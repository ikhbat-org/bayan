// T6: CEmitter.cs 61-178 (`Emit`, `Run`, symbol table), 288-396 (`EmitMain`, names, `FilePath`).
// Header only (T1): the entry point with its final signature. `Run()`'s section order is one function here.

import semantics
import emitter.ltree

/// CEmitter.cs:61 `Emit`: the C translation unit for `program`. The lowered nodes are in `t`.
public string emit(ref Ctx c, from in ltree.LTree t, through in ltree.LoweredProgram program, by bool ownershipChecks) uses alloc {
    var cc = CCtx { ownershipChecks: ownershipChecks, packageRoot: c.packageRoot }
    for i in 0..program.testFunctions.length { cc.testIndex[program.testFunctions[i].symbol] = i }
    return t6Run(ref cc, from: ref c, through: in t, for: in program)
}

/// CEmitter.cs:63 `Run`: the sections of the translation unit, in order.
public string t6Run(ref CCtx cc, from ref Ctx c, through in ltree.LTree t, for in ltree.LoweredProgram program) uses alloc {
    var bodies = StrBuf()
    var protos = StrBuf()
    for f in program.functions { t6EmitFunction(ref cc, from: ref c, through: in t, for: in f, to: ref protos, by: ref bodies) }
    for f in program.testFunctions { t6EmitFunction(ref cc, from: ref c, through: in t, for: in f, to: ref protos, by: ref bodies) }
    let main = t6EmitMain(ref cc, from: ref c, through: in program)

    var errors = StrBuf()
    let variants = c.errorVariants.length
    errors.append("static const byn_str byn_errors[] = {\n")
    if variants == 0 { errors.append("    BYN_STR(\"\", 0),\n") }
    for v in 0..variants { errors.append($"    {stringLiteral(semantics.errorVariantSummary(ref c, by: v))},\n") }
    errors.append("};\n\n")
    errors.append("static __attribute__((unused)) void byn_w_error(byn_writer* w, uint32_t code) {\n")
    errors.append($"    if (code == 0 || code > {variants}) byn_w_str(w, BYN_STR(\"no error\", 8));\n")
    errors.append("    else byn_w_str(w, byn_errors[code - 1]);\n}\n\n")
    errors.append("static const uint8_t byn_exit_codes[] = {")
    if variants == 0 {
        errors.append("1")
    } else {
        for v in 0..variants {
            if v > 0 { errors.append(", ") }
            errors.append($"{c.errorVariants[v].exitCode}")
        }
    }
    errors.append("};\n\n")

    var statics = StrBuf()
    for name in cc.staticOrder { statics.append(cc.statics[name]) }
    let symbolIndex = t6SymbolTable(ref cc, to: ref statics)
    let types = emitTypes(ref cc, from: ref c)
    var enums = StrBuf()
    for j in 0..c.moduleOrder.length {
        let m = c.moduleOrder[j]
        for k in 0..c.modules[m].enums.length {
            enums.append($"typedef int32_t {cType(ref cc, from: ref c, for: semantics.enumTypeOf(c.modules[m].enums[k]))};\n")
        }
    }
    let enumText = enums.finish()
    var sb = StrBuf()
    sb.append("/* Generated by the Bayan compiler. Do not edit. */\n")
    // The checker's runtime declarations, also when this file is compiled by hand without -DBYN_DEBUG.
    if cc.ownershipChecks { sb.append("#ifndef BYN_DEBUG\n#define BYN_DEBUG\n#endif\n") }
    sb.append("#include \"bayan-rt.h\"\n#include <math.h>\n#include <stdlib.h>\n\n")
    for (path, name) in cc.files { sb.append($"static const char {name}[] = {cString(path)};\n") }
    sb.append("\n")
    sb.append(enumText)
    if enumText.length > 0 { sb.append("\n") }
    sb.append(types)
    sb.append(statics.finish())
    sb.append(errors.finish())
    if program.mutants { sb.append(t10MutantSelector) }
    if program.covering { sb.append(t10CoverageCounters(program.coverage.count)) }
    sb.append(protos.finish())
    sb.append("\n")
    for h in cc.helperOrder { sb.append($"{cc.helpers[h].proto};\n") }
    sb.append("\n")
    for v in cc.vtableOrder { sb.append(cc.vtables[v]) }
    if cc.vtableOrder.length > 0 { sb.append("\n") }
    for h in cc.helperOrder { sb.append($"{cc.helpers[h].body}\n") }
    sb.append(bodies.finish())
    sb.append(main)
    var text = $"{sb.finish()}"
    // A literal's index is known once every literal is seen; the marks cannot clash, as `Escape` writes control bytes as octal.
    if cc.symbols { text = t6SymbolIndexes(text, by: in symbolIndex) }
    return t6ResolveResets(text)
}

/// CEmitter.cs:69-73: `new FunctionEmitter(this, f)`, its signature as a prototype and its body.
void t6EmitFunction(ref CCtx cc, from ref Ctx c, through in ltree.LTree t, for in ltree.LoweredFunction f, to ref StrBuf protos, by ref StrBuf bodies) uses alloc {
    protos.append(signature(ref cc, from: ref c, through: in t, for: in f))
    protos.append(";\n")
    bodies.append(emitFunction(ref cc, from: ref c, through: in t, for: in f))
    bodies.append("\n")
}

/// CEmitter.cs:123 `SymbolTable`: appends `byn_symtab`, the distinct literal texts sorted by UTF-8 bytes with `""` first (R2),
/// and returns each literal's index by first-seen number.
List<i64> t6SymbolTable(ref CCtx cc, to ref StrBuf sb) uses alloc {
    var indexes = List<i64>()
    if !cc.symbols { return indexes }
    var sorted = List<string>()
    var seen = Map<string, bool>()
    for text in cc.symbolTexts {
        if !seen.contains(text) {
            seen[text] = true
            sorted.append(text)
        }
    }
    if !seen.contains("") { sorted.append("") }
    sorted.sort()
    sb.append("static const byn_str byn_symtab[] = {\n")
    for text in sorted { sb.append($"    {stringLiteral(text)},\n") }
    sb.append("};\n\n")
    var position = Map<string, i64>()
    for i in 0..sorted.length { position[sorted[i]] = i }
    for text in cc.symbolTexts { indexes.append(position[text]) }
    return indexes
}

/// CEmitter.cs:118 `Regex.Replace(text, "\u0001(\\d+)\u0001", m => symbolIndex[int.Parse(m)])`.
string t6SymbolIndexes(string text, by in List<i64> symbolIndex) uses alloc {
    var sb = StrBuf()
    let bytes = text.bytes
    var start = 0
    var i = 0
    while i < bytes.length {
        if i64(bytes[i]) == 1 {
            var j = i + 1
            var n = 0
            while j < bytes.length && i64(bytes[j]) >= 48 && i64(bytes[j]) <= 57 {
                n = n * 10 + i64(bytes[j]) - 48
                j += 1
            }
            // coverage-exempt: Q787
            if j > i + 1 && j < bytes.length && i64(bytes[j]) == 1 {
                sb.append(text[start..i])
                sb.append($"{symbolIndex[n]}")
                start = j + 1
                i = j + 1
                continue
            }
        }
        i += 1
    }
    sb.append(text[start..bytes.length])
    return $"{sb.finish()}"
}

/// CEmitter.cs:170 `ResolveResets`: turns each `#line generated` into `#line N "main.c"` naming the line after it, so
/// debuggers step over generated code.
string t6ResolveResets(string text) uses alloc {
    if !text.contains("#line generated") { return text }
    var sb = StrBuf()
    var start = 0
    var n = 0
    for p in 0..text.bytes.length + 1 {
        if p == text.bytes.length || i64(text.bytes[p]) == 10 {
            if n > 0 { sb.append("\n") }
            let line = text[start..p]
            if line == "#line generated" {
                sb.append($"#line {n + 2} {cString("main.c")}")
            } else {
                sb.append(line)
            }
            n += 1
            start = p + 1
        }
    }
    return $"{sb.finish()}"
}

/// CEmitter.cs:288 `EmitMain`.
public string t6EmitMain(ref CCtx cc, from ref Ctx c, through in ltree.LoweredProgram program) uses alloc {
    var sb = StrBuf()
    sb.append($"int main(int argc, char** argv) {{\n    {errorCType(ref cc, from: ref c)} err = {{0}};\n")
    if program.mutants { sb.append("    byn_mutant_read();\n") }
    if program.covering {
        if program.tests.length > 0 {
            sb.append("    byn_cov_start(argc == 3 && strcmp(argv[1], \"--test\") == 0 ? argv[2] : NULL);\n")
        } else {
            sb.append("    byn_cov_start(NULL);\n")
        }
    }
    // Map and symbol hashing is seeded per run; tests get a fixed seed so they are reproducible.
    if cc.hashes || cc.symbols {
        if program.tests.length > 0 {
            sb.append("    byn_hash_seed_init(argc == 3 && strcmp(argv[1], \"--test\") == 0);\n")
        } else {
            sb.append("    byn_hash_seed_init(false);\n")
        }
    }
    // The literal table first and in order, so literal N is ID N and `Symbol.intern` of its text finds it.
    if cc.symbols { sb.append("    byn_sym_init(byn_symtab, (uint32_t)(sizeof byn_symtab / sizeof byn_symtab[0]));\n") }
    if program.tests.length > 0 {
        sb.append("    if (argc == 3 && strcmp(argv[1], \"--test\") == 0) {\n        switch (atoi(argv[2])) {\n")
        for i in 0..program.tests.length {
            let fn = program.testFunctions[i].symbol
            // coverage-exempt: Q787
            sb.append($"        case {i}: {c.functions[fn].hasFails ? "err = " : ""}{functionName(ref cc, from: ref c, for: fn)}(); break;\n")
        }
        sb.append("        default: return 2;\n        }\n")
        sb.append("        if (err.code != 0) { byn_report_error(byn_errors[err.code - 1]); return 1; }\n")
        sb.append("        byn_stdout_flush();\n        return 0;\n    }\n")
    } else {
        sb.append("    (void)argv;\n")
    }
    var exit = "0"
    if program.main != -1 {
        let main = program.main
        // Arguments are checked for UTF-8 before `main` runs, whether or not it takes them.
        sb.append("    byn_str* byn_argv = byn_args(&argc, argv);\n")
        var args = List<string>()
        if c.functions[main].parameters.length == 1 {
            let parameterType = c.locals[c.functions[main].parameters[0]].type
            args.append($"({cType(ref cc, from: ref c, for: parameterType)}){{byn_argv, argc > 1 ? argc - 1 : 0}}")
        } else {
            sb.append("    (void)byn_argv;\n")
        }
        let returnsCode = c.functions[main].returnType == semantics.prim(.i32)
        if returnsCode {
            sb.append("    int32_t code = 0;\n")
            exit = "code"
        }
        if c.functions[main].hasFails && returnsCode { args.append("&code") }
        var joined = StrBuf()
        for i in 0..args.length {
            if i > 0 { joined.append(", ") }
            joined.append(args[i])
        }
        let call = $"{functionName(ref cc, from: ref c, for: main)}({joined.finish()})"
        sb.append($"    {c.functions[main].hasFails ? "err = " : returnsCode ? "code = " : ""}{call};\n")
    } else {
        sb.append("    (void)argc;\n")
    }
    sb.append("    if (err.code != 0) { byn_report_error(byn_errors[err.code - 1]); return byn_exit_codes[err.code - 1]; }\n")
    sb.append($"    byn_stdout_flush();\n    return {exit};\n}}\n")
    return $"{sb.finish()}"
}

/// CEmitter.cs:137 `SymbolLiteral` (Q845): the C value of symbol literal `text`, numbering the text on first sight.
public string symbolLiteral(ref CCtx cc, for string text) uses alloc {
    cc.symbols = true
    if !cc.symbolIds.contains(text) {
        cc.symbolIds[text] = cc.symbolTexts.length
        cc.symbolTexts.append(text)
    }
    let k = cc.symbolIds[text]
    return $"((byn_sym){{{rune(symbolMark)}{k}{rune(symbolMark)}}})"
}

/// CEmitter.cs:150 `SymbolText` (Q845): the C expression for the interned text of the symbol `s` (C text).
public string symbolText(ref CCtx cc, for string s) uses alloc {
    cc.symbols = true
    return $"byn_sym_text({s})"
}

/// CEmitter.cs:157 `SymbolIntern` (Q845): the C expression for `Symbol.intern` of `text` (C text).
public string symbolIntern(ref CCtx cc, for string text) uses alloc {
    cc.symbols = true
    return $"byn_sym_intern({text})"
}

/// CEmitter.cs:348 `FunctionName` (Q845): the C name of function `fn`.
public string functionName(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn) uses alloc {
    let kind = c.functions[fn].kind
    if kind == .testKeyword { return $"byn_test_{cc.testIndex[fn]}" }
    let module = c.modules[c.functions[fn].module].cName
    if kind == .main { return $"byn_{module}__main" }
    let name = c.functions[fn].name
    // `f$lambda2` in an instance of `f` is named after that instance, so each instantiation has its own.
    if kind == .lambda {
        let at = name.lastPosition("$lambda") ?? -1
        return $"{functionName(ref cc, from: ref c, for: c.functions[fn].enclosing)}__lambda{name[at + 7..name.length]}"
    }
    let owner = c.functions[fn].owner
    if owner != -1 {
        var member = ""
        switch kind {
            case .constructor: member = $"init{t6IndexOf(in c.structs[owner].constructors, for: fn)}"
            case .getter: member = $"get_{name}"
            default: member = $"{name}{t6Overload(in semantics.findMethods(ref c, by: owner, for: name), for: fn)}"
        }
        let typeArgs = t2Copy(in c.structs[owner].typeArgs)
        return $"byn_{module}__{c.structs[owner].name}{t2TypeArgs(ref c, for: in typeArgs)}__{member}"
    }
    let template = c.functions[fn].template
    var overloads = List<semantics.FuncId>()
    if c.modules[c.functions[fn].module].functions.contains(name) {
        for o in c.modules[c.functions[fn].module].functions[name] { overloads.append(o) }
    }
    let fnArgs = t2Copy(in c.functions[fn].typeArgs)
    return $"byn_{module}__{name}{t6Overload(in overloads, for: template == -1 ? fn : template)}{t2TypeArgs(ref c, for: in fnArgs)}"
}

/// `List.IndexOf`: the position of `f` in `fns`, -1 when it is not there.
i64 t6IndexOf(in List<semantics.FuncId> fns, for semantics.FuncId f) {
    for i in 0..fns.length {
        if fns[i] == f { return i }
    }
    return -1
}

/// CEmitter.cs:369 `Overload`: the `__o1` that tells a second overload from the first (J65); empty for the first.
string t6Overload(in List<semantics.FuncId> overloads, for semantics.FuncId f) uses alloc {
    let i = t6IndexOf(in overloads, for: f)
    return i > 0 ? $"__o{i}" : ""
}

/// CEmitter.cs:374 `FieldName` (Q845): `name` as a C member name, avoiding C keywords.
public string fieldName(string name) uses alloc {
    for w in cKeywords() {
        if w == name { return $"{name}_" }
    }
    return name
}

/// CEmitter.cs:376 `FileName` (Q845): the C name of the static that holds `fn`'s file path, registering it.
public string fileName(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn) uses alloc {
    let relative = filePath(ref cc, from: ref c, for: fn)
    if !cc.files.contains(relative) {
        let name = $"byn_file_{cc.files.length}"
        cc.files[relative] = name
    }
    return cc.files[relative]
}

/// CEmitter.cs:388 `FilePath` (Q845): the path panics and `#line` name `fn`'s file by.
public string filePath(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn) uses alloc {
    let file = c.functions[fn].file
    let path = file == -1 ? "" : c.files[file].path
    // Project files are already relative to the project root; a loose file is named from its directory.
    var relative = path.replaced("\\", by: "/")
    if Path.isRooted(path) { relative = Path.relative(cc.packageRoot, to: path).replaced("\\", by: "/") }
    if relative.startsWith("..") { relative = Path.fileName(path) }
    return relative
}

/// CEmitter.cs:184 `MutantSelector`: a `--mutate` build's selector, `BAYAN_MUTANT`, and its reach log, `BAYAN_SITE_REACH`.
const t10MutantSelector: string = """
    #include <stdio.h>

    static int64_t byn_mutant;
    static const char* byn_reach_path;
    static uint8_t* byn_reach_bits;
    static int64_t byn_reach_cap;

    static void byn_reach_write(void) {
        FILE* f = fopen(byn_reach_path, "w");
        if (f == NULL) return;
        for (int64_t i = 0; i < byn_reach_cap; i++)
            if (byn_reach_bits[i]) fprintf(f, "%lld\n", (long long)i);
        fclose(f);
    }

    static bool byn_mutant_is(int64_t id) {
        if (byn_reach_path != NULL && id >= 0 && id < INT32_MAX) {
            if (id >= byn_reach_cap) {
                int64_t cap = id + 64;
                uint8_t* bits = (uint8_t*)realloc(byn_reach_bits, (size_t)cap);
                if (bits == NULL) abort();
                memset(bits + byn_reach_cap, 0, (size_t)(cap - byn_reach_cap));
                byn_reach_bits = bits;
                byn_reach_cap = cap;
            }
            byn_reach_bits[id] = 1;
        }
        return byn_mutant == id;
    }

    static void byn_mutant_read(void) {
        const char* r = getenv("BAYAN_SITE_REACH");
        if (r != NULL && *r != 0) {
            byn_reach_path = r;
            atexit(byn_reach_write);
        }
        const char* s = getenv("BAYAN_MUTANT");
        int64_t n = 0;
        if (s == NULL || *s == 0) return;
        for (; *s != 0; s++) {
            if (*s < '0' || *s > '9' || n > (INT64_MAX - 9) / 10) return;
            n = n * 10 + (*s - '0');
        }
        byn_mutant = n;
    }


    """

/// CEmitter.cs:240 `CoverageCounters`: a `--coverage` build's `count` counters (at least one) and their writer.
string t10CoverageCounters(i64 count) uses alloc {
    return $"{t10CoverageHead}static uint64_t byn_cov[{count > 1 ? count : 1}];\n{t10CoverageTail}"
}

const t10CoverageHead: string = """
    #include <stdio.h>
    #ifdef _WIN32
    #include <process.h>
    #define byn_cov_pid() ((unsigned long long)_getpid())
    #elif defined(__wasi__)
    #define byn_cov_pid() 0ULL
    #else
    #include <unistd.h>
    #define byn_cov_pid() ((unsigned long long)getpid())
    #endif


    """

const t10CoverageTail: string = """
    static char* byn_cov_path;

    static void byn_cov_write(void) {
        char* path = byn_cov_path;
        byn_cov_path = NULL;
        if (path == NULL) return;
        FILE* f = fopen(path, "w");
        free(path);
        if (f == NULL) return;
        fputs("bayan-coverage 1\n", f);
        for (size_t i = 0; i < sizeof byn_cov / sizeof byn_cov[0]; i++)
            if (byn_cov[i] != 0) fprintf(f, "%llu %llu\n", (unsigned long long)i, (unsigned long long)byn_cov[i]);
        fclose(f);
    }

    /* The file is `<BAYAN_COVERAGE>.<test index>` under `--test`, else `<BAYAN_COVERAGE>.<pid>`. */
    static void byn_cov_start(const char* test) {
        const char* prefix = getenv("BAYAN_COVERAGE");
        if (prefix == NULL || *prefix == 0) return;
        size_t n = strlen(prefix) + (test != NULL ? strlen(test) : 20) + 2;
        byn_cov_path = malloc(n);
        if (byn_cov_path == NULL) return;
        if (test != NULL) snprintf(byn_cov_path, n, "%s.%s", prefix, test);
        else snprintf(byn_cov_path, n, "%s.%llu", prefix, byn_cov_pid());
        byn_cov_flush = byn_cov_write;
        atexit(byn_cov_write);
    }


    """
