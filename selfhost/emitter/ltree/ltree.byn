public LNode addLErrorCode(ref LTree t, from move LErrorCode n) uses alloc {
    t.errorCodes.append(move n)
    return lNode(.errorCode, at: t.errorCodes.length - 1)
}

public LNode addLErrorField(ref LTree t, from move LErrorField n) uses alloc {
    t.errorFields.append(move n)
    return lNode(.errorField, at: t.errorFields.length - 1)
