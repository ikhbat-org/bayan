// T1: LoweredNodes.cs 1-127 (the lowered tree; the lowerer's state is `emitter/lctx.byn`, Lowerer.cs 37-41 and 48-76).
// A module of its own so that `emitter` and `emitter.cprint` both read it without importing each other (D1).
//
// The lowered tree shares the bound tree's handle space (bound.byn:3): a lowered node is
// `(LKind << 32) | index` into a per-kind arena on `LTree`, -1 is null, and `LKind`'s ordinals start at 100,
// above `BoundKind`'s 77 members, so a `BStmt`/`BExpr` handle and a lowered one tell apart by kind without a
// tag. One struct per C# record, fields in C# order: `Node Syntax` is `TextSpan span`, a symbol is its
// semantics handle, `T[]` is a `List<T>`, and a base type computed from a field (`LOptionalValue`'s `Type`)
// is the field. The records that C# derives from `BoundStmt`/`BoundExpr` only for their `Syntax` and `Type`
// carry the same two facts: `span` and, where C# passes it, `type`.

import semantics

public type TextSpan = semantics.TextSpan
public type Type = semantics.Type
public type FuncId = semantics.FuncId
public type LocalId = semantics.LocalId
public type VariantId = semantics.VariantId
public type TestId = semantics.TestId
public type BExpr = semantics.BExpr
public type BStmt = semantics.BStmt
public type BPattern = semantics.BPattern
public type BInterpolationPart = semantics.BInterpolationPart
public type BNode = semantics.BNode

/// A lowered node, or a bound one: `(kind << 32) | index`; -1 is null.
public type LNode = i64

// ── Kinds ──────────────────────────────────────────────────────────────────────

/// The first `LKind` ordinal; `BoundKind` has 77 members (0..76).
const lKindBase: i64 = 100

/// `LoweredNodes.cs` order. The handle's kind is `lKindBase + ordinal`.
public enum LKind {
    label
    gotoStmt
    loop
    returnStmt
    returnError
    failingCall
    write
    panic
    setContext
    freeArena
    pushPanicHandler
    popPanicHandler
    claim
    optionalHas
    optionalValue
    unionTag
    unionField
    errorCode
    errorField
    assignExpr
    sequence
    indexUnchecked
    nextChar
    neverValue
    functionValue
    mutantIs
    count
    voidValue
}

/// `WriteSink`.
public enum WriteSink {
    print
    panic
    strBuf
    log
}

public LNode lNode(LKind kind, at i64 index) => ((lKindBase + i64(kind.ordinal)) << 32) | index

/// Whether `n` is a lowered handle rather than a bound one.
public bool isLowered(LNode n) => n >= 0 && (n >> 32) >= lKindBase

public LKind lKindOf(LNode n) => LKind.fromOrdinal((n >> 32) - lKindBase) ?? .voidValue

public i64 lIndexOf(LNode n) => n & 0xFFFFFFFF

// ── Lowered records ────────────────────────────────────────────────────────────

/// A jump target; emitted as `name:;`.
public struct LLabel {
    public TextSpan span
    public string name
}

public struct LGoto {
    public TextSpan span
    public string label
}

/// `for (;;) { body }`; leave it only through `LGoto`.
public struct LLoop {
    public TextSpan span
    public BStmt body
}

/// Returns normally. For a failing function the value goes to the result pointer and the error code is 0; a constructor returns its `this`. `value` -1 is C#'s null.
public struct LReturn {
    public TextSpan span
    public BExpr value = -1
}

/// Returns the error code in `code` (a local of an error type) from a failing function.
public struct LReturnError {
    public TextSpan span
    public BExpr code
}

/// `error = call(…, &result)` for a function that can fail.
public struct LFailingCall {
    public TextSpan span
    public LocalId error
    public BExpr call
    public LocalId result = -1
}

/// Formats `parts` into a stack buffer and sends it to the sink. A part with a `guards` entry (-1 for none) is written only when that condition holds.
public struct LWrite {
    public TextSpan span
    public WriteSink sink
    public BExpr target = -1
    public List<BInterpolationPart> parts
    public List<BExpr>? guards = null
}

/// Panics with a fixed message (failed `assert`, unmatched `switch`).
public struct LPanic {
    public TextSpan span
    public string message
}

/// Sets `context.allocator` to `arena`, saving the previous one in slot `slot`; with no arena, restores the saved allocator.
public struct LSetContext {
    public TextSpan span
    public BExpr arena = -1
    public i64 slot
}

/// Frees an arena declared with `using`.
public struct LFreeArena {
    public TextSpan span
    public BExpr arena
}

/// Registers the `defer panicking` handler in slot `slot`.
public struct LPushPanicHandler {
    public TextSpan span
    public i64 slot
    public LocalId panic = -1
    public BStmt body
}

/// Unregisters the handler in slot `slot` as its scope ends.
public struct LPopPanicHandler {
    public TextSpan span
    public i64 slot
}

/// Debug builds: a `switch move x` binding owns its storage once its arm is selected; nothing otherwise.
public struct LClaim {
    public TextSpan span
    public LocalId local
}

/// Whether an optional holds a value (type bool).
public struct LOptionalHas {
    public TextSpan span
    public BExpr optional
}

/// The value inside an optional already known to hold one.
public struct LOptionalValue {
    public TextSpan span
    public BExpr optional
    public Type type
}

/// A union's tag: its variant's declaration index (type i32).
public struct LUnionTag {
    public TextSpan span
    public BExpr unionValue
}

/// A payload field of a union already known to hold `variant`; its type is `variant`'s field `index`.
public struct LUnionField {
    public TextSpan span
    public BExpr unionValue
    public VariantId variant
    public i64 index
}

/// An error's code: its case's program-wide number, 0 for none (type u32).
public struct LErrorCode {
    public TextSpan span
    public BExpr error
}

/// A payload field of an error already known to be `variant`.
public struct LErrorField {
    public TextSpan span
    public BExpr error
    public VariantId variant
    public i64 index
}

/// `(target = value)` as an expression; used for pattern bindings.
public struct LAssignExpr {
    public TextSpan span
    public BExpr target
    public BExpr value
}

/// C's comma operator: evaluates `effects`, then `value`.
public struct LSequence {
    public TextSpan span
    public List<BExpr> effects
    public BExpr value
}

/// An element read whose index the compiler proved in range (loop over a sequence).
public struct LIndexUnchecked {
    public TextSpan span
    public BExpr target
    public BExpr index
    public Type type
}

/// The next char of `text` at byte offset `position` (a local), advancing it (type char).
public struct LNextChar {
    public TextSpan span
    public BExpr text
    public LocalId position
}

/// The value of an expression that never completes (it jumped, failed or panicked).
public struct LNever {
    public TextSpan span
    public Type type
}

/// A function value: `function`'s code with `env` (the captures tuple) or no environment.
public struct LFunctionValue {
    public TextSpan span
    public FuncId function
    // Q1: round 4 redoes this (LoweredNodes.cs:118).
    public LocalId env = -1
    public Type functionType
}

/// Whether the process-wide selector `byn_mutant` is `id` (a `--mutate` build).
public struct LMutantIs {
    public TextSpan span
    public i64 id
}

/// Counts one hit of coverage counter `id` (a `--coverage` build).
public struct LCount {
    public TextSpan span
    public i64 id
}

/// The value of a `void` expression whose effects were already emitted.
public struct LVoid {
    public TextSpan span
}

// ── Coverage probes (CoverageProbes.cs; keyed by bound node, Q1098) ───────────

/// C# `BoundProbe`: the `Syntax` (its span) and the counter id.
public struct BoundProbe {
    public TextSpan span
    public i64 id
}

/// C# `BoundBranchProbe`.
public struct BoundBranchProbe {
    public TextSpan span
    public i64 whenTrue
    public i64 whenFalse
}

/// One `(ErrorVariantSymbol Variant, int Id)` of a `BoundErrorProbe`.
public struct ErrorProbeVariant {
    public VariantId variant
    public i64 id
}

/// C# `BoundErrorProbe`.
public struct BoundErrorProbe {
    public TextSpan span
    public List<ErrorProbeVariant> variants = List<ErrorProbeVariant>()
}

/// C# `CoverageProbes`, keyed by bound node.
public struct CoverageProbes {
    public i64 count = 0
    public Map<BNode, BoundProbe> statements = []
    public Map<BNode, BoundBranchProbe> branches = []
    public Map<BNode, BoundErrorProbe> errors = []
}

// ── Program ────────────────────────────────────────────────────────────────────

/// `LoweredFunction`: a function body with every local (not parameter) it uses, in first-use order.
public struct LoweredFunction {
    public FuncId symbol
    public List<LocalId> locals
    public i64 contextSlots
    public i64 panicSlots
    public BStmt body
}

/// `LoweredProgram`, with a `Ctx` passed alongside instead of `Compilation`. C#'s `CoverageProbes? Coverage` is
/// `covering` and `coverage`: an optional unique value cannot be moved out of the lowerer's state.
public struct LoweredProgram {
    public List<LoweredFunction> functions
    public FuncId main
    public List<TestId> tests
    public List<LoweredFunction> testFunctions
    public bool mutants = false
    public bool covering = false
    public CoverageProbes coverage = CoverageProbes {}
}

// ── Arenas ─────────────────────────────────────────────────────────────────────

/// The arenas of the lowered kinds, one list per `LKind`.
public struct LTree {
    public List<LLabel> labels = List<LLabel>()
    public List<LGoto> gotoStmts = List<LGoto>()
    public List<LLoop> loops = List<LLoop>()
    public List<LReturn> returnStmts = List<LReturn>()
    public List<LReturnError> returnErrors = List<LReturnError>()
    public List<LFailingCall> failingCalls = List<LFailingCall>()
    public List<LWrite> writes = List<LWrite>()
    public List<LPanic> panics = List<LPanic>()
    public List<LSetContext> setContexts = List<LSetContext>()
    public List<LFreeArena> freeArenas = List<LFreeArena>()
    public List<LPushPanicHandler> pushPanicHandlers = List<LPushPanicHandler>()
    public List<LPopPanicHandler> popPanicHandlers = List<LPopPanicHandler>()
    public List<LClaim> claims = List<LClaim>()
    public List<LOptionalHas> optionalHass = List<LOptionalHas>()
    public List<LOptionalValue> optionalValues = List<LOptionalValue>()
    public List<LUnionTag> unionTags = List<LUnionTag>()
    public List<LUnionField> unionFields = List<LUnionField>()
    public List<LErrorCode> errorCodes = List<LErrorCode>()
    public List<LErrorField> errorFields = List<LErrorField>()
    public List<LAssignExpr> assignExprs = List<LAssignExpr>()
    public List<LSequence> sequences = List<LSequence>()
    public List<LIndexUnchecked> indexUncheckeds = List<LIndexUnchecked>()
    public List<LNextChar> nextChars = List<LNextChar>()
    public List<LNever> neverValues = List<LNever>()
    public List<LFunctionValue> functionValues = List<LFunctionValue>()
    public List<LMutantIs> mutantIss = List<LMutantIs>()
    public List<LCount> counts = List<LCount>()
    public List<LVoid> voidValues = List<LVoid>()
}

// ── Constructors ───────────────────────────────────────────────────────────────

public LNode addLLabel(ref LTree t, from move LLabel n) uses alloc {
    t.labels.append(move n)
    return lNode(.label, at: t.labels.length - 1)
}

public LNode addLGoto(ref LTree t, from move LGoto n) uses alloc {
    t.gotoStmts.append(move n)
    return lNode(.gotoStmt, at: t.gotoStmts.length - 1)
}

public LNode addLLoop(ref LTree t, from move LLoop n) uses alloc {
    t.loops.append(move n)
    return lNode(.loop, at: t.loops.length - 1)
}

public LNode addLReturn(ref LTree t, from move LReturn n) uses alloc {
    t.returnStmts.append(move n)
    return lNode(.returnStmt, at: t.returnStmts.length - 1)
}

public LNode addLReturnError(ref LTree t, from move LReturnError n) uses alloc {
    t.returnErrors.append(move n)
    return lNode(.returnError, at: t.returnErrors.length - 1)
}

public LNode addLFailingCall(ref LTree t, from move LFailingCall n) uses alloc {
    t.failingCalls.append(move n)
    return lNode(.failingCall, at: t.failingCalls.length - 1)
}

public LNode addLWrite(ref LTree t, from move LWrite n) uses alloc {
