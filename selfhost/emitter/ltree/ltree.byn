public LNode addLFreeArena(ref LTree t, from move LFreeArena n) uses alloc {
    t.freeArenas.append(move n)
    return lNode(.freeArena, at: t.freeArenas.length - 1)
}

public LNode addLPushPanicHandler(ref LTree t, from move LPushPanicHandler n) uses alloc {
    t.pushPanicHandlers.append(move n)
    return lNode(.pushPanicHandler, at: t.pushPanicHandlers.length - 1)
}

public LNode addLPopPanicHandler(ref LTree t, from move LPopPanicHandler n) uses alloc {
    t.popPanicHandlers.append(move n)
    return lNode(.popPanicHandler, at: t.popPanicHandlers.length - 1)
