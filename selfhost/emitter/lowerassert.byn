/// Lowerer.cs:1528 `CallParts` (Q845): the call `e` with its receiver and arguments lowered, or -1 when one never returns.
public BExpr lowerCallParts(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let function = c.bCalls[i].function
    let span = c.bCalls[i].span
    let type = c.bCalls[i].type
    let invoke = c.functions[function].kind == .invoke
    let hasReceiver = c.bCalls[i].receiver != -1 && (semantics.functionHasThis(ref c, by: function) || invoke)
    var ops = List<BExpr>()
    var lvalues = List<bool>()
    if hasReceiver {
        let receiver = c.bCalls[i].receiver
        ops.append(receiver)
        lvalues.append(isLvalueShape(ref c, through: ref l, for: receiver))
    }
    let offset: i64 = hasReceiver ? 1 : 0
    for k in 0..c.bCalls[i].arguments.length {
        ops.append(c.bCalls[i].arguments[k])
        let p = k
        lvalues.append(p < c.functions[function].parameters.length && semantics.paramIsByRef(ref c, by: c.functions[function].parameters[p]))
    }
    var parts = List<BExpr>()
    unless operands(ref c, through: ref l, for: in ops, as: in lvalues, to: ref parts) { return -1 }
    var receiver: BExpr = -1
    if hasReceiver {
        receiver = parts[0]
        // A function value is named twice in C (its code and its environment), so anything but a local is evaluated once first.
        if !isLvalue(in c, through: in l, for: receiver)
            // coverage-exempt: Q780
            || invoke && (ltree.isLowered(receiver) || semantics.boundKind(receiver) != .local) {
            receiver = spill(ref c, through: ref l, for: receiver)
        }
        // `map[k].f()` with `ref this` changes the stored value; reading through the panicking index first keeps a missing key out.
        if t5IsBuiltin(in c, for: receiver, by: .mapIndexSet) {
            let place = lowerStable(ref c, through: ref l, for: receiver)
            let read = t5Builtin(ref c, from: place, as: .mapIndex, to: c.bBuiltinCalls[place & 0xFFFFFFFF].receiver, by: t5Arguments(in c, for: place))
            emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: read }))
            receiver = place
        }
    }
    var arguments = List<BExpr>()
    for k in offset..parts.length { arguments.append(parts[k]) }
    let copy = semantics.addCall(ref c, from: BCall { span: span, function: function, receiver: receiver, arguments: move arguments, type: type })
    return t5Copied(ref c, from: e, as: copy)
}

/// Lowerer.cs:1561 `BuiltinCall` (Q844): the lowered builtin call `e`, with its statements appended to the current output list.
public BExpr lowerBuiltinCall(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let member = c.bBuiltinCalls[i].member
    let span = c.bBuiltinCalls[i].span
    let type = c.bBuiltinCalls[i].type
    let receiver = c.bBuiltinCalls[i].receiver
    if member == .strBufAppend {
        let first = c.bBuiltinCalls[i].arguments[0]
        if !ltree.isLowered(first) && semantics.boundKind(first) == .interpolated {
            let target = lowerLvalue(ref c, through: ref l, for: receiver)
            if isNeverExpr(target) { return target }
            return lowerWriteParts(ref c, through: ref l, for: e, by: .strBuf, to: target, as: first)
        }
    }
    // `x.take()`: move the value out, then leave the type's empty value in the place, evaluated once.
    if member == .listTake || member == .mapTake || member == .strBufTake || member == .optionalTake {
        var place = lowerLvalue(ref c, through: ref l, for: receiver)
        if isNeverExpr(place) { return place }
        place = lowerStable(ref c, through: ref l, for: place)
        // `map[k].take()` reads through the panicking index, so a missing key is not inserted.
        var read = place
        if t5IsBuiltin(in c, for: place, by: .mapIndexSet) {
            read = t5Builtin(ref c, from: place, as: .mapIndex, to: c.bBuiltinCalls[place & 0xFFFFFFFF].receiver, by: t5Arguments(in c, for: place))
        }
        let taken = spill(ref c, through: ref l, for: read)
        var empty: BExpr = -1
        if member == .strBufTake {
            empty = semantics.addCall(ref c, from: BCall { span: span, function: c.builtinStrBufGrow, type: type })
        } else {
            empty = semantics.addDefault(ref c, from: BDefault { span: span, type: type })
        }
        emitAssign(ref c, through: ref l, to: place, as: empty)
        return taken
    }
    let mutating = t5Mutating(member)
    var ops = List<BExpr>()
    ops.append(receiver)
    for a in c.bBuiltinCalls[i].arguments { ops.append(a) }
    // `slot` inserts the value type's default: field initializers for a struct, zero otherwise.
    if member == .mapSlot && ops.length == 2 {
        if semantics.kindOf(type) == .structType {
            let sid = i64(type & 0xFFFFFFFF)
            var values = List<BExpr>()
            for k in 0..c.structs[sid].fields.length {
                let field = c.structs[sid].fields[k]
                var value = c.fields[field].defaultValue
                // coverage-exempt: Q780
                if value == -1 { value = semantics.addDefault(ref c, from: BDefault { span: span, type: c.fields[field].type }) }
                values.append(value)
            }
            ops.append(semantics.addStructLiteral(ref c, from: BStructLiteral { span: span, structId: sid, fields: move values, type: type }))
        } else {
            ops.append(semantics.addDefault(ref c, from: BDefault { span: span, type: type }))
        }
    }
    var lvalues = List<bool>()
    lvalues.append(mutating && isLvalueShape(ref c, through: ref l, for: receiver))
    var parts = List<BExpr>()
    unless operands(ref c, through: ref l, for: in ops, as: in lvalues, to: ref parts) {
        return ltree.addLNever(ref l.tree, from: T5LNever { span: span, type: type })
    }
    var lowered = parts[0]
    if mutating && !isLvalue(in c, through: in l, for: lowered) {
        lowered = spill(ref c, through: ref l, for: lowered)
    } else if !mutating && !isTrivial(in c, through: in l, for: lowered) && (member == .listAsSpan || member == .strBufAsString) {
        lowered = spill(ref c, through: ref l, for: lowered)
    }
    var arguments = List<BExpr>()
    for k in 1..parts.length { arguments.append(parts[k]) }
    let copy = t5Copied(ref c, from: e, as: semantics.addBuiltinCall(ref c, from: BBuiltinCall { span: span, member: member, receiver: lowered, arguments: move arguments, type: type }))
    if semantics.isVoid(type) {
        emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: copy }))
        return ltree.addLVoid(ref l.tree, from: T5LVoid { span: span })
    }
    return copy
}

/// Lowerer.cs:1609 `Stable` (Q844): `place` with every operand that a later write could change spilled to a temporary.
public BExpr lowerStable(ref Ctx c, through ref LCtx l, for BExpr place) uses alloc {
    if ltree.isLowered(place) {
        if ltree.lKindOf(place) == .optionalValue {
            let i = ltree.lIndexOf(place)
            let span = l.tree.optionalValues[i].span
            let type = l.tree.optionalValues[i].type
            let optional = lowerStable(ref c, through: ref l, for: l.tree.optionalValues[i].optional)
            return ltree.addLOptionalValue(ref l.tree, from: T5LOptionalValue { span: span, optional: optional, type: type })
        }
    } else {
        let i = i64(place & 0xFFFFFFFF)
        switch semantics.boundKind(place) {
            case .field:
                let span = c.bFields[i].span
                let field = c.bFields[i].field
                let type = c.bFields[i].type
                let receiver = lowerStable(ref c, through: ref l, for: c.bFields[i].receiver)
                return t5Copied(ref c, from: place, as: semantics.addField(ref c, from: BField { span: span, receiver: receiver, field: field, type: type }))
            case .tupleElement:
                let span = c.bTupleElements[i].span
                let index = c.bTupleElements[i].index
                let type = c.bTupleElements[i].type
                let receiver = lowerStable(ref c, through: ref l, for: c.bTupleElements[i].receiver)
                return t5Copied(ref c, from: place, as: semantics.addTupleElement(ref c, from: BTupleElement { span: span, receiver: receiver, index: index, type: type }))
            // A list's elements live behind its pointer, so a copy of a non-addressable list still names them.
            case .index:
                let span = c.bIndexes[i].span
                let fromEnd = c.bIndexes[i].fromEnd
                let type = c.bIndexes[i].type
                let index = c.bIndexes[i].index
                let target = lowerStable(ref c, through: ref l, for: c.bIndexes[i].target)
                let at = isTrivial(in c, through: in l, for: index) ? index : spill(ref c, through: ref l, for: index)
                return t5Copied(ref c, from: place, as: semantics.addIndex(ref c, from: BIndex { span: span, target: target, index: at, fromEnd: fromEnd, type: type }))
            case .builtinCall:
                let member = c.bBuiltinCalls[i].member
                if member == .mapIndexSet || member == .mapSlot {
                    let receiver = lowerStable(ref c, through: ref l, for: c.bBuiltinCalls[i].receiver)
                    var arguments = List<BExpr>()
                    for k in 0..c.bBuiltinCalls[i].arguments.length {
                        let a = c.bBuiltinCalls[i].arguments[k]
                        arguments.append(isTrivial(in c, through: in l, for: a) ? a : spill(ref c, through: ref l, for: a))
                    }
                    return t5Builtin(ref c, from: place, as: member, to: receiver, by: move arguments)
                }
            default: break
        }
    }
    return isTrivial(in c, through: in l, for: place) || isLvalue(in c, through: in l, for: place) ? place : spill(ref c, through: ref l, for: place)
}

/// Lowerer.cs:1621 `Write` (Q845): the lowered write of interpolated `text` to `sink` (`target` -1 when the sink has none) for `call`.
public BExpr lowerWrite(ref Ctx c, through ref LCtx l, for BExpr call, by ltree.WriteSink sink, to BExpr target, as BExpr text) uses alloc {
    return lowerWriteParts(ref c, through: ref l, for: call, by: sink, to: target, as: text)
}

/// Lowerer.cs:1624 `WriteParts` (Q845): as `lowerWrite`, with `level` (a log level or print stream, -1 for none) lowered after the parts and written as the target.
public BExpr lowerWriteParts(ref Ctx c, through ref LCtx l, for BExpr call, by ltree.WriteSink sink, to BExpr target, as BExpr text, at BExpr level = -1) uses alloc {
    let ti = i64(text & 0xFFFFFFFF)
    let span = ltree.spanOf(in c, through: in l.tree, for: call)
    var values = List<BExpr>()
    for k in 0..c.bInterpolateds[ti].parts.length {
        let v = c.bInterpolateds[ti].parts[k].value
        if v == -1 { continue }
        // A `Symbol` writes its text (spec 008 R4).
        let t = ltree.typeOf(in c, through: in l.tree, for: v)
        if semantics.kindOf(t) == .builtin && semantics.builtinKindOf(i64(t & 0xFFFFFFFF)) == .symbol {
            values.append(semantics.addBuiltinCall(ref c, from: BBuiltinCall { span: ltree.spanOf(in c, through: in l.tree, for: v), member: .symbolText, receiver: v, type: semantics.prim(.string) }))
        } else {
            values.append(v)
        }
    }
    if level != -1 { values.append(level) }
    var lowered = List<BExpr>()
    unless operands(ref c, through: ref l, for: in values, as: in List<bool>(), to: ref lowered) {
        return ltree.addLNever(ref l.tree, from: T5LNever { span: span, type: ltree.typeOf(in c, through: in l.tree, for: call) })
    }
    var written = target
    if level != -1 {
        written = lowered[lowered.length - 1]
        unless isTrivial(in c, through: in l, for: written) {
            // Spilling the target evaluates it ahead of the call (the emitter would evaluate it last inside the
            // call), so the parts before it are spilled first to keep them evaluated before it.
            for j in 0..lowered.length - 1 {
                unless isTrivial(in c, through: in l, for: lowered[j]) { lowered[j] = spill(ref c, through: ref l, for: lowered[j]) }
            }
            written = spill(ref c, through: ref l, for: written)
        }
    }
    var parts = List<BInterpolationPart>()
    var next: i64 = 0
    for k in 0..c.bInterpolateds[ti].parts.length {
        let p = c.bInterpolateds[ti].parts[k]
        if p.value == -1 {
            parts.append(p)
        } else {
            parts.append(BInterpolationPart { text: p.text, value: lowered[next], spec: p.spec })
            next += 1
        }
    }
    emit(ref l, for: ltree.addLWrite(ref l.tree, from: T5LWrite { span: span, sink: sink, target: written, parts: move parts }))
    return ltree.addLVoid(ref l.tree, from: T5LVoid { span: span })
}

/// Lowerer.cs:1652 `SwitchExpr` (Q845): the lowered switch expression `e`, with its statements appended to the current output list.
public BExpr lowerSwitchExpr(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let si = i64(e & 0xFFFFFFFF)
    let span = c.bSwitchExprs[si].span
    let type = c.bSwitchExprs[si].type
    var value = lowerExpr(ref c, through: ref l, for: c.bSwitchExprs[si].value)
    if isNeverExpr(value) { return value }
    unless isRepeatable(in c, through: in l, for: value) { value = spill(ref c, through: ref l, for: value) }
    let result: LocalId = semantics.isNever(type) ? -1 : newTemp(ref c, through: ref l, for: type)
    let end = newLabel(ref l, for: "switch_end")
    for k in 0..c.bSwitchExprs[si].arms.length {
        let arm = c.bSwitchExprs[si].arms[k]
        let match = lowerMatch(ref c, through: ref l, for: arm.pattern, at: value)
        captureBegin(ref l)
        lowerClaim(ref c, through: ref l, for: arm.pattern)
        let v = lowerExpr(ref c, through: ref l, for: arm.value)
        if result != -1 {
            emitAssign(ref c, through: ref l, to: localExpr(ref c, at: arm.span, for: result), as: v)
        } else {
            emitEffect(ref c, through: ref l, for: v)
        }
        emit(ref l, for: ltree.addLGoto(ref l.tree, from: T5LGoto { span: arm.span, label: end }))
        let body = captureEnd(ref l)
        if arm.guard == -1 {
            emit(ref l, for: semantics.addIf(ref c, from: BIf { span: arm.span, condition: match, then: block(ref c, at: arm.span, for: move body) }))
            continue
        }
        var pre = List<BStmt>()
        let guard = captureExpr(ref c, through: ref l, for: arm.guard, lvalue: false, to: ref pre)
        if pre.length == 0 {
            emit(ref l, for: semantics.addIf(ref c, from: BIf { span: arm.span, condition: andExpr(ref c, through: in l, for: match, by: guard), then: block(ref c, at: arm.span, for: move body) }))
        } else {
            pre.append(semantics.addIf(ref c, from: BIf { span: arm.span, condition: guard, then: block(ref c, at: arm.span, for: move body) }))
            emit(ref l, for: semantics.addIf(ref c, from: BIf { span: arm.span, condition: match, then: block(ref c, at: arm.span, for: move pre) }))
        }
    }
    emit(ref l, for: ltree.addLPanic(ref l.tree, from: T5LPanic { span: span, message: "no switch arm matched" }))
    emit(ref l, for: ltree.addLLabel(ref l.tree, from: T5LLabel { span: span, name: end }))
    if result == -1 { return ltree.addLNever(ref l.tree, from: T5LNever { span: span, type: type }) }
    return localExpr(ref c, at: span, for: result)
}

/// Lowerer.cs:1692 `TryFrom` (Q845): the lowered `T.tryFrom` conversion `e`, with its statements appended to the current output list.
public BExpr lowerTryFrom(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let ti = i64(e & 0xFFFFFFFF)
    let span = c.bTryFroms[ti].span
    let target = c.bTryFroms[ti].target
    let type = c.bTryFroms[ti].type
    var value = lowerExpr(ref c, through: ref l, for: c.bTryFroms[ti].operand)
    if isNeverExpr(value) { return value }
    unless isRepeatable(in c, through: in l, for: value) { value = spill(ref c, through: ref l, for: value) }
    let from = ltree.typeOf(in c, through: in l.tree, for: value)
    var fits: BExpr = -1
    if semantics.isInteger(target) && semantics.isFloat(from) {
        let r = semantics.range(semantics.primKindOf(i64(target & 0xFFFFFFFF)))
        let min = semantics.bigToF64(r.min)
        let max = semantics.bigToF64(r.max)
        // A value above min - 1 truncates into range; when min - 1 rounds to min in `from` (i64 from f64, i32
        // from f32) no value lies between them, so the bound is min itself, inclusive.
        let below = from == semantics.prim(.f32) ? f64(f32(min - 1.0)) : min - 1.0
        if below == min {
            fits = t5Check(ref c, through: in l, at: span, for: fits, by: .ge, to: value, as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .real, real: min }))
        } else {
            fits = t5Check(ref c, through: in l, at: span, for: fits, by: .gt, to: value, as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .real, real: below }))
        }
        fits = t5Check(ref c, through: in l, at: span, for: fits, by: .lt, to: value, as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .real, real: max + 1.0 }))
    } else if semantics.isInteger(target) {
        let r = semantics.range(semantics.primKindOf(i64(target & 0xFFFFFFFF)))
        let fr = semantics.range(semantics.primKindOf(i64(from & 0xFFFFFFFF)))
        if semantics.bigCmp(fr.min, as: r.min) < 0 {
            fits = t5Check(ref c, through: in l, at: span, for: fits, by: .ge, to: value, as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .integer, integer: r.min }))
        }
        if semantics.bigCmp(r.max, as: fr.max) < 0 {
            fits = t5Check(ref c, through: in l, at: span, for: fits, by: .le, to: value, as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .integer, integer: r.max }))
        }
    }
    let converted = from == target ? value : semantics.addConversion(ref c, from: BConversion { span: span, operand: value, type: target, kind: .numericCast })
    let some = semantics.addConversion(ref c, from: BConversion { span: span, operand: converted, type: type, kind: .toOptional })
    if fits == -1 { return some }
    let none = semantics.addDefault(ref c, from: BDefault { span: span, type: type })
    return lowerExpr(ref c, through: ref l, for: semantics.addConditional(ref c, from: BConditional { span: span, condition: fits, whenTrue: some, whenFalse: none, type: type }))
}
