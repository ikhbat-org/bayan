/* ── Maps ────────────────────────────────────────────────────────────────── */

/* The 128-bit key of every key hash (low and high halves); `main` sets it (0 under `--test`, else from the OS CSPRNG). */
extern uint64_t byn_hash_seed;
extern uint64_t byn_hash_seed_hi;
