// The coverage half of the quality report of the self-hosted driver (spec 017 T11). Ports `QualityReport.cs` :109 `Coverage`,
// :150 `Json` with :228 `WriteCoverage` (the coverage form), :332 `Listing`, :344 `Percent`, :347 `CoverageSummary`, and
// `Gates.cs` :15 `Coverage`, :43 `Add`, :51 `Fmt`. The mutation half (T13): `QualityReport.cs` :47 `Suggest`, :70 and :77
// `Mutation` (the external form and the shared one), :150 `Json` (the mutation form), :314 `Summary`, and `Gates.cs` :32
// `Mutation`. The JSON is `Utf8JsonWriter`'s indented form (testreport.byn `T11Json`).

import emitter

/// `ReportBranch` (QualityReport.cs:18): `status` is hit, missed or unknown.
struct QualityBranch {
    i64 line
    i64 column
    bool outcome
    string status
}

/// `ReportErrorPath` (QualityReport.cs:21).
struct QualityErrorPath {
    string function
    string variant
    bool hit = false
    bool unknown = false
    List<string> origins = List<string>()
}

/// `FileCoverage` (QualityReport.cs:24) with the `ReportFile` path (:34).
struct QualityFile {
    string path
    List<i64> coveredLines = List<i64>()
    List<i64> missedLines = List<i64>()
    List<i64> unknownLines = List<i64>()
    List<QualityBranch> branches = List<QualityBranch>()
    List<QualityErrorPath> errorPaths = List<QualityErrorPath>()
}

/// `Tally` (QualityReport.cs:28).
struct QualityTally {
    i64 covered = 0
    i64 total = 0
}

/// A coverage `QualityReport` (QualityReport.cs:40, `Kind` "coverage"): the timing in nanoseconds (`ReportTiming.BuildSeconds`, `TotalSeconds`).
struct QualityReport {
    string tool
    i64 buildNanos = 0
    i64 totalNanos = 0
    List<QualityFile> files = List<QualityFile>()
    QualityTally lines = QualityTally {}
    QualityTally branches = QualityTally {}
    QualityTally errorPaths = QualityTally {}
}

/// `GateFailure` (Gates.cs:6): `Percent` is `100.0 * covered / total`.
struct GateFailure {
    string name
    i64 covered
    i64 total
    i64 min
    List<string> missing = List<string>()
}

/// QualityReport.cs:109 `Coverage`: `hits` merged over every test; when `timedOut` a counter nobody hit is unknown, never missed.
QualityReport qualityCoverage(string tool, by in emitter.CoverageMap map, from in Map<i64, u64> hits, for bool timedOut, through i64 buildNanos, as i64 totalNanos) uses alloc {
    let unhit = timedOut ? "unknown" : "missed"
    var report = QualityReport { tool: tool, buildNanos: buildNanos, totalNanos: totalNanos }
    // `GroupBy(c => c.File)`: the files in first-appearance order.
    var fileIndex: Map<string, i64> = []
    for c in map.counters {
        // std modules (`<std>/...`) are the compiler's own source: they are no part of the package's coverage or its gate
        if c.file.startsWith("<std>/") { continue }
        unless fileIndex.contains(c.file) {
            fileIndex[c.file] = report.files.length
            report.files.append(QualityFile { path: c.file })
        }
    }
    for f in 0..report.files.length {
        let path = report.files[f].path
        // `GroupBy(c => c.Line).OrderBy(g => g.Key)`: a line is covered when every counter on it was hit.
        var lineHit: Map<i64, bool> = []
        for c in map.counters {
            if c.file != path || c.kind != "line" { continue }
            let hit = hits.contains(c.id)
            lineHit[c.line] = (lineHit.tryGet(at: c.line) ?? true) && hit
        }
        var lineKeys = List<i64>()
        for (line, _) in lineHit { lineKeys.append(line) }
        lineKeys.sort()
        for line in lineKeys {
            if lineHit[line] {
                report.files[f].coveredLines.append(line)
            } else if timedOut {
                report.files[f].unknownLines.append(line)
            } else {
                report.files[f].missedLines.append(line)
            }
        }
        for c in map.counters {
            if c.file != path || c.kind != "branch" { continue }
            report.files[f].branches.append(QualityBranch { line: c.line, column: c.column, outcome: c.outcome == true, status: hits.contains(c.id) ? "hit" : unhit })
        }
        // `GroupBy(c => (c.Function!, c.Variant!))`, in first-appearance order.
        var errorIndex: Map<string, i64> = []
        for c in map.counters {
            if c.file != path || c.kind != "error" { continue }
            let function = c.function ?? ""
            let variant = c.variant ?? ""
            let key = $"{function}\u{0}{variant}"
            unless errorIndex.contains(key) {
                errorIndex[key] = report.files[f].errorPaths.length
                report.files[f].errorPaths.append(QualityErrorPath { function: function, variant: variant })
            }
            let e = errorIndex[key]
            if hits.contains(c.id) {
                report.files[f].errorPaths[e].hit = true
                report.files[f].errorPaths[e].origins.append($"{c.origin ?? ""} {c.line}:{c.column}")
            }
        }
        for e in 0..report.files[f].errorPaths.length {
            report.files[f].errorPaths[e].unknown = timedOut && !report.files[f].errorPaths[e].hit
        }
    }
    for f in report.files {
        report.lines.covered += f.coveredLines.length
        report.lines.total += f.coveredLines.length + f.missedLines.length + f.unknownLines.length
        report.branches.covered += qualityHitBranches(in f)
        report.branches.total += f.branches.length
        report.errorPaths.covered += qualityHitErrorPaths(in f)
        report.errorPaths.total += f.errorPaths.length
    }
    return report
}

/// `f.Branches.Count(b => b.Status == "hit")`.
i64 qualityHitBranches(in QualityFile f) {
    var n: i64 = 0
    for b in f.branches {
        if b.status == "hit" { n += 1 }
    }
    return n
}

/// `f.ErrorPaths.Count(e => e.Hit)`.
i64 qualityHitErrorPaths(in QualityFile f) {
    var n: i64 = 0
    for e in f.errorPaths {
        if e.hit { n += 1 }
    }
    return n
}

/// QualityReport.cs:150 `Json` of a coverage report: `bayan-quality.json`.
string qualityJson(in QualityReport r) uses alloc {
    var w = T11Json {}
    t11JsonOpen(ref w, for: null, by: "{")
    t11JsonValue(ref w, for: "version", by: "1")
    t11JsonValue(ref w, for: "kind", by: t11JsonString("coverage"))
    t11JsonValue(ref w, for: "tool", by: t11JsonString(r.tool))
    t11JsonOpen(ref w, for: "timing", by: "{")
    t11JsonValue(ref w, for: "build_s", by: t11JsonSeconds(r.buildNanos))
    t11JsonValue(ref w, for: "total_s", by: t11JsonSeconds(r.totalNanos))
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "files", by: "[")
    for f in r.files {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "path", by: t11JsonString(f.path))
        qualityWriteCoverage(ref w, for: in f)
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
    t11JsonOpen(ref w, for: "totals", by: "{")
    t11JsonTally(ref w, for: "lines", by: in r.lines)
    t11JsonTally(ref w, for: "branches", by: in r.branches)
    t11JsonTally(ref w, for: "errorPaths", by: in r.errorPaths)
    t11JsonClose(ref w, by: "}")
    t11JsonClose(ref w, by: "}")
    return $"{t11JsonText(in w)}\n"
}

/// QualityReport.cs:207-213: one tally of `totals`.
void t11JsonTally(ref T11Json w, for string name, by in QualityTally tally) uses alloc {
    t11JsonOpen(ref w, for: name, by: "{")
    t11JsonValue(ref w, for: "covered", by: $"{tally.covered}")
    t11JsonValue(ref w, for: "total", by: $"{tally.total}")
    t11JsonClose(ref w, by: "}")
}

/// QualityReport.cs:228 `WriteCoverage`.
void qualityWriteCoverage(ref T11Json w, for in QualityFile f) uses alloc {
    t11JsonOpen(ref w, for: "lines", by: "{")
    t11JsonValue(ref w, for: "covered", by: $"{f.coveredLines.length}")
    t11JsonValue(ref w, for: "total", by: $"{f.coveredLines.length + f.missedLines.length + f.unknownLines.length}")
    t11JsonOpen(ref w, for: "missed", by: "[")
    for l in f.missedLines { t11JsonValue(ref w, for: null, by: $"{l}") }
    t11JsonClose(ref w, by: "]")
    t11JsonOpen(ref w, for: "unknown", by: "[")
    for l in f.unknownLines { t11JsonValue(ref w, for: null, by: $"{l}") }
    t11JsonClose(ref w, by: "]")
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "branches", by: "{")
    t11JsonValue(ref w, for: "covered", by: $"{qualityHitBranches(in f)}")
    t11JsonValue(ref w, for: "total", by: $"{f.branches.length}")
    for status in ["missed", "unknown"] {
        t11JsonOpen(ref w, for: status, by: "[")
        for b in f.branches {
            if b.status != status { continue }
            t11JsonOpen(ref w, for: null, by: "{")
            t11JsonValue(ref w, for: "line", by: $"{b.line}")
            t11JsonValue(ref w, for: "column", by: $"{b.column}")
            t11JsonValue(ref w, for: "outcome", by: b.outcome ? "true" : "false")
            t11JsonClose(ref w, by: "}")
        }
        t11JsonClose(ref w, by: "]")
    }
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "errorPaths", by: "[")
    for e in f.errorPaths {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "function", by: t11JsonString(e.function))
        t11JsonValue(ref w, for: "variant", by: t11JsonString(e.variant))
        t11JsonValue(ref w, for: "hit", by: e.hit ? "true" : "false")
        if e.unknown { t11JsonValue(ref w, for: "unknown", by: "true") }
        t11JsonOpen(ref w, for: "origins", by: "[")
        for o in e.origins { t11JsonValue(ref w, for: null, by: t11JsonString(o)) }
        t11JsonClose(ref w, by: "]")
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
}

/// QualityReport.cs:332 `Listing`: `+` hit, `-` missed, `~` unknown, blank for no counter, then the source line.
string qualityListing(in QualityFile f, from in List<string> sourceLines) uses alloc {
    var sb = StrBuf()
    for i in 0..sourceLines.length {
        let n = i + 1
        let gutter = t11Has(in f.coveredLines, for: n) ? "+" : t11Has(in f.missedLines, for: n) ? "-" : t11Has(in f.unknownLines, for: n) ? "~" : " "
        sb.append($"{gutter} {sourceLines[i]}\n")
    }
    return $"{sb.finish()}"
}

/// QualityReport.cs:344 `Percent`.
string qualityPercent(in QualityTally t) uses alloc => t.total == 0 ? "100%" : $"{gatesFmt(t.covered, by: t.total)}%"

/// QualityReport.cs:347 `CoverageSummary`.
string qualityCoverageSummary(in QualityReport r) uses alloc {
    var sb = StrBuf()
    sb.append($"coverage: lines {r.lines.covered}/{r.lines.total} ({qualityPercent(in r.lines)}), branches {r.branches.covered}/{r.branches.total} ({qualityPercent(in r.branches)}), error paths {r.errorPaths.covered}/{r.errorPaths.total} ({qualityPercent(in r.errorPaths)})\n")
    for f in r.files {
        let lines = f.coveredLines.length + f.missedLines.length + f.unknownLines.length
        sb.append($"  {f.path}: lines {f.coveredLines.length}/{lines}, branches {qualityHitBranches(in f)}/{f.branches.length}, error paths {qualityHitErrorPaths(in f)}/{f.errorPaths.length}\n")
        for b in f.branches {
            if b.status == "hit" { continue }
            sb.append($"{b.status == "missed" ? "uncovered" : "unknown"} branch: {f.path}:{b.line}:{b.column} never {b.outcome ? "true" : "false"}\n")
        }
        for e in f.errorPaths {
            if e.hit { continue }
            sb.append($"{e.unknown ? "unknown" : "uncovered"} error path: {f.path}: {e.function} {e.variant}\n")
        }
    }
    return $"{sb.finish()}"
}

/// Gates.cs:15 `Coverage`: the measures below their minimum percentages (null: no minimum).
List<GateFailure> gatesCoverage(in QualityReport report, by i64? minLines, for i64? minBranches, through i64? minErrorPaths) uses alloc {
    var failures = List<GateFailure>()
    var covered: i64 = 0
    var missing = List<string>()
    for f in report.files {
        covered += f.coveredLines.length
        for l in f.missedLines { missing.append($"uncovered line: {f.path}:{l}") }
    }
    gatesAdd(ref failures, for: "lines", by: minLines, through: covered, from: move missing)
    covered = 0
    var branches = List<string>()
    for f in report.files {
        covered += qualityHitBranches(in f)
        for b in f.branches {
            if b.status == "missed" { branches.append($"uncovered branch: {f.path}:{b.line}:{b.column} never {b.outcome ? "true" : "false"}") }
        }
    }
    gatesAdd(ref failures, for: "branches", by: minBranches, through: covered, from: move branches)
    covered = 0
    var errors = List<string>()
    for f in report.files {
        covered += qualityHitErrorPaths(in f)
        for e in f.errorPaths {
            if !e.hit && !e.unknown { errors.append($"uncovered error path: {e.function} {e.variant} ({f.path})") }
        }
    }
    gatesAdd(ref failures, for: "error paths", by: minErrorPaths, through: covered, from: move errors)
    return failures
}

/// Gates.cs:43 `Add`: the missing count is `missing`'s length unless `missingCount` is given.
void gatesAdd(ref List<GateFailure> failures, for string name, by i64? min, through i64 covered, from move List<string> missing, i64? missingCount = null) uses alloc {
    let total = covered + (missingCount ?? missing.length)
    let m = min ?? return
    if covered * 100 >= m * total { return }
    failures.append(GateFailure { name: name, covered: covered, total: total, min: m, missing: move missing })
}

/// Gates.cs:32 `Mutation`: (killed + timeout) / (killed + timeout + survived) against the minimum; each survivor named.
List<GateFailure> gatesMutation(in MutationReport report, by i64? minMutation) uses alloc {
    var failures = List<GateFailure>()
    var missing = List<string>()
    for f in report.files {
        for m in f.mutants {
            if m.status == "survived" { missing.append($"survived mutant: {m.site.file}:{m.site.line}:{m.site.column} {m.site.op} `{m.site.original}` -> `{m.site.mutated}`") }
        }
    }
    gatesAdd(ref failures, for: "mutation", by: minMutation, through: report.totals[0] + report.totals[2], from: move missing, missingCount: report.totals[1])
    return failures
}

/// Gates.cs:51 `Fmt` of `100.0 * covered / total` (`0.###`): rounded to thousandths, half away from zero, trailing zeros dropped.
string gatesFmt(i64 covered, by i64 total) uses alloc {
    let thousandths = (200000 * covered + total) / (2 * total)
    let whole = thousandths / 1000
    let rest = thousandths % 1000
    if rest == 0 { return $"{whole}" }
    var digits = rest < 10 ? $"00{rest}" : rest < 100 ? $"0{rest}" : $"{rest}"
    while digits.endsWith("0") { digits = digits[0..digits.length - 1] }
    return $"{whole}.{digits}"
}

/// `IReadOnlyList<int>.Contains` (QualityReport.cs:338).
bool t11Has(in List<i64> xs, for i64 x) {
    for y in xs {
        if y == x { return true }
    }
    return false
}

/// `ReportMutant` (QualityReport.cs:15): `status` is killed, survived, timeout, marked or not_reached.
struct ReportMutant {
    ExternalSite site
    string status
    i64? killedBy = null
    string? suggestion = null
}

/// `ReportFile` (QualityReport.cs:34) of a mutation report.
struct MutationFile {
    string path
    List<ReportMutant> mutants = List<ReportMutant>()
}

/// One entry of `Operators` (QualityReport.cs:41): the operator and its counts in `Counts` order.
struct MutationOperator {
    string op
    List<i64> counts = [0, 0, 0, 0, 0, 0]
}

/// A mutation `QualityReport` (QualityReport.cs:40, `Kind` "mutation"): build and total time in nanoseconds, the rest of
/// `ReportTiming` in seconds; `totals` and each operator's counts in `Counts` order.
struct MutationReport {
    string tool
    i64 buildNanos = 0
    i64 totalNanos = 0
    f64 mean = 0.0
    f64 max = 0.0
    f64 share = 0.0
    List<MutationFile> files = List<MutationFile>()
    List<i64> totals = [0, 0, 0, 0, 0, 0]
    List<MutationOperator> operators = List<MutationOperator>()
}

/// QualityReport.cs:43 `Counts`.
List<string> qualityCounts() uses alloc => ["killed", "survived", "timeout", "marked", "not_reached", "not_emitted"]

/// QualityReport.cs:47 `Suggest`: the sentence that says what test is missing, one per operator.
string qualitySuggest(string op) {
    switch op {
        case "boundary":
            return "add a case at the boundary value"
        case "relational":
            return "add a case where the two operands are equal and one where they differ"
        case "logical":
            return "add a case where exactly one operand holds"
        case "condition":
            return "add a case where the condition is false and one where it is true, and assert the difference"
        case "bool":
            return "add a case that depends on this value"
        case "arithmetic":
            return "add a case whose result differs under the changed operator"
        case "literal":
            return "add a case that depends on this exact number"
        case "negation":
            return "add a case with a non-zero operand and assert the sign"
        case "statement":
            return "assert the effect of this statement"
        case "emptyReturn":
            return "assert the returned value is not the empty value"
        case "variant":
            return "add a case that asserts which error variant is returned"
        default:
            return "add a case that fails under this change"
    }
}

/// QualityReport.cs:70 `Mutation` of an external-mode run (R3): the candidates not emitted are the results with that status.
MutationReport qualityMutation(string tool, from in List<ExternalResult> results, by i64 buildNanos, as i64 totalNanos) uses alloc {
    var notEmitted = List<MutationOperator>()
    var seconds = List<f64>()
    for r in results {
        if r.status != .notEmitted {
            seconds.append(r.seconds)
            continue
        }
        let k = qualityOperator(ref notEmitted, for: r.site.op)
        notEmitted[k].counts[5] += 1
    }
    return qualityMutationOf(tool, from: in results, by: in notEmitted, through: buildNanos, for: in seconds, as: totalNanos)
}

/// QualityReport.cs:77 `Mutation`; `notEmitted` carries each operator's count in its `not_emitted` slot.
MutationReport qualityMutationOf(string tool, from in List<ExternalResult> mutants, by in List<MutationOperator> notEmitted, through i64 buildNanos, for in List<f64> mutantSeconds, as i64 totalNanos) uses alloc {
    var report = MutationReport { tool: tool, buildNanos: buildNanos, totalNanos: totalNanos }
    var sum = 0.0
    for x in mutantSeconds {
        sum += x
        if x > report.max { report.max = x }
    }
    if mutantSeconds.length > 0 { report.mean = sum / f64(mutantSeconds.length) }
    let build = f64(buildNanos / 100) / 1e7
    if build > 0.0 { report.share = report.mean / build }
    for op in emitter.mutatorOperators() { let _ = qualityOperator(ref report.operators, for: op) }
    for n in notEmitted {
        let k = qualityOperator(ref report.operators, for: n.op)
        report.operators[k].counts[5] = n.counts[5]
    }
    for m in mutants {
        if m.status == .notEmitted { continue }
        let slot = qualitySlot(m.status)
        let k = qualityOperator(ref report.operators, for: m.site.op)
        report.operators[k].counts[slot] += 1
        var f: i64 = -1
        for i in 0..report.files.length {
            if report.files[i].path == m.site.file { f = i }
        }
        if f < 0 {
            f = report.files.length
            report.files.append(MutationFile { path: m.site.file })
        }
        report.files[f].mutants.append(ReportMutant { site: m.site, status: qualityCounts()[slot], suggestion: m.status == .survived ? qualitySuggest(m.site.op) : null })
    }
    for o in report.operators {
        for c in 0..6 { report.totals[c] += o.counts[c] }
    }
    return report
}

/// The index of `op` in `operators`, appended with zero counts when absent (the C# `Dictionary`, which keeps insertion order).
i64 qualityOperator(ref List<MutationOperator> operators, for string op) uses alloc {
    for i in 0..operators.length {
        if operators[i].op == op { return i }
    }
    operators.append(MutationOperator { op: op })
    return operators.length - 1
}

/// QualityReport.cs:139 `StatusName` as an index into `Counts`.
i64 qualitySlot(MutantStatus s) {
    switch s {
        case .killed:
            return 0
        case .survived:
            return 1
        case .timeout:
            return 2
        case .marked:
            return 3
        // coverage-exempt: Q1258 through `return 4` an external run's results are never not-reached
        case .notReached:
            return 4
        case .notEmitted:
            // coverage-exempt: Q1258 `Mutation` skips a not-emitted mutant before it asks for the name
            return 5
    }
}

/// QualityReport.cs:150 `Json` of a mutation report: `bayan-quality.json`.
string qualityMutationJson(in MutationReport r) uses alloc {
    var w = T11Json {}
    t11JsonOpen(ref w, for: null, by: "{")
    t11JsonValue(ref w, for: "version", by: "1")
    t11JsonValue(ref w, for: "kind", by: t11JsonString("mutation"))
    t11JsonValue(ref w, for: "tool", by: t11JsonString(r.tool))
    t11JsonOpen(ref w, for: "timing", by: "{")
    t11JsonValue(ref w, for: "build_s", by: r.buildNanos == 0 ? "0" : t11JsonSeconds(r.buildNanos))
    t11JsonValue(ref w, for: "mean_mutant_s", by: $"{r.mean}")
    t11JsonValue(ref w, for: "max_mutant_s", by: $"{r.max}")
    t11JsonValue(ref w, for: "total_s", by: t11JsonSeconds(r.totalNanos))
    t11JsonValue(ref w, for: "mutant_share_of_build", by: $"{r.share}")
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "files", by: "[")
    for f in r.files {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "path", by: t11JsonString(f.path))
        t11JsonOpen(ref w, for: "mutants", by: "[")
        for m in f.mutants {
            t11JsonOpen(ref w, for: null, by: "{")
            t11JsonOpen(ref w, for: "site", by: "{")
            t11JsonValue(ref w, for: "id", by: $"{m.site.id}")
            t11JsonValue(ref w, for: "file", by: t11JsonString(m.site.file))
            t11JsonValue(ref w, for: "line", by: $"{m.site.line}")
            t11JsonValue(ref w, for: "column", by: $"{m.site.column}")
            t11JsonValue(ref w, for: "operator", by: t11JsonString(m.site.op))
            t11JsonValue(ref w, for: "original", by: t11JsonString(m.site.original))
            t11JsonValue(ref w, for: "mutated", by: t11JsonString(m.site.mutated))
            if (m.site.unobservable is { } u) { t11JsonValue(ref w, for: "unobservable", by: t11JsonString(u)) }
            t11JsonClose(ref w, by: "}")
            t11JsonValue(ref w, for: "status", by: t11JsonString(m.status))
            // coverage-exempt: Q1257 only the blocked `MutationResult` form sets `killedBy`
            if (m.killedBy is { } k) { t11JsonValue(ref w, for: "killedBy", by: $"{k}") }
            if (m.suggestion is { } s) { t11JsonValue(ref w, for: "suggestion", by: t11JsonString(s)) }
            t11JsonClose(ref w, by: "}")
        }
        t11JsonClose(ref w, by: "]")
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
    qualityWriteCounts(ref w, for: "totals", by: in r.totals)
    t11JsonOpen(ref w, for: "operators", by: "{")
    for o in r.operators { qualityWriteCounts(ref w, for: o.op, by: in o.counts) }
    t11JsonClose(ref w, by: "}")
    t11JsonClose(ref w, by: "}")
    return $"{t11JsonText(in w)}\n"
}

/// QualityReport.cs:274 `WriteCounts`.
void qualityWriteCounts(ref T11Json w, for string name, by in List<i64> counts) uses alloc {
    t11JsonOpen(ref w, for: name, by: "{")
    let names = qualityCounts()
    for c in 0..6 { t11JsonValue(ref w, for: names[c], by: $"{counts[c]}") }
    t11JsonClose(ref w, by: "}")
}

/// QualityReport.cs:314 `Summary` with no warnings (its one caller, CliApp.cs:944, passes none; Q1258): totals, each survivor
/// with its suggestion, per-operator counts and timing.
string qualitySummary(in MutationReport r) uses alloc {
    var sb = StrBuf()
    sb.append($"mutation: {r.totals[0]} killed, {r.totals[1]} survived, {r.totals[2]} timeout, {r.totals[3]} marked, {r.totals[4]} not reached, {r.totals[5]} not emitted\n")
    for f in r.files {
        for m in f.mutants {
            if m.status != "survived" { continue }
            let s = m.site
            sb.append($"survived: {s.file}:{s.line}:{s.column}: {s.original} → {s.mutated} [{s.op}]\n  suggestion: {m.suggestion ?? ""}\n")
        }
    }
    sb.append("operators:\n")
    let names = qualityCounts()
    for o in r.operators {
        sb.append($"  {o.op}: ")
        for c in 0..6 { sb.append($"{c > 0 ? ", " : ""}{o.counts[c]} {names[c].replaced("_", by: " ")}") }
        sb.append("\n")
    }
    let build = f64(r.buildNanos / 100) / 1e7
    let total = f64(r.totalNanos / 100) / 1e7
    sb.append($"timing: build {qualityFmt(build)} s, mean {qualityFmt(r.mean)} s and max {qualityFmt(r.max)} s per mutant, total {qualityFmt(total)} s, mutant share of build {qualityFmt(r.share * 100.0)}%\n")
    return $"{sb.finish()}"
}

/// QualityReport.cs:311 `Fmt` (`0.###`) of a non-negative value: rounded to thousandths, trailing zeros dropped.
string qualityFmt(f64 v) uses alloc {
    let thousandths = i64(v * 1000.0 + 0.5)
    let whole = thousandths / 1000
    let rest = thousandths % 1000
    if rest == 0 { return $"{whole}" }
    var digits = rest < 10 ? $"00{rest}" : rest < 100 ? $"0{rest}" : $"{rest}"
    while digits.endsWith("0") { digits = digits[0..digits.length - 1] }
    return $"{whole}.{digits}"
}
