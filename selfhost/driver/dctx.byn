// Shared state of the driver (spec 012 D6): one `// ── Tn state` section per task.

// ── T1 state

/// The global options of `TakeGlobalOptions` (CliApp.cs:315). The terminal is never a tty here (R2: no colour), so `color` is checked and kept, and paints nothing.
struct DCtx {
    bool ascii = false
    string color = "auto"
}

/// The state of a run before any option is read.
DCtx newDCtx() {
    return DCtx {}
}
