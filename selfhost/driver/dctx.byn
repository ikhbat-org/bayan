// Shared state of the driver (spec 012 D6): one `// ── Tn state` section per task, inside `DCtx`.

/// Everything the driver reads and writes for one run. Each task adds its fields in its own `// ── Tn state` section.
public struct DCtx {
    // ── T1 state
    /// `--ascii` of `TakeGlobalOptions` (CliApp.cs:315), as given.
    bool ascii = false
    /// `--color` of `TakeGlobalOptions`, as given: auto, always or never.
    string color = "auto"
    /// `s_styleOut` of `Run` (CliApp.cs:29), decided from `color` and `ascii`.
    DStyle styleOut = DStyle {}
    /// `s_styleErr` of `Run` (CliApp.cs:30).
    DStyle styleErr = DStyle {}
    /// `s_stderrTty` of `Run` (CliApp.cs:31).
    bool stderrTty = false
}
