// `bayan cache stats` and `bayan clean` of the self-hosted driver (spec 017 T3). Ports `CliApp.cs` :595 `Cache`,
// `Toolchain.cs` :21-70 (`CacheDirectory`, `CacheData`, `Programs`, `Scripts`) and :518 `Stats`, and `Dist.cs` :226 `Clean`, :259 `Remove`.

/// What `bayan cache stats` reports (Toolchain.cs:19 `CacheStats`).
struct CacheStats {
    string directory = ""
    i64 programs = 0
    i64 bytes = 0
    i64 scripts = 0
}

/// Toolchain.cs:30 `CacheDirectory`: `$BAYAN_CACHE`; else `%LOCALAPPDATA%\bayan\cache` on Windows, `~/Library/Caches/bayan` on macOS, `$XDG_CACHE_HOME/bayan` or `~/.cache/bayan` elsewhere.
string cacheDirectory() uses alloc, env {
    let set = Env.get("BAYAN_CACHE") ?? ""
    if set.length > 0 { return set }
    // coverage-exempt: Q1083 through `let home`
    if Target.os == "windows" {
        return Path.combine(Path.combine(Env.get("LOCALAPPDATA") ?? "", "bayan"), "cache")
    }
    let home = Env.get("HOME") ?? ""
    // coverage-exempt: Q1083
    if Target.os == "macos" { return Path.combine(Path.combine(Path.combine(home, "Library"), "Caches"), "bayan") }
    // coverage-exempt: Q1083 through `return Path.combine(Path.combine(home, ".cache"), "bayan")`
    let xdg = Env.get("XDG_CACHE_HOME") ?? ""
    if xdg.length > 0 && Path.isRooted(xdg) { return Path.combine(xdg, "bayan") }
    return Path.combine(Path.combine(home, ".cache"), "bayan")
}

/// Toolchain.cs:60 `CacheData`: `<cache>/v1`.
string cacheData() uses alloc, env => Path.combine(cacheDirectory(), "v1")

/// The C# `Directory.Exists`: `path` lists.
bool t3DirectoryExists(string path) uses alloc, fs {
    let _ = Io.listDir(path) catch return false
    return true
}

/// `Directory.EnumerateFileSystemEntries`: the names in `dir`, none when it is missing or not a directory.
List<string> t3Entries(string dir) uses alloc, fs {
    let names = Io.listDir(dir) catch return List<string>()
    return names
}

/// Toolchain.cs:518 `Stats`.
CacheStats cacheStats() uses alloc, env, fs {
    var programs = 0
    var scripts = 0
    var bytes = 0
    let data = cacheData()
    let programsDir = Path.combine(data, "programs")
    let scriptsDir = Path.combine(data, "scripts")
    for name in t3Entries(programsDir) {
        let entry = Path.combine(programsDir, name)
        unless t3DirectoryExists(entry) { continue }
        programs += 1
        for file in t3Entries(entry) {
            let f = Path.combine(entry, file)
            unless t1FileExists(f) { continue }
            // coverage-exempt: Q1083 a file that lists but cannot be read (removed in between, or unreadable); `FileInfo.Length` needs no read
            let content = Io.readFile(f) catch continue
            bytes += content.length
        }
    }
    for name in t3Entries(scriptsDir) {
        if t1FileExists(Path.combine(scriptsDir, name)) && !name.endsWith(".tmp") { scripts += 1 }
    }
    return CacheStats { directory: cacheDirectory(), programs: programs, bytes: bytes, scripts: scripts }
}

/// CliApp.cs:595 `Cache`. `kept` is the command and its arguments.
i32 cacheCommand(List<string> kept) uses alloc, console, env, fs {
    if kept.length != 2 || kept[1] != "stats" {
        Io.stderr.write("usage: bayan cache stats   (`bayan clean --cache` empties it)\n")
        return exitUsage
    }
    let s = cacheStats()
    Io.stdout.write($"cache:    {s.directory}\n")
    // `{1:0.0}` of `Bytes / 1024.0 / 1024.0`: exact in binary, so half-up on the tenths is .NET's rounding.
    let tenths = (s.bytes * 10 + 524288) / 1048576
    Io.stdout.write($"programs: {s.programs} ({tenths / 10}.{tenths % 10} MB)\n")
    Io.stdout.write($"scripts:  {s.scripts}\n")
    return exitOk
}

/// `Io.remove` succeeded: it unlinks a file or a symlink (also one to a directory) and fails on a real directory.
bool t3Unlinked(string path) uses fs {
    Io.remove(path) catch return false
    return true
}

/// One entry of `Directory.Delete(dir, recursive: true)`, or `dir` itself: a link is removed and its target kept, as in the C#. A failure
/// panics with the `IoError` (the C# throws an unhandled exception, Q1085).
void t3RemoveEntry(string path) uses alloc, fs {
    if t3Unlinked(path) { return }
    if t3DirectoryExists(path) {
        t3RemoveTree(path)
        return
    }
    Io.remove(path) catch switch {
        IoError e => panic($"cannot remove {path}: {e}"),
    }
}

/// `Directory.Delete(dir, recursive: true)` of a real directory.
void t3RemoveTree(string dir) uses alloc, fs {
    for name in t3Entries(dir) { t3RemoveEntry(Path.combine(dir, name)) }
    Io.removeDirectory(dir) catch switch {
        IoError e => panic($"cannot remove {dir}: {e}"),
    }
}

/// Dist.cs:259 `Remove`.
void t3Remove(string dir, by string name) uses alloc, console, fs {
    unless t3DirectoryExists(dir) { return }
    t3RemoveEntry(dir)
    Io.stdout.write($"removed {name}\n")
}

/// Dist.cs:226 `Clean`. `kept` is the command and its arguments.
i32 cleanCommand(List<string> kept) uses alloc, console, env, fs {
    var path: string? = null
    var dist = false
    var cache = false
    for i in 1..kept.length {
        let a = kept[i]
        if a == "--dist" {
            dist = true
        } else if a == "--cache" {
            cache = true
        } else if a.startsWith("-") || path is not null {
            Io.stderr.write($"bayan: unexpected argument `{a}`\n")
            Io.stderr.write("usage: bayan clean [<dir>] [--dist] [--cache]\n")
            return exitUsage
        } else {
            path = a
        }
    }
    let given = path ?? "."
    let project = t1FileExists(Path.combine(given, "package.byn"))
    if !project && (path is not null || dist || !cache) {
        Io.stderr.write($"bayan: `{given}` isn't a project (no `package.byn`), so it has no out/ to clean\n")
        return exitUsage
    }
    if project {
        let root = Path.fullPath(given)
        t3Remove(Path.combine(root, "out"), by: "out/")
        if dist { t3Remove(Path.combine(root, "dist"), by: "dist/") }
    }
    if cache {
        let data = cacheData()
        t3Remove(data, by: data)
    }
    return exitOk
}

// ── 017 T9: the build cache. Ports `Toolchain.cs` :71-90 (`TagCacheDirectory`, `Scripts`, `Staging`), :237 (the key of
// `BuildCached`), :262-310 (`ReplaceFile`, `Lookup`), :361-460 (`Touch`, `Evict`, `SweepStale`, `Discard`), :462-516 (the script
// cache, `ComputeCompilerBuild`) and :556-562 (`Hash`, `HashFile`). What needs a rename, a write time or an executable bit is a
// stub (Q1111, Q1112).

/// Toolchain.cs:66 `CacheDirTag`, the CACHEDIR.TAG signature (bford.info/cachedir).
const cacheDirTag: string = "Signature: 8a477f597d28d172789f06886806bc55\n# This file is a cache directory tag created by bayan.\n# For information about cache directory tags see https://bford.info/cachedir/\n"

/// Toolchain.cs:62 `Programs`.
string t9Programs() uses alloc, env => Path.combine(cacheData(), "programs")

/// Toolchain.cs:71 `TagCacheDirectory`.
// stub: T9 tagCacheDirectory (blocked: Q1111) `File.Move(temp, tag, overwrite: false)` has no builtin
void tagCacheDirectory() uses alloc, env, fs {
}

/// Toolchain.cs:88 `Scripts`.
string t9Scripts() uses alloc, env => Path.combine(cacheData(), "scripts")

/// Toolchain.cs:90 `Staging`.
string t9Staging() uses alloc, env => Path.combine(cacheData(), "tmp")

/// The `BuildMode` name `string.Join` writes (Toolchain.cs:237, :499): `Debug`, `Safe` or `Fast`.
string t9ModeName(string mode) => mode == "debug" ? "Debug" : mode == "fast" ? "Fast" : "Safe"

/// Toolchain.cs:237: the key of a program, from the compiler version, mode, target, C compiler, flags, runtime and C source.
/// `target` is `target ?? Targets.Host`, which `string.Join` writes empty when null.
string t9Key(string mode, for string? target, by in List<string> compiler, through in List<string> flags, from string cSource) uses alloc {
    var sb = StrBuf()
    sb.append(version)
    sb.append("\0")
    sb.append(t9ModeName(mode))
    sb.append("\0")
    sb.append(target ?? "")
    sb.append("\0")
    sb.append(ccJoin(in compiler))
    sb.append("\0")
    sb.append(ccJoin(in flags))
    sb.append("\0")
    sb.append(runtimeHeader)
    sb.append("\0")
    sb.append(runtimeSource)
    sb.append("\0")
    sb.append(cSource)
    return t9Hash(sb.finish())
}

/// Toolchain.cs:262 `ReplaceFile(path, temp => File.Copy(source, temp))`, the one call (:254).
// stub: T9 replaceFile (blocked: Q1111) `File.Move(temp, path, overwrite: true)` has no builtin, and a copy has no executable bit
void replaceFile(string path, from string source) uses alloc, fs {
}

/// Toolchain.cs:289 `Lookup`: the cached executable for `key` if it is intact; a damaged entry is removed. A file that cannot be
/// read for want of permission fails (the C#'s `UnauthorizedAccessException` is not caught); any other read error is damage.
string? lookup(string key, by string exeName) fails IoError uses alloc, env, fs {
    let dir = Path.combine(t9Programs(), key)
    let exe = Path.combine(dir, exeName)
    let sum = Path.combine(dir, "program.sha256")
    unless t9DirectoryExists(dir) { return null }
    if Fs.fileExists(exe) && Fs.fileExists(sum) {
        let intact = try t9Intact(exe, by: sum)
        if intact {
            touch(dir)
            return exe
        }
    }
    try discard(dir)
    return null
}

/// `Directory.Exists`, which has no builtin (`Fs.fileExists` is `File.Exists`): a directory `Io.listDir` reads, or one it may not
/// read, as a 0300 directory that `Directory.Exists` holds to exist. Unlike `Directory.Exists`, a path under a parent that cannot be
/// searched counts too (Q1113).
bool t9DirectoryExists(string dir) uses alloc, fs {
    let _ = Io.listDir(dir) catch switch {
        IoError.permissionDenied => return true,
        IoError e => return false,
    }
    return true
}

/// The `char.IsWhiteSpace` set (as runes) `string.Trim()` removes.
List<rune> t9Whitespace() uses alloc {
    let ws: List<rune> = [
        '\u{9}', '\u{A}', '\u{B}', '\u{C}', '\u{D}', ' ', '\u{85}', '\u{A0}', '\u{1680}', '\u{2000}', '\u{2001}', '\u{2002}',
        '\u{2003}', '\u{2004}', '\u{2005}', '\u{2006}', '\u{2007}', '\u{2008}', '\u{2009}', '\u{200A}', '\u{2028}', '\u{2029}',
        '\u{202F}', '\u{205F}', '\u{3000}',
    ]
    return ws
}

/// `File.ReadAllText(path).Trim()`: the text without a leading UTF-8 byte order mark, trimmed of `char.IsWhiteSpace`.
string t9ReadTrimmed(string path) fails IoError uses alloc, fs {
    let text = try Io.readText(path)
    let body = text.startsWith("\u{FEFF}") ? text.runes.skip(1) : text
    let ws = t9Whitespace()
    return body.trimmed(by: ws.span).copy()
}

/// `File.ReadAllText(sum).Trim() == HashFile(exe)` of `Lookup`: false on an `IOException`, a failure on a permission error.
bool t9Intact(string exe, by string sum) fails IoError uses alloc, fs {
    let text = t9ReadTrimmed(sum) catch switch {
        IoError.permissionDenied => fail .permissionDenied,
        IoError e => return false,
    }
    let hash = t9HashFile(exe) catch switch {
        IoError.permissionDenied => fail .permissionDenied,
        // coverage-exempt: Q1113 an executable that exists and cannot be read for another reason (the C#'s `IOException` of `File.OpenRead`)
        IoError e => return false,
    }
    return text == hash
}

