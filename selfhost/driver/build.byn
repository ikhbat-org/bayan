// The commands `build` (with `--emit-c`) and `run` of the self-hosted driver (spec 012 T5). Ports `CliApp.cs` :151
// `ParseBuildOptions`, :259 `Compile` (its `--package` branch; the rest is `semantics/cli.byn` `t26Compile`), :409 `EmitC`,
// :422 `PrepareOut`, :434 `WriteIfChanged`, :458 `Build`, :505 `Phase`, :544 `RunProgram` and :573 `Start`. The C compiler
// runs through the build cache, cache.byn `t9Build` (spec 017 T9), which stages under the cache as `Toolchain.Compile` does.

import lexer
import semantics
import emitter

type T5T26Options = semantics.T26Options
type T5CompilationOptions = semantics.CompilationOptions

/// The `BuildOptions` (CliApp.cs:149) fields `build` and `run` read; the test-only ones stay C# (R3).
struct T5Options {
    string path
    string mode = "safe"
    string? output = null
    bool emitC = false
    bool json = false
    List<string> programArgs = List<string>()
    string? target = null
    bool verbose = false
    bool all = false
    string? package = null
}

/// The C# `Directory.Exists`: `path` lists.
bool t5DirectoryExists(string path) {
    let _ = Io.listDir(path) catch return false
    return true
}

/// CliApp.cs:151 `ParseBuildOptions` with `allowTestJson: false` (the `--changed`, `--base`, `--json`, `--mutate`, `--run`,
/// `--coverage` and `--only` arms are then the `default` arm's). Null after reporting.
T5Options? t5ParseBuildOptions(in List<string> args, by bool allowOutput, for bool allowVerbose) uses alloc, console, fs {
    var path: string? = null
    var output: string? = null
    var target: string? = null
    var package: string? = null
    var mode = "safe"
    var json = false
    var all = false
    var verbose = false
    var emitC = false
    var programArgs = List<string>()
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--" {
            for k in (i + 1)..args.length { programArgs.append(args[k]) }
            i = args.length
        } else if a == "--mode" && i + 1 < args.length {
            // Toolchain.cs:68 `TryParseMode`.
            i += 1
            mode = args[i]
            if mode != "debug" && mode != "safe" && mode != "fast" {
                Io.stderr.write($"bayan: unknown mode `{args[i]}` (expected debug, safe or fast)\n")
                return null
            }
        } else if a == "--diagnostics" && i + 1 < args.length {
            i += 1
            if args[i] == "json" {
                json = true
            } else if args[i] == "text" {
                json = false
            } else {
                Io.stderr.write($"bayan: unknown diagnostics format `{args[i]}` (expected json or text)\n")
                return null
            }
        } else if a == "-o" && allowOutput && i + 1 < args.length {
            i += 1
            output = args[i]
        } else if a == "--emit-c" && allowOutput {
            emitC = true
        } else if a == "--target" && allowOutput && i + 1 < args.length {
            i += 1
            target = args[i]
            if args[i] == "host" {
                target = null
            } else if !targetIsKnown(args[i]) {
                Io.stderr.write($"bayan: unknown target `{args[i]}` (expected host, {t5Join(in targetNames())})\n")
                return null
            }
        } else if a == "--all" {
            all = true
        } else if (a == "-v" || a == "--verbose") && allowVerbose {
            verbose = true
        } else if a == "--package" && i + 1 < args.length {
            i += 1
            package = args[i]
        } else {
            if path is not null || a.startsWith("-") {
                Io.stderr.write($"bayan: unexpected argument `{a}`\n")
                return null
            }
            path = a
        }
        i += 1
    }
    // `File.Exists("package.byn")`: a relative name resolves against the working directory.
    if path is null && t1FileExists("package.byn") { path = "." }
    if (path is not { } p) {
        Io.stderr.write("bayan: expected a file or directory (or run inside a project with a `package.byn`)\n")
        return null
    }
    if !t1FileExists(p) && !t5DirectoryExists(p) {
        Io.stderr.write($"bayan: not found: {p}\n")
        return null
    }
    return T5Options {
        path: p,
        mode: mode,
        output: output,
        emitC: emitC,
        json: json,
        programArgs: move programArgs,
        target: target,
        verbose: verbose,
        all: all,
        package: package,
    }
}

/// `string.Join(", ", xs)`.
string t5Join(in List<string> xs) {
    var sb = StrBuf()
    for i in 0..xs.length {
        if i > 0 { sb.append(", ") }
        sb.append(xs[i])
    }
    return $"{sb.finish()}"
}

/// The `BuildOptions` `t26Compile` and `t26Report` read.
T5T26Options t5T26(in T5Options o) => T5T26Options { path: o.path, json: o.json, all: o.all, target: o.target }

/// `Compilation.Diagnostics.HasErrors`.
bool t5HasErrors(in semantics.Ctx c) {
    for d in c.diagnostics {
        if !d.isWarning { return true }
    }
    return false
}

/// The `*.byn` files of `dir` in ordinal order, without the `*.test.byn` ones unless `includeTests` (Compilation.cs:155 `ModuleFiles`).
/// `Io.listDir` already returns the names in byte order (`bayan-rt.c` sorts them with `qsort` and `byn_str_order`).
List<string> t5ModuleFiles(string dir, bool includeTests = false) uses alloc, fs {
    var files = List<string>()
    // coverage-exempt: Q1018 reached only if the directory goes away between `t5DirectoryExists` and this read (a race no test can stage)
    let names = Io.listDir(dir) catch return files
    for name in names {
        let f = Path.combine(dir, name)
        if name.endsWith(".byn") && (includeTests || !name.endsWith(".test.byn")) && t1FileExists(f) { files.append(f) }
    }
    return files
}

/// CliApp.cs:262 `Compile` (`includeTests` is its parameter): the `--package <root>` branch, else `semantics/cli.byn` `t26Compile` (the project, script and
/// path branches). Prints diagnostics and adds them to `reported`; `ok` is false where the C# returns null. `ascii`, `width` and `isTty` are
/// the stderr ones of `StartProgress` (CliApp.cs:306); the callers in commands.byn, features.byn and build.byn pass the stderr ones of `DCtx`; only `t26Compile`'s project branch clears the line late (Q1116).
semantics.Ctx t5Compile(in T5Options o, by in semantics.T26Symbols symbols, to ref List<semantics.T26Reported> reported, through ref bool ok, bool includeTests = false, bool ascii = false, i64 width = 100, bool isTty = false) uses alloc, clock, console, env, fs {
    let style = DStyle { ascii: ascii, width: width }
    var progress = start(in style, by: isTty, through: o.json, for: "compiling")
    let o26 = t5T26(in o)
    let manifestPath = Path.combine(o.path, "package.byn")
    if (o.package is { } package) {
        if !(t5DirectoryExists(o.path) && t1FileExists(manifestPath)) {
            let full = Path.fullPath(o.path)
            var files = List<string>()
            if t5DirectoryExists(full) {
                files = t5ModuleFiles(full, includeTests: includeTests)
            } else {
                files.append(full)
            }
            var sources = List<lexer.SourceText>()
            for f in files {
                // coverage-exempt: Q1018 an unreadable module file; the C# `SourceText.FromFile` (CliApp.cs:294) throws there, uncaught
                let bytes = Io.readFile(f) catch List<u8>()
                sources.append(lexer.SourceText.create(f, from: move bytes))
            }
            let options = T5CompilationOptions { includeTests: includeTests, target: o.target }
            var c = semantics.create(from: move sources, at: Path.fullPath(package), by: in options)
            done(ref progress)
            semantics.t26Report(in o26, by: in symbols, for: ref c, to: ref reported)
            ok = !t5HasErrors(in c)
            return c
        }
    }
    if t5DirectoryExists(o.path) && t1FileExists(manifestPath) {
        // CliApp.cs:272 and :279 clear the line before the manifest diagnostics and the no-entry message, which `t26Compile` prints; the
        // driver clears it after them (blocked: Q1116)
        let compiled = semantics.t26Compile(in o26, by: in symbols, to: ref reported, through: ref ok, includeTests: includeTests)
        done(ref progress)
        return compiled
    }
    // The path branch, here rather than in `t26Compile`, so that `--target` reaches `CompilationOptions` (Q1018).
    let options = T5CompilationOptions { includeTests: includeTests, target: o.target }
    var c = semantics.fromPath(o.path, by: in options, wholeDirectory: !t1IsScript(o.path))
    done(ref progress)
    semantics.t26Report(in o26, by: in symbols, for: ref c, to: ref reported)
    ok = !t5HasErrors(in c)
    return c
}

/// CliApp.cs:409 `EmitC`: the C translation unit for an error-free compilation.
string t5EmitC(ref semantics.Ctx c, by string mode) uses alloc => emitter.t12Emit(ref c, by: mode)

/// CliApp.cs:435 `PrepareOut`: a project's `out/<mode>/<target>/`, with the emitted C written to its `c/`; null outside a
/// project.
string? t5PrepareOut(in semantics.Ctx compiled, by string mode, for string target, from string source) uses alloc, fs {
    if compiled.manifest is null { return null }
    let root = compiled.displayRoot
    let dir = Path.combine(Path.combine(Path.combine(root, "out"), mode), target)
    let c = Path.combine(dir, "c")
    // CliApp.cs:440 `Directory.CreateDirectory(c)` (Q1042 (a)): its exception is not caught, so the CLI dies with an
    // unhandled exception (exit 134); a panic aborts the same way (Q1018 (j)).
    Io.createDirectory(c) catch { panic($"cannot create the directory {c}") }
    t5WriteIfChanged(Path.combine(c, "main.c"), from: source)
    t5WriteIfChanged(Path.combine(c, "bayan-rt.h"), from: runtimeHeader)
    t5WriteIfChanged(Path.combine(c, "bayan-rt.c"), from: runtimeSource)
    return dir
}

/// CliApp.cs:434 `WriteIfChanged`. `Toolchain.ReplaceFile` (Toolchain.cs:220) writes through a temporary file and a rename,
/// which has no builtin; the file is written in place.
void t5WriteIfChanged(string path, from string text) uses alloc, fs {
    let old = Io.readText(path) catch ""
    if !t1FileExists(path) || old != text {
        // coverage-exempt: Q1018 the catch is reached only if a file under `out/` cannot be written (the C# throws there)
        Io.writeFile(path, text.bytes) catch return
    }
}

/// CliApp.cs:420 `HostTarget`.
string t5HostTarget() uses alloc => targetHost() ?? "host"

/// CliApp.cs:458 `Build`. `kept` is the command and its arguments.
i32 buildCommand(in List<string> kept, by ref DCtx d) uses alloc, clock, console, env, fs, process, random {
    let clock = Io.monotonicNanos()
    let args = t2Rest(kept)
    let o = t5ParseBuildOptions(in args, by: true, for: true) ?? return exitUsage
    let symbols = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    var compiled = t5Compile(in o, by: in symbols, to: ref reported, through: ref ok, ascii: d.styleErr.ascii, width: d.styleErr.width, isTty: d.stderrTty)
    unless ok { return semantics.t26Failed(in t5T26(in o), from: in reported, by: in symbols) }
    if refuseLibrary(compiled, by: "build") { return exitUsage }
    let emit = Io.monotonicNanos()
    let source = t5EmitC(ref compiled, by: o.mode)
    let emitTime = Io.monotonicNanos() - emit
    if o.emitC {
        Io.stdout.write(source)
        return exitOk
    }
    let target = o.target ?? t5HostTarget()
    var output = ""
    if (o.output is { } given) {
        output = given
    } else if (t5PrepareOut(in compiled, by: o.mode, for: target, from: source) is { } dir) {
        output = Path.combine(dir, targetExecutableName(semantics.programName(ref compiled, for: o.path), for: target))
    } else {
        output = targetExecutableName(semantics.programName(ref compiled, for: o.path), for: target)
    }
    let native = Io.monotonicNanos()
    var progress = start(in d.styleErr, by: d.stderrTty, through: o.json, for: "building")
    let built = t9Build(source, by: o.mode, to: output, for: o.target, through: ref d)
    done(ref progress)
    let nativeTime = Io.monotonicNanos() - native
    unless built.result.succeeded {
        t5ReportToolchain(built.result, by: o.json, for: symbols)
        return exitToolchain
    }
    if o.json { return exitOk }
    if o.verbose {
        print(t5Phase("parse", by: t5Paint(.note, by: d.styleOut, for: semantics.t26Seconds(compiled.parseTime))))
        print(t5Phase("check", by: t5Paint(.note, by: d.styleOut, for: semantics.t26Seconds(compiled.checkTime))))
        print(t5Phase("emit", by: t5Paint(.note, by: d.styleOut, for: semantics.t26Seconds(emitTime))))
        print(t5Phase("compile", by: t5Paint(.note, by: d.styleOut, for: built.hit ? "from cache" : semantics.t26Seconds(nativeTime))))
        let shown = compiled.manifest is not null && o.output is null ? Path.relative(compiled.displayRoot, to: output).replaced("\\", by: "/") : output
        print($"  {t5Paint(.note, by: d.styleOut, for: shown)}")
    }
    let dot = semantics.t26Symbols(d.styleOut.ascii).dot
    var summary = $"{dot} built {semantics.programName(ref compiled, for: o.path)} ({o.mode}, {target}) in {semantics.t26Seconds(Io.monotonicNanos() - clock)}"
    // `Messages.BuildFromCache` with `Symbols.Separator` (Style.cs:59-60).
    if built.hit { summary = $"{summary} {d.styleOut.ascii ? "-" : "·"} from cache" }
    print(t5Paint(.success, by: d.styleOut, for: summary))
    return exitOk
}

/// CliApp.cs:403 `ReportToolchain`: its `--diagnostics json` branch (:411-415), BYN4001 as one `DiagnosticJson.Render` line;
/// the text is cc.byn `ccReportToolchainBy`, in the stderr style.
void t5ReportToolchain(NativeBuild result, by bool json, for semantics.T26Symbols symbols) uses alloc, console {
    if !(json && result.rejected) {
        ccReportToolchainBy(result, by: in symbols)
        return
    }
    var c = CcCtx {
        files: List<semantics.SourceFile>(),
        modules: List<semantics.Mod>(),
        diagnostics: List<CcDiag>(),
        bags: List<semantics.DiagBag>(),
    }
    // DiagnosticCodes.cs:330 BYN4001, with no file and no span; `CcCtx` and the other aliases are cc.byn's (a qualified struct literal does not parse).
    c.diagnostics.append(CcDiag {
        code: "BYN4001",
        span: CcSpan { start: 0, length: 0 },
        fixSpan: CcSpan { start: 0, length: 0 },
        message: "internal compiler error: the C compiler rejected the generated C; this is a bug in the Bayan compiler",
        help: result.errors,
        related: List<CcRelated>(),
    })
    var reported = List<semantics.T26Reported>()
    semantics.t26Report(T5T26Options { path: "", json: true }, by: symbols, for: ref c, to: ref reported)
}

/// CliApp.cs:507 `Phase`: `Messages.PhaseLine` (`  {0,-11}{1}`).
string t5Phase(string name, by string value) uses alloc {
    var sb = StrBuf()
    sb.append("  ")
    sb.append(name)
    for _ in name.length..11 { sb.append(" ") }
    sb.append(value)
    return $"{sb.finish()}"
}

/// CliApp.cs:544 `RunProgram`. `args` is what follows `run` (a script run passes `[file, "--", ..rest]`, CliApp.cs:99).
i32 runProgram(in List<string> args, by ref DCtx d) uses alloc, clock, console, env, fs, process, random {
    let o = t5ParseBuildOptions(in args, by: false, for: false) ?? return exitUsage
    let host = t5HostTarget()
    var key: string? = null
    if t1IsScript(o.path) {
        // coverage-exempt: Q1018 the catch is reached only if the script changes between `t1IsScript` and this read (a race no test can stage)
        let bytes = Io.readFile(o.path) catch return exitFailure
        let scripted = scriptKey(bytes.span, by: o.mode, for: null)
        key = scripted
        if (lookupScript(scripted, by: targetExecutableName("program", for: host), through: ref d) is { } remembered) {
            return t5Start(remembered, by: in o.programArgs)
        }
    }
    let symbols = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    var compiled = t5Compile(in o, by: in symbols, to: ref reported, through: ref ok, ascii: d.styleErr.ascii, width: d.styleErr.width, isTty: d.stderrTty)
    unless ok { return semantics.t26Failed(in t5T26(in o), from: in reported, by: in symbols) }
    if refuseLibrary(compiled, by: "run") { return exitUsage }
    let source = t5EmitC(ref compiled, by: o.mode)
    var output: string? = null
    if (t5PrepareOut(in compiled, by: o.mode, for: host, from: source) is { } dir) {
        output = Path.combine(dir, targetExecutableName(semantics.programName(ref compiled, for: o.path), for: host))
    }
    var progress = start(in d.styleErr, by: d.stderrTty, through: o.json, for: "building")
    let built = t9Build(source, by: o.mode, to: output, for: null, through: ref d)
    done(ref progress)
    unless built.result.succeeded {
        t5ReportToolchain(built.result, by: o.json, for: symbols)
        return exitToolchain
    }
    if (key is { } k) { rememberScript(k, by: built.key, through: ref d) }
    return t5Start(built.exe, by: in o.programArgs)
}

/// CliApp.cs:573 `Start`: runs `executable` with `programArgs`; `Io.run` captures its output, written stdout then stderr
/// after it ends (spec Q5). A signal-killed program (a panic aborts) writes what it captured the same way and exits 128 + the
/// signal, as the C# shell reports it (Q1157).
i32 t5Start(string executable, by in List<string> programArgs) uses alloc, console, process {
    let r = Io.run(executable, programArgs.span) catch switch {
        .signaled(let s, let output, let errors) => {
            Io.stdout.write(output)
            Io.stderr.write(errors)
            return 128 + s
        },
        // coverage-exempt: Q1018 reached only if the just-built executable cannot be started; the C# `Process.Start` throws there
        IoError e => return exitFailure,
    }
    Io.stdout.write(r.stdout)
    Io.stderr.write(r.stderr)
    return r.exitCode
}
