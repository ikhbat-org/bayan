// SHA-256 (FIPS 180-4) over bytes for the self-hosted driver (spec 017 T9, plan D5): what `SHA256.HashData` returns, for the
// cache keys of `Toolchain.cs` :296, :624, :681-687 and `dist`'s inputs hash. Words are kept in `u64` below 2^32, so the
// additions mod 2^32 are a mask, not a wrap a `safe` build would trap on.

/// The round constants of FIPS 180-4 §4.2.2.
List<u64> t9RoundConstants() uses alloc {
    let k: List<u64> = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
    return k
}

/// A 32-bit word rotated right by `n`.
u64 t9Rotr(u64 x, by u64 n) => ((x >> n) | (x << (32 - n))) & 0xffffffff

/// One 64-byte block of `data` from `at` into the state `h` (FIPS 180-4 §6.2.2).
void t9Block(ref List<u64> h, from ReadOnlySpan<u8> data, at i64 start, by in List<u64> k, through ref List<u64> w) {
    for t in 0..16 {
        let i = start + t * 4
        w[t] = (u64(data[i]) << 24) | (u64(data[i + 1]) << 16) | (u64(data[i + 2]) << 8) | u64(data[i + 3])
    }
    for t in 16..64 {
        let s0 = t9Rotr(w[t - 15], by: 7) ^ t9Rotr(w[t - 15], by: 18) ^ (w[t - 15] >> 3)
        let s1 = t9Rotr(w[t - 2], by: 17) ^ t9Rotr(w[t - 2], by: 19) ^ (w[t - 2] >> 10)
        w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xffffffff
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..64 {
        let s1 = t9Rotr(e, by: 6) ^ t9Rotr(e, by: 11) ^ t9Rotr(e, by: 25)
        let ch = (e & f) ^ (~e & 0xffffffff & g)
        let t1 = (hh + s1 + ch + k[t] + w[t]) & 0xffffffff
        let s0 = t9Rotr(a, by: 2) ^ t9Rotr(a, by: 13) ^ t9Rotr(a, by: 22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = (s0 + maj) & 0xffffffff
        hh = g
        g = f
        f = e
        e = (d + t1) & 0xffffffff
        d = c
        c = b
        b = a
        a = (t1 + t2) & 0xffffffff
    }
    h[0] = (h[0] + a) & 0xffffffff
    h[1] = (h[1] + b) & 0xffffffff
    h[2] = (h[2] + c) & 0xffffffff
    h[3] = (h[3] + d) & 0xffffffff
    h[4] = (h[4] + e) & 0xffffffff
    h[5] = (h[5] + f) & 0xffffffff
    h[6] = (h[6] + g) & 0xffffffff
    h[7] = (h[7] + hh) & 0xffffffff
}

/// `SHA256.HashData(data)`: the 32-byte digest.
List<u8> sha256(ReadOnlySpan<u8> data) uses alloc {
    let k = t9RoundConstants()
    var h: List<u64> = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    var w = List<u64>()
    for _ in 0..64 { w.append(0) }
    let whole = data.length / 64 * 64
    var start: i64 = 0
    while start < whole {
        t9Block(ref h, from: data, at: start, by: in k, through: ref w)
        start += 64
    }
    // The tail, the `0x80` byte, zeros to 56 mod 64, then the bit length big-endian (§5.1.1).
    var tail = List<u8>()
    for i in whole..data.length { tail.append(data[i]) }
    tail.append(0x80)
    while tail.length % 64 != 56 { tail.append(0) }
    let bits = u64(data.length) * 8
    for i in 0..8 { tail.append(u8((bits >> u64(56 - i * 8)) & 0xff)) }
    start = 0
    while start < tail.length {
        t9Block(ref h, from: tail.span, at: start, by: in k, through: ref w)
        start += 64
    }
    var digest = List<u8>()
    for v in h {
        digest.append(u8((v >> 24) & 0xff))
        digest.append(u8((v >> 16) & 0xff))
        digest.append(u8((v >> 8) & 0xff))
        digest.append(u8(v & 0xff))
    }
    return digest
}
