// bayan: the self-hosted compiler driver (spec 012). `Run` of CliApp.cs:37 with the global options of
// `TakeGlobalOptions` (CliApp.cs:328); commands the driver does not port are refused (R3).
//
//     bayan [--ascii] [--color auto|always|never] <command> [args]

import semantics

const exitOk: i32 = 0
const exitFailure: i32 = 1
const exitUsage: i32 = 2
const exitTestFailure: i32 = 3
const exitToolchain: i32 = 4

/// Toolchain.CompilerVersion (Toolchain.cs:33).
const version: string = "0.3.0-dev"

/// Messages.Usage (Messages.cs:32), kept equal by SelfhostDriverTests.
const usageText: string = """
usage: bayan <command> [args]

commands:
  new <name>           create an app in a new directory [--lib|--script] [--vcs git|none] [--ci github|none]
  init [<dir>]         add a project's missing files to a directory (same options as new)
  lex [--json] <file>  print the token stream [--json: as one JSON object] (`-` reads stdin)
  parse [--ast] <file> check syntax; with --ast print the syntax tree
  types <path>         print each function's parameter and local types as JSON
  check <path>         report diagnostics for a program (a file or directory)
  build <path>         compile to an executable [-o <file>] [--mode debug|safe|fast] [--target <t>] [--emit-c]
                       [-v: print each phase's time and the output path]
  run <path>           compile and run [--mode debug|safe|fast] [-- <program args>]
  test <path>          compile and run the tests, each in its own process [--mode debug|safe|fast]
                       [--json: print the results as JSON instead]
                       [--changed [--base <ref>]: only modules with files changed since HEAD or <ref>]
                       [--only <text>: only tests whose name contains <text>; repeatable]
                       [-v: also list the passing and pending tests]
                       [--mutate: run every mutant against the tests that reach it; with --run <cmd>, run <cmd> once
                       per mutant instead, with BAYAN_MUTANT set (exit 0 survived, non-zero killed)]
  mutate --binary <exe> --sites <map.json> -- <cmd>
                       run <cmd> once per mutant site of a prebuilt --mutate binary, as test --mutate --run does
  dist [<dir>]         build release binaries into dist/<version>/ [--target <t>|all] [--mode m]
                       [--force: rebuild an existing version] [--allow-dirty: build from a dirty git tree]
  clean [<dir>]        remove out/ [--dist: also dist/] [--cache: also the global build cache]
  cache stats          show the shared build cache's location and size
  format <path>        rewrite input forms (those with a fix-it) in a `.byn` file or a directory of them,
                       and booleans and primitives to `style` in `package.byn` [--check: list, don't write]
  audit <path>         list every `because` bypass and `unsafe` or `extern` declaration, with its reason
  features --used <path>
                       print the syntax node kinds, builtins and diagnostics a build touched, as JSON
  explain <code>       explain a diagnostic, e.g. `bayan explain BYN0003`
  <script>.byn         run a script, so `#!/usr/bin/env bayan` works
  doctor               check the C compiler, zig, git and the build cache, with fixes
  --version            print the compiler version and the commit it was built from
  --help               print this message

check, types, build, run, test and features take a project directory (one with `package.byn`; the
default inside a project), a script (a file starting with `#!`), or a file or directory of `.byn` files.

options for every command:
  --color auto|always|never
                       color for terminals (auto: on unless piped or NO_COLOR is set;
                       FORCE_COLOR turns it on, TERM=dumb off)
  --ascii              use ASCII symbols instead of ◆ ✗ │ (also with TERM=dumb or a non-UTF-8 locale)

options for check, types, build, run and test:
  --all                show every error instead of the first 20 (JSON is never capped)
  --diagnostics json   print each diagnostic to stderr as one JSON object per line
                       (code, severity, file, span, message, label, help, fixes)

exit codes:
  0  success
  1  compile errors
  2  usage errors (unknown command or option, missing path)
  3  test failures, or a coverage or mutation score below its minimum
  4  toolchain problems (no C compiler, unwritable cache, C compiler failure)

`bayan run` exits 1 when compilation fails and otherwise passes the program's own exit code
through unchanged, so it cannot tell a build failure from a program that exits 1. When that
matters, run `bayan build` first or read `--diagnostics json`.
"""

/// CliApp.cs:33 `VersionLine` with the commit replaced by `selfhost` (spec Q3).
string versionLine() => $"bayan {version} (selfhost)"

/// CliApp.cs:37 `Run`.
i32 run(ReadOnlySpan<string> args, through ref DCtx d) {
    var kept = List<string>()
    unless takeGlobalOptions(args, to: ref kept, through: ref d) { return exitUsage }
    // no-builtin: Q1117 the `Terminal` of CliApp.cs:27 is what `Run(args, stdout, stderr)` gives: neither stream a tty, width 0
    d.styleOut = decideStyle(d.color, by: d.ascii, through: false, for: 0)
    d.styleErr = decideStyle(d.color, by: d.ascii, through: false, for: 0)
    d.stderrTty = false
    if kept.length == 0 {
        Io.stderr.write($"{usageText}\n")
        return exitUsage
    }
    let command = kept[0]
    switch command {
        case "--version" or "version":
            Io.stdout.write($"{versionLine()}\n")
            return exitOk
        case "doctor":
            return doctorCommand(by: in d)
        case "--help" or "-h" or "help":
            Io.stdout.write($"{usageText}\n")
            return exitOk
        case "lex":
            return lexCommand(in kept)
        case "parse":
            return parseCommand(in kept)
        case "types":
            return typesCommand(in kept, by: in d)
        case "format":
            return formatCommand(in kept, by: in d)
        case "audit":
            return auditCommand(in kept, by: in d)
        case "features":
            return featuresCommand(in kept, by: in d)
        case "explain":
            return explainCommand(kept)
        case "check":
            return checkCommand(in kept, by: in d)
        case "build":
            return buildCommand(in kept, by: ref d)
        case "run":
            return runProgram(in t2Rest(kept), by: ref d)
        case "test":
            return testCommand(in kept, by: ref d)
        case "mutate":
            return refuse(command)
        case "new":
            let newArgs = t2Rest(kept)
            return scaffoldNew(newArgs.span)
        case "dist":
            return distCommand(in kept, by: ref d)
        case "cache":
            return cacheCommand(kept)
        case "clean":
            return cleanCommand(kept)
        case "init":
            let initArgs = t2Rest(kept)
            return scaffoldInit(initArgs.span)
        default:
            // `#!/usr/bin/env bayan` runs `bayan script.byn [args]` (CliApp.cs:97).
            if command.endsWith(".byn") && t1FileExists(command) {
                var script = List<string>()
                script.append(command)
                script.append("--")
                for a in t2Rest(kept) { script.append(a) }
                return runProgram(in script, by: ref d)
            }
            Io.stderr.write($"bayan: unknown command `{command}`\n")
            if command == "fmt" { Io.stderr.write("the formatter is `bayan format`\n") }
            Io.stderr.write($"{usageText}\n")
            return exitUsage
    }
}

/// CliApp.cs:328 `TakeGlobalOptions`: `--color` and `--ascii` are removed from `args` into `kept` and `d`, before any `--`
/// and before a script run without a command; false after reporting a bad colour value.
bool takeGlobalOptions(ReadOnlySpan<string> args, to ref List<string> kept, through ref DCtx d) {
    var color = "auto"
    var command = false
    var i: i64 = 0
    while i < args.length {
        var value: string? = null
        // A script's arguments are its own (`bayan --ascii tool.byn --color never`).
        if args[i] == "--" || (!command && !args[i].startsWith("-") && args[i].endsWith(".byn") && t1FileExists(args[i])) {
            for k in i..args.length { kept.append(args[k]) }
            break
        }
        if !args[i].startsWith("-") { command = true }
        if args[i] == "--ascii" {
            d.ascii = true
            i += 1
            continue
        }
        if args[i] == "--color" && i + 1 < args.length {
            i += 1
            value = args[i]
        } else if args[i].startsWith("--color=") {
            value = args[i]["--color=".length..args[i].length]
        } else if args[i] == "--color" {
            value = ""
        }
        if (value is not { } v) {
            kept.append(args[i])
            i += 1
            continue
        }
        if v != "auto" && v != "always" && v != "never" {
            Io.stderr.write($"bayan: unknown color setting `{v}` (expected auto, always or never)\n")
            return false
        }
        color = v
        i += 1
    }
    d.color = color
    return true
}

/// TerminalStyle.cs:13 `Decide`, palette included (:24-27, `t7Light`); the Windows code page arm of `Utf8` (:75-84) has no builtin (Q1117).
DStyle decideStyle(string colorFlag, by bool ascii, through bool isTty, for i64 width) uses alloc, env {
    let dumb = Env.get("TERM") == "dumb"
    var color = false
    switch colorFlag {
        case "always":
            color = true
        case "never":
            color = false
        default:
            if (Env.get("NO_COLOR") ?? "").length > 0 {
                color = false
            } else if (Env.get("FORCE_COLOR") ?? "").length > 0 && Env.get("FORCE_COLOR") != "0" {
                color = true
            } else if dumb {
                color = false
            } else {
                color = isTty
            }
    }
    var palette: i64 = 0
    if color {
        let term = Env.get("COLORTERM") ?? ""
        if term == "truecolor" || term == "24bit" {
            palette = t7Light() ? 1 : 2
        }
    }
    return DStyle { color: color, ascii: ascii || dumb || !t7Utf8(), width: isTty && width > 0 ? width : 100, palette: palette }
}

/// TerminalStyle.cs:59 `Light`: `BAYAN_THEME`, else the background field of `COLORFGBG` (digits only, 7 or 9 to 15), else dark.
bool t7Light() uses alloc, env {
    let theme = Env.get("BAYAN_THEME") ?? ""
    if theme == "light" { return true }
    if theme == "dark" { return false }
    let fgbg = Env.get("COLORFGBG") ?? ""
    // digits after the last `;`; `int.TryParse` with `NumberStyles.None` rejects an empty, non-digit or out-of-range (above int.MaxValue) field
    var bg: i64 = 0
    var digits = 0
    var bad = false
    for c in fgbg.bytes {
        if c == 0x3b {
            bg = 0
            digits = 0
            bad = false
        } else if c >= 0x30 && c <= 0x39 {
            bg = bg * 10 + i64(c) - 0x30
            digits += 1
            if bg > 2147483647 {
                bad = true
                bg = 0
            }
        } else {
            bad = true
        }
    }
    if bad || digits == 0 { return false }
    return bg == 7 || (bg >= 9 && bg <= 15)
}

/// `Palette.Prefix` (Style.cs:34) of the roles `error`, `warning`, `help`, `success`, `note` as 0 to 4, for `palette` (0 `Ansi16`, 1 `TruecolorLight`, 2 `TruecolorDark`); the hex rows are `Palette.Hex`.
string t7Prefix(by i64 palette, for i64 role) uses alloc {
    if palette == 0 {
        let rows = ["\u{1b}[31m", "\u{1b}[33m", "\u{1b}[34m", "\u{1b}[32m", "\u{1b}[2m"]
        return rows[role]
    }
    if palette == 1 {
        let rows = ["\u{1b}[38;2;180;35;24m", "\u{1b}[38;2;138;83;0m", "\u{1b}[38;2;31;58;95m", "\u{1b}[38;2;47;107;31m", "\u{1b}[38;2;95;94;90m"]
        return rows[role]
    }
    let rows = ["\u{1b}[38;2;255;138;128m", "\u{1b}[38;2;242;193;78m", "\u{1b}[38;2;141;184;242m", "\u{1b}[38;2;143;214;148m", "\u{1b}[38;2;180;178;169m"]
    return rows[role]
}

/// TerminalStyle.cs:66 `Utf8`: on Windows the console code page, which has no builtin and is read as UTF-8 (Q1117); elsewhere the first non-empty of `LC_ALL`, `LC_CTYPE`, `LANG` names UTF-8 (none set counts as UTF-8).
bool t7Utf8() uses alloc, env {
    // coverage-exempt: Q1117 through `let names` (the Windows arm)
    if Target.os == "windows" {
        // no-builtin: Q1117 TerminalStyle.cs:68-77 reads `Console.OutputEncoding.CodePage == 65001` on Windows, never the locale; read as UTF-8
        return true
    }
    let names = ["LC_ALL", "LC_CTYPE", "LANG"]
    for name in names {
        let locale = Env.get(name) ?? ""
        if locale.length == 0 { continue }
        return locale.lowercased().contains("utf-8") || locale.lowercased().contains("utf8")
    }
    return true
}

/// The C# `File.Exists`: `path` reads and is not a directory.
bool t1FileExists(string path) {
    let _ = Io.listDir(path) catch {
        let _ = Io.readFile(path) catch return false
        return true
    }
    return false
}

/// CliApp.cs:375 `IsScript`: a file whose first two bytes are `#!`. A copy of `semantics/cli.byn` `t26IsScript` (private there); T28 merges copies.
bool t1IsScript(string path) {
    unless t1FileExists(path) { return false }
    // coverage-exempt: Q918 the catch is reached only if the file changes between the reads at :219 and :229 (a race no test can stage); the C# has no such branch
    let bytes = Io.readFile(path) catch return false
    return bytes.length >= 2 && bytes[0] == 0x23 && bytes[1] == 0x21
}

/// CliApp.cs:384 `RefuseLibrary`: a library has nothing to build or run; `command` is the refused verb (`build`, `run`).
bool refuseLibrary(semantics.Ctx compiled, by string command) {
    unless compiled.library { return false }
    Io.stderr.write($"bayan: `{compiled.packageName}` is a library, so there is no program to {command}; `bayan test` runs its tests\n")
    return true
}

/// R3 (spec Q4): one stderr line naming `what`.
i32 refuse(string what) {
    Io.stderr.write($"error: `{what}` is not available in the self-hosted compiler; use the C# `bayan`\n")
    return exitUsage
}

i32 main(ReadOnlySpan<string> args) {
    var d = newDCtx()
    return run(args, through: ref d)
}
