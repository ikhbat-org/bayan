// The command `explain` of the self-hosted driver (spec 017 T1). Ports `CliApp.cs` :1089 `Explain` and :1107 `ExplainText`;
// the embedded `docs/diagnostics/BYN####.md` are the constants of `diagdocs.byn` (plan D2). Takes the arguments `run` kept
// (the command first).

/// CliApp.cs:1089 `Explain`.
i32 explainCommand(List<string> kept) uses alloc, console {
    let args = t2Rest(kept)
    if args.length != 1 {
        Io.stderr.write("bayan: expected one diagnostic code, e.g. `bayan explain BYN0003`\n")
        return exitUsage
    }
    if (explainText(args[0]) is { } text) {
        Io.stdout.write(text)
        return exitOk
    }
    Io.stderr.write($"bayan: no explanation for `{args[0]}`\n")
    return exitUsage
}

/// CliApp.cs:1107 `ExplainText`: the document for a code, matched case-insensitively; null when the code is malformed or has none.
string? explainText(string code) uses alloc {
    let name = t1Trim(code).uppercased()
    if name.length != 7 || !name.startsWith("BYN") { return null }
    for i in 3..7 {
        let b = name.bytes[i]
        if b < 0x30 || b > 0x39 { return null }
    }
    return diagDoc(name)
}

/// `char.IsWhiteSpace` for a code point of the Basic Multilingual Plane (the set `string.Trim` removes).
bool t1IsWhiteSpace(i64 cp) {
    if cp >= 0x09 && cp <= 0x0d { return true }
    if cp >= 0x2000 && cp <= 0x200a { return true }
    return cp == 0x20 || cp == 0x85 || cp == 0xa0 || cp == 0x1680 || cp == 0x2028 || cp == 0x2029 || cp == 0x202f || cp == 0x205f || cp == 0x3000
}

/// The code point and byte size of the UTF-8 sequence of `text` at byte `i`.
(i64 cp, i64 size) t1Decode(string text, at i64 i) {
    let b = i64(text.bytes[i])
    var size: i64 = 4
    var cp = b & 0x07
    if b < 0x80 {
        return (cp: b, size: 1)
    } else if b < 0xe0 {
        size = 2
        cp = b & 0x1f
    } else if b < 0xf0 {
        size = 3
        cp = b & 0x0f
    }
    for k in 1..size { cp = (cp << 6) | (i64(text.bytes[i + k]) & 0x3f) }
    return (cp: cp, size: size)
}

/// `string.Trim()` of CliApp.cs:1109: removes the `char.IsWhiteSpace` characters from both ends (`trimmed()` removes only ASCII ones).
string t1Trim(string text) {
    var start: i64 = 0
    var end = text.length
    while start < end {
        let c = t1Decode(text, at: start)
        unless t1IsWhiteSpace(c.cp) { break }
        start += c.size
    }
    while end > start {
        var i = end - 1
        while i > start && (text.bytes[i] & 0xc0) == 0x80 { i -= 1 }
        let c = t1Decode(text, at: i)
        unless t1IsWhiteSpace(c.cp) { break }
        end = i
    }
    return text[start..end]
}
