// GENERATED by SelfhostDefaultT1Tests (BAYAN_UPDATE=1): one constant per docs/diagnostics/BYN####.md (spec 017 plan D2). Do not edit.

const doc0001: string = "# BYN0001: bidirectional control character outside a string literal\n\n**Why.** Bidi controls (U+202A–U+202E, U+2066–U+2069) are invisible and reorder how text displays. In code or comments they can make source read differently from how it compiles (\"Trojan Source\", CVE-2021-42574). Bayan allows them only inside string literals, where they are data.\n\n**Example.**\n\n```\n// comment <U+202E> hidden\n```\n\n**Fix.** Delete the character. If you need it in text, put it in a string literal, ideally as an escape: `\"\\u{202E}\"`.\n"
const doc0002: string = "# BYN0002: unexpected character\n\n**Why.** The character cannot start any token: it is not an operator, punctuation, digit, quote or identifier letter.\n\n**Example.**\n\n```\nlet a = 1 `\n```\n\n**Fix.** Remove the character, or put it inside a string or comment.\n"
const doc0003: string = "# BYN0003: unterminated string literal\n\n**Why.** A regular string must close on the line it opens. A raw `\"\"\"` string must close before the end of the file. An interpolated string's `{` must be closed before the string ends.\n\n**Example.**\n\n```\nlet a = \"open\n```\n\n**Fix.** Add the closing `\"`. For text spanning lines use a raw string:\n\n```\nlet a = \"\"\"\n    several\n    lines\n    \"\"\"\n```\n"
const doc0004: string = "# BYN0004: unterminated block comment\n\n**Why.** A `/*` comment runs until `*/`. Without one it swallows the rest of the file.\n\n**Example.**\n\n```\n/* started here\nlet a = 1\n```\n\n**Fix.** Add `*/` where the comment should end, or use `//` line comments.\n"
const doc0005: string = "# BYN0005: identifier not in normalization form C\n\n**Why.** Unicode can encode the same visible letter in more than one way (`é` as one scalar or as `e` + combining accent). Two identifiers that look identical but differ in bytes would be different names. Bayan requires NFC so that names that look the same are the same.\n\n**Example.**\n\n```\nlet café = 1   // `e` followed by U+0301\n```\n\n**Fix.** Use the composed form. The diagnostic carries a machine-applicable fix; most editors also have a \"normalize to NFC\" command.\n"
const doc0006: string = "# BYN0006: invalid escape sequence\n\n**Why.** Only a fixed set of escapes exists, so a typo cannot silently become a different character.\n\n**Example.**\n\n```\nlet s = \"bad \\q escape\"\n```\n\n**Fix.** Use one of `\\n \\r \\t \\0 \\\\ \\\" \\'` or `\\u{…}` with a hex scalar value. To write a backslash, use `\\\\` or a raw `\"\"\"` string.\n"
const doc0007: string = "# BYN0007: empty char literal\n\n**Why.** A `rune` is one Unicode scalar; `''` holds none.\n\n**Example.**\n\n```\nlet c = ''\n```\n\n**Fix.** Put the character between the quotes, e.g. `' '`, or use an empty string `\"\"`.\n"
const doc0008: string = "# BYN0008: unterminated char literal\n\n**Why.** A char literal must close with `'` on the same line.\n\n**Example.**\n\n```\nlet c = 'x\n```\n\n**Fix.** Add the closing `'`.\n"
const doc0009: string = "# BYN0009: char literal holds more than one scalar\n\n**Why.** A `rune` is exactly one Unicode scalar value. Text with several characters, including letters built from combining marks or emoji sequences, is a string.\n\n**Example.**\n\n```\nlet c = 'ab'\n```\n\n**Fix.** Use a string literal: `\"ab\"`.\n"
const doc0010: string = "# BYN0010: invalid numeric literal\n\n**Why.** The literal breaks one of the number rules: `_` separators must sit between digits; `0x` and `0b` need at least one digit of the right base; an exponent needs digits.\n\n**Example.**\n\n```\nlet a = 1__000\nlet b = 0x\nlet c = 1e\n```\n\n**Fix.** Write `1_000`, `0x0`, `1e3`.\n"
const doc0011: string = "# BYN0011: unit suffix on a hex or binary literal\n\n**Why.** Unit suffixes such as `dec` or `s` attach meaning to a decimal quantity. Hex and binary literals are bit patterns, so only the built-in width suffixes `u`, `l`, `ul` are allowed on them.\n\n**Example.**\n\n```\nlet a = 0xFFs\n```\n\n**Fix.** Write the value in decimal (`255s`), or drop the suffix.\n"
const doc0012: string = "# BYN0012: reserved word used as identifier\n\n**Why.** Every keyword is reserved, including those kept for future features (`actor`, `macro`, `select`, `become`), so adding a feature later cannot break existing code. The C# primitive type names (`sbyte`, `byte`, `short`, `ushort`, `int`, `uint`, `long`, `ulong`, `nint`, `nuint`, `float`, `double`) are reserved too: they name the sized types in every project, so none can be declared as a name (`i32 int`, `let long = 4`).\n\n**Example.**\n\n```\nlet actor = 1\n```\n\n**Fix.** Choose another name, e.g. `actorId`.\n"
const doc0013: string = "# BYN0013: escape is not a Unicode scalar value\n\n**Why.** `\\u{…}` must name a Unicode scalar: U+0000–U+D7FF or U+E000–U+10FFFF. Surrogates and values above U+10FFFF cannot be encoded in UTF-8.\n\n**Example.**\n\n```\nlet c = '\\u{D800}'\n```\n\n**Fix.** Use the scalar value you meant. For characters outside the BMP write the code point directly (`\\u{1F600}`), not a surrogate pair.\n"
const doc0014: string = "# BYN0014: single `}` in an interpolated string\n\n**Why.** In `$\"…\"` strings `{` opens an expression and `}` closes it. A lone `}` in the text is ambiguous, so literal braces are written doubled.\n\n**Example.**\n\n```\nlet s = $\"stray } here\"\n```\n\n**Fix.** Write `}}` (and `{{` for a literal `{`). The diagnostic carries this fix.\n"
const doc0015: string = "# BYN0015: source is not valid UTF-8\n\n**Why.** Bayan source files are UTF-8. An invalid byte sequence usually means the file was saved in another encoding (ISO-8859-1, Windows-1252, UTF-16).\n\n**Fix.** Re-save the file as UTF-8. The byte offset in the diagnostic shows the first bad byte on each line.\n"
const doc0016: string = "# BYN0016: interpolated strings nested too deeply\n\n**Why.** An interpolated string may contain an expression that is itself an interpolated string. The lexer bounds this nesting (16 levels) so pathological input cannot exhaust it. Only the first occurrence in a file is reported.\n\n**Fix.** Build the inner text in a local first:\n\n```\nlet inner = $\"{a}-{b}\"\nlet outer = $\"[{inner}]\"\n```\n"
const doc1001: string = "# BYN1001: expected token\n\n**Why.** The parser needed a specific token at this point (a closing brace, a parenthesis, a name) and found something else. When a block is not closed, the help line names the line where it was opened.\n\n**Example.**\n\n```\nvoid f() {\n    let x = 1\n\nvoid g() {}\n```\n\n**Fix.** Insert the missing token. For an unclosed block, add `}` where the block should end.\n"
const doc1002: string = "# BYN1002: expected an expression\n\n**Why.** An operator, initializer or argument list needs a value here, but the next token cannot start an expression.\n\n**Example.**\n\n```\nlet a = \n```\n\n**Fix.** Supply the missing value, or remove the operator that expects one.\n"
const doc1003: string = "# BYN1003: expected a type\n\n**Why.** A declaration, cast or generic argument needs a type here, but the next token cannot start one.\n\n**Example.**\n\n```\nvoid f(, i32 x) {}\n```\n\n**Fix.** Write the type, such as `i32`, `string` or a struct name.\n"
const doc1004: string = "# BYN1004: expected a struct member\n\n**Why.** Inside a struct body, only fields, properties, constructors and methods may appear. The token shown cannot start any of them.\n\n**Example.**\n\n```\nstruct S {\n    i64 a\n    + \n}\n```\n\n**Fix.** Remove the stray tokens, or complete the member declaration.\n"
const doc1005: string = "# BYN1005: expected a line break after the statement\n\n**Why.** A statement ends at the end of its line, at `}` or at the end of the file. A second statement on the same line has nothing to end the first, so the two would read as one.\n\n**Example.**\n\n```\nlet a = 1 let b = 2\n```\n\n**Fix.** Put the next statement on its own line, at the same indent. The diagnostic carries a machine-applicable fix.\n"
const doc1006: string = "# BYN1006: `unless` cannot have an `else`\n\n**Why.** `unless c A else B` reads as a double negative. When both branches matter, the positive form says the same thing directly.\n\n**Example.**\n\n```\nunless ready { wait() } else { go() }\n```\n\n**Fix.** Write `if ready { go(); } else { wait(); }`. The diagnostic offers this rewrite.\n"
const doc1007: string = "# BYN1007: `unless` with a negated condition\n\n**Why.** `unless (!x)` is a double negative and means `if (x)`. Bayan rejects it so conditions read directly. From design round 3 the same holds for the word spelling `not`, in both the block and the postfix form; BYN1007 covers both spellings (it absorbed the retired [BYN1049](BYN1049.md)).\n\n**Example.**\n\n```\nunless !done { step() }\nreturn 0 unless !ok\nreturn 0 unless not ok\n```\n\n**Fix.** Use `if` with the condition un-negated (`return 0 if ok`). The diagnostic carries the rewrite.\n"
const doc1008: string = "# BYN1008: postfix condition on a compound statement\n\n**Why.** A postfix `if` or `unless` (`return x if c;`) is meant for one short simple statement: a return, break, continue, assignment or call. On a block, loop or declaration it hides control flow at the end of a long construct, and on a declaration it would leave the name unassigned.\n\n**Example.**\n\n```\nlet y = 2 if ready\n```\n\n**Fix.** Use a prefix `if ready { … }`, or declare the variable first and assign it conditionally.\n"
const doc1009: string = "# BYN1009: chained postfix conditions\n\n**Why.** `x if a if b;` is ambiguous to readers (which condition is checked first?) and adds nothing over `&&`.\n\n**Example.**\n\n```\nreturn 0 if a if b\n```\n\n**Fix.** Combine the conditions: `return 0 if a && b;`.\n"
const doc1010: string = "# BYN1010: `goto` is not supported\n\n**Why.** Bayan has no `goto`. Structured exits cover its legitimate uses: labeled `break` and `continue` leave nested loops, and `defer` handles cleanup. `goto case` is not supported either; switch sections never fall through.\n\n**Example.**\n\n```\ngoto done\n```\n\n**Fix.** Label the loop and use `break label;` or `continue label;`. For shared switch code, move it into a function.\n"
const doc1011: string = "# BYN1011: invalid assignment target\n\n**Why.** Only variables, fields, properties and indexed elements can be assigned. Calls, literals and operator results are values, not storage.\n\n**Example.**\n\n```\nf() = 3\na + b += 1\n```\n\n**Fix.** Assign to a variable or member instead.\n"
const doc1012: string = "# BYN1012: expression has no effect as a statement\n\n**Why.** A statement that is only an expression must do something: call a function, `try` or `catch`, or jump with `?? return`. Expressions such as `a + b;` compute a value and throw it away, which is almost always a mistake.\n\n**Example.**\n\n```\nlet x = 1\nx + 1\n```\n\n**Fix.** Assign the value (`y = x + 1;`), use it, or remove the statement.\n"
const doc1013: string = "# BYN1013: conditional expression in a collection literal\n\n**Why.** Inside `[ … ]`, a bare `c ? a : b` is easy to misread as several elements. Bayan asks for parentheses so element boundaries stay obvious.\n\n**Example.**\n\n```\nlet xs = [1, ready ? 2 : 3]\n```\n\n**Fix.** Parenthesize it: `[1, (ready ? 2 : 3)]`. The diagnostic carries this fix.\n"
const doc1014: string = "# BYN1014: stacked case labels\n\n**Why.** C-style `case a: case b:` relies on fall-through, which Bayan switch sections do not have. One label with an `or` pattern states the intent directly.\n\n**Example.**\n\n```\nswitch day {\n    case .sat:\n    case .sun:\n        rest()\n        break\n}\n```\n\n**Fix.** Write `case .sat or .sun:`. The parser merges stacked labels this way to keep checking the rest of the file.\n"
const doc1015: string = "# BYN1015: C-style `for` loop\n\n**Why.** Bayan's `for` iterates over a range or collection; there is no `for (init; cond; step)` form. Ranges cover counting loops and make off-by-one bounds explicit.\n\n**Example.**\n\n```\nlet n = 3\nfor (i32 i = 0; i < n; i++) { }\n```\n\n**Fix.** Write `for i in 0..n { … }`, or use `while` for anything else.\n"
const doc1016: string = "# BYN1016: modifier not allowed here\n\n**Message.** \"`{0}` is not allowed here\"\n\n**Help.** \"put `@sealed` on a struct\" (on anything but a struct); \"write `@sealed` with no arguments and no `because`\" (with arguments or `because`); \"put `@positional` on a struct\" (on anything but a struct); \"write `@positional` with no arguments and no `because`\" (with arguments or `because`); \"remove `@positional`: a struct with states is built with state literals\" (on a struct with a `states` block).\n\n**Why.** Each modifier applies to certain declarations only: `public` to functions, structs and members, `readonly` to fields and structs, `static` to members, and so on. An import, local or top-level function cannot take the modifier shown. `@sealed` and `@positional` belong on a struct and take no arguments and no `because`; a struct with states is built with state literals, so it cannot be `@positional`.\n\n**Example.**\n\n```\npublic import money\nreadonly void f() {}\n\n@sealed\nvoid run() {}\n\n@positional(strict)\nstruct Point {\n    i64 x\n    i64 y\n}\n```\n\n**Fix.** Remove the modifier, or put `@sealed` or `@positional`, bare, on a struct without states.\n"
const doc1017: string = "# BYN1017: parenthesized condition\n\n**What.** Parentheses around the whole condition of `if`, `unless`, `while`, `switch` or `do … while`.\n\n**Why.** Bayan conditions are bare and their bodies are blocks, so the parentheses carry nothing. One spelling keeps code uniform. They are still allowed when the condition has a struct literal at its top level, where the `{` would otherwise open the body.\n\n**Example.**\n\n```\nif (count > 0) {\n    print(\"some\")\n}\n```\n\n**Fix.** Remove the parentheses (the machine fix does this):\n\n```\nif count > 0 {\n    print(\"some\")\n}\n```\n"
const doc1018: string = "# BYN1018: body needs braces\n\n**What.** A single statement as the body of `if`, `else`, `unless`, `while`, `for` or `do`, or a declaration as the body of `defer` (`defer stmt;` is otherwise legal, spec §7.6; `defer let x = 1;` declares a local nothing can see).\n\n**Why.** A braceless body invites the classic bug where a second indented line looks guarded but is not. Every body is a block.\n\n**Example.**\n\n```\nvoid f() {\n    defer let x = 1\n}\n```\n\n**Fix.** Wrap the statement in `{ }` (the machine fix does this):\n\n```\ndefer { let x = 1 }\n```\n\nWhen the header has its own fix (BYN1017, BYN1007, BYN1019, …), that fix also adds the braces, so it is valid applied alone.\n"
const doc1019: string = "# BYN1019: parenthesized `for`\n\n**What.** `for (let x in xs)`, `for (var x in xs)` or `foreach (var x in xs)`.\n\n**Why.** Bayan has one loop over a sequence: `for x in xs { … }`. The loop variable is a fresh binding each iteration, so `let`/`var` adds nothing. A `(` after `for` followed by a top-level `let`, `var` or `in` is this input form; `for (a, b) in pairs` is a tuple destructure.\n\n**Example.**\n\n```\nforeach (var order in orders) {\n    ship(order)\n}\n```\n\n**Fix.** Write the bare form (the machine fix does this):\n\n```\nfor order in orders {\n    ship(order)\n}\n```\n"
const doc1020: string = "# BYN1020: `errdefer`\n\n**What.** The keyword `errdefer`.\n\n**Why.** Cleanup kinds are spelled after `defer`: `defer`, `defer failing`, `defer panicking`. `errdefer` was the old spelling of `defer failing`.\n\n**Example.**\n\n```\nerrdefer (e) log($\"rolled back: {e}\")\n```\n\n**Fix.** Write `defer failing`; the `(e)` binding stays (the machine fix does this):\n\n```\ndefer failing (e) log($\"rolled back: {e}\")\n```\n"
const doc1021: string = "# BYN1021: `=` in a literal\n\n**What.** `name = value` inside a struct literal or a `with` literal.\n\n**Why.** A literal names its fields with `:`, the same as a manifest and a property pattern. `=` is assignment, which a literal does not do.\n\n**Example.**\n\n```\nlet p = Point { x = 1, y = 2 }\nlet q = p with { y = 3 }\n```\n\n**Fix.** Write `:` (the machine fix does this):\n\n```\nlet p = Point { x: 1, y: 2 }\nlet q = p with { y: 3 }\n```\n"
const doc1022: string = "# BYN1022: compound `unless`\n\n**What.** `unless` with a condition joined by `&&` or `||`.\n\n**Why.** `unless a && b` means \"if not (a and b)\", which readers get wrong. `unless` is for one plain condition.\n\n**Example.**\n\n```\nunless ready && open {\n    wait()\n}\n```\n\n**Fix.** Use `if` with the negated condition in parentheses (the machine fix does this), and simplify it if you like:\n\n```\nif !(ready && open) {\n    wait()\n}\n```\n"
const doc1023: string = "# BYN1023: `unless x is null`\n\n**What.** `unless x is null`.\n\n**Why.** It is a double negative; `if x is not null` says the same thing directly.\n\n**Example.**\n\n```\nunless user is null {\n    greet(user)\n}\n```\n\n**Fix.** Write `if … is not null` (the machine fix does this):\n\n```\nif user is not null {\n    greet(user)\n}\n```\n"
const doc1025: string = "# BYN1025: `catch (e)` binding\n\n**What.** A `(name)` binding after `catch`.\n\n**Why.** A handler that needs the error matches it: each `catch switch` arm binds the error at the type it matched, so the binding always has a precise type.\n\n**Example.**\n\n```\nlet n = parse(s) catch (e) switch {\n    .empty => 0,\n    _ => fallback(e),\n}\n```\n\n**Fix.** Remove `(e)` (the machine fix does this when `switch` follows) and bind the error in the arms that need it:\n\n```\nlet n = parse(s) catch switch {\n    .empty => 0,\n    ParseError e => fallback(e),\n}\n```\n"
const doc1028: string = "# BYN1028: `delegate`\n\n**Why.** Bayan writes function types directly: `Order -> bool`. A name for one is a type alias. The C# `delegate` declaration is an input form.\n\n**Message.** `delegate` is not Bayan; write a function type `type {0} = {1}`\n\n**Help.** declare it as `type {0} = {1}`\n\n**Example.**\n\n```\nstruct Order { i64 total }\n\ndelegate bool OrderFilter(Order order)\n```\n\n**Fix.** Write a type alias for the function type:\n\n```\nstruct Order { i64 total }\n\ntype OrderFilter = Order -> bool\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it. A generic delegate (`delegate bool F<T>(T x)`) gets no fix: aliases take no type parameters.\n"
const doc1029: string = "# BYN1029: `error set` in place of `union error`\n\n**What.** The round-2 `error set S = A | B`, or `|` between the members of a `union error` composition.\n\n**Why.** `union error` declares, composes and narrows error sets with one head-first spelling, so `set` is gone. A composition lists its members like any other list, separated by `,`.\n\n**Example.**\n\n```\nerror set SignupError = EmailError | DbError\n```\n\n**Fix.** Write `union error`, with `,` between the members (the machine fix does this):\n\n```\nunion error SignupError = EmailError, DbError\n```\n"
const doc1030: string = "# BYN1030: retired: the rewrite moved to `bayan format` `style.primitives`; never reuse\n\n**No longer reported.** BYN1030 reported `int`, `long`, `short`, `byte`, `uint`, `ulong`, `float` and `double` written as a type. Since design round 3 §28 the compiler accepts both spellings and resolves the C# names to `i32 i64 i16 u8 u32 u64 f32 f64` with no diagnostic. Which spelling a project stores is `style.primitives`, and `bayan format` rewrites to it. The code stays reserved: never reuse it.\n\n**Example.**\n\n```\nlong twice(int n) => n * 2\n```\n\n**Fix.** None needed. Run `bayan format` to respell the primitives to the project's `style.primitives`.\n"
const doc1031: string = "# BYN1031: `T!E` return type\n\n**What.** A function declared `T!E name(…)` or `T!(A, B) name(…)`.\n\n**Why.** What a function can fail with is written once, after the parameters, with `fails`.\n\n**Example.**\n\n```\ni64!ParseError parse(string s) { return 0 }\n```\n\n**Fix.** Move the errors to a `fails` clause (the machine fix does this):\n\n```\ni64 parse(string s) fails ParseError { return 0 }\n```\n"
const doc1032: string = "# BYN1032: retired, `if !x` is no longer rewritten\n\n**No longer reported.** BYN1032 asked for `if !x { … }` with no `else` to be written `unless x { … }`. Design round 3 §5 dropped it: the rewrite replaced one paraphrase with another for no gain, and each boolean spelling reads well in some code. `!`/`&&`/`||` and `not`/`and`/`or` are both allowed. The code stays reserved: never reuse it.\n\n**Example.** Both are accepted:\n\n```\nif !done {\n    work()\n}\nif not done {\n    work()\n}\n```\n\n**Fix.** None needed.\n"
const doc1033: string = "# BYN1033: likelihood word after `unless`\n\n**What.** `unless unlikely …` or `unless never …`.\n\n**Why.** A likelihood word belongs to `if`, where it describes the branch that is written. After `unless` it would describe the negation.\n\n**Example.**\n\n```\nunless unlikely ok {\n    recover()\n}\n```\n\n**Fix.** Drop the word (the machine fix does this), or write `if unlikely` with the negated condition:\n\n```\nif unlikely !ok {\n    recover()\n}\n```\n"
const doc1040: string = "# BYN1040: `;` is an input form\n\n**Why.** A statement ends at the newline, so `;` adds nothing. The waqf rules decide where a statement ends: a line ending in a binary operator, `,`, `=`, `=>` or `{` continues on the next line, and so does a line starting with `.`, `?.`, `??`, `catch`, `&&`, `||`, `and` or `or`. A declaration header continues onto lines starting with its clauses: `fails`, `where`, `requires`. A line starting with `(`, `[` or `-` always starts a new statement, and outside brackets a blank line always ends one.\n\n**Example.**\n\n```\nlet a = 1;\nlet b = 2; print(a + b);\n```\n\n**Fix.** Remove the `;`. When another statement follows on the same line, the fix puts it on its own line instead. `bayan format` applies the fix.\n"
const doc1041: string = "# BYN1041: `else` on a new line\n\n**Why.** A newline after the `}` of an `if` ends the statement, so an `else` on the next line has no `if` to belong to. Keeping `else` on the line of `}` makes the two branches read as one statement.\n\n**Example.**\n\n```\nif a > 0 {\n    print(\"pos\")\n}\nelse {\n    print(\"other\")\n}\n```\n\n**Fix.** Move `else` up to the line of `}`: `} else {`. The diagnostic carries a machine-applicable fix.\n"
const doc1042: string = "# BYN1042: a value or modifier on the next line\n\n**Why.** `return`, `break`, `continue` and `fail` take their operand on the same line, and a postfix `if` or `unless` sits on the line of its statement. A newline ends the statement, so a value or condition left on the next line would otherwise be a separate statement. One code covers both forms: \"`{0}` takes its value on the same line\" for an operand, and \"a postfix `{0}` must be on the line of its statement\" for a modifier. `fail` is in scope (revision 0002), but `fail` statements do not parse yet (step 5.3f), so only `return`, `break` and `continue` raise it today.\n\n**Example.**\n\n```\ni64 f(i64 x) {\n    return\n        x + 1\n}\n\nvoid g(bool done) {\n    stop()\n        if done\n}\n```\n\n**Fix.** Move the value to the line of `return`, or the `if` clause up to the statement's line. The diagnostic carries a machine-applicable fix that joins the lines.\n"
const doc1043: string = "# BYN1043: declaration and local binding in the wrong order\n\n**Why.** Declarations put the type first (`Sku sku`, `Grams weight(Order order)`); local bindings put the name first (`let w: Grams = 0g`). One code covers both directions, with one message form each. A name-first declaration reads \"`{0}: {1}` is an input form; write `{1} {0}`\", and a name-first return reads \"`{0}(…) -> {1}` is an input form; write `{1} {0}(…)`\". A type-first local reads \"`{0} {1}` is an input form; write `let {1}: {0}`\". A typed loop variable follows the local rule: `for T x in e` reads \"`for {0} {1}` is an input form; write `for {1}: {0}`\".\n\n**Message.** `{0}: {1}` is an input form; write `{1} {0}` (a name-first declaration); `{0}(…) -> {1}` is an input form; write `{1} {0}(…)` (a name-first return); `{0} {1}` is an input form; write `let {1}: {0}` (a type-first local).\n\n**Help.** put the type before the name; declarations are type-first (declaration); put the return type before the name (return); write `{2} {1}: {0}`; local bindings put the name first (local, `{2}` is `let` or `var`).\n\n**Example.**\n\n```\nf() -> i32 { return 0 }\nf(x: i32) { }\nstruct P { name: string }\nunion Event { timeout(after: Millis) }\nvoid run() {\n    Grams w = 0g\n}\n```\n\n**Fix.** For a declaration, write the type first: `i32 f()`, `f(i32 x)`, `string name`, `timeout(Millis after)`. A missing return type becomes `void`. For a loop variable, write `for x: T in e`. For a local binding, write `let w: Grams = 0g`; the local gains `let`, or `var` when it has no value or is assigned later in its block. A `let`, `var` or `const` already written is kept: `const i32 n = 1` becomes `const n: i32 = 1`. A function type used as a field or parameter type is parenthesized so the name follows it: `(Order -> void uses net) onPaid`. The diagnostic carries the rewrite, and `bayan format` applies it.\n"
const doc1044: string = "# BYN1044: declaration keywords in the wrong order\n\n**Why.** A declaration names its kind first and its modifier after it, as Arabic puts the head before what describes it: `struct unique`, `type distinct`, `union error`. The modifier-first spellings `unique struct`, `distinct type`, `error enum` and `error union` are input forms. The round-2 `error set` is BYN1029.\n\n**Example.**\n\n```\nunique struct File {\n    i64 fd\n}\nerror enum StockError {\n    outOfStock\n}\ndistinct type Sku = string\n```\n\n**Fix.** Put the kind first:\n\n```\nstruct unique File {\n    i64 fd\n}\nunion error StockError {\n    outOfStock\n}\ntype distinct Sku = string\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1045: string = "# BYN1045: bracket attribute\n\n**Why.** Bayan writes an attribute as `@name` or `@name(args)` before the declaration, with a camelCase name, so `[` only ever opens a list or an index. The C# spelling `[Name(args)]` is an input form.\n\n**Example.**\n\n```\n[Cases(1, 2, 3)]\ntest \"positive\" (i32 n) {\n    assert(n > 0)\n}\n```\n\n**Fix.** Write the attribute with `@` and a camelCase name:\n\n```\n@cases(1, 2, 3)\ntest \"positive\" (i32 n) {\n    assert(n > 0)\n}\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1046: string = "# BYN1046: `pattern` outside a `const`\n\n**Why.** A named pattern is a `const` value of pattern type, so `except`, `is` and `switch` can share it (spec §6.5). `pattern` is a contextual keyword, valid only after `=` in a `const` declaration; anywhere else it is an ordinary name.\n\n**Example.**\n\n```\nvoid main() {\n    let inactive = pattern Line { status: .removed or .backordered }\n}\n```\n\n**Fix.** Declare the pattern as a `const`:\n\n```\nconst inactive = pattern Line { status: .removed or .backordered }\n```\n\nThere is no machine fix: the `const` may need to move out of the function.\n"
const doc1047: string = "# BYN1047: block comment\n\n**Why.** Bayan has one comment form, `//` to the end of the line (and `///` for documentation), so a comment never hides code across lines and never nests. `/* */` is an input form. An unclosed `/*` is BYN0004.\n\n**Example.**\n\n```\n/* Prices are in cents.\n   Discounts round down. */\ni64 total(i64 price) => price\n```\n\n**Fix.** Write each line with `//`:\n\n```\n// Prices are in cents.\n// Discounts round down.\ni64 total(i64 price) => price\n```\n\nThe diagnostic carries a machine-applicable fix (one `//` line per comment line, at the indent of the `/*` line), and `bayan format` applies it.\n"
const doc1048: string = "# BYN1048: `char` is now `rune`\n\n**Why.** A Bayan character is a Unicode scalar value, not a UTF-16 unit as in C#, so it is named `rune`. `char` is an input form; a character literal such as `'a'` is a `rune`.\n\n**Example.**\n\n```\nbool isVowel(char c) => c == 'a' or c == 'e'\n```\n\n**Fix.** Rename the type to `rune`:\n\n```\nbool isVowel(rune c) => c == 'a' or c == 'e'\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1049: string = "# BYN1049: retired, merged into BYN1007\n\n**No longer reported.** BYN1049 was never raised. A round-3 draft gave `stmt unless not cond` this code, but that is the double negative [BYN1007](BYN1007.md) already reports, so the two were merged into BYN1007. An earlier draft of the round-3 plan used BYN1049 for a return type written before the name (`void f()`). Since the 2026-10-22 revert (plan J54) that order is canonical again, and BYN1043 reports the opposite, a return written after the parameters (`f() -> T`, fix `T f()`). The code stays reserved: never reuse it.\n\n**Example.** See [BYN1007](BYN1007.md):\n\n```\nreturn 0 unless not ok\n```\n\n**Fix.** Write the condition with `if`: `return 0 if ok`.\n"
const doc1050: string = "# BYN1050: `value` in `requires` is now `it`\n\n**Why.** In a `requires` rule the value being checked is `it`, as in a lambda argument (spec §7.9). `requires value…` is an input form.\n\n**Example.**\n\n```\ntype distinct Percent = i32 requires value in 0..=100\n```\n\n**Fix.** Rename `value` to `it`:\n\n```\ntype distinct Percent = i32 requires it in 0..=100\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1051: string = "# BYN1051: `except` is not allowed in a `case` pattern\n\n**Why.** `except` removes cases from a value ([grammar guide](../bayan-grammar.md)); it is an expression, not part of a pattern. A `case` label or a `switch` arm takes a pattern, and `not` already says \"anything but this\".\n\n**Example.**\n\n```\nShape pick(Shape s) {\n    switch s {\n        case _ except .circle: return s\n        default: return s\n    }\n}\n```\n\n**Fix.** Write `not` before the pattern:\n\n```\n        not .circle => return s\n```\n\n`_ except p` carries a machine-applicable fix, and `bayan format` applies it. Any other left side has no fix: the parser reads it as `left and not p`.\n"
const doc1052: string = "# BYN1052: `except` takes a pattern, not a condition\n\n**Why.** The right side of `except` is a pattern (`.timeout`, `\"if\"`, `0..=9`). A comparison, `and`, `or`, `is` or `in` after a constant makes it a condition, which `except` does not accept.\n\n**Example.**\n\n```\nvoid check(i32 n) {\n    if n is 0 except n > 3 {\n        print(\"x\")\n    }\n}\n```\n\n**Fix.** Move the condition to `where`, or write the pattern alone:\n\n```\n    if n is 0 where n > 3 {\n```\n\nThe diagnostic has no machine-applicable fix.\n"
const doc1053: string = "# BYN1053: cases separated by commas\n\n**Why.** Declarations are separated by newlines: each case of an `enum`, `union` or `union error` sits on its own line, like a field. Commas separate entries of literals and argument lists only.\n\n**Example.**\n\n```\nunion Shape { circle(f64 r), square(f64 side) }\n```\n\n**Fix.** Write each case on its own line, without commas:\n\n```\nunion Shape {\n    circle(f64 r)\n    square(f64 side)\n}\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1054: string = "# BYN1054: `try` covers more than the call that fails\n\n**Why.** `try` covers the whole expression to its right, down to `??` (spec §8): one scope rule, with no exceptions to memorize. When the part that can fail is only a piece of that expression, the reader would take `try` to apply to the whole, so the compiler asks for parentheses around the failing piece.\n\n**Example.**\n\n```\ni64 parse(string s) fails ParseError { return 0 }\ni64 total(string s) fails ParseError {\n    return try parse(s) + 1\n}\n```\n\n**Fix.** Wrap the part that fails in parentheses, with `try` inside:\n\n```\ni64 total(string s) fails ParseError {\n    return (try parse(s)) + 1\n}\n```\n\nThe diagnostic carries a machine-applicable fix. `bayan format` does not apply it: the code is a binder error, not an input form.\n"
const doc1055: string = "# BYN1055: `=>` in a function type\n\n**Why.** A function type is written with `->`: `i32 -> bool`, `(i32, string) -> i32`, `() -> void`. `=>` is the lambda arrow and the expression-body arrow (`bool isBig(i32 x) => x > 2`); in a parameter type, a `type` alias target, a local annotation or a type argument it is the older spelling and an input form.\n\n**Message.** `=>` in a type is an input form; write `->`\n\n**Help.** write the function type with `->`\n\n**Example.**\n\n```\ntype Pred = i32 => bool\n\nbool check((i32 => bool) p) => p(3)\n```\n\n**Fix.** Write `->`:\n\n```\ntype Pred = i32 -> bool\n\nbool check((i32 -> bool) p) => p(3)\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1056: string = "# BYN1056: `return .x` where `.x` is an error\n\n**Why.** `return` always returns a value and `fail` always leaves with an error (spec §8), so a reader tells the two exits apart by the keyword alone. In a function that fails, `return .x` where the return type has no case `.x` but the `fails` clause does reads as a value and is an error; it is the older spelling and an input form. When the return type has a case `.x`, `return .x` returns that value and no diagnostic is raised.\n\n**Message.** `return .{0}` returns an error; write `fail .{0}`\n\n**Help.** leave with the error: `fail .{0}`\n\n**Example.**\n\n```\nunion error LookupError {\n    missing\n}\n\ni64 find(string key) fails LookupError {\n    return .missing if key.isEmpty\n    return 1\n}\n```\n\n**Fix.** Write `fail` in place of `return`:\n\n```\ni64 find(string key) fails LookupError {\n    fail .missing if key.isEmpty\n    return 1\n}\n```\n\nThe diagnostic carries a machine-applicable fix. `bayan format` does not apply it: the code is a binder error, not an input form the parser sees.\n"
const doc1057: string = "# BYN1057: `(T)x` is an input form\n\n**Why.** A conversion is a call on the target type: `u8(x)` is checked and traps in every build mode when `x` is out of range, and `u8.tryFrom(x)` returns `u8?` (spec §6.2). The C-style cast `(u8)x` is the older spelling and an input form; it also made `if (i32)big > 3 {` ambiguous with a parenthesized condition.\n\n**Message.** `({0})x` is an input form; write `{0}(x)`\n\n**Help.** call the conversion: `{0}(x)`\n\n**Example.**\n\n```\nlet big: i64 = 300\nlet small = (u8)big\n```\n\n**Fix.** Call the type with the value:\n\n```\nlet big: i64 = 300\nlet small = u8(big)\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1058: string = "# BYN1058: `params` or `T...` for a variadic parameter\n\n**Why.** A variadic parameter is written `rest ReadOnlySpan<T> name`: the caller's extra arguments arrive as a read-only span. C#'s `params T[]` and C's `T...` are input forms.\n\n**Example.**\n\n```\ni32 sum(params i32[] xs) { return 0 }\ni32 total(i32... xs) { return 0 }\n```\n\n**Fix.** Write `rest ReadOnlySpan<T>`:\n\n```\ni32 sum(rest ReadOnlySpan<i32> xs) { return 0 }\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1059: string = "# BYN1059: `state x` member lines\n\n**Why.** A struct declares its typestates in one `states { … }` block after its fields, one state per line, each with an optional named payload. Per-line `state x` members are an input form.\n\n**Example.**\n\n```\nstruct Order {\n    i64 total\n    state draft\n    state paid(i64 payment)\n}\n```\n\n**Fix.** Gather the states into one block:\n\n```\nstruct Order {\n    i64 total\n    states {\n        draft\n        paid(i64 payment)\n    }\n}\n```\n\nEvery `state` line carries the same machine-applicable fix, and `bayan format` applies it: the lines leave their places and the block takes the place of the last one. There is no fix when the struct already has a `states` block (move the state into it by hand), or when a `state` line shares its line with other code or a comment.\n"
const doc1060: string = "# BYN1060: `{ get }` on an interface member\n\n**Why.** A field-shaped interface member, `Type name`, is already a read-only property requirement. C#'s `Type name { get }` is an input form.\n\n**Example.**\n\n```\ninterface Sized {\n    i64 length { get }\n}\n```\n\n**Fix.** Remove `{ get }`: `i64 length`. The diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1061: string = "# BYN1061: `this` receiver without a state\n\n**Why.** A method reads its receiver by default, so a bare `this` first parameter says nothing. Write `this` only with a state (`this is .placed`), or as `ref this` or `move this`.\n\n**Example.**\n\n```\nstruct Counter {\n    i64 n\n\n    i64 read(this) => n\n}\n```\n\n**Fix.** Remove `this`: `i64 read() => n`. The diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1062: string = "# BYN1062: `trust(x, reason: …)` is now `x.trustUnchecked() because \"…\"`\n\n**Why.** Clearing the `Untrusted` mark bypasses a safety rule, and every bypass in Bayan states its reason in a `because` clause, so a reviewer finds them all with one search. `trust(x, reason: \"…\")` is the older spelling and an input form.\n\n**Example.**\n\n```\nlet name: Untrusted<string> = Untrusted(\"x\")\nprint(trust(name, reason: \"checked against the allow list\"))\n```\n\n**Fix.** Call `trustUnchecked()` on the value and give the reason in `because`:\n\n```\nlet name: Untrusted<string> = Untrusted(\"x\")\nprint(name.trustUnchecked() because \"checked against the allow list\")\n```\n\nThe diagnostic carries a machine-applicable fix when the reason is a string literal, and `bayan format` applies it.\n"
const doc1063: string = "# BYN1063: `requires` on a function\n\n**Why.** A function's precondition is written `expects condition`; `requires` belongs to field and type rules. `requires` on a function is an input form.\n\n**Example.**\n\n```\ni64 half(i64 n) requires n >= 0 { return n / 2 }\n```\n\n**Fix.** Write `expects`: `i64 half(i64 n) expects n >= 0 { return n / 2 }`. The diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc1064: string = "# BYN1064: payload without a name\n\n**Why.** Each payload of a union variant or a state is a named field, read as `shape.radius` once the variant is matched. A type alone gives the field no name.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f64)\n}\n```\n\n**Fix.** Name the payload: `circle(f64 radius)`. There is no automatic fix, because the name is yours to choose.\n"
const doc1065: string = "# BYN1065: function clauses out of order\n\n**Why.** The clauses after a function's parameters have one order, so every signature reads the same way: `where`, `expects`, `uses`, `becomes`, `fails`. The code is raised once, at the first clause out of order.\n\n**Example.**\n\n```\ni64 parse(string s) fails ParseError uses io { return 0 }\n```\n\n**Fix.** Put the clauses in order: `i64 parse(string s) uses io fails ParseError { return 0 }`. The diagnostic carries a machine-applicable fix that sorts the clauses, and `bayan format` applies it.\n"
const doc1066: string = "# BYN1066: prefix pointer type\n\n**Why.** A pointer type is written after its pointee, as in C#: `T*`, and `readonly T*` for a pointee that cannot be written through it. Rust's `*const T` and `*mut T`, and a bare `*T`, are input forms.\n\n**Example.**\n\n```\nextern void copy(*const u8 from, *mut u8 to) { }\n```\n\n**Fix.** Write the pointer after the type: `readonly u8* from`, `u8* to`. The diagnostic carries a machine-applicable fix, and `bayan format` applies it; a nested `**T` is fixed from the inside out. Pointer types are allowed only in `extern` declarations (BYN1067).\n"
const doc1067: string = "# BYN1067: pointer type outside `extern`\n\n**Why.** Pointers exist only to call C. A pointer type may appear only in an `extern` declaration; everywhere else, use a reference (`ref`), a span or an index.\n\n**Example.**\n\n```\nvoid fill(u8* buffer) { }\n```\n\n**Fix.** Pass a `ref` or a span, or wrap the C call in an `extern` declaration. There is no automatic fix.\n"
const doc1068: string = "# BYN1068: compact format spec in an interpolation hole\n\n**Why.** An interpolation hole takes its format specs as named arguments after the value: `{n, as: .hex}`, `{x, digits: 2}`, `{id, width: 6, fill: '0'}`. The C#-style compact forms `{n:hex}`, `{n:binary}`, `{n:octal}`, `{x:.2}`, `{d:iso}` and `{x:debug}` are input forms.\n\n**Example.**\n\n```\nprint($\"{n:hex} {x:.2}\")\n```\n\n**Fix.** Write the spec as named arguments: `print($\"{n, as: .hex} {x, digits: 2}\")`. The diagnostic carries a machine-applicable fix, and `bayan format` applies it. Other compact specs (`{x:N2}`) are not recognized and are a syntax error.\n"
const doc1069: string = "# BYN1069: attribute not allowed before a statement\n\n**Why.** A statement may carry attributes from a short allow-list, written on the line before it and applying to that statement only. The list holds one attribute: `@unobservable because \"…\"` or `@unobservable(operator) because \"…\"`, which tells mutation testing that a change there cannot be observed. Every other attribute belongs on a declaration.\n\n**Example.**\n\n```\ni32 f(i32 x) {\n    @inline\n    return x\n}\n```\n\n**Fix.** Remove the attribute, or move it to the declaration it was meant for. There is no automatic fix.\n"
const doc2001: string = "# BYN2001: undefined name\n\n**Why.** A name must be declared before it can be used: as a local, parameter, function, type, constant or imported module. Bayan has no implicit globals.\n\n**Example.**\n\n```\nlet total = cout + 1\n```\n\n**Fix.** Check the spelling (the help line suggests a close match), declare the name, or `import` the module it lives in.\n"
const doc2002: string = "# BYN2002: unknown type\n\n**Why.** Types are primitives, built-ins (`Span<T>`, `List<T>`, `Arena`, `StrBuf`), and structs, error enums and aliases declared in the module or an imported one.\n\n**Example.**\n\n```\nlet price: Mony = 0\n```\n\n**Fix.** Check the spelling, or import the module that declares the type and qualify it: `money.Money`.\n"
const doc2003: string = "# BYN2003: unknown member\n\n**Why.** Members are fixed by the type's declaration; Bayan has no dynamic members or extension methods in v0.1.\n\n**Example.**\n\n```\nlet name = \"x\"\nlet n = name.size\n```\n\n**Fix.** Use a member the type has. For strings, spans and lists the size is always `length`.\n"
const doc2004: string = "# BYN2004: unknown module\n\n**Why.** A module is a directory of `.byn` files under the package root (the entry file's directory); `import a.b;` reads `a/b/`.\n\n**Example.**\n\n```\nimport mony\n```\n\n**Fix.** Check the directory name, or create the directory next to the entry file.\n"
const doc2005: string = "# BYN2005: not visible\n\n**Why.** Declarations are module-private by default; `private` members are visible only inside their struct. Other modules see only `public` declarations.\n\n**Example.**\n\n```\nimport money\nlet c = money.round(1)   // `round` is not public\n```\n\n**Fix.** Mark the declaration `public` if other modules should use it, or call a public API instead.\n"
const doc2006: string = "# BYN2006: duplicate declaration\n\n**Why.** Every name in a module, struct, parameter list or import list must be unique. Bayan has no overloading.\n\n**Example.**\n\n```\ni64 area(i64 w) => w\ni64 area(i64 w, i64 h) => w * h\n```\n\n**Fix.** Rename one of them; for variants of a function, give each a descriptive name (`areaOfSquare`).\n"
const doc2007: string = "# BYN2007: local shadows another local\n\n**Why.** A local hiding another local of the same name makes code ambiguous to read, so Bayan forbids it in nested scopes too. The one exception is a `let` in the same scope that gives the name a new type (`let count = count.length;`); with the same type it is warning BYN2028.\n\n**Example.**\n\n```\nlet ok = true\nlet total = 0\nif ok { let total = 1 }\n```\n\n**Fix.** Pick a different name.\n"
const doc2008: string = "# BYN2008: type casing\n\n**Why.** Casing carries meaning (spec §5.1): types are PascalCase, values and functions camelCase. Acronyms are capitalized like words (`HttpClient`, not `HTTPClient`).\n\n**Example.**\n\n```\nstruct point { i64 x }\n```\n\n**Fix.** Use the suggested name from the fix.\n"
const doc2009: string = "# BYN2009: value casing\n\n**Why.** Casing carries meaning (spec §5.1): locals, parameters, fields, functions and error variants are camelCase.\n\n**Example.**\n\n```\nlet Total = 0\n```\n\n**Fix.** Use the suggested name from the fix.\n"
const doc2010: string = "# BYN2010: import cycle\n\n**Why.** Modules form a tree of dependencies so each can be compiled and understood on its own terms.\n\n**Example.**\n\n```\n// a/a.byn\nimport b\n// b/b.byn\nimport a\n```\n\n**Fix.** Move the declarations both modules need into a third module that both import.\n"
const doc2011: string = "# BYN2011: circular type alias\n\n**Why.** An alias is another name for an existing type; one defined in terms of itself names no type.\n\n**Example.**\n\n```\ntype A = B\ntype B = A\n```\n\n**Fix.** Point one of the aliases at a concrete type.\n"
const doc2012: string = "# BYN2012: circular constant\n\n**Why.** Constants are evaluated at compile time; a cycle has no value.\n\n**Example.**\n\n```\nconst a: i64 = b + 1\nconst b: i64 = a\n```\n\n**Fix.** Break the cycle by giving one constant a literal value.\n"
const doc2013: string = "# BYN2013: two entry points\n\n**Why.** Top-level statements in the entry file are the program's `main`; a separate `void main()` would be a second one.\n\n**Example.**\n\n```\nprint(\"a\")\nvoid main() { print(\"b\") }\n```\n\n**Fix.** Keep one: move the statements into `main`, or delete `main` and keep the top-level statements.\n"
const doc2014: string = "# BYN2014: no entry point\n\n**Why.** A program starts at the top-level statements of the entry file, or at `void main()`.\n\n**Example.**\n\n```\ni64 twice(i64 x) => x * 2\n```\n\n**Fix.** Add top-level statements or a `main` function. To check a library, run `bayan test` on it.\n"
const doc2015: string = "# BYN2015: statement outside the entry module\n\n**Why.** Top-level statements form the program's `main`, so only the entry module may have them. Other modules contain declarations only.\n\n**Example.**\n\n```\n// money/money.byn\nprint(\"loaded\")\n```\n\n**Fix.** Move the statements into a function and call it from the entry module.\n"
const doc2017: string = "# BYN2017: instance member without an instance\n\n**Why.** Fields, properties and non-static methods belong to a value. Static methods have no `this`.\n\n**Example.**\n\n```\nstruct Counter {\n    i64 count\n    static i64 twice() => count * 2\n}\n```\n\n**Fix.** Make the method an instance method, or pass the value as a parameter.\n"
const doc2018: string = "# BYN2018: `this` outside a method\n\n**Why.** `this` is the value a method was called on. Functions and static methods are not called on a value.\n\n**Example.**\n\n```\ni64 f() => this.x\n```\n\n**Fix.** Take the value as a parameter.\n"
const doc2019: string = "# BYN2019: not a value\n\n**Why.** Types and modules name things at compile time; they cannot be stored or passed. Neither can a function or method named without its call parentheses: there are no function values yet.\n\n**Example.**\n\n```\nstruct Money { i64 cents }\nlet t = Money\n```\n\n**Fix.** Construct a value (`Money { cents: 0 }`) or call a function from the module (`money.parse(s)`). For a method, add the parentheses: `items.copy()`.\n"
const doc2020: string = "# BYN2020: unknown label\n\n**Why.** `break label;` and `continue label;` leave the enclosing loop with that label.\n\n**Example.**\n\n```\nfor i in 0..3 { break outer }\n```\n\n**Fix.** Label the loop (`outer: for (…)`) or fix the label's spelling.\n"
const doc2021: string = "# BYN2021: unknown parameter\n\n**Why.** A named argument must match a parameter name of the function being called.\n\n**Example.**\n\n```\nvoid resize(i64 width) { }\nresize(widht: 3)\n```\n\n**Fix.** Use the parameter's name (the fix suggests the closest one).\n"
const doc2022: string = "# BYN2022: not supported in v0.1\n\n**Why.** The syntax is part of Bayan, but this version of the compiler does not implement it yet. Reporting it keeps programs from silently meaning something else.\n\n**Example.**\n\n```\nlet x = a?.b\n```\n\n**Fix.** Rewrite without the feature; the help line suggests an alternative when one exists.\n"
const doc2023: string = "# BYN2023: wrong number of type arguments\n\n**Why.** Generic types have a fixed arity: `List<T>` and `Span<T>` take one type argument, and a `struct Pair<A, B>` takes two. `ValidationError` takes one too: a bare `ValidationError` names no type, so there is no `T.Field` for its violations (revision 0011).\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n}\nvar xs: List<i64, i64>\nvoid check(Order o) fails ValidationError { }\n```\n\n**Fix.** Pass exactly the type arguments the type takes: `fails ValidationError<Order>`.\n"
const doc2024: string = "# BYN2024: nested optional\n\n**Why.** `T??` would need two kinds of null, which hides a missing case. Use an error or a small struct to tell them apart.\n\n**Example.**\n\n```\ntype MaybeCount = i64?\nlet x: MaybeCount? = null\n```\n\n**Fix.** Drop the extra `?`.\n"
const doc2025: string = "# BYN2025: void used as a value\n\n**Why.** `void` means a function returns nothing. It cannot be the type of a local, a field or a parameter.\n\n**Example.**\n\n```\nvar x: void\n```\n\n**Fix.** Remove the declaration, or give it a real type.\n"
const doc2026: string = "# BYN2026: declaration as a statement body\n\n**No longer reported.** Retired in design round 2: a statement body is always a block, so a braceless body is BYN1018 before binding, and a declaration can no longer be the whole body. The code stays reserved.\n\n**Why (before round 2).** `if (c) let x = 1;` declares a local that no code can see.\n\n**Example.**\n\n```\nif (ready) let x = 1\n```\n\n**Fix.** Use a block: `if ready { let x = 1; … }`, or declare the local before the `if`.\n"
const doc2027: string = "# BYN2027: `==` with `null`\n\n**What.** `x == null`, `x != null` or `null == x`.\n\n**Why.** Absence is tested with a pattern: `x is null`, `x is not null`. The pattern also narrows `x` in the branch where it is present.\n\n**Example.**\n\n```\nlet name: string? = null\nvoid greet(string? name) { }\nif name != null {\n    greet(name)\n}\n```\n\n**Fix.** Write the pattern (the machine fix does this):\n\n```\nlet name: string? = null\nvoid greet(string name) { }\nif name is not null {\n    greet(name)\n}\n```\n"
const doc2028: string = "# BYN2028: `let` shadows a local of the same type\n\n**What.** A `let` redeclares a local in the same scope, and the new value has the same type as the old one (warning).\n\n**Why.** Redeclaring a name with `let` is for changing its type as a value moves through steps: `let count = count.length;` turns a `string` into an `i32`. When the type stays the same, the second `let` hides the first value without saying how it differs, and a reader cannot tell which one a later line means (HANDOFF §4).\n\n**Example.**\n\n```\ni64 readSize() => 1\nlet size = readSize()\nlet size = size * 2\n```\n\n**Fix.** Reuse the first one, or name the second one for what it is:\n\n```\nlet size = readSize()\nlet doubled = size * 2\n```\n"
const doc2029: string = "# BYN2029: nested `it`\n\n**Why.** `it` names the parameter of the one-parameter lambda being written. Inside a lambda that already uses `it`, a second `it` could mean either parameter, so the shorthand stops at one level. A `requires` rule counts as that level, since its `it` is the field.\n\n**Example.**\n\n```\nbool any(List<i64> xs, by (i64 -> bool) p) => false\nbool first(List<List<i64>> xss, by (List<i64> -> bool) p) => p(xss[0])\n\nvoid main() {\n    let xss: List<List<i64>> = [[1, 2], [3]]\n    let found = first(xss, by: any(it, by: it > 1))\n}\n```\n\n**Fix.** Name the inner lambda's parameter:\n\n```\nlet found = first(xss, by: any(it, by: x => x > 1))\n```\n"
const doc2031: string = "# BYN2031: `toString()` call\n\n**What.** A call to `toString()` or `ToString()`. Bayan has no such method.\n\n**Why.** Display has one protocol (HANDOFF §13): a type writes itself with `formatInto(ref StrBuf)`, and the allocating `format()` is derived from it. Interpolation calls `formatInto` directly, so `$\"{x}\"` never builds a temporary string. A `toString()` beside them would be a second, allocating way to do the same thing.\n\n**Example.**\n\n```\nlet total = 1\nlet text = total.toString()\n```\n\n**Fix.** Call `format()` (the machine fix renames the call), or interpolate the value where it is written:\n\n```\nlet text = total.format()\nprint($\"{total}\")\n```\n"
const doc2032: string = "# BYN2032: unknown std module\n\n**Why.** `import std.a.b;` reads the std module `a/b/` shipped with the compiler (`lib/std/`), never a directory of the package; this build ships no module of that name.\n\n**Example.**\n\n```\nimport std.nope\n```\n\n**Fix.** Check the module name against the list in the help line.\n"
const doc2033: string = "# BYN2033: std module imports a package module\n\n**Why.** A std module (`lib/std/`, shipped with the compiler) is the same source in every package, so it can import only other std modules; a plain `import util` in it would read whatever `util/` the importing package happens to have.\n\n**Example.**\n\n```\n// lib/std/a/a.byn\nimport util\n```\n\n**Fix.** Import `std.…` modules only, or move the code into the package.\n"
const doc2034: string = "# BYN2034: circular field default\n\n**Why.** A field default is bound once, and a struct literal copies it. A default that builds a struct whose own default builds the first again has no end.\n\n**Example.**\n\n```\nstruct A { Owned<B>? b = Owned(B {}) }\nstruct B { Owned<A>? a = Owned(A {}) }\n```\n\n**Fix.** Give one of the fields a default that does not build the other struct, such as `null`, or make it `required`.\n"
const doc2101: string = "# BYN2101: missing initializer\n\n**Why.** `let` and `const` never change, so they must be given their value where they are declared.\n\n**Example.**\n\n```\nlet total\n```\n\n**Fix.** Give it a value, or declare it with `var` (or a type, `i64 total;`) and assign it on every path before use.\n"
const doc2102: string = "# BYN2102: use before assignment\n\n**Why.** A local declared without a value has none until it is assigned. Bayan checks every path, so reading it early is a compile error rather than garbage at run time.\n\n**Example.**\n\n```\nlet ok = true\nvar total: i64\nif ok { total = 1 }\nprint($\"{total}\")\n```\n\n**Fix.** Assign it on every path before the read, or give the declaration a value.\n"
const doc2103: string = "# BYN2103: `out` parameter not assigned\n\n**Why.** The caller reads an `out` argument after the call, so the function must assign it before returning normally.\n\n**Example.**\n\n```\nbool parse(string s, at out i64 value) { return false }\n```\n\n**Fix.** Assign the parameter before each `return` and before the end of the body.\n"
const doc2104: string = "# BYN2104: assignment to an immutable value\n\n**Why.** `let` locals, parameters, loop variables and pattern variables never change after they are bound; this makes data flow easy to follow.\n\n**Example.**\n\n```\nlet total = 0\ntotal += 1\n```\n\nCalling a `ref this` member on a `let` value, or on an element of a `let` collection (`list[0].record()`), is the same error: the call changes the value.\n\n**Fix.** Declare it with `var` if it should change. For parameters, copy into a local `var`, or take the parameter by `ref`.\n"
const doc2105: string = "# BYN2105: readonly field\n\n**Why.** A `readonly` field keeps the value it is given in a constructor or struct literal.\n\n**Example.**\n\n```\nstruct Id { readonly i64 value }\nlet id = Id { value: 1 }\nid.value = 2\n```\n\n**Fix.** Create a new value (`id with { value: 2 }`), or drop `readonly` from the field.\n"
const doc2106: string = "# BYN2106: modifying a temporary or read-only value\n\n**Why.** Only variables, fields of variables, and elements of lists, arrays and spans can be written. A call result is a temporary copy, and the bytes of a string are read-only.\n\n**Example.**\n\n```\nlet s = \"abc\"\ns.bytes[0] = 65\n```\n\n**Fix.** Store the value in a `var` first, or copy the bytes into a buffer you own.\n"
const doc2107: string = "# BYN2107: getter modifies its value\n\n**Why.** Reading a property must not change the value; otherwise `x.count` in a `let` would be an error at a distance.\n\n**Example.**\n\n```\nstruct Counter {\n    i64 n\n    i64 next => record()\n    i64 record(ref this) {\n        n += 1\n        return n\n    }\n}\n```\n\n**Fix.** Make it a method: `i64 next() { … }`.\n"
const doc2108: string = "# BYN2108: required field with a default\n\n**Why.** `required` means every struct literal must set the field; a default would never be used.\n\n**Example.**\n\n```\nstruct User { required string name = \"\" }\n```\n\n**Fix.** Remove `required` or remove the default.\n"
const doc2109: string = "# BYN2109: missing fields\n\n**Why.** A struct literal must set every field that is `required` or has no default, so no value is ever half-built.\n\n**Example.**\n\n```\nstruct Point {\n    i64 x\n    i64 y\n}\nlet p = Point { x: 1 }\n```\n\n**Fix.** Set the missing fields, or give them defaults in the struct.\n"
const doc2110: string = "# BYN2110: field set twice\n\n**Why.** Each field gets one value in a struct literal; a second one would silently win.\n\n**Example.**\n\n```\nstruct Point {\n    i64 x\n}\nlet p = Point { x: 1, x: 2 }\n```\n\n**Fix.** Remove one of them.\n"
const doc2111: string = "# BYN2111: struct literal bypasses a constructor\n\n**Why.** A constructor establishes invariants; a struct literal from outside the struct would skip them.\n\n**Example.**\n\n```\nstruct Ratio {\n    i64 num\n    i64 den\n\n    public Ratio(i64 num, to i64 den) {\n        this.num = num\n        this.den = den\n    }\n}\n\nlet r = Ratio { num: 1, den: 0 }\n```\n\n**Fix.** Call the constructor: `Ratio(1, 2)`.\n"
const doc2112: string = "# BYN2112: no constructor\n\n**Why.** Structs without a constructor are built with a struct literal, which names each field.\n\n**Example.**\n\n```\nstruct Point {\n    i64 x\n    i64 y\n}\nlet p = Point(1, 2)\n```\n\n**Fix.** Use a struct literal: `Point { x: 1, y: 2 }`.\n"
const doc2113: string = "# BYN2113: recursive struct\n\n**No longer reported since M21.** A struct that contains itself by value is now BYN2761, which names the whole cycle and covers unions too. The code stays reserved.\n\n**Why (before M21).** Structs are stored by value, so a struct that contains itself (directly or through other structs) would be infinitely large.\n\n**Example.**\n\n```\nstruct Node {\n    i64 value\n    Node? next\n}\n```\n\n**Fix.** Store the next node as `Owned<Node>?`, the children in a `List<Node>`, or refer to them by index.\n"
const doc2114: string = "# BYN2114: not a struct\n\n**Why.** Struct literals and `with` expressions build struct values; other types have no fields to set.\n\n**Example.**\n\n```\nlet n = 5\nlet m = n with { value: 1 }\n```\n\n**Fix.** Use a struct type.\n"
const doc2115: string = "# BYN2115: method modifies `this` without `ref this`\n\n**What.** A method assigns to a field of `this`, or calls a `ref this` member on `this`, but does not declare `ref this` as its first parameter.\n\n**Why.** Members are read-only by default (spec §9). `ref this` in the signature tells the reader, and the compiler, that a call changes its receiver, so calling it on a `let` is an error at the call site instead of a surprise inside the body. The compiler checks the declaration; it does not infer it.\n\n**Example.**\n\n```\nstruct Counter {\n    i64 n\n\n    void bump() {\n        n += 1\n    }\n}\n```\n\n**Fix.** Declare `ref this` as the first parameter (the machine fix inserts it):\n\n```\nstruct Counter {\n    i64 n\n\n    void bump(ref this) {\n        n += 1\n    }\n}\n```\n\nIf the method should not change the value, return a new value instead of writing to `this`.\n"
const doc2116: string = "# BYN2116: operator with `ref this`\n\n**Not reported yet.** Operator declarations are spec-only (spec §2); the code is reserved for when they arrive.\n\n**What.** An operator (`+ - * / %`, unary `-`, `[]` or `compare`) declares `ref this`.\n\n**Why.** Operators are `static` and build a result from their operands; `a + b` must not change `a`. A mutating form such as `+=` is derived from the operator, not written by hand.\n\n**Example.**\n\n```\nstruct Version {\n    i64 major\n    i64 minor\n\n    static Ordering compare(ref this, Version other) { }\n}\n```\n\n**Fix.** Take both operands as parameters:\n\n```\nstruct Version {\n    i64 major\n    i64 minor\n\n    static Ordering compare(Version a, Version b) { … }\n}\n```\n"
const doc2117: string = "# BYN2117: `ref this` is not the first parameter\n\n**What.** `ref this` appears in a parameter list after another parameter, or twice.\n\n**Why.** `ref this` is not an ordinary parameter: it marks the member as mutating (spec §9) and stands for the receiver, which is written before the `.` at the call site. Keeping it first makes every mutating signature read the same way.\n\n**Example.**\n\n```\nvoid add(i64 by, ref this) { n += by }\n```\n\n**Fix.** Move `ref this` to the start of the parameter list:\n\n```\nvoid add(ref this, i64 by) { n += by }\n```\n"
const doc2201: string = "# BYN2201: string indexer\n\n**Why.** A `string` is UTF-8. `s[i]` would have to pick between a byte, a code point and a grapheme, and either be wrong for some text or hide an O(n) scan. Bayan makes you choose.\n\n**Example.**\n\n```\nlet name = \"Ali\"\nlet first = name[0]\n```\n\n**Fix.** Read a byte, slice, or take characters: `s.bytes[i]` for the byte at offset `i` (the machine fix), `s[a..b]` for the text between byte offsets, `s.runes.take(n)` for the first `n` runes, or `s.graphemes` for user-perceived characters.\n"
const doc2202: string = "# BYN2202: type mismatch\n\n**Why.** Bayan converts implicitly only when nothing can be lost: widening integers, `T` to `T?`. Everything else needs an explicit cast.\n\n**Example.**\n\n```\nlet big: i64 = 3\nlet small: i32 = big\n```\n\n**Fix.** Convert explicitly with a cast (the fix inserts one), or change the declared type.\n"
const doc2203: string = "# BYN2203: literal out of range\n\n**Why.** An integer literal takes its type from the context; a value outside that type's range would silently wrap.\n\n**Example.**\n\n```\nlet b: u8 = 300\n```\n\n**Fix.** Use a wider type or a smaller value.\n"
const doc2204: string = "# BYN2204: constant overflow\n\n**Why.** The compiler evaluates constant expressions; one that overflows would panic every time it runs.\n\n**Example.**\n\n```\nconst big: i32 = 2_000_000_000 * 2\n```\n\n**Fix.** Use a wider type, or the wrapping operators (`*%`) if wrapping is intended.\n"
const doc2205: string = "# BYN2205: division by zero\n\n**Why.** Integer division by zero traps at run time; a constant divisor of zero always does.\n\n**Example.**\n\n```\nlet x = 10 / 0\n```\n\n**Fix.** Divide by a non-zero value.\n"
const doc2206: string = "# BYN2206: invalid cast\n\n**Why.** Casts convert between numeric types and between `rune` and integers. Other conversions are functions (`parse`, `formatInto`).\n\n**Example.**\n\n```\nlet n = i64(\"42\")\n```\n\n**Fix.** Call a conversion function instead.\n"
const doc2207: string = "# BYN2207: bad unary operand\n\n**Why.** Each operator works on specific types: `-` on signed numbers, `!` on `bool`, `~` on integers, `++`/`--` on integer variables.\n\n**Example.**\n\n```\nlet n: u32 = 5\nlet x = -n\n```\n\n**Fix.** Use an operand of a type the operator supports, or cast first.\n"
const doc2208: string = "# BYN2208: bad binary operands\n\n**Why.** Arithmetic needs two numbers of compatible types; mixing signed and unsigned, or numbers and `bool`, needs an explicit cast so the intended type is visible.\n\n**Example.**\n\n```\nlet a: i64 = 1\nlet b: u64 = 2\nlet c = a + b\n```\n\n**Fix.** Cast one operand so both have the same type.\n"
const doc2209: string = "# BYN2209: string concatenation\n\n**What.** `+` (or `+=`) with `string` operands. Strings cannot be joined with `+`, not even constants.\n\n**Why.** `+` on strings would allocate behind your back, and in a loop it is quadratic. Bayan keeps allocation visible: interpolation writes straight into its output or a buffer. One rule for every operand, constant or not, keeps the language small (HANDOFF §12). A string pattern such as `\"/api/\" + var rest` is not concatenation and stays legal.\n\n**Example.**\n\n```\nlet name = \"x\"\nlet greeting = \"Hello, \" + name\nlet path = \"/usr\" + \"/lib\"\n```\n\n**Fix.** Interpolate the parts (the machine fix rewrites `a + b` to `$\"{a}{b}\"`, inlining literal text). Two literals become one literal, which stays a constant:\n\n```\nlet greeting = $\"Hello, {name}\"\nlet path = \"/usr/lib\"\n```\n\nTo build text in a loop, append to a `StrBuf`: `buf.append($\"{a}{b}\")`.\n"
const doc2210: string = "# BYN2210: `??` on a non-optional value\n\n**Why.** `a ?? b` uses `b` when `a` is null; a value that cannot be null never uses `b`.\n\n**Example.**\n\n```\nlet n = 5 ?? 0\n```\n\n**Fix.** Remove `?? …`.\n"
const doc2211: string = "# BYN2211: member of an optional value\n\n**Why.** An optional value must be checked before its members are used, so a null is handled where it can occur.\n\n**Example.**\n\n```\nstruct Point {\n    i64 x\n}\nlet p: Point? = null\nlet x = p.x\n```\n\n**Fix.** Check it first: `if (p is { } point) { … point.x … }`, or supply a default: `(p ?? origin).x`.\n"
const doc2212: string = "# BYN2212: not indexable\n\n**Why.** Indexing works on arrays, spans and lists.\n\n**Example.**\n\n```\nlet n = 5\nlet d = n[0]\n```\n\n**Fix.** Index a collection instead.\n"
const doc2213: string = "# BYN2213: constant index out of range\n\n**Why.** A fixed array's length is known at compile time, so a constant index past the end is always a bug.\n\n**Example.**\n\n```\nlet xs: i64[3] = [1, 2, 3]\nlet x = xs[3]\n```\n\n**Fix.** Use an index from 0 to length − 1.\n"
const doc2214: string = "# BYN2214: `^` outside an index\n\n**Why.** `^n` means \"n from the end\" of the collection being indexed; outside an index there is no end to count from.\n\n**Example.**\n\n```\nlet i = ^1\n```\n\n**Fix.** Use it as `xs[^1]`, or compute `xs.length - 1`.\n"
const doc2215: string = "# BYN2215: open range\n\n**Why.** Open ranges (`a..`, `..b`) are only meaningful as slices, where the collection supplies the missing end.\n\n**Example.**\n\n```\nfor i in 0.. { }\n```\n\n**Fix.** Give both ends: `0..n`.\n"
const doc2216: string = "# BYN2216: branch type mismatch\n\n**Why.** Both branches of `?:` (and every arm of a `switch` expression) produce the expression's value, so they need a common type.\n\n**Example.**\n\n```\nlet ok = true\nlet x = ok ? 1 : \"no\"\n```\n\n**Fix.** Make the branches agree, converting one of them explicitly if needed.\n"
const doc2217: string = "# BYN2217: cannot infer type\n\n**Why.** A local's type comes from its value; `null`, `[]`, and a declaration with no value say nothing about the type.\n\n**Example.**\n\n```\nlet x = null\n```\n\n**Fix.** Write the type: `i64? x = null;`.\n"
const doc2218: string = "# BYN2218: no target type\n\n**Why.** `.variant`, `{ … }` and `[ … ]` take their type from where they are used: a declared local, a parameter or a return type.\n\n**Example.**\n\n```\nlet e = .invalid\n```\n\n**Fix.** Write the type out: `MoneyError.invalid`, `Point { … }`, or declare the local's type.\n"
const doc2219: string = "# BYN2219: not a constant\n\n**Why.** Constants, array lengths, parameter defaults and patterns are evaluated by the compiler. A spread `..xs` into a fixed array or `Span` literal must also have a compile-time length, because the literal's storage is sized on the stack.\n\n**Example.**\n\n```\ni64 compute() => 1\nconst n: i64 = compute()\n```\n\n**Fix.** Use literals and other constants, or make it a `let`. For a spread, spread a fixed array `T[N]`, or make the target a `List<T>`.\n"
const doc2220: string = "# BYN2220: not callable\n\n**Why.** Only functions, methods and types with a constructor (or built-ins such as `List<T>()`) can be called. Bayan has no function values in v0.1.\n\n**Example.**\n\n```\nlet n = 5\nn()\n```\n\n**Fix.** Call a function, or for numbers convert with a cast: `(i64)x`.\n"
const doc2221: string = "# BYN2221: not iterable\n\n**Why.** `for` walks ranges, arrays, spans, lists, the characters of a string, and user types conforming to `IIndexable` or `IEnumerator`.\n\n**Example.**\n\n```\nfor x in 5 { }\n```\n\n**Fix.** Iterate a range (`0..n`) or a collection, or make the type conform to `IIndexable` (`i64 count { get; }` and `Item get(i64 index)`) or `IEnumerator` (`bool moveNext(ref this)` and `Item current { get; }`).\n"
const doc2222: string = "# BYN2222: array length mismatch\n\n**Why.** A fixed array `T[N]` holds exactly N elements; the literal must provide all of them.\n\n**Example.**\n\n```\nlet xs: i64[3] = [1, 2]\n```\n\n**Fix.** Provide every element, or change the length.\n"
const doc2223: string = "# BYN2223: tuple name mismatch\n\n**Why.** Tuple element names are part of the type; a mismatched name usually means swapped values.\n\n**Example.**\n\n```\nlet p: (i64 x, i64 y) = (y: 1, x: 2)\n```\n\n**Fix.** Use the names of the target type, in order.\n"
const doc2224: string = "# BYN2224: interpolation not allowed here\n\n**No longer reported since M14.** `$\"…\"` is now an expression of type `string` anywhere: outside `print`, `panic` and `StrBuf.append` it formats into a temporary growable `StrBuf` from `context.allocator`, and the result borrows that allocator's region. The code stays reserved.\n\n**Why (before M14).** `$\"…\"` wrote straight into its output (standard output, a panic message, a `StrBuf`) without allocating. Storing it would have needed a hidden allocation.\n\n**Example.**\n\n```\nlet n = 1\nlet msg = $\"total {n}\"\n```\n\n**Fix.** None needed today. To keep text past a `using` arena, build it outside the arena's `context` or `.copy(to: alloc)` it into a longer-lived allocator.\n"
const doc2225: string = "# BYN2225: not formattable\n\n**What.** An interpolation hole holds a value with no textual form.\n\n**Why.** Interpolation formats primitives, errors, enums, optionals and tuples of them, and structs that define `formatInto(ref StrBuf)`. Structs have no default display (HANDOFF §13): the compiler will not guess a format for you. Spans, lists and arenas have no single textual form.\n\n**Example.**\n\n```\nstruct Q {\n    List<i64> xs\n}\nlet q = Q { xs: List<i64>() }\nprint($\"{q}\")\n```\n\n**Fix.** Add `formatInto(ref StrBuf)` to the struct, or use `{x, as: .debug}` for the debug form (the struct-literal form, when every field formats):\n\n```\nstruct Point {\n    i64 x\n    i64 y\n\n    void formatInto(ref StrBuf out) {\n        out.append($\"({x}, {y})\")\n    }\n}\n```\n\nFor a collection, format the elements in a loop, or a summary such as `xs.length`.\n"
const doc2226: string = "# BYN2226: not disposable\n\n**Why.** `using` releases a value's memory at the end of the scope; only `Arena` and `List<T>` own memory in v0.1.\n\n**Example.**\n\n```\nusing let n = 5\n```\n\n**Fix.** Remove `using`.\n"
const doc2227: string = "# BYN2227: ambiguous variant\n\n**Why.** When a function can fail with several error sets, a bare `.variant` must name exactly one variant.\n\n**Example.**\n\n```\nunion error MoneyError {\n    invalid\n}\nunion error ParseError {\n    invalid\n}\nvoid check(i64 n) fails MoneyError, ParseError {\n    fail .invalid if n < 0   // both MoneyError and ParseError have `invalid`\n}\n```\n\n**Fix.** Qualify it: `MoneyError.invalid`.\n"
const doc2228: string = "# BYN2228: unknown variant\n\n**Why.** An error enum lists its variants; others do not exist.\n\n**Example.**\n\n```\nunion error MoneyError {\n    invalid\n}\nvoid check() fails MoneyError {\n    fail MoneyError.overflow\n}\n```\n\n**Fix.** Use one of the declared variants, or add the variant to the error enum.\n"
const doc2229: string = "# BYN2229: invalid const array\n\n**Why.** A module-level `const` array is stored once as static data, so its element type must be a number type, `bool`, `rune` or `string`, its type a fixed-size `T[N]`, and every element a literal or constant. Structs, `List`s and computed elements have no static form.\n\n**Example.**\n\n```\ni64 twice(i64 x) => x * 2\nconst table: i64[3] = [1, twice(2), 3]\n```\n\n**Fix.** Use only literals and constants, or build the collection at run time with `let`.\n"
const doc2230: string = "# BYN2230: renamed member\n\n**What.** A built-in member is used under its old name: `add` on a `List`, `asString()` on a `StrBuf`, `onPanic` on `Panic`, or a round-3 rename that changes the call's shape.\n\n**Why.** Round 2 gives each idea one name (HANDOFF §11, §12). Ordered collections `append` (unordered ones `add`). A `StrBuf` hands back its text with `finish()`, or lends it with `view`. The old names stay recognised so the compiler can tell you the new one. Sizes keep `length` (round 3 keeps length). Round 3 names the panic hook for its role, `Panic.handler`; spells ranges and lookups with particles (`remove(from:until:)`, `tryGet(at:)`); and drops the `toX`/`asX` members for a view noun (`span`) and the `string(x, as:)` conversion. Decoding bytes is a codec, `Utf8.decode`, and `string(x)` only formats.\n\n| Old | New |\n|---|---|\n| `list.add(x)` | `list.append(x)` |\n| `buf.asString()` | `buf.finish()` |\n| `Panic.onPanic = f` | `Panic.handler = f` |\n| `list.removeRange(a, b)` | `list.remove(from: a, until: b)` |\n| `list.replaceRange(r, items)` | `list.replace(at: r, by: items)` |\n| `map.getOr(k, d)` | `(map.tryGet(at: k) ?? d)` |\n| `xs.asSpan()` | `xs.span` |\n| `n.toHex()`, `n.toBinary()`, `n.toOctal()` | `string(n, as: .hex)`, `.binary`, `.octal` |\n| `s.offset(x)` | `s.position(x)` |\n| `s.toUtf16()` | `s.utf16` |\n| `xs.toList()` | `xs.copy()` |\n| `array.toList()` | `array.span.copy()` |\n| `string.from(bytes)`, `string.fromUtf8(bytes)` | `Utf8.decode(bytes)` |\n| `string.tryFrom(bytes)` | `Utf8.tryDecode(bytes)` |\n| `try string(bytes)` | `try Utf8.decode(bytes)` |\n\n**Example.**\n\n```\nvar xs = List<i64>()\nxs.add(1)\nvar buf = StrBuf()\nprint(buf.asString())\n```\n\n**Fix.** Write the new name (the machine fix does it):\n\n```\nvar xs = List<i64>()\nxs.append(1)\nprint(buf.finish())\n```\n"
const doc2234: string = "# BYN2234: `while let` on a value that cannot be null\n\n**What.** `while let x = e { … }` loops while `e` is non-null and binds `x` to its value. Here `e` is not an optional (`T?`), so the loop would never stop on its own.\n\n**Why.** The loop's only exit test is \"is the value null?\"; a value that cannot be null makes the test meaningless and the loop endless.\n\n**Example.**\n\n```\ni64 next() => 1\nwhile let n = next() { print($\"{n}\") }\n```\n\n**Fix.** Return `T?` from the source (`i64? next()`) so the loop ends at `null`, or loop with a condition: `while n < 10 { … }`. To bind a value once, write `let n = next();`.\n"
const doc2235: string = "# BYN2235: spread of something that is not a sequence\n\n**What.** `..x` inside a collection literal adds every element of `x`, so `x` must be a `List<T>`, a `Span<T>` or a fixed array `T[N]`. A number, a string or a map has no elements to add this way.\n\n**Why.** A spread copies a sequence's elements into the literal in order; anything else has no order or no elements of the literal's element type.\n\n**Example.**\n\n```\nlet n = 5\nlet xs: List<i32> = [..n, 1]\n```\n\n**Fix.** To add one value, drop the `..`; to add several, spread a list, span or fixed array.\n\n```\nlet n = 5\nlet xs: List<i32> = [n, 1]\n```\n"
const doc2236: string = "# BYN2236: map literal with an element that is not `key: value`\n\n**What.** A collection literal with a `key: value` element is a map literal, and then every element needs a key. An element without one (a plain value or a `..` spread) has no key to store it under.\n\n**Why.** `[\"a\": 1, 2]` is neither a list nor a map; the compiler does not guess which one was meant.\n\n**Example.**\n\n```\nlet stock: Map<string, i32> = [\"A-1\": 12, 3]\n```\n\n**Fix.** Give every element a key, or remove the keys to make a list.\n\n```\nlet stock: Map<string, i32> = [\"A-1\": 12, \"B-2\": 3]\n```\n"
const doc2301: string = "# BYN2301: missing argument\n\n**Why.** Every parameter without a default needs an argument.\n\n**Example.**\n\n```\ni64 area(i64 width, by i64 height) => width * height\nlet a = area(3)\n```\n\n**Fix.** Pass the missing argument, or give the parameter a default.\n"
const doc2302: string = "# BYN2302: too many arguments\n\n**Why.** A call passes at most one argument per parameter.\n\n**Example.**\n\n```\ni64 twice(i64 n) => n * 2\nlet a = twice(1, 2)\n```\n\n**Fix.** Remove the extra arguments.\n"
const doc2303: string = "# BYN2303: argument passed twice\n\n**Why.** Each parameter receives one argument.\n\n**Example.**\n\n```\ni64 area(i64 width, by i64 height) => width * height\nlet a = area(3, by: 1, by: 2)\n```\n\n**Fix.** Remove one of them.\n"
const doc2304: string = "# BYN2304: positional after named\n\n**Why.** After a named argument, positions no longer line up with parameters.\n\n**Example.**\n\n```\ni64 f(i64 x, by i64 y) => x + y\nlet a = f(by: 1, 2)\n```\n\n**Fix.** Name the remaining arguments too.\n"
const doc2305: string = "# BYN2305: argument must be named\n\n**Why.** `f(true)` doesn't say what the argument means. Bayan requires the parameter name for `bool` parameters. An argument that is a variable or field with the parameter's name (`verbose` or `options.verbose` for `verbose`) counts as named. Parameters that share a type no longer need names: since design round 3 every required parameter besides the object carries a particle, and the call writes it (BYN5005).\n\n**Example.**\n\n```\nvoid show(bool verbose) {\n}\n\nshow(true)\n```\n\n**Fix.** Name it: `show(verbose: true)`.\n"
const doc2306: string = "# BYN2306: argument modifier mismatch\n\n**Why.** `ref` and `out` show at the call site that the callee may change the caller's variable; they must match the parameter.\n\n**Example.**\n\n```\nvoid bump(ref i64 total) { }\nvar total: i64 = 0\nbump(total)   // void bump(ref i64 total)\n```\n\n**Fix.** Write the modifier the parameter declares: `bump(ref total)`.\n\nSee GRAMMAR: Role marks (docs/bayan-grammar.md §15).\n"
const doc2307: string = "# BYN2307: arguments in the wrong order\n\n**No longer reported.** Retired in design round 3 (§15): particles replace the same-type naming rule. Every required parameter besides the object carries a particle, and the call writes it, so a swapped pair is a missing particle (BYN5005), with the missing particle as the fix. The code stays reserved.\n\n**Why (before design round 3).** An argument written as a variable or field named like a parameter (`start`, `tok.start`) said which parameter it was for. When every unnamed argument did that and they didn't line up with the parameters, the call had them swapped.\n\n**Example (before design round 3).**\n\n```\ni64 width(i64 start, i64 end) => end - start\nwidth(end, start)\n```\n\n**Now.** The second parameter takes a particle, and the call writes it:\n\n```\ni64 width(i64 start, until i64 end) => end - start\nwidth(start, until: end)\n```\n"
const doc2310: string = "# BYN2310: span parameter is never written through\n\n**Why.** A `Span<T>` parameter promises the function may change the caller's elements, so callers can't pass a `string`, `string.bytes` or another read-only view. A function that only reads should say so with `ReadOnlySpan<T>`; a `Span<T>` still converts to it implicitly.\n\n**Example.**\n\n```\ni64 total(Span<i64> values) {\n    var sum: i64 = 0\n    for v in values {\n        sum += v\n    }\n    return sum\n}\n```\n\n**Fix.** Declare the parameter `ReadOnlySpan<i64> values`.\n"
const doc2311: string = "# BYN2311: `var` is never reassigned\n\n**Why.** A `var` says the value will change; a reader has to look for where. When nothing ever assigns it, increments it, passes it by `ref` or `out`, or mutates through it, the `var` is noise, and `let` says what is true. This applies to locals and to `var` pattern bindings alike (spec §7.1, §6.5). Parameters, `for` loop variables and `let` bindings are never reported.\n\n**Example.**\n\n```\nunion Shape {\n    circle(i64 radius)\n    empty\n}\nlet prices = List<i64>()\nlet shape = Shape.empty\nvar total = prices.length\nprint($\"{total}\")\n\nif shape is .circle(var r) { print($\"{r}\") }\n```\n\n**Fix.** Declare them with `let`: `let total = prices.length;` and `.circle(let r)`.\n"
const doc2320: string = "# BYN2320: `requires` or `expects` condition is not `bool`\n\n**What.** A condition has a type other than `bool`. The condition is either a struct field's `requires` rule or a function's `expects` clause. The message reads \"a `requires` clause must be `bool`, got `i64`\" for both.\n\n**Why.** A `requires` rule checks a field value and an `expects` clause checks the arguments on entry; each panics in every build mode when it is false. Only a `bool` can be true or false (HANDOFF §7).\n\n**Example.**\n\n```\nstruct P { i64 low requires it }\n```\n\nThe same code is reported for a function:\n\n```\ni32 half(i32 n) expects n {\n    return n / 2\n}\n```\n\n**Fix.** Write the condition the value must meet, such as `it > 0` for a field or `count > 0` for a parameter:\n\n```\nstruct P { i64 low requires it >= 0 }\n```\n\nFor the function:\n\n```\ni32 half(i32 n) expects n >= 0 {\n    return n / 2\n}\n```\n"
const doc2321: string = "# BYN2321: constant value violates a `requires` or `expects` contract\n\n**What.** A constant makes a contract false. The contract is either a struct field's `requires` rule, when a struct literal sets the field to a constant that fails it, or a function's `expects` clause, when a call passes a constant argument that fails it. The message names the value and the contract, for example \"`-1` violates `requires it >= 0` of `P`\".\n\n**Why.** A `requires` rule or an `expects` clause is an obligation on the value. A violation is a bug and panics at run time in every build mode; when the value is a constant, the compiler already knows it would panic, so it reports it here instead (HANDOFF §7).\n\n**Example.**\n\n```\nstruct P { i64 low requires it >= 0 }\n\nlet p = P { low: -1 }\n```\n\nThe same code is reported for a function:\n\n```\ni32 discount(i32 total, by i32 percent)\n    expects percent in 0..=100 && total >= 0\n    => total - total * percent / 100\n\nlet price = discount(200, by: 150)\n```\n\n**Fix.** Pass a value that meets the rule or clause (the help reads \"pass a value that meets `requires …`\"):\n\n```\nstruct P { i64 low requires it >= 0 }\n\nlet p = P { low: 1 }\n```\n\nFor the function:\n\n```\ni32 discount(i32 total, by i32 percent)\n    expects percent in 0..=100 && total >= 0\n    => total - total * percent / 100\n\nlet price = discount(200, by: 50)\n```\n"
const doc2322: string = "# BYN2322: retired, `requires` is checked at construction\n\n**No longer reported.** BYN2322 rejected `requires` on fields and distinct types while their checks were not built. Round 3 step 5.3b checks those rules at construction (revision 0006): a struct literal, `with` or `X(raw)` of a type with `requires` fails with `ValidationError` when a rule is broken. The code stays reserved: never reuse it.\n\n**Example.** Accepted; the literal is fallible:\n\n```\nstruct OrderForm {\n    i32 quantity\n        requires it > 0\n}\n\nlet form = try OrderForm { quantity: n }\n```\n\n**Fix.** None needed.\n"
const doc2401: string = "# BYN2401: missing return\n\n**Why.** A function with a return type must produce a value; falling off the end would return garbage.\n\n**Example.**\n\n```\ni64 sign(i64 n) { if n > 0 { return 1 } }\n```\n\n**Fix.** Add a `return` (or `panic(…)`) on the paths that reach the end.\n"
const doc2402: string = "# BYN2402: missing return value\n\n**Why.** A function with a return type must produce a value on every `return`.\n\n**Example.**\n\n```\ni64 f() { return }\n```\n\n**Fix.** Return a value.\n"
const doc2403: string = "# BYN2403: return value in a void function\n\n**Why.** A `void` function produces no value, so a returned value would be lost.\n\n**Example.**\n\n```\nvoid log() { return 1 }\n```\n\n**Fix.** Declare a return type, or remove the value.\n"
const doc2404: string = "# BYN2404: `never` function can return\n\n**Why.** `never` promises the function does not return (it panics, exits or loops forever).\n\n**Example.**\n\n```\nnever halt() {\n    print(\"x\")\n}\n```\n\n**Fix.** End every path with `panic(…)` or a call to another `never` function.\n"
const doc2405: string = "# BYN2405: unreachable code\n\n**Why.** Code after `return`, `break`, `continue`, a failure or a call that returns `never` cannot run; it is usually a mistake.\n\n**Example.**\n\n```\nvoid f() {\n    return\n    print(\"done\")\n}\n```\n\n**Fix.** Remove the code or move it before the jump.\n"
const doc2406: string = "# BYN2406: jump outside a loop\n\n**Why.** `break` leaves a loop or a `switch`; `continue` starts a loop's next iteration.\n\n**Example.**\n\n```\nlet done = true\nif done { break }\n```\n\n**Fix.** Use `return` to leave the function.\n"
const doc2407: string = "# BYN2407: continue targets a switch\n\n**Why.** `continue` starts the next iteration of a loop; a `switch` has no iterations.\n\n**Example.**\n\n```\nlet x = 1\ns: switch x { case 1: continue s }\n```\n\n**Fix.** Label the enclosing loop and continue that.\n"
const doc2408: string = "# BYN2408: label not on a loop\n\n**Why.** Labels exist only for `break label;` and `continue label;`, which target loops and `switch` statements.\n\n**Example.**\n\n```\ndone: print(\"x\")\n```\n\n**Fix.** Remove the label, or move it to a loop.\n"
const doc2409: string = "# BYN2409: duplicate default\n\n**Why.** Only one section can handle the values that no other section matches.\n\n**Example.**\n\n```\nlet x = 1\nswitch x {\n    default: break\n    default: break\n}\n```\n\n**Fix.** Remove one of them.\n"
const doc2410: string = "# BYN2410: non-exhaustive switch\n\n**Why.** A `switch` expression must produce a value for every input, and a `switch` over an enum, an error enum or `bool` must name every case so adding a variant shows every place that needs updating.\n\n**Example.**\n\n```\nlet ok = true\nlet n = ok switch { true => 1 }\n```\n\n**Fix.** Add the missing cases (listed in the label), or `_ => …` / `default:` for the rest. For a union declared in this package, the help names the missing arms and does not suggest `_`, since a `_` arm on such a union is the BYN2712 warning.\n"
const doc2411: string = "# BYN2411: pattern cannot match\n\n**Why.** A pattern that can never match its input's type is always a bug.\n\n**Example.**\n\n```\nlet n = 5\nif n is null { }\n```\n\n**Fix.** Remove the pattern, or match against the right type.\n"
const doc2601: string = "# BYN2601: `try` is not allowed in `defer`\n\n**Why.** Cleanup runs while the function is already returning, possibly because of another error. A failure there would have to replace or drop the first error, so cleanup must not fail. This covers `defer` and `defer failing`.\n\n**Example.**\n\n```\nvoid flush(string file) fails IoError { }\ndefer try flush(\"log\")\n```\n\n**Fix.** Handle the error inside the cleanup:\n\n```\ndefer flush(\"log\") catch log(\"flush failed\")\n```\n"
const doc2602: string = "# BYN2602: unhandled failure\n\n**Why.** Errors are values that must be dealt with where they occur: passed on with `try`, or handled with `catch`. Ignoring one silently is not possible.\n\n**Example.**\n\n```\nunion error ParseError {\n    bad\n}\ni64 parse(string s) fails ParseError => 1\nlet text = \"1\"\nlet m = parse(text)\n```\n\n**Fix.** Write `try parse(text)` in a function that `fails`, or `parse(text) catch …` to handle it.\n"
const doc2603: string = "# BYN2603: undeclared error\n\n**Why.** A function's signature lists every error set it can fail with, so callers know what to handle.\n\n**Example.**\n\n```\nunion error MoneyError {\n    bad\n}\nunion error ParseError {\n    bad\n}\ni64 parse(string s) fails ParseError => 1\ni64 total(string s) fails MoneyError { return try parse(s) }   // parse fails ParseError\n```\n\nThe message and the help name each set with its type arguments: a function that validates two types gets `` help: add it to the signature: `fails ValidationError<Address>, ValidationError<Signup>` ``.\n\n**Fix.** Add the set to the `fails` clause, or handle the error with `catch`.\n"
const doc2604: string = "# BYN2604: `try` in a function that cannot fail\n\n**Why.** `try` passes an error to the caller, which needs a `fails` clause to say so.\n\n**Example.**\n\n```\nunion error ParseError {\n    bad\n}\ni64 parse(string s) fails ParseError => 1\ni64 total(string s) { return try parse(s) }\n```\n\n**Fix.** Handle the error with `catch`, or add `fails …` to the signature.\n"
const doc2605: string = "# BYN2605: nothing to handle\n\n**Why.** `try` and `catch` apply to a call of a function that `fails`; on anything else they do nothing.\n\n**Example.**\n\n```\ni64 twice(i64 n) => n * 2\nlet n = try twice(2)\n```\n\n**Fix.** Remove `try` / `catch`.\n"
const doc2606: string = "# BYN2606: `defer failing` in a function that cannot fail\n\n**Why.** `defer failing` runs only when the function fails. In a function without a `fails` clause it would never run.\n\n**Example.**\n\n```\nvoid cleanup() { }\nvoid f() {\n    defer failing cleanup()\n}\n```\n\n**Fix.** Remove `failing` so the cleanup runs on every exit, or add a `fails` clause if the function can fail:\n\n```\nvoid f() {\n    defer cleanup()\n}\n```\n"
const doc2607: string = "# BYN2607: public function with inferred errors\n\n**Why.** A public function's error sets are part of its API; inferring them would let a change inside the body silently change what callers must handle.\n\n**Example.**\n\n```\npublic i64 parse(string s) fails { return 0 }\n```\n\n**Fix.** List the sets: `fails ParseError`.\n"
const doc2608: string = "# BYN2608: not an error set\n\n**Why.** A `fails` clause lists `error enum` types.\n\n**Example.**\n\n```\ni64 f() fails i64 { return 0 }\n```\n\n**Fix.** Name an error enum.\n"
const doc2609: string = "# BYN2609: empty error set\n\n**Why.** An error enum with no variants can never be produced, so failing with it means nothing.\n\n**Example.**\n\n```\nunion error NoError { }\n```\n\n**Fix.** Add the variants, or remove the enum.\n"
const doc2610: string = "# BYN2610: jump out of defer\n\n**Why.** Cleanup must run to completion; jumping out of a `defer` or `defer failing` body would skip the rest of the cleanup.\n\n**Example.**\n\n```\ndefer { return }\n```\n\n**Fix.** Restructure the cleanup so it ends normally.\n"
const doc2611: string = "# BYN2611: catch block completes\n\n**Why.** When the call fails there is no value to use, so a `catch { … }` block on a call that returns a value has to leave: the code after it would otherwise read a value that was never produced. A call returning `void` has no value, so its block may simply end.\n\n**Example.**\n\n```\nunion error ParseError {\n    bad\n}\ni64 parse(string s) fails ParseError => 1\nvoid log(string s) { }\nlet s = \"1\"\nlet n = parse(s) catch { log(\"x\") }\n```\n\n**Fix.** End the block with `return`, `break`, `continue` or a panic, or give a value with the expression form: `parse(s) catch -1`.\n"
const doc2612: string = "# BYN2612: not allowed in a panic handler\n\n**What.** A `defer panicking` body, or the function named by `Panic.handler`, uses `try`, `return`, `break`, `continue`, an assignment or an allocation.\n\n**Why.** A panic means the program is in a state it cannot trust, and handlers run on the way to aborting it (spec §7.6). Panic handlers can't recover: they cannot resume normal flow, fail, change state, or ask an allocator that may itself be broken for memory. They can only report, flush and release outside resources.\n\n**Example.**\n\n```\nstruct Db {\n    i64 id\n    string name\n}\nvoid log(string s) { }\nvoid save(Db db) {\n    var saved = 0\n    let id = db.id\n    defer panicking {\n        saved = -1\n        let note = $\"save {id} failed\"\n        log(note)\n    }\n}\n```\n\n**Fix.** Write the report straight to `print`, `panic` or a `StrBuf` the handler was given, and read only `let` values:\n\n```\nstruct Db {\n    i64 id\n    string name\n}\nvoid save(Db db) {\n    let name = db.name\n    defer panicking (p) print($\"save to {name} failed: {p.message}\")\n}\n```\n"
const doc2613: string = "# BYN2613: panic handler reads a `var`\n\n**What.** A `defer panicking` body, or the function named by `Panic.handler`, reads a `var` declared outside it. `let` bindings, `is let` and `for` loop variables, and parameters are fine.\n\n**Why.** A panic can happen half way through an update, so a `var` may hold a torn or stale value when the handler runs. A `let` binding, a loop or pattern variable, or a parameter was fixed before the handler was registered, so the handler sees what it was written against (spec §7.6).\n\n**Example.**\n\n```\nvar done = 0\ndefer panicking print($\"{done} items written\")\n```\n\n**Fix.** Copy the value into a `let` before the handler and read that, or leave it out of the report:\n\n```\nlet total = items.length\ndefer panicking print($\"writing {total} items failed\")\n```\n"
const doc2614: string = "# BYN2614: `Panic.handler` set outside the start of `main`\n\n**What.** `Panic.handler = f;` appears somewhere other than the first statement of the program's entry function, appears a second time, or appears in a library package.\n\n**Why.** The hook runs for every panic in the process, after the `defer panicking` handlers and before the trace is printed (spec §7.6). Setting it once, before anything else runs, means every panic sees the same hook and no library can replace the program's choice.\n\n**Example.**\n\n```\nvoid report(Panic p) { }\nvoid main() {\n    print(\"starting\")\n    Panic.handler = report\n}\n```\n\n**Fix.** Make it the first statement of `main`, and set it only there:\n\n```\nvoid main() {\n    Panic.handler = report\n    print(\"starting\")\n}\n```\n\nA library cannot set it; the program that uses the library does.\n"
const doc2615: string = "# BYN2615: panic handler reads a local moved after it\n\n**What.** A `defer panicking` body reads a local that is moved, on some path, after the handler is registered.\n\n**Why.** A panic handler runs at a panic anywhere in its scope, not only at the scope's exit. A panic after the move would run the handler on a value that has already been handed away and may be freed (spec §7.6).\n\n**Example.**\n\n```\nvoid sink(move List<i64> xs) { }\nlet ys = List<i64>()\ndefer panicking print($\"handler sees {ys.length}\")\nsink(move ys)\n```\n\n**Fix.** Move the value before registering the handler, or read a `let` copied from it there:\n\n```\nlet ys = List<i64>()\nlet n = ys.length\ndefer panicking print($\"handler sees {n}\")\nsink(move ys)\n```\n"
const doc2700: string = "# BYN2700: unknown union variant\n\n**Why.** The name after the union, or after a target-typed `.`, must be one of the union's variants.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r)\n    none\n}\n\nlet s = Shape.square(1)\n```\n\n**Fix.** Use a declared variant, or add the variant to the union.\n"
const doc2701: string = "# BYN2701: duplicate union variant\n\n**Why.** Each variant names one tag; two variants with the same name could not be told apart.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r)\n    circle(f32 radius)\n}\n```\n\n**Fix.** Rename or remove one of the variants.\n"
const doc2702: string = "# BYN2702: empty union\n\n**Why.** A union with no variants has no values, so nothing can ever have its type.\n\n**Example.**\n\n```\nunion Nothing { }\n```\n\n**Fix.** Add the variants, or remove the union.\n"
const doc2703: string = "# BYN2703: variant pattern arity\n\n**Why.** A variant pattern lists one subpattern per payload field, in declaration order.\n\n**Example.**\n\n```\nunion Shape {\n    rect(f32 w, f32 h)\n}\n\nf32 width(Shape s) => s switch { .rect(let w) => w }\n```\n\n**Fix.** List every field, with `_` for the ones you do not need: `.rect(let w, _)`.\n"
const doc2704: string = "# BYN2704: payload read without a pattern\n\n**Why.** A union value may hold any of its variants, so a payload field is read only after matching the variant.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r)\n    none\n}\n\nlet s = Shape.circle(1)\nprint(s.r)\n```\n\n**Fix.** Match the variant and bind the field: `if s is .circle(let r) { … }`.\n"
const doc2705: string = "# BYN2705: variant used without its payload\n\n**Why.** A variant with payload fields is constructed by calling it with a value for each field. The same holds for a `union error` case in `fail`.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r)\n    none\n}\n\nlet s = Shape.circle\n\nunion error CarrierError {\n    timeout(i64 after)\n    closed\n}\n\nvoid send() fails CarrierError { fail .timeout }\n```\n\n**Fix.** Pass the payload: `Shape.circle(1)`, `fail .timeout(after: 30)`.\n"
const doc2706: string = "# BYN2706: unit variant called\n\n**Why.** A variant without payload fields is a value on its own; it takes no arguments, and its pattern has no parentheses. The same holds for a `union error` case.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r)\n    none\n}\n\nlet s = Shape.none()\n\nunion error CarrierError {\n    timeout(i64 after)\n    closed\n}\n\nvoid send() fails CarrierError { fail .closed() }\n```\n\n**Fix.** Drop the parentheses: `Shape.none`, `fail .closed`, or `.none` in a pattern.\n"
const doc2707: string = "# BYN2707: recursive union\n\n**No longer reported since M21.** A union that contains itself by value is now BYN2761, which names the whole cycle and covers structs too. The code stays reserved.\n\n**Why (before M21).** Unions are stored inline, so a union that contains itself by value would have infinite size.\n\n**Example.**\n\n```\nunion Expr {\n    number(i64 value)\n    negate(Expr operand)\n}\n```\n\n**Fix.** Store the inner value as `Owned<Expr>`, in a `List` of the union, or as an index into one.\n"
const doc2708: string = "# BYN2708: borrowed union payload\n\n**Why.** A union payload is stored by value; a span would borrow memory the union may outlive.\n\n**Example.**\n\n```\nunion Chunk {\n    bytes(ReadOnlySpan<u8> data)\n    empty\n}\n```\n\n**Fix.** Store an owned `List` copied with `.copy(to: alloc)` instead.\n"
const doc2709: string = "# BYN2709: union case value is not an integer constant\n\n**Why.** A payload-free case may declare the integer it is stored as, for C interop: `union Mode { read = 1, write = 2 }`. The value becomes the case's tag, an `i32`, so it must be an integer literal (optionally negated) that fits in `i32`.\n\n**Example.**\n\n```\nunion Mode {\n    read = 1.5\n    write = \"w\"\n}\n```\n\n**Fix.** Write the value as an integer literal, or remove it:\n\n```\nunion Mode { read = 1, write = 2 }\n```\n"
const doc2710: string = "# BYN2710: union case with data has a value\n\n**Why.** Only payload-free cases can declare an integer value; a case that carries data is not a plain integer on the C side.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r) = 1\n    none = 2\n}\n```\n\n**Fix.** Remove the value from the case that carries data:\n\n```\nunion Shape { circle(f32 r), none = 2 }\n```\n"
const doc2711: string = "# BYN2711: two union cases share a value\n\n**Why.** A case's value is its tag; two cases with the same tag could not be told apart. A case without a value takes one more than the case before it, so it can collide with a later explicit value.\n\n**Example.**\n\n```\nunion Mode {\n    read = 1\n    write = 1\n}\nunion Level {\n    low = 1\n    mid\n    high = 2\n}\n```\n\n**Fix.** Give each case its own value:\n\n```\nunion Mode { read = 1, write = 2 }\nunion Level { low = 1, mid, high = 3 }\n```\n"
const doc2712: string = "# BYN2712: `_` arm on a union declared in this package (warning)\n\n**Why.** A `switch` on a union is exhaustive: when a case is added, every `switch` that does not handle it is an error, which points at the code to update. A `_` arm matches every case, including the ones added later, so it hides those errors. For a union declared in the same package, you can list its cases instead.\n\n**Example.**\n\n```\nunion Shape {\n    circle(f32 r)\n    rect(f32 w, f32 h)\n    none\n}\n\nf32 area(Shape s) => s switch {\n    .circle(let r) => r * r,\n    _ => 0,\n}\n```\n\n**Fix.** List the remaining cases instead of `_` (the help lists them):\n\n```\nf32 area(Shape s) => s switch {\n    .circle(let r) => r * r,\n    .rect(_, _) or .none => 0,\n}\n```\n"
const doc2720: string = "# BYN2720: unknown enum member\n\n**Why.** An enum lists its members; others do not exist. Besides its members, an enum type has only `count`, `values`, `fromOrdinal` and `parse`.\n\n**Example.**\n\n```\nenum Color {\n    red\n    green\n    blue\n}\n\nlet c = Color.gren\n```\n\n**Fix.** Use one of the declared members, or add the member to the enum.\n"
const doc2721: string = "# BYN2721: duplicate enum member\n\n**Why.** Each member of an enum names one value, so a name can appear only once.\n\n**Example.**\n\n```\nenum Color {\n    red\n    green\n    red\n}\n```\n\n**Fix.** Remove the repeated member, or rename it.\n"
const doc2722: string = "# BYN2722: empty enum\n\n**Why.** An enum with no members has no values, so nothing can ever have its type.\n\n**Example.**\n\n```\nenum Nothing { }\n```\n\n**Fix.** Add the members, or remove the enum.\n"
const doc2723: string = "# BYN2723: enum argument is not constant\n\n**Why.** The data of an enum member is stored once in a static table, indexed by ordinal, so every argument must be known at compile time: a literal, a `const`, an expression of those, or a member of a plain enum.\n\n**Example.**\n\n```\ni64 twice(i64 n) => n * 2\nenum Size(i64 bytes) {\n    small(1)\n    large(twice(512))\n}\n```\n\n**Fix.** Write the value as a literal or a `const` (`large(1024)`), or compute it at run time from the member, for example in a function taking the enum.\n"
const doc2724: string = "# BYN2724: invalid enum parameter\n\n**Why.** Each parameter of a data enum becomes a static table with one entry per member, so its type must have a static form: a number type, `bool`, `rune`, `string` or a plain enum (one without data). Parameters are read-only values, so `ref`, `out`, `in`, `move` and default values are not allowed either.\n\n**Example.**\n\n```\nstruct Point { i64 x }\nenum Shape(Point corner) {\n    square(Point { x: 0 })\n}\n```\n\n**Fix.** Store the parts as separate scalar parameters (`enum Shape(i64 cornerX)`), and pass every argument explicitly.\n"
const doc2740: string = "# BYN2740: cannot infer a type argument\n\n**Why.** A call of a generic function reads its type arguments from the types of its arguments. When no argument mentions a type parameter (or every such argument is `null`), there is nothing to read it from; Bayan does not infer type arguments from the expected type of the call.\n\n**Example.**\n\n```\nT? none<T>() => null\nvar x = none()\n```\n\n**Fix.** Write the type arguments out, as in `none<i64>()`, or pass an argument the type can be read from.\n"
const doc2741: string = "# BYN2741: conflicting type arguments\n\n**Why.** Every argument whose parameter mentions a type parameter fixes that type parameter. When two of them fix it to different types and neither converts to the other, the call has no single instantiation.\n\n**Example.**\n\n```\nvoid both<T>(T a, by T b) { }\nboth(1, by: \"one\")\n```\n\n**Fix.** Make the arguments agree, convert one of them, or write the type arguments out, as in `both<string>(…)`.\n"
const doc2742: string = "# BYN2742: wrong number of type arguments in a call\n\n**Why.** A generic function takes exactly as many type arguments as it declares type parameters; a function that is not generic takes none.\n\n**Example.**\n\n```\nvoid both<T>(T a, by T b) { }\nboth<i64, string>(1, by: 2)\n```\n\n**Fix.** Pass one type argument per type parameter, or leave them all out and let the arguments decide.\n"
const doc2743: string = "# BYN2743: operator on a type parameter\n\n**Why.** Type parameters have no constraints, so the body of a generic function or type must be valid for every type it could be instantiated with. A value of a type parameter `T` can only be copied, compared with `==` and `!=`, passed, stored, returned and formatted; arithmetic, ordering (`<`, `<=`, `>`, `>=`), logic and bitwise operators are not available on every type.\n\n**Example.**\n\n```\nT add<T>(T a, by T b) => a + b\n```\n\n**Fix.** Write the function for the concrete type (`i64 add(i64 a, by i64 b)`), or pass the operation in as data the caller computes.\n"
const doc2744: string = "# BYN2744: member of a type parameter\n\n**Why.** A type parameter with no `where` clause has no known members: a field, property or method that one type argument has, another lacks. (With a `where T : I` clause, a missing member is [BYN2806](BYN2806.md).)\n\n**Example.**\n\n```\ni64 size<T>(T x) => x.length\n```\n\n**Fix.** Add `where T : I` naming an interface that declares the member, or take the concrete type the member belongs to.\n"
const doc2760: string = "# BYN2760: invalid `Map` key\n\n**Why.** A `Map` hashes and compares its keys by their value, so a key must be a type with one obvious equality: an integer type, `rune`, `bool`, `string`, `Symbol`, a plain enum (one without data), or a tuple or struct whose parts are all keys. Floats (where `0.0 == -0.0` and `NaN != NaN`), optionals, enums with data, unions, collections and `@noEquality` structs are not keys. A tuple or struct with a part that is not a key is [BYN2831](BYN2831.md), which names the part.\n\n**Example.**\n\n```\nlet byWeight = Map<f64, string>()\n```\n\n**Fix.** Key by a value of one of the allowed types, such as an integer id, a `string` or `Symbol` name, a plain enum, or a tuple or struct of those.\n"
const doc2761: string = "# BYN2761: type contains itself by value\n\n**Why.** Structs and unions are stored inline: a field or payload of type `T` holds a whole `T`. A type that contains itself by value, directly or through other structs, unions, optionals, arrays or tuples, would be infinitely large. The message lists the cycle, starting and ending at the reported type. `Owned<T>` is a pointer into an allocator and `List<T>` holds its elements elsewhere, so either breaks the cycle.\n\n**Example.**\n\n```\nunion Expr {\n    lit(i64 v)\n    add(Expr l, Expr r)\n}\n\nstruct Tree {\n    i64 value\n    Forest children\n}\nstruct Forest { Tree first }\n```\n\n**Fix.** Refer to the inner value through `Owned<…>`, built with `Owned(value)` from `context.allocator`:\n\n```\nunion Expr {\n    lit(i64 v),\n    add(Owned<Expr> l, Owned<Expr> r),\n}\n```\n\nor keep the children in a `List<…>`, or refer to them by index.\n"
const doc2762: string = "# BYN2762: a `Map` cannot be copied\n\n**No longer reported.** Retired in spec 002: replaced by BYN2780. Every collection, `StrBuf`, `Owned` and `unique struct` is now unique, and any implicit copy of one is BYN2780, with `move` or `.copy(to: alloc)` as the fix. The code stays reserved.\n\n**Why (before spec 002).** A `Map` (and a growable `StrBuf`) is a small header over storage on the heap. Copying the header would leave two values sharing that storage: a `set` through one can rehash, free the old arrays and leave the other pointing at freed memory. Until maps can be copied safely, storing an existing map anywhere else is rejected: in a `let` or `var`, an assignment, a struct, union or tuple, an array literal, a `for` loop variable declared with `var` (each iteration copies the element; `let` loop variables are immutable, so they are fine), a `with` that leaves a map field in place (a field it replaces is not copied), `List.add` or `Map.set`, or a `return` of anything but a local that is going out of scope. The same holds for a value that contains a map by value, through struct fields, union payloads, tuples, arrays, optionals or `Result`s. Reading the map in place is fine: calling its members, looping over it with `for`, formatting it, or passing it as an argument (read-only or by `ref`). A fresh map, from `Map<K, V>()` or any call, can be stored anywhere.\n\n**Example.**\n\n```\nvar a = Map<i64, i64>()\na.set(1, 10)\nvar b = a\nb.set(2, 20)\n```\n\n**Fix.** Keep one map and pass it by `ref` where it is changed:\n\n```\nvoid addTwenty(ref Map<i64, i64> m) {\n    m.set(2, 20)\n}\n\nvar a = Map<i64, i64>()\na.set(1, 10)\naddTwenty(ref a)\n```\n\nor build a new map and copy the entries into it with a `for` loop.\n"
const doc2770: string = "# BYN2770: unknown attribute\n\n**Why.** Attributes change how a declaration compiles, so a misspelled or unsupported one is an error instead of being ignored. The attributes are `[ExitCode(n)]`, on an error variant, and `[Cases(...)]`, on a test that takes parameters.\n\n**Example.**\n\n```\n@inlin\nvoid step() { }\n```\n\n**Fix.** Remove the attribute, or correct its name.\n"
const doc2771: string = "# BYN2771: invalid `main` signature\n\n**Why.** The runtime calls `main` itself, so it accepts only the shapes it knows how to call: return `void` or `i32` (the exit code), take nothing or `ReadOnlySpan<string> args` (the command-line arguments without the program name), with or without `fails`.\n\n**Example.**\n\n```\nstring main(i64 count) { return \"done\" }\n```\n\n**Fix.** Use one of `void main()`, `i32 main()`, `void main(ReadOnlySpan<string> args)` or `i32 main(ReadOnlySpan<string> args)`, optionally followed by `fails E`.\n"
const doc2772: string = "# BYN2772: invalid exit code\n\n**Why.** `@exitCode(n)` sets the process exit code when a failing `main` ends with that variant. Exit codes outside 1 to 255 are truncated or mean success on common systems, and the code must be known at compile time.\n\n**Example.**\n\n```\nunion error ConfigError {\n    @exitCode(300)\n    malformed\n}\n```\n\n**Fix.** Pass one integer constant from 1 to 255, such as `@exitCode(3)`.\n"
const doc2773: string = "# BYN2773: `@cases` value count does not match the parameters\n\n**What.** One case of a `@cases(...)` attribute gives a different number of values than the test has parameters.\n\n**Why.** Each case runs the test once with its values bound to the parameters in order (spec §20). A missing or extra value has no parameter to go to, so the case cannot run.\n\n**Example.**\n\n```\n@cases((0, false), (1, true, 2))\ntest \"quantity bounds\" (i32 input, bool valid) {\n    assert(valid == (input > 0))\n}\n```\n\n**Fix.** Give every case one value per parameter, in parameter order:\n\n```\n@cases((0, false), (1, true))\ntest \"quantity bounds\" (i32 input, bool valid) {\n    assert(valid == (input > 0))\n}\n```\n\nA test with one parameter takes bare values: `@cases(1, 2, 3)`.\n"
const doc2774: string = "# BYN2774: `@cases` value is not a constant\n\n**What.** A value in `@cases(...)` is not a constant literal: an integer, float, string, rune, `true`, `false`, `null` or a `.case` value.\n\n**Why.** Cases are fixed when the test is compiled and shown in its title, such as `quantity bounds (input: 101, valid: false)`, so each value must be known without running code. Cases from a named const list (`@cases(discountCases)`) are not supported yet.\n\n**Example.**\n\n```\n@cases(limit(), 2)\ntest \"positive\" (i32 n) {\n    assert(n > 0)\n}\n```\n\n**Fix.** Write each value as a literal, one tuple literal per case when the test takes more than one parameter:\n\n```\n@cases(1, 2)\ntest \"positive\" (i32 n) {\n    assert(n > 0)\n}\n```\n"
const doc2775: string = "# BYN2775: `assert` needs a `bool`\n\n**What.** The expression after `assert` is not a `bool`.\n\n**Why.** `assert expr;` checks that `expr` is `true` and panics otherwise, showing the value of each sub-expression (spec §20). There is no truthiness in Bayan: a number, a string or an optional is not true or false by itself, so the comparison must be written out.\n\n**Example.**\n\n```\nlet items = List<i64>()\nlet count = items.length\nassert count\n```\n\n**Fix.** Compare the value with what you expect:\n\n```\nlet count = items.length\nassert count == 3\n```\n\nFor an optional, test it with `is not null`: `assert found is not null;`.\n"
const doc2780: string = "# BYN2780: implicit copy of a unique value\n\n**Message.** \"implicit copy of a unique value: {0}\"\n\n**Help.** \"write `move {0} with { … }` to give up `{0}`\" (on a `with` that copies a `unique` value, `{0}` the copied variable).\n\n**Why.** A unique value owns storage: a `List`, `Map`, `StrBuf` or `Owned`, a `unique struct`, a type parameter inside a generic body, or anything that holds one of these by value (a struct field, a union payload, a tuple, array, optional, `Untrusted` or `Result`). Copying it would leave two values sharing that storage, and growing or freeing one would leave the other pointing at freed memory. So storing an existing place of a unique type is rejected: a `let` or `var` initializer, an assignment, a field in a struct literal or `with`, an element added to a collection, a tuple, array or optional, an argument to a `move` parameter, or a `return` of anything but a local or `move` parameter (returning those moves them). A plain parameter of unique type is a read-only borrow, so storing it is a copy too. Fresh values (calls, constructors, literals, `copy(to:)`, `move x`) are never copies, and reading in place (members, indexing, `for`, `switch`, comparison, formatting, passing to a plain or `ref` parameter) is fine. A field of unique type cannot stand for an interface getter either: the getter's result belongs to the caller, so reading the field in its place would copy it.\n\n**Example.**\n\n```\nvar a = List<i64>()\na.append(1)\nvar b = a\n```\n\n**Fix.** Hand the value over with `move`, after which `a` cannot be used until it is assigned again:\n\n```\nvar b = move a\n```\n\nor make an independent copy with `a.copy(to: alloc)` (for a `List`, `Map` or `StrBuf`), or share the original by passing it by `ref`. In a function that should own a parameter, declare it `move p`.\n\nA `with` that copies a unique value from a local hands it over the same way: `let copy = move tx with { label: \"copy\" }` is `(move tx) with { … }`, since `with` binds looser than every prefix operator. `x = x with { … }` is already a move and needs no `move`.\n"
const doc2781: string = "# BYN2781: use after move\n\n**Why.** `move x` (or passing `x` to a `move` parameter) hands its value to a new owner, so `x` no longer holds anything. Reading it, calling a member on it or moving it again on any path after the move would touch storage that now belongs to someone else. A move in one branch of an `if` or `switch` makes the local unusable after the branches join, and a move inside a loop of a local declared outside it fails on the next iteration.\n\n**Example.**\n\n```\nvar a = List<i64>()\nvar b = move a\na.append(2)\n```\n\n**Fix.** Assign a fresh value before using the local again:\n\n```\nvar b = move a\na = List<i64>()\na.append(2)\n```\n\nor move a copy instead, `move a.copy(to: alloc)`, and keep the original. In a loop, reassign the local before the next iteration.\n"
const doc2782: string = "# BYN2782: cannot move out of this\n\n**Why.** `move` takes the value from an owner that then holds nothing, and the compiler has to know that owner is not used again. It can track that only for a local variable or a `move` parameter. Moving out of a field, an element, a plain or `ref` parameter would leave a hole that someone else still reads, and a call result or literal is already fresh, so there is nothing to move.\n\n**Example.**\n\n```\nstruct Bag {\n    List<i64> items\n}\n\nvoid take(Bag bag) {\n    var items = move bag.items\n}\n```\n\n**Fix.** When `bag` can be written (a `var` local or a `ref` parameter), take the value with `bag.items.take()`, which leaves an empty list in the field (it works for a `List`, `Map`, `StrBuf` or an optional of a unique type), copy it with `bag.items.copy(to: alloc)`, or read it in place through the field. For a parameter, declare it `move p` so the function owns it. For a fresh value, remove `move`.\n"
const doc2783: string = "# BYN2783: a borrowed binding cannot be changed or moved\n\n**Why.** A `for` loop variable and a `switch` or `is` pattern binding of a unique type borrow from the value they were bound to: they name storage that the list, union or other subject still owns. This holds for `var` bindings too. Changing the binding (a mutating member call, an assignment to it or to its fields) or moving it would change or take storage behind the owner's back.\n\n**Example.**\n\n```\nvar lists = List<List<i64>>()\nlists.append(List<i64>())\nfor xs in lists { xs.append(1) }\n```\n\n**Fix.** Change the element through its owner:\n\n```\nfor i in 0..lists.length { lists[i].append(1) }\n```\n\nor copy the binding into a local of its own with `xs.copy(to: alloc)`.\n"
const doc2784: string = "# BYN2784: a collection holding a unique value cannot be copied\n\n**Why.** `copy(to:)` on a `List` or `Map` copies the elements, keys and values as they are. When those are themselves a `List`, `Map`, `StrBuf` or `Owned` (or a struct, union, tuple, array or optional holding one), the copy would share their storage with the original, and growing one would free memory the other still points to.\n\n**Example.**\n\n```\nvoid run(Arena arena) {\n    let lists = List<List<i64>>()\n    let copy = lists.copy(to: arena)\n}\n```\n\n**Fix.** Build the copy with a loop that copies each element:\n\n```\nvar copy = List<List<i64>>()\nfor inner in lists { copy.append(inner.copy(to: arena)) }\n```\n\nor share the original by `ref`.\n"
const doc2785: string = "# BYN2785: `slot` needs a default value\n\n**Why.** `map.slot(key)` returns a reference to the key's value, inserting a default value first when the key is missing. That needs a default for the value type: numbers, `bool`, `rune`, `string`, optionals, and structs whose every field has an initializer. Enums, unions, lists, maps and other types have no default, so the inserted value would be made up.\n\n**Example.**\n\n```\nenum Color {\n    red\n    green\n}\n\nvar colors = Map<string, Color>()\ncolors.slot(\"sky\") = .red\n```\n\n**Fix.** Write with `map[key] = value`, which inserts or updates, and read with `map[key]` (panics when missing) or `map.tryGet(at: key) ?? fallback`:\n\n```\ncolors[\"sky\"] = .red\nlet sky = colors.tryGet(at: \"sky\") ?? .green\n```\n\nor give every field of a struct value type an initializer.\n"
const doc2786: string = "# BYN2786: an `Untrusted` value reaches a sink\n\n**Why.** `Io.run` and `Io.runBatch` run commands. `Io.run` involves no shell, but an untrusted program path runs whatever the attacker names, and an untrusted argument can inject an option (`--upload-pack=…` to `git`, `-oProxyCommand=…` to `ssh`) that makes the program run attacker-chosen commands. `Io.runBatch` runs a batch file through `cmd.exe`, which interprets its arguments again. A value that came from outside the program (`Untrusted<T>`, or a list, span or array of them) must not reach either unchecked: the program or path and every argument must be ordinary values.\n\n**Example.**\n\n```\nvoid main() fails IoError {\n    let name: Untrusted<string> = Untrusted(\"x\")\n    let args: Untrusted<string>[1] = [name]\n    let a = try Io.runBatch(\"./build.cmd\", args.span)\n    let b = try Io.run(\"git\", [name])\n}\n```\n\n**Fix.** Check the value, then clear the mark with `name.trustUnchecked() because \"checked against the allow list\"`.\n"
const doc2787: string = "# BYN2787: `trust` needs a reason\n\n**Why.** `trust(x, reason: \"…\")` clears the `Untrusted` mark on a value, so the reason is the audit trail for why that is safe. It must be written at the call site as a non-empty string literal; a missing, empty, interpolated or variable reason says nothing a reviewer can search for.\n\n**Example.**\n\n```\nUntrusted<string> name = Untrusted(\"x\")\nprint(trust(name, reason: \"\"))\n```\n\n**Fix.** Pass a literal that explains why the value is safe, such as `reason: \"checked against the allow list\"`.\n"
const doc2788: string = "# BYN2788: `take()` needs a `List`, `Map`, `StrBuf` or an optional of a unique type\n\n**Why.** `x.take()` moves the value out of a place and leaves that type's empty value behind, so the place stays usable. Only types with an obvious empty value support it: an empty `List`, `Map` or `StrBuf`, and `null` for an optional holding a unique type. Other types have no empty value to leave, and a plain value needs no `take()` because it is copied.\n\n**Example.**\n\n```\nvar count = 3\nlet n = count.take()\n```\n\n**Fix.** Copy a plain value, `let n = count;`. For a unique struct, move the whole local with `move x`, or `take()` the collection fields inside it.\n"
const doc2789: string = "# BYN2789: `switch move …` needs a local or a `move` parameter\n\n**Why.** `switch move x` moves `x` into the switch so its pattern bindings own the parts they bind, and `x` is moved from afterwards. Only a value this function owns outright can be moved that way: a local or a `move` parameter. A field or element belongs to its owner, and a plain parameter is borrowed from the caller, so moving it into the switch would leave a half-moved value behind.\n\n**Example.**\n\n```\nunion Slot {\n    empty\n    full(List<i64> items)\n}\nstruct Box {\n    Slot slot\n}\nvoid show(List<i64> xs) { }\nvoid inspect() {\n    let box = Box { slot: Slot.empty }\n    switch move box.slot {\n        case .full(let items): show(items)\n        default:\n    }\n}\n```\n\n**Fix.** Drop `move` and the bindings borrow, as in `switch box.slot`. Declare a parameter `move` to own it. For a collection field, take it into a local first, `let items = box.items.take();`, and switch on that local.\n"
const doc2790: string = "# BYN2790: pattern binds the same storage more than once in `switch move …`\n\n**Why.** In `switch move x` each pattern binding owns the part it binds. A binding for a whole value and another for a part of it, two bindings on both sides of an `and`, or two bindings of the same field in one property pattern (`{ items: let x, items: let y }`, at any nesting) would own the same storage twice, and a unique value may have only one owner (L006).\n\n**Example.**\n\n```\nstruct Ledger {\n    List<i64> items\n}\nvoid keep(move List<i64> xs) { }\nvoid drop(move Ledger l) { }\nvoid inspect() {\n    let a = Ledger { items: List<i64>() }\n    switch move a {\n        case let x and let y:\n            drop(move x)\n            drop(move y)\n        case Ledger { items: let it } whole:\n            keep(move it)\n            drop(move whole)\n        case { items: let x, items: let y }:\n            keep(move x)\n            keep(move y)\n        default:\n    }\n}\n```\n\n**Fix.** Bind the whole value or its parts, not both: `case let x:` or `case Ledger { items: let it }:`, and each field once. Bindings over disjoint parts, such as `{ items: let a, other: let b }` or `.pair(let a, let b)`, are accepted. Without `move`, bindings borrow and any of these patterns is fine.\n"
const doc2791: string = "# BYN2791: binding is mutated in the guard of `switch move …`\n\n**Why.** In `switch move x` each pattern binding owns the part it binds, but only once its arm is selected. A `when` guard runs before that: when it fails, the value goes back to the switch and a later arm binds the same storage. A guard that changed the binding (grew a list, took a field, passed it by `ref` or `out`, moved it) would leave that later arm with a stale or freed copy. So inside the guard the arm's bindings and their parts are read-only.\n\n**Example.**\n\n```\nstruct Bag {\n    List<i64> items\n\n    public i64 grow(ref this) uses alloc {\n        this.items.append(1)\n        return this.items.length\n    }\n}\nunion Slot {\n    full(Bag b)\n    empty\n}\nbool bump(ref List<i64> xs) {\n    xs.append(7)\n    return true\n}\nbool keep(move Bag b) => true\nvoid consume(move Bag b) { }\nvoid inspect(move Slot s) {\n    switch move s {\n        case .full(var x) when x.grow() > 50: print(\"big\")\n        case .full(var x) when bump(ref x.items): print(\"bumped\")\n        case .full(let x) when keep(move x): print(\"kept\")\n        case .full(var y):\n            let n = y.grow()\n            consume(move y)\n        default:\n    }\n}\n```\n\n**Fix.** Read the binding in the guard and change it in the arm's body: `case .full(var x) when x.items.length > 49: x.grow(); …`. Without `move`, bindings borrow and this rule does not apply.\n"
const doc2800: string = "# BYN2800: interface name must start with `I`\n\n**What.** An `interface` is named without the `I` prefix, or the `I` is not followed by an uppercase letter.\n\n**Why.** An interface is not a type on its own: it is listed after `:`, named in a `where` bound or used as `dyn ref I`. The `I` prefix tells the reader which names are interfaces at every one of those places (spec §5.1).\n\n**Example.**\n\n```\ninterface Shape {\n    f32 area()\n}\n```\n\n**Fix.** Rename it to `I` followed by the PascalCase name (the machine fix does):\n\n```\ninterface IShape {\n    f32 area()\n}\n```\n"
const doc2801: string = "# BYN2801: missing interface member\n\n**What.** A struct lists an interface after `:` but does not provide one of the interface's members that has no default body. A field can provide a getter (`i64 count { get; }`) but not a method: a field named like a required method is reported here.\n\n**Why.** Code written against the interface may call any of its members on the struct; a member without a body has nothing to run unless the struct provides it.\n\n**Example.**\n\n```\ninterface IShape {\n    i64 area()\n}\n\nstruct Square : IShape {\n    i64 side\n}\n```\n\n**Fix.** Add the member with the signature the interface declares:\n\n```\nstruct Square : IShape {\n    i64 side\n\n    i64 area() => side * side\n}\n```\n"
const doc2802: string = "# BYN2802: interface member does not match\n\n**What.** A struct provides a member an interface requires, but its signature differs: the return type, a parameter's type or modifier, the kind (method or property), `static`, or the `fails` clause. A field standing for a getter must have the getter's type. It is also reported when a default from one base would stand for a member of the same name in another base: add the member to the struct to choose.\n\n**Why.** Callers use the interface's signature. A witness that returns another type, takes other parameters or fails differently cannot stand in for it.\n\n**Example.**\n\n```\nunion error ParseError {\n    empty\n}\ninterface IParser {\n    i64 parse(string text) fails ParseError\n}\nstruct Digits : IParser {\n    i64 parse(string text) => 0\n}\n```\n\n**Fix.** Change the member's signature to the interface's:\n\n```\nstruct Digits : IParser {\n    i64 parse(string text) fails ParseError => 0\n}\n```\n"
const doc2803: string = "# BYN2803: missing associated type\n\n**What.** An interface declares `type Item;`, and a struct listing it does not bind `type Item = …;`.\n\n**Why.** The interface's members mention `Item`; without a binding the struct's members cannot be checked against them, and generic code cannot know what `T.Item` is.\n\n**Example.**\n\n```\nstruct Digits : IIndexable {\n    i64 count => 3\n\n    i64 get(i64 index) => index * 10\n}\n```\n\n**Fix.** Bind the associated type to the type the members use:\n\n```\nstruct Digits : IIndexable {\n    type Item = i64\n\n    i64 count => 3\n\n    i64 get(i64 index) => index * 10\n}\n```\n"
const doc2804: string = "# BYN2804: not an interface\n\n**What.** A struct's base list (after `:`) or a `where` bound names a type that is not an `interface`: a struct, union, enum or other type.\n\n**Why.** Only interfaces can be conformed to or used as constraints. There is no struct inheritance; a struct that needs another struct's data holds it as a field.\n\n**Example.**\n\n```\nstruct Point {\n    i64 x\n}\n\nstruct Circle : Point {\n    i64 r\n}\n```\n\n**Fix.** List an interface, or hold the other type as a field:\n\n```\nstruct Circle {\n    Point center\n    i64 r\n}\n```\n"
const doc2805: string = "# BYN2805: interface listed twice\n\n**What.** A struct lists the same interface more than once after `:`.\n\n**Why.** A struct conforms to an interface once; the second entry adds nothing and usually means another interface was meant.\n\n**Example.**\n\n```\ninterface IShape {\n    i64 area()\n}\nstruct Square : IShape, IShape {\n    i64 side\n    i64 area() => side * side\n}\n```\n\n**Fix.** Remove the second entry, or replace it with the interface that was meant:\n\n```\nstruct Square : IShape {\n    i64 side\n\n    i64 area() => side * side\n}\n```\n"
const doc2806: string = "# BYN2806: member not found in the constraints\n\n**What.** Generic code uses a member on a type parameter, and no interface in the parameter's `where` clause declares it. Inside a default method, `this` stands for the interface's `Self`, whose only constraint is that interface.\n\n**Why.** Generic code is checked once, at its definition, not separately for each type it is called with. It can rely only on what its constraints promise. Otherwise a call with a new type could break code that has no error of its own.\n\n**Example.**\n\n```\ninterface IShape {\n    i64 area()\n}\n\nvoid show<T>(ref T shape) where T : IShape {\n    print($\"{shape.perimeter()}\")\n}\n```\n\n**Fix.** Declare the member in a constraining interface, or add an interface that declares it to the `where` clause:\n\n```\ninterface IShape {\n    i64 area()\n    i64 perimeter()\n}\n\nvoid show<T>(ref T shape) where T : IShape {\n    print($\"{shape.perimeter()}\")\n}\n```\n"
const doc2807: string = "# BYN2807: type argument does not conform\n\n**What.** A call or a type names a type argument that does not meet its parameter's `where` constraint. The error is reported where the type is chosen: at the call, or at a generic's own call when it passes one of its type parameters along.\n\n**Why.** The generic code was checked against its constraints, so it may call any member they declare. A type that does not conform has no such member to call. Only structs conform to interfaces, and a type parameter conforms only to the interfaces in its own `where` clause.\n\n**Example.**\n\n```\ninterface IShape {\n    i64 area()\n}\nstruct Square {\n    i64 side\n}\ni64 measure<T>(ref T shape) where T : IShape => shape.area()\nvoid main() {\n    var s = Square { side: 2 }\n    print($\"{measure(ref s)}\")\n}\n```\n\n**Fix.** Conform the type to the interface, or pass one that does. For a type parameter, add the interface to its `where` clause:\n\n```\nstruct Square : IShape {\n    i64 side\n\n    i64 area() => side * side\n}\n```\n"
const doc2808: string = "# BYN2808: interface cannot be used with `dyn`\n\n**What.** `dyn ref I` names an interface that has a generic method or an associated type (`type Item;`). The diagnostic names the first such member.\n\n**Why.** A `dyn ref` call goes through a table with one entry per member, built once for each conforming type. A generic method has no single entry (each type argument is a different function), and an associated type has no single type for callers to use: both depend on information only a constraint provides (spec 006, handoff Q93).\n\n**Example.**\n\n```\ninterface ICursor {\n    type Item\n    Item peek()\n}\n\nvoid walk(dyn ref ICursor c) { }\n```\n\n**Fix.** Use a `where` constraint, which keeps the conforming type known at compile time:\n\n```\nvoid walk<T>(ref T c) where T : ICursor { }\n```\n"
const doc2809: string = "# BYN2809: `dyn I` by value is not supported yet\n\n**What.** A type is written `dyn I` without `ref`.\n\n**Why.** An owned dynamic value would need its size at run time and an allocation to hold it. Only the borrowed form `dyn ref I` is supported: it points at a value that lives elsewhere and never allocates (spec 006, non-goals).\n\n**Example.**\n\n```\ninterface IShape {\n    f32 area()\n}\n\nvoid show(dyn IShape s) { }\n```\n\n**Fix.** Borrow the value with `dyn ref` (or `dyn ref readonly` when only members without `ref this` are called):\n\n```\nvoid show(dyn ref IShape s) { }\n```\n"
const doc2810: string = "# BYN2810: `static` interface member\n\n**What.** An interface member is declared `static`.\n\n**Why.** A `static` interface member (`static T parse(string text)`, called as `T.parse(…)` through a constraint) is not supported yet: no part of the compiler port needs it, so it is left out of the first interface subset (spec 006).\n\n**Example.**\n\n```\ninterface IParse {\n    static i64 parse(string text)\n}\n```\n\n**Fix.** Remove `static` and call the member on a value, or make it a free function:\n\n```\ni64 parse(string text) {\n    // …\n}\n```\n"
const doc2811: string = "# BYN2811: `extension` conformance\n\n**What.** An `extension T : I` declaration adds a conformance to a type after the type is declared.\n\n**Why.** Retroactive conformance is not supported yet. A type's conformances are listed on its own declaration, so they are all in one place and a conformance cannot appear or disappear depending on which module is imported.\n\n**Example.**\n\n```\nstruct Money {\n    i64 cents\n}\n\nextension Money : IShape {\n    i64 area() => 0\n}\n```\n\n**Fix.** List the interface on the type's declaration and move the members into it:\n\n```\nstruct Money : IShape {\n    i64 cents\n\n    i64 area() => 0\n}\n```\n\nIf the type is not yours to change, wrap it in a struct that conforms.\n"
const doc2812: string = "# BYN2812: `where` names an unknown type parameter\n\n**What.** A `where` clause constrains a name that is not one of the declaration's own type parameters.\n\n**Why.** A `where T : I` clause restricts the types that can be passed for `T`, so `T` must be declared in the `<…>` of the same function, struct, union or interface. A misspelled parameter would otherwise leave the real one unconstrained.\n\n**Example.**\n\n```\nvoid show<T>(ref T shape) where U : IShape { }\n```\n\n**Fix.** Name one of the declaration's type parameters, or remove the clause if there are none:\n\n```\nvoid show<T>(ref T shape) where T : IShape { }\n```\n"
const doc2813: string = "# BYN2813: `ref this` member through `dyn ref readonly`\n\n**What.** A member that takes `ref this` is called through a `dyn ref readonly` value. This includes default methods declared `ref this`.\n\n**Why.** `ref this` means the call may modify the value. A `dyn ref readonly` borrow promises that the value is not modified through it.\n\n**Example.**\n\n```\ninterface ICounter {\n    i64 next(ref this)\n}\n\nvoid show(dyn ref readonly ICounter c) {\n    print($\"{c.next()}\")\n}\n```\n\n**Fix.** Take a writable `dyn ref`:\n\n```\nvoid show(dyn ref ICounter c) {\n    print($\"{c.next()}\")\n}\n```\n"
const doc2814: string = "# BYN2814: `ref this` does not match the interface\n\n**What.** A struct's member and the interface member it provides disagree on `ref this`: one takes it and the other does not.\n\n**Why.** `ref this` decides whether a call may modify the value it is called on. Callers through the interface rely on the interface's choice: a read-only member must not change the value, and a `ref this` member needs a mutable one.\n\n**Example.**\n\n```\ninterface ICounter {\n    i64 next(ref this)\n    i64 peek()\n}\n\nstruct Counter : ICounter {\n    i64 value\n\n    i64 next() => value\n\n    i64 peek(ref this) => value\n}\n```\n\n**Fix.** Add or remove `ref this` to match the interface:\n\n```\nstruct Counter : ICounter {\n    i64 value\n\n    i64 next(ref this) {\n        value += 1\n        return value\n    }\n\n    i64 peek() => value\n}\n```\n"
const doc2815: string = "# BYN2815: only structs can conform\n\n**What.** A union or an enum lists interfaces after `:`.\n\n**Why.** Conformance is for structs only for now. Union and enum members are not in the language yet, so a union or enum has nowhere to provide an interface's members (spec 006, handoff Q100).\n\n**Example.**\n\n```\nunion Shape : IShape {\n    circle(i64 r)\n    none\n}\n```\n\n**Fix.** Wrap the union or enum in a struct that conforms, and switch on it inside the members:\n\n```\nunion Shape {\n    circle(i64 r),\n    none,\n}\n\nstruct AnyShape : IShape {\n    Shape shape\n\n    i64 area() => shape switch {\n        .circle(let r) => 3 * r * r,\n        .none => 0,\n    }\n}\n```\n"
const doc2816: string = "# BYN2816: an interface is not a type\n\n**What.** An interface name is used as a type on its own: a parameter, local, field, return or type argument.\n\n**Why.** An interface describes what a type provides; it has no size or layout of its own, so there is no value of type `IShape`. An interface may appear in a base list (`struct Circle : IShape`), in a `where` bound, or after `dyn ref`.\n\n**Example.**\n\n```\ninterface IShape {\n    f32 area()\n}\n\nvoid show(IShape s) { }\n```\n\n**Fix.** Borrow any conforming value with `dyn ref`, or make the function generic with a constraint:\n\n```\nvoid show(dyn ref IShape s) { }\n\nvoid draw<T>(ref T s) where T : IShape { }\n```\n"
const doc2820: string = "# BYN2820: lambda parameter count\n\n**Why.** A lambda takes its parameter types from the function type it is passed or assigned to, so it must name exactly as many parameters as that type has.\n\n**Example.**\n\n```\ni64 apply((i64, i64) -> i64 f) => f(1, 2)\n\nvoid main() {\n    let sum = apply(x => x)\n}\n```\n\n**Fix.** Name one parameter per parameter of the function type:\n\n```\nlet sum = apply((a, b) => a + b)\n```\n"
const doc2821: string = "# BYN2821: value a lambda cannot capture\n\n**Why.** A lambda copies what it captures when it is made, so it captures only values that cannot change under it: `let` locals, `let` pattern bindings and plain parameters. A `var` could be reassigned after the copy, a `ref`, `mut` or `move` parameter is a borrow of the caller's storage, and `this` (with the fields read through it) is not captured at all.\n\n**Example.**\n\n```\ni64 apply((i64 -> i64) f) => f(1)\n\nvoid main() {\n    var step = 2\n    step = 3\n    let a = apply(x => x + step)\n}\n```\n\n**Fix.** Copy the value into a `let` first and capture that:\n\n```\nlet current = step\nlet a = apply(x => x + current)\n```\n"
const doc2822: string = "# BYN2822: function type not supported here\n\n**Why.** A function value borrows the frame that made it, so in 007 it lives only where that frame outlives it: a parameter, a local, or the target of a `type` alias naming one of those. A struct field, a return type, a type argument, or the element of an optional, span, list, map, array or tuple would carry it out of that frame.\n\n**Example.**\n\n```\nstruct Line {\n    i32 qty\n}\nstruct Money {\n    i64 cents\n}\ntype Pricer = Line -> Money uses net\nstruct Shop {\n    Pricer pricer\n}\n```\n\n**Fix.** Take the function as a parameter of the function that calls it: `Money total(Line line, Pricer pricer)`.\n"
const doc2823: string = "# BYN2823: member where a lambda is expected\n\n**Why.** A leading `.name` picks a member of the expected type, such as an enum member or an error variant. A function type has no such members, and `.name` never stands for a lambda that reads the member of its parameter.\n\n**Example.**\n\n```\nstruct User {\n    string name\n}\n\nstring label(User u, by (User -> string) key) => key(u)\n\nvoid main() {\n    let user = User { name: \"a\" }\n    let text = label(user, by: .name)\n}\n```\n\n**Fix.** Read the member through `it`:\n\n```\nlet text = label(user, by: it.name)\n```\n"
const doc2824: string = "# BYN2824: not a function value\n\n**Why.** Only a module-level, non-generic function is a value of a function type, and only when its signature matches the type exactly. A built-in, a generic function, a method (static or instance), a constructor and a union variant are not values: a built-in has no single signature, a generic function has none until its type arguments are known, a method needs its receiver, and a constructor or variant builds a value rather than being one.\n\n**Example.**\n\n```\nstruct Order {\n    i64 total\n\n    i64 doubled() => total * 2\n}\n\ni64 measure((() -> i64) f) => f()\n\ni64 twice(Order o) => measure(o.doubled)\n```\n\n**Fix.** Wrap it in a lambda that calls it: `measure(() => o.doubled())`.\n"
const doc2830: string = "# BYN2830: `HashMap` is not supported yet\n\n**Why.** Bayan has one hash map, `Map<K, V>`. It hashes its keys like an unordered map would, and it also keeps insertion order, so iteration is the same on every run and every build. An unordered `HashMap` would iterate in an order that depends on the hash seed, which deterministic output cannot tolerate. `HashMap` is reported once and then read as `Map`, so nothing else is reported for it.\n\n**Example.**\n\n```\nstruct Counter {\n    HashMap<string, i32> counts\n}\n```\n\n**Fix.** Write `Map` with the same type arguments: `Map<string, i32> counts`. The fix does this; `bayan format` does not apply it, since the type checker reports it.\n"
const doc2831: string = "# BYN2831: a part of a `Map` key is not a key\n\n**Why.** A tuple or struct is a `Map` key when every element or field is one: an integer type, `rune`, `bool`, `string`, `Symbol`, a plain enum, or a tuple or struct of those. The map hashes and compares a composite key part by part, so one part that cannot be hashed (a float, an optional, an enum with data, a collection, a `@noEquality` struct) rules out the whole key. The diagnostic names the first such part and its type. In generic code it is reported where the type argument is chosen.\n\n**Example.**\n\n```\nstruct Weight {\n    f64 grams\n}\n\nlet byWeight = Map<Weight, string>()\n```\n\n**Fix.** Key by a field that identifies the value, such as an integer id or a `Symbol` name, or change the part to a key type.\n"
const doc2832: string = "# BYN2832: a `string` value is not a `Symbol`\n\n**Why.** Only a string literal becomes a `Symbol` by itself: its text is known when the program is compiled, so it is an entry of the program's literal table. Any other `string` (a local, a parameter, a slice, an interpolated string, a call result) is known only at run time, and turning it into a `Symbol` interns it, which allocates. Bayan keeps that visible.\n\n**Example.**\n\n```\nvoid main() {\n    let name: string = \"total\"\n    let s: Symbol = name\n}\n```\n\n**Fix.** Intern it: `let s: Symbol = Symbol.intern(name)`. A function that calls it declares `uses alloc`; `main` needs none.\n"
const doc3001: string = "# BYN3001: borrowed value in a struct field\n\n**Why.** A `string`, `Span<T>` or `StrBuf` points into memory owned elsewhere. Storing it in a struct would let the struct outlive that memory; v0.1 has no way to check that, so it is not allowed.\n\n**Example.**\n\n```\nstruct Window { Span<u8> bytes }\n```\n\n**Fix.** Storing borrows in structs arrives in a later version; copy the data instead (for example into a `List<u8>`), or store an index.\n"
const doc3002: string = "# BYN3002: borrow outlives its source\n\n**Why.** A `string`, `Span<T>` or `List<T>` that points into a stack buffer, a local array or an arena is only valid until that storage is freed at the end of its block. Storing it in a variable (or list) declared in an outer block would leave the variable pointing at freed memory.\n\n**Example.**\n\n```\nvar view = \"\"\n{\n    let bytes = stackalloc u8[16]\n    var sb = StrBuf(bytes)\n    sb.append(\"scratch\")\n    view = sb.finish()\n}\nprint(view)\n```\n\n**Fix.** Move the storage out to the block where the value is used, or copy the data with `.copy(to: alloc)` into an allocator that lives long enough.\n"
const doc3003: string = "# BYN3003: returning a borrow of local storage\n\n**Why.** A function's locals, by-value parameters and `stackalloc` buffers are freed when it returns, so a span or string pointing into them would dangle. A returned borrow may only point into what the caller passed in (spec §9.4 rule 4).\n\n**Example.**\n\n```\nSpan<i64> scratch() {\n    let buf = stackalloc i64[4]\n    return buf[1..]\n}\n```\n\n**Fix.** Let the caller pass the buffer (a `Span<T>` parameter) or an allocator in, and borrow or allocate from that.\n"
const doc3004: string = "# BYN3004: modified while borrowed\n\n**Why.** Adding to or clearing a `List` can move its elements, clearing a `StrBuf` overwrites its text, and resetting an `Arena` frees everything allocated from it. A span, string or loop that still points into the old storage would read freed or changed memory (spec §9.4 rules 5 and 6).\n\n**Example.**\n\n```\nvar xs = List<i64>()\nxs.append(1)\nlet view = xs.span\nxs.append(2)\nprint($\"{view[0]}\")\n```\n\n**Fix.** Finish using the borrow before the change, or copy what it needs first. To grow a list you are iterating over, collect the new items in another list and add them after the loop.\n"
const doc3005: string = "# BYN3005: `ref` and another use in one call\n\n**Why.** A `ref` argument may be changed by the callee while the callee also reads the same value through another argument, for example a list it is growing and a span over that list (spec §9.4 rule 5).\n\n**Example.**\n\n```\nvar xs = List<i64>()\nvoid grow(ref List<i64> items, from ReadOnlySpan<i64> source) { }\ngrow(items: ref xs, from: xs)\n```\n\n**Fix.** Copy the value into a local first and pass the copy, or split the work into two calls.\n"
const doc3006: string = "# BYN3006: moved while borrowed\n\n**Why.** Moving a value (`move s`, a `move` argument, `return move s`, `switch move s`, or `.take()` on a `List`, `Map`, `StrBuf` or optional) hands its storage to a new owner, which may grow, change or free it. A span or `dyn ref` that still points into the moved value would read freed or changed memory (spec §9.4 rules 5 and 6).\n\n**Example.**\n\n```\nstruct S {\n    List<i64> xs\n}\nvar s = S { xs: List<i64>() }\nlet view = s.xs.mutableSpan()\nvar t = move s\nprint($\"{view[0]}\")\n```\n\n**Fix.** Finish using the borrow before the move, or copy what it needs first.\n"
const doc3100: string = "# BYN3100: `package.byn` is data only\n\n**Why.** The manifest is read by tools that never run Bayan code, so it holds values only: strings, integers, `.names`, `[lists]` and `Type { field: value }`. Calls, operators, `comptime` and statements are not allowed.\n\n**Example.**\n\n```\nPackage {\n    name: \"local/\" + \"tally\",\n}\n```\n\n**Fix.** Write the value out: `name = \"local/tally\"`.\n"
const doc3101: string = "# BYN3101: unknown manifest field\n\n**Why.** `package.byn` is checked against the `Package` type (and `Dist` for `dist: Dist { … }`). A misspelled field would otherwise be ignored silently.\n\n**Example.**\n\n```\nPackage {\n    name: \"local/tally\",\n    version: \"0.1.0\",\n    verison: \"0.2.0\",\n}\n```\n\n**Fix.** Use one of the listed fields, or remove the line.\n"
const doc3102: string = "# BYN3102: invalid manifest value\n\n**Why.** Each manifest field has a fixed shape: `name` is `namespace/name` in lowercase words joined by `-`, `version` is a semantic version, `edition` is `2027`, `kind` is `.app` or `.lib`, `dist.targets` is a list like `[.host]` and `dist.mode` is `.debug`, `.safe` or `.fast`.\n\n**Example.**\n\n```\nPackage {\n    name: \"Tally\",\n    version: \"1.0\",\n}\n```\n\n**Fix.** `name = \"local/tally\"`, `version = \"1.0.0\"`.\n"
const doc3103: string = "# BYN3103: missing manifest field\n\n**Why.** Every package needs a `name` and a `version`: outputs, `dist/` directories and provenance records are named after them.\n\n**Example.**\n\n```\nPackage {\n    name: \"local/tally\",\n}\n```\n\n**Fix.** Add `version = \"0.1.0\"`.\n"
const doc3104: string = "# BYN3104: `=` in `package.byn`\n\n**What.** `field = value` in `package.byn`.\n\n**Why.** The manifest is Bayan data, and Bayan literals name their fields with `:`.\n\n**Example.**\n\n```\nPackage {\n    name = \"local/shop\",\n}\n```\n\n**Fix.** Write `:` (the machine fix does this):\n\n```\nPackage {\n    name: \"local/shop\",\n}\n```\n"
const doc3201: string = "# BYN3201: an unused value\n\n**Why.** A statement ends at the newline (spec §2.5), so a line split in the wrong place can leave a value on a line of its own: `let x = a` followed by `-b` is two statements, and `-b` does nothing. Making an unused non-`void` value an error turns every such mis-split line into a diagnostic.\n\n**Example.**\n\n```\nvoid main() {\n    let a = 1\n    let x = a\n        -2\n    print(x)\n}\n```\n\n**Fix.** Join the lines, assign the value, or remove the expression:\n\n```\nvoid main() {\n    let a = 1\n    let x = a - 2\n    print(x)\n}\n```\n\nThere is no automatic fix: whether the value belongs to the line above or is not needed is a choice.\n"
const doc3202: string = "# BYN3202: duplicate error case in a composition\n\n**Why.** A composed `union error` is flattened: `union error ShipError = CarrierError, StockError` has every case of both sets. When two of them have a case with the same name, `.rejected` in a `fails ShipError` function or a `catch switch` arm could mean either.\n\n**Example.**\n\n```\nunion error CarrierError {\n    timeout\n    rejected\n}\nunion error StockError {\n    outOfStock\n    rejected\n}\nunion error ShipError = CarrierError, StockError\n```\n\nDifferent instantiations of one generic set are not a clash: `union error FormError = ValidationError<Signup>, ValidationError<Address>` is valid, and a `catch switch` matches them by type (`ValidationError<Signup> e => …`). The message names each set with its type arguments: `` `ValidationError<Signup>` and `SignupError` both have a case `invalid` ``.\n\n**Fix.** Rename one of the cases (`carrierRejected`), or compose fewer sets.\n"
const doc3204: string = "# BYN3204: bare literal for a distinct type\n\n**Message.** \"`{0}` is not a `{1}`\"\n\n**Help.** \"wrap it: `{1}({0})`\"\n\n**What.** A bare literal is used where a distinct type is expected.\n\n**Why.** A distinct type is a new type, not an alias: its `requires` are checked when a value is built with `T(raw)`, and a bare literal would skip that check.\n\n**Example.**\n\n```\ntype distinct Id = i64 requires it > 0\n\nvoid main() {\n    let i: Id = 7\n}\n```\n\n**Fix.** Wrap the literal (the machine fix does this):\n\n```\n    let i: Id = Id(7)\n```\n"
const doc3206: string = "# BYN3206: rule target is not a field\n\n**Message.** \"`at .{0}` names no field of `{1}`\"\n\n**Help.** \"name a field of `{1}`\"\n\n**What.** A struct-level `requires … at .name` names something that is not a field of the struct.\n\n**Why.** `at .field` says which field a failed rule is reported against; it must name a field the struct declares.\n\n**Example.**\n\n```\nstruct Range {\n    i64 low\n    i64 high\n    requires low <= high at .top\n}\n```\n\n**Fix.** Name a field of the struct:\n\n```\n    requires low <= high at .high\n```\n"
const doc3207: string = "# BYN3207: literal of a checked struct needs `try`\n\n**Message.** \"a literal of `{0}` can fail its `requires`; write `try {0} { … }`\"\n\n**Help.** \"add `try` before the literal and handle the `ValidationError<Order>`\"\n\n**What.** A struct literal builds a struct whose `requires` the compiler cannot decide, and nothing handles the failure.\n\n**Why.** A struct's `requires` are checked when the value is built. A literal that may break them fails with `ValidationError`, which must be propagated or caught like any other error.\n\n**Example.**\n\n```\nstruct Order {\n    i64 quantity requires it > 0\n}\n\nOrder order(i64 n) fails ValidationError<Order> => Order { quantity: n }\n```\n\n**Fix.** Add `try` (the machine fix does this), or `catch` the error:\n\n```\nOrder order(i64 n) fails ValidationError<Order> => try Order { quantity: n }\n```\n"
const doc3208: string = "# BYN3208: field of a checked struct assigned one at a time\n\n**Message.** \"fields of `{0}` cannot be assigned one at a time; its `requires` are checked at construction\"\n\n**Help.** \"build a new value with `with`: `try x with { f: v }`\"\n\n**What.** A method of a struct with `requires` assigns one of its fields.\n\n**Why.** The rules are checked when the value is built. Writing a field afterwards could break them unseen, so a checked struct changes only by building a new value.\n\n**Example.**\n\n```\nstruct Range {\n    i64 low\n    i64 high\n    requires low <= high at .high\n\n    void widen(ref this) {\n        this.high = this.high + 1\n    }\n}\n```\n\n**Fix.** Build a new value with `with`, which checks the rules again:\n\n```\n    Range widen() fails ValidationError<Range> => try this with { high: this.high + 1 }\n```\n"
const doc3209: string = "# BYN3209: `unique` value declared `const`\n\n**Why.** A `const` is a compile-time value that every use copies, while a `unique` type has exactly one owner and is never copied (spec §3.11). A `struct unique`, or a struct holding one, therefore cannot be `const`.\n\n**Example.**\n\n```\nstruct unique File {\n    i64 fd\n}\nvoid main() {\n    const f = File { fd: 1 }\n}\n```\n\n**Fix.** Declare it with `let` (the machine fix does this):\n\n```\n    let f = File { fd: 1 }\n```\n"
const doc3213: string = "# BYN3213: overlapping overloads\n\n**Not reported yet.** v0.1 overloads differ by particle set only, and two with the same particles are reported as BYN2006; the code is reserved for overloads that differ by parameter type.\n\n**Message.** \"`{0}` and `{1}` both accept `{2}`\"\n\n**Help.** \"change a parameter type or particle so the overloads cannot overlap\"\n\n**What.** Two overloads that differ only by parameter type accept the same argument through an implicit conversion, as `void f(Grams g)` beside `void f(Kilograms k)` does when `Kilograms` converts to `Grams`.\n\n**Why.** The overload rules are checked at the declaration so that a call never needs ambiguity resolution. Overlapping overloads would make the choice depend on conversion ranking.\n\n**Fix.** Change a parameter type or a particle so that no argument list fits both.\n"
const doc3214: string = "# BYN3214: `rest` parameter stored\n\n**Message.** \"`{0}` is borrowed for the call and cannot be stored\"\n\n**Help.** \"copy it first: `{0}.copy()`\"\n\n**What.** A `rest` parameter is returned, or stored somewhere that outlives the call: a `ref` or `out` parameter, or a field of `this`.\n\n**Why.** The values of a `rest` tail live in the caller's stack frame for the one call, so passing them allocates nothing. Once the call returns, the slots are reused, and a stored span would point at whatever comes next.\n\n**Example.**\n\n```\nReadOnlySpan<i64> keep(rest ReadOnlySpan<i64> xs) {\n    return xs\n}\n```\n\n**Fix.** Copy the values into a list that owns them. In v0.1, `copy` takes the allocator to copy into:\n\n```\nList<i64> keep(ref Arena arena, rest ReadOnlySpan<i64> xs) {\n    return xs.copy(to: arena)\n}\n```\n\nReading `xs` and binding it to a local inside the function are fine. The diagnostic has no machine-applicable fix.\n"
const doc3215: string = "# BYN3215: reference to an overloaded name\n\n**Not reported yet.** v0.1 overloads differ by particle set only, and a function reference does not pick among them; the code is reserved for overloads that differ by parameter type.\n\n**Message.** \"`{0}` is overloaded; give the reference a function type\"\n\n**Help.** \"annotate it: `let f: A -> B = {0}`\"\n\n**What.** An overloaded function's name is used as a value without a function type to choose the overload.\n\n**Why.** Each overload is a different function. Without a target type there is no way to tell which one the reference means.\n\n**Fix.** Give the reference a function type, as in `let f: i32 -> i32 = abs`.\n"
const doc3216: string = "# BYN3216: field written from outside its struct\n\n**Message.** \"`{0}.{1}` can be written only by `{0}`'s own methods or with `with`: `{0}` {2}\"\n\n`{2}` is \"has `requires`\", \"has states\" or \"is `@sealed`\".\n\n**Help.** \"add a `ref this` method to `{0}`, or build a new value with `with`\"\n\n**What.** Code outside a struct assigns one of its fields, and the struct has a `requires` rule, a `states` block or `@sealed`. Plain data structs allow direct field writes everywhere.\n\n**Why.** Such a struct owns its fields: only its own methods change them, so it can keep its rules and states, and a `@sealed` struct can change its representation without breaking callers. Other code builds a new value instead; for a struct with `requires`, `with` checks the rules again.\n\n**Example.**\n\n```\n@sealed\npublic struct HttpClientOptions {\n    i64 timeout\n    i32 retries\n}\n\nvoid tune(ref HttpClientOptions options) {\n    options.retries = 5\n}\n```\n\n**Fix.** Build a new value with `with`, or move the write into a `ref this` method of `HttpClientOptions`:\n\n```\nvoid tune(ref HttpClientOptions options) {\n    options = options with { retries: 5 }\n}\n```\n"
const doc3217: string = "# BYN3217: borrow crosses a fiber\n\n**Not reported yet.** v0.1 has no fibers; the code is reserved for when they arrive.\n\n**Message.** \"`{0}` holds a reference into `{1}` and cannot be passed to a fiber that may outlive it\"\n\n**Help.** \"copy the data first, or spawn the fiber in a scope that ends before `{1}`\"\n\n**What.** A value that borrows from another is passed to a fiber that may run longer than the value it borrows from.\n\n**Why.** When the owner goes away, the fiber would read freed memory.\n\n**Fix.** Copy the data into the fiber, or spawn it in a scope that ends before the owner does.\n"
const doc3218: string = "# BYN3218: rule under a field reads other fields\n\n**Message.** \"this `requires` reads `it` and other fields\"\n\n**Help.** \"split it: an `it` rule under the field, and a struct-level rule with `at .field`\"\n\n**What.** A `requires` written under a field reads both `it` and another field of the struct.\n\n**Why.** A rule under a field checks that field alone. A rule that relates several fields is a struct-level rule, and `at .field` says which field a failure is reported against.\n\n**Example.**\n\n```\nstruct Range {\n    i64 low\n    i64 high requires it > 0 && it >= low\n}\n```\n\n**Fix.** Split the rule:\n\n```\nstruct Range {\n    i64 low\n    i64 high requires it > 0\n    requires low <= high at .high\n}\n```\n"
const doc3219: string = "# BYN3219: not a mutation operator\n\n**Message.** \"`{0}` is not a mutation operator\"\n\n**Help.** \"use one of `boundary`, `relational`, `logical`, `condition`, `bool`, `arithmetic`, `literal`, `negation`, `statement`, `emptyReturn`, `variant`, or no argument for all\"\n\n**What.** The argument of `@unobservable(operator)` names no mutation operator.\n\n**Why.** An operator argument narrows a mark to one kind of mutant. The names are the operators of the mutation-testing table; a misspelled one would silently mark nothing.\n\n**Example.**\n\n```\ni32 f(i32 x) {\n    @unobservable(bogus) because \"x is clamped by the caller\"\n    return x\n}\n```\n\n**Fix.** Use one of the listed operators, or drop the argument to cover every operator in the statement.\n"
const doc4001: string = "# BYN4001: internal compiler error, the C compiler rejected the generated C\n\n**What.** `bayan build`, `run`, `test` or `dist` produced C that the C compiler (zig cc, `$BAYAN_CC` or `cc`) refused. The C compiler's own messages follow the error.\n\n**Why.** A program that `bayan check` accepts must compile; a C compiler error that reaches you is a bug in the Bayan compiler, not in your code (spec §24). The generated C carries `#line` directives, so the C compiler's messages name the `.byn` file and line of the statement it rejected.\n\n**Fix.** Report it with the C text and the `.byn` lines it names. `bayan build --emit-c` prints the generated C; a project's last build keeps it in `out/<mode>/<target>/c/main.c`. Meanwhile, rewriting the named statement differently may avoid the bug.\n"
const doc4002: string = "# BYN4002: internal compiler error, a bound error expression reached lowering\n\n**What.** `bayan build`, `run`, `test` or `dist` found an error expression in the bound program, a body or a field default, although the checker reported no error. The compiler stops before generating any C and exits 1.\n\n**Why.** An error expression stands for a construct the checker rejected, and a rejection is always reported. With none reported, the checker is wrong, not your program (spec §24).\n\n**Fix.** Report it with the program, or the smallest part of it that still fails. `bayan check` on the same program may show where.\n"
const doc5001: string = "# BYN5001: `-ed` member that takes `ref this`\n\n**What.** A member is named with the `-ed` form of a verb (`sorted`, `trimmed`, `joined`) but takes `ref this`, so it changes `this`.\n\n**Why.** The `-ed` name is reserved (spec §5.2, [grammar guide](../bayan-grammar.md) tree 1 and 2): it names a changed copy or a view of `this` and never changes it. A member that acts on `this` is a plain verb on `ref this` (`sort`, `trim`). The `-ed` form does not need a plain verb to exist: an immutable type such as `string` has `trimmed()` with no `trim`.\n\n**Message.** `{0}` changes `this`; name it `{1}`\n\n**Help.** name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view\n\n**What counts as `-ed`.** One lowercase word of five letters or more ending in `-ed`, on a member that takes `ref this` and does not return `bool`. The plain verb offered in the message is found by dropping `-ed` (`sorted` → `sort`), dropping only the `d` (`reversed` → `reverse`), undoing a doubled consonant (`trimmed` → `trim`) or `-ied` (`copied` → `copy`). Not participles: words ending in `-eed` (`need`, `speed`, `seed`), shorter words (`red`, `bed`, `used`), and `hundred`, `embed`, `shred`, `naked`, `wicked`, `sacred`, `kindred`. An irregular form declared in `forms` in the project dictionary counts too (`forms: [\"regrind\": \"reground\"]`; see [BYN5014](BYN5014.md)). Not checked: math vocabulary (`sqrt`, `radians`, …), and typestate states (`states { paid, shipped }`), which are not members. A `bool` member named `closed` is a state: see [BYN5102](BYN5102.md).\n\n**Example.**\n\n```\nstruct Words {\n    string text\n    void sorted(ref this) { }\n}\n```\n\n**Fix.** Name the member that changes `this` with the plain verb, and keep `-ed` for the copy or the view:\n\n```\nstruct Words {\n    string text\n\n    void sort(ref this) { … }\n}\n```\n\n**Where this comes from.** The `-ed` copy follows the Arabic passive participle (mafʿūl), which names the result of an act, not the act. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5002: string = "# BYN5002: state member modifies `this`\n\n**What.** A member with no arguments named `isX`, `hasX` or `canX` is declared `ref this`.\n\n**Why.** `is`, `has` and `can` name a state (spec §5.2, [grammar guide](../bayan-grammar.md) tree 3): a reader expects `if q.isEmpty` to look, not to change `q`, and a state member is callable on a `let`. A member that changes `this` is an action, named with a verb on `ref this` (tree 1). A member with arguments (`hasRoomFor(n)`) is not checked.\n\n**Example.**\n\n```\nstruct Queue {\n    i64 count\n\n    bool isEmpty(ref this) {\n        count = 0\n        return true\n    }\n}\n```\n\n**Fix.** Remove `ref this` so the member only reads:\n\n```\nstruct Queue {\n    i64 count\n\n    bool isEmpty() => count == 0\n}\n```\n\nIf it must change `this`, name the action with a verb: `bool drain(ref this)`.\n\n**Where this comes from.** The `is` / `has` / `can` state follows the Arabic attribute (ṣifa), which describes a thing without acting on it. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5003: string = "# BYN5003: `tryX` with the wrong return type\n\n**What.** A hand-written `tryX` returns something other than `T?` or `bool`, and the type has an `x()` that `fails`.\n\n**Why.** `tryX` is reserved (spec §5.2, [grammar guide](../bayan-grammar.md) tree 4): it is the attempt form of `x() fails`, derived from it, and it returns `T?` (the value or `null`) or `bool` (whether it worked). A `tryX` with another return type reads as an attempt but does not report failure the way every other `tryX` does.\n\n**Example.**\n\n```\nunion error ParseError {\n    empty\n}\nstruct Reader {\n    string text\n    i64 parse() fails ParseError {\n        return 0\n    }\n    i64 tryParse() => 0\n}\n```\n\n**Fix.** Remove `tryParse` and call `try parse()`, or return `i64?`:\n\n```\n    i64? tryParse() => null\n```\n\n**Where this comes from.** `tryX` follows Arabic verb Form X (istafʿala), which adds the sense of attempting the act. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5004: string = "# BYN5004: too many unlabeled parameters\n\n**Why.** A particle is part of a function's name: `copy(from: a, to: b)` says what each argument is for, where `copy(a, b)` leaves the reader to guess. A function has at most one unlabeled required parameter, the object; every other one starts with a particle (`from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`). The receiver of a method never counts as the object. `bool` parameters, parameters with a default, `extern` declarations, operators, union and state payloads and laws are exempt.\n\n**Message.** `{0}` has {1} unlabeled parameters; give each but one a particle\n\n**Help.** keep one unlabeled parameter, the object\n\n**Example.**\n\n```\nvoid transfer(i64 amount, i64 payer, i64 payee) {\n    return\n}\n```\n\nEach parameter besides the object is also reported as BYN5006.\n\n**Fix.** Keep the object unlabeled and give the others a particle by meaning:\n\n```\nvoid transfer(i64 amount, from i64 payer, to i64 payee) {\n    return\n}\n```\n\nThe diagnostic has no machine-applicable fix.\n\nSee GRAMMAR: Role marks (docs/bayan-grammar.md §15).\n"
const doc5005: string = "# BYN5005: argument passed without its particle\n\n**Why.** A particle is part of the function's name, so the call writes it: `width(2, until: 5)` reads as the declaration does. An argument for a parameter with a particle, passed without it, is reported; this also catches a swapped pair, which the same-type naming rule (BYN2307, retired) used to.\n\n**Message.** `{0}` is passed without its particle `{1}:`\n\n**Help.** add `{1}:` before the argument\n\n**Example.**\n\n```\ni64 width(i64 start, until i64 end) => end - start\n\nprint($\"{width(2, 5)}\")\n```\n\n**Fix.** Add the particle: `width(2, until: 5)`. The diagnostic carries this fix.\n\nSee GRAMMAR: Role marks (docs/bayan-grammar.md §15).\n"
const doc5006: string = "# BYN5006: parameter needs a particle\n\n**Why.** A function has one unlabeled required parameter, the object; every other required parameter starts with a particle that names its role (BYN5004). This code marks each parameter that needs one. The receiver of a method is not the object, so `record(ref this, i64 amount, i64 fee)` has two unlabeled parameters.\n\n**Message.** `{0}` is a required parameter besides the object and needs a particle\n\n**Help.** label it with `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`\n\n**Example.**\n\n```\nstruct Ledger {\n    i64 total\n\n    void record(ref this, i64 amount, i64 fee) {\n        total += amount - fee\n    }\n}\n```\n\n**Fix.** Choose the particle by meaning: a source or start takes `from`, a destination `to`, an exclusive end `until`, an inclusive end `through`, a position `at`, a replacement `by`:\n\n```\n    void record(ref this, i64 amount, by i64 fee) {\n        total += amount - fee\n    }\n```\n\nThe diagnostic has no machine-applicable fix.\n\nSee GRAMMAR: Role marks (docs/bayan-grammar.md §15).\n"
const doc5007: string = "# BYN5007: a log level used as the verb\n\n**Message.** `Log.{0}` names a level, not the act; write `log(…, as: .{0})`\n\n**Help.** call `log` and pass the level `as: .{0}`\n\n**What.** A call such as `Log.debug(\"cache miss\")` names the level where the act should be.\n\n**Why.** `log` is the verb; the level says how the message is logged, so it is an argument with the particle `as` ([grammar guide](../bayan-grammar.md) §10): `log(\"cache miss\", as: .debug)`.\n\n**Example.**\n\n```\nLog.debug(\"cache miss\")\n```\n\n**Fix.** Call `log` and pass the level:\n\n```\nlog(\"cache miss\", as: .debug)\n```\n\n**Where this comes from.** The level describes the act the way the Arabic ḥāl (circumstantial accusative) describes the state in which a verb is done, so it follows the verb instead of replacing it. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5008: string = "# BYN5008: not a particle\n\n**Why.** A parameter may start with a particle that names its role: `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`. Any other word in that position, followed by a passing mode or a type and a name, is not one.\n\n**Message.** `{0}` is not a particle\n\n**Help.** choose one of `from`, `to`, `until`, `through`, `at`, `by`, `for`, `as`\n\n**Example.**\n\n```\nvoid copy(over Buf src, to Buf dst) {\n    return\n}\n```\n\n**Fix.** Choose one of the eight particles, or remove the word:\n\n```\nvoid copy(from Buf src, to Buf dst) {\n    return\n}\n```\n\nThe diagnostic has no machine-applicable fix.\n\nSee GRAMMAR: Role marks (docs/bayan-grammar.md §15).\n"
const doc5009: string = "# BYN5009: a particle as a member name\n\n**What.** A member is named with a particle (`at`, `to`, `by`, `from`, `until`, `through`, `for`, `as`), or an instance member spells a conversion with `to` or `as` (`toList`, `toString`, `asSpan`). The checker runs on all code, public or not.\n\n**Message.** `{0}` is a particle; name the member with a verb or a noun\n\n**Help.** rename the member, for example `tryGet(at:)` instead of `at(…)`\n\nFor an instance `toX` or `asX` member:\n\n**Message.** `{0}` spells a conversion with `{1}`; write `{2}`\n\n**Help.** use a view noun, `copy()`, or a `T(x)` conversion\n\n`{2}` is the form to write instead: the view noun for `asX` (`asCount` → `count`), and the conversion `X(x)` for `toX`, with a primitive type in lowercase (`toString` → `string(shelf)`, `toList` → `List(shelf)`).\n\n**Why.** Members are verbs or nouns ([grammar guide](../bayan-grammar.md) §1); a particle labels an argument (`tryGet(at: k)`) and says nothing on its own. A conversion already has a form: a view is a noun (`xs.span`), an owned copy is `copy()`, and a conversion is `T(x)` (`List(seq)`, `string(x)`). Static factories keep `from` (`T.fromJson(…)`, `T.tryFrom(x)`) and are not checked, nor is any static member.\n\n**Example.**\n\n```\nstruct Shelf {\n    i64 count\n\n    i64 at(i64 index) => count + index\n\n    string toString() => \"\"\n}\n```\n\n**Fix.** Name the member with a verb or a noun, and write a conversion as `T(x)`:\n\n```\nstruct Shelf {\n    i64 count\n\n    i64 tryGet(at i64 index) => count + index\n}\n\nlet text = string(shelf)\n```\n\nThe diagnostic has no machine-applicable fix.\n\n**Where this comes from.** Arabic grammar sorts every word into three classes: ism (noun), fiʿl (verb) and ḥarf (particle). A ḥarf has meaning only beside another word, so it cannot name a thing or an act on its own. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5011: string = "# BYN5011: `expects` reads one parameter\n\n**Message.** \"this `expects` reads only `{0}`; a type with `requires` checks it once\"\n\n**Help.** \"declare a type with `requires` for `{0}`\"\n\n**What.** A function's `expects` clause tests a single parameter and nothing else. This is a warning.\n\n**Why.** A condition on one value is a fact about that value, not about the call. A type with `requires` checks it once, when the value is built, and every function that takes the type can rely on it; an `expects` checks it again at each call and leaves other functions unprotected.\n\n**Example.**\n\n```\ni64 percent(i64 value) expects value in 0..=100 {\n    return value\n}\n```\n\n**Fix.** Declare a type that carries the rule, and take it:\n\n```\ntype distinct Percent = i64 requires it in 0..=100\n\ni64 percent(Percent value) => value.value\n```\n\nAn `expects` that relates two parameters (`lo <= hi`) is not reported. The diagnostic has no machine-applicable fix.\n"
const doc5013: string = "# BYN5013: particle used twice\n\n**Why.** A particle names one role in a signature, and a call is read by its particles: with two `from` parameters, `copy(from: a, from: b)` no longer says which is which. A particle appears at most once per declaration. Calls need no check, since such a declaration cannot exist.\n\n**Message.** `{0}` uses the particle `{1}` twice\n\n**Help.** group the values in a struct, or choose another particle\n\n**Example.**\n\n```\nvoid copy(from string src, from string backup) {\n    return\n}\n```\n\n**Fix.** Group the values in a struct, or choose another particle for one of them:\n\n```\nstruct Sources {\n    string src\n    string backup\n}\n\nvoid copy(from Sources sources) {\n    return\n}\n```\n\nThe diagnostic has no machine-applicable fix.\n\nSee GRAMMAR: Role marks (docs/bayan-grammar.md §15).\n"
const doc5014: string = "# BYN5014: unknown word in a member name\n\nA warning: it never blocks a build.\n\n**What.** A word of a member name is not in the checker's built-in word list or in the project dictionary, so the checker cannot tell whether it is a verb, a noun or an adjective. Each word of a name is checked (`upsertRow` → `upsert`, `row`), on all code, public or not.\n\n**Message.** `{0}` is not a known verb or noun\n\n**Help.** add it to `grammar` in package.byn: `verbs: [\"{0}\"]`, `nouns: [\"{0}\"]` or `adjectives: [\"{0}\"]`\n\n**What counts as known.** A word in the built-in list (`src/Bayan.Semantics/Lexicon.cs`; its verbs are also the verbs a help text may start with), a particle, or a word declared in `grammar` in `package.byn`, compared in lowercase. Regular forms of a known word are known too: `-s`, `-es`, `-ies`, `-ed`, `-ing`, `-er`, `-or`, `-est`, `-ly`, with a doubled consonant undone, and `un-` or `re-` before a known word. An irregular form is declared in `forms`. Not checked: math vocabulary (`sqrt`, `log2`, `radians`, …), single letters and digits (`x`, `v2`), names with letters outside ASCII, and typestate states.\n\n**Why.** The grammar rules ([grammar guide](../bayan-grammar.md) §1) depend on the class of each word: a `ref this` member is named with a verb, a property with a noun. A domain word (`upsert`, `sku`, `kyc`) is declared once for the project rather than suppressed member by member.\n\n**Example.**\n\n```\nstruct Catalog {\n    i64 count\n\n    void upsertRow(ref this) {\n        count += 1\n    }\n}\n```\n\n**Fix.** Declare the word in `package.byn`:\n\n```\ngrammar: Grammar {\n    verbs: [\"upsert\"],\n}\n```\n\nThe fix that adds the word to `package.byn` is not offered yet: a fix edits the file of the diagnostic, and this one edits another file (handoff Question 272).\n\n**Where this comes from.** Arabic grammar sorts every word into ism (noun), fiʿl (verb) and ḥarf (particle), and each rule applies to one class. The checker needs the class of a word before it can apply a rule. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5101: string = "# BYN5101: noun on a `ref this` member\n\nA lint: it never blocks a build. It checks the public API only, a `public` member of a `public` struct; a name the module keeps to itself is not checked (grammar guide §1, checker scope).\n\n**What.** A `ref this` member's name starts with a noun from the built-in word list: `size`, `length`, `total`, `sum`, `value`, `values`, `data`, `item`, `items`, `element`, `elements`, `result`, `results`, `name`, `id`, `state`, `status`, `info`, `content`, `contents`, `capacity`, `amount`, `number`, `key`, `keys`, `entry`, `entries`, `node`, `nodes`. Only the first word of the name is checked (`sizeUp` → `size`). The list holds words that are rarely verbs; `count`, `list` and `set` are not on it.\n\n**Why.** A member that changes `this` is an act, named with a verb (spec §5.2, [grammar guide](../bayan-grammar.md) tree 1): `c.add(2)` says what happens to `c`; `c.total(2)` does not.\n\n**Example.**\n\n```\npublic struct Counter {\n    i64 n\n\n    public void total(ref this, i64 by) {\n        n += by\n    }\n}\n```\n\n**Fix.** Name the action:\n\n```\npublic struct Counter {\n    i64 n\n\n    public void add(ref this, i64 by) {\n        n += by\n    }\n}\n```\n\n**Where this comes from.** A verb on `ref this` follows Arabic verb Form V (tafaʿʿala), the reflexive form: the act falls on its own subject. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5102: string = "# BYN5102: `bool` state without `is`, `has` or `can`\n\nA lint: it never blocks a build. It checks the public API only, a `public` member of a `public` struct; a name the module keeps to itself is not checked (grammar guide §1, checker scope).\n\n**What.** A `bool` property, or a `bool` method with no arguments that is not `ref this`, is named without the `is`, `has` or `can` prefix. Not reported: names starting with `contains`, `equals`, `matches`, `startsWith`, `endsWith` (verbs that ask a question) or `try` (an attempt, tree 4); `ref this` members (an action that reports success, such as `bool advance(ref this)`); fields.\n\n**Why.** A boolean state reads as a question with `is` / `has` / `can` (spec §5.2, [grammar guide](../bayan-grammar.md) tree 3): `if door.isLocked` says what is asked; `if door.locked` could be an action or a copy.\n\n**Example.**\n\n```\npublic struct Door {\n    bool open\n\n    public bool locked() => !open\n}\n```\n\n**Fix.** Add the prefix (the machine fix renames the declaration to `isX`; rename the callers with it):\n\n```\npublic struct Door {\n    bool open\n\n    public bool isLocked() => !open\n}\n```\n\n**Where this comes from.** The `is` / `has` / `can` state follows the Arabic attribute (ṣifa), which describes a thing without acting on it. See the [grammar guide](../bayan-grammar.md) §12.\n"
const doc5103: string = "# BYN5103: line join not indented\n\nA lint: it never blocks a build. `bayan format` applies its fix.\n\n**What.** A line starting with a joining token (waṣl: `.`, `?.`, `??`, `&&`, `||`, `and`, `or`, `catch`, `except`, `fails`, `uses`, `where`, `becomes`, `expects`) is indented no deeper than the line its statement starts on. Not reported: `catch` after a line ending in `}` (`} catch`), a struct-level `requires` at a field's indentation, and a line after one that already continues (ending in an operator, `,`, `=`, `=>` or an opening bracket).\n\n**Why.** The joining token makes the line part of the statement above (spec §2.5), but at the same indentation it reads as a new statement. Indenting it deeper shows the join.\n\n**Example.**\n\n```\nlet name = \"bayan\"\nlet n = name\n.length\nprint($\"{n}\")\n```\n\n**Fix.** Indent the line deeper than the line its statement starts on:\n\n```\nlet name = \"bayan\"\nlet n = name\n    .length\nprint($\"{n}\")\n```\n"
const doc6001: string = "# BYN6001: `noalloc`, `nosuspend` and `suspends` are removed\n\n**Why.** A function without `uses` is already pure: it cannot allocate or suspend. What a function needs is named in `uses`, so the marker words add nothing. Writing one is an input form.\n\n**Example.**\n\n```\ni32 twice(i32 n) noalloc => n * 2\n```\n\n**Fix.** Remove the word:\n\n```\ni32 twice(i32 n) => n * 2\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it. It is reported in signature position only: right after the parameters and again after `uses`.\n"
const doc6002: string = "# BYN6002: a function uses an effect it does not declare\n\n**Why.** A public function's signature is a contract: callers in other packages read its effects there, and no `uses` clause means pure. A function with a `uses` clause, public or not, promises the same. Private functions without `uses` infer their effects, and so do tests and scripts. The entry function is exempt whatever its visibility, because nothing calls it.\n\n**Example.**\n\n```\npublic void greet(string name) {\n    print($\"hello {name}\")\n}\n```\n\n**Fix.** Declare the effect:\n\n```\npublic void greet(string name) uses console {\n    print($\"hello {name}\")\n}\n```\n\nThe effects come from `print` and the `Io` streams (`console`), `Io.readFile`, `Io.readText`, `Io.writeFile` and `Io.listDir` (`fs`), `Io.run` and `Io.runBatch` (`process`), `Io.monotonicNanos` (`clock`), and the allocating built-ins (`alloc`), and from calls of other functions. `log`, `panic` and `todo` are not effects.\n"
const doc6003: string = "# BYN6003: not an effect\n\n**Why.** The effect list is closed: `alloc`, `suspend`, `net`, `fs`, `clock`, `random`, `env`, `process` and `console`. A `uses` clause may also name an `effect` alias declared in the same module. An alias that refers to itself is reported here too.\n\n**Example.**\n\n```\nvoid save() uses disk { }\n```\n\n**Fix.** Name the primitive effect, or declare an alias:\n\n```\neffect disk = fs\n\nvoid save() uses disk { }\n```\n"
const doc6004: string = "# BYN6004: the package does not declare the capability\n\n**Why.** `capabilities` in `package.byn` is an upper bound on what the package may do. A package without `.net` cannot contain a function that uses `net`, directly or through a call. Only `net`, `fs`, `process` and `env` need a capability; the other effects are always allowed. A manifest with no `capabilities` field has no bound.\n\n**Example.**\n\n```\n// package.byn\nPackage {\n    name:         \"local/report\",\n    version:      \"0.1.0\",\n    edition:      2027,\n    kind:         .app,\n    capabilities: [.net],\n}\n\n// src/main/main.byn\nvoid main() {\n    let text = try Io.readText(\"report.txt\")\n    print(text)\n}\n```\n\n**Fix.** Add the capability, or remove the use:\n\n```\n    capabilities: [.net, .fs],\n```\n\nIt is reported where the effect starts: at the built-in call, not at each function that calls it.\n"
const doc6005: string = "# BYN6005: an implementation uses more than its interface allows\n\n**Why.** An interface method's `uses` clause is an upper bound for every implementation, and no clause means pure. Code that calls through the interface relies on the bound, so an implementation may use fewer effects but not more.\n\nThe `uses` clause of a function type works the same way for a lambda or function stored in a local of that type: the call through the local relies on the bound. (A function-typed parameter is different: its effects are those of whatever the caller passes.)\n\n**Example.**\n\n```\ninterface IPricer {\n    i64 price(i64 cents)\n}\n\nstruct Logged : IPricer {\n    public i64 price(i64 cents) uses console {\n        print($\"pricing {cents}\")\n        return cents\n    }\n}\n```\n\n**Fix.** Remove the use, or widen the bound on the interface:\n\n```\ninterface IPricer {\n    i64 price(i64 cents) uses console\n}\n```\n\nA lambda stored in a local of a function type:\n\n```\nvoid stored() uses console {\n    let f: i64 -> void = x => print($\"{x}\")\n    f(1)\n}\n```\n\nWiden the function type's bound to match:\n\n```\nlet f: i64 -> void uses console = x => print($\"{x}\")\n```\n"
const doc6006: string = "# BYN6006: `context (…) { }` is now `provide … { }`\n\n**Why.** A block that supplies a value to the code inside it is written `provide name: value { }`, without parentheses. `context (…) { }` is an input form.\n\n**Example.**\n\n```\nvoid run(Arena arena) {\n    context (allocator: arena) {\n        print(\"x\")\n    }\n}\n```\n\n**Fix.** Write `provide` and drop the parentheses:\n\n```\n    provide allocator: arena {\n        print(\"x\")\n    }\n```\n\nThe diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc6007: string = "# BYN6007: not a handler\n\n**Why.** `provide` installs handlers, and the handler names are the effects plus `log`: `alloc`, `net`, `fs`, `clock`, `random`, `env`, `process`, `console` and `log`. `suspend` parks the fiber itself and has nothing to intercept, so it has no handler.\n\n**Example.**\n\n```\nvoid run(Arena arena) {\n    provide memory: arena {\n        print(\"x\")\n    }\n}\n```\n\n**Fix.** Name the handler:\n\n```\n    provide alloc: arena {\n        print(\"x\")\n    }\n```\n\n`allocator` is still accepted for `alloc`. v0.1 lowers only `alloc`; the other handler names are BYN2022.\n"
const doc7001: string = "# BYN7001: value not known to be in the state\n\n**Message.** `{0}` needs `{1}` to be `.{2}`, but it is `{3}`\n\n**Help.** check the state with `is` or `switch` first. Inside `if x.p { … }`, when `p` is exactly `this is .s` and `.s` is the state the call needs: `p` doesn't narrow; write `if x is .s`\n\n**Why.** A method with `this is .s`, or a parameter of a state type `T.s`, may run only on a value known to be in that state. Widening is free (`Order.paid` passes where `Order` is wanted), but the struct itself, or a state type listing other states, is not known to be in the one the callee needs.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n}\ni64 refund(Order.paid order) => order.id\nlet order = Order.draft { id: 1 }\nlet any: Order = order\nlet refunded = refund(any)\n```\n\n**Fix.** Match the state with `is` or `switch` before the call, or pass a value whose type already names the state.\n"
const doc7002: string = "# BYN7002: payload read without knowing the state\n\n**Message.** `{0}` is a payload of `.{1}`; `{2}` is not known to be `.{1}`\n\n**Help.** match `.{1}` with `is` or `switch` before reading `{0}`\n\n**Why.** A payload field exists only while the value is in a state that declares it. Reading it from a value that may be in another state would read storage that holds something else. A read is allowed when the value's type, an `is` test, a `switch` arm or a `becomes` call guarantees a state that has the field; with several states, each must have it with the same type.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n}\n\ni64 paidAmount(Order order) => order.payment\n```\n\n**Fix.** Test the state first: `if order is .paid { … order.payment … }`, or take the state type `Order.paid` as the parameter.\n"
const doc7003: string = "# BYN7003: `become` the signature does not declare\n\n**Message.** `become` needs `becomes .{0}` on `{1}` (with another target: `become .{0}` is not declared; `{1}` becomes `.{2}`; for a `becomes` call on `this`: `{0}` calls `{1}`, which changes the state; declare `becomes` on `{0}`)\n\n**Help.** add `becomes .{0}` to the signature of `{1}` (with another target: change the target to `.{2}`, or declare `becomes .{0}`; for a `becomes` call on `this`: add `becomes .{2}` to the signature of `{0}`)\n\n**Why.** A transition is part of the method's signature: callers rely on `becomes .s` to know the state after the call. A `become` the signature does not declare would change the state behind their back. The same holds for a call on `this` to a method that `becomes .t`: it changes the caller's state, so the caller declares `becomes .t` too, and the call counts as its `become .t`.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n    void pay(ref this is .draft, i64 amount) {\n        become .paid(amount)\n    }\n}\n```\n\n**Fix.** Declare the transition: `void pay(ref this is .draft, i64 amount) becomes .paid { … }`. With no `becomes`, the diagnostic carries a machine-applicable fix that adds the clause. With another target, change the `become` or the `becomes` so they agree. For a `becomes` call on `this` (`void erase(ref this) { reset() }`), declare the callee's target on the caller: `void erase(ref this) becomes .draft { reset() }`; the fix adds the clause when the caller has no `becomes`. On a `move this` or plain `this` method, the fix also makes the receiver `ref this`, since BYN7010 rejects `becomes` without it.\n"
const doc7004: string = "# BYN7004: switch over states misses a state\n\n**Message.** the switch does not handle state `.{0}`\n\n**Help.** add a `case .{0}` arm\n\n**Why.** A `switch` on a value with states must handle every state the value may be in, as a `switch` on a union must handle every variant. A state type such as `Order is .paid or .shipped` needs only the states it lists. A `default` section or an irrefutable arm covers the rest.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n        shipped\n    }\n}\n\nvoid show(Order order) {\n    switch order {\n        case .draft:\n            print(\"draft\")\n        case .paid:\n            print(\"paid\")\n    }\n}\n```\n\n**Fix.** Add a section for each missing state. In a statement `switch` the fix-it inserts an empty `case .s:` section after the last one.\n"
const doc7005: string = "# BYN7005: literal of a struct with states names no state\n\n**Message.** `{0}` has states; a literal must name one: `{0}.{1} { … }`\n\n**Help.** name the state the value starts in\n\n**Why.** A struct with states is built as `T.state { fields…, payload… }`. No state is a safe default, so a plain `T { … }` or `T()` does not say which state the value starts in.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n}\nlet order = Order { id: 1 }\n```\n\n**Fix.** Name the state: `let order = Order.draft { id: 1 }`.\n"
const doc7006: string = "# BYN7006: one state written inline\n\n**Message.** `{0} {1} is .{2}` is an input form; write `{0}.{2} {1}` (without a name, in a local annotation or an alias: `{0} is .{2}` is an input form; write `{0}.{2}`)\n\n**Help.** write the state type `{0}.{2}`\n\n**Why.** A value known to be in one state has the state type `T.s`. The inline form `T name is .a or .b` is for two or more states; with one state it is an input form.\n\n**Example.**\n\n```\nvoid ship(Order order is .paid) { }\n```\n\n**Fix.** Write the state type: `void ship(Order.paid order) { }`. The diagnostic carries a machine-applicable fix, and `bayan format` applies it.\n"
const doc7007: string = "# BYN7007: unknown state\n\n**Message.** `{0}` has no state `.{1}`\n\n**Help.** check the states declared in `{0}`\n\n**Why.** A state type `T.s`, a receiver `this is .s`, a `becomes .s` clause, a `become .s` or a state literal `T.s { … }` must name a state from the struct's `states { … }` block.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n}\nvoid refund(Order.refunded order) { }\n```\n\n**Fix.** Use one of the declared states, or add the state to the struct's `states` block.\n"
const doc7008: string = "# BYN7008: state with the name of a static member\n\n**Message.** state `.{0}` has the same name as static member `{1}.{0}`\n\n**Help.** rename the state or the static member\n\n**Why.** `T.s` names a state of `T`, and `T.m` names a static member of `T`. A state and a static member with the same name would make `T.empty` mean two things.\n\n**Example.**\n\n```\nstruct Cart {\n    i64 count\n    states {\n        empty\n        full\n    }\n    static Cart.empty empty() => Cart.empty { count: 0 }\n}\n```\n\n**Fix.** Rename one of them, for example the static member to `makeEmpty`.\n"
const doc7009: string = "# BYN7009: return without `become`\n\n**Message.** `{0}` declares `becomes .{1}` but returns here without `become`\n\n**Help.** add `become .{1}(…)` before returning, or fail\n\n**Why.** A signature with `becomes .s` promises that the receiver is in state `.s` when the function returns normally, and callers rely on that state after the call. A `return`, or the end of the body, reached on a path that ran no `become` would leave the receiver in its old state. Only a failure (`fail`, a propagated error) or a call that never returns may leave without `become`.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n    void pay(ref this is .draft, i64 amount) becomes .paid {\n        if amount <= 0 {\n            return\n        }\n        become .paid(amount)\n    }\n}\n```\n\n**Fix.** Run `become .paid(…)` on every path before the return, or fail on the paths that cannot make the transition: declare `fails` and `fail` instead of `return`.\n"
const doc7010: string = "# BYN7010: `becomes` without `ref this`\n\n**Message.** `{0}` declares `becomes .{1}` but takes `{2}`; a transition needs `ref this`\n\n**Help.** change the receiver of `{0}` to `ref this`, or return the new state as a value\n\n**Why.** A transition only means something to a caller that still holds the value afterwards. A `move this` receiver ends the caller's ownership, and a plain `this` is a copy the caller never sees again, so `becomes` on either would change a state nobody can observe. `move this is .s` and `this is .s` stay valid for methods without `becomes`: they read or consume a value in a known state. A `become` in a method rejected here reports nothing more.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n    void pay(move this is .draft, i64 amount) becomes .paid {\n        become .paid(amount)\n    }\n}\n```\n\n**Fix.** Take the receiver as `ref this`, keeping its state: `void pay(ref this is .draft, i64 amount) becomes .paid { … }`. The diagnostic carries a machine-applicable fix that replaces `move` (or adds `ref` before a plain `this`). A method that ends the value's life should drop `becomes` instead.\n"
const doc7011: string = "# BYN7011: `becomes` call on a `ref` parameter\n\n**Message.** `{0}` changes the state of `{1}`, a `ref` parameter; a state changes in place only through `ref this`\n\n**Help.** take `{1}` by `move` and return the new state as a value\n\n**Why.** Every place a value's state can change is visible in a signature, so a caller trusts what it knows about a value's state without reading any method body. A function that calls a `becomes` method on one of its `ref` parameters changes the caller's value behind a signature that says nothing about states. A transition in place happens only through the receiver of a `ref this` method that declares `becomes`.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n    void pay(ref this is .draft, i64 amount) becomes .paid {\n        become .paid(amount)\n    }\n}\n\nvoid charge(ref Order.draft order) {\n    order.pay(2)\n}\n```\n\n**Fix.** Consume the value and return the new state, with the transition in the signature (`Order.paid charge(move Order.draft order)`), or make the transition a `becomes` method of `Order` and call it on the caller's value.\n"
const doc7012: string = "# BYN7012: assignment that changes the state\n\n**Message.** `{0}` would change state here; a state changes only through `become`\n\n**Help.** assign a value in the same state, or move the transition into a `becomes` method\n\n**Why.** A state changes in place only through `become`, so every change shows in a `becomes` signature. A whole-value assignment to a `ref` parameter (or to `this`) whose type has states could swap the caller's value for one in another state without the caller knowing. It is allowed only when the target's type names exactly one state and the new value is in that state: `ref Order o` and `ref Order o is .paid or .shipped` can't be reassigned, since the callee does not know which state the caller had; `ref Order.paid o` can take another `Order.paid`.\n\n**Example.**\n\n```\nstruct Order {\n    i64 id\n    states {\n        draft\n        paid(i64 payment)\n    }\n}\nvoid wipe(ref Order o) {\n    o = Order.draft { id: o.id }\n}\n```\n\n**Fix.** Assign a value in the state the parameter names (`ref Order.paid o` takes `Order.paid { … }`), write fields through a `ref this` method of the struct, or move the transition into a `ref this` method that declares `becomes .draft` and runs `become .draft`.\n"
const doc8001: string = "# BYN8001: a safety bypass without `because`\n\n**Why.** Some constructs switch off a check the compiler would otherwise make: `@allow`, `@json(expose)`, a call to a member ending in `Unchecked`, and `unsafe`. Each one names its reason in a `because \"…\"` clause on its line, so a reviewer and `bayan audit` can see why (spec §4.4). An empty reason is rejected too.\n\n**Example.**\n\n```\n@allow(unusedValue)\nvoid warm(Cache cache) {\n    cache.load()\n}\n```\n\n**Fix.** Explain the bypass in a `because` clause:\n\n```\n@allow(unusedValue) because \"warming only fills the cache\"\nvoid warm(Cache cache) {\n    cache.load()\n}\n```\n\nThere is no automatic fix: the reason is human text. This version reports `@allow`, `@json(expose)` and calls to a member ending in `Unchecked` without a reason, and any empty reason; `unsafe` is checked once `unsafe` blocks parse.\n"
const doc8006: string = "# BYN8006: `expects` reads untrusted data\n\n**Message.** \"`expects` reads `{0}`, which is `Untrusted`; a violation would trap on outside data\"\n\n**Help.** \"validate `{0}` with a type that has `requires` before the call\"\n\n**What.** A function's `expects` clause reads a parameter of type `Untrusted<T>`.\n\n**Why.** A violated `expects` traps in every build mode. Outside data can break any rule, so checking it with `expects` lets whoever sends the data stop the program. Outside data is validated where it enters, with a `requires` type whose construction fails with a `ValidationError` the caller handles.\n\n**Example.**\n\n```\ni64 fit(Untrusted<string> name, by i64 limit) expects name.length <= limit {\n    return limit\n}\n```\n\n**Fix.** Validate the value into a type with `requires` before the call, and take that type:\n\n```\ntype distinct Name = string requires it.length <= 64\n\ni64 fit(Name name, by i64 limit) => limit\n```\n\nThe diagnostic has no machine-applicable fix.\n"

