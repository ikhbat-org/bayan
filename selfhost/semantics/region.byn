// T25: RegionAnalysis.cs 1-~417 (regions, borrows, loans, Stmt/Expr/Compute).

// The C# records: a region is a lexical depth and a name; `source` marks a parameter's (or `this`'s) data in a summary.
struct Region {
    i64 depth
    string name
    i64 source = regionNoSource
}

/// C# `NoSource`.
const regionNoSource: i64 = -9223372036854775807

/// C# `This`: the index standing for `this` in a store summary.
const regionThis: i64 = -1

/// One entry of a C# store summary: `(Source, Target)` and the first place the body stores it (none for a broad callee).
struct StorePair {
    i64 source
    i64 target
    TextSpan? site = null
}

/// One entry of the C# `_loopItems` map: the iterable and its borrow.
struct LoopItem {
    BExpr iterable
    Borrow borrow
}

// What a value may borrow from: regions, owning locals and, per owner, the position it was lent at.
struct Borrow {
    List<Region> regions
    List<LocalId> owners
    Map<LocalId, i64>? lends = null
}

struct Loan {
    LocalId owner
    LocalId holder = -1
    i64 created
    i64 loopEnd
}

struct Mutation {
    LocalId target
    TextSpan span
    bool moved = false
    LocalId through = -1
}

// One entry of the C# `_restTails` map: a region and the tail its rest parameter names.
struct RestTail {
    Region region
    string tail
}

// The C# `RegionAnalysis` instance state for one function.
struct Regions {
    FuncId fn
    FileId source
    Map<FieldId, LocalId> thisFields = []
    Map<LocalId, Borrow> locals = []
    Map<LocalId, i64> depthOf = []
    Map<LocalId, i64> declaredAt = []
    List<Loan> loans = []
    List<Mutation> mutations = []
    Map<LocalId, bool> referentMayBorrow = []
    List<Borrow> contexts = []
    List<(i64, i64)> reported = []
    List<RestTail> restTails = []
    i64 depth = 0
    i64 iteration = 0
    List<Region> environments = []
    bool reporting = false
    /// A by-value loop variable over a list, array, span or map, with the iterable and its borrow: its lists share the element's storage.
    Map<LocalId, LoopItem> loopItems = []
    /// Set while computing `fn`'s store summary: nothing is reported, and stores into a target are recorded in `pairs`.
    bool summary = false
    List<StorePair> pairs = []
    /// The parameters (or `regionThis`) the result may borrow.
    List<i64> returns = []
    /// The summary's target parameters, with their index.
    Map<LocalId, i64> targets = []
}

// ── The C# immutable sets (Q640): a `List` with no duplicates stands for `ImmutableHashSet`, copied on every change ──

/// C# `Borrow.None`.
Borrow t25None() => Borrow { regions: [], owners: [] }

/// C# `new Borrow([region], [])`.
Borrow t25Region(i64 depth, as string name) {
    var regions = List<Region>()
    regions.append(Region { depth: depth, name: name })
    return Borrow { regions: move regions, owners: [] }
}

/// C# `Borrow.IsEmpty`.
bool t25IsEmpty(Borrow b) => b.regions.length == 0 && b.owners.length == 0

/// A copy of `b`: the C# records are immutable, so sharing one is copying it here.
Borrow t25Copy(Borrow b) {
    var regions = List<Region>()
    for x in b.regions { regions.append(x) }
    var owners = List<LocalId>()
    for o in b.owners { owners.append(o) }
    return Borrow { regions: move regions, owners: move owners, lends: t25CopyLends(b.lends) }
}

/// C# `b with { Owners = [] }`.
Borrow t25WithoutOwners(Borrow b) {
    var regions = List<Region>()
    for x in b.regions { regions.append(x) }
    return Borrow { regions: move regions, owners: [], lends: t25CopyLends(b.lends) }
}

Map<LocalId, i64>? t25CopyLends(Map<LocalId, i64>? lends) {
    if (lends is { } l) {
        var m: Map<LocalId, i64> = []
        for (k, v) in l { m[k] = v }
        return move m
    }
    return null
}

/// C# `ImmutableHashSet<Region>.Add`.
void t25AddRegion(to ref List<Region> regions, by Region x) {
    for y in regions {
        if y == x { return }
    }
    regions.append(x)
}

/// C# `ImmutableHashSet<LocalSymbol>.Add`.
void t25AddOwner(to ref List<LocalId> owners, by LocalId x) {
    for y in owners {
        if y == x { return }
    }
    owners.append(x)
}

// ── RegionAnalysis.cs:31 Borrow.Union, :35 Lent, :38 Merge ──────────────────────

Borrow unionBorrow(in Borrow a, by in Borrow b) {
    if t25IsEmpty(b) { return t25Copy(a) }
    if t25IsEmpty(a) { return t25Copy(b) }
    var regions = List<Region>()
    for x in a.regions { regions.append(x) }
    for x in b.regions { t25AddRegion(to: ref regions, by: x) }
    var owners = List<LocalId>()
    for o in a.owners { owners.append(o) }
    for o in b.owners { t25AddOwner(to: ref owners, by: o) }
    return Borrow { regions: move regions, owners: move owners, lends: t25Merge(a.lends, by: b.lends) }
}

Borrow lent(in Borrow b, for LocalId owner, at i64 at) {
    var regions = List<Region>()
    for x in b.regions { regions.append(x) }
    var owners = List<LocalId>()
    for o in b.owners { owners.append(o) }
    t25AddOwner(to: ref owners, by: owner)
    var one: Map<LocalId, i64> = []
    one[owner] = at
    let added: Map<LocalId, i64>? = move one
    return Borrow { regions: move regions, owners: move owners, lends: t25Merge(b.lends, by: added) }
}

Map<LocalId, i64>? t25Merge(Map<LocalId, i64>? a, by Map<LocalId, i64>? b) {
    if a is null { return t25CopyLends(b) }
    if b is null { return t25CopyLends(a) }
    var result: Map<LocalId, i64> = []
    if (a is { } x) {
        for (k, v) in x { result[k] = v }
    }
    if (b is { } y) {
        for (owner, at) in y {
            if result.contains(owner) {
                let other = result[owner]
                result[owner] = at < other ? at : other
            } else {
                result[owner] = at
            }
        }
    }
    return move result
}

// ── RegionAnalysis.cs:83 Analyze, :89 Run ─────────────────────────────────────

void analyzeRegions(ref Ctx c, for FuncId fn) {
    if c.functions[fn].file == -1 || c.functions[fn].body == -1 { return }
    var r = Regions { fn: fn, source: c.functions[fn].file }
    runRegions(ref r, through: ref c)
}

/// Q745: each template's store and return summaries, one least fixpoint from none, recomputed in declaration order until no summary grows.
void summarizeRegions(ref Ctx c) {
    var functions = List<FuncId>()
    for m in 0..c.modules.length {
        let fns = copyIds(c.modules[m].allFunctions)
        for fn in fns {
            if c.functions[fn].file != -1 && c.functions[fn].body != -1 && !functionIsInstance(ref c, by: fn)
                && (t41HasTargets(ref c, for: fn) || t41MayHold(ref c, for: c.functions[fn].returnType)) {
                functions.append(fn)
            }
        }
    }
    var changed = true
    var first = true
    while changed {
        changed = false
        for fn in functions {
            var known: i64 = 0
            if c.storeSummaries.contains(fn) { known = c.storeSummaries[fn].length }
            var returned: i64 = 0
            if c.returnSummaries.contains(fn) { returned = c.returnSummaries[fn].length }
            var pairs = List<StorePair>()
            var returns = List<i64>()
            var flags = T41Changed {}
            // Q31 (plan 013): the first pass fills `Ctx`'s lazy memos (`changedFields`) in `General`, in today's order; later
            // passes only read them, so each of their runs is freed with its arena. A list keeps the allocator it was made
            // with, so `pairs`, `returns` and `c.locals` (grown by `fieldLocal`) stay in `General`.
            if first {
                flags = t41SummaryRun(ref c, for: fn, by: known, from: returned, to: ref pairs, through: ref returns)
            } else {
                using let arena = Arena()
                provide allocator: arena {
                    flags = t41SummaryRun(ref c, for: fn, by: known, from: returned, to: ref pairs, through: ref returns)
                }
            }
            let pairsChanged = flags.pairs
            let returnsChanged = flags.returns
            if pairsChanged {
                c.storeSummaries[fn] = move pairs
                changed = true
            }
            if returnsChanged {
                c.returnSummaries[fn] = move returns
                changed = true
            }
        }
        first = false
    }
}

/// Whether a summary run changed the store pairs and the returns.
struct T41Changed {
    bool pairs = false
    bool returns = false
}

/// One summary run of `fn`: its store pairs and returns, copied into `pairs` and `returns` when their counts differ from
/// `known` and `returned`; whether each did.
T41Changed t41SummaryRun(ref Ctx c, for FuncId fn, by i64 known, from i64 returned, to ref List<StorePair> pairs, through ref List<i64> returns) {
    var r = Regions { fn: fn, source: c.functions[fn].file, summary: true }
    runRegions(ref r, through: ref c)
    var pairsChanged = false
    var returnsChanged = false
    if r.pairs.length != known {
        for p in r.pairs { pairs.append(p) }
        pairsChanged = true
    }
    if r.returns.length != returned {
        for x in r.returns { returns.append(x) }
        returnsChanged = true
    }
    return T41Changed { pairs: pairsChanged, returns: returnsChanged }
}

/// Whether `fn` has a summary target: a `ref`, `out` or writable `dyn ref` parameter, or a `ref this` receiver, that can hold a borrow.
bool t41HasTargets(ref Ctx c, for FuncId fn) {
    let ps = copyIds(c.functions[fn].parameters)
    for p in ps {
        if t41IsTarget(ref c, for: p) { return true }
    }
    let owner = c.functions[fn].owner
    return c.functions[fn].isMutating && functionHasThis(ref c, by: fn) && (owner == -1 || t41MayHold(ref c, for: structTypeOf(owner)))
}

bool t41IsTarget(ref Ctx c, for LocalId p) =>
    (t37RefOrOut(c, for: p) || t37WritableDynRef(c, for: c.locals[p].type)) && t41MayHold(ref c, for: c.locals[p].type)

/// Whether a value of `t` may borrow, counting a type parameter as one that may (a summary covers every instance).
bool t41MayHold(ref Ctx c, for Type t) {
    var seen = List<Type>()
    return mayBorrow(ref c, for: t, by: ref seen) || occurs(ref c, by: t)
}

/// C# `new Borrow([new Region(0, "the caller's data", source)], [])`.
Borrow t41Source(i64 source) {
    var regions = List<Region>()
    regions.append(Region { depth: 0, name: "the caller's data", source: source })
    return Borrow { regions: move regions, owners: [] }
}

void runRegions(ref Regions r, through ref Ctx c) {
    let ps = copyIds(in c.functions[r.fn].parameters)
    // C# `p.Syntax?.Rest`: T12's parameter syntax, one per parameter in order (Q641).
    let syntax = t12Params(in c, for: r.fn)
    for i in 0..ps.length {
        let p = ps[i]
        let type = c.locals[p].type
        // An arena parameter is a handle to the caller's arena: what it allocates outlives the call.
        let callerOwned = c.locals[p].modifier == .refKeyword || c.locals[p].modifier == .outKeyword || type == builtinType(.arena)
        r.depthOf[p] = callerOwned ? 0 : 1
        r.declaredAt[p] = -1
        // What a parameter points to belongs to the caller; the marker keeps that known after unions.
        if r.summary {
            if t41IsTarget(ref c, for: p) { r.targets[p] = i }
            if t41MayHold(ref c, for: type) {
                let caller = t25Region(0, as: "the caller's data")
                let own = t41Source(i)
                r.locals[p] = unionBorrow(caller, by: own)
            }
        } else {
            var seen = List<Type>()
            if mayBorrow(ref c, for: type, by: ref seen) { r.locals[p] = t25Region(0, as: "the caller's data") }
        }
        // A `rest` tail is borrowed for the call only (J62): it lives in the caller's frame for this statement.
        if (syntax[i].syntax is { } x) && x.isRest && kindOf(type) == .span {
            let tail = Region { depth: 1, name: $"`{c.locals[p].name}`" }
            t25SetRestTail(ref r, for: tail, to: c.locals[p].name)
            r.locals[p] = t25Region(1, as: $"`{c.locals[p].name}`")
        }
    }
    // The first pass collects what each local may borrow (a loop can store into a local
    // after its first use); the second reports against the complete picture.
    let body = c.functions[r.fn].body
    stmtRegions(ref r, through: ref c, for: body)
    r.reporting = true
    stmtRegions(ref r, through: ref c, for: body)
    if !r.summary { checkMutations(ref r, through: ref c) }
}

/// C# `_restTails[tail] = name`.
void t25SetRestTail(ref Regions r, for Region tail, to string name) {
    for k in 0..r.restTails.length {
        if r.restTails[k].region == tail {
            r.restTails[k].tail = name
            return
        }
    }
    r.restTails.append(RestTail { region: tail, tail: name })
}

// ── Statements: RegionAnalysis.cs:117 Stmt, :229 Iterate, :237 Declare ─────────

void stmtRegions(ref Regions r, through ref Ctx c, for BStmt s) {
    let i = boundIndex(s)
    switch boundKind(s) {
        case .block:
            r.depth += 1
            let sts = copyIds(in c.bBlocks[i].statements)
            for st in sts { stmtRegions(ref r, through: ref c, for: st) }
            r.depth -= 1
        case .localDecl:
            let local = c.bLocalDecls[i].local
            let init = c.bLocalDecls[i].initializer
            declareBorrow(ref r, through: ref c, for: local, at: c.bLocalDecls[i].span.start)
            if init != -1 {
                let value = exprRegions(ref r, through: ref c, for: init)
                storeBorrow(ref r, through: ref c, for: local, by: in value, at: nodeSpan(in c, for: init))
                referBorrow(ref r, through: ref c, for: local, by: init)
            }
        case .exprStmt:
            let _ = exprRegions(ref r, through: ref c, for: c.bExprStmts[i].expr)
        case .assertStmt:
            let _ = exprRegions(ref r, through: ref c, for: c.bAsserts[i].condition)
        case .assign:
            let target = c.bAssigns[i].target
            let valueExpr = c.bAssigns[i].value
            let value = exprRegions(ref r, through: ref c, for: valueExpr)
            let _ = exprRegions(ref r, through: ref c, for: target)
            storeIntoBorrow(ref r, through: ref c, for: target, by: in value, at: nodeSpan(in c, for: valueExpr))
            if boundKind(target) == .local { referBorrow(ref r, through: ref c, for: c.bLocals[boundIndex(target)].local, by: valueExpr) }
        case .returnStmt:
            let valueExpr = c.bReturns[i].value
            if valueExpr != -1 {
                let value = exprRegions(ref r, through: ref c, for: valueExpr)
                checkReturn(ref r, through: ref c, for: in value, at: nodeSpan(in c, for: valueExpr))
            }
        case .failStmt:
            let _ = exprRegions(ref r, through: ref c, for: c.bFails[i].error)
        case .ifStmt:
            let then = c.bIfs[i].then
            let elseBranch = c.bIfs[i].elseBranch
            let _ = exprRegions(ref r, through: ref c, for: c.bIfs[i].condition)
            stmtRegions(ref r, through: ref c, for: then)
            if elseBranch != -1 { stmtRegions(ref r, through: ref c, for: elseBranch) }
        case .whileStmt:
            let body = c.bWhiles[i].body
            let _ = exprRegions(ref r, through: ref c, for: c.bWhiles[i].condition)
            iterateRegions(ref r, through: ref c, at: r.depth + 1, for: body)
        case .doWhile:
            let condition = c.bDoWhiles[i].condition
            iterateRegions(ref r, through: ref c, at: r.depth + 1, for: c.bDoWhiles[i].body)
            let _ = exprRegions(ref r, through: ref c, for: condition)
        case .forStmt:
            t25For(ref r, through: ref c, for: s)
        case .switchStmt:
            let value = exprRegions(ref r, through: ref c, for: c.bSwitches[i].value)
            for k in 0..c.bSwitches[i].sections.length {
                r.depth += 1
                let pattern = c.bSwitches[i].sections[k].pattern
                let guard = c.bSwitches[i].sections[k].guard
                let body = copyIds(in c.bSwitches[i].sections[k].body)
                if pattern != -1 { t37BindPattern(ref r, through: ref c, for: pattern, by: in value) }
                if guard != -1 { let _ = exprRegions(ref r, through: ref c, for: guard) }
                for st in body { stmtRegions(ref r, through: ref c, for: st) }
                r.depth -= 1
            }
        case .deferStmt:
            stmtRegions(ref r, through: ref c, for: c.bDefers[i].body)
        case .errdeferStmt:
            let body = c.bErrdefers[i].body
            if c.bErrdefers[i].error != -1 { declareBorrow(ref r, through: ref c, for: c.bErrdefers[i].error, at: c.bErrdefers[i].span.start) }
            stmtRegions(ref r, through: ref c, for: body)
        case .panicDefer:
            let body = c.bPanicDefers[i].body
            if c.bPanicDefers[i].panic != -1 { declareBorrow(ref r, through: ref c, for: c.bPanicDefers[i].panic, at: c.bPanicDefers[i].span.start) }
            stmtRegions(ref r, through: ref c, for: body)
        case .contextStmt:
            let body = c.bContexts[i].body
            r.contexts.append(allocatedFrom(ref r, through: ref c, for: c.bContexts[i].allocator))
            stmtRegions(ref r, through: ref c, for: body)
            r.contexts.remove(at: r.contexts.length - 1)
        default:
            return
    }
}

/// The C# `case BoundFor f:` arm of `Stmt`.
void t25For(ref Regions r, through ref Ctx c, for BStmt s) {
    let i = boundIndex(s)
    let variable = c.bFors[i].variable
    let iterableExpr = c.bFors[i].iterable
    let body = c.bFors[i].body
    let span = c.bFors[i].span
    let user = c.bFors[i].userIteration is not null
    let iterable = exprRegions(ref r, through: ref c, for: iterableExpr)
    let iterableType = exprType(in c, for: iterableExpr)
    let kind = kindOf(iterableType)
    // The loop reads the collection on every iteration: it holds a loan on it.
    if r.reporting {
        var owners = List<LocalId>()
        for o in iterable.owners { owners.append(o) }
        var root = rootLocal(ref c, for: iterableExpr)
        if root == -1 { root = thisField(ref r, through: ref c, for: iterableExpr) }
        if root != -1 && (kind == .list || kind == .map || kind == .array || user) { t25AddOwner(to: ref owners, by: root) }
        for owner in owners { r.loans.append(Loan { owner: owner, holder: -1, created: span.start, loopEnd: span.end }) }
    }
    r.depth += 1
    declareBorrow(ref r, through: ref c, for: variable, at: span.start)
    // A `dyn ref` variable points into an array or list, like `dyn ref I d = xs[i]`, or where a span points; any other is a copy.
    let dynRef = kindOf(c.locals[variable].type) == .dynRef
    let iterableSpan = nodeSpan(in c, for: iterableExpr)
    var item = t25None()
    if !dynRef {
        item = t25WithoutOwners(iterable)
    } else if kind == .list || kind == .array {
        item = lendBorrow(ref r, through: ref c, for: iterableExpr, by: in iterable, at: iterableSpan.end)
    } else if kind == .span {
        item = t25Copy(iterable)
    } else {
        item = t25WithoutOwners(iterable)
    }
    storeBorrow(ref r, through: ref c, for: variable, by: in item, at: iterableSpan)
    // The item is a shallow copy the loop never frees, and `BorrowsSubject` refuses changing it (BYN2783).
    // coverage-exempt: Q746
    if !user && !dynRef && c.locals[variable].borrowsSubject && (kind == .list || kind == .array || kind == .span || kind == .map) {
        r.loopItems[variable] = LoopItem { iterable: iterableExpr, borrow: t25Copy(iterable) }
    }
    if dynRef {
        var seen = List<Type>()
        var may = true
        switch kind {
            case .list: may = mayBorrow(ref c, for: c.listTypes[typeIndex(iterableType)], by: ref seen)
            case .array: may = mayBorrow(ref c, for: c.arrayTypes[typeIndex(iterableType)].element, by: ref seen)
            case .span: may = mayBorrow(ref c, for: c.spanTypes[typeIndex(iterableType)].element, by: ref seen)
            default: may = true
        }
        r.referentMayBorrow[variable] = may
    }
    iterateRegions(ref r, through: ref c, at: r.depth, for: body)
    r.depth -= 1
}

void iterateRegions(ref Regions r, through ref Ctx c, at i64 depth, for BStmt body) {
    let outer = r.iteration
    r.iteration = depth
    stmtRegions(ref r, through: ref c, for: body)
    r.iteration = outer
}

void declareBorrow(ref Regions r, through ref Ctx c, for LocalId local, at i64 position) {
    r.depthOf[local] = r.depth
    r.declaredAt[local] = position
}

// ── Expressions: RegionAnalysis.cs:245 Expr, :251 Compute, :367 Builtin ────────

Borrow exprRegions(ref Regions r, through ref Ctx c, for BExpr e) {
    let result = computeBorrow(ref r, through: ref c, for: e)
    var seen = List<Type>()
    let type = exprType(c, for: e)
    if mayBorrow(ref c, for: type, by: ref seen) || r.summary && occurs(ref c, by: type) { return move result }
    return t25None()
}

Borrow computeBorrow(ref Regions r, through ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            let local = c.bLocals[i].local
            if r.locals.contains(local) { return t25Copy(r.locals[local]) }
            return t25None()
        case .thisRef:
            if r.summary { return t41Source(regionThis) }
            return t25None()
        case .literal or .defaultValue or .errorVariant or .enumMember or .enumValues or .staticArray:
            return t25None()
        case .conversion:
            let operandExpr = c.bConversions[i].operand
            let kind = c.bConversions[i].kind
            let span = c.bConversions[i].span
            // A `dyn ref` to a span element points where the span points: it borrows what the span borrows.
            if kind == .toDynRef && boundKind(operandExpr) == .index {
                let target = c.bIndexes[boundIndex(operandExpr)].target
                let index = c.bIndexes[boundIndex(operandExpr)].index
                if kindOf(exprType(in c, for: target)) == .span {
                    let spanBorrow = exprRegions(ref r, through: ref c, for: target)
                    let _ = exprRegions(ref r, through: ref c, for: index)
                    return move spanBorrow
                }
            }
            let operand = exprRegions(ref r, through: ref c, for: operandExpr)
            if kind == .arrayToSpan || kind == .listToSpan || kind == .toDynRef {
                return lendBorrow(ref r, through: ref c, for: operandExpr, by: in operand, at: span.end)
            }
            return move operand
        case .moveExpr:
            // The new owner may grow or free the storage: a move ends every borrow into it.
            let operandExpr = c.bMoves[i].operand
            let span = c.bMoves[i].span
            let operand = exprRegions(ref r, through: ref c, for: operandExpr)
            let operandEnd = nodeSpan(in c, for: operandExpr).end
            mutateBorrow(ref r, through: ref c, for: operandExpr, at: TextSpan.fromBounds(span.start, until: span.end > operandEnd ? span.end : operandEnd), moved: true)
            return move operand
        case .builtinCall:
            return builtinBorrow(ref r, through: ref c, for: e)
        case .call:
            return callBorrow(ref r, through: ref c, for: e)
        case .slice:
            let targetExpr = c.bSlices[i].target
            let start = c.bSlices[i].start
            let end = c.bSlices[i].end
            let span = c.bSlices[i].span
            let target = exprRegions(ref r, through: ref c, for: targetExpr)
            if start != -1 { let _ = exprRegions(ref r, through: ref c, for: start) }
            if end != -1 { let _ = exprRegions(ref r, through: ref c, for: end) }
            let kind = kindOf(exprType(in c, for: targetExpr))
            if kind == .list || kind == .array { return lendBorrow(ref r, through: ref c, for: targetExpr, by: in target, at: span.end) }
            return move target
        case .index:
            // The element is a copy: it may point where the collection's data points, but not into the collection.
            let index = c.bIndexes[i].index
            let target = exprRegions(ref r, through: ref c, for: c.bIndexes[i].target)
            let _ = exprRegions(ref r, through: ref c, for: index)
            return t25WithoutOwners(target)
        case .spread:
            // Like an index: the elements are copies of what the sequence holds.
            let operand = exprRegions(ref r, through: ref c, for: c.bSpreads[i].operand)
            return t25WithoutOwners(operand)
        case .stackalloc:
            let span = c.bStackallocs[i].span
            return t25Region(r.depth, as: $"the `stackalloc` buffer on line {lineOf(ref r, through: ref c, at: span)}")
        case .collection:
            let elementExprs = copyIds(in c.bCollections[i].elements)
            let type = c.bCollections[i].type
            let span = c.bCollections[i].span
            var elements = t25None()
            for el in elementExprs {
                let b = exprRegions(ref r, through: ref c, for: el)
                elements = unionBorrow(in elements, by: in b)
            }
            switch kindOf(type) {
                case .span:
                    let literal = t25Region(r.depth, as: $"the array literal on line {lineOf(ref r, through: ref c, at: span)}")
                    return unionBorrow(in elements, by: in literal)
                case .list or .map:
                    if r.contexts.length > 0 { return unionBorrow(in elements, by: in r.contexts[r.contexts.length - 1]) }
                    return move elements
                default:
                    return move elements
            }
        case .interpolated:
            // The text is a copy formatted into `context.allocator`: it borrows that, not its holes (Q43).
            var values = List<BExpr>()
            for part in c.bInterpolateds[i].parts {
                if part.value != -1 { values.append(part.value) }
            }
            for v in values { let _ = exprRegions(ref r, through: ref c, for: v) }
            if r.contexts.length > 0 { return t25Copy(r.contexts[r.contexts.length - 1]) }
            return t25None()
        case .jump:
            stmtRegions(ref r, through: ref c, for: c.bJumps[i].jump)
            return t25None()
        case .blockExpr:
            stmtRegions(ref r, through: ref c, for: c.bBlockExprs[i].block)
            return t25None()
        case .isExpr:
            let pattern = c.bIses[i].pattern
            let value = exprRegions(ref r, through: ref c, for: c.bIses[i].value)
            t37BindPattern(ref r, through: ref c, for: pattern, by: in value)
            return t25None()
        case .switchExpr:
            let value = exprRegions(ref r, through: ref c, for: c.bSwitchExprs[i].value)
            var result = t25None()
            for k in 0..c.bSwitchExprs[i].arms.length {
                let pattern = c.bSwitchExprs[i].arms[k].pattern
                let guard = c.bSwitchExprs[i].arms[k].guard
                let armValue = c.bSwitchExprs[i].arms[k].value
                t37BindPattern(ref r, through: ref c, for: pattern, by: in value)
                if guard != -1 { let _ = exprRegions(ref r, through: ref c, for: guard) }
                let b = exprRegions(ref r, through: ref c, for: armValue)
                result = unionBorrow(in result, by: in b)
            }
            return move result
        case .catchExpr:
            let binding = c.bCatches[i].binding
            let handler = c.bCatches[i].handler
            let span = c.bCatches[i].span
            let operand = exprRegions(ref r, through: ref c, for: c.bCatches[i].operand)
            if binding != -1 { declareBorrow(ref r, through: ref c, for: binding, at: span.start) }
            let handled = exprRegions(ref r, through: ref c, for: handler)
            return unionBorrow(in operand, by: in handled)
        case .lambda:
            // A lambda borrows what its captures borrow, and its captures live in this frame,
            // overwritten by each iteration of the loop that creates it.
            let captureExprs = copyIds(in c.bLambdas[i].captures)
            let span = c.bLambdas[i].span
            var captures = t25None()
            for capture in captureExprs {
                let b = exprRegions(ref r, through: ref c, for: capture)
                captures = unionBorrow(in captures, by: in b)
            }
            if captureExprs.length == 0 { return move captures }
            let environment = Region { depth: r.iteration > 1 ? r.iteration : 1, name: $"the lambda on line {lineOf(ref r, through: ref c, at: span)}" }
            t25AddRegion(to: ref r.environments, by: environment)
            let own = t25Region(environment.depth, as: environment.name)
            return unionBorrow(in captures, by: in own)
        default:
            var result = t25None()
            for child in children(in c, for: e) {
                // coverage-exempt: Q746
                if child != -1 && isExprKind(boundKind(child)) {
                    let b = exprRegions(ref r, through: ref c, for: child)
                    result = unionBorrow(in result, by: in b)
                }
            }
            return move result
    }
}

Borrow builtinBorrow(ref Regions r, through ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    let receiverExpr = c.bBuiltinCalls[i].receiver
    let argExprs = copyIds(in c.bBuiltinCalls[i].arguments)
    let member = c.bBuiltinCalls[i].member
    let span = c.bBuiltinCalls[i].span
    let receiver = exprRegions(ref r, through: ref c, for: receiverExpr)
    var args = List<Borrow>()
    for a in argExprs { args.append(exprRegions(ref r, through: ref c, for: a)) }
    let stored = t41BuiltinStore(member)
    // coverage-exempt: Q746
    if stored != -1 && stored < args.length { storeIntoBorrow(ref r, through: ref c, for: receiverExpr, by: args[stored], at: nodeSpan(c, for: argExprs[stored])) }
    // `finish()` points into the buffer's storage, which outlives the local: a loan on it, but not its scope.
    if member == .strBufAsString && hasSyntax(c, for: e, by: syntaxCall) {
        let buffer = rootLocal(ref c, for: receiverExpr)
        if buffer != -1 { return lent(receiver, for: buffer, at: span.end) }
    }
    switch member {
        case .listAsSpan or .arrayAsSpan or .strBufAsString or .listMutableSpan or .arrayMutableSpan:
            return lendBorrow(ref r, through: ref c, for: receiverExpr, by: in receiver, at: span.end)
        default:
            break
    }
    // C# `case … when b.Arguments.Length > 0`: with no argument the member falls to the cases below.
    switch member {
        case .spanCopy or .stringCopy or .listCopy or .mapCopy or .strBufCopy:
            if argExprs.length > 0 { return allocatedFrom(ref r, through: ref c, for: argExprs[0]) }
        default:
            break
    }
    switch member {
        case .ioReadAll or .intToString or .stringCopy or .stringLowercased or .stringUppercased
            or .stringReplaced or .stringRepeated or .stringJoined or .utf16Copy
            or .stringPadded or .bytesToString or .spanCopy or .listCopy:
            // Fresh text from `context.allocator`, like `Io.readText`.
            if r.contexts.length > 0 { return t25Copy(r.contexts[r.contexts.length - 1]) }
            return t25None()
        case .listReplace or .listAdd:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25None()
        case .mapIndexSet or .mapSlot:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25WithoutOwners(receiver)
        case .listTake or .mapTake or .strBufTake or .optionalTake:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span, moved: true)
            return move receiver
        case .listRemoveLast:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25WithoutOwners(receiver)
        case .mapIndex or .mapTryGet or .listTryGet:
            return t25WithoutOwners(receiver)
        // An interned `Symbol`'s text lives until exit, like a literal.
        case .mapLength or .mapContains or .symbolText:
            return t25None()
        case .mapRemove or .mapClear or .listRemoveRange or .listRemoveThrough or .listRemoveAt
            or .listRemoveAtRange or .listSort:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25None()
        case .listClear or .strBufClear or .strBufInsert or .arenaReset:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25None()
        default:
            var acc = t25Copy(receiver)
            for a in args { acc = unionBorrow(in acc, by: in a) }
            return move acc
    }
}

/// The builtins' store summaries: the argument each stores into its receiver, or -1. Every other builtin stores none:
/// a `StrBuf` append or insert copies the text, `copy(to:)` copies into the arena, formatting copies.
i64 t41BuiltinStore(BuiltinMember member) {
    switch member {
        case .listAdd: return 0
        case .listReplace: return 1
        case .mapIndexSet: return 0
        case .mapSlot: return 0
        default: return -1
    }
}
