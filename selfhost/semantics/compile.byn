// T11: Compilation.cs 1-549 and 551-652 (FromPath, FromProject, Create, ModuleFiles, LoadModule, ResolveImport,
// CNameOf, Declare, DeclareBuiltinVariants, CheckMainSignature, CheckAttributes, CheckCases, IsCaseLiteral,
// DeclareTest, CaseTitle, DeclareFile, AssociatedType, DeclareTypeParameters, DeclareWhere, ResolveInterface,
// RejectBases, AddType, AddFunction), plus AfterMembersDeclared (:1549), ReportInto (:1922) and the `Work`
// dispatch (`runWork`) that replaces the C# closures (Q570). The C# fields of :22-25 and :551-559 live in
// ctx.byn's `// ── T11 state` section.

import lexer
import parser

/// The C# `CompilationOptions` record.
public struct CompilationOptions {
    public bool includeTests = false
    public bool library = false
    public bool skipOwnershipCheck = false
    public List<string>? capabilities = null
    public string? packageName = null
    public string? target = null
    /// Test-only: the std files `import std.…` reads; null for the shipped ones (`stdShippedSources`, stdsource.byn).
    public List<StdSource>? std = null
}

// ── StdLibrary.cs ───────────────────────────────────────────────────────────────

/// A std file: its path under `std/` (`json/reader.byn`) and its text.
public struct StdSource {
    public string path
    public string text
}

/// One file of a std module: its name and its text.
public struct StdFile {
    public string file
    public string text
}

/// One std module: its path (`a/b` for `std.a.b`) and its files, in name order.
public struct StdModule {
    public string path
    public List<StdFile> files
}

/// The C# `StdLibrary`: the std modules (spec 016), `byPath` indexing `modules`, and `names` every module's import name
/// (`std.json`), sorted.
public struct StdLibrary {
    public List<StdModule> modules = List<StdModule>()
    public Map<string, i64> byPath = []
    public List<string> names = List<string>()
}

/// StdLibrary.cs:12 the constructor: a module is the files directly in one directory; tests are not part of it.
StdLibrary stdLibraryCreate(from in List<StdSource> files) {
    var library = StdLibrary {}
    for f in files {
        let slash = f.path.lastPosition("/") ?? -1
        let file = $"{f.path[(slash + 1)..f.path.length]}"
        if slash < 0 || !file.endsWith(".byn") || file.endsWith(".test.byn") { continue }
        let module = $"{f.path[0..slash]}"
        if !library.byPath.contains(module) {
            library.byPath[module] = library.modules.length
            library.modules.append(StdModule { path: module, files: List<StdFile>() })
        }
        library.modules[library.byPath[module]].files.append(StdFile { file: file, text: f.text })
    }
    for m in 0..library.modules.length {
        let n = library.modules[m].files.length
        for i in 1..n {
            var j = i
            while j > 0 && pathLess(library.modules[m].files[j].file, by: library.modules[m].files[j - 1].file) {
                let t = library.modules[m].files[j]
                library.modules[m].files[j] = library.modules[m].files[j - 1]
                library.modules[m].files[j - 1] = t
                j -= 1
            }
        }
        library.names.append($"std.{library.modules[m].path.replaced("/", by: ".")}")
    }
    t11SortOrdinal(ref library.names)
    return library
}

/// C# `HostTarget.Split` (HostTarget.cs): the `Target.os` and `Target.arch` of a target name; `wasm32` is `wasi`/`wasm32`.
public (string os, string arch) hostTargetSplit(string target) uses alloc {
    if target == "wasm32" { return (os: "wasi", arch: "wasm32") }
    if (target.position("-") is { } dash) { return (os: $"{target[0..dash]}", arch: $"{target[(dash + 1)..target.length]}") }
    return (os: "", arch: "")
}


/// The C# `_testCases` value: the arguments of the test's first `@cases` attribute (`attribute`) that are cases.
public struct TestCases {
    public i64 attribute
    public List<i64> args
}

/// The identity of top-level declaration `declIndex` of `file` (the C# `Decl` reference, as a map key).
i64 declKey(FileId file, at i64 declIndex) => (file << 32) | declIndex

// ── Compilation.cs:69 FromPath ──────────────────────────────────────────────────

/// Compiles a file or a directory. A file's module is its directory, but only that file is read unless
/// `wholeDirectory` is set. `path` must be absolute: Bayan has no current directory (Q571).
public Ctx fromPath(string path, by in CompilationOptions options, bool wholeDirectory = true) uses alloc, clock, fs {
    let full = t11FullPath(path)
    let isDir = t11DirectoryExists(full)
    let dir = isDir ? full : t11DirectoryName(full)
    var files = List<string>()
    if isDir || wholeDirectory {
        files = t11ModuleFiles(dir, includeTests: options.includeTests)
    } else {
        files.append(full)
    }
    if !isDir && !listContainsString(in files, by: full) { files.append(full) }
    var sources = List<lexer.SourceText>()
    for f in files { sources.append(lexer.SourceText.create(f, from: t11ReadAllBytes(f))) }
    return create(from: move sources, at: dir, by: in options)
}

// ── Compilation.cs:87 FromProject ───────────────────────────────────────────────

/// Compiles a project: the entry module is `src/<entryModule>/`, imports resolve under `src/`, and with tests
/// every `tests/*.test.byn` joins the entry module. Files are named relative to the project root.
public Ctx fromProject(string root, for string entryModule, by in CompilationOptions options) uses alloc, clock, fs {
    let src = t11Combine(root, by: "src")
    let entry = t11Combine(src, by: entryModule)
    var files = List<string>()
    if t11DirectoryExists(entry) { files = t11ModuleFiles(entry, includeTests: options.includeTests) }
    let tests = t11Combine(root, by: "tests")
    if options.includeTests && t11DirectoryExists(tests) {
        var found = List<string>()
        for name in t11ListFiles(tests) {
            let f = t11Combine(tests, by: name)
            if name.endsWith(".test.byn") && !t11DirectoryExists(f) { found.append(f) }
        }
        t11SortOrdinal(ref found)
        for f in found { files.append(f) }
    }
    var sources = List<lexer.SourceText>()
    for f in files { sources.append(lexer.SourceText.create(t11RelativePath(root, to: f).replaced("\\", by: "/"), from: t11ReadAllBytes(f))) }
    return create(from: move sources, at: src, by: in options, displayRoot: root)
}

// ── Compilation.cs:100 Create ───────────────────────────────────────────────────

/// Compiles `entryFiles` as the entry module; imports resolve under `packageRoot`.
public Ctx create(from move List<lexer.SourceText> entryFiles, at string packageRoot, by in CompilationOptions options, string? displayRoot = null) uses alloc, clock, fs =>
    t2Create(from: move entryFiles, at: packageRoot, by: in options, through: [], for: List<string>(), displayRoot: displayRoot)

/// Compilation.cs:129 WithFile: the same program compiled again with `text` in place of the file of the same path,
/// entry or imported: spec 013 re-binds and ownership-checks each mutant this way.
public Ctx withFile(in Ctx c, from in lexer.SourceText text) uses alloc, clock, fs {
    var replaced: Map<string, lexer.SourceText> = []
    var paths = List<string>()
    for path in c.replacedPaths {
        replaced[path] = t2CopySource(in c.replaced[path])
        paths.append(path)
    }
    unless replaced.contains(text.path) { paths.append(text.path) }
    replaced[text.path] = t2CopySource(in text)
    var entry = List<lexer.SourceText>()
    for f in c.entryFiles { entry.append(f.path == text.path ? t2CopySource(in text) : t2CopySource(in f)) }
    return t2Create(from: move entry, at: c.packageRoot, by: in c.options, through: move replaced, for: move paths, displayRoot: c.displayRoot)
}

lexer.SourceText t2CopySource(in lexer.SourceText s) uses alloc => lexer.SourceText.create(s.path, from: s.bytes.copy())

/// C# `CompilationOptions` copied, for `withFile`.
CompilationOptions t2CopyOptions(in CompilationOptions o) uses alloc {
    var capabilities: List<string>? = null
    if (o.capabilities is { } caps) { capabilities = copyStrings(in caps) }
    return CompilationOptions { includeTests: o.includeTests, library: o.library, skipOwnershipCheck: o.skipOwnershipCheck, capabilities: move capabilities, packageName: o.packageName, target: o.target }
}

/// Compilation.cs:138 Create, with the files `through` read from this text instead of from disk.
Ctx t2Create(from move List<lexer.SourceText> entryFiles, at string packageRoot, by in CompilationOptions options, through move Map<string, lexer.SourceText> replaced, for move List<string> replacedPaths, string? displayRoot = null) uses alloc, clock, fs {
    var capabilities: List<string>? = null
    if (options.capabilities is { } caps) { capabilities = copyStrings(in caps) }
    var c = Ctx {
        files: List<SourceFile>(),
        modules: List<Mod>(),
        diagnostics: List<Diag>(),
        bags: List<DiagBag>(),
        library: options.library,
        capabilities: move capabilities,
        packageName: options.packageName ?? "",
        target: options.target,
        packageRoot: packageRoot,
        displayRoot: displayRoot ?? packageRoot,
        includeTests: options.includeTests,
        skipOwnershipCheck: options.skipOwnershipCheck,
    }
    c.options = t2CopyOptions(in options)
    for f in entryFiles { c.entryFiles.append(t2CopySource(in f)) }
    c.replaced = move replaced
    c.replacedPaths = move replacedPaths
    if (options.std is { } injected) {
        c.std = stdLibraryCreate(from: in injected)
    } else {
        c.std = stdLibraryCreate(from: in stdShippedSources())
    }
    var clock = Io.monotonicNanos()
    c.entryModule = loadModule(ref c, for: "main", at: packageRoot, from: move entryFiles, by: -1)
    t11OrderModules(ref c)
    for f in copyIds(in c.modules[c.entryModule].files) { c.files[f].isEntry = true }
    c.parseTime = Io.monotonicNanos() - clock
    // Syntax errors stop here: binding a broken tree mostly reports their echoes.
    if t11HasErrors(in c) { return c }
    clock = Io.monotonicNanos()
    // C# `Lexicon` is static (Lexicon.cs:9), built before anything reads it.
    buildLexicon(ref c)
    declare(ref c)
    bindAll(ref c)
    // Each case binds and checks the same body; report what it finds there once.
    // (blocked: Q573) Untested: no current path produces a repeated diagnostic until T12's `checkOverloads` lands.
    if c.testCases.length > 0 { removeRepeats(ref c) }
    c.checkTime = Io.monotonicNanos() - clock
    return c
}

/// The C# `DiagnosticBag.HasErrors` of `Diagnostics`.
bool t11HasErrors(in Ctx c) {
    for d in c.diagnostics {
        if !d.isWarning { return true }
    }
    return false
}

// ── Compilation.cs:117 ModuleFiles ──────────────────────────────────────────────

/// The `.byn` files of `dir` (without `.test.byn` unless `includeTests`), as `dir/name`, in ordinal order.
List<string> t11ModuleFiles(string dir, bool includeTests) {
    var files = List<string>()
    for name in t11ListFiles(dir) {
        if !name.endsWith(".byn") { continue }
        let f = t11Combine(dir, by: name)
        // `Directory.EnumerateFiles` lists files only.
        if t11DirectoryExists(f) { continue }
        if includeTests || !f.endsWith(".test.byn") { files.append(f) }
    }
    t11SortOrdinal(ref files)
    return files
}

// ── Compilation.cs:125 LoadModule ───────────────────────────────────────────────

ModId loadModule(ref Ctx c, for string name, at string dir, from move List<lexer.SourceText> sources, by ModId importer) {
    c.modules.append(Mod { name: name, files: List<FileId>(), directory: dir, cName: t11CNameOf(name) })
    let module = c.modules.length - 1
    c.modulesByDir[dir] = module
    c.loading.append(module)
    var pending = move sources
    var inOrder = List<lexer.SourceText>()
    while pending.length > 0 { inOrder.append(pending.removeLast()) }
    // Whether each file's tree has an error (the C# `f.Tree.Diagnostics.Any(d => d.IsError)`).
    var broken = List<bool>()
    while inOrder.length > 0 {
        let source = inOrder.removeLast()
        let path = source.path
        var text = List<u8>()
        for b in source.bytes { text.append(b) }
        var p = parser.Parser.create(lexer.lex(move source, by: lexer.Keywords.build()))
        let unit = parser.parseCompilationUnit(ref p)
        let fileId = c.files.length
        // Every lexer and parser code is an error (DiagnosticCodes.cs has no BYN0xxx/BYN1xxx warning).
        var hasError = false
        for d in p.lexed.diagnostics {
            // A report the parser withdrew (`unreport`, Q440) is gone from the C# bag (Parser.cs:2627).
            if d.code == "" { continue }
            addDiag(ref c, by: Diag {
                code: d.code,
                file: fileId,
                span: d.span,
                message: d.message,
                label: d.label,
                help: d.help,
                isWarning: false,
                hasFix: d.hasFix,
                fixSpan: d.fixSpan,
                fixReplacement: d.fixReplacement,
                related: List<Related>(),
            })
            hasError = true
        }
        // The line-join lint (BYN5103) is a warning the C# compilation adds after the tree's diagnostics.
        for d in parser.lintLineJoins(ref p) {
            addDiag(ref c, by: Diag {
                code: d.code,
                file: fileId,
                span: d.span,
                message: d.message,
                label: d.label,
                help: d.help,
                isWarning: true,
                hasFix: d.hasFix,
                fixSpan: d.fixSpan,
                fixReplacement: d.fixReplacement,
                related: List<Related>(),
            })
        }
        c.files.append(SourceFile {
            path: path,
            displayPath: path,
            text: move text,
            unit: move unit,
            module: module,
            isTestFile: path.endsWith(".test.byn"),
            imports: Map<string, ModId>(),
        })
        c.modules[module].files.append(fileId)
        broken.append(hasError)
    }
    let files = copyIds(in c.modules[module].files)
    for i in 0..files.length {
        if broken[i] { continue }
        let f = files[i]
        for m in 0..c.files[f].unit.members.length {
            switch c.files[f].unit.members[m] {
                case .importDecl(let node):
                    resolveImport(ref c, from: f, for: in node.value)
                default:
                    continue
            }
        }
    }
    var at: i64 = 0
    while at < c.loading.length {
        if c.loading[at] == module {
            c.loading.remove(at: at)
            break
        }
        at += 1
    }
    c.moduleOrder.append(module)
    return module
}

/// Compilation.cs:163-181 `LoadModule`: `Modules.Add(module)` (:180) runs after `ResolveImport` (:177), so `Modules`
/// lists an imported module before its importer, and every pass over `Modules` (field defaults, Compilation.cs:1418-1423)
/// sees a dependency first. `loadModule` numbers a module on append (:147), before its imports load, so once the entry
/// module is in, `c.modules` is renumbered into `moduleOrder` (that post-order) and the ModIds held so far follow:
/// `c.files[*].module`, `c.files[*].imports`, `c.modulesByDir`, `c.entryModule`. A `Mod` holds only its four loading
/// fields here: `declare` builds the builtin module (`t9Create`) later, and symbols are declared later still.
void t11OrderModules(ref Ctx c) {
    var newId = List<ModId>()
    for _ in 0..c.modules.length { newId.append(-1) }
    for i in 0..c.moduleOrder.length { newId[c.moduleOrder[i]] = i }
    var modules = List<Mod>()
    var byDir = Map<string, ModId>()
    for m in copyIds(in c.moduleOrder) {
        modules.append(Mod { name: c.modules[m].name, files: copyIds(in c.modules[m].files), directory: c.modules[m].directory, cName: c.modules[m].cName })
        byDir[c.modules[m].directory] = modules.length - 1
    }
    c.modules = move modules
    c.modulesByDir = move byDir
    c.entryModule = newId[c.entryModule]
    for i in 0..c.moduleOrder.length { c.moduleOrder[i] = i }
    for f in 0..c.files.length {
        c.files[f].module = newId[c.files[f].module]
        // `imports` is keyed by the name each `import` uses (resolveImport:236); a repeated name was reported, not stored.
        var seen = Map<string, bool>()
        for m in 0..c.files[f].unit.members.length {
            switch c.files[f].unit.members[m] {
                case .importDecl(let node):
                    let alias = t11Text(in c, from: f, at: node.value.alias ?? node.value.path[node.value.path.length - 1])
                    if seen.contains(alias) || !c.files[f].imports.contains(alias) { continue }
                    seen[alias] = true
                    c.files[f].imports[alias] = newId[c.files[f].imports[alias]]
                    // Post-order: an import was appended to `moduleOrder` before its importer (a cycle is reported, not stored).
                    assert c.files[f].imports[alias] < c.files[f].module
                default:
                    continue
            }
        }
    }
    // Every held ModId names the remapped module it came from (Q1034): a file belongs to the module listing it, a
    // directory maps to the module loaded from it, and the entry module is the one `create` loaded at the package root.
    var listed = 0
    for m in 0..c.modules.length {
        assert c.modulesByDir[c.modules[m].directory] == m
        for f in copyIds(in c.modules[m].files) { assert c.files[f].module == m }
        listed += c.modules[m].files.length
    }
    assert listed == c.files.length
    assert c.modulesByDir.length == c.modules.length
    assert c.modules[c.entryModule].name == "main"
    assert c.modules[c.entryModule].directory == c.packageRoot
}

// ── Compilation.cs:146 ResolveImport ────────────────────────────────────────────

void resolveImport(ref Ctx c, from FileId file, for in parser.ImportDecl decl) {
    var nameBuf = StrBuf()
    var parts = List<string>()
    parts.append(c.packageRoot)
    for i in 0..decl.path.length {
        let part = t11Text(in c, from: file, at: decl.path[i])
        if i > 0 { nameBuf.append(".") }
        nameBuf.append(part)
        parts.append(part)
    }
    let name = $"{nameBuf.finish()}"
    // `std.a.b` is the shipped module `a/b/` (spec 016); the package's own `std/` is never read for it.
    let std = parts[1] == "std"
    var stdPathBuf = StrBuf()
    for i in 2..parts.length {
        if i > 2 { stdPathBuf.append("/") }
        stdPathBuf.append(parts[i])
    }
    let stdPath = $"{stdPathBuf.finish()}"
    let dir = std ? $"<std>/{stdPath}" : Path.combine(parts.span)
    let span = TextSpan.fromBounds(decl.path[0].start, until: decl.path[decl.path.length - 1].end)
    // A std module never reads the importing package: its imports are std modules only.
    if !std && c.modules[c.files[file].module].directory.startsWith("<std>/") {
        report(ref c, for: .stdImportsPackage, from: file, at: span, by: (c.modules[c.files[file].module].name, name, "", "", ""),
            help: "import only `std.…` modules from a std module")
        return
    }
    let alias = t11Text(in c, from: file, at: decl.alias ?? decl.path[decl.path.length - 1])
    var module: ModId = -1
    if c.modulesByDir.contains(dir) {
        module = c.modulesByDir[dir]
        if listContains(in c.loading, by: module) {
            var chain = StrBuf()
            var started = false
            for m in c.loading {
                if m == module { started = true }
                if started {
                    chain.append(c.modules[m].name)
                    chain.append(" → ")
                }
            }
            chain.append(c.modules[module].name)
            report(ref c, for: .importCycle, from: file, at: span, by: ($"{chain.finish()}", "", "", "", ""),
                help: "move the shared declarations into a module both can import")
            return
        }
    } else if std {
        // C# `Options.Std ?? StdLibrary.Shipped` is `c.std`, built once in `create`.
        let stdModule: i64 = decl.path.length > 1 && c.std.byPath.contains(stdPath) ? c.std.byPath[stdPath] : -1
        if stdModule < 0 {
            var help = StrBuf()
            if c.std.names.length == 0 {
                help.append("remove the import: no std modules ship with this build")
            } else {
                help.append("import one of ")
                for i in 0..c.std.names.length {
                    if i > 0 { help.append(", ") }
                    help.append($"`{c.std.names[i]}`")
                }
            }
            report(ref c, for: .unknownStdModule, from: file, at: span, by: (name, "", "", "", ""), help: $"{help.finish()}")
            return
        }
        var sources = List<lexer.SourceText>()
        for f in c.std.modules[stdModule].files {
            var bytes = List<u8>()
            for b in f.text.bytes { bytes.append(b) }
            sources.append(lexer.SourceText.create($"{dir}/{f.file}", from: move bytes))
        }
        module = loadModule(ref c, for: name, at: dir, from: move sources, by: c.files[file].module)
    } else {
        var files = List<string>()
        if t11DirectoryExists(dir) { files = t11ModuleFiles(dir, includeTests: c.includeTests) }
        if files.length == 0 {
            report(ref c, for: .unknownModule, from: file, at: span, by: (name, "", "", "", ""),
                help: $"put the module's `.byn` files in `{t11RelativePath(c.packageRoot, to: dir)}/` next to the entry file; a module is a directory")
            return
        }
        var sources = List<lexer.SourceText>()
        for f in files {
            let path = t11RelativePath(c.displayRoot, to: f).replaced("\\", by: "/")
            // C# `_replaced?.GetValueOrDefault(f.Path) ?? new SourceText(…)`: `withFile`'s text before the disk's.
            if c.replaced.contains(path) {
                sources.append(t2CopySource(in c.replaced[path]))
            } else {
                sources.append(lexer.SourceText.create(path, from: t11ReadAllBytes(f)))
            }
        }
        module = loadModule(ref c, for: name, at: dir, from: move sources, by: c.files[file].module)
    }
    if c.files[file].imports.contains(alias) {
        report(ref c, for: .duplicateDeclaration, from: file, at: span, by: (alias, "", "", "", ""))
    } else {
        c.files[file].imports[alias] = module
    }
}

// ── Compilation.cs:179 CNameOf ──────────────────────────────────────────────────

/// Each character of `moduleName` that is not an ASCII letter or digit becomes `_` (`char.IsAsciiLetterOrDigit`).
/// A non-ASCII character is one `_` per UTF-16 unit, as in C#: a UTF-8 lead byte writes one, a 4-byte lead
/// (an astral character, two UTF-16 units) writes two, a continuation byte writes none.
string t11CNameOf(string moduleName) {
    var sb = StrBuf()
    for b in moduleName.bytes {
        if (b >= 0x61 && b <= 0x7A) || (b >= 0x41 && b <= 0x5A) || (b >= 0x30 && b <= 0x39) {
            sb.append($"{rune(b)}")
        } else if b >= 0xF0 {
            sb.append("__")
        } else if b < 0x80 || b >= 0xC0 {
            sb.append("_")
        }
    }
    return $"{sb.finish()}"
}

// ── Compilation.cs:184 Declare ──────────────────────────────────────────────────

void declare(ref Ctx c) {
    t11DeclareBuiltinVariants(ref c, for: "IoError")
    t11DeclareBuiltinVariants(ref c, for: "Utf8Error")
    for m in copyIds(in c.moduleOrder) {
        for f in copyIds(in c.modules[m].files) { declareFile(ref c, for: f) }
    }
    // Before any signature names a `union error … except .c`, whose cases must already exist.
    for m in copyIds(in c.moduleOrder) {
        for set in copyIds(in c.modules[m].errorSets) { declareVariants(ref c, for: set) }
    }
    t11DeclareBuiltinVariants(ref c, for: "ParseError")
    // Bounds are resolved once every type is declared, so `where T : IOrder<T>` can name `T` and later types.
    for i in 0..c.wheres.length {
        let work = t11CopyWork(in c.wheres[i])
        runWork(ref c, for: in work)
    }
    declareInterfaceMembers(ref c, for: findInterface(ref c, for: "IEnumerator"))
    declareInterfaceMembers(ref c, for: findInterface(ref c, for: "IIndexable"))
    for m in copyIds(in c.moduleOrder) {
        for i in copyIds(in c.modules[m].interfaces) { declareInterfaceMembers(ref c, for: i) }
    }
    c.interfaceMembersDeclared = true
    for i in 0..c.pendingInterfaces.length {
        let w = t11CopyWork(in c.pendingInterfaces[i])
        let scope = instantiatingBegin(ref c, from: w.file, at: w.span)
        runWork(ref c, for: in w)
        instantiatingEnd(ref c, by: scope)
    }
    for alias in copyIds(in c.aliasOrder) {
        let file = c.aliases[alias].file
        switch c.files[file].unit.members[c.aliases[alias].declIndex] {
            case .errorSetDecl(let composed):
                checkComposition(ref c, for: alias, from: in composed.value)
            default:
                continue
        }
    }
    for m in copyIds(in c.moduleOrder) {
        for e in copyIds(in c.modules[m].enums) { declareEnumMembers(ref c, for: e) }
    }
    // `Range<i64>` is not a type name, so `Rule`'s cases are declared here rather than resolved.
    let rule = typeIndex(t9Type(ref c, for: "Rule"))
    let ruleFile = c.unions[rule].file
    switch c.files[ruleFile].unit.members[c.unions[rule].declIndex] {
        case .unionDecl(let decl):
            for v in 0..decl.value.variants.length {
                let vName = decl.value.variants[v].name
                let sym = newUnionVariant(ref c, by: UnionVariantSymbol {
                    name: t11Text(in c, from: ruleFile, at: vName),
                    nameSpan: vName,
                    span: vName,
                    owner: rule,
                    file: ruleFile,
                    declIndex: c.unions[rule].declIndex,
                    memberIndex: v,
                    tag: c.unions[rule].variants.length,
                    doc: decl.value.variants[v].doc,
                })
                for field in decl.value.variants[v].fields {
                    let p = newLocal(ref c, by: LocalSymbol {
                        name: t11Text(in c, from: ruleFile, at: field.name),
                        nameSpan: field.name,
                        span: field.name,
                        type: internRange(ref c, by: prim(.i64)),
                        kind: .parameter,
                        isParameter: true,
                        modifier: .none,
                        ordinal: c.unionVariants[sym].fields.length,
                    })
                    c.unionVariants[sym].fields.append(p)
                }
                c.unions[rule].variants.append(sym)
            }
        default:
            // coverage-exempt: Q1197
            panic("the builtin `Rule` is a union")
    }
    for m in copyIds(in c.moduleOrder) {
        for u in copyIds(in c.modules[m].unions) { declareUnionVariants(ref c, for: u) }
    }
    for m in copyIds(in c.moduleOrder) {
        for set in copyIds(in c.modules[m].errorSets) { declarePayloads(ref c, for: set) }
    }
    for m in copyIds(in c.moduleOrder) {
        for s in copyIds(in c.modules[m].structs) { declareMembers(ref c, for: s) }
        for s in copyIds(in c.modules[m].structs) { checkStateNames(ref c, for: s) }
        for s in copyIds(in c.modules[m].structs) { checkMembers(ref c, for: s) }
        var free = List<FuncId>()
        for f in copyIds(in c.modules[m].allFunctions) {
            // coverage-exempt: Q1197
            if c.functions[f].owner < 0 && !functionIsInstance(ref c, by: f) && c.functions[f].kind != .main && c.functions[f].kind != .testKeyword {
                free.append(f)
            }
        }
        for f in free {
            let file = c.functions[f].file
            switch c.files[file].unit.members[c.functions[f].declIndex] {
                case .functionDecl(let decl):
                    declareSignature(ref c, for: f, from: in decl.value, by: file)
                default:
                    // coverage-exempt: Q1197
                    panic("a free function is declared by a `FunctionDecl`")
            }
        }
        checkSignatures(ref c, for: m)
        checkOverloads(ref c, for: m)
    }
    c.membersDeclared = true
    for i in 0..c.pendingKeys.length {
        let work = t11CopyWork(in c.pendingKeys[i])
        if work.atSite {
            // Compilation.cs:1550 `() => Instantiating(site, span, check)`.
            let scope = instantiatingBegin(ref c, from: work.siteFile, at: work.siteSpan)
            runWork(ref c, for: in work)
            instantiatingEnd(ref c, by: scope)
        } else {
            runWork(ref c, for: in work)
        }
    }
    for m in copyIds(in c.moduleOrder) {
        for s in copyIds(in c.modules[m].structs) { checkStructShape(ref c, for: s) }
        for u in copyIds(in c.modules[m].unions) { checkUnionShape(ref c, for: u) }
    }
    let main = c.modules[c.entryModule].main
    // (blocked: Q720) Reports BYN2771 for every `main` until T38's `declareSignature` sets its `returnType`.
    if main >= 0 && c.functions[main].kind == .function { t11CheckMainSignature(ref c, for: main) }
}

/// A copy of `w`, so a queued item can be run while `c` is passed by `ref`.
Work t11CopyWork(in Work w) => Work {
    kind: w.kind,
    subject: w.subject,
    args: copyIds(in w.args),
    instance: w.instance,
    file: w.file,
    span: w.span,
    declIndex: w.declIndex,
    memberIndex: w.memberIndex,
    atSite: w.atSite,
    siteFile: w.siteFile,
    siteSpan: w.siteSpan,
}

// ── Compilation.cs:244 DeclareBuiltinVariants ───────────────────────────────────

/// The variants of the builtin error set `name`. `IoError` is numbered first, so the runtime can return its codes 1
/// to 11 directly; `Utf8Error` follows (12). The C# `_nextErrorCode` is `errorVariants.length + 1`: every
/// `ErrorVariantSymbol` takes the next code (Q572).
void t11DeclareBuiltinVariants(ref Ctx c, for string name) {
    let set = typeIndex(t9Type(ref c, for: name))
    let file = c.errorSets[set].file
    switch c.files[file].unit.members[c.errorSets[set].declIndex] {
        case .errorEnumDecl(let decl):
            for v in 0..decl.value.variants.length {
                let vName = decl.value.variants[v].name
                let sym = newErrorVariant(ref c, by: ErrorVariantSymbol {
                    name: t11Text(in c, from: file, at: vName),
                    nameSpan: vName,
                    span: vName,
                    set: set,
                    file: file,
                    declIndex: c.errorSets[set].declIndex,
                    memberIndex: v,
                    code: c.errorVariants.length + 1,
                    doc: decl.value.variants[v].doc,
                })
                // A built-in payload is one primitive or `Millis`: `invalidSequence(i64 at)`, `timeout(Millis after)`.
                for field in decl.value.variants[v].fields {
                    var type = errorType()
                    switch field.type {
                        case .namedType(let n):
                            let typeName = t11Text(in c, from: file, at: n.value.path[0])
                            type = typeName == "Millis" ? builtinType(.millis) : (primitiveByName(typeName) ?? panic("a built-in payload is a primitive or `Millis`"))
                        default:
                            panic("a built-in payload is a named type")
                    }
                    let p = newLocal(ref c, by: LocalSymbol {
                        name: t11Text(in c, from: file, at: field.name),
                        nameSpan: field.name,
                        span: field.name,
                        type: type,
                        kind: .parameter,
                        isParameter: true,
                        modifier: .none,
                        ordinal: c.errorVariants[sym].fields.length,
                    })
                    c.errorVariants[sym].fields.append(p)
                }
                c.errorSets[set].variants.append(sym)
            }
        default:
            panic("a builtin error set is a `union error`")
    }
}

// ── Compilation.cs:260 CheckMainSignature ───────────────────────────────────────

/// `void` or `i32 main()`, optionally with `ReadOnlySpan<string> args` and `fails` (BYN2771).
void t11CheckMainSignature(ref Ctx c, for FuncId main) {
    let returns = c.functions[main].returnType
    let returnOk = isVoid(returns) || isError(returns) || returns == prim(.i32)
    var paramsOk = c.functions[main].parameters.length == 0
    if !paramsOk && c.functions[main].parameters.length == 1 {
        let p = c.functions[main].parameters[0]
        let type = c.locals[p].type
        if c.locals[p].modifier == .none {
            if isError(type) {
                paramsOk = true
            } else if kindOf(type) == .span {
                let data = c.spanTypes[typeIndex(type)]
                paramsOk = data.readOnly && isString(data.element)
            }
        }
    }
    if !returnOk || !paramsOk {
        report(ref c, for: .invalidMainSignature, from: c.functions[main].file, at: c.functions[main].nameSpan, by: ("", "", "", "", ""),
            help: "write `void main()`, `i32 main()`, `void main(ReadOnlySpan<string> args)` or `i32 main(ReadOnlySpan<string> args)`, each optionally with `fails`")
    }
}

// ── Compilation.cs:273 CheckAttributes ──────────────────────────────────────────

/// `@cases` belongs on a test with parameters, `@exitCode` on an error variant and `@sealed` and `@positional`,
/// bare, on a struct; nothing else takes an attribute. `decl` is member `declIndex` of `file`, or a member of it.
void t11CheckAttributes(ref Ctx c, from FileId file, for in parser.Decl decl, at i64 declIndex) {
    switch decl {
        case .importDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .globalStatement(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .functionDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .structDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .interfaceDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .getterDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .associatedTypeDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .extensionDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .fieldDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .propertyDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .constructorDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .errorEnumDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .errorSetDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .enumDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .unionDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .typeAliasDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .effectDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .testDecl(let n): t11CheckAttributeList(ref c, from: file, for: in n.value.attributes, by: in decl, at: declIndex)
        case .none: return
    }
}

/// The body of `CheckAttributes` over `attributes`, the C# `decl.Attributes`.
void t11CheckAttributeList(ref Ctx c, from FileId file, for in List<parser.AttributeSyntax> attributes, by in parser.Decl decl, at i64 declIndex) {
    var isTest = false
    var isStruct = false
    var hasStates = false
    switch decl {
        case .testDecl(_):
            isTest = true
        case .structDecl(let s):
            isStruct = true
            hasStates = s.value.states.length > 0
        default:
            break
    }
    var hasCases = false
    for ai in 0..attributes.length {
        let name = t11Text(in c, from: file, at: attributes[ai].name)
        let span = attributes[ai].span
        let bare = attributes[ai].args.length == 0 && attributes[ai].becauseKeyword is null
        if name == "cases" && isTest {
            if hasCases {
                report(ref c, for: .modifierNotAllowed, from: file, at: span, by: ("@cases", "", "", "", ""), help: "combine the cases into one `@cases(...)`")
            } else {
                switch decl {
                    case .testDecl(let t):
                        c.testCases[declKey(file, at: declIndex)] = TestCases { attribute: ai, args: t11CheckCases(ref c, from: file, for: in t.value, by: in attributes[ai]) }
                    default:
                        panic("`isTest` holds only for a `TestDecl`")
                }
            }
            hasCases = true
        } else if name == "cases" {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: ("@cases", "", "", "", ""), help: "put `@cases(...)` on a test that takes parameters")
        } else if name == "exitCode" {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: ("@exitCode", "", "", "", ""), help: "put `@exitCode` on an error enum variant")
        } else if name == "sealed" && !isStruct {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: ("@sealed", "", "", "", ""), help: "put `@sealed` on a struct")
        } else if name == "sealed" && !bare {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: (t11Text(in c, from: file, at: span), "", "", "", ""), help: "write `@sealed` with no arguments and no `because`")
        } else if name == "sealed" {
            continue
        } else if name == "positional" && !isStruct {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: ("@positional", "", "", "", ""), help: "put `@positional` on a struct")
        } else if name == "positional" && !bare {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: (t11Text(in c, from: file, at: span), "", "", "", ""), help: "write `@positional` with no arguments and no `because`")
        } else if name == "positional" && hasStates {
            report(ref c, for: .modifierNotAllowed, from: file, at: span, by: ("@positional", "", "", "", ""), help: "remove `@positional`: a struct with states is built with state literals")
        } else if name == "positional" {
            c.positional[declKey(file, at: declIndex)] = 1
        } else {
            report(ref c, for: .unknownAttribute, from: file, at: attributes[ai].name, by: (name, "", "", "", ""), help: "use `@exitCode(n)` on an error variant or `@cases(...)` on a test")
        }
    }
    switch decl {
        case .testDecl(let t):
            if t.value.params.length > 0 && !hasCases {
                let span = TextSpan.fromBounds(t.value.params[0].span.start, until: t.value.params[t.value.params.length - 1].span.end)
                report(ref c, for: .modifierNotAllowed, from: file, at: span, by: (t11Text(in c, from: file, at: span), "", "", "", ""),
                    label: "a test without `@cases` takes no parameters",
                    help: "add `@cases(...)` with one value per parameter for each case, or remove the parameters")
            }
        case .structDecl(let s):
            for m in s.value.members { t11CheckAttributes(ref c, from: file, for: in m, at: declIndex) }
        default:
            break
    }
}

// ── Compilation.cs:322 CheckCases ───────────────────────────────────────────────

/// The cases of `@cases(...)` that fit `test`: a tuple per case, or a bare value when it takes one parameter, with
/// one literal per parameter (BYN2773, BYN2774). Each case is the index of its argument in `a.args`.
List<i64> t11CheckCases(ref Ctx c, from FileId file, for in parser.TestDecl t, by in parser.AttributeSyntax a) {
    var cases = List<i64>()
    var names = StrBuf()
    for i in 0..t.params.length {
        if i > 0 { names.append(", ") }
        names.append(t11Text(in c, from: file, at: t.params[i].name))
    }
    let joined = $"{names.finish()}"
    for ai in 0..a.args.length {
        let value = parser.exprSpan(in a.args[ai].value)
        var named = false
        switch a.args[ai].value {
            case .nameExpr(_) or .memberExpr(_):
                named = true
            default:
                break
        }
        if named {
            report(ref c, for: .casesNotConstant, from: file, at: value, by: ("", "", "", "", ""), label: "cases from a const list are not supported yet",
                help: "write each case as a tuple literal, such as `@cases((0, false), (1, true))`")
            continue
        }
        let count = t11CaseValueCount(in a.args[ai].value)
        if count != t.params.length {
            let help = t.params.length == 1 ? "give one value per case: `@cases(1, 2, 3)`"
                : $"give each case one value per parameter, in order: `({joined})`"
            report(ref c, for: .casesArity, from: file, at: value, by: (string(count), string(t.params.length), "", "", ""), help: help)
            continue
        }
        var constant = true
        for k in 0..count {
            if !t11CaseValueIsLiteral(in a.args[ai].value, at: k) {
                report(ref c, for: .casesNotConstant, from: file, at: t11CaseValueSpan(in a.args[ai].value, at: k), by: ("", "", "", "", ""),
                    help: "write the value as a literal: a number, string, rune, `true`, `false`, `null` or a `.case`")
                constant = false
            }
        }
        if constant { cases.append(ai) }
    }
    return cases
}

/// The C# `values.Length` of a case: a tuple's element count, else 1.
i64 t11CaseValueCount(in parser.Expr e) {
    switch e {
        case .tupleExpr(let t): return t.value.elements.length
        default: return 1
    }
}

/// The span of the C# `values[k]` of a case: a tuple's element `k`, else the case itself.
TextSpan t11CaseValueSpan(in parser.Expr e, at i64 k) {
    switch e {
        case .tupleExpr(let t): return parser.exprSpan(in t.value.elements[k].value)
        default: return parser.exprSpan(in e)
    }
}

/// `IsCaseLiteral` of the C# `values[k]` of a case.
bool t11CaseValueIsLiteral(in parser.Expr e, at i64 k) {
    switch e {
        case .tupleExpr(let t): return t11IsCaseLiteral(in t.value.elements[k].value)
        default: return t11IsCaseLiteral(in e)
    }
}

// ── Compilation.cs:354 IsCaseLiteral ────────────────────────────────────────────

bool t11IsCaseLiteral(in parser.Expr e) {
    switch e {
        case .literalExpr(_) or .targetMemberExpr(_):
            return true
        case .unaryExpr(let u):
            if u.value.op != .negate && u.value.op != .plus { return false }
            switch u.value.operand {
                case .literalExpr(let l): return l.value.kind == .integer || l.value.kind == .floatKeyword
                default: return false
            }
        case .parenExpr(let p):
            return t11IsCaseLiteral(in p.value.inner)
        default:
            return false
    }
}

// ── Compilation.cs:362 DeclareTest ──────────────────────────────────────────────

/// A test function titled `title`; `attribute`/`arg` name its case's values (-1 for none).
void t11DeclareTest(ref Ctx c, from FileId file, at i64 declIndex, by TextSpan span, for string title, as i64 attribute, to i64 arg) {
    let module = c.files[file].module
    // Symbols.cs:207: `ReturnType` defaults to `PrimitiveType.Void`, which DeclareTest never changes.
    let fn = newFunction(ref c, by: FunctionSymbol { name: "test", span: span, module: module, kind: .testKeyword, file: file, declIndex: declIndex, returnType: prim(.void) })
    let testId = newTest(ref c, by: TestSymbol { title: title, span: span, function: fn, file: file, declIndex: declIndex })
    c.modules[module].tests.append(testId)
    c.modules[module].allFunctions.append(fn)
    if attribute < 0 {
        c.testBodies[fn] = TestBody { decl: SyntaxRef { file: file, declIndex: declIndex }, hasValues: false, caseArgument: SyntaxRef {} }
    } else {
        c.testBodies[fn] = TestBody { decl: SyntaxRef { file: file, declIndex: declIndex }, hasValues: true, caseArgument: SyntaxRef { file: file, declIndex: declIndex, memberIndex: attribute, itemIndex: arg } }
    }
}

// ── Compilation.cs:371 CaseTitle ────────────────────────────────────────────────

/// `quantity bounds (input: 101, valid: false)`: the title, then each parameter with its value as written.
string t11CaseTitle(in Ctx c, from FileId file, for in parser.TestDecl t, by in parser.Expr values) {
    var sb = StrBuf()
    sb.append(t.title)
    sb.append(" (")
    for i in 0..t.params.length {
        if i > 0 { sb.append(", ") }
        sb.append(t11Text(in c, from: file, at: t.params[i].name))
        sb.append(": ")
        sb.append(t11Text(in c, from: file, at: t11CaseValueSpan(in values, at: i)))
    }
    sb.append(")")
    return $"{sb.finish()}"
}

// ── Compilation.cs:374 DeclareFile ──────────────────────────────────────────────

void declareFile(ref Ctx c, for FileId file) {
    let module = c.files[file].module
    var mainStatements = List<SyntaxRef>()
    for d in 0..c.files[file].unit.members.length {
        let decl = t8TakeDecl(ref c, from: file, at: d, by: .none)
        t11CheckAttributes(ref c, from: file, for: in decl, at: d)
        let _ = t8TakeDecl(ref c, from: file, at: d, by: move decl)
        switch c.files[file].unit.members[d] {
            case .structDecl(let s):
                let name = t11Text(in c, from: file, at: s.value.name)
                var attributes = List<string>()
                for a in s.value.attributes { attributes.append(t11Text(in c, from: file, at: a.name)) }
                let sym = newStruct(ref c, by: StructSymbol {
                    name: name,
                    nameSpan: s.value.name,
                    span: s.value.name,
                    module: module,
                    file: file,
                    declIndex: d,
                    access: accessOf(s.value.modifiers),
                    modifiers: i64(s.value.modifiers),
                    doc: s.value.doc,
                    attributes: move attributes,
                })
                if addType(ref c, from: file, at: s.value.name, as: structTypeOf(sym)) { c.modules[module].structs.append(sym) }
                checkType(ref c, from: file, at: s.value.name)
                var needsFields = s.value.rules.length > 0
                for m in s.value.members {
                    switch m {
                        case .fieldDecl(let f):
                            if f.value.requiresClauses.length > 0 { needsFields = true }
                        default:
                            continue
                    }
                }
                if s.value.typeParams.length == 0 && needsFields {
                    // J23: `T.Field`, reachable only through `T`, so it is not added to the module's types. Not for a
                    // generic struct, whose `requires` is BYN2022 (Question 225). Its members are the struct's fields.
                    let fieldEnum = newEnum(ref c, by: EnumSymbol {
                        name: $"{name}_Field",
                        nameSpan: s.value.name,
                        span: s.value.name,
                        module: module,
                        file: file,
                        declIndex: d,
                        access: accessOf(s.value.modifiers),
                        modifiers: i64(s.value.modifiers),
                        fieldsOf: sym,
                    })
                    c.structs[sym].fieldEnum = fieldEnum
                    c.modules[module].enums.append(fieldEnum)
                }
                var into = List<TypeParamId>()
                let map = declareTypeParameters(ref c, from: file, for: in s.value.typeParams, to: ref into)
                c.structs[sym].typeParams = move into
                if (map is { } m) { c.structs[sym].typeMap = t11CopyMap(in m) }
                c.wheres.append(Work { kind: .where, subject: structTypeOf(sym), args: List<Type>(), file: file, span: TextSpan { start: 0, length: 0 }, declIndex: d })
            case .errorEnumDecl(let e):
                let sym = newErrorSet(ref c, by: ErrorSetSymbol {
                    name: t11Text(in c, from: file, at: e.value.name),
                    nameSpan: e.value.name,
                    span: e.value.name,
                    module: module,
                    file: file,
                    declIndex: d,
                    access: accessOf(e.value.modifiers),
                    modifiers: i64(e.value.modifiers),
                })
                if addType(ref c, from: file, at: e.value.name, as: errorSetTypeOf(sym)) { c.modules[module].errorSets.append(sym) }
                checkType(ref c, from: file, at: e.value.name)
            case .enumDecl(let e):
                let name = t11Text(in c, from: file, at: e.value.name)
                let sym = newEnum(ref c, by: EnumSymbol {
                    name: name,
                    nameSpan: e.value.name,
                    span: e.value.name,
                    module: module,
                    file: file,
                    declIndex: d,
                    access: accessOf(e.value.modifiers),
                    modifiers: i64(e.value.modifiers),
                })
                if addType(ref c, from: file, at: e.value.name, as: enumTypeOf(sym)) { c.modules[module].enums.append(sym) }
                checkType(ref c, from: file, at: e.value.name)
                t11RejectBases(ref c, from: file, for: in e.value.bases, by: name, as: "an enum")
                c.wheres.append(Work { kind: .where, subject: enumTypeOf(sym), args: List<Type>(), file: file, span: TextSpan { start: 0, length: 0 }, declIndex: d })
            case .unionDecl(let u):
                let name = t11Text(in c, from: file, at: u.value.name)
                let sym = newUnion(ref c, by: UnionSymbol {
                    name: name,
                    nameSpan: u.value.name,
                    span: u.value.name,
                    module: module,
                    file: file,
                    declIndex: d,
                    access: accessOf(u.value.modifiers),
                    modifiers: i64(u.value.modifiers),
                })
                if addType(ref c, from: file, at: u.value.name, as: unionTypeOf(sym)) { c.modules[module].unions.append(sym) }
                checkType(ref c, from: file, at: u.value.name)
                var into = List<TypeParamId>()
                let map = declareTypeParameters(ref c, from: file, for: in u.value.typeParams, to: ref into)
                c.unions[sym].typeParams = move into
                if (map is { } m) { c.unions[sym].typeMap = t11CopyMap(in m) }
                t11RejectBases(ref c, from: file, for: in u.value.bases, by: name, as: "a union")
                c.wheres.append(Work { kind: .where, subject: unionTypeOf(sym), args: List<Type>(), file: file, span: TextSpan { start: 0, length: 0 }, declIndex: d })
            case .interfaceDecl(let i):
                let name = t11Text(in c, from: file, at: i.value.name)
                let sym = newInterface(ref c, by: InterfaceSymbol {
                    name: name,
                    nameSpan: i.value.name,
                    span: i.value.name,
                    module: module,
                    file: file,
                    declIndex: d,
                    access: accessOf(i.value.modifiers),
                    modifiers: i64(i.value.modifiers),
                })
                if findInterface(ref c, for: name) >= 0 {
                    report(ref c, for: .duplicateDeclaration, from: file, at: i.value.name, by: (name, "", "", "", ""), label: "already declared as a built-in interface")
                } else if addType(ref c, from: file, at: i.value.name, as: interfaceTypeOf(sym)) {
                    c.modules[module].interfaces.append(sym)
                }
                checkInterface(ref c, from: file, at: i.value.name)
                var into = List<TypeParamId>()
                let map = declareTypeParameters(ref c, from: file, for: in i.value.typeParams, to: ref into)
                c.interfaces[sym].typeParams = move into
                if (map is { } m) { c.interfaces[sym].typeMap = t11CopyMap(in m) }
                c.wheres.append(Work { kind: .where, subject: interfaceTypeOf(sym), args: List<Type>(), file: file, span: TextSpan { start: 0, length: 0 }, declIndex: d })
            case .extensionDecl(let x):
                let name = t11Text(in c, from: file, at: x.value.name)
                if x.value.bases.length == 0 {
                    report(ref c, for: .unsupported, from: file, at: x.value.name, by: ("`extension` declarations", "", "", "", ""))
                    continue
                }
                var sb = StrBuf()
                for b in 0..x.value.bases.length {
                    if b > 0 { sb.append(", ") }
                    sb.append(t11Text(in c, from: file, at: t8TypeSpan(in x.value.bases[b])))
                }
                let bases = $"{sb.finish()}"
                let span = TextSpan.fromBounds(x.value.span.start, until: t8TypeSpan(in x.value.bases[x.value.bases.length - 1]).end)
                report(ref c, for: .extensionConformance, from: file, at: span, by: (name, bases, "", "", ""),
                    label: "retroactive conformance", help: $"list `{bases}` on `{name}`'s declaration")
            case .typeAliasDecl(let a):
                let name = t11Text(in c, from: file, at: a.value.name)
                if a.value.distinct {
                    // J5: a nominal wrapper, a struct whose one field `value` carries the type's `requires`. The
                    // symbol's declaration is the alias (member `d`); the declare pass reads `value` from it (Q572).
                    let sym = newStruct(ref c, by: StructSymbol {
                        name: name,
                        nameSpan: a.value.name,
                        span: a.value.name,
                        module: module,
                        file: file,
                        declIndex: d,
                        access: accessOf(a.value.modifiers),
                        modifiers: i64(a.value.modifiers),
                    })
                    if addType(ref c, from: file, at: a.value.name, as: structTypeOf(sym)) {
                        c.modules[module].structs.append(sym)
                        c.distinct[sym] = 1
                    }
                    checkType(ref c, from: file, at: a.value.name)
                } else {
                    if a.value.requiresClauses.length > 0 {
                        report(ref c, for: .unsupported, from: file, at: a.value.requiresClauses[0].span, by: ("`requires` on a plain `type` alias", "", "", "", ""))
                    }
                    let sym = newAlias(ref c, by: AliasPlaceholder { name: name, nameSpan: a.value.name, span: a.value.name, file: file, declIndex: d, modifiers: i64(a.value.modifiers) })
                    if addType(ref c, from: file, at: a.value.name, as: t8AliasType(sym)) { c.aliasOrder.append(sym) }
                    checkType(ref c, from: file, at: a.value.name)
                }
            case .errorSetDecl(let s):
                let sym = newAlias(ref c, by: AliasPlaceholder { name: t11Text(in c, from: file, at: s.value.name), nameSpan: s.value.name, span: s.value.name, file: file, declIndex: d, modifiers: i64(s.value.modifiers) })
                if addType(ref c, from: file, at: s.value.name, as: t8AliasType(sym)) { c.aliasOrder.append(sym) }
                checkType(ref c, from: file, at: s.value.name)
            case .functionDecl(let f):
                let name = t11Text(in c, from: file, at: f.value.name)
                // C# `Decl = f`: the symbol keeps its `becomes`, `ref this` and `move this` scalars (Q656 (e)).
                var becomes: string? = null
                if (f.value.becomes is { } becomesAt) { becomes = t11Text(in c, from: file, at: becomesAt) }
                let sym = newFunction(ref c, by: FunctionSymbol {
                    name: name,
                    nameSpan: f.value.name,
                    span: f.value.name,
                    module: module,
                    kind: .function,
                    access: accessOf(f.value.modifiers),
                    modifiers: i64(f.value.modifiers),
                    file: file,
                    declIndex: d,
                    becomes: becomes,
                    refThis: f.value.refThis,
                    moveThis: f.value.moveThis,
                })
                checkValue(ref c, from: file, at: f.value.name)
                var into = List<TypeParamId>()
                let map = declareTypeParameters(ref c, from: file, for: in f.value.typeParams, to: ref into)
                c.functions[sym].typeParams = move into
                if (map is { } m) { c.functions[sym].typeMap = t11CopyMap(in m) }
                c.wheres.append(Work { kind: .where, instance: sym, args: List<Type>(), file: file, span: TextSpan { start: 0, length: 0 }, declIndex: d })
                if name == "main" && module == c.entryModule {
                    if c.modules[module].main >= 0 {
                        report(ref c, for: .duplicateMain, from: file, at: f.value.name, by: ("", "", "", "", ""))
                        continue
                    }
                    c.modules[module].main = sym
                }
                addFunction(ref c, from: file, at: f.value.name, for: sym)
            case .globalStatement(let g):
                var isConst = false
                switch g.value.statement {
                    case .localDecl(let k):
                        if k.value.kind == .constKeyword {
                            isConst = true
                            let name = t11Text(in c, from: file, at: k.value.name)
                            let sym = newConst(ref c, by: ConstSymbol { name: name, nameSpan: k.value.name, span: k.value.name, module: module, file: file, declIndex: d })
                            if checkUnique(ref c, from: file, at: k.value.name) {
                                c.modules[module].constants[name] = sym
                                c.modules[module].allConstants.append(sym)
                            }
                            checkValue(ref c, from: file, at: k.value.name)
                        }
                    default:
                        isConst = false
                }
                if !isConst {
                    if module != c.entryModule || c.files[file].isTestFile {
                        report(ref c, for: .statementOutsideEntry, from: file, at: g.value.span, by: ("", "", "", "", ""))
                    } else {
                        mainStatements.append(SyntaxRef { file: file, declIndex: d })
                    }
                }
            case .testDecl(let t):
                if !c.includeTests { continue }
                if t.value.params.length == 0 {
                    t11DeclareTest(ref c, from: file, at: d, by: t.value.span, for: t.value.title, as: -1, to: -1)
                } else if c.testCases.contains(declKey(file, at: d)) {
                    let attribute = c.testCases[declKey(file, at: d)].attribute
                    for arg in copyIds(in c.testCases[declKey(file, at: d)].args) {
                        let title = t11CaseTitle(in c, from: file, for: in t.value, by: in t.value.attributes[attribute].args[arg].value)
                        t11DeclareTest(ref c, from: file, at: d, by: t.value.span, for: title, as: attribute, to: arg)
                    }
                }
            default:
                continue
        }
    }
    if mainStatements.length > 0 {
        let first = t11DeclSpan(in c.files[file].unit.members[mainStatements[0].declIndex])
        let main = c.modules[module].main
        if main >= 0 && c.functions[main].kind == .function {
            let line = lineIndex(c.files[c.functions[main].file].text.span, at: c.functions[main].span.start) + 1
            report(ref c, for: .duplicateMain, from: file, at: first, by: ("", "", "", "", ""), label: $"`main` is also declared on line {line}")
        } else if main < 0 {
            let sym = newFunction(ref c, by: FunctionSymbol { name: "main", span: first, module: module, kind: .main, file: file, declIndex: mainStatements[0].declIndex, returnType: prim(.void) })
            c.modules[module].main = sym
            c.modules[module].allFunctions.append(sym)
            c.mainStatementsFn = sym
            c.mainStatements = move mainStatements
        } else {
            report(ref c, for: .statementOutsideEntry, from: file, at: first, by: ("", "", "", "", ""), help: "keep top-level statements in one file of the entry module")
        }
    }
}

/// A copy of a type map.
Map<string, Type> t11CopyMap(in Map<string, Type> m) {
    var copy: Map<string, Type> = []
    for (k, v) in m { copy[k] = v }
    return copy
}

/// The span of a top-level statement (the C# `GlobalStatement.Span`).
TextSpan t11DeclSpan(in parser.Decl d) {
    switch d {
        case .globalStatement(let g): return g.value.span
        default: panic("main statements are global statements")
    }
}

// ── Compilation.cs:562 AssociatedType ───────────────────────────────────────────

/// `T.Item` in a template: one type parameter per (T, name), so every mention is the same type.
TypeParamId associatedType(ref Ctx c, for TypeParamId owner, by string name) {
    let key = $"{owner} {name}"
    if c.associatedTypes.contains(key) { return c.associatedTypes[key] }
    let t = newTypeParam(ref c, by: TypeParam { name: $"{c.typeParams[owner].name}.{name}" })
    c.associatedTypes[key] = t
    return t
}

// ── Compilation.cs:570 DeclareTypeParameters ────────────────────────────────────

/// Declares the `<A, B>` of a generic declaration; the map is null when there are none.
Map<string, Type>? declareTypeParameters(ref Ctx c, from FileId file, for in List<TextSpan> names, to ref List<TypeParamId> into) {
    if names.length == 0 { return null }
    var map: Map<string, Type> = []
    var seen: Map<string, Location> = []
    for name in names {
        checkType(ref c, from: file, at: name)
        let text = t11Text(in c, from: file, at: name)
        if seen.contains(text) {
            reportDuplicate(ref c, from: file, at: name, as: seen[text])
            continue
        }
        seen[text] = loc(file, at: name)
        let parameter = newTypeParam(ref c, by: TypeParam { name: text })
        into.append(parameter)
        map[text] = typeParamTypeOf(parameter)
    }
    return map
}

// ── Compilation.cs:592 DeclareWhere ─────────────────────────────────────────────

/// Resolves the bounds of `where T : IA, IB` into the constraints of `parameters`.
void declareWhere(ref Ctx c, from FileId file, for in List<parser.WhereClause> clauses, to in List<TypeParamId> parameters, by in Map<string, Type>? typeMap, as string owner) {
    if clauses.length == 0 { return }
    var args: Map<string, Type> = []
    if (typeMap is { } m) { args = t11CopyMap(in m) }
    let types = TypeResolver { file: file, container: -1, typeArgs: move args }
    for w in clauses {
        let text = t11Text(in c, from: file, at: w.param)
        var parameter: TypeParamId = -1
        for p in parameters {
            if c.typeParams[p].name == text {
                parameter = p
                break
            }
        }
        if parameter < 0 {
            var help = $"remove the `where` clause; `{owner}` has no type parameters"
            if parameters.length > 0 {
                var sb = StrBuf()
                sb.append("name one of ")
                for i in 0..parameters.length {
                    if i > 0 { sb.append(", ") }
                    sb.append($"`{c.typeParams[parameters[i]].name}`")
                }
                help = $"{sb.finish()}"
            }
            report(ref c, for: .whereUnknownParameter, from: file, at: w.param, by: (text, "", "", "", ""), label: $"not a type parameter of `{owner}`", help: help)
            continue
        }
        var constraints = copyIds(in c.typeParams[parameter].constraints)
        // The parser builds every bound with `parseNamedType` (decls.byn:677), the C# `NamedType[] Bounds`.
        for bound in w.bounds {
            switch bound {
                case .namedType(let n):
                    let i = resolveInterface(ref c, through: in types, from: file, for: in n.value)
                    if i >= 0 { constraints.append(i) }
                default:
                    panic("a `where` bound is a named type")
            }
        }
        c.typeParams[parameter].constraints = move constraints
    }
}

// ── Compilation.cs:614 ResolveInterface ─────────────────────────────────────────

/// A base or a `where` bound: an interface, or BYN2804.
InterfaceId resolveInterface(ref Ctx c, through in TypeResolver types, from FileId file, for in parser.NamedType syntax) {
    let t = resolveBound(ref c, through: in types, for: in syntax)
    if kindOf(t) == .interfaceType { return typeIndex(t) }
    if !isError(t) {
        let k = kindOf(t)
        var kind = "a type"
        if k == .structType {
            kind = "a struct"
        } else if k == .unionType {
            kind = "a union"
        } else if k == .enumType {
            kind = "an enum"
        } else if k == .errorSet {
            kind = "an error enum"
        } else if k == .typeParam {
            kind = "a type parameter"
        }
        report(ref c, for: .notAnInterface, from: file, at: syntax.span, by: (typeDisplay(ref c, by: t), "", "", "", ""), label: kind, help: "list an `interface` here")
    }
    return -1
}

// ── Compilation.cs:631 RejectBases ──────────────────────────────────────────────

/// Interfaces listed on a union or enum (BYN2815): only structs conform yet.
void t11RejectBases(ref Ctx c, from FileId file, for in List<parser.TypeSyntax> bases, by string name, as string kind) {
    if bases.length > 0 {
        let span = TextSpan.fromBounds(t8TypeSpan(in bases[0]).start, until: t8TypeSpan(in bases[bases.length - 1]).end)
        report(ref c, for: .nonStructConformance, from: file, at: span, by: (name, kind, "", "", ""), label: "listed here", help: "wrap it in a struct that conforms")
    }
}

// ── Compilation.cs:638 AddType ──────────────────────────────────────────────────

bool addType(ref Ctx c, from FileId file, at TextSpan name, as Type type) {
    if !checkUnique(ref c, from: file, at: name) { return false }
    c.modules[c.files[file].module].types[t11Text(in c, from: file, at: name)] = type
    return true
}

// ── Compilation.cs:645 AddFunction ──────────────────────────────────────────────

void addFunction(ref Ctx c, from FileId file, at TextSpan name, for FuncId f) {
    // Another function of the name is an overload, kept if its signature cannot overlap (CheckOverloads, J65).
    let module = c.files[file].module
    let text = t11Text(in c, from: file, at: name)
    if c.modules[module].functions.contains(text) {
        var overloads = copyIds(in c.modules[module].functions[text])
        overloads.append(f)
        c.modules[module].functions[text] = move overloads
    } else if checkUnique(ref c, from: file, at: name) {
        var overloads = List<FuncId>()
        overloads.append(f)
        c.modules[module].functions[text] = move overloads
    } else {
        return
    }
    c.modules[module].allFunctions.append(f)
}

// ── Compilation.cs:1549 AfterMembersDeclared ────────────────────────────────────

void afterMembersDeclared(ref Ctx c, for in Work work) {
    var w = t11CopyWork(in work)
    if c.hasInstantiationSite {
        w.atSite = true
        w.siteFile = c.instantiationSiteFile
        w.siteSpan = c.instantiationSiteSpan
    }
    c.pendingKeys.append(move w)
}

// ── Compilation.cs:1922 ReportInto ──────────────────────────────────────────────

/// Sends reports to bag `bag` (-1: the compilation's own list) until called again. The C# returns the previous
/// target; callers read `c.sink` before calling instead (Q708).
void reportInto(ref Ctx c, to i64 bag) {
    c.sink = bag
}

// ── The closures of `List<Action>` (Q570) ───────────────────────────────────────

/// Runs one deferred item: the body of the C# closure it stands for.
void runWork(ref Ctx c, for in Work work) {
    switch work.kind {
        case .where:
            t11RunWhere(ref c, for: in work)
        case .keyCheck:
            // TypeResolver.cs:191 `AfterMembersDeclared(() => CheckKey())`.
            let _ = t8CheckKey(ref c, for: work.subject, from: work.file, at: work.span)
        case .constraint:
            t13RunConstraint(ref c, for: in work)
        case .interfaceMembers:
            // Compilation.cs:204 and :1660 `DeclareInterfaceMembers(instance)`; the caller wraps it in `Instantiating`.
            // Its only effect is T38's `declareInterfaceMembers`, a stub (Q720).
            declareInterfaceMembers(ref c, for: typeIndex(work.subject))
        case .members:
            panic("internal error: C# runs DeclareMembers inside Instantiating and never queues it (Compilation.cs:1630)")
        case .unionVariants:
            panic("internal error: C# runs DeclareUnionVariants inside Instantiating and never queues it (Compilation.cs:1648)")
        case .conform:
            panic("internal error: C# runs Conform inside Instantiating and never queues it (Compilation.cs:1631)")
        case .fieldDefault:
            // Compilation.cs:1634 `FieldDefault(instance, f, site, span)`. T13 drains its `.fieldDefault` items with its
            // own switch (generics.byn:180), so no list `runWork` drains holds this kind yet (Q720).
            let _ = fieldDefault(ref c, for: typeIndex(work.subject), by: work.memberIndex, from: work.file, at: work.span)
        case .bindFunction:
            // Compilation.cs:1637 `BindFunction(fn)`. T13 drains its `.bindFunction` items with its own switch
            // (generics.byn:180), so no list `runWork` drains holds this kind yet (Q720).
            bindFunction(ref c, for: work.instance)
    }
}

/// The `_wheres` closures of `DeclareFile` (Compilation.cs:399, :415, :425, :437, :488): `DeclareWhere` over
/// the declaration's `where` clauses, its type parameters and its type map (null without type parameters).
void t11RunWhere(ref Ctx c, for in Work work) {
    let file = work.file
    switch c.files[file].unit.members[work.declIndex] {
        case .structDecl(let s):
            let sym = typeIndex(work.subject)
            let parameters = copyIds(in c.structs[sym].typeParams)
            let owner = $"{c.structs[sym].name}"
            if parameters.length == 0 {
                declareWhere(ref c, from: file, for: in s.value.where, to: in parameters, by: null, as: owner)
            } else {
                declareWhere(ref c, from: file, for: in s.value.where, to: in parameters, by: t11CopyMap(in c.structs[sym].typeMap), as: owner)
            }
        case .enumDecl(let e):
            let owner = $"{c.enums[typeIndex(work.subject)].name}"
            declareWhere(ref c, from: file, for: in e.value.where, to: in List<TypeParamId>(), by: null, as: owner)
        case .unionDecl(let u):
            let sym = typeIndex(work.subject)
            let parameters = copyIds(in c.unions[sym].typeParams)
            let owner = $"{c.unions[sym].name}"
            if parameters.length == 0 {
                declareWhere(ref c, from: file, for: in u.value.where, to: in parameters, by: null, as: owner)
            } else {
                declareWhere(ref c, from: file, for: in u.value.where, to: in parameters, by: t11CopyMap(in c.unions[sym].typeMap), as: owner)
            }
        case .interfaceDecl(let i):
            let sym = typeIndex(work.subject)
            let parameters = copyIds(in c.interfaces[sym].typeParams)
            let owner = $"{c.interfaces[sym].name}"
            if parameters.length == 0 {
                declareWhere(ref c, from: file, for: in i.value.where, to: in parameters, by: null, as: owner)
            } else {
                declareWhere(ref c, from: file, for: in i.value.where, to: in parameters, by: t11CopyMap(in c.interfaces[sym].typeMap), as: owner)
            }
        case .functionDecl(let f):
            let sym = work.instance
            let parameters = copyIds(in c.functions[sym].typeParams)
            let owner = $"{c.functions[sym].name}"
            if parameters.length == 0 {
                declareWhere(ref c, from: file, for: in f.value.where, to: in parameters, by: null, as: owner)
            } else {
                declareWhere(ref c, from: file, for: in f.value.where, to: in parameters, by: t11CopyMap(in c.functions[sym].typeMap), as: owner)
            }
        default:
            panic("a `where` item names a generic declaration")
    }
}

// ── Helpers: text, paths and files ──────────────────────────────────────────────

/// The source text at `span` of `f` (the C# `Name.Text` / `SourceText.GetText`).
string t11Text(in Ctx c, from FileId f, at TextSpan span) => $"{getText(c.files[f].text.span, at: span)}"


/// The C# `File.ReadAllBytes`; an unreadable file is an exception out of the C# compiler, a panic here (Q571).
List<u8> t11ReadAllBytes(string path) {
    let bytes = Io.readFile(path) catch panic($"cannot read `{path}`")
    return bytes
}

/// The C# `Directory.Exists`: whether `path` lists as a directory.
bool t11DirectoryExists(string path) {
    let _ = Io.listDir(path) catch return false
    return true
}

/// The names in directory `dir`; nothing when it cannot be listed.
List<string> t11ListFiles(string dir) {
    let names = Io.listDir(dir) catch return List<string>()
    return names
}

/// The C# `Path.GetDirectoryName(path)!`.
string t11DirectoryName(string path) {
    return Path.directoryName(path) ?? panic("t11DirectoryName: no directory name")
}

/// The C# `Path.GetFullPath`.
string t11FullPath(string path) {
    return Path.fullPath(path)
}

/// The C# `Path.Combine(a, b)`.
string t11Combine(string a, by string b) {
    return Path.combine(a, b)
}

/// The C# `Path.GetRelativePath(root, path)`.
string t11RelativePath(string root, to string path) {
    return Path.relative(root, to: path)
}

/// Sorts `xs` in ordinal (byte) order, the C# `Order(StringComparer.Ordinal)`.
void t11SortOrdinal(ref List<string> xs) {
    for i in 1..xs.length {
        var j = i
        while j > 0 && pathLess(xs[j], by: xs[j - 1]) {
            let t = xs[j]
            xs[j] = xs[j - 1]
            xs[j - 1] = t
            j -= 1
        }
    }
}
