    c.lexiconCollectives = [
        "span", "list", "map", "set", "array", "buffer", "queue", "stack", "batch", "history", "inventory", "catalog", "data",
        "metadata",
    ]
    c.lexiconIrregularPlurals = ["people", "children", "criteria", "indices", "matrices", "data"]
    c.lexiconIrregularSingulars = ["person", "child", "criterion", "index", "matrix", "datum"]
