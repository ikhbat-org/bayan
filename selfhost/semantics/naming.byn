/// Particles (spec §10), the prefixes of derived names, and function words a name may join with.
bool isParticleWord(string w) => w switch {
    "from" or "to" or "until" or "through" or "at" or "by" or "for" or "as" => true,
    _ => false,
}

bool isFunctionWord(string w) => w switch {
    "is" or "has" or "can" or "try" or "into" or "with" or "and" or "or" or "of" or "in" or "on" or "off" or "out" or
    "up" or "down" or "over" or "per" or "no" or "not" or "each" or "every" or "some" or "none" or "ok" or "if" or
    "else" or "then" or "also" or "only" or "again" or "once" or "self" or "twice" or "before" or "after" => true,
    _ => false,
}

/// Math vocabulary: a naming exemption, not a synonym (J70). There is no `log` member.
bool isMathWord(string w) => w switch {
    "abs" or "sign" or "sqrt" or "cbrt" or "pow" or "exp" or "ln" or "log2" or "log10" or "sin" or "cos" or "tan" or
    "asin" or "acos" or "atan2" or "radians" or "degrees" => true,
    _ => false,
}

// ── Naming.cs ───────────────────────────────────────────────────────────────────

void checkType(ref Ctx c, from FileId f, at TextSpan name) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    if text == "_" { return }
    let fixedName = toPascal(text)
    if fixedName != text {
        report(ref c, for: .typeCasing, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
            help: $"rename it `{fixedName}`", hasFix: true, fixSpan: name, fixReplacement: fixedName)
    }
}

/// An interface name is `I`, then an uppercase letter, then PascalCase (`IShape`).
void checkInterface(ref Ctx c, from FileId f, at TextSpan name) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    if text.length > 1 && text.bytes[0] == 0x49 && isUpperAscii(text.bytes[1]) {
        checkType(ref c, from: f, at: name)
        return
    }
    let fixedName = $"I{toPascal(text)}"
    report(ref c, for: .interfaceName, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""), label: "an interface name",
        help: $"rename it to `{fixedName}`", hasFix: true, fixSpan: name, fixReplacement: fixedName)
}

void checkValue(ref Ctx c, from FileId f, at TextSpan name) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    if text == "_" { return }
    let fixedName = toCamel(text)
    if fixedName != text {
        let help = isUpperAscii(text.bytes[0]) && fixedName.length > 0 ?
            $"rename it `{fixedName}`; only types are PascalCase" :
            $"rename it `{fixedName}`"
        report(ref c, for: .valueCasing, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
            help: help, hasFix: true, fixSpan: name, fixReplacement: fixedName)
    }
}

/// Grammar rules on the members of `s` (spec §5.2, `docs/bayan-grammar.md`): BYN50xx are pattern contracts
/// on all code, BYN51xx word-class lints on the public API only (J84). Math vocabulary (J70) is exempt from
/// BYN5001 and BYN5014; typestate states are not members and are not checked.
void checkMembers(ref Ctx c, for StructId s) {
    let grammar = grammarOf(ref c)
    checkMembersWith(ref c, for: s, by: grammar)
}

/// `checkMembers` with the project dictionary already read.
void checkMembersWith(ref Ctx c, for StructId s, by in Grammar grammar) {
    buildLexicon(ref c)
    let f = c.structs[s].file
    let structPublic = c.structs[s].access == .publicKeyword
    for i in 0..c.structs[s].methods.length {
        let fn = c.structs[s].methods[i]
        let name = c.functions[fn].nameSpan
        let text = $"{c.functions[fn].name}"
        let isStatic = c.functions[fn].isStatic
        let isMutating = c.functions[fn].isMutating
        let ret = c.functions[fn].returnType
        let noArgs = !isStatic && c.functions[fn].parameters.length == 0
        let isPublic = structPublic && c.functions[fn].access == .publicKeyword
        if isMutating && !isBool(ret) { checkParticiple(ref c, by: grammar, from: f, at: name, for: text) }
        checkParticleName(ref c, for: s, from: f, at: name, by: text, isStatic: isStatic)
        checkWords(ref c, by: grammar, from: f, at: name, for: text, as: isMutating ? "verbs" : isBool(ret) ? "adjectives" : "nouns")
        if noArgs && isMutating && isStateName(text) {
            report(ref c, for: .stateMemberMutates, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""), label: "declared `ref this`",
                help: "remove `ref this` so it only reads, or name the action with a verb")
        }
        if text.length > 3 && text.startsWith("try") && isUpperAscii(text.bytes[3]) {
            let target = $"{lowerAscii(text[3..4])}{text[4..text.length]}"
            var failing: FuncId = -1
            for m in c.structs[s].methods {
                if c.functions[m].hasFails && c.functions[m].name == target {
                    failing = m
                    break
                }
            }
            if failing >= 0 && kindOf(ret) != .optional && !isBool(ret) && !isError(ret) {
                let failingType = typeDisplay(ref c, by: c.functions[failing].returnType)
                let failingName = $"{c.functions[failing].name}"
                let shown = typeDisplay(ref c, by: ret)
                report(ref c, for: .tryWrongReturn, from: f, at: returnTypeSpan(ref c, for: fn),
                    by: (a0: text[3..text.length], a1: failingType, a2: failingName, a3: "", a4: ""),
                    label: $"returns `{shown}`",
                    help: $"change it to return `{failingType}?` or `bool`, or remove `{text}` and call `try {failingName}()`")
            }
        }
        if isPublic && isMutating {
            let words = wordSpans(text)
            if words.length > 0 && isThingNoun(lowerAscii(words[0].text)) {
                report(ref c, for: .nounOnMutator, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
                    help: "rename it with the verb for what it does to `this`")
            }
        }
        if isPublic && noArgs && !isMutating && isBool(ret) { checkBoolState(ref c, from: f, at: name, for: text) }
    }
    for i in 0..c.structs[s].properties.length {
        let p = c.structs[s].properties[i]
        let name = c.properties[p].nameSpan
        let text = $"{c.properties[p].name}"
        checkParticleName(ref c, for: s, from: f, at: name, by: text, isStatic: false)
        checkWords(ref c, by: grammar, from: f, at: name, for: text, as: isBool(c.properties[p].type) ? "adjectives" : "nouns")
        if isBool(c.properties[p].type) && structPublic && c.properties[p].access == .publicKeyword {
            checkBoolState(ref c, from: f, at: name, for: text)
        }
    }
    unless structPublic { return }
    for field in copyIds(in c.structs[s].fields) {
        if c.fields[field].access != .publicKeyword || t7MemberRenamed(ref c, from: f, at: c.fields[field].declIndex, by: c.fields[field].memberIndex) { continue }
        let name = c.fields[field].nameSpan
        let text = $"{c.fields[field].name}"
        let type = c.fields[field].type
        unless checkCount(ref c, by: grammar, from: f, at: name, for: text, as: type) { checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: type) }
    }
    for p in copyIds(in c.structs[s].properties) {
        if c.properties[p].access != .publicKeyword || t7MemberRenamed(ref c, from: f, at: c.properties[p].declIndex, by: c.properties[p].memberIndex) { continue }
        let name = c.properties[p].nameSpan
        let text = $"{c.properties[p].name}"
        let type = c.properties[p].type
        unless checkCount(ref c, by: grammar, from: f, at: name, for: text, as: type) { checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: type) }
    }
    for fn in copyIds(in c.structs[s].methods) {
        if c.functions[fn].access != .publicKeyword { continue }
        t7CheckParameters(ref c, by: grammar, from: f, for: fn)
    }
    var publicMethods = List<FuncId>()
    for fn in copyIds(in c.structs[s].methods) {
        if c.functions[fn].access == .publicKeyword { publicMethods.append(fn) }
    }
    var others = List<string>()
    for field in copyIds(in c.structs[s].fields) {
        if c.fields[field].access == .publicKeyword { others.append($"{c.fields[field].name}") }
    }
    for p in copyIds(in c.structs[s].properties) {
        if c.properties[p].access == .publicKeyword { others.append($"{c.properties[p].name}") }
    }
    checkDoer(ref c, by: grammar, from: f, for: c.structs[s].module, at: c.structs[s].declIndex, as: c.structs[s].nameSpan,
        through: move publicMethods, until: move others)
}

/// Ports `Naming.CheckSignatures`: BYN5104 and BYN5105 on the rest of a module's public API, once top-level signatures
/// are declared: the parameters of public top-level functions, a public interface's getters and its methods' parameters,
/// and the payload fields of a public union or error set (the struct members are `checkMembers`'s).
void checkSignatures(ref Ctx c, for ModId module) {
    let grammar = grammarOf(ref c)
    buildLexicon(ref c)
    for fn in copyIds(in c.modules[module].allFunctions) {
        // coverage-exempt: Q1200 through `|| functionIsInstance`
        if c.functions[fn].kind != .function || c.functions[fn].owner >= 0 || c.functions[fn].iface >= 0
            || functionIsInstance(ref c, by: fn) || c.functions[fn].access != .publicKeyword { continue }
        t7CheckParameters(ref c, by: grammar, from: c.functions[fn].file, for: fn)
    }
    for i in copyIds(in c.modules[module].interfaces) {
        if c.interfaces[i].access != .publicKeyword { continue }
        let source = c.interfaces[i].file
        for member in t7InterfaceGetters(ref c, for: i) {
            if member.renamed { continue }
            var getter: FuncId = -1
            for g in c.interfaces[i].properties {
                if c.functions[g].nameSpan == member.name {
                    getter = g
                    break
                }
            }
            // coverage-exempt: Q1200
            if getter < 0 { continue }
            let text = $"{getText(c.files[source].text.span, at: member.name)}"
            let type = c.functions[getter].returnType
            unless checkCount(ref c, by: grammar, from: source, at: member.name, for: text, as: type) { checkNumber(ref c, by: grammar, from: source, at: member.name, for: text, as: type) }
        }
        for fn in copyIds(in c.interfaces[i].methods) { t7CheckParameters(ref c, by: grammar, from: source, for: fn) }
        var getters = List<string>()
        for g in copyIds(in c.interfaces[i].properties) { getters.append($"{c.functions[g].name}") }
        checkDoer(ref c, by: grammar, from: source, for: c.interfaces[i].module, at: c.interfaces[i].declIndex, as: c.interfaces[i].nameSpan,
            through: copyIds(in c.interfaces[i].methods), until: move getters)
    }
    for u in copyIds(in c.modules[module].unions) {
        if c.unions[u].access != .publicKeyword { continue }
        let source = c.unions[u].file
        for v in t7Payloads(ref c, from: source, at: c.unions[u].declIndex) {
            let declared = findUnionVariant(ref c, by: u, for: v.variant)
            // coverage-exempt: Q1200
            if declared >= 0 { checkPayload(ref c, by: grammar, from: source, at: v.fields, for: copyIds(in c.unionVariants[declared].fields)) }
        }
    }
    for set in copyIds(in c.modules[module].errorSets) {
        if c.errorSets[set].access != .publicKeyword { continue }
        let source = c.errorSets[set].file
        for v in t7Payloads(ref c, from: source, at: c.errorSets[set].declIndex) {
            let declared = findErrorVariant(ref c, by: set, for: v.variant)
            // coverage-exempt: Q1200
            if declared >= 0 { checkPayload(ref c, by: grammar, from: source, at: v.fields, for: copyIds(in c.errorVariants[declared].fields)) }
        }
    }
}

/// The `foreach (var p in fn.Parameters) if (p.Syntax is { } syntax) CheckNumber(…, syntax.Name, p.Type)` loop of
/// `Naming.CheckMembers` and `Naming.CheckSignatures`: the parameters with syntax are read from the tree in
/// `fn.parameters` order, as `checkParticles` reads them (Q552), and reported in `f`.
void t7CheckParameters(ref Ctx c, by Grammar grammar, from FileId f, for FuncId fn) {
    let facts = paramFacts(ref c, for: fn)
    let params = copyIds(in c.functions[fn].parameters)
    for k in 0..params.length {
        // coverage-exempt: Q1200
        if k >= facts.length { break }
        let name = facts[k].name
        let text = $"{getText(c.files[c.functions[fn].file].text.span, at: name)}"
        checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: c.locals[params[k]].type)
    }
}

/// One `GetterDecl` or `PropertyDecl` of an interface's `Decl.Members`: its name and whether `IsRenamed` holds.
struct T7Getter {
    TextSpan name
    bool renamed = false
}

/// The getter and property members of interface `i`'s declaration, in member order. Ports the `foreach (var member in i.Decl.Members)` `GetterDecl`/`PropertyDecl` switch of `Naming.CheckSignatures`.
List<T7Getter> t7InterfaceGetters(ref Ctx c, for InterfaceId i) {
    var found = List<T7Getter>()
    let f = c.interfaces[i].file
    switch c.files[f].unit.members[c.interfaces[i].declIndex] {
        case .interfaceDecl(let n):
            for m in n.value.members {
                switch m {
                    case .getterDecl(let g):
                        found.append(T7Getter { name: g.value.name, renamed: isRenamed(g.value.attributes, from: c.files[f].text.span) })
                    case .propertyDecl(let p):
                        found.append(T7Getter { name: p.value.name, renamed: isRenamed(p.value.attributes, from: c.files[f].text.span) })
                    default:
                        continue
                }
            }
        default:
            // coverage-exempt: Q1200
            return found
    }
    return found
}

/// One variant of a union or error set declaration: its name and its payload fields' name spans.
struct T7Payload {
    string variant
    List<TextSpan> fields = List<TextSpan>()
}

/// The variants of the `UnionDecl` or `ErrorEnumDecl` at `declIndex` of file `f`, in declaration order. Ports the `UnionDecl`/`ErrorEnumDecl` variant walk of `Naming.CheckSignatures`.
List<T7Payload> t7Payloads(ref Ctx c, from FileId f, at i64 declIndex) {
    var found = List<T7Payload>()
    switch c.files[f].unit.members[declIndex] {
        case .unionDecl(let n):
            for v in n.value.variants {
                var fields = List<TextSpan>()
                for field in v.fields { fields.append(field.name) }
                found.append(T7Payload { variant: $"{getText(c.files[f].text.span, at: v.name)}", fields: move fields })
            }
        case .errorEnumDecl(let n):
            for v in n.value.variants {
                var fields = List<TextSpan>()
                for field in v.fields { fields.append(field.name) }
                found.append(T7Payload { variant: $"{getText(c.files[f].text.span, at: v.name)}", fields: move fields })
            }
        default:
            // coverage-exempt: Q1200
            return found
    }
    return found
}

/// Ports `Naming.CheckPayload`: each payload field whose declared parameter has its name's span is checked,
/// BYN5105 first, then BYN5104.
void checkPayload(ref Ctx c, by Grammar grammar, from FileId f, at List<TextSpan> fields, for List<LocalId> declared) {
    for name in fields {
        var field: LocalId = -1
        for p in declared {
            if c.locals[p].nameSpan == name {
                field = p
                break
            }
        }
        // coverage-exempt: Q1200
        if field < 0 { continue }
        let text = $"{getText(c.files[f].text.span, at: name)}"
        let type = c.locals[field].type
        unless checkCount(ref c, by: grammar, from: f, at: name, for: text, as: type) { checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: type) }
    }
}

/// Ports `Naming.CheckDoer`: BYN5106 and BYN5107 on a public struct or interface named for a doer or a tool by its last
/// word (revision 0021 Part 4): a built-in doer (`doerVerb`), `codec` (`encode` or `decode`), or a project verb's regular
/// doer noun (`upsert` → `upserter`, `scan` → `scanner`). BYN5106: a public member, static or instance, is named its verb
/// or a derived form (`tryX`, `xInto`, `xOp`). BYN5107: a tool (`isTool`) has no public `ref this` member. Other "-er"
/// words (`Carrier`, `User`), function-type aliases and stored function fields are not types named for a doer here and
/// are not checked, nor is the standard library. `declIndex` is the declaration `IsRenamed` reads; every method in
/// `methods` has a declaration (`m.Decl is not null` holds: struct and interface methods are declared from a `FunctionDecl`).
void checkDoer(ref Ctx c, by Grammar grammar, from FileId f, for ModId module, at i64 declIndex, as TextSpan name, through List<FuncId> methods, until List<string> others) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    // The standard library is not checked (Q1191): `std.json`'s `JsonReader` reads with `next`.
    if c.modules[module].directory.startsWith("<std>/") || t8DeclRenamed(ref c, from: f, at: declIndex) || !isAllAscii(text) { return }
    let words = wordSpans(text)
    if words.length == 0 { return }
    let noun = lowerAscii(words[words.length - 1].text)
    var verbs = List<string>()
    if noun == "codec" {
        verbs.append("encode")
        verbs.append("decode")
    } else if (doerVerb(noun) is { } verb) {
        verbs.append(verb)
    } else {
        var matches = List<string>()
        for v in grammar.verbs {
            if listContainsString(doerNouns(v), by: noun) { matches.append(v) }
        }
        t11SortOrdinal(ref matches)
        if matches.length > 0 { verbs.append(matches[0]) }
    }
    if verbs.length == 0 { return }
    var acted = false
    for m in methods {
        for v in verbs {
            if actsAs(c.functions[m].name, for: v) { acted = true }
        }
    }
    for m in others {
        for v in verbs {
            if actsAs(m, for: v) { acted = true }
        }
    }
    unless acted {
        var named = StrBuf()
        for k in 0..verbs.length {
            if k > 0 { named.append(" or ") }
            named.append($"`{verbs[k]}`")
        }
        report(ref c, for: .doerWithoutVerb, from: f, at: name, by: (a0: text, a1: verbs[0], a2: "", a3: "", a4: ""),
            help: $"add a member named {named.finish()}, or rename the type for what it is")
    }
    unless isTool(noun) { return }
    for m in methods {
        if c.functions[m].isMutating {
            report(ref c, for: .instrumentChangesThis, from: f, at: c.functions[m].nameSpan, by: (a0: text, a1: $"{c.functions[m].name}", a2: "", a3: "", a4: ""),
                help: "remove `ref this` and keep fixed settings in fields, or rename the type as a doer if it is fed data step by step")
        }
    }
}

/// The local `Acts` of `Naming.CheckDoer` for one verb `v`: `m` is `v`, `tryV`, `vInto` or `vOp`.
bool actsAs(string m, for string v) =>
    m == v || m == $"try{upperAscii(v[0..1])}{v[1..v.length]}" || m == $"{v}Into" || m == $"{v}Op"

/// `IsRenamed(decl)` for `CheckDoer`: the struct or interface declaration at `declIndex` of file `f`. A `type distinct`'s
/// struct is declared from its alias here; its C# `StructDecl` is built without attributes, so it is not renamed.
bool t8DeclRenamed(ref Ctx c, from FileId f, at i64 declIndex) {
    switch c.files[f].unit.members[declIndex] {
        case .structDecl(let n):
            return isRenamed(n.value.attributes, from: c.files[f].text.span)
        case .interfaceDecl(let n):
            return isRenamed(n.value.attributes, from: c.files[f].text.span)
        default:
            return false
    }
}

/// Ports `Naming.Doers`: the built-in doer and tool nouns and their verbs (revision 0021 Part 4); `codec` is `checkDoer`'s.
string? doerVerb(string noun) => noun switch {
    "parser" => "parse",
    "builder" => "build",
    "reader" => "read",
    "writer" => "write",
    "recorder" => "record",
    "encoder" => "encode",
    "decoder" => "decode",
    "scanner" => "scan",
    "loader" => "load",
    "scheduler" => "schedule",
    "renderer" => "render",
    "formatter" => "format",
    "handler" => "handle",
    "hasher" => "hash",
    "comparer" => "compare",
    _ => null,
}

/// Ports `Naming.Tools`: the tool nouns of BYN5107: a tool keeps fixed settings and does not change `this`.
bool isTool(string noun) => noun switch {
    "hasher" or "comparer" or "codec" => true,
    _ => false,
}

/// Ports `Naming.DoerNouns`: a verb's doer noun by regular spelling: `-er`, `-r` after `e`, `-ier` after a consonant and
/// `y`, and a doubled final consonant (`scanner`).
List<string> doerNouns(string verb) {
    var nouns = List<string>()
    let n = verb.length
    if n < 2 { return nouns }
    let last = verb.bytes[n - 1]
    if last == 0x65 {
        nouns.append($"{verb}r")
        return nouns
    }
    if last == 0x79 && !isVowel(verb.bytes[n - 2]) {
        nouns.append($"{verb[0..n - 1]}ier")
        return nouns
    }
    nouns.append($"{verb}er")
    if !isVowel(last) && last != 0x77 && last != 0x78 && last != 0x79 && isVowel(verb.bytes[n - 2]) { nouns.append($"{verb}{verb[n - 1..n]}er") }
    return nouns
}

/// Ports `Naming.IsRenamed`: a name under a rename attribute (`@json(name: …)`, `@column(…)`) is forced from outside
/// and exempt from BYN5104 and BYN5105 (grammar guide §1). `text` is the source the attribute names are read from.
bool isRenamed(List<parser.AttributeSyntax> attributes, from ReadOnlySpan<u8> text) {
    for a in attributes {
        let name = getText(text, at: a.name)
        if name == "json" || name == "column" { return true }
    }
    return false
}

/// `IsRenamed(f.Decl)` for a struct field or property: the `FieldDecl` or `PropertyDecl` at `memberIndex` of the
/// struct declaration at `declIndex`. A `type distinct`'s `value` field has no member (`memberIndex` -1), as its C#
/// `FieldDecl` is built without attributes.
bool t7MemberRenamed(ref Ctx c, from FileId f, at i64 declIndex, by i64 memberIndex) {
    if memberIndex < 0 { return false }
    switch c.files[f].unit.members[declIndex] {
        case .structDecl(let n):
            switch n.value.members[memberIndex] {
                case .fieldDecl(let d):
                    return isRenamed(d.value.attributes, from: c.files[f].text.span)
                case .propertyDecl(let d):
                    return isRenamed(d.value.attributes, from: c.files[f].text.span)
                default:
                    // coverage-exempt: Q1200
                    return false
            }
        default:
            // coverage-exempt: Q1200
            return false
    }
}

/// Ports the local `IsLink` of `Naming.CheckNumber`: a particle or function word ends the head noun.
bool isLink(string w) => isParticleWord(lowerAscii(w)) || isFunctionWord(lowerAscii(w))

/// Ports `Naming.CheckNumber`. BYN5104: a collection (`List`, `Map`, spans, arrays, text views; `Untrusted`, `Owned`
/// and `?` looked through) is named with a plural or a collective, anything else with a singular; the last word decides
/// (revision 0021 Part 4), or the word before the first particle or function word. A `bool` is a state, not a noun,
/// and a type parameter may be either; neither is checked. A collection is reported only when its last word is a
/// known noun, so the plural in the message is always known; a number is never reported as plural.
void checkNumber(ref Ctx c, by Grammar grammar, from FileId f, at TextSpan name, for string text, as Type type) {
    if isBool(type) || kindOf(type) == .typeParam || kindOf(type) == .error || text == "_" || !isAllAscii(text) { return }
    let spans = wordSpans(text)
    if spans.length == 0 { return }
    // A particle or function word ends the head noun: `modulesByDir` is decided by `modules`; `byPath` and `inGroup` by none.
    if isLink(spans[0].text) { return }
    var head: i64 = -1
    for k in 1..spans.length {
        if isLink(spans[k].text) {
            head = k
            break
        }
    }
    let at = head < 0 ? spans.length - 1 : head - 1
    let start = spans[at].start
    let headText = spans[at].text
    let word = lowerAscii(headText)
    if listContainsString(c.lexiconCollectives, by: word) || listContainsString(grammar.collectives, by: word) { return }
    var inner = type
    while kindOf(inner) == .untrusted || kindOf(inner) == .owned || kindOf(inner) == .optional {
        inner = kindOf(inner) == .untrusted ? c.untrustedTypes[typeIndex(inner)]
            : kindOf(inner) == .owned ? c.ownedTypes[typeIndex(inner)] : c.optionalTypes[typeIndex(inner)]
    }
    let kind = kindOf(inner)
    // coverage-exempt: Q1200
    if kind == .list || kind == .map || kind == .span || kind == .array || kind == .textView {
        // Only a noun has a plural: `covered`, `distinct` and `byKey` name a collection by what it holds or how it is keyed.
        if looksPlural(ref c, for: word, by: grammar) || !isNoun(ref c, for: word, by: grammar) { return }
        let pluralName = $"{text[0..start]}{matchCase(headText, as: plural(ref c, for: word, by: grammar))}{text[start + headText.length..text.length]}"
        report(ref c, for: .numberAgreement, from: f, at: name, by: (a0: text, a1: pluralName, a2: "", a3: "", a4: ""),
            help: $"rename it `{pluralName}`", hasFix: true, fixSpan: name, fixReplacement: pluralName)
    } else if !isNumeric(inner) && isPlural(ref c, for: word, by: grammar) {
        // A number named with a plural is a quantity in units (`cents`, `grams`); a count is BYN5105's.
        let display = typeDisplay(ref c, by: type)
        if (singular(ref c, for: word, by: grammar) is { } one) {
            let singularName = $"{text[0..start]}{matchCase(headText, as: one)}{text[start + headText.length..text.length]}"
            report(ref c, for: .numberAgreementOne, from: f, at: name, by: (a0: text, a1: display, a2: "", a3: "", a4: ""),
                help: $"rename it `{singularName}`", hasFix: true, fixSpan: name, fixReplacement: singularName)
        } else {
            report(ref c, for: .numberAgreementOne, from: f, at: name, by: (a0: text, a1: display, a2: "", a3: "", a4: ""))
        }
    }
}

/// Ports `Naming.CheckCount`. BYN5105: an integer that counts items is singular noun + `Count`; `<plural>Count`,
/// `num<Plural>` and `numberOf<Plural>` are renamed (revision 0021 Part 4). `length` is not a count name. True when it
/// reports, so BYN5104 does not report the name again.
bool checkCount(ref Ctx c, by Grammar grammar, from FileId f, at TextSpan name, for string text, as Type type) {
    if !isInteger(type) || !isAllAscii(text) { return false }
    var words = List<string>()
    for w in wordSpans(text) { words.append(w.text) }
    var counted = List<string>()
    let n = words.length
    if n > 1 && words[n - 1] == "Count" {
        for k in 0..n - 1 { counted.append(words[k]) }
    } else if n > 1 && words[0] == "num" {
        for k in 1..n { counted.append(words[k]) }
    } else if n > 2 && words[0] == "number" && words[1] == "Of" {
        for k in 2..n { counted.append(words[k]) }
    }
    if counted.length == 0 { return false }
    let last = lowerAscii(counted[counted.length - 1])
    unless isPlural(ref c, for: last, by: grammar) { return false }
    let one = singular(ref c, for: last, by: grammar) ?? return false
    var head = StrBuf()
    for k in 0..counted.length - 1 { head.append(counted[k]) }
    let headText = $"{head.finish()}"
    let fixedName = headText.length == 0 ? $"{one}Count"
        : $"{lowerAscii(headText[0..1])}{headText[1..headText.length]}{matchCase(counted[counted.length - 1], as: one)}Count"
    report(ref c, for: .countName, from: f, at: name, by: (a0: text, a1: fixedName, a2: "", a3: "", a4: ""),
        help: $"rename it `{fixedName}`", hasFix: true, fixSpan: name, fixReplacement: fixedName)
    return true
}

/// Ports `Naming.IsPlural`: a plural the checker knows: an irregular plural, a project noun's `forms` entry (not a
/// verb's, Q1207), or a regular plural of a known noun.
bool isPlural(ref Ctx c, for string word, by Grammar grammar) {
    if listContainsString(c.lexiconIrregularPlurals, by: word) { return true }
    return singular(ref c, for: word, by: grammar) is not null
}

/// Ports `Naming.LooksPlural`: a word that may be a plural, for a collection's name: `isPlural`, or any word ending
/// in `s` but `ss`, `us` or `is`.
bool looksPlural(ref Ctx c, for string word, by Grammar grammar) =>
    isPlural(ref c, for: word, by: grammar) || word.endsWith("s") && !word.endsWith("ss") && !word.endsWith("us") && !word.endsWith("is")

/// Ports `Naming.Singular`: the singular of `word`: the project noun whose `forms` entry it is, else an irregular
/// plural's singular (`Lexicon.IrregularSingulars`), else the first regular base (`-ies`, `-es`, `-s` of the `Endings`
/// table) that is a known noun; null when none is known.
string? singular(ref Ctx c, for string word, by Grammar grammar) {
    for (key, form) in grammar.forms {
        if form == word && isNoun(ref c, for: key, by: grammar) { return key }
    }
    for k in 0..c.lexiconIrregularPlurals.length {
        if c.lexiconIrregularPlurals[k] == word { return c.lexiconIrregularSingulars[k] }
    }
    if word.endsWith("ss") || word.endsWith("us") || word.endsWith("is") { return null }
    let endings: List<string> = ["ies", "es", "s"]
    for ending in endings {
        if word.length <= ending.length + 1 || !word.endsWith(ending) { continue }
        let bare = word[0..word.length - ending.length]
        for r in endingReplacements(ending) {
            let candidate = $"{bare}{r}"
            if isNoun(ref c, for: candidate, by: grammar) { return candidate }
        }
    }
    return null
}

/// Ports `Naming.Plural`: the plural of `word`: a project noun's `forms` entry, else the irregular plural whose
/// singular it is (`Lexicon.IrregularSingulars`), else the regular spelling (`-s`, `-es`, `-ies`).
string plural(ref Ctx c, for string word, by Grammar grammar) {
    // coverage-exempt: Q1200
    if isNoun(ref c, for: word, by: grammar) {
        if (grammar.forms.tryGet(at: word) is { } form) { return form }
    }
    for k in 0..c.lexiconIrregularSingulars.length {
        if c.lexiconIrregularSingulars[k] == word { return c.lexiconIrregularPlurals[k] }
    }
    let n = word.length
    if n > 1 && word.bytes[n - 1] == 0x79 && !isVowel(word.bytes[n - 2]) { return $"{word[0..n - 1]}ies" }
    if word.endsWith("s") || word.endsWith("x") || word.endsWith("z") || word.endsWith("ch") || word.endsWith("sh") {
        return $"{word}es"
    }
    return $"{word}s"
}

/// Ports `Naming.IsNoun`.
bool isNoun(ref Ctx c, for string word, by Grammar grammar) =>
    listContainsString(c.lexiconNouns, by: word) || listContainsString(grammar.nouns, by: word)

/// Ports `Naming.IsVerb`.
bool isVerb(ref Ctx c, for string word, by Grammar grammar) =>
    listContainsString(c.lexiconVerbs, by: word) || listContainsString(grammar.verbs, by: word)

/// Ports `Naming.MatchCase`: `word` spelled with the first letter's case of `like`: `Line`, `lines` → `Lines`; there is no all-caps branch, because spec §5.1 keeps only a two-letter acronym uppercase, so `URLS` would fail BYN2009 (`URL`, `urls` → `Urls`).
string matchCase(string like, as string word) {
    if word.length == 0 || !isUpperAscii(like.bytes[0]) { return word }
    return $"{upperAscii(word[0..1])}{word[1..word.length]}"
}

/// BYN5001: an `-ed` name is a changed copy or a view, so a member that takes `ref this` is a plain verb (revision 0005).
void checkParticiple(ref Ctx c, by in Grammar grammar, from FileId f, at TextSpan name, for string text) {
    var stems = List<string>()
    // A form is read by its word's class: the -ed spelling for a verb only, the plural for a noun (revision 0021 Part 3).
    for (word, form) in grammar.forms {
        if form == text && isVerb(ref c, for: word, by: grammar) { stems.append(word) }
    }
    if stems.length == 0 { stems = participleStems(text) }
    if stems.length == 0 { return }
    var stem = stems[0]
    for w in stems {
        if isVerb(ref c, for: w, by: grammar) {
            stem = w
            break
        }
    }
    report(ref c, for: .participleChangesThis, from: f, at: name, by: (a0: text, a1: stem, a2: "", a3: "", a4: ""),
        help: "name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view")
}

/// BYN5009: a particle is not a member name, and no instance member spells a conversion with `to` or `as`:
/// a view is a noun (`asSpan` → `span`), a conversion is `T(x)` (`toList` → `List(x)`).
void checkParticleName(ref Ctx c, for StructId s, from FileId f, at TextSpan name, by string text, bool isStatic) {
    if isParticleWord(text) {
        report(ref c, for: .particleAsMemberName, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
            help: "rename the member, for example `tryGet(at:)` instead of `at(…)`")
        return
    }
    if isStatic { return }
    let words = wordSpans(text)
    if words.length < 2 { return }
    let particle = words[0].text
    if (particle != "to" && particle != "as") || !isUpperAscii(words[1].text.bytes[0]) { return }
    let rest = text[particle.length..text.length]
    let lowered = lowerAscii(rest)
    let instead = particle == "as" ?
        $"{lowerAscii(rest[0..1])}{rest[1..rest.length]}" :
        $"{isPrimitiveWord(lowered) ? lowered : rest}({toCamel(c.structs[s].name)})"
    report(ref c, for: .conversionMember, from: f, at: name, by: (a0: text, a1: particle, a2: instead, a3: "", a4: ""),
        help: "use a view noun, `copy()`, or a `T(x)` conversion")
}

/// The primitive type names a `toX` conversion is written in lowercase: `toString` → `string(x)`.
bool isPrimitiveWord(string w) => w switch {
    "string" or "bool" or "rune" or "i8" or "i16" or "i32" or "i64" or "u8" or "u16" or "u32" or "u64" or "f32" or
    "f64" or "sbyte" or "byte" or "short" or "ushort" or "int" or "uint" or "long" or "ulong" or "float" or
    "double" => true,
    _ => false,
}

/// BYN5014: every word of a member name is a word the checker knows, from the lexicon or the project's
/// `grammar` (J85), directly or by a regular ending (`bases`). Names with letters outside ASCII, single
/// letters and math names are not checked. The help offers the three classes, the best guess first: `guess` is
/// `verbs` for a member that changes `this`, `adjectives` for a `bool` member, else `nouns`.
void checkWords(ref Ctx c, by in Grammar grammar, from FileId f, at TextSpan name, for string text, as string guess) {
    if isMathWord(text) || !isAllAscii(text) { return }
    for w in wordSpans(text) {
        let word = trimDigits(lowerAscii(w.text))
        if word.length < 2 || !isAllLowerLetters(word) || isMathWord(lowerAscii(w.text)) { continue }
        if isKnown(ref c, for: word, by: grammar) { continue }
        report(ref c, for: .unknownWord, from: f, at: TextSpan { start: name.start + w.start, length: w.text.length },
            by: (a0: word, a1: "", a2: "", a3: "", a4: ""),
            help: $"add it to `grammar` in package.byn: {offer(guess, for: word)}, {offer(guess == "verbs" ? "nouns" : "verbs", for: word)} or {offer(guess == "adjectives" ? "nouns" : "adjectives", for: word)}")
    }
}

/// Ports `Naming.Offer`.
string offer(string field, for string word) => $"`{field}: [\"{word}\"]`"

bool isKnown(ref Ctx c, for string word, by in Grammar grammar) {
    if isListed(ref c, for: word, by: grammar) { return true }
    for (_, form) in grammar.forms {
        if form == word { return true }
    }
    for b in bases(word) {
        if isListed(ref c, for: b, by: grammar) { return true }
    }
    return false
}

bool isListed(ref Ctx c, for string w, by in Grammar grammar) =>
    listContainsString(c.lexiconVerbs, by: w) || listContainsString(c.lexiconNouns, by: w) || listContainsString(c.lexiconAdjectives, by: w)
    || listContainsString(c.lexiconCollectives, by: w) || listContainsString(c.lexiconIrregularPlurals, by: w)
    || isParticleWord(w) || isFunctionWord(w)
    || listContainsString(grammar.verbs, by: w) || listContainsString(grammar.nouns, by: w) || listContainsString(grammar.adjectives, by: w)
    || listContainsString(grammar.collectives, by: w)

/// The words `word` may be a regular form of: plurals and third person (`-s`, `-es`, `-ies`), `-ed`, `-ing`,
/// doers (`-er`, `-or`), `-est`, `-ly`, and `un-`/`re-`; a doubled final consonant is undone (`runner` → `run`).
List<string> bases(string word) {
    var found = List<string>()
    let endings: List<string> = ["ies", "es", "s", "ied", "ed", "ing", "ier", "er", "ers", "or", "est", "ly"]
    for ending in endings {
        if word.length <= ending.length + 1 || !word.endsWith(ending) { continue }
        let bare = word[0..word.length - ending.length]
        for r in endingReplacements(ending) { found.append($"{bare}{r}") }
        if bare.length >= 3 && bare.bytes[bare.length - 1] == bare.bytes[bare.length - 2] { found.append(bare[0..bare.length - 1]) }
        if ending == "ers" {
            let more = bases(word[0..word.length - 1])
            for b in more { found.append(b) }
        }
    }
    let prefixes: List<string> = ["un", "re"]
    for prefix in prefixes {
        if word.length <= prefix.length + 2 || !word.startsWith(prefix) { continue }
        let stripped = word[prefix.length..word.length]
        found.append(stripped)
        let more = bases(stripped)
        for b in more { found.append(b) }
    }
    return found
}

/// What replaces each ending of `bases`, in the C# `Endings` table's order.
List<string> endingReplacements(string ending) => ending switch {
    "ies" or "ied" or "ier" => ["y"],
    "s" or "ly" => [""],
    "ers" => [],
    _ => ["", "e"],
}

/// Naming.cs:187 GrammarOf: the project dictionary from `package.byn` beside the package's sources (`displayRoot`),
/// lowered; empty without one. Read once per compilation and kept in `c.grammarRead`, as the C# caches it (a copy is returned: `Grammar` is unique).
Grammar grammarOf(ref Ctx c) {
    if !c.grammarKnown {
        c.grammarRead = readGrammar(ref c)
        c.grammarKnown = true
    }
    return lowerGrammar(in c.grammarRead)
}

Grammar readGrammar(ref Ctx c) {
    let path = t11Combine(c.displayRoot, by: "package.byn")
    // `File.Exists(path) ? Manifest.Read(path)`: a directory or a missing path is no file; a file `Manifest.Read`
    // cannot read throws out of the C# compiler, a panic here (as `t11ReadAllBytes`, Q571).
    if t11DirectoryExists(path) { return Grammar {} }
    let bytes = Io.readFile(path) catch switch {
        IoError.notFound => return Grammar {},
        IoError e => panic($"cannot read `{path}`"),
    }
    let manifest = manifestParse(lexer.SourceText.create("package.byn", from: move bytes))
    return lowerGrammar(in manifest.grammar)
}

/// The index of the file the loader read as `"package.byn"`, or -1.
i64 packageFileIndex(in List<SourceFile> files) {
    for i in 0..files.length {
        if files[i].displayPath == "package.byn" { return i }
    }
    return -1
}

/// `grammar` with every word and form in lowercase.
Grammar lowerGrammar(in Grammar grammar) {
    var lower = Grammar {}
    for w in grammar.verbs { lower.verbs.append(lowerAscii(w)) }
    for w in grammar.nouns { lower.nouns.append(lowerAscii(w)) }
    for w in grammar.adjectives { lower.adjectives.append(lowerAscii(w)) }
    for w in grammar.collectives { lower.collectives.append(lowerAscii(w)) }
    for (word, form) in grammar.forms { lower.forms[lowerAscii(word)] = lowerAscii(form) }
    return lower
}

void checkBoolState(ref Ctx c, from FileId f, at TextSpan name, for string text) {
    if isStateName(text) || text.startsWith("contains") || text.startsWith("equals") || text.startsWith("matches")
        || text.startsWith("startsWith") || text.startsWith("endsWith") || text.startsWith("try") { return }
    let fixedName = $"is{upperAscii(text[0..1])}{text[1..text.length]}"
    report(ref c, for: .boolWithoutPrefix, from: f, at: name, by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
        help: $"rename it `{fixedName}`", hasFix: true, fixSpan: name, fixReplacement: fixedName)
}

/// `isX`, `hasX`, `canX`: the prefix, then a capital.
bool isStateName(string name) =>
    statePrefixed(name, by: "is") || statePrefixed(name, by: "has") || statePrefixed(name, by: "can")

bool statePrefixed(string name, by string prefix) =>
    name.length > prefix.length && name.startsWith(prefix) && isUpperAscii(name.bytes[prefix.length])

/// The verbs `name` may be the `-ed` form of, most likely first; empty when it is not a participle. Only a
/// single lowercase word ending in `-ed` counts: `sorted` → sort, `reversed` → reverse, `trimmed` → trim,
/// `copied` → copy. Words ending in `-eed`, words shorter than five letters and `isNotParticiple` are not.
List<string> participleStems(string name) {
    var stems = List<string>()
    if name.length < 5 || !name.endsWith("ed") || name.endsWith("eed") || !isAllLowerLetters(name) || isNotParticiple(name) {
        return stems
    }
    let bare = name[0..name.length - 2]
    let n = bare.length
    let last = bare.bytes[n - 1]
    let prev = bare.bytes[n - 2]
    if last == 0x69 { stems.append($"{bare[0..n - 1]}y") }
    if n >= 4 && last == prev && !isVowel(last) && last != 0x6C && last != 0x73 { stems.append(bare[0..n - 1]) }
    // `reversed`, `parsed`, `doubled`, `named` drop only the `d`; `sorted`, `joined` drop `ed`.
    let keepsE = last == 0x63 || last == 0x75 || last == 0x76 || last == 0x7A
        || (last == 0x73 && prev != 0x73) || (last == 0x6C && !isVowel(prev) && prev != 0x6C)
        || (n == 3 && !isVowel(bare.bytes[0]) && isVowel(bare.bytes[1]) && !isVowel(bare.bytes[2])
            && bare.bytes[2] != 0x77 && bare.bytes[2] != 0x78 && bare.bytes[2] != 0x79)
    let dropD = name[0..name.length - 1]
    if keepsE {
        stems.append(dropD)
        stems.append(bare)
    } else {
        stems.append(bare)
        stems.append(dropD)
    }
    return stems
}

bool isVowel(u8 b) => b == 0x61 || b == 0x65 || b == 0x69 || b == 0x6F || b == 0x75

/// Common words ending in `-ed` that are not the `-ed` form of a verb.
bool isNotParticiple(string w) => w switch {
    "hundred" or "embed" or "shred" or "naked" or "wicked" or "sacred" or "kindred" => true,
    _ => false,
}

/// The first word of a `ref this` member that names a thing, not an action (BYN5101).
bool isThingNoun(string w) => w switch {
    "size" or "length" or "total" or "sum" or "value" or "values" or "data" or "item" or "items" or "element" or
    "elements" or "result" or "results" or "name" or "id" or "state" or "status" or "info" or "content" or
    "contents" or "capacity" or "amount" or "number" or "key" or "keys" or "entry" or "entries" or "node" or
    "nodes" => true,
    _ => false,
}

string toPascal(string name) {
    let words = wordSpans(name)
    if words.length == 0 { return name }
    var sb = StrBuf()
    for w in words { sb.append(capitalize(w.text)) }
    return $"{sb.finish()}"
}

string toCamel(string name) {
    let words = wordSpans(name)
    if words.length == 0 { return name }
    var sb = StrBuf()
    sb.append(lowerAscii(words[0].text))
    for i in 1..words.length { sb.append(capitalize(words[i].text)) }
    return $"{sb.finish()}"
}

/// Two-letter acronyms stay uppercase (`IO`); other words are capitalized.
string capitalize(string word) {
    if word.length == 0 { return word }
    if word.length == 2 && isUpperAscii(word.bytes[0]) && isUpperAscii(word.bytes[1]) { return word }
    var bytes = List<u8>()
    for i in 0..word.length {
        let b = word.bytes[i]
        if i == 0 && isLowerAscii(b) {
            bytes.append(b - 32)
        } else if i > 0 && isUpperAscii(b) {
            bytes.append(b + 32)
        } else {
            bytes.append(b)
        }
    }
    return $"{utf8(bytes.span)}"
}

/// One word of a name and its byte offset in the name.
struct WordSpan {
    i64 start
    string text
}

/// Splits at underscores and case changes: `HTTPClient` → HTTP, Client; `parse_url` → parse, url;
/// `IOError` → IO, Error. Uncased letters and digits stay with the word they follow.
List<WordSpan> wordSpans(string name) {
    var words = List<WordSpan>()
    var start: i64 = 0
    var length: i64 = 0
    let n = name.length
    for i in 0..n {
        let ch = name.bytes[i]
        if ch == 0x5F {
            if length > 0 { words.append(WordSpan { start: start, text: name[start..start + length] }) }
            length = 0
            continue
        }
        if isUpperAscii(ch) && length > 0 {
            let prev = name.bytes[i - 1]
            let nextIsLower = i + 1 < n && isLowerAscii(name.bytes[i + 1])
            if isLowerAscii(prev) || isDigitAscii(prev) || (isUpperAscii(prev) && nextIsLower) {
                words.append(WordSpan { start: start, text: name[start..start + length] })
                length = 0
            }
        }
        if length == 0 { start = i }
        length += 1
    }
    if length > 0 { words.append(WordSpan { start: start, text: name[start..start + length] }) }
    return words
}

bool isUpperAscii(u8 b) => b >= 0x41 && b <= 0x5A

bool isLowerAscii(u8 b) => b >= 0x61 && b <= 0x7A

bool isDigitAscii(u8 b) => b >= 0x30 && b <= 0x39

string lowerAscii(string s) {
    var bytes = List<u8>()
    for b in s.bytes {
        if isUpperAscii(b) { bytes.append(b + 32) } else { bytes.append(b) }
    }
    return $"{utf8(bytes.span)}"
}

string upperAscii(string s) {
    var bytes = List<u8>()
    for b in s.bytes {
        if isLowerAscii(b) { bytes.append(b - 32) } else { bytes.append(b) }
    }
    return $"{utf8(bytes.span)}"
}

bool isAllAscii(string s) {
    for b in s.bytes {
        if b >= 0x80 { return false }
    }
    return true
}

bool isAllLowerLetters(string s) {
    for b in s.bytes {
        unless isLowerAscii(b) { return false }
    }
    return true
}

/// `s` without its trailing digits.
string trimDigits(string s) {
    var n = s.length
    while n > 0 && isDigitAscii(s.bytes[n - 1]) { n -= 1 }
    return s[0..n]
}

/// The span of `fn`'s declared return type, read from the tree through its `declIndex`/`memberIndex`.
TextSpan returnTypeSpan(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    if f < 0 || d < 0 { return c.functions[fn].nameSpan }
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n):
            return typeSyntaxSpan(in n.value.returnType)
        case .structDecl(let n):
            return memberReturnSpan(in n.value.members, at: m)
        case .interfaceDecl(let n):
            return memberReturnSpan(in n.value.members, at: m)
        case .extensionDecl(let n):
            return memberReturnSpan(in n.value.members, at: m)
        default:
            return c.functions[fn].nameSpan
    }
}

TextSpan memberReturnSpan(in List<parser.Decl> members, at i64 m) {
    if m < 0 || m >= members.length { return TextSpan { start: 0, length: 0 } }
    switch members[m] {
        case .functionDecl(let n):
            return typeSyntaxSpan(in n.value.returnType)
        default:
            return TextSpan { start: 0, length: 0 }
    }
}

TextSpan typeSyntaxSpan(in parser.TypeSyntax t) => t switch {
    .namedType(let n) => n.value.span,
    .optionalType(let n) => n.value.span,
    .arrayType(let n) => n.value.span,
    .tupleType(let n) => n.value.span,
    .functionTypeSyntax(let n) => n.value.span,
    .dynType(let n) => n.value.span,
    .refinedType(let n) => n.value.span,
    .pointerType(let n) => n.value.span,
    .none => TextSpan { start: 0, length: 0 },
}

// ── Particles.cs ────────────────────────────────────────────────────────────────

/// The particle rule at a declaration (spec §10): one unlabeled required parameter, the object; every other
/// takes a particle (BYN5004, BYN5006); a particle appears once (BYN5013). The receiver is not a parameter
/// here, and a `bool` parameter is passed by name, so neither counts. The parameters are read from the tree
/// through `fn`'s `declIndex`/`memberIndex`, in `fn.parameters` order (Q552). Exempt: `extern` declarations
/// and a `rest` tail, which takes no label (J39).
void checkParticles(ref Ctx c, from FileId f, for FuncId fn) {
    if c.functions[fn].template >= 0 || (c.functions[fn].modifiers & 128) != 0 { return }
    let params = paramFacts(ref c, for: fn)
    let fnName = $"{c.functions[fn].name}"
    var seen = List<string>()
    for p in params {
        if (p.particle is { } particle) {
            let text = $"{getText(c.files[f].text.span, at: particle)}"
            if listContainsString(seen, by: text) {
                report(ref c, for: .repeatedParticle, from: f, at: particle, by: (a0: fnName, a1: text, a2: "", a3: "", a4: ""),
                    label: "used again", help: "group the values in a struct, or choose another particle")
            } else {
                seen.append(text)
            }
        }
    }
    var unlabeled = List<i64>()
    for i in 0..params.length {
        let isBoolParam = i < c.functions[fn].parameters.length && isBool(c.locals[c.functions[fn].parameters[i]].type)
        if params[i].isPlain && !isBoolParam { unlabeled.append(i) }
    }
    if unlabeled.length < 2 { return }
    let name = c.functions[fn].kind == .constructor ? $"{c.structs[c.functions[fn].owner].name}" : fnName
    report(ref c, for: .particleRequired, from: f, at: c.functions[fn].nameSpan, by: (a0: name, a1: $"{unlabeled.length}", a2: "", a3: "", a4: ""),
        label: $"{unlabeled.length} unlabeled parameters", help: "keep one unlabeled parameter, the object")
    for k in 1..unlabeled.length {
        let at = params[unlabeled[k]].name
        let paramName = $"{getText(c.files[f].text.span, at: at)}"
        report(ref c, for: .parameterNeedsParticle, from: f, at: at, by: (a0: paramName, a1: "", a2: "", a3: "", a4: ""),
            label: "needs a particle", help: "label it with `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`")
    }
}

/// What the particle rule reads of one parameter's syntax.
struct ParamFacts {
    TextSpan? particle = null
    TextSpan name
    /// No particle, no default and not a `rest` tail.
    bool isPlain = false
}

/// The parameters of `fn`'s declaration, or none when it has no function or constructor declaration.
List<ParamFacts> paramFacts(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    if f < 0 || d < 0 { return List<ParamFacts>() }
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n):
            return paramFactsOf(in n.value.params)
        case .structDecl(let n):
            return memberParamFacts(in n.value.members, at: m)
        case .interfaceDecl(let n):
            return memberParamFacts(in n.value.members, at: m)
        case .extensionDecl(let n):
            return memberParamFacts(in n.value.members, at: m)
        default:
            return List<ParamFacts>()
    }
}

List<ParamFacts> memberParamFacts(in List<parser.Decl> members, at i64 m) {
    if m < 0 || m >= members.length { return List<ParamFacts>() }
    switch members[m] {
        case .functionDecl(let n):
            return paramFactsOf(in n.value.params)
        case .constructorDecl(let n):
            return paramFactsOf(in n.value.params)
        default:
            return List<ParamFacts>()
    }
}

List<ParamFacts> paramFactsOf(in List<parser.Param> params) {
    var facts = List<ParamFacts>()
    for p in params {
        facts.append(ParamFacts {
            particle: p.particle,
            name: p.name,
            isPlain: p.particle is null && p.defaultKeyword is .none && !p.rest,
        })
    }
    return facts
}
