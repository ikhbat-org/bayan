    literal
    symbolLiteral
    hostTarget
    defaultValue
    local
    thisRef
    field
    tupleElement
    call
    builtinCall
    unary
    binary
    conversion
    tryFrom
    conditional
    coalesce
    structLiteral
    withExpr
    tuple
    collection
    spread
    index
    slice
    range
    isExpr
    switchExpr
    interpolated
    moveExpr
    tryExpr
    catchExpr
    jump
    blockExpr
    errorVariant
    enumMember
    unionNew
    enumValues
    staticArray
    stackalloc
    errorExpr
    typeRef
    moduleRef
    lambda
    functionRef
    block
    localDecl
    exprStmt
    assign
    returnStmt
    failStmt
    becomeStmt
    breakStmt
    continueStmt
    ifStmt
    whileStmt
    doWhile
    forStmt
    switchStmt
    deferStmt
    assertStmt
    errdeferStmt
    panicDefer
    setOnPanic
    contextStmt
    errorStmt
    constantPattern
    relationalPattern
    rangePattern
    bindPattern
    notPattern
    binaryPattern
    propertyPattern
    unionField
    unionPattern
    errorField
    errorPattern
    methodGroup
    variantGroup
    builtinGroup
}

