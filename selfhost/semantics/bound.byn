public BExpr addStructLiteral(ref Ctx c, from move BStructLiteral n) uses alloc {
    var m = move n
    // A state literal `T.s { … }` is of type `T.s` (`literal with { State = state, Type = stateType }`, BinderExpressions.cs:1609).
    if m.state == -1 || m.type == -1 { m.type = makeType(.structType, at: m.structId) }
    c.bStructLiterals.append(move m)
    return makeBound(.structLiteral, at: c.bStructLiterals.length - 1)
}

