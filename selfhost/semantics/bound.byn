// ── Base-class members ─────────────────────────────────────────────────────────

/// C# `BoundExpr.Type`.
public Type exprType(in Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .literal: return c.bLiterals[i].type
        case .symbolLiteral: return builtinType(.symbol)
        case .hostTarget: return prim(.string)
        case .defaultValue: return c.bDefaults[i].type
        case .local: return c.bLocals[i].type
        case .thisRef: return c.bThises[i].type
        case .field: return c.bFields[i].type
        case .tupleElement: return c.bTupleElements[i].type
        case .call: return c.bCalls[i].type
        case .builtinCall: return c.bBuiltinCalls[i].type
        case .unary: return c.bUnaries[i].type
        case .binary: return c.bBinaries[i].type
        case .conversion: return c.bConversions[i].type
        case .tryFrom: return c.bTryFroms[i].type
        case .conditional: return c.bConditionals[i].type
        case .coalesce: return c.bCoalesces[i].type
        case .structLiteral: return c.bStructLiterals[i].type
        case .withExpr: return c.bWiths[i].type
        case .tuple: return c.bTuples[i].tupleType
        case .collection: return c.bCollections[i].type
        case .spread: return c.bSpreads[i].type
        case .index: return c.bIndexes[i].type
        case .slice: return c.bSlices[i].type
        case .range: return c.bRanges[i].type
        case .isExpr: return prim(.bool)
        case .switchExpr: return c.bSwitchExprs[i].type
        case .interpolated: return prim(.string)
        case .moveExpr: return c.bMoves[i].type
        case .tryExpr: return c.bTries[i].type
        case .catchExpr: return c.bCatches[i].type
        case .jump: return prim(.neverKind)
        case .blockExpr: return c.bBlockExprs[i].type
        case .errorVariant: return c.bErrorVariants[i].type
        case .enumMember: return c.bEnumMembers[i].type
        case .unionNew: return c.bUnionNews[i].type
        case .enumValues: return c.bEnumValues[i].type
        case .staticArray: return c.bStaticArrays[i].type
        case .stackalloc: return c.bStackallocs[i].type
        case .errorExpr: return errorType()
        case .typeRef: return errorType()
        case .moduleRef: return errorType()
        case .lambda: return c.bLambdas[i].functionType
        case .functionRef: return c.bFunctionRefs[i].functionType
        case .unionField: return c.bUnionFields[i].type
        case .errorField: return c.bErrorFields[i].type
        case .methodGroup: return errorType()
        case .variantGroup: return errorType()
        case .builtinGroup: return errorType()
        default: return errorType()
    }
}

/// C# `BoundNode.Syntax.Span`.
public TextSpan nodeSpan(in Ctx c, for BNode n) {
    let i = boundIndex(n)
    switch boundKind(n) {
        case .literal: return c.bLiterals[i].span
        case .symbolLiteral: return c.bSymbolLiterals[i].span
        case .hostTarget: return c.bHostTargets[i].span
        case .defaultValue: return c.bDefaults[i].span
        case .local: return c.bLocals[i].span
        case .thisRef: return c.bThises[i].span
        case .field: return c.bFields[i].span
        case .tupleElement: return c.bTupleElements[i].span
        case .call: return c.bCalls[i].span
        case .builtinCall: return c.bBuiltinCalls[i].span
        case .unary: return c.bUnaries[i].span
        case .binary: return c.bBinaries[i].span
        case .conversion: return c.bConversions[i].span
        case .tryFrom: return c.bTryFroms[i].span
        case .conditional: return c.bConditionals[i].span
        case .coalesce: return c.bCoalesces[i].span
        case .structLiteral: return c.bStructLiterals[i].span
        case .withExpr: return c.bWiths[i].span
        case .tuple: return c.bTuples[i].span
        case .collection: return c.bCollections[i].span
        case .spread: return c.bSpreads[i].span
        case .index: return c.bIndexes[i].span
        case .slice: return c.bSlices[i].span
        case .range: return c.bRanges[i].span
        case .isExpr: return c.bIses[i].span
        case .switchExpr: return c.bSwitchExprs[i].span
        case .interpolated: return c.bInterpolateds[i].span
        case .moveExpr: return c.bMoves[i].span
        case .tryExpr: return c.bTries[i].span
        case .catchExpr: return c.bCatches[i].span
        case .jump: return c.bJumps[i].span
        case .blockExpr: return c.bBlockExprs[i].span
        case .errorVariant: return c.bErrorVariants[i].span
        case .enumMember: return c.bEnumMembers[i].span
        case .unionNew: return c.bUnionNews[i].span
        case .enumValues: return c.bEnumValues[i].span
        case .staticArray: return c.bStaticArrays[i].span
        case .stackalloc: return c.bStackallocs[i].span
        case .errorExpr: return c.bErrorExprs[i].span
        case .typeRef: return c.bTypeRefs[i].span
        case .moduleRef: return c.bModuleRefs[i].span
        case .lambda: return c.bLambdas[i].span
        case .functionRef: return c.bFunctionRefs[i].span
        case .block: return c.bBlocks[i].span
        case .localDecl: return c.bLocalDecls[i].span
        case .exprStmt: return c.bExprStmts[i].span
        case .assign: return c.bAssigns[i].span
        case .returnStmt: return c.bReturns[i].span
        case .failStmt: return c.bFails[i].span
        case .becomeStmt: return c.bBecomes[i].span
        case .breakStmt: return c.bBreaks[i].span
        case .continueStmt: return c.bContinues[i].span
        case .ifStmt: return c.bIfs[i].span
        case .whileStmt: return c.bWhiles[i].span
        case .doWhile: return c.bDoWhiles[i].span
        case .forStmt: return c.bFors[i].span
        case .switchStmt: return c.bSwitches[i].span
        case .deferStmt: return c.bDefers[i].span
        case .assertStmt: return c.bAsserts[i].span
        case .errdeferStmt: return c.bErrdefers[i].span
        case .panicDefer: return c.bPanicDefers[i].span
        case .setOnPanic: return c.bSetOnPanics[i].span
        case .contextStmt: return c.bContexts[i].span
        case .errorStmt: return c.bErrorStmts[i].span
        case .constantPattern: return c.bConstantPatterns[i].span
        case .relationalPattern: return c.bRelationalPatterns[i].span
        case .rangePattern: return c.bRangePatterns[i].span
        case .bindPattern: return c.bBindPatterns[i].span
        case .notPattern: return c.bNotPatterns[i].span
        case .binaryPattern: return c.bBinaryPatterns[i].span
        case .propertyPattern: return c.bPropertyPatterns[i].span
        case .unionField: return c.bUnionFields[i].span
        case .unionPattern: return c.bUnionPatterns[i].span
        case .errorField: return c.bErrorFields[i].span
        case .errorPattern: return c.bErrorPatterns[i].span
        case .methodGroup: return c.bMethodGroups[i].span
        case .variantGroup: return c.bVariantGroups[i].span
        case .builtinGroup: return c.bBuiltinGroups[i].span
    }
}

/// C# `BoundPattern.InputType`.
public Type patternInput(in Ctx c, for BPattern p) {
    let i = boundIndex(p)
    switch boundKind(p) {
        case .constantPattern: return c.bConstantPatterns[i].inputType
        case .relationalPattern: return c.bRelationalPatterns[i].inputType
        case .rangePattern: return c.bRangePatterns[i].inputType
        case .bindPattern: return c.bBindPatterns[i].inputType
        case .notPattern: return c.bNotPatterns[i].inputType
        case .binaryPattern: return c.bBinaryPatterns[i].inputType
        case .propertyPattern: return c.bPropertyPatterns[i].inputType
        case .unionPattern: return c.bUnionPatterns[i].inputType
        case .errorPattern: return c.bErrorPatterns[i].inputType
        default: return errorType()
    }
}

// ── Walk ───────────────────────────────────────────────────────────────────────

/// C# `BoundTree.Children`: the direct children of a node, in evaluation order.
public List<BNode> children(in Ctx c, for BNode n) uses alloc {
    var result = List<BNode>()
    let i = boundIndex(n)
    switch boundKind(n) {
        case .field:
            result.append(c.bFields[i].receiver)
        case .tupleElement:
            result.append(c.bTupleElements[i].receiver)
        case .unionField:
            result.append(c.bUnionFields[i].receiver)
        case .errorField:
            result.append(c.bErrorFields[i].receiver)
        case .call:
            if c.bCalls[i].receiver != -1 { result.append(c.bCalls[i].receiver) }
            for x in c.bCalls[i].arguments { result.append(x) }
        case .builtinCall:
            result.append(c.bBuiltinCalls[i].receiver)
            for x in c.bBuiltinCalls[i].arguments { result.append(x) }
        case .unary:
            result.append(c.bUnaries[i].operand)
        case .binary:
            result.append(c.bBinaries[i].left)
            result.append(c.bBinaries[i].right)
        case .conversion:
            result.append(c.bConversions[i].operand)
        case .tryFrom:
            result.append(c.bTryFroms[i].operand)
        case .conditional:
            result.append(c.bConditionals[i].condition)
            result.append(c.bConditionals[i].whenTrue)
            result.append(c.bConditionals[i].whenFalse)
        case .coalesce:
            result.append(c.bCoalesces[i].left)
            result.append(c.bCoalesces[i].right)
        case .structLiteral:
            for x in c.bStructLiterals[i].fields { result.append(x) }
            for x in c.bStructLiterals[i].payload { result.append(x) }
        case .unionNew:
            for x in c.bUnionNews[i].payload { result.append(x) }
        case .errorVariant:
            for x in c.bErrorVariants[i].payload { result.append(x) }
        case .withExpr:
            result.append(c.bWiths[i].target)
            for u in c.bWiths[i].updates { result.append(u.value) }
        case .tuple:
            for x in c.bTuples[i].elements { result.append(x) }
        case .collection:
            for x in c.bCollections[i].elements { result.append(x) }
        case .spread:
            result.append(c.bSpreads[i].operand)
        case .index:
            result.append(c.bIndexes[i].target)
            result.append(c.bIndexes[i].index)
        case .slice:
            result.append(c.bSlices[i].target)
            if c.bSlices[i].start != -1 { result.append(c.bSlices[i].start) }
            if c.bSlices[i].end != -1 { result.append(c.bSlices[i].end) }
        case .range:
            result.append(c.bRanges[i].start)
            result.append(c.bRanges[i].end)
        case .isExpr:
            result.append(c.bIses[i].value)
            result.append(c.bIses[i].pattern)
        case .switchExpr:
            result.append(c.bSwitchExprs[i].value)
            for a in c.bSwitchExprs[i].arms {
                result.append(a.pattern)
                if a.guard != -1 { result.append(a.guard) }
                result.append(a.value)
            }
        case .interpolated:
            for p in c.bInterpolateds[i].parts {
                if p.value != -1 { result.append(p.value) }
            }
        case .tryExpr:
            result.append(c.bTries[i].operand)
        case .moveExpr:
            result.append(c.bMoves[i].operand)
        case .catchExpr:
            result.append(c.bCatches[i].operand)
            result.append(c.bCatches[i].handler)
        case .jump:
            result.append(c.bJumps[i].jump)
        case .blockExpr:
            result.append(c.bBlockExprs[i].block)
        case .lambda:
            for x in c.bLambdas[i].captures { result.append(x) }
        case .block:
            for x in c.bBlocks[i].statements { result.append(x) }
        case .localDecl:
            if c.bLocalDecls[i].initializer != -1 { result.append(c.bLocalDecls[i].initializer) }
        case .exprStmt:
            result.append(c.bExprStmts[i].expr)
        case .assertStmt:
            result.append(c.bAsserts[i].condition)
        case .assign:
            result.append(c.bAssigns[i].target)
            result.append(c.bAssigns[i].value)
        case .returnStmt:
            if c.bReturns[i].value != -1 { result.append(c.bReturns[i].value) }
        case .failStmt:
            result.append(c.bFails[i].error)
        case .becomeStmt:
            for x in c.bBecomes[i].payload { result.append(x) }
        case .ifStmt:
            result.append(c.bIfs[i].condition)
            result.append(c.bIfs[i].then)
            if c.bIfs[i].elseBranch != -1 { result.append(c.bIfs[i].elseBranch) }
        case .whileStmt:
            result.append(c.bWhiles[i].condition)
            result.append(c.bWhiles[i].body)
        case .doWhile:
            result.append(c.bDoWhiles[i].body)
            result.append(c.bDoWhiles[i].condition)
        case .forStmt:
            result.append(c.bFors[i].iterable)
            result.append(c.bFors[i].body)
        case .switchStmt:
            result.append(c.bSwitches[i].value)
            for s in c.bSwitches[i].sections {
                if s.pattern != -1 { result.append(s.pattern) }
                if s.guard != -1 { result.append(s.guard) }
                for b in s.body { result.append(b) }
            }
        case .deferStmt:
            result.append(c.bDefers[i].body)
        case .errdeferStmt:
            result.append(c.bErrdefers[i].body)
        case .panicDefer:
            result.append(c.bPanicDefers[i].body)
        case .contextStmt:
            result.append(c.bContexts[i].allocator)
            result.append(c.bContexts[i].body)
        case .constantPattern:
            result.append(c.bConstantPatterns[i].value)
        case .relationalPattern:
            result.append(c.bRelationalPatterns[i].value)
        case .rangePattern:
            result.append(c.bRangePatterns[i].start)
            result.append(c.bRangePatterns[i].end)
        case .notPattern:
            result.append(c.bNotPatterns[i].operand)
        case .binaryPattern:
            result.append(c.bBinaryPatterns[i].left)
            result.append(c.bBinaryPatterns[i].right)
        case .propertyPattern:
            for s in c.bPropertyPatterns[i].subpatterns { result.append(s.pattern) }
        case .unionPattern:
            for x in c.bUnionPatterns[i].subpatterns { result.append(x) }
        case .errorPattern:
            for x in c.bErrorPatterns[i].subpatterns { result.append(x) }
        default:
            return result
    }
    return result
}

/// C# `BoundTree.Descendants`: the node and everything below it, pre-order.
public List<BNode> descendants(in Ctx c, for BNode n) uses alloc {
    var result = List<BNode>()
    var stack = List<BNode>()
    stack.append(n)
    while stack.length > 0 {
        let m = stack.removeLast()
        result.append(m)
        let ch = children(in c, for: m)
        var j = ch.length - 1
        while j >= 0 {
            stack.append(ch[j])
            j -= 1
        }
    }
    return result
}
