// ── Constants ──────────────────────────────────────────────────────────────────

/// What a `Constant` holds: C#'s boxed `Int128`, `double`, `bool`, `string` or `Rune` (Q536).
public enum ConstantKind {
    integer
    real
    flag
    text
    rune
}

/// C# `ConstantValue`: only the field named by `kind` is meaningful.
public struct Constant {
    public ConstantKind kind
    public Big integer = Big { lo: 0, hi: 0 }
    public f64 real = 0.0
    public bool flag = false
    public string text = ""
    public u32 rune = 0
}

/// `ConstantValue.ToString()`.
string constantText(in Constant k) {
    switch k.kind {
        case .integer: return bigText(k.integer)
        case .real: return realText(k.real)
        case .flag: return k.flag ? "true" : "false"
        case .text: return $"\"{k.text}\""
        case .rune: return $"{rune(k.rune)}"
    }
}

/// C#'s `double.ToString()` under the invariant culture: the shortest round-trip digits, in exponent form
/// `1E+20` / `1E-05` when the decimal exponent is at least 17 or below -4; `Infinity`, `-Infinity`, `NaN`.
public string realText(f64 v) uses alloc {
    if v != v { return "NaN" }
    let s = $"{v}"
    if s == "inf" { return "Infinity" }
    if s == "-inf" { return "-Infinity" }
    let b = s.bytes
    // Bayan prints the same shortest digits; re-lay them out C#'s way.
    var sb = StrBuf()
    var i = 0
    if i64(b[0]) == 45 {
        sb.append("-")
        i = 1
    }
    var d = List<i64>()
    var point = -1
    while i < b.length && i64(b[i]) != 101 {
        if i64(b[i]) == 46 {
            point = d.length
        } else {
            d.append(i64(b[i]) - 48)
        }
        i += 1
    }
    if point < 0 { point = d.length }
    var exp = 0
    if i < b.length {
        i += 1
        var negExp = false
        if i64(b[i]) == 45 {
            negExp = true
            i += 1
        }
        while i < b.length {
            exp = exp * 10 + i64(b[i]) - 48
            i += 1
        }
        if negExp { exp = -exp }
    }
    var lead = 0
    while lead < d.length && d[lead] == 0 { lead += 1 }
    if lead == d.length {
        sb.append("0")
        return $"{sb.finish()}"
    }
    var last = d.length - 1
    while d[last] == 0 { last -= 1 }
    // The decimal exponent of the first significant digit.
    let x = point - lead - 1 + exp
    if x >= 17 || x < -4 {
        sb.append($"{d[lead]}")
        if last > lead {
            sb.append(".")
            for j in lead + 1..last + 1 { sb.append($"{d[j]}") }
        }
        var ax = x
        if x < 0 {
            sb.append("E-")
            ax = -x
        } else {
            sb.append("E+")
        }
        if ax < 10 { sb.append("0") }
        sb.append($"{ax}")
        return $"{sb.finish()}"
    }
    if x < 0 {
        sb.append("0.")
        for j in 0..-x - 1 { sb.append("0") }
        for j in lead..last + 1 { sb.append($"{d[j]}") }
        return $"{sb.finish()}"
    }
    for j in 0..x + 1 {
        if lead + j <= last {
            sb.append($"{d[lead + j]}")
        } else {
            sb.append("0")
        }
    }
    if lead + x < last {
        sb.append(".")
        for j in lead + x + 1..last + 1 { sb.append($"{d[j]}") }
    }
    return $"{sb.finish()}"
}

// ── Handles ────────────────────────────────────────────────────────────────────

public BNode makeBound(BoundKind kind, at i64 index) => (i64(kind.ordinal) << 32) | index

public BoundKind boundKind(BNode n) => BoundKind.fromOrdinal(n >> 32) ?? .errorExpr

i64 boundIndex(BNode n) => n & 0xFFFFFFFF

public bool isStmtKind(BoundKind k) => k.ordinal >= BoundKind.block.ordinal && k.ordinal <= BoundKind.errorStmt.ordinal

public bool isPatternKind(BoundKind k) {
    switch k {
        case .constantPattern or .relationalPattern or .rangePattern or .bindPattern or .notPattern or .binaryPattern
            or .propertyPattern or .unionPattern or .errorPattern:
            return true
        default:
            return false
    }
}

public bool isExprKind(BoundKind k) => !isStmtKind(k) && !isPatternKind(k)

// ── Constants and syntax facts keyed by handle ──────────────────────────────────

/// C# `BoundExpr.Constant`; null when `e` is not a compile-time constant.
public Constant? exprConstant(in Ctx c, for BExpr e) => c.constants.tryGet(at: e)

public void setConstant(ref Ctx c, for BExpr e, to Constant k) uses alloc {
    c.constants[e] = k
}

/// `Syntax is LiteralExpr` (BinderExpressions.cs:94, :1496).
const syntaxLiteral: i64 = 1
/// `Syntax is UnaryExpr` (BinderExpressions.cs:1496).
const syntaxUnary: i64 = 2
/// `Syntax is Expr x && IsUntypedLiteral(x)` (BinderExpressions.cs:249).
const syntaxUntypedLiteral: i64 = 4
/// `Syntax is DiscardPattern` (BinderCalls.cs:1590).
const syntaxDiscard: i64 = 8
/// `Syntax is CallExpr` on a builtin method call (RegionAnalysis.cs:451: `sb.finish()`, not `sb.view`).
const syntaxCall: i64 = 16

/// The `syntax…` bits recorded for `n` (0 when none were).
i64 syntaxFlags(in Ctx c, for BNode n) => c.syntaxFlags.tryGet(at: n) ?? 0

/// Records the `syntax…` bits of the node C# would build from the same `Syntax`.
public void setSyntaxFlags(ref Ctx c, for BNode n, to i64 flags) uses alloc {
    c.syntaxFlags[n] = flags
}

public bool hasSyntax(in Ctx c, for BNode n, by i64 flag) => (syntaxFlags(in c, for: n) & flag) != 0

// ── Syntax nodes (T21, Q849, Q850) ─────────────────────────────────────────────

/// The case of a recorded `parser.Expr`: the C# record type of `BoundNode.Syntax` when it is an `Expr`.
public enum ExprSyntaxKind {
    literalExpr
    interpolatedExpr
    nameExpr
    thisExpr
    memberExpr
    targetMemberExpr
    callExpr
    indexExpr
    unaryExpr
    binaryExpr
    rangeExpr
    conditionalExpr
    castExpr
    isExpr
    exceptExpr
    inExpr
    switchExpr
    tryExpr
    moveExpr
    catchExpr
    caughtErrorExpr
    jumpExpr
    blockExpr
    structLiteralExpr
    withExpr
    spreadExpr
    mapEntryExpr
    collectionExpr
    tupleExpr
    parenExpr
    lambdaExpr
    stackallocExpr
    patternExpr
    errorExpr
}

/// A recorded `parser.Expr` (a non-owning copy, since `parser.Expr` owns its children): its case and span, and the
/// children `Lowerer.Anchor` and `IsLiteral` walk, as handles into `Ctx.exprSyntaxNodes` (-1 when the case has none).
public struct ExprSyntax {
    public ExprSyntaxKind kind
    public TextSpan span
    /// `ParenExpr.Inner`.
    public i64 inner = -1
    /// `MemberExpr.Member`.
    public TextSpan member = TextSpan { start: 0, length: 0 }
    /// `CallExpr.Callee`.
    public i64 callee = -1
    /// `BinaryExpr.Left`.
    public i64 left = -1
    /// `IsExpr.Value`.
    public i64 value = -1
    /// `IndexExpr.Target`.
    public i64 target = -1
    /// `ConditionalExpr.Condition`.
    public i64 condition = -1
    /// `UnaryExpr.Operand` and `UnaryExpr.Op`.
    public i64 operand = -1
    public parser.UnaryOp op = .plus
    /// P2: `BinaryExpr.Op` and `BinaryExpr.Right.Span` (Mutator.cs:105, :165).
    public parser.BinaryOp binaryOp = .add
    public TextSpan right = TextSpan { start: 0, length: 0 }
    /// P2: `LiteralExpr.Kind` and `LiteralExpr.Suffix.Span`, null when it has none (Mutator.cs:173, :205).
    public parser.LiteralKind literalKind = .integer
    public TextSpan? suffix = null
    /// P2: `CallExpr.Because` is not null (Features.cs:46).
    public bool becauseKeyword = false
}

/// C# `n.Syntax` when it is an `Expr`, else null.
public ExprSyntax? exprSyntax(in Ctx c, for BNode n) {
    let h = c.exprSyntaxOf.tryGet(at: n) ?? -1
    if h == -1 { return null }
    return c.exprSyntaxNodes[h]
}

/// The child `node` of a recorded syntax node (its `inner`, `callee`, … handle).
public ExprSyntax exprSyntaxNode(in Ctx c, at i64 node) => c.exprSyntaxNodes[node]

/// Records `e` (with the children `exprSyntax` gives) and returns its handle; -1 for `.none`.
i64 syntaxNode(ref Ctx c, from in parser.Expr e) uses alloc {
    switch e {
        case .literalExpr(let x):
            return syntaxOfLiteral(ref c, from: in x.value)
        case .interpolatedExpr(let x):
            return syntaxLeaf(ref c, as: .interpolatedExpr, at: x.value.span)
        case .nameExpr(let x):
            return syntaxLeaf(ref c, as: .nameExpr, at: x.value.span)
        case .thisExpr(let x):
            return syntaxLeaf(ref c, as: .thisExpr, at: x.value.span)
        case .memberExpr(let x):
            return syntaxOfMember(ref c, from: in x.value)
        case .targetMemberExpr(let x):
            return syntaxLeaf(ref c, as: .targetMemberExpr, at: x.value.span)
        case .callExpr(let x):
            return syntaxOfCall(ref c, from: in x.value)
        case .indexExpr(let x):
            return syntaxOfIndex(ref c, from: in x.value)
        case .unaryExpr(let x):
            return syntaxOfUnary(ref c, from: in x.value)
        case .binaryExpr(let x):
            return syntaxOfBinary(ref c, from: in x.value)
        case .rangeExpr(let x):
            return syntaxLeaf(ref c, as: .rangeExpr, at: x.value.span)
        case .conditionalExpr(let x):
            return syntaxOfConditional(ref c, from: in x.value)
        case .castExpr(let x):
            return syntaxLeaf(ref c, as: .castExpr, at: x.value.span)
        case .isExpr(let x):
            return syntaxOfIs(ref c, from: in x.value)
        case .exceptExpr(let x):
            return syntaxLeaf(ref c, as: .exceptExpr, at: x.value.span)
        case .inExpr(let x):
            return syntaxLeaf(ref c, as: .inExpr, at: x.value.span)
        case .switchExpr(let x):
            return syntaxLeaf(ref c, as: .switchExpr, at: x.value.span)
        case .tryExpr(let x):
            return syntaxLeaf(ref c, as: .tryExpr, at: x.value.span)
        case .moveExpr(let x):
            return syntaxLeaf(ref c, as: .moveExpr, at: x.value.span)
        case .catchExpr(let x):
            return syntaxLeaf(ref c, as: .catchExpr, at: x.value.span)
        case .caughtErrorExpr(let x):
            return syntaxLeaf(ref c, as: .caughtErrorExpr, at: x.value.span)
        case .jumpExpr(let x):
            return syntaxLeaf(ref c, as: .jumpExpr, at: x.value.span)
        case .blockExpr(let x):
            return syntaxLeaf(ref c, as: .blockExpr, at: x.value.span)
        case .structLiteralExpr(let x):
            return syntaxLeaf(ref c, as: .structLiteralExpr, at: x.value.span)
        case .withExpr(let x):
            return syntaxLeaf(ref c, as: .withExpr, at: x.value.span)
        case .spreadExpr(let x):
            return syntaxLeaf(ref c, as: .spreadExpr, at: x.value.span)
        case .mapEntryExpr(let x):
            // coverage-exempt: Q853
            return syntaxLeaf(ref c, as: .mapEntryExpr, at: x.value.span)
        case .collectionExpr(let x):
            return syntaxLeaf(ref c, as: .collectionExpr, at: x.value.span)
        case .tupleExpr(let x):
            return syntaxLeaf(ref c, as: .tupleExpr, at: x.value.span)
        case .parenExpr(let x):
            return syntaxOfParen(ref c, from: in x.value)
        case .lambdaExpr(let x):
            return syntaxLeaf(ref c, as: .lambdaExpr, at: x.value.span)
        case .stackallocExpr(let x):
            return syntaxLeaf(ref c, as: .stackallocExpr, at: x.value.span)
        case .patternExpr(let x):
            return syntaxLeaf(ref c, as: .patternExpr, at: x.value.span)
        case .errorExpr(let x):
            // coverage-exempt: Q853 through `return -1`
            return syntaxLeaf(ref c, as: .errorExpr, at: x.value.span)
        case .none:
            return -1
    }
}

/// Records a syntax node with no walked children.
i64 syntaxLeaf(ref Ctx c, as ExprSyntaxKind kind, at TextSpan span) uses alloc => syntaxAppend(ref c, from: ExprSyntax { kind: kind, span: span })

i64 syntaxAppend(ref Ctx c, from ExprSyntax node) uses alloc {
    c.exprSyntaxNodes.append(node)
    return c.exprSyntaxNodes.length - 1
}

/// Records a `ParenExpr` and the `Inner` child it walks.
i64 syntaxOfParen(ref Ctx c, from in parser.ParenExpr x) uses alloc {
    let inner = syntaxNode(ref c, from: in x.inner)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .parenExpr, span: x.span, inner: inner })
}

/// Records a `MemberExpr` and its `Member` name.
/// A synthetic `for try` member name (`t28SyntheticName`) is its C# span, `f.Iterable.Span` (Q739).
i64 syntaxOfMember(ref Ctx c, from in parser.MemberExpr x) uses alloc => syntaxAppend(ref c, from: ExprSyntax { kind: .memberExpr, span: x.span, member: t40RealSpan(in c, for: x.member) })

/// Records a `CallExpr` and the `Callee` child it walks.
i64 syntaxOfCall(ref Ctx c, from in parser.CallExpr x) uses alloc {
    let callee = syntaxNode(ref c, from: in x.callee)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .callExpr, span: x.span, callee: callee, becauseKeyword: x.becauseKeyword is not null })
}

/// Records a `LiteralExpr`, its `Kind` and its `Suffix`.
i64 syntaxOfLiteral(ref Ctx c, from in parser.LiteralExpr x) uses alloc => syntaxAppend(ref c, from: ExprSyntax { kind: .literalExpr, span: x.span, literalKind: x.kind, suffix: x.suffix })

/// Records a `BinaryExpr` and the `Left` child it walks.
i64 syntaxOfBinary(ref Ctx c, from in parser.BinaryExpr x) uses alloc {
    let left = syntaxNode(ref c, from: in x.left)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .binaryExpr, span: x.span, left: left, binaryOp: x.op, right: parser.exprSpan(in x.right) })
}

/// Records an `IsExpr` and the `Value` child it walks.
i64 syntaxOfIs(ref Ctx c, from in parser.IsExpr x) uses alloc {
    let value = syntaxNode(ref c, from: in x.value)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .isExpr, span: x.span, value: value })
}

/// Records an `IndexExpr` and the `Target` child it walks.
i64 syntaxOfIndex(ref Ctx c, from in parser.IndexExpr x) uses alloc {
    let target = syntaxNode(ref c, from: in x.target)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .indexExpr, span: x.span, target: target })
}

/// Records a `ConditionalExpr` and the `Condition` child it walks.
i64 syntaxOfConditional(ref Ctx c, from in parser.ConditionalExpr x) uses alloc {
    let condition = syntaxNode(ref c, from: in x.condition)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .conditionalExpr, span: x.span, condition: condition })
}

/// Records a `UnaryExpr`, its `Op` and the `Operand` child it walks.
i64 syntaxOfUnary(ref Ctx c, from in parser.UnaryExpr x) uses alloc {
    let operand = syntaxNode(ref c, from: in x.operand)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .unaryExpr, span: x.span, operand: operand, op: x.op })
}

/// Records `n`'s syntax as the node `h` (-1 records nothing) and returns `n`.
BNode recordSyntaxNode(ref Ctx c, for BNode n, at i64 h) uses alloc {
    if h != -1 { c.exprSyntaxOf[n] = h }
    return n
}

/// `n`, built with `Syntax = e`.
BNode recordSyntax(ref Ctx c, for BNode n, from in parser.Expr e) uses alloc => recordSyntaxNode(ref c, for: n, at: syntaxNode(ref c, from: in e))

/// `n`, built with `Syntax = value.Syntax`.
BNode shareSyntax(ref Ctx c, for BNode n, from BNode value) uses alloc {
    let h = c.nodeSyntaxOf.tryGet(at: value) ?? -1
    if h != -1 { c.nodeSyntaxOf[n] = h }
    return recordSyntaxNode(ref c, for: n, at: c.exprSyntaxOf.tryGet(at: value) ?? -1)
}

// ── Other syntax nodes (P2, Q1076, Q1096) ──────────────────────────────────────

/// The C# record type of `BoundNode.Syntax` when it is not an `Expr`: every `Stmt` and `Pattern` case, then the
/// other nodes the binder builds from (a `requires` rule, top-level statements, a struct, a name, a parameter, an argument).
public enum NodeSyntaxKind {
    blockStmt
    localDecl
    exprStmt
    assignStmt
    incDecStmt
    returnStmt
    failStmt
    breakStmt
    continueStmt
    becomeStmt
    ifStmt
    unlessStmt
    guardedStmt
    whileStmt
    doWhileStmt
    whileLetStmt
    forStmt
    labeledStmt
    switchStmt
    deferStmt
    assertStmt
    contextStmt
    emptyStmt
    errorStmt
    constantPattern
    relationalPattern
    varPattern
    discardPattern
    declarationPattern
    notPattern
    binaryPattern
    propertyPattern
    positionalPattern
    variantPattern
    slicePattern
    listPattern
    requiresRule
    globalStatement
    functionDecl
    structDecl
    name
    param
    argument
}

/// A recorded non-`Expr` syntax node: its case and span, and what `Mutator` reads from an `AssignStmt` (`Op`,
/// `Target.Span`, `Value.Span`) or a `ReturnStmt` (`Value.Span`, null when it has none).
public struct NodeSyntax {
    public NodeSyntaxKind kind
    public TextSpan span
    public parser.AssignOp assignOp = .assign
    public TextSpan target = TextSpan { start: 0, length: 0 }
    public TextSpan? value = null
}

/// C# `n.Syntax` when it is not an `Expr`, else null.
public NodeSyntax? nodeSyntax(in Ctx c, for BNode n) {
    let h = c.nodeSyntaxOf.tryGet(at: n) ?? -1
    if h == -1 { return null }
    return c.nodeSyntaxNodes[h]
}

/// `n`, built with `Syntax` a node of `kind` at `span` that is not an `Expr`.
BNode recordNodeSyntax(ref Ctx c, for BNode n, as NodeSyntaxKind kind, at TextSpan span) uses alloc => recordNodeSyntaxOf(ref c, for: n, from: NodeSyntax { kind: kind, span: span })

BNode recordNodeSyntaxOf(ref Ctx c, for BNode n, from NodeSyntax node) uses alloc {
    c.nodeSyntaxNodes.append(node)
    c.nodeSyntaxOf[n] = c.nodeSyntaxNodes.length - 1
    return n
}

/// `n`, built with `Syntax = s`, an `AssignStmt`.
BNode recordAssignSyntax(ref Ctx c, for BNode n, from in parser.AssignStmt s) uses alloc => recordNodeSyntaxOf(ref c, for: n, from: NodeSyntax { kind: .assignStmt, span: s.span, assignOp: s.op, target: parser.exprSpan(in s.target), value: parser.exprSpan(in s.value) })

/// `n`, built with `Syntax = s`, a `ReturnStmt`.
BNode recordReturnSyntax(ref Ctx c, for BNode n, from in parser.ReturnStmt s) uses alloc {
    if s.value is .none { return recordNodeSyntax(ref c, for: n, as: .returnStmt, at: s.span) }
    return recordNodeSyntaxOf(ref c, for: n, from: NodeSyntax { kind: .returnStmt, span: s.span, value: parser.exprSpan(in s.value) })
}

/// `n`, built with `Syntax = s`; `.none` records nothing.
BNode recordStmtSyntax(ref Ctx c, for BNode n, from in parser.Stmt s) uses alloc {
    let span = parser.stmtSpan(in s)
    switch s {
        case .blockStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .blockStmt, at: span)
        // coverage-exempt: Q1105 through `return n`
        case .localDecl(_):
            return recordNodeSyntax(ref c, for: n, as: .localDecl, at: span)
        case .exprStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .exprStmt, at: span)
        case .assignStmt(let x):
            return recordAssignSyntax(ref c, for: n, from: in x.value)
        case .incDecStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .incDecStmt, at: span)
        case .returnStmt(let x):
            return recordReturnSyntax(ref c, for: n, from: in x.value)
        case .failStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .failStmt, at: span)
        case .breakStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .breakStmt, at: span)
        case .continueStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .continueStmt, at: span)
        case .becomeStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .becomeStmt, at: span)
        case .ifStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .ifStmt, at: span)
        case .unlessStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .unlessStmt, at: span)
        case .guardedStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .guardedStmt, at: span)
        case .whileStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .whileStmt, at: span)
        case .doWhileStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .doWhileStmt, at: span)
        case .whileLetStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .whileLetStmt, at: span)
        case .forStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .forStmt, at: span)
        case .labeledStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .labeledStmt, at: span)
        case .switchStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .switchStmt, at: span)
        case .deferStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .deferStmt, at: span)
        case .assertStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .assertStmt, at: span)
        case .contextStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .contextStmt, at: span)
        case .emptyStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .emptyStmt, at: span)
        case .errorStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .errorStmt, at: span)
        case .none:
            return n
    }
}

/// `n`, built with `Syntax = p`.
BNode recordPatternSyntax(ref Ctx c, for BNode n, from in parser.Pattern p) uses alloc {
    // coverage-exempt: Q1105 through `return n`
    if (patternSyntax(in p) is { } s) { return recordNodeSyntaxOf(ref c, for: n, from: s) }
    return n
}

/// The `Syntax` a pattern node built from `p` records; null for `.none`.
NodeSyntax? patternSyntax(in parser.Pattern p) {
    let span = parser.patternSpan(in p)
    switch p {
        case .constantPattern(_):
            // coverage-exempt: Q1105
            return NodeSyntax { kind: .constantPattern, span: span }
        case .relationalPattern(_):
            return NodeSyntax { kind: .relationalPattern, span: span }
        case .varPattern(_):
            return NodeSyntax { kind: .varPattern, span: span }
        case .discardPattern(_):
            return NodeSyntax { kind: .discardPattern, span: span }
        case .declarationPattern(_):
            return NodeSyntax { kind: .declarationPattern, span: span }
        case .notPattern(_):
            return NodeSyntax { kind: .notPattern, span: span }
        case .binaryPattern(_):
            return NodeSyntax { kind: .binaryPattern, span: span }
        case .propertyPattern(_):
            // coverage-exempt: Q1105
            return NodeSyntax { kind: .propertyPattern, span: span }
        case .positionalPattern(_):
            return NodeSyntax { kind: .positionalPattern, span: span }
        case .variantPattern(_):
            return NodeSyntax { kind: .variantPattern, span: span }
        case .slicePattern(_):
            // coverage-exempt: Q1105
            return NodeSyntax { kind: .slicePattern, span: span }
        case .listPattern(_):
            return NodeSyntax { kind: .listPattern, span: span }
        case .none:
            // coverage-exempt: Q1105
            return null
    }
}

