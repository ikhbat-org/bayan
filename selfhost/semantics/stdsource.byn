const stdSource0: string = """// Tests of std.json. Expected encodings are python3 `json.dumps` output (indent 0 is `json.dumps(v)`, N is
// `json.dumps(v, indent=N)`) for `json.loads` of the input, recorded from a run, not written by hand.

/// The tree of `text`, trusted for the test.
JsonValue tree(string text) fails JsonError uses alloc {
    return (try Json.parse(text)).trustUnchecked() because "test input is a literal"
}

/// `ok`, or the error `Json.parse(text)` fails with, as `describe` writes it.
string errorOf(string text) uses alloc {
    let _ = Json.parse(text) catch switch {
        JsonError e => return describe(e),
    }
    return "ok"
}

/// `ok`, or the error `Json.encode(v)` fails with, as `describe` writes it.
string encodeErrorOf(JsonValue v) uses alloc {
    let _ = Json.encode(v) catch switch {
        JsonError e => return describe(e),
    }
    return "ok"
}

/// `e` as `kind message @offset line:column`, or its kind alone when it has no position.
string describe(JsonError e) uses alloc => e switch {
    .syntax s => $"syntax {s.message} @{s.offset} {s.line}:{s.column}",
    .tooDeep d => $"tooDeep @{d.offset} {d.line}:{d.column}",
    .nonFinite => "nonFinite",
    .nestedTooDeep => "nestedTooDeep",
}

/// `depth` lists, each holding the next, around `null`.
JsonValue nested(i64 depth) uses alloc {
    var v = JsonValue.nothing
    for _ in 0..depth {
        var items = List<JsonValue>()
        items.append(move v)
        v = .list(items: move items)
    }
    return v
}

/// The tokens of `text`, one word each.
string tokensOf(string text) fails JsonError uses alloc {
    var reader = JsonReader.over(text)
    var sb = StrBuf()
    while true {
        let token = (try reader.next()) ?? break
        let word = token switch {
            .startObject => "{",
            .endObject => "}",
            .startList => "[",
            .endList => "]",
            .key(let name) => $"key:{name}",
            .text(let value) => $"text:{value}",
            .number(let value, let digits) => $"number:{value}/{digits}",
            .flag(let value) => $"flag:{value}",
            .nothing => "null",
        }
        sb.append($"{word} ")
    }
    return $"{sb.finish()}"
}

@cases(
