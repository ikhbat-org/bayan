    .borrowCrossesFiber => "`{0}` holds a reference into `{1}` and cannot be passed to a fiber that may outlive it",
    .requiresMixesFields => "this `requires` reads `it` and other fields",
    .unknownMutationOperator => "`{0}` is not a mutation operator",
    .manifestNotData => "`package.byn` is data only: expected {0}",
    .manifestUnknownField => "`{0}` is not a field of `{1}`",
    .manifestInvalidValue => "`{0}` must be {1}",
    .manifestMissingField => "`package.byn` has no `{0}`",
    .manifestEquals => "`package.byn` uses `field: value`",
    .cCompilerRejected => "internal compiler error: the C compiler rejected the generated C; this is a bug in the Bayan compiler",
    .participleChangesThis => "`{0}` changes `this`; name it `{1}`",
    .stateMemberMutates => "`{0}` reads as state but modifies `this`",
    .tryWrongReturn => "`try{0}` must return `{1}?` or `bool`; it is derived from `{2}() fails`",
    .particleRequired => "`{0}` has {1} unlabeled parameters; give each but one a particle",
    .argumentNeedsParticle => "`{0}` is passed without its particle `{1}:`",
    .parameterNeedsParticle => "`{0}` is a required parameter besides the object and needs a particle",
    .logLevelAsVerb => "`Log.{0}` names a level, not the act; write `log(…, as: .{0})`",
    .unknownParticle => "`{0}` is not a particle",
    .particleAsMemberName => "`{0}` is a particle; name the member with a verb or a noun",
    .conversionMember => "`{0}` spells a conversion with `{1}`; write `{2}`",
    .expectsSingleParameter => "this `expects` reads only `{0}`; a type with `requires` checks it once",
    .repeatedParticle => "`{0}` uses the particle `{1}` twice",
    .unknownWord => "`{0}` is not a known verb or noun",
    .nounOnMutator => "`{0}` is a noun on a `ref this` member; name the action",
    .boolWithoutPrefix => "`{0}` is a `bool` state; prefix with `is`, `has` or `can`",
    .noallocRemoved => "`{0}` is removed; a function without `uses` is already pure",
    .effectNotDeclared => "`{0}` uses `{1}` but does not declare it",
    .unknownEffect => "`{0}` is not an effect",
    .capabilityExceeded => "`{0}` uses `{1}`, which package `{2}` does not declare in `capabilities`",
    .effectBoundExceeded => "`{0}` uses `{1}`, beyond the bound `{2}` declared by `{3}`",
    .contextBlockInput => "`context (…) {{ }}` is now `provide … {{ }}`",
    .unknownHandler => "`{0}` is not a handler; `provide` takes `alloc`, `net`, `fs`, `clock`, `random`, `env`, `process`, `console` or `log`",
    .wrongState => "`{0}` needs `{1}` to be `.{2}`, but it is `{3}`",
    .payloadNotInState => "`{0}` is a payload of `.{1}`; `{2}` is not known to be `.{1}`",
    .becomeUndeclared => "`become` needs `becomes .{0}` on `{1}`",
    .becomeOtherState => "`become .{0}` is not declared; `{1}` becomes `.{2}`",
    .becomesCallUndeclared => "`{0}` calls `{1}`, which changes the state; declare `becomes` on `{0}`",
    .stateSwitchNotExhaustive => "the switch does not handle state `.{0}`",
    .stateLiteralNeedsState => "`{0}` has states; a literal must name one: `{0}.{1} {{ … }}`",
    .singleStateInline => "`{0} is .{1}` is an input form; write `{2}`",
    .unknownState => "`{0}` has no state `.{1}`",
    .stateShadowsStatic => "state `.{0}` has the same name as static member `{1}.{0}`",
    .missingBecome => "`{0}` declares `becomes .{1}` but returns here without `become`",
    .becomesNeedsRef => "`{0}` declares `becomes .{1}` but takes `{2}`; a transition needs `ref this`",
    .becomesOnRefParameter => "`{0}` changes the state of `{1}`, a `ref` parameter; a state changes in place only through `ref this`",
    .assignmentChangesState => "`{0}` would change state here; a state changes only through `become`",
    .missingBecause => "`{0}` bypasses a safety rule and needs `because \"…\"`",
    .expectsReadsUntrusted => "`expects` reads `{0}`, which is `Untrusted`; a violation would trap on outside data",
}

/// `Warning(...)` in C#; every other descriptor is an error.
bool isWarning(SemaCode code) => code switch {
    .sameTypeShadowing or .spanParameterNeverWritten or .neverReassignedVar or
    .unreachableCode or .wildcardOnLocalUnion or .expectsSingleParameter or .unknownWord or
    .nounOnMutator or .boolWithoutPrefix => true,
    _ => false,
}

/// Every case, in order (the test prints the whole table from it).
List<SemaCode> allSemaCodes() {
    var codes = List<SemaCode>()
    for code in SemaCode.values { codes.append(code) }
    return codes
}

/// `string.Format` for the templates above: `{0}`-`{4}` are replaced and `{{`/`}}` unescaped. Text is
/// copied in runs between braces, so a slice never splits a code point.
string format(string template, by (string a0, string a1, string a2, string a3, string a4) args) {
    var sb = StrBuf()
    let t = template.bytes
    var i: i64 = 0
    var run: i64 = 0
    while i < t.length {
        let b = t[i]
        if (b == '{' || b == '}') && i + 1 < t.length && t[i + 1] == b {
            sb.append(template[run..i + 1])
            i += 2
            run = i
        } else if b == '{' && i + 2 < t.length && t[i + 2] == '}' {
            sb.append(template[run..i])
            sb.append(t[i + 1] == '0' ? args.a0 : t[i + 1] == '1' ? args.a1 : t[i + 1] == '2' ? args.a2 : t[i + 1] == '3' ? args.a3 : t[i + 1] == '4' ? args.a4 : "")
            i += 3
            run = i
        } else {
            i += 1
        }
    }
    sb.append(template[run..t.length])
    return $"{sb.finish()}"
}

