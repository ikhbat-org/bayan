/// The message template, in `string.Format` syntax (`{{`/`}}` unescape; `{0}`-`{4}` substitute).
string messageFormat(SemaCode code) => code switch {
    .modifierNotAllowed => "`{0}` is not allowed here",
    .tryCoversMore => "`try` covers `{0}`, which cannot fail",
    .returnErrorInput => "`return .{0}` returns an error; write `fail .{0}`",
    .undefinedName => "`{0}` is not defined",
    .unknownType => "unknown type `{0}`",
    .unknownMember => "`{0}` is not a member of `{1}`",
    .unknownModule => "no module `{0}`",
    .notVisible => "`{0}` is not visible here",
    .duplicateDeclaration => "`{0}` is declared twice",
    .shadowing => "`{0}` is already a local here",
    .typeCasing => "type name `{0}` must be PascalCase",
    .valueCasing => "`{0}` must be camelCase",
    .importCycle => "import cycle: {0}",
    .circularAlias => "type alias `{0}` refers to itself",
    .circularConstant => "constant `{0}` depends on itself",
    .duplicateMain => "the program has two entry points",
    .noMain => "the program has no entry point",
    .statementOutsideEntry => "top-level statements are allowed only in the entry module",
    .instanceMemberWithoutThis => "`{0}` needs an instance",
    .thisOutsideMethod => "`this` is only available inside instance methods",
    .notAValue => "`{0}` is a {1}, not a value",
    .unknownLabel => "no enclosing loop is labeled `{0}`",
    .unknownParameter => "`{0}` has no parameter `{1}`",
    .unsupported => "{0} is not supported in v0.1",
    .wrongTypeArgumentCount => "`{0}` takes {1} type argument(s), not {2}",
    .nestedOptional => "`{0}?` is already optional",
    .voidValue => "`void` is not a value type",
    .declarationAsBody => "a declaration cannot be the whole body of a statement",
    .nullEquality => "compare with `is null` / `is not null`, not `==`",
    .sameTypeShadowing => "`{0}` shadows an earlier `{0}` of the same type `{1}`",
    .nestedIt => "`it` inside a lambda that already uses `it`; name one lambda",
    .toStringCall => "Bayan has no `toString()`; display is `format()` (derived from `formatInto(ref StrBuf)`)",
    .unknownStdModule => "no std module `{0}`",
    .missingInitializer => "`{0} {1}` needs a value",
    .useBeforeAssign => "`{0}` is used before it is assigned",
    .outNotAssigned => "`out` parameter `{0}` is not assigned on every path",
    .immutableAssignment => "`{0}` is immutable",
    .readonlyField => "field `{0}` is readonly",
    .mutateTemporary => "cannot modify this value",
    .getterMutates => "property `{0}` modifies the value",
    .requiredWithDefault => "required field `{0}` has a default value",
    .missingFields => "`{0}` needs a value for `{1}`",
    .duplicateFieldInit => "field `{0}` is set twice",
    .literalWithConstructor => "`{0}` has a constructor; call it instead of using a struct literal",
    .noConstructor => "`{0}` has no constructor",
    .recursiveStruct => "struct `{0}` contains itself",
    .notAStruct => "`{0}` is not a struct",
    .mutatesWithoutRefThis => "`{0}` modifies `this` but is not declared `ref this`",
    .refThisOnOperator => "operators cannot take `ref this`",
    .refThisNotFirst => "`ref this` must be the first parameter",
    .stringIndexer => "a `string` cannot be indexed",
    .typeMismatch => "expected `{1}`, found `{0}`",
    .literalOutOfRange => "{0} does not fit in {1}",
    .constantOverflow => "constant arithmetic overflows `{0}`",
    .divisionByZero => "division by zero",
    .invalidCast => "cannot convert `{0}` to `{1}`",
    .badUnaryOperand => "`{0}` cannot be applied to `{1}`",
    .badBinaryOperands => "`{0}` cannot be applied to `{1}` and `{2}`",
    .stringConcatenation => "strings cannot be joined with `+`; use interpolation",
    .coalesceNotOptional => "`??` needs an optional value on the left, found `{0}`",
    .memberOfOptional => "`{0}` is not a member of `{1}`; the value may be null",
    .notIndexable => "`{0}` cannot be indexed",
    .indexOutOfRange => "index {0} is out of range for `{1}`",
    .fromEndOutsideIndex => "`^` is only allowed inside an index or slice",
    .openRange => "a range needs both ends here",
    .branchTypeMismatch => "branches have different types: `{0}` and `{1}`",
    .cannotInferType => "cannot infer the type of `{0}`",
    .noTargetType => "`{0}` needs a known type here",
    .notConstant => "{0} must be a compile-time constant",
    .notCallable => "`{0}` cannot be called",
    .notIterable => "`{0}` cannot be iterated",
    .arrayLengthMismatch => "`{0}` needs exactly its length in elements, found {1}",
    .tupleNameMismatch => "tuple element `{0}` is named `{1}` in the target type",
    .interpolationNotAllowed => "an interpolated string must be passed directly to an output",
    .notFormattable => "`{0}` cannot be formatted",
    .notDisposable => "`using` needs a value that owns memory, not `{0}`",
    .ambiguousVariant => "`.{0}` is ambiguous; it exists in `{1}`",
    .unknownVariant => "`{0}` is not a variant of `{1}`",
    .invalidConstArray => "module-level `const` array `{0}` must hold literal numbers, `bool`s, `rune`s or `string`s",
    .renamedMember => "`{0}` is now `{1}`",
    .whileLetNotOptional => "`while let` needs a `T?` value, got `{0}`",
    .spreadNotSequence => "`..{0}` spreads a `{1}`, which is not a sequence",
    .mapLiteralMixed => "a map literal needs `key: value` in every element",
    .missingArgument => "missing argument `{0}` for `{1}`",
    .tooManyArguments => "`{0}` takes {1} argument(s)",
    .duplicateArgument => "`{0}` is passed twice",
    .positionalAfterNamed => "a positional argument cannot follow a named one",
    .argumentMustBeNamed => "argument for `{0}` must be named",
    .argumentModifierMismatch => "argument for `{0}` must be passed as {1}",
    .retiredArgumentsSwapped => "retired: particles replace the same-type naming rule",
    .spanParameterNeverWritten => "`{0}` is never written through; use `ReadOnlySpan<{1}>`",
    .neverReassignedVar => "`{0}` is never reassigned; declare it with `let`",
    .requiresNotBool => "a `requires` clause must be `bool`, got `{0}`",
    .requiresViolated => "`{0}` violates `requires {1}` of `{2}`",
    .retiredRequiresNotHere => "retired: `requires` is checked at construction",
    .missingReturn => "`{0}` must return `{1}` on every path",
    .missingReturnValue => "this function returns `{0}`; `return` needs a value",
    .returnValueInVoid => "`{0}` returns nothing, but `return` has a value",
    .neverReturns => "`{0}` returns `never` but can reach its end",
    .unreachableCode => "unreachable code",
    .jumpOutsideLoop => "`{0}` outside a loop",
    .continueSwitch => "`continue {0}` refers to a `switch`, not a loop",
    .labelNotOnLoop => "label `{0}` must be on a loop or `switch`",
    .duplicateDefault => "`switch` has more than one `default` section",
    .nonExhaustive => "`switch` does not handle every `{0}`",
    .patternMismatch => "{0} cannot match `{1}`",
    .tryInDefer => "`try` is not allowed in `defer`",
    .unhandledFailure => "`{0}` can fail; handle the error or pass it on",
    .undeclaredError => "`{0}` is not in the `fails` clause of `{1}`",
    .propagateFromInfallible => "`{0}` cannot fail, so it cannot pass on `{1}`",
    .nothingToHandle => "`{0}` needs a call that can fail",
    .errdeferWithoutFails => "`defer failing` in a function that cannot fail",
    .publicInferredFails => "public function `{0}` must list its errors",
    .notAnErrorSet => "`{0}` is not an error enum",
    .emptyErrorSet => "error enum `{0}` has no variants",
    .jumpOutOfDefer => "`{0}` cannot leave a `defer` or `defer failing` body",
