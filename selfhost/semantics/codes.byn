// T2: Bayan.Syntax/Diagnostics/DiagnosticCodes.cs, BYN2xxx-BYN8xxx plus BYN1016/1054/1056.
//
// The semantic message table: every descriptor in the BYN2000-BYN8999 ranges, in `DiagnosticCodes.cs`
// order, plus the three BYN1xxx codes the checker reports (Q526). Member names are the C# names with the
// first letter lowered, so `conversionMember` is BYN5009's second message form and `becomesCallUndeclared`
// is BYN7003's third, registered once each in C#.

/// Every descriptor a semantics pass reports, in `DiagnosticCodes.cs` order.
enum SemaCode {
    modifierNotAllowed
    tryCoversMore
    returnErrorInput
    undefinedName
    unknownType
    unknownMember
    unknownModule
    notVisible
    duplicateDeclaration
    shadowing
    typeCasing
    valueCasing
    importCycle
    circularAlias
    circularConstant
    duplicateMain
    noMain
    statementOutsideEntry
    instanceMemberWithoutThis
    thisOutsideMethod
    notAValue
    unknownLabel
    unknownParameter
    unsupported
    wrongTypeArgumentCount
    nestedOptional
    voidValue
    declarationAsBody
    nullEquality
    sameTypeShadowing
    nestedIt
    toStringCall
    unknownStdModule
    missingInitializer
    useBeforeAssign
    outNotAssigned
    immutableAssignment
    readonlyField
    mutateTemporary
    getterMutates
    requiredWithDefault
    missingFields
    duplicateFieldInit
    literalWithConstructor
    noConstructor
    recursiveStruct
    notAStruct
    mutatesWithoutRefThis
    refThisOnOperator
    refThisNotFirst
    stringIndexer
    typeMismatch
    literalOutOfRange
    constantOverflow
    divisionByZero
    invalidCast
    badUnaryOperand
    badBinaryOperands
    stringConcatenation
    coalesceNotOptional
    memberOfOptional
    notIndexable
    indexOutOfRange
    fromEndOutsideIndex
    openRange
    branchTypeMismatch
    cannotInferType
    noTargetType
    notConstant
    notCallable
    notIterable
    arrayLengthMismatch
    tupleNameMismatch
    interpolationNotAllowed
    notFormattable
    notDisposable
    ambiguousVariant
    unknownVariant
    invalidConstArray
    renamedMember
    whileLetNotOptional
    spreadNotSequence
    mapLiteralMixed
    missingArgument
    tooManyArguments
    duplicateArgument
    positionalAfterNamed
    argumentMustBeNamed
    argumentModifierMismatch
    retiredArgumentsSwapped
    spanParameterNeverWritten
    neverReassignedVar
    requiresNotBool
    requiresViolated
    retiredRequiresNotHere
    missingReturn
    missingReturnValue
    returnValueInVoid
    neverReturns
    unreachableCode
    jumpOutsideLoop
    continueSwitch
    labelNotOnLoop
    duplicateDefault
    nonExhaustive
    patternMismatch
    tryInDefer
    unhandledFailure
    undeclaredError
    propagateFromInfallible
    nothingToHandle
    errdeferWithoutFails
    publicInferredFails
    notAnErrorSet
    emptyErrorSet
    jumpOutOfDefer
    catchBlockCompletes
    panicHandlerRestricted
    panicHandlerReads
    onPanicPlacement
    panicHandlerReadsMoved
    unknownUnionVariant
    duplicateUnionVariant
    emptyUnion
    variantPatternArity
    payloadNeedsPattern
    variantNeedsPayload
    variantHasNoPayload
    recursiveUnion
    borrowPayload
    unionValueNotInteger
    unionValueOnPayload
    duplicateUnionValue
    wildcardOnLocalUnion
    unknownEnumMember
    duplicateEnumMember
    emptyEnum
    enumArgumentNotConstant
    invalidEnumParameter
    cannotInferTypeArgument
    conflictingTypeArgument
    genericArgumentCount
    typeParameterOperator
    typeParameterMember
    invalidMapKey
    recursiveByValue
    sharedStorageCopy
    unknownAttribute
    invalidMainSignature
    untrustedSink
    trustReason
    takeUnsupported
    switchMoveSubject
    owningPatternOverlap
    owningBindingMutatedInGuard
    invalidExitCode
    assertNotBool
    casesArity
    casesNotConstant
    implicitCopy
    useAfterMove
    cannotMove
    mutateBorrow
    copyUniqueElement
    mapSlotNoDefault
    interfaceName
    missingInterfaceMember
    interfaceMemberMismatch
    missingAssociatedType
    notAnInterface
    duplicateConformance
    constraintMember
    constraintNotSatisfied
    notDynSafe
    dynByValue
    staticAbstract
    extensionConformance
    whereUnknownParameter
    dynReadonlyMutation
    refThisMismatch
    nonStructConformance
    interfaceAsType
    lambdaArity
    cannotCapture
    functionTypeNotHere
    memberNotLambda
    notAFunctionValue
    hashMapNotSupported
    keyPartNotHashable
    stringNotSymbol
    borrowField
    borrowOutlivesSource
    borrowReturned
    modifiedWhileBorrowed
    refAndValue
    movedWhileBorrowed
    unusedValue
    duplicateErrorCase
    bareLiteralForDistinct
    ruleTargetNotField
    literalNeedsTry
    checkedFieldAssignment
    uniqueConst
    overlappingOverloads
    restEscapes
    ambiguousOverloadReference
    fieldWriteOutside
    borrowCrossesFiber
    requiresMixesFields
    unknownMutationOperator
    manifestNotData
    manifestUnknownField
    manifestInvalidValue
    manifestMissingField
    manifestEquals
    cCompilerRejected
    participleChangesThis
    stateMemberMutates
    tryWrongReturn
    particleRequired
    argumentNeedsParticle
    parameterNeedsParticle
    logLevelAsVerb
    unknownParticle
    particleAsMemberName
    conversionMember
    expectsSingleParameter
    repeatedParticle
    unknownWord
    nounOnMutator
    boolWithoutPrefix
    noallocRemoved
    effectNotDeclared
    unknownEffect
    capabilityExceeded
    effectBoundExceeded
    contextBlockInput
    unknownHandler
    wrongState
    payloadNotInState
    becomeUndeclared
    becomeOtherState
    becomesCallUndeclared
    stateSwitchNotExhaustive
    stateLiteralNeedsState
    singleStateInline
    unknownState
    stateShadowsStatic
    missingBecome
    becomesNeedsRef
    becomesOnRefParameter
    assignmentChangesState
    missingBecause
    expectsReadsUntrusted
}

