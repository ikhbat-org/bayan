// T18: BinderExpressions.cs ~600-1155 (members, index, slice).

import lexer
import parser

enum MemberRefKind {
    none
    field
    propertyKeyword
    method
}

// The C# `Symbol?` `lookupMember` returns: a field, property or method of a type, by its arena id.
struct MemberRef {
    MemberRefKind kind
    i64 id = -1
}

struct RenamedResult {
    string oldName
    string newName
    bool hasFix
    TextSpan fixSpan = TextSpan { start: 0, length: 0 }
    string replacement = ""
}

// ── Private helpers ──────────────────────────────────────────────────────────

string t18Text(in Ctx c, from FileId f, at TextSpan span) => span.start < 0 ? c.syntheticNames[-1 - span.start] : $"{getText(c.files[f].text.span, at: span)}"

bool t18ContainsBraces(string text) {
    for b in text.bytes {
        if b == 0x7B || b == 0x7D { return true }
    }
    return false
}

// ── Entry points ─────────────────────────────────────────────────────────────

BExpr constantRef(ref Binder b, through ref Ctx c, at TextSpan span, for ConstId k) => t21ConstantRef(ref b, through: ref c, at: span, for: k, from: -1)

/// `constantRef` that records `syntax` as the C# `Syntax` of the node it returns (Q849).
BExpr t21ConstantRef(ref Binder b, through ref Ctx c, at TextSpan span, for ConstId k, from i64 syntax) {
    bindConstant(ref c, for: k)
    if c.consts[k].isStaticArray {
        return recordSyntaxNode(ref c, for: addStaticArray(ref c, from: BStaticArray { span: span, constId: k, type: c.consts[k].type }), at: syntax)
    }
    if !(c.consts[k].value is { } value) {
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    return t21ConstantLiteral(ref c, at: span, as: c.consts[k].type, by: in value, from: syntax)
}

BExpr constantLiteral(ref Ctx c, at TextSpan span, as Type type, by in Constant value) => t21ConstantLiteral(ref c, at: span, as: type, by: in value, from: -1)

/// `constantLiteral` that records `syntax` as the C# `Syntax` of the literal (Q849).
BExpr t21ConstantLiteral(ref Ctx c, at TextSpan span, as Type type, by in Constant value, from i64 syntax) {
    if type == builtinType(.symbol) {
        let sLit = addSymbolLiteral(ref c, from: BSymbolLiteral { span: span, text: value.text })
        setConstant(ref c, for: sLit, to: value)
        return recordSyntaxNode(ref c, for: sLit, at: syntax)
    }
    let lit = addLiteral(ref c, from: BLiteral { span: span, type: type, value: value })
    setConstant(ref c, for: lit, to: value)
    return recordSyntaxNode(ref c, for: lit, at: syntax)
}

MemberRef lookupMember(ref Ctx c, for Type t, by string name) {
    let tk = kindOf(t)
    if tk == .structType {
        let s = typeIndex(t)
        let f = findField(ref c, by: s, for: name)
        if f != -1 { return MemberRef { kind: .field, id: f } }
        let p = findProperty(ref c, by: s, for: name)
        if p != -1 { return MemberRef { kind: .propertyKeyword, id: p } }
        let methods = findMethods(ref c, by: s, for: name)
        if methods.length > 0 { return MemberRef { kind: .method, id: methods[0] } }
    }
    if tk == .typeParam {
        for iface in copyIds(in c.typeParams[typeIndex(t)].constraints) {
            let p = findInterfaceProperty(ref c, by: iface, for: name)
            if p != -1 { return MemberRef { kind: .method, id: p } }
            let methods = findInterfaceMethods(ref c, by: iface, for: name)
            if methods.length > 0 { return MemberRef { kind: .method, id: methods[0] } }
        }
    }
    return MemberRef { kind: .none, id: -1 }
}

BExpr bindImplicitThisMember(ref Binder b, through ref Ctx c, for in parser.NameExpr n, by MemberRef member) {
    let syntax = syntaxLeaf(ref c, as: .nameExpr, at: n.span)
    let hostFn = host(b, through: c)
    let inInstance = hostFn != -1 && !c.functions[hostFn].isStatic && (c.functions[hostFn].kind == .method || c.functions[hostFn].kind == .getter || c.functions[hostFn].kind == .constructor)
    if member.kind == .method && c.functions[member.id].isStatic {
        return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: n.span, receiver: -1, function: member.id, typeArgs: List<TextSpan>() }), at: syntax)
    }
    let nameText = t18Text(in c, from: b.file, at: n.name)
    if !inInstance {
        let staticHost = host(b, through: c)
        let helpText = staticHost != -1 && c.functions[staticHost].isStatic ? "call it on an instance; a `static` method has no `this`" : "set it in a constructor; field defaults cannot read other fields"
        report(ref b, through: ref c, for: .instanceMemberWithoutThis, at: n.span, by: (nameText, "", "", "", ""), help: helpText)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }
    if inLambda(ref b, through: ref c, at: n.span, for: nameText, by: "it is read through `this`, which a lambda does not capture") {
        @unobservable because "Q607: inLambda is a stub; add a lambda read of an implicit this member when T35 lands"
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }
    let self = recordSyntaxNode(ref c, for: addThis(ref c, from: BThis { span: n.span, type: b.thisType }), at: syntax)
    switch member.kind {
        case .field:
            return recordSyntaxNode(ref c, for: addField(ref c, from: BField { span: n.span, receiver: self, field: member.id, type: c.fields[member.id].type }), at: syntax)
        case .propertyKeyword:
            return recordSyntaxNode(ref c, for: addCall(ref c, from: BCall { span: n.span, function: c.properties[member.id].getter, receiver: self, arguments: List<BExpr>(), type: c.properties[member.id].type }), at: syntax)
        case .method:
            if c.functions[member.id].kind == .getter {
                @unobservable because "Q607: declareInterfaceMembers is a stub; add a getter-through-interface case when T38 lands"
                return recordSyntaxNode(ref c, for: addCall(ref c, from: BCall { span: n.span, function: member.id, receiver: self, arguments: List<BExpr>(), type: c.functions[member.id].returnType }), at: syntax)
            }
            return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: n.span, receiver: self, function: member.id, typeArgs: List<TextSpan>() }), at: syntax)
        default:
            // coverage-exempt: Q853
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }
}

BExpr bindMember(ref Binder b, through ref Ctx c, for in parser.MemberExpr m) {
    let syntax = syntaxOfMember(ref c, from: in m)
    if m.nullConditional {
        report(ref b, through: ref c, for: .unsupported, at: m.span, by: ("`?.`", "", "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
    }
    let target = bindExprOrType(ref b, through: ref c, for: in m.target)
    let name = t18Text(in c, from: b.file, at: m.member)
    let bk = boundKind(target)
    if bk == .errorExpr { return target }
    if bk == .moduleRef {
        return t18BindModuleMember(ref b, through: ref c, for: m, to: c.bModuleRefs[boundIndex(target)].module, from: syntax)
    }
    if bk == .typeRef {
        let refType = c.bTypeRefs[boundIndex(target)].referenced
        let tk = kindOf(refType)
        if tk == .errorSet {
            let set = typeIndex(refType)
            let variant = findErrorVariant(ref c, by: set, for: name)
            if variant != -1 {
                return recordSyntaxNode(ref c, for: addErrorVariant(ref c, from: BErrorVariant { span: m.span, variant: variant, type: refType }), at: syntax)
            }
            var varNames = List<string>()
            for v in c.errorSets[set].variants { varNames.append(c.errorVariants[v].name) }
            let close = suggest(name, by: in varNames)
            let help = close is { } ? $"did you mean `{close}`?" : ""
            report(ref b, through: ref c, for: .unknownVariant, at: m.member, by: (name, errorSetDisplayName(ref c, by: set), "", "", ""), help: help)
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
        }
        if tk == .enumType {
            return t18BindEnumStatic(ref b, through: ref c, for: m, to: typeIndex(refType), from: syntax)
        }
        if tk == .unionType {
            return t18BindVariant(ref b, through: ref c, at: m.span, by: m.member, to: typeIndex(refType), from: syntax)
        }
        if tk == .structType {
            let s = typeIndex(refType)
            let methods = findMethods(ref c, by: s, for: name)
            let method: FuncId = methods.length > 0 ? methods[0] : -1
            if method != -1 && c.functions[method].isStatic {
                checkAccess(ref b, through: ref c, for: c.functions[method].access, from: c.functions[method].owner, by: c.functions[method].module, at: m.member)
                return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: method, typeArgs: List<TextSpan>() }), at: syntax)
            }
            let help = (method != -1 || findField(ref c, by: s, for: name) != -1 || findProperty(ref c, by: s, for: name) != -1) ? $"call it on a `{c.structs[s].name}` value; `{name}` belongs to a value, not the type" : ""
            report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, c.structs[s].name, "", "", ""), help: help)
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
        }
        if tk == .builtin {
            let bKind = builtinKindOf(typeIndex(refType))
            if bKind == .io {
                let member = findIo(ref c, for: name)
                if member == -1 {
                    let near = suggest(name, by: in ["readFile", "readText", "writeFile", "listDir", "run", "runBatch", "monotonicNanos", "stdout", "stderr", "stdin"])
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, builtinName(bKind), "", "", ""), help: help)
                    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
                }
                if c.functions[member].builtin == .ioStdout || c.functions[member].builtin == .ioStderr || c.functions[member].builtin == .ioStdin {
                    return recordSyntaxNode(ref c, for: addCall(ref c, from: BCall { span: m.span, function: member, receiver: -1, arguments: List<BExpr>(), type: c.functions[member].returnType }), at: syntax)
                }
                return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() }), at: syntax)
            }
            if bKind == .hex {
                if name == "encode" {
                    return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: t9Function(ref c, for: "Hex.encode"), typeArgs: List<TextSpan>() }), at: syntax)
                }
                if name == "decode" {
                    return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: t9Function(ref c, for: "Hex.decode"), typeArgs: List<TextSpan>() }), at: syntax)
                }
                let near = suggest(name, by: in ["encode", "decode"])
                let help = near is { } ? $"did you mean `{near}`?" : ""
                report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, builtinName(bKind), "", "", ""), help: help)
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
            if bKind == .symbol {
                if name == "intern" {
                    return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: t9Function(ref c, for: "Symbol.intern"), typeArgs: List<TextSpan>() }), at: syntax)
                }
                let near = suggest(name, by: in ["intern"])
                let help = near is { } ? $"did you mean `{near}`?" : ""
                report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, builtinName(bKind), "", "", ""), help: help)
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
            if bKind == .utf8 {
                let member = findUtf8(ref c, for: name)
                if member == -1 {
                    let near = suggest(name, by: in ["decode", "tryDecode"])
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, builtinName(bKind), "", "", ""), help: help)
                    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
                }
                return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() }), at: syntax)
            }
            if bKind == .path {
                let member = findPath(ref c, for: name)
                if member == -1 {
                    let near = suggest(name, by: in ["isRooted", "relative", "fileName"])
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, builtinName(bKind), "", "", ""), help: help)
                    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
                }
                return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() }), at: syntax)
            }
        }
        if isString(refType) {
            let member = findString(ref c, for: name)
            if member != -1 {
                return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() }), at: syntax)
            }
            let codec = (name == "from" || name == "fromUtf8") ? "Utf8.decode" : (name == "tryFrom" ? "Utf8.tryDecode" : "")
            if codec != "" {
                report(ref b, through: ref c, for: .renamedMember, at: m.member, by: ($"string.{name}", codec, "", "", ""), label: "the old name", help: $"write `{codec}`", hasFix: true, fixSpan: m.span, fixReplacement: codec)
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
            let near = suggest(name, by: in ["invalidUtf8At"])
            let help = near is { } ? $"did you mean `{near}`?" : ""
            report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, primitiveName(primKindOf(typeIndex(refType))), "", "", ""), help: help)
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
        }
        report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, typeDisplay(ref c, by: refType), "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
    }
    return t21BindValueMember(ref b, through: ref c, at: m.span, for: target, by: m.member, from: syntax)
}

/// A unit variant is a value; a variant with a payload is called like a function.
BExpr t18BindVariant(ref Binder b, through ref Ctx c, at TextSpan syntaxSpan, by TextSpan memberSpan, to UnionId u, from i64 syntax) {
    let name = t18Text(in c, from: b.file, at: memberSpan)
    let foundVariant = findUnionVariant(ref c, by: u, for: name)
    if foundVariant != -1 {
        if c.unionVariants[foundVariant].fields.length == 0 {
            return recordSyntaxNode(ref c, for: addUnionNew(ref c, from: BUnionNew { span: syntaxSpan, variant: foundVariant, payload: List<BExpr>(), type: makeType(.unionType, at: u) }), at: syntax)
        }
        return recordSyntaxNode(ref c, for: addVariantGroup(ref c, from: BVariantGroup { span: syntaxSpan, variant: foundVariant }), at: syntax)
    }
    var variantNames = List<string>()
    for v in c.unions[u].variants { variantNames.append(c.unionVariants[v].name) }
    let close = suggest(name, by: in variantNames)
    let help = close is { } ? $"did you mean `{close}`?" : ""
    report(ref b, through: ref c, for: .unknownUnionVariant, at: memberSpan, by: (name, c.unions[u].name, "", "", ""), help: help)
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: syntaxSpan }), at: syntax)
}

/// `Color.red`, `Color.count`, `Color.values`, `Color.fromOrdinal` and `Color.parse`.
BExpr t18BindEnumStatic(ref Binder b, through ref Ctx c, for parser.MemberExpr m, to EnumId e, from i64 syntax) {
    let name = t18Text(in c, from: b.file, at: m.member)
    let foundMember = findEnumMember(ref c, by: e, for: name)
    if foundMember != -1 {
        return recordSyntaxNode(ref c, for: addEnumMember(ref c, from: BEnumMember { span: m.span, member: foundMember, type: makeType(.enumType, at: e) }), at: syntax)
    }
    switch name {
        case "count":
            let count = Constant { kind: .integer, integer: bigFromI64(c.enums[e].members.length) }
            let lit = recordSyntaxNode(ref c, for: addLiteral(ref c, from: BLiteral { span: m.span, type: prim(.i64), value: count }), at: syntax)
            setConstant(ref c, for: lit, to: count)
            return lit
        case "values":
            let spanT = internSpan(ref c, by: makeType(.enumType, at: e), readOnly: true)
            return recordSyntaxNode(ref c, for: addEnumValues(ref c, from: BEnumValues { span: m.span, enumId: e, type: spanT }), at: syntax)
        case "fromOrdinal":
            return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: c.enums[e].fromOrdinal, typeArgs: List<TextSpan>() }), at: syntax)
        case "parse":
            return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: c.enums[e].parse, typeArgs: List<TextSpan>() }), at: syntax)
        default:
            var candidates = List<string>()
            for mem in c.enums[e].members { candidates.append(c.enumMembers[mem].name) }
            candidates.append("count")
            candidates.append("values")
            candidates.append("fromOrdinal")
            candidates.append("parse")
            let close = suggest(name, by: in candidates)
            let help = close is { } ? $"did you mean `{close}`?" : ""
            report(ref b, through: ref c, for: .unknownEnumMember, at: m.member, by: (name, c.enums[e].name, "", "", ""), help: help)
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
    }
}

BExpr t18BindModuleMember(ref Binder b, through ref Ctx c, for parser.MemberExpr m, to ModId mod, from i64 syntax = -1) {
    let name = t18Text(in c, from: b.file, at: m.member)
    if c.modules[mod].constants.contains(name) {
        let constId = c.modules[mod].constants[name]
        checkAccess(ref b, through: ref c, for: accessOf(0), from: -1, by: mod, at: m.member, publicRequired: true)
        return t21ConstantRef(ref b, through: ref c, at: m.span, for: constId, from: syntax)
    }
    if c.modules[mod].functions.contains(name) {
        let fnId = c.modules[mod].functions[name][0]
        checkAccess(ref b, through: ref c, for: c.functions[fnId].access, from: -1, by: mod, at: m.member)
        return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: m.span, receiver: -1, function: fnId, typeArgs: List<TextSpan>() }), at: syntax)
    }
    if c.modules[mod].types.contains(name) {
        var path = List<TextSpan>()
        switch m.target {
            case .nameExpr(let n): path.append(n.value.name)
            default: panic("a module member's target is a `NameExpr`")
        }
        path.append(m.member)
        let resolved = resolveType(ref b, through: ref c, for: in parser.TypeSyntax.namedType(Owned(NamedType { span: m.span, path: move path, args: List<parser.TypeSyntax>() })))
        return recordSyntaxNode(ref c, for: addTypeRef(ref c, from: BTypeRef { span: m.span, referenced: resolved }), at: syntax)
    }
    report(ref b, through: ref c, for: .unknownMember, at: m.member, by: (name, $"module {c.modules[mod].name}", "", "", ""))
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
}

/// Reports a member the current code may not see. Module constants are always module-private in v0.1.
void checkAccess(ref Binder b, through ref Ctx c, for Accessibility access, from StructId owner, by ModId module, at TextSpan name, bool publicRequired = false) {
    let currModule = c.files[b.file].module
    let nameText = t18Text(in c, from: b.file, at: name)
    if publicRequired && module != currModule {
        report(ref b, through: ref c, for: .notVisible, at: name, by: (nameText, "", "", "", ""), label: "module constants are not visible outside their module")
        return
    }
    let builtinMod = t9Module(ref c)
    switch access {
        case .privateKeyword:
            if owner >= 0 && owner != b.owner {
                report(ref b, through: ref c, for: .notVisible, at: name, by: (nameText, "", "", "", ""), label: $"`private` to `{c.structs[owner].name}`")
            } else if module != currModule && module != builtinMod {
                report(ref b, through: ref c, for: .notVisible, at: name, by: (nameText, "", "", "", ""), label: "not `public`", help: $"mark `{nameText}` `public` to use it from another module")
            }
        case .module:
            if module != currModule && module != builtinMod {
                report(ref b, through: ref c, for: .notVisible, at: name, by: (nameText, "", "", "", ""), label: "not `public`", help: $"mark `{nameText}` `public` to use it from another module")
            }
        default: {}
    }
}

BExpr bindValueMember(ref Binder b, through ref Ctx c, at TextSpan span, for BExpr target, by TextSpan member) => t21BindValueMember(ref b, through: ref c, at: span, for: target, by: member, from: -1)

/// `bindValueMember` that records `syntax` as the C# `Syntax` of the nodes it builds (Q849).
BExpr t21BindValueMember(ref Binder b, through ref Ctx c, at TextSpan span, for BExpr target, by TextSpan member, from i64 syntax) {
    let name = t18Text(in c, from: b.file, at: member)
    let targetType = exprType(in c, for: target)
    var lookupType = targetType
    if kindOf(targetType) == .state {
        @unobservable because "Q607: resolveStates and statesOf are stubs; add a union-with-states receiver when T38 lands"
        lookupType = makeType(.structType, at: c.stateTypes[typeIndex(targetType)].s)
    }

    let lk = kindOf(lookupType)
    if lk == .structType {
        let s = typeIndex(lookupType)
        let foundField = findField(ref c, by: s, for: name)
        if foundField != -1 {
            checkAccess(ref b, through: ref c, for: c.fields[foundField].access, from: s, by: c.structs[s].module, at: member)
            return recordSyntaxNode(ref c, for: addField(ref c, from: BField { span: span, receiver: target, field: foundField, type: c.fields[foundField].type }), at: syntax)
        }

        let foundProp = findProperty(ref c, by: s, for: name)
        if foundProp != -1 {
            checkAccess(ref b, through: ref c, for: c.properties[foundProp].access, from: s, by: c.structs[s].module, at: member)
            return recordSyntaxNode(ref c, for: addCall(ref c, from: BCall { span: span, function: c.properties[foundProp].getter, receiver: target, arguments: List<BExpr>(), type: c.properties[foundProp].type }), at: syntax)
        }

        let methods = findMethods(ref c, by: s, for: name)
        if methods.length > 0 {
            let foundMethod = methods[0]
            checkAccess(ref b, through: ref c, for: c.functions[foundMethod].access, from: s, by: c.structs[s].module, at: member)
            let recv = c.functions[foundMethod].isStatic ? -1 : target
            return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: span, receiver: recv, function: foundMethod, typeArgs: List<TextSpan>() }), at: syntax)
        }

        let states = statesOf(ref c, for: s)
        if states != -1 {
            let payload = t21BindPayloadField(ref b, through: ref c, at: span, for: target, from: states, by: member, to: syntax)
            if payload != -1 { return payload }
        }
    } else if lk == .errorSet || lk == .errorUnion {
        @unobservable because "Q607: bindErrorCasePattern is a stub; add a narrowed error-set field read when T22 lands"
        if boundKind(target) == .local {
            let el = c.bLocals[boundIndex(target)].local
            if b.errorNarrowed.contains(el) {
                let v = b.errorNarrowed[el]
                for fi in 0..c.errorVariants[v].fields.length {
                    let f = c.errorVariants[v].fields[fi]
                    if c.locals[f].name == name {
                        return recordSyntaxNode(ref c, for: addErrorField(ref c, from: BErrorField { span: span, receiver: target, variant: v, index: fi }), at: syntax)
                    }
                }
            }
        }
    } else if lk == .unionType {
        @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
        let u = typeIndex(lookupType)
        @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
        if boundKind(target) == .local {
            let l = c.bLocals[boundIndex(target)].local
            if b.narrowed.contains(l) {
                let v = b.narrowed[l]
                for fi in 0..c.unionVariants[v].fields.length {
                    let f = c.unionVariants[v].fields[fi]
                    if c.locals[f].name == name {
                        return recordSyntaxNode(ref c, for: addUnionField(ref c, from: BUnionField { span: span, receiver: target, variant: v, index: fi }), at: syntax)
                    }
                }
            }
        }
        @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
        var fieldVariant = -1
        for vi in 0..c.unions[u].variants.length {
            @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
            let v = c.unions[u].variants[vi]
            for fi in 0..c.unionVariants[v].fields.length {
                @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
                let f = c.unionVariants[v].fields[fi]
                if c.locals[f].name == name {
                    fieldVariant = v
                    break
                }
            }
            if fieldVariant != -1 { break }
        }
        if fieldVariant != -1 {
            report(ref b, through: ref c, for: .payloadNeedsPattern, at: member, by: (c.unions[u].name, name, "", "", ""), help: "match the variant and bind the field, as in `case .Variant(let x):`")
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
        }
    } else if lk == .tuple {
        let t = typeIndex(lookupType)
        let index = tupleIndexOf(ref c, by: lookupType, for: name)
        if index >= 0 {
            return recordSyntaxNode(ref c, for: addTupleElement(ref c, from: BTupleElement { span: span, receiver: target, index: index, type: c.tupleTypes[t][index].type }), at: syntax)
        }
    } else if lk == .enumType {
        let e = typeIndex(lookupType)
        let f = findEnumField(ref c, by: e, for: name)
        if f != -1 {
            let lit = recordSyntaxNode(ref c, for: literal(ref c, at: span, as: prim(.i32), by: Constant { kind: .integer, integer: bigFromI64(c.enumFields[f].index) }), at: syntax)
            return recordSyntaxNode(ref c, for: addBuiltinCall(ref c, from: BBuiltinCall { span: span, member: .enumField, receiver: target, arguments: [lit], type: c.enumFields[f].type }), at: syntax)
        }
    } else if lk == .owned {
        let innerType = c.ownedTypes[typeIndex(lookupType)]
        if name != "value" && !isError(innerType) {
            let innerCall = shareSyntax(ref c, for: addBuiltinCall(ref c, from: BBuiltinCall { span: nodeSpan(in c, for: target), member: .ownedValue, receiver: target, arguments: List<BExpr>(), type: innerType }), from: target)
            return t21BindValueMember(ref b, through: ref c, at: span, for: innerCall, by: member, from: syntax)
        }
    } else if lk == .optional {
        if name != "take" {
            let targetText = t18Text(in c, from: b.file, at: nodeSpan(in c, for: target))
            report(ref b, through: ref c, for: .memberOfOptional, at: member, by: (name, typeDisplay(ref c, by: lookupType), "", "", ""), help: $"check it first: `if ({targetText} is {{ }} value) {{ … value.{name} … }}`")
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
        }
    } else if lk == .error {
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    } else if lk == .typeParam {
        let tp = typeIndex(lookupType)
        if c.typeParams[tp].constraints.length > 0 {
            var foundMember: FuncId = -1
            for iface in copyIds(in c.typeParams[tp].constraints) {
                foundMember = findInterfaceProperty(ref c, by: iface, for: name)
                if foundMember == -1 {
                    let methods = findInterfaceMethods(ref c, by: iface, for: name)
                    if methods.length > 0 { foundMember = methods[0] }
                }
                @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
                if foundMember != -1 { break }
            }
            if foundMember != -1 {
                @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
                return t18BindInterfaceMember(ref b, through: ref c, at: span, for: target, by: foundMember, from: member, as: syntax)
            }
            let self = c.interfaces[c.typeParams[tp].constraints[0]].self == tp
            var constraintList = List<string>()
            var constraints = copyIds(in c.typeParams[tp].constraints)
            for iface in constraints {
                constraintList.append($"`{interfaceDisplayName(ref c, by: iface)}`")
            }
            var sb = StrBuf()
            for ci in 0..constraintList.length {
                if ci > 0 { sb.append(", ") }
                sb.append(constraintList[ci])
            }
            let joinedConstraints = $"{sb.finish()}"
            let help = self ? $"declare `{name}` in `{interfaceDisplayName(ref c, by: c.typeParams[tp].constraints[0])}`; a default method sees only its interface's members" : $"add an interface declaring `{name}` to the `where` clause"
            report(ref b, through: ref c, for: .constraintMember, at: member, by: (c.typeParams[tp].name, name, joinedConstraints, "", ""), help: help)
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
        }
        report(ref b, through: ref c, for: .typeParameterMember, at: member, by: (name, c.typeParams[tp].name, "", "", ""), help: $"add `where {c.typeParams[tp].name} : …` naming an interface that declares `{name}`, or use a concrete type")
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    } else if lk == .dynRef {
        let d = c.dynRefTypes[typeIndex(lookupType)]
        var foundMember = findInterfaceProperty(ref c, by: d.iface, for: name)
        if foundMember == -1 {
            let methods = findInterfaceMethods(ref c, by: d.iface, for: name)
            if methods.length > 0 { foundMember = methods[0] }
        }
        if foundMember != -1 {
            @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
            if d.readOnly && c.functions[foundMember].isMutating {
                report(ref b, through: ref c, for: .dynReadonlyMutation, at: member, by: (name, interfaceDisplayName(ref c, by: d.iface), "", "", ""), label: "declared `ref this`", help: $"take `dyn ref {interfaceDisplayName(ref c, by: d.iface)}`")
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
            }
            @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
            return t18BindInterfaceMember(ref b, through: ref c, at: span, for: target, by: foundMember, from: member, as: syntax)
        }
    }

    if (builtinProperty(ref c, for: targetType, by: name) is { } builtin) {
        @unobservable because "Q607: propertyType and bindCollection are stubs; add str.length and static-array length cases when T35 lands"
        var callType: Type = -1
        @unobservable because "Q607: propertyType and bindCollection are stubs; add str.length and static-array length cases when T35 lands"
        if kindOf(builtin.type) == .span && boundKind(target) == .staticArray {
            callType = internSpan(ref c, by: c.spanTypes[typeIndex(builtin.type)].element, readOnly: true)
        } else {
            callType = propertyType(ref b, through: ref c, for: builtin.member, as: builtin.type)
        }
        @unobservable because "Q607: propertyType and bindCollection are stubs; add str.length and static-array length cases when T35 lands"
        return recordSyntaxNode(ref c, for: addBuiltinCall(ref c, from: BBuiltinCall { span: span, member: builtin.member, receiver: target, arguments: List<BExpr>(), type: callType }), at: syntax)
    }
    @unobservable because "Q607: fact is a stub; add an Untrusted<string> length case when T19 lands"
    if kindOf(targetType) == .untrusted && (name == "length" || name == "isEmpty") {
        let innerType = c.untrustedTypes[typeIndex(targetType)]
        if (builtinProperty(ref c, for: innerType, by: name) is { } factProp) {
            return recordSyntaxNode(ref c, for: addBuiltinCall(ref c, from: BBuiltinCall { span: span, member: factProp.member, receiver: fact(ref c, for: target), arguments: List<BExpr>(), type: factProp.type }), at: syntax)
        }
    }
    if hasMethod(ref c, for: targetType, by: name) {
        return recordSyntaxNode(ref c, for: addBuiltinGroup(ref c, from: BBuiltinGroup { span: span, receiver: target, name: name }), at: syntax)
    }
    if reportRenamed(ref b, through: ref c, for: targetType, at: member) {
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    if name == "take" {
        report(ref b, through: ref c, for: .takeUnsupported, at: member, by: (typeDisplay(ref c, by: targetType), "", "", "", ""), help: "copy it, or move the whole local; only an owned collection or optional has an empty value to leave behind")
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    let label = name == "matches" && isString(targetType) ? "`matches` arrives with `std.regex` after v0.1" : ""
    let help = memberSuggestion(ref c, for: targetType, by: name) ?? ""
    report(ref b, through: ref c, for: .unknownMember, at: member, by: (name, typeDisplay(ref c, by: targetType), "", "", ""), label: label, help: help)
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
}

/// A member of an interface, reached through a constrained type parameter or a `dyn ref`.
BExpr t18BindInterfaceMember(ref Binder b, through ref Ctx c, at TextSpan syntaxSpan, for BExpr target, by FuncId m, from TextSpan memberSpan, as i64 syntax) {
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    if c.functions[m].typeParams.length > 0 {
        report(ref b, through: ref c, for: .unsupported, at: memberSpan, by: ("calling a generic interface method", "", "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: syntaxSpan }), at: syntax)
    }
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    if c.functions[m].kind == .getter {
        let returnType = returnTypeThrough(ref b, through: ref c, for: exprType(in c, for: target), by: m)
        return recordSyntaxNode(ref c, for: addCall(ref c, from: BCall { span: syntaxSpan, function: m, receiver: target, arguments: List<BExpr>(), type: returnType }), at: syntax)
    }
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: syntaxSpan, receiver: target, function: m, typeArgs: List<TextSpan>() }), at: syntax)
}

/// The return type of interface member `m` called on `receiver`: an associated type `Item` is `T.Item`.
Type returnTypeThrough(ref Binder b, through ref Ctx c, for Type receiver, by FuncId m) {
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    if kindOf(receiver) == .typeParam {
        let tp = typeIndex(receiver)
        let iface = c.functions[m].iface
        if iface >= 0 && c.interfaces[iface].self != tp {
            let ret = c.functions[m].returnType
            if kindOf(ret) == .typeParam {
                let rIdx = typeIndex(ret)
                var foundAssoc = false
                for assoc in c.interfaces[iface].associatedTypes {
                    if assoc == rIdx {
                        foundAssoc = true
                        break
                    }
                }
                if foundAssoc {
                    let assocName = c.typeParams[rIdx].name
                    let assocId = associatedType(ref c, for: tp, by: assocName)
                    return makeType(.typeParam, at: assocId)
                }
            }
        }
    }
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    return c.functions[m].returnType
}

/// BYN2230 and BYN2031: a member under its round-1 or C# name; the fix writes the new one.
bool reportRenamed(ref Binder b, through ref Ctx c, for Type type, at TextSpan member) {
    let name = t18Text(in c, from: b.file, at: member)
    if name == "toString" || name == "ToString" {
        report(ref b, through: ref c, for: .toStringCall, at: member, by: ("", "", "", "", ""), label: "not a Bayan method", help: "call `format()`, or interpolate the value: `$\"{x}\"`", hasFix: true, fixSpan: member, fixReplacement: "format")
        return true
    }
    if (t18RenamedCall(ref b, through: ref c, for: type, at: member) is { } shape) {
        let helpText = shape.hasFix ? $"write `{shape.replacement}`" : $"write `{shape.newName}`"
        report(ref b, through: ref c, for: .renamedMember, at: member, by: (shape.oldName, shape.newName, "", "", ""), label: "the old name", help: helpText, hasFix: shape.hasFix, fixSpan: shape.fixSpan, fixReplacement: shape.replacement)
        return true
    }
    var renamed: string? = null
    let isList = kindOf(type) == .list
    let isSpanT = kindOf(type) == .span
    let isArrayT = kindOf(type) == .array
    let isStr = isString(type)
    let isStrBuf = kindOf(type) == .builtin && builtinKindOf(typeIndex(type)) == .strBuf

    if isList && name == "add" {
        renamed = "append"
    } else if isStrBuf && name == "asString" {
        renamed = "finish"
    } else if isStr && name == "offset" {
        renamed = "position"
    } else if (isList || isSpanT) && name == "toList" {
        renamed = "copy"
    } else if isArrayT && name == "toList" {
        renamed = "span.copy"
    }
    if renamed is null { return false }
    let call = (name == "asString" || name == "toList") ? "()" : ""
    let ren = renamed ?? ""
    report(ref b, through: ref c, for: .renamedMember, at: member, by: ($"{name}{call}", $"{ren}{call}", "", "", ""), label: "the old name", help: $"rename it `{ren}`", hasFix: true, fixSpan: member, fixReplacement: ren)
    return true
}

/// The renames that change the call's shape (J72, round 3 §27): the fix rewrites the member and its arguments,
/// so it is written only when the member is called with the old arguments.
RenamedResult? t18RenamedCall(ref Binder b, through ref Ctx c, for Type type, at TextSpan memberSpan) {
    let name = t18Text(in c, from: b.file, at: memberSpan)
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    var isCalleeMatch = false
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    var tail = TextSpan { start: memberSpan.start, length: 0 }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if (b.calleeOf is { } activeCall) {
        if activeCall.isMember && activeCall.member.start == memberSpan.start && activeCall.member.length == memberSpan.length {
            isCalleeMatch = true
            tail = TextSpan.fromBounds(memberSpan.start, until: activeCall.span.end)
        }
    }

    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isList = kindOf(type) == .list
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isArrayT = kindOf(type) == .array
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isMap = kindOf(type) == .map
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isStr = isString(type)
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isInt = isInteger(type)

    if isList && name == "removeRange" {
        @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
        if isCalleeMatch && (b.calleeOf is { } cCall) && cCall.argCount == 2 && cCall.firstTwoPlain {
            let from = t18Text(in c, from: b.file, at: cCall.arg0)
            let until = t18Text(in c, from: b.file, at: cCall.arg1)
            return RenamedResult { oldName: "removeRange", newName: "remove(from:until:)", hasFix: true, fixSpan: tail, replacement: $"remove(from: {from}, until: {until})" }
        }
        @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
        return RenamedResult { oldName: "removeRange", newName: "remove(from:until:)", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isList && name == "replaceRange" {
        if isCalleeMatch && (b.calleeOf is { } rCall) && rCall.argCount == 2 && rCall.firstTwoPlain {
            let at = t18Text(in c, from: b.file, at: rCall.arg0)
            let by = t18Text(in c, from: b.file, at: rCall.arg1)
            return RenamedResult { oldName: "replaceRange", newName: "replace(at:by:)", hasFix: true, fixSpan: tail, replacement: $"replace(at: {at}, by: {by})" }
        }
        return RenamedResult { oldName: "replaceRange", newName: "replace(at:by:)", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isMap && name == "getOr" {
        if isCalleeMatch && (b.calleeOf is { } mCall) && mCall.argCount == 2 && mCall.firstTwoPlain {
            if mCall.isMember {
                let key = t18Text(in c, from: b.file, at: mCall.arg0)
                let fallback = t18Text(in c, from: b.file, at: mCall.arg1)
                let mapText = t18Text(in c, from: b.file, at: mCall.target)
                return RenamedResult { oldName: "getOr", newName: "tryGet(at:) ??", hasFix: true, fixSpan: mCall.span, replacement: $"({mapText}.tryGet(at: {key}) ?? {fallback})" }
            }
        }
        return RenamedResult { oldName: "getOr", newName: "tryGet(at:) ??", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if (isList || isArrayT) && name == "asSpan" {
        if isCalleeMatch && (b.calleeOf is { } sCall) && sCall.argCount == 0 {
            return RenamedResult { oldName: "asSpan()", newName: "span", hasFix: true, fixSpan: tail, replacement: "span" }
        }
        return RenamedResult { oldName: "asSpan()", newName: "span", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isStr && name == "toUtf16" {
        if isCalleeMatch && (b.calleeOf is { } uCall) && uCall.argCount == 0 {
            return RenamedResult { oldName: "toUtf16()", newName: "utf16", hasFix: true, fixSpan: tail, replacement: "utf16" }
        }
        return RenamedResult { oldName: "toUtf16()", newName: "utf16", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isInt && (name == "toHex" || name == "toBinary" || name == "toOctal") {
        let radix = name == "toHex" ? "hex" : (name == "toBinary" ? "binary" : "octal")
        if isCalleeMatch && (b.calleeOf is { } hCall) && hCall.argCount == 0 {
            if hCall.isMember {
                let targetText = t18Text(in c, from: b.file, at: hCall.target)
                return RenamedResult { oldName: $"{name}()", newName: $"string(x, as: .{radix})", hasFix: true, fixSpan: hCall.span, replacement: $"string({targetText}, as: .{radix})" }
            }
        }
        return RenamedResult { oldName: $"{name}()", newName: $"string(x, as: .{radix})", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    return null
}

string? memberSuggestion(ref Ctx c, for Type type, by string name) {
    if name == "Length" || name == "Count" || name == "count" || name == "size" || name == "len" {
        return "use `length` for the size of anything"
    }
    var candidates = List<string>()
    let tk = kindOf(type)
    if tk == .structType {
        let s = typeIndex(type)
        for f in c.structs[s].fields { candidates.append(c.fields[f].name) }
        for p in c.structs[s].properties { candidates.append(c.properties[p].name) }
        for m in c.structs[s].methods { candidates.append(c.functions[m].name) }
    } else if tk == .enumType {
        let e = typeIndex(type)
        for f in c.enums[e].fields { candidates.append(c.enumFields[f].name) }
        for n in names(ref c, for: type) { candidates.append(n) }
    } else {
        for n in names(ref c, for: type) { candidates.append(n) }
    }
    let close = suggest(name, by: in candidates)
    if (close is { } sug) { return $"did you mean `{sug}`?" }
    return null
}

BExpr bindTargetMember(ref Binder b, through ref Ctx c, for in parser.TargetMemberExpr t, to Type expected) {
    let syntax = syntaxLeaf(ref c, as: .targetMemberExpr, at: t.span)
    var target = expected
    if expected != -1 {
        let ek = kindOf(expected)
        if ek == .optional {
            target = c.optionalTypes[typeIndex(expected)]
        } else if ek == .result {
            target = c.resultTypes[typeIndex(expected)].error
        }
    }

    if target == -1 {
        report(ref b, through: ref c, for: .noTargetType, at: t.span, by: (t18Text(in c, from: b.file, at: t.member), "", "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    let tk = kindOf(target)
    if tk == .error { return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax) }
    let name = t18Text(in c, from: b.file, at: t.member)

    if tk == .function {
        report(ref b, through: ref c, for: .memberNotLambda, at: t.span, by: (name, "", "", "", ""), help: $"write `it.{name}`", hasFix: true, fixSpan: t.span, fixReplacement: $"it.{name}")
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .errorSet {
        let set = typeIndex(target)
        let foundVariant = findErrorVariant(ref c, by: set, for: name)
        if foundVariant != -1 {
            return recordSyntaxNode(ref c, for: addErrorVariant(ref c, from: BErrorVariant { span: t.span, variant: foundVariant, type: target }), at: syntax)
        }
        report(ref b, through: ref c, for: .unknownVariant, at: t.member, by: (name, errorSetDisplayName(ref c, by: set), "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .errorUnion {
        let u = typeIndex(target)
        var matches = List<VariantId>()
        for set in copyIds(in c.errorUnionTypes[u].sets) {
            let v = findErrorVariant(ref c, by: set, for: name)
            if v != -1 {
                var excluded = false
                for ex in c.errorUnionTypes[u].excluded {
                    if ex == v {
                        excluded = true
                        break
                    }
                }
                if !excluded { matches.append(v) }
            }
        }
        if matches.length == 1 {
            return recordSyntaxNode(ref c, for: addErrorVariant(ref c, from: BErrorVariant { span: t.span, variant: matches[0], type: target }), at: syntax)
        }
        if matches.length > 1 {
            var matchedSets = List<string>()
            for mv in matches { matchedSets.append(errorSetDisplayName(ref c, by: c.errorVariants[mv].set)) }
            var sb = StrBuf()
            for mi in 0..matchedSets.length {
                if mi > 0 { sb.append("`, `") }
                sb.append(matchedSets[mi])
            }
            report(ref b, through: ref c, for: .ambiguousVariant, at: t.span, by: (name, $"{sb.finish()}", "", "", ""))
        } else {
            report(ref b, through: ref c, for: .unknownVariant, at: t.member, by: (name, typeDisplay(ref c, by: target), "", "", ""))
        }
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .enumType {
        let e = typeIndex(target)
        let foundMember = findEnumMember(ref c, by: e, for: name)
        if foundMember != -1 {
            return recordSyntaxNode(ref c, for: addEnumMember(ref c, from: BEnumMember { span: t.span, member: foundMember, type: target }), at: syntax)
        }
        var candidates = List<string>()
        for mem in c.enums[e].members { candidates.append(c.enumMembers[mem].name) }
        let close = suggest(name, by: in candidates)
        let help = close is { } ? $"did you mean `{close}`?" : ""
        report(ref b, through: ref c, for: .unknownEnumMember, at: t.member, by: (name, c.enums[e].name, "", "", ""), help: help)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .unionType {
        return t18BindVariant(ref b, through: ref c, at: t.span, by: t.member, to: typeIndex(target), from: syntax)
    }
    if tk == .structType {
        let methods = findMethods(ref c, by: typeIndex(target), for: name)
        let method: FuncId = methods.length > 0 ? methods[0] : -1
        if method != -1 && c.functions[method].isStatic {
            return recordSyntaxNode(ref c, for: addMethodGroup(ref c, from: BMethodGroup { span: t.span, receiver: -1, function: method, typeArgs: List<TextSpan>() }), at: syntax)
        }
    }
    report(ref b, through: ref c, for: .unknownMember, at: t.member, by: (name, typeDisplay(ref c, by: target), "", "", ""))
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
}

BExpr bindIndex(ref Binder b, through ref Ctx c, for in parser.IndexExpr i) {
    let syntax = syntaxOfIndex(ref c, from: in i)
    let target = bindExpr(ref b, through: ref c, for: in i.target)
    let targetType = exprType(in c, for: target)
    if isError(targetType) {
        let _ = bindExpr(ref b, through: ref c, for: in i.index)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
    }
    if isString(targetType) {
        switch i.index {
            case .rangeExpr(let r):
                return bindSlice(ref b, through: ref c, for: in i, from: target, by: in r.value, as: prim(.string))
            default: {}
        }
        t18ReportStringIndexer(ref b, through: ref c, for: i)
        let _ = bindExpr(ref b, through: ref c, for: in i.index)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
    }
    if kindOf(targetType) == .map {
        let mapType = c.mapTypes[typeIndex(targetType)]
        let key = bindConverted(ref b, through: ref c, for: in i.index, to: mapType.key)
        if isError(exprType(in c, for: key)) {
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
        }
        return recordSyntaxNode(ref c, for: addBuiltinCall(ref c, from: BBuiltinCall { span: i.span, member: .mapIndex, receiver: target, arguments: [key], type: mapType.value }), at: syntax)
    }
    var element: Type = -1
    let tk = kindOf(targetType)
    if tk == .span {
        element = c.spanTypes[typeIndex(targetType)].element
    } else if tk == .list {
        element = c.listTypes[typeIndex(targetType)]
    } else if tk == .array {
        element = c.arrayTypes[typeIndex(targetType)].element
    }
    if element == -1 {
        report(ref b, through: ref c, for: .notIndexable, at: parser.exprSpan(in i.target), by: (typeDisplay(ref c, by: targetType), "", "", "", ""))
        let _ = bindExpr(ref b, through: ref c, for: in i.index)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
    }
    switch i.index {
        case .rangeExpr(let r):
            let isReadOnly = (tk == .span && c.spanTypes[typeIndex(targetType)].readOnly) || boundKind(target) == .staticArray
            let sliceType = internSpan(ref c, by: element, readOnly: isReadOnly)
            return bindSlice(ref b, through: ref c, for: in i, from: target, by: in r.value, as: sliceType)
        default: {}
    }

    var fromEnd = false
    var index: BExpr = -1
    switch i.index {
        case .unaryExpr(let u):
            if u.value.op == .fromEnd {
                fromEnd = true
                index = t18BindIndexValue(ref b, through: ref c, for: u.value.operand)
            } else {
                index = t18BindIndexValue(ref b, through: ref c, for: i.index)
            }
        default:
            index = t18BindIndexValue(ref b, through: ref c, for: i.index)
    }

    if tk == .array && (exprConstant(in c, for: index) is { } k) && k.kind == .integer {
        let arr = c.arrayTypes[typeIndex(targetType)]
        let n = bigToI64(k.integer)
        let effective = fromEnd ? arr.length - n : n
        if effective < 0 || effective >= arr.length || (fromEnd && n == 0) {
            let nStr = fromEnd ? $"^{n}" : $"{n}"
            report(ref b, through: ref c, for: .indexOutOfRange, at: parser.exprSpan(in i.index), by: (nStr, typeDisplay(ref c, by: targetType), "", "", ""))
        }
    }
    return recordSyntaxNode(ref c, for: addIndex(ref c, from: BIndex { span: i.span, target: target, index: index, fromEnd: fromEnd, type: element }), at: syntax)
}

BExpr t18BindIndexValue(ref Binder b, through ref Ctx c, for parser.Expr syntax) {
    let index = bindExpr(ref b, through: ref c, for: in syntax, to: prim(.i64))
    let indexType = exprType(in c, for: index)
    if isError(indexType) { return index }
    let span = parser.exprSpan(in syntax)
    if !isInteger(indexType) {
        report(ref b, through: ref c, for: .typeMismatch, at: span, by: (typeDisplay(ref c, by: indexType), "an integer index", "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntaxNode(ref c, from: in syntax))
    }
    if isUnsignedInteger(indexType) && primitiveBits(primKindOf(typeIndex(indexType))) == 64 {
        return recordSyntaxNode(ref c, for: addConversion(ref c, from: BConversion { span: span, operand: index, type: prim(.i64), kind: .numericCast }), at: syntaxNode(ref c, from: in syntax))
    }
    return convert(ref b, through: ref c, for: index, to: prim(.i64), at: span)
}

BExpr bindSlice(ref Binder b, through ref Ctx c, for in parser.IndexExpr i, from BExpr target, by in parser.RangeExpr r, as Type type) {
    var start: BExpr = -1
    var startFromEnd = false
    switch r.start {
        case .unaryExpr(let u):
            if u.value.op == .fromEnd {
                startFromEnd = true
                start = t18BindIndexValue(ref b, through: ref c, for: u.value.operand)
            } else {
                start = t18BindIndexValue(ref b, through: ref c, for: r.start)
            }
        case .none:
            {}
        default:
            start = t18BindIndexValue(ref b, through: ref c, for: r.start)
    }

    var end: BExpr = -1
    var endFromEnd = false
    switch r.end {
        case .unaryExpr(let u):
            if u.value.op == .fromEnd {
                endFromEnd = true
                end = t18BindIndexValue(ref b, through: ref c, for: u.value.operand)
            } else {
                end = t18BindIndexValue(ref b, through: ref c, for: r.end)
            }
        case .none:
            {}
        default:
            end = t18BindIndexValue(ref b, through: ref c, for: r.end)
    }

    return recordSyntaxNode(ref c, for: addSlice(ref c, from: BSlice { span: i.span, target: target, start: start, startFromEnd: startFromEnd, end: end, endFromEnd: endFromEnd, inclusive: r.inclusive, type: type }), at: syntaxOfIndex(ref c, from: in i))
}

string interpolationSource(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    let text = t18Text(in c, from: b.file, at: parser.exprSpan(in e))
    switch e {
        case .literalExpr(let l):
            if l.value.kind == .string && !t18ContainsBraces(text) {
                return text[1..text.length - 1]
            }
        case .interpolatedExpr(_):
            if text.startsWith("$\"") && !text.startsWith("$\"\"\"") {
                return text[2..text.length - 1]
            }
        default: {}
    }
    return $"{{{text}}}"
}

/// BYN2201: strings have no indexer (spec §3.2); offer the four alternatives.
void t18ReportStringIndexer(ref Binder b, through ref Ctx c, for parser.IndexExpr i) {
    let targetSpan = parser.exprSpan(in i.target)
    let indexSpan = parser.exprSpan(in i.index)
    let s = t18Text(in c, from: b.file, at: targetSpan)
    let index = t18Text(in c, from: b.file, at: indexSpan)
    let diagSpan = TextSpan.fromBounds(targetSpan.end, until: i.span.end)
    let help = $"read a byte, slice, or take characters; `string` is UTF-8, so position {index} is not a character:\n  `{s}.bytes[{index}]`       the byte at offset {index} (applied below)\n  `{s}[a..b]`          the text between byte offsets a and b\n  `{s}.runes.take(n)`  the first n runes\n  `{s}.graphemes`      user-perceived characters"
    report(ref b, through: ref c, for: .stringIndexer, at: diagSpan, by: ("", "", "", "", ""), label: "strings have no indexer", help: help, hasFix: true, fixSpan: i.span, fixReplacement: $"{s}.bytes[{index}]")
}
