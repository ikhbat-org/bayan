// The shared state of the self-hosted checker: handles into the arenas, the per-file and per-module
// records, the diagnostic bag, the deferred-work item and the binder's cursors. Every type another
// semantics file names lives here; T3/T4 extend `Ctx` with arenas and the file is frozen after T4.
//
// The C# keeps this state in `Compilation` (`src/Bayan.Semantics/Compilation.cs`: the module list,
// the diagnostic bag, the sinks, the options), in `FileContext` (`Symbols/Symbols.cs:69-80`: the
// tree, the module, the imports) and in `Binder`. A handle is an index into an arena; -1 is C#'s
// `null`. `Type` and the bound handles encode `(kind << 32) | index`.

import lexer
import parser

public type TextSpan = lexer.TextSpan
public type CompilationUnit = parser.CompilationUnit

// ── Handles ─────────────────────────────────────────────────────────────────────

/// A `Ctx.files` index.
public type FileId = i64
/// A `Ctx.modules` index.
public type ModId = i64
public type StructId = i64
public type InterfaceId = i64
public type ErrorSetId = i64
public type EnumId = i64
public type UnionId = i64
public type FuncId = i64
public type LocalId = i64
public type ConstId = i64
public type TypeParamId = i64
public type FieldId = i64
public type PropertyId = i64
public type VariantId = i64
public type TestId = i64
public type ConformanceId = i64
public type AliasId = i64
public type EnumFieldId = i64
public type EnumMemberId = i64
/// `(TypeKind << 32) | index`; canonical, so C#'s structural equality is handle equality.
public type Type = i64
/// `(BoundKind << 32) | index` into T4's bound arenas.
public type BExpr = i64
public type BStmt = i64
public type BPattern = i64

// ── Files and modules ───────────────────────────────────────────────────────────

/// One source the checker reads: a `.byn` file, a parsed `"<builtin>"` source, or `"package.byn"`.
/// The C# `FileContext`: one file's tree and the imports visible in it (Q521).
public struct SourceFile {
    /// The path the loader opened.
    public string path
    /// The path diagnostics print, relative to the project root.
    public string displayPath
    /// The bytes the parser read.
    public List<u8> text
    public CompilationUnit unit
    /// The module whose files this one belongs to.
    public ModId module = -1
    /// The entry module's files, which hold `main` or the top-level statements.
    public bool isEntry = false
    /// A `tests/*.test.byn` file; the C# `FileContext.IsTestFile`.
    public bool isTestFile = false
    /// The modules this file imports, by the name it uses (the C# `FileContext.Imports`).
    public Map<string, ModId> imports
}

/// A directory of files that one `import` names.
public struct Mod {
    public string name
    public List<FileId> files
    /// The directory the module's files came from (the C# `ModuleSymbol.Directory`).
    public string directory = ""
    /// The name used in emitted C identifiers (the C# `ModuleSymbol.CName`).
    public string cName = ""
    /// Named types by their declared name (the C# `ModuleSymbol.Types`).
    public Map<string, Type> types = []
    /// Functions by name; one name may be overloaded (the C# `ModuleSymbol.Functions`).
    public Map<string, List<FuncId>> functions = []
    /// Constants by name (the C# `ModuleSymbol.Constants`).
    public Map<string, ConstId> constants = []
    public List<StructId> structs = List<StructId>()
    public List<ErrorSetId> errorSets = List<ErrorSetId>()
    public List<EnumId> enums = List<EnumId>()
    public List<UnionId> unions = List<UnionId>()
    public List<InterfaceId> interfaces = List<InterfaceId>()
    public List<FuncId> allFunctions = List<FuncId>()
    public List<TestId> tests = List<TestId>()
    public List<ConstId> allConstants = List<ConstId>()
    /// The implicit `main` built from top-level statements, or an explicit `main`; -1 when absent.
    public FuncId main = -1
}

// ── Diagnostics ─────────────────────────────────────────────────────────────────

/// A secondary span under a diagnostic, underlined with `---` (the C# `RelatedSpan`).
public struct Related {
    public TextSpan span
    public string label
}

/// A compiler diagnostic (the C# `Diagnostic`): a code, a place, an optional fix and related spans.
/// An empty `label` or `help` is C#'s `null`; `file` is -1 for a diagnostic with no location.
public struct Diag {
    public string code = ""
    public FileId file = -1
    public TextSpan span
    public string message
    public string label = ""
    public string help = ""
    public bool isWarning = false
    public bool hasFix = false
    public TextSpan fixSpan
    public string fixReplacement = ""
    public List<Related> related
}

/// A nested diagnostic sink (the C# `PushBag`): its items and the bag it was pushed over.
public struct DiagBag {
    public List<Diag> items
    /// The `Ctx.bags` index of the enclosing bag, or -1 for the outermost.
    public i64 previous = -1
}

// ── Deferred work ──────────────────────────────────────────────────────────────

/// What T11's `drain` does with a `Work` item.
public enum WorkKind {
    /// A `where` clause to check; drained by `declare`.
    where
    keyCheck
    constraint
    interfaceMembers
    members
    unionVariants
    conform
    fieldDefault
    bindFunction
}

/// One deferred check (the C# `Work` record): a kind, the type it is about and where it came from.
public struct Work {
    public WorkKind kind
    public Type subject = -1
    public List<Type> args
    /// The instantiated function a `bindFunction` item binds, or -1.
    public FuncId instance = -1
    public FileId file = -1
    public TextSpan span
    public i64 declIndex = -1
    public i64 memberIndex = -1
    /// C# `AfterMembersDeclared` wraps the check in `Instantiating(site, span, check)` when `_instantiationSite` is
    /// set (Compilation.cs:1550): `atSite` says it was, `siteFile`/`siteSpan` hold that site (Q716, dispatcher 2026-10-31).
    public bool atSite = false
    public FileId siteFile = -1
    public TextSpan siteSpan = TextSpan { start: 0, length: 0 }
}

/// A `break`/`continue` target: a label if it has one, and whether it belongs to a loop.
public struct JumpTarget {
    public string? label = null
    public bool isLoop = false
    public i64 id = -1
}

// ── The 128-bit integer ────────────────────────────────────────────────────────

/// A 128-bit two's-complement integer, as `lo` (low 64 bits) and `hi` (high 64 bits). Bayan has no
/// `i128`, and `PrimitiveType.Range` returns one (Q540); T5 owns the operations.
public struct Big {
    public u64 lo
    public u64 hi
}

/// A parsed `Big`, or why it is not one: `ok` is false for a syntax error, `overflow` for a value
/// outside the 128-bit range.
public struct BigParse {
    public Big value
    public bool ok = false
    public bool overflow = false
}

// ── Constructed-type data (T3) ────────────────────────────────────────────────

/// The parts of a `Span<T>` / `ReadOnlySpan<T>`.
public struct SpanData {
    public Type element
    public bool readOnly
}

/// The parts of a `dyn ref [readonly] I`.
public struct DynRefData {
    public InterfaceId iface
    public bool readOnly
}

/// The key and value of a `Map<K, V>`.
public struct MapData {
    public Type key
    public Type value
}

/// The element and length of a `T[N]`.
public struct ArrayData {
    public Type element
    public i64 length
}

/// One field of a tuple type; `name` is null for an unnamed element.
public struct TupleField {
    public string? name = null
    public Type type
}

/// The parts of a function type `(A, B) -> R uses net fails E`.
public struct FunctionData {
    public List<Type> parameters
    public Type ret
    public List<ErrorSetId> errorSets
    public List<string> effects
}

/// The value and error of a `Result<T, E>`.
public struct ResultData {
    public Type value
    public Type error
}

/// The struct and known states of a state type.
public struct StateData {
    public StructId s
    public List<VariantId> states
}

/// The sets and excluded variants of an error union.
public struct ErrorUnionData {
    public List<ErrorSetId> sets
    public List<VariantId> excluded
}

// ── The checker's state ────────────────────────────────────────────────────────

/// Everything a pass reads and writes. T3 adds the symbol/type arenas and their caches, T4 the bound
/// arenas; one owner per field.
/// Where a piece of syntax lives, for state the C# keeps as syntax references (Q714): `c.files[file].unit.members[declIndex]`,
/// then member `memberIndex`, item `itemIndex` and sub-item `subIndex` as the owning task documents; -1 where unused.
public struct SyntaxRef {
    public FileId file = -1
    public i64 declIndex = -1
    public i64 memberIndex = -1
    public i64 itemIndex = -1
    public i64 subIndex = -1
}

/// C# `_exitCodes` entry: a variant and its `@exitCode` attribute (Q714).
public struct ExitCodeRef {
    public VariantId variant = -1
    public SyntaxRef attribute
}

/// C# `_testBodies` value: the test's declaration and, for a `@cases` test, the case whose values it binds (Q714).
public struct TestBody {
    public SyntaxRef decl
    public bool hasValues = false
    public SyntaxRef values
}

public struct Ctx {
    public List<SourceFile> files
    public List<Mod> modules
    public List<Diag> diagnostics
    /// Nested sinks; empty for the outermost.
    public List<DiagBag> bags
    /// The bag index new diagnostics go to, or -1 for `diagnostics`.
    public i64 sink = -1
    /// Whether diagnostics are dropped rather than kept (the C# `_quiet`).
    public bool quiet = false
    /// A library has no `main`, so none is required.
    public bool library = false
    /// The package's `capabilities`, the upper bound on its effects (§13); null for no bound.
    public List<string>? capabilities = null
    /// The package's name, for BYN6004; empty when there is none.
    public string packageName = ""

    // ── T3: symbol arenas (one per `Symbols.cs` class plus `AliasPlaceholder`) ──
    public List<StructSymbol> structs = List<StructSymbol>()
    public List<FieldSymbol> fields = List<FieldSymbol>()
    public List<PropertySymbol> properties = List<PropertySymbol>()
    public List<FunctionSymbol> functions = List<FunctionSymbol>()
    public List<InterfaceSymbol> interfaces = List<InterfaceSymbol>()
    public List<Conformance> conformances = List<Conformance>()
    public List<LocalSymbol> locals = List<LocalSymbol>()
    public List<ConstSymbol> consts = List<ConstSymbol>()
    public List<ErrorSetSymbol> errorSets = List<ErrorSetSymbol>()
    public List<ErrorVariantSymbol> errorVariants = List<ErrorVariantSymbol>()
    public List<TestSymbol> tests = List<TestSymbol>()
    public List<EnumSymbol> enums = List<EnumSymbol>()
    public List<EnumFieldSymbol> enumFields = List<EnumFieldSymbol>()
    public List<EnumMemberSymbol> enumMembers = List<EnumMemberSymbol>()
    public List<UnionSymbol> unions = List<UnionSymbol>()
    public List<UnionVariantSymbol> unionVariants = List<UnionVariantSymbol>()
    public List<TypeParam> typeParams = List<TypeParam>()
    public List<AliasPlaceholder> aliases = List<AliasPlaceholder>()

    // ── T3: constructed-type arenas (one per constructed kind) ──
    public List<Type> optionalTypes = List<Type>()
    public List<SpanData> spanTypes = List<SpanData>()
    public List<DynRefData> dynRefTypes = List<DynRefData>()
    public List<Type> listTypes = List<Type>()
    public List<MapData> mapTypes = List<MapData>()
    public List<Type> ownedTypes = List<Type>()
    public List<Type> untrustedTypes = List<Type>()
    public List<ArrayData> arrayTypes = List<ArrayData>()
    public List<Type> rangeTypes = List<Type>()
    public List<List<TupleField>> tupleTypes = List<List<TupleField>>()
    public List<FunctionData> functionTypes = List<FunctionData>()
    public List<ResultData> resultTypes = List<ResultData>()
    public List<StateData> stateTypes = List<StateData>()
    public List<ErrorUnionData> errorUnionTypes = List<ErrorUnionData>()

    // ── T3: interning caches (one `Map` per constructed kind) ──
    public Map<string, i64> optionalIntern = []
    public Map<string, i64> spanIntern = []
    public Map<string, i64> dynRefIntern = []
    public Map<string, i64> listIntern = []
    public Map<string, i64> mapIntern = []
    public Map<string, i64> ownedIntern = []
    public Map<string, i64> untrustedIntern = []
    public Map<string, i64> arrayIntern = []
    public Map<string, i64> rangeIntern = []
    public Map<string, i64> tupleIntern = []
    public Map<string, i64> functionIntern = []
    public Map<string, i64> resultIntern = []
    public Map<string, i64> stateIntern = []
    public Map<string, i64> errorUnionIntern = []

    /// While set, declared types display with their module (`a.Point`); the C# `[ThreadStatic] QualifyModules`.
    public bool qualifyModules = false
    /// Effect/verb/noun/adjective names (T6 fills them).
    public List<string> lexiconVerbs = List<string>()
    public List<string> lexiconNouns = List<string>()
    public List<string> lexiconAdjectives = List<string>()

    // ── T3+: shared caches (the owner task fills them) ──
    /// T5: template handle -> instance handle.
    public Map<i64, i64> instances = []
    /// T5: the instantiation worklist.
    public List<Work> instantiationWork = List<Work>()
    public List<Work> pendingKeys = List<Work>()
    public List<Work> pendingConstraints = List<Work>()
    public Map<i64, i64> states = []
    public Map<i64, i64> distinct = []
    public Map<i64, i64> positional = []
    public Map<i64, i64> invokeSymbols = []
    public Map<i64, i64> validationErrors = []
    public Map<i64, i64> conformancesChecked = []

    // ── Bound arenas (T4): one per node struct of bound.byn, in `BoundKind` order ──
    public List<BLiteral> bLiterals = List<BLiteral>()
    public List<BSymbolLiteral> bSymbolLiterals = List<BSymbolLiteral>()
    public List<BHostTarget> bHostTargets = List<BHostTarget>()
    public List<BDefault> bDefaults = List<BDefault>()
    public List<BLocal> bLocals = List<BLocal>()
    public List<BThis> bThises = List<BThis>()
    public List<BField> bFields = List<BField>()
    public List<BTupleElement> bTupleElements = List<BTupleElement>()
    public List<BCall> bCalls = List<BCall>()
    public List<BBuiltinCall> bBuiltinCalls = List<BBuiltinCall>()
    public List<BUnary> bUnaries = List<BUnary>()
    public List<BBinary> bBinaries = List<BBinary>()
    public List<BConversion> bConversions = List<BConversion>()
    public List<BTryFrom> bTryFroms = List<BTryFrom>()
    public List<BConditional> bConditionals = List<BConditional>()
    public List<BCoalesce> bCoalesces = List<BCoalesce>()
    public List<BStructLiteral> bStructLiterals = List<BStructLiteral>()
    public List<BWith> bWiths = List<BWith>()
    public List<BTuple> bTuples = List<BTuple>()
    public List<BCollection> bCollections = List<BCollection>()
    public List<BSpread> bSpreads = List<BSpread>()
    public List<BIndex> bIndexes = List<BIndex>()
    public List<BSlice> bSlices = List<BSlice>()
    public List<BRange> bRanges = List<BRange>()
    public List<BIs> bIses = List<BIs>()
    public List<BSwitchExpr> bSwitchExprs = List<BSwitchExpr>()
    public List<BInterpolated> bInterpolateds = List<BInterpolated>()
    public List<BMove> bMoves = List<BMove>()
    public List<BTry> bTries = List<BTry>()
    public List<BCatch> bCatches = List<BCatch>()
    public List<BJump> bJumps = List<BJump>()
    public List<BBlockExpr> bBlockExprs = List<BBlockExpr>()
    public List<BErrorVariant> bErrorVariants = List<BErrorVariant>()
    public List<BEnumMember> bEnumMembers = List<BEnumMember>()
    public List<BUnionNew> bUnionNews = List<BUnionNew>()
    public List<BEnumValues> bEnumValues = List<BEnumValues>()
    public List<BStaticArray> bStaticArrays = List<BStaticArray>()
    public List<BStackalloc> bStackallocs = List<BStackalloc>()
    public List<BErrorExpr> bErrorExprs = List<BErrorExpr>()
    public List<BTypeRef> bTypeRefs = List<BTypeRef>()
    public List<BModuleRef> bModuleRefs = List<BModuleRef>()
    public List<BLambda> bLambdas = List<BLambda>()
    public List<BFunctionRef> bFunctionRefs = List<BFunctionRef>()
    public List<BBlock> bBlocks = List<BBlock>()
    public List<BLocalDecl> bLocalDecls = List<BLocalDecl>()
    public List<BExprStmt> bExprStmts = List<BExprStmt>()
    public List<BAssign> bAssigns = List<BAssign>()
    public List<BReturn> bReturns = List<BReturn>()
    public List<BFail> bFails = List<BFail>()
    public List<BBecome> bBecomes = List<BBecome>()
    public List<BBreak> bBreaks = List<BBreak>()
    public List<BContinue> bContinues = List<BContinue>()
    public List<BIf> bIfs = List<BIf>()
    public List<BWhile> bWhiles = List<BWhile>()
    public List<BDoWhile> bDoWhiles = List<BDoWhile>()
    public List<BFor> bFors = List<BFor>()
    public List<BSwitch> bSwitches = List<BSwitch>()
    public List<BDefer> bDefers = List<BDefer>()
    public List<BAssert> bAsserts = List<BAssert>()
    public List<BErrdefer> bErrdefers = List<BErrdefer>()
    public List<BPanicDefer> bPanicDefers = List<BPanicDefer>()
    public List<BSetOnPanic> bSetOnPanics = List<BSetOnPanic>()
    public List<BContext> bContexts = List<BContext>()
    public List<BErrorStmt> bErrorStmts = List<BErrorStmt>()
    public List<BConstantPattern> bConstantPatterns = List<BConstantPattern>()
    public List<BRelationalPattern> bRelationalPatterns = List<BRelationalPattern>()
    public List<BRangePattern> bRangePatterns = List<BRangePattern>()
    public List<BBindPattern> bBindPatterns = List<BBindPattern>()
    public List<BNotPattern> bNotPatterns = List<BNotPattern>()
    public List<BBinaryPattern> bBinaryPatterns = List<BBinaryPattern>()
    public List<BPropertyPattern> bPropertyPatterns = List<BPropertyPattern>()
    public List<BUnionField> bUnionFields = List<BUnionField>()
    public List<BUnionPattern> bUnionPatterns = List<BUnionPattern>()
    public List<BErrorField> bErrorFields = List<BErrorField>()
    public List<BErrorPattern> bErrorPatterns = List<BErrorPattern>()
    public List<BMethodGroup> bMethodGroups = List<BMethodGroup>()
    public List<BVariantGroup> bVariantGroups = List<BVariantGroup>()
    public List<BBuiltinGroup> bBuiltinGroups = List<BBuiltinGroup>()
    /// `break`/`continue` targets; `BBreak.target` and the loop/switch `target` fields index it.
    public List<JumpTarget> jumpTargets = List<JumpTarget>()
    /// C# `BoundExpr.Constant`, by expression handle.
    public Map<i64, Constant> constants = []
    /// The `syntax…` bits of bound.byn (what C# reads from `BoundNode.Syntax`), by node handle.
    public Map<i64, i64> syntaxFlags = []
    /// C# `BoundNode.Syntax` when it is an `Expr` (T21, Q850): the recorded syntax nodes, and each bound node's handle into them.
    public List<ExprSyntax> exprSyntaxNodes = List<ExprSyntax>()
    public Map<i64, i64> exprSyntaxOf = []
    /// C# `Compilation.Checks`: each struct's `requires` check; `checksOf` maps a `StructId` to its index.
    public List<StructChecks> checks = List<StructChecks>()
    public Map<StructId, i64> checksOf = []

    // ── Shared state (Q714): written by one task, read by another; only the dispatcher adds fields here.
    /// C# `_exitCodes` (T12 fills it in `declareVariants`, T13 `bindAll` binds each).
    public List<ExitCodeRef> exitCodes = List<ExitCodeRef>()
    /// C# `_mainStatements` (T11 fills it in `declareFile`, T13 `bindFunction` binds them): the synthesized `main`, or -1,
    /// and its top-level statements in order.
    public FuncId mainStatementsFn = -1
    public List<SyntaxRef> mainStatements = List<SyntaxRef>()
    /// C# `_testBodies` (T11 fills it in `declareFile`, T13 `bindFunction` binds each).
    public Map<FuncId, TestBody> testBodies = []
    /// C# `Options.IncludeTests` and `Options.SkipOwnershipCheck` (T11 sets them when it creates the compilation).
    public bool includeTests = false
    public bool skipOwnershipCheck = false
    /// C# `_associatedBindings` (T12 fills it in `declareMembers`, T14 reads it): `"{s} {name}"` to the resolved `type name = …;`.
    public Map<string, Type> associatedBindings = []
    /// C# `_baseSpans` (T12 fills it in `declareMembers`, T14 reads it): `"{s} {i}"` to where the base is listed.
    public Map<string, TextSpan> baseSpans = []
    /// C# `Builtins.Panic` (Q858; `Builtins` constructor fills it, T3 of spec 011 `lowerIf` reads it): the built-in `panic` function.
    public FuncId builtinPanic = -1
    /// C# `Builtins.StrBufGrow` (Q861; `Builtins` constructor fills it, T4/T5 of spec 011 read it): the built-in growable `StrBuf()`.
    public FuncId builtinStrBufGrow = -1

    // ── Per-task state (Q710). A task adds the C# fields it needs, with defaults, only under its own marker.
    // ── T10 state
    // ── T11 state
    /// C# `PackageRoot`: imports resolve under it.
    public string packageRoot = ""
    /// C# `DisplayRoot`: imported files are named relative to it.
    public string displayRoot = ""
    /// C# `Modules`: every loaded module, dependencies before dependents (`modules` also holds the builtin module).
    public List<ModId> moduleOrder = List<ModId>()
    /// C# `EntryModule`.
    public ModId entryModule = -1
    /// C# `OnPanic`: the function `Panic.onPanic` is set to in `main`; -1 for none (T36 sets it).
    public FuncId onPanic = -1
    /// C# `_modulesByDir` and `_loading`.
    public Map<string, ModId> modulesByDir = []
    public List<ModId> loading = List<ModId>()
    /// C# `Options.Std ?? StdLibrary.Shipped`: the std modules `import std.…` reads, built once in `create`.
    public StdLibrary std = StdLibrary {}
    /// C# `ParseTime` and `CheckTime`, in nanoseconds.
    public i64 parseTime = 0
    public i64 checkTime = 0
    /// C# `_aliases`: the aliases `addType` accepted, in declaration order.
    public List<AliasId> aliasOrder = List<AliasId>()
    /// C# `_testCases`: the accepted cases of each test with `@cases`, by `declKey(file, declIndex)`.
    public Map<i64, TestCases> testCases = []
    /// C# `_wheres` and `_associatedTypes` (key `"<owner> <name>"`).
    public List<Work> wheres = List<Work>()
    public Map<string, TypeParamId> associatedTypes = []
    /// C# `MembersDeclared`.
    public bool membersDeclared = false
    // ── T12 state
    // ── T13 state
    /// C# `_instances` (Q581): `t13Key` of `(Generic, Args)` to the instance (a `FuncId` or a `Type`).
    public Map<string, i64> instanceKeys = []
    /// C# `_instantiating`: depth of `Instantiating` calls.
    public i64 instantiating = 0
    /// C# `_instantiationSite`: whether it is set, and its file and span.
    public bool hasInstantiationSite = false
    public FileId instantiationSiteFile = -1
    public TextSpan instantiationSiteSpan = TextSpan { start: 0, length: 0 }
    /// C# `_instantiationErrors`: what instantiation reported that is not the user's.
    public List<Diag> instantiationErrors = List<Diag>()
    /// C# `_instanceAnalysisSeen` (a set): `code|file|start|length` of each instance-analysis diagnostic kept.
    public Map<string, i64> instanceAnalysisSeen = []
    /// C# `_firstPass`: a `firstPasses` index, or -1 for null.
    public i64 firstPass = -1
    public List<FirstPass> firstPasses = List<FirstPass>()
    /// C# `RequiresChecks`.
    public List<RequiresCheck> requiresChecks = List<RequiresCheck>()
    /// C# `_interfaceMembersDeclared` and `_pendingInterfaces` (`Work { kind: .interfaceMembers }`).
    public bool interfaceMembersDeclared = false
    public List<Work> pendingInterfaces = List<Work>()
    // ── T14 state
    /// C# `_conformancesChecked` (Q709).
    public bool checkedConformances = false
    // ── T15 state
    // ── T16 state
    // ── T17 state
    // ── T18 state
    // ── 012 T18 state
    /// C# `Options.Target`: the build target `Target.os`/`Target.arch` name; null for the compiling host.
    public string? target = null
    // ── T19 state
    // ── T20 state
    // ── T21 state
    // ── T22 state
    // ── T23 state
    /// C# `((CatchExpr)c.Syntax).Variant.Span` (FlowAnalysis.cs:314), by the `catchExpr` handle; the catch binder fills it (Q632).
    public Map<BExpr, TextSpan> catchVariantSpans = []
    // ── T24 state
    // ── T25 state
    // ── T26 state
    /// C# `CliApp.Compiled.Manifest`: the project's manifest, null outside a project (read by `programName`).
    public Manifest? manifest = null
    // ── T27 state
    // ── T28 state
    /// The text of each name `for try` synthesizes (Binder.cs:1113-1115), by `-1 - span.start` (Q679).
    public List<string> syntheticNames = List<string>()
    /// C# `_unobservable` and `_unobservableSeen` (a set): `file|start|length|op` of each mark kept.
    public List<UnobservableMark> unobservable = List<UnobservableMark>()
    public Map<string, i64> unobservableSeen = []
    /// C# `Compilation.MutationChecks`: calls of methods through a receiver, checked once every body is bound.
    public List<MutationCheck> mutationChecks = List<MutationCheck>()
    // ── T29 state
    // ── T30 state
    // ── T31 state
    // ── T32 state
    // ── T33 state
    // ── T34 state
    // ── T35 state
    // ── T36 state
    // ── T37 state
    /// C# `Compilation.ChangedFields`: the fields each `ref this` method changes structurally, as a set in insertion order.
    public Map<FuncId, List<FieldId>> changedFields = []
    // ── T38 state
    /// C# `_inReportedCycle`: structs and unions already reported as part of a cycle.
    public List<Type> inReportedCycle = List<Type>()
    // ── T39 state
    /// C# `Compilation.ThisWrites`: the first write to `this` in each method not declared `ref this` (Q694).
    public Map<FuncId, T39ThisWrite> thisWrites = []
    // ── T40 state
    /// The C# span of each `for try` synthetic name (Binder.cs:1110-1115, `f.Iterable.Span`), beside `syntheticNames`.
    public List<TextSpan> syntheticSpans = List<TextSpan>()
    // ── P2 state
    /// C# `BoundNode.Syntax` when it is not an `Expr` (P2, Q1076): the recorded nodes, and each bound node's handle into them.
    public List<NodeSyntax> nodeSyntaxNodes = List<NodeSyntax>()
    public Map<i64, i64> nodeSyntaxOf = []
    /// C# `Options` and `_entryFiles`, which `withFile` compiles again (Compilation.cs:61, 45).
    public CompilationOptions options = CompilationOptions {}
    public List<lexer.SourceText> entryFiles = List<lexer.SourceText>()
    /// C# `_replaced`: files read from this text instead of from disk, by path (Compilation.cs:47, 212).
    public Map<string, lexer.SourceText> replaced = []
    /// The keys of `replaced`, for `withFile` to copy it: a map of unique values is neither copied nor iterated (Q1103).
    public List<string> replacedPaths = List<string>()
    // ── T41 state
    /// C# `Compilation.StoreSummaries`: for each template with a body, what it may store from a parameter (or `this`, -1)
    /// into a `ref`/`out` parameter (or its `ref this` receiver), with the first place it does, in insertion order.
    public Map<FuncId, List<StorePair>> storeSummaries = []
    /// C# `Compilation.ReturnSummaries`: for each template with a body, the parameters (or `this`, -1) its result may borrow.
    public Map<FuncId, List<i64>> returnSummaries = []
}

// ── The binder's cursors ──────────────────────────────────────────────────────

/// C# `_calleeOf` (BinderExpressions.cs:920), as what T18's renamed-call readers use (Q731): a parser node is
/// unique, so the binder keeps the call's spans and argument shape instead. Spans are zero-length where absent.
public struct CalleeOf {
    public TextSpan span
    /// The callee is a `.memberExpr`; `member` and `target` are its member and target spans.
    public bool isMember = false
    public TextSpan member = TextSpan { start: 0, length: 0 }
    public TextSpan target = TextSpan { start: 0, length: 0 }
    public i64 argCount = 0
    /// The first two arguments are both unnamed with modifier `.none`.
    public bool firstTwoPlain = false
    public TextSpan arg0 = TextSpan { start: 0, length: 0 }
    public TextSpan arg1 = TextSpan { start: 0, length: 0 }
}

CalleeOf calleeOfCall(parser.CallExpr call) {
    var r = CalleeOf { span: call.span, argCount: call.args.length }
    switch call.callee {
        case .memberExpr(let me):
            r.isMember = true
            r.member = me.value.member
            r.target = parser.exprSpan(in me.value.target)
        default: {}
    }
    if call.args.length > 0 { r.arg0 = parser.exprSpan(in call.args[0].value) }
    if call.args.length > 1 {
        r.arg1 = parser.exprSpan(in call.args[1].value)
        r.firstTwoPlain = call.args[0].name is null && call.args[0].modifier == .none && call.args[1].name is null && call.args[1].modifier == .none
    }
    return r
}

/// C# `_covered` entry (BinderCalls.cs:14), as what ReportUnhandled (BinderCalls.cs:944) reads (Q731).
public struct CoveredCall {
    public TextSpan span
    public string name
    public bool structLiteral
}

/// The C# `Binder`'s per-body state: the file and function being bound, the scopes, the jump targets
/// and the narrowing facts. Every field is a T1 handle or a parser type.
public struct Binder {
    public FileId file = -1
    public FuncId fn = -1
    public StructId owner = -1
    /// The receiver's type for `this`, or -1.
    public Type thisType = -1
    public i64 nextLocalId = 0
    /// The open scopes, innermost last.
    public List<Map<string, LocalId>> scopes
    /// The enclosing loops and labeled statements.
    public List<JumpTarget> targets
    public i64 deferDepth = 0
    public bool inPanicHandler = false
    /// The first statement of the body being bound, or -1.
    public i64 firstStatement = -1
    public bool onPanicSet = false
    /// A lambda's captured parameters, by the function it belongs to.
    public List<(FuncId, List<BExpr>)> lambdas
    public Map<FuncId, i64> lambdaCount
    public i64 itDepth = 0
    public i64 held = 0
    /// C# `_seeds`: the locals a re-bind starts from (`bindFunction`'s second pass), and their types.
    public List<(i64, Type)> seeds
    /// Flow facts keyed by the `LocalDecl` span start.
    public Map<i64, i64> pending
    public Map<i64, i64> constraints
    public Map<i64, i64> peers
    /// Locals known to be non-null, and their span start.
    public List<(i64, LocalId)> nonNull
    public List<(i64, LocalId, Type)> stateFacts
    /// The variant a local's error value was narrowed to.
    public Map<LocalId, VariantId> errorNarrowed

    // ── Per-task binder state (Q710), as in `Ctx`.
    // ── T15 state
    /// The C# constructor's `typeArgs`, which `_types` resolves with before the function's or struct's map; null for none.
    public Map<string, Type>? typeArgs = null
    /// The C# `_it`: the field whose own rule is being bound, or -1.
    public FieldId itField = -1
    /// The C# `_thisFacts`: the fact key for `this`, made on first use; null until then.
    public LocalId? thisFacts = null
    /// The C# `_types` map (see `typeArgs`), taken once by T15's `t15CaptureTypes`; `typesCaptured` says whether it was.
    public Map<string, Type> types = []
    public bool typesCaptured = false
    /// The C# `Scope` identities, parallel to `scopes` (innermost last); facts keyed by a scope compare these (Q715).
    public List<i64> scopeIds = []
    /// The identity the next opened scope takes.
    public i64 nextScopeId = 0
    /// The C# `_firstStatement`, by its file and full span (Q719); `firstStatementFile` is -1 for none.
    public FileId firstStatementFile = -1
    public TextSpan firstStatementSpan = TextSpan { start: 0, length: 0 }
    // ── T16 state
    /// The C# `_handled` (BinderCalls.cs:11): the span (in `file`) of the call a `try`, `catch` or `assert … fails` handles; null for none.
    public TextSpan? handled = null
    // ── T17 state
    /// The C# `_caught` (BinderCalls.cs:17): the local `caught` reads in a `catch` handler, or -1.
    public LocalId caught = -1
    /// The C# `_printArgument` (BinderCalls.cs:193): an argument of `print` is being converted.
    public bool printArgument = false
    /// The C# `_sinkArgument` (BinderCalls.cs:196): the sink parameter an argument is converted to, or null.
    public string? sinkArgument = null
    // ── T18 state
    public CalleeOf? calleeOf = null
    public Map<LocalId, VariantId> narrowed = []
    // ── T19 state
    // ── T20 state
    /// The C# `_prebound` (BinderCalls.cs:248), keyed by the argument's span start in `file` for its identity (Q617).
    public Map<i64, BExpr> prebound = []
    /// The C# `_covered` (BinderCalls.cs:14): while a `try` operand is bound, the failing calls it does not handle; null outside one.
    public List<CoveredCall>? covered = null
    // ── T21 state
    /// The C# `_patternOwns` (BinderCalls.cs:906): the patterns being bound are on a `switch move x` subject, so their bindings own their parts.
    public bool patternOwns = false
    // ── T22 state
    // ── T23 state
    // ── T24 state
    // ── T25 state
    // ── T34 state
    // ── T35 state
    // ── T36 state
    // ── T37 state
    // ── T38 state
    // ── T39 state
    // ── T40 state
}
