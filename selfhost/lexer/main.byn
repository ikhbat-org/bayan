// bayan-lex: the self-hosted lexer. Prints the same token dump as `bayan lex`.
//
//     bayan-lex [--json] [<path>|-] the token dump (`--json`: the JSON form) of `<path>`, or of stdin
//                               given `-` or no path; exit 0 if there are no error diagnostics, else 1
//     bayan-lex --many <dir>    `== <name>` and the dump of every `*.byn` in `<dir>`, in name order,
//                               preceded by a `span out of range` line for any span outside the input
//     bayan-lex --time <path>   only the nanoseconds spent lexing
//
// Exit 2 on a usage error or an unreadable file under `--many`/`--time`; exit 4 when the input of
// the token dump cannot be read.

const exitOk: i32 = 0
const exitFailure: i32 = 1
const exitUsage: i32 = 2
const exitInput: i32 = 4

i32 usage(string message) {
    Io.stderr.write($"bayan-lex: {message}\nusage: bayan-lex [--json] [<path>|-] | --many <dir> | --time <path>\n")
    return exitUsage
}

i32 fileNotFound(string path) {
    Io.stderr.write($"bayan: file not found: {path}\n")
    return exitUsage
}

i32 unreadable(string path) {
    Io.stderr.write($"bayan-lex: cannot read `{path}`\n")
    return exitInput
}

/// Lexes `path` and appends its dump (`json`: the JSON form) to `sb`; returns whether any diagnostic is an error.
public bool dumpFile(string path, from move List<u8> bytes, by Keywords keywords, to ref StrBuf sb, bool json) uses alloc {
    var result = lex(SourceText.create(path, from: move bytes), by: keywords)
    if json {
        dumpJson(ref result, to: ref sb)
    } else {
        dump(ref result, to: ref sb)
    }
    return !result.diagnostics.isEmpty
}

/// Appends a `span out of range` line for every token, doc or diagnostic span outside the input.
void checkSpans(ref LexResult result, to ref StrBuf sb) {
    let size = result.source.bytes.length
    for token in result.tokens {
        unless inside(TextSpan { start: token.start, length: token.length }, until: size) { sb.append($"span out of range: token {token.start}+{token.length}\n") }
        unless inside(TextSpan { start: token.docStart, length: token.docLength }, until: size) { sb.append($"span out of range: doc {token.docStart}+{token.docLength}\n") }
    }
    for d in result.diagnostics {
        unless inside(d.span, until: size) { sb.append($"span out of range: {d.code} {d.span.start}+{d.span.length}\n") }
        if d.hasFix && !inside(d.fixSpan, until: size) { sb.append($"span out of range: {d.code} fix {d.fixSpan.start}+{d.fixSpan.length}\n") }
    }
}

bool inside(TextSpan span, until i64 size) => span.start >= 0 && span.length >= 0 && span.end <= size

/// Dumps `path`, or stdin when `path` is `-`.
i32 lexOne(string path, by Keywords keywords, bool json) {
    var bytes = List<u8>()
    if path == "-" {
        let input = Io.stdin.readAllBytes()
        unless input.isOk {
            Io.stderr.write("bayan-lex: cannot read standard input\n")
            return exitInput
        }
        for b in input.value { bytes.append(b) }
    } else {
        bytes = Io.readFile(path) catch return unreadable(path)
    }
    var sb = StrBuf()
    let failed = dumpFile(path == "-" ? "<stdin>" : path, from: move bytes, by: keywords, to: ref sb, json: json)
    Io.stdout.write(sb.finish())
    return failed ? exitFailure : exitOk
}

i32 lexMany(string dir, by Keywords keywords) {
    let names = Io.listDir(dir) catch return usage($"cannot list `{dir}`")
    for name in names {
        unless name.endsWith(".byn") { continue }
        using let arena = Arena()
        provide allocator: arena {
            let path = $"{dir}/{name}"
            let bytes = Io.readFile(path) catch return fileNotFound(path)
            var sb = StrBuf()
            sb.append($"== {name}\n")
            var result = lex(SourceText.create(path, from: move bytes), by: keywords)
            checkSpans(ref result, to: ref sb)
            dump(ref result, to: ref sb)
            Io.stdout.write(sb.finish())
        }
    }
    return exitOk
}

i32 lexTimed(string path, by Keywords keywords) {
    let bytes = Io.readFile(path) catch return fileNotFound(path)
    let start = Io.monotonicNanos()
    let result = lex(SourceText.create(path, from: move bytes), by: keywords)
    let elapsed = Io.monotonicNanos() - start
    print($"{elapsed}")
    return result.tokens.isEmpty ? exitFailure : exitOk
}

i32 main(ReadOnlySpan<string> args) {
    let keywords = Keywords.build()
    if args.length == 0 { return lexOne("-", by: keywords, json: false) }
    if args.length == 1 && args[0] == "--json" { return lexOne("-", by: keywords, json: true) }
    if args.length == 1 && !args[0].startsWith("--") { return lexOne(args[0], by: keywords, json: false) }
    if args.length == 2 && args[0] == "--json" && !args[1].startsWith("--") { return lexOne(args[1], by: keywords, json: true) }
    if args.length == 2 && args[1] == "--json" && !args[0].startsWith("--") { return lexOne(args[0], by: keywords, json: true) }
    if args.length == 2 && args[0] == "--many" { return lexMany(args[1], by: keywords) }
    if args.length == 2 && args[0] == "--time" { return lexTimed(args[1], by: keywords) }
    return usage("expected `[--json] [<path>|-]`, `--many <dir>` or `--time <path>`")
}
