// Hand-written lexer over UTF-8 bytes. Ports `src/Bayan.Syntax/Lexing/Lexer.cs` method by method;
// identifier classes and NFC come from the generated `unicode-tables.byn` instead of the .NET
// runtime and ICU, with NFC ported from `tools/Bayan.UnicodeGen/Nfc.cs`.

const maxInterpolationDepth: i64 = 32

public LexResult lex(move SourceText source, by Keywords keywords) uses alloc {
    var modes = List<ModeEntry>()
    for i in 0..maxInterpolationDepth + 1 { modes.append(ModeEntry { inText: false, braceDepth: 0, start: 0 }) }
    var result = LexResult {
        source: move source,
        diagnostics: List<Diagnostic>(),
        modes: move modes,
        depth: 0,
        reportedTooDeep: false,
        pos: 0,
        tokenFlags: 0,
        docStart: -1,
        docEnd: -1,
        tokens: List<Token>(),
    }
    result.run(keywords)
    return result
}

// ── Unicode ───────────────────────────────────────────────────────────────────────

/// Whether `cp` lies in one of the inclusive `lo, hi` pairs of `ranges`.
bool inRanges(ReadOnlySpan<u32> ranges, for u32 cp) {
    var lo: i64 = 0
    var hi = ranges.length / 2
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if ranges[mid * 2 + 1] < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < ranges.length / 2 && ranges[lo * 2] <= cp
}

/// `_` and the letter categories Lu Ll Lt Lm Lo Nl.
bool isIdentifierStart(u32 cp) => inRanges(identStartRanges, for: cp)

/// C# `char.IsUpper(text[0])`: whether the first scalar is Lu. Above U+FFFF C# sees a high surrogate, and the tables are BMP only, so it is false.
public bool firstIsUpper(ReadOnlySpan<u8> text) => text.length > 0 && inRanges(upperRanges, for: decodeAt(text, at: 0).value)

/// C# `char.IsLower(text[0])`: whether the first scalar is Ll; false above U+FFFF like `firstIsUpper`.
public bool firstIsLower(ReadOnlySpan<u8> text) => text.length > 0 && inRanges(lowerRanges, for: decodeAt(text, at: 0).value)

/// Identifier starts plus U+200C U+200D and Mn Mc Nd Pc.
bool isIdentifierContinue(u32 cp) => isIdentifierStart(cp) || inRanges(identContinueRanges, for: cp)

/// Length of the bidi control character at `pos` and its code point, or 0.
(i64 length, u32 codePoint) bidiControlAt(ReadOnlySpan<u8> text, at i64 pos) {
    if pos + 2 >= text.length || text[pos] != 0xE2 { return (length: 0, codePoint: 0) }
    let b1 = text[pos + 1]
    let b2 = text[pos + 2]
    if (b1 == 0x80 && b2 >= 0xAA && b2 <= 0xAE) || (b1 == 0x81 && b2 >= 0xA6 && b2 <= 0xA9) {
        return (length: 3, codePoint: 0x2000 | (u32(b1 & 0x0F) << 6) | u32(b2 & 0x3F))
    }
    return (length: 0, codePoint: 0)
}

// NFC (UAX #15) over the generated tables: full canonical decomposition (Hangul algorithmic),
// canonical ordering by CCC, canonical composition with blocking.

const sBase: i64 = 0xAC00
const lBase: i64 = 0x1100
const vBase: i64 = 0x1161
const tBase: i64 = 0x11A7
const lCount: i64 = 19
const vCount: i64 = 21
const tCount: i64 = 28
const nCount: i64 = 588
const sCount: i64 = 11172

/// Index of the triple whose first entry is `cp` in `table`, or -1.
i64 findTriple(ReadOnlySpan<u32> table, for u32 cp) {
    var lo: i64 = 0
    var hi = table.length / 3
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if table[mid * 3] < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < table.length / 3 && table[lo * 3] == cp ? lo : -1
}

/// The canonical combining class of `cp`.
i64 ccc(u32 cp) {
    var lo: i64 = 0
    var hi = cccRanges.length / 3
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cccRanges[mid * 3 + 1] < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < cccRanges.length / 3 && cccRanges[lo * 3] <= cp ? cccRanges[lo * 3 + 2] : 0
}

/// Appends the full canonical decomposition of `cp`.
void decompose(u32 cp, to ref List<u32> output) {
    let s = i64(cp) - sBase
    if s >= 0 && s < sCount {
        output.append(u32(lBase + s / nCount))
        output.append(u32(vBase + s % nCount / tCount))
        if s % tCount != 0 { output.append(u32(tBase + s % tCount)) }
        return
    }
    let i = findTriple(decompIndex, for: cp)
    if i < 0 {
        output.append(cp)
        return
    }
    let offset = i64(decompIndex[i * 3 + 1])
    let length = i64(decompIndex[i * 3 + 2])
    for k in offset..offset + length { output.append(decompData[k]) }
}

/// Stable sort of each run of non-starters by CCC.
void reorder(ref List<u32> cps) {
    for i in 1..cps.length {
        let c = ccc(cps[i])
        if c == 0 { continue }
        let cp = cps[i]
        var j = i
        while j > 0 && ccc(cps[j - 1]) > c {
            cps[j] = cps[j - 1]
            j -= 1
        }
        cps[j] = cp
    }
}

/// Primary composite of the pair, or -1.
i64 composePair(u32 first, to u32 second) {
    let l = i64(first) - lBase
    let v = i64(second) - vBase
    if l >= 0 && l < lCount && v >= 0 && v < vCount { return sBase + (l * vCount + v) * tCount }
    let s = i64(first) - sBase
    let t = i64(second) - tBase
    if s >= 0 && s < sCount && s % tCount == 0 && t > 0 && t < tCount { return i64(first) + t }
    var lo: i64 = 0
    var hi = compPairs.length / 3
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let f = compPairs[mid * 3]
        if f < first || (f == first && compPairs[mid * 3 + 1] < second) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < compPairs.length / 3 && compPairs[lo * 3] == first && compPairs[lo * 3 + 1] == second { return compPairs[lo * 3 + 2] }
    return -1
}

/// Canonical composition in place; a character is blocked by an intervening one of equal or higher CCC.
void compose(ref List<u32> cps) {
    if cps.length == 0 { return }
    var starterIndex: i64 = 0
    var lastCcc: i64 = ccc(cps[0]) == 0 ? 0 : 256
    var count: i64 = 1
    for i in 1..cps.length {
        let cp = cps[i]
        let c = ccc(cp)
        let composite = composePair(cps[starterIndex], to: cp)
        if composite >= 0 && (lastCcc < c || lastCcc == 0) {
            cps[starterIndex] = u32(composite)
            continue
        }
        if c == 0 { starterIndex = count }
        lastCcc = c
        cps[count] = cp
        count += 1
    }
    while cps.length > count { let _ = cps.removeLast() }
}

/// The NFC form of the scalars `input`.
List<u32> normalize(ReadOnlySpan<u32> input) {
    var cps = List<u32>()
    for cp in input { decompose(cp, to: ref cps) }
    reorder(ref cps)
    compose(ref cps)
    return cps
}

// ── Lexer state ───────────────────────────────────────────────────────────────────

struct ModeEntry {
    /// True while scanning the text part of an interpolated string.
    bool inText
    /// Unclosed `{` inside an interpolation hole.
    i64 braceDepth
    /// Offset of the `$"` that opened this string.
    i64 start
}

/// The tokens and diagnostics of one source, and the lexer's state while it runs; the last token is `endOfFile`.
public struct LexResult {
    public SourceText source
    public List<Diagnostic> diagnostics
    /// `maxInterpolationDepth + 1` entries; `modes[depth]` is the current one.
    List<ModeEntry> modes
    i64 depth
    bool reportedTooDeep
    i64 pos
    u8 tokenFlags
    i64 docStart
    i64 docEnd
    public List<Token> tokens

    void run(ref this, Keywords keywords) {
        if source.bytes.length >= 3 && source.bytes[0] == 0xEF && source.bytes[1] == 0xBB && source.bytes[2] == 0xBF { pos = 3 }
        while true {
            if modes[depth].inText {
                lexInterpolatedText()
                continue
            }
            skipTrivia()
            if pos >= source.bytes.length {
                if depth > 0 {
                    report(.unterminatedString, at: TextSpan { start: modes[depth].start, length: 2 },
                        label: "this string never ends", help: "close the `{` and the string")
                }
                add(.endOfFile, at: TextSpan { start: pos, length: 0 })
                return
            }
            lexToken(keywords)
        }
    }

    // ── Plumbing ──────────────────────────────────────────────────────────────────

    u8 peek(i64 offset = 0) => pos + offset < source.bytes.length ? source.bytes[pos + offset] : 0

    void add(ref this, TokenKind kind, at TextSpan span) {
        let docLength = docStart >= 0 ? docEnd - docStart : 0
        tokens.append(Token {
            kind: kind,
            tokenFlags: tokenFlags,
            start: span.start,
            length: span.length,
            docStart: docStart >= 0 ? docStart : 0,
            docLength: docLength,
        })
        tokenFlags = 0
        docStart = -1
    }

    void report(ref this, DiagnosticCode code, at TextSpan span, string arg0 = "", string arg1 = "", string label = "", string help = "") {
        diagnostics.append(Diagnostic {
            code: codeText(code),
            span: span,
            message: format(messageFormat(code), by: (arg0: arg0, arg1: arg1)),
            label: label,
            help: help,
            hasFix: false,
            fixSpan: span,
            fixReplacement: "",
        })
    }

    void reportFix(ref this, DiagnosticCode code, at TextSpan span, by string replacement, string arg0 = "", string label = "", string help = "") {
        diagnostics.append(Diagnostic {
            code: codeText(code),
            span: span,
            message: format(messageFormat(code), by: (arg0: arg0, arg1: "")),
            label: label,
            help: help,
            hasFix: true,
            fixSpan: span,
            fixReplacement: replacement,
        })
    }

    bool isIdentifierStartAt(i64 at) {
        if at >= source.bytes.length { return false }
        let b = source.bytes[at]
        if b < 0x80 { return isAsciiIdentStart(b) }
        let d = decodeAt(source.bytes.span, at: at)
        return d.valid && isIdentifierStart(d.value)
    }

    /// Advances over one code point, reporting bidi controls and invalid UTF-8 unless allowed.
    void advanceCodePoint(ref this, bool allowBidi) {
        let b = source.bytes[pos]
        if b < 0x80 {
            pos += 1
            return
        }
        let bidi = bidiControlAt(source.bytes.span, at: pos)
        if bidi.length > 0 {
            unless allowBidi { reportBidi(bidi.codePoint, at: pos) }
            pos += bidi.length
            return
        }
        let d = decodeAt(source.bytes.span, at: pos)
        unless d.valid {
            report(.invalidUtf8, at: TextSpan { start: pos, length: 1 }, arg0: hex(b, to: 2))
            pos += 1
            return
        }
        pos += d.length
    }

    void reportBidi(ref this, u32 codePoint, at i64 start) {
        reportFix(.bidiControl, at: TextSpan { start: start, length: 3 }, by: "", arg0: hex(codePoint, to: 4),
            label: "invisible character that reorders how the text displays",
            help: "remove it; bidi controls may only appear inside string literals (Trojan Source, CVE-2021-42574)")
    }

    // ── Trivia ────────────────────────────────────────────────────────────────────

    void skipTrivia(ref this) {
        while pos < source.bytes.length {
            let b = source.bytes[pos]
            if b == ' ' || b == '\t' || b == '\r' {
                pos += 1
                tokenFlags |= triviaBefore
            } else if b == '\n' {
                pos += 1
                tokenFlags |= triviaBefore | newlineBefore
            } else if b == '/' && peek(1) == '/' {
                let start = pos
                let isDoc = peek(2) == '/' && peek(3) != '/'
                while pos < source.bytes.length && source.bytes[pos] != '\n' { advanceCodePoint(allowBidi: false) }
                if isDoc {
                    if docStart < 0 { docStart = start }
                    docEnd = pos
                }
                tokenFlags |= triviaBefore
            } else if b == '/' && peek(1) == '*' {
                let start = pos
                pos += 2
                while pos < source.bytes.length && !(source.bytes[pos] == '*' && peek(1) == '/') {
                    if source.bytes[pos] == '\n' { tokenFlags |= newlineBefore }
                    advanceCodePoint(allowBidi: false)
                }
                if pos >= source.bytes.length {
                    report(.unterminatedComment, at: TextSpan { start: start, length: 2 }, label: "comment starts here",
                        help: "close it with `*/`")
                } else {
                    pos += 2
                    reportFix(.blockComment, at: TextSpan.fromBounds(start, until: pos), by: lineComments(start, until: pos),
                        label: "block comment", help: "write each line with `//`")
                }
                tokenFlags |= triviaBefore
            } else if b == '#' && tokens.length == 0 && (peek(1) == '!' || peek(1) == ':') && isAtLineStart() {
                // Script shebang and `#:` directives at the top of a file.
                while pos < source.bytes.length && source.bytes[pos] != '\n' { advanceCodePoint(allowBidi: false) }
                tokenFlags |= triviaBefore
            } else {
                return
            }
        }
    }

    /// BYN1047's fix for the comment `[start, end)`: one `//` line per trimmed content line, the outer
    /// blank lines dropped, at the indent of the `/*` line; code after `*/` moves to its own line.
    string lineComments(ref this, i64 start, until i64 end) {
        let text = source.bytes.span
        var lineStart = start
        while lineStart > 0 && text[lineStart - 1] != '\n' { lineStart -= 1 }
        var indentEnd = lineStart
        while indentEnd < start && (text[indentEnd] == ' ' || text[indentEnd] == '\t') { indentEnd += 1 }
        var starts = List<i64>()
        var ends = List<i64>()
        var at = start + 2
        while true {
            var lineEnd = at
            while lineEnd < end - 2 && text[lineEnd] != '\n' { lineEnd += 1 }
            var a = at
            var b = lineEnd
            while a < b && (text[a] == ' ' || text[a] == '\t' || text[a] == '\r') { a += 1 }
            while b > a && (text[b - 1] == ' ' || text[b - 1] == '\t' || text[b - 1] == '\r') { b -= 1 }
            starts.append(a)
            ends.append(b)
            if lineEnd >= end - 2 { break }
            at = lineEnd + 1
        }
        var first: i64 = 0
        var last = starts.length - 1
        if last > first && starts[last] == ends[last] { last -= 1 }
        if last > first && starts[first] == ends[first] { first += 1 }
        var sb = StrBuf()
        for i in first..last + 1 {
            if i > first {
                sb.append("\n")
                appendUtf8(text[lineStart..indentEnd], to: ref sb)
            }
            sb.append(starts[i] == ends[i] ? "//" : "// ")
            appendUtf8(text[starts[i]..ends[i]], to: ref sb)
        }
        var after = end
        while after < text.length && (text[after] == ' ' || text[after] == '\t' || text[after] == '\r') { after += 1 }
        if after < text.length && text[after] != '\n' {
            sb.append("\n")
            appendUtf8(text[lineStart..indentEnd], to: ref sb)
        }
        return $"{sb.finish()}"
    }

    bool isAtLineStart() => pos == 0 || source.bytes[pos - 1] == '\n'

    // ── Tokens ────────────────────────────────────────────────────────────────────

    void lexToken(ref this, Keywords keywords) {
        let start = pos
        let c = source.bytes[pos]

        if isAsciiIdentStart(c) {
            lexIdentifier(keywords)
            return
        }
        if isDigit(c) {
            lexNumber()
            return
        }
        if c >= 0x80 {
            let bidi = bidiControlAt(source.bytes.span, at: pos)
            if bidi.length > 0 {
                reportBidi(bidi.codePoint, at: pos)
                pos += bidi.length
                tokenFlags |= triviaBefore
                return
            }
            let d = decodeAt(source.bytes.span, at: pos)
            unless d.valid {
                report(.invalidUtf8, at: TextSpan { start: pos, length: 1 }, arg0: hex(c, to: 2))
                pos += 1
                return
            }
            if isIdentifierStart(d.value) {
                lexIdentifier(keywords)
                return
            }
            reportUnexpected(d.value, by: d.length)
            return
        }

        switch c {
            case '"':
                lexString(.stringLiteral, from: start, at: start)
            case '\'':
                lexChar()
            case '$':
                if peek(1) != '"' {
                    reportUnexpected(c, by: 1)
                    return
                }
                if depth + 1 >= modes.length {
                    unless reportedTooDeep { report(.interpolationTooDeep, at: TextSpan { start: start, length: 2 }) }
                    reportedTooDeep = true
                    pos += 1
                    lexString(.stringLiteral, from: start, at: pos)
                    return
                }
                add(.interpolatedStringStart, at: TextSpan { start: start, length: 2 })
                pos += 2
                depth += 1
                modes[depth] = ModeEntry { inText: true, braceDepth: 0, start: start }
            case '{':
                if depth > 0 { modes[depth].braceDepth += 1 }
                single(.openBrace)
            case '}':
                if depth > 0 && modes[depth].braceDepth == 0 {
                    add(.interpolationEnd, at: TextSpan { start: start, length: 1 })
                    pos += 1
                    depth -= 1
                    return
                }
                if depth > 0 { modes[depth].braceDepth -= 1 }
                single(.closeBrace)
            case '(': single(.openParen)
            case ')': single(.closeParen)
            case '[': single(.openBracket)
            case ']': single(.closeBracket)
            case ';': single(.semicolon)
            case ',': single(.comma)
            case '@': single(.at)
            case '#': single(.hash)
            case '~': single(.tilde)
            case ':': single(.colon)
            case '.':
                if peek(1) == '.' {
                    addFixed(peek(2) == '=' ? TokenKind.dotDotEquals : TokenKind.dotDot, peek(2) == '=' ? 3 : 2)
                } else {
                    single(.dot)
                }
            case '?':
                if peek(1) == '?' {
                    addFixed(peek(2) == '=' ? TokenKind.questionQuestionEquals : TokenKind.questionQuestion, peek(2) == '=' ? 3 : 2)
                } else if peek(1) == '.' && !isDigit(peek(2)) {
                    addFixed(.questionDot, 2)
                } else {
                    single(.question)
                }
            case '+':
                addFixed(peek(1) switch {
                    '+' => TokenKind.plusPlus,
                    '=' => TokenKind.plusEquals,
                    '%' => TokenKind.plusPercent,
                    '|' => TokenKind.plusBar,
                    _ => TokenKind.plus,
                })
            case '-':
                addFixed(peek(1) switch {
                    '-' => TokenKind.minusMinus,
                    '>' => TokenKind.arrow,
                    '=' => TokenKind.minusEquals,
                    '%' => TokenKind.minusPercent,
                    '|' => TokenKind.minusBar,
                    _ => TokenKind.minus,
                })
            case '*':
                addFixed(peek(1) switch {
                    '=' => TokenKind.starEquals,
                    '%' => TokenKind.starPercent,
                    '|' => TokenKind.starBar,
                    _ => TokenKind.star,
                })
            case '/': addFixed(peek(1) == '=' ? TokenKind.slashEquals : TokenKind.slash)
            case '%': addFixed(peek(1) == '=' ? TokenKind.percentEquals : TokenKind.percent)
            case '^': addFixed(peek(1) == '=' ? TokenKind.caretEquals : TokenKind.caret)
            case '!': addFixed(peek(1) == '=' ? TokenKind.bangEquals : TokenKind.bang)
            case '&':
                addFixed(peek(1) switch { '&' => TokenKind.ampAmp, '=' => TokenKind.ampEquals, _ => TokenKind.amp })
            case '|':
                addFixed(peek(1) switch { '|' => TokenKind.barBar, '=' => TokenKind.barEquals, _ => TokenKind.bar })
            case '=':
                addFixed(peek(1) switch { '=' => TokenKind.equalsEquals, '>' => TokenKind.fatArrow, _ => TokenKind.equals })
            case '<':
                if peek(1) == '<' {
                    addFixed(peek(2) == '=' ? TokenKind.lessLessEquals : TokenKind.lessLess, peek(2) == '=' ? 3 : 2)
                } else {
                    addFixed(peek(1) == '=' ? TokenKind.lessEquals : TokenKind.less)
                }
            case '>':
                addFixed(peek(1) == '=' ? TokenKind.greaterEquals : TokenKind.greater)
            default:
                reportUnexpected(c, by: 1)
        }
    }

    void reportUnexpected(ref this, u32 cp, by i64 length) {
        let shown = cp < 0x20 || cp == 0x7F ? $"\\u{{{hex(cp, to: 1)}}}" : $"{rune(cp)}"
        report(.unexpectedCharacter, at: TextSpan { start: pos, length: length }, arg0: shown)
        pos += length
        tokenFlags |= triviaBefore
    }

    void single(ref this, TokenKind kind) => addFixed(kind, 1)

    /// Adds a fixed-length token; with no explicit length, two-character kinds are inferred.
    void addFixed(ref this, TokenKind kind, i64 length = 0) {
        let n = length == 0 ? kindText(kind).length : length
        add(kind, at: TextSpan { start: pos, length: n })
        pos += n
    }

    void lexIdentifier(ref this, Keywords keywords) {
        let start = pos
        var ascii = true
        while pos < source.bytes.length {
            let b = source.bytes[pos]
            if b < 0x80 {
                unless isAsciiIdentContinue(b) { break }
                pos += 1
                continue
            }
            if bidiControlAt(source.bytes.span, at: pos).length > 0 { break }
            let d = decodeAt(source.bytes.span, at: pos)
            if !d.valid || !isIdentifierContinue(d.value) { break }
            ascii = false
            pos += d.length
        }

        let span = source.bytes.span[start..pos]
        unless ascii {
            checkNfc(span, at: start)
            add(.identifier, at: TextSpan { start: start, length: pos - start })
            return
        }

        var kind = keywords.lookup(span)
        if kind == .identifier && peek() == '"' {
            if span.length == 1 && span[0] == 'c' {
                lexString(.cStringLiteral, from: start, at: pos)
                return
            }
            if sameBytes(span, as: "u16".bytes) {
                lexString(.u16StringLiteral, from: start, at: pos)
                return
            }
        }
        if isReservedKeyword(kind) {
            report(.reservedKeyword, at: TextSpan.fromBounds(start, until: pos), arg0: utf8(span),
                label: "reserved for a future version of Bayan", help: "choose another name")
            kind = .identifier
        }
        add(kind, at: TextSpan { start: start, length: pos - start })
    }

    /// Reports BYN0005 when the identifier `span` (valid UTF-8) is not in NFC.
    void checkNfc(ref this, ReadOnlySpan<u8> span, at i64 start) {
        var input = List<u32>()
        var at: i64 = 0
        while at < span.length {
            let d = decodeAt(span, at: at)
            input.append(d.value)
            at += d.length
        }
        let normalized = normalize(input.span)
        var same = normalized.length == input.length
        if same {
            for i in 0..input.length {
                if normalized[i] != input[i] { same = false }
            }
        }
        if same { return }
        var fix = StrBuf()
        for cp in normalized { fix.append($"{rune(cp)}") }
        reportFix(.identifierNotNfc, at: TextSpan.fromBounds(start, until: pos), by: fix.finish(), arg0: utf8(span),
            label: "same letters, different encoding",
            help: "use the composed (NFC) form; identifiers that look the same must be byte-identical")
    }

    void lexNumber(ref this) {
        let start = pos
        var radix = ""
        var isFloat = false

        if source.bytes[pos] == '0' && (peek(1) | 0x20) == 'x' {
            radix = "hexadecimal"
            pos += 2
            scanDigits(.hex, from: start)
        } else if source.bytes[pos] == '0' && (peek(1) | 0x20) == 'b' && (peek(2) == '0' || peek(2) == '1' || peek(2) == '_') {
            radix = "binary"
            pos += 2
            scanDigits(.binary, from: start)
            if isDigit(peek()) {
                let bad = pos
                while isDigit(peek()) { pos += 1 }
                report(.invalidNumber, at: TextSpan.fromBounds(bad, until: pos), arg0: "binary literals use only `0` and `1`")
            }
        } else {
            scanDigits(.decimal, from: start)
            if peek() == '.' && isDigit(peek(1)) {
                isFloat = true
                pos += 1
                scanDigits(.decimal, from: start)
            }
            if (peek() | 0x20) == 'e' && (isDigit(peek(1)) || ((peek(1) == '+' || peek(1) == '-') && isDigit(peek(2)))) {
                isFloat = true
                pos += peek(1) == '+' || peek(1) == '-' ? 2 : 1
                scanDigits(.decimal, from: start)
            }
        }

        add(isFloat ? TokenKind.floatLiteral : TokenKind.integerLiteral, at: TextSpan { start: start, length: pos - start })

        if isIdentifierStartAt(pos) {
            let suffixStart = pos
            while pos < source.bytes.length {
                let b = source.bytes[pos]
                if b < 0x80 {
                    unless isAsciiIdentContinue(b) { break }
                    pos += 1
                    continue
                }
                let d = decodeAt(source.bytes.span, at: pos)
                if !d.valid || !isIdentifierContinue(d.value) { break }
                pos += d.length
            }
            add(.numericSuffix, at: TextSpan { start: suffixStart, length: pos - suffixStart })
            let suffix = source.bytes.span[suffixStart..pos]
            let builtIn = sameBytes(suffix, as: "u".bytes) || sameBytes(suffix, as: "l".bytes) || sameBytes(suffix, as: "ul".bytes)
            if !radix.isEmpty && !builtIn {
                report(.suffixOnHexOrBinary, at: TextSpan.fromBounds(suffixStart, until: pos), arg0: utf8(suffix), arg1: radix,
                    help: "write the value in decimal, or convert it with T(x), where T is the unit type")
            }
        }
    }

    void scanDigits(ref this, DigitKind digits, from i64 literalStart) {
        let first = pos
        var digitsEnd = first
        while pos < source.bytes.length && (isDigitOf(digits, for: source.bytes[pos]) || source.bytes[pos] == '_') {
            if source.bytes[pos] != '_' { digitsEnd = pos + 1 }
            pos += 1
        }
        // Only underscores after a prefix is still no digits; deleting them would not help. Trailing underscores are
        // reported and deleted as one run, so the fix leaves a valid literal.
        if digitsEnd == first && digits != .decimal {
            let prefix = digits == .hex ? "0x" : "0b"
            report(.invalidNumber, at: TextSpan.fromBounds(literalStart, until: pos), arg0: $"expected digits after `{prefix}`")
        } else if digitsEnd < pos {
            reportFix(.invalidNumber, at: TextSpan.fromBounds(digitsEnd, until: pos), by: "", arg0: "`_` must sit between digits")
        }
    }

    /// Lexes a string whose opening quote is at `quote`.
    void lexString(ref this, TokenKind kind, from i64 start, at i64 quote) {
        pos = quote
        if kind == .stringLiteral && peek(1) == '"' && peek(2) == '"' {
            pos += 3
            while pos < source.bytes.length && !(source.bytes[pos] == '"' && peek(1) == '"' && peek(2) == '"') { advanceCodePoint(allowBidi: true) }
            if pos >= source.bytes.length {
                report(.unterminatedString, at: TextSpan { start: start, length: 3 }, label: "raw string starts here",
                    help: "close it with `\"\"\"`")
            } else {
                pos += 3
            }
            add(.rawStringLiteral, at: TextSpan { start: start, length: pos - start })
            return
        }

        pos += 1
        while true {
            if pos >= source.bytes.length || source.bytes[pos] == '\n' {
                let end = pos > start && pos <= source.bytes.length && pos > 0 && source.bytes[pos - 1] == '\r' ? pos - 1 : pos
                report(.unterminatedString, at: TextSpan.fromBounds(start, until: end),
                    label: "string ends at the end of the line",
                    help: "close it with `\"`; for text spanning lines use a raw `\"\"\"` string")
                add(kind, at: TextSpan { start: start, length: end - start })
                return
            }
            let b = source.bytes[pos]
            if b == '"' {
                pos += 1
                add(kind, at: TextSpan { start: start, length: pos - start })
                return
            }
            if b == '\\' {
                scanEscape()
            } else {
                advanceCodePoint(allowBidi: true)
            }
        }
    }

    void lexInterpolatedText(ref this) {
        let modeStart = modes[depth].start
        let start = pos
        while true {
            if pos >= source.bytes.length || source.bytes[pos] == '\n' {
                addText(start)
                report(.unterminatedString, at: TextSpan { start: modeStart, length: 2 }, label: "this string never ends",
                    help: "close it with `\"`")
                add(.interpolatedStringEnd, at: TextSpan { start: pos, length: 0 })
                depth -= 1
                return
            }
            let b = source.bytes[pos]
            if b == '"' {
                addText(start)
                add(.interpolatedStringEnd, at: TextSpan { start: pos, length: 1 })
                pos += 1
                depth -= 1
                return
            } else if b == '\\' {
                scanEscape()
            } else if (b == '{' && peek(1) == '{') || (b == '}' && peek(1) == '}') {
                pos += 2
            } else if b == '{' {
                if depth + 1 >= modes.length {
                    unless reportedTooDeep { report(.interpolationTooDeep, at: TextSpan { start: pos, length: 1 }) }
                    reportedTooDeep = true
                    pos += 1
                    continue
                }
                addText(start)
                add(.interpolationStart, at: TextSpan { start: pos, length: 1 })
                pos += 1
                depth += 1
                modes[depth] = ModeEntry { inText: false, braceDepth: 0, start: modeStart }
                return
            } else if b == '}' {
                reportFix(.unescapedCloseBrace, at: TextSpan { start: pos, length: 1 }, by: "}}")
                pos += 1
            } else {
                advanceCodePoint(allowBidi: true)
            }
        }
    }

    void addText(ref this, i64 start) {
        if pos > start { add(.interpolatedStringText, at: TextSpan { start: start, length: pos - start }) }
    }

    void lexChar(ref this) {
        let start = pos
        pos += 1
        if peek() == '\'' {
            pos += 1
            report(.emptyCharLiteral, at: TextSpan { start: start, length: 2 }, help: "write the character between the quotes, e.g. `' '`")
            add(.charLiteral, at: TextSpan { start: start, length: 2 })
            return
        }
        var scalars = 0
        while pos < source.bytes.length && source.bytes[pos] != '\'' && source.bytes[pos] != '\n' {
            if source.bytes[pos] == '\\' {
                scanEscape()
            } else {
                advanceCodePoint(allowBidi: false)
            }
            scalars += 1
        }
        if pos >= source.bytes.length || source.bytes[pos] != '\'' {
            report(.unterminatedCharLiteral, at: TextSpan.fromBounds(start, until: pos), help: "close it with `'`")
            add(.charLiteral, at: TextSpan { start: start, length: pos - start })
            return
        }
        pos += 1
        if scalars > 1 {
            report(.charLiteralTooLong, at: TextSpan.fromBounds(start, until: pos), help: "use a string literal (\"…\") for text")
        }
        add(.charLiteral, at: TextSpan { start: start, length: pos - start })
    }

    void scanEscape(ref this) {
        let start = pos
        pos += 1
        if pos >= source.bytes.length || source.bytes[pos] == '\n' {
            report(.invalidEscape, at: TextSpan { start: start, length: 1 }, arg0: "\\")
            return
        }
        let e = source.bytes[pos]
        switch e {
            case 'n' or 'r' or 't' or '0' or '\\' or '"' or '\'':
                pos += 1
            case 'u':
                if peek(1) != '{' {
                    invalidEscape(start)
                    return
                }
                pos += 2
                let digitsStart = pos
                var value: i64 = 0
                while pos < source.bytes.length && hexValue(source.bytes[pos]) >= 0 && pos - digitsStart < 8 {
                    value = value * 16 + hexValue(source.bytes[pos])
                    pos += 1
                }
                let digits = pos - digitsStart
                if digits == 0 || peek() != '}' {
                    report(.invalidEscape, at: TextSpan.fromBounds(start, until: pos), arg0: utf8(source.bytes.span[start..pos]),
                        help: "write `\\u{` followed by 1–6 hex digits and `}`")
                    return
                }
                pos += 1
                if digits > 6 || value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF) {
                    report(.invalidUnicodeEscape, at: TextSpan.fromBounds(start, until: pos), arg0: utf8(source.bytes.span[start..pos]),
                        help: "use a scalar value in U+0000–U+D7FF or U+E000–U+10FFFF")
                }
            default:
                invalidEscape(start)
        }
    }

    /// The `default` arm of `scanEscape`.
    void invalidEscape(ref this, i64 start) {
        advanceCodePoint(allowBidi: true)
        report(.invalidEscape, at: TextSpan.fromBounds(start, until: pos), arg0: utf8(source.bytes.span[start..pos]),
            help: "use a valid escape: \\n \\r \\t \\0 \\\\ \\\" \\' and \\u{…}")
    }
}

enum DigitKind {
    decimal
    hex
    binary
}

bool isDigitOf(DigitKind kind, for u8 b) => kind switch {
    .decimal => isDigit(b),
    .hex => isDigit(b) || (b >= 'a' && b <= 'f') || (b >= 'A' && b <= 'F'),
    .binary => b == '0' || b == '1',
}

bool isDigit(u8 b) => b >= '0' && b <= '9'

bool isAsciiIdentStart(u8 b) => (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'

bool isAsciiIdentContinue(u8 b) => isAsciiIdentStart(b) || isDigit(b)

i64 hexValue(u8 b) {
    if b >= '0' && b <= '9' { return b - 0x30 }
    if b >= 'a' && b <= 'f' { return b - 0x61 + 10 }
    if b >= 'A' && b <= 'F' { return b - 0x41 + 10 }
    return -1
}
