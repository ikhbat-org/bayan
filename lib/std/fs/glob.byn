// std.fs glob (spec 015 S5, T13): the files under the working directory a pattern names.

import std.path

type Glob = path.Glob

/// The depth below the base directory a walk stops at when the pattern has `**` or `{}` (its length is unknown).
const maxDepth: i64 = 64

/// The files whose path matches `pattern` (`**`, `*`, `?`, `[…]`, `{a,b}` as `Glob.matches` reads them), sorted by byte
/// order, written with `/` separators and starting as `pattern` does. Directories are walked but not listed; a base
/// directory that is missing or unreadable gives an empty list, and a directory below it that cannot be read is
/// skipped. Directory links are followed, except one back to a directory being walked (an ancestor). Names starting with `.` are listed and dot-directories
/// are entered, as any other name (the Go and Rust rule); a caller that wants them hidden filters the result. A
/// pattern with `**` or `{` is walked 64 directory levels below its base directory; matches deeper than that are not
/// returned.
public List<string> glob(string pattern) uses fs, alloc {
    var found = List<string>()
    collect(pattern, to: ref found)
    var j = 0
    while j < found.length {
        var k = j
        while k > 0 && found[k] < found[k - 1] {
            let t = found[k]
            found[k] = found[k - 1]
            found[k - 1] = t
            k -= 1
        }
        j += 1
    }
    var kept = List<string>()
    for f in found {
        if kept.length == 0 || kept[kept.length - 1] != f {
            kept.append(f)
        }
    }
    return kept
}

/// Adds the files `pattern` names to `found`, sorted or not, a file more than once when two alternatives name it. A `{a,b}`
/// group before the first `*`, `?` or `[` is replaced by each option in turn and each result collected on its own, so
/// every alternative is walked from its own base directory (`{/x/a,b}/*.byn` lists `/x/a` and `b`).
void collect(string pattern, to ref List<string> found) uses fs, alloc {
    var open: i64 = -1
    var i = 0
    while i < pattern.length && open < 0 {
        let b = pattern.bytes[i]
        if b == '*' || b == '?' || b == '[' {
            break
        }
        if b == '{' {
            open = i
        }
        i += 1
    }
    var close: i64 = -1
    var starts = List<i64>()
    if open >= 0 {
        var depth = 0
        var k = open
        starts.append(open)
        while k < pattern.length && close < 0 {
            let b = pattern.bytes[k]
            if b == '{' {
                depth += 1
            } else if b == '}' {
                depth -= 1
                if depth == 0 {
                    close = k
                }
            } else if b == ',' && depth == 1 {
                starts.append(k)
            }
            k += 1
        }
    }
    if close >= 0 {
        starts.append(close)
        let head = pattern[0..open]
        let tail = pattern[close + 1..pattern.length]
        for k in 0..(starts.length - 1) {
            collect($"{head}{pattern[starts[k] + 1..starts[k + 1]]}{tail}", to: ref found)
        }
        return
    }
    let depth = depthOf(pattern)
    var seen: Map<string, bool> = []
    walk(pattern, from: baseOf(pattern), until: depth, through: ref seen, to: ref found)
}

/// The directory levels a walk for `pattern` descends below its base: `maxDepth` with `**` or `{`, else one more than the
/// `/` after the base.
i64 depthOf(string pattern) {
    if pattern.contains("**") || pattern.contains("{") { return maxDepth }
    return count(pattern[baseOf(pattern).length..], for: "/") + 1
}

/// The directory a walk for `pattern` starts in: its leading segments with no `*`, `?`, `[` or `{`, through the `/` that
/// ends them (`a/`, `a//`, `/`, `C:/`), so an entry under it is the base and a name and starts as `pattern` does.
string baseOf(string pattern) {
    var i = 0
    var slash = -1
    while i < pattern.length {
        let b = pattern.bytes[i]
        if b == '*' || b == '?' || b == '[' || b == '{' {
            break
        }
        if b == '/' {
            slash = i
        }
        i += 1
    }
    if slash < 0 {
        return ""
    }
    return pattern[0..slash + 1]
}

/// The number of times `part` occurs in `text`.
i64 count(string text, for string part) {
    var n = 0
    for _ in text.parts(by: part) {
        n += 1
    }
    return n - 1
}

/// Adds every file under `dir` (to `depth` levels) whose path matches `pattern`. Directory links are followed; a directory whose
/// real path is in `seen` (the directories being walked, from the base down to `dir`) is an ancestor and is not entered, so a
/// link back up the tree (`a/loop -> ..`) ends the walk. A directory reached through two different links is walked under each.
void walk(
    string pattern,
    from string dir,
    until i64 depth,
    through ref Map<string,
    bool> seen,
    to ref List<string> found
) uses fs, alloc {
    let real = Fs.realPath(dir.isEmpty ? "." : dir) catch { return }
    return if seen.contains(real)
    seen[real] = true
    let names = Io.listDir(dir.isEmpty ? "." : dir) catch { return }
    for name in names {
        let entry = dir.isEmpty ? $"{name}" : (dir.endsWith("/") ? $"{dir}{name}" : $"{dir}/{name}")
        if Fs.fileExists(entry) {
            if Glob.matches(pattern, for: entry) {
                found.append(entry)
            }
        } else if depth > 1 {
            walk(pattern, from: entry, until: depth - 1, through: ref seen, to: ref found)
        }
    }
    let _ = seen.remove(real)
}
