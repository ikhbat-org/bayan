// Tests of Fs.copy, Fs.modified, Fs.fileSize, Fs.setModified and Fs.realPath, over files the tests build in tmp/ below the working
// directory. Ported from StdFsTests; the expected values are the literals of that class.

/// Makes `dir` an empty directory: removes what an earlier run left (with `rm`; none on Windows, where the leftovers stay).
void fresh(string dir) uses fs, alloc, process {
    let args: string[2] = ["-rf", dir]
    let _ = Io.run("rm", args.span) catch {
        Io.createDirectory(dir) catch {}
        return
    }
    Io.createDirectory(dir) catch {}
}

/// What `Fs.copy(path, to: dest)` did, as the name of its failure, `ok` when it succeeded.
string copied(string path, to string dest) uses fs {
    Fs.copy(path, to: dest) catch switch {
        .notFound => return "notFound",
        .invalidInput => return "invalidInput",
        .isDirectory => return "isDirectory",
        _ => return "fail",
    }
    return "ok"
}

/// What `Fs.setModified(path, to: nanos)` did, as the name of its failure, `ok` when it succeeded.
string stamped(string path, to i64 nanos) uses fs {
    Fs.setModified(path, to: Time.fromNanos(nanos)) catch switch {
        .notFound => return "notFound",
        .invalidInput => return "invalidInput",
        _ => return "fail",
    }
    return "ok"
}

/// The write time of `path` in nanoseconds, -1 when it cannot be read.
i64 modifiedNanos(string path) uses fs {
    let t = Fs.modified(path) catch { return -1 }
    return t.nanos
}

/// What `Fs.realPath(path)` gave: the path, or the name of its failure.
string resolved(string path) uses fs, alloc {
    let r = Fs.realPath(path) catch switch {
        .notFound => return "notFound",
        .invalidInput => return "invalidInput",
        _ => return "fail",
    }
    return r
}

/// Makes `link` a symbolic link to `target` with `ln`; false where there is none (Windows, whose Git Bash `ln -s` copies the file).
bool link(string link, to string target) uses fs, alloc, process {
    return false if Target.os == "windows"
    let args: string[3] = ["-s", target, link]
    let _ = Io.run("ln", args.span) catch { return false }
    return true
}

test "copy-onto-itself-fails-invalid-input" {
    let work = "tmp/fs-copy-self"
    fresh(work)
    Io.createDirectory("tmp/fs-copy-self/dir") catch { assert false }
    let file = "tmp/fs-copy-self/dir/f.txt"
    Io.writeFile(file, "kept".bytes) catch { assert false }
    // The same file by another spelling is found by file identity.
    assert copied(file, to: "tmp/fs-copy-self/dir/../dir/f.txt") == "invalidInput"
    // No `ln` (Windows): the symlink rows have nothing to test.
    if link("tmp/fs-copy-self/link.txt", to: "dir/f.txt") {
        assert copied("tmp/fs-copy-self/link.txt", to: file) == "invalidInput"
        assert copied(file, to: "tmp/fs-copy-self/link.txt") == "invalidInput"
    }
    let text = Io.readText(file) catch { return }
    assert text == "kept"
}

test "copy-has-a-new-write-time" {
    let work = "tmp/fs-copy-time"
    fresh(work)
    let file = "tmp/fs-copy-time/old.txt"
    Io.writeFile(file, "old".bytes) catch { assert false }
    // 2001-01-01T00:00:00Z
    let old: i64 = 978307200000000000
    assert stamped(file, to: old) == "ok"
    assert copied(file, to: "tmp/fs-copy-time/copy.txt") == "ok"
    let source = Fs.modified(file) catch { return }
    assert source.nanos == old
    let copy = Fs.modified("tmp/fs-copy-time/copy.txt") catch { return }
    let age = Time.now().nanos - copy.nanos
    // Written within a minute of now.
    assert age > -60000000000
    assert age < 60000000000
}

test "write-times-match-dotnet" {
    let work = "tmp/fs-times"
    fresh(work)
    let file = "tmp/fs-times/file.txt"
    Io.writeFile(file, "x".bytes) catch { assert false }
    // 2001-01-01T00:00:00.1234567Z
    let nanos: i64 = 978307200123456700
    assert stamped(file, to: nanos) == "ok"
    // To the second at least.
    assert modifiedNanos(file) / 1000000000 == 978307200
    // A missing path fails both, as File.SetLastWriteTimeUtc does.
    assert stamped("tmp/fs-times/missing", to: nanos) == "notFound"
    assert modifiedNanos("tmp/fs-times/missing") == -1
}

test "file-size-is-the-byte-count" {
    let work = "tmp/fs-size"
    fresh(work)
    let file = "tmp/fs-size/file.txt"
    Io.writeFile(file, "seven b".bytes) catch { assert false }
    let size = Fs.fileSize(file) catch switch {
        _ => -1,
    }
    assert size == 7
    // A missing path is notFound.
    let missing = Fs.fileSize("tmp/fs-size/missing") catch switch {
        .notFound => -2,
        _ => -1,
    }
    assert missing == -2
}

test "real-path-matches-dotnet" {
    let work = "tmp/fs-real"
    fresh(work)
    Io.writeFile("tmp/fs-real/real.txt", "x".bytes) catch { assert false }
    // No `ln` (Windows): nothing to resolve.
    if !link("tmp/fs-real/l2", to: "real.txt") { return }
    assert link("tmp/fs-real/l1", to: "l2")
    assert link("tmp/fs-real/loop", to: "loop")
    // A chain of links resolves to the file it ends at.
    assert resolved("tmp/fs-real/l1") == Path.fullPath("tmp/fs-real/real.txt")
    // A missing path is notFound; a link cycle fails.
    assert resolved("tmp/fs-real/missing") == "notFound"
    assert resolved("tmp/fs-real/loop") == "fail"
}
