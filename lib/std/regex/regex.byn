// std.regex (spec 015 S3, T14): RE2-style patterns run by a Pike VM over the runes of UTF-8 text, so matching takes
// time linear in the text times the program, never backtracking; no backreferences, no lookaround.

/// A `{m,n}` count above this is refused, as in RE2.
const maxRepeat: i64 = 1000

/// A compiled program longer than this many instructions is refused (`tooLarge`).
const maxProgram: i64 = 100000

/// Groups nest at most this deep, so parsing never recurses past it (docs/memory-leaks.md rule 5).
const maxDepth: i64 = 1000

/// Why `Regex.parse` refused a pattern, at a byte offset of the pattern.
public union error RegexError {
    /// The pattern breaks the syntax at `offset`.
    syntax(string message, i64 offset)
    /// A backreference or lookaround (or another construct linear-time matching leaves frag) starts at `offset`.
    unsupported(string message, i64 offset)
    /// The compiled program would exceed `maxProgram` instructions; `offset` is where the pattern grew past it.
    tooLarge(i64 offset)
}

/// What one instruction does.
enum Op {
    rune
    set
    any
    split
    jump
    save
    lineStart
    lineEnd
    wordBoundary
    notWordBoundary
    done
}

/// One instruction. `rune`: `x` is the code point. `set`: the range pairs `ranges[x..y]` and `flags` (1 negated, 2 any
/// non-digit, 4 any non-space, 8 any non-word). `split`: try `pc + x` first, then `pc + y`. `jump`: go to `pc + x`.
/// `save`: slot `x` takes the position. Targets are relative, so a fragment can be copied anywhere.
struct Inst {
    Op  op
    i64 x     = 0
    i64 y     = 0
    i64 flags = 0
}

/// A compiled RE2-style pattern: literals, `.`, classes `[...]` and `[^...]`, `\d \s \w` and `\D \S \W` (ASCII, as in
/// RE2), anchors `^ $ \b \B`, groups `(...)` and `(?:...)`, `? * + {m} {m,} {m,n}` with lazy forms (`??`, `*?`, ...),
/// and alternation `|`. `^` and `$` match at the start and end of the whole text; `.` matches any rune but `\n`. A
/// match is leftmost-first (Perl order); matching is linear in the length of the text.
public struct Regex {
    List<Inst> program
    List<u32>  ranges
    i64        groups

    /// The pattern compiled, failing `unsupported` for a backreference (`\1`, `\k<…>`), lookaround (`(?=`, `(?!`,
    /// `(?<=`, `(?<!`), flags or named groups, `syntax` at the first byte that breaks the syntax, and `tooLarge` when
    /// the program would exceed `maxProgram` instructions.
    public static Regex parse(string pattern) uses alloc fails RegexError {
        var p = Parser { pattern: pattern, ranges: List<u32>() }
        let body = try p.parseBranches()
        fail .syntax(message: "unmatched `)`", offset: p.pos) if p.pos < pattern.length
        var program = List<Inst>()
        program.append(Inst { op: .save, x: 0 })
        for inst in body {
            program.append(inst)
        }
        program.append(Inst { op: .save, x: 1 })
        program.append(Inst { op: .done })
        return Regex { program: move program, ranges: p.ranges.copy(), groups: p.groups }
    }

    /// Whether the pattern matches the whole of `text`, as Python's `re.fullmatch` (not only a part; `find` is that).
    public bool matches(string text) uses alloc {
        return search(text, from: 0, whole: true) is not null
    }

    /// The leftmost-first match in `text`, or `null` when there is none.
    public Match? find(string text) uses alloc {
        let slots = search(text, from: 0, whole: false) ?? return null
        return Match { text: text, slots: move slots }
    }

    /// Every match in `text`, left to right and not overlapping. As in RE2 and Go, an empty match right where the
    /// previous match ended is skipped, and the search steps one rune past an empty match.
    public List<Match> findAll(string text) uses alloc {
        var all = List<Match>()
        var pos = 0
        var previousEnd = -1
        while pos <= text.length {
            let slots = search(text, from: pos, whole: false) ?? break
            let start = slots[0]
            let end = slots[1]
            var accept = true
            if end == pos {
                accept = start != previousEnd
                pos += pos < text.length ? runeAt(text, at: pos).width : 1
            } else {
                pos = end
            }
            previousEnd = end
            if accept {
                all.append(Match { text: text, slots: move slots })
            }
        }
        return all
    }

    /// `text` with every match `findAll` gives replaced by `replacement`, taken literally (no `$1` or `\1`).
    public string replaced(string text, by string replacement) uses alloc {
        let all = findAll(text)
        var sb = StrBuf()
        var last = 0
        for m in all {
            let span = m.span
            sb.append(text[last..span.start])
            sb.append(replacement)
            last = span.end
        }
        sb.append(text[last..])
        return $"{sb.finish()}"
    }

    /// `text` with `\` before each of `\ . + * ? ( ) | [ ] { } ^ $` (Go's `QuoteMeta` set), so `Regex.parse` of the
    /// result matches `text` literally; the pattern for outside text (spec §15.1).
    public static string escaped(string text) uses alloc {
        var sb = StrBuf()
        var run = 0
        for i in 0..text.length {
            let b = text.bytes[i]
            if isMeta(b) {
                sb.append(text[run..i])
                sb.append("\\")
                run = i
            }
        }
        sb.append(text[run..])
        return $"{sb.finish()}"
    }

    /// The slots of the first match at or after `from` (start and end of the match, then of each group, -1 when a
    /// group took no part), or `null`. `whole` anchors the match at `from` and accepts it only when it ends at the
    /// text's end.
    List<i64>? search(string text, from i64 from, bool whole) uses alloc {
        let slotCount = 2 * (groups + 1)
        var vm = Vm { marks: List<i64>(), stack: List<Frame>(), current: List<i64>(), slotCount: slotCount }
        for _ in 0..program.length {
            vm.marks.append(0)
        }
        for _ in 0..slotCount {
            vm.current.append(-1)
        }
        var now = Threads { pcs: List<i64>(), slots: List<i64>() }
        var next = Threads { pcs: List<i64>(), slots: List<i64>() }
        var best = List<i64>()
        var matched = false
        var generation = 1
        var nowGeneration = 1
        var pos = from
        while true {
            if !matched && (!whole || pos == from) {
                for k in 0..slotCount {
                    vm.current[k] = -1
                }
                vm.pos = pos
                vm.generation = nowGeneration
                vm.add(text, at: 0, to: ref now, from: program.span)
            }
            break if now.pcs.length == 0 && (matched || whole)
            var value: u32 = 0
            var width = 0
            if pos < text.length {
                let r = runeAt(text, at: pos)
                value = r.value
                width = r.width
            }
            generation += 1
            for i in 0..now.pcs.length {
                let pc = now.pcs[i]
                let inst = program[pc]
                if inst.op == .done {
                    continue if whole && pos != text.length
                    best.clear()
                    for k in 0..slotCount {
                        best.append(now.slots[i * slotCount + k])
                    }
                    matched = true
                    break
                }
                continue if pos >= text.length
                var hit = false
                if inst.op == .rune {
                    hit = i64(value) == inst.x
                } else if inst.op == .any {
                    hit = value != 0x0A
                } else if inst.op == .set {
                    hit = isInClass(value, by: inst)
                }
                continue if !hit
                for k in 0..slotCount {
                    vm.current[k] = now.slots[i * slotCount + k]
                }
                vm.pos = pos + width
                vm.generation = generation
                vm.add(text, at: pc + 1, to: ref next, from: program.span)
            }
            let swap = move now
            now = move next
            next = move swap
            next.pcs.clear()
            next.slots.clear()
            nowGeneration = generation
            break if pos >= text.length
            pos += width
        }
        return null if !matched
        return best
    }

    /// Whether rune `value` is in the class of `inst`.
    bool isInClass(u32 value, by Inst inst) {
        var hit = false
        var i = inst.x
        while i < inst.y {
            if value >= ranges[i] && value <= ranges[i + 1] {
                hit = true
            }
            i += 2
        }
        hit = hit || ((inst.flags & 2) != 0 && !isDigit(value))
        hit = hit || ((inst.flags & 4) != 0 && !isSpace(value))
        hit = hit || ((inst.flags & 8) != 0 && !isWord(value))
        return hit != ((inst.flags & 1) != 0)
    }
}

/// One match: its span and the text of each group.
public struct Match {
    string    text
    List<i64> slots

    /// The byte offsets of the whole match in the text searched, `start` inclusive and `end` exclusive.
    public (i64 start, i64 end) span => (start: slots[0], end: slots[1])

    /// The text group `index` matched (0 is the whole match, then each `(...)` by its opening parenthesis), or `null`
    /// when the group took no part in the match or there is no group `index`.
    public string? group(i64 index) {
        return null if index < 0 || 2 * index + 1 >= slots.length
        let start = slots[2 * index]
        return null if start < 0
        return text[start..slots[2 * index + 1]]
    }
}

/// A recursive-descent parser that emits program fragments.
struct Parser {
    string    pattern
    i64       pos    = 0
    i64       groups = 0
    i64       depth  = 0
    List<u32> ranges

    /// `concat ('|' concat)*`.
    List<Inst> parseBranches(ref this) uses alloc fails RegexError {
        fail .syntax(message: "groups nest too deep", offset: pos) if depth >= maxDepth
        depth += 1
        var branches = List<List<Inst>>()
        branches.append(try parseConcat())
        while pos < pattern.length && pattern.bytes[pos] == '|' {
            pos += 1
            branches.append(try parseConcat())
        }
        depth -= 1
        if branches.length == 1 {
            return branches.removeLast()
        }
        var total = 2 * (branches.length - 1)
        for b in branches {
            total += b.length
        }
        fail .tooLarge(offset: pos) if total > maxProgram
        var frag = List<Inst>()
        for i in 0..branches.length {
            let last = i == branches.length - 1
            if !last {
                frag.append(Inst { op: .split, x: 1, y: branches[i].length + 2 })
            }
            for inst in branches[i] {
                frag.append(inst)
            }
            if !last {
                frag.append(Inst { op: .jump, x: total - frag.length })
            }
        }
        return frag
    }

    /// A run of repeated atoms, up to `|`, `)` or the end.
    List<Inst> parseConcat(ref this) uses alloc fails RegexError {
        var frag = List<Inst>()
        while pos < pattern.length && pattern.bytes[pos] != '|' && pattern.bytes[pos] != ')' {
            let piece = try parseRepeat()
            fail .tooLarge(offset: pos) if frag.length + piece.length > maxProgram
            for inst in piece {
                frag.append(inst)
            }
        }
        return frag
    }

    /// An atom and at most one quantifier, with its lazy `?`.
    List<Inst> parseRepeat(ref this) uses alloc fails RegexError {
        let atom = try parseItem()
        let at = pos
        var min = 0
        var max = -1
        let b = peek()
        if b == '*' {
            pos += 1
        } else if b == '+' {
            min = 1
            pos += 1
        } else if b == '?' {
            max = 1
            pos += 1
        } else if b == '{' && hasCountNext() {
            pos += 1
            min = number()
            max = min
            if peek() == ',' {
                pos += 1
                max = peek() == '}' ? -1 : number()
            }
            pos += 1
            fail .syntax(message: "repetition count above 1000", offset: at) if min > maxRepeat || max > maxRepeat
            fail .syntax(message: "repetition maximum below its minimum", offset: at) if max >= 0 && max < min
        } else {
            return atom
        }
        var greedy = true
        if peek() == '?' {
            greedy = false
            pos += 1
        }
        fail .syntax(message: "repetition of a repetition", offset: pos) if hasRepeatNext()
        return try repeated(atom.span, from: min, through: max, greedy: greedy, at: at)
    }

    /// `e` repeated `min` to `max` times (`max` -1: no bound), each optional copy nested in the one before it. `e*` is
    /// `(e+)?`, as in RE2, so an `e` that matches empty still sets its groups (`(a*)*` on `b`).
    List<Inst> repeated(ReadOnlySpan<Inst> e, from i64 min, through i64 max, bool greedy, at i64 at)
            uses alloc fails RegexError {
        let n = e.length
        var size = min * n
        if max < 0 {
            size += min == 0 ? n + 2 : 1
        } else {
            size += (max - min) * (n + 1)
        }
        fail .tooLarge(offset: at) if size > maxProgram
        var frag = List<Inst>()
        let copies = max < 0 && min > 0 ? min - 1 : min
        for _ in 0..copies {
            for inst in e {
                frag.append(inst)
            }
        }
        if max < 0 && min == 0 {
            frag.append(greedy ? Inst { op: .split, x: 1, y: n + 2 } : Inst { op: .split, x: n + 2, y: 1 })
            for inst in e {
                frag.append(inst)
            }
            frag.append(greedy ? Inst { op: .split, x: -n, y: 1 } : Inst { op: .split, x: 1, y: -n })
        } else if max < 0 {
            for inst in e {
                frag.append(inst)
            }
            frag.append(greedy ? Inst { op: .split, x: -n, y: 1 } : Inst { op: .split, x: 1, y: -n })
        } else {
            for k in 0..max - min {
                let skip = (max - min - k) * (n + 1)
                frag.append(greedy ? Inst { op: .split, x: 1, y: skip } : Inst { op: .split, x: skip, y: 1 })
                for inst in e {
                    frag.append(inst)
                }
            }
        }
        return frag
    }

    /// One atom: a group, a class, `.`, an anchor, an escape or a literal rune.
    List<Inst> parseItem(ref this) uses alloc fails RegexError {
        let start = pos
        var frag = List<Inst>()
        let b = pattern.bytes[pos]
        if b == '(' {
            pos += 1
            var index = -1
            if peek() == '?' {
                let rest = pattern[pos..]
                let lookaround = rest.startsWith("?=") || rest.startsWith("?!") || rest.startsWith("?<=")
                    || rest.startsWith("?<!")
                fail .unsupported(message: "lookaround", offset: start) if lookaround
                fail .unsupported(message: "group flags and named groups", offset: start) if !rest.startsWith("?:")
                pos += 2
            } else {
                groups += 1
                index = groups
                frag.append(Inst { op: .save, x: 2 * index })
            }
            let body = try parseBranches()
            fail .syntax(message: "missing `)`", offset: start) if peek() != ')'
            pos += 1
            for inst in body {
                frag.append(inst)
            }
            if index >= 0 {
                frag.append(Inst { op: .save, x: 2 * index + 1 })
            }
            return frag
        }
        fail .syntax(message: "missing argument to repetition operator", offset: start) if hasRepeatNext()
        pos += 1
        if b == '[' {
            frag.append(try classSet(start))
        } else if b == '.' {
            frag.append(Inst { op: .any })
        } else if b == '^' {
            frag.append(Inst { op: .lineStart })
        } else if b == '$' {
            frag.append(Inst { op: .lineEnd })
        } else if b == '\\' {
            let code = try escape(start)
            if code >= 0 {
                frag.append(Inst { op: .rune, x: code })
            } else if code == -7 {
                frag.append(Inst { op: .wordBoundary })
            } else if code == -8 {
                frag.append(Inst { op: .notWordBoundary })
            } else {
                let from = ranges.length
                let flags = addClass(code)
                frag.append(Inst { op: .set, x: from, y: ranges.length, flags: flags })
            }
        } else {
            pos = start
            let r = runeAt(pattern, at: pos)
            pos += r.width
            frag.append(Inst { op: .rune, x: i64(r.value) })
        }
        return frag
    }

    /// The class whose `[` is at `start` (`pos` is past it), as a `set` instruction.
    Inst classSet(ref this, i64 start) uses alloc fails RegexError {
        var flags = 0
        if peek() == '^' {
            flags = 1
            pos += 1
        }
        let from = ranges.length
        var first = true
        while true {
            fail .syntax(message: "missing `]`", offset: start) if pos >= pattern.length
            let b = pattern.bytes[pos]
            if b == ']' && !first {
                pos += 1
                return Inst { op: .set, x: from, y: ranges.length, flags: flags }
            }
            first = false
            fail .unsupported(message: "POSIX class", offset: pos) if pattern[pos..].startsWith("[:")
            let at = pos
            let lo = try classRune()
            if lo < 0 {
                flags = flags | addClass(lo)
                continue
            }
            var hi = lo
            if hasRangeNext() {
                pos += 1
                let endAt = pos
                hi = try classRune()
                fail .syntax(message: "class escape as a range end", offset: endAt) if hi < 0
                fail .syntax(message: "range end before its start", offset: at) if hi < lo
            }
            ranges.append(u32(lo))
            ranges.append(u32(hi))
        }
    }

    /// A rune of a class, or a negative builtin code for `\d \D \s \S \w \W` (as `escape` gives them).
    i64 classRune(ref this) fails RegexError {
        let start = pos
        if pattern.bytes[pos] == '\\' {
            pos += 1
            let code = try escape(start)
            fail .syntax(message: "`\\b` or `\\B` in a class", offset: start) if code == -7 || code == -8
            return code
        }
        let r = runeAt(pattern, at: pos)
        pos += r.width
        return i64(r.value)
    }

    /// The escape whose `\` is at `start` (`pos` is past it): a rune, or -1..-6 for `\d \D \s \S \w \W`, -7 for `\b`,
    /// -8 for `\B`.
    i64 escape(ref this, i64 start) fails RegexError {
        fail .syntax(message: "trailing `\\`", offset: start) if pos >= pattern.length
        let e = pattern.bytes[pos]
        pos += 1
        fail .unsupported(message: "backreference", offset: start) if (e >= '1' && e <= '9') || e == 'k'
        return -1 if e == 'd'
        return -2 if e == 'D'
        return -3 if e == 's'
        return -4 if e == 'S'
        return -5 if e == 'w'
        return -6 if e == 'W'
        return -7 if e == 'b'
        return -8 if e == 'B'
        return 0x0A if e == 'n'
        return 0x09 if e == 't'
        return 0x0D if e == 'r'
        return 0x0C if e == 'f'
        return 0x0B if e == 'v'
        return i64(e) if e >= 0x21 && e <= 0x7E && !isWord(u32(e))
        fail .syntax(message: "unknown escape", offset: start)
    }

    /// Appends the ranges of builtin `code` (-1..-6) and gives the `set` flags it needs: a negated builtin adds no
    /// ranges and sets its flag.
    i64 addClass(ref this, i64 code) uses alloc {
        if code == -1 {
            addRange(0x30, through: 0x39)
        } else if code == -3 {
            addRange(0x09, through: 0x0A)
            addRange(0x0C, through: 0x0D)
            addRange(0x20, through: 0x20)
        } else if code == -5 {
            addRange(0x30, through: 0x39)
            addRange(0x41, through: 0x5A)
            addRange(0x5F, through: 0x5F)
            addRange(0x61, through: 0x7A)
        }
        return 2 if code == -2
        return 4 if code == -4
        return 8 if code == -6
        return 0
    }

    void addRange(ref this, u32 lo, through u32 hi) uses alloc {
        ranges.append(lo)
        ranges.append(hi)
    }

    /// The byte at `pos`, or 0 at the end.
    u8 peek() => pos < pattern.length ? pattern.bytes[pos] : 0

    /// Whether a `-` at `pos` makes a range (it is not the last byte before `]`).
    bool hasRangeNext() => peek() == '-' && pos + 1 < pattern.length && pattern.bytes[pos + 1] != ']'

    /// Whether a quantifier starts at `pos`.
    bool hasRepeatNext() {
        let b = peek()
        return b == '*' || b == '+' || b == '?' || (b == '{' && hasCountNext())
    }

    /// Whether `{m}`, `{m,}` or `{m,n}` starts at `pos`; any other `{` is a literal, as in RE2.
    bool hasCountNext() {
        var i = pos + 1
        let digitsStart = i
        while i < pattern.length && isDigit(u32(pattern.bytes[i])) {
            i += 1
        }
        return false if i == digitsStart || i >= pattern.length
        return true if pattern.bytes[i] == '}'
        return false if pattern.bytes[i] != ','
        i += 1
        while i < pattern.length && isDigit(u32(pattern.bytes[i])) {
            i += 1
        }
        return i < pattern.length && pattern.bytes[i] == '}'
    }

    /// The decimal number at `pos`, capped above `maxRepeat` so a long one cannot overflow.
    i64 number(ref this) {
        var value = 0
        while isDigit(u32(peek())) {
            value = value * 10 + i64(peek() - '0')
            if value > maxRepeat {
                value = maxRepeat + 1
            }
            pos += 1
        }
        return value
    }
}

/// The threads of one step: the pc of each, in priority order, and its `slotCount` slots.
struct Threads {
    List<i64> pcs
    List<i64> slots
}

/// A pending step of `Vm.add`: follow `pc`, or (`pc` -1) put `value` back into slot `slot`.
struct Frame {
    i64 pc
    i64 slot  = 0
    i64 value = 0
}

/// The work space of `Regex.search`.
struct Vm {
    /// The generation that last added each pc to a list, so a pc joins a list once.
    List<i64>   marks
    List<Frame> stack
    /// The slots of the thread being added.
    List<i64>   current
    i64         slotCount
    /// The text position and list generation of the threads being added.
    i64         pos        = 0
    i64         generation = 0

    /// Adds the thread at `pc` (with `current` slots) to `list` at text position `pos`, marking with `generation`,
    /// following jumps, splits, saves and assertions in priority order with an explicit stack.
    void add(ref this, string text, at i64 pc, to ref Threads list, from ReadOnlySpan<Inst> program) uses alloc {
        stack.append(Frame { pc: pc })
        while stack.length > 0 {
            let f = stack.removeLast()
            if f.pc < 0 {
                current[f.slot] = f.value
                continue
            }
            continue if marks[f.pc] == generation
            marks[f.pc] = generation
            let inst = program[f.pc]
            switch inst.op {
                case .jump:
                    stack.append(Frame { pc: f.pc + inst.x })
                case .split:
                    stack.append(Frame { pc: f.pc + inst.y })
                    stack.append(Frame { pc: f.pc + inst.x })
                case .save:
                    stack.append(Frame { pc: -1, slot: inst.x, value: current[inst.x] })
                    current[inst.x] = pos
                    stack.append(Frame { pc: f.pc + 1 })
                case .lineStart:
                    stack.append(Frame { pc: f.pc + 1 }) if pos == 0
                case .lineEnd:
                    stack.append(Frame { pc: f.pc + 1 }) if pos == text.length
                case .wordBoundary:
                    stack.append(Frame { pc: f.pc + 1 }) if isBoundary(text, at: pos)
                case .notWordBoundary:
                    stack.append(Frame { pc: f.pc + 1 }) if !isBoundary(text, at: pos)
                default:
                    list.pcs.append(f.pc)
                    for k in 0..slotCount {
                        list.slots.append(current[k])
                    }
            }
        }
    }
}

/// The rune at byte `at` of `text` and its width in bytes.
(u32 value, i64 width) runeAt(string text, at i64 at) {
    let b0 = u32(text.bytes[at])
    return (value: b0, width: 1) if b0 < 0x80
    let b1 = u32(text.bytes[at + 1]) & 0x3F
    return (value: ((b0 & 0x1F) << 6) | b1, width: 2) if b0 < 0xE0
    let b2 = u32(text.bytes[at + 2]) & 0x3F
    return (value: ((b0 & 0x0F) << 12) | (b1 << 6) | b2, width: 3) if b0 < 0xF0
    let b3 = u32(text.bytes[at + 3]) & 0x3F
    return (value: ((b0 & 0x07) << 18) | (b1 << 12) | (b2 << 6) | b3, width: 4)
}

/// Whether `\b` holds at byte `at`: a word byte on exactly one side.
bool isBoundary(string text, at i64 at) {
    let before = at > 0 && isWord(u32(text.bytes[at - 1]))
    let after = at < text.length && isWord(u32(text.bytes[at]))
    return before != after
}

bool isDigit(u32 r) => r >= 0x30 && r <= 0x39

/// `\s`: tab, newline, form feed, carriage return, space (RE2's set).
bool isSpace(u32 r) => r == 0x09 || r == 0x0A || r == 0x0C || r == 0x0D || r == 0x20

/// `\w`: ASCII letters, digits and `_`.
bool isWord(u32 r) => isDigit(r) || (r >= 0x41 && r <= 0x5A) || (r >= 0x61 && r <= 0x7A) || r == 0x5F

/// Whether `Regex.escaped` puts a `\` before byte `b`.
bool isMeta(u8 b) {
    return b == '\\' || b == '.' || b == '+' || b == '*' || b == '?' || b == '(' || b == ')' || b == '|' || b == '['
        || b == ']' || b == '{' || b == '}' || b == '^' || b == '$'
}
