// Tests of std.encoding. Expected encodings for non-RFC vectors are recorded from a run of
// `python3 -c 'import base64,sys; print(base64.b64encode(...).decode())'`, not written by hand.

/// `ok`, or the error `Base64.decode(text)` fails with.
string errorOf(string text) uses alloc {
    let _ = Base64.decode(text) catch switch {
        .badDigit(let at) => return $"badDigit @{at}",
        .overflow         => return "overflow",
    }
    return "ok"
}

@cases(
    ("", ""),
    ("f", "Zg=="),
    ("fo", "Zm8="),
    ("foo", "Zm9v"),
    ("foob", "Zm9vYg=="),
    ("fooba", "Zm9vYmE="),
    ("foobar", "Zm9vYmFy"),
)
test "RFC 4648 §10 vectors encode and decode" (string input, string expected) {
    assert Base64.encode(input.bytes) == expected
    let decoded = try Base64.decode(expected)
    assert (try Utf8.decode(decoded.span)) == input
}

test "all 256 byte values round-trip and match recorded b64encode output" {
    var all = List<u8>()
    for i in 0..256 {
        all.append(u8(i))
        var single = List<u8>()
        single.append(u8(i))
        let back = try Base64.decode(Base64.encode(single.span))
        assert back.length == 1 && back[0] == u8(i)
    }
    let expected = ""
    let encoded = Base64.encode(all.span)
    assert encoded == expected
    let decoded = try Base64.decode(encoded)
    assert Hex.encode(decoded.span) == Hex.encode(all.span)
}

@cases(
    ("00", "AA=="),
    ("0000", "AAA="),
    ("000000", "AAAA"),
    ("fbefbe", "++++"),
    ("ffffff", "////"),
    ("fbffbf", "+/+/"),
)
test "non-RFC byte vectors encode and decode" (string hex, string expected) {
    let raw = try Hex.decode(hex)
    assert Base64.encode(raw.span) == expected
    let decoded = try Base64.decode(expected)
    assert Hex.encode(decoded.span) == hex
}

@cases(
    ("Zg=", "badDigit @3"),
    ("Z", "badDigit @1"),
    ("Zg", "badDigit @2"),
    ("Zm8", "badDigit @3"),
    ("Zm9!", "badDigit @3"),
    ("!m9v", "badDigit @0"),
    ("Z!9v", "badDigit @1"),
    ("Zm!v", "badDigit @2"),
    ("Zg==Zg==", "badDigit @2"),
    ("Zm8=Zg==", "badDigit @3"),
    ("=g==", "badDigit @0"),
    ("Z===", "badDigit @1"),
    ("Zg=A", "badDigit @3"),
    ("Zh==", "badDigit @1"),
    ("Zm9=", "badDigit @2"),
    ("Zm9v\n", "badDigit @4"),
    (" Zm9v", "badDigit @0"),
    ("Zm 9v", "badDigit @2"),
)
test "decode refuses broken text with the bad byte offset" (string input, string expected) {
    assert errorOf(input) == expected
}
