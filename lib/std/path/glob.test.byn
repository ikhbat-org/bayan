// Tests of std.path Glob. The expected results are not recorded from another implementation: S5 settles the
// semantics (`*` and `?` stop at `/`, `**` crosses it), so the table is written from the rules in `Glob.matches`.

@cases(
    ("a.byn", "a.byn", true),
    ("a.byn", "b.byn", false),
    ("*.byn", "a.byn", true),
    ("*.byn", "a.cs", false),
    ("*.byn", ".byn", true),
    ("*.byn", "d/a.byn", false),
    ("src/*.byn", "src/a.byn", true),
    ("src/*.byn", "src/d/a.byn", false),
    ("a?c", "abc", true),
    ("a?c", "ac", false),
    ("a?c", "a/c", false),
    ("[ab]x", "ax", true),
    ("[ab]x", "cx", false),
    ("[a-c]x", "bx", true),
    ("[a-c]x", "dx", false),
    ("[!a-c]x", "dx", true),
    ("[!a-c]x", "bx", false),
    ("[^a]x", "bx", true),
    ("[]a]x", "]x", true),
    ("[a", "[a", true),
    ("[a", "a", false),
    ("[a-]x", "-x", true),
    ("{a,b}.cs", "a.cs", true),
    ("{a,b}.cs", "b.cs", true),
    ("{a,b}.cs", "c.cs", false),
    ("s/{a,b/c}/x", "s/a/x", true),
    ("s/{a,b/c}/x", "s/b/c/x", true),
    ("{a,{b,c}d}", "cd", true),
    ("{a,{b,c}d}", "bd", true),
    ("{a,{b,c}d}", "b", false),
    ("{a", "{a", true),
    ("{}", "", true),
    ("src/**/*.byn", "src/a.byn", true),
    ("src/**/*.byn", "src/x/y/a.byn", true),
    ("src/**/*.byn", "lib/a.byn", false),
    ("src/**/*.byn", "src/x/a.cs", false),
    ("**/a.byn", "a.byn", true),
    ("**/a.byn", "x/y/a.byn", true),
    ("**/a.byn", "x/ya.byn", false),
    ("src/**", "src/x/y", true),
    ("src/**", "lib/x", false),
    ("**", "a/b/c", true),
    ("a**b", "axb", true),
    ("a**b", "a/b", false),
    ("*", "", true),
    ("", "", true),
    ("", "a", false),
    ("?", "é", true),
    ("a?", "aé", true),
    ("a??", "aé", false),
    ("[é]", "é", true),
    ("[éa]x", "éx", true),
    ("[!é]", "é", false),
    ("[!é]", "è", true),
    ("*[!é]", "é", false),
    ("[à-ë]", "é", true),
    ("?", "€", true),
    ("?", "😀", true),
)
test "patterns against paths" (string pattern, string path, bool expected) {
    assert Glob.matches(pattern, for: path) == expected
}
