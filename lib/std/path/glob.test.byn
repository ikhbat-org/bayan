// Tests of std.path Glob. The expected results are not recorded from another implementation: S5 settles the
// semantics (`*` and `?` stop at `/`, `**` crosses it), so the table is written from the rules in `Glob.matches`.

@cases(
    ("a.byn", "a.byn", true),
    ("a.byn", "b.byn", false),
    ("*.byn", "a.byn", true),
    ("*.byn", "a.cs", false),
    ("*.byn", ".byn", true),
    ("*.byn", "d/a.byn", false),
    ("src/*.byn", "src/a.byn", true),
    ("src/*.byn", "src/d/a.byn", false),
    ("a?c", "abc", true),
    ("a?c", "ac", false),
    ("a?c", "a/c", false),
    ("[ab]x", "ax", true),
    ("[ab]x", "cx", false),
    ("[a-c]x", "bx", true),
    ("[a-c]x", "dx", false),
    ("[!a-c]x", "dx", true),
    ("[!a-c]x", "bx", false),
    ("[^a]x", "bx", true),
    ("[]a]x", "]x", true),
    ("[a", "[a", true),
    ("[a", "a", false),
    ("[a-]x", "-x", true),
    ("{a,b}.cs", "a.cs", true),
    ("{a,b}.cs", "b.cs", true),
    ("{a,b}.cs", "c.cs", false),
    ("s/{a,b/c}/x", "s/a/x", true),
    ("s/{a,b/c}/x", "s/b/c/x", true),
    ("{a,{b,c}d}", "cd", true),
    ("{a,{b,c}d}", "bd", true),
    ("{a,{b,c}d}", "b", false),
    ("{a", "{a", true),
    ("{}", "", true),
    ("src/**/*.byn", "src/a.byn", true),
    ("src/**/*.byn", "src/x/y/a.byn", true),
    ("src/**/*.byn", "lib/a.byn", false),
    ("src/**/*.byn", "src/x/a.cs", false),
    ("**/a.byn", "a.byn", true),
    ("**/a.byn", "x/y/a.byn", true),
    ("**/a.byn", "x/ya.byn", false),
    ("src/**", "src/x/y", true),
    ("src/**", "lib/x", false),
    ("**", "a/b/c", true),
    ("a**b", "axb", true),
    ("a**b", "a/b", false),
    ("*", "", true),
    ("", "", true),
    ("", "a", false),
    ("?", "é", true),
    ("a?", "aé", true),
    ("a??", "aé", false),
    ("[é]", "é", true),
    ("[éa]x", "éx", true),
    ("[!é]", "é", false),
    ("[!é]", "è", true),
    ("*[!é]", "é", false),
    ("[à-ë]", "é", true),
    ("?", "€", true),
    ("?", "😀", true),
)
test "patterns against paths" (string pattern, string path, bool expected) {
    assert Glob.matches(pattern, for: path) == expected
}

test "a run of `*` or `**/` that cannot match fails in polynomial time" {
    assert !Glob.matches($"{"*".repeated(20)}b", for: "a".repeated(28))
    assert !Glob.matches($"{"*a".repeated(14)}b", for: "a".repeated(28))
    assert !Glob.matches($"{"**/".repeated(20)}b", for: "a/".repeated(25))
    assert Glob.matches($"{"*".repeated(20)}b", for: $"{"a".repeated(28)}b")
    assert Glob.matches($"{"**/".repeated(20)}b", for: $"{"a/".repeated(25)}b")
}

test "{a,b} groups are tried one alternative at a time, not all built first" {
    assert !Glob.matches("{a,b}".repeated(40), for: "x")
    assert Glob.matches("{a,b}".repeated(40), for: "ab".repeated(20))
    assert !Glob.matches($"{"{a,b}".repeated(40)}x", for: "a".repeated(40))
    assert Glob.matches($"{"{a,b}".repeated(4)}*", for: "abababab")
}

/// The live memory of this process in KB (`ps -o rss`; on macOS `vmmap`'s physical footprint, as the LSP bounds test reads it).
i64 globResidentKb() uses alloc, process {
    var args = List<string>()
    args.append("-c")
    if Target.os == "macos" {
        args.append("vmmap --summary $PPID | awk '/^Physical footprint:/{s=$3;u=substr(s,length(s),1);v=substr(s,1,length(s)-1)+0;if(u==\"K\")v=v;else if(u==\"M\")v=v*1024;else if(u==\"G\")v=v*1048576;else v=v/1024;printf \"%d\\n\",v}'")
    } else {
        args.append("ps -o rss= -p $PPID")
    }
    let r = Io.run("sh", args.span) catch { panic("cannot run sh to read the resident set") }
    assert(r.exitCode == 0)
    var kb: i64 = 0
    for b in r.stdout.trimmed().bytes {
        assert(b >= '0' && b <= '9')
        kb = kb * 10 + i64(b - '0')
    }
    return kb
}

test "matching many paths keeps nothing per call (audit 0.4.0 mediums review: the `*` table built in the caller's allocator)" {
    return if Target.os == "windows"
    let pattern = $"*{"c".repeated(300)}"
    let path = "a".repeated(400)
    assert !Glob.matches(pattern, for: path)
    let before = globResidentKb()
    for _ in 0..2000 {
        assert !Glob.matches(pattern, for: path)
    }
    let grown = globResidentKb() - before
    print($"2000 matches of a 301-byte pattern over a 400-byte path grew the resident set by {grown} KB") if grown >= 40 * 1024
    assert grown < 40 * 1024
}
