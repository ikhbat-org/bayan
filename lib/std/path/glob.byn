// std.path glob matching (spec 015 S5, T13): shell-style patterns over `/`-separated paths, compared byte by byte.

/// Matching `/`-separated paths against shell-style glob patterns.
public struct Glob {
    /// Whether the whole of `path` matches `pattern`. `?` is one byte and `*` any bytes, neither crossing a `/`;
    /// a `**` segment (`a/**/b`, `**/b`, `a/**`) is any number of segments, `a/**/b` matching `a/b`; `[abc]`, `[a-z]`
    /// and `[!abc]` (or `[^abc]`) are one byte of a set, a `[` without a closing `]` is itself; `{a,b}` alternatives
    /// nest and may hold `/`; an unclosed `{` is itself.
    public static bool matches(string pattern, for string path) uses alloc {
        for alternative in expand(pattern) {
            if matchFrom(alternative, from: 0, for: path, at: 0) { return true }
        }
        return false
    }
}

/// `pattern` with its first `{a,b}` group replaced by each option in turn, expanded again until no group is left.
List<string> expand(string pattern) uses alloc {
    var result = List<string>()
    let open = pattern.position("{") ?? -1
    var close = -1
    var starts = List<i64>()
    if open >= 0 {
        var depth = 0
        var i = open
        starts.append(open)
        while i < pattern.length && close < 0 {
            let b = pattern.bytes[i]
            if b == '{' {
                depth += 1
            } else if b == '}' {
                depth -= 1
                if depth == 0 { close = i }
            } else if b == ',' && depth == 1 {
                starts.append(i)
            }
            i += 1
        }
    }
    if close < 0 {
        result.append($"{pattern}")
        return result
    }
    starts.append(close)
    let head = pattern[0..open]
    let tail = pattern[close + 1..pattern.length]
    for k in 0..(starts.length - 1) {
        let option = pattern[starts[k] + 1..starts[k + 1]]
        for e in expand($"{head}{option}{tail}") { result.append(e) }
    }
    return result
}

/// Whether `pattern` from `pi` matches `path` from `si` to its end.
bool matchFrom(string pattern, from i64 pi, for string path, at i64 si) {
    var i = pi
    var j = si
    while i < pattern.length {
        let c = pattern.bytes[i]
        if c == '*' {
            if i + 1 < pattern.length && pattern.bytes[i + 1] == '*' && (i == 0 || pattern.bytes[i - 1] == '/') {
                let k = i + 2
                if k == pattern.length { return true }
                if pattern.bytes[k] == '/' {
                    if matchFrom(pattern, from: k + 1, for: path, at: j) { return true }
                    var m = j
                    while m < path.length {
                        if path.bytes[m] == '/' && matchFrom(pattern, from: k + 1, for: path, at: m + 1) { return true }
                        m += 1
                    }
                    return false
                }
            }
            var m = j
            while m <= path.length {
                if matchFrom(pattern, from: i + 1, for: path, at: m) { return true }
                if m == path.length || path.bytes[m] == '/' { return false }
                m += 1
            }
            return false
        }
        if c == '?' {
            if j >= path.length || path.bytes[j] == '/' { return false }
            i += 1
            j += 1
        } else if c == '[' && classEnd(pattern, at: i) > 0 {
            let end = classEnd(pattern, at: i)
            if j >= path.length || path.bytes[j] == '/' || !inClass(pattern, from: i, to: end, for: path.bytes[j]) { return false }
            i = end
            j += 1
        } else {
            if j >= path.length || path.bytes[j] != c { return false }
            i += 1
            j += 1
        }
    }
    return j == path.length
}

/// The index just past the `]` closing the class that opens at `open`, or -1.
i64 classEnd(string pattern, at i64 open) {
    var i = open + 1
    if i < pattern.length && (pattern.bytes[i] == '!' || pattern.bytes[i] == '^') { i += 1 }
    if i < pattern.length && pattern.bytes[i] == ']' { i += 1 }
    while i < pattern.length {
        if pattern.bytes[i] == ']' { return i + 1 }
        i += 1
    }
    return -1
}

/// Whether `b` is in the class `pattern[open..end]`.
bool inClass(string pattern, from i64 open, to i64 end, for u8 b) {
    var i = open + 1
    var negated = false
    if pattern.bytes[i] == '!' || pattern.bytes[i] == '^' {
        negated = true
        i += 1
    }
    let close = end - 1
    var hit = false
    while i < close {
        let low = pattern.bytes[i]
        if i + 2 < close && pattern.bytes[i + 1] == '-' {
            if b >= low && b <= pattern.bytes[i + 2] { hit = true }
            i += 3
        } else {
            if b == low { hit = true }
            i += 1
        }
    }
    return hit != negated
}
