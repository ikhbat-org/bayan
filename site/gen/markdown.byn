// Markdown for the published release docs (FORMAT.md §Release docs). `renderMarkdown` takes the source
// and returns HTML: ATX headings with slug ids, paragraphs, emphasis, code spans, links, fenced code,
// lists, pipe tables, blockquotes and rules. Anything else is escaped text. Lists and blockquotes nest
// at most `maxNesting` deep and inline emphasis and links as deep, so recursion is bounded.

const maxNesting: i64 = 16

/// Where the relative links of one doc point (FORMAT.md §Release docs).
public struct DocLinks {
    /// The doc's repo path, e.g. `docs/bayan-style.md`; relative links resolve against its directory.
    string       source
    /// The repo paths of the published docs, and their page names in the same order.
    List<string> paths
    List<string> names
    /// Put before `<name>.html`: "" beside the docs, `docs/<version>/` from the roadmap page.
    string       prefix
    /// The GitHub ref for links to any other repo file: `v<version>` or `dev`.
    string       gitRef
}

/// A rendered doc: the HTML without its title heading, the text of the first `# ` heading, and the h2/h3 headings.
public struct Rendered {
    string        html
    string        title
    List<Heading> toc
}

struct MdState {
    DocLinks      links
    List<string>  slugs
    List<string>  bases
    List<i64>     counts
    List<Heading> toc
    string        title
    bool          titleTaken
}

/// A list item marker; `content` is the column the item's text starts at, 0 when there is no marker.
struct ListMarker {
    bool ordered
    i64  start
    u8   bullet
    i64  content
}

bool isAlnum(u8 c) => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || isDigit(c)

bool isPunctuation(u8 c) =>
    (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')

bool has(string s, for string part) => (s.position(part) ?? -1) >= 0

/// The number of leading spaces of `line`.
i64 indentOf(string line) {
    var i: i64 = 0
    while i < line.length && line.bytes[i] == ' ' {
        i += 1
    }
    return i
}

bool isBlank(string line) => line.trimmed().isEmpty

/// `line` without up to `count` leading spaces.
string dedented(string line, by i64 count) => line[(indentOf(line) < count ? indentOf(line) : count)..line.length]

/// The lines of `source`, without `\r` and with leading tabs as four spaces.
List<string> sourceLines(string source) {
    var lines = List<string>()
    var start: i64 = 0
    while start < source.length {
        let end = source.position("\n", from: start) ?? source.length
        var line = source[start..end]
        if line.endsWith("\r") {
            line = line[0..(line.length - 1)]
        }
        var lead: i64 = 0
        while lead < line.length && (line.bytes[lead] == ' ' || line.bytes[lead] == '\t') {
            lead += 1
        }
        if has(line[0..lead], for: "\t") {
            line = $"{line[0..lead].replaced("\t", by: "    ")}{line[lead..line.length]}"
        }
        lines.append(line)
        start = end + 1
    }
    return lines
}

/// The run of 3 or more backticks or tildes that opens a fenced code block on `line`, or "".
string fenceOf(string line) {
    let start = indentOf(line)
    return "" if start > 3 || start >= line.length
    let c = line.bytes[start]
    return "" if c != '`' && c != '~'
    var end = start
    while end < line.length && line.bytes[end] == c {
        end += 1
    }
    return "" if end - start < 3
    return "" if c == '`' && has(line[end..line.length], for: "`")
    return line[start..end]
}

/// Whether `line` closes a block opened by `fence`: the same character, at least as many, nothing after.
bool closesFence(string line, by string fence) {
    return false if indentOf(line) > 3
    let t = line.trimmed()
    return false unless t.startsWith(fence)
    for c in t.bytes {
        return false if c != fence.bytes[0]
    }
    return true
}

/// The level (1 to 6) of the ATX heading on `line`, or 0.
i64 headingLevel(string line) {
    let start = indentOf(line)
    return 0 if start > 3
    var end = start
    while end < line.length && line.bytes[end] == '#' {
        end += 1
    }
    let level = end - start
    return 0 if level is < 1 or > 6
    return 0 if end < line.length && line.bytes[end] != ' '
    return level
}

/// The text of a heading of `level`, without the closing `#` run.
string headingText(string line, at i64 level) {
    let text = line[(indentOf(line) + level)..line.length].trimmed()
    var end = text.length
    while end > 0 && text.bytes[end - 1] == '#' {
        end -= 1
    }
    return "" if end == 0
    return text if end == text.length || text.bytes[end - 1] != ' '
    return text[0..end].trimmed()
}

/// Whether `line` is a thematic break: 3 or more `-`, spaces allowed.
bool isRule(string line) {
    return false if indentOf(line) > 3
    var count: i64 = 0
    for c in line.bytes {
        continue if c == ' '
        return false if c != '-'
        count += 1
    }
    return count >= 3
}

bool isQuote(string line) {
    let start = indentOf(line)
    return start <= 3 && start < line.length && line.bytes[start] == '>'
}

/// The text of a quoted line after `>` and one optional space.
string unquoted(string line) {
    var start = indentOf(line) + 1
    if start < line.length && line.bytes[start] == ' ' {
        start += 1
    }
    return line[start..line.length]
}

ListMarker markerOf(string line) {
    let none = ListMarker { ordered: false, start: 1, bullet: 0, content: 0 }
    let start = indentOf(line)
    return none if start > 3 || start >= line.length
    var marker = none
    var end = start
    let c = line.bytes[start]
    if c == '-' || c == '*' {
        marker.bullet = c
        end = start + 1
    } else {
        while end < line.length && end - start < 9 && isDigit(line.bytes[end]) {
            end += 1
        }
        return none if end == start || end >= line.length || line.bytes[end] != '.'
        marker.ordered = true
        marker.start = i64.parse(line[start..end]) catch 1
        end += 1
    }
    return none if end < line.length && line.bytes[end] != ' '
    let spaces = indentOf(line[end..line.length])
    marker.content = spaces == 0 || spaces > 4 || end + spaces == line.length ? end + 1 : end + spaces
    return marker
}

/// The cells of a table row: split at unescaped `|`, outer pipes dropped, each trimmed.
List<string> tableCells(string line) {
    var row = line.trimmed()
    if row.startsWith("|") {
        row = row[1..row.length]
    }
    if row.endsWith("|") && !row.endsWith("\\|") {
        row = row[0..(row.length - 1)]
    }
    var cells = List<string>()
    var start: i64 = 0
    var i: i64 = 0
    while i < row.length {
        let c = row.bytes[i]
        if c == '\\' {
            i += 2
            continue
        }
        if c == '|' {
            cells.append(row[start..i].trimmed())
            start = i + 1
        }
        i += 1
    }
    cells.append(row[start..row.length].trimmed())
    return cells
}

/// The alignment of a delimiter cell (`left`, `center`, `right` or ""), or "-" when it is not one.
string alignmentOf(string cell) {
    let left = cell.startsWith(":")
    let right = cell.endsWith(":") && cell.length > 1
    let dashes = cell[(left ? 1 : 0)..(cell.length - (right ? 1 : 0))]
    return "-" if dashes.isEmpty
    for c in dashes.bytes {
        return "-" if c != '-'
    }
    return left && right ? "center" : right ? "right" : left ? "left" : ""
}

/// Whether `lines[at]` and the line after it start a pipe table: a row and a delimiter row with as many cells.
bool isTableStart(ReadOnlySpan<string> lines, at i64 i) {
    return false if i + 1 >= lines.length || !has(lines[i], for: "|") || !has(lines[i + 1], for: "|")
    let delimiters = tableCells(lines[i + 1])
    for cell in delimiters {
        return false if alignmentOf(cell) == "-"
    }
    return tableCells(lines[i]).length == delimiters.length
}

/// Whether `lines[at]` ends a paragraph: a blank line or the start of another block.
bool startsBlock(ReadOnlySpan<string> lines, at i64 i, by i64 depth) {
    let line = lines[i]
    return true if isBlank(line) || !fenceOf(line).isEmpty || headingLevel(line) > 0 || isRule(line)
    return true if depth < maxNesting && (isQuote(line) || markerOf(line).content > 0)
    return isTableStart(lines, at: i)
}

/// `base`, or `base-2`, `base-3` … for its later uses; never an id already taken.
string uniqueSlug(string base, for ref MdState md) {
    var k: i64 = 0
    while k < md.bases.length && md.bases[k] != base {
        k += 1
    }
    if k == md.bases.length {
        md.bases.append(base)
        md.counts.append(0)
    }
    var id = base
    while true {
        md.counts[k] += 1
        id = md.counts[k] == 1 ? base : $"{base}-{md.counts[k]}"
        var taken = false
        for s in md.slugs {
            if s == id {
                taken = true
                break
            }
        }
        unless taken {
            break
        }
    }
    md.slugs.append(id)
    return id
}

/// The id of a heading: lowercase ASCII letters and digits, each run of anything else one `-`, none at either end.
string slug(string text) {
    let low = text.lowercased()
    var sb = StrBuf()
    var any = false
    var dash = false
    for i in 0..low.length {
        let c = low.bytes[i]
        if (c >= 'a' && c <= 'z') || isDigit(c) {
            if dash && any {
                sb.append("-")
            }
            sb.append(low[i..(i + 1)])
            any = true
            dash = false
        } else {
            dash = true
        }
    }
    return "section" unless any
    return $"{sb.finish()}"
}

/// Whether `url` has a scheme (`https:`, `mailto:`) or starts with `//`.
bool isAbsolute(string url) {
    return true if url.startsWith("//")
    for i in 0..url.length {
        let c = url.bytes[i]
        return i > 0 if c == ':'
        return false if !(isAlnum(c) || c == '+' || c == '-' || c == '.')
    }
    return false
}

/// `path` resolved against the directory of the repo path `source`, with `.` and `..` removed.
string resolved(string path, from string source) {
    let slash = source.lastPosition("/") ?? -1
    let joined = path.startsWith("/") ? path : $"{source[0..(slash + 1)]}{path}"
    var parts = List<string>()
    var start: i64 = 0
    while start <= joined.length {
        let end = joined.position("/", from: start) ?? joined.length
        let part = joined[start..end]
        if part == ".." {
            if parts.length > 0 {
                parts.remove(at: parts.length - 1)
            }
        } else if !part.isEmpty && part != "." {
            parts.append(part)
        }
        start = end + 1
    }
    var sb = StrBuf()
    for k in 0..parts.length {
        if k > 0 {
            sb.append("/")
        }
        sb.append(parts[k])
    }
    return $"{sb.finish()}"
}

/// Where a link to `url` goes (FORMAT.md §Release docs): a published doc's page, else the file on GitHub.
string linkTarget(string url, by ref DocLinks links) {
    return url if url.isEmpty || url.startsWith("#") || isAbsolute(url)
    let hash = url.position("#") ?? url.length
    let path = resolved(url[0..hash], from: links.source)
    let fragment = url[hash..url.length]
    for k in 0..links.paths.length {
        return $"{links.prefix}{links.names[k]}.html{fragment}" if links.paths[k] == path
    }
    return $"https://github.com/ikhbat-org/bayan/blob/{links.gitRef}/{path}{fragment}"
}

/// The end of the code span opened by the backtick run of `count` at `start`, or -1.
i64 codeSpanEnd(string text, from i64 start, by i64 count) {
    var j = start + count
    while j < text.length {
        let p = text.position("`", from: j) ?? return -1
        var end = p
        while end < text.length && text.bytes[end] == '`' {
            end += 1
        }
        return p if end - p == count
        j = end
    }
    return -1
}

/// The position of the `**` closing a strong span opened at `start`, or -1.
i64 strongEnd(string text, from i64 start) {
    var j = start + 3
    while j < text.length {
        let p = text.position("**", from: j) ?? return -1
        return p if text.bytes[p - 1] != ' '
        j = p + 1
    }
    return -1
}

/// The position of the `c` (`*` or `_`) closing an emphasis opened at `start`, or -1.
i64 emphasisEnd(string text, from i64 start, by u8 c) {
    var j = start + 2
    while j < text.length {
        let b = text.bytes[j]
        if b == c && c == '*' && j + 1 < text.length && text.bytes[j + 1] == '*' {
            j += 2
            continue
        }
        let after: u8 = j + 1 < text.length ? text.bytes[j + 1] : ' '
        return j if b == c && text.bytes[j - 1] != ' ' && !(c == '_' && isAlnum(after))
        j += 1
    }
    return -1
}

void wrapInto(string tag, from string inner, by i64 depth, to ref StrBuf html, for ref MdState md) {
    html.append($"<{tag}>")
    inlineInto(inner, by: depth + 1, to: ref html, for: ref md)
    html.append($"</{tag}>")
}

/// Appends the inline HTML of `text`: code spans, `**strong**`, `*em*`/`_em_`, links and autolinks, the rest escaped.
/// A delimiter with no closer is text; once a search finds none, later ones of the same kind are skipped.
void inlineInto(string text, by i64 depth, to ref StrBuf html, for ref MdState md) {
    let n = text.length
    var i: i64 = 0
    var plain: i64 = 0
    var noStrong = depth >= maxNesting
    var noStar = noStrong
    var noUnderscore = noStrong
    var noLink = noStrong
    var failedTicks = List<i64>()
    while i < n {
        let c = text.bytes[i]
        let next: u8 = i + 1 < n ? text.bytes[i + 1] : 0
        let prev: u8 = i > 0 ? text.bytes[i - 1] : ' '
        if c == '\\' && isPunctuation(next) {
            escapeInto(text[plain..i], to: ref html)
            escapeInto(text[(i + 1)..(i + 2)], to: ref html)
            i += 2
            plain = i
            continue
        }
        if c == '`' {
            var count: i64 = 1
            while i + count < n && text.bytes[i + count] == '`' {
                count += 1
            }
            var failed = false
            for k in failedTicks {
                if k == count {
                    failed = true
                }
            }
            let end = failed ? -1 : codeSpanEnd(text, from: i, by: count)
            if end < 0 {
                unless failed {
                    failedTicks.append(count)
                }
                i += count
                continue
            }
            var code = text[(i + count)..end].replaced("\n", by: " ")
            if code.length > 1 && code.startsWith(" ") && code.endsWith(" ") && !code.trimmed().isEmpty {
                code = code[1..(code.length - 1)]
            }
            escapeInto(text[plain..i], to: ref html)
            html.append("<code>")
            escapeInto(code, to: ref html)
            html.append("</code>")
            i = end + count
            plain = i
            continue
        }
        if c == '*' && next == '*' && !noStrong && i + 2 < n && text.bytes[i + 2] != ' ' {
            let end = strongEnd(text, from: i)
            if end < 0 {
                noStrong = true
                i += 2
                continue
            }
            escapeInto(text[plain..i], to: ref html)
            wrapInto("strong", from: text[(i + 2)..end], by: depth, to: ref html, for: ref md)
            i = end + 2
            plain = i
            continue
        }
        let emphasisOpen = (c == '*' && !noStar) || (c == '_' && !noUnderscore && !isAlnum(prev))
        if emphasisOpen && next != ' ' && next != c && next != 0 {
            let end = emphasisEnd(text, from: i, by: c)
            if end < 0 {
                if c == '*' {
                    noStar = true
                } else {
                    noUnderscore = true
                }
                i += 1
                continue
            }
            escapeInto(text[plain..i], to: ref html)
            wrapInto("em", from: text[(i + 1)..end], by: depth, to: ref html, for: ref md)
            i = end + 1
            plain = i
            continue
        }
        if c == '[' && !noLink {
            let middle = text.position("](", from: i + 1) ?? -1
            let close = middle < 0 ? -1 : text.position(")", from: middle + 2) ?? -1
            if close < 0 {
                noLink = true
                i += 1
                continue
            }
            if has(text[(i + 1)..middle], for: "[") {
                i += 1
                continue
            }
            var url = text[(middle + 2)..close].trimmed()
            url = url[0..(url.position(" ") ?? url.length)]
            escapeInto(text[plain..i], to: ref html)
            html.append("<a href=\"")
            escapeInto(linkTarget(url, by: ref md.links), to: ref html)
            html.append("\">")
            inlineInto(text[(i + 1)..middle], by: depth + 1, to: ref html, for: ref md)
            html.append("</a>")
            i = close + 1
            plain = i
            continue
        }
        if c == '<' && (text[i..n].startsWith("<https://") || text[i..n].startsWith("<http://")) {
            let close = text.position(">", from: i) ?? -1
            let url = close < 0 ? "" : text[(i + 1)..close]
            if !url.isEmpty && !has(url, for: " ") && !has(url, for: "<") {
                escapeInto(text[plain..i], to: ref html)
                html.append("<a href=\"")
                escapeInto(url, to: ref html)
                html.append("\">")
                escapeInto(url, to: ref html)
                html.append("</a>")
                i = close + 1
                plain = i
                continue
            }
        }
        i += 1
    }
    escapeInto(text[plain..n], to: ref html)
}

void headingInto(string line, by i64 depth, to ref StrBuf html, for ref MdState md) {
    let level = headingLevel(line)
    let text = headingText(line, at: level)
    if level == 1 && depth == 0 && !md.titleTaken {
        md.title = text.copy()
        md.titleTaken = true
        return
    }
    var inner = StrBuf()
    inlineInto(text, by: 0, to: ref inner, for: ref md)
    let content = $"{inner.finish()}"
    let id = uniqueSlug(slug(text), for: ref md)
    html.append($"<h{level} id=\"{id}\">{content}</h{level}>\n")
    if level is 2 or 3 {
        md.toc.append(Heading { id: id, html: content })
    }
}

/// Appends the fenced code block opening at `lines[at]` and returns the index after it; an unclosed one runs to the end.
i64 fencedInto(ReadOnlySpan<string> lines, at i64 start, to ref StrBuf html) {
    let open = lines[start]
    let fence = fenceOf(open)
    let indent = indentOf(open)
    let info = open[(indent + fence.length)..open.length].trimmed()
    let lang = info[0..(info.position(" ") ?? info.length)]
    var code = StrBuf()
    var j = start + 1
    while j < lines.length && !closesFence(lines[j], by: fence) {
        if j > start + 1 {
            code.append("\n")
        }
        code.append(dedented(lines[j], by: indent))
        j += 1
    }
    let text = $"{code.finish()}"
    if lang is "bayan" or "byn" {
        html.append("<pre class=\"byn\"><code>")
        html.append(highlight(text))
    } else {
        html.append("<pre><code>")
        escapeInto(text, to: ref html)
    }
    html.append("</code></pre>\n")
    return j < lines.length ? j + 1 : j
}

/// Appends the blockquote starting at `lines[at]` (with lazy continuation lines) and returns the index after it.
i64 quoteInto(ReadOnlySpan<string> lines, at i64 start, by i64 depth, to ref StrBuf html, for ref MdState md) {
    var inner = List<string>()
    var j = start
    while j < lines.length {
        let line = lines[j]
        if isQuote(line) {
            inner.append(unquoted(line))
        } else if isBlank(line) || isBlank(inner[inner.length - 1]) || startsBlock(lines, at: j, by: depth) {
            break
        } else {
            inner.append(line)
        }
        j += 1
    }
    html.append("<blockquote>\n")
    renderBlocks(inner.span, by: depth + 1, as: false, to: ref html, for: ref md)
    html.append("</blockquote>\n")
    return j
}

/// Appends the list starting at `lines[at]` and returns the index after it. Items continue on lines indented to their
/// content column and on lazy paragraph lines; a blank line between items or inside one makes the list loose.
i64 listInto(ReadOnlySpan<string> lines, at i64 start, by i64 depth, to ref StrBuf html, for ref MdState md) {
    let first = markerOf(lines[start])
    var marker = first
    var body = List<string>()
    var ends = List<i64>()
    var loose = false
    var j = start
    while true {
        let line = lines[j]
        body.append(marker.content >= line.length ? "" : line[marker.content..line.length])
        j += 1
        var blanks: i64 = 0
        while j < lines.length {
            let next = lines[j]
            if isBlank(next) {
                blanks += 1
            } else if indentOf(next) >= marker.content {
                if blanks > 0 {
                    loose = true
                }
                for _ in 0..blanks {
                    body.append("")
                }
                blanks = 0
                body.append(next[marker.content..next.length])
            } else if blanks == 0 && !startsBlock(lines, at: j, by: depth) {
                body.append(next)
            } else {
                break
            }
            j += 1
        }
        ends.append(body.length)
        break if j >= lines.length || isRule(lines[j])
        let next = markerOf(lines[j])
        break if next.content == 0 || next.ordered != first.ordered || next.bullet != first.bullet
        if blanks > 0 {
            loose = true
        }
        marker = next
    }
    let tag = first.ordered ? "ol" : "ul"
    html.append(first.ordered && first.start != 1 ? $"<ol start=\"{first.start}\">\n" : $"<{tag}>\n")
    var from: i64 = 0
    for end in ends {
        html.append("<li>")
        renderBlocks(body.span[from..end], by: depth + 1, as: !loose, to: ref html, for: ref md)
        html.append("</li>\n")
        from = end
    }
    html.append($"</{tag}>\n")
    return j
}

void cellInto(string tag, from string text, by string align, to ref StrBuf html, for ref MdState md) {
    html.append(align.isEmpty ? $"<{tag}>" : $"<{tag} style=\"text-align: {align}\">")
    inlineInto(text, by: 0, to: ref html, for: ref md)
    html.append($"</{tag}>")
}

/// Appends the pipe table starting at `lines[at]` and returns the index after it: rows run to a blank line or a line with no `|`.
i64 tableInto(ReadOnlySpan<string> lines, at i64 start, to ref StrBuf html, for ref MdState md) {
    let head = tableCells(lines[start])
    var aligns = List<string>()
    for cell in tableCells(lines[start + 1]) {
        aligns.append(alignmentOf(cell))
    }
    html.append("<table>\n<thead>\n<tr>")
    for k in 0..head.length {
        cellInto("th", from: head[k], by: aligns[k], to: ref html, for: ref md)
    }
    html.append("</tr>\n</thead>\n")
    var j = start + 2
    while j < lines.length && !isBlank(lines[j]) && has(lines[j], for: "|") {
        if j == start + 2 {
            html.append("<tbody>\n")
        }
        let row = tableCells(lines[j])
        html.append("<tr>")
        for k in 0..head.length {
            let cell = k < row.length ? row[k] : ""
            cellInto("td", from: cell, by: aligns[k], to: ref html, for: ref md)
        }
        html.append("</tr>\n")
        j += 1
    }
    if j > start + 2 {
        html.append("</tbody>\n")
    }
    html.append("</table>\n")
    return j
}

/// Appends the paragraph starting at `lines[at]` (bare text in a tight list item) and returns the index after it.
i64 paragraphInto(
    ReadOnlySpan<string> lines,
    at i64 start,
    by i64 depth,
    as bool tight,
    to ref StrBuf html,
    for ref MdState md
) {
    var text = StrBuf()
    text.append(lines[start].trimmed())
    var j = start + 1
    while j < lines.length && !startsBlock(lines, at: j, by: depth) {
        text.append("\n")
        text.append(lines[j].trimmed())
        j += 1
    }
    unless tight {
        html.append("<p>")
    }
    inlineInto($"{text.finish()}", by: 0, to: ref html, for: ref md)
    unless tight {
        html.append("</p>\n")
    }
    return j
}

/// Appends the blocks of `lines`, nested `depth` lists and blockquotes deep; past `maxNesting` markers are text.
void renderBlocks(ReadOnlySpan<string> lines, by i64 depth, as bool tight, to ref StrBuf html, for ref MdState md) {
    var i: i64 = 0
    var bare = false
    while i < lines.length {
        let line = lines[i]
        if isBlank(line) {
            i += 1
            continue
        }
        if bare {
            html.append("\n")
            bare = false
        }
        if !fenceOf(line).isEmpty {
            i = fencedInto(lines, at: i, to: ref html)
        } else if headingLevel(line) > 0 {
            headingInto(line, by: depth, to: ref html, for: ref md)
            i += 1
        } else if isRule(line) {
            html.append("<hr>\n")
            i += 1
        } else if depth < maxNesting && isQuote(line) {
            i = quoteInto(lines, at: i, by: depth, to: ref html, for: ref md)
        } else if depth < maxNesting && markerOf(line).content > 0 {
            i = listInto(lines, at: i, by: depth, to: ref html, for: ref md)
        } else if isTableStart(lines, at: i) {
            i = tableInto(lines, at: i, to: ref html, for: ref md)
        } else {
            i = paragraphInto(lines, at: i, by: depth, as: tight, to: ref html, for: ref md)
            bare = tight
        }
    }
}

/// The HTML of the Markdown `source`, with relative links pointed by `links`. The first `# ` heading becomes the title
/// and is left out of the HTML (the template shows it).
Rendered renderMarkdown(string source, by move DocLinks links) {
    var md = MdState {
        links: move links,
        slugs: List<string>(),
        bases: List<string>(),
        counts: List<i64>(),
        toc: List<Heading>(),
        title: "",
        titleTaken: false,
    }
    let lines = sourceLines(source)
    var html = StrBuf()
    renderBlocks(lines.span, by: 0, as: false, to: ref html, for: ref md)
    return Rendered { html: $"{html.finish()}", title: md.title, toc: md.toc.take() }
}
