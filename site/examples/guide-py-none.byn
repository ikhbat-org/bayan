string? find(List<string> names, by string prefix) {
    for n in names {
        if n.startsWith(prefix) {
            return n
        }
    }
    return null
}

void main() {
    let names: List<string> = ["aisha", "fatimah", "bilal"]
    print(find(names, by: "fa") ?? "nobody")
    print(find(names, by: "x") ?? "nobody")
    let hit = find(names, by: "bi")
    if hit is not null {
        print($"found {hit}")
    }
}
