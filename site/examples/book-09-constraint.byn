interface IShape {
    i64 area()
    string name => "shape"
    string describe() => $"{name} with area {area()}"
}

struct Square : IShape {
    i64 side

    i64 area() => side * side
    string name => "square"
}

struct Rect : IShape {
    i64 w
    i64 h

    i64 area() => w * h
}

string show<T>(T shape) where T : IShape => shape.describe()

i64 totalArea<T>(ReadOnlySpan<T> shapes) where T : IShape {
    var sum = 0
    for s in shapes {
        sum += s.area()
    }
    return sum
}

T larger<T>(move T a, by move T b) where T : IShape => a.area() >= b.area() ? move a : move b

void main() {
    print(show(Square { side: 3 }))
    print(show(Rect { w: 2, h: 5 }))
    let squares: List<Square> = [Square { side: 1 }, Square { side: 2 }]
    print($"{totalArea(squares.span)}")
    print($"{larger(Square { side: 3 }, by: Square { side: 4 }).side}")
}
