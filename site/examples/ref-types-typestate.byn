struct Order {
    i32 id

    states {
        draft
        paid(i32 payment)
        shipped(i32 payment, i32 tracking)
    }

    void pay(ref this is .draft, i32 amount) becomes .paid {
        become .paid(amount)
    }

    void ship(ref this is .paid, i32 tracking) becomes .shipped {
        become .shipped(payment, tracking)
    }

    i32 amount(this is .paid or .shipped) => payment
}

string describe(Order o) => o switch {
    .draft  => "draft",
    .paid p => $"paid {p.payment}",
    .shipped(let payment, let tracking) => $"shipped {payment} as {tracking}",
}

var o = Order.draft { id: 7 }
print(describe(o))
o.pay(250)
print(describe(o))
o.ship(42)
print($"{describe(o)} {o.amount()}")
