interface IShape {
    i32 area()

    string describe() => $"area {area()}"
}

struct Square : IShape {
    i32 side

    i32 area() => side * side
}

i32 twice<T>(T s) where T : IShape => s.area() * 2

void show(dyn ref IShape s) {
    print(s.describe())
}

var sq = Square { side: 3 }
print(sq.describe())
print($"{twice(sq)}")
show(sq)
