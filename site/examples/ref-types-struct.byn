struct Point {
    i32 x
    i32 y = 0

    i32  sum      => x + y
    bool isOrigin => x == 0 && y == 0

    i32 scaled(i32 k) => sum * k

    void shift(ref this, i32 dx) {
        x += dx
    }
}

var p = Point { x: 1 }
p.shift(4)
print($"{p.x} {p.y} {p.sum} {p.isOrigin} {p.scaled(2)}")
let q = p with { y: 9 }
print($"{q.y} {p == q} {p == Point { x: 5 }}")
