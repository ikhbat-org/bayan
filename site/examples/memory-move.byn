struct Bag {
    string name
    List<i64> items
}

i64 sum(move List<i64> xs) {
    var total: i64 = 0
    for x in xs {
        total += x
    }
    return total
}

void main() {
    var a = List<i64>()
    a.append(1)
    a.append(2)
    let b = move a
    print($"b {b.length}")

    var bag = Bag { name: "bag", items: move b }
    bag.items.append(3)
    print($"{bag.name} {bag.items.length}")

    var d = List<i64>()
    d.append(5)
    d.append(6)
    print($"sum {sum(move d)}")
}
