void transfer(i32 amount, from string payer, to string payee) {
    print($"{payer} pays {payee} {amount}")
}

i32 clamp(i32 x, to i32 max) => x > max ? max : x

i32 span(from i32 start, until i32 end) => end - start

void main() {
    transfer(200, from: "Aisha", to: "Ali")
    transfer(75, to: "Hafsa", from: "Aisha")
    print($"{clamp(12, to: 10)}")
    print($"{span(from: 3, until: 10)}")
}
