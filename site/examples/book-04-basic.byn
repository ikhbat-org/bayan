i32 square(i32 x) {
    return x * x
}

i32 cube(i32 x) => x * square(x)

void announce(string label, for i32 value) {
    print($"{label}: {value}")
}

i32 factorial(i32 n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

announce("square of 7", for: square(7))
announce("cube of 3", for: cube(3))
announce("5!", for: factorial(5))
