i64 square(i64 x) {
    return x * x
}

i64 cube(i64 x) => x * square(x)

void announce(string label, for i64 value) {
    print($"{label}: {value}")
}

i64 factorial(i64 n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

announce("square of 7", for: square(7))
announce("cube of 3", for: cube(3))
announce("5!", for: factorial(5))
