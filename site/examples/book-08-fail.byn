union error ParseError {
    empty
    notNumber
}

i64 parseQty(string text) fails ParseError {
    fail .empty if text.isEmpty
    return i64.tryParse(text) ?? fail .notNumber
}

void main() {
    print($"{parseQty("12") catch 0}")
    print($"{parseQty("") catch -1}")
    print($"{parseQty("twelve") catch -2}")
}
