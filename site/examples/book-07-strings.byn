void main() {
    let line = "  ada, 90 ,grace,85  "
    let clean = line.trimmed()
    print($"[{clean}] {clean.length} bytes")
    for part in clean.parts(by: ",") {
        print($"[{part.trimmed()}]")
    }
    let word = "héllo"
    print($"{word.length} bytes, {word.runeCount} runes")
    print(word[0..3])
    print($"{word.bytes[1]}")
    for r in word.runes.take(2) {
        print($"{r}")
    }
    var buf = StrBuf(capacity: 32)
    buf.append("total: ")
    buf.append($"{12 * 3}")
    print(buf.finish())
    print($"{i64.tryParse("90") ?? -1} {i64.tryParse("9x") ?? -1}")
    print($"[{"ada", width: 7}] [{7, width: 4, fill: '0'}]")
}
