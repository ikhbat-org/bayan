// A call picks the overload whose particles it writes.

struct Pos {
    i32 x

    Pos plus(by i32 d) => Pos { x: x + d }

    Pos plus(from i32 a, to i32 b) => Pos { x: x - a + b }
}

i32 shift(i32 x, by i32 d) => x + d
i32 shift(i32 x, from i32 a, to i32 b) => x - a + b

let p = Pos { x: 1 }
print($"{p.plus(by: 2).x} {p.plus(from: 1, to: 9).x}")
print($"{shift(1, by: 2)} {shift(1, from: 2, to: 5)}")
