union error CarrierError {
    timeout
    rejected
    offline
}

union error Retryable = CarrierError except .rejected

i64 send(i64 n) fails CarrierError {
    fail .rejected if n < 0
    fail .timeout if n == 0
    return n * 2
}

i64 retry(i64 n) fails Retryable {
    let q = send(n) catch (CarrierError.rejected) 1
    return q
}

void main() {
    print($"{retry(5) catch -1}")
    print($"{retry(-3) catch -1}")
    print($"{retry(0) catch -1}")
}
