public i64 checksum(ReadOnlySpan<i32> xs) {
    var total: i64 = 0
    for x in xs {
        total = total * 31 + x
    }
    return total
}

public List<i32> squares(i32 n) uses alloc {
    var xs = List<i32>()
    for i in 0..n {
        xs.append(i * i)
    }
    return xs
}

void main() {
    let xs = squares(5)
    print($"{xs.length} {checksum(xs.span)}")
}
