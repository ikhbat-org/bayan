union error ParseError {
    empty
    notNumber
    negative
}

i64 parseQty(string text) fails ParseError {
    fail .empty if text.isEmpty
    let n = i64.tryParse(text) ?? fail .notNumber
    fail .negative if n < 0
    return n
}

i64 lineTotal(string qty, by i64 price) fails ParseError {
    let n = try parseQty(qty)
    return n * price
}

void main() {
    print($"{lineTotal("3", by: 250) catch 0}")
    let bad = lineTotal("-3", by: 250) catch {
        print("rejected a negative quantity")
        return
    }
    print($"{bad}")
}
