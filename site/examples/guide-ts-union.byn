union Outcome {
    ok(string value)
    failed(string reason)
    pending
}

string render(Outcome r) => r switch {
    .ok(let v) => $"ok: {v}",
    .failed(let why) => $"failed: {why}",
    .pending => "pending",
}

void main() {
    let all: List<Outcome> = [.ok("done"), .failed("timeout"), .pending]
    for r in all { print(render(r)) }
}
