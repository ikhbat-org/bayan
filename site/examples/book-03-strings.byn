let word = "salām"
print($"{word.length} bytes, {word.runeCount} runes")
print(word.uppercased())
print($"{word.contains("lā")} {word.startsWith("s")} {word == "salām"}")
print(word[0..1])
for r in word.runes {
    print($"{r}")
}
let multi = """
two
lines
"""
print(multi)
let pair = $"{word}-{word.length}"
print(pair)
print($"braces: {{ and }}")
