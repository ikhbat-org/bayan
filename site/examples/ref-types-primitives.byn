let small: i8 = 100
let wide: i64 = small
let big: i64 = 300
print($"{wide}")
print($"{u8.tryFrom(big)} {u8.tryFrom(200)}")
let n: u8 = 250
print($"{n +% 10} {n +| 10}")
print($"{i32(big)} {f64(3) / 2.0} {i64(2.9)} {i64(-2.9)}")
print($"{7 / 2} {-7 / 2} {7 % 3}")
let flag: bool = true
print($"{flag and not false}")
