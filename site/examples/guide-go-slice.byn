void main() {
    let xs: List<i64> = [10, 20, 30, 40]
    let mid = xs.span[1..3]
    print($"{mid.length} {mid[0]} {mid[1]}")
    let s = "hello, world"
    print(s[0..5])
    var counts = Map<string, i64>()
    for w in "a b a c a b".parts(by: " ") {
        counts[w] = (counts.tryGet(at: w) ?? 0) + 1
    }
    print($"{counts["a"]} {counts["b"]} {counts["c"]}")
}
