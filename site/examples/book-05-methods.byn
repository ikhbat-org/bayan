struct Counter {
    string name
    i64 count = 0

    bool isZero => count == 0

    string describe() => $"{name}: {count}"

    void add(ref this, i64 amount = 1) {
        count += amount
    }

    static Counter named(string name) => Counter { name: name }
}

void main() {
    var hits = Counter.named("hits")
    print(hits.describe())
    print($"{hits.isZero}")
    hits.add()
    hits.add(amount: 5)
    print(hits.describe())
    print($"{hits.isZero}")
}
