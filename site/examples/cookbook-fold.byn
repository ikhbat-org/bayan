void main() {
    let xs: List<i32> = [1, 2, 3, 4, 5, 6]
    var total: i32 = 0
    var evens = List<i32>()
    var doubled = List<i32>()
    for x in xs {
        total += x
        if x % 2 == 0 {
            evens.append(x)
        }
        doubled.append(x * 2)
    }
    print($"total {total}, evens {evens.length}, doubled {doubled.length}")
    print($"last doubled: {doubled[doubled.length - 1]}")
}
