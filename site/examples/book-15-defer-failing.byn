union error StepError {
    broken
}

void step(bool ok) uses console fails StepError {
    defer print("always runs")
    defer failing print("only when step fails")
    fail .broken if !ok
    print("step ok")
}

void main() uses console {
    step(ok: true) catch { print("unexpected") }
    step(ok: false) catch { print("caught") }
}
