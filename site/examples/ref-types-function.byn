type Pred = i32 -> bool

bool any(ReadOnlySpan<i32> xs, by Pred p) {
    for x in xs {
        if p(x) {
            return true
        }
    }
    return false
}

i32 apply(i32 x, by (i32 -> i32) f) => f(x)

bool isBig(i32 x) => x > 2

let xs: Span<i32> = [1, 2, 3]
let base = 10
print($"{any(xs, by: it > 2)} {any(xs, by: x => x > 5)} {any(xs, by: isBig)}")
print($"{apply(1, by: x => x + base)}")
