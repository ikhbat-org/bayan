type Pred = i64 -> bool

bool any(ReadOnlySpan<i64> xs, by Pred p) {
    for x in xs {
        if p(x) {
            return true
        }
    }
    return false
}

i64 apply(i64 x, by (i64 -> i64) f) => f(x)

bool isBig(i64 x) => x > 2

let xs: Span<i64> = [1, 2, 3]
let base = 10
print($"{any(xs, by: it > 2)} {any(xs, by: x => x > 5)} {any(xs, by: isBig)}")
print($"{apply(1, by: x => x + base)}")
