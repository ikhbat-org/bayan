union error ConfigError {
    badValue
}

i32 parsePort(string text) fails ConfigError {
    return i32.tryParse(text) ?? fail .badValue
}

i32 doubled(string text) fails ConfigError {
    let n = try parsePort(text)
    return n * 2
}

void main() {
    print($"{doubled("21") catch -1}")
    print($"{doubled("x") catch -1}")
}
