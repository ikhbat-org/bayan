string greet(string name, string greeting = "Salam") => $"{greeting}, {name}!"

i64 repeatCount(string text, i64 times = 2) => text.length * times

void main() {
    print(greet("Aisha"))
    print(greet("Aisha", greeting: "Welcome"))
    print($"{repeatCount("abc")} {repeatCount("abc", times: 5)}")
}
