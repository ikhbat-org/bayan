struct User {
    string name
    string email
    i32 age
}

void main() {
    let aisha = User { name: "Aisha", email: "aisha@example.com", age: 36 }
    let older = aisha with { age: 37 }
    let renamed = aisha with { name: "Aisha L.", email: "aisha.l@example.com" }
    print($"{aisha.name} {aisha.age}")
    print($"{older.name} {older.age}")
    print($"{renamed.name} {renamed.email} {renamed.age}")
}
