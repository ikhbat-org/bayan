struct Money {
    i64 cents

    void formatInto(ref StrBuf sb) {
        sb.append($"${cents / 100}.{cents % 100, width: 2, fill: '0'}")
    }
}

struct Line {
    string item
    Money price
    i64 qty = 1
}

void main() {
    let tea = Line { item: "tea", price: Money { cents: 450 }, qty: 2 }
    print($"{tea.item} costs {tea.price} each")
    print($"{tea, as: .debug}")
}
