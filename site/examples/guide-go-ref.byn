void bump(ref i32 n) {
    n += 1
}

i32 total(ReadOnlySpan<i32> xs) {
    var sum: i32 = 0
    for x in xs {
        sum += x
    }
    return sum
}

void main() {
    var a: i32 = 1
    bump(ref a)
    bump(ref a)
    print($"{a}")
    let xs: List<i32> = [1, 2, 3]
    print($"{total(xs.span)} {total(xs.span[1..3])}")
}
