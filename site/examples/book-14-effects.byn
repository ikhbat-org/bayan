effect store = console, alloc

public i32 square(i32 n) {
    return n * n
}

public List<i32> squares(i32 upTo) uses alloc {
    var xs = List<i32>()
    for i in 1..=upTo {
        xs.append(square(i))
    }
    return xs
}

public void show(List<i32> xs) uses store {
    for x in xs {
        print($"- {x}")
    }
}

public i32 traced(i32 n) {
    log($"tracing {n}")
    return n + 1
}

void main() uses console, alloc {
    print($"square {square(7)}")
    let xs = squares(4)
    show(xs)
    print($"traced {traced(1)}")
}
