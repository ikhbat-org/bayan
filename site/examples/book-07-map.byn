void main() {
    var totals = Map<string, i32>()
    totals["aisha"] = 90
    totals["hafsa"] = 85
    totals["aisha"] = (totals.tryGet(at: "aisha") ?? 0) + 5
    print($"{totals.length} students")
    print($"aisha has {totals["aisha"]}")
    print($"yusuf has {totals.tryGet(at: "yusuf") ?? 0}")
    print($"{totals.contains("hafsa")}")
    for e in totals {
        print($"{e.key} -> {e.value}")
    }
    print($"{totals.remove("hafsa")} {totals.length}")
    let seeded: Map<string, i32> = ["x": 1, "y": 2]
    print($"{seeded.length}")
}
