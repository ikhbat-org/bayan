union error ConfigError {
    missing(string key)
    badValue
}

i64 port(string text) fails ConfigError {
    fail .missing("port") if text.length == 0
    return i64.tryParse(text) ?? fail .badValue
}

string describe(string text) {
    let n = port(text) catch switch {
        .missing(let key) => return $"missing key {key}",
        .badValue => return $"bad value `{text}`",
    }
    return $"port {n}"
}

void main() {
    for text in ["8080", "", "80x"] {
        print(describe(text))
    }
}
