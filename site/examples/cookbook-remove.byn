void main() {
    var xs: List<i64> = [10, 20, 30, 40, 50, 60]
    xs.remove(at: 0)
    print($"{xs.length} first {xs[0]}")
    xs.remove(at: 1..3)
    print($"{xs.length}: {xs[0]} {xs[1]} {xs[2]}")
    // By value: find the index, then remove it.
    for i in 0..xs.length {
        if xs[i] == 60 {
            xs.remove(at: i)
            break
        }
    }
    print($"{xs.length}: {xs[0]} {xs[1]}")
}
