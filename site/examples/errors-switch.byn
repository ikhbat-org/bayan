union error EmailError {
    invalid
    taken
}

union error DbError {
    timeout
    lost
}

union error SignupError = EmailError, DbError

i64 signUp(i64 n) fails SignupError {
    fail .invalid if n == 1
    fail .timeout if n == 2
    fail .lost if n == 3
    return n * 100
}

i64 handle(i64 n) => signUp(n) catch switch {
    EmailError => 10,
    DbError.timeout => 30,
    DbError e => 40,
}
void main() {
    for i in 0..4 {
        print($"{i}: {handle(i)}")
    }
}
