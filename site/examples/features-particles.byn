struct Account {
    string owner
    i32    balance
}

void transfer(i32 amount, from ref Account payer, to ref Account payee) {
    payer.balance -= amount
    payee.balance += amount
}

void main() {
    var aisha = Account { owner: "aisha", balance: 500 }
    var maryam = Account { owner: "maryam", balance: 100 }
    transfer(200, from: ref aisha, to: ref maryam)
    print($"{aisha.owner} {aisha.balance}")
    print($"{maryam.owner} {maryam.balance}")
}
