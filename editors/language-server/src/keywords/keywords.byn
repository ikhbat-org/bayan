/// The hover doc of each keyword in `names`.
const docs: string[70] = [
    "Conditional. No parentheses; braces required. Postfix form: `stmt if cond`.",
    "Pattern switch; exhaustive over unions and states.",
    "Leaves the loop.",
    "Read-only storage or pointer target.",
    "Clause: the method moves `this` to a state, `becomes .placed`. Every returning path must `become`.",
    "Copy with changed fields: `order with { quantity: 2 }`. Re-checks the type's rules.",
    "`defer failing stmt` runs `stmt` only when the scope exits by failure.",
    "`defer panicking stmt` runs `stmt` only when the scope exits by panic.",
    "Precondition checked at function entry in every build mode; traps on failure.",
    "Boolean or pattern disjunction (same as `||` in expressions).",
    "`type distinct Name = T` creates a new type that does not mix with `T`.",
    "Type, pattern or state test: `x is not null`, `order is .paid`.",
    "`effect db = net, fs` declares an effect alias for `uses` clauses.",
    "Module declaration.",
    "Typestate block inside a struct: one state per line. Refer to a state as `.s` or `Type.s`.",
    "Visible only inside the declaring type.",
    "No value; only for `T?`. Test with `is null` / `is not null`.",
    "`struct unique Name` is move-only: values are moved, never copied. Cannot be `const`.",
    "Mutable local binding, name first: `var w: Grams = 0g`.",
    "Boolean or pattern conjunction (same as `&&` in expressions).",
    "Unsafe block; needs `because \"…\"`.",
    "Benchmark declaration.",
    "Immutable local binding, name first: `let w: Grams = 0g`.",
    "Fails with an error case: `fail .timeout`. Also postfix (`fail .x if c`) and after `??`.",
    "Purpose clause, required on `@allow`, `@json(expose)`, `…Unchecked()` and `unsafe`.",
    "`for x in xs { … }` iterates any type with `moveNext`/`current`. `for try x in xs` for fallible sequences.",
    "Compile-time constant: `const name = …`.",
    "Runs at scope exit. `defer failing` runs only on failure, `defer panicking` only on panic.",
    "Skips to the next iteration.",
    "Test declaration: `test \"name\" { … }`, lives beside the code.",
    "Variadic parameter: `rest ReadOnlySpan<T> items`.",
    "Declares an interface. Properties are bare `Type name`; static members may use `Self`.",
    "Declares a value type. `struct unique Name` makes it move-only.",
    "Returns from the function.",
    "Handles failures: `catch e { … }` or `catch switch { case .x -> … }`.",
    "Negated conditional: `unless cond { … }` or postfix `stmt unless cond`.",
    "Boolean true.",
    "Exclusion (istithnāʾ): `for x in xs except null`, `union error A = B except .c`.",
    "`type Name = T` is an alias; `type distinct Name = T requires …` is a new type with rules.",
    "Power assert: on failure prints every sub-expression's value. `assert … fails` checks failures.",
    "Transitions `this` to a state: `become .placed`.",
    "Generic constraints clause. Clause order: `where`, `expects`, `uses`, `becomes`, `fails`.",
    "The implementing type inside an interface.",
    "Rule on a field, struct or distinct type, checked at construction and `with`.",
    "Implicit single parameter in lambdas and rules: `xs.where(it > 0)`.",
    "Loop while a condition holds. `while let x = …` loops while a value is present.",
    "Visible inside the package.",
    "Declares a tagged union. `union error Name` declares an error union; one `case` per line.",
    "Propagates a failure to the caller. `try … catch` handles it.",
    "Effect-handler block: `provide log: handler { … }` redirects an effect inside the block.",
    "Separates the loop variable from the sequence in `for x in xs`.",
    "Passes by reference. `ref this` marks a method that changes `this`.",
    "Clause listing the error unions a function can fail with: `fails IoError, ParseError`.",
    "Effect clause: `uses alloc, net, fs, clock, random, env, process, console, suspend`.",
    "Declares a foreign (C) function or type. Pointers are allowed only here.",
    "Particle (`as: .hex`) and pattern binding.",
    "`union error Name { … }` declares the error cases a function can `fail` with.",
    "Aborts with a message. Handled only by `Panic.handler` set in `main`.",
    "`checked(expr)` returns a failure instead of trapping on overflow.",
    "Boolean or pattern negation (same as `!` in expressions).",
    "Opt-in law declaration checked by the toolchain.",
    "Boolean false.",
    "Alternative branch; written after `}` on the same line.",
    "Imports a module (`core` needs no import).",
    "`const name = pattern T { … }` names a reusable pattern.",
    "Transfers ownership: `move x` at a call site, `move this` as a consuming receiver.",
    "The receiver. `ref this` mutates; `this is .s` requires a state; `move this` consumes.",
    "Visible outside the module (default visibility is module).",
    "A union case, or a `switch` arm.",
    "Type-level member.",
]

