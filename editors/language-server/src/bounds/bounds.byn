// The memory bounds of bayan-lsp (docs/memory-leaks.md, the `bayan-lsp` rows; spec 019 T38a, R22), ported from LanguageServerWorkspaceTests
// and LanguageServerLeakTests: the limits are set small on the workspace and the transport, as the C# tests set them; the server keeps its
// defaults. The C# heap measurements (a GC'd live heap, a WeakReference, a private buffer's capacity, allocated bytes) have no Bayān
// counterpart: the resident set of this test process (`ps`, so those blocks are pending on Windows) or what a structure keeps stands in, and
// each title says which. Each block works in its own tree under tmp/lsp-bounds/. scripts/release/editor-gate.sh runs them.

import server
import transport
import workspace

/// tmp/lsp-bounds/<name>, emptied and created; its real path, as the workspace keys files.
string fresh(string name) uses alloc, fs {
    let base = Path.combine(Path.fullPath("tmp"), "lsp-bounds")
    let dir = Path.combine(base, name)
    deleteTree(dir)
    Io.createDirectory(base) catch {}
    Io.createDirectory(dir) catch { panic($"cannot create {dir}") }
    return Fs.realPath(dir) catch { panic($"cannot resolve {dir}") }
}

/// Removes `dir` and everything under it; a link is removed, not followed.
void deleteTree(string dir) uses alloc, fs {
    let names = Io.listDir(dir) catch { return }
    for name in names {
        let path = Path.combine(dir, name)
        let real = Fs.realPath(path) catch ""
        if Fs.fileExists(path) || real != path {
            Io.remove(path) catch {}
        } else {
            deleteTree(path)
        }
    }
    Io.removeDirectory(dir) catch {}
}

/// Writes `text` to `rel` under `root`, creating its directories; the file's path.
string touch(string root, at string rel, as string text = "f() {}\n") uses alloc, fs {
    var dir = root
    var parts = List<string>()
    for p in rel.parts(by: "/") {
        parts.append(p)
    }
    for i in 0..parts.length - 1 {
        dir = Path.combine(dir, parts[i])
        Io.createDirectory(dir) catch {}
    }
    let path = Path.combine(dir, parts[parts.length - 1])
    Io.writeFile(path, text.bytes) catch { panic($"cannot write {path}") }
    return path
}

/// Whether `path` can be read.
bool readable(string path) uses alloc, fs {
    let _ = Io.readFile(path) catch { return false }
    return true
}

string uriOf(string root, at string rel) uses alloc => workspace.fileUri(Path.combine(root, rel))

/// The file names of the documents held, sorted.
List<string> names(ref workspace.Workspace ws) uses alloc {
    var all = List<string>()
    for at in ws.slots() {
        let u = ws.docs[at].uri
        let slash = u.lastPosition("/") ?? -1
        all.append(u[slash + 1..u.length])
    }
    all.sort()
    return all
}

/// The live memory of this process in KB. On Linux (and other Unix), `ps -o rss`; on macOS, `vmmap --summary`'s
/// `Physical footprint` (which counts compressed pages, unlike `ps -o rss`) minus freed allocator caches
/// (`MALLOC_LARGE (empty)` dirty+swapped and `MALLOC ZONE` `FRAG SIZE`, which `libmalloc` retains instead of unmapping).
i64 residentKb() uses alloc, process {
    var args = List<string>()
    args.append("-c")
    if Target.os == "macos" {
        args.append(
            "vmmap --summary $PPID | awk 'function kb(s,u,v){u=substr(s,length(s),1);v=substr(s,1,length(s)-1)+0;if(u==\"B\")return v/1024;if(u==\"K\")return v;if(u==\"M\")return v*1024;if(u==\"G\")return v*1024*1024;return 0}/^Physical footprint:[ \\t]/{fp=kb($3);seen=1}/^MALLOC_LARGE \\(empty\\)[ \\t]/{empty+=kb($5)+kb($6)}/^MALLOC ZONE[ \\t]/{zones=1;next}zones&&NF>=8&&$(NF-1)~/%$/{frag+=kb($(NF-2))}END{if(!seen)exit 1;v=int(fp-empty-frag+0.5);if(v<0)v=0;printf \"%d\\n\",v}'",
        )
    } else {
        args.append("ps -o rss= -p $PPID")
    }
    let r = Io.run("sh", args.span) catch { panic("cannot run sh to read the resident set") }
    assert(r.exitCode == 0)
    let text = r.stdout.trimmed()
    assert(text.length > 0)
    var kb: i64 = 0
    for b in text.bytes {
        assert(b >= '0' && b <= '9')
        kb = kb * 10 + i64(b - '0')
    }
    return kb
}

/// `Dense` of LanguageServerLeakTests: about `chars` characters of structs and functions with locals.
string dense(i64 chars) uses alloc {
    let unit = "struct S{i64 a}\nvoid f(i64 x){let y=x}\n"
    return unit.repeated((chars + unit.length - 1) / unit.length)
}

test "the file budget (maxFiles, 20,000 by default) stops indexing at 3 of 5 files but an open buffer is still held" {
    let root = fresh("file-count")
    for i in 0..5 {
        let _ = touch(root, at: $"src/f{i}.byn")
    }
    var ws = workspace.Workspace.create()
    ws.maxFiles = 3
    ws.indexFolder(root)
    assert(ws.slots().length == 3)
    assert(ws.limitReached)
    let _ = ws.open(uriOf(root, at: "src/open.byn"), from: "g() {}\n".utf16.copy(), at: 1)
    assert(ws.slots().length == 4)
}

test "the character budget (maxChars, 256 MiB by default) counts a removed file's characters back" {
    let root = fresh("char-refund")
    let a = touch(root, at: "src/a.byn", as: "aaaaaa")
    let _ = touch(root, at: "src/b.byn", as: "bbbbbb")
    var ws = workspace.Workspace.create()
    ws.maxChars = 10
    ws.indexFolder(root)
    assert(ws.slots().length == 1)
    let first = ws.docs[ws.slots()[0]].uri
    let _ = ws.remove(first)
    assert(ws.slots().length == 0)
    let _ = ws.loadFromDisk(a)
    assert(ws.slots().length == 1)
}

test "a spent file budget recovers once its files are removed and a second root is then indexed" {
    let root = fresh("limit-recovers")
    for i in 0..4 {
        let _ = touch(root, at: $"a/f{i}.byn")
    }
    let _ = touch(root, at: "b/x.byn")
    var ws = workspace.Workspace.create()
    ws.maxFiles = 3
    ws.indexFolder(Path.combine(root, "a"))
    assert(ws.limitReached)
    var uris = List<string>()
    for at in ws.slots() {
        uris.append(ws.docs[at].uri)
    }
    for u in uris {
        let _ = ws.remove(u)
    }
    assert(!ws.limitReached)
    ws.indexFolder(Path.combine(root, "b"))
    let n = names(ref ws)
    assert(n.length == 1 && n[0] == "x.byn")
}

test "a known file that grows past the character budget on reload is removed" {
    let root = fresh("grown-past-budget")
    let a = touch(root, at: "src/a.byn", as: "xxxx")
    var ws = workspace.Workspace.create()
    ws.maxChars = 10
    ws.indexFolder(root)
    assert(ws.slots().length == 1)
    Io.writeFile(a, "x".repeated(20).bytes) catch { panic($"cannot write {a}") }
    let _ = ws.loadFromDisk(a)
    assert(ws.slots().length == 0)
}

test "the folder walk stops at the first file rejected for the character budget: later files that would fit are skipped" {
    let root = fresh("walk-stops")
    for i in 0..4 {
        let _ = touch(root, at: $"src/f{i}.byn")
    }
    // The walk takes files in the order the directory lists them.
    let src = Path.combine(root, "src")
    let order = Io.listDir(src) catch { panic($"cannot list {src}") }
    for i in 0..4 {
        let text = i == 0 ? "aaaaaa" : i == 1 ? "b".repeated(20) : i == 2 ? "c" : "d"
        Io.writeFile(Path.combine(src, order[i]), text.bytes) catch { panic("cannot write a file") }
    }
    var ws = workspace.Workspace.create()
    ws.maxChars = 10
    ws.indexFolder(root)
    let n = names(ref ws)
    assert(n.length == 1 && n[0] == order[0])
}

test "a known file that does not grow is never evicted for the character budget, and the budget counts exactly" {
    let root = fresh("not-evicted")
    let a = touch(root, at: "src/a.byn", as: "12345678")
    var ws = workspace.Workspace.create()
    ws.maxChars = 10
    ws.indexFolder(root)
    let _ = ws.open(uriOf(root, at: "src/open.byn"), from: "x".repeated(20).utf16.copy(), at: 1)
    assert(ws.charCount > 10)
    Io.writeFile(a, "12345".bytes) catch { panic($"cannot write {a}") }
    let _ = ws.loadFromDisk(a)
    var found = false
    for name in names(ref ws) {
        found = found || name == "a.byn"
    }
    assert(found)
    assert(ws.charCount == 25)
}

test "the character count stays exact over open, full and incremental changes, a disk rewrite and the close that reloads it" {
    let root = fresh("char-count-exact")
    let a = touch(root, at: "src/a.byn", as: "abc\n")
    var ws = workspace.Workspace.create()
    ws.indexFolder(root)
    assert(ws.charCount == 4)
    let u = uriOf(root, at: "src/a.byn")
    let at = ws.open(u, from: "abcdef\n".utf16.copy(), at: 1)
    assert(ws.charCount == 7)
    ws.apply(at: at, from: 0, by: 1, to: 0, through: 3, as: "XYZW".utf16.copy().span)
    assert(ws.charCount == 9 && ws.docs[at].text.length == 9)
    ws.replace("12".utf16.copy(), at: at)
    assert(ws.charCount == 2)
    Io.writeFile(a, "disk text\n".bytes) catch { panic($"cannot write {a}") }
    ws.close(u)
    assert(ws.slots().length == 1 && ws.charCount == 10)
}

test "closing a buffer removes it when its disk file is under .worktrees/ or over the per-file limit (maxFileBytes, 4 MiB by default)" {
    let root = fresh("close-rules")
    let _ = touch(root, at: "src/kept.byn")
    let _ = touch(root, at: ".worktrees/w/hidden.byn")
    let _ = touch(root, at: "src/big.byn", as: "x".repeated(40))
    var ws = workspace.Workspace.create()
    ws.maxFileBytes = 32
    ws.indexFolder(root)
    assert(ws.slots().length == 1)
    let hidden = uriOf(root, at: ".worktrees/w/hidden.byn")
    let big = uriOf(root, at: "src/big.byn")
    let _ = ws.open(hidden, from: "g() {}\n".utf16.copy(), at: 1)
    let _ = ws.open(big, from: "h() {}\n".utf16.copy(), at: 1)
    assert(ws.slots().length == 3)
    ws.close(hidden)
    ws.close(big)
    let n = names(ref ws)
    assert(n.length == 1 && n[0] == "kept.byn")
    assert(ws.charCount == 7)
}

test "a file over the per-file limit (maxFileBytes + 1 bytes) is rejected by its size, unread: an unreadable one is still removed" {
    if Target.os == "windows" {
        todo("`chmod 000` makes the file unreadable; Windows has no chmod")
    }
    let root = fresh("sized-unread")
    let big = touch(root, at: "src/big.byn", as: "x".repeated(8))
    var ws = workspace.Workspace.create()
    ws.maxFileBytes = 32
    ws.indexFolder(root)
    assert(ws.slots().length == 1)
    Io.writeFile(big, "x".repeated(33).bytes) catch { panic($"cannot write {big}") }
    // Unreadable, so a full read fails and keeps the previous document; only the size check removes it.
    var args = List<string>()
    args.append("000")
    args.append(big)
    let _ = Io.run("chmod", args.span) catch { panic("cannot run chmod") }
    let unreadable = !readable(big)
    let _ = ws.loadFromDisk(big)
    args[0] = "644"
    let _ = Io.run("chmod", args.span) catch { panic("cannot run chmod") }
    if !unreadable {
        todo("`chmod 000` did not stop a read (running as root?)")
    }
    assert(ws.slots().length == 0)
}

test "the folder walk enters no hidden directory, tmp or build output (the incident: a whole tree and its mutants indexed)" {
    let root = fresh("skipped-dirs")
    let _ = touch(root, at: "src/a.byn")
    for d in [".git", ".worktrees", "tmp", "bin", "obj", "out", "node_modules", "target", "build", "dist"] {
        let _ = touch(root, at: $"{d}/x.byn")
    }
    var ws = workspace.Workspace.create()
    ws.indexFolder(root)
    let n = names(ref ws)
    assert(n.length == 1 && n[0] == "a.byn")
}

test "a disk document keeps under 12 bytes per character in the resident set, and no tokens, diagnostics or locals" {
    let root = fresh("bytes-per-char")
    let text = dense(1 << 20)
    var chars: i64 = 0
    for i in 0..8 {
        let _ = touch(root, at: $"src/d{i}.byn", as: text)
        chars += text.length
    }
    var ws = workspace.Workspace.create()
    let measured = Target.os != "windows"
    let before = measured ? residentKb() : 0
    ws.indexFolder(root)
    let after = measured ? residentKb() : 0
    assert(ws.charCount == chars)
    for at in ws.slots() {
        assert(ws.docs[at].tokens.length == 0 && ws.docs[at].diagnostics.length == 0)
        for s in ws.docs[at].symbols {
            assert(!s.isLocal)
        }
    }
    assert(ws.symbolsNamed("S").length > 0)
    if !measured {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    print($"retained {(after - before) * 1024 / chars} bytes per char over {chars} chars ({before} KB to {after} KB)")
    assert((after - before) * 1024 <= 12 * chars)
}

test "a replaced document leaves none of its symbols in the symbol index (the C# asserted it was collectable)" {
    let root = fresh("replaced")
    var files = List<string>()
    for i in 0..4 {
        files.append(touch(root, at: $"src/f{i}.byn", as: $"struct T{i} {{}}\n"))
    }
    var ws = workspace.Workspace.create()
    ws.indexFolder(root)
    assert(ws.globals().length == 4)
    assert(ws.symbolsNamed("T0").length == 1)
    for f in files {
        Io.writeFile(f, "struct Changed {}\n".bytes) catch { panic($"cannot write {f}") }
        let _ = ws.loadFromDisk(f)
    }
    for i in 0..4 {
        assert(ws.symbolsNamed($"T{i}").length == 0)
    }
    assert(ws.symbolsNamed("Changed").length == 4)
}

test "nesting 100,000 deep (brackets, blocks, string interpolation) gives one nesting diagnostic each and does not overflow the stack" {
    let n: i64 = 100000
    let open = ["(", "{ let a = [", "$\"{"]
    let close = [")", "]; }", "}\""]
    for k in 0..3 {
        let text = $"{k == 1 ? "void f() " : "f"}{open[k].repeated(n)}x{close[k].repeated(n)}"
        let d = workspace.Document.create("file:///deep.byn", from: text.utf16.copy(), at: 1, as: true)
        var nested = 0
        for g in d.diagnostics {
            if g.message.contains("nested deeper than 256") {
                nested += 1
            }
        }
        assert(nested == 1)
    }
}

test "a 300,000-link member chain is typed with the receiver depth capped at 8 and does not overflow the stack" {
    var ws = workspace.Workspace.create()
    let at = ws.open("file:///chain.byn", from: "a.".repeated(300000).utf16.copy(), at: 1)
    let doc = ws.docs[at].full()
    var last = doc.tokens.length - 1
    while last >= 0 && !doc.isTextAt(last, as: "a") {
        last -= 1
    }
    assert(last >= 599998)
    assert(ws.typeOfReceiver(doc, at: last) is null)
}

test "diagnostics are capped at 1,000 per file with one summary entry" {
    let d = workspace.Document.create("file:///semi.byn", from: ";".repeated(262144).utf16.copy(), at: 1, as: true)
    assert(d.diagnostics.length == 1001)
    assert(d.diagnostics[1000].message == "261144 more problems not shown")
}

test "an open buffer over 4 MiB of UTF-8 (maxFileBytes) is too large to analyse; one at the limit is not" {
    let ws = workspace.Workspace.create()
    assert(!ws.tooLarge("x".repeated(4194304).utf16.copy().span))
    assert(ws.tooLarge("x".repeated(4194305).utf16.copy().span))
    // 1,398,102 three-byte characters are 4,194,306 bytes in fewer units than the limit.
    assert(ws.tooLarge("一".repeated(1398102).utf16.copy().span))
    assert(!ws.tooLarge("一".repeated(1398101).utf16.copy().span))
}

test "one file through a linked directory is one document, and the walk does not follow the link" {
    if Target.os == "windows" {
        todo("`ln -s` makes the link; Windows has none")
    }
    let root = fresh("symlink")
    let _ = touch(root, at: "real/a.byn")
    var args = List<string>()
    for a in ["-s", Path.combine(root, "real"), Path.combine(root, "link")] {
        args.append(a)
    }
    let _ = Io.run("ln", args.span) catch { panic("cannot run ln") }
    var ws = workspace.Workspace.create()
    ws.indexFolder(root)
    assert(ws.slots().length == 1)
    let _ = ws.open(uriOf(root, at: "link/a.byn"), from: "g() {}\n".utf16.copy(), at: 1)
    assert(ws.slots().length == 1)
    assert(ws.charCount == 7)
}

test "re-walking a folder does not spend the directory bound (maxDirs, 200,000 by default)" {
    let root = fresh("rewalk")
    let _ = touch(root, at: "a/f.byn")
    let _ = touch(root, at: "a/s/f.byn")
    var ws = workspace.Workspace.create()
    ws.maxDirs = 3
    ws.indexFolder(Path.combine(root, "a"))
    for _ in 0..5 {
        ws.loadFolder(Path.combine(root, "a"))
    }
    let _ = touch(root, at: "a/t/f.byn")
    ws.loadFolder(Path.combine(root, "a/t"))
    assert(ws.slots().length == 3)
}

test "a removed folder refunds its directories to the directory bound" {
    let root = fresh("refund-dirs")
    let _ = touch(root, at: "a/f.byn")
    let _ = touch(root, at: "a/s/f.byn")
    var ws = workspace.Workspace.create()
    ws.maxDirs = 2
    ws.indexFolder(Path.combine(root, "a"))
    let _ = ws.removeFolder(uriOf(root, at: "a/s"))
    let _ = touch(root, at: "a/t/f.byn")
    ws.loadFolder(Path.combine(root, "a/t"))
    assert(ws.slots().length == 2)
}

test "the folder walk stops at the directory bound, over every walk together" {
    let root = fresh("dir-bound")
    let _ = touch(root, at: "r.byn")
    for i in 0..5 {
        let _ = touch(root, at: $"d{i}/f.byn")
    }
    var ws = workspace.Workspace.create()
    ws.maxDirs = 3
    ws.indexFolder(root)
    assert(ws.slots().length == 3)
    ws.loadFolder(Path.combine(root, "d0"))
    assert(ws.slots().length == 3)
}

/// `Content-Length` framing of `body`.
List<u8> framed(string body) uses alloc {
    var bytes = List<u8>()
    for b in $"Content-Length: {body.length}\r\n\r\n".bytes {
        bytes.append(b)
    }
    for b in body.bytes {
        bytes.append(b)
    }
    return bytes
}

test "a message over the message limit (64 MiB by default) is skipped and a large one under it still parses" {
    let text = "a".repeated(300000)
    var input = List<u8>()
    // The skipped message is valid JSON: read past the limit, it would be the first message.
    let skipped = "{\"text\":\"skipped\"}"
    for b in framed($"{skipped}{" ".repeated(500000 - skipped.length)}") {
        input.append(b)
    }
    for b in framed($"{{\"text\":\"{text}\"}}") {
        input.append(b)
    }
    var t = transport.Transport.reading(move input, at: 400000)
    let doc = t.read() ?? panic("no message read")
    let e = doc.get("text", at: doc.root) catch { panic("no text member") }
    let s = doc.text(e) catch { panic("text is not a string") }
    assert(s == text)
    assert(t.read() is null)
}

test "a Content-Length of 60 MiB with a 2-byte body grows the resident set by under 1 MiB: the body is not allocated up front" {
    if Target.os == "windows" {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    var input = List<u8>()
    for b in $"Content-Length: {60 << 20}\r\n\r\n{{}}".bytes {
        input.append(b)
    }
    var t = transport.Transport.reading(move input, at: 64 << 20)
    let before = residentKb()
    assert(t.read() is null)
    let after = residentKb()
    print($"resident set {before} KB to {after} KB")
    assert(after - before < 1024)
}

/// Frames a message holding `big` as `run` answers one: in its own arena.
void sendBig(string big) uses alloc {
    using let arena = Arena()
    provide allocator: arena {
        var w = transport.begin()
        w.writeString(big, for: "big")
        assert(transport.frame(ref w).length > 2 << 20)
    }
}

test "16 messages of 2 MiB read and 16 written grow the resident set by less than two of them; the transport keeps only its 64 KiB input chunk" {
    if Target.os == "windows" {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    let big = "x".repeated(2 << 20)
    var input = List<u8>()
    for _ in 0..16 {
        // A notification no handler takes: read and dropped, nothing written.
        for b in framed($"{{\"jsonrpc\":\"2.0\",\"method\":\"x/big\",\"params\":{{\"big\":\"{big}\"}}}}") {
            input.append(b)
        }
    }
    // The feed is copied so every page of it is written before the first reading: a large `realloc` remaps pages instead of copying
    // them, and a page the system has not committed yet would count against the reads when the transport first touches it.
    var t = transport.Transport.reading(input.copy(), at: 64 << 20)
    var s = server.Server.create()
    // One message read and one written first: the allocator keeps the pages of the first message's arena for the next, as the edit
    // block's warm-up.
    var warm = transport.Transport.reading(
        framed($"{{\"jsonrpc\":\"2.0\",\"method\":\"x/big\",\"params\":{{\"big\":\"{big}\"}}}}"),
        at: 64 << 20,
    )
    assert(s.run(ref warm) == 0)
    sendBig(big)
    let before = residentKb()
    assert(s.run(ref t) == 0)
    let read = residentKb()
    for _ in 0..16 {
        sendBig(big)
    }
    let after = residentKb()
    print($"resident set {before} KB, {read} KB after the reads, {after} KB after the writes")
    assert(t.bufferBytes <= (64 << 10) + 256)
    // macOS: less than four messages. The hosted macos-15 runner grew 6288 KB on the reads and 4160 KB on the writes (release dry run
    // 44688158908, 2026-11-20); on macOS arm64 the growth stays flat from 16 to 256 messages (under 3.6 MB, docs/memory-leaks.md), so it is the
    // allocator keeping pages, not a message kept. A kept message per read is 32768 KB at 16, still over. The reads then grew 13392,
    // 11760 and 8912 KB on the same runner with no transport or runtime change (release dry runs 44825766493, 44835983809, 44851112492,
    // 2026-11-21), so macOS takes half a kept message's growth.
    let limit: i64 = Target.os == "macos" ? 16384 : 4096
    assert(read - before < limit)
    assert(after - read < limit)
}

test "reading past 16 bad-JSON bodies of 256 KiB keeps the tree of one of them in the message arena: each is read as its own message" {
    if Target.os == "windows" {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    // A long array cut off by a stray byte: the parse builds its tree before it fails.
    let junk = $"[{"1,".repeated(1 << 17)}x"
    var input = List<u8>()
    for _ in 0..16 {
        for b in framed(junk) {
            input.append(b)
        }
    }
    for b in framed("{}") {
        input.append(b)
    }
    var t = transport.Transport.reading(input.copy(), at: 64 << 20)
    var warm = transport.Transport.reading(framed(junk), at: 64 << 20)
    using let warmArena = Arena()
    provide allocator: warmArena {
        let _ = warm.read()
    }
    let before = residentKb()
    var during: i64 = 0
    using let arena = Arena()
    provide allocator: arena {
        let _ = t.read()
        during = residentKb()
    }
    print($"resident set {before} KB, {during} KB after the first read")
    assert(during - before < 65536)
}

test "1,000 edits to one open document do not grow the resident set" {
    if Target.os == "windows" {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    var ws = workspace.Workspace.create()
    let text = dense(1 << 14)
    let at = ws.open("file:///edits.byn", from: text.utf16.copy(), at: 1)
    var before: i64 = 0
    for i in 0..1000 {
        // After a warm-up.
        if i == 100 {
            before = residentKb()
        }
        // As `run` handles a didChange: in its own arena.
        using let arena = Arena()
        provide allocator: arena {
            if i % 2 == 0 {
                ws.apply(at: at, from: 0, by: 0, to: 0, through: 0, as: "x".utf16.copy().span)
            } else {
                ws.apply(at: at, from: 0, by: 0, to: 0, through: 1, as: "".utf16.copy().span)
            }
            ws.set(at, to: i32(i + 2))
            assert(ws.symbolsNamed("f").length > 0)
        }
    }
    let after = residentKb()
    print($"resident set {before} KB to {after} KB")
    assert(ws.docs[at].version == 1001 && ws.charCount == text.length)
    // The allocator settles at most one step of about 2.5 MiB at some edit; an edit that kept its document would add over 100 KiB.
    assert(after - before < 4096)
}

test "40 incremental changes to a 1 MiB document in one didChange do not grow the resident set: no change keeps its text" {
    if Target.os == "windows" {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    var ws = workspace.Workspace.create()
    let text = dense(1 << 19)
    let at = ws.open("file:///changes.byn", from: text.utf16.copy(), at: 1)
    var before: i64 = 0
    var after: i64 = 0
    // As `run` handles one didChange with many `contentChanges`: all in one arena.
    using let arena = Arena()
    provide allocator: arena {
        for i in 0..40 {
            // After a warm-up.
            if i == 4 {
                before = residentKb()
            }
            if i % 2 == 0 {
                ws.apply(at: at, from: 0, by: 0, to: 0, through: 0, as: "x".utf16.copy().span)
            } else {
                ws.apply(at: at, from: 0, by: 0, to: 0, through: 1, as: "".utf16.copy().span)
            }
        }
        after = residentKb()
    }
    print($"resident set {before} KB to {after} KB")
    assert(ws.charCount == text.length)
    // A change that kept its text in the message arena would add about 2 MiB each, over 70 MiB for the 36 measured.
    assert(after - before < 8192)
}

test "walking 100 folders of 200 files leaves under 2 MiB in the message arena: the walk keeps no listing once it returns" {
    if Target.os == "windows" {
        todo("`sh` and `ps` read the resident set; Windows has neither")
    }
    let root = fresh("walk-listing")
    let stem = "n".repeated(100)
    for d in 0..100 {
        for f in 0..200 {
            let _ = touch(root, at: $"d{d}/{stem}{f}.txt", as: "")
        }
    }
    var ws = workspace.Workspace.create()
    var before: i64 = 0
    var after: i64 = 0
    // As `run` handles initialize: the walk in one arena.
    using let arena = Arena()
    provide allocator: arena {
        before = residentKb()
        ws.indexFolder(root)
        after = residentKb()
    }
    print($"resident set {before} KB to {after} KB")
    assert(ws.slots().length == 0)
    // A walk that kept every name and entry path in the message arena would add over 6 MiB for the 20,000 entries. The peak during the
    // walk (each folder in its own arena) is not seen here: the resident set is read only before and after.
    assert(after - before < 2048)
}
