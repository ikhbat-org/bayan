// LSP base protocol: `Content-Length` framed JSON over standard input and output.

/// A body over this many bytes is read past in chunks and dropped.
const defaultMaxMessage: i64 = 64 * 1024 * 1024

const chunk: i64 = 64 * 1024

/// Header lines keep this many bytes; the rest of a longer line is dropped.
const headerLimit: i64 = 256

const contentLengthKey: string = "Content-Length:"

/// Reads framed messages from standard input and writes framed messages to standard output.
public struct Transport {
    i64        maxMessage
    List<u8>   input
    i64        pos    = 0
    i64        filled = 0
    List<u8>   header

    public static Transport create(i64 maxMessage = defaultMaxMessage) uses alloc {
        var input = List<u8>()
        for _ in 0..chunk {
            input.append(0)
        }
        return Transport { maxMessage: maxMessage, input: move input, header: List<u8>() }
    }

    /// The next byte of standard input, or -1 at its end (a read error ends it too).
    i64 readByte(ref this) uses console {
        if pos == filled {
            let n = Io.stdin.read(to: input.mutableSpan()) catch { return -1 }
            return -1 if n <= 0
            pos = 0
            filled = n
        }
        let b = input[pos]
        pos += 1
        return i64(b)
    }

    /// Fills `into` from standard input; false if it ended first.
    bool readExactly(ref this, Span<u8> into) uses console {
        var done: i64 = 0
        while done < into.length {
            if pos == filled {
                let n = Io.stdin.read(to: input.mutableSpan()) catch { return false }
                return false if n <= 0
                pos = 0
                filled = n
            }
            let k = (into.length - done < filled - pos ? into.length - done : filled - pos)
            for i in 0..k {
                into[done + i] = input[pos + i]
            }
            pos += k
            done += k
        }
        return true
    }

    /// One header line into `header`, without its `\n` (and a `\r` before it); false at the end of input.
    bool readLine(ref this) uses alloc, console {
        header.clear()
        while true {
            let b = readByte()
            return false if b < 0
            if b == 10 {
                if header.length > 0 && header[header.length - 1] == '\r' {
                    let _ = header.removeLast()
                }
                return true
            }
            if header.length < headerLimit {
                header.append(u8(b))
            }
        }
    }

    /// The next message, or null at the end of input. A body that is not JSON is logged and skipped.
    public JsonDocument? read(ref this) uses alloc, console {
        while true {
            var contentLength: i64 = -1
            while true {
                return null if !readLine()
                if header.length == 0 {
                    break if contentLength >= 0
                    continue
                }
                let len = parseContentLength(header.span)
                if len >= 0 {
                    contentLength = len
                }
            }
            if contentLength > maxMessage {
                Io.stderr.write($"bayan-lsp: message of {contentLength} bytes dropped, over the {maxMessage} byte limit\n")
                var skip = List<u8>()
                for _ in 0..chunk {
                    skip.append(0)
                }
                var left = contentLength
                while left > 0 {
                    let k = (left < chunk ? left : chunk)
                    return null if !readExactly(skip.mutableSpan()[0..k])
                    left -= k
                }
                continue
            }
            var body = List<u8>()
            var read: i64 = 0
            while read < contentLength {
                let k = (contentLength - read < chunk ? contentLength - read : chunk)
                for _ in 0..k {
                    body.append(0)
                }
                return null if !readExactly(body.mutableSpan()[read..read + k])
                read += k
            }
            let doc = JsonDocument.parse(move body) catch switch {
                .syntax(let message, let offset) => {
                    Io.stderr.write($"bayan-lsp: bad message skipped: {message} at byte {offset}\n")
                    continue
                },
            }
            return doc
        }
    }
}

/// Starts a message: `{"jsonrpc":"2.0"` is written, the caller writes the rest of the object's members.
public JsonWriter begin() uses alloc {
    var w = JsonWriter.create()
    w.writeStartObject()
    w.writeString("2.0", for: "jsonrpc")
    return w
}

/// Ends the message started by `begin` and writes it to standard output with its header.
public void send(ref JsonWriter w) uses alloc, console {
    w.writeEndObject()
    let body = w.text ?? panic("bayan-lsp: the JSON writer wrote text that is not UTF-8")
    Io.stdout.write($"Content-Length: {body.length}\r\n\r\n")
    Io.stdout.write(body)
}

/// The value of a `Content-Length:` line (key in any ASCII case) as `long.TryParse` reads it after trimming spaces, or -1.
i64 parseContentLength(ReadOnlySpan<u8> line) {
    let n = contentLengthKey.length
    return -1 if line.length <= n
    for i in 0..n {
        return -1 if asciiLower(line[i]) != asciiLower(contentLengthKey.bytes[i])
    }
    var start = n
    var end = line.length
    while start < end && line[start] == ' ' {
        start += 1
    }
    while end > start && line[end - 1] == ' ' {
        end -= 1
    }
    return parseLong(line[start..end])
}

u8 asciiLower(u8 b) => b >= 'A' && b <= 'Z' ? b + 32 : b

bool isWhite(u8 b) => b == ' ' || (b >= 0x09 && b <= 0x0D)

/// `long.TryParse` with `NumberStyles.Integer`: whitespace around, an optional sign, digits; trailing NULs are allowed. Returns -1 when
/// it fails or the value is negative (a header with either is ignored).
i64 parseLong(ReadOnlySpan<u8> text) {
    var i: i64 = 0
    var end = text.length
    while end > 0 && text[end - 1] == 0 {
        end -= 1
    }
    while i < end && isWhite(text[i]) {
        i += 1
    }
    while end > i && isWhite(text[end - 1]) {
        end -= 1
    }
    var negative = false
    if i < end && (text[i] == '+' || text[i] == '-') {
        negative = text[i] == '-'
        i += 1
    }
    return -1 if i >= end
    var value: i64 = 0
    while i < end {
        let b = text[i]
        return -1 if b < '0' || b > '9'
        let d = i64(b - '0')
        return -1 if value > (i64.max - d) / 10
        value = value * 10 + d
        i += 1
    }
    if negative {
        return value == 0 ? 0 : -1
    }
    return value
}
