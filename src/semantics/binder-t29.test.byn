// 019 T29 (coverage ratchet): binder.byn paths no golden case reaches: bodies whose first statement is an increment, a
// `continue`, a `do`-`while`, a `;` or a parse error, and `requires` rules that are not `bool`, read no field, repeat a
// field, measure `runeCount` or overflow. The expected values are the output of the self-hosted checker at the commit that
// added the test.

test "binder t29: requires rules of every shape" {
    let text = """
        struct A {
            i64 n
                requires it + 1
        }

        struct B {
            i64 n
            requires 1 + 1 == 2
        }

        struct C {
            i64 n
                requires it > 0
                requires it < 10
        }

        struct D {
            string s
                requires it.runeCount in 1..=5
        }

        struct E {
            i64 n
                requires it in 1..=(1 << 62) * 4
        }

        void inc(ref i64 n) {
            n++
        }

        void loop() {
            do {
            } while false
        }

        void main() {}
        """
    let c = t29s1Compile(text)
    let expected = """
        BYN2320 a `requires` clause must be `bool`, got `i64`
        BYN2204 constant arithmetic overflows `i64`

        """
    assert t29s1Diags(in c) == expected
}

test "binder t29: a first statement that is a continue, a semicolon or a parse error" {
    let c1 = t29s1Compile("void f() {\n    continue\n}\n\nvoid main() {}\n")
    assert t29s1Diags(in c1) == "BYN2406 `continue` outside a loop\n"
    let c2 = t29s1Compile("void f() {\n    ;\n}\n\nvoid main() {}\n")
    assert t29s1Diags(in c2) == "BYN1040 `;` is an input form; a statement ends at the newline\n"
    let c3 = t29s1Compile("void f() {\n    )\n}\n\nvoid main() {}\n")
    assert t29s1Diags(in c3) == "BYN1002 expected an expression, found `)`\n"
}

test "binder t29: constants without a value, constant arrays, array lengths and parameter defaults" {
    let text = """
        const x: i64
        const y
        const z: i64[2] = [1, 2]
        const a: i64[2] = z
        const e: i64[2] = [1, nope]
        const q: i64[2] = nope
        const w = [[1]]
        const v = [1, h()]
        const n = 0 - 1
        const t = true

        i64 h() => 1

        void g(i64 x = h()) {}

        void k1(i64[n] xs) {}

        void k3(i64[t] xs) {}

        void main() {}
        """
    let c = t29s1Compile(text)
    let expected = """
        BYN2203 -1 does not fit in an array length
        BYN2202 expected `i64`, found `bool`
        BYN2101 `const x` needs a value
        BYN2101 `const y` needs a value
        BYN2229 module-level `const` array `a` must hold literal numbers, `bool`s, `rune`s or `string`s
        BYN2001 `nope` is not defined
        BYN2001 `nope` is not defined
        BYN2229 module-level `const` array `w` must hold literal numbers, `bool`s, `rune`s or `string`s
        BYN2202 expected `i32`, found `i64`
        BYN2219 a parameter default must be a compile-time constant

        """
    assert t29s1Diags(in c) == expected
}
