// 019 T29 (coverage ratchet): calls.byn's search for `it` in each kind of argument, inference through each kind of
// parameter type, and misused `tryFrom` and implied names, which no golden case reaches. The expected text is the output
// of the self-hosted code at the commit that added the test.

test "calls t29: an `it` argument found in each kind of expression" {
    let text = "struct P {\n    i64 a\n}\n\nunion error E { bad }\n\ni64 apply(by (i64) -> i64 f) => f(1)\ni64 h(i64 a, by i64 b) => a + b\ni64 fail1(i64 a) fails E => a\n\nvoid main() {\n    let xs = [1]\n    let p = P { a: 1 }\n    let s = [\n        apply(by: it(1)),\n        apply(by: h(1, by: it)),\n        apply(by: h(1, by: 2)),\n        apply(by: (it)),\n        apply(by: xs[it]),\n        apply(by: -it),\n        apply(by: 1 + it),\n        apply(by: 1..it),\n        apply(by: true ? 1 : it),\n        apply(by: it is 1),\n        apply(by: 1 in 0..it),\n        apply(by: 0 switch { 1 => 2, _ => it }),\n        apply(by: 0 switch { 1 => 2, _ => 3 }),\n        apply(by: try fail1(it)),\n        apply(by: move it),\n        apply(by: fail1(1) catch (E.bad) it),\n        apply(by: P { a: it }),\n        apply(by: P { a: 1 }),\n        apply(by: p with { a: it }),\n        apply(by: p with { a: 1 }),\n        apply(by: [1, ..it]),\n        apply(by: [1: it]),\n        apply(by: [1, it]),\n        apply(by: [1]),\n        apply(by: (1, it)),\n        apply(by: (1, 2)),\n        apply(by: $\"{1}{it}\"),\n        apply(by: $\"a{1}\"),\n    ]\n    print($\"{s.length}\")\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN2220 233+2 `i64` cannot be called;BYN2202 292+11 expected `i64 -> i64`, found `i64`;BYN2202 427+5 expected `i64`, found `Range<i64>`;BYN2202 487+7 expected `i64`, found `bool`;BYN2202 515+10 expected `i64`, found `bool`;BYN2202 595+27 expected `i64 -> i64`, found `i32`;BYN2782 682+2 cannot move out of a fresh value;BYN2202 751+11 expected `i64`, found `P`;BYN2202 783+10 expected `i64 -> i64`, found `P`;BYN2202 814+16 expected `i64`, found `P`;BYN2202 851+15 expected `i64 -> i64`, found `P`;BYN2202 887+9 expected `i64`, found `a collection literal`;BYN2022 891+4 spreads (`..xs`) outside a collection literal is not supported in v0.1;BYN2202 917+7 expected `i64`, found `a map literal`;BYN2202 945+7 expected `i64`, found `a collection literal`;BYN2202 973+3 expected `i64 -> i64`, found `a collection literal`;BYN2202 997+7 expected `i64`, found `(i32, i64)`;BYN2202 1025+6 expected `i64 -> i64`, found `(i32, i32)`;BYN2202 1052+10 expected `i64`, found `string`;BYN2202 1083+7 expected `i64 -> i64`, found `string`;BYN2604 643+13 `main$lambda12` cannot fail, so it cannot pass on `E`;",
    )
}

test "calls t29: inference through optional, span, tuple, function, map, result and generic parameters" {
    let text = "struct Box<T> {\n    T v\n}\n\nunion error E { bad }\n\nT opt<T>(T? x) => todo(\"opt\")\nT sp<T>(ReadOnlySpan<T> s) => todo(\"sp\")\nT tup<T>((T, i64) p) => todo(\"tup\")\nT fun<T>((T) -> i64 f) => todo(\"fun\")\nT bx<T>(Box<T> b) => todo(\"bx\")\nT res<T>(Result<T, E> r) => todo(\"res\")\nT mp<T>(Map<string, T> m) => todo(\"mp\")\nT ls<T>(List<T> m) => todo(\"ls\")\n\ni64 len(string s) => 1\n\nvoid main() {\n    let o: i64? = 1\n    let a = opt(o)\n    let b = opt(2)\n    let c = sp([1, 2])\n    let d = sp(3)\n    let e = tup((1, 2))\n    let f = tup((1, 2, 3))\n    let g = tup(4)\n    let h = fun(len)\n    let i = fun(5)\n    let j = bx(Box { v: 1 })\n    let k = bx(6)\n    let m: Map<string, i64> = [\"a\": 1]\n    let n = mp(m)\n    let q = mp(7)\n    let r = ls([1])\n    let t = ls(8)\n    print($\"{a}{b}{c}{d}{e}{f}{g}{h}{i}{j}{k}{n}{q}{r}{t}\")\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN2740 472+2 cannot infer type argument `T` of `sp`;BYN2202 494+6 expected `(i32, i64)`, found `(i32, i32)`;BYN2740 514+3 cannot infer type argument `T` of `tup`;BYN2740 541+3 cannot infer type argument `T` of `tup`;BYN2740 581+3 cannot infer type argument `T` of `fun`;BYN2023 603+3 `Box` takes 1 type argument(s), not 0;BYN2740 600+2 cannot infer type argument `T` of `bx`;BYN2740 629+2 cannot infer type argument `T` of `bx`;BYN2740 704+2 cannot infer type argument `T` of `mp`;BYN2740 722+2 cannot infer type argument `T` of `ls`;BYN2740 742+2 cannot infer type argument `T` of `ls`;",
    )
}

test "calls t29: `tryFrom` with two arguments or a text and implied names" {
    let text = "struct Opts {\n    bool verbose\n}\n\nvoid run(bool verbose) {}\nT id<T>(T x) => x\ni64 one() => 1\n\nvoid main() {\n    let a = u8.tryFrom(1, 2)\n    let b = u8.tryFrom(\"x\")\n    let o: Opts? = Opts { verbose: true }\n    run(o?.verbose)\n    run(id<bool>)\n    print($\"{a}{b}\")\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN2302 120+10 `u8.tryFrom` takes 1 argument(s);BYN2206 160+3 cannot convert `string` to `u8`;BYN2305 215+3 argument for `verbose` must be named;BYN2022 215+3 `?.` is not supported in v0.1;BYN2305 235+8 argument for `verbose` must be named;BYN2019 235+8 `id` is a function, not a value;BYN2780 76+1 implicit copy of a unique value: type parameter `T` may stand for a unique type;",
    )
}

test "calls t29: a spread of a non-collection, an `out` argument of a known state and a `ref` argument of another type" {
    let text = "struct S {\n    i64 n\n}\n\ni64 sum(rest ReadOnlySpan<i64> xs) => xs.length\nvoid setOut(out i64 v) {\n    v = 1\n}\nvoid bump(ref i64 v) {\n    v += 1\n}\n\nvoid main() {\n    let n = 3\n    let a = sum(..n)\n    let xs = [1, 2]\n    let b = sum(..xs)\n    let c = sum(1, 2, 3)\n    var k: i64 = 0\n    setOut(out k)\n    var w: i32 = 0\n    bump(ref w)\n    print($\"{a}{b}{c}{k}{w}\")\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN2215 190+3 a range needs both ends here;BYN2202 233+2 expected `ReadOnlySpan<i64>`, found `i32[2]`;BYN2202 331+1 expected `i64`, found `i32`;BYN2311 307+1 `w` is never reassigned; declare it with `let`;",
    )
}

test "calls t29: `it` found in an `in`, except, move and `with` argument" {
    let text = "struct P {\n    i64 x\n}\n\nbool keep((i64) -> bool f) => true\nP mk((i64) -> P f) => P { x: 1 }\ni64? opt((i64) -> i64? f) => 1\n\nvoid main() {\n    let p = P { x: 1 }\n    let a = keep(it in 0..3)\n    let d = opt(move it)\n    let e = mk(p with { x: it })\n    let g = opt(it except null)\n    print($\"{a}{d}{e.x}{g}\")\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN2782 211+2 cannot move out of a fresh value;BYN2022 264+9 this expression is not supported in v0.1;",
    )
}

test "calls t29: inference from typed map, result, generic struct, span and function parameters" {
    let text = "struct Box<T> {\n    T v\n}\n\nunion error E {\n    bad\n}\n\nT mp<T>(Map<string, T> a, Map<string, T> b) => todo(\"mp\")\nT res<T>(Result<T, E> r) => todo(\"res\")\nT bx<T>(Box<T> a, Box<T> b) => todo(\"bx\")\nT sp<T>(ReadOnlySpan<T> s) => todo(\"sp\")\nT fun<T>((T) -> i64 f) => todo(\"fun\")\nT tup<T>((T, i64) p) => todo(\"tup\")\n\nvoid use(\n    Map<string, i64> m1,\n    Map<string, string> m2,\n    Result<i64, E> r,\n    Box<i64> b1,\n    Box<string> b2,\n    ReadOnlySpan<i64> s,\n    (i64, i64) -> i64 f2,\n    (string, i64) t\n) {\n    let a = mp(m1, m2)\n    let b = mp(m1, m1)\n    let c = res(r)\n    let d = bx(b1, b2)\n    let e = bx(b1, b1)\n    let g = sp(s)\n    let h = fun(f2)\n    let k = tup(t)\n    let n = i64.parse(\"12\")\n    print($\"{a}{b}{c}{d}{e}{g}{h}{k}{n}\")\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN5004 56+2 `mp` has 2 unlabeled parameters; give each but one a particle;BYN5006 95+1 `b` is a required parameter besides the object and needs a particle;BYN5004 154+2 `bx` has 2 unlabeled parameters; give each but one a particle;BYN5006 177+1 `b` is a required parameter besides the object and needs a particle;BYN5004 315+3 `use` has 8 unlabeled parameters; give each but one a particle;BYN5006 369+2 `m2` is a required parameter besides the object and needs a particle;BYN5006 392+1 `r` is a required parameter besides the object and needs a particle;BYN5006 408+2 `b1` is a required parameter besides the object and needs a particle;BYN5006 428+2 `b2` is a required parameter besides the object and needs a particle;BYN5006 454+1 `s` is a required parameter besides the object and needs a particle;BYN5006 479+2 `f2` is a required parameter besides the object and needs a particle;BYN5006 501+1 `t` is a required parameter besides the object and needs a particle;BYN2741 526+2 type argument `T` of `mp` is inferred as both `i64` and `string`;BYN2741 591+2 type argument `T` of `bx` is inferred as both `i64` and `string`;BYN2740 648+3 cannot infer type argument `T` of `fun`;BYN2602 687+15 `i64.parse` can fail; handle the error or pass it on;",
    )
}
