// 019 T29 (coverage ratchet): binder2.byn paths no golden case reaches. Each program is compiled alone as `a.byn` and
// summarised as its diagnostics (`code start+length message`, joined by ` | `); the expected text is the output of the
// self-hosted checker at the commit that added the test.

import lexer

string t29b2Diags(string text, bool library = false) uses alloc, clock, fs {
    var bytes = List<u8>()
    for b in text.bytes {
        bytes.append(b)
    }
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create("a.byn", from: move bytes))
    let c = create(from: move sources, at: ".", by: CompilationOptions { library: library })
    var sb = StrBuf()
    var first = true
    for d in c.diagnostics {
        sb.append(" | ") unless first
        first = false
        sb.append($"{d.code} {d.span.start}+{d.span.length} {d.message}")
    }
    return $"{sb.finish()}"
}

bool t29b2Is(string text, as string expected, bool library = false) uses alloc, clock, console, fs {
    let got = t29b2Diags(text, library: library)
    if got != expected {
        print($"T29GOT {got}")
    }
    return got == expected || expected == "?"
}

test "binder2 t29: @unobservable on every statement kind" {
    let text = """
            union error E {
                bad
            }

            i64 next() => 1

            i64 f(i64 x) fails E {
                var n = x
                @unobservable
                {
                    n += 1
                }
                @unobservable
                n++
                @unobservable(1 + 2)
                n += 1
                @unobservable
                unless n > 3 {
                    n += 1
                }
                @unobservable
                while n < 10 {
                    @unobservable
                    n += 1
                    @unobservable
                    break
                }
                @unobservable
                do {
                    n += 1
                    @unobservable
                    continue
                } while (n < 20)
                @unobservable
                while let k = next() {
                    break
                }
                @unobservable
                outer: for i in 0..3 {
                    break outer
                }
                @unobservable
                switch n {
                    case 1: n += 1
                    default: n += 2
                }
                @unobservable
                defer {
                    print("d")
                }
                @unobservable
                assert n > 0
                @unobservable
                ;
                @unobservable
                fail .bad if n > 100
                return n
            }
            """
    assert t29b2Is(text, as: "?")
}

test "binder2 t29: writable dyn ref loops over borrowed and owned places" {
    let text = """
            interface IC {
                void bump(ref this)
                i64 n
            }
            struct C : IC {
                i64 n
                void bump(ref this) { n += 1 }
            }
            struct W {
                List<C> items
                i64 k
            }
            union error E {
                bad
            }
            List<C> make() fails E => List<C>()
            void t1(List<C> a, i64 n) {
                for x: dyn ref IC in (n switch { 1 => a, _ => a }) { x.bump() }
            }
            void t2(List<C> a) {
                for x: dyn ref IC in a.copy() { x.bump() }
            }
            void t3(List<C> a) {
                let t = (a, 1)
                for x: dyn ref IC in t.item1 { x.bump() }
            }
            void t4(W w) {
                for x: dyn ref IC in (w with { items: List<C>() }).items { x.bump() }
            }
            void t5(List<C> a) {
                for x: dyn ref IC in (make() catch a) { x.bump() }
            }
            void t6(List<C> a) fails E {
                for x: dyn ref IC in try make() { x.bump() }
            }
            void t7(List<C>? a) {
                for x: dyn ref IC in a ?? List<C>() { x.bump() }
            }
            """
    assert t29b2Is(text, as: "?")
}

test "binder2 t29: exit codes, assert fails, labels, consts and using" {
    let text = """
            i64 seven() => 7

            union error ConfigError {
                @exitCode(n: 3)
                named
                @exitCode(nope)
                unknown
                @exitCode(seven())
                call
                @exitCode(-1)
                negative
            }

            union error ParseError {
                empty
            }

            i64 f(string s) fails ParseError {
                fail .empty if s.isEmpty
                return 1
            }

            void v() {
            }

            struct unique Box {
                List<i64> items
            }

            void g(i64 n) {
                assert (f("")) fails ParseError.empty
                assert 5 fails ParseError
                assert missing() fails ParseError
                assert f("") fails 5
                assert f("") fails ParseError.empy
                outer: for i in 0..3 {
                    outer: for j in 0..3 {
                        break
                    }
                }
                const k = seven()
                const m: i64
                let w = v()
                let p = panic("x")
                using u = n
                using z = missing2
                unless true {
                    print("never")
                }
                print("a")
                const bx = Box { items: List<i64>() }
            }
            """
    assert t29b2Is(text, as: "?")
}
