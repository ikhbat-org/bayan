// 019 T29 (coverage ratchet): json.byn paths no golden case reaches: a program named after a directory `main`, file names
// without a dot, trailing separators, and a fix on a diagnostic with no file. The expected values are the output of the
// self-hosted checker at the commit that added the test.

test "json t29: program names and path pieces" {
    Io.createDirectory("tmp/t29s1-json") catch {}
    Io.createDirectory("tmp/t29s1-json/main") catch {}
    var c = t26EmptyCtx()
    assert programName(ref c, for: "tmp/t29s1-json/main") == "main"
    assert programName(ref c, for: "tmp/t29s1-json/main/main.byn") == "main"
    assert t26FileNameWithoutExtension("a/b") == "b"
    // the host's separator, `\` on Windows, is the one trimmed
    let ab = Path.combine("a", "b")
    let separator = ab[1..2]
    assert t26TrimEndSlash($"{ab}{separator}{separator}") == ab
    assert t26TrimEndSlash("") == ""
}

test "json t29: a fix on a diagnostic with no file is left out" {
    let c = t26EmptyCtx()
    let d = Diag {
        code: "BYN0000",
        span: TextSpan { start: 0, length: 0 },
        message: "m",
        hasFix: true,
        fixSpan: TextSpan { start: 0, length: 0 },
        fixReplacement: "x",
        related: List<Related>(),
    }
    let expected = """
        {"code":"BYN0000","severity":"error","file":null,"span":null,"message":"m","label":null,"help":null,"fixes":[]}
        """
    assert t26DiagnosticJson(in c, for: in d) == expected
}
