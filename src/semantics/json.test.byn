// DiagJsonTests.cs:21 `ADiagnosticWithoutALocationHasNullFileAndSpan` (019 T30f part 4): a diagnostic with no file renders
// `file` and `span` as JSON null; the expected line is the C# test's literal.

test "diag json: a diagnostic without a location has null file and span" {
    let c = Ctx { files: List<SourceFile>(), modules: List<Mod>(), diagnostics: List<Diag>(), bags: List<DiagBag>() }
    let d = Diag {
        code: "BYN0000",
        span: TextSpan { start: 0, length: 0 },
        message: "m",
        isNote: true,
        fixSpan: TextSpan { start: 0, length: 0 },
        related: List<Related>(),
    }
    let expected = """
        {"code":"BYN0000","severity":"note","file":null,"span":null,"message":"m","label":null,"help":null,"fixes":[]}
        """
    assert t26DiagnosticJson(in c, for: in d) == expected
}
