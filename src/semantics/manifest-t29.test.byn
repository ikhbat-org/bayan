// 019 T29 (coverage ratchet): manifest.byn paths no golden case reaches: lexer errors, text after `Package { … }`,
// fields of the wrong kind or given twice, bad lists and names, and the string escapes and digits the reader decodes.
// The expected values are the output of the self-hosted checker at the commit that added the test.

/// The diagnostics of manifest `m`, one `code message` line each.
string t29s2bManifestDiags(Manifest m) uses alloc {
    var sb = StrBuf()
    for d in m.diagnostics {
        sb.append($"{d.code} {d.message}\n")
    }
    return sb.finish()
}

/// The diagnostic codes of manifest `m`, each followed by a space.
string t29s2bManifestCodes(Manifest m) uses alloc {
    var sb = StrBuf()
    for d in m.diagnostics {
        sb.append($"{d.code} ")
    }
    return sb.finish()
}

test "manifest t29: a lexer error" {
    let m = grammarDictParse("Package { name: \"local/a\", version: \"0.1.0\" } \"open\n")
    assert t29s2bManifestDiags(in m) == "BYN0003 unterminated string literal\n"
}

test "manifest t29: text after the package" {
    let m = grammarDictParse("Package { name: \"local/a\", version: \"0.1.0\" } 1\n")
    assert t29s2bManifestDiags(
        in m,
    ) == "BYN3100 `package.byn` is data only: expected the end of the file after `Package { … }`\n"
}

test "manifest t29: fields of the wrong kind" {
    let m = grammarDictParse(
        "Package { name: 1, version: \"0.1.0\", capabilities: 1, dist: 1, style: Style { booleans: .symbols, primitives: .sized } }\n",
    )
    assert t29s2bManifestCodes(in m) == "BYN3102 BYN3102 BYN3102 "
    assert m.booleans == .symbols && m.primitives == .sized
}

test "manifest t29: a field given twice" {
    let m = grammarDictParse("Package { name: \"local/a\", name: \"local/b\", version: \"0.1.0\" }\n")
    assert t29s2bManifestDiags(in m) == "BYN3100 `package.byn` is data only: expected `name` only once\n"
}

test "manifest t29: a field name that is not a name" {
    let m = grammarDictParse("Package { 1: 2 }\n")
    assert t29s2bManifestDiags(in m) == "BYN3100 `package.byn` is data only: expected `field: value` or `}`\n"
}

test "manifest t29: a list without commas" {
    let m = grammarDictParse("Package { name: \"local/a\", version: \"0.1.0\", capabilities: [.fs .net] }\n")
    assert t29s2bManifestDiags(in m) == "BYN3100 `package.byn` is data only: expected `,` or `]`\n"
}

test "manifest t29: an equals sign and then a bad value" {
    let m = grammarDictParse("Package { name = \"local/a\", version: . }\n")
    assert t29s2bManifestDiags(in m) == "BYN3104 `package.byn` uses `field: value`\n"
}

test "manifest t29: a bare word value" {
    let m = grammarDictParse("Package { name: local, version: \"0.1.0\" }\n")
    assert t29s2bManifestCodes(in m) == "BYN3100 "
}

test "manifest t29: string escapes" {
    assert t10DecodeString("\"a\\nb\\rc\\td\\0e\\\\f\\\"g\\'h\"".bytes) == "a\nb\rc\td\0e\\f\"g'h"
    assert t10DecodeString("\"\\u{41}\\u{e9}\\u{20AC}\\u{1F600}\"".bytes) == "Aé€😀"
    assert t10DecodeString("\"\\u{fF}\\u{00000041}\"".bytes) == "ÿA"
    let kept = "\\q\\u{zz}\\u{110000}\\u{D800}\\u{123456789}\\u{}\\u41"
    assert t10DecodeString($"\"{kept}\"".bytes) == kept
}

test "manifest t29: digits" {
    assert t10ParseLong("1_000".bytes) == 1000
    assert t10ParseLong("12a".bytes) is null
    assert t10ParseLong("_".bytes) is null
}
