// DiagnosticRendererTests.cs at widths 26 and 40 (019 T27): the C# builds these diagnostics by hand, which no CLI run does, so
// these render them through `render` at that width.

import lexer
import parser

/// DiagnosticRendererTests.cs:26 `Find` and `DiagnosticRenderer.Render(diagnostic, includePath: false, Style.Plain with { Width = width })`
/// of `d` in `text`, the one file `a.byn`.
string t27Render(string text, for move Diag d, by i64 width) uses alloc, clock, fs {
    var bytes = List<u8>()
    for b in text.bytes {
        bytes.append(b)
    }
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create("a.byn", from: move bytes))
    let c = create(from: move sources, at: ".", by: CompilationOptions {})
    var at: i64 = -1
    for i in 0..c.files.length {
        at = i if c.files[i].path == "a.byn"
    }
    var diag = move d
    diag.file = at
    return render(in c, for: diag, by: false, through: t26Symbols(ascii: false, width: width))
}

/// The span of the first `needle` in `text`, as `Find` gives it.
TextSpan t27Find(string text, for string needle) {
    let t = text.bytes
    let n = needle.bytes
    for i in 0..t.length - n.length + 1 {
        var same = true
        for j in 0..n.length {
            same = same && t[i + j] == n[j]
        }
        return TextSpan { start: i, length: n.length } if same
    }
    return TextSpan { start: -1, length: 0 }
}

/// `rendered.Split('\n')`.
List<string> t27Split(string rendered) uses alloc {
    let t = rendered.bytes
    var lines = List<string>()
    var from: i64 = 0
    for i in 0..t.length {
        if t[i] == 0x0A {
            lines.append(rendered[from..i])
            from = i + 1
        }
    }
    lines.append(rendered[from..t.length])
    return lines
}

// DiagnosticRendererTests.cs:263-280 `LongMessageAndLabelWrapAtTheStyleWidth`, its expected text as the C# writes it.
test "renderer: a long message and label wrap at the style width" {
    let text = "let x = 1\n"
    let d = Diag {
        code: "BYN2000",
        span: t27Find(text, for: "x"),
        message: "one two three four five six",
        label: "alpha beta gamma delta",
        fixSpan: TextSpan { start: 0, length: 0 },
        related: List<Related>(),
    }
    let expected = "error BYN2000: one two\nthree four five six\n\n  1 │ let x = 1\n    │     ^ alpha beta\n    │       gamma delta\n"
    assert t27Render(text, for: move d, by: 26) == expected
}

// DiagnosticRendererTests.cs:282-291 `BacktickedCodeInAMessageIsNeverSplit`.
test "renderer: backticked code in a message is never split" {
    let text = "let x = 1\n"
    let type = "`(string alpha, string bravo, string charlie, i64 delta)`"
    let d = Diag {
        code: "BYN2000",
        span: t27Find(text, for: "x"),
        message: $"expected `i64`, found {type} here",
        fixSpan: TextSpan { start: 0, length: 0 },
        related: List<Related>(),
    }
    let rendered = t27Split(t27Render(text, for: move d, by: 40))
    assert rendered[0] == "error BYN2000: expected `i64`, found"
    assert rendered[1] == type
    assert rendered[2] == "here"
}

// DiagnosticRendererTests.cs:293-304 `SourceAndFixLinesNeverWrap`.
test "renderer: source and fix lines never wrap" {
    var code = "let x = 1"
    for n in 2..=60 {
        code = $"{code} + {n}"
    }
    let text = $"{code}\n"
    let d = Diag {
        code: "BYN2000",
        span: t27Find(text, for: "x"),
        message: "m",
        hasFix: true,
        fixSpan: t27Find(text, for: "let"),
        fixReplacement: "var",
        related: List<Related>(),
    }
    let rendered = t27Split(t27Render(text, for: move d, by: 40))
    assert rendered[2] == $"  1 │ {code}"
    assert rendered[5] == $"    │ 1 │ var{code[3..code.length]}"
}

// SelfhostSemanticsT2Tests.cs (009 T2, 019 T30e): the T2 driver modes as blocks. The expected values are what the frozen C#
// code paths the C# test calls (`DiagnosticRenderer.RenderAll`, `DiagnosticBag.RemoveRepeats`, `DiagnosticDescriptor.Format`)
// return for the same inputs.

/// SelfhostSemanticsT2Tests.cs:89 `makeFile`.
SourceFile t2File(string display, by string text) uses alloc {
    let empty = List<u8>()
    let source = lexer.SourceText.create("<t2>", from: move empty)
    var p = parser.Parser.create(lexer.lex(move source, by: lexer.Keywords.build()))
    let unit = parser.parseCompilationUnit(ref p)
    var textBytes = List<u8>()
    for b in text.bytes {
        textBytes.append(b)
    }
    return SourceFile {
        path: display,
        displayPath: display,
        text: move textBytes,
        unit: move unit,
        imports: Map<string, i64>(),
    }
}

/// SelfhostSemanticsT2Tests.cs:141 `emptyCtx`.
Ctx t2Ctx() uses alloc {
    return Ctx { files: List<SourceFile>(), modules: List<Mod>(), diagnostics: List<Diag>(), bags: List<DiagBag>() }
}

/// SelfhostSemanticsT2Tests.cs:167-171, the `==T2Q==` query: the omitted count, then the rendered text.
string t2Render(Ctx c, by bool includePath, until i64 errorLimit) uses alloc {
    var omitted: i64 = 0
    let rendered = renderAll(in c, from: in c.diagnostics, by: includePath, until: errorLimit, to: ref omitted)
    return $"omitted {omitted}\n{rendered}"
}

/// SelfhostSemanticsT2Tests.cs:199 `noArgs`.
(string a0, string a1, string a2, string a3, string a4) t2NoArgs() => (a0: "", a1: "", a2: "", a3: "", a4: "")

// SelfhostSemanticsT2Tests.cs:477 `EveryDiagCaseRendersLikeCSharp`, the hand-built lists at :491-543 (the golden cases are
// the diag goldens' own run); expected values are `DiagnosticRenderer.RenderAll(list, includePath: true)` with 0 omitted.
test "diag t2: hand-built lists render like the C# renderer" {
    // multi
    var c1 = t2Ctx()
    c1.files.append(t2File("b.byn", by: "let y = 2\n"))
    c1.files.append(t2File("a.byn", by: "let x = 1\n"))
    c1.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 4, length: 1 },
            message: "`y` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c1.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 1,
            span: TextSpan { start: 4, length: 1 },
            message: "`x` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    let expected1 = """
        omitted 0
        error BYN2001: `x` is not defined
          --> a.byn:1:5

          1 │ let x = 1
            │     ^

        error BYN2001: `y` is not defined
          --> b.byn:1:5

          1 │ let y = 2
            │     ^

        """
    assert t2Render(c1, by: true, until: 2147483647) == expected1

    // prefix
    var c2 = t2Ctx()
    c2.files.append(t2File("b/x.byn", by: "let bx = 1\n"))
    c2.files.append(t2File("a/y.byn", by: "let ay = 1\n"))
    c2.files.append(t2File("a/x.byn", by: "let ax = 1\n"))
    c2.files.append(t2File("ab.byn", by: "let ab = 1\n"))
    c2.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 4, length: 2 },
            message: "`bx` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 1,
            span: TextSpan { start: 4, length: 2 },
            message: "`ay` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 2,
            span: TextSpan { start: 4, length: 2 },
            message: "`ax` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 3,
            span: TextSpan { start: 4, length: 2 },
            message: "`ab` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    let expected2 = """
        omitted 0
        error BYN2001: `ax` is not defined
          --> a/x.byn:1:5

          1 │ let ax = 1
            │     ^^

        error BYN2001: `ay` is not defined
          --> a/y.byn:1:5

          1 │ let ay = 1
            │     ^^

        error BYN2001: `ab` is not defined
          --> ab.byn:1:5

          1 │ let ab = 1
            │     ^^

        error BYN2001: `bx` is not defined
          --> b/x.byn:1:5

          1 │ let bx = 1
            │     ^^

        """
    assert t2Render(c2, by: true, until: 2147483647) == expected2

    // unicode
    var c3 = t2Ctx()
    c3.files.append(t2File("u.byn", by: "\tlet s = \"ஂ𐀀\u{1}é\"\n"))
    c3.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 10, length: 3 },
            message: "`s` is not defined",
            label: "label `in code`",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c3.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 20, length: 3 },
            message: "`p` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    let expected3 = "omitted 0\nerror BYN2001: `s` is not defined\n  --> u.byn:1:11\n\n  1 │ \tlet s = \"ஂ𐀀�é\"\n    │ \t         ^ label `in code`\n\nerror BYN2001: `p` is not defined\n  --> u.byn:1:15\n\n  1 │ \tlet s = \"ஂ𐀀�é\"\n    │ \t             ^\n"
    assert t2Render(c3, by: true, until: 2147483647) == expected3

    // synthetic
    var c4 = t2Ctx()
    c4.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: -1,
            span: TextSpan { start: 0, length: 0 },
            message: "`x` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c4.diagnostics.append(
        Diag {
            code: "BYN2002",
            file: -1,
            span: TextSpan { start: 3, length: 2 },
            message: "unknown type `y`",
            isWarning: true,
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c4.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: -1,
            span: TextSpan { start: 0, length: 0 },
            message: "`a` is not defined and this message is long enough that it must wrap onto the second and third lines so that the first line's narrower width is compared against the rest width",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    let expected4 = """
        omitted 0
        error BYN2001: `x` is not defined

        error BYN2001: `a` is not defined and this message is long enough that it must wrap onto the second
        and third lines so that the first line's narrower width is compared against the rest width

        warning BYN2002: unknown type `y`

        """
    assert t2Render(c4, by: true, until: 2147483647) == expected4
}

// SelfhostSemanticsT2Tests.cs:557 `ErrorLimitCapsErrorsNotWarnings`: the first three v0.3.2 diag cases with an error and a
// warning at limits 0, 1, 2 and `int.MaxValue`; expected values are the C# `RenderAll(items, includePath, Style.Plain, limit,
// out omitted)`.
test "diag t2: the error limit caps errors, not warnings" {
    // diag/clause-order-uses-fix.byn includePath False
    var c1 = t2Ctx()
    c1.files.append(
        t2File(
            "clause-order-uses-fix.byn",
            by: "union error E {\n    a\n}\npublic void log(i64 n) expects n > 0 fails E {\n    print(\"log\")\n}\n",
        ),
    )
    c1.diagnostics.append(
        Diag {
            code: "BYN5011",
            file: 0,
            span: TextSpan { start: 47, length: 7 },
            message: "this `expects` reads only `n`; a type with `requires` checks it once",
            help: "declare a type with `requires` for `n`",
            isWarning: true,
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c1.diagnostics.append(
        Diag {
            code: "BYN6002",
            file: 0,
            span: TextSpan { start: 75, length: 12 },
            message: "`log` uses `console` but does not declare it",
            label: "uses `console`",
            help: "add `console` to the `uses` clause, or remove the call",
            hasFix: true,
            fixReplacement: " uses console",
            fixSpan: TextSpan { start: 60, length: 0 },
            related: List<Related>(),
        },
    )
    let case1Limit0 = """
        omitted 1
        warning BYN5011: this `expects` reads only `n`; a type with `requires` checks it once

          4 │ public void log(i64 n) expects n > 0 fails E {
            │                        ^^^^^^^
            │
          help: declare a type with `requires` for `n`

        """
    assert t2Render(c1, by: false, until: 0) == case1Limit0
    let case1Limit1 = """
        omitted 0
        warning BYN5011: this `expects` reads only `n`; a type with `requires` checks it once

          4 │ public void log(i64 n) expects n > 0 fails E {
            │                        ^^^^^^^
            │
          help: declare a type with `requires` for `n`

        error BYN6002: `log` uses `console` but does not declare it

          5 │     print("log")
            │     ^^^^^^^^^^^^ uses `console`
            │
          help: add `console` to the `uses` clause, or remove the call
            │ 4 │ public void log(i64 n) expects n > 0 uses console fails E {
            │   │                                     +++++++++++++

        """
    assert t2Render(c1, by: false, until: 1) == case1Limit1
    let case1Limit2 = """
        omitted 0
        warning BYN5011: this `expects` reads only `n`; a type with `requires` checks it once

          4 │ public void log(i64 n) expects n > 0 fails E {
            │                        ^^^^^^^
            │
          help: declare a type with `requires` for `n`

        error BYN6002: `log` uses `console` but does not declare it

          5 │     print("log")
            │     ^^^^^^^^^^^^ uses `console`
            │
          help: add `console` to the `uses` clause, or remove the call
            │ 4 │ public void log(i64 n) expects n > 0 uses console fails E {
            │   │                                     +++++++++++++

        """
    assert t2Render(c1, by: false, until: 2) == case1Limit2
    let case1LimitMax = """
        omitted 0
        warning BYN5011: this `expects` reads only `n`; a type with `requires` checks it once

          4 │ public void log(i64 n) expects n > 0 fails E {
            │                        ^^^^^^^
            │
          help: declare a type with `requires` for `n`

        error BYN6002: `log` uses `console` but does not declare it

          5 │     print("log")
            │     ^^^^^^^^^^^^ uses `console`
            │
          help: add `console` to the `uses` clause, or remove the call
            │ 4 │ public void log(i64 n) expects n > 0 uses console fails E {
            │   │                                     +++++++++++++

        """
    assert t2Render(c1, by: false, until: 2147483647) == case1LimitMax

    // diag/generic-guard-mutate-rebind.byn includePath False
    var c2 = t2Ctx()
    c2.files.append(
        t2File(
            "generic-guard-mutate-rebind.byn",
            by: "struct Bag {\n    List<i64> items\n\n    public i64 grow(ref this) uses alloc {\n        this.items.append(1)\n        return this.items.length\n    }\n}\n\nunion Slot {\n    full(Bag b)\n    empty\n}\n\ni64 pick<T>(move Slot s, T v) uses alloc, console {\n    switch move s {\n        case .full(var x) when x.grow() > 5:\n            print(\"call\")\n        default:\n    }\n    return 0\n}\n\nvoid usePick() uses alloc, console {\n    let _ = pick(Slot.empty, 1)\n}\n\nvoid take(u8 x) {}\n\nvoid rebound() {\n    let k = Bag { items: List<i64>() }\n    var v = 5\n    let _ = k.grow()\n    take(v)\n}\n",
        ),
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN5004",
            file: 0,
            span: TextSpan { start: 194, length: 4 },
            message: "`pick` has 2 unlabeled parameters; give each but one a particle",
            label: "2 unlabeled parameters",
            help: "keep one unlabeled parameter, the object",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN5006",
            file: 0,
            span: TextSpan { start: 217, length: 1 },
            message: "`v` is a required parameter besides the object and needs a particle",
            label: "needs a particle",
            help: "label it with `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2791",
            file: 0,
            span: TextSpan { start: 293, length: 1 },
            message: "`x` is mutated in the guard of `switch move …`; a guard that fails gives the value back",
            label: "`grow` modifies it",
            help: "read it in the guard and change it in the arm's body",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2104",
            file: 0,
            span: TextSpan { start: 546, length: 1 },
            message: "`k` is immutable",
            label: "`grow` modifies it; declared with `let` on line 31",
            help: "declare it with `var` if it should change",
            hasFix: true,
            fixReplacement: "var",
            fixSpan: TextSpan { start: 485, length: 3 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2791",
            file: 0,
            span: TextSpan { start: 293, length: 1 },
            message: "`x` is mutated in the guard of `switch move …`; a guard that fails gives the value back",
            label: "`grow` modifies it",
            help: "read it in the guard and change it in the arm's body",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c2.diagnostics.append(
        Diag {
            code: "BYN2311",
            file: 0,
            span: TextSpan { start: 528, length: 1 },
            message: "`v` is never reassigned; declare it with `let`",
            help: "declare it with `let` to tell the reader the value never changes",
            isWarning: true,
            hasFix: true,
            fixReplacement: "let",
            fixSpan: TextSpan { start: 524, length: 3 },
            related: List<Related>(),
        },
    )
    let case2Limit0 = """
        omitted 5
        warning BYN2311: `v` is never reassigned; declare it with `let`

          32 │     var v = 5
             │         ^
             │
          help: declare it with `let` to tell the reader the value never changes
             │ 32 │     let v = 5
             │    │     +++

        """
    assert t2Render(c2, by: false, until: 0) == case2Limit0
    let case2Limit1 = """
        omitted 4
        error BYN5004: `pick` has 2 unlabeled parameters; give each but one a particle

          15 │ i64 pick<T>(move Slot s, T v) uses alloc, console {
             │     ^^^^ 2 unlabeled parameters
             │
          help: keep one unlabeled parameter, the object

        warning BYN2311: `v` is never reassigned; declare it with `let`

          32 │     var v = 5
             │         ^
             │
          help: declare it with `let` to tell the reader the value never changes
             │ 32 │     let v = 5
             │    │     +++

        """
    assert t2Render(c2, by: false, until: 1) == case2Limit1
    let case2Limit2 = """
        omitted 3
        error BYN5004: `pick` has 2 unlabeled parameters; give each but one a particle

          15 │ i64 pick<T>(move Slot s, T v) uses alloc, console {
             │     ^^^^ 2 unlabeled parameters
             │
          help: keep one unlabeled parameter, the object

        error BYN5006: `v` is a required parameter besides the object and needs a particle

          15 │ i64 pick<T>(move Slot s, T v) uses alloc, console {
             │                            ^ needs a particle
             │
          help: label it with `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`

        warning BYN2311: `v` is never reassigned; declare it with `let`

          32 │     var v = 5
             │         ^
             │
          help: declare it with `let` to tell the reader the value never changes
             │ 32 │     let v = 5
             │    │     +++

        """
    assert t2Render(c2, by: false, until: 2) == case2Limit2
    let case2LimitMax = """
        omitted 0
        error BYN5004: `pick` has 2 unlabeled parameters; give each but one a particle

          15 │ i64 pick<T>(move Slot s, T v) uses alloc, console {
             │     ^^^^ 2 unlabeled parameters
             │
          help: keep one unlabeled parameter, the object

        error BYN5006: `v` is a required parameter besides the object and needs a particle

          15 │ i64 pick<T>(move Slot s, T v) uses alloc, console {
             │                            ^ needs a particle
             │
          help: label it with `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`

        error BYN2791: `x` is mutated in the guard of `switch move …`; a guard that fails gives the value
        back

          17 │         case .full(var x) when x.grow() > 5:
             │                                ^ `grow` modifies it
             │
          help: read it in the guard and change it in the arm's body

        error BYN2791: `x` is mutated in the guard of `switch move …`; a guard that fails gives the value
        back

          17 │         case .full(var x) when x.grow() > 5:
             │                                ^ `grow` modifies it
             │
          help: read it in the guard and change it in the arm's body

        warning BYN2311: `v` is never reassigned; declare it with `let`

          32 │     var v = 5
             │         ^
             │
          help: declare it with `let` to tell the reader the value never changes
             │ 32 │     let v = 5
             │    │     +++

        error BYN2104: `k` is immutable

          33 │     let _ = k.grow()
             │             ^ `grow` modifies it; declared with `let` on line 31
             │
          help: declare it with `var` if it should change
             │ 31 │     var k = Bag { items: List<i64>() }
             │    │     +++

        """
    assert t2Render(c2, by: false, until: 2147483647) == case2LimitMax

    // diag/grammar-dictionary/main.byn includePath True
    var c3 = t2Ctx()
    c3.files.append(
        t2File(
            "main.byn",
            by: "struct Catalog {\n    i64 count\n\n    void upsertRow(ref this) {\n        count += 1\n    }\n\n    i64 skuCount => count\n\n    bool isIdempotent => true\n\n    // `forms` gives the irregular `-ed` spelling, so this member changes `this` under an `-ed` name.\n    void reground(ref this) {\n        count += 1\n    }\n\n    i64 kycLevel => 0\n}\n\nprint(\"ok\")\n",
        ),
    )
    c3.diagnostics.append(
        Diag {
            code: "BYN5001",
            file: 0,
            span: TextSpan { start: 258, length: 8 },
            message: "`reground` changes `this`; name it `regrind`",
            help: "name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c3.diagnostics.append(
        Diag {
            code: "BYN5014",
            file: 0,
            span: TextSpan { start: 313, length: 3 },
            message: "`kyc` is not a known verb, noun or adjective",
            help: "add it to `grammar` in package.byn: `nouns: [\"kyc\"]`, `verbs: [\"kyc\"]` or `adjectives: [\"kyc\"]`",
            isWarning: true,
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    let case3Limit0 = """
        omitted 1
        warning BYN5014: `kyc` is not a known verb, noun or adjective
          --> main.byn:17:9

          17 │     i64 kycLevel => 0
             │         ^^^
             │
          help: add it to `grammar` in package.byn: `nouns: ["kyc"]`, `verbs: ["kyc"]` or
                `adjectives: ["kyc"]`

        """
    assert t2Render(c3, by: true, until: 0) == case3Limit0
    let case3Limit1 = """
        omitted 0
        error BYN5001: `reground` changes `this`; name it `regrind`
          --> main.byn:13:10

          13 │     void reground(ref this) {
             │          ^^^^^^^^
             │
          help: name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view

        warning BYN5014: `kyc` is not a known verb, noun or adjective
          --> main.byn:17:9

          17 │     i64 kycLevel => 0
             │         ^^^
             │
          help: add it to `grammar` in package.byn: `nouns: ["kyc"]`, `verbs: ["kyc"]` or
                `adjectives: ["kyc"]`

        """
    assert t2Render(c3, by: true, until: 1) == case3Limit1
    let case3Limit2 = """
        omitted 0
        error BYN5001: `reground` changes `this`; name it `regrind`
          --> main.byn:13:10

          13 │     void reground(ref this) {
             │          ^^^^^^^^
             │
          help: name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view

        warning BYN5014: `kyc` is not a known verb, noun or adjective
          --> main.byn:17:9

          17 │     i64 kycLevel => 0
             │         ^^^
             │
          help: add it to `grammar` in package.byn: `nouns: ["kyc"]`, `verbs: ["kyc"]` or
                `adjectives: ["kyc"]`

        """
    assert t2Render(c3, by: true, until: 2) == case3Limit2
    let case3LimitMax = """
        omitted 0
        error BYN5001: `reground` changes `this`; name it `regrind`
          --> main.byn:13:10

          13 │     void reground(ref this) {
             │          ^^^^^^^^
             │
          help: name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view

        warning BYN5014: `kyc` is not a known verb, noun or adjective
          --> main.byn:17:9

          17 │     i64 kycLevel => 0
             │         ^^^
             │
          help: add it to `grammar` in package.byn: `nouns: ["kyc"]`, `verbs: ["kyc"]` or
                `adjectives: ["kyc"]`

        """
    assert t2Render(c3, by: true, until: 2147483647) == case3LimitMax
}

// SelfhostSemanticsT2Tests.cs:600 `RemoveRepeatsMatchesCSharp`, input at :605-617; expected value is `DiagnosticBag.RemoveRepeats`
// on the same list, printed as at :629-631.
test "diag t2: removeRepeats keeps the first of each group" {
    var c = t2Ctx()
    c.files.append(t2File("a.byn", by: "let a = 1\n"))
    c.files.append(t2File("b.byn", by: "let a = 1\n"))
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 0, length: 3 },
            message: "`a` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 0, length: 3 },
            message: "`a` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2002",
            file: 0,
            span: TextSpan { start: 0, length: 3 },
            message: "`a` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 1,
            span: TextSpan { start: 0, length: 3 },
            message: "`a` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 0, length: 4 },
            message: "`a` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 1, length: 2 },
            message: "`a` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 0, length: 3 },
            message: "`b` is not defined",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: 0,
            span: TextSpan { start: 0, length: 3 },
            message: "`a` is not defined",
            isWarning: true,
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: -1,
            span: TextSpan { start: 0, length: 3 },
            message: "no source",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    c.diagnostics.append(
        Diag {
            code: "BYN2001",
            file: -1,
            span: TextSpan { start: 0, length: 3 },
            message: "no source",
            fixSpan: TextSpan { start: 0, length: 0 },
            related: List<Related>(),
        },
    )
    let expected = """
        BYN2001|0|0|3|`a` is not defined
        BYN2002|0|0|3|`a` is not defined
        BYN2001|1|0|3|`a` is not defined
        BYN2001|0|0|4|`a` is not defined
        BYN2001|0|1|2|`a` is not defined
        BYN2001|0|0|3|`b` is not defined
        BYN2001|-1|0|3|no source
        ==T2N== 7

        """
    removeRepeats(ref c)
    var sb = StrBuf()
    for d in c.diagnostics {
        sb.append($"{d.code}|{d.file}|{d.span.start}|{d.span.length}|{d.message}\n")
    }
    sb.append($"==T2N== {c.diagnostics.length}\n")
    assert sb.finish() == expected
}

// SelfhostSemanticsT2Tests.cs:637 `ReportBuildsTheDiag`, driver at :234-249; expected value is `RenderAll(items, includePath: true)`
// of the items at :643-648, then `==T2R== 3 0`.
test "diag t2: report builds the diag" {
    var c = t2Ctx()
    c.files.append(t2File("r.byn", by: "let total = 0\nlet count = 1\n"))
    report(
        ref c,
        for: .undefinedName,
        from: 0,
        at: TextSpan { start: 4, length: 5 },
        by: (a0: "total", a1: "", a2: "", a3: "", a4: ""),
        label: "not in scope",
        help: "declare it first",
    )
    report(ref c, for: .unreachableCode, from: 0, at: TextSpan { start: 4, length: 5 }, by: t2NoArgs())
    report(
        ref c,
        for: .undefinedName,
        from: 0,
        at: TextSpan { start: 18, length: 5 },
        by: t2NoArgs(),
        label: "here",
        hasFix: true,
        fixSpan: TextSpan { start: 18, length: 5 },
        fixReplacement: "value",
    )
    var omitted: i64 = 0
    let text = renderAll(in c, from: in c.diagnostics, by: true, until: 1000, to: ref omitted)
    let expected = """
        error BYN2001: `total` is not defined
          --> r.byn:1:5

          1 │ let total = 0
            │     ^^^^^ not in scope
            │
          help: declare it first

        warning BYN2405: unreachable code
          --> r.byn:1:5

          1 │ let total = 0
            │     ^^^^^

        error BYN2001: `` is not defined
          --> r.byn:2:5

          2 │ let count = 1
            │     ^^^^^ here
            │
            │ 2 │ let value = 1
            │   │     +++++
        ==T2R== 3 0

        """
    assert $"{text}==T2R== {c.diagnostics.length} {omitted}\n" == expected
}

// SelfhostSemanticsT2Tests.cs:655 `SinkGoesToTheInnermostBag`, driver at :204-230, expected text at :661.
test "diag t2: a report goes to the innermost bag" {
    var c = t2Ctx()
    report(ref c, for: .undefinedName, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    let outer = pushBag(ref c)
    report(ref c, for: .unknownType, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    let inner = pushBag(ref c)
    report(ref c, for: .unknownMember, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    popBag(ref c, to: inner)
    report(ref c, for: .notVisible, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    popBag(ref c, to: outer)
    report(ref c, for: .shadowing, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    c.quiet = true
    report(ref c, for: .duplicateDeclaration, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    c.quiet = false
    report(ref c, for: .importCycle, from: -1, at: TextSpan { start: 0, length: 1 }, by: t2NoArgs())
    var sb = StrBuf()
    sb.append("top")
    for d in c.diagnostics {
        sb.append($" {d.code}")
    }
    sb.append("\n")
    for i in 0..c.bags.length {
        sb.append($"bag{i} {c.bags[i].previous}")
        for d in c.bags[i].items {
            sb.append($" {d.code}")
        }
        sb.append("\n")
    }
    assert sb.finish() == "top BYN2001 BYN2007 BYN2010\nbag0 -1 BYN2002 BYN2005\nbag1 0 BYN2003\n"
}

