// 019 T29 (coverage ratchet): region2.byn's type walks over tuples, unions and optionals, and the fields `ref this`
// methods change through each other, which no golden case reaches. The expected text is the output of the self-hosted code
// at the commit that added the test.

/// The return type of the function `name` in `c`.
Type t29s0ReturnOf(in Ctx c, by string name) {
    for f in c.functions {
        return f.returnType if f.name == name
    }
    return errorType()
}

test "region2 t29: what tuples, unions, optionals and structs may lend and whether they hold a list" {
    let text = "struct P {\n    i64 a\n}\n\nstruct L {\n    List<i64> xs\n}\n\nstruct H {\n    (i64, List<i64>) t\n}\n\nunion U {\n    one(i64 a)\n    two(List<i64> xs)\n}\n\nunion V {\n    none\n    some(i64 a)\n}\n\n(i64, i64) f1() => todo(\"f1\")\n(i64, string) f2() => todo(\"f2\")\n(i64, List<i64>) f3() => todo(\"f3\")\nU f4() => todo(\"f4\")\nV f5() => todo(\"f5\")\nP f6() => todo(\"f6\")\nList<i64>? f7() => todo(\"f7\")\nL f8() => todo(\"f8\")\nH f9() => todo(\"f9\")\ni64? f10() => todo(\"f10\")\nUntrusted<List<i64>> f11() => todo(\"f11\")\nResult<List<i64>, E> f12() => todo(\"f12\")\n\nunion error E { bad }\n"
    var c = t29s0Compile(text)
    var sb = StrBuf()
    let names = ["f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12"]
    for name in names {
        let t = t29s0ReturnOf(in c, by: name)
        var seen = List<Type>()
        var seen2 = List<Type>()
        sb.append($"{name} {mayLend(ref c, for: t, by: ref seen)} {containsList(ref c, for: t, by: ref seen2)};")
    }
    assert t29s0Same(
        $"{sb.finish()}",
        as: "f1 false false;f2 true false;f3 true true;f4 true true;f5 false false;f6 false false;f7 true true;f8 true true;f9 true true;f10 false false;f11 true true;f12 true true;",
    )
}

test "region2 t29: `ref this` methods that call each other on `this` share what they change" {
    let text = "struct In {\n    i64 n\n    void bump(ref this) {\n        n += 1\n    }\n}\n\nvoid add(to ref List<i64> xs) {\n    xs.append(1)\n}\n\nstruct Out {\n    In inner\n    List<i64> xs\n    i64 k\n    void start(ref this) {\n        top()\n    }\n    void top(ref this) {\n        go()\n        a()\n    }\n    void a(ref this) {\n        b()\n    }\n    void b(ref this) {\n        k += 1\n        top()\n    }\n    void go(ref this) {\n        inner.bump()\n        add(to: ref xs)\n    }\n}\n\nvoid main() {\n    var o = Out { inner: In { n: 0 }, xs: [], k: 0 }\n    let first = o.xs[0]\n    o.start()\n    print($\"{first}\")\n}\n"
    assert t29s0Same(t29s0Diags(text), as: "")
}

test "region2 t29: text-returning builtins called inside a `provide` block borrow its arena" {
    let text = "void main() uses fs, env, process {\n    using let arena = Arena()\n    let bytes = \"ab\".bytes\n    provide allocator: arena {\n        let a = Io.readText(\"x.txt\") catch { return }\n        let b = Utf8.decode(bytes) catch { return }\n        let d = Utf8.decode(bytes, invalid: .replace)\n        let e = Hex.encode(bytes)\n        let f = Env.get(\"HOME\")\n        let g = Path.relative(\"a/b\", to: \"a\")\n        let h = Path.fileName(\"a/b\")\n        let i = Path.directoryName(\"a/b\")\n        let j = Path.combine(\"a\", \"b\")\n        let k = Path.fullPath(\"a\")\n        let m = Fs.realPath(\"a\") catch { return }\n        print($\"{a}{b}{d}{e}{f}{g}{h}{i}{j}{k}{m}\")\n    }\n}\n"
    assert t29s0Same(t29s0Diags(text), as: "")
}

test "region2 t29: a struct or union already being walked holds nothing more, and a string field lends" {
    let text = "struct S {\n    string s\n}\n\nunion W {\n    one(string s)\n}\n\nS g1() => todo(\"g1\")\nW g2() => todo(\"g2\")\ni64[2] g3() => todo(\"g3\")\n"
    var c = t29s0Compile(text)
    var sb = StrBuf()
    for name in ["g1", "g2", "g3"] {
        let t = t29s0ReturnOf(in c, by: name)
        var fresh = List<Type>()
        var s1 = List<Type>()
        s1.append(t)
        var s2 = List<Type>()
        s2.append(t)
        var s3 = List<Type>()
        s3.append(t)
        sb.append(
            $"{name} {mayLend(ref c, for: t, by: ref fresh)} {mayBorrow(ref c, for: t, by: ref s1)} {mayLend(ref c, for: t, by: ref s2)} {containsList(ref c, for: t, by: ref s3)};",
        )
    }
    assert t29s0Same(
        $"{sb.finish()}",
        as: "g1 true false false false;g2 true false false false;g3 true false true false;",
    )
}

test "region2 t29: a `ref this` method's changes through locals, repeated fields and by-value `ref` arguments" {
    let text = "struct In {\n    i64 n\n    void bump(ref this) {\n        n += 1\n    }\n}\n\nvoid inc(ref i64 n) {\n    n += 1\n}\n\nvoid add(to ref List<i64> xs) {\n    xs.append(1)\n}\n\nstruct Out {\n    In inner\n    List<i64> xs\n    i64 k\n    void go(ref this) {\n        var other = In { n: 0 }\n        other.bump()\n        inner.bump()\n        inner.bump()\n        inc(ref k)\n        add(to: ref xs)\n        add(to: ref xs)\n    }\n    void run(ref this) {\n        for x in xs {\n            go()\n            print($\"{x}\")\n        }\n    }\n}\n\nvoid main() {\n    var o = Out { inner: In { n: 0 }, xs: [], k: 0 }\n    o.run()\n}\n"
    assert t29s0Same(t29s0Diags(text), as: "BYN3004 464+4 `xs` is modified while the `for` loop still borrows it;")
}

test "region2 t29: one list passed by `ref` and again by `ref` or by value" {
    let text = "void two(ref List<i64> a, from ref List<i64> b) {\n    a.append(b.length)\n}\n\nvoid val(ref List<i64> a, from ReadOnlySpan<i64> b) {\n    a.append(b.length)\n}\n\nvoid main() {\n    var xs = List<i64>()\n    two(ref xs, from: ref xs)\n    val(ref xs, from: xs.span)\n}\n"
    assert t29s0Same(
        t29s0Diags(text),
        as: "BYN3005 221+2 `xs` is passed by `ref` and again in the same call;BYN3005 207+2 `xs` is passed by `ref` and again in the same call;BYN3005 247+7 `xs` is passed by `ref` and again in the same call;",
    )
}

test "region2 t29: process, buffer, decode and path builtins inside a `provide` block borrow its arena" {
    let text = "void main() uses fs, process {\n    using let arena = Arena()\n    let bytes = \"ab\".bytes\n    let raw = stackalloc u8[4]\n    let parts = [\"a\", \"b\"]\n    let none = List<string>()\n    provide allocator: arena {\n        let a = Io.run(\"sh\", none.span) catch { return }\n        let b = Io.runBatch(\"./b.cmd\", none.span) catch { return }\n        var d = StrBuf.over(raw)\n        d.append(\"x\")\n        let e = Utf8.tryDecode(bytes) ?? \"\"\n        let f = Path.combine(parts.span)\n        print($\"{a.exitCode}{b.exitCode}{d.finish()}{e}{f}\")\n    }\n}\n"
    assert t29s0Same(t29s0Diags(text), as: "")
}

test "region2 t29: an interface method that writes a `ref` argument may store its receiver into it" {
    let text = "interface IPut {\n    void put(ref List<string> xs) uses alloc\n}\n\nstruct P : IPut {\n    string s\n    void put(ref List<string> xs) {\n        xs.append(s)\n    }\n}\n\nvoid fill(dyn ref IPut p, to ref List<string> xs) {\n    p.put(ref xs)\n}\n\nvoid main() {\n    var p = P { s: \"a\" }\n    var xs = List<string>()\n    fill(p, to: ref xs)\n    print($\"{xs.length}\")\n}\n"
    assert t29s0Same(t29s0Diags(text), as: "")
}
