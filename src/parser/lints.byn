// ── Style lints with one-time fixes (BYN1077–BYN1080) ────────────────────────
// Ports the Parser.cs region of that name. BYN1077 and BYN1079 append to `p.styleLints` as the other style lints do;
// BYN1078 and some BYN1080 sites are typed lints, which the compilation keeps only if their operand binds as `check` asks
// (compile.byn `confirmTypedLints`). The C# parser keeps node references; this one records plain spans and texts when
// a node is built, since a node is read-only once it is in the tree.

// Parser.cs: BannerColumn
const bannerColumn: i64 = 80

/// The C# `TypedLintCheck`: how a typed lint's operand must bind for the compilation to confirm it.
public enum TypedLintCheck {
    patternInteger
    patternRune
    patternString
    patternEnum
    narrowableLocal
}

/// The C# `TypedLint`: a lint the compilation confirms from every binding of the expression at `operand`; if it does not,
/// it adds `otherwise` instead, when set.
public struct TypedLint {
    public Diagnostic     lint
    public TextSpan       operand
    public TypedLintCheck check
    public Diagnostic?    otherwise = null
}

/// The kind of a constant a pattern can hold (the C# `ConstantKind` char): `i`nteger, `c`har (rune), `s`tring or `e`num case.
public enum ConstKind {
    none
    integer
    rune
    string
    enumCase
}

/// One test of a chain (the C# `PatternItem` tuple).
public struct PatternItem {
    public TextSpan  operand
    public string    pattern
    public ConstKind kind
    public bool      range
}

/// An `&&` or `||` (the C# `_logical` entry, with `next`), and what `lintPatterns` reads of it, taken when it is built: for
/// `||`, the items of its flattened terms (`allItems` when every term is one) and the spans of its `&&` terms; for `&&`,
/// its range item, if it is one. `child` is set when it is the left operand of the same operator.
public struct LogicalSite {
    public TextSpan          span
    public BinaryOp          op
    public i64               next
    public bool              child    = false
    public bool              allItems = false
    public List<PatternItem> items    = []
    public List<TextSpan>    ranges   = []
}

/// A `_bindExits` entry: the `if` statement's span, its lint and narrowing lint, the bound name, and whether its hit block
/// has a `defer` or `using` local (`declares`) or any local (`hasLocal`).
public struct BindExit {
    public TextSpan   stmt
    public Diagnostic exit
    public TypedLint? local
    public string     name
    public bool       declares
    public bool       hasLocal
}

/// The operand span and name of `X is { } k`, and whether `X` is a name without type arguments.
public struct OptionalBind {
    public TextSpan value
    public string   name
    public bool     isName
}

bool sameSpan(TextSpan a, as TextSpan b) => a.start == b.start && a.length == b.length

/// A space or tab byte.
bool isIndentByte(u8 b) => b == ' ' || b == '\t'

/// Whether `bytes[at..at+3]` is `─` (U+2500, E2 94 80).
bool isBoxDash(ref Parser p, at i64 at) =>
    at >= 0
    && at + 3 <= p.lexed.source.length
    && p.lexed.source.bytes[at] == 0xE2
    && p.lexed.source.bytes[at + 1] == 0x94
    && p.lexed.source.bytes[at + 2] == 0x80

/// Whether the bytes of `span` hold `\n`.
bool spansLine(ref Parser p, at TextSpan span) {
    for i in span.start..span.end {
        return true if p.lexed.source.bytes[i] == '\n'
    }
    return false
}

/// BYN1077 on a banner comment `// ── Title ──…` whose fill does not end at column 80; the fix refills it.
// Parser.cs: LintBanners
public void lintBanners(ref Parser p) uses alloc {
    let lines = p.lexed.source.getLineIndex(p.lexed.source.length) + 1
    for line in 0..lines {
        let span = p.lexed.source.getLineSpan(line)
        var slash = span.start
        while slash < span.end && isIndentByte(p.lexed.source.bytes[slash]) {
            slash += 1
        }
        // `// ── ` is 10 bytes: `//`, a space, two `─` and a space.
        if slash + 10 > span.end || p.lexed.source.bytes[slash] != '/' || p.lexed.source.bytes[slash + 1] != '/'
                || p.lexed.source.bytes[slash + 2] != ' '
                || !isBoxDash(ref p, at: slash + 3)
                || !isBoxDash(ref p, at: slash + 6)
                || p.lexed.source.bytes[slash + 9] != ' ' {
            continue
        }
        var fill: i64 = 0
        while isBoxDash(ref p, at: span.end - 3 * (fill + 1)) && span.end - 3 * (fill + 1) >= slash + 10 {
            fill += 1
        }
        let titleStart = slash + 10
        let titleEnd = span.end - 3 * fill
        continue if fill == 0 || titleEnd - titleStart < 2 || p.lexed.source.bytes[titleEnd - 1] != ' '
        // The title before its last space has no space of its own at either end, and does not end in `─`.
        continue if isTriviaSpace(p.lexed.source.bytes[titleStart]) || isTriviaSpace(p.lexed.source.bytes[titleEnd - 2])
        continue if isBoxDash(ref p, at: titleEnd - 4)
        // A `//` inside a multi-line string is not a comment.
        let next = tokenAt(ref p, at: slash)
        continue if next > 0 && p.lexed.tokens[next - 1].end > slash
        var columns: i64 = 0
        for i in span.start..span.end {
            if (p.lexed.source.bytes[i] & 0xC0) != 0x80 {
                columns += 1
            }
        }
        let want = bannerColumn - (columns - fill)
        continue if columns == bannerColumn || want < 2
        let fillSpan = TextSpan.fromBounds(titleEnd, until: span.end)
        var dashes = StrBuf()
        for _ in 0..want {
            dashes.append("─")
        }
        reportStyleLint(
            ref p,
            for: "BYN1077",
            at: fillSpan,
            by: $"a banner comment ends at column {columns}; fill it with `─` to column {bannerColumn}",
            label: $"ends at column {columns}",
            help: $"fill it with `─` to column {bannerColumn}",
            fixSpan: fillSpan,
            fixReplacement: $"{dashes.finish()}",
        )
    }
}

// ── BYN1078 conditions.patterns ──────────────────────────────────────────────

/// Records the `&&` or `||` just built, `e`, with the index of the token after it.
// Parser.cs: ParseBinary (its `_logical.Add`)
void noteLogical(ref Parser p, for Expr e) {
    switch e {
        case .binaryExpr(let b):
            noteLogicalBinary(ref p, for: b.value)
        default:
            return
    }
}

void noteLogicalBinary(ref Parser p, for BinaryExpr b) {
    // Parser.cs: LintPatterns (its `children`): the left operand of the same operator is part of this chain.
    if b.left is .binaryExpr(let l) && l.value.op == b.op {
        var i = p.logical.length - 1
        while i >= 0 {
            if p.logical[i].op == b.op && sameSpan(p.logical[i].span, as: l.value.span) {
                p.logical[i].child = true
                break
            }
            i -= 1
        }
    }
    var site = LogicalSite { span: b.span, op: b.op, next: p.pos }
    if b.op == .logicalOr {
        site.allItems = true
        flattenOr(ref p, for: b.left, to: ref site)
        flattenOr(ref p, for: b.right, to: ref site)
    } else {
        let item = binaryPatternItem(ref p, for: b, relational: false)
        if item is not null && item.range {
            site.allItems = true
            site.items.append(item)
        }
    }
    p.logical.append(move site)
}

/// The terms of an `||` chain, as pattern items (Parser.cs: LintPatterns, its `Flatten` and `PatternItem(p, relational: true)`).
void flattenOr(ref Parser p, for Expr x, to ref LogicalSite site) {
    if x is .binaryExpr(let b) && b.value.op == .logicalOr {
        flattenOr(ref p, for: b.value.left, to: ref site)
        flattenOr(ref p, for: b.value.right, to: ref site)
        return
    }
    let item = patternItem(ref p, for: x, relational: true)
    if item is not null {
        site.items.append(item)
    } else {
        site.allItems = false
    }
    let range = andSpan(x)
    if range is not null {
        site.ranges.append(range)
    }
}

/// The span of `x` if it is an `&&`, inside any parentheses.
TextSpan? andSpan(Expr x) {
    switch x {
        case .parenExpr(let paren):
            return andSpan(paren.value.inner)
        case .binaryExpr(let b):
            return b.value.span if b.value.op == .logicalAnd
            return null
        default:
            return null
    }
}

/// BYN1078 on an `||` or `&&` chain that tests one path against constants; the fix writes one `is` pattern.
// Parser.cs: LintPatterns
public void lintPatterns(ref Parser p) uses alloc {
    var consumed = List<TextSpan>()
    for i in 0..p.logical.length {
        continue if p.logical[i].op != .logicalOr || p.logical[i].child || !p.logical[i].allItems
        unless lintPatternChain(ref p, at: i) {
            continue
        }
        for r in p.logical[i].ranges {
            consumed.append(r)
        }
    }
    for i in 0..p.logical.length {
        continue if p.logical[i].op != .logicalAnd || p.logical[i].child || !p.logical[i].allItems
        var taken = false
        for r in consumed {
            if sameSpan(r, as: p.logical[i].span) {
                taken = true
            }
        }
        if !taken {
            let _ = lintPatternChain(ref p, at: i)
        }
    }
}

/// Whether a token of `kind` after a chain ends it, so nothing after it joins the pattern.
bool endsPattern(TokenKind kind) =>
    kind is .closeParen
    or .closeBracket
    or .comma
    or .openBrace
    or .semicolon
    or .closeBrace
    or .endOfFile
    or .ampAmp
    or .barBar

/// Reports BYN1078 on the chain of `p.logical[site]` if its items test one operand with one kind of constant, distinct, and
/// nothing after it joins the pattern.
// Parser.cs: LintPatternChain
bool lintPatternChain(ref Parser p, at i64 site) {
    let next = p.logical[site].next
    let after = p.lexed.tokens[next < p.count - 1 ? next : p.count - 1]
    return false if !after.hasNewlineBefore && !endsPattern(after.kind)
    let count = p.logical[site].items.length
    let operandSpan = p.logical[site].items[0].operand
    let operand = p.lexed.source.getText(operandSpan)
    let kind = p.logical[site].items[0].kind
    var tests: i64 = 0
    var patterns = StrBuf()
    for k in 0..count {
        return false if p.lexed.source.getText(p.logical[site].items[k].operand) != operand
            || p.logical[site].items[k].kind != kind
        for j in 0..k {
            return false if p.logical[site].items[j].pattern == p.logical[site].items[k].pattern
        }
        tests += p.logical[site].items[k].range ? 2 : 1
        if k > 0 {
            patterns.append(" or ")
        }
        patterns.append(p.logical[site].items[k].pattern)
    }
    let check = kind == .integer ? TypedLintCheck.patternInteger : kind == .rune ? TypedLintCheck.patternRune
        : kind == .string ? TypedLintCheck.patternString : TypedLintCheck.patternEnum
    let pattern = $"{operand} is {patterns.finish()}"
    let span = p.logical[site].span
    let lint = styleLintOf(
        "BYN1078",
        at: span,
        by: $"`{operand}` is tested against constants {tests} times; write one pattern",
        label: $"{tests} tests of `{operand}`",
        help: $"write `{pattern}`",
        fixSpan: span,
        fixReplacement: pattern,
    )
    p.typedLints.append(TypedLint { lint: lint, operand: operandSpan, check: check })
    return true
}

/// One test of a chain: `x == C` gives `C`, and `x >= A && x <= B` (A at most B) gives `A..=B`. With `relational` (a term
/// of an `||` chain), `x < C` gives `< C`, and `C > x` gives the same.
// Parser.cs: PatternItem
PatternItem? patternItem(ref Parser p, for Expr e, bool relational = false) {
    switch e {
        case .parenExpr(let paren):
            return patternItem(ref p, for: paren.value.inner, relational: relational)
        case .binaryExpr(let b):
            return binaryPatternItem(ref p, for: b.value, relational: relational)
        default:
            return null
    }
}

PatternItem? binaryPatternItem(ref Parser p, for BinaryExpr b, bool relational) {
    if b.op == .eq && isPathOperand(b.left) {
        let kind = constantKind(ref p, for: b.right)
        return PatternItem {
            operand: exprSpan(in b.left),
            pattern: p.lexed.source.getText(exprSpan(in b.right)),
            kind: kind,
            range: false,
        } if kind != .none
    }
    if relational && (b.op is .lt or .le or .gt or .ge) {
        return relationalItem(ref p, for: b.left, by: b.right, as: b.op) if isPathOperand(b.left)
        let flipped = b.op == .lt ? BinaryOp.gt : b.op == .le ? BinaryOp.ge : b.op == .gt ? BinaryOp.lt : BinaryOp.le
        return relationalItem(ref p, for: b.right, by: b.left, as: flipped)
    }
    if b.op == .logicalAnd
            && b.left is .binaryExpr(let ge)
            && ge.value.op == .ge
            && b.right is .binaryExpr(let le)
            && le.value.op == .le
            && isPathOperand(ge.value.left)
            && p.lexed.source.getText(
                exprSpan(in ge.value.left),
            ) == p.lexed.source.getText(exprSpan(in le.value.left)) {
        let lo = rangeBound(ref p, for: ge.value.right)
        let hi = rangeBound(ref p, for: le.value.right)
        if lo is not null && hi is not null && lo.kind == hi.kind && boundAtMost(lo, to: hi) {
            let text = $"{p.lexed.source.getText(exprSpan(in ge.value.right))}..={p.lexed.source.getText(exprSpan(in le.value.right))}"
            return PatternItem { operand: exprSpan(in ge.value.left), pattern: text, kind: lo.kind, range: true }
        }
    }
    return null
}

/// `operand op bound` as a relational item, if `operand` is a path and `bound` a range bound.
PatternItem? relationalItem(ref Parser p, for Expr operand, by Expr bound, as BinaryOp op) {
    let text = op == .lt ? "<" : op == .le ? "<=" : op == .gt ? ">" : ">="
    unless isPathOperand(operand) {
        return null
    }
    let b = rangeBound(ref p, for: bound)
    return null if b is null
    return PatternItem {
        operand: exprSpan(in operand),
        pattern: $"{text} {p.lexed.source.getText(exprSpan(in bound))}",
        kind: b.kind,
        range: false,
    }
}

/// A name, a field path or an index path whose indexes are names or literals: reading it twice reads the same value.
// Parser.cs: IsPathOperand
bool isPathOperand(Expr e) {
    switch e {
        case .nameExpr(let n):
            return n.value.typeArgs.length == 0
        case .memberExpr(let m):
            return false if m.value.nullConditional || m.value.typeArgs.length != 0
            return true if m.value.target is .thisExpr(_)
            return isPathOperand(m.value.target)
        case .indexExpr(let i):
            switch i.value.index {
                case .nameExpr(let n):
                    return false if n.value.typeArgs.length != 0
                case .literalExpr(_):
                    let _ = 0
                default:
                    return false
            }
            return isPathOperand(i.value.target)
        default:
            return false
    }
}

/// The kind of a constant a pattern can hold; qualified names and floats are left out.
// Parser.cs: ConstantKind
ConstKind constantKind(ref Parser p, for Expr e) {
    switch e {
        case .literalExpr(let l):
            return .none if l.value.suffix is not null
            return .integer if l.value.kind == .integer
            return .rune if l.value.kind == .char
            if l.value.kind == .string {
                let t = p.lexed.source.getText(l.value.span)
                return .string if t.startsWith("\"") && !t.startsWith("\"\"\"")
            }
            return .none
        case .unaryExpr(let u):
            return .integer if u.value.op == .negate && isPlainInteger(u.value.operand)
            return .none
        case .targetMemberExpr(_):
            return .enumCase
        default:
            return .none
    }
}

/// An integer literal without a suffix.
bool isPlainInteger(Expr e) {
    switch e {
        case .literalExpr(let l):
            return l.value.kind == .integer && l.value.suffix is null
        default:
            return false
    }
}

/// The value of a range bound (the C# `(char Kind, Int128 Value)`): the magnitude in four 32-bit limbs, low first.
public struct Bound {
    public ConstKind kind
    public bool      negative
    public u64       l0
    public u64       l1
    public u64       l2
    public u64       l3
}

/// Whether `a` is at most `b`, both of one kind.
bool boundAtMost(Bound a, to Bound b) {
    return a.negative if a.negative != b.negative
    var order: i64 = 0
    if a.l3 != b.l3 {
        order = a.l3 < b.l3 ? -1 : 1
    } else if a.l2 != b.l2 {
        order = a.l2 < b.l2 ? -1 : 1
    } else if a.l1 != b.l1 {
        order = a.l1 < b.l1 ? -1 : 1
    } else if a.l0 != b.l0 {
        order = a.l0 < b.l0 ? -1 : 1
    }
    return a.negative ? order >= 0 : order <= 0
}

/// The value of a range bound: an integer literal (signed, with `0x`, `0o` or `0b`) or a rune literal of one plain character.
// Parser.cs: RangeBound
Bound? rangeBound(ref Parser p, for Expr e) {
    switch e {
        case .unaryExpr(let u):
            return null if u.value.op != .negate
            switch u.value.operand {
                case .literalExpr(let l):
                    return null if l.value.kind != .integer || l.value.suffix is not null
                    let v = integerValue(ref p, at: l.value.span)
                    return null if v is null
                    let zero = v.l0 == 0 && v.l1 == 0 && v.l2 == 0 && v.l3 == 0
                    return Bound { kind: .integer, negative: !zero, l0: v.l0, l1: v.l1, l2: v.l2, l3: v.l3 }
                default:
                    return null
            }
        case .literalExpr(let l):
            return null if l.value.suffix is not null
            return integerValue(ref p, at: l.value.span) if l.value.kind == .integer
            return null if l.value.kind != .char
            let s = l.value.span
            return null if s.length < 2
                || p.lexed.source.bytes[s.start] != '\''
                || p.lexed.source.bytes[s.end - 1] != '\''
            var runes: i64 = 0
            for i in (s.start + 1)..(s.end - 1) {
                return null if p.lexed.source.bytes[i] == '\\'
                if (p.lexed.source.bytes[i] & 0xC0) != 0x80 {
                    runes += 1
                }
            }
            return null if runes != 1
            return Bound { kind: .rune, negative: false, l0: scalarAt(ref p, at: s.start + 1), l1: 0, l2: 0, l3: 0 }
        default:
            return null
    }
}

/// The scalar of the UTF-8 sequence at `at`.
u64 scalarAt(ref Parser p, at i64 at) {
    let b0 = u64(p.lexed.source.bytes[at])
    return b0 if b0 < 0x80
    return ((b0 & 0x1F) << 6) | (u64(p.lexed.source.bytes[at + 1]) & 0x3F) if b0 < 0xE0
    return (
        (b0 & 0x0F) << 12
    ) | ((u64(p.lexed.source.bytes[at + 1]) & 0x3F) << 6) | (u64(p.lexed.source.bytes[at + 2]) & 0x3F) if b0 < 0xF0
    let high = ((b0 & 0x07) << 18) | ((u64(p.lexed.source.bytes[at + 1]) & 0x3F) << 12)
    return high | ((u64(p.lexed.source.bytes[at + 2]) & 0x3F) << 6) | (u64(p.lexed.source.bytes[at + 3]) & 0x3F)
}

/// The value of the integer literal at `span`, without `_`; null past 30 digits or on a digit outside its radix.
// Parser.cs: IntegerValue
Bound? integerValue(ref Parser p, at TextSpan span) {
    var digits = List<u8>()
    for i in span.start..span.end {
        if p.lexed.source.bytes[i] != '_' {
            digits.append(p.lexed.source.bytes[i])
        }
    }
    var radix: u64 = 10
    var from: i64 = 0
    if digits.length >= 2 && digits[0] == '0' {
        let b = digits[1]
        if b == 'x' || b == 'X' {
            radix = 16
        } else if b == 'o' || b == 'O' {
            radix = 8
        } else if b == 'b' || b == 'B' {
            radix = 2
        }
        if radix != 10 {
            from = 2
        }
    }
    let length = digits.length - from
    return null if length is 0 or > 30
    var v = Bound { kind: .integer, negative: false, l0: 0, l1: 0, l2: 0, l3: 0 }
    for k in from..digits.length {
        let c = digits[k]
        var d: u64 = 99
        if c >= '0' && c <= '9' {
            d = u64(c - '0')
        } else if c >= 'a' && c <= 'f' {
            d = u64(c - 'a') + 10
        } else if c >= 'A' && c <= 'F' {
            d = u64(c - 'A') + 10
        }
        return null if d >= radix
        let n0 = v.l0 * radix + d
        v.l0 = n0 & 0xFFFFFFFF
        let n1 = v.l1 * radix + (n0 >> 32)
        v.l1 = n1 & 0xFFFFFFFF
        let n2 = v.l2 * radix + (n1 >> 32)
        v.l2 = n2 & 0xFFFFFFFF
        v.l3 = v.l3 * radix + (n2 >> 32)
    }
    return v
}

// ── BYN1079 literals.empty ───────────────────────────────────────────────────

/// BYN1079 on `= List<T>()`, `= Map<K, V>()` or `= T {}` spelling the declared type; the fix writes `[]` or `{}`.
// Parser.cs: LintEmptyLiteral
void lintEmptyLiteral(ref Parser p, for TypeSyntax type, by Expr init) {
    var spelled = TextSpan { start: 0, length: 0 }
    var empty = ""
    switch init {
        case .callExpr(let call):
            return if call.value.args.length != 0 || call.value.becauseKeyword is not null
            switch call.value.callee {
                case .nameExpr(let callee):
                    let name = p.lexed.source.getText(callee.value.name)
                    return if callee.value.typeArgs.length == 0 || name != "List" && name != "Map"
                    spelled = callee.value.span
                    empty = "[]"
                default:
                    return
            }
        case .structLiteralExpr(let s):
            return if s.value.type is .none || s.value.fields.length != 0
            spelled = typeSpan(in s.value.type)
            empty = "{}"
        default:
            return
    }
    unless sameSqueezed(ref p, from: spelled, as: typeSpan(in type)) {
        return
    }
    let span = exprSpan(in init)
    reportStyleLint(
        ref p,
        for: "BYN1079",
        at: span,
        by: $"the type is known from the target; write `{empty}`",
        label: "spells out the declared type",
        help: $"write `{empty}`",
        fixSpan: span,
        fixReplacement: empty,
    )
}

/// Whether the texts of `a` and `b` are the same without their whitespace.
// Parser.cs: Squeezed
bool sameSqueezed(ref Parser p, from TextSpan a, as TextSpan b) {
    var i = a.start
    var j = b.start
    while true {
        while i < a.end && isTriviaSpace(p.lexed.source.bytes[i]) {
            i += 1
        }
        while j < b.end && isTriviaSpace(p.lexed.source.bytes[j]) {
            j += 1
        }
        return i == a.end && j == b.end if i == a.end || j == b.end
        return false if p.lexed.source.bytes[i] != p.lexed.source.bytes[j]
        i += 1
        j += 1
    }
}

// ── BYN1080 optionals.bind ───────────────────────────────────────────────────

/// The BYN1080 message for `X is { } k`, with `reason`.
string optionalsBindMessage(string x, by string name, for string reason) =>
    $"`{x} is {{ }} {name}` binds an optional with a pattern; {reason}"

/// The operand and name of `X is { } k`.
// Parser.cs: OptionalBinding
OptionalBind? optionalBinding(ref Parser p, for Expr condition) {
    switch condition {
        case .isExpr(let i):
            switch i.value.pattern {
                case .propertyPattern(let pp):
                    return null if !(pp.value.type is .none) || pp.value.properties.length != 0
                    let k = pp.value.designation
                    return null if k is null
                    var isName = false
                    if i.value.value is .nameExpr(let n) && n.value.typeArgs.length == 0 {
                        isName = true
                    }
                    return OptionalBind {
                        value: exprSpan(in i.value.value),
                        name: p.lexed.source.getText(k),
                        isName: isName,
                    }
                default:
                    return null
            }
        default:
            return null
    }
}

/// BYN1080 on `while (X is { } k)`; the fix writes `while let k = X`.
// Parser.cs: LintWhileBind
void lintWhileBind(
    ref Parser p,
    at Token keyword,
    for Expr condition,
    by Stmt body,
    until i64 conditionEnd,
    bool parenthesized
) {
    return if !parenthesized || !isBlockStmt(in body)
    let bind = optionalBinding(ref p, for: condition)
    return if bind is null
    let x = p.lexed.source.getText(bind.value)
    // `while let` takes a bare value, which ends at `{`.
    return if x.contains("{") || x.contains("\n")
    let span = TextSpan.fromBounds(keyword.start, until: conditionEnd)
    let fixedText = $"while let {bind.name} = {x}"
    reportStyleLint(
        ref p,
        for: "BYN1080",
        at: span,
        by: optionalsBindMessage(x, by: bind.name, for: "write `while let`"),
        label: "binds with a pattern",
        help: $"write `{fixedText}`",
        fixSpan: span,
        fixReplacement: fixedText,
    )
}

/// BYN1080 on `if (X is { } k)`: on a `let` local or parameter the fix tests `X is not null` and reads `X` (confirmed by the
/// compilation); where the miss leaves, it binds `let k = X ?? exit` (decided by the block). `span` is the `if` statement's.
// Parser.cs: LintIfBind
/// `conditionSpan` runs from the condition's first token to its end.
void lintIfBind(
    ref Parser p,
    at TextSpan span,
    for Expr condition,
    by Stmt then,
    from Stmt otherwise,
    as Likelihood likelihood,
    through TextSpan conditionSpan,
    bool parenthesized,
    bool elseIf
) {
    return if !parenthesized || likelihood != .none
    switch otherwise {
        case .blockStmt(_) or .ifStmt(_):
            let _ = 0
        default:
            unless otherwise is .none {
                return
            }
    }
    switch then {
        case .blockStmt(let block):
            lintIfBindBlock(
                ref p,
                at: span,
                for: condition,
                by: block.value,
                from: otherwise,
                through: conditionSpan,
                elseIf: elseIf,
            )
        default:
            return
    }
}

void lintIfBindBlock(
    ref Parser p,
    at TextSpan span,
    for Expr condition,
    by BlockStmt then,
    from Stmt otherwise,
    through TextSpan conditionSpan,
    bool elseIf
) {
    let bind = optionalBinding(ref p, for: condition)
    return if bind is null
    let x = p.lexed.source.getText(bind.value)
    return if x.contains("\n")
    let local = narrowLint(ref p, for: then, by: bind, through: conditionSpan)
    let exit = exitBindLint(
        ref p,
        at: span,
        for: then,
        from: otherwise,
        by: bind,
        through: conditionSpan,
        elseIf: elseIf,
    )
    if exit is not null {
        var declares = false
        var hasLocal = false
        for s in then.statements {
            switch s {
                case .deferStmt(_):
                    declares = true
                case .localDecl(let l):
                    hasLocal = true
                    if l.value.usingKeyword {
                        declares = true
                    }
                default:
                    continue
            }
        }
        p.bindExits.append(
            BindExit { stmt: span, exit: exit, local: local, name: bind.name, declares: declares, hasLocal: hasLocal },
        )
    } else if local is not null {
        p.typedLints.append(local)
    }
}

/// The `if X is not null` rewrite: `k` in the hit block becomes `X`, unless a use of it is not a plain read; null unless `X`
/// is a name.
// Parser.cs: NarrowLint
TypedLint? narrowLint(ref Parser p, for BlockStmt then, by OptionalBind bind, through TextSpan conditionSpan) {
    unless bind.isName {
        return null
    }
    let x = p.lexed.source.getText(bind.value)
    let conditionStart = conditionSpan.start
    let conditionEnd = conditionSpan.end
    var body = StrBuf()
    var from = then.span.start
    var i = tokenAt(ref p, at: then.span.start)
    while i < p.count && p.lexed.tokens[i].start < then.span.end {
        let t = p.lexed.tokens[i]
        // A lambda may not see the narrowing.
        return null if t.kind == .fatArrow
        if t.kind == .identifier && p.textOf(t) == bind.name {
            let before = p.kindAt(i - 1)
            return null if before == .dot
                || before == .refKeyword
                || before == .inKeyword
                || before == .outKeyword
                || p.kindAt(i + 1) == .colon
            body.append(p.lexed.source.getText(TextSpan.fromBounds(from, until: t.start)))
            body.append(x)
            from = t.end
        }
        i += 1
    }
    body.append(p.lexed.source.getText(TextSpan.fromBounds(from, until: then.span.end)))
    let open = p.lexed.tokens[tokenAt(ref p, at: conditionStart)]
    let lead = open.hasTriviaBefore ? "" : " "
    let head = $"{lead}{x} is not null{p.lexed.source.getText(TextSpan.fromBounds(conditionEnd, until: then.span.start))}"
    let lint = styleLintOf(
        "BYN1080",
        at: TextSpan.fromBounds(conditionStart, until: conditionEnd),
        by: optionalsBindMessage(x, by: bind.name, for: $"`{x} is not null` narrows `{x}`"),
        label: "binds a second name",
        help: $"write `if {x} is not null` and read `{x}`",
        fixSpan: TextSpan.fromBounds(conditionStart, until: then.span.end),
        fixReplacement: $"{head}{body.finish()}",
    )
    return TypedLint { lint: lint, operand: bind.value, check: .narrowableLocal }
}

/// Whether a `return` of `value` is short enough for `?? return …`: a literal, a name or a `.case`.
bool isSimpleReturn(Expr value) {
    switch value {
        case .literalExpr(_) or .targetMemberExpr(_):
            return true
        case .nameExpr(let n):
            return n.value.typeArgs.length == 0
        default:
            return false
    }
}

/// The `let k = X ?? exit` rewrite of an `if` whose `else` block is one bare exit; the hit block moves up a level. Null for
/// an `else if`.
// Parser.cs: ExitBindLint
Diagnostic? exitBindLint(
    ref Parser p,
    at TextSpan span,
    for BlockStmt then,
    from Stmt otherwise,
    by OptionalBind bind,
    through TextSpan conditionSpan,
    bool elseIf
) {
    return null if elseIf
    switch otherwise {
        case .blockStmt(let block):
            return exitBindBlock(ref p, at: span, for: then, from: block.value, by: bind, through: conditionSpan)
        default:
            return null
    }
}

Diagnostic? exitBindBlock(
    ref Parser p,
    at TextSpan span,
    for BlockStmt then,
    from BlockStmt otherwise,
    by OptionalBind bind,
    through TextSpan conditionSpan
) {
    let x = p.lexed.source.getText(bind.value)
    let name = bind.name
    return null if otherwise.statements.length != 1 || otherwise.span.length < 2
    var jump = ""
    var simple = false
    switch otherwise.statements[0] {
        case .returnStmt(let r):
            simple = isSimpleReturn(r.value.value)
        case .breakStmt(let b):
            return null if b.value.label is not null
            jump = "break"
        case .continueStmt(let c):
            return null if c.value.label is not null
            jump = "continue"
        default:
            return null
    }
    var from = otherwise.span.start + 1
    var to = otherwise.span.end - 1
    while from < to && isTriviaSpace(p.lexed.source.bytes[from]) {
        from += 1
    }
    while to > from && isTriviaSpace(p.lexed.source.bytes[to - 1]) {
        to -= 1
    }
    let exit = p.lexed.source.getText(TextSpan.fromBounds(from, until: to))
    return null if exit.contains("\n") || exit.contains("/") || exit.contains(";")
    return null if jump != "" && exit != jump
    if jump != "" {
        simple = true
    }
    let lineStart = p.lexed.source.getLineSpan(p.lexed.source.getLineIndex(span.start)).start
    for i in lineStart..span.start {
        unless isIndentByte(p.lexed.source.bytes[i]) {
            return null
        }
    }
    let indent = p.lexed.source.getText(TextSpan.fromBounds(lineStart, until: span.start))
    let body = dedentedBody(ref p, for: then, at: indent)
    return null if body is null
    let head = simple ? $"let {name} = {x} ?? {exit}" : $"let {name} = {x}\n{indent}{exit} if {name} is null"
    let help = simple ? $"write `{head}`" : $"write `let {name} = {x}` and `{exit} if {name} is null`"
    return styleLintOf(
        "BYN1080",
        at: conditionSpan,
        by: optionalsBindMessage(x, by: name, for: "the miss leaves, so a `let` can bind it"),
        label: "binds with a pattern",
        help: help,
        fixSpan: span,
        fixReplacement: $"{head}\n{body}",
    )
}

/// Whether the bytes of `from..to` are all spaces, tabs or line breaks.
bool isBlank(ref Parser p, from i64 from, to i64 to) {
    for i in from..to {
        unless isTriviaSpace(p.lexed.source.bytes[i]) {
            return false
        }
    }
    return true
}

/// The statements of `block` one level out at `indent`, or null if a line or token does not allow it.
// Parser.cs: DedentedBody
string? dedentedBody(ref Parser p, for BlockStmt block, at string indent) {
    var t = tokenAt(ref p, at: block.span.start)
    while t < p.count && p.lexed.tokens[t].start < block.span.end {
        return null if spansLine(ref p, at: spanOf(p.lexed.tokens[t]))
        t += 1
    }
    return null if block.span.length < 2
    let start = block.span.start + 1
    let end = block.span.end - 1
    var breaks = List<i64>()
    for i in start..end {
        return null if p.lexed.source.bytes[i] == '\r'
        if p.lexed.source.bytes[i] == '\n' {
            breaks.append(i)
        }
    }
    if breaks.length == 0 {
        var from = start
        var to = end
        while from < to && isTriviaSpace(p.lexed.source.bytes[from]) {
            from += 1
        }
        while to > from && isTriviaSpace(p.lexed.source.bytes[to - 1]) {
            to -= 1
        }
        return null if from == to
        return $"{indent}{p.lexed.source.getText(TextSpan.fromBounds(from, until: to))}"
    }
    unless isBlank(ref p, from: start, to: breaks[0]) {
        return null
    }
    return null if p.lexed.source.getText(TextSpan.fromBounds(breaks[breaks.length - 1] + 1, until: end)) != indent
    let deeper = $"{indent}    "
    var body = StrBuf()
    for k in 0..(breaks.length - 1) {
        let lineStart = breaks[k] + 1
        let lineEnd = breaks[k + 1]
        if k > 0 {
            body.append("\n")
        }
        continue if isBlank(ref p, from: lineStart, to: lineEnd)
        let line = p.lexed.source.getText(TextSpan.fromBounds(lineStart, until: lineEnd))
        unless line.startsWith(deeper) {
            return null
        }
        body.append(indent)
        body.append(p.lexed.source.getText(TextSpan.fromBounds(lineStart + deeper.length, until: lineEnd)))
    }
    return null if breaks.length < 2
    return $"{body.finish()}"
}

/// Decides the `if (X is { } k)` sites among `statements`: the hit block moves up only if it declares nothing that would
/// outlive it (no local, `defer` or `using`, unless it is the last statement) and no later statement names `k`.
// Parser.cs: LintBindExits
void lintBindExits(ref Parser p, for List<Stmt> statements) {
    let last = statements.length - 1
    for i in 0..statements.length {
        var span = TextSpan { start: 0, length: 0 }
        switch statements[i] {
            case .ifStmt(let s):
                span = s.value.span
            default:
                continue
        }
        var found: i64 = -1
        for j in 0..p.bindExits.length {
            if sameSpan(p.bindExits[j].stmt, as: span) {
                found = j
                break
            }
        }
        continue if found == -1
        let site = p.bindExits[found]
        p.bindExits.remove(at: found)
        let outlives = site.declares || i < last && site.hasLocal
        var named = false
        if i < last {
            let end = stmtSpan(in statements[last]).end
            var t = tokenAt(ref p, at: span.end)
            while t < p.count && p.lexed.tokens[t].start < end {
                if p.lexed.tokens[t].kind == .identifier && p.textOf(p.lexed.tokens[t]) == site.name {
                    named = true
                }
                t += 1
            }
        }
        let local = site.local
        if !outlives && !named {
            if local is not null {
                var withExit = local
                withExit.otherwise = site.exit
                p.typedLints.append(withExit)
            } else {
                p.styleLints.append(site.exit)
            }
        } else if local is not null {
            p.typedLints.append(local)
        }
    }
}
