// 019 T29 (coverage ratchet): stmts.byn paths no golden case reaches: locals written later through members, indexes,
// `++`, `--` and `ref`, parenthesized conditions with spaces and tabs inside, braceless bodies that are errors or end
// the input, `do … while` without a statement after its condition, stray attributes, likelihood words before
// non-expressions, and `unless … else` without braces. The helpers `t29Brief` and `t29Bodies` are
// dump-t29.test.byn's. The expected text is the output of the self-hosted parser at the commit that added the test.

test "parser t29: rare statements and their fixes" {
    let bodies = [
        "int x = 1\nx.a.b = 2",
        "int x = 1\nx[1][2] = 2",
        "int x = 1\nx[1",
        "int x = 1\nx++",
        "int x = 1\nx--",
        "int x = 1\nx >>= 1",
        "int x = 1\ng(ref x)",
        "int x = 1\na.x = 2\na?.x = 3",
        "if ( x ) {\n}",
        "if (\tx\t) {\n}",
        "if(x) {\n}",
        "if (x {\n}",
        "if (x) )",
        "while (x) )",
        "if (x) }",
        "\tif (x)\n\t\tf()",
        "if (x) if (y) f()",
        "if (x) if (y;) f()",
        "if (x) f() else g()",
        "if (x); f()",
        "if (x) as",
        "if (x) catch",
        "if (x) with",
        "if (x) is",
        "if (x) in",
        "@ 1",
        "@a )",
        "do {\n} while (x) + 1",
        "do {\n} while (x)\nf()",
        "become .a\n(1)",
        "assert x\nfails",
        "int\nx = 1",
        "if never {\n}",
        "if never ) {\n}",
        "unless never {\n}",
        "unless never x {\n}",
        "unless unlikely {\n}",
        "unless (x) f() else g()",
        "unless (x) { } else g()",
        "if (x) { a = 1 } b = 2",
        "if (x) (a) = { b }",
        "if (a { b }) = 1 { }",
    ]
    var sb = StrBuf()
    sb.append(t29Bodies(bodies))
    for text in ["void f() {\n    if (x)", "void f() {\n    @a", "void f() {\n    if (x"] {
        sb.append($"== {text}\n{t29Brief(text)}")
    }
    let bytes: List<u8> = [' ', '\t', '\n', '\r', 0x0B, 0x0C, 'x']
    for b in bytes {
        sb.append($"{isTrimmed(b)} ")
    }
    let expected = """
            == 0
            Function f() -> void
              Block
                Var x: i32 = 1
                Assign (. (. x a) b) = 2
            [BYN1043 11+5]
            == 1
