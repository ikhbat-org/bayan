              Block
                Var x: i32 = 1
                Expr (call g (ref x))
            [BYN1043 11+5]
            == 7
            Function f() -> void
              Block
                Let x: i32 = 1
                Assign (. a x) = 2
                Assign (?. a x) = 3
            [BYN1043 11+5]
