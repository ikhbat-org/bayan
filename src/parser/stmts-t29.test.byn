            true true true true true true false 
            """
    assert sb.finish() == expected
}

test "parser t29: the statement helpers on their rare inputs" {
    var sb = StrBuf()
    sb.append(t29Bodies(["using x = y", "for (int x in xs) {\n}"]))
    for text in ["(a)) x", "(a { b", "((a)", "x"] {
        var p = t3ParserOf(text)
        skipPastCloseParen(ref p)
        sb.append($"{text} {p.pos}\n")
    }
    var q = t3ParserOf("int")
    let type = parseType(ref q)
    sb.append($"{isNoType(in type)} {isNoType(in TypeSyntax.none)}\n")
    let expected = """
            == 0
            Function f() -> void
              Block
                Using Let x = y
            == 1
            Function f() -> void
              Block
                For Let x: i32 in xs
                  Block
            [BYN1019 15+13]
            (a)) x 4
            (a { b 2
            ((a) 4
            x 1
            false true

            """
    assert sb.finish() == expected
}
