// 019 T29 (coverage ratchet): the span walker over inline copies of the parse cases of the golden corpus, and the
// out-of-range lines of `nodeSpan` and `childSpan`. The expected values are the output of the self-hosted parser at the
// commit that added the test.

import lexer

test "parser t29: attributes on every declaration and statement keep their spans" {
    let text = """
            @a import x.y
            @a print(1)
            @a struct S {
                @a int f
                @a int p { get => 1 }
                @a init() { }
                @a int g => 1
            }
            @a interface I {
                @a void m()
                @a type T
            }
            @a extension S {
            }
            @a enum E {
                a
            }
            @a union U {
                a
                b(int x)
            }
            @a union error Er {
                a
            }
            @a union error Es = Er, Ef
            @a type T = int
            @a effect ef = fs
            @a test "t" {
            }
            extern void ext(u8* p)
            void f() {
                @a let x = 1
                @a x = 2
                @a x += 1
                @a x++
                @a return
                @a fail .a
                @a break
                @a continue
                @a become g()
                @a if x {
                }
                @a unless x {
                }
                @a while x {
                }
                @a do {
                } while x
                @a while let y = x {
                }
                @a for i in xs {
                }
                @a outer: for i in xs {
                }
                @a switch x {
                    case 1:
                        break
                }
                @a defer g()
                @a assert x
                @a provide allocator: a {
                }
                @a {
                }
                @a ;
                @a )
                let c = (u8)x
                let m = move x
                (int, int) t = (1, 2)
                let n = g<int>()
                let k = g() catch (Er.a) 0
                let k2 = g() catch (e) 0
                switch x {
                    case .a b:
                        break
                }
            }
            """
    var bytes = List<u8>()
    for b in text.bytes {
        bytes.append(b)
    }
    var p = Parser.create(lexer.lex(SourceText.create("t.byn", from: move bytes), by: Keywords.build()))
    let unit = parseCompilationUnit(ref p)
    var sb = StrBuf()
    checkSpans(in unit, until: p.lexed.source.bytes.length, to: ref sb)
    for d in p.lexed.diagnostics {
        sb.append($"{d.code} {d.span.start}+{d.span.length} {d.message}\n")
    }
    let expected = """
            span out of range: attributeSyntax 14+2 outside 17+8
            span out of range: blockStmt 66+12 outside 57+8
            span out of range: errorExpr 852+0 outside 849+2
            span out of range: nameExpr 889+1 outside 884+4
            span out of range: targetMemberExpr member 1027+1 outside 1026+1
            BYN1012 68+8 this expression does nothing as a statement
            BYN1016 344+6 `extern` is not allowed here
            BYN1001 367+4 expected `{`, found `void`
            BYN1069 382+2 attribute `@a` is not allowed before a statement
            BYN1069 399+2 attribute `@a` is not allowed before a statement
            BYN1069 412+2 attribute `@a` is not allowed before a statement
            BYN1069 426+2 attribute `@a` is not allowed before a statement
            BYN1069 437+2 attribute `@a` is not allowed before a statement
            BYN1069 451+2 attribute `@a` is not allowed before a statement
            BYN1069 466+2 attribute `@a` is not allowed before a statement
            BYN1069 479+2 attribute `@a` is not allowed before a statement
            BYN1069 495+2 attribute `@a` is not allowed before a statement
            BYN1001 505+1 expected `.`, found `g`
            BYN1069 533+2 attribute `@a` is not allowed before a statement
            BYN1069 557+2 attribute `@a` is not allowed before a statement
            BYN1069 580+2 attribute `@a` is not allowed before a statement
            BYN1069 606+2 attribute `@a` is not allowed before a statement
            BYN1069 637+2 attribute `@a` is not allowed before a statement
            BYN1069 664+2 attribute `@a` is not allowed before a statement
            BYN1069 698+2 attribute `@a` is not allowed before a statement
            BYN1069 756+2 attribute `@a` is not allowed before a statement
            BYN1069 773+2 attribute `@a` is not allowed before a statement
            BYN1069 789+2 attribute `@a` is not allowed before a statement
            BYN1069 825+2 attribute `@a` is not allowed before a statement
            BYN1069 840+2 attribute `@a` is not allowed before a statement
            BYN1040 843+1 `;` is an input form; a statement ends at the newline
            BYN1069 849+2 attribute `@a` is not allowed before a statement
            BYN1002 852+1 expected an expression, found `)`
            BYN1057 866+4 `(u8)x` is an input form; write `u8(x)`
            BYN1043 895+12 `(int, int) t` is an input form; write `let t: (int, int)`
            BYN1025 992+3 `catch (e)` is an input form; bind the error in a `catch switch` arm

            """
    assert sb.finish() == expected
}

test "parser t29: a span before the input or of negative length is out of range" {
    var sb = StrBuf()
    nodeSpan(TextSpan { start: -1, length: 1 }, for: "a", until: 4, to: ref sb)
    nodeSpan(TextSpan { start: 1, length: -1 }, for: "b", until: 4, to: ref sb)
    nodeSpan(TextSpan { start: 1, length: 3 }, for: "c", until: 4, to: ref sb)
    nodeSpan(TextSpan { start: 1, length: 4 }, for: "d", until: 4, to: ref sb)
    childSpan(TextSpan { start: 0, length: 1 }, for: "e", through: TextSpan { start: 1, length: 2 }, to: ref sb)
    let expected = """
            span out of range: a -1+1
            span out of range: b 1+-1
            span out of range: d 1+4
            span out of range: e 0+1 outside 1+2

            """
    assert sb.finish() == expected
}

test "parser t29: the parse cases written inline keep their spans inside the input" {
    let sources = [
        """
            void check(i64 a, Cart cart) {
                assert a == 1
                assert(a == 1)
                assert cart.subtotal.cents > 0 && a < 10
                assert !cart.isEmpty
            }

        """,
        """
            union error ConfigError {
                @exitCode(3)
                /// The configuration is malformed.
                malformed
                /// Something else.
                other
            }

            /// Runs the tool.
            @experimental
            @tag(level: 2)
            public void run() { }

            @experimental
            /// Stops the tool.
            void stop() { }

        """,
        """
            struct Circle : IShape {
                f32 r

                f32 area() => r * r
            }

            struct Wrapper<T> : IShape, m.IDescribe where T : IShape, IOrder<T> {
                T inner
            }

            struct Stream : IEnumerator {
                type Item = Token
                i64 i
            }

            union Shape : IShape {
                circle(f32 r)
                none
            }

            union Box<T> : IShape where T : IShape {
                full(T v)
                empty
            }

            enum Color : IShape {
                red
                green
            }

            enum Planet(f64 mass) : IShape where T : IShape {
                earth(1.0)
                mars(0.1)
            }

            T max<T>(T a, T b) where T : IOrder<T> => a.less(b) ? b : a

            T parse<T>(string s) where T : IParse<T> fails {
                return T.parse(s)
            }

            T read<T>(string s) where T : IParse<T>, IShape where U : IShape expects s.length > 0 fails IoError {
                return T.parse(s)
            }

        """,
        """
            @allow(unusedValue) because "the cache is warmed for its effect"
            @cases(1) because "x"
            void warm() {
                let n = countUnchecked(xs) because "xs is never empty here"
            }

        """,
        """
            union error MkError { bad }

            i32 mk(bool ok) fails MkError {
                fail .bad if !ok
                return 7
            }

            void touch(bool ok) fails MkError {
                fail .bad if !ok
            }

            i32 get(bool ok) {
                var failed = false
                let n = mk(ok) catch {
                    failed = true
                    return -1
                }
                return n
            }

            var hit = false
            touch(ok: false) catch { hit = true }
            print($"{get(ok: true)} {get(ok: false)} {hit}")

        """,
        """
            let n = parse(s) catch { return -1 }
            let m = parse(s) catch {
                log("failed")
                break
            }
            save(x) catch { log("x") }

        """,
        """
            union error MkError { bad }

            struct P {
                i64 x = 0
            }

            P mk(bool ok) fails MkError {
                fail .bad if !ok
                return { x: 7 }
            }

            let a: P = mk(ok: false) catch { x: 1 }
            let b: P = mk(ok: true) catch { x: 1 }
            let c: P = mk(ok: false) catch P{}
            print($"{a.x} {b.x} {c.x}")

        """,
        """
            let resp = signUp(form) catch switch {
                EmailError => .badRequest("Invalid email"),
                DbError.timeout => .unavailable,
                DbError e => .serverError(e),
            }
            save(x) catch switch {
                IoError e => log(e),
                _ => log("other"),
            }
            let old = parse(s) catch switch {
                .empty => 0,
                _ => 1,
            }
            let n = parse(s) catch switch {
                ParseError e => fallback(e),
            }

        """,
        """
            T parse<T>(string s, i64 limit)
                where T : IParse<T>
                expects s.length > 0
                expects limit > 0
                uses fs
                fails IoError {
                return T.parse(s)
            }

            void close(move this is .open)
                uses console
                becomes .closed
                fails {
                let expects = 1
                print(expects)
                become .closed
            }

            interface IStore {
