                    become .paid(amount)
                }
                void ship(move this) becomes .shipped {
                    become .shipped
                }
                i64 total(this is .paid or .shipped) => id
            }

            void archive(Order order is .paid or .shipped) {
                print(order.id)
            }

            void refund(Order.paid order) {
                print(order.payment)
            }

        """,
        """
            struct Counter {
                i64 n

                void bump(ref this) {
                    n += 1
                }

                void add(ref this, i64 by) {
                    n += by
                }

                i64 peek() => n
            }

        """,
        """
            struct Order {
                i64 id
                states {
                    placed
                    paid
                    shipped
                }
            }

            type Done = Order is .paid or .shipped
            type Moving = Order is .placed or .paid or .shipped

            void archive(Order o) {
                let x: Order is .paid or .shipped = o
                var y: Order is .placed or .paid or .shipped = o
                print(x.id)
            }

        """,
        """
            void f(i32 n) expects n > Limit {}
            void g() {}

        """,
        """
            type distinct Email = string requires it.length > 3

            struct SignupForm {
                Email email
                string username
                    requires it.length in 3..=32
                string password
                    requires it.length in 8..=128
                i32 age requires it in 13..=120

                requires password != username at .password
            }

        """,
        """
            i32 discount(i32 total, i32 percent)
                expects percent in 0..=100
                expects total >= 0
                => total - total * percent / 100

            void check(i32 n) expects n in 1..10 && n != 5 fails {
                print($"{n in 0..=n * 2}")
            }

        """,
        """
            void log(rest ReadOnlySpan<Display> items, to Stream stream = .stdout, string sep = " ") {
                print(items)
            }

            i64 sum(rest ReadOnlySpan<i64> xs) {
                return 0
            }

        """,
        """
            void main() {
                let a = 1
                var b = 2
                const c = 3
                let d: i64 = 4
                var e: u8 = 5
                let f: i64 = 6
                var m: Money
                using let arena = Arena()
                b = 7
                b += 1
                b -= 1
                b *= 2
                b /= 2
                b %= 3
                b <<= 1
                b >>= 1
                b &= 1
                b |= 2
                b ^= 3
                m.cents = 9
                xs[0] = 1
                b++
                b--
                ++b
                _ = f()
                if a > 0 { print("pos") } else if a < 0 { print("neg") } else { print("zero") }
                unless ok { retry() }
                while b > 0 { b-- }
                do { b++ } while b < 10
                for i in 0..10 { total += i }
                for x in xs { print(x) }
                for i: i64 in 0..=n {}
                for y in ys {}
                outer: for row in grid {
                    for cell in row {
                        break outer if cell == 0
                        continue outer
                    }
                }
                defer close(f)
                defer failing rollback()
                defer failing (e) { log(e) }
                provide allocator: arena {
                    work()
                }
                {
                    nested()
                }

                return
            }

        """,
        """
            struct Money {
                i64 cents = 0
            }

            struct LineItem {
                string name
                Money unitPrice
                i64 qty = 1
            }

            let price = Money { cents: 250 }
            let item = LineItem { name: "tea", unitPrice: { cents: 250 }, qty: 2 }
            let more = item with { name: "coffee", qty: 3 }
            let none = Money {}
            Money pick() => { cents: 1 }
            {
                outer: for i in 0..2 {
                    break outer
                }
            }
            union error MkError { bad }
            Money mk(bool ok) fails MkError {
                fail .bad if !ok
                return { cents: 7 }
            }
            let caught: Money = mk(ok: false) catch { cents: 1 }

        """,
        """
            let a = Åp { x: 1 }
            let b = Ω { }
            let c = Δ { y: 2 }
            let d = Ω.ω { x: 1 }
            let e = Ä.ö { }
            let f = v is Ä { x: 1 }
            let g = v is Δ { y: 2 }
            let h = v is ω { x: 1 }
            let i = ω { x: 1 }
            let j = Åp { x: 1 }

        """,
        """
            /// A sum of money.
            public struct Money {
                public required i64 cents
                public readonly string currency = "MYR"
                private i64? note
                i64[4] history

                public bool isZero => cents == 0

                public Money(i64 cents) { this.cents = cents }

                public Money plus(Money other) => Money { cents: cents + other.cents }

                void reset() {
                    cents = 0
                }
            }

        """,
        """
            string name(Day d) {
                switch d {
                    case .sat or .sun:
                        return "weekend"
                    case .mon:
                        print("ugh")
                        break
                    case var other when other.isHoliday:
                        return "holiday"
                    default:
                        return "weekday"
                }
                let size = n switch {
                    0 => "none",
                    1 or 2 => "few",
                    < 10 => "some",
                    _ => "many",
                }
                return size
            }

        """,
        """
            @cases((0, false), (1, true))
            test "quantity bounds" (i32 input, bool valid) {
                assert(input >= 0)
            }

            @cases(1, 2, 3) test "positive" (i32 n) { assert(n > 0) }

            test "plain" {
            }

        """,
        """
            union Shape {
                circle(f32 r)
                rect(f32 w, f32 h)
                /// Nothing at all.
                none
            }

            public union Token {
                number(i64 value)
                word(string text)
                end
            }

            f32 area(Shape s) => s switch {
                .circle(let r) => r * r,
                Shape.rect(var w, _) => w,
                .none => 0,
            }

            union Mode {
                read = 1
                write = 2
                append
                none = -1
            }

        """,
        """
            void log(string msg) uses allocator, io {
                print(msg)
            }
            i32 next(i32 n) uses allocator becomes .done fails ParseError => n

        """,
        """
            void f<T>(T x) where T : I uses io becomes .done fails E {
                print(x)
            }

        """,
        """
            void main() {
                let a = not true and false or true
                let b = !true && false || true
                let c = a and not b
                    or a
                print("x") unless not a
            }

        """,
    ]
    var sb = StrBuf()
    var i = 0
    for source in sources {
