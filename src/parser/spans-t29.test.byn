            let all = [..xs, ..more, 4]
            let fixed = [1, 2, 3]
            let nested = ["k": [1, 2], "j": (a ? b : c)]
            let prices: Map<string, Money> = ["tea": Money { cents: 250 }, "jam": { cents: 99 }]
            let typed = ["cake": Money { cents: 300 }]

        """,
        """
            // Declaration-only keywords are names wherever the grammar does not need them (spec 004 R3).
            type Code = i64

            union error Failure {
                error
                set
                law
            }

            struct Names {
                i64 error
                i64 flags
                i64 unit
                i64 distinct
                i64 open
                i64 extensible
                i64 set
                i64 type
                i64 law
                i64 derivation
                i64 attribute
                i64 embed
            }

            i64 error(i64 error) => error
            i64 flags(i64 flags) => flags
            i64 unit(i64 unit) => unit
            i64 distinct(i64 distinct) => distinct
            i64 open(i64 open) => open
            i64 extensible(i64 extensible) => extensible
            i64 set(i64 set) => set
            i64 type(i64 type) => type
            i64 law(i64 law) => law
            i64 derivation(i64 derivation) => derivation
            i64 attribute(i64 attribute) => attribute
            i64 embed(i64 embed) => embed
            (i64 type, i64 law) swap((i64 flags, i64 unit) pair) => (pair.unit, pair.flags)

            let error = 3
            let flags = 1
            var unit = 2
            let distinct: i64 = 4
            let open = true
            let extensible = false
            let set = [1, 2]
            let type = 5
            let law = 6
            let derivation = 7
            let attribute = 8
            let embed = 9
            let pair: (i64 error, i64 set) = (1, 2)
            type = 1
            set.add(1)
            let n = Names { error: 1, set: 2, type: 3 }
            let total = n.error + n.flags + n.unit + n.distinct + n.open + n.extensible + n.set + n.type + n.law + n.derivation + n.attribute + n.embed
            let f = Failure.set
            print(error(type: 1))

        """,
        """
            void f(i64 n, Point p, List<i64> xs, Map<string, i64> prices) fails ReadError {
                if n > 0 { a() } else if n < 0 { b() } else { c() }
                if (p == Point { x: 0, y: 0 }) { origin() }
                if (p is { x: 0 }) { origin() }
                if (n + 1) * 2 > 3 { big() }
                if n > 0 { return }
                unless p.isValid { reject(p) }
                while queue.hasItems { step() }
                while try socket.hasMore() { read() }
                do { n++ } while n < 10
                do { n++ } while n < 20
                switch n {
                    case 1: one()
                    default: other()
                }
                for x in xs { use(x) }
                for i in 0..n { use(i) }
                for x: i64 in xs { use(x) }
