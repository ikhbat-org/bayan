// 019 T29 (coverage ratchet): decls2.byn paths no golden case reaches: interface and extension members that are not
// members, unterminated bodies, `;` after enum and union cases, payloads without names, case commas with spaces and tabs
// around them, and the whitespace and comment helpers. The helper `t29Brief` is dump-t29.test.byn's. The expected text is
// the output of the self-hosted parser at the commit that added the test.

test "parser t29: rare declaration bodies" {
    let sources = [
        "interface I {\n    +\n}\n",
        "interface I {\n    )\n}\n",
        "interface I {\n    int x { set }\n}\n",
        "interface I {\n    type T x\n    type (\n}\n",
        "interface I {\n    f() int\n    int = 1\n    int (\n}\n",
        "interface I {\n    void f()",
        "extension S {\n    )\n}\n",
        "extension S {\n    int x\n}\n",
        "extension S : I x\n",
        "extension S {\n    void f() { }",
        "enum E {\n    a, b;\n}\n",
        "union U {\n    a, b;\n}\n",
        "enum E { a, b c }\n",
        "enum E { a , b\t, c }\n",
        "enum E {\n    a,\t\n    b\n}\n",
        "union error E except .a, b { c }\n",
        "error /* c */ union E { a }\n",
        "union U { a(int), b(, ) }\n",
        "union U { a(int x,",
    ]
    var sb = StrBuf()
    for i in 0..sources.length {
        sb.append($"== {i}\n{t29Brief(sources[i])}")
    }
    let bytes: List<u8> = [' ', '\t', '\n', '\r', 0x0B, 0x0C, 'x']
    for b in bytes {
        sb.append($"{isWhiteSpace(b)} ")
    }
    sb.append($"[{keptComment("\t/* c */\t")}] [{keptComment(" \t")}]\n")
    let expected = """
            == 0
            Interface I
            [BYN1001 18+1]
            == 1
            Interface I
            [BYN1001 18+1]
            == 2
            Interface I
              Getter i32 x
            [BYN1001 26+3]
            [BYN1001 32+1]
            == 3
            Interface I
            [BYN1001 18+4]
            [BYN1001 31+4]
            == 4
            Interface I
            [BYN1001 18+1]
            [BYN1001 30+3]
            [BYN1001 42+3]
            == 5
            Interface I
              Function f() -> void
            [BYN1001 26+0]
            == 6
            Extension S
              <error>
            [BYN1004 18+1]
            == 7
            Extension S
              Field i32 x
            == 8
            Extension S : I
              <error>
            [BYN1001 16+1]
            [BYN1001 18+0]
            == 9
            Extension S
              Function f() -> void
                Block
            [BYN1001 30+0]
            == 10
            Enum E
              Member a
              Member b
            [BYN1040 17+1]
            [BYN1053 14+1]
            == 11
            Union U
              Variant a
              Variant b
            [BYN1040 18+1]
            [BYN1053 15+1]
            == 12
            Enum E
              Member a
              Member b
            [BYN1053 10+1]
            [BYN1001 14+1]
            [BYN1001 16+1]
            == 13
            Enum E
              Member a
              Member b
              Member c
            [BYN1053 11+1]
            == 14
            Enum E
              Member a
              Member b
            [BYN1053 14+1]
            == 15
            ErrorEnum E
            [BYN1001 14+6]
            == 16
            ErrorEnum E
              Variant a
            [BYN1047 6+7]
            [BYN1044 0+19]
            == 17
            Union U
              Variant a(i32 <missing>)
              Variant b(<missing> <missing>)
            [BYN1064 12+3]
            [BYN1003 20+1]
            [BYN1053 16+1]
            == 18
            Union U
              Variant a(i32 x)
            [BYN1001 18+0]
            true true true true true true false [ /* c */] []

            """
    assert sb.finish() == expected
}
