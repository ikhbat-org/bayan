// 019 T29 (coverage ratchet): main.byn's argument handling and its runs, which no golden case reaches. Each run is asserted
// by its exit code (the C goes to stdout, the reports to stderr); the inputs are written under tmp/emit-main-t29, named from
// the root `bayan test` runs in. The expected values are the output of the self-hosted emitter at the commit that added
// the test.

import semantics

/// tmp/emit-main-t29/<name>, created when missing.
string emT29Dir(string name) uses alloc, fs {
    let root = Path.combine(Path.fullPath("tmp"), "emit-main-t29")
    Io.createDirectory(root) catch {}
    let dir = Path.combine(root, name)
    Io.createDirectory(dir) catch {}
    return dir
}

/// `text` written as `dir/name`; the path.
string emT29Write(string dir, for string name, as string text) uses alloc, fs {
    let path = Path.combine(dir, name)
    Io.writeFile(path, text) catch { panic($"cannot write {path}") }
    return path
}

test "emit main t29: usage, global options and the mode" {
    assert usage() == exitUsage
    let dir = emT29Dir("options")
    let ok = emT29Write(dir, for: "ok.byn", as: "print(\"a\")\n")
    assert main(["--ascii", "--color", "never", "--color=always", "--color", "auto", "--mode", "debug", ok]) == exitOk
    assert main(["--mode", "fast", ok]) == exitOk
    assert main(["--color=bad"]) == exitUsage
    assert main(["--color"]) == exitUsage
    assert main(["--mode", "slow", ok]) == exitUsage
    assert main(["--mode"]) == exitUsage
    assert main(["--", ok]) == exitUsage
    assert main([]) == exitUsage
}

test "emit main t29: many, time and package take one shape of arguments" {
    let dir = emT29Dir("shapes")
    let ok = emT29Write(dir, for: "ok.byn", as: "print(\"a\")\n")
    assert main(["--many", dir, ok]) == exitUsage
    assert main(["--time", ok, ok]) == exitUsage
    assert main(["--package", dir]) == exitUsage
    assert main(["--many"]) == exitUsage
    assert main(["--time"]) == exitUsage
    assert main(["--package"]) == exitUsage
}

test "emit main t29: a build with errors, with and without tests" {
    let dir = emT29Dir("errors")
    let bad = emT29Write(dir, for: "bad.byn", as: "i64 f() => \"a\"\n")
    assert main([bad]) == exitFailure
    assert main(["--tests", bad]) == exitFailure
}

test "emit main t29: coverage and mutation builds" {
    let dir = emT29Dir("builds")
    let ok = emT29Write(dir, for: "ok.byn", as: "i64 f(i64 x) => x > 1 ? x + 1 : 0\nprint($\"{f(2)}\")\n")
    assert main(["--coverage", ok]) == exitOk
    assert main(["--mutate", ok]) == exitOk
    assert main(["--tests", ok]) == exitOk
}

test "emit main t29: t10Emit adds probes or switches" {
    let source = "i64 f(i64 x) => x > 1 ? x + 1 : 0\nprint($\"{f(2)}\")\n"
    var bytes = List<u8>()
    for b in source.bytes {
        bytes.append(b)
    }
    var c = t12Compile(Path.fullPath("tmp"), at: move bytes, for: "em.byn", by: false)
    assert !t12HasErrors(in c)
    let plain = t10Emit(ref c, by: "safe", through: false, as: false)
    assert !plain.contains("byn_cov")
    var covered = List<u8>()
    for b in source.bytes {
        covered.append(b)
    }
    var cc = t12Compile(Path.fullPath("tmp"), at: move covered, for: "em.byn", by: false)
    let probes = t10Emit(ref cc, by: "safe", through: true, as: false)
    assert probes.contains("byn_cov")
    var mutated = List<u8>()
    for b in source.bytes {
        mutated.append(b)
    }
    var cm = t12Compile(Path.fullPath("tmp"), at: move mutated, for: "em.byn", by: false)
    let switches = t10Emit(ref cm, by: "debug", through: false, as: true)
    assert switches.contains("byn_mut")
}

test "emit main t29: a library has no program to build" {
    let dir = emT29Dir("lib")
    assert emT29Write(dir, for: "package.byn", as: "Package {\n    name: \"local/mylib\",\n    version: \"0.1.0\",\n    edition: 2027,\n    kind: .lib,\n}\n").endsWith("package.byn")
    let src = Path.combine(dir, "src")
    Io.createDirectory(src) catch {}
    let module = Path.combine(src, "mylib")
    Io.createDirectory(module) catch {}
    assert emT29Write(module, for: "lib.byn", as: "public i64 one() => 1\n").endsWith("lib.byn")
    assert main([dir]) == exitUsage
    assert main(["--tests", dir]) == exitOk
}

test "emit main t29: package runs" {
    let dir = emT29Dir("package")
    let ok = emT29Write(dir, for: "ok.byn", as: "i64 f(i64 x) => x > 1 ? x + 1 : 0\nprint($\"{f(2)}\")\n")
    let bad = emT29Write(emT29Dir("package-bad"), for: "bad.byn", as: "i64 f() => \"a\"\n")
    assert main(["--package", dir, ok]) == exitOk
    assert main(["--package", dir, "--coverage", ok]) == exitOk
    assert main(["--package", dir, "--mutate", ok]) == exitOk
    assert main(["--package", dir, bad]) == exitFailure
    assert main(["--package", dir, "--tests", bad]) == exitFailure
    assert main(["--package", dir, Path.combine(dir, "missing.byn")]) == exitFailure
}

test "emit main t29: many skips what is not a source and names a failing exit" {
    let dir = emT29Dir("many")
    assert emT29Write(dir, for: "a.byn", as: "print(\"a\")\n").endsWith("a.byn")
    assert emT29Write(dir, for: "b.byn", as: "i64 f() => \"a\"\n").endsWith("b.byn")
    assert emT29Write(dir, for: "c.test.byn", as: "test \"t\" {\n    assert 1 == 1\n}\n").endsWith("c.test.byn")
    assert emT29Write(dir, for: "notes.txt", as: "not a source\n").endsWith("notes.txt")
    assert main(["--many", dir]) == exitOk
    assert main(["--many", Path.combine(dir, "no-such-dir")]) == exitUsage
}

test "emit main t29: time" {
    let dir = emT29Dir("time")
    let ok = emT29Write(dir, for: "ok.byn", as: "print(\"a\")\n")
    let bad = emT29Write(emT29Dir("time-bad"), for: "bad.byn", as: "i64 f() => \"a\"\n")
    assert main(["--time", ok]) == exitOk
    assert main(["--time", bad]) == exitFailure
    assert main(["--time", "--x"]) == exitUsage
}
