// 019 T29 (coverage ratchet): main.byn's arguments, `--package`, `--many`, `--time`, the library refusal and the
// `--coverage`/`--mutate` emits, on inputs written under tmp/t29emi-main. The expected exit codes are the output of the
// self-hosted emitter at the commit that added the test.

/// tmp/t29emi-main with an app input, one with only a warning, one with an error, a test file, a file that is not
/// `*.byn`, and a library project under lib/.
string t29MainDir() {
    let dir = Path.combine(Path.fullPath("tmp"), "t29emi-main")
    Io.createDirectory(Path.combine(dir, "lib/src")) catch {}
    t29MainWrite(dir, for: "ok.byn", as: "void main() {\n    print(\"hi\")\n}\n")
    t29MainWrite(dir, for: "warn.byn", as: "void main() {\n    var x = 1\n    print($\"{x}\")\n}\n")
    t29MainWrite(dir, for: "bad.byn", as: "void main() {\n    let x: i64 = \"s\"\n}\n")
    t29MainWrite(dir, for: "ok.test.byn", as: "i64 one() => 1\n\ntest \"one\" {\n    assert one() == 1\n}\n")
    t29MainWrite(dir, for: "notes.txt", as: "not an input\n")
    t29MainWrite(
        dir,
        for: "lib/package.byn",
        as: "Package {\n    name: \"local/t29lib\",\n    version: \"0.1.0\",\n    edition: 2027,\n    kind: .lib,\n}\n",
    )
    t29MainWrite(dir, for: "lib/src/lib.byn", as: "public i64 one() => 1\n\ntest \"one\" {\n    assert one() == 1\n}\n")
    return dir
}

void t29MainWrite(string dir, for string name, as string text) {
    Io.writeFile(Path.combine(dir, name), text.bytes) catch {}
}

test "emitter t29: main's options and their exit codes" {
    let dir = t29MainDir()
    let ok = Path.combine(dir, "ok.byn")
    let bad = Path.combine(dir, "bad.byn")
    print($"usage {usage()}")
    print($"dashdash {main(["--", ok])}")
    print($"ascii {main(["--ascii", "--color", "auto", "--mode", "debug", ok])}")
    print($"always {main(["--color=always", ok])}")
    print($"never {main(["--color", "never", "--mode", "fast", ok])}")
    print($"colorbad {main(["--color=bogus", ok])}")
    print($"colorlast {main(["--color"])}")
    print($"modelast {main(["--mode"])}")
    print($"modebad {main(["--mode", "bogus", ok])}")
    print($"coverage {main(["--coverage", ok])}")
    print($"mutate {main(["--mutate", ok])}")
    print($"both {main(["--coverage", "--mutate", ok])}")
    print($"bad {main([bad])}")
    print($"badtests {main(["--tests", bad])}")
    print($"lib {main([Path.combine(dir, "lib")])}")
    print($"libtests {main(["--tests", Path.combine(dir, "lib")])}")
    print($"noinput {main([Path.combine(dir, "missing.byn")])}")
}

test "emitter t29: main's --package, --many and --time" {
    let dir = t29MainDir()
    let ok = Path.combine(dir, "ok.byn")
    let bad = Path.combine(dir, "bad.byn")
    print($"package {main(["--package", dir, ok])}")
    print($"packagetests {main(["--tests", "--package", dir, Path.combine(dir, "ok.test.byn")])}")
    print($"packagecov {main(["--coverage", "--package", dir, ok])}")
    print($"packagemut {main(["--mutate", "--package", dir, ok])}")
    print($"packagebad {main(["--package", dir, bad])}")
    print($"packagebadtests {main(["--tests", "--package", dir, bad])}")
    print($"packagemissing {main(["--package", dir, Path.combine(dir, "missing.byn")])}")
    print($"packagerest {main(["--package", dir])}")
    print($"packagelast {main(["--package"])}")
    print($"many {main(["--many", dir])}")
    print($"manyrest {main(["--many", dir, ok])}")
    print($"manylast {main(["--many"])}")
    print($"manymissing {main(["--many", Path.combine(dir, "missing")])}")
    print($"time {main(["--time", ok])}")
    print($"timerest {main(["--time", ok, ok])}")
    print($"timelast {main(["--time"])}")
    print($"timebad {main(["--time", bad])}")
}

test "emitter t29: t12HasErrors tells a warning from an error" {
    let dir = t29MainDir()
    for name in ["ok.byn", "warn.byn", "bad.byn"] {
        let bytes = Io.readFile(Path.combine(dir, name)) catch List<u8>()
        let c = t12Compile(dir, at: move bytes, for: name, by: false)
        print($"{name} {c.diagnostics.length} {t12HasErrors(in c)}")
    }
}
