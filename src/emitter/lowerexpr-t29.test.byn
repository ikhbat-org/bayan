string t29LxPrelude() => """
    union error E {
        bad
        worse(i64 code)
    }

    struct Pt {
        i64 x = 0
        i64 y = 0
    }

    struct Pos {
        i64 v requires it >= 0
    }

    i64 two(i64 a, by i64 b) => a + b
    Pt mkPt(i64 a) => Pt { x: a, y: 0 }
    (i64 a, i64 b) mkTup(i64 a) => (a, a)
    bool yes(i64 a) => a > 0
    i64[2] mkArr(i64 a) => [a, a]
    List<i64> mkList(i64 a) => [a]
    i64 sumSpan(ReadOnlySpan<i64> s) => s.length

    i64? mkOpt(i64 a) {
        return null if a < 0
        return a
    }

    never stop() fails E {
        fail .bad
    }

    """

/// The C function `f` of `source` after `t29LxPrelude()` (`f` is on line 32), or `errors: …`.
string t29LxFn(string source, by bool covering = false) {
    var program = StrBuf()
    program.append(t29LxPrelude())
    program.append(source)
    program.append("\nvoid main() {\n    print(\"m\")\n}\n")
    let text = t29Emit(program.finish(), covering: covering)
    return text if text.startsWith("errors:")
    var sb = StrBuf()
    var on = false
    for line in text.lines {
        if !on && line.contains("byn_main__f(") && line.endsWith("{") {
            on = true
        } else if on {
            sb.append("\n")
        }
        if on {
            sb.append(line)
        }
        return sb.finish() if on && line == "}"
    }
    return sb.finish()
}

/// One lowering case: the C of `f` in `source` is `expected`.
void t29LxCase(string source, by string expected) {
    let got = t29LxFn(source)
    assert got == expected
}

