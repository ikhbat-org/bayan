// 019 T29 (coverage ratchet): `t6FloatLiteral` of a NaN and the infinities. The expected values are the output of the
// self-hosted emitter at the commit that added the test.

test "cprint t29: t6FloatLiteral of NaN and the infinities" {
    let inf = 1.0 / 0.0
    assert t6FloatLiteral(inf - inf, by: false) == "((double)NAN)"
    assert t6FloatLiteral(inf - inf, by: true) == "((float)NAN)"
    assert t6FloatLiteral(inf, by: false) == "((double)INFINITY)"
    assert t6FloatLiteral(inf, by: true) == "((float)INFINITY)"
    assert t6FloatLiteral(-inf, by: false) == "(-(double)INFINITY)"
    assert t6FloatLiteral(-inf, by: true) == "(-(float)INFINITY)"
    assert t6FloatLiteral(0.5, by: false) == "(0.5)"
    assert t6FloatLiteral(2.0, by: true) == "((float)2.0)"
}
