import semantics
import lexer

// T29: own.byn's storage parts of an `Owned`, an `Untrusted` and a state type, and the runtime suffixes of `isize`,
// `usize` and `char`. The expected values are the output of the self-hosted emitter at the commit that added the test.

type OwOptions = semantics.CompilationOptions

Ctx owCompile(string source) {
    var bytes = List<u8>()
    for b in source.bytes {
        bytes.append(b)
    }
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create("ow.byn", from: move bytes))
    let options = OwOptions { includeTests: false }
    return semantics.create(from: move sources, at: Path.fullPath("tmp"), by: in options)
}

string owParts(ref Ctx c, for Type t) {
    var parts = List<T7Part>()
    t7StorageParts(ref c, for: t, at: "x", to: ref parts)
    var sb = StrBuf()
    for p in parts {
        sb.append($"{p.storage} {p.place} {p.type}\n")
    }
    return sb.finish()
}

test "own t29: storage parts of owned, untrusted and state types" {
    var c = owCompile("struct Bag {\n    List<i64> items\n}\n\nprint(\"a\")\n")
    var bag = -1
    for i in 0..c.structs.length {
        bag = i if c.structs[i].name == "Bag"
    }
    let list = semantics.internList(ref c, by: semantics.prim(.i64))
    let owned = semantics.internOwned(ref c, by: semantics.prim(.i64))
    assert owParts(ref c, for: owned) == "x &x Owned<i64>\n"
    assert owParts(ref c, for: semantics.internUntrusted(ref c, by: list)) == "x.ptr &x List<i64>\n"
    let states = List<semantics.VariantId>()
    assert owParts(ref c, for: semantics.internState(ref c, by: bag, for: in states)) == "x.items.ptr &x.items List<i64>\n"
}

test "own t29: the runtime suffixes of isize, usize and char" {
    assert intSuffix(semantics.prim(.isize)) == "i64"
    assert intSuffix(semantics.prim(.usize)) == "u64"
    assert intSuffix(semantics.prim(.char)) == "char"
    assert intSuffix(semantics.prim(.u8)) == "u8"
}
