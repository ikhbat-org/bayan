import semantics
import lexer

// T29: common.byn's C types and keys of the builtin, error, view, state, range and `dyn ref` types, and `mapLine` on a
// line it has already written. The expected values are the output of the self-hosted emitter at the commit that added
// the test.

type CmOptions = semantics.CompilationOptions
type CmSpan    = semantics.TextSpan

Ctx cmCompile(string source) {
    var bytes = List<u8>()
    for b in source.bytes {
        bytes.append(b)
    }
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create("cm.byn", from: move bytes))
    let options = CmOptions { includeTests: false }
    return semantics.create(from: move sources, at: Path.fullPath("tmp"), by: in options)
}

test "common t29: the C types and keys of the builtin types" {
    var c = cmCompile("print(\"a\")\n")
    var cc = CCtx { packageRoot: c.packageRoot }
    assert cType(ref cc, from: ref c, for: semantics.builtinType(.ioStream)) == "int32_t"
    assert cType(ref cc, from: ref c, for: semantics.builtinType(.ioInput)) == "int32_t"
    assert cType(ref cc, from: ref c, for: semantics.builtinType(.io)) == "bynt_iostream"
    assert key(ref c, for: semantics.builtinType(.arena)) == "arena"
    assert key(ref c, for: semantics.builtinType(.processResult)) == "process"
    assert key(ref c, for: semantics.builtinType(.panic)) == "panic"
    assert key(ref c, for: semantics.builtinType(.formatSpec)) == "formatspec"
    assert key(ref c, for: semantics.builtinType(.time)) == "time"
    assert key(ref c, for: semantics.builtinType(.io)) == "iostream"
}

test "common t29: the keys of errors, views, states, ranges and dyn refs" {
    var c = cmCompile(
        """
        interface Shape {
            i64 area()
        }

        struct Box {
            i64 side
        }

        print("a")
        """,
    )
    let sets = List<semantics.ErrorSetId>()
    let excluded = List<semantics.VariantId>()
    assert key(ref c, for: semantics.errorUnionOf(ref c, for: in sets, as: in excluded)) == "err"
    assert key(ref c, for: semantics.textViewType(.runes)) == "textview"
    var shape = -1
    for i in 0..c.interfaces.length {
        shape = i if c.interfaces[i].name == "Shape"
    }
    var box = -1
    for i in 0..c.structs.length {
        box = i if c.structs[i].name == "Box"
    }
    assert key(ref c, for: semantics.internDynRef(ref c, by: shape, readOnly: false)) == "dyn_main__Shape"
    let states = List<semantics.VariantId>()
    assert key(ref c, for: semantics.internState(ref c, by: box, for: in states)) == "main__Box"
    assert key(ref c, for: semantics.internRange(ref c, by: semantics.prim(.i64))) == "tup3_i64_i64_bool"
}

test "common t29: mapLine writes a line once" {
    var c = cmCompile("print(\"a\")\n")
    let span = CmSpan { start: 12, length: 1 }
    var fn = -1
    for i in 0..c.functions.length {
        fn = i if fn == -1 && c.functions[i].file == 0
    }
    var f = CFunc { fn: fn, file: "byn_file_0", linePath: "\"cm.byn\"" }
    f.lineStarts.append(0)
    f.lineStarts.append(11)
    var sb = StrBuf()
    mapLine(ref sb, from: in c, through: ref f, at: span)
    mapLine(ref sb, from: in c, through: ref f, at: span)
    sb.append("x;\n")
    mapLine(ref sb, from: in c, through: ref f, at: span)
    assert sb.finish() == "#line 2 \"cm.byn\"\nx;\n#line 2 \"cm.byn\"\n"
}
