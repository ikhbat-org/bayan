import semantics
import emitter.ltree

type LaBAssert         = semantics.BAssert
type LaBInterpolated   = semantics.BInterpolated
type LaExprSyntax      = semantics.ExprSyntax
type LaLIndexUnchecked = ltree.LIndexUnchecked

string laEmit(string source) {
    var bytes = List<u8>()
    for b in source.bytes {
        bytes.append(b)
    }
    var c = t12Compile(Path.fullPath("tmp"), at: move bytes, for: "la.byn", by: false)
    var sb = StrBuf()
    for d in c.diagnostics {
        sb.append($"{d.code} {d.span.start} {d.message}\n") if !d.isWarning
    }
    let errors = sb.finish()
    return $"errors: {errors}" if errors != ""
    return t12Emit(ref c, by: "safe")
}

test "lowerassert t29: power asserts, writes, switches and tryFrom" {
    var sources = List<string>()
    sources.append(
        """
        union error F {
            a
            b
        }

        union Shape {
            circle(i64 r)
            none
        }

        struct Pt {
            i64 x = 0

            public i64 get() fails F {
                fail .a if this.x == 1
                return this.x
            }

            public static Pt make(i64 x) => Pt { x: x }
        }

        i64 pick(i64 x) fails F {
            fail .a if x == 1
            return x
        }

        i64 one() => 1

        i64 id(i64 x) => x

        i32 small() => 1

        bool yes() => true

        List<i64> list() => [1, 2]

        void a1() {
            let x = one()
            let y = one()
            let n = small()
            let b = yes()
            let xs = list()
            assert (x + 1) == 2
            assert (x == 2)
            assert (id(x)) == 2
            assert xs[0] == 2
            assert n == y
            assert x == (1) && x == -1 && x == -(2) && b == !true && x == -y && x == +3
            assert x > 5 || y > 5 || one() > 5
            assert x > 5 && (y > 5 || one() > 5)
            assert pick(x) fails F
            assert pick(x) fails F.a
            let p = Pt { x: 1 }
            assert p.get() fails F
            assert Pt.make(x).x == 2
            assert (b ? x : y) == 3
            let s = Shape.circle(x)
            assert s is .none
        }

        struct Pt2 {
            i64 x = 0

            public void check() {
                assert x == 1
            }
        }

        void a6() {
            let x = one()
            assert (pick(x)) fails F
            assert later() == 4
            assert apply(v => v + 1) == 2
        }

        i64 apply((i64) -> i64 f) {
            let g: (i64) -> i64 = v => f(v) + 1
            return g(1)
        }

        i64 later(i64 v = 1 + 2) => v

        void a2() {
            assert pick(id(panic("a"))) fails F
        }

        void a3() {
            let x = one()
            assert x == id(panic("a"))
        }

        void a4() {
            let b = yes()
            assert b || one() == id(panic("a"))
        }

        void main() {
        }
        """,
    )
    sources.append(
        """
        struct Pt {
            i64 x = 0
            List<i64> xs = []
        }

        struct Q {
            i64 x = 1
            i64 y = 2
        }

        i64 one() => 1

        i64 id(i64 x) => x

        List<i64> make() => [1]

        StrBuf buf() => StrBuf()

        void b1(ref List<StrBuf> sbs) {
            sbs[id(panic("a"))].append($"{one()}")
        }

        void b2(ref List<List<i64>> ls) {
            let t = ls[id(panic("a"))].take()
        }

        void b3(ref Map<i64, Q> m) {
            let q = m.slot(1)
            m.slot(2).x += 1
            m.slot(one()).x = 3
        }

        void b4() {
        }

        void b4b(ref List<i64> xs) {
            xs.append(id(panic("a")))
        }

        void b5() {
            let s = make().span
            let v = buf().view
        }

        void b6(ref Map<i64, List<i64>> ml) {
            var u = (make(), 1)
            let a = u.item1.take()
            let b = ml[one() + 1].take()
        }

        struct Cell<T> {
            i64 n = 3
        }

        void b10(ref Map<i64, Cell<i64>> m) {
            let q = m.slot(1)
        }

        void b7() {
            let x = one()
            panic($"x {x}")
        }

        void b8() {
            print($"{id(panic("a"))}")
        }

        void b9() {
            print($"{one()} {one()}", to: one() > 0 ? .stdout : .stderr)
        }

        void main() {
        }
        """,
    )
    sources.append(
        """
        i64 one() => 1

        i64 id(i64 x) => x

        bool ok(i64 x) => x > 0

        i64? opt(i64 x) => x

        f64 real() => 1.5

        f32 single() => 1.5

        i32 small() => 1

        void c1() {
            let x = id(panic("a")) switch {
                1 => 2,
                _ => 3,
            }
        }

        never c2(i64 v) => v switch {
            1 => panic("a"),
            _ => panic("b"),
        }

        void c3(i64 v) {
            let x = v switch {
                var w when (opt(w) ?? 0) > 1 => 2,
                var w when ok(w) => 4,
                _ => 3,
            }
        }

        void d1() {
            let a = i32.tryFrom(id(panic("a")))
        }

        void d2() {
            let b = i32.tryFrom(one())
            let c = i32.tryFrom(real())
            let d = i64.tryFrom(single())
            let e = i64.tryFrom(small())
            let h = f64.tryFrom(one())
        }

        void main() {
        }
        """,
    )
    assert laEmit(sources[0]).contains("failed with F.a")
    assert laEmit(sources[1]).contains("BYN_STR(\"x \", 2)")
    assert laEmit(sources[2]).contains("no switch arm matched")
}

/// A compiled program for the direct calls below, and a lowering context inside its `main`.
semantics.Ctx laCtx() {
    var bytes = List<u8>()
    let source = """
        union error F {
            a
        }

        struct R {
            i64 x
        }

        i64 one() => 1

        i64 pick(i64 x) fails F {
            fail .a if x == 1
            return x
        }

        List<i64> list() => [1]

        void maps(ref Map<i64, R> m) {
        }

        R mkR() => R { x: 1 }

        StrBuf buf() => StrBuf()

        void main() {
            assert one() == 1
        }
        """
    for b in source.bytes {
        bytes.append(b)
    }
    return t12Compile(Path.fullPath("tmp"), at: move bytes, for: "la.byn", by: false)
}

FuncId laFn(semantics.Ctx c, for string name) {
    for k in 0..c.functions.length {
        return k if c.functions[k].name == name
    }
    return -1
}

LCtx laLCtx(semantics.Ctx c) {
    var l = LCtx {}
    l.fn = laFn(c, for: "main")
    l.outs.append(List<BStmt>())
    return l
}

BExpr laLit(ref semantics.Ctx c, as i64 v) {
    return t5Literal(
        ref c,
        at: TextSpan { start: 0, length: 1 },
        by: semantics.prim(.i64),
        as: Constant { kind: .real, real: f64(v) },
    )
}

BExpr laCall(ref semantics.Ctx c, for string name) {
    let f = laFn(c, for: name)
    return semantics.addCall(
        ref c,
        from: BCall { span: TextSpan { start: 0, length: 1 }, function: f, type: c.functions[f].returnType },
    )
}

test "lowerassert t29: hand-built nodes" {
    var c = laCtx()
    assert c.diagnostics.length == 0
    var l = laLCtx(c)
    let span = TextSpan { start: 0, length: 1 }
    let lit = laLit(ref c, as: 7)
    let void = ltree.addLVoid(ref l.tree, from: T5LVoid { span: span })
    assert !t5IsBuiltin(c, for: void, by: .mapIndexSet)
    c.constants[lit] = Constant { kind: .real, real: 2.5 }
    let copy = t5Copied(ref c, from: lit, as: laLit(ref c, as: 8))
    assert c.constants[copy].real == 2.5
    let ov = ltree.addLOptionalValue(
        ref l.tree,
        from: T5LOptionalValue { span: span, optional: lit, type: semantics.prim(.i64) },
    )
    let s1 = lowerStable(ref c, through: ref l, for: ov)
    assert ltree.lKindOf(s1) == .optionalValue
    assert l.tree.optionalValues[ltree.lIndexOf(s1)].optional == lit
    assert lowerStable(ref c, through: ref l, for: void) == void
    let iu = ltree.addLIndexUnchecked(
        ref l.tree,
        from: LaLIndexUnchecked { span: span, target: lit, index: lit, type: semantics.prim(.i64) },
    ) because "a hand-built node the test never prints"
    assert lowerStable(ref c, through: ref l, for: iu) == iu
    let len = semantics.addBuiltinCall(
        ref c,
        from: BBuiltinCall {
            span: span,
            member: .listLength,
            receiver: laCall(ref c, for: "list"),
            type: semantics.prim(.i64),
        },
    )
    let s2 = lowerStable(ref c, through: ref l, for: len)
    assert semantics.boundKind(s2) == .local
    assert l.outs[0].length == 1
}

test "lowerassert t29: hand-built asserts and calls" {
    var c = laCtx()
    var l = laLCtx(c)
    let span = TextSpan { start: 0, length: 1 }
    let void = c.functions[laFn(c, for: "main")].returnType
    var flags = List<LocalId>()
    flags.append(newTemp(ref c, through: ref l, for: semantics.prim(.bool)))
    flags.append(newTemp(ref c, through: ref l, for: semantics.prim(.bool)))
    let piece = PowerAssertPiece { text: "", value: -1, allShown: [], noneShown: [], anyFrom: 0 }
    let g = t5Guard(ref c, through: l, for: piece, at: span, by: flags)
    assert c.bBinaries[g & 0xFFFFFFFF].op == .logicalOr
    var exprs = List<BExpr>()
    var mayNotRuns = List<bool>()
    let lit = laLit(ref c, as: 4)
    shown(c, through: l, for: lit, by: true, to: ref exprs, as: ref mayNotRuns)
    assert exprs.length == 1 && exprs[0] == lit && mayNotRuns[0]
    c.exprSyntaxNodes.append(LaExprSyntax { kind: .literalExpr, span: TextSpan { start: 3, length: 1 } })
    let inner = c.exprSyntaxNodes.length - 1
    let paren = LaExprSyntax { kind: .parenExpr, span: TextSpan { start: 2, length: 3 }, inner: inner }
    assert t5Anchor(c, through: l, for: paren, to: 10) == 3
    let condition = semantics.addBinary(
        ref c,
        from: BBinary {
            span: span,
            op: .eq,
            left: laLit(ref c, as: 1),
            right: laLit(ref c, as: 2),
            type: semantics.prim(.bool),
        },
    )
    let before = l.outs[0].length
    lowerAssert(
        ref c,
        through: ref l,
        for: semantics.addAssert(
            ref c,
            from: LaBAssert { span: TextSpan { start: 0, length: 5 }, condition: condition },
        ),
    )
    assert l.outs[0].length == before + 2
    let pick = laFn(c, for: "pick")
    let set = c.functions[pick].errorSets[0]
    var args = List<BExpr>()
    args.append(laLit(ref c, as: 5))
    let call = semantics.addCall(
        ref c,
        from: BCall { span: span, function: pick, arguments: move args, type: semantics.prim(.i64) },
    )
    let n1 = l.outs[0].length
    lowerAssert(
        ref c,
        through: ref l,
        for: semantics.addAssert(
            ref c,
            from: LaBAssert { span: TextSpan { start: 0, length: 5 }, condition: call, failsWith: set },
        ),
    )
    assert l.outs[0].length == n1 + 2
    var args2 = List<BExpr>()
    args2.append(laLit(ref c, as: 5))
    let call2 = semantics.addCall(
        ref c,
        from: BCall { span: span, function: pick, arguments: move args2, type: semantics.prim(.i64) },
    )
    c.exprSyntaxNodes.append(LaExprSyntax { kind: .nameExpr, span: TextSpan { start: 2, length: 1 } })
    c.exprSyntaxOf[call2] = c.exprSyntaxNodes.length - 1
    let n2 = l.outs[0].length
    lowerAssert(
        ref c,
        through: ref l,
        for: semantics.addAssert(
            ref c,
            from: LaBAssert { span: TextSpan { start: 0, length: 5 }, condition: call2, failsWith: set },
        ),
    )
    assert l.outs[0].length == n2 + 2
    var parts = List<BInterpolationPart>()
    parts.append(BInterpolationPart { value: laCall(ref c, for: "one") })
    let text = semantics.addInterpolated(ref c, from: LaBInterpolated { span: span, parts: move parts })
    let n3 = l.outs[0].length
    let w = lowerWriteParts(
        ref c,
        through: ref l,
        for: text,
        by: .print,
        to: -1,
        as: text,
        at: laCall(ref c, for: "one"),
    )
    assert ltree.lKindOf(w) == .voidValue
    assert l.outs[0].length == n3 + 3
    let noThis = semantics.addCall(
        ref c,
        from: BCall {
            span: span,
            function: laFn(c, for: "one"),
            receiver: laLit(ref c, as: 1),
            type: semantics.prim(.i64),
        },
    )
    let lowered = lowerCallParts(ref c, through: ref l, for: noThis)
    assert c.bCalls[lowered & 0xFFFFFFFF].receiver == -1
    var adds = List<BExpr>()
    adds.append(laLit(ref c, as: 3))
    let add = semantics.addBuiltinCall(
        ref c,
        from: BBuiltinCall {
            span: span,
            member: .listAdd,
            receiver: laCall(ref c, for: "list"),
            arguments: move adds,
            type: void,
        },
    )
    let n4 = l.outs[0].length
    assert ltree.lKindOf(lowerBuiltinCall(ref c, through: ref l, for: add)) == .voidValue
    assert l.outs[0].length == n4 + 2
    let m = c.functions[laFn(c, for: "maps")].parameters[0]
    var keys = List<BExpr>()
    keys.append(laLit(ref c, as: 1))
    let slot = semantics.addBuiltinCall(
        ref c,
        from: BBuiltinCall {
            span: span,
            member: .mapSlot,
            receiver: localExpr(ref c, at: span, for: m),
            arguments: move keys,
            type: c.functions[laFn(c, for: "mkR")].returnType,
        },
    )
    let s = lowerBuiltinCall(ref c, through: ref l, for: slot)
    assert c.bBuiltinCalls[s & 0xFFFFFFFF].arguments.length == 2
}
