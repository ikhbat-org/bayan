// 019 T29 (coverage ratchet): lexer.byn paths no golden case reaches. Each input is lexed and summarised as its tokens
// (`Kind start+length;`) and diagnostics (`code start+length message`, plus the fix); the expected text is the output of
// the self-hosted lexer at the commit that added the test.

List<u8> t29Bytes(string text) uses alloc {
    var bytes = List<u8>()
    for b in text.bytes {
        bytes.append(b)
    }
    return bytes
}

string t29Summary(ref LexResult r) uses alloc {
    var sb = StrBuf()
    for t in r.tokens {
        sb.append($"{kindName(t.kind)} {t.start}+{t.length};")
    }
    for d in r.diagnostics {
        sb.append($" {d.code} {d.span.start}+{d.span.length} {d.message}")
        if d.hasFix {
            sb.append(" fix ")
            escape(d.fixReplacement.bytes, to: ref sb)
        }
        sb.append(";")
    }
    return $"{sb.finish()}"
}

bool t29LexesTo(move List<u8> bytes, as string expected) uses alloc, console {
    var r = lex(SourceText.create("t.byn", from: move bytes), by: Keywords.build())
    let got = t29Summary(ref r)
    if got != expected {
        print($"T29GOT {got}")
    }
    return got == expected
}

/// The NFC form of `input` as space-separated hex code points.
string t29Nfc(ReadOnlySpan<u32> input) uses alloc {
    var sb = StrBuf()
    for cp in normalize(input) {
        sb.append($"{hex(cp, to: 4)} ")
    }
    return $"{sb.finish()}"
}

bool t29Is(string text, as string expected) uses alloc, console => t29LexesTo(t29Bytes(text), as: expected)

test "lexer t29: a byte order mark is skipped, other EF lead bytes are not" {
    assert t29Is("\u{FEFF}a", as: "Identifier 3+1;EndOfFile 4+0;")
    assert t29Is("\u{FEC0}", as: "Identifier 0+3;EndOfFile 3+0;")
    assert t29Is("\u{F6AA}", as: "EndOfFile 3+0; BYN0002 0+3 unexpected character `\u{F6AA}`;")
}

test "lexer t29: identifiers not in NFC get the composed form as their fix" {
    assert t29Is("가 각", as: "Identifier 0+3;Identifier 4+3;EndOfFile 7+0;")
    assert t29Is(
        "\u{1100}\u{1161}",
        as: "Identifier 0+6;EndOfFile 6+0; BYN0005 0+6 identifier `\u{1100}\u{1161}` is not in Unicode normalization form C fix `\u{AC00}`;",
    )
    assert t29Is(
        "\u{AC00}\u{11A8}",
        as: "Identifier 0+6;EndOfFile 6+0; BYN0005 0+6 identifier `\u{AC00}\u{11A8}` is not in Unicode normalization form C fix `\u{AC01}`;",
    )
    assert t29Is(
        "\u{F900}",
        as: "Identifier 0+3;EndOfFile 3+0; BYN0005 0+3 identifier `\u{F900}` is not in Unicode normalization form C fix `\u{8C48}`;",
    )
    assert t29Is(
        "x\u{301}\u{323}",
        as: "Identifier 0+5;EndOfFile 5+0; BYN0005 0+5 identifier `x\u{301}\u{323}` is not in Unicode normalization form C fix `x\u{323}\u{301}`;",
    )
    assert t29Is("a\u{316}\u{323}", as: "Identifier 0+5;EndOfFile 5+0;")
    assert t29Is(
        "\u{1E900}\u{1E900} \u{20000} \u{30000}",
        as: "Identifier 0+8;Identifier 9+4;Identifier 14+4;EndOfFile 18+0;",
    )
}

test "lexer t29: normalize composes, reorders and leaves an empty input empty" {
    var empty = List<u32>()
    compose(ref empty)
    assert empty.length == 0
    let marks = normalize([0x0301, 0x0041])
    assert marks.length == 2 && marks[0] == 0x0301 && marks[1] == 0x0041
    assert firstIsUpper("".bytes) == false && firstIsLower("".bytes) == false
    assert t29Nfc([0x0301, 0x0323]) == "0323 0301 "
    var sb = StrBuf()
    sb.append($"{t29Nfc([0x1100, 0x1100])};")
    sb.append($"{t29Nfc([0x1100, 0x11A8])};")
    sb.append($"{t29Nfc([0xAC01, 0x11A8])};")
    sb.append($"{t29Nfc([0xAC00, 0x11A7])};")
    sb.append($"{t29Nfc([0xAC00, 0x11C3])};")
    assert sb.finish() == "1100 1100 ;1100 11A8 ;AC01 11A8 ;AC00 11A7 ;AC00 11C3 ;"
}

test "lexer t29: non-ASCII after a number, in an identifier and as a token" {
    assert t29Is(
        "1é 1€ 1éé 1é€",
        as: "IntegerLiteral 0+1;NumericSuffix 1+2;IntegerLiteral 4+1;IntegerLiteral 9+1;NumericSuffix 10+4;IntegerLiteral 15+1;NumericSuffix 16+2;EndOfFile 21+0; BYN0002 5+3 unexpected character `€`; BYN0002 18+3 unexpected character `€`;",
    )
    var invalid = t29Bytes("1")
    invalid.append(0xFF)
    assert t29LexesTo(
        move invalid,
        as: "IntegerLiteral 0+1;EndOfFile 2+0; BYN0015 1+1 source is not valid UTF-8 (byte 0xFF);",
    )
    var suffixInvalid = t29Bytes("1é")
    suffixInvalid.append(0xFF)
    assert t29LexesTo(
        move suffixInvalid,
        as: "IntegerLiteral 0+1;NumericSuffix 1+2;EndOfFile 4+0; BYN0015 3+1 source is not valid UTF-8 (byte 0xFF);",
    )
    var identInvalid = t29Bytes("é")
    identInvalid.append(0xFF)
    assert t29LexesTo(
        move identInvalid,
        as: "Identifier 0+2;EndOfFile 3+0; BYN0015 2+1 source is not valid UTF-8 (byte 0xFF);",
    )
    assert t29Is(
        "é€ € ⁁ \u{206A} \u{7F} a\u{E0100}\u{F0000}",
        as: "Identifier 0+2;Identifier 20+5;EndOfFile 29+0; BYN0002 2+3 unexpected character `€`; BYN0002 6+3 unexpected character `€`; BYN0002 10+3 unexpected character `⁁`; BYN0002 14+3 unexpected character `\u{206A}`; BYN0002 18+1 unexpected character `\\u{7F}`; BYN0002 25+4 unexpected character `\u{F0000}`;",
    )
}

test "lexer t29: an E2 80 sequence past the bidi controls is an unexpected character" {
    assert t29Is("\u{202F}", as: "EndOfFile 3+0; BYN0002 0+3 unexpected character `\u{202F}`;")
}

test "lexer t29: operators and numbers at their edges" {
    assert t29Is(
        "?.5 1e+x 0b0 0bz",
        as: "Question 0+1;Dot 1+1;IntegerLiteral 2+1;IntegerLiteral 4+1;NumericSuffix 5+1;Plus 6+1;Identifier 7+1;IntegerLiteral 9+3;IntegerLiteral 13+1;NumericSuffix 14+2;EndOfFile 16+0;",
    )
}

test "lexer t29: comments, shebangs and block comment fixes" {
    assert t29Is("// x", as: "EndOfFile 4+0;")
    assert t29Is("/* a*b */", as: "EndOfFile 9+0; BYN1047 0+9 `/* */` is an input form; write `//` lines fix `// a*b`;")
    assert t29Is(" #!x", as: "Hash 1+1;Bang 2+1;Identifier 3+1;EndOfFile 4+0;")
    assert t29Is("#!x", as: "EndOfFile 3+0;")
    assert t29Is("\t/* a */", as: "EndOfFile 8+0; BYN1047 1+7 `/* */` is an input form; write `//` lines fix `// a`;")
    assert t29Is("/**/", as: "EndOfFile 4+0; BYN1047 0+4 `/* */` is an input form; write `//` lines fix `//`;")
    assert t29Is(
        "/*\t\r a \t\r\n b */",
        as: "EndOfFile 15+0; BYN1047 0+15 `/* */` is an input form; write `//` lines fix `// a\\n// b`;",
    )
    assert t29Is(
        "/*\n a\n\n b\n */ \t\rx",
        as: "Identifier 16+1;EndOfFile 17+0; BYN1047 0+13 `/* */` is an input form; write `//` lines fix `// a\\n//\\n// b\\n`;",
    )
}

test "lexer t29: unterminated strings, chars and interpolations" {
    assert t29Is("\"abc", as: "StringLiteral 0+4;EndOfFile 4+0; BYN0003 0+4 unterminated string literal;")
    assert t29Is("\"ab\r\n", as: "StringLiteral 0+3;EndOfFile 5+0; BYN0003 0+3 unterminated string literal;")
    assert t29Is(
        "$\"ab",
        as: "InterpolatedStringStart 0+2;InterpolatedStringText 2+2;InterpolatedStringEnd 4+0;EndOfFile 4+0; BYN0003 0+2 unterminated string literal;",
    )
    assert t29Is(
        "$\"ab\nx",
        as: "InterpolatedStringStart 0+2;InterpolatedStringText 2+2;InterpolatedStringEnd 4+0;Identifier 5+1;EndOfFile 6+0; BYN0003 0+2 unterminated string literal;",
    )
    assert t29Is("'ab", as: "CharLiteral 0+3;EndOfFile 3+0; BYN0008 0+3 unterminated char literal;")
}

test "lexer t29: escapes" {
    assert t29Is(
        "\"\\",
        as: "StringLiteral 0+2;EndOfFile 2+0; BYN0006 1+1 invalid escape sequence `\\`; BYN0003 0+2 unterminated string literal;",
    )
    assert t29Is(
        "\"\\\n\"",
        as: "StringLiteral 0+2;StringLiteral 3+1;EndOfFile 4+0; BYN0006 1+1 invalid escape sequence `\\`; BYN0003 0+2 unterminated string literal; BYN0003 3+1 unterminated string literal;",
    )
    assert t29Is("\"\\uz\"", as: "StringLiteral 0+5;EndOfFile 5+0; BYN0006 1+2 invalid escape sequence `\\u`;")
    assert t29Is(
        "\"\\u{",
        as: "StringLiteral 0+4;EndOfFile 4+0; BYN0006 1+3 invalid escape sequence `\\u{`; BYN0003 0+4 unterminated string literal;",
    )
    assert t29Is(
        "\"\\u{123456789}\"",
        as: "StringLiteral 0+15;EndOfFile 15+0; BYN0006 1+11 invalid escape sequence `\\u{12345678`;",
    )
    assert t29Is("\"\\u{}\"", as: "StringLiteral 0+6;EndOfFile 6+0; BYN0006 1+3 invalid escape sequence `\\u{`;")
    assert t29Is("\"\\u{12x\"", as: "StringLiteral 0+8;EndOfFile 8+0; BYN0006 1+5 invalid escape sequence `\\u{12`;")
    assert t29Is(
        "\"\\u{0000041}\"",
        as: "StringLiteral 0+13;EndOfFile 13+0; BYN0013 1+11 `\\u{0000041}` is not a Unicode scalar value;",
    )
    assert t29Is(
        "\"\\u{a}\\u{G}\"",
        as: "StringLiteral 0+12;EndOfFile 12+0; BYN0006 6+3 invalid escape sequence `\\u{`;",
    )
    assert t29Is(
        "\"\\u{:}\\u{ }\"",
        as: "StringLiteral 0+12;EndOfFile 12+0; BYN0006 1+3 invalid escape sequence `\\u{`; BYN0006 6+3 invalid escape sequence `\\u{`;",
    )
}

test "lexer low041: CR LF ends a bad escape, an interpolated text and a char without keeping the CR" {
    assert t29Is("\"abc\\\r\n", as: "StringLiteral 0+5;EndOfFile 7+0; BYN0006 4+1 invalid escape sequence `\\`; BYN0003 0+5 unterminated string literal;")
    assert t29Is("$\"ab\r\n", as: "InterpolatedStringStart 0+2;InterpolatedStringText 2+2;InterpolatedStringEnd 4+0;EndOfFile 6+0; BYN0003 0+2 unterminated string literal;")
    assert t29Is("'a\r\n", as: "CharLiteral 0+2;EndOfFile 4+0; BYN0008 0+2 unterminated char literal;")
}

test "lexer low041: a doc span drops the CR and stops at a plain comment" {
    let r = lex(SourceText.create("t.byn", from: t29Bytes("/// Summary\r\nx")), by: Keywords.build())
    assert r.tokens[0].docStart == 0 && r.tokens[0].docLength == 11
    let s = lex(SourceText.create("t.byn", from: t29Bytes("/// doc1\n// regular\n/// doc2\nx")), by: Keywords.build())
    assert s.tokens[0].docStart == 20 && s.tokens[0].docLength == 8
}
