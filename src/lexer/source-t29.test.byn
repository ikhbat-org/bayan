// 019 T29 (coverage ratchet): source.byn paths no golden case reaches: the invalid and truncated UTF-8 sequences of
// `decodeAt`, a CR LF line end, `lineCount` and zero-padded `hex`. The expected text is the output of the self-hosted lexer
// at the commit that added the test.

/// `value+length valid` of the step `decodeAt` takes at the start of `values` (each a byte).
string t29Decode(ReadOnlySpan<i64> values) uses alloc {
    var bytes = List<u8>()
    for v in values {
        bytes.append(u8(v))
    }
    let d = decodeAt(bytes.span, at: 0)
    return $"{hex(d.value, to: 1)}+{d.length} {d.valid}"
}

test "lexer t29: decodeAt takes the maximal invalid subpart of a bad sequence" {
    var sb = StrBuf()
    sb.append($"{t29Decode([0xC3])}\n")
    sb.append($"{t29Decode([0xC3, 0x41])}\n")
    sb.append($"{t29Decode([0xE0, 0x80, 0x80])}\n")
    sb.append($"{t29Decode([0xED, 0xA0, 0x80])}\n")
    sb.append($"{t29Decode([0xE2, 0x82, 0x41])}\n")
    sb.append($"{t29Decode([0xF0, 0x80, 0x80, 0x80])}\n")
    sb.append($"{t29Decode([0xF0, 0x90, 0x41])}\n")
    sb.append($"{t29Decode([0xF0, 0x90, 0x80, 0x41])}\n")
    sb.append($"{t29Decode([0xF4, 0x90, 0x80, 0x80])}\n")
    sb.append($"{t29Decode([0xF4, 0x8F, 0xBF, 0xBF])}\n")
    let expected = """
            FFFD+1 false
            FFFD+1 false
            FFFD+1 false
            FFFD+1 false
            FFFD+2 false
            FFFD+1 false
            FFFD+2 false
            FFFD+3 false
            FFFD+1 false
            10FFFF+4 true

            """
    assert sb.finish() == expected
}

test "lexer t29: a CR LF line end, the line count and padded hex" {
    var bytes = List<u8>()
    for b in "a\r\nb".bytes {
        bytes.append(b)
    }
    var source = SourceText.create("t.byn", from: move bytes)
    assert source.lineCount() == 2
    let first = source.getLineSpan(0)
    assert first.start == 0 && first.length == 1
    assert hex(0x12345678, to: 1) == "12345678"
    assert hex(0xA, to: 4) == "000A"
}
