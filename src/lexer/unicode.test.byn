// LexerTests.cs:33 `SyntaxTakesUnicodeDataOnlyFromGeneratedTables` (019 T30f part 4): the C# test bans the .NET Unicode calls
// (`Normalize(`, `IsNormalized(`, `GetUnicodeCategory`) in csharp/Bayan.Syntax. Bayān's runtime has no such call; its Unicode
// data is the code point range tables (`u32[` constants) of the generated src/lexer/unicode-tables.byn, so the syntax sources
// (src/lexer, src/parser) hold no such table outside that file, and that file carries the generator's header. Run from the
// repo root, as `bayan test --package src src/lexer` is.

test "lexer: syntax takes Unicode data only from the generated tables" {
    let generated = Io.readText(Path.fullPath("src/lexer/unicode-tables.byn")) catch ""
    assert generated.startsWith("// Generated by tools/Bayan.UnicodeGen; do not edit.\n")
    var offenders = List<string>()
    var seen: i64 = 0
    for dir in ["src/lexer", "src/parser"] {
        var names = Io.listDir(Path.fullPath(dir)) catch List<string>()
        names.sort()
        for name in names {
            continue if !name.endsWith(".byn") || name.endsWith(".test.byn") || name == "unicode-tables.byn"
            seen += 1
            let text = Io.readText(Path.fullPath(Path.combine(dir, name))) catch ""
            if text.contains(": u32[") {
                offenders.append($"{dir}/{name}")
            }
        }
    }
    assert seen > 0
    assert offenders.length == 0
}
