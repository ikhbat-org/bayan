// sabk phase 1 (spec 024): `encode` turns one `Inst` into its 4-byte arm64 word. Field layouts are the ARM Architecture
// Reference Manual's; the tests check every form against the reference assembler's bytes (`testdata/encodings.tsv`).
// An operand the form cannot hold is an `EncodeError` naming the mnemonic and operand, never a truncated word.

/// The word for `inst`. A branch or `adr` target is encoded with offset 0: the label fixup (T5) or the relocation fills it.
public u32 encode(Inst inst) uses alloc fails EncodeError => try encodeAt(inst, at: 0)

/// The word for `inst` with `offset` bytes from the instruction to its target; `offset` is read by `b`, `bl`, `b.cond`,
/// `cbz`, `cbnz` and `adr` only.
public u32 encodeAt(Inst inst, at i64 offset) uses alloc fails EncodeError {
    switch inst {
        case .movz(let width, let rd, let imm, let shift):
            return try moveWide("movz", from: 0x52800000, at: width, to: rd, by: imm, for: shift)
        case .movk(let width, let rd, let imm, let shift):
            return try moveWide("movk", from: 0x72800000, at: width, to: rd, by: imm, for: shift)
        case .movReg(let width, let rd, let rm):
            return sf(width, from: 0x2A0003E0) | ((try reg(rm, for: "mov", as: "rm", at: width, allowSp: false, allowZr: true)) << 16) | (try reg(rd, for: "mov", as: "rd", at: width, allowSp: false, allowZr: true))
        case .movSp(let rd, let rn):
            return 0x91000000 | ((try reg(rn, for: "mov", as: "rn", at: .x, allowSp: true, allowZr: false)) << 5) | (try reg(rd, for: "mov", as: "rd", at: .x, allowSp: true, allowZr: false))
        case .addImm(let width, let rd, let rn, let imm12, let shift12):
            return try arithImm("add", from: 0x11000000, at: width, to: rd, by: rn, for: imm12, rdSp: true, shift12: shift12)
        case .subImm(let width, let rd, let rn, let imm12, let shift12):
            return try arithImm("sub", from: 0x51000000, at: width, to: rd, by: rn, for: imm12, rdSp: true, shift12: shift12)
        case .subsImm(let width, let rd, let rn, let imm12, let shift12):
            return try arithImm("subs", from: 0x71000000, at: width, to: rd, by: rn, for: imm12, rdSp: false, shift12: shift12)
        case .cmpImm(let width, let rn, let imm12, let shift12):
            return try arithImm("cmp", from: 0x71000000, at: width, to: Reg { kind: .zero, number: 31 }, by: rn, for: imm12, rdSp: false, shift12: shift12)
        case .addReg(let width, let rd, let rn, let rm, let shift, let amount):
            return try shifted("add", from: 0x0B000000, at: width, to: rd, by: rn, for: rm, as: shift, through: amount)
        case .subReg(let width, let rd, let rn, let rm, let shift, let amount):
            return try shifted("sub", from: 0x4B000000, at: width, to: rd, by: rn, for: rm, as: shift, through: amount)
        case .subsReg(let width, let rd, let rn, let rm, let shift, let amount):
            return try shifted("subs", from: 0x6B000000, at: width, to: rd, by: rn, for: rm, as: shift, through: amount)
        case .cmpReg(let width, let rn, let rm, let shift, let amount):
            return try shifted("cmp", from: 0x6B000000, at: width, to: Reg { kind: .zero, number: 31 }, by: rn, for: rm, as: shift, through: amount)
        case .andReg(let width, let rd, let rn, let rm, let shift, let amount):
            return try shifted("and", from: 0x0A000000, at: width, to: rd, by: rn, for: rm, as: shift, through: amount)
        case .orrReg(let width, let rd, let rn, let rm, let shift, let amount):
            return try shifted("orr", from: 0x2A000000, at: width, to: rd, by: rn, for: rm, as: shift, through: amount)
        case .eorReg(let width, let rd, let rn, let rm, let shift, let amount):
            return try shifted("eor", from: 0x4A000000, at: width, to: rd, by: rn, for: rm, as: shift, through: amount)
        case .mul(let width, let rd, let rn, let rm):
            return try threeReg("mul", from: 0x1B007C00, at: width, to: rd, by: rn, for: rm)
        case .sdiv(let width, let rd, let rn, let rm):
            return try threeReg("sdiv", from: 0x1AC00C00, at: width, to: rd, by: rn, for: rm)
        case .msub(let width, let rd, let rn, let rm, let ra):
            return (try threeReg("msub", from: 0x1B008000, at: width, to: rd, by: rn, for: rm)) | ((try reg(ra, for: "msub", as: "ra", at: width, allowSp: false, allowZr: true)) << 10)
        case .neg(let width, let rd, let rm):
            return sf(width, from: 0x4B0003E0) | ((try reg(rm, for: "neg", as: "rm", at: width, allowSp: false, allowZr: true)) << 16) | (try reg(rd, for: "neg", as: "rd", at: width, allowSp: false, allowZr: true))
        case .cset(let width, let rd, let cond):
            // cset is csinc rd, zr, zr, !cond; `al` has no inverse.
            if cond == .al { fail .refused("cset", "cond al has no inverse condition") }
            return sf(width, from: 0x1A9F07E0) | ((condition(cond) ^ 1) << 12) | (try reg(rd, for: "cset", as: "rd", at: width, allowSp: false, allowZr: true))
        case .csel(let width, let rd, let rn, let rm, let cond):
            return (try threeReg("csel", from: 0x1A800000, at: width, to: rd, by: rn, for: rm)) | (condition(cond) << 12)
        case .ldrImm(let width, let rt, let rn, let disp):
            return try memImm("ldr", from: 0xB9400000, at: width, to: rt, by: rn, for: disp)
        case .strImm(let width, let rt, let rn, let disp):
            return try memImm("str", from: 0xB9000000, at: width, to: rt, by: rn, for: disp)
        case .ldur(let width, let rt, let rn, let disp):
            return try memUnscaled("ldur", from: 0xB8400000, at: width, to: rt, by: rn, for: disp)
        case .stur(let width, let rt, let rn, let disp):
            return try memUnscaled("stur", from: 0xB8000000, at: width, to: rt, by: rn, for: disp)
        case .stp(let mode, let rt, let rt2, let rn, let disp):
            return try pair("stp", from: (mode == .offset ? 0xA9000000 : mode == .pre ? 0xA9800000 : 0xA8800000), at: rt, to: rt2, by: rn, for: disp)
        case .ldp(let mode, let rt, let rt2, let rn, let disp):
            return try pair("ldp", from: (mode == .offset ? 0xA9400000 : mode == .pre ? 0xA9C00000 : 0xA8C00000), at: rt, to: rt2, by: rn, for: disp)
        case .b(let _):
            return 0x14000000 | (try wordOffset("b", from: offset, at: 26))
        case .bl(let _):
            return 0x94000000 | (try wordOffset("bl", from: offset, at: 26))
        case .bCond(let cond, let _):
            return 0x54000000 | ((try wordOffset("b.cond", from: offset, at: 19)) << 5) | condition(cond)
        case .cbz(let width, let rt, let _):
            return sf(width, from: 0x34000000) | ((try wordOffset("cbz", from: offset, at: 19)) << 5) | (try reg(rt, for: "cbz", as: "rt", at: width, allowSp: false, allowZr: true))
        case .cbnz(let width, let rt, let _):
            return sf(width, from: 0x35000000) | ((try wordOffset("cbnz", from: offset, at: 19)) << 5) | (try reg(rt, for: "cbnz", as: "rt", at: width, allowSp: false, allowZr: true))
        case .br(let rn):
            return 0xD61F0000 | ((try reg(rn, for: "br", as: "rn", at: .x, allowSp: false, allowZr: false)) << 5)
        case .blr(let rn):
            return 0xD63F0000 | ((try reg(rn, for: "blr", as: "rn", at: .x, allowSp: false, allowZr: false)) << 5)
        case .ret(let rn):
            return 0xD65F0000 | ((try reg(rn, for: "ret", as: "rn", at: .x, allowSp: false, allowZr: false)) << 5)
        case .adrp(let rd, let _):
            return 0x90000000 | (try reg(rd, for: "adrp", as: "rd", at: .x, allowSp: false, allowZr: true))
        case .addPageOff(let rd, let rn, let _):
            return 0x91000000 | ((try reg(rn, for: "add", as: "rn", at: .x, allowSp: true, allowZr: false)) << 5) | (try reg(rd, for: "add", as: "rd", at: .x, allowSp: true, allowZr: false))
        case .adr(let rd, let _):
            // The byte offset is a signed 21-bit value split into immlo (2 bits) and immhi (19 bits).
            if offset < -1048576 || offset > 1048575 {
                fail .refused("adr", $"operand target: offset {offset} is outside -1048576..1048575 (+-1 MiB)")
            }
            let imm = u32(offset & 0x1FFFFF)
            return 0x10000000 | ((imm & 3) << 29) | ((imm >> 2) << 5) | (try reg(rd, for: "adr", as: "rd", at: .x, allowSp: false, allowZr: true))
    }
}

/// `base` is the 32-bit form; the 64-bit form sets `sf` (bit 31).
u32 sf(Width width, from u32 base) => width == .x ? base | 0x80000000 : base

/// The 4-bit condition field.
u32 condition(Cond cond) {
    switch cond {
        case .eq: return 0
        case .ne: return 1
        case .hs: return 2
        case .lo: return 3
        case .mi: return 4
        case .pl: return 5
        case .vs: return 6
        case .vc: return 7
        case .hi: return 8
        case .ls: return 9
        case .ge: return 10
        case .lt: return 11
        case .gt: return 12
        case .le: return 13
        case .al: return 14
    }
}

/// The register number of `r` for operand `operand` of `mnemonic`. Register 31 is `sp` only where `allowSp` (64-bit
/// forms), the zero register only where `allowZr`; a general register is `x0`-`x30`.
u32 reg(Reg r, for string mnemonic, as string operand, at Width width, bool allowSp, bool allowZr) uses alloc fails EncodeError {
    switch r.kind {
        case .general:
            if r.number > 30 {
                fail .refused(mnemonic, $"operand {operand}: register number {r.number} is outside x0-x30")
            }
        case .sp:
            unless allowSp {
                fail .refused(mnemonic, $"operand {operand}: sp is not allowed here, need a general register")
            }
            if width != .x || r.number != 31 {
                fail .refused(mnemonic, $"operand {operand}: sp needs the 64-bit form")
            }
        case .zero:
            unless allowZr {
                fail .refused(mnemonic, $"operand {operand}: xzr/wzr is not allowed here, need a register or sp")
            }
            unless r.number == 31 {
                fail .refused(mnemonic, $"operand {operand}: the zero register is register 31")
            }
    }
    return u32(r.number)
}

// `imm` is a `u16`, so an immediate above 65535 cannot reach here; only `shift` can be out of range.
u32 moveWide(string mnemonic, from u32 base, at Width width, to Reg rd, by u16 imm, for u8 shift) uses alloc fails EncodeError {
    let limit: u8 = width == .x ? 48 : 16
    if shift % 16 != 0 || shift > limit {
        let allowed = width == .x ? "0, 16, 32 or 48" : "0 or 16"
        fail .refused(mnemonic, $"operand shift: {shift} is not {allowed} for this width")
    }
    return sf(width, from: base) | (u32(shift / 16) << 21) | (u32(imm) << 5) | (try reg(rd, for: mnemonic, as: "rd", at: width, allowSp: false, allowZr: true))
}

/// add/sub/subs/cmp with a 12-bit immediate: `rn` may be `sp`, `rd` is `sp` only for add/sub (`rdSp`).
u32 arithImm(string mnemonic, from u32 base, at Width width, to Reg rd, by Reg rn, for u16 imm12, bool rdSp, bool shift12) uses alloc fails EncodeError {
    if imm12 > 4095 {
        fail .refused(mnemonic, $"operand imm12: {imm12} is outside 0..4095")
    }
    let rdn = try reg(rd, for: mnemonic, as: "rd", at: width, allowSp: rdSp, allowZr: !rdSp)
    let rnn = try reg(rn, for: mnemonic, as: "rn", at: width, allowSp: true, allowZr: false)
    return sf(width, from: base) | (shift12 ? 0x400000 : 0) | (u32(imm12) << 10) | (rnn << 5) | rdn
}

/// add/sub/subs/cmp/and/orr/eor with a shifted register: no `sp`, the zero register allowed.
u32 shifted(string mnemonic, from u32 base, at Width width, to Reg rd, by Reg rn, for Reg rm, as ShiftKind shift, through u8 amount) uses alloc fails EncodeError {
    let limit: u8 = width == .x ? 63 : 31
    if amount > limit {
        fail .refused(mnemonic, $"operand shift amount: {amount} is outside 0..{limit}")
    }
    let kind: u32 = shift == .lsl ? 0 : shift == .lsr ? 1 : 2
    let rdn = try reg(rd, for: mnemonic, as: "rd", at: width, allowSp: false, allowZr: true)
    let rnn = try reg(rn, for: mnemonic, as: "rn", at: width, allowSp: false, allowZr: true)
    let rmn = try reg(rm, for: mnemonic, as: "rm", at: width, allowSp: false, allowZr: true)
    return sf(width, from: base) | (kind << 22) | (rmn << 16) | (u32(amount) << 10) | (rnn << 5) | rdn
}

/// The `rm`, `rn`, `rd` fields of a three-register form (mul, sdiv, msub, csel).
u32 threeReg(string mnemonic, from u32 base, at Width width, to Reg rd, by Reg rn, for Reg rm) uses alloc fails EncodeError {
    let rdn = try reg(rd, for: mnemonic, as: "rd", at: width, allowSp: false, allowZr: true)
    let rnn = try reg(rn, for: mnemonic, as: "rn", at: width, allowSp: false, allowZr: true)
    let rmn = try reg(rm, for: mnemonic, as: "rm", at: width, allowSp: false, allowZr: true)
    return sf(width, from: base) | (rmn << 16) | (rnn << 5) | rdn
}

/// ldr/str with an unsigned offset, a multiple of the access size (8 for x, 4 for w), at most 4095 accesses.
u32 memImm(string mnemonic, from u32 base, at Width width, to Reg rt, by Reg rn, for u16 offset) uses alloc fails EncodeError {
    let size: u16 = width == .x ? 8 : 4
    if offset % size != 0 || offset / size > 4095 {
        fail .refused(mnemonic, $"operand offset: {offset} is not a multiple of {size} in 0..{size * 4095}")
    }
    let rtn = try reg(rt, for: mnemonic, as: "rt", at: width, allowSp: false, allowZr: true)
    let rnn = try reg(rn, for: mnemonic, as: "rn", at: .x, allowSp: true, allowZr: false)
    let word = width == .x ? base | 0x40000000 : base
    return word | (u32(offset / size) << 10) | (rnn << 5) | rtn
}

/// ldur/stur with a signed 9-bit byte offset.
u32 memUnscaled(string mnemonic, from u32 base, at Width width, to Reg rt, by Reg rn, for i16 offset) uses alloc fails EncodeError {
    if offset < -256 || offset > 255 {
        fail .refused(mnemonic, $"operand offset: {offset} is outside -256..255")
    }
    let rtn = try reg(rt, for: mnemonic, as: "rt", at: width, allowSp: false, allowZr: true)
    let rnn = try reg(rn, for: mnemonic, as: "rn", at: .x, allowSp: true, allowZr: false)
    let word = width == .x ? base | 0x40000000 : base
    return word | (u32(i64(offset) & 0x1FF) << 12) | (rnn << 5) | rtn
}

/// stp/ldp of two x registers: a signed offset, a multiple of 8, -512..504; `mode` picks the base word.
u32 pair(string mnemonic, from u32 word, at Reg rt, to Reg rt2, by Reg rn, for i16 offset) uses alloc fails EncodeError {
    if offset % 8 != 0 || offset < -512 || offset > 504 {
        fail .refused(mnemonic, $"operand offset: {offset} is not a multiple of 8 in -512..504")
    }
    let rtn = try reg(rt, for: mnemonic, as: "rt", at: .x, allowSp: false, allowZr: true)
    let rt2n = try reg(rt2, for: mnemonic, as: "rt2", at: .x, allowSp: false, allowZr: true)
    let rnn = try reg(rn, for: mnemonic, as: "rn", at: .x, allowSp: true, allowZr: false)
    return word | (u32(i64(offset / 8) & 0x7F) << 15) | (rt2n << 10) | (rnn << 5) | rtn
}

/// A branch byte offset as a signed `bits`-bit word count, masked to its field; a multiple of 4.
u32 wordOffset(string mnemonic, from i64 offset, at i64 bits) uses alloc fails EncodeError {
    let limit = 1 << (bits - 1)
    if offset % 4 != 0 {
        fail .refused(mnemonic, $"operand target: offset {offset} is not a multiple of 4")
    }
    let words = offset / 4
    if words < -limit || words >= limit {
        fail .refused(mnemonic, $"operand target: offset {offset} is outside {-limit * 4}..{limit * 4 - 4}")
    }
    return u32(words & (limit * 2 - 1))
}
