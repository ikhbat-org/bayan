// The short `bayan --help` and the per-command help (owner decision 2026-11-16): the top-level text, the `-h`, `help` and
// `--help` spellings, `help <command>` against `<command> --help`, every flag of the old 62-line help in some command's help,
// `-v` and an unknown `help <command>`. The spellings run through `$BAYAN_EXE` as a child process.

/// The 62-line `bayan --help` before the owner decision of 2026-11-16, kept to check no flag was lost.
const helpOld: string = """
usage: bayan <command> [args]

commands:
  new <name>           create an app in a new directory [--lib|--script] [--vcs git|none] [--ci github|none]
  init [<dir>]         add a project's missing files to a directory (same options as new)
  lex [--json] <file>  print the token stream [--json: as one JSON object] (`-` reads stdin)
  parse [--ast] <file> check syntax; with --ast print the syntax tree
  types <path>         print each function's parameter and local types as JSON
  check <path>         report diagnostics for a program (a file or directory)
  build <path>         compile to an executable [-o <file>] [--mode debug|safe|fast] [--target <t>] [--emit-c]
                       [-v: print each phase's time and the output path]
  run <path>           compile and run [--mode debug|safe|fast] [-- <program args>]
  test <path>          compile and run the tests, each in its own process [--mode debug|safe|fast]
                       [--json: print the results as JSON instead]
                       [--changed [--base <ref>]: only modules with files changed since HEAD or <ref>]
                       [--only <text>: only tests whose name contains <text>; repeatable]
                       [-v: also list the passing and pending tests]
                       [--mutate: run every mutant against the tests that reach it; with --run <cmd>, run <cmd> once
                       per mutant instead, with BAYAN_MUTANT set (exit 0 survived, non-zero killed)]
  mutate --binary <exe> --sites <map.json> -- <cmd>
                       run <cmd> once per mutant site of a prebuilt --mutate binary, as test --mutate --run does
  dist [<dir>]         build release binaries into dist/<version>/ [--target <t>|all] [--mode m]
                       [--force: rebuild an existing version] [--allow-dirty: build from a dirty git tree]
  clean [<dir>]        remove out/ [--dist: also dist/] [--cache: also the global build cache]
  cache stats          show the shared build cache's location and size
  format <path>        rewrite input forms (those with a fix-it) in a `.byn` file or a directory of them,
                       and booleans and primitives to `style` in `package.byn` [--check: list, don't write]
  fix [<path>…]        apply every style lint's fix (whatever its severity in `lints`) to `.byn` files
                       or directories of them (default: the current directory); does not format
  audit <path>         list every `because` bypass and `unsafe` or `extern` declaration, with its reason
  features --used <path>
                       print the syntax node kinds, builtins and diagnostics a build touched, as JSON
  explain <code>       explain a diagnostic, e.g. `bayan explain BYN0003`
  <script>.byn         run a script, so `#!/usr/bin/env bayan` works
  doctor               check the C compiler, zig, git and the build cache, with fixes
  --version            print the compiler version and the commit it was built from
  --help               print this message

check, types, build, run, test and features take a project directory (one with `package.byn`; the
default inside a project), a script (a file starting with `#!`), or a file or directory of `.byn` files.

options for every command:
  --color auto|always|never
                       color for terminals (auto: on unless piped or NO_COLOR is set;
                       FORCE_COLOR turns it on, TERM=dumb off)
  --ascii              use ASCII symbols instead of ◆ ✗ │ (also with TERM=dumb or a non-UTF-8 locale)

options for check, types, build, run and test:
  --all                show every error instead of the first 20 (JSON is never capped)
  --diagnostics json   print each diagnostic to stderr as one JSON object per line
                       (code, severity, file, span, message, label, help, fixes)

exit codes:
  0  success
  1  compile errors
  2  usage errors (unknown command or option, missing path)
  3  test failures, or a coverage or mutation score below its minimum
  4  toolchain problems (no C compiler, unwritable cache, C compiler failure)

`bayan run` exits 1 when compilation fails and otherwise passes the program's own exit code
through unchanged, so it cannot tell a build failure from a program that exits 1. When that
matters, run `bayan build` first or read `--diagnostics json`.
"""

/// The commands `commandHelp` describes.
List<string> helpCommands() uses alloc => [
    "new", "init", "build", "run", "test", "check", "types", "features", "mutate", "lex", "parse", "format", "fix", "audit",
    "explain", "doctor", "clean", "cache", "dist",
]

/// The lines of `text`, split at each LF.
List<string> helpLines(string text) uses alloc {
    var lines = List<string>()
    var start: i64 = 0
    for i in 0..text.length {
        if text.bytes[i] == 0x0a {
            lines.append(text[start..i])
            start = i + 1
        }
    }
    lines.append(text[start..text.length])
    return lines
}

/// The columns of `line`: its UTF-8 bytes that start a character.
i64 helpWidth(string line) {
    var width: i64 = 0
    for c in line.bytes {
        width += 1 if (c & 0xc0) != 0x80
    }
    return width
}

/// The driver with `args`, run from the repo root.
GoldenOutcome helpRun(List<string> args) uses alloc, clock, console, env, fs, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    print(failure) if exe == ""
    assert(exe != "")
    let o = goldenChild(exe, by: in args, at: Path.fullPath("."), from: in List<u8>(), through: ref failure)
    print(failure) if failure != ""
    assert(failure == "")
    return GoldenOutcome { stdout: goldenLf(o.stdout), stderr: goldenLf(o.stderr), exitCode: o.exitCode }
}

/// True for a byte of a flag's name: a lowercase letter, a digit or `-`.
bool helpFlagByte(u8 c) => c is 0x61..=0x7a || c is 0x30..=0x39 || c == 0x2d

/// The flags of `text`: each `-x` or `--name` that starts after a space, `[`, `(`, `|` or a backquote.
List<string> helpFlags(string text) uses alloc {
    var flags = List<string>()
    let b = text.bytes
    var i: i64 = 1
    while i + 1 < b.length {
        let before = b[i - 1]
        let starts = b[i] == 0x2d && (before is 0x20 or 0x5b or 0x28 or 0x7c or 0x60)
        if starts && (b[i + 1] == 0x2d || b[i + 1] is 0x61..=0x7a) {
            var j = i + 1
            while j < b.length && helpFlagByte(b[j]) {
                j += 1
            }
            flags.append(text[i..j])
            i = j
            continue
        }
        i += 1
    }
    return flags
}

/// True when `flag` stands in `text` as a whole word (not inside a longer flag).
bool helpHasFlag(string text, by string flag) uses alloc {
    for f in helpFlags(text) {
        return true if f == flag
    }
    return false
}

test "help: the top-level help is at most 28 lines of at most 80 columns" {
    let lines = helpLines(usageText)
    assert(lines.length <= 28)
    for line in lines {
        print(line) if helpWidth(line) > 80
        assert(helpWidth(line) <= 80)
    }
    for c in helpCommands() {
        let text = commandHelp(c) ?? ""
        assert(text != "")
        for line in helpLines(text) {
            print(line) if helpWidth(line) > 80
            assert(helpWidth(line) <= 80)
        }
    }
}

test "help: -h, help and --help print the same text" {
    let spelled = helpRun(["--help"])
    assert(spelled.exitCode == exitOk)
    assert(spelled.stdout == $"{usageText}\n")
    assert(helpRun(["-h"]).stdout == spelled.stdout)
    assert(helpRun(["help"]).stdout == spelled.stdout)
}

test "help: help build and build --help print the same text, with --emit-c" {
    let named = helpRun(["help", "build"])
    assert(named.exitCode == exitOk)
    assert(helpHasFlag(named.stdout, by: "--emit-c"))
    assert(helpRun(["build", "--help"]).stdout == named.stdout)
    assert(helpRun(["build", "-h"]).stdout == named.stdout)
}

test "help: every flag of the old help is in some command's help" {
    let flags = helpFlags(helpOld)
    assert(flags.length > 30)
    for flag in flags {
        var found = flag == "--version" && helpHasFlag(usageText, by: flag)
        for c in helpCommands() {
            found = found || helpHasFlag(commandHelp(c) ?? "", by: flag)
        }
        print(flag) unless found
        assert(found)
    }
}

test "help: -v prints what --version prints" {
    let spelled = helpRun(["--version"])
    assert(spelled.exitCode == exitOk)
    assert(spelled.stdout == $"{versionLine()}\n")
    let aliased = helpRun(["-v"])
    assert(aliased.exitCode == exitOk && aliased.stdout == spelled.stdout)
}

test "help: help of an unknown command is a one-line usage error" {
    let o = helpRun(["help", "nosuch"])
    assert(o.exitCode == exitUsage)
    assert(o.stdout == "")
    assert(o.stderr == "bayan: unknown command `nosuch`; `bayan help` lists the commands\n")
}
