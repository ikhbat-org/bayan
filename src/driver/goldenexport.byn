test "`argv-masked-arguments` compares the argv after the compiler's name (SelfhostDriverT3Tests.cs:410-423), a changed one fails" {
    // this driver compiles main.c in its cache, not beside the output as the C# did (a T19 divergence), so a fake driver calls the
    // recording `cc` with the arguments the C# passed it
    let fakes = Path.combine(Path.fullPath("tmp"), "golden-cli-fake-argv")
    deleteWorkDir(fakes)
    let cc = "cc -std=c11 -fwrapv -ffp-contract=off -w -O0 -g -DBYN_DEBUG \"-ffile-prefix-map=$d=.\" -I \"$d\" \"$d/main.c\" \"$d/bayan-rt.o\" -o program -lm"
    let exe = goldenCliFake(fakes, for: "bayan", as: $"d=$PWD\n{cc}")
    let r = goldenCliPair(
        "SelfhostDriverT3Tests/ArgumentsWithoutATargetAreTheHostsAsToolchain",
        as: goldenCliSpecArgvArguments,
        from: "-DBYN_DEBUG",
        to: "-DBYN_CHANGED",
        by: exe,
    )
    deleteWorkDir(fakes)
    assert(r[0] == "")
    assert(r[1].contains("expected.argv\nexpected line 7: -DBYN_CHANGED\nactual line 7: -DBYN_DEBUG"))
}

test "an unknown `compare` word fails the case naming the word" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cli-unknown")
    deleteWorkDir(root)
    goldenCliFixture(
        root,
        for: "SelfhostDriverT1Tests/AuditAsCliApp-10",
        as: goldenCliSpecVersion.replaced("version-masked", by: "sideways"),
    )
    let failure = goldenCliFixtureRun(root, for: "SelfhostDriverT1Tests/AuditAsCliApp-10")
    deleteWorkDir(root)
    assert(
        failure == $"{Path.combine(root, "cli/SelfhostDriverT1Tests/AuditAsCliApp-10")}\nunknown compare word `sideways`"
    )
}

test "input.tsv entries and trees are placed below the scratch directory, an executable one marked so" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cli-inputs")
    deleteWorkDir(root)
    goldenCliFixture(
        root,
        for: "SelfhostDriverT3Tests/ArgumentsWithoutATargetAreTheHostsAsToolchain",
        as: goldenCliSpecArgvArguments,
    )
    let scratch = Path.combine(root, "scratch")
    var failure = ""
    let cwd = goldenCliStage(
        Path.combine(root, "cli/SelfhostDriverT3Tests/ArgumentsWithoutATargetAreTheHostsAsToolchain"),
        from: root,
        to: scratch,
        through: ref failure,
    )
    let main = Io.readText(Path.combine(scratch, "examples/hello/main.byn")) catch "-"
    let cc = Path.combine(scratch, "tmp/t3/bin-null-args/cc")
    var args = List<string>()
    args.append("-x")
    args.append(cc)
    let exec = Io.run("test", args.span) catch return
    deleteWorkDir(root)
    assert(failure == "")
    assert(cwd == scratch)
    assert(main == "print(\"Salam, world!\")\n")
    assert(exec.exitCode == 0)
}

test "a `main.byn` entry goes to the path `args` names when another entry is named too" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cli-stage-named")
    deleteWorkDir(root)
    let dir = Path.combine(root, "cli/C/named")
    goldenWrite(dir, for: "args", as: "build\n-o\n<repo>/t/tally/tally\n<repo>/t/tally/main.byn\n")
    goldenWrite(dir, for: "env", as: "PATH=<repo>/t/fakebin\n")
    goldenWrite(dir, for: "input.tsv", as: "fakebin\ttree:tt\nmain.byn\tfile:aa\n")
    goldenWrite(root, for: "inputs/trees/tt.tsv", as: "")
    goldenWrite(root, for: "inputs/files/aa", as: "main\n")
    let scratch = Path.combine(root, "scratch")
    var failure = ""
    let _ = goldenCliStage(dir, from: root, to: scratch, through: ref failure)
    let main = Io.readText(Path.combine(scratch, "t/tally/main.byn")) catch "-"
    deleteWorkDir(root)
    assert(failure == "")
    assert(main == "main\n")
}

test "an `input.byn.ref` pointer is placed where input.byn goes, and BAYAN_UPDATE=1 keeps it and writes no input.byn" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cli-ref")
    deleteWorkDir(root)
    let name = "SelfhostDriverT1Tests/AScriptRunsAndAGlobalOptionBeforeItIsTaken"
    let dir = Path.combine(root, $"cli/{name}")
    goldenCliFixture(root, for: name, as: goldenCliSpecExit)
    let text = "print(\"hi\")\n"
    let sha = Hex.encode(sha256(text.bytes).span)
    goldenWrite(root, for: $"inputs/files/{sha}", as: text)
    goldenWrite(dir, for: "input.byn.ref", as: $"file:{sha}\n")
    Io.remove(Path.combine(dir, "input.byn")) catch {}
    let scratch = Path.combine(root, "scratch")
    var failure = ""
    let _ = goldenCliStage(dir, from: root, to: scratch, through: ref failure)
    let staged = Io.readText(Path.combine(scratch, "tmp/t1-driver/tool.byn")) catch "-"
    let run = goldenCliFixtureRun(root, for: name)
    let update = goldenUpdateRun(root, as: "1", by: "1")
    let pointer = Io.readText(Path.combine(dir, "input.byn.ref")) catch "-"
    let written = Fs.fileExists(Path.combine(dir, "input.byn"))
    deleteWorkDir(root)
    deleteWorkDir(
        Path.combine(Path.fullPath("tmp"), "cli/SelfhostDriverT1Tests_AScriptRunsAndAGlobalOptionBeforeItIsTaken"),
    )
    assert(failure == "")
    assert(staged == text)
    assert(run == "")
    assert(update.stdout.contains($"\npassed cli/{name}\n"))
    assert(pointer == $"file:{sha}\n")
    assert(!written)
}

test "an `input.byn.ref` pointer with no file below inputs/files fails the case naming the missing file" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cli-ref-missing")
    deleteWorkDir(root)
    let name = "SelfhostDriverT1Tests/AScriptRunsAndAGlobalOptionBeforeItIsTaken"
    let dir = Path.combine(root, $"cli/{name}")
    goldenCliFixture(root, for: name, as: goldenCliSpecExit)
    let sha = Hex.encode(sha256("print(\"hi\")\n".bytes).span)
    goldenWrite(dir, for: "input.byn.ref", as: $"file:{sha}\n")
    Io.remove(Path.combine(dir, "input.byn")) catch {}
    let failure = goldenCliFixtureRun(root, for: name)
    deleteWorkDir(root)
    deleteWorkDir(
        Path.combine(Path.fullPath("tmp"), "cli/SelfhostDriverT1Tests_AScriptRunsAndAGlobalOptionBeforeItIsTaken"),
    )
    assert(failure.contains($"missing input file {Path.combine(root, $"inputs/files/{sha}")}"))
}

test "the T12 and time masks compare bytes, so text with multibyte characters before a match does not stop them" {
    assert(goldenCliT12("é<root>/cache/v1/tmp/x/a.byn in 1.5s") == "éa.byn in <time>")
    assert(goldenCliT12("ـ<root>/cache/v1/tmp") == "ـ<root>/cache/v1/tmp")
    assert(goldenCliTimes("ءé in 12.34s ب", from: " in ", by: " in masked", two: true) == "ءé in masked ب")
}

test "the doctor mask reads ok rows' values as `<host>` as land-export.sh `mask_doctor` does, `not found` and other rows as is" {
    let text = "◆ bayan       0.3.3-dev (commit <c>)\n◆ host        macos-arm64\n\u{1b}[32m◆\u{1b}[0m C compiler  /usr/bin/cc (clang 17)\n* zig         not found\n* git         /opt/homebrew/bin/git (git 2.56.0)\n✗ cache       <root>/cache (not writable)\n◆ cache       <root>/cache (writable, 0 programs, 0.0 MB)\n"
    let masked = "◆ bayan       0.3.3-dev (commit <c>)\n◆ host        <host>\n\u{1b}[32m◆\u{1b}[0m C compiler  <host>\n* zig         not found\n* git         <host>\n✗ cache       <root>/cache (not writable)\n◆ cache       <host>\n"
    assert(goldenCliDoctor(text, by: true) == masked)
    assert(goldenCliDoctor(
        "◆ cache       <root>/cache (writable)\n",
        by: false,
    ) == "◆ cache       <root>/cache (writable)\n")
    assert(goldenCliDoctor("◆ hostname    x\n◆ host\n", by: true) == "◆ hostname    x\n◆ host\n")
}

test "the T9 mask reads times, unwritable-cache and C compiler messages, script keys and the commit as SelfhostDefaultT9Tests' `Masked`" {
    let key = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    assert(goldenCliT9("◆ built a (safe) in 12.34s · from cache\n") == "◆ built a (safe) in <t>s · from cache\n")
    let unwritable = "bayan: cannot write the build output or cache (<root>/cache): Permission denied\nnext\n"
    assert(goldenCliT9(unwritable) == "bayan: cannot write the build output or cache (<root>/cache): <message>\nnext\n")
    assert(goldenCliT9(
        "bayan: cannot run the C compiler `cc`: no such file\n",
    ) == "bayan: cannot run the C compiler `cc`: <message>\n")
    assert(
        goldenCliT9($"<root>/cache/v1/scripts/{key}/x (commit abc)") == "<root>/cache/v1/scripts/<skey>/x (commit <c>)"
    )
    assert(goldenCliT9("scripts/0123 1.5s") == "scripts/0123 1.5s")
}

test "the argv mask reads a file below a cache's `v1/tmp/` by its name, another path as is" {
    let argv = "cc\n/r/tmp/cache/v1/tmp/ab-1/main.c\n-o\n/r/tmp/cache/v1/tmp/ab-1/program.exe\n/r/src/main.c\n"
    assert(goldenCliArgv(argv, at: "/s") == "cc\nmain.c\n-o\nprogram.exe\n/r/src/main.c")
}

test "the cc mask reads everything after `C compiler failed (exit N):` as `<cc output>`, and a text without that line as is" {
    assert(goldenCliCc(
        "✗ build failed\nC compiler failed (exit 1):\nmain.c:2:5: error: x\n1 error\n",
    ) == "✗ build failed\nC compiler failed (exit 1):\n<cc output>\n")
    assert(goldenCliCc(
        "C compiler failed (exit 1): x\nC compiler failed (exit ):\n",
    ) == "C compiler failed (exit 1): x\nC compiler failed (exit ):\n")
}

test "a cli case without `args` is reported, and BAYAN_UPDATE=1 rewrites a cli case's expected files" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cli-update")
    deleteWorkDir(root)
    let name = "SelfhostDriverT1Tests/AuditAsCliApp-10"
    goldenCliFixture(
        root,
        for: name,
        as: goldenCliSpecVersion.replaced("usage: bayan audit <path>", by: "usage: changed"),
    )
    goldenWrite(root, for: "cli/SelfhostDriverT3Tests/Probe/expected.stdout", as: "")
    let before = goldenUpdateRun(root, as: "1", by: null)
    let update = goldenUpdateRun(root, as: "1", by: "1")
    let again = goldenUpdateRun(root, as: "1", by: null)
    let stderr = Io.readText(Path.combine(root, $"cli/{name}/expected.stderr")) catch ""
    deleteWorkDir(root)
    let probe = Path.combine(root, "cli/SelfhostDriverT3Tests/Probe")
    assert(before.exitCode == exitTestFailure)
    assert(before.stdout.contains($"\nfailed cli/{name}\n"))
    assert(
        before.stdout.contains($"\nskipped cli/SelfhostDriverT3Tests/Probe\n    skipped: no `args` file in {probe}\n")
    )
    assert(update.stdout.contains(
        $"\npassed cli/{name}\n    rewrote {Path.combine(root, $"cli/{name}/expected.stderr")}\n",
    ))
    assert(again.exitCode == exitOk)
    assert(stderr == "usage: bayan audit <path>\n")
}
