/// Writes the `cli` case `name` (`<Class>/<case>`) below `root`/cli from `spec`, sections `=== <file>` each followed by its text (the export
/// case's files, as tmp/export-full holds them with its worktree read as `<repo>`): `=== <file> -n` drops the text's final LF, `<space>` reads as a
/// space, and `=== input/<path>` (`input+x/` executable, `input/<dir>/` an empty directory) is an input stored under `root`/inputs and listed
/// in the case's input.tsv, its directories as `tree:` entries (the T17a form).
void goldenCliFixture(string root, for string name, as string spec) uses alloc, fs {
    let dir = Path.combine(Path.combine(root, "cli"), name)
    var entries = StrBuf()
    var rest = $"\n{spec}\n"
    var at = goldenOffset(rest, for: "\n=== ")
    while at >= 0 {
        rest = rest[at + 5..rest.length]
        let eol = goldenOffset(rest, for: "\n")
        var file = rest[0..eol]
        rest = rest[eol..rest.length]
        let next = goldenOffset(rest, for: "\n=== ")
        var text = (next < 0 ? rest[1..rest.length] : rest[1..next + 1]).replaced("<space>", by: " ")
        if file.endsWith(" -n") {
            file = file[0..file.length - 3]
            text = text[0..text.length - 1]
        }
        if file.startsWith("input/") || file.startsWith("input+x/") {
            let slash = goldenOffset(file, for: "/")
            let path = file[slash + 1..file.length]
            let sha = Hex.encode(sha256(text.bytes).span)
            if !path.endsWith("/") {
                goldenWrite(root, for: $"inputs/files/{sha}", as: text)
            }
            entries.append($"{path}\t{slash == 5 ? "file" : "file+x"}:{sha}\n")
        } else {
            goldenWrite(dir, for: file, as: text)
        }
        at = next
    }
    let tsv = goldenCliFixtureTree(root, at: "", from: entries.finish())
    if tsv != "" {
        goldenWrite(dir, for: "input.tsv", as: tsv)
    }
}

/// The input.tsv lines of the `entries` (`<path>\t<kind>:<sha256>` lines) below `prefix`, each directory's own lines stored as
/// `root`/inputs/trees/<sha256>.tsv.
string goldenCliFixtureTree(string root, at string prefix, from string entries) uses alloc, fs {
    var sb = StrBuf()
    var done = List<string>()
    for e in goldenLines(entries) {
        continue if e == "" || !e.startsWith(prefix)
        let tab = goldenOffset(e, for: "\t")
        let rest = e[prefix.length..tab]
        continue if rest == ""
        let slash = goldenOffset(rest, for: "/")
        if slash < 0 {
            sb.append($"{rest}\t{e[tab + 1..e.length]}\n")
            continue
        }
        let name = rest[0..slash]
        var seen = false
        for d in done {
            seen = seen || d == name
        }
        continue if seen
        done.append(name)
        let tree = goldenCliFixtureTree(root, at: $"{prefix}{name}/", from: entries)
        let sha = Hex.encode(sha256(tree.bytes).span)
        goldenWrite(root, for: $"inputs/trees/{sha}.tsv", as: tree)
        sb.append($"{name}\ttree:{sha}\n")
    }
    return sb.finish()
}

/// The failure text of the `cli` case `name` (`<Class>/<case>`) below `root` through `exe` (`$BAYAN_EXE` when empty); empty when it passes.
string goldenCliFixtureRun(string root, for string name, by string exe = "") uses alloc, clock, env, fs, process {
    var failure = ""
    let driver = exe != "" ? exe : goldenExe(through: ref failure)
    return $"no driver: {failure}" if driver == ""
    return goldenCli(Path.combine(Path.combine(Path.combine(root, "cli"), name), "args"), by: driver) ?? ""
}

/// The failure texts of `spec` as the case `name` (`<Class>/<case>`) and of it with `from` replaced by `to` as `name`-changed, through `exe`
/// (`$BAYAN_EXE` when empty); empty for a pass. Their directories and scratch directories are removed.
List<string> goldenCliPair(string name, as string spec, from string a, to string b, by string exe = "")
        uses alloc, clock, env, fs, process {
    let root = Path.combine(Path.fullPath("tmp"), $"golden-cli-{Path.fileName(name)}")
    deleteWorkDir(root)
    let changed = spec.replaced(a, by: b)
    var results = List<string>()
    if changed == spec {
        results.append("the change does not apply")
        return results
    }
    goldenCliFixture(root, for: name, as: spec)
    goldenCliFixture(root, for: $"{name}-changed", as: changed)
    results.append(goldenCliFixtureRun(root, for: name, by: exe))
    results.append(goldenCliFixtureRun(root, for: $"{name}-changed", by: exe))
    deleteWorkDir(root)
    let scratch = Path.combine(Path.fullPath("tmp"), "cli")
    let cls = Path.directoryName(name) ?? ""
    deleteWorkDir(Path.combine(scratch, $"{cls}_{Path.fileName(name)}"))
    deleteWorkDir(Path.combine(scratch, $"{cls}_{Path.fileName(name)}-changed"))
    return results
}

/// An executable shell script `body` at `root`/`name` for a fake driver; its path.
string goldenCliFake(string root, for string name, as string body) uses alloc, fs, process {
    goldenWrite(root, for: name, as: $"#!/bin/sh\n{body}\n")
    let path = Path.combine(root, name)
    var args = List<string>()
    args.append("a+x")
    args.append(path)
    let _ = Io.run("chmod", args.span) catch { panic($"cannot make {path} executable") }
    return path
}

test "`exit` compares the exit code alone (SelfhostDriverTests.cs:465), a changed one fails" {
    let r = goldenCliPair(
        "SelfhostDriverT1Tests/AScriptRunsAndAGlobalOptionBeforeItIsTaken",
        as: goldenCliSpecExit,
        from: "=== expected.exitcode\n0",
        to: "=== expected.exitcode\n1",
    )
    assert(r[0] == "")
    assert(r[1].contains("expected.exitcode\nexpected line 1: 1\nactual line 1: 0"))
}

