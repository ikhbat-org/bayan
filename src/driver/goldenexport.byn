test "`version-seconds-masked` masks the version line and times (SelfhostDriverT2Tests.cs:33, :49-50), a changed stdout fails" {
    // the recorded version (0.3.2) is not this driver's, so a fake driver prints the recorded line
    let fakes = Path.combine(Path.fullPath("tmp"), "golden-cli-fake-version")
    deleteWorkDir(fakes)
    let exe = goldenCliFake(fakes, for: "bayan", as: "echo 'bayan 0.3.2 (masked)'")
    let r = goldenCliPair(
        "SelfhostDriverT2Tests/DispatchAsCliApp",
        as: goldenCliSpecVersionSeconds,
        from: "bayan 0.3.2",
        to: "bayan 0.0.0",
        by: exe,
    )
    deleteWorkDir(fakes)
    assert(r[0] == "")
    assert(r[1].contains("expected.stdout\nexpected line 1: bayan 0.0.0 (masked)\nactual line 1: bayan 0.3.2 (masked)"))
    assert(goldenCliVersion(
        goldenCliT2("bayan 0.3.3-dev (selfhost)\nchecked in 1.25s\n"),
    ) == "bayan 0.3.3-dev (masked)\nchecked in masked\n")
}

