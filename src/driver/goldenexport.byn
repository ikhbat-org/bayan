test "`stderr-bayan-prefix` compares stderr's `bayan:` line up to its `(` (SelfhostDriverT5Tests.cs:488-496), a changed one fails" {
    let r = goldenCliPair(
        "SelfhostDriverT5Tests/CannotWriteTheOutputAsCliApp",
        as: goldenCliSpecBayanPrefix,
        from: "or cache",
        to: "or changed",
    )
    assert(r[0] == "")
    assert(r[1].contains(
        "expected.stderr\nexpected line 1: bayan: cannot write the build output or changed \nactual line 1: bayan: cannot write",
    ))
}

