// L018 (spec 019 T31c): SelfhostParserNoPanicLawTests.cs without .NET. The corrupted seed corpus (SelfhostParserGenerator.cs
// `GenerateCorrupt(Seeds)`) and the random corpus (`GenerateRandomCorpus`) are generated here with the C# generators' rng and call
// order, written under tmp/l018-nopanic/<kind>/ and run through one `bayan-parse --many` each. The C# tree's own span walker is not
// ported: the child-outside-parent count is printed, not compared (docs/laws/018-no-parser-panic.md, Proof notes).

import lexer

/// SelfhostParserGenerator.cs:346 `XorShift`: xorshift64; `next(n)` is `Below(n)`, `(int)(Next() % (ulong)n)`.
struct L018Rng {
    u64 state

    u64 step(ref this) {
        this.state ^= this.state << 13
        this.state ^= this.state >> 7
        this.state ^= this.state << 17
        return this.state
    }

    i64 next(ref this, i64 n) {
        return i64(this.step() % u64(n))
    }
}

/// SelfhostParserGenerator.cs:25 `Seeds`.
List<u64> l018Seeds() uses alloc {
    var seeds = List<u64>()
    seeds.append(0x9E3779B97F4A7C15)
    seeds.append(0x0123456789ABCDEF)
    seeds.append(0xFEDCBA9876543210)
    seeds.append(0xDEADBEEFCAFEF00D)
    seeds.append(0x3141592653589793)
    seeds.append(0x2718281828459045)
    seeds.append(0x0BADF00D0BADF00D)
    seeds.append(0x5EED5EED5EED5EED)
    return seeds
}

