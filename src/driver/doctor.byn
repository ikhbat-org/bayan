// `bayan doctor` of the self-hosted driver (spec 017 T5): ports `Doctor.cs` 1-122 and `Toolchain.cs` `FindCompiler`'s `$BAYAN_CC` branch (:114-115),
// which `Doctor` reads; `CacheDirectory` and `Stats` come from cache.byn (`cacheDirectory`, `cacheStats`). `Doctor.Run` ignores its arguments.

import semantics

/// `Doctor.Level` (Doctor.cs:13).
enum T5Level {
    ok
    note
    broken
}

/// `Doctor.Check` (Doctor.cs:17); a null `fix` is C#'s `Fix = null`.
struct T5Check {
    T5Level level  = .ok
    string  name   = ""
    string  detail = ""
    string? fix    = null
}

/// `Role` of Style.cs:3 for the four roles `Render` paints.
enum T5Role {
    error
    help
    success
    note
}

const t5ZigUrl: string = "https://ziglang.org"

/// CliApp.cs:33 `VersionLine`'s commit has no source in the driver (Q1091): the row prints `(commit selfhost)`.
const t5Commit: string = "selfhost"

/// `Style.Paint` (Style.cs:68) with the palette of `style` (`t7Prefix`) when `style.color`.
string t5Paint(T5Role role, by DStyle style, for string text) uses alloc {
    unless style.color {
        return $"{text}"
    }
    var index = 4
    switch role {
        case .error:
            index = 0
        case .help:
            index = 2
        case .success:
            index = 3
        case .note:
            index = 4
    }
    let prefix = t7Prefix(by: style.palette, for: index)
    return $"{prefix}{text}\u{1b}[0m"
}

/// CliApp.cs:101 `Doctor.Run` (Doctor.cs:19): the checks in order, rendered to stdout; 4 when one fails.
i32 doctorCommand(by in DCtx d) uses alloc, clock, console, env, fs, process {
    var checks = List<T5Check>()
    // `Messages.DoctorVersion` with the commit of Q1091
    checks.append(T5Check { level: .ok, name: "bayan", detail: $"{version} (commit {t5Commit})" })
    // coverage-exempt: Q1092 `Target.os` is a constant of the host, so no row runs on a machine with no Bayan target
    if (targetHost() is { } host) {
        checks.append(T5Check { level: .ok, name: "host", detail: $"{host}" })
    } else {
        // coverage-exempt: Q1092 the no-host row
        checks.append(
            T5Check {
                level: .broken,
                name: "host",
                detail: "this machine has no Bayan target",
                fix: "build on linux, macos or windows, x64 or arm64",
            },
        )
    }
    checks.append(t5CCompiler())
    checks.append(t5Zig())
    checks.append(t5Git())
    checks.append(t5Cache())
    Io.stdout.write(t5Render(in checks, by: d.styleOut))
    for c in checks {
        return exitToolchain if c.level == .broken
    }
    return exitOk
}

/// Doctor.cs:37 `Render`.
string t5Render(in List<T5Check> checks, by DStyle style) uses alloc {
    let symbols = semantics.t26Symbols(style.ascii)
    var width = 0
    for c in checks {
        if c.name.length > width {
            width = c.name.length
        }
    }
    var sb = StrBuf()
    for c in checks {
        if c.level == .broken {
            sb.append($"{t5Paint(.error, by: style, for: $"{symbols.cross} {c.name}: {c.detail}")}\n")
        } else {
            let mark = t5Paint(c.level == .ok ? .success : .note, by: style, for: symbols.dot)
            var padded = StrBuf()
            padded.append(c.name)
            for _ in c.name.length..width {
                padded.append(" ")
            }
            sb.append($"{mark} {padded.finish()}  {c.detail}\n")
        }
        if (c.fix is { } fix) {
            sb.append($"{t5Paint(.help, by: style, for: $"  help: {fix}")}\n")
        }
    }
    return $"{sb.finish()}"
}

/// `t5Render` of `checks` in each style against tests/cases/style/`shape` (StyleTests.cs:204 `DoctorShape`); null when all three match.
string? t5RenderCompare(in List<T5Check> checks, for string shape) uses alloc, fs {
    for ending in goldenStyleEndings() {
        let text = goldenStyleMask(t5Render(in checks, by: goldenStyleOf(ending)), for: "", at: "")
        if (goldenStyleCompare(
            shape,
            for: ending,
            as: $"# Doctor.Render\n{goldenStreams(text, for: "")}",
        ) is { } failure) {
            return failure
        }
    }
    return null
}

test "doctor-ok: passing checks render as tests/cases/style/doctor-ok in each style" {
    // StyleTests.cs:142-149: the checks `Doctor.Render` gets.
    var checks = List<T5Check>()
    checks.append(T5Check { level: .ok, name: "bayan", detail: $"{version} (commit a1b2c3d4e5f6)" })
    checks.append(T5Check { level: .ok, name: "host", detail: t5HostTarget() })
    checks.append(T5Check { level: .ok, name: "C compiler", detail: "zig cc (0.14.1)" })
    checks.append(T5Check { level: .ok, name: "zig", detail: "/usr/local/bin/zig (0.14.1)" })
    checks.append(T5Check { level: .ok, name: "git", detail: "/usr/bin/git (git version 2.47.0)" })
    checks.append(T5Check { level: .ok, name: "cache", detail: "~/.cache/bayan (writable, 3 programs, 1.2 MB)" })
    assert(t5RenderCompare(in checks, for: "doctor-ok") is null)
}

test "doctor-fail: failing checks render as tests/cases/style/doctor-fail in each style" {
    // StyleTests.cs:151-158; `Doctor.Level.Fail` is `.broken`.
    var checks = List<T5Check>()
    checks.append(T5Check { level: .ok, name: "bayan", detail: $"{version} (commit a1b2c3d4e5f6)" })
    checks.append(T5Check { level: .ok, name: "host", detail: t5HostTarget() })
    checks.append(
        T5Check {
            level: .broken,
            name: "C compiler",
            detail: "none found",
            fix: "install zig (https://ziglang.org), or set BAYAN_CC to a C compiler",
        },
    )
    checks.append(
        T5Check {
            level: .note,
            name: "zig",
            detail: "not found; building for other targets needs it",
            fix: "install zig (https://ziglang.org)",
        },
    )
    checks.append(T5Check { level: .ok, name: "git", detail: "/usr/bin/git (git version 2.47.0)" })
    checks.append(
        T5Check {
            level: .broken,
            name: "cache",
            detail: "~/.cache/bayan isn't writable: Permission denied",
            fix: "set BAYAN_CACHE to a writable directory",
        },
    )
    assert(t5RenderCompare(in checks, for: "doctor-fail") is null)
}

/// Doctor.cs:50 `CCompiler`.
T5Check t5CCompiler() uses alloc, env, fs, process {
    let fromEnv = (Env.get("BAYAN_CC") ?? "").length > 0
    let compiler = t5FindCompiler()
    return T5Check {
        level: .broken,
        name: "C compiler",
        detail: "none found",
        fix: $"install zig ({t5ZigUrl}), or set BAYAN_CC to a C compiler",
    } if compiler.length == 0
    let command = ccJoin(in compiler)
    var args = List<string>()
    for i in 1..compiler.length {
        args.append(compiler[i])
    }
    args.append("--version")
    if (t5Version(compiler[0], by: in args) is { } found) {
        return T5Check { level: .ok, name: "C compiler", detail: $"{command} ({found})" }
    }
    return T5Check {
        level: .broken,
        name: "C compiler",
        detail: $"BAYAN_CC is `{command}`, which can't be run",
        fix: "point BAYAN_CC at a C compiler, or unset it to use zig",
    } if fromEnv
    return T5Check {
        level: .broken,
        name: "C compiler",
        detail: $"`{command}` can't be run",
        fix: "reinstall it, or set BAYAN_CC to a working C compiler",
    }
}

/// Toolchain.cs:107 `FindCompiler`: `$BAYAN_CC` split on spaces (:110), else cc.byn `ccFindCompiler`; empty is C#'s null.
/// A `BAYAN_CC` that names an existing file whole is that one program, so a compiler under a path with a space
/// (`C:\Program Files\LLVM\bin\clang.exe`) runs (audit 0.4.0 review: `build` and the cache read it since the mediums fixes).
List<string> t5FindCompiler() uses alloc, env, fs {
    // coverage-exempt: Q1286 the `?? ""` result is never null
    if ((Env.get("BAYAN_CC") ?? "") is { } cc && cc.length > 0) {
        var found = List<string>()
        if Fs.fileExists(cc) {
            found.append($"{cc}")
            return found
        }
        for part in cc.parts(by: " ") {
            // coverage-exempt: Q1286 needs BAYAN_CC with two adjacent spaces, which a test cannot set
            if part.length > 0 {
                found.append($"{part}")
            }
        }
        // the C# `compiler[0]` of Doctor.cs:56 throws IndexOutOfRangeException on no words; the driver panics (Q1095)
        // coverage-exempt: Q1286 through `names no program` leads only to the panic
        if found.length == 0 {
            panic("BAYAN_CC is set but names no program")
        }
        return found
    }
    return ccFindCompiler()
}

/// Doctor.cs:63 `Zig`.
T5Check t5Zig() uses alloc, env, fs, process {
    let found = ccFindOnPath("zig", for: Target.os)
    if found is null {
        return T5Check {
            level: .note,
            name: "zig",
            detail: "not found; building for other targets needs it",
            fix: $"install zig ({t5ZigUrl})",
        }
    }
    let zig = found
    var args = List<string>()
    args.append("version")
    if (t5Version(zig, by: in args) is { } v) {
        return T5Check { level: .ok, name: "zig", detail: $"{zig} ({v})" }
    }
    return T5Check { level: .broken, name: "zig", detail: $"{zig} can't be run", fix: $"reinstall zig ({t5ZigUrl})" }
}

/// Doctor.cs:72 `Git`.
T5Check t5Git() uses alloc, env, fs, process {
    let found = ccFindOnPath("git", for: Target.os)
    if found is null {
        return T5Check {
            level: .note,
            name: "git",
            detail: "not found; `bayan new` skips `git init`, `bayan dist` records no commit, `bayan test --changed` is unavailable",
            fix: "install git",
        }
    }
    let git = found
    var args = List<string>()
    args.append("--version")
    if (t5Version(git, by: in args) is { } v) {
        return T5Check { level: .ok, name: "git", detail: $"{git} ({v})" }
    }
    return T5Check { level: .note, name: "git", detail: $"{git} can't be run", fix: "reinstall git" }
}

/// Doctor.cs:81 `Cache`: `Directory.CreateDirectory`, a probe file written and deleted, then cache.byn `cacheStats`.
T5Check t5Cache() uses alloc, clock, env, fs {
    let dir = cacheDirectory()
    Io.createDirectory(dir) catch switch { IoError e => return t5CacheBroken(dir, by: $"{e}") }
    let probe = Path.combine(dir, $".doctor-{Io.monotonicNanos()}")
    Io.writeFile(probe, "".bytes) catch switch { IoError e => return t5CacheBroken(dir, by: $"{e}") }
    // coverage-exempt: Q1092 the probe file was written a line earlier; only a race removes it
    Io.remove(probe) catch switch { IoError e => return t5CacheBroken(dir, by: $"{e}") }
    let stats = cacheStats()
    // `{2:0.0}` of `Bytes / 1024.0 / 1024.0`: exact in binary, so half-up on the tenths is .NET's rounding (cache.byn `cacheCommand`)
    let tenths = (stats.bytes * 10 + 524288) / 1048576
    return T5Check {
        level: .ok,
        name: "cache",
        detail: $"{dir} (writable, {stats.programs} programs, {tenths / 10}.{tenths % 10} MB)",
    }
}

/// The `catch` of Doctor.cs:93.
T5Check t5CacheBroken(string dir, by string message) {
    return T5Check {
        level: .broken,
        name: "cache",
        detail: $"{dir} isn't writable: {message}",
        fix: "set BAYAN_CACHE to a writable directory",
    }
}

/// Doctor.cs:100 `Version`: the first line `file` prints for `args`, trimmed (stdout, else stderr); null if it can't run or fails.
string? t5Version(string file, by in List<string> args) uses alloc, process {
    let r = Io.run(file, args.span) catch return null
    let text = r.stdout.length > 0 ? r.stdout : r.stderr
    unless r.exitCode == 0 {
        return null
    }
    for line in text.parts(by: "\n") {
        return $"{line.trimmed()}"
    }
    // coverage-exempt: Q1092 `parts` yields at least one part (an empty text gives one empty part), so the loop always returns; the C# `Split('\n')[0]` has no such line
    return null
}

/// CliEnvironmentTests.cs:252 `s_checks`.
List<T5Check> t25RenderChecks() uses alloc {
    var checks = List<T5Check>()
    checks.append(T5Check { level: .ok, name: "bayan", detail: "0.1.0" })
    checks.append(T5Check { level: .note, name: "zig", detail: "not found", fix: "install zig" })
    checks.append(T5Check { level: .broken, name: "cache", detail: "isn't writable", fix: "set BAYAN_CACHE" })
    return checks
}

test "doctor-render-plain: a passing, a noted and a failing check render with marks, aligned names and help lines" {
    // CliEnvironmentTests.cs:267 `DoctorRendersPlain`
    let checks = t25RenderChecks()
    let got = t5Render(in checks, by: DStyle {})
    assert(
        got == "◆ bayan  0.1.0\n◆ zig    not found\n  help: install zig\n✗ cache: isn't writable\n  help: set BAYAN_CACHE\n"
    )
}

test "doctor-render-ascii: ascii symbols render the marks as `*` and `x`" {
    // CliEnvironmentTests.cs:273 `DoctorRendersAscii`
    let checks = t25RenderChecks()
    let got = t5Render(in checks, by: DStyle { ascii: true })
    assert(
        got == "* bayan  0.1.0\n* zig    not found\n  help: install zig\nx cache: isn't writable\n  help: set BAYAN_CACHE\n"
    )
}

test "doctor-render-colour: the 16-colour palette paints each mark, a failing line and the help lines" {
    // CliEnvironmentTests.cs:279 `DoctorRendersColour`: `Palette.Ansi16` is palette 0
    let checks = t25RenderChecks()
    let got = t5Render(in checks, by: DStyle { color: true, palette: 0 })
    let want = "\u{1b}[32m◆\u{1b}[0m bayan  0.1.0\n\u{1b}[2m◆\u{1b}[0m zig    not found\n\u{1b}[34m  help: install zig\u{1b}[0m\n\u{1b}[31m✗ cache: isn't writable\u{1b}[0m\n\u{1b}[34m  help: set BAYAN_CACHE\u{1b}[0m\n"
    assert(got == want)
}
