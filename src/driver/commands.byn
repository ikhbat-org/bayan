// The commands `lex`, `parse`, `types` and `check` of the self-hosted driver (spec 012 T2). Ports `CliApp.cs` :108 `Lex`,
// :125 `Parse`, :141 `Types` and :448 `Check`; :259-309 (`Compile`, `Report`) are `semantics/cli.byn` `t26Compile` and
// `t26Report`. Each takes the arguments `run` kept (the command first).

import lexer
import parser
import semantics

/// The arguments after the command (`args[1..]` of CliApp.cs:49).
List<string> t2Rest(in List<string> kept) {
    var rest = List<string>()
    for i in 1..kept.length {
        rest.append(kept[i])
    }
    return rest
}

/// CliApp.cs:1107 `TryReadSingleFile`: one argument that is a file; false after the message.
bool tryReadSingleFile(in List<string> args) {
    if args.length != 1 {
        Io.stderr.write("bayan: expected exactly one file\n")
        return false
    }
    unless t1FileExists(args[0]) {
        Io.stderr.write($"bayan: file not found: {args[0]}\n")
        return false
    }
    return true
}

/// CliApp.cs:108 `Lex`. `--json` is refused (R3, Q940). No style: the dump renders plain (Q941).
i32 lexCommand(in List<string> kept) {
    let args = t2Rest(kept)
    for a in args {
        return refuse("lex --json") if a == "--json"
    }
    var bytes = List<u8>()
    var name = "<stdin>"
    if args.length == 1 && args[0] == "-" {
        // coverage-exempt: Q943 the C# `CopyTo` has no failure branch; the runtime side is tested by `RuntimeNativeTests.FailedReadReleasesItsBuffer` (stdin from a directory)
        bytes = Io.stdin.readAllBytes() catch return exitFailure
    } else {
        unless tryReadSingleFile(in args) {
            return exitUsage
        }
        name = args[0]
        // coverage-exempt: Q943 reached only if the file changes between the reads of `t1FileExists` and here
        bytes = Io.readFile(name) catch return exitFailure
    }
    var sb = StrBuf()
    let failed = lexer.dumpFile(name, from: move bytes, by: lexer.Keywords.build(), to: ref sb, json: false)
    Io.stdout.write(sb.finish())
    return failed ? exitFailure : exitOk
}

/// CliApp.cs:125 `Parse`.
i32 parseCommand(in List<string> kept) {
    var printAst = false
    var rest = List<string>()
    for i in 1..kept.length {
        if kept[i] == "--ast" {
            printAst = true
        } else {
            rest.append(kept[i])
        }
    }
    unless tryReadSingleFile(in rest) {
        return exitUsage
    }
    // `parseOne` reads stdin for `-`; the C# parses the file named `-` (CliApp.cs:128, :1107), so it is read as `./-`.
    if printAst {
        return parser.parseOne(rest[0] == "-" ? "./-" : rest[0], by: lexer.Keywords.build())
    }
    // stub: T2 parse without --ast (blocked: Q940)
    return refuse("parse")
}

/// `s_styleErr` for the diagnostic renderer and the failure line (CliApp.cs:310 `Report`, :521 `Failed`): the symbols, the width and, with colour, the
/// `Palette.Prefix` of `Role.Error`, `Warning`, `Help` and `Note` (`t7Prefix` 0, 1, 2, 4).
semantics.T26Symbols t19Symbols(in DStyle style) uses alloc {
    unless style.color {
        return semantics.t26Symbols(style.ascii, width: style.width)
    }
    return semantics.t26Symbols(
        style.ascii,
        color: true,
        width: style.width,
        error: t7Prefix(by: style.palette, for: 0),
        warning: t7Prefix(by: style.palette, for: 1),
        help: t7Prefix(by: style.palette, for: 2),
        note: t7Prefix(by: style.palette, for: 4),
    )
}

test "diag-secondary: a related span renders as tests/cases/style/diag-secondary in each style" {
    // StyleTests.cs:172 `Secondary`: a BYN2104 with a fix and a related span, which no binder site produces yet (Q81).
    let text = "i64 sum(Line line) {\n    let total = 0\n    total += line.price\n    return total\n}\n"
    let use = goldenOffset(text, for: "total +=")
    let declared = goldenOffset(text, for: "total = 0")
    var bytes = List<u8>()
    for b in text.bytes {
        bytes.append(b)
    }
    let empty = List<u8>()
    var p = parser.Parser.create(
        lexer.lex(lexer.SourceText.create("ledger.byn", from: move empty), by: lexer.Keywords.build()),
    )
    let unit = parser.parseCompilationUnit(ref p)
    var c = GoldenCtx {
        files: List<semantics.SourceFile>(),
        modules: List<semantics.Mod>(),
        diagnostics: List<GoldenDiag>(),
        bags: List<semantics.DiagBag>(),
    }
    c.files.append(
        GoldenFile {
            path: "src/ledger/ledger.byn",
            displayPath: "src/ledger/ledger.byn",
            text: move bytes,
            unit: move unit,
            imports: Map<string, i64>(),
        },
    )
    var related = List<GoldenRelated>()
    related.append(
        GoldenRelated { span: CcSpan { start: declared, length: "total".length }, label: "declared with `let` here" },
    )
    var diags = List<GoldenDiag>()
    diags.append(
        GoldenDiag {
            code: "BYN2104",
            file: 0,
            span: CcSpan { start: use, length: "total".length },
            message: "`total` is immutable",
            label: "cannot be changed",
            help: "declare it with `var` if it should change",
            hasFix: true,
            fixSpan: CcSpan { start: declared - "let ".length, length: "let".length },
            fixReplacement: "var",
            related: move related,
        },
    )
    for ending in goldenStyleEndings() {
        var omitted: i64 = 0
        let rendered = semantics.renderAllBy(
            in c,
            from: in diags,
            by: true,
            until: 2147483647,
            to: ref omitted,
            through: in t19Symbols(in goldenStyleOf(ending)),
        )
        let failure = goldenStyleCompare(
            "diag-secondary",
            for: ending,
            as: $"# DiagnosticRenderer.RenderAll\n{goldenStreams("", for: rendered)}",
        )
        assert(failure is null)
    }
}

/// CliApp.cs:141 `Types`.
i32 typesCommand(in List<string> kept, by in DCtx d) {
    let args = t2Rest(kept)
    let o = t5ParseBuildOptions(in args, by: false, for: false) ?? return exitUsage
    let symbols = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    var c = t5Compile(
        in o,
        by: in symbols,
        to: ref reported,
        through: ref ok,
        ascii: d.styleErr.ascii,
        width: d.styleErr.width,
        isTty: d.stderrTty,
    )
    unless ok {
        return exitFailure
    }
    Io.stdout.write(semantics.typedDump(ref c))
    return exitOk
}

/// CliApp.cs `Check` (csharp/Bayan.Cli/CliApp.cs:461).
i32 checkCommand(in List<string> kept, by in DCtx d) {
    let clock = Io.monotonicNanos()
    let args = t2Rest(kept)
    let o = t5ParseBuildOptions(in args, by: false, for: false) ?? return exitUsage
    let symbols = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    var c = t5Compile(
        in o,
        by: in symbols,
        to: ref reported,
        through: ref ok,
        ascii: d.styleErr.ascii,
        width: d.styleErr.width,
        isTty: d.stderrTty,
        styleLints: true,
    )
    unless ok {
        return semantics.t26Failed(in t5T26(in o), from: in reported, by: in symbols)
    }
    unless o.json {
        let dot = semantics.t26Symbols(d.styleOut.ascii).dot
        print(
            t5Paint(
                .success,
                by: d.styleOut,
                for: semantics.checkSummary(
                    dot,
                    for: semantics.programName(ref c, for: o.path),
                    by: semantics.t26Seconds(Io.monotonicNanos() - clock),
                ),
            ),
        )
    }
    return exitOk
}
