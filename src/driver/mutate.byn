// `test --mutate` and `mutate` of the self-hosted driver (spec 017 T13). Ports `CliApp.cs` :855 `MutateTests`, :888
// `MutateBinary`, :928 `ShellCommand`, :932 `RunExternal`, :951 `ReportGates`, :961 `ExternalLine`, :965 `StatusName`, :975
// `MutantLine` and :986 `ShellQuote`, with `MutationRunner.cs` :31 `Run`, :61 `Mutant`, :85 `RunExternal` and :127 `Exec`, and
// `ExternalSite.cs` :8 `From` and :14 `ReadAll`. The mutation report and gate are quality.byn.

import semantics
import emitter
import emitter.cprint
import lexer
import std.json

/// `MutantStatus` (MutationRunner.cs), in its declaration order, which `Messages.MutateTotals` counts in.
enum MutantStatus {
    killed
    survived
    timeout
    notReached
    marked
    notEmitted
}

/// `ExternalSite` (ExternalSite.cs:6): a site as `<binary>.sites.json` carries it.
struct ExternalSite {
    i64     id
    string  file
    i64     line
    i64     column
    string  op
    string  original
    string  mutated
    bool    emitted      = true
    string? unobservable = null
}

/// `ExternalResult` (ExternalSite.cs:39): `seconds` is the run's `Elapsed.TotalSeconds`, 0 when not run.
struct ExternalResult {
    ExternalSite site
    MutantStatus status
    f64          seconds = 0.0
}

/// `MutantResult` (MutationRunner.cs) with its `SchemaSite` as `ExternalSite.From` makes it, the one form its readers use.
struct MutantResult {
    ExternalSite site
    MutantStatus status
    i64          runs     = 0
    i64?         killedBy = null
}

/// `MutationResult` (MutationRunner.cs).
struct MutationResult {
    List<MutantResult> mutants = []
    List<i64> excluded  = []
    i64       processes = 0
}

/// `Outcome` (MutationRunner.cs): `elapsedNanos` is `Elapsed`.
struct T13Outcome {
    i32  exitCode     = 0
    bool timedOut     = false
    i64  elapsedNanos = 0
}

/// CliApp.cs:855 `MutateTests`: one schemata build, then every mutant run against the tests that reach it, a line per mutant and
/// the totals; the site map is written beside the binary.
i32 mutateTests(in T11Options o, through ref semantics.Ctx compiled, by ref DCtx d)
        uses alloc, clock, console, env, fs, process, random {
    let none = List<string>()
    var schema = emitter.buildSchema(ref compiled, for: in none)
    let sites = emitter.sitesJson(in schema)
    var l = T11LCtx {}
    l.mutating = true
    l.mutants = schema.switches.take()
    let program = emitter.lower(ref compiled, to: ref l)
    let source = cprint.emit(ref compiled, from: in l.tree, through: in program, by: o.mode == "debug")
    let host = t5HostTarget()
    var output: string? = null
    if (t5PrepareOut(in compiled, by: o.mode, for: host, from: source) is { } dir) {
        output = Path.combine(
            dir,
            targetExecutableName($"{semantics.programName(ref compiled, for: o.path)}-mutate", for: host),
        )
    }
    let built = Io.monotonicNanos()
    var progress = start(in d.styleErr, by: d.stderrTty, through: o.json, for: "building")
    let native = t9Build(source, by: o.mode, to: output, for: null, through: ref d)
    done(ref progress)
    unless native.result.succeeded {
        t5ReportToolchain(native.result, by: o.json, for: t19Symbols(in d.styleErr))
        return exitToolchain
    }
    let executable = native.exe
    let path = emitter.sitesPath(executable)
    // `File.WriteAllText` throws, uncaught, when the site map cannot be written.
    // coverage-exempt: Q1258 an IO failure the C# lets escape
    Io.writeFile(path, sites.bytes) catch { panic($"cannot write {path}") }
    if (o.run is { } run) {
        let full = Path.fullPath(o.path)
        let root = compiled.manifest is not null ? compiled.displayRoot : t5DirectoryExists(
            o.path,
        ) ? full : Path.directoryName(full)
            ?? ""
        let map = externalSiteReadAll(sites) ?? panic("the site map just written is not one")
        return runExternal(
            in map,
            by: in shellCommand(run),
            for: executable,
            through: "bayan test --mutate --run",
            to: Path.combine(Path.combine(root, "out"), "test"),
            as: Io.monotonicNanos() - built,
            minMutation: t13MinMutation(in compiled),
        )
    }
    let work = Path.combine(t9TempPath(), $"bayan-mutate-{t9Unique(ref d)}")
    // `Directory.CreateTempSubdirectory` throws, uncaught, when the temporary directory cannot be written.
    // coverage-exempt: Q1258 an IO failure the C# lets escape
    Io.createDirectory(work) catch { panic($"cannot create the directory {work}") }
    var tests = List<i64>()
    for i in 0..program.tests.length {
        tests.append(i)
    }
    let result = mutationRun(executable, by: in schema, for: in tests, through: work, as: testTimeout())
    for t in result.excluded {
        Io.stderr.write($"test {compiled.tests[program.tests[t]].title} does not pass unmutated; left out\n")
    }
    var counts = [0, 0, 0, 0, 0, 0]
    for m in result.mutants {
        counts[t13Index(m.status)] += 1
    }
    print(
        $"{counts[0]} killed, {counts[1]} survived, {counts[2]} timeout, {counts[3]} not reached, {counts[4]} marked, {counts[5]} not emitted",
    )
    // CliApp.cs:878-879, inside the `try` whose `finally` deletes the work directory.
    var failed = false
    if (t13MinMutation(in compiled) is { } min) {
        let noSeconds = List<f64>()
        failed = reportGates(
            in gatesMutation(
                in qualityMutationResult(
                    "bayan test --mutate",
                    from: in result,
                    by: in schema,
                    through: 0,
                    for: in noSeconds,
                    as: 0,
                ),
                by: min,
            ),
        )
    }
    deleteWorkDir(work)
    return failed ? exitTestFailure : exitOk
}

/// `compiled.Manifest?.MinMutation`.
i64? t13MinMutation(in semantics.Ctx compiled) {
    if (compiled.manifest is { } manifest) {
        return manifest.minMutation
    }
    return null
}

/// The position of `s` in `MutantStatus`'s declaration order (`Enum.GetValues`).
i64 t13Index(MutantStatus s) {
    switch s {
        case .killed:
            return 0
        case .survived:
            return 1
        case .timeout:
            return 2
        case .notReached:
            return 3
        case .marked:
            return 4
        case .notEmitted:
            return 5
    }
}

/// CliApp.cs:888 `MutateBinary`: `bayan mutate --binary <exe> --sites <map.json> [--jobs N] -- <cmd>`, the command run once per site
/// of a prebuilt schemata binary, up to N sites at once (`--jobs`, else `$BAYAN_MUTATE_JOBS`, else 1; `mutationRunExternal`).
i32 mutateBinary(in List<string> args) uses alloc, clock, console, env, fs, process {
    return mutateWorker(args) if args.length > 0 && args[0] == "--mutate-worker"
    var binary: string? = null
    var sites: string? = null
    var jobsText: string? = null
    var jobsName = "--jobs"
    var command = List<string>()
    var i: i64 = 0
    while i < args.length {
        if args[i] == "--binary" && i + 1 < args.length {
            i += 1
            binary = args[i]
        } else if args[i] == "--sites" && i + 1 < args.length {
            i += 1
            sites = args[i]
        } else if args[i] == "--jobs" && i + 1 < args.length {
            i += 1
            jobsText = args[i]
        } else if args[i] == "--" {
            for k in (i + 1)..args.length {
                command.append(args[k])
            }
            i = args.length
        } else {
            Io.stderr.write($"bayan: unexpected argument `{args[i]}`\n")
            return exitUsage
        }
        i += 1
    }
    let b = binary ?? ""
    let s = sites ?? ""
    if binary is null || sites is null || command.length == 0 {
        Io.stderr.write("bayan: usage: bayan mutate --binary <exe> --sites <map.json> [--jobs N] -- <command>\n")
        return exitUsage
    }
    if jobsText is null {
        jobsText = Env.get("BAYAN_MUTATE_JOBS")
        jobsName = "BAYAN_MUTATE_JOBS"
    }
    let jt = jobsText ?? "1"
    var jobs = t9Digits(jt, until: 2147483647) ?? 0
    if jobs == 0 {
        Io.stderr.write($"bayan: `{jobsName}` expects a positive whole number, got `{jt}`\n")
        return exitUsage
    }
    // the workers are this driver started again (`mutateWorker`), which the runtime can only name through `$BAYAN_EXE`, as the golden
    // runner's `--jobs` workers (golden.byn `goldenJobs`); Windows has no `sh` to start them
    var driver = ""
    // coverage-exempt: Q1286 through `jobs = 1` the Windows arm
    if jobs > 1 && Target.os == "windows" {
        Io.stderr.write($"bayan: Windows has no `sh` to start mutant workers: {jobsName} {jobs} runs as 1\n")
        jobs = 1
    } else if jobs > 1 {
        driver = Env.get("BAYAN_EXE") ?? ""
        // coverage-exempt: Q1286 through `names no file` needs BAYAN_EXE to name no file
        unless Fs.fileExists(driver) {
            Io.stderr.write(
                $"bayan: {jobsName} {jobs} starts its workers through `BAYAN_EXE`, which names no file: `{driver}`\n",
            )
            // coverage-exempt: Q1286 needs BAYAN_EXE to name no file
            return exitUsage
        }
    }
    for path in [b, s] {
        unless Fs.fileExists(path) {
            Io.stderr.write($"bayan: not found: {path}\n")
            return exitUsage
        }
    }
    // `File.ReadAllText` throws, uncaught, when the existing site map cannot be read.
    // coverage-exempt: Q1258 an IO failure the C# lets escape
    let bytes = Io.readFile(s) catch { panic($"cannot read {s}") }
    let text = t13ReadAllText(in bytes)
    let map = externalSiteReadAll(text) ?? return t13BadSites(s)
    let full = Path.fullPath(b)
    var min: i64? = null
    // coverage-exempt: Q1286 through `min = manifest.minMutation` needs `package.byn` in the working directory
    if Fs.fileExists("package.byn") {
        // `Manifest.Read` throws, uncaught, when the existing manifest cannot be read.
        // coverage-exempt: Q1258 an IO failure the C# lets escape
        let manifest = semantics.manifestRead("package.byn") catch { panic("cannot read package.byn") }
        min = manifest.minMutation
    }
    return runExternal(
        in map,
        by: in command,
        for: full,
        through: "bayan mutate",
        to: Path.directoryName(full) ?? "",
        as: 0,
        minMutation: min,
        jobs: jobs,
        driver: driver,
    )
}

/// CliApp.cs:911-913: `Messages.MutateBadSites`, exit 2.
i32 t13BadSites(string sites) uses alloc, console {
    Io.stderr.write($"bayan: `{sites}` is not a version 1 site map\n")
    return exitUsage
}

/// CliApp.cs:918 `File.ReadAllText`: the bytes decoded in the encoding their byte order mark names, as `StreamReader`'s
/// `DetectEncoding` reads it (UTF-16 or UTF-32, either byte order, or UTF-8), else as UTF-8; the mark dropped, each invalid
/// sequence decoded as U+FFFD.
string t13ReadAllText(in List<u8> b) uses alloc {
    return t13DecodeWide(in b, from: 2, by: 2, as: true) if t13Starts(in b, for: [0xFE, 0xFF])
    return t13DecodeWide(in b, from: 4, by: 4, as: false) if t13Starts(in b, for: [0xFF, 0xFE, 0x00, 0x00])
    return t13DecodeWide(in b, from: 2, by: 2, as: false) if t13Starts(in b, for: [0xFF, 0xFE])
    return t13DecodeUtf8(in b, from: 3) if t13Starts(in b, for: [0xEF, 0xBB, 0xBF])
    return t13DecodeWide(in b, from: 4, by: 4, as: true) if t13Starts(in b, for: [0x00, 0x00, 0xFE, 0xFF])
    return t13DecodeUtf8(in b, from: 0)
}

/// `UTF8Encoding` decoding of `b` from `start`, with `Encoding`'s replacement fallback: each maximal subpart of an
/// ill-formed sequence (a lead byte and the continuation bytes that can follow it) becomes one U+FFFD.
string t13DecodeUtf8(in List<u8> b, from i64 start) uses alloc {
    var utf8 = List<u8>()
    var i = start
    while i < b.length {
        let c = i64(b[i])
        if c < 0x80 {
            utf8.append(b[i])
            i += 1
            continue
        }
        var need: i64 = 0
        var lo: i64 = 0x80
        var hi: i64 = 0xBF
        if c is 0xC2..=0xDF {
            need = 1
        } else if c is 0xE0..=0xEF {
            need = 2
            if c == 0xE0 {
                lo = 0xA0
            }
            if c == 0xED {
                hi = 0x9F
            }
        } else if c is 0xF0..=0xF4 {
            need = 3
            if c == 0xF0 {
                lo = 0x90
            }
            if c == 0xF4 {
                hi = 0x8F
            }
        }
        var k: i64 = 1
        while k <= need && i + k < b.length && i64(b[i + k]) >= lo && i64(b[i + k]) <= hi {
            k += 1
            lo = 0x80
            hi = 0xBF
        }
        if need > 0 && k > need {
            for j in i..i + k {
                utf8.append(b[j])
            }
        } else {
            t13AppendUtf8(ref utf8, for: 0xFFFD)
        }
        i += k
    }
    return Utf8.decode(utf8, invalid: .replace)
}

/// Whether `b` starts with `prefix`.
bool t13Starts(in List<u8> b, for ReadOnlySpan<u8> prefix) {
    return false if b.length < prefix.length
    for i in 0..prefix.length {
        return false if b[i] != prefix[i]
    }
    return true
}

/// `UnicodeEncoding` (`width` 2) or `UTF32Encoding` (`width` 4) decoding of `b` from `start`, with `Encoding`'s replacement
/// fallback: an unpaired surrogate, a value past U+10FFFF and a trailing partial unit each become U+FFFD.
string t13DecodeWide(in List<u8> b, from i64 start, by i64 width, as bool bigEndian) uses alloc {
    var utf8 = List<u8>()
    var i = start
    while i + width <= b.length {
        let u = t13Unit(in b, at: i, by: width, as: bigEndian)
        i += width
        var cp = u
        if width == 2 && u >= 0xD800 && u <= 0xDBFF {
            cp = 0xFFFD
            if i + 2 <= b.length {
                let low = t13Unit(in b, at: i, by: 2, as: bigEndian)
                if low is 0xDC00..=0xDFFF {
                    cp = 0x10000 + (u - 0xD800) * 1024 + (low - 0xDC00)
                    i += 2
                }
            }
        } else if u is 0xD800..=0xDFFF or > 0x10FFFF {
            cp = 0xFFFD
        }
        t13AppendUtf8(ref utf8, for: cp)
    }
    if i < b.length {
        t13AppendUtf8(ref utf8, for: 0xFFFD)
    }
    return Utf8.decode(utf8, invalid: .replace)
}

/// The `width`-byte unit of `b` at `i`, in the byte order `bigEndian` names.
i64 t13Unit(in List<u8> b, at i64 i, by i64 width, as bool bigEndian) {
    var u: i64 = 0
    for k in 0..width {
        u = u * 256 + i64(b[bigEndian ? i + k : i + width - 1 - k])
    }
    return u
}

/// `cp` appended to `utf8` as UTF-8.
void t13AppendUtf8(ref List<u8> utf8, for i64 cp) uses alloc {
    if cp < 0x80 {
        utf8.append(u8(cp))
    } else if cp < 0x800 {
        utf8.append(u8(0xC0 | (cp >> 6)))
        utf8.append(u8(0x80 | (cp & 0x3F)))
    } else if cp < 0x10000 {
        utf8.append(u8(0xE0 | (cp >> 12)))
        utf8.append(u8(0x80 | ((cp >> 6) & 0x3F)))
        utf8.append(u8(0x80 | (cp & 0x3F)))
    } else {
        utf8.append(u8(0xF0 | (cp >> 18)))
        utf8.append(u8(0x80 | ((cp >> 12) & 0x3F)))
        utf8.append(u8(0x80 | ((cp >> 6) & 0x3F)))
        utf8.append(u8(0x80 | (cp & 0x3F)))
    }
}

/// CliApp.cs:928 `ShellCommand`.
List<string> shellCommand(string command) uses alloc {
    // coverage-exempt: Q1258 through `["cmd", "/c", command]` Windows
    if Target.os == "windows" {
        return ["cmd", "/c", command]
    }
    return ["/bin/sh", "-c", command]
}

/// CliApp.cs:932 `RunExternal`: the command over `sites`, a line per site and the report summary, and `bayan-quality.json` written
/// to `reportDir`; `jobs` sites at once through the workers `driver` starts (`mutationRunExternal`).
i32 runExternal(
    in List<ExternalSite> sites,
    by in List<string> command,
    for string binary,
    through string tool,
    to string reportDir,
    as i64 buildNanos,
    i64? minMutation = null,
    i64 jobs = 1,
    string driver = ""
) uses alloc, clock, console, env, fs, process {
    let total = Io.monotonicNanos()
    let results = mutationRunExternal(
        in sites,
        by: in command,
        for: binary,
        as: testTimeout(),
        jobs: jobs,
        driver: driver,
    )
        ?? return t13BaselineFailed()
    let report = qualityMutation(tool, from: in results, by: buildNanos, as: Io.monotonicNanos() - total)
    let none = List<string>()
    Io.stdout.write(qualitySummary(in report, by: in none))
    // coverage-exempt: Q1258 through `Io.writeFile(path, qualityMutationJson` an IO failure the C# lets escape
    Io.createDirectory(reportDir) catch { panic($"cannot create the directory {reportDir}") }
    let path = Path.combine(reportDir, "bayan-quality.json")
    Io.writeFile(path, qualityMutationJson(in report).bytes) catch { panic($"cannot write {path}") }
    return reportGates(in gatesMutation(in report, by: minMutation)) ? exitTestFailure : exitOk
}

/// CliApp.cs:939-941: `Messages.MutateBaselineFailed`, exit 1.
i32 t13BaselineFailed() uses console {
    Io.stderr.write("bayan: the command does not exit 0 on the unmutated binary\n")
    return exitFailure
}

/// CliApp.cs:951 `ReportGates`: a line per failed gate, then what it misses; whether any failed.
bool reportGates(in List<GateFailure> failures) uses alloc, console {
    for f in failures {
        Io.stderr.write($"bayan: {f.name} {gatesFmt(f.covered, by: f.total)}% < {f.min}%\n")
        for line in f.missing {
            Io.stderr.write($"{line}\n")
        }
    }
    return failures.length > 0
}

/// CliApp.cs:961 `ExternalLine`.
string externalLine(in ExternalResult r) uses alloc => t13Line(in r.site, by: r.status)

/// CliApp.cs:965 `StatusName`.
string statusName(MutantStatus s) {
    switch s {
        case .killed:
            return "killed"
        case .survived:
            return "survived"
        case .timeout:
            return "timeout"
        case .notReached:
            return "not reached"
        case .marked:
            return "marked"
        case .notEmitted:
            return "not emitted"
    }
}

/// CliApp.cs:975 `MutantLine`.
string mutantLine(in MutantResult m) uses alloc => t13Line(in m.site, by: m.status)

/// `Messages.MutateLine` with `MutateTimeoutNote`, which `ExternalLine` and `MutantLine` both print.
string t13Line(in ExternalSite s, by MutantStatus status) uses alloc {
    return $"{s.file}:{s.line}:{s.column} {s.op} `{s.original}` -> `{s.mutated}`: {statusName(status)}{status == .timeout ? " (counted as killed)" : ""}"
}

/// CliApp.cs:986 `ShellQuote`: double quotes when nothing in `text` expands there, else single quotes with `'` as `'\''`.
string shellQuote(string text) uses alloc {
    for c in ["$", "`", "\\", "\"", "!"] {
        return $"'{text.replaced("'", by: "'\\''")}'" if text.contains(c)
    }
    return $"\"{text}\""
}

/// MutationRunner.cs:31 `Run`: each test once unmutated (mutant 0) with its reach file, then every site against the tests that
/// reach it. `onMutant` is the one caller's (CliApp.cs:866): the mutant's line on stdout.
MutationResult mutationRun(
    string executable,
    by in emitter.Schema schema,
    for in List<i64> tests,
    through string workDir,
    as i64 baselineMs
) uses alloc, clock, console, fs, process {
    var processes: i64 = 0
    var time: Map<i64, i64> = []
    var reach: Map<i64, Map<i64, bool>> = []
    var excluded = List<i64>()
    for t in tests {
        let path = Path.combine(workDir, $"reach.{t}")
        t9DeleteFile(path)
        let outcome = t13Exec(executable, at: t, by: 0, for: path, as: baselineMs)
        processes += 1
        // A pending test (exit 4) is left out without a warning; it is not meant to pass yet.
        // A timed-out run's exit code is -1 (`t13Run`), so `!timedOut` never fails after exit 4 and exit 0 is never timed out.
        // coverage-exempt: Q1258 through `if outcome.exitCode != 0 || outcome.timedOut` the conditions MutationRunner.cs:45-46 test
        continue if outcome.exitCode == 4 && !outcome.timedOut
        if outcome.exitCode != 0 || outcome.timedOut {
            excluded.append(t)
            continue
        }
        time[t] = outcome.elapsedNanos
        var ids: Map<i64, bool> = []
        // A run that exits 0 writes the reach file at exit (CEmitter.cs:182 `atexit`); reading it fails only on an IO error the C# lets escape.
        // coverage-exempt: Q1258 through `let text = Io.readText(path)` a passing run always writes its reach file
        if Fs.fileExists(path) {
            let text = Io.readText(path) catch { panic($"cannot read {path}") }
            for line in t11ReadAllLines(text) {
                ids[t9Digits(line, until: 2147483647) ?? panic($"`{line}` is not a site id")] = true
            }
        }
        reach[t] = move ids
    }
    var ran = List<i64>()
    for t in tests {
        if time.contains(t) {
            ran.append(t)
        }
    }
    var results = List<MutantResult>()
    for site in schema.sites {
        // Another process sweeps `bayan-mutate-*` directories idle for an hour; this one is in use.
        Fs.setModified(workDir, to: Time.now()) catch {}
        let result = t13Mutant(executable, by: in site, for: in ran, through: in reach, as: in time, to: ref processes)
        print(mutantLine(in result))
        results.append(result)
    }
    return MutationResult { mutants: move results, excluded: move excluded, processes: processes }
}

/// MutationRunner.cs:61 `Mutant`: a reaching test that fails or times out kills the site; a marked one that none kills is marked.
MutantResult t13Mutant(
    string executable,
    by in emitter.SchemaSite site,
    for in List<i64> tests,
    through in Map<i64,
    Map<i64,
    bool>> reach,
    as in Map<i64,
    i64> time,
    to ref i64 processes
) uses alloc, clock, process {
    let s = externalSiteFrom(in site)
    unless site.emitted {
        return MutantResult { site: s, status: .notEmitted }
    }
    var runs: i64 = 0
    for t in tests {
        unless reach[t].contains(site.id) {
            continue
        }
        let limit = t13Limit(time[t])
        let outcome = t13Exec(executable, at: t, by: site.id, for: null, as: limit)
        runs += 1
        processes += 1
        return MutantResult { site: s, status: .timeout, runs: runs, killedBy: t } if outcome.timedOut
        return MutantResult { site: s, status: .killed, runs: runs, killedBy: t } if outcome.exitCode != 0
    }
    // A marked mutant still runs; one a test kills stays killed so the report can warn that the mark is wrong.
    return MutantResult { site: s, status: .marked, runs: runs } if site.unobservable is not null
    return MutantResult { site: s, status: runs == 0 ? .notReached : .survived, runs: runs }
}

/// `TimeSpan.FromTicks(Math.Max(TimeSpan.TicksPerSecond, 5 * elapsed.Ticks))` in whole milliseconds, truncated as
/// `WaitForExit(limit)` (MutationRunner.cs:161) truncates it (Q1258).
i64 t13Limit(i64 elapsedNanos) {
    let ticks = elapsedNanos / 100
    let limit = ticks * 5 > 10000000 ? ticks * 5 : 10000000
    return limit / 10000
}

/// The limit of a mutant of the external route, the owner's rule of 2026-11-05 (Decision 2026-11-20: after the dotnet exit this
/// route no longer follows the C# runner): the mutant-0 time x 1.5 + 5 s, in whole milliseconds, truncated.
i64 t13ExternalLimit(i64 elapsedNanos) => elapsedNanos * 3 / 2 / 1000000 + 5000

/// MutationRunner.cs:85 `RunExternal`: `command` once per emitted site with `BAYAN_MUTANT` set to its id and `BAYAN_BINARY` to
/// `binary` (CliApp.cs:936), each bounded by `t13ExternalLimit` of the unmutated run (mutant 0). With `jobs` above 1 the sites run
/// in that many worker processes of `driver` (`t13Workers`), started after mutant 0 ran alone, and their lines are printed once
/// all have run, in site order. Null when mutant 0 cannot start or does not exit 0 within `baselineMs`.
List<ExternalResult>? mutationRunExternal(
    in List<ExternalSite> sites,
    by in List<string> command,
    for string binary,
    as i64 baselineMs,
    i64 jobs = 1,
    string driver = ""
) uses alloc, clock, console, env, fs, process {
    // The command could not be started (not found, not executable).
    let baseline = t13RunCommand(in command, at: 0, by: binary, as: baselineMs) ?? return null
    return null if baseline.timedOut || baseline.exitCode != 0
    let timeout = t13ExternalLimit(baseline.elapsedNanos)
    var dir = ""
    if jobs > 1 {
        dir = t13Workers(sites, by: command, for: binary, as: timeout, to: jobs, through: driver)
    }
    var results = List<ExternalResult>()
    for i in 0..sites.length {
        let site = sites[i]
        var result = ExternalResult { site: site, status: .notEmitted }
        if site.emitted {
            // `Process.Start` throws, uncaught, when the command the baseline ran cannot start for a site (MutationRunner.cs:120);
            // a worker that could not start it, or stopped, wrote no outcome for the site.
            // coverage-exempt: Q1258 a command that started for the baseline cannot start for a site
            let outcome = (dir == ""
                ? t13RunCommand(in command, at: site.id, by: binary, as: timeout)
                : t13WorkerOutcome(dir, at: i))
                ?? panic($"cannot run {command[0]}{t13WorkerErr(dir, by: jobs)}")
            let status: MutantStatus = outcome.timedOut ? .timeout : outcome.exitCode != 0 ? .killed : site.unobservable is not null ? .marked : .survived
            result = ExternalResult { site: site, status: status, seconds: f64(outcome.elapsedNanos / 100) / 1e7 }
        }
        print(externalLine(in result))
        results.append(result)
    }
    if dir != "" {
        deleteWorkDir(dir)
    }
    return results
}

/// `sh -c` text: starts `$1 mutate --mutate-worker $3 <k> $2 $4 $5 -- <command>` for k from 0 to `$2 - 1` in the background, the
/// command being the arguments after `$5`, stdout dropped and stderr in `$3`/err-<k>, and waits for all.
const t13WorkersScript: string = "exe=$1 n=$2 dir=$3 limit=$4 bin=$5; shift 5; k=0; while [ \"$k\" -lt \"$n\" ]; do \"$exe\" mutate --mutate-worker \"$dir\" \"$k\" \"$n\" \"$limit\" \"$bin\" -- \"$@\" >/dev/null 2>\"$dir/err-$k\" & k=$((k + 1)); done; wait"

/// The emitted `sites` run by `jobs` workers of `driver` (`mutateWorker`), each mutant within `limitMs`: their outcomes are in the
/// returned directory, a file per site index (`t13WorkerOutcome`). The directory, under the temp path and named for this run, is the
/// only one the workers write; each writes only the files of its own sites and its own err-<k>.
string t13Workers(
    List<ExternalSite> sites,
    by List<string> command,
    for string binary,
    as i64 limitMs,
    to i64 jobs,
    through string driver
) uses alloc, clock, env, fs, process {
    let dir = Path.combine(t9TempPath(), $"bayan-mutjobs-{Io.monotonicNanos()}")
    deleteWorkDir(dir)
    var list = StrBuf()
    for s in sites {
        list.append(s.emitted ? $"{s.id}\n" : "-\n")
    }
    // coverage-exempt: Q1258 through `Io.writeFile` an IO failure in the temp directory
    Io.createDirectory(dir) catch { panic($"cannot create the directory {dir}") }
    let path = Path.combine(dir, "sites")
    Io.writeFile(path, list.finish().bytes) catch { panic($"cannot write {path}") }
    var args = List<string>()
    for a in ["-c", t13WorkersScript, "sh", driver, $"{jobs}", dir, $"{limitMs}", binary] {
        args.append(a)
    }
    for a in command {
        args.append(a)
    }
    // a failure to start `sh` leaves every outcome unwritten, which `mutationRunExternal` reports at the first site
    // coverage-exempt: Q1286 needs `sh` to fail to start
    let _ = Io.run("sh", args.span) catch return dir
    return dir
}

/// The outcome worker `mutateWorker` wrote for site index `i` in `dir`; null when there is none.
T13Outcome? t13WorkerOutcome(string dir, at i64 i) uses alloc, fs {
    let text = Io.readText(Path.combine(dir, $"{i}")) catch return null
    var parts = List<string>()
    for p in text.trimmed().parts(by: " ") {
        parts.append(p)
    }
    return null if parts.length != 3
    let timedOut = t9Digits(parts[0], until: 1) ?? return null
    let failed = t9Digits(parts[1], until: 1) ?? return null
    let elapsed = t9Digits(parts[2], until: 9223372036854775807) ?? return null
    return T13Outcome { exitCode: failed == 1 ? 1 : 0, timedOut: timedOut == 1, elapsedNanos: elapsed }
}

/// The `jobs` workers' stderr in `dir` as the end of the message that no outcome was written; empty without workers.
string t13WorkerErr(string dir, by i64 jobs) uses alloc, fs {
    return "" if dir == ""
    var text = StrBuf()
    for k in 0..jobs {
        text.append(Io.readText(Path.combine(dir, $"err-{k}")) catch "")
    }
    return $" (a mutant worker wrote no outcome; the workers' stderr: {text.finish()})"
}

/// `bayan mutate --mutate-worker <dir> <k> <n> <limitMs> <binary> -- <command>`, a worker of `t13Workers`: of the sites in `dir`/sites
/// (an id per line, `-` for one not emitted), the emitted ones whose position among the emitted is `k` modulo `n`, each run through
/// `t13RunCommand` within `limitMs`, its outcome written to `dir`/<index> as `<timed out 0|1> <failed 0|1> <elapsed ns>`.
/// `exitUsage` on bad arguments; `exitFailure` when the command cannot start or an outcome cannot be written.
i32 mutateWorker(List<string> args) uses alloc, clock, console, fs, process {
    if args.length < 8 || args[6] != "--" {
        Io.stderr.write("bayan: usage: bayan mutate --mutate-worker <dir> <k> <n> <limitMs> <binary> -- <command>\n")
        return exitUsage
    }
    let dir = args[1]
    let k = t9Digits(args[2], until: 2147483647) ?? return exitUsage
    let n = t9Digits(args[3], until: 2147483647) ?? return exitUsage
    let limit = t9Digits(args[4], until: 9223372036854775807) ?? return exitUsage
    return exitUsage if n == 0
    var command = List<string>()
    for i in 7..args.length {
        command.append(args[i])
    }
    let path = Path.combine(dir, "sites")
    let text = Io.readText(path) catch {
        Io.stderr.write($"bayan: cannot read {path}\n")
        return exitFailure
    }
    let lines = t11ReadAllLines(text)
    var emitted: i64 = 0
    for i in 0..lines.length {
        continue if lines[i] == "-"
        emitted += 1
        continue if (emitted - 1) % n != k
        let id = t9Digits(lines[i], until: 9223372036854775807) ?? return exitUsage
        let ran = t13RunCommand(in command, at: id, by: args[5], as: limit)
        if ran is null {
            Io.stderr.write($"bayan: cannot run {command[0]} for mutant {id}\n")
            return exitFailure
        }
        // coverage-exempt: Q1286 the null result already returned at the `if ran is null` above
        if (ran is { } o) {
            let file = Path.combine(dir, $"{i}")
            Io.writeFile(file, $"{o.timedOut ? 1 : 0} {o.exitCode != 0 ? 1 : 0} {o.elapsedNanos}\n".bytes) catch {
                Io.stderr.write($"bayan: cannot write {file}\n")
                return exitFailure
            }
        }
    }
    return exitOk
}

/// `Run` (MutationRunner.cs:88) of the external command; null when it cannot start (`Win32Exception`).
T13Outcome? t13RunCommand(in List<string> command, at i64 mutant, by string binary, as i64 limitMs)
        uses alloc, clock, process {
    var args = List<string>()
    for k in 1..command.length {
        args.append(command[k])
    }
    var env: Map<string, string?> = []
    env["BAYAN_BINARY"] = binary
    env["BAYAN_MUTANT"] = $"{mutant}"
    return t13Run(command[0], by: in args, for: in env, as: limitMs)
}

/// MutationRunner.cs:127 `Exec`: `executable --test <test>` with `BAYAN_MUTANT` set and `BAYAN_SITE_REACH` set or removed.
T13Outcome t13Exec(string executable, at i64 index, by i64 mutant, for string? reachPath, as i64 limitMs)
        uses alloc, clock, process {
    var args = List<string>()
    args.append("--test")
    args.append($"{index}")
    var env: Map<string, string?> = []
    env["BAYAN_MUTANT"] = $"{mutant}"
    env["BAYAN_SITE_REACH"] = reachPath
    // `Process.Start` of the just-built executable throws, uncaught, when it cannot start.
    // coverage-exempt: Q1258 through `panic` the executable just built cannot start
    return t13Run(executable, by: in args, for: in env, as: limitMs) ?? panic($"cannot run {executable}")
}

/// MutationRunner.cs `Exec(psi, limit)`: the output is discarded; a signal-killed run is exit 128 + the signal, as
/// `Process.ExitCode` reports it. Null when the program cannot start.
T13Outcome? t13Run(string program, by in List<string> args, for in Map<string, string?> env, as i64 limitMs)
        uses alloc, clock, process {
    let clock = Io.monotonicNanos()
    let r = Io.run(program, args.span, env: env, timeout: Millis(limitMs)) catch switch {
        .timeout(
            _,
            _,
            _
        ) => return T13Outcome { exitCode: -1, timedOut: true, elapsedNanos: Io.monotonicNanos() - clock },
        .signaled(let s, let _, let _) => return T13Outcome {
            exitCode: 128 + s,
            elapsedNanos: Io.monotonicNanos() - clock,
        },
        IoError e => return null,
    }
    return T13Outcome { exitCode: r.exitCode, elapsedNanos: Io.monotonicNanos() - clock }
}

/// ExternalSite.cs:8 `From`.
ExternalSite externalSiteFrom(in emitter.SchemaSite s) uses alloc {
    return ExternalSite {
        id: s.id,
        file: s.site.file,
        line: s.site.line,
        column: s.site.column,
        op: s.site.op,
        original: s.site.original,
        mutated: s.site.mutated,
        emitted: s.emitted,
        unobservable: s.unobservable,
    }
}

/// ExternalSite.cs:14 `ReadAll`: a site map; null when it is not one this version understands. `JsonDocument.Parse` is
/// `std.json`'s reader with `JsonReaderOptions`' default depth limit, 64 (Q1258).
List<ExternalSite>? externalSiteReadAll(string text) uses alloc {
    let parsed = json.Json.parse(text) catch return null
    let root = (move parsed).trustUnchecked() because "a site map only names sites; each field is checked below"
    return null if t13Depth(in root) > 64
    switch root {
        case .object(let members):
            let version = t13Find(in members, for: "version")
            return null if version < 0 || t13Int(in members[version].value) != 1
            let sites = t13Find(in members, for: "sites")
            return null if sites < 0
            var list = List<ExternalSite>()
            switch members[sites].value {
                case .list(let items):
                    for s in items {
                        list.append(t13Site(in s) ?? return null)
                    }
                default:
                    return null
            }
            return list
        default:
            return null
    }
}

/// The nesting depth of `v` as `Utf8JsonReader` counts it against `MaxDepth`: one per object or array.
i64 t13Depth(in json.JsonValue v) {
    var deepest: i64 = 0
    switch v {
        case .object(let members):
            for m in members {
                let d = t13Depth(in m.value)
                if d > deepest {
                    deepest = d
                }
            }
            return deepest + 1
        case .list(let items):
            for x in items {
                let d = t13Depth(in x)
                if d > deepest {
                    deepest = d
                }
            }
            return deepest + 1
        default:
            return 0
    }
}

/// One site of `ReadAll`; null where the C# throws.
ExternalSite? t13Site(in json.JsonValue s) uses alloc {
    switch s {
        case .object(let members):
            let id = t13IntMember(in members, for: "id") ?? return null
            let file = t13Str(in members, for: "file") ?? return null
            let line = t13IntMember(in members, for: "line") ?? return null
            let column = t13IntMember(in members, for: "column") ?? return null
            let op = t13Str(in members, for: "operator") ?? return null
            let original = t13Str(in members, for: "original") ?? return null
            let mutated = t13Str(in members, for: "mutated") ?? return null
            var emitted = true
            let e = t13Find(in members, for: "emitted")
            if e >= 0 {
                switch members[e].value {
                    case .flag(let b):
                        emitted = b
                    default:
                        return null
                }
            }
            var unobservable: string? = null
            let u = t13Find(in members, for: "unobservable")
            if u >= 0 {
                switch members[u].value {
                    case .text(let v):
                        unobservable = v
                    case .nothing:
                        unobservable = null
                    default:
                        return null
                }
            }
            return ExternalSite {
                id: id,
                file: file,
                line: line,
                column: column,
                op: op,
                original: original,
                mutated: mutated,
                emitted: emitted,
                unobservable: unobservable,
            }
        default:
            return null
    }
}

/// `TryGetProperty`/`GetProperty`: the index of the last member named `key`, as `JsonDocument` reads a duplicate; -1 when none.
i64 t13Find(in List<json.JsonMember> members, for string key) {
    var found: i64 = -1
    for i in 0..members.length {
        if members[i].key == key {
            found = i
        }
    }
    return found
}

/// `GetProperty(key).GetInt32()`; null where it throws.
i64? t13IntMember(in List<json.JsonMember> members, for string key) uses alloc {
    let i = t13Find(in members, for: key)
    return null if i < 0
    return t13Int(in members[i].value)
}

/// `GetInt32`: a number written as an integer within `int`; null otherwise.
i64? t13Int(in json.JsonValue v) uses alloc {
    switch v {
        case .number(let _, let text):
            let negative = text.startsWith("-")
            let digits = t9Digits(negative ? text[1..text.length] : text, until: negative ? 2147483648 : 2147483647)
                ?? return null
            return negative ? -digits : digits
        default:
            return null
    }
}

/// ExternalSite.cs:12 `Str`: the member's string; null when it is missing, null or not a string.
string? t13Str(in List<json.JsonMember> members, for string key) uses alloc {
    let i = t13Find(in members, for: key)
    return null if i < 0
    switch members[i].value {
        case .text(let s):
            return s
        default:
            return null
    }
}

/// ExternalModeTests.cs:203 `TheSiteMapReaderRoundTripsSitesJson`'s source.
const t13RoundTripSource: string = "i64 inc(i64 n) {\n    var y = n\n    @unobservable because \"no test can see it\"\n    y += 0\n    return n + 1\n}\n\ntest \"inc\" {\n    assert inc(1) == 2\n}\n"

// ExternalModeTests.TheSiteMapReaderRoundTripsSitesJson.
test "site-map: the reader reads back each site of a schemata build's sites JSON, its unobservable mark kept, and refuses version 2" {
    var files = List<lexer.SourceText>()
    var bytes = List<u8>()
    for b in t13RoundTripSource.bytes {
        bytes.append(b)
    }
    files.append(lexer.SourceText.create("lib.test.byn", from: move bytes))
    let options = GoldenOptions { includeTests: true, library: true }
    var c = semantics.create(from: move files, at: ".", by: options)
    assert(!t5HasErrors(c))
    let none = List<string>()
    let schema = emitter.buildSchema(ref c, for: none)
    let read = externalSiteReadAll(emitter.sitesJson(schema))
    assert(read is not null)
    if (read is { } sites) {
        assert(sites.length > 0)
        assert(sites.length == schema.sites.length)
        var marked = false
        for i in 0..sites.length {
            assert(sites[i] == externalSiteFrom(schema.sites[i]))
            marked = marked || sites[i].unobservable == "no test can see it"
        }
        assert(marked)
    }
    assert(externalSiteReadAll("{ \"version\": 2, \"sites\": [] }") is null)
}

/// MutationRunnerTests.cs:14 `Fixture`.
const t13RunnerFixture: string = "i64 big(i64 n) {\n    if n > 5 { return 1 }\n    return 0\n}\n\ni64 inc(i64 n) {\n    return n + 1\n}\n\ni64 count() {\n    var i = 0\n    while i < 3 {\n        i += 1\n    }\n    return i\n}\n\ni64 hidden(i64 n) {\n    var y = n\n    @unobservable because \"no test can see it\"\n    y += 0\n    return y\n}\n\ni64 unused(i64 n) {\n    return n * 2\n}\n\ntest \"big\" {\n    assert big(9) == 1\n    assert big(2) == 0\n}\n\ntest \"inc\" {\n    assert inc(1) == 2\n}\n\ntest \"inc again\" {\n    assert inc(2) == 3\n}\n\ntest \"count\" {\n    assert count() == 3\n}\n\ntest \"hidden\" {\n    assert hidden(4) == 4\n}\n\n"

/// A fresh `tmp/<name>` and `source` compiled there as `lib.test.byn`, a library with its tests.
semantics.Ctx t13RunnerCompile(string name, by string source, at ref string dir) uses alloc, clock, fs {
    dir = Path.combine(Path.fullPath("tmp"), name)
    deleteWorkDir(dir)
    // coverage-exempt: Q1286 a test helper's `catch { panic }`
    Io.createDirectory(dir) catch { panic($"cannot create {dir}") }
    var files = List<lexer.SourceText>()
    var bytes = List<u8>()
    for b in source.bytes {
        bytes.append(b)
    }
    files.append(lexer.SourceText.create(Path.combine(dir, "lib.test.byn"), from: move bytes))
    let options = GoldenOptions { includeTests: true, library: true }
    var c = semantics.create(from: move files, at: dir, by: options)
    assert(!t5HasErrors(c))
    return c
}

/// The one mutant of `result` at `op`, `original` and `mutated`.
MutantResult t13RunnerMutant(in MutationResult result, by string op, for string original, to string mutated) {
    for m in result.mutants {
        return m if m.site.op == op && m.site.original == original && m.site.mutated == mutated
    }
    // coverage-exempt: Q1286 `panic`
    panic($"no {op} mutant {original} -> {mutated}")
}

/// `Processes`: the wrapper's log lines for `mutant`.
i64 t13RunnerProcesses(in List<string> log, for i64 mutant) uses alloc {
    var n: i64 = 0
    for line in log {
        n += line.startsWith($"{mutant} ") ? 1 : 0
    }
    return n
}

/// True when `log` holds the line `line`.
bool t13RunnerHas(in List<string> log, for string line) {
    for l in log {
        return true if l == line
    }
    return false
}

// MutationRunnerTests.StatusesAreKilledSurvivedTimeoutNotReachedMarked, AMutantRunsOnlyTheTestsThatReachItAndStopsAtTheFirstFailure,
// ATimedOutMutantCountsAsKilledAndIsNamed and SitesJsonCarriesTheMark, on the C#'s one shared run: the fixture built once, every
// mutant run through a wrapper that logs `mutant test` per process. Sites are found by line, as `ExternalSite` has no function.
test "mutation-runner: statuses, reach, the first failure, timeouts and the mark" {
    if Target.os == "windows" {
        todo("the wrapper is a `sh` script")
    }
    var dir = ""
    var c = t13RunnerCompile("mutation-runner", by: t13RunnerFixture, at: ref dir)
    let none = List<string>()
    var schema = emitter.buildSchema(ref c, for: none)
    assert(emitter.sitesJson(schema).contains("\"unobservable\": \"no test can see it\""))
    var l = T11LCtx {}
    l.mutating = true
    l.mutants = schema.switches.take()
    let program = emitter.lower(ref c, to: ref l)
    assert(program.tests.length == 5)
    let source = cprint.emit(ref c, from: l.tree, through: program, by: false)
    var d = newDCtx()
    let native = t9Build(source, by: "safe", to: null, for: null, through: ref d)
    print(native.result.errors) unless native.result.succeeded
    assert(native.result.succeeded)
    let log = Path.combine(dir, "log.txt")
    goldenWrite(
        dir,
        for: "wrapper.sh",
        as: $"#!/bin/sh\necho \"$BAYAN_MUTANT $2\" >> '{log}'\nexec '{native.exe}' \"$@\"\n",
    )
    boundSh("chmod 700 \"$1/wrapper.sh\"", at: dir)
    let result = mutationRun(Path.combine(dir, "wrapper.sh"), by: schema, for: [0, 1, 2, 3, 4], through: dir, as: 60000)
    let lines = t11ReadAllLines(Io.readText(log) catch "")
    // Statuses.
    let killed = t13RunnerMutant(result, by: "arithmetic", for: "n + 1", to: "n - 1")
    let survived = t13RunnerMutant(result, by: "boundary", for: "n > 5", to: "n >= 5")
    let spin = t13RunnerMutant(result, by: "statement", for: "i += 1", to: "")
    assert(killed.status == .killed && survived.status == .survived && spin.status == .timeout)
    var unused: i64 = 0
    var hidden: i64 = 0
    var hiddenRan = false
    for m in result.mutants {
        if m.site.line == 26 {
            unused += 1
            assert(m.status == .notReached)
        }
        if m.site.line == 21 {
            hidden += 1
            assert(m.status is .marked or .killed or .timeout)
            hiddenRan = hiddenRan || m.runs > 0
        }
    }
    assert(unused > 0 && hidden > 0 && hiddenRan)
    // `inc` is reached by tests 1 and 2: the kill by test 1 ends the mutant. `big` is reached by test 0 only.
    assert(killed.runs == 1 && t13RunnerProcesses(lines, for: killed.site.id) == 1)
    assert(t13RunnerHas(lines, for: $"{killed.site.id} 1"))
    assert(t13RunnerProcesses(lines, for: survived.site.id) == 1 && t13RunnerHas(lines, for: $"{survived.site.id} 0"))
    // Mutants not run start no process; the total is mutant 0 once per test plus every counted run.
    var runs: i64 = 0
    for m in result.mutants {
        if m.status is .notReached or .notEmitted {
            assert(t13RunnerProcesses(lines, for: m.site.id) == 0)
        }
        assert(m.runs == t13RunnerProcesses(lines, for: m.site.id))
        runs += m.runs
    }
    assert(t13RunnerProcesses(lines, for: 0) == 5)
    assert(lines.length == 5 + runs && result.processes == lines.length)
    // A timed-out mutant counts as killed and is named.
    assert(spin.killedBy == 3 && spin.runs == 1)
    deleteWorkDir(dir)
}

// MutationRunnerTests.TheWorkDirectoryIsTouchedSoAnotherProcessDoesNotSweepItMidRun.
test "mutation-runner: the work directory is touched so another process does not sweep it mid-run" {
    var dir = ""
    var c = t13RunnerCompile("mutation-runner-touch", by: "i64 inc(i64 n) {\n    return n + 1\n}\n", at: ref dir)
    let none = List<string>()
    let schema = emitter.buildSchema(ref c, for: none)
    assert(schema.sites.length > 0)
    Fs.setModified(
        dir,
        to: Time.fromNanos(Time.now().nanos - 3 * 60 * 60 * 1000000000),
    ) catch { panic($"cannot age {dir}") }
    let tests = List<i64>()
    let _ = mutationRun("none", by: schema, for: tests, through: dir, as: 1000)
    let modified = (Fs.modified(dir) catch Time.fromNanos(0)).nanos
    assert(modified > Time.now().nanos - 5 * 60 * 1000000000)
    deleteWorkDir(dir)
}

// MutationRunnerTests.AWorkDirectoryAnotherProcessSweptIsRecreatedAndARemovedReachFileReachesNothing.
test "mutation-runner: a work directory another process swept leaves a removed reach file reaching nothing" {
    if Target.os == "windows" {
        todo("the test is a `sh` script")
    }
    var root = ""
    var c = t13RunnerCompile("mutation-runner-swept", by: "i64 inc(i64 n) {\n    return n + 1\n}\n", at: ref root)
    let none = List<string>()
    let schema = emitter.buildSchema(ref c, for: none)
    assert(schema.sites.length > 0)
    goldenWrite(
        root,
        for: "test.sh",
        as: "#!/bin/sh\necho 0 > \"$BAYAN_SITE_REACH\"\nrm -rf \"$(dirname \"$BAYAN_SITE_REACH\")\"\n",
    )
    boundSh("chmod 700 \"$1/test.sh\"", at: root)
    let work = Path.combine(root, "work")
    let result = mutationRun(Path.combine(root, "test.sh"), by: schema, for: [0, 1], through: work, as: 10000)
    assert(result.excluded.length == 0)
    for m in result.mutants {
        if m.site.emitted {
            assert(m.status == .notReached)
        }
    }
    deleteWorkDir(root)
}
