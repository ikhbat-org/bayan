// CInventoryTests (spec 019 T27; K2, spec 011 R4): every compiler extension the emitted C relies on is a row of 011-c-inventory.md, and every
// row has a hit. The runtime is scanned as C; CEmitter.cs and cprint/*.byn only over their string literals, holes removed. The C# regexes
// run as std.regex patterns (leftmost-first, as .NET; `\w` and `\s` are ASCII there, which the scanned tokens are). Offsets are bytes where
// the C# ones were UTF-16 units: a line number counts the same `\n`s, and `ciWord` takes only ASCII letters and digits for
// `char.IsLetterOrDigit`.

import std.regex

const ciInventoryPath: string = "docs/specs/011-self-hosted-emitter/011-c-inventory.md"

/// `Extensions()`: the extension tokens.
const ciExtensions: string = "__builtin_\\w+|__attribute__\\s*\\(\\(([^()]|\\([^()]*\\))*\\)\\)|__declspec|\\balloca\\b|__typeof__|\\btypeof\\b|__auto_type|__thread\\b|__int128|__extension__|__restrict\\w*|#pragma \\w+|_Pragma|__asm__|\\basm\\b|__has_builtin|__PRETTY_FUNCTION__|__COUNTER__|\\(\\{"

/// `Row()`: a table row, groups file, anchor, token and why (named in C#; std.regex numbers them).
const ciRow: string = "^\\| ([^ |`]+) `([^`]+)` \\| `([^`]+)` \\| (.+) \\|$"

regex.Regex ciRegex(string pattern) uses alloc {
    return regex.Regex.parse(pattern) catch { panic($"bad pattern {pattern}") }
}

/// Whether byte `p` of `s` is the one byte of `c` (false past the end).
bool ciIs(string s, at i64 p, as string c) {
    return p >= 0 && p < s.length && s.bytes[p] == c.bytes[0]
}

/// `File.ReadAllText(Path.Combine(Golden.RepoRoot, repoPath))`, from the repository root the tests run in.
string ciRead(string repoPath) uses alloc, fs {
    return Io.readText(Path.fullPath(repoPath)) catch { panic($"cannot read {repoPath}") }
}

/// `text.ReplaceLineEndings("\n").Split('\n')`.
List<string> ciLines(string text) uses alloc {
    var lines = List<string>()
    for line in text.replaced("\r\n", by: "\n").replaced("\r", by: "\n").parts(by: "\n") {
        lines.append(line)
    }
    return lines
}

/// `Split(match)`: one token per match; an `__attribute__((a, b))` list gives `__attribute__((a))` and `__attribute__((b))`.
List<string> ciSplit(string match) uses alloc {
    var tokens = List<string>()
    if !match.startsWith("__attribute__") {
        tokens.append(match)
        return tokens
    }
    let open = match.position("((") ?? 0
    let list = match[open + 2..match.length - 2]
    var depth: i64 = 0
    var start: i64 = 0
    for i in 0..list.length + 1 {
        if ciIs(list, at: i, as: "(") {
            depth += 1
        } else if ciIs(list, at: i, as: ")") {
            depth -= 1
        } else if i == list.length || (ciIs(list, at: i, as: ",") && depth == 0) {
            tokens.append($"__attribute__(({list[start..i].trimmed()}))")
            start = i + 1
        }
    }
    return tokens
}

/// `char.IsLetterOrDigit(c) || c == '_'` on ASCII.
bool ciWord(string s, at i64 p) {
    return false if p < 0 || p >= s.length
    let b = s.bytes[p]
    return (b >= 0x30 && b <= 0x39) || (b >= 0x41 && b <= 0x5a) || (b >= 0x61 && b <= 0x7a) || b == 0x5f
}

/// `AnchorLines(text, fragment)`: the 1-based lines of `text` holding `fragment` (Q1040). An end of the fragment that is a letter, digit or
/// `_` must not touch another one, so `byn_env_get` does not match `byn_env_get_all`.
List<i64> ciAnchorLines(string text, for string fragment) uses alloc {
    var found = List<i64>()
    let lines = ciLines(text)
    for i in 0..lines.length {
        let l = lines[i]
        var at = l.position(fragment) ?? -1
        while at >= 0 {
            let end = at + fragment.length
            let before = ciWord(fragment, at: 0) && ciWord(l, at: at - 1)
            let after = ciWord(fragment, at: fragment.length - 1) && ciWord(l, at: end)
            if !before && !after {
                found.append(i + 1)
                break
            }
            at = l.position(fragment, from: at + 1) ?? -1
        }
    }
    return found
}

/// `Run(s, p, c)`: how many bytes `c` start at `p`.
i64 ciRun(string s, at i64 p, as string c) {
    var n: i64 = 0
    while ciIs(s, at: p + n, as: c) {
        n += 1
    }
    return n
}

/// `Hole`: skips an interpolation hole whose opening braces are already consumed; the index after its closing braces.
i64 ciHole(string s, at i64 start, for i64 braces) {
    var p = start
    var depth: i64 = 1
    while p < s.length && depth > 0 {
        if ciIs(s, at: p, as: "{") {
            depth += 1
        } else if ciIs(s, at: p, as: "}") {
            depth -= 1
        } else if ciIs(s, at: p, as: "\"") {
            p += 1
            while p < s.length && !ciIs(s, at: p, as: "\"") {
                p += ciIs(s, at: p, as: "\\") ? 2 : 1
            }
        }
        p += 1
    }
    return p + braces - 1 < s.length ? p + braces - 1 : s.length
}

/// `Quoted`: a plain or verbatim literal body from after the opening quote; the index after the closing quote.
i64 ciQuoted(string s, to ref List<u8> o, at i64 start, by bool interpolated, as bool verbatim) {
    var p = start
    while p < s.length {
        let c = s.bytes[p]
        if ciIs(s, at: p, as: "\"") {
            if verbatim && ciIs(s, at: p + 1, as: "\"") {
                o[p] = c
                o[p + 1] = c
                p += 2
                continue
            }
            return p + 1
        }
        if ciIs(s, at: p, as: "\\") && !verbatim {
            o[p] = c
            if p + 1 < s.length {
                o[p + 1] = s.bytes[p + 1]
            }
            p += 2
        } else if interpolated && ciIs(s, at: p, as: "{") && ciIs(s, at: p + 1, as: "{") {
            o[p] = c
            p += 2
        } else if interpolated && ciIs(s, at: p, as: "}") && ciIs(s, at: p + 1, as: "}") {
            o[p + 1] = c
            p += 2
        } else if interpolated && ciIs(s, at: p, as: "{") {
            p = ciHole(s, at: p + 1, for: 1)
        } else {
            if !ciIs(s, at: p, as: "\n") {
                o[p] = c
            }
            p += 1
        }
    }
    return p
}

/// `Raw`: a raw literal body; a hole opens at `dollars` braces. The index after the closing quotes.
i64 ciRaw(string s, to ref List<u8> o, at i64 start, for i64 quotes, by i64 dollars) {
    var p = start
    while p < s.length {
        return p + quotes if ciRun(s, at: p, as: "\"") >= quotes
        if dollars > 0 && ciRun(s, at: p, as: "{") >= dollars {
            let extra = ciRun(s, at: p, as: "{") - dollars
            for k in 0..extra {
                o[p + k] = s.bytes[p]
            }
            p = ciHole(s, at: p + extra + dollars, for: dollars)
        } else {
            if !ciIs(s, at: p, as: "\n") {
                o[p] = s.bytes[p]
            }
            p += 1
        }
    }
    return p
}

/// `Literals(source)`: `s` with everything but string-literal content blanked, same length and line breaks. Interpolation holes are blanked,
/// `{{` and `}}` in a `$"…"` read as one brace; comments and char literals are skipped. Handles plain, verbatim (`@"`), interpolated (`$`,
/// `$$`) and raw (`"""`) literals.
string ciLiterals(string s) uses alloc {
    var o = List<u8>()
    for b in s.bytes {
        o.append(b == 0x0a ? b : 0x20)
    }
    var p: i64 = 0
    while p < s.length {
        if ciIs(s, at: p, as: "/") && ciIs(s, at: p + 1, as: "/") {
            while p < s.length && !ciIs(s, at: p, as: "\n") {
                p += 1
            }
        } else if ciIs(s, at: p, as: "/") && ciIs(s, at: p + 1, as: "*") {
            let end = s.position("*/", from: p + 2) ?? -1
            p = end < 0 ? s.length : end + 2
        } else if ciIs(s, at: p, as: "'") {
            p += 1
            while p < s.length && !ciIs(s, at: p, as: "'") && !ciIs(s, at: p, as: "\n") {
                p += ciIs(s, at: p, as: "\\") ? 2 : 1
            }
            p += 1
        } else if ciIs(s, at: p, as: "$") || ciIs(s, at: p, as: "@") || ciIs(s, at: p, as: "\"") {
            var dollars: i64 = 0
            var verbatim = false
            while ciIs(s, at: p, as: "$") || ciIs(s, at: p, as: "@") {
                if ciIs(s, at: p, as: "$") {
                    dollars += 1
                } else {
                    verbatim = true
                }
                p += 1
            }
            continue if !ciIs(s, at: p, as: "\"")
            let quotes = ciRun(s, at: p, as: "\"")
            p += quotes
            // the empty string
            continue if quotes == 2
            if quotes >= 3 {
                p = ciRaw(s, to: ref o, at: p, for: quotes, by: dollars)
            } else {
                p = ciQuoted(s, to: ref o, at: p, by: dollars > 0, as: verbatim)
            }
        } else {
            p += 1
        }
    }
    return Utf8.decode(o, invalid: .replace)
}

/// `Hits()`: each extension token of the scanned files as `file:line token`.
List<string> ciHits() uses alloc, fs {
    var files = List<string>()
    var texts = List<string>()
    for f in ["runtime/bayan-rt.h", "runtime/bayan-rt.c"] {
        files.append(f)
        texts.append(ciRead(f))
    }
    for f in ["csharp/Bayan.Backend.C/CEmitter.cs"] {
        files.append(f)
        texts.append(ciLiterals(ciRead(f)))
    }
    var cprint = List<string>()
    for name in Io.listDir(Path.fullPath("src/emitter/cprint")) catch List<string>() {
        cprint.append(name) if name.endsWith(".byn")
    }
    cprint.sort()
    for name in cprint {
        let f = $"src/emitter/cprint/{name}"
        files.append(f)
        texts.append(ciLiterals(ciRead(f)))
    }
    let extensions = ciRegex(ciExtensions)
    var hits = List<string>()
    for i in 0..files.length {
        let text = texts[i]
        for m in extensions.findAll(text) {
            var line: i64 = 1
            for k in 0..m.span.start {
                line += ciIs(text, at: k, as: "\n") ? 1 : 0
            }
            for token in ciSplit(m.group(0) ?? "") {
                hits.append($"{files[i]}:{line} {token}")
            }
        }
    }
    return hits
}

/// `Rows(bad)`: each row as `file:line token`, its anchor resolved to a line; an anchor matching no line or several goes to `bad`.
List<string> ciRows(to ref List<string> bad) uses alloc, console, fs {
    let row = ciRegex(ciRow)
    var rows = List<string>()
    for line in ciLines(ciRead(ciInventoryPath)) {
        continue if !line.startsWith("| ") || line.startsWith("| Site ")
        let found = row.find(line)
        print($"inventory table line is not a row: {line}") if found is null
        assert(found is not null)
        var file = ""
        var anchor = ""
        var token = ""
        if (found is { } m) {
            file = m.group(1) ?? ""
            anchor = m.group(2) ?? ""
            token = m.group(3) ?? ""
        }
        let at = ciAnchorLines(ciRead(file), for: anchor)
        if at.length != 1 {
            var where = "no line"
            if at.length > 0 {
                where = "lines"
                for k in 0..at.length {
                    where = $"{where}{k == 0 ? " " : ", "}{at[k]}"
                }
            }
            bad.append($"anchor {file} `{anchor}` matches {where}; it must match exactly one")
            continue
        }
        rows.append($"{file}:{at[0]} {token}")
    }
    return rows
}

/// `xs` one per line.
string ciJoined(List<string> xs) uses alloc {
    var text = ""
    for x in xs {
        text = $"{text}{x}\n"
    }
    return text
}

/// The items of `xs` not in `ys`.
List<string> ciExcept(List<string> xs, from List<string> ys) uses alloc {
    var seen = Map<string, bool>()
    for y in ys {
        seen[y] = true
    }
    var left = List<string>()
    for x in xs {
        left.append(x) if !seen.contains(x)
    }
    return left
}

test "c inventory: every hit is a row and every row has a hit" {
    var hits = ciHits()
    hits.sort()
    var bad = List<string>()
    var rows = ciRows(to: ref bad)
    rows.sort()
    print(ciJoined(bad)) if bad.length > 0
    assert(bad.length == 0)
    let noRow = ciExcept(hits, from: rows)
    let noHit = ciExcept(rows, from: hits)
    print($"hits without a row:\n{ciJoined(noRow)}rows without a hit:\n{ciJoined(noHit)}") if noRow.length > 0
        || noHit.length > 0
    assert(noRow.length == 0 && noHit.length == 0)
    assert(ciJoined(hits) == ciJoined(rows))
}

/// The scan sees what the emitter really writes: the extensions in the C of a small program are all rows. The C# test emitted through
/// `CliApp.EmitC` in debug mode; here `$BAYAN_EXE build --emit-c --mode debug`.
test "c inventory: emitted C of a program uses only row tokens" {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    print(failure) if exe == ""
    assert(exe != "")
    let dir = Path.combine(Path.fullPath("tmp"), "c-inventory")
    deleteWorkDir(dir)
    goldenWrite(dir, for: "main.byn", as: "print(\"hi\")\n")
    var args = List<string>()
    for a in ["build", "--emit-c", "--mode", "debug", Path.combine(dir, "main.byn")] {
        args.append(a)
    }
    let r = Io.run(exe, args.span) catch { panic($"cannot run {exe}") }
    deleteWorkDir(dir)
    print(r.stderr) if r.exitCode != 0
    assert(r.exitCode == 0)
    var bad = List<string>()
    var tokens = Map<string, bool>()
    for row in ciRows(to: ref bad) {
        tokens[row[(row.position(" ") ?? 0) + 1..row.length]] = true
    }
    var unlisted = ""
    for m in ciRegex(ciExtensions).findAll(r.stdout) {
        for t in ciSplit(m.group(0) ?? "") {
            unlisted = $"{unlisted}{unlisted.isEmpty ? "" : ", "}{t}" if !tokens.contains(t)
        }
    }
    print($"emitted extension tokens without a row: {unlisted}") if !unlisted.isEmpty
    assert(unlisted.isEmpty)
}

/// `xs` joined by `,`, to compare a list with a literal.
string ciInts(List<i64> xs) uses alloc {
    var text = ""
    for x in xs {
        text = $"{text}{text.isEmpty ? "" : ","}{x}"
    }
    return text
}

test "c inventory: anchor matches whole words only" {
    assert(
        ciInts(ciAnchorLines("byn_env_get_all(x);\nbyn_env_get(x);\nmy_byn_env_get(x);\n", for: "byn_env_get")) == "2"
    )
    assert(ciInts(ciAnchorLines("a(\"x\")\nb(\"x\")\n", for: "(\"x\")")) == "1,2")
    assert(ciAnchorLines("a\nb\n", for: "c").length == 0)
}

test "c inventory: plain literal keeps its text" {
    assert(ciLiterals("f(\"__builtin_x\"); // \"__builtin_y\"").contains("__builtin_x"))
    assert(!ciLiterals("f(\"__builtin_x\"); // \"__builtin_y\"").contains("__builtin_y"))
}

test "c inventory: code outside literals is blanked" {
    assert(!ciLiterals("var t = typeof(int); /* \"asm\" */ var c = '\"'; // asm").contains("typeof"))
    assert(!ciLiterals("var t = typeof(int); /* \"asm\" */ var c = '\"'; // asm").contains("asm"))
}

test "c inventory: verbatim literal ends at a single quote" {
    let r = ciLiterals("@\"a \"\"b\"\" __asm__\" asm")
    assert(r.contains("__asm__"))
    assert(!r.trimmed().contains("asm\""))
    assert(r.endsWith(" "))
}

test "c inventory: interpolation holes are removed" {
    let r = ciLiterals("$\"({f(\"typeof\", x)}) __asm__\"")
    assert(!r.contains("typeof"))
    assert(r.contains("__asm__"))
    assert(!r.contains("({"))
}

test "c inventory: doubled braces are one brace" {
    let r = ciLiterals("$\"({T}){{a}} ({{ b\"")
    assert(ciRegex(ciExtensions).findAll(r).length == 1)
}

/// `Collapsed(s)`: runs of white space as one space, trimmed.
string ciCollapsed(string s) uses alloc {
    return ciRegex("\\s+").replaced(s, by: " ").trimmed()
}

test "c inventory: statement expression in an interpolated literal is found" {
    let r = ciLiterals("$\"({{ int t = {x}; t; }})\"")
    assert(ciCollapsed(r) == "({ int t = ; t; })")
    assert(ciRegex(ciExtensions).findAll(r).length == 1)
}

test "c inventory: only real holes are removed" {
    assert(ciCollapsed(ciLiterals("$\"a {x:X2} b {f(new { A = 1 }, \"}\")} c\"")) == "a b c")
    assert(ciCollapsed(ciLiterals("$\"{{ a }}\"")) == "{ a }")
}

test "c inventory: plain literal with an escaped quote stays one literal" {
    let r = ciLiterals("f(\"a \\\" __asm__ \"); asm")
    assert(r.contains("__asm__"))
    assert(!r.contains("); asm"))
    assert(ciRegex(ciExtensions).findAll(r).length == 1)
}

test "c inventory: raw literal with dollars uses double brace holes" {
    let r = ciLiterals("$$\"\"\"\n  a({ {{x.ToString(\"asm\")}} typeof\n  \"\"\" asm")
    assert(r.contains("a({ "))
    assert(r.contains("typeof"))
    assert(!r.contains("asm"))
    assert(r.count("\n") == 2)
}

test "c inventory: line breaks are preserved" {
    let src = "a\n\"b\"\n$\"c{x}\n\""
    assert(src.count("\n") == ciLiterals(src).count("\n"))
    assert(src.length == ciLiterals(src).length)
}

test "c inventory: attribute list splits on commas" {
    assert(ciJoined(ciSplit("__attribute__((noreturn, cold))")) == "__attribute__((noreturn))\n__attribute__((cold))\n")
    assert(ciJoined(
        ciSplit("__attribute__ ((aligned(8), packed))"),
    ) == "__attribute__((aligned(8)))\n__attribute__((packed))\n")
    assert(ciJoined(ciSplit("__builtin_expect")) == "__builtin_expect\n")
}
