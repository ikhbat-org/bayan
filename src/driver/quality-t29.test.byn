// 019 T29 (coverage ratchet): quality.byn paths no golden case reaches in process: the coverage report of a counter map with
// some counters hit, finished and timed out, its JSON, listing and summary, `gatesFmt` and `qualityJsonNumber` on each digit
// shape, and the mark warnings for a mark outside the sources and one past a multi-byte character. The expected values are
// the output of the self-hosted driver at the commit that added the test.

import emitter
import lexer
import semantics

/// A program with a line, a branch and an error path on each of its first lines.
const t29QualityText: string = "union error E {\n    bad\n}\n\ni64 check(i64 n) fails E {\n    fail .bad if n < 0\n    return n\n}\n\nlet r = check(1) catch switch {\n    E.bad => 0\n}\nprint(r > 0 ? \"pos\" : \"neg\")\n"

/// The counter map of `t29QualityText` and the hits of every other counter.
emitter.CoverageMap t29QualityMap(ref Map<i64, u64> hits) uses alloc, clock, fs {
    let dir = Path.combine(Path.fullPath("tmp"), "quality-t29")
    goldenWrite(dir, for: "main.byn", as: t29QualityText)
    var c = semantics.fromPath(Path.combine(dir, "main.byn"), by: T5CompilationOptions {}, wholeDirectory: false)
    var l = T11LCtx {}
    let map = t5Instrument(ref c, to: ref l)
    for k in 0..map.counters.length {
        if k % 2 == 0 {
            hits[map.counters[k].id] = 1
        }
    }
    return map
}

test "driver t29: qualityCoverage, its JSON, listing and summary with some counters hit" {
    var hits: Map<i64, u64> = []
    let map = t29QualityMap(ref hits)
    let f = Path.combine(Path.combine(Path.fullPath("tmp"), "quality-t29"), "main.byn")
    let report = qualityCoverage("t29", by: in map, from: in hits, for: false, through: 1500000000, as: 2500000000)
    let json = """
        {
          "version": 1,
          "kind": "coverage",
          "tool": "t29",
          "timing": {
            "build_s": 1.5,
            "total_s": 2.5
          },
          "files": [
            {
              "path": "<f>",
              "lines": {
                "covered": 3,
                "total": 4,
                "missed": [
                  10
                ],
                "unknown": []
              },
              "branches": {
                "covered": 2,
                "total": 4,
                "missed": [
                  {
                    "line": 6,
                    "column": 18,
                    "outcome": true
                  },
                  {
                    "line": 13,
                    "column": 7,
                    "outcome": true
                  }
                ],
                "unknown": []
              },
              "errorPaths": [
                {
                  "function": "check",
                  "variant": "E.bad",
                  "hit": false,
                  "origins": []
                }
              ]
            }
          ],
          "totals": {
            "lines": {
              "covered": 3,
              "total": 4
            },
            "branches": {
              "covered": 2,
              "total": 4
            },
            "errorPaths": {
              "covered": 0,
              "total": 1
            }
          }
        }

        """
    t29Same(qualityJson(in report).replaced(f, by: "<f>"), as: json)
    t29Same(qualityCoverageSummary(in report).replaced(f, by: "<f>"), as: "coverage: lines 3/4 (75%), branches 2/4 (50%), error paths 0/1 (0%)\n  <f>: lines 3/4, branches 2/4, error paths 0/1\nuncovered branch: <f>:6:18 never true\nuncovered branch: <f>:13:7 never true\nuncovered error path: <f>: check E.bad\n")
    let listing = "  union error E {\n      bad\n  }\n  \n  i64 check(i64 n) fails E {\n+     fail .bad if n < 0\n+     return n\n  }\n  \n- let r = check(1) catch switch {\n      E.bad => 0\n  }\n+ print(r > 0 ? \"pos\" : \"neg\")\n"
    t29Same(qualityListing(in report.files[0], from: t11ReadAllLines(t29QualityText)), as: listing)
    let timedOut = qualityCoverage("t29", by: in map, from: in hits, for: true, through: 0, as: 0)
    let timedOutJson = """
        {
          "version": 1,
          "kind": "coverage",
          "tool": "t29",
          "timing": {
            "build_s": 0,
            "total_s": 0
          },
          "files": [
            {
              "path": "<f>",
              "lines": {
                "covered": 3,
                "total": 4,
                "missed": [],
                "unknown": [
                  10
                ]
              },
              "branches": {
                "covered": 2,
                "total": 4,
                "missed": [],
                "unknown": [
                  {
                    "line": 6,
                    "column": 18,
                    "outcome": true
                  },
                  {
                    "line": 13,
                    "column": 7,
                    "outcome": true
                  }
                ]
              },
              "errorPaths": [
                {
                  "function": "check",
                  "variant": "E.bad",
                  "hit": false,
                  "unknown": true,
                  "origins": []
                }
              ]
            }
          ],
          "totals": {
            "lines": {
              "covered": 3,
              "total": 4
            },
            "branches": {
              "covered": 2,
              "total": 4
            },
            "errorPaths": {
              "covered": 0,
              "total": 1
            }
          }
        }

        """
    t29Same(qualityJson(in timedOut).replaced(f, by: "<f>"), as: timedOutJson)
    t29Same(qualityCoverageSummary(in timedOut).replaced(f, by: "<f>"), as: "coverage: lines 3/4 (75%), branches 2/4 (50%), error paths 0/1 (0%)\n  <f>: lines 3/4, branches 2/4, error paths 0/1\nunknown branch: <f>:6:18 never true\nunknown branch: <f>:13:7 never true\nunknown error path: <f>: check E.bad\n")
    t29Same(qualityListing(in timedOut.files[0], from: t11ReadAllLines(t29QualityText)), as: "  union error E {\n      bad\n  }\n  \n  i64 check(i64 n) fails E {\n+     fail .bad if n < 0\n+     return n\n  }\n  \n~ let r = check(1) catch switch {\n      E.bad => 0\n  }\n+ print(r > 0 ? \"pos\" : \"neg\")\n")
    let none: Map<i64, u64> = []
    let noneReport = qualityCoverage("t29", by: in map, from: in none, for: false, through: 0, as: 0)
    t29Same(qualityCoverageSummary(in noneReport).replaced(f, by: "<f>"), as: "coverage: lines 0/4 (0%), branches 0/4 (0%), error paths 0/1 (0%)\n  <f>: lines 0/4, branches 0/4, error paths 0/1\nuncovered branch: <f>:6:18 never true\nuncovered branch: <f>:6:18 never false\nuncovered branch: <f>:13:7 never true\nuncovered branch: <f>:13:7 never false\nuncovered error path: <f>: check E.bad\n")
    deleteWorkDir(Path.combine(Path.fullPath("tmp"), "quality-t29"))
}

test "driver t29: gatesFmt and t11Has on each digit shape" {
    t29Same(gatesFmt(1, by: 3), as: "33.333")
    t29Same(gatesFmt(1, by: 200), as: "0.5")
    t29Same(gatesFmt(1, by: 2000), as: "0.05")
    t29Same(gatesFmt(1, by: 20000), as: "0.005")
    t29Same(gatesFmt(1, by: 1), as: "100")
    var xs = List<i64>()
    xs.append(1)
    xs.append(2)
    assert t11Has(in xs, for: 2) && !t11Has(in xs, for: 3)
}

test "driver t29: qualityJsonNumber in exponent form and with trailing zeros" {
    t29Same(qualityJsonNumber(0.0000001), as: "1E-07")
    t29Same(qualityJsonNumber(1.5e17), as: "1.5E+17")
    t29Same(qualityJsonNumber(1e20), as: "1E+20")
    t29Same(qualityJsonNumber(100000.0), as: "100000")
    t29Same(qualityJsonNumber(0.0), as: "0")
    t29Same(qualityJsonNumber(0.25), as: "0.25")
}

test "driver t29: qualityWarnings for a mark outside the sources and one past a multi-byte character" {
    var c = qrBuild(goldenQualityFixture)
    let none = List<string>()
    let schema = emitter.buildSchema(ref c, for: in none)
    let empty = List<lexer.SourceText>()
    t29Same(
        qualityWarnings(in qrResults(in schema, by: false), by: in schema, for: in c, from: in empty).joined(by: "\n"),
        as: "warning: lib.test.byn:0:0: the mark covers no mutant (`no test can see it`)\nwarning: lib.test.byn:0:0: the mark covers no mutant (`nothing to mutate`)",
    )
    let text = "i64 f(i64 n) {\n    @unobservable(literal) because \"é\"\n    let k = \"é\".length > n ? 1 : 2\n    return k\n}\n"
    var marked = qrBuild(text)
    let markedSchema = emitter.buildSchema(ref marked, for: in none)
    t29Same(
        qualityWarnings(in qrResults(in markedSchema, by: false), by: in markedSchema, for: in marked, from: in qrSources(text))
            .joined(by: "\n"),
        as: "",
    )
}
