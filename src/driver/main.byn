// bayan: the self-hosted compiler driver (spec 012). `Run` of CliApp.cs:37 with the global options of
// `TakeGlobalOptions` (CliApp.cs:328); commands the driver does not port are refused (R3).
//
//     bayan [--ascii] [--color auto|always|never] <command> [args]

import semantics

const exitOk: i32          = 0
const exitFailure: i32     = 1
const exitUsage: i32       = 2
const exitTestFailure: i32 = 3
const exitToolchain: i32   = 4

/// Toolchain.CompilerVersion (Toolchain.cs:33).
const version: string = "0.4.1"

/// `bayan --help`, `-h` and `help` (owner decision 2026-11-16): one line per command; `commandHelp` has each command's options.
/// `mutate` and `cache` are left out to stay within 28 lines: `bayan help test` and `bayan help clean` name them, and
/// `bayan help mutate` and `bayan help cache` describe them.
const usageText: string = """
Usage: bayan <command> [options]

  new              Create a project in a new directory
  init             Add a project's missing files to a directory

  build            Compile a program to an executable
  run              Compile and run a program
  test             Compile and run a program's tests
  check            Report a program's diagnostics
  <script>.byn     Run a script, so `#!/usr/bin/env bayan` works

  format           Rewrite `.byn` files into their canonical form
  fix              Apply every style lint's fix
  audit            List every `because` bypass and `unsafe` or `extern`
  explain          Explain a diagnostic, e.g. `bayan explain BYN0003`
  doctor           Check the C compiler, zig, git and the build cache
  clean            Remove out/, and dist/ or the build cache
  dist             Build release binaries into dist/<version>/

  lex              Print a file's token stream
  parse            Check a file's syntax or print its syntax tree
  types            Print each function's parameter and local types
  features         Print the syntax, builtins and diagnostics a build used

General options:
  -h, --help       Print this help, or after a command that command's help
  -v, --version    Print the version line, `bayan <version> (selfhost)`
Run 'bayan help <command>' for a command's options.
"""

/// What `check`, `types`, `build`, `run`, `test` and `features` take as `<path>`.
const pathHelp: string = """
<path> is a project directory (one with `package.byn`; the default inside a
project), a script (a file starting with `#!`), or a file or directory of
`.byn` files.
"""

/// The options of `check`, `types`, `build`, `run` and `test`, and their exit codes.
const compileHelp: string = """
  --all                show every error instead of the first 20 (JSON is never
                       capped)
  --diagnostics json   print each diagnostic to stderr as one JSON object per
                       line (code, severity, file, span, message, label, help,
                       fixes)

Exit codes:
  0  success
  1  compile errors
  2  usage errors (unknown command or option, missing path)
  3  test failures, or a coverage or mutation score below its minimum
  4  toolchain problems (no C compiler, unwritable cache, C compiler failure)
"""

/// The options of `new` and `init`.
const newHelp: string = """
Options:
  --lib                create a library instead of an app
  --script             create a script instead of an app
  --vcs git|none       start a git repository, or not
  --ci github|none     add a GitHub workflow, or not
"""

/// The options every command takes.
const generalHelp: string = """
General options:
  --color auto|always|never
                       color for terminals (auto: on unless piped or NO_COLOR
                       is set; FORCE_COLOR turns it on, TERM=dumb off)
  --ascii              use ASCII symbols instead of ◆ ✗ │ (also with
                       TERM=dumb or a non-UTF-8 locale)
  -h, --help           print this help
"""

/// `bayan help <command>` and `bayan <command> --help`: `command`'s usage and options; null for a command that has none.
string? commandHelp(string command) uses alloc {
    var body = ""
    var compile = false
    var path = false
    switch command {
        case "new" or "init":
            let usage = command == "new" ? "new <name>" : "init [<dir>]"
            let what = command == "new" ? "Create an app in a new directory <name>." : "Add a project's missing files to <dir> (default: the current directory)."
            body = $"Usage: bayan {usage} [options]\n\n{what}\n\n{newHelp}"
        case "build":
            compile = true
            path = true
            body = """
Usage: bayan build [<path>] [options]

Compile a program to an executable.

Options:
  -o <file>            write the executable to <file>
  --mode debug|safe|fast
                       the build mode
  --target <t>         build for target <t>
  --emit-c             write the C instead of an executable
  -v                   print each phase's time and the output path
"""
        case "run":
            compile = true
            path = true
            body = """
Usage: bayan run [<path>] [options] [-- <program args>]
       bayan <script>.byn [<program args>]

Compile and run a program, passing it <program args>. A script runs by its
name alone, so `#!/usr/bin/env bayan` works.

`bayan run` exits 1 when compilation fails and otherwise passes the program's
own exit code through unchanged, so it cannot tell a build failure from a
program that exits 1. When that matters, run `bayan build` first or read
`--diagnostics json`.

Options:
  --mode debug|safe|fast
                       the build mode
  -- <program args>    pass the rest to the program
"""
        case "test":
            compile = true
            path = true
            body = """
Usage: bayan test [<path>] [options]

Compile and run the tests, each in its own process.

Options:
  --mode debug|safe|fast
                       the build mode
  --json               print the results as JSON instead
  --changed            only modules with files changed since HEAD
  --base <ref>         with --changed: changed since <ref> instead of HEAD
  --only <text>        only tests whose name contains <text>; repeatable
  -v                   also list the passing and pending tests
  --mutate             run every mutant against the tests that reach it
  --run <cmd>          with --mutate: run <cmd> once per mutant instead, with
                       BAYAN_MUTANT set (exit 0 survived, non-zero killed),
                       as `bayan mutate` does for a prebuilt binary
"""
        case "check":
            compile = true
            path = true
            body = """
Usage: bayan check [<path>] [options]

Report diagnostics for a program (a file or directory).

Options:
"""
        case "types":
            compile = true
            path = true
            body = """
Usage: bayan types [<path>] [options]

Print each function's parameter and local types as JSON.

Options:
"""
        case "features":
            path = true
            body = """
Usage: bayan features --used <path>

Print the syntax node kinds, builtins and diagnostics a build touched, as JSON.

Options:
  --used <path>        the program whose build to report
"""
        case "mutate":
            body = """
Usage: bayan mutate --binary <exe> --sites <map.json> -- <cmd>

Run <cmd> once per mutant site of a prebuilt --mutate binary, as
`bayan test --mutate --run` does.

Options:
  --binary <exe>       the binary built with --mutate
  --sites <map.json>   its mutant site map
  -- <cmd>             the command to run once per mutant
"""
        case "lex":
            body = """
Usage: bayan lex [--json] <file>

Print the token stream of <file> (`-` reads stdin).

Options:
  --json               print it as one JSON object
"""
        case "parse":
            body = """
Usage: bayan parse [--ast] <file>

Check the syntax of <file>.

Options:
  --ast                print the syntax tree
"""
        case "format":
            body = """
Usage: bayan format [--check] <path>

Rewrite input forms (those with a fix-it) in a `.byn` file or a directory of
them, and booleans and primitives to `style` in `package.byn`.

Options:
  --check              list the files, don't write them
"""
        case "fix":
            body = """
Usage: bayan fix [<path>…]

Apply every style lint's fix (whatever its severity in `lints`) to `.byn`
files or directories of them (default: the current directory); does not
format.
"""
        case "audit":
            body = """
Usage: bayan audit <path>

List every `because` bypass and `unsafe` or `extern` declaration, with its
reason.
"""
        case "explain":
            body = """
Usage: bayan explain <code>

Explain a diagnostic, e.g. `bayan explain BYN0003`.
"""
        case "doctor":
            body = """
Usage: bayan doctor

Check the C compiler, zig, git and the build cache, with fixes.
"""
        case "clean":
            body = """
Usage: bayan clean [<dir>] [options]

Remove out/ (default: in the current directory). `bayan cache stats` shows
the build cache's location and size.

Options:
  --dist               also remove dist/
  --cache              also empty the global build cache
"""
        case "cache":
            body = """
Usage: bayan cache stats

Show the shared build cache's location and size (`bayan clean --cache`
empties it).
"""
        case "dist":
            body = """
Usage: bayan dist [<dir>] [options]

Build release binaries into dist/<version>/.

Options:
  --target <t>|all     build for target <t>, or for every target
  --mode debug|safe|fast
                       the build mode
  --force              rebuild an existing version
  --allow-dirty        build from a dirty git tree
"""
        default:
            return null
    }
    var text = StrBuf()
    text.append(body)
    if compile {
        text.append($"\n{compileHelp}")
    }
    if path {
        text.append($"\n\n{pathHelp}")
    }
    text.append($"\n\n{generalHelp}")
    return text.finish()
}

/// `bayan help <command>` and `bayan <command> --help`: the help of `command` on stdout, or a usage error naming it.
i32 helpCommand(string command) {
    if (commandHelp(command) is not { } text) {
        Io.stderr.write($"bayan: unknown command `{command}`; `bayan help` lists the commands\n")
        return exitUsage
    }
    Io.stdout.write($"{text}\n")
    return exitOk
}

/// True when an argument of `kept` after the command and before any `--` is `--help` or `-h`.
bool asksHelp(List<string> kept) {
    for i in 1..kept.length {
        return false if kept[i] == "--"
        return true if kept[i] is "--help" or "-h"
    }
    return false
}

/// CliApp.cs:33 `VersionLine` with the commit replaced by `selfhost` (spec Q3).
string versionLine() => $"bayan {version} (selfhost)"

/// CliApp.cs:37 `Run`.
i32 run(ReadOnlySpan<string> args, through ref DCtx d) {
    var kept = List<string>()
    unless takeGlobalOptions(args, to: ref kept, through: ref d) {
        return exitUsage
    }
    // no-builtin: Q1117 the `Terminal` of CliApp.cs:27 is what `Run(args, stdout, stderr)` gives: neither stream a tty, width 0.
    // `BAYAN_TERMINAL=<width>`, a positive integer, makes both streams a terminal of that width (019 T2a); any other value is ignored.
    let width = i64.tryParse(Env.get("BAYAN_TERMINAL") ?? "") ?? 0
    let tty = width > 0
    d.styleOut = decideStyle(d.color, by: d.ascii, through: tty, for: width)
    d.styleErr = decideStyle(d.color, by: d.ascii, through: tty, for: width)
    d.stderrTty = tty
    if kept.length == 0 {
        Io.stderr.write($"{usageText}\n")
        return exitUsage
    }
    let command = kept[0]
    if commandHelp(command) is not null && asksHelp(kept) {
        return helpCommand(command)
    }
    switch command {
        case "--version" or "-v" or "version":
            Io.stdout.write($"{versionLine()}\n")
            return exitOk
        case "doctor":
            // coverage-exempt: Q1219 the C# `doctor` prints its own version line (Q1112), so no row compares it
            return doctorCommand(by: in d)
        case "--help" or "-h" or "help":
            if kept.length > 1 && command == "help" {
                return helpCommand(kept[1])
            }
            Io.stdout.write($"{usageText}\n")
            return exitOk
        case "lex":
            return lexCommand(in kept)
        case "parse":
            return parseCommand(in kept)
        case "types":
            return typesCommand(in kept, by: in d)
        case "format":
            return formatCommand(in kept, by: in d)
        case "fix":
            return fixCommand(in kept, by: in d)
        case "audit":
            return auditCommand(in kept, by: in d)
        case "features":
            return featuresCommand(in kept, by: in d)
        case "explain":
            return explainCommand(kept)
        case "check":
            return checkCommand(in kept, by: in d)
        case "build":
            return buildCommand(in kept, by: ref d)
        case "run":
            return runProgram(in t2Rest(kept), by: ref d)
        case "test":
            return testCommand(in kept, by: ref d)
        case "mutate":
            return mutateBinary(in t2Rest(kept))
        case "new":
            let newArgs = t2Rest(kept)
            return scaffoldNew(newArgs.span)
        case "dist":
            return distCommand(in kept, by: ref d)
        case "cache":
            return cacheCommand(kept)
        case "clean":
            return cleanCommand(kept)
        case "init":
            let initArgs = t2Rest(kept)
            return scaffoldInit(initArgs.span)
        default:
            // `#!/usr/bin/env bayan` runs `bayan script.byn [args]` (CliApp.cs:97).
            if command.endsWith(".byn") && t1FileExists(command) {
                var script = List<string>()
                script.append(command)
                script.append("--")
                for a in t2Rest(kept) {
                    script.append(a)
                }
                return runProgram(in script, by: ref d)
            }
            Io.stderr.write($"bayan: unknown command `{command}`\n")
            if command == "fmt" {
                Io.stderr.write("the formatter is `bayan format`\n")
            }
            Io.stderr.write($"{usageText}\n")
            return exitUsage
    }
}

/// CliApp.cs:328 `TakeGlobalOptions`: `--color` and `--ascii` are removed from `args` into `kept` and `d`, before any `--`
/// and before a script run without a command; false after reporting a bad colour value.
bool takeGlobalOptions(ReadOnlySpan<string> args, to ref List<string> kept, through ref DCtx d) {
    var color = "auto"
    var command = false
    var i: i64 = 0
    while i < args.length {
        var value: string? = null
        // A script's arguments are its own (`bayan --ascii tool.byn --color never`).
        if args[i] == "--"
                || (!command && !args[i].startsWith("-") && args[i].endsWith(".byn") && t1FileExists(args[i])) {
            for k in i..args.length {
                kept.append(args[k])
            }
            break
        }
        if !args[i].startsWith("-") {
            command = true
        }
        if args[i] == "--ascii" {
            d.ascii = true
            i += 1
            continue
        }
        if args[i] == "--color" && i + 1 < args.length {
            i += 1
            value = args[i]
        } else if args[i].startsWith("--color=") {
            value = args[i]["--color=".length..args[i].length]
        } else if args[i] == "--color" {
            value = ""
        }
        if (value is not { } v) {
            kept.append(args[i])
            i += 1
            continue
        }
        if v != "auto" && v != "always" && v != "never" {
            Io.stderr.write($"bayan: unknown color setting `{v}` (expected auto, always or never)\n")
            return false
        }
        color = v
        i += 1
    }
    d.color = color
    return true
}

/// TerminalStyle.cs:13 `Decide`, palette included (:24-27, `t7Light`); the Windows code page arm of `Utf8` (:75-84) has no builtin (Q1117).
DStyle decideStyle(string colorFlag, by bool ascii, through bool isTty, for i64 width) uses alloc, env {
    let dumb = Env.get("TERM") == "dumb"
    var color = false
    switch colorFlag {
        case "always":
            color = true
        case "never":
            color = false
        default:
            if (Env.get("NO_COLOR") ?? "").length > 0 {
                color = false
            } else if (Env.get("FORCE_COLOR") ?? "").length > 0 && Env.get("FORCE_COLOR") != "0" {
                color = true
                // coverage-exempt: Q1286 through `color = false` `decideStyle` reads TERM itself: needs TERM=dumb
            } else if dumb {
                color = false
            } else {
                color = isTty
            }
    }
    var palette: i64 = 0
    if color {
        let term = Env.get("COLORTERM") ?? ""
        if term is "truecolor" or "24bit" {
            palette = t7Light() ? 1 : 2
        }
    }
    return DStyle {
        color: color,
        ascii: ascii || dumb || !t7Utf8(),
        width: isTty && width > 0 ? width : 100,
        palette: palette,
    }
}

/// TerminalStyle.cs:59 `Light`: `BAYAN_THEME`, else the background field of `COLORFGBG` (digits only, 7 or 9 to 15), else dark.
bool t7Light() uses alloc, env {
    let theme = Env.get("BAYAN_THEME") ?? ""
    return true if theme == "light"
    return false if theme == "dark"
    let fgbg = Env.get("COLORFGBG") ?? ""
    // digits after the last `;`; `int.TryParse` with `NumberStyles.None` rejects an empty, non-digit or out-of-range (above int.MaxValue) field
    var bg: i64 = 0
    var digits = 0
    var bad = false
    for c in fgbg.bytes {
        if c == 0x3b {
            bg = 0
            digits = 0
            bad = false
        } else if c is 0x30..=0x39 {
            bg = bg * 10 + i64(c) - 0x30
            digits += 1
            if bg > 2147483647 {
                bad = true
                bg = 0
            }
        } else {
            bad = true
        }
    }
    return false if bad || digits == 0
    return bg is 7 or 9..=15
}

/// `Palette.Prefix` (Style.cs:34) of the roles `error`, `warning`, `help`, `success`, `note` as 0 to 4, for `palette` (0 `Ansi16`, 1 `TruecolorLight`, 2 `TruecolorDark`); the hex rows are `Palette.Hex`.
string t7Prefix(by i64 palette, for i64 role) uses alloc {
    if palette == 0 {
        let rows = ["\u{1b}[31m", "\u{1b}[33m", "\u{1b}[34m", "\u{1b}[32m", "\u{1b}[2m"]
        return rows[role]
    }
    if palette == 1 {
        let rows = [
            "\u{1b}[38;2;180;35;24m",
            "\u{1b}[38;2;138;83;0m",
            "\u{1b}[38;2;31;58;95m",
            "\u{1b}[38;2;47;107;31m",
            "\u{1b}[38;2;95;94;90m",
        ]
        return rows[role]
    }
    let rows = [
        "\u{1b}[38;2;255;138;128m",
        "\u{1b}[38;2;242;193;78m",
        "\u{1b}[38;2;141;184;242m",
        "\u{1b}[38;2;143;214;148m",
        "\u{1b}[38;2;180;178;169m",
    ]
    return rows[role]
}

/// TerminalStyle.cs:66 `Utf8`: on Windows the console code page, which has no builtin and is read as UTF-8 (Q1117); elsewhere the first non-empty of `LC_ALL`, `LC_CTYPE`, `LANG` names UTF-8 (none set counts as UTF-8).
bool t7Utf8() uses alloc, env {
    // coverage-exempt: Q1117 through `let names` (the Windows arm)
    if Target.os == "windows" {
        // no-builtin: Q1117 TerminalStyle.cs:68-77 reads `Console.OutputEncoding.CodePage == 65001` on Windows, never the locale; read as UTF-8
        return true
    }
    let names = ["LC_ALL", "LC_CTYPE", "LANG"]
    for name in names {
        let locale = Env.get(name) ?? ""
        continue if locale.length == 0
        return locale.lowercased().contains("utf-8") || locale.lowercased().contains("utf8")
    }
    // coverage-exempt: Q1286 needs LC_ALL, LC_CTYPE and LANG all unset
    return true
}

/// The C# `File.Exists`: `path` reads and is not a directory.
bool t1FileExists(string path) {
    // Q31 (plan 013): the listing and the bytes are read only to test the path, so both are freed with the arena
    using let arena = Arena()
    provide allocator: arena {
        let _ = Io.listDir(path) catch {
            let _ = Io.readFile(path) catch return false
            return true
        }
    }
    return false
}

/// CliApp.cs:375 `IsScript`: a file whose first two bytes are `#!`. A copy of `semantics/cli.byn` `t26IsScript` (private there); T28 merges copies.
bool t1IsScript(string path) {
    unless t1FileExists(path) {
        return false
    }
    // coverage-exempt: Q918 the catch is reached only if the file changes between the reads at :219 and :229 (a race no test can stage); the C# has no such branch
    let bytes = Io.readFile(path) catch return false
    return bytes.length >= 2 && bytes[0] == 0x23 && bytes[1] == 0x21
}

/// CliApp.cs:384 `RefuseLibrary`: a library has nothing to build or run; `command` is the refused verb (`build`, `run`).
bool refuseLibrary(semantics.Ctx compiled, by string command) {
    unless compiled.library {
        return false
    }
    Io.stderr.write(
        $"bayan: `{compiled.packageName}` is a library, so there is no program to {command}; `bayan test` runs its tests\n",
    )
    return true
}

/// R3 (spec Q4): one stderr line naming `what`.
i32 refuse(string what) {
    Io.stderr.write($"error: `{what}` is not available in the self-hosted compiler; use the C# `bayan`\n")
    return exitUsage
}

i32 main(ReadOnlySpan<string> args) {
    var d = newDCtx()
    return run(args, through: ref d)
}
