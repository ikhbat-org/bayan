    assert(failed.contains("expected.exitcode\nexpected line 1: 1\nactual line 1: 0"))
}

// T17b2c: exported cases run through `goldenInChild` with their program's output kept whole, and their programs built by `goldenTest` before
// any case clock starts. Each block's fake driver lives under a fresh tmp/golden-prebuild-<n>, so its programs are cold.

/// A fake driver at `root`/bayan: `build` adds its `-o` path as a line of `root`/builds, sleeps `sleep` seconds and puts the shell program
/// `body` there; any other command is `$BAYAN_EXE`'s, with `BAYAN_EXE` naming the fake so a case child builds through it too. Its path.
string goldenPrebuildFake(string root, as string body, for string sleep) uses alloc, env, fs, process {
    var failure = ""
    let real = goldenExe(through: ref failure)
    goldenWrite(root, for: "prog", as: $"#!/bin/sh\n{body}\n")
    return goldenCliFake(
        root,
        for: "bayan",
        as: $"if [ \"$1\" = build ]; then\n  while [ $# -gt 0 ]; do [ \"$1\" = -o ] && out=$2; shift; done\n  echo \"$out\" >> '{root}/builds'\n  sleep {sleep}\n  cp '{root}/prog' \"$out\"\n  chmod +x \"$out\"\n  exit 0\nfi\nBAYAN_EXE='{root}/bayan' exec '{real}' \"$@\"",
    )
}

/// A `lex` case `name` of `root`/cases whose `expected.tokens` is `tokens`.
void goldenPrebuildCase(string root, for string name, as string tokens) uses alloc, fs {
    let dir = $"cases/lex/SelfhostLexerTests/{name}"
    goldenWrite(root, for: $"{dir}/input.byn", as: "a\n")
    goldenWrite(root, for: $"{dir}/expected.tokens", as: tokens)
}

/// The tmp/golden-programs entry of each build the fake of `root` ran (its `-o` path is `<entry>.<n>/prog`).
List<string> goldenPrebuildBuilds(string root) uses alloc, fs {
    var entries = List<string>()
    for path in goldenCliLines(Path.combine(root, "builds")) {
        continue if path == ""
        let stage = Path.directoryName(path) ?? ""
        let name = Path.fileName(stage)
        let dot = goldenOffset(name, for: ".")
        entries.append(Path.combine(Path.directoryName(stage) ?? "", dot < 0 ? name : name[0..dot]))
    }
    return entries
}

/// `root` and the tmp/golden-programs entries its fake built removed.
void goldenPrebuildClean(string root) uses alloc, fs {
    for entry in goldenPrebuildBuilds(root) {
        deleteWorkDir(entry)
    }
    deleteWorkDir(root)
}

/// A fresh tmp/golden-prebuild-<n> for the block `tag`.
string goldenPrebuildRoot(string tag) uses alloc, clock, fs {
    let root = Path.combine(Path.fullPath("tmp"), $"golden-prebuild-{tag}-{Io.monotonicNanos()}")
    deleteWorkDir(root)
    return root
}

test "an exported case whose program prints 1 MiB compares every byte: it passes, and fails naming the line when one byte past 64 KiB differs" {
    let root = goldenPrebuildRoot("big")
    var text = StrBuf()
    for i in 0..20000 {
        text.append($"{i + 1}:1 Identifier `x` 0123456789abcdef0123456789abcdef\n")
    }
    let big = text.finish()
    goldenWrite(root, for: "big", as: big)
    let exe = goldenPrebuildFake(root, as: $"cat '{Path.combine(root, "big")}'", for: "0")
    goldenPrebuildCase(root, for: "LexGolden-1", as: big)
    goldenPrebuildCase(root, for: "LexGolden-2", as: big.replaced("10000:1 Identifier", by: "10000:2 Identifier"))
    var results = List<GoldenResult>()
    let none = List<string>()
    let exit = goldenTest(
        Path.combine(root, "cases"),
        by: none,
        for: 30000,
        to: ref results,
        quiet: true,
        driverPath: exe,
    )
    let builds = goldenPrebuildBuilds(root).length
    goldenPrebuildClean(root)
    assert(big.length >= 1048576)
    assert(exit == exitTestFailure && results.length == 2 && builds == 1)
    assert(results[0].status == "passed")
    assert(results[1].status == "failed")
    assert(results[1].detail.contains(
        "expected.tokens\nexpected line 10000: 10000:2 Identifier `x` 0123456789abcdef0123456789abcdef\nactual line 10000: 10000:1 Identifier",
    ))
}

test "an exported case whose program never exits is timed out at the case limit, leaves no process, and the case after it still runs" {
    if Target.os == "windows" {
        todo("`ps` lists the processes left; Windows has none")
    }
    let root = goldenPrebuildRoot("hang")
    let tokens = "1:1 Identifier `a`\n"
    goldenWrite(root, for: "tokens", as: tokens)
    let exe = goldenPrebuildFake(
        root,
        as: $"case \"$PWD\" in *_LexGolden-1) while :; do sleep 1; done ;; esac\ncat '{Path.combine(root, "tokens")}'",
        for: "0",
    )
    goldenPrebuildCase(root, for: "LexGolden-1", as: tokens)
    goldenPrebuildCase(root, for: "LexGolden-2", as: tokens)
    var results = List<GoldenResult>()
    let none = List<string>()
    let exit = goldenTest(
        Path.combine(root, "cases"),
        by: none,
        for: 3000,
        to: ref results,
        quiet: true,
        driverPath: exe,
    )
    let entries = goldenPrebuildBuilds(root)
    var args = List<string>()
    for a in ["-A", "-ww", "-o", "args="] {
        args.append(a)
    }
    let ps = Io.run("ps", args.span, timeout: Millis(10000)) catch { panic("ps did not run") }
    goldenPrebuildClean(root)
    assert(exit == exitTestFailure && results.length == 2 && entries.length == 1)
    assert(results[0].status == "timed out" && results[0].detail.startsWith("timed out after 3 s"))
    assert(results[1].status == "passed")
    assert(!ps.stdout.contains(Path.combine(entries[0], "prog")))
}

test "goldenTest builds a program before the case clock starts: a build longer than the case limit leaves the case passing" {
    let root = goldenPrebuildRoot("slow")
    let tokens = "1:1 Identifier `a`\n"
    goldenWrite(root, for: "tokens", as: tokens)
    let exe = goldenPrebuildFake(root, as: $"cat '{Path.combine(root, "tokens")}'", for: "4")
    goldenPrebuildCase(root, for: "LexGolden-1", as: tokens)
    var results = List<GoldenResult>()
    let none = List<string>()
    let exit = goldenTest(
        Path.combine(root, "cases"),
        by: none,
        for: 2000,
        to: ref results,
        quiet: true,
        driverPath: exe,
    )
    let builds = goldenPrebuildBuilds(root).length
    goldenPrebuildClean(root)
    assert(builds == 1)
    assert(exit == exitOk && results.length == 1 && results[0].status == "passed")
}

test "with --jobs 4 and five cases needing one cold program, build is invoked once" {
    let root = goldenPrebuildRoot("jobs")
    let tokens = "1:1 Identifier `a`\n"
    goldenWrite(root, for: "tokens", as: tokens)
    let exe = goldenPrebuildFake(root, as: $"cat '{Path.combine(root, "tokens")}'", for: "1")
    for n in ["1", "2", "3", "4", "5"] {
        goldenPrebuildCase(root, for: $"LexGolden-{n}", as: tokens)
    }
    var results = List<GoldenResult>()
    let none = List<string>()
    let exit = goldenTest(
        Path.combine(root, "cases"),
        by: none,
        for: 30000,
        to: ref results,
        jobs: 4,
        quiet: true,
        driverPath: exe,
    )
    let builds = goldenPrebuildBuilds(root).length
    goldenPrebuildClean(root)
    assert(builds == 1)
    assert(exit == exitOk && results.length == 5)
    for r in results {
        assert(r.status == "passed")
    }
}

test "a build past the build limit is kept as a failed file naming the program, the limit and the directory, each case failing with it, never rebuilt" {
    let root = goldenPrebuildRoot("limit")
    let tokens = "1:1 Identifier `a`\n"
    goldenWrite(root, for: "tokens", as: tokens)
    let exe = goldenPrebuildFake(root, as: $"cat '{Path.combine(root, "tokens")}'", for: "30")
    goldenPrebuildCase(root, for: "LexGolden-1", as: tokens)
    goldenPrebuildCase(root, for: "LexGolden-2", as: tokens)
    let cases = Path.combine(root, "cases")
    let none = List<string>()
    var first = List<GoldenResult>()
    let _ = goldenTest(cases, by: none, for: 30000, to: ref first, quiet: true, driverPath: exe, buildMs: 1000)
    let once = goldenPrebuildBuilds(root)
    var next = List<GoldenResult>()
    let _ = goldenTest(cases, by: none, for: 30000, to: ref next, quiet: true, driverPath: exe, buildMs: 1000)
    let builds = goldenPrebuildBuilds(root).length
    let failed = once.length == 1 ? Io.readText(Path.combine(once[0], "failed")) catch "" : ""
    goldenPrebuildClean(root)
    assert(once.length == 1 && builds == 1)
    let text = once.length == 1 ? $"the lexer program did not build within 1 s: delete {once[0]} to build it again" : "-"
    assert(failed == text)
    assert(first.length == 2 && next.length == 2)
    for r in [first[0], first[1], next[0], next[1]] {
        assert(r.status == "failed" && r.detail.contains(text))
    }
    assert(goldenBuildLimitMs == 1200000)
}
