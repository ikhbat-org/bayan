}

test "an emit-c T7 case compares the section its name ends with, the thunk case on its local (SelfhostEmitterT7Tests.cs:352-360, :515-522)" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-programs-t7")
    deleteWorkDir(root)
    goldenWrite(
        root,
        for: "prog",
        as: "#!/bin/sh\necho '== x'\necho \"$1 $3\"\necho \"$4\"\necho '== thunk'\necho \"$1 $3\"\necho \"$4\"\n",
    )
    let exe = goldenCliFake(
        root,
        for: "bayan",
        as: $"while [ $# -gt 0 ]; do [ \"$1\" = -o ] && out=$2; shift; done\ncp '{Path.combine(root, "prog")}' \"$out\"\nchmod +x \"$out\"",
    )
    let dir = Path.combine(root, "cases/emit-c/SelfhostEmitterT7Tests/Thunk_MatchesCSharp-thunk unit thunk")
    goldenWrite(dir, for: "input.byn", as: "f() {}\n")
    goldenWrite(dir, for: "expected.c", as: "thunk b\ninput.byn")
    let pass = goldenProgramsCase("emit-c", at: dir, by: exe) ?? ""
    goldenWrite(dir, for: "expected.c", as: "thunk a\ninput.byn")
    let failed = goldenProgramsCase("emit-c", at: dir, by: exe) ?? ""
    deleteWorkDir(root)
    assert(pass == "")
    assert(failed.contains("expected.c\nexpected line 1: thunk a\nactual line 1: thunk b"))
}

test "an emit-c case with `input.name` runs on its input staged under that name, which `args` and the C name; without it the plain name" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-programs-original")
    deleteWorkDir(root)
    goldenWrite(root, for: "prog", as: "#!/bin/sh\necho \"$@\"\nfor a; do :; done\ncat \"$a\"\n")
    let exe = goldenCliFake(
        root,
        for: "bayan",
        as: $"while [ $# -gt 0 ]; do [ \"$1\" = -o ] && out=$2; shift; done\ncp '{Path.combine(root, "prog")}' \"$out\"\nchmod +x \"$out\"",
    )
    let t10 = Path.combine(
        root,
        "cases/emit-c/SelfhostDefaultT10Tests/CoverageCMatchesTheCSharpOnEveryRunInput-arithmetic.byn --coverage",
    )
    goldenWrite(t10, for: "args", as: "--coverage\n--mode\nsafe\n--package\n.\ninput.byn\n")
    goldenWrite(t10, for: "input.byn", as: "f() {}\n")
    goldenWrite(t10, for: "input.name", as: "arithmetic.byn\n")
    goldenWrite(t10, for: "expected.c", as: "--coverage --mode safe --package . arithmetic.byn\nf() {}\n")
    let pass = goldenProgramsCase("emit-c", at: t10, by: exe) ?? ""
    let parity = Path.combine(root, "cases/emit-c/SelfhostEmitterParityTests/RunInputsEmitTheSameC-run_x")
    goldenWrite(parity, for: "args", as: "--mode\nsafe\n--package\n.\ninput.byn\n")
    goldenWrite(parity, for: "input.byn", as: "f() {}\n")
    goldenWrite(parity, for: "input.name", as: "lib/a.byn\n")
    goldenWrite(parity, for: "expected.c", as: "--mode safe --package . lib/a.byn\nf() {}\n")
    let passParity = goldenProgramsCase("emit-c", at: parity, by: exe) ?? ""
    // a `SameAsCli` case runs on the full path, read back as `plain` as `Mapped` wrote it; the bare name stays
    let same = Path.combine(root, "cases/emit-c/SelfhostEmitterHarnessTests/DiagnosticOptionsAgree-diag_goto.byn --all")
    goldenWrite(same, for: "args", as: "build\n--emit-c\n--all\ninput.byn\n")
    goldenWrite(same, for: "input.byn", as: "goto.byn\n")
    goldenWrite(same, for: "input.name", as: "goto.byn\n")
    goldenWrite(same, for: "expected.c", as: "--all input.byn\ngoto.byn\n")
    goldenWrite(same, for: "expected.stderr", as: "")
    goldenWrite(same, for: "expected.exitcode", as: "0\n")
    let passSame = goldenProgramsCase("emit-c", at: same, by: exe) ?? ""
    Io.remove(Path.combine(t10, "input.name")) catch {}
    let failed = goldenProgramsCase("emit-c", at: t10, by: exe) ?? ""
    deleteWorkDir(root)
    assert(pass == "")
    assert(passParity == "")
    assert(passSame == "")
    assert(failed.contains(
        "expected line 1: --coverage --mode safe --package . arithmetic.byn\nactual line 1: --coverage --mode safe --package . input.byn",
    ))
}

test "an `args` line reads `\\\\`, `\\n` and `\\r` as a backslash, an LF and a CR (019-export-runners.md), the program getting one argument each" {
    var files = List<string>()
    for f in [
        "input.byn",
        "",
        "section",
        "s\n",
        "args",
        "a\\nb\nc\\\\nd\ne\\rf\\x\n",
        "expected.sections",
        "== s\n[a\nb]\n[c\\nd]\n[e\rf\\x]\n",
    ] {
        files.append(f)
    }
    let pass = goldenProgramsFake(
        "args-escape",
        for: "sem",
        at: "Words",
        as: "echo '== s'\nprintf '[%s]\\n' \"$@\"",
        from: "",
        by: ref files,
    )
    files[7] = "== s\n[a\\nb]\n[c\\\\nd]\n[e\\rf\\x]\n"
    let failed = goldenProgramsFake(
        "args-escape",
        for: "sem",
        at: "Words",
        as: "echo '== s'\nprintf '[%s]\\n' \"$@\"",
        from: "",
        by: ref files,
    )
    assert(pass == "")
    assert(failed.contains("expected line 2: [a\\nb]\nactual line 2: [a"))
    assert(goldenArgUnescape("\\\\r\\") == "\\r\\")
}

test "a path argument below the scratch directory is made absolute though it does not exist there, another argument kept (SelfhostPathT7Tests.cs)" {
    let scratch = Path.combine(Path.fullPath("tmp"), "golden-programs-arg")
    deleteWorkDir(scratch)
    goldenWrite(scratch, for: "tmp/h/x.byn", as: "")
    assert(goldenProgramArg("tmp/h/other", at: scratch) == Path.combine(scratch, "tmp/h/other"))
    assert(goldenProgramArg("tmp/h/x.byn", at: scratch) == Path.combine(scratch, "tmp/h/x.byn"))
    assert(goldenProgramArg("src", at: scratch) == "src")
    assert(goldenProgramArg("x.byn", at: scratch) == "x.byn")
    assert(goldenProgramArg("<repo>/a/b", at: scratch) == $"{scratch}/a/b")
    deleteWorkDir(scratch)
}

