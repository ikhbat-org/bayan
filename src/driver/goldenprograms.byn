test "a sem CheckParity case runs on its `<repo>` argument as the full path below the scratch directory, stderr read repo-relative as `Portable` wrote it, not `<repo>` (SelfhostSemanticsTests.cs:583-614)" {
    var files = List<string>()
    for f in [
        "args",
        "<repo>/tmp/t26-tests/cli/diag_x.byn/x.byn\n",
        "input.byn",
        "f() {}\n",
        "expected.stderr",
        "--> tmp/t26-tests/cli/diag_x.byn/x.byn:1:1\n",
        "expected.exitcode",
        "1\n",
    ] {
        files.append(f)
    }
    let pass = goldenProgramsFake(
        "check-same",
        for: "sem",
        at: "SelfhostSemanticsParityTests",
        as: "test -f \"$1\" && echo \"--> $1:1:1\" >&2\nexit 1",
        from: "",
        by: ref files,
    )
    files[5] = "--> <repo>/tmp/t26-tests/cli/diag_x.byn/x.byn:1:1\n"
    let failed = goldenProgramsFake(
        "check-same",
        for: "sem",
        at: "SelfhostSemanticsParityTests",
        as: "test -f \"$1\" && echo \"--> $1:1:1\" >&2\nexit 1",
        from: "",
        by: ref files,
    )
    assert(pass == "")
    assert(failed.contains(
        "expected.stderr\nexpected line 1: --> <repo>/tmp/t26-tests/cli/diag_x.byn/x.byn:1:1\nactual line 1: --> tmp/t26-tests/cli/diag_x.byn/x.byn:1:1",
    ))
}

