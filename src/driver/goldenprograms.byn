}

test "a DefaultT10 CoverageC/MutateC or Parity `run/` case runs bayan-emit on its input under the file name of its label, which the C names" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-programs-original")
    deleteWorkDir(root)
    goldenWrite(root, for: "prog", as: "#!/bin/sh\necho \"$@\"\nfor a; do :; done\ncat \"$a\"\n")
    let exe = goldenCliFake(root, for: "bayan",
        as: $"while [ $# -gt 0 ]; do [ \"$1\" = -o ] && out=$2; shift; done\ncp '{Path.combine(root, "prog")}' \"$out\"\nchmod +x \"$out\"")
    let t10 = Path.combine(root, "cases/emit-c/SelfhostDefaultT10Tests/CoverageCMatchesTheCSharpOnEveryRunInput-arithmetic.byn --coverage")
    goldenWrite(t10, for: "args", as: "--coverage\n--mode\nsafe\n--package\n.\ninput.byn\n")
    goldenWrite(t10, for: "input.byn", as: "f() {}\n")
    goldenWrite(t10, for: "expected.c", as: "--coverage --mode safe --package . arithmetic.byn\nf() {}\n")
    let pass = goldenProgramsCase("emit-c", at: t10, by: exe) ?? ""
    let parity = Path.combine(root, "cases/emit-c/SelfhostEmitterParityTests/RunInputsEmitTheSameC-run_arithmetic.byn")
    goldenWrite(parity, for: "args", as: "--mode\nsafe\n--package\n.\ninput.byn\n")
    goldenWrite(parity, for: "input.byn", as: "f() {}\n")
    goldenWrite(parity, for: "expected.c", as: "--mode safe --package . arithmetic.byn\nf() {}\n")
    let passParity = goldenProgramsCase("emit-c", at: parity, by: exe) ?? ""
    goldenWrite(t10, for: "expected.c", as: "--coverage --mode safe --package . input.byn\nf() {}\n")
    let failed = goldenProgramsCase("emit-c", at: t10, by: exe) ?? ""
    deleteWorkDir(root)
    assert(pass == "")
    assert(passParity == "")
    assert(failed.contains("expected line 1: --coverage --mode safe --package . input.byn\nactual line 1: --coverage --mode safe --package . arithmetic.byn"))
    assert(goldenProgramOriginal("FixtureCMatchesAndAnInputWithErrorsFailsAsBuildDoes-b.byn --coverage", for: "input.byn") == "input.byn")
}

