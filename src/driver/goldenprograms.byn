test "an emit-c harness case runs bayan-emit without `build` and `--emit-c` (SelfhostEmitterHarness.cs), a changed expected.c fails" {
    var files = List<string>()
    for f in [
        "args",
        "build\n--emit-c\ninput.byn\n",
        "input.byn",
        "f() {}\n",
        "expected.c",
        "input.byn\n",
        "expected.stderr",
        "",
        "expected.exitcode",
        "0\n",
    ] {
        files.append(f)
    }
    let pass = goldenProgramsFake(
        "emit",
        for: "emit-c",
