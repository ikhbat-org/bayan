test "a lex case runs bayan-lex on its input (SelfhostLexerTests.cs:113-121), a changed expected.tokens fails" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-programs-lex")
    deleteWorkDir(root)
    let dir = Path.combine(root, "cases/lex/SelfhostLexerTests/LexGolden-19")
    goldenWrite(dir, for: "input.byn", as: "a /* never closed\nb\n")
    let tokens = "1:1 Identifier `a`\n3:1 EndOfFile\n\nerror BYN0004: unterminated block comment\n\n  1 │ a /* never closed\n    │   ^^ comment starts here\n    │\n  help: close it with `*/`\n"
    goldenWrite(dir, for: "expected.tokens", as: tokens)
    var failure = ""
    let exe = goldenExe(through: ref failure)
    let pass = goldenProgramsCase("lex", at: dir, by: exe) ?? ""
    goldenWrite(dir, for: "expected.tokens", as: tokens.replaced("3:1 EndOfFile", by: "3:2 EndOfFile"))
    let failed = goldenProgramsCase("lex", at: dir, by: exe) ?? ""
    deleteWorkDir(root)
    assert(failure == "")
    assert(pass == "")
    assert(failed.contains("expected.tokens\nexpected line 2: 3:2 EndOfFile\nactual line 2: 3:1 EndOfFile"))
}

