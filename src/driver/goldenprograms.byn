test "an emit-c harness case runs bayan-emit without `build` and `--emit-c` (SelfhostEmitterHarness.cs), a changed expected.c fails" {
    var files = List<string>()
    for f in ["args", "build\n--emit-c\ninput.byn\n", "input.byn", "f() {}\n", "expected.c", "input.byn\n", "expected.stderr", "",
            "expected.exitcode", "0\n"] {
        files.append(f)
    }
    let pass = goldenProgramsFake("emit", for: "emit-c", at: "SelfhostEmitterHarnessTests", as: "echo \"$@\"", from: "", by: ref files)
    files[5] = "--emit-c input.byn\n"
    let failed = goldenProgramsFake("emit", for: "emit-c", at: "SelfhostEmitterHarnessTests", as: "echo \"$@\"", from: "", by: ref files)
    assert(pass == "")
    assert(failed.contains("expected.c\nexpected line 1: --emit-c input.byn\nactual line 1: input.byn"))
    var cli = List<string>()
    for a in ["--color", "never", "test", "--emit-c", "x.test.byn"] {
        cli.append(a)
    }
    let self = goldenProgramEmitArgs(ref cli)
    assert(self.length == 4 && self[2] == "--tests" && self[3] == "x.test.byn")
}

