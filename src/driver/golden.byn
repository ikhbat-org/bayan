test "an expected `import one of <std modules>` matches any std module list, and an expected list only itself" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-std-modules")
    deleteWorkDir(root)
    goldenWrite(
        root,
        for: "masked",
        as: "help: import one of <std modules>\n\"help\":\"import one of <std modules>\"\n",
    )
    goldenWrite(root, for: "listed", as: "help: import one of `std.json`\n")
    let path = Path.combine(root, "masked")
    let now = "help: import one of `std.encoding`, `std.fs`, `std.json`\n\"help\":\"import one of `std.json`\"\n"
    assert(goldenDiffer(now, for: path, at: path) is null)
    assert(goldenDiffer(
        "help: import one of `std.json`\n\"help\":\"import one of `std.json`\"\n",
        for: path,
        at: path,
    ) is null)
    assert(goldenDiffer("help: import one of `std.json`\n\"help\":\"import one of\"\n", for: path, at: path) is { })
    let listed = Path.combine(root, "listed")
    assert(goldenDiffer("help: import one of `std.json`\n", for: listed, at: listed) is null)
    assert(goldenDiffer("help: import one of `std.fs`, `std.json`\n", for: listed, at: listed) is { })
    deleteWorkDir(root)
    assert(goldenStdModules(
        "a import one of `std.a.b`, `std.c` b\n",
        by: "<std modules>",
    ) == "a import one of <std modules> b\n")
    assert(goldenStdModules("import one of `std.a`, x", by: "<std modules>") == "import one of <std modules>, x")
}

/// A shell script at `root`/`name` that prints `bayan 9.9 (fake)` for any arguments and exits with `code` after sleeping `seconds`; executable when `exec`.
string goldenFakeDriver(string root, for string name, as bool exec, by i64 code = 0, i64 seconds = 0)
        uses alloc, fs, process {
    goldenWrite(root, for: name, as: $"#!/bin/sh\necho \"bayan 9.9 (fake)\"\nsleep {seconds}\nexit {code}\n")
    let path = Path.combine(root, name)
    if exec {
        var args = List<string>()
        args.append("a+x")
        args.append(path)
        let _ = Io.run("chmod", args.span) catch { panic($"cannot make {path} executable") }
    }
    return path
}

test "BAYAN_EXE names a driver that starts, and the report prints its path and version line" {
    if Target.os == "windows" {
        todo("the fake driver is a `#!/bin/sh` script made executable by `chmod`, which Windows cannot start")
    }
    let root = Path.combine(Path.fullPath("tmp"), "golden-exe")
    deleteWorkDir(root)
    let path = goldenFakeDriver(root, for: "ok", as: true)
    var failure = ""
    let found = goldenExeOf(path, through: ref failure)
    let report = goldenExeReport(found)
    deleteWorkDir(root)
    assert(found == path)
    assert(failure == "")
    assert(report == $"driver: {path}\nbayan 9.9 (fake)\n")
}

test "an unset, empty or non-executable BAYAN_EXE fails naming BAYAN_EXE" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-exe-bad")
    deleteWorkDir(root)
    let plain = goldenFakeDriver(root, for: "plain", as: false)
    let sleeper = goldenFakeDriver(root, for: "sleeper", as: true, seconds: 5)
    let failing = goldenFakeDriver(root, for: "failing", as: true, by: 1)
    var unset = ""
    var empty = ""
    var plainFailure = ""
    var missing = ""
    var exited = ""
    var slow = ""
    let a = goldenExeOf(null, through: ref unset)
    let b = goldenExeOf("", through: ref empty)
    let c = goldenExeOf(plain, through: ref plainFailure)
    let d = goldenExeOf(Path.combine(root, "none"), through: ref missing)
    let e = goldenExeOf(failing, through: ref exited)
    let f = goldenExeOf(sleeper, through: ref slow, for: 200)
    deleteWorkDir(root)
    assert(a == "" && b == "" && c == "" && d == "" && e == "" && f == "")
    assert(unset.contains("BAYAN_EXE")
        && empty.contains("BAYAN_EXE")
        && plainFailure.contains("BAYAN_EXE")
        && missing.contains("BAYAN_EXE") && exited.contains("BAYAN_EXE") && slow.contains("BAYAN_EXE"))
    assert(unset != plainFailure)
}

/// The `style` cases of `root`: in `skips` the skip texts, and the failures returned (T2b). `$BAYAN_EXE` names the driver.
List<string> goldenStyleFailures(string root, to ref List<string> skips) uses alloc, clock, console, env, fs, process {
    var exit = 0
    var failures = List<string>()
    for c in goldenDiscover(root, through: ref exit) {
        continue if c.kind != "style"
        if (goldenSkip(in c) is { } skip) {
            skips.append($"style/{c.name}: {skip}")
        } else if (goldenRun(in c) is { } failure) {
            failures.append(failure)
        }
    }
    return failures
}

/// Copies tests/cases/style/`shape`.{color,plain,ascii} into `root`/style/.
void goldenStyleCopy(string root, for string shape) uses alloc, fs {
    for ending in goldenStyleEndings() {
        let text = Io.readText(Path.fullPath($"tests/cases/style/{shape}{ending}")) catch ""
        goldenWrite(root, for: $"style/{shape}{ending}", as: text)
    }
}

test "the 17 CLI style shapes match through BAYAN_EXE and the five in-process shapes are skipped naming their test block" {
    var skips = List<string>()
    let failures = goldenStyleFailures(Path.fullPath("tests/cases"), to: ref skips)
    for f in failures {
        print(f)
    }
    assert(failures.length == 0)
    assert(skips.length == 5)
    for skip in skips {
        assert(skip.contains("covered by the test block \"") && skip.contains("src/driver/"))
    }
}

test "a changed expected .color line fails naming the file and the first differing line" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-style-compare")
    deleteWorkDir(root)
    goldenStyleCopy(root, for: "check-ok")
    let path = Path.combine(Path.combine(root, "style"), "check-ok.color")
    let expected = Io.readText(path) catch ""
    var changed = goldenLines(expected)
    let was = changed[3]
    changed[3] = "changed line"
    var text = ""
    for i in 0..changed.length {
        text = i == 0 ? changed[i] : $"{text}\n{changed[i]}"
    }
    goldenWrite(root, for: "style/check-ok.color", as: text)
    var skips = List<string>()
    let failures = goldenStyleFailures(root, to: ref skips)
    deleteWorkDir(root)
