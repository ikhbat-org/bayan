    assert(failures[0].startsWith($"{path}\n"))
    assert(failures[0].contains($"expected line 4: changed line\nactual line 4: {was}"))
}

test "a style child killed by a signal fails that case and the next case still runs" {
    if Target.os == "windows" {
        todo(
            "the crashing driver is a `#!/bin/sh` script that runs `kill -SEGV`, which Windows can neither start nor send",
        )
    }
    let root = Path.combine(Path.fullPath("tmp"), "golden-style-crash")
    deleteWorkDir(root)
    var failure = ""
    let exe = goldenExe(through: ref failure)
    assert(exe != "")
    goldenStyleCopy(root, for: "check-ok")
    goldenStyleCopy(root, for: "diag-error-fix")
    // a driver that crashes on the `check-ok` scratch directory and is `$BAYAN_EXE` otherwise
    goldenWrite(
        root,
        for: "crash",
        as: $"#!/bin/sh\ncase \"$*\" in *\"/style/check-ok/\"*) kill -SEGV $$ ;; esac\nexec \"{exe}\" \"$@\"\n",
    )
    let crash = Path.combine(root, "crash")
    var args = List<string>()
    args.append("a+x")
    args.append(crash)
    let _ = Io.run("chmod", args.span) catch { panic($"cannot make {crash} executable") }
    var exit = 0
    var results = List<string>()
    for c in goldenDiscover(root, through: ref exit) {
        results.append(goldenStyle(in c, by: crash) ?? "passed")
    }
    deleteWorkDir(root)
    assert(results.length == 2)
    assert(results[0].startsWith(Path.combine(root, "style/check-ok.color"))
        && results[0].contains("killed by signal 11"))
    assert(results[1] == "passed")
}

/// Copies tests/cases/`rel` to `root`/`rel`, byte for byte; nothing when it is absent.
void goldenCopy(string root, for string rel) uses alloc, fs {
    let from = Path.fullPath($"tests/cases/{rel}")
    return unless Fs.fileExists(from)
    let bytes = Io.readFile(from) catch return
    let path = Path.combine(root, rel)
    Io.createDirectory(Path.directoryName(path) ?? root) catch return
    Io.writeFile(path, bytes.span) catch return
}

/// Copies the `run` case `stem` (its input and every file beside it of the same stem) into `root`/run/.
void goldenRunCopy(string root, for string stem) uses alloc, fs {
    for ending in [".byn", ".stdout", ".stderr", ".exitcode", ".args", ".stdin"] {
        goldenCopy(root, for: $"run/{stem}{ending}")
    }
}

/// `text` with line `index` (from 0) replaced by `changed line`.
string goldenChangeLine(string text, at i64 index) uses alloc {
    var changed = goldenLines(text)
    changed[index] = "changed line"
    var joined = ""
    for i in 0..changed.length {
        joined = i == 0 ? changed[i] : $"{joined}\n{changed[i]}"
    }
    return joined
}

// The sweep of the 346 `run` cases is `bayan test tests/cases --only run/` (T4), one result and one time limit per case: as one test block it
// outlived the block's time limit.

/// A cases directory `root` with the `run` cases `a-fails` (arithmetic with a changed `.stdout` line), `b-loops` (a program that never
/// exits) and `c-passes` (arithmetic).
void goldenLoopFixture(string root) uses alloc, fs {
    deleteWorkDir(root)
    let source = Io.readText(Path.fullPath("tests/cases/run/arithmetic.byn")) catch ""
    let stdout = Io.readText(Path.fullPath("tests/cases/run/arithmetic.stdout")) catch ""
    goldenWrite(root, for: "run/a-fails.byn", as: source)
    goldenWrite(root, for: "run/a-fails.stdout", as: goldenChangeLine(stdout, at: 0))
    goldenWrite(root, for: "run/b-loops.byn", as: "void main() {\n    while true {\n    }\n}\n")
    goldenWrite(root, for: "run/b-loops.stdout", as: "")
    goldenWrite(root, for: "run/c-passes.byn", as: source)
    goldenWrite(root, for: "run/c-passes.stdout", as: stdout)
}

test "a failing case and a case that never exits are each reported and the cases after them still run" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-limit")
    goldenLoopFixture(root)
    var results = List<GoldenResult>()
    let none = List<string>()
    let exit = goldenTest(root, by: none, for: 5000, to: ref results)
    deleteWorkDir(root)
    assert(exit == exitTestFailure)
    assert(results.length == 3)
    assert(results[0].name == "run/a-fails" && results[0].status == "failed")
    assert(results[0].detail.contains(Path.combine(Path.combine(root, "run"), "a-fails.stdout"))
        && results[0].detail.contains("expected line 1: changed line"))
    assert(results[1].name == "run/b-loops" && results[1].status == "timed out")
    assert(results[1].detail.startsWith("timed out after 5 s"))
    assert(results[2].name == "run/c-passes" && results[2].status == "passed")
}

test "an in-process case that never exits is reported as timed out and the cases after it still run" {
    if Target.os == "windows" {
        todo("the hanging driver is a `#!/bin/sh` script made executable by `chmod`, which Windows cannot start")
    }
    var failure = ""
    let exe = goldenExe(through: ref failure)
    assert(exe != "")
    let root = Path.combine(Path.fullPath("tmp"), "golden-limit-inprocess")
    deleteWorkDir(root)
    let source = Io.readText(Path.fullPath("tests/cases/lex/bad-chars.byn")) catch ""
    let tokens = Io.readText(Path.fullPath("tests/cases/lex/bad-chars.tokens")) catch ""
    for stem in ["a-hang", "b-ok"] {
        goldenWrite(root, for: $"lex/{stem}.byn", as: source)
        goldenWrite(root, for: $"lex/{stem}.tokens", as: tokens)
    }
    // a driver that never exits on the `a-hang` case and is `$BAYAN_EXE` otherwise
    goldenWrite(
        root,
        for: "hang",
        as: $"#!/bin/sh\ncase \"$*\" in *a-hang*) while :; do sleep 1; done ;; esac\nexec \"{exe}\" \"$@\"\n",
    )
    let hang = Path.combine(root, "hang")
    var args = List<string>()
    args.append("a+x")
    args.append(hang)
    let _ = Io.run("chmod", args.span) catch { panic($"cannot make {hang} executable") }
    var exit = 0
    var results = List<GoldenResult>()
    for c in goldenDiscover(root, through: ref exit) {
        results.append(goldenResult(c, for: 3000, by: hang))
    }
    deleteWorkDir(root)
    assert(results.length == 2)
    assert(results[0].name == "lex/a-hang" && results[0].status == "timed out")
    assert(results[0].detail.startsWith("timed out after 3 s"))
    assert(results[1].name == "lex/b-ok" && results[1].status == "passed")
}

test "--only run/<name> runs that one case, in the runner and through bayan test" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-only")
    goldenLoopFixture(root)
    var results = List<GoldenResult>()
    var only = List<string>()
    only.append("run/c-passes")
    let exit = goldenTest(root, by: only, for: 60000, to: ref results)
    var nothing = List<string>()
    nothing.append("run/none")
    var unmatched = List<GoldenResult>()
    let usage = goldenTest(root, by: nothing, for: 60000, to: ref unmatched)
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    for a in ["test", root, "--only", "run/c-passes"] {
        args.append(a)
    }
    let o = goldenChild(exe, by: in args, at: Path.fullPath("."), from: in List<u8>(), through: ref failure)
    deleteWorkDir(root)
    assert(exit == exitOk && results.length == 1 && results[0].name == "run/c-passes" && results[0].status == "passed")
    assert(usage == exitUsage && unmatched.length == 0)
    assert(failure == "" && o.exitCode == exitOk)
    assert(o.stdout.contains("running 1 case of ") && o.stdout.contains("\npassed run/c-passes\n"))
    assert(!o.stdout.contains("a-fails") && !o.stdout.contains("b-loops"))
}

/// A cases directory `root` with the `run` cases `a-passes`, `b-fails` (its `.stdout` fourth line changed) and `c-passes`, and the `lex`
/// cases `bad-chars` and `bad-interpolation`.
void goldenJobsFixture(string root) uses alloc, fs {
    deleteWorkDir(root)
    let source = Io.readText(Path.fullPath("tests/cases/run/arithmetic.byn")) catch ""
    let stdout = Io.readText(Path.fullPath("tests/cases/run/arithmetic.stdout")) catch ""
    for stem in ["a-passes", "b-fails", "c-passes"] {
        goldenWrite(root, for: $"run/{stem}.byn", as: source)
        goldenWrite(root, for: $"run/{stem}.stdout", as: stem == "b-fails" ? goldenChangeLine(stdout, at: 3) : stdout)
    }
    for stem in ["bad-chars", "bad-interpolation"] {
        goldenCopy(root, for: $"lex/{stem}.byn")
        goldenCopy(root, for: $"lex/{stem}.tokens")
    }
}

/// `bayan test root --jobs <jobs>` through `$BAYAN_EXE`, its stdout with the seconds masked (`goldenTestSeconds`).
GoldenOutcome goldenJobsRun(string root, as string jobs) uses alloc, clock, env, fs, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    for a in ["test", root, "--jobs", jobs] {
        args.append(a)
    }
    var o = goldenChild(exe, by: in args, at: Path.fullPath("."), from: in List<u8>(), through: ref failure)
    o.stdout = goldenTestSeconds(goldenLf(o.stdout))
    return o
}

// L040: every selected case is reported once, the same under --jobs 1 and --jobs 4
test "--jobs 1 and --jobs 4 print the same report in case order, times masked, and exit the same" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-jobs")
    goldenJobsFixture(root)
    let one = goldenJobsRun(root, as: "1")
    let four = goldenJobsRun(root, as: "4")
    var results = List<GoldenResult>()
    let none = List<string>()
    let exit = goldenTest(root, by: none, for: 60000, to: ref results, jobs: 4)
    deleteWorkDir(root)
    assert(one.exitCode == exitTestFailure && four.exitCode == one.exitCode && exit == exitTestFailure)
    assert(four.stdout == one.stdout)
    assert(one.stdout.contains("running 5 cases of ")
        && one.stdout.contains("◆ 4 passed · ✗ 1 failed · 0 pending · 0 test blocks, 5 golden cases · Ts"))
    assert(results.length == 5)
    var names = List<string>()
    for r in results {
        names.append(r.name)
    }
    assert(names[0] == "lex/bad-chars" && names[1] == "lex/bad-interpolation" && names[2] == "run/a-passes")
    assert(names[3] == "run/b-fails" && names[4] == "run/c-passes")
    assert(results[3].status == "failed" && results[4].status == "passed")
}

/// `bayan test root --jobs <jobs>` through `$BAYAN_EXE` with `$BAYAN_TEST_SHARD` set to `shard` (unset when null): its exit code, its stdout
/// with the seconds masked (`goldenTestSeconds`) and its stderr.
GoldenOutcome goldenShardRun(string root, as string jobs, by string? shard) uses alloc, env, fs, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    for a in ["test", root, "--jobs", jobs] {
        args.append(a)
    }
    var env = goldenEnv()
    env["BAYAN_TEST_SHARD"] = shard
    let r = Io.run(exe, args.span, env: env) catch return GoldenOutcome { stdout: failure, exitCode: -1 }
    return GoldenOutcome { stdout: goldenTestSeconds(goldenLf(r.stdout)), stderr: r.stderr, exitCode: r.exitCode }
}

/// The case lines of a golden report, `<status> <kind>/<case>` (`goldenPrint`), in report order.
List<string> goldenCaseLines(string report) uses alloc {
    var lines = List<string>()
    for line in goldenLines(report) {
        for status in ["passed ", "failed ", "skipped ", "timed out "] {
            if line.startsWith(status) {
                lines.append(line)
            }
        }
    }
    return lines
}

// spec 019 T30: the shards of a run are disjoint and together hold every selected case
test "BAYAN_TEST_SHARD 1/3, 2/3 and 3/3 report each case of the unsharded run once, and the header names the shard" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-shard")
    goldenJobsFixture(root)
    let whole = goldenShardRun(root, as: "4", by: null)
    let empty = goldenShardRun(root, as: "4", by: "")
    var shards = List<GoldenOutcome>()
    for i in 1..4 {
        shards.append(goldenShardRun(root, as: "4", by: $"{i}/3"))
    }
    deleteWorkDir(root)
    let all = goldenCaseLines(whole.stdout)
    assert(all.length == 5 && whole.exitCode == exitTestFailure && empty.stdout == whole.stdout)
    var seen = List<string>()
    for i in 0..3 {
        assert(shards[i].stdout.contains($" of {root} (shard {i + 1}/3)\n"))
        for line in goldenCaseLines(shards[i].stdout) {
            seen.append(line)
        }
    }
    assert(seen.length == all.length)
    for line in all {
        var times = 0
        for s in seen {
            if s == line {
                times += 1
            }
        }
        assert(times == 1)
    }
    assert(shards[0].stdout.contains("running 2 cases of ") && shards[2].stdout.contains("running 1 case of "))
    assert(shards[0].exitCode == exitTestFailure && shards[1].exitCode == exitOk && shards[2].exitCode == exitOk)
}

test "BAYAN_TEST_SHARD puts all cases of one class in one shard, a flat case being its own group" {
    var cases = List<GoldenCase>()
    for name in [
        "lex/flat-a", "lex/One/x", "lex/One/y", "lex/One/z", "lex/flat-b", "sem/One/p", "sem/Two/q", "sem/Two/r",
    ] {
        let slash = goldenOffset(name, for: "/")
        cases.append(GoldenCase { kind: name[0..slash], name: name[slash + 1..name.length], input: name })
    }
    var shards = List<string>()
    var total = 0
    for i in 0..3 {
        var sb = StrBuf()
        for c in goldenShardCases(in cases, at: i, by: 3) {
            sb.append($"{c.input} ")
            total += 1
        }
        shards.append(sb.finish())
    }
    // groups in case order: lex/flat-a, lex/One, lex/flat-b, sem/One, sem/Two
    assert(total == cases.length)
    assert(shards[0] == "lex/flat-a sem/One/p ")
    assert(shards[1] == "lex/One/x lex/One/y lex/One/z sem/Two/q sem/Two/r ")
    assert(shards[2] == "lex/flat-b ")
}

test "a BAYAN_TEST_SHARD that is not i/n with 1 <= i <= n <= 64 is refused with exit 2, naming the variable" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-shard-bad")
    goldenJobsFixture(root)
    var outcomes = List<GoldenOutcome>()
    for value in ["0/4", "5/4", "a/b", "3", "/4", "4/", "1/65", "1/3/3", "-1/3"] {
        outcomes.append(goldenShardRun(root, as: "1", by: value))
    }
    deleteWorkDir(root)
    for o in outcomes {
        assert(o.exitCode == exitUsage && !o.stdout.contains("running "))
        assert(o.stderr.contains("BAYAN_TEST_SHARD expects i/n, whole numbers with 1 <= i <= n <= 64, got `"))
    }
}

test "--jobs 1 and --jobs 4 print the same report under BAYAN_TEST_SHARD 1/3" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-shard-jobs")
    goldenJobsFixture(root)
    let one = goldenShardRun(root, as: "1", by: "1/3")
    let four = goldenShardRun(root, as: "4", by: "1/3")
    deleteWorkDir(root)
    assert(one.exitCode == exitTestFailure && four.exitCode == one.exitCode && four.stdout == one.stdout)
    let lines = goldenCaseLines(one.stdout)
    assert(lines.length == 2 && lines[0] == "passed lex/bad-chars" && lines[1] == "failed run/b-fails")
}

test "a worker resumes at its next-<k> index and stops after a batch with more of its cases left" {
    let dir = Path.combine(Path.fullPath("tmp"), "golden-worker-batch")
    deleteWorkDir(dir)
    let input = Path.fullPath("tests/cases/lex/bad-chars.byn")
    var list = StrBuf()
    for _ in 0..goldenWorkerBatch + 3 {
        list.append($"lex\tbad-chars\t{input}\n")
    }
    goldenWrite(dir, for: "cases", as: list.finish())
    goldenWrite(dir, for: "next-0", as: "2\n")
    let first = goldenWorker(dir, at: "0", for: "1", by: "60000")
    let skipped = Io.readText(Path.combine(dir, "1")) catch "-"
    let last = Io.readText(Path.combine(dir, $"{goldenWorkerBatch + 1}")) catch "-"
    let unrun = Io.readText(Path.combine(dir, $"{goldenWorkerBatch + 2}")) catch "-"
    let next = Io.readText(Path.combine(dir, "next-0")) catch "-"
    let second = goldenWorker(dir, at: "0", for: "1", by: "60000")
    let rest = Io.readText(Path.combine(dir, $"{goldenWorkerBatch + 2}")) catch "-"
    deleteWorkDir(dir)
    assert(first == goldenWorkerMore && skipped == "-" && last.startsWith("passed\n") && unrun == "-")
    assert(next == $"{goldenWorkerBatch + 2}\n")
    assert(second == exitOk && rest.startsWith("passed\n"))
}

test "--jobs 8 fails the changed case naming its path and the expected and actual fourth line, the others passing" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-jobs-8")
    goldenJobsFixture(root)
    let stdout = Io.readText(Path.fullPath("tests/cases/run/arithmetic.stdout")) catch ""
    let fourth = goldenLines(goldenLf(stdout))[3]
    let eight = goldenJobsRun(root, as: "8")
    let expected = Path.combine(Path.combine(root, "run"), "b-fails.stdout")
    deleteWorkDir(root)
    assert(eight.exitCode == exitTestFailure)
    assert(eight.stdout.contains(
        $"\nfailed run/b-fails\n    {expected}\n    expected line 4: changed line\n    actual line 4: {fourth}\n",
    ))
    for name in ["lex/bad-chars", "lex/bad-interpolation", "run/a-passes", "run/c-passes"] {
        assert(eight.stdout.contains($"\npassed {name}\n"))
    }
}

test "a worker that panics fails the case it was on with its stderr, and its later cases naming that case" {
    if Target.os == "windows" {
        todo("the panicking worker is a `#!/bin/sh` script made executable by `chmod`, which Windows cannot start")
    }
    let root = Path.combine(Path.fullPath("tmp"), "golden-jobs-panic")
    deleteWorkDir(root)
    let exe = goldenCliFake(root, for: "bayan", as: "echo 'panic: slice 3..5 of a 4-byte string' >&2\nexit 101")
    var cases = List<GoldenCase>()
    for name in ["a", "b"] {
        cases.append(GoldenCase { kind: "run", name: name, input: Path.combine(root, $"{name}.byn") })
    }
    var results = List<GoldenResult>()
    goldenJobs(in cases, by: exe, for: 60000, as: 1, to: ref results)
    deleteWorkDir(root)
    assert(results.length == 2)
    assert(results[0].detail.contains("stopped on it; its stderr:\npanic: slice 3..5 of a 4-byte string"))
    assert(results[1].detail.contains("did not reach it: it stopped on run/a"))
}

test "one worker runs with no `sh` and is started again while it exits goldenWorkerMore, resuming where it stopped (T17e)" {
    if Target.os == "windows" {
        todo("the restarted worker is a `#!/bin/sh` script made executable by `chmod`, which Windows cannot start")
    }
    let root = Path.combine(Path.fullPath("tmp"), "golden-jobs-one")
    deleteWorkDir(root)
    // the fake worker writes the result of the case in next-0 (0 when there is none); it exits 75 after case 0, as after a batch
    let body = "[ \"$2\" = --golden-worker ] || exit 0\ni=$(cat \"$3/next-0\" 2>/dev/null || echo 0)\nprintf 'passed\\nran %s' \"$i\" > \"$3/$i\"\n[ \"$i\" = 0 ] || exit 0\necho 1 > \"$3/next-0\"\nexit 75"
    let exe = goldenCliFake(root, for: "bayan", as: body)
    var cases = List<GoldenCase>()
    for name in ["a", "b"] {
        cases.append(GoldenCase { kind: "run", name: name, input: Path.combine(root, $"{name}.byn") })
    }
    var results = List<GoldenResult>()
    goldenJobs(in cases, by: exe, for: 60000, as: 1, to: ref results)
    deleteWorkDir(root)
    assert(results.length == 2)
    assert(results[0].status == "passed" && results[0].detail == "ran 0")
    assert(results[1].status == "passed" && results[1].detail == "ran 1")
}

test "one worker of the driver itself runs more than a batch of cases, started again after each batch, on every OS (T17e)" {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    print(failure) if exe == ""
    assert(exe != "")
    let input = Path.fullPath("tests/cases/lex/bad-chars.byn")
    var cases = List<GoldenCase>()
    for _ in 0..goldenWorkerBatch + 2 {
        cases.append(GoldenCase { kind: "lex", name: "bad-chars", input: input })
    }
    var results = List<GoldenResult>()
    goldenJobs(in cases, by: exe, for: 60000, as: 1, to: ref results)
    assert(results.length == goldenWorkerBatch + 2)
    for r in results {
        print(r.detail) if r.status != "passed"
        assert(r.status == "passed")
    }
}

// The bound of a run over the full cases tree (spec 019 T9a, R9; docs/memory-leaks.md rule 8). The run takes minutes, past the 60 s of a test
// block, so the block is pending unless `$BAYAN_TEST_TIMEOUT_MS` gives it 10 minutes, as the release memory gate does (T9b).

/// `sh -c` text: runs `BAYAN_EXE=$1 $1 test $2`, output dropped, writing its exit code to the file `$4` when it ends; until then, every 50 ms,
/// the resident set (`ps`, KB) of it and of each `$1 test --golden-worker $3…`. Prints `<exit> <runner peak KB> <largest worker peak KB>`.
const goldenPeakScript: string = "( BAYAN_EXE=\"$1\" \"$1\" test \"$2\" >/dev/null 2>&1; echo $? > \"$4\" ) & t=0; w=0; while [ ! -s \"$4\" ]; do s=$(ps -A -ww -o rss=,args= | awk -v p=\"$1 test $2\" -v q=\"$1 test --golden-worker $3\" '{ k = $1 + 0; sub(/^ *[0-9]+ /, \"\") } $0 == p && k > a { a = k } index($0, q) == 1 && k > b { b = k } END { print a + 0, b + 0 }'); a=${s% *}; b=${s#* }; [ \"$a\" -gt \"$t\" ] && t=$a; [ \"$b\" -gt \"$w\" ] && w=$b; sleep 0.05; done; echo \"$(cat \"$4\") $t $w\""

test "a run over tests/cases keeps the runner and each worker under 15 MB and leaves no scratch directory" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let limit = testTimeout()
    if limit < 600000 {
        todo("the run takes minutes: set BAYAN_TEST_TIMEOUT_MS to 600000 or more")
    }
    var failure = ""
    let exe = goldenExe(through: ref failure)
    print(failure) if exe == ""
    assert(exe != "")
    let tmp = Path.fullPath("tmp")
    let root = Path.combine(tmp, "golden-bound")
    deleteWorkDir(root)
    Io.createDirectory(root) catch { panic($"cannot create {root}") }
    let before = Io.listDir(tmp) catch List<string>()
    var args = List<string>()
    for a in [
        "-c",
        goldenPeakScript,
        "sh",
        exe,
        "tests/cases",
        Path.combine(tmp, "golden-jobs-"),
        Path.combine(root, "exit"),
    ] {
        args.append(a)
    }
    let r = Io.run("sh", args.span, timeout: Millis(limit - 10000)) catch { panic("the sampled run did not end") }
    deleteWorkDir(root)
    let after = Io.listDir(tmp) catch List<string>()
    var fields = List<string>()
    for f in r.stdout.trimmed(from: .end).parts(by: " ") {
        fields.append(f)
    }
    assert(fields.length == 3 && fields[0] == "0")
    let runner = t9Digits(fields[1], until: 9223372036854775807) ?? 0
    let worker = t9Digits(fields[2], until: 9223372036854775807) ?? 0
    // measured 2026-11-17 on macOS arm64 (10 CPUs, shared), default --jobs 4, four runs: runner 9,296 to 9,984 KB, largest worker 9,568 to
    // 9,792 KB; the bounds are 1.5 times that. The runner lists the cases, starts the workers and reads their results; each worker runs its
    // share of the cases in itself, so it is sampled on its own. The drivers a worker starts to build or run a case are not counted.
    // `cache` is the program cache `goldenEnv` names (CACHEDIR.TAG, kept between runs as the C# classes keep it), not scratch: a fresh
    // clone has no tmp/cache before the first run.
    var left = List<string>()
    for name in after {
        continue if name == "cache"
        var old = false
        for b in before {
            old = old || b == name
        }
        if !old || name is "run" or "run-build" or "style" or "style-cache" or "scaffold" or "output" {
            left.append(name)
        }
    }
    print(
        $"runner {runner} KB, largest worker {worker} KB (measured 9,984 and 9,792), left in {tmp}: {t5Join(in left)}",
    )
    assert(runner > 0 && runner < 15 * 1024)
    assert(worker > 0 && worker < 15 * 1024)
    assert(left.length == 0)
}

/// A cases directory `root` for update mode (R5): `lex/a-same` matching; `lex/b-changed`, and `lex/c-pending` with a `.pending` file, their third
/// `.tokens` line changed; `run/d-changed` its fourth `.stdout` line changed.
void goldenUpdateFixture(string root) uses alloc, fs {
    deleteWorkDir(root)
    let source = Io.readText(Path.fullPath("tests/cases/lex/bad-chars.byn")) catch ""
    let tokens = Io.readText(Path.fullPath("tests/cases/lex/bad-chars.tokens")) catch ""
    for stem in ["a-same", "b-changed", "c-pending"] {
        goldenWrite(root, for: $"lex/{stem}.byn", as: source)
        goldenWrite(root, for: $"lex/{stem}.tokens", as: stem == "a-same" ? tokens : goldenChangeLine(tokens, at: 2))
    }
    goldenWrite(root, for: "lex/c-pending.pending", as: "T6\n")
    goldenWrite(
        root,
        for: "run/d-changed.byn",
        as: Io.readText(Path.fullPath("tests/cases/run/arithmetic.byn")) catch "",
    )
    let stdout = Io.readText(Path.fullPath("tests/cases/run/arithmetic.stdout")) catch ""
    goldenWrite(root, for: "run/d-changed.stdout", as: goldenChangeLine(stdout, at: 3))
}

/// `bayan test root --jobs <jobs>` through `$BAYAN_EXE` with `$BAYAN_UPDATE` set to `update` (unset when null): its exit code and stdout.
GoldenOutcome goldenUpdateRun(string root, as string jobs, by string? update) uses alloc, env, fs, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    for a in ["test", root, "--jobs", jobs] {
        args.append(a)
    }
    var env = goldenEnv()
    env["BAYAN_UPDATE"] = update
    let r = Io.run(exe, args.span, env: env) catch return GoldenOutcome { stdout: failure, exitCode: -1 }
    return GoldenOutcome { stdout: goldenLf(r.stdout), stderr: r.stderr, exitCode: r.exitCode }
}

/// The modification time of `path` in nanoseconds; -1 when it cannot be read.
i64 goldenModified(string path) uses fs {
    let t = Fs.modified(path) catch return -1
    return t.nanos
}

/// Every file under `root` with its modification time and text, one string.
string goldenTree(string root) uses alloc, fs {
    var sb = StrBuf()
    for rel in goldenFiles(root) {
        let path = Path.combine(root, rel)
        sb.append($"{rel} {goldenModified(path)}\n{Io.readText(path) catch "<unreadable>"}\n")
    }
    return sb.finish()
}

test "BAYAN_UPDATE=1 with --jobs 4 rewrites only the differing expected files, lists them in case order, and leaves a .pending case alone" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-update")
    goldenUpdateFixture(root)
    let same = Path.combine(root, "lex/a-same.tokens")
    let pending = Path.combine(root, "lex/c-pending.tokens")
    let sameBefore = $"{goldenModified(same)} {Io.readText(same) catch ""}"
    let pendingBefore = $"{goldenModified(pending)} {Io.readText(pending) catch ""}"
    let four = goldenUpdateRun(root, as: "4", by: "1")
    let again = goldenUpdateRun(root, as: "1", by: "1")
    let changed = Io.readText(Path.combine(root, "lex/b-changed.tokens")) catch ""
    let stdout = Io.readText(Path.combine(root, "run/d-changed.stdout")) catch ""
    let sameAfter = $"{goldenModified(same)} {Io.readText(same) catch ""}"
    let pendingAfter = $"{goldenModified(pending)} {Io.readText(pending) catch ""}"
    deleteWorkDir(root)
    assert(four.exitCode == exitOk && again.exitCode == exitOk)
    let b = Path.combine(Path.combine(root, "lex"), "b-changed.tokens")
    let d = Path.combine(Path.combine(root, "run"), "d-changed.stdout")
    let c = Path.combine(Path.combine(root, "lex"), "c-pending.pending")
    assert(four.stdout.contains(
        $"\npassed lex/a-same\npassed lex/b-changed\n    rewrote {b}\nskipped lex/c-pending\n    pending: {c}\npassed run/d-changed\n    rewrote {d}\n",
    ))
    assert(again.stdout.contains("\npassed lex/a-same\npassed lex/b-changed\nskipped lex/c-pending\n"))
    assert(!again.stdout.contains("rewrote"))
    assert(changed == (Io.readText(Path.fullPath("tests/cases/lex/bad-chars.tokens")) catch "-"))
    assert(stdout == goldenLf(Io.readText(Path.fullPath("tests/cases/run/arithmetic.stdout")) catch "-"))
    assert(sameAfter == sameBefore && pendingAfter == pendingBefore)
}

// L042: a run without BAYAN_UPDATE writes nothing under the cases directory
test "a run without BAYAN_UPDATE leaves the cases directory byte for byte the same, with --jobs 1 and --jobs 4" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-no-update")
    goldenUpdateFixture(root)
    let before = goldenTree(root)
    let one = goldenUpdateRun(root, as: "1", by: null)
    let four = goldenUpdateRun(root, as: "4", by: null)
    let after = goldenTree(root)
    deleteWorkDir(root)
    assert(one.exitCode == exitTestFailure && four.exitCode == exitTestFailure)
    assert(one.stdout.contains("\nfailed lex/b-changed\n") && one.stdout.contains("\nskipped lex/c-pending\n"))
    assert(!one.stdout.contains("rewrote") && !four.stdout.contains("rewrote"))
    assert(before.contains("lex/b-changed.tokens") && after == before)
}

test "a .pending case that now matches fails saying to remove its .pending file" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-pending")
    deleteWorkDir(root)
    goldenCopy(root, for: "lex/bad-chars.byn")
    goldenCopy(root, for: "lex/bad-chars.tokens")
    goldenWrite(root, for: "lex/bad-chars.pending", as: "T6\n")
    var exit = 0
    var results = List<GoldenResult>()
    for c in goldenDiscover(root, through: ref exit) {
        results.append(goldenResult(c, for: 60000))
    }
    let tokens = Path.combine(root, "lex/bad-chars.tokens")
    let kept = Io.readText(tokens) catch ""
    deleteWorkDir(root)
    assert(results.length == 1 && results[0].status == "failed")
    let input = Path.combine(Path.combine(root, "lex"), "bad-chars.byn")
    let pending = Path.combine(Path.combine(root, "lex"), "bad-chars.pending")
    assert(results[0].detail == $"{input}\nnow matches its expected output: remove {pending}")
    assert(kept == (Io.readText(Path.fullPath("tests/cases/lex/bad-chars.tokens")) catch "-"))
}

/// A cases directory `root` of `.pending` cases: `lex/p` and `run/q` build and differ (third `.tokens`, fourth `.stdout` line changed);
/// `run/broken` does not build.
void goldenPendingFixture(string root) uses alloc, fs {
    deleteWorkDir(root)
    goldenWrite(root, for: "lex/p.byn", as: Io.readText(Path.fullPath("tests/cases/lex/bad-chars.byn")) catch "")
    goldenWrite(
        root,
        for: "lex/p.tokens",
        as: goldenChangeLine(Io.readText(Path.fullPath("tests/cases/lex/bad-chars.tokens")) catch "", at: 2),
    )
    goldenWrite(root, for: "run/q.byn", as: Io.readText(Path.fullPath("tests/cases/run/arithmetic.byn")) catch "")
    goldenWrite(
        root,
        for: "run/q.stdout",
        as: goldenChangeLine(Io.readText(Path.fullPath("tests/cases/run/arithmetic.stdout")) catch "", at: 3),
    )
    goldenWrite(root, for: "run/broken.byn", as: "void main() {\n    print(nope)\n}\n")
    goldenWrite(root, for: "run/broken.stdout", as: "x\n")
    for stem in ["lex/p", "run/q", "run/broken"] {
        goldenWrite(root, for: $"{stem}.pending", as: "T6\n")
    }
}

test "a .pending case that does not build fails with its build error, and one that builds and differs is skipped" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-pending-build")
    goldenPendingFixture(root)
    var exit = 0
    var results = List<GoldenResult>()
    for c in goldenDiscover(root, through: ref exit) {
        results.append(goldenResult(c, for: 60000))
    }
    deleteWorkDir(root)
    assert(results.length == 3
        && results[0].name == "lex/p"
        && results[1].name == "run/broken"
        && results[2].name == "run/q")
    assert(results[0].status == "skipped" && results[2].status == "skipped")
    assert(results[1].status == "failed")
    let input = Path.combine(Path.combine(root, "run"), "broken.byn")
    assert(results[1].detail.startsWith($"{input}\nrun/broken did not build:\n")
        && results[1].detail.contains("error BYN2001: `nope` is not defined"))
}

/// `bayan test root --jobs <jobs>` (no `--jobs` when empty) through `$BAYAN_EXE` with the child's `$BAYAN_EXE` set to `value` (unset when
/// null): its exit code and stdout with the seconds masked (`goldenTestSeconds`).
GoldenOutcome goldenExeRun(string root, by string? value, as string jobs = "") uses alloc, env, fs, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    args.append("test")
    args.append(root)
    if jobs != "" {
        args.append("--jobs")
        args.append(jobs)
    }
    var env = goldenEnv()
    env["BAYAN_EXE"] = value
    let r = Io.run(exe, args.span, env: env) catch return GoldenOutcome { stdout: failure, exitCode: -1 }
    return GoldenOutcome { stdout: goldenTestSeconds(goldenLf(r.stdout)), stderr: r.stderr, exitCode: r.exitCode }
}

test "a .pending case with BAYAN_EXE unset or naming a missing file fails naming BAYAN_EXE, with --jobs 1 and the default jobs alike" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-pending-exe")
    goldenPendingFixture(root)
    let none = Path.combine(root, "none")
    let unset = goldenExeRun(root, by: null, as: "1")
    let missing = goldenExeRun(root, by: none, as: "1")
    let unsetDefault = goldenExeRun(root, by: null)
    let missingDefault = goldenExeRun(root, by: none)
    deleteWorkDir(root)
    assert(unset.exitCode == exitTestFailure && missing.exitCode == exitTestFailure)
    assert(unsetDefault.exitCode == exitTestFailure && missingDefault.exitCode == exitTestFailure)
    assert(unsetDefault.stdout == unset.stdout && missingDefault.stdout == missing.stdout)
    let stems = ["lex/p", "run/broken", "run/q"]
    let inputs = [
        Path.combine(Path.combine(root, "lex"), "p.byn"),
        Path.combine(Path.combine(root, "run"), "broken.byn"),
        Path.combine(Path.combine(root, "run"), "q.byn"),
    ]
    for i in 0..3 {
        let stem = stems[i]
        let input = inputs[i]
        assert(unset.stdout.contains(
            $"\nfailed {stem}\n    {input}\n    BAYAN_EXE is not set: set it to the path of the bayan driver\n",
        ))
        assert(missing.stdout.contains(
            $"\nfailed {stem}\n    {input}\n    BAYAN_EXE={none} is not an executable bayan driver\n",
        ))
    }
    assert(unset.stdout.contains("\n◆ 0 passed · ✗ 3 failed · 0 pending · 0 test blocks, 3 golden cases · ")
        && missing.stdout.contains("\n◆ 0 passed · ✗ 3 failed · 0 pending · 0 test blocks, 3 golden cases · "))
}

test "new, out, emit and quality cases pass over tests/cases" {
    for kind in ["new", "out", "emit", "quality"] {
        var count: i64 = 0
        let failures = goldenFailures(Path.fullPath("tests/cases"), for: kind, to: ref count)
        for f in failures {
            print(f)
        }
        assert(failures.length == 0)
        assert(count == (kind is "new" or "out" ? 3 : 1))
    }
}

test "run cases honour // mode:, // os:, .args, .stdin, .exitcode, .stderr, .test.byn and an empty working directory" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-run")
    deleteWorkDir(root)
    // mode: fast; .args; .stdin; .stderr and .exitcode; a .test.byn; a case that lists its working directory
    for stem in ["overflow-fast", "main-args", "io-stdin", "assert-and-right", "assert-fails.test", "io-list-dir"] {
        goldenRunCopy(root, for: stem)
    }
    // a case for the other OS, with its .stdout changed: skipped here, so it passes
    let other = Target.os == "windows" ? "io-run" : "path-windows-combine"
    goldenRunCopy(root, for: other)
    let stdout = Path.combine(root, $"run/{other}.stdout")
    goldenWrite(root, for: $"run/{other}.stdout", as: goldenChangeLine(Io.readText(stdout) catch "", at: 0))
    // a stale file in the working directory of io-list-dir
    goldenWrite(Path.fullPath("tmp"), for: "run/run_io-list-dir/stale.txt", as: "x\n")
    var count: i64 = 0
    let failures = goldenFailures(root, for: "run", to: ref count)
    deleteWorkDir(root)
    for f in failures {
        print(f)
    }
    assert(count == 7)
    assert(failures.length == 0)
}

test "a changed run expected line or a missing .exitcode fails naming the expected file and the first differing line" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-run-fail")
    deleteWorkDir(root)
    goldenRunCopy(root, for: "main-args")
    let stdout = Path.combine(Path.combine(root, "run"), "main-args.stdout")
    let was = goldenLines(Io.readText(stdout) catch "")[1]
    goldenWrite(root, for: "run/main-args.stdout", as: goldenChangeLine(Io.readText(stdout) catch "", at: 1))
    goldenRunCopy(root, for: "assert-and-right")
    Io.remove(Path.combine(root, "run/assert-and-right.exitcode")) catch {}
    var count: i64 = 0
    let failures = goldenFailures(root, for: "run", to: ref count)
    deleteWorkDir(root)
    assert(failures.length == 2)
    assert(failures[0].contains(Path.combine(Path.combine(root, "run"), "assert-and-right.exitcode"))
        && failures[0].contains("missing expected file"))
    assert(failures[1].startsWith($"{stdout}\n")
        && failures[1].contains($"expected line 2: changed line\nactual line 2: {was}"))
}

test "a changed new, emit or quality expected line fails naming the file and the first differing line" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-files-fail")
    deleteWorkDir(root)
    goldenCopy(root, for: "new/lib.tree")
    goldenCopy(root, for: "quality/mutation-report.json")
    // emit over four copied run cases, expecting their lines of the frozen run-c.sha256; switch-move-guard's `// mode: debug` changes
    // its C, so a mode not read fails here
    let stems = ["arithmetic", "assert-fails.test", "overflow-fast", "switch-move-guard"]
    for stem in stems {
        goldenRunCopy(root, for: stem)
    }
    var lines = ""
    for line in goldenLines(Io.readText(Path.fullPath("tests/cases/emit/run-c.sha256")) catch "") {
        for stem in stems {
            if line.endsWith($"  run/{stem}.byn") {
                lines = $"{lines}{line}\n"
            }
        }
    }
    goldenWrite(root, for: "emit/run-c.sha256", as: lines)
    var count: i64 = 0
    assert(goldenFailures(root, for: "emit", to: ref count).length == 0)
    var wants = List<string>()
    for rel in ["new/lib.tree", "emit/run-c.sha256", "quality/mutation-report.json"] {
        let path = Path.combine(root, rel)
        let text = Io.readText(path) catch ""
        wants.append(goldenLines(text)[1])
        goldenWrite(root, for: rel, as: goldenChangeLine(text, at: 1))
    }
    var failures = List<string>()
    for kind in ["new", "emit", "quality"] {
        for f in goldenFailures(root, for: kind, to: ref count) {
            failures.append(f)
        }
    }
    deleteWorkDir(root)
    assert(failures.length == 3)
    let paths = [
        Path.combine(Path.combine(root, "new"), "lib.tree"),
        Path.combine(Path.combine(root, "emit"), "run-c.sha256"),
        Path.combine(Path.combine(root, "quality"), "mutation-report.json"),
    ]
    for i in 0..3 {
        assert(failures[i].startsWith($"{paths[i]}\n"))
        assert(failures[i].contains($"expected line 2: changed line\nactual line 2: {wants[i]}"))
    }
}

test "a run case is built in its // mode:, the C of its build arguments matching its frozen emit digest" {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    assert(failure == "")
    let root = Path.combine(Path.fullPath("tmp"), "golden-mode")
    deleteWorkDir(root)
    // switch-move-guard is `// mode: debug`, whose C differs from the default safe mode's
    goldenRunCopy(root, for: "switch-move-guard")
    let input = Path.combine(root, "run/switch-move-guard.byn")
    var args = goldenBuildArgs(input, as: Path.combine(root, "program"), from: input)
    args.append("--emit-c")
    let o = goldenChild(
        exe,
        by: in args,
        at: Path.fullPath("."),
        from: in List<u8>(),
        through: ref failure,
    )
    deleteWorkDir(root)
    assert(failure == "" && o.exitCode == 0)
    let frozen = Io.readText(Path.fullPath("tests/cases/emit/run-c.sha256")) catch ""
    assert(frozen.contains($"{t9Hash(o.stdout)}  run/switch-move-guard.byn\n"))
}

// `@cases` rows (spec 019 T7, R7): each case of a test is one reported test that `--only` can select by its title; a non-constant value is
// BYN2774. The expected text is the frozen `run/test-cases.test` and `diag/cases-not-constant` files.

/// `bayan test -v` through `$BAYAN_EXE` of `dir` with `extra` after it: its exit code and stdout with the seconds masked.
GoldenOutcome goldenRowsRun(string dir, by in List<string> extra) uses alloc, clock, env, fs, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    for a in ["test", "-v", dir] {
        args.append(a)
    }
    for a in extra {
        args.append(a)
    }
    var o = goldenChild(exe, by: in args, at: Path.fullPath("."), from: in List<u8>(), through: ref failure)
    o.stdout = goldenTestSeconds(goldenLf(o.stdout))
    return o
}

/// The result lines of a `bayan test -v` report: each passed (`◆`) or failed (`✗`) test, one line.
List<string> goldenRowLines(string stdout) uses alloc {
    var rows = List<string>()
    for line in goldenLines(stdout) {
        if line.startsWith("  ◆ ") || line.startsWith("  ✗ ") {
            rows.append(line)
        }
    }
    return rows
}

/// A copy of the `run` case test-cases.test in `root`/run_test-cases.test, the work directory name the runner gives it, so that its
/// report names the module as the frozen `.stdout` does; returns that directory.
string goldenRowsFixture(string root) uses alloc, fs {
    deleteWorkDir(root)
    let dir = Path.combine(root, "run_test-cases.test")
    goldenWrite(
        dir,
        for: "test-cases.test.byn",
        as: Io.readText(Path.fullPath("tests/cases/run/test-cases.test.byn")) catch "",
    )
    return dir
}

test "@cases reports one result per row, each failing row on its own, and exits with the test-failure code" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cases-rows")
    let dir = goldenRowsFixture(root)
    let o = goldenRowsRun(dir, by: in List<string>())
    deleteWorkDir(root)
    let stdout = goldenLf(Io.readText(Path.fullPath("tests/cases/run/test-cases.test.stdout")) catch "")
    let code = Io.readText(Path.fullPath("tests/cases/run/test-cases.test.exitcode")) catch ""
    assert(o.stdout == stdout)
    assert(o.exitCode == exitTestFailure && $"{o.exitCode}\n" == code)
    // 4 + 3 + 2 rows and one plain test, every result line different
    let rows = goldenRowLines(o.stdout)
    assert(rows.length == 10 && o.stdout.contains("running 10 tests in 1 module"))
    for i in 0..rows.length {
        for j in (i + 1)..rows.length {
            assert(rows[i] != rows[j])
        }
    }
    // a failing row is its own result: another row of the same test passed
    var failed: i64 = 0
    for row in rows {
        continue unless row.startsWith("  ✗ ")
        failed += 1
        var name = ""
        for part in row["  ✗ ".length..row.length].parts(by: " (") {
            name = $"{part}"
            break
        }
        var passedRow = false
        for other in rows {
            passedRow = passedRow || other.startsWith($"  ◆ {name} (")
        }
        assert(passedRow)
    }
    assert(failed == 2)
}

test "--only with one row's title runs that row alone, passing or failing" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cases-only")
    let dir = goldenRowsFixture(root)
    let all = goldenRowLines(goldenRowsRun(dir, by: in List<string>()).stdout)
    var passing = ""
    var failing = ""
    for row in all {
        if passing == "" && row.startsWith("  ◆ ") {
            passing = row
        }
        if failing == "" && row.startsWith("  ✗ ") {
            failing = row
        }
    }
    let prefix = "  ◆ run_test-cases.test: "
    var one = List<string>()
    one.append($"{passing[prefix.length..passing.length]}")
    let p = goldenRowsRun(dir, by: in ["--only", one[0]])
    var two = List<string>()
    two.append($"{failing[prefix.length..failing.length]}")
    let f = goldenRowsRun(dir, by: in ["--only", two[0]])
    deleteWorkDir(root)
    assert(all.length == 10 && passing.startsWith(prefix) && failing.startsWith("  ✗ run_test-cases.test: "))
    assert(p.exitCode == exitOk
        && p.stdout.contains("running 1 test in 1 module")
        && p.stdout.contains("◆ 1 passed · Ts"))
    let pRows = goldenRowLines(p.stdout)
    assert(pRows.length == 1 && pRows[0] == passing)
    assert(f.exitCode == exitTestFailure && f.stdout.contains("running 1 test in 1 module")
        && f.stdout.contains("◆ 0 passed · ✗ 1 failed"))
    let fRows = goldenRowLines(f.stdout)
    assert(fRows.length == 1 && fRows[0] == failing)
}

test "a non-constant @cases value is BYN2774 under check, as the frozen diag case says" {
    let root = Path.combine(Path.fullPath("tmp"), "golden-cases-constant")
    deleteWorkDir(root)
    goldenCopy(root, for: "diag/cases-not-constant.byn")
    let input = Path.combine(Path.combine(root, "diag"), "cases-not-constant.byn")
    var failure = ""
    let exe = goldenExe(through: ref failure)
    var args = List<string>()
    args.append("check")
    args.append(input)
    let o = goldenChild(exe, by: in args, at: Path.fullPath("."), from: in List<u8>(), through: ref failure)
    deleteWorkDir(root)
    // the diag file is the report without each `  --> <input>:<line>:<column>` line and without the closing summary
    var sb = StrBuf()
    var located: i64 = 0
    for line in goldenLines(goldenLf(o.stderr)) {
        if line.startsWith($"  --> {input}:") {
            located += 1
            continue
        }
        break if line.startsWith("✗ build failed: ")
        sb.append($"{line}\n")
    }
    let diag = goldenLf(Io.readText(Path.fullPath("tests/cases/diag/cases-not-constant.diag")) catch "")
    assert(failure == "" && o.exitCode == exitFailure)
    assert(sb.finish() == $"{diag}\n" && located == 4)
}

// L041: job count does not change the result
test "L041: --jobs N and --jobs M print the same masked report over 30 generated cases directories" {
    let ns = goldenLines("1\n2\n1\n3")
    let ms = goldenLines("4\n16\n2\n8")
    var mismatch = ""
    var passed = false
    var failed = false
    var missing = false
    for seed in 0..30 {
        var state: u64 = 0x9E3779B97F4A7C15 ^ (u64(seed + 1) *% 0xD1B54A32D192ED03)
        let root = Path.combine(Path.fullPath("tmp"), $"golden-l041-{seed}")
        // one to three `lex` and one to three `parse` cases, each passing (its expected file copied), failing (one expected line changed) or
        // with no expected file
        deleteWorkDir(root)
        for kind in ["lex", "parse"] {
            let stems = goldenLines(
                kind == "lex"
                    ? "bad-chars\nchars\ncomments\nfloats\nidentifiers\nintegers\nkeywords\noperators\nstrings\nunexpected"
                    : "except-wasl\nhello\nexcept-expr\ncatch-block\nparticles\ncatch-switch\nerror-payload",
            )
            let ending = kind == "lex" ? ".tokens" : ".ast"
            state ^= state << 13
            state ^= state >> 7
            state ^= state << 17
            let count = 1 + i64(state % 3)
            for k in 0..count {
                state ^= state << 13
                state ^= state >> 7
                state ^= state << 17
                let stem = stems[i64((state >> 4) % u64(stems.length))]
                let mode = (state >> 20) % 3
                goldenCopy(root, for: $"{kind}/{stem}.byn")
                let expected = Io.readText(Path.fullPath($"tests/cases/{kind}/{stem}{ending}")) catch ""
                if mode == 0 {
                    goldenWrite(root, for: $"{kind}/{stem}{ending}", as: expected)
                } else if mode == 1 {
                    let at = i64((state >> 32) % u64(goldenLines(expected).length))
                    goldenWrite(root, for: $"{kind}/{stem}{ending}", as: goldenChangeLine(expected, at: at))
                }
            }
        }
        for j in 0..ns.length {
            let n = goldenJobsRun(root, as: ns[j])
            let m = goldenJobsRun(root, as: ms[j])
            assert(!n.stdout.contains("timed out") && !m.stdout.contains("timed out"))
            passed = passed || n.stdout.contains("\npassed ")
            failed = failed || n.stdout.contains("expected line ")
            missing = missing || n.stdout.contains("missing expected file")
            continue if n.stdout == m.stdout
            let a = goldenLines(n.stdout)
            let b = goldenLines(m.stdout)
            var i: i64 = 0
            while i < a.length && i < b.length && a[i] == b[i] {
                i += 1
            }
            let left = i < a.length ? a[i] : "<end>"
            let right = i < b.length ? b[i] : "<end>"
            mismatch = $"L041 counterexample: seed {seed} ({root}), --jobs {ns[j]} vs --jobs {ms[j]}, line {i + 1}: {left} | {right}"
            break
        }
        if mismatch != "" {
            print(mismatch)
            break
        }
        deleteWorkDir(root)
    }
    assert(mismatch == "")
    assert(passed && failed && missing)
}
