/// The names in `dir` that are files, not directories (`Directory.GetFiles`).
List<string> boundFiles(string dir) uses alloc, fs {
    var files = List<string>()
    for name in Io.listDir(dir) catch List<string>() {
        files.append(name) unless boundIsDir(Path.combine(dir, name))
    }
    return files
}

test "bound: a build tags the cache data it owns as a cache directory" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("cachedir-tag")
    boundArithmetic(root)
    goldenWrite(root, for: "sh/script.byn", as: "#!/usr/bin/env bayan\nprint(\"hi\")\n")
    let cache = Path.combine(root, "cache")
    let v1 = Path.combine(cache, "v1")
    let tag = Path.combine(v1, "CACHEDIR.TAG")
    let none = List<string>()
    let built = boundStart(boundList([exe, "build", "arithmetic.byn"]), at: root, as: none)
    print(built.stderr)
    assert(built.exit == 0)
    assert((Io.readText(tag) catch "").startsWith("Signature: 8a477f597d28d172789f06886806bc55\n"))
    assert(boundFiles(cache).length == 0)
    let remembered = boundStart(boundList([exe, "run", "sh/script.byn"]), at: root, as: none)
    print(remembered.stderr)
    assert(remembered.exit == 0)
    assert(boundFiles(cache).length == 0)
    assert(boundFiles(v1).length == 1)
    Io.remove(tag) catch { panic($"cannot remove {tag}") }
    let again = boundStart(boundList([exe, "build", "--verbose", "arithmetic.byn"]), at: root, as: none)
    assert($"{again.stdout}{again.stderr}".contains("from cache"))
    assert(Fs.fileExists(tag))
    Io.remove(tag) catch { panic($"cannot remove {tag}") }
    // A build hit writes the tag too; only a lookup hit leaves the script pointer alone (a miss remembers it again).
    let pointers = boundFiles(Path.combine(v1, "scripts"))
    assert(pointers.length == 1)
    let pointer = Path.combine(Path.combine(v1, "scripts"), pointers[0])
    let old = Time.fromNanos(1577836800 * 1000000000)
    Fs.setModified(pointer, to: old) catch { panic($"cannot age {pointer}") }
    assert(boundStart(boundList([exe, "run", "sh/script.byn"]), at: root, as: none).exit == 0)
    let kept = (Fs.modified(pointer) catch Time.now()).nanos
    let tagged = Fs.fileExists(tag)
    deleteWorkDir(root)
    assert(kept == old.nanos)
    assert(tagged)
}

test "run: a script that imports a module of its own runs the edited module and is not remembered" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("script-imports")
    goldenWrite(root, for: "tool.byn", as: "#!/usr/bin/env bayan\nimport helper\nprint(helper.h())\n")
    goldenWrite(root, for: "helper/h.byn", as: "public string h() {\n    return \"v1\"\n}\n")
    let none = List<string>()
    let first = boundStart(boundList([exe, "run", "tool.byn"]), at: root, as: none)
    print(first.stderr)
    goldenWrite(root, for: "helper/h.byn", as: "public string h() {\n    return \"v2\"\n}\n")
    let second = boundStart(boundList([exe, "run", "tool.byn"]), at: root, as: none)
    print(second.stderr)
    let pointers = boundFiles(Path.combine(Path.combine(Path.combine(root, "cache"), "v1"), "scripts"))
    deleteWorkDir(root)
    assert(first.exit == 0)
    assert(first.stdout == "v1\n")
    assert(second.exit == 0)
    assert(second.stdout == "v2\n")
    assert(pointers.length == 0)
}

test "run: a file whose helper lives in a sibling file runs the edited sibling and is not remembered" {
