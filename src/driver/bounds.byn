// The memory and disk bounds of CliMemoryBoundsTests as SelfhostDefaultBoundsTests ran them through the driver (spec 019 T28, R9, R15), with
// the C# bounds. Each block runs `$BAYAN_EXE` in its own tree under tmp/selfhost-bounds/ with `BAYAN_CACHE` there and `BAYAN_CC` unset
// (`SelfhostDefaultBoundsTests.Start`); a peak resident set is sampled by scripts/release/peak-rss.sh as `PeakSampler` sampled it. The C#
// rows also compared each argv with the C# `bayan`; with no .NET only the driver's side and its bound remain. The release memory gate runs
// every block whose title starts `bound: ` (docs/memory-leaks.md, *Release gate*). Blocks need `sh` and `ps`, so they are pending on Windows.
// The M5 evict rows delegated to SelfhostDefaultT9Tests are the `bound: evict …` blocks (T28 part 2); the M4 row delegated to the cli case
// cli/SelfhostDefaultT12Tests/TheInputsHashDoesNotFollowLinks, which the gate runs. Not here: the rows
// SelfhostDefaultBoundsTests listed as skips (the M1 stream rows, Q1226; M2 and the F2 mutate row, Q1220; M7, Q1149) and the BAYAN_CC_JOBS
// rows, which the driver does not read.

/// `SelfhostDefaultBoundsTests.Run` on the driver: exit code, stdout, stderr and the peak resident set in KB (0 when no sample was taken).
struct BoundRun {
    i32    exit   = -1
    string stdout = ""
    string stderr = ""
    i64    peakKb = 0
}

/// `xs` as a list.
List<string> boundList(ReadOnlySpan<string> xs) uses alloc {
    var list = List<string>()
    for x in xs {
        list.append(x)
    }
    return list
}

/// `SelfhostDefaultBoundsTests.Fresh`: tmp/selfhost-bounds/<name>, emptied and created.
string boundFresh(string name) uses alloc, fs {
    let dir = Path.combine(Path.combine(Path.fullPath("tmp"), "selfhost-bounds"), name)
    deleteWorkDir(dir)
    Io.createDirectory(dir) catch { panic($"cannot create {dir}") }
    return dir
}

/// `SelfhostDefaultBoundsTests.Start` on the driver: `cmd` (the driver and its arguments) in `dir` through
/// `env -u BAYAN_CC <env> BAYAN_CACHE=<dir>/cache` (`env` holds `-u NAME` items, then `NAME=value` ones), sampled by scripts/release/peak-rss.sh.
BoundRun boundStart(in List<string> cmd, at string dir, as in List<string> env) uses alloc, fs, process {
    let result = $"{dir}.peak"
    var all = boundList(["scripts/release/peak-rss.sh", result, dir, "env", "-u", "BAYAN_CC"])
    for e in env {
        all.append(e)
    }
    all.append($"BAYAN_CACHE={Path.combine(dir, "cache")}")
    for a in cmd {
        all.append(a)
    }
    let r = Io.run("sh", all.span) catch { panic($"cannot run sh scripts/release/peak-rss.sh in {dir}") }
    let line = (Io.readText(result) catch "").trimmed()
    Io.remove(result) catch {}
    var fields = List<string>()
    for f in line.parts(by: " ") {
        fields.append(f)
    }
    let peak = fields.length == 2 ? t9Digits(fields[1], until: 9223372036854775807) ?? 0 : 0
    return BoundRun { exit: r.exitCode, stdout: r.stdout, stderr: r.stderr, peakKb: peak }
}

/// `script` under `sh -c` with `$1` = `dir`: what C# did with `File.CreateSymbolicLink`, a fake compiler's mode and the like.
void boundSh(string script, at string dir) uses alloc, console, process {
    let r = Io.run("sh", boundList(["-c", script, "sh", dir]).span) catch { panic($"cannot run sh -c {script}") }
    print(r.stderr) if r.exitCode != 0
    assert(r.exitCode == 0)
}

/// Whether `path` is a directory that can be listed (`Directory.Exists`).
bool boundIsDir(string path) uses alloc, fs {
    let _ = Io.listDir(path) catch return false
    return true
}

/// `text` has a line `… <digits> bytes omitted …` (the regex `… \d+ bytes omitted …` of the M1 row).
bool boundOmitted(string text) uses alloc {
    let head = "… "
    let tail = " bytes omitted …"
    for raw in text.parts(by: "\n") {
        let line = raw.trimmed()
        let framed = line.startsWith(head) && line.endsWith(tail) && line.length > head.length + tail.length
        return true if framed
            && t9Digits(line[head.length..line.length - tail.length], until: 9223372036854775807) is { }
    }
    return false
}

/// `path` (a directory) and the time `minutes` ago as its last write time (`Directory.SetLastWriteTimeUtc(..., UtcNow.AddMinutes(-minutes))`).
void boundAged(string path, by i64 minutes) uses alloc, clock, fs {
    Io.createDirectory(path) catch { panic($"cannot create {path}") }
    Fs.setModified(
        path,
        to: Time.fromNanos(Time.now().nanos - minutes * 60 * 1000000000),
    ) catch { panic($"cannot age {path}") }
}

/// The driver `$BAYAN_EXE`; the block fails when it is not one.
string boundExe() uses alloc, console, env, process {
    var failure = ""
    let exe = goldenExe(through: ref failure)
    print(failure) if exe == ""
    assert(exe != "")
    return exe
}

/// tests/cases/run/arithmetic.byn copied into `root` (`SelfhostDefaultBoundsTests.Arithmetic`).
void boundArithmetic(string root) uses alloc, fs {
    let text = Io.readText(
        Path.fullPath("tests/cases/run/arithmetic.byn"),
    ) catch { panic("cannot read tests/cases/run/arithmetic.byn") }
    Io.writeFile(
        Path.combine(root, "arithmetic.byn"),
        text.bytes,
    ) catch { panic($"cannot write {root}/arithmetic.byn") }
}

// ── M1 ───────────────────────────────────────────────────────────────────────

test "bound: a test printing until killed stays under 300 MB and reports the elided bytes" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("spam-s2")
    // 1 KiB lines and a 6 s timeout, as the C# row: at 100-byte lines and 3 s a starved test binary printed less than the
    // 2 × 64 KiB kept, so nothing was omitted.
    var line = ""
    for i in 0..1024 {
        line = $"{line}x"
    }
    let spam = $"void main() {{\n}}\n\ntest \"spam\" {{\n    while true {{\n        print(\"{line}\")\n    }}\n}}\n"
    Io.writeFile(Path.combine(root, "main.byn"), spam.bytes) catch { panic("cannot write main.byn") }
    let run = boundStart(boundList([exe, "test", "main.byn"]), at: root, as: boundList(["BAYAN_TEST_TIMEOUT_MS=6000"]))
    deleteWorkDir(root)
    print($"peak {run.peakKb} KB, exit {run.exit}")
    assert(run.peakKb > 0)
    assert(run.peakKb < 300 * 1024)
    assert(run.exit == exitTestFailure)
    assert(boundOmitted(run.stdout))
}

