    print(first.stderr)
    goldenWrite(root, for: "util.byn", as: "string h() => \"v2\"\n")
    let second = boundStart(boundList([exe, "run", "tool.byn"]), at: root, as: none)
    print(second.stderr)
    let pointers = boundFiles(Path.combine(Path.combine(Path.combine(root, "cache"), "v1"), "scripts"))
    deleteWorkDir(root)
    assert(first.exit == 0)
    assert(first.stdout == "v1\n")
    assert(second.exit == 0)
    assert(second.stdout == "v2\n")
    assert(pointers.length == 0)
}

// ── M6, F13 ──────────────────────────────────────────────────────────────────

test "bound: a build sweeps stale temporary and staging directories" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    for timeout in ["", "7200"] {
        let root = boundFresh($"sweep-{timeout}")
        boundArithmetic(root)
        let temp = $"{root}-tmp"
        deleteWorkDir(temp)
        for name in ["bayan-coverage-old", "bayan-mutate-old", "bayan-asan-old"] {
            boundAged(Path.combine(temp, name), by: 120)
        }
        boundAged(Path.combine(temp, "bayan-coverage-new"), by: 0)
        let staging = Path.combine(root, "cache/v1/tmp")
        boundAged(Path.combine(staging, "key-old"), by: 180)
        boundAged(Path.combine(staging, "key-running"), by: 125)
        boundAged(Path.combine(staging, "key-new"), by: 0)
        var env = timeout == "" ? boundList(["-u", "BAYAN_CC_TIMEOUT_S"]) : boundList([$"BAYAN_CC_TIMEOUT_S={timeout}"])
        for name in ["TMPDIR", "TMP", "TEMP"] {
            env.append($"{name}={temp}")
        }
        let _ = boundStart(boundList([exe, "build", "arithmetic.byn"]), at: root, as: env)
        var swept = true
        for name in ["bayan-coverage-old", "bayan-mutate-old", "bayan-asan-old"] {
            swept = swept && !boundIsDir(Path.combine(temp, name))
        }
        let fresh = boundIsDir(Path.combine(temp, "bayan-coverage-new"))
        let running = boundIsDir(Path.combine(staging, "key-running"))
        let old = boundIsDir(Path.combine(staging, "key-old"))
        let young = boundIsDir(Path.combine(staging, "key-new"))
        deleteWorkDir(root)
        deleteWorkDir(temp)
        print(
            $"BAYAN_CC_TIMEOUT_S `{timeout}`: swept {swept}, fresh {fresh}, running {running}, old {old}, new {young}",
        )
        assert(swept && fresh)
        assert(running == (timeout == "7200"))
        assert(!old && young)
    }
}

/// `SelfhostDefaultT9Tests.ABuildSweepsStaleDirectories` (spec 019 T15g, T25): not exported, since its check needs file ages, empty seeded
/// directories and cache staging keys. Both theory rows: the seeded names left in `<root>-tmp` and the staging keys after one build. The
/// expected names are the C# test's literal (SelfhostDefaultT9Tests.cs:1281). Not a `bound: ` block: no resident set is compared.
test "sweep: a build leaves the fresh and the foreign seeded names in TMPDIR and sweeps stale staging keys" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let seeded = [
        "bayan-coverage-old/",
        "bayan-coverage-old/inside",
        "bayan-mutate-old/",
        "bayan-asan-old/",
        "bayan-coverage-new/",
        "other-old/",
        "bayan-coverage-file",
    ]
    for timeout in ["", "7200"] {
        let root = boundFresh($"t9-sweep-{timeout}")
        boundArithmetic(root)
        let temp = $"{root}-tmp"
        deleteWorkDir(temp)
        for name in ["bayan-coverage-old", "bayan-mutate-old", "bayan-asan-old", "other-old"] {
            boundAged(Path.combine(temp, name), by: 120)
        }
        boundAged(Path.combine(temp, "bayan-coverage-new"), by: 0)
        Io.writeFile(
            Path.combine(temp, "bayan-coverage-old/inside"),
            "".bytes,
        ) catch { panic($"cannot write {temp}/bayan-coverage-old/inside") }
        let file = Path.combine(temp, "bayan-coverage-file")
        Io.writeFile(file, "".bytes) catch { panic($"cannot write {file}") }
        Fs.setModified(
            file,
            to: Time.fromNanos(Time.now().nanos - 120 * 60 * 1000000000),
        ) catch { panic($"cannot age {file}") }
        // the C# seed ages the directories after creating `inside`, which touches its parent
        boundAged(Path.combine(temp, "bayan-coverage-old"), by: 120)
        let staging = Path.combine(root, "cache/v1/tmp")
        boundAged(Path.combine(staging, "key-old"), by: 180)
        boundAged(Path.combine(staging, "key-running"), by: 125)
        boundAged(Path.combine(staging, "key-new"), by: 0)
        var env = timeout == "" ? boundList(["-u", "BAYAN_CC_TIMEOUT_S"]) : boundList([$"BAYAN_CC_TIMEOUT_S={timeout}"])
        env.append($"TMPDIR={temp}")
        env.append($"TMP={temp}")
        let r = boundStart(boundList([exe, "build", "arithmetic.byn"]), at: root, as: env)
        var left = List<string>()
        for name in seeded {
            let path = Path.combine(temp, name.endsWith("/") ? name[0..name.length - 1] : name)
            left.append(name) if boundIsDir(path) || Fs.fileExists(path)
        }
        let running = boundIsDir(Path.combine(staging, "key-running"))
        let old = boundIsDir(Path.combine(staging, "key-old"))
        deleteWorkDir(root)
        deleteWorkDir(temp)
        let names = left.joined(by: "\n")
        print($"BAYAN_CC_TIMEOUT_S `{timeout}`: exit {r.exit}, left [{names}], running {running}, old {old}")
        assert(r.exit == 0)
        assert(names == "bayan-coverage-new/\nother-old/\nbayan-coverage-file")
        assert(running == (timeout == "7200"))
        assert(!old)
    }
}

// ── F2 ───────────────────────────────────────────────────────────────────────

/// `CliMemoryBoundsTests.RunWithSweptWorkDir`'s watcher: every `bayan-coverage-*` directory in `$T` is deleted as soon as it appears while
/// the arguments run.
const boundSweptScript: string = "( while :; do for d in \"$T\"/bayan-coverage-*; do [ -d \"$d\" ] && rm -rf \"$d\"; done; sleep 0.005; done ) & w=$!; \"$@\"; c=$?; kill $w; wait $w 2>/dev/null; exit $c"

test "bound: a coverage work directory another process swept does not change the exit code" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("swept-coverage-s2")
    goldenWrite(root, for: "main.byn", as: "void main() {\n}\n\ntest \"spin\" {\n    while true {\n    }\n}\n")
    let temp = Path.combine(root, "tmp")
    Io.createDirectory(temp) catch { panic($"cannot create {temp}") }
    let env = boundList([$"TMPDIR={temp}", $"T={temp}", "BAYAN_TEST_TIMEOUT_MS=2000"])
    let run = boundStart(
        boundList(["sh", "-c", boundSweptScript, "sh", exe, "test", "--coverage", "main.byn"]),
        at: root,
        as: env,
    )
    deleteWorkDir(root)
    print($"exit {run.exit}\n{run.stderr}")
    assert(run.exit == exitTestFailure)
}

// ── Q31 (plans 013, 014) ──────────────────────────────────────────────────────

// SelfhostDefaultBoundsTests `CheckPeakBoundMb`: plan 014's max RSS after both arenas plus about 80 MB, one per OS (macOS 480, Linux 560);
// Windows was never measured after plan 014 and keeps plan 013's 1,700 MB.
// macOS 520 (2026-11-20): the bound follows the size of src/driver, as the check reads the whole package. Plan 014's 396 MB was for
// selfhost/driver at 780,342 bytes of .byn; src/driver is now 1,745,700 bytes and peaked at 481 MB on the hosted macos-15 runner and
// 290-486 MB in five runs on macOS arm64, so the peak per source byte fell; 486 MB plus 5%, rounded up to the next 10 (docs/memory-leaks.md).
test "bound: check of the driver stays under its plan 014 bound" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let dir = boundFresh("check-driver")
    let bound: i64 = Target.os == "macos" ? 520 : Target.os == "linux" ? 560 : 1700
    let cmd = boundList([exe, "check", "--package", Path.fullPath("src"), Path.fullPath("src/driver")])
    let run = boundStart(cmd, at: dir, as: List<string>())
    deleteWorkDir(dir)
    print($"check of src/driver peaked at {run.peakKb / 1024} MB, bound {bound} MB\n{run.stderr}")
    assert(run.exit == 0)
    assert(run.peakKb > 0)
    assert(run.peakKb < bound * 1024)
}

/// SelfhostDefaultBoundsTests `BuildFreesTheFrontendBeforeTheCCompiler`'s fake `zig`: records its parent's (the driver's) resident set and fails.
const boundRssZig: string = "#!/bin/sh\nps -o rss= -p $PPID >> \"$Q31_RSS_LOG\"\nexit 1\n"

// measured on Linux (bayan-test01), the driver's resident set when the C compiler starts: 21 MB at `zig version`, 29 MB at the runtime
// object (2026-11-14); without the frontend arena the whole compile is still resident, 788/801 MB (SelfhostDefaultBoundsTests `BuildAtCcBoundMb`).
test "bound: build frees the frontend before the C compiler starts" {
    if Target.os != "linux" {
        todo("Linux only: macOS keeps freed memory charged to the process")
    }
    let exe = boundExe()
    let dir = boundFresh("build-at-cc")
    goldenWrite(dir, for: "bin/zig", as: boundRssZig)
    boundSh("chmod 700 \"$1/bin/zig\"", at: dir)
    let log = Path.combine(dir, "rss.log")
    let env = boundList([$"PATH={Path.combine(dir, "bin")}:/usr/bin:/bin", $"Q31_RSS_LOG={log}"])
    let cmd = boundList(
        [
            exe,
            "build",
            "--package",
            Path.fullPath("src"),
            "-o",
            Path.combine(dir, "bayan"),
            Path.fullPath("src/driver"),
        ],
    )
    let run = boundStart(cmd, at: dir, as: env)
    let text = Io.readText(log) catch ""
    deleteWorkDir(dir)
    var samples = List<i64>()
    for line in text.parts(by: "\n") {
        let kb = t9Digits(line.trimmed(), until: 9223372036854775807) ?? -1
        samples.append(kb / 1024) if kb >= 0
    }
    var peak: i64 = 0
    for mb in samples {
        peak = mb > peak ? mb : peak
    }
    print(
        $"the driver held {peak} MB at the most when the C compiler started ({samples.length} samples), bound 100 MB\n{run.stderr}",
    )
    assert(samples.length > 0)
    assert(peak < 100)
}

// measured after the arenas, 64 files of 4 MB: doctor 33 MB on macOS, 15 MB on Linux; before: 543 MB and 514 MB. bound = 3x the larger,
// rounded up (SelfhostDefaultBoundsTests `DoctorPeakBoundMb`).
test "bound: doctor of a 256 MB cache stays under 100 MB" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let dir = boundFresh("doctor-cache")
    let programs = Path.combine(dir, "cache/v1/programs/x")
    Io.createDirectory(programs) catch { panic($"cannot create {programs}") }
    boundSh(
        "i=0; while [ $i -lt 64 ]; do head -c 4194304 /dev/zero > \"$1/f$i\" || exit 1; i=$((i + 1)); done",
        at: programs,
    )
    let run = boundStart(boundList([exe, "doctor"]), at: dir, as: List<string>())
    deleteWorkDir(dir)
    print($"doctor peaked at {run.peakKb / 1024} MB, bound 100 MB\n{run.stdout}")
    assert(run.stdout.contains("256.0 MB"))
    assert(run.peakKb > 0)
    assert(run.peakKb < 100 * 1024)
}

/// A program that runs `Regex.findAll` with a 20,000-instruction pattern over 20,000 one-byte matches, then waits 200 ms
/// on `sleep` with the matches still live. Without the wait it ended on the macOS and Linux runners before the sampler's
/// first sample (peak 0, ci 45853205771).
const boundFindAll: string = "import std.regex\n\nvoid main() fails IoError {\n    let re = regex.Regex.parse(\"(a{1000}){20}|b\") catch panic(\"parse failed\")\n    let all = re.findAll(\"b\".repeated(20000))\n    let hold: string[2] = [\"-c\", \"sleep 0.2\"]\n    let _ = try Io.run(\"sh\", hold.span)\n    print($\"{all.length}\")\n}\n"

// measured: 3.3 GB on macOS when each search made and zeroed its own work space (O(matches x program)), 10 MB with one
// work space for all the searches of a findAll (2026-11-26); with the wait, sampled 11 MB on macOS and 20.9 MB on Linux
// (gcc:14 container, 2026-11-27). bound = 100 MB.
test "bound: Regex.findAll over many matches stays under 100 MB" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("regex-findall")
    goldenWrite(root, for: "findall.byn", as: boundFindAll)
    let program = Path.combine(root, "findall")
    let built = boundStart(boundList([exe, "build", "-o", program, "findall.byn"]), at: root, as: List<string>())
    print(built.stderr)
    assert(built.exit == 0)
    let run = boundStart(boundList([program]), at: root, as: List<string>())
    deleteWorkDir(root)
    print($"findAll peaked at {run.peakKb / 1024} MB, bound 100 MB\n{run.stderr}")
    assert(run.exit == 0)
    assert(run.stdout == "20000\n")
    assert(run.peakKb > 0)
    assert(run.peakKb < 100 * 1024)
}
