test "bound: format skips scratch directories and outward links" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("format")
    let unformatted = "let a = true\nunless !a { print(\"y\") }\n"
    for rel in ["fixture/.worktrees/x/a.byn", "fixture/tmp/b.byn", "fixture/src/ok.byn", "outside/c.byn"] {
        goldenWrite(root, for: rel, as: unformatted)
    }
    boundSh("ln -s \"$1/outside\" \"$1/fixture/link\" && ln -s \"$1/fixture/tmp\" \"$1/fixture/inner-link\"", at: root)
    let run = boundStart(boundList([exe, "format", "--check", "fixture"]), at: root, as: List<string>())
    deleteWorkDir(root)
    let output = $"{run.stdout}{run.stderr}"
    print(output)
    assert(run.exit == exitFailure)
    assert(output.contains("ok.byn") && output.endsWith("src/ok.byn\n"))
    assert(!output.contains("a.byn")
        && !output.contains("b.byn")
        && !output.contains("c.byn")
        && !output.contains("inner-link"))
}

test "bound: format and audit find files under nested build-named directories" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    var outputs = List<string>()
    for command in ["format", "audit"] {
        let root = boundFresh($"nested-bin-{command}")
        goldenWrite(
            root,
            for: "src/bin/x.byn",
            as: "unsafe void poke() {\n}\nlet a = true\nunless !a { print(\"y\") }\n",
        )
        let args = command == "format" ? boundList([exe, "format", "--check", "."]) : boundList([exe, "audit", "."])
        let run = boundStart(args, at: root, as: List<string>())
        deleteWorkDir(root)
        outputs.append(command == "format" ? $"{run.stdout}{run.stderr}" : run.stdout)
    }
    print($"{outputs[0]}{outputs[1]}")
    assert(outputs[0].contains("x.byn"))
    assert(outputs[1].contains("unsafe void poke()"))
}

// ── M5 ───────────────────────────────────────────────────────────────────────

test "bound: a build trims the cache to BAYAN_CACHE_MAX_MB" {
    if Target.os == "windows" {
        todo("`sh` and `ps` sample the resident set; Windows has neither")
    }
    let exe = boundExe()
    let root = boundFresh("evict-build")
    boundArithmetic(root)
    let programs = Path.combine(root, "cache/v1/programs")
    for i in 0..3 {
        let entry = Path.combine(programs, $"old{i}")
        Io.createDirectory(entry) catch { panic($"cannot create {entry}") }
        boundSh("head -c 600000 /dev/zero > \"$1/program\"", at: entry)
        boundAged(entry, by: (3 - i) * 60)
    }
    let run = boundStart(boundList([exe, "build", "arithmetic.byn"]), at: root, as: boundList(["BAYAN_CACHE_MAX_MB=1"]))
    let left = Io.listDir(programs) catch List<string>()
    deleteWorkDir(root)
    print($"exit {run.exit}, left: {t5Join(in left)}\n{run.stderr}")
    assert(run.exit == 0)
    // CliMemoryBoundsTests.cs:304 `Assert.Contains(build.Key!, left)`: the entry just built is the one directory that is not an old one.
    var built = 0
    for name in left {
        built += name.startsWith("old") ? 0 : 1
        assert(name != "old0" && name != "old1")
    }
    assert(built == 1)
}

/// The names under `dir`, each `prefix`/<name>, a directory with a trailing `/` and followed by its own (`SelfhostDefaultT9Tests.Names`).
void boundNames(string dir, as string prefix, to ref List<string> names) uses alloc, fs {
    for name in Io.listDir(dir) catch List<string>() {
        let path = Path.combine(dir, name)
        let rel = prefix == "" ? name : $"{prefix}/{name}"
        if boundIsDir(path) {
            names.append($"{rel}/")
            boundNames(path, as: rel, to: ref names)
        } else {
            names.append(rel)
        }
    }
}

/// tests/cases/bounds/evict/`name` (exported from the C# `Toolchain.Evict` by SelfhostDefaultT9Tests at dc7b22142, spec 019 T28; the
/// format is that test's `EvictCase` and `EvictStep`): the `.in` tree built under tmp/selfhost-bounds/, each `age` line setting an
/// entry's write time that many minutes back, each `evict <keep> <maxBytes> <maxEntries> <seconds>` line run through `t9Evict` on
/// its `cache/v1`, then the names left as one `== <step>` block. "" when the blocks are the `.expected`, else the case and both.
string boundEvictCase(string name) uses alloc, clock, console, env, fs, process, random {
    let stem = Path.fullPath($"tests/cases/bounds/evict/{name}")
    let input = Io.readText($"{stem}.in") catch { panic($"cannot read {stem}.in") }
    let expected = Io.readText($"{stem}.expected") catch { panic($"cannot read {stem}.expected") }
    let root = boundFresh($"evict-{name}")
    var lines = List<string>()
    for l in input.parts(by: "\n") {
        lines.append(l)
    }
    var d = newDCtx()
    var got = ""
    var step = 0
    var i = 0
    while i < lines.length {
        let line = lines[i]
        i += 1
        continue if line == ""
        var f = List<string>()
        for x in line.parts(by: " ") {
            f.append(x)
        }
        let path = Path.combine(root, f[1])
        if f[0] == "dir" {
            Io.createDirectory(path) catch { panic($"cannot create {path}") }
        } else if f[0] == "file" {
            Io.writeFile(path, lines[i].bytes) catch { panic($"cannot write {path}") }
            i += 1
        } else if f[0] == "file64" {
            boundSh($"printf %s '{lines[i]}' | base64 -d > \"$1\"", at: path)
            i += 1
        } else if f[0] == "age" {
            let minutes = t9Digits(f[2], until: 9223372036854775807) ?? 0
            Fs.setModified(
                path,
                to: Time.fromNanos(Time.now().nanos - minutes * 60 * 1000000000),
            ) catch { panic($"cannot age {path}") }
        } else if f[0] == "evict" {
            step += 1
            t9Evict(
                f[1],
                to: t9Digits(f[2], until: 9223372036854775807) ?? 0,
                by: t9Digits(f[3], until: 9223372036854775807) ?? 0,
                until: (t9Digits(f[4], until: 9223372036854775807) ?? 0) * 1000000000,
                at: Path.combine(root, "cache/v1"),
                through: ref d,
            ) catch {}
            var names = List<string>()
            boundNames(root, as: "", to: ref names)
            names.sort()
            got = $"{got}== {step}\n"
            for n in names {
                got = $"{got}{n}\n"
            }
        }
    }
    deleteWorkDir(root)
    return got == expected ? "" : $"evict case {name}: expected\n{expected}got\n{got}"
}

