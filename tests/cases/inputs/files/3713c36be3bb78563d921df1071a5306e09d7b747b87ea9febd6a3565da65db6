Binder tcBinder(FuncId fn, by StructId owner) => Binder {
    file: 0,
    fn: fn,
    owner: owner,
    scopes: [],
    targets: [],
    lambdas: [],
    lambdaCount: [],
    seeds: [],
    pending: [],
    constraints: [],
    peers: [],
    nonNullLocals: [],
    stateFacts: [],
