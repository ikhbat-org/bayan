void resolveTypeArgs() {
    var c = tcSource()
    let s = newStruct(ref c, by: StructSymbol { name: "Holder", module: 0, file: 0, declIndex: 2, typeMap: ["T": prim(.i64)] })
    let f = newFunction(ref c, by: FunctionSymbol { name: "f", module: 0, kind: .method, typeMap: ["T": prim(.bool)] })
    var b = tcBinder(f, by: s)
    b.typeArgs = ["T": prim(.string)]
    print("== resolve type-args")
    switch c.files[0].unit.members[12] {
        case .functionDecl(let d):
            for i in 0..d.value.params.length {
                let t = resolveType(ref b, through: ref c, for: in d.value.params[i].type)
                print($"resolve {i} {typeDisplay(ref c, by: t)}")
            }
        default:
            break
    }
    tcDiags(in c, from: 0)
}
