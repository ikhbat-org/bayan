struct Point {
    i64 x
    i64 y
    i64 sum() => x + y
}

enum Color {
    red
    green
}

i64 colorCode(Color c) => c switch {
    .red => 1,
    .green => 2,
}

i64 apply(i64 n, by i64 -> i64 f) => f(n)

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 sumAll(List<i64> xs) {
    var sum: i64 = 0
    for x in xs { sum += x }
    var i = 0
    while i < xs.length { i += 1 }
    return sum + i
}

i64 orZero(i64? n) => n ?? 0

string greet(string name) uses alloc => $"hello {name}"

i64 stock(Map<string, i64> m) => m.length

const limit: i64 = 100

i64 widen(i32 n) => i64(n)

i64 twice(i64 n) => n * 2

test "twice doubles" {
    assert twice(2) == 4
}

void main() {
    var total: i64 = 0
    if total >= 0 {
        var unset1: i64
        total = unset1
        total += widen(i32(3))
        if total >= 0 {
            total += sumAll([1, 2, 3])
            if total >= 0 {
                print(greet($"{total}"))
                if total >= 0 {
                    total += orZero(null)
                    total += 1
                }
            }
        }
    }
    print($"{total}")
}
