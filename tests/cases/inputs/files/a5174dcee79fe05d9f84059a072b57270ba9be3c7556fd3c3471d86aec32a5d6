void main() {
    print("== direct")
    {
        var v = S00 { f0: -4, f1: 7 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -2, f1: 9 }
