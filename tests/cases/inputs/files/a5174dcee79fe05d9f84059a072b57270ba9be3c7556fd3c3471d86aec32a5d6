interface IGen1 {
    i64 m0
    string m1() uses alloc
    void m2(ref this, i64 by)
    string m3() uses alloc => $"m3 {m0} {m0}"
    string m4() uses alloc => $"m4 {m0} {m0}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f0 + 9
    string m1() => $"S10 {f0 * f1}"
    void m2(ref this, i64 by) {
        f0 += by * 2
    }
    // override
    string m3() => $"S10 m3 {1 * 1}"
    // override
    string m4() => $"S10 m4 {f1 - f0}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 3 * f1
    string m1() => $"S11 {9 + f1}"
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

void roS10(S10 v) {
    print($"m0 {v.m0}")
    print(v.m3())
    print(v.m1())
    print(v.m4())
}

void rwS10(ref S10 v) {
    print($"m0 {v.m0}")
    print(v.m3())
    v.m2(4)
    print(v.m1())
    print(v.m4())
    v.m2(5)
}

