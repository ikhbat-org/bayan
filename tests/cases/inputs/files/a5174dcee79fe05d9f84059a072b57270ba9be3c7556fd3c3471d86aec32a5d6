interface IGen0 {
    i64 m0(i64 x)
    string m1() uses alloc
    string m2() uses alloc
    i64 m3
    i64 m4(i64 x) => m0(x) + m3
    i64 m5(i64 x) => m0(x) + m3
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 - f1
    string m1() => $"S00 {f1 - 3}"
    string m2() => $"S00 {f0 - f1}"
    i64 m3 => f0 - f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 - x
    string m1() => $"S01 {3 + f0}"
    string m2() => $"S01 {7 - 4}"
    i64 m3 => f1 * f1
    // override
    i64 m4(i64 x) => f0 - x
}

void roS00(S00 v) {
    print($"m4 {v.m4(3)}")
    print(v.m1())
    print($"m3 {v.m3}")
    print($"m5 {v.m5(1)}")
    print($"m3 {v.m3}")
    print($"m5 {v.m5(7)}")
    print($"m4 {v.m4(1)}")
}

void rwS00(ref S00 v) {
    print($"m4 {v.m4(3)}")
    print(v.m1())
    print($"m3 {v.m3}")
    print($"m5 {v.m5(1)}")
    print($"m3 {v.m3}")
    print($"m5 {v.m5(7)}")
    print($"m4 {v.m4(1)}")
}

