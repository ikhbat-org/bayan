union error E {
    a
    b(i64 code)
    c(i64 code)
}

struct Point {
    i64 x
    i64 y

    i64 sum => x + y

    i64 scaled(i64 k) => x * k + y
}

T pick<T>(move T a) => a

i64 risky(i64 x) fails E {
    fail .b(code: x) if x > 10
    fail .c(code: 1) if x == 3
    unless x != 4 { fail .a }
    return x * 2
}

i64 chain(i64 x) fails E {
    let v = (try risky(x)) + 1
    return v - 1
}

i64 loops(i64 n) {
    var total: i64 = 0
    var i: i64 = 0
    while true {
        if i >= n { break }
        total += i
        total -= 1
        total *= 2
        total /= 2
        total %= 1000
        i += 1
    }
    var xs = [1, 2, 3]
    xs[0] = 7
    xs[^1] = 9
    do {
        total += 1
    } while false
    var flag = false
    flag = true
    if flag && true { total -= 1 }
    let small: i32 = -5
    let f: i64 -> i64 = a => a + 1
    return total + xs[0] + xs[^1] + i64(small) + f(1) + pick(1)
}

string escapes() => "a\rb\u{0C}c\u{08}d\u{01}e"

void main() {
    let p = Point { x: 1, y: 2 }
    let r = chain(2) catch 0
    let q = risky(20) catch 5
    print($"{p.sum} {p.scaled(3)} {r} {q} {loops(5)} {escapes()}")
}

test "loops count" {
    assert loops(3) > -100
}