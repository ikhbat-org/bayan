interface IGen0 {
    i64 m0
    i64 m1
    string m2() uses alloc
    void m3(ref this, i64 by)
    string m4() uses alloc => $"m4 {m0} {m1}"
    i64 m5(i64 x) => m1 + m1
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 - f0
    i64 m1 => 9 - f0
    string m2() => $"S00 {f1 - 2}"
    void m3(ref this, i64 by) {
        f0 += by * 1
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 6 * f0
    i64 m1 => f1 - 8
    string m2() => $"S01 {f1 * f1}"
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m4() => $"S01 m4 {f0 * f1}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 - f1
    i64 m1 => 2 - f0
    string m2() => $"S02 {4 * f0}"
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    i64 m5(i64 x) => x * f0
}

void roS00(S00 v) {
    print($"m1 {v.m1}")
    print(v.m4())
    print($"m1 {v.m1}")
    print(v.m2())
    print(v.m2())
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1}")
    print(v.m4())
    v.m3(1)
    print($"m1 {v.m1}")
    v.m3(8)
    print(v.m2())
    print(v.m2())
    v.m3(-1)
}

