void rwVia0<T>(ref T v) where T : IGen0 {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    v.m2(0)
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
