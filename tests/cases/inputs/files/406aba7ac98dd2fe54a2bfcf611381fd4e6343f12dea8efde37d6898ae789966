interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    void m2(ref this, i64 by)
    i64 m3
    string m4() uses alloc => $"m4 {m1(5)} {m1(5)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * f0
    i64 m1(i64 x) => f1 * f1
    void m2(ref this, i64 by) {
        f0 += by * 2
    }
    i64 m3 => 2 - f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 2 - f1
    i64 m1(i64 x) => 3 + 2
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m3 => f1 * 9
    // override
    string m4() => $"S01 m4 {f0 * f1}"
}

void roS00(S00 v) {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void rwS00(ref S00 v) {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    v.m2(0)
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void roS01(S01 v) {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void rwS01(ref S01 v) {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    v.m2(0)
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void roVia0<T>(T v) where T : IGen0 {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
