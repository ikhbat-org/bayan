void rwDyn0(dyn ref IGen0 v) {
    print($"m0 {v.m0}")
    print(v.m4())
    print($"m3 {v.m3}")
    v.m2(0)
    print($"m1 {v.m1(7)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 3, f1: 0 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -5 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 3, f1: 0 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -5 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 3, f1: 0 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -5 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
}
