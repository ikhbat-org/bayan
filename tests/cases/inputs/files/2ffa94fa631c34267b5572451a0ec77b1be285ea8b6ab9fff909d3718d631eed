interface IGen1 {
    i64 m0
    i64 m1(i64 x)
    i64 m2
    string m3() uses alloc
    i64 m4(i64 x) => m0 + m2
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 2 * f0
    i64 m1(i64 x) => f1 + f1
    i64 m2 => 9 - 4
    string m3() => $"S10 {4 + f0}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f1 - 5
    i64 m1(i64 x) => x * f0
    i64 m2 => f0 - 1
    string m3() => $"S11 {f0 - 8}"
}

void roS10(S10 v) {
    print($"m1 {v.m1(5)}")
    print($"m2 {v.m2}")
    print($"m4 {v.m4(0)}")
    print($"m0 {v.m0}")
    print($"m2 {v.m2}")
    print($"m1 {v.m1(5)}")
    print($"m4 {v.m4(6)}")
}

