interface IGen1 {
    i64 m0
    string m1() uses alloc
    i64 m2(i64 x)
    void m3(ref this, i64 by)
    i64 m4(i64 x) => m2(x) + m2(5)
    i64 m5(i64 x) => m2(x) + m0
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 5 - 4
    string m1() => $"S10 {f0 + 9}"
    i64 m2(i64 x) => f1 - 4
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f1 * f1
    string m1() => $"S11 {4 * f0}"
    i64 m2(i64 x) => x * 2
    void m3(ref this, i64 by) {
        f0 += by * 1
    }
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 7 + f1
    string m1() => $"S12 {f0 * 5}"
    i64 m2(i64 x) => x * 4
    void m3(ref this, i64 by) {
        f0 += by * 3
    }
}

void roS10(S10 v) {
    print(v.m1())
    print($"m2 {v.m2(-1)}")
    print($"m2 {v.m2(6)}")
    print($"m4 {v.m4(3)}")
}

void rwS10(ref S10 v) {
    print(v.m1())
    print($"m2 {v.m2(-1)}")
    print($"m2 {v.m2(6)}")
    print($"m4 {v.m4(3)}")
