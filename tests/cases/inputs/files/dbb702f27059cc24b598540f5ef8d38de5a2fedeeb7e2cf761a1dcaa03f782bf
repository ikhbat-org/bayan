interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    i64 m2
    i64 m3(i64 x) => m2 + m0(0)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 3 - f0
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m2 => 3 + f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - f1
    void m1(ref this, i64 by) {
        f0 += by * 2
    }
    i64 m2 => 8 + f1
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + f0
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2 => 4 - 8
}

