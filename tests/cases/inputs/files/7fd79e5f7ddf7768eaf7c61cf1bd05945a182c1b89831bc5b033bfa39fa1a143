i64 call0(i64 a0, by (i64 -> i64) f) => f(a0)

i64 relay0(i64 a0, by (i64 -> i64) f) => call0(a0, by: f)

void host0Direct(string q0, to string q1) {
    let k0: i64 = 3
    let p0: i64 = 20
    let r: i64 = p0 * k0 - p0
    print($"c0 {r}")
}

void host0Local(string q0, to string q1) {
    let k0: i64 = 3
    let f: i64 -> i64 = p0 => p0 * k0 - p0
    let r: i64 = f(20)
    print($"c0 {r}")
}

void host0Via1(string q0, to string q1) {
    let k0: i64 = 3
    let r: i64 = call0(20, by: it * k0 - it)
    print($"c0 {r}")
}

void host0Via2(string q0, to string q1) {
    let k0: i64 = 3
    let r: i64 = relay0(20, by: it * k0 - it)
    print($"c0 {r}")
}

bool call1(by (() -> bool) f) => f()

bool relay1(by (() -> bool) f) => call1(by: f)

void host1Direct() {
    let r: bool = 0 < 7
    print($"c1 {r}")
}

void host1Local() {
    let f: () -> bool = () => 0 < 7
    let r: bool = f()
    print($"c1 {r}")
}

void host1Via1() {
    let r: bool = call1(by: () => 0 < 7)
    print($"c1 {r}")
}

void host1Via2() {
    let r: bool = relay1(by: () => 0 < 7)
    print($"c1 {r}")
}

bool fn2(i64 p0, to string p1) => 4 < p0 && p1 == "bayan"

bool call2(i64 a0, to string a1, by ((i64, string) -> bool) f) => f(a0, a1)

bool relay2(i64 a0, to string a1, by ((i64, string) -> bool) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let r: bool = fn2(-6, to: "bayan")
    print($"c2 {r}")
}

void host2Local() {
    let f: (i64, string) -> bool = fn2
    let r: bool = f(-6, "bayan")
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(-6, to: "bayan", by: fn2)
    print($"c2 {r}")
}

void host2Via2() {
    let r: bool = relay2(-6, to: "bayan", by: fn2)
    print($"c2 {r}")
}

