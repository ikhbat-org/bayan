enum Color {
    red
    green
}

i64 colorCode(Color c) => c switch {
    .red => 1,
    .green => 2,
}

interface IArea {
    i64 area()
}

struct Box : IArea {
    i64 w
    i64 h
    i64 area() => w * h
}

i64 biggerArea<T>(T a, to T b) where T : IArea => a.area() > b.area() ? a.area() : b.area()

i64 sumAll(List<i64> xs) {
    var sum: i64 = 0
    for x in xs { sum += x }
    var i = 0
    while i < xs.length { i += 1 }
    return sum + i
}

string greet(string name) uses alloc => $"hello {name}"

i64 stock(Map<string, i64> m) => m.length

i64 widen(i32 n) => i64(n)

(i64 lo, i64 hi) bounds(i64 n) => (lo: 0, hi: n)

i64 twice(i64 n) => n * 2

test "twice doubles" {
    assert twice(2) == 4
}

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += colorCode(Color.green)
        if total >= 0 {
            total += biggerArea(Box { w: 1, h: 2 }, to: Box { w: 3, h: total })
            if total >= 0 {
                total += sumAll([1, 2, 3])
                total += 1
            }
        }
    }
    print($"{total}")
}
