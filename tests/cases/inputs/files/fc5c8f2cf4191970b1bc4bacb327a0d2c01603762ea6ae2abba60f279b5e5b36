            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("@allow import x\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("@allow because \"\" import x\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("[Inline]\nimport x\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("f(i64 a, by i64 b) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f(i64 a, ref this) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f(this) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f(this, i64 a) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f(ref this is .open or .shut, i64 a) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f(i64 x is .small) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
