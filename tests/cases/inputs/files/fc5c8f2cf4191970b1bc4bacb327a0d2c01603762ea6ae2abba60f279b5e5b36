            let d = parseStruct(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.span, for: d.name, by: d.states.length)
        }
        {
            var p = makeParser("struct S {\n    states { a }\n    state b\n}\n", by: keywords)
            let d = parseStruct(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.span, for: d.name, by: d.states.length)
        }
        {
            var p = makeParser("struct S {", by: keywords)
            let d = parseStruct(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.span, for: d.name, by: d.states.length)
