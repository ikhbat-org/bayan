        {
            var p = makeParser("f(i64... xs) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f(rest i64 xs, i64 y) {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("f() fails uses alloc, net where T : I {}", by: keywords)
            let d = parseFunction(ref p, at: 0, by: modifierNone)
