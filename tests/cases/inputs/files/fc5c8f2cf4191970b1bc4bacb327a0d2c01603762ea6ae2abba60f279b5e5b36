import lexer

void summary(ref Parser p, at TextSpan span, for TextSpan name, by i64 count) {
    print($"{p.lexed.source.getText(name)} {span.start}+{span.length} {count}")
    for d in p.lexed.diagnostics {
        let fix = d.hasFix ? $" fix {d.fixSpan.start}+{d.fixSpan.length} [{d.fixReplacement}]" : ""
        print($"{d.code} {d.span.start}+{d.span.length} {d.message} | {d.label} | {d.help}{fix}")
    }
}

Parser makeParser(string text, by Keywords keywords) {
    var bytes = List<u8>()
    for b in text.bytes { bytes.append(b) }
    return Parser.create(lexer.lex(SourceText.create("t4.byn", from: move bytes), by: keywords))
}
void main() {
    let keywords = Keywords.build()
    using let arena = Arena()
    provide allocator: arena {
        {
            var p = makeParser("import a.b as c\nimport d\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("}\nimport a\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("public public import x\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("readonly static struct S {}\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("public\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
            var p = makeParser("delegate void Handler(i64 a, string b);\n", by: keywords)
            let d = parseCompilationUnit(ref p)
            summary(ref p, at: d.span, for: TextSpan { start: 0, length: 0 }, by: d.members.length)
        }
        {
