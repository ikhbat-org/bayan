            let d = parseFunction(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.name, for: d.name, by: d.params.length)
        }
        {
            var p = makeParser("struct unique S<T> : I, J where T : K {}", by: keywords)
            let d = parseStruct(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.span, for: d.name, by: d.states.length)
        }
        {
            var p = makeParser("struct S {\n    state open\n    state shut\n}\n", by: keywords)
            let d = parseStruct(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.span, for: d.name, by: d.states.length)
        }
        {
            var p = makeParser("struct S {\n    state open // why\n}\n", by: keywords)
            let d = parseStruct(ref p, at: 0, by: modifierNone)
            summary(ref p, at: d.span, for: d.name, by: d.states.length)
        }
