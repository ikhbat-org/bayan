interface IGen0 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    string m2() uses alloc
    void m3(ref this, i64 by)
    string m4() uses alloc => $"m4 {m0(4)} {m1(8)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 * 6
    i64 m1(i64 x) => 5 - f1
    string m2() => $"S00 {f1 + f1}"
    void m3(ref this, i64 by) {
        f0 += by * 1
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 * f0
    i64 m1(i64 x) => f1 - f1
    string m2() => $"S01 {f0 * 7}"
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

void roS00(S00 v) {
    print($"m1 {v.m1(9)}")
    print($"m1 {v.m1(1)}")
    print(v.m2())
    print(v.m2())
    print(v.m4())
    print($"m1 {v.m1(-3)}")
    print($"m0 {v.m0(2)}")
    print($"m1 {v.m1(3)}")
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1(9)}")
    print($"m1 {v.m1(1)}")
    print(v.m2())
    print(v.m2())
    print(v.m4())
    print($"m1 {v.m1(-3)}")
    print($"m0 {v.m0(2)}")
    print($"m1 {v.m1(3)}")
}

