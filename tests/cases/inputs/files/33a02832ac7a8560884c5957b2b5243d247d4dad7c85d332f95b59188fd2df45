void loops(i64 n) {
    var i = 0
    while i < n { i += 1 }
    do { i -= 1 } while i > 0
    while i < n {
        if i == 3 { break }
        if i == 4 { continue }
        i += 1
    }
    for k in 0..n { i = k }
    for k in 0..=n {
        if k == 2 { continue }
        i = k
    }
    for k in 0..n {
        for j in 0..k { i = j }
    }
}

