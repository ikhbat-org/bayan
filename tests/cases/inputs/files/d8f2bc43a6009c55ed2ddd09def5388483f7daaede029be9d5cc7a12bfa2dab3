interface ISink {
    void put(ref this, string v)
}

struct Box : ISink {
    string s

    void put(ref this, string v) {}
}

struct Boxes : IIndexable {
    type Item = Box
    i64 count => 1
    Box get(i64 index) => Box { s: "" }
}

string make(Arena a) => "x".copy(to: a)

string make3(i64 n, by Arena a) => make(a)

string both(bool f, by Arena a, at Arena b) => make(f ? a : b)

