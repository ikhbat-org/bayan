void main() {
    print("== direct")
    {
        var v = S00 { f0: 3, f1: 2 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 4, f1: 4 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S10 { f0: 6, f1: 8 }
        roS10(v)
        rwS10(ref v)
        print($"S10 {v.f0} {v.f1}")
    }
    {
        var v = S11 { f0: -1, f1: 5 }
        roS11(v)
        rwS11(ref v)
        print($"S11 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 3, f1: 2 }
