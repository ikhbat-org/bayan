interface IGen0 {
    i64 m0
    void m1(ref this, i64 by)
    i64 m2(i64 x) => m0 + m0
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 + f0
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    i64 m2(i64 x) => f0 + 8
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 4 + f1
    void m1(ref this, i64 by) {
        f0 += by * 3
    }
    // override
    i64 m2(i64 x) => f1 - f0
}

void roS00(S00 v) {
    print($"m2 {v.m2(1)}")
    print($"m2 {v.m2(6)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2(1)}")
    print($"m2 {v.m2(6)}")
    v.m1(0)
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void roS01(S01 v) {
    print($"m2 {v.m2(1)}")
    print($"m2 {v.m2(6)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void rwS01(ref S01 v) {
    print($"m2 {v.m2(1)}")
