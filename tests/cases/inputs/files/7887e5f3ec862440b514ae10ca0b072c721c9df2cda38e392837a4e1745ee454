interface IGen1 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    i64 m2(i64 x) => m0(x) + m0(6)
    i64 m3(i64 x) => m1(x) + m1(1)
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * x
    i64 m1(i64 x) => f0 - x
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - f0
    i64 m1(i64 x) => f1 * f1
    // override
    i64 m2(i64 x) => x + f1
}

void roS10(S10 v) {
    print($"m2 {v.m2(4)}")
    print($"m1 {v.m1(4)}")
    print($"m3 {v.m3(3)}")
    print($"m2 {v.m2(0)}")
}

