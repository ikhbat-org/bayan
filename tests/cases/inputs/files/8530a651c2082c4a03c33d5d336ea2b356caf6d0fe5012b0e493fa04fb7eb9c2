string call2(i64 a0, by (i64 -> string) f) => f(a0)

string relay2(i64 a0, by (i64 -> string) f) => call2(a0, by: f)

void host2Direct(i64 q0) {
    let k0: i64 = q0 + 9
    let p0: i64 = 11
    let r: string = $"{k0}-{p0}"
    print($"c2 {r}")
}

void host2Local(i64 q0) {
    let k0: i64 = q0 + 9
    let f: i64 -> string uses alloc = p0 => $"{k0}-{p0}"
    let r: string = f(11)
    print($"c2 {r}")
}

void host2Via1(i64 q0) {
    let k0: i64 = q0 + 9
    let r: string = call2(11, by: p0 => $"{k0}-{p0}")
    print($"c2 {r}")
