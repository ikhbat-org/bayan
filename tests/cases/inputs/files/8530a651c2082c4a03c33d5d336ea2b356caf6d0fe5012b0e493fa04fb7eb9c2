string call0(bool a0, to i64 a1, by ((bool, i64) -> string) f) => f(a0, a1)

string relay0(bool a0, to i64 a1, by ((bool, i64) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let p0: bool = false
    let r: string = $"{p0}-{p0}"
    print($"c0 {r}")
}

void host0Local() {
    let f: (bool, i64) -> string uses alloc = (p0, p1) => $"{p0}-{p0}"
    let r: string = f(false, 20)
    print($"c0 {r}")
}

void host0Via1() {
    let r: string = call0(a0: false, to: 20, by: (p0, p1) => $"{p0}-{p0}")
    print($"c0 {r}")
}

void host0Via2() {
    let r: string = relay0(a0: false, to: 20, by: (p0, p1) => $"{p0}-{p0}")
    print($"c0 {r}")
}

i64 call1(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => f(a0, a1)

i64 relay1(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => call1(a0, to: a1, by: f)

void host1Direct(string q0, to bool q1) {
    let k0: i64 = 14
    let p0: i64 = 8
    let r: i64 = k0 - p0
    print($"c1 {r}")
}

void host1Local(string q0, to bool q1) {
    let k0: i64 = 14
    let f: (i64, bool) -> i64 = (p0, p1) => {
        return k0 - p0
    }
    let r: i64 = f(8, false)
