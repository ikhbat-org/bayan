    i64 a
    i64 b
}

void typed(List<i32> xs, at ref u8[4] a, by ReadOnlySpan<i16> sp, through ref (i64 a, i64 b) t, to ref Q q, for ref List<i64> ys, as i32 n, from i64 m) {
