string call5(by (() -> string) f) => f()

string relay5(by (() -> string) f) => call5(by: f)

void host5Direct(bool q0, to bool q1) {
    let r: string = $"{q0}-{0}"
    print($"c5 {r}")
}

void host5Local(bool q0, to bool q1) {
    let f: () -> string uses alloc = () => $"{q0}-{0}"
    let r: string = f()
    print($"c5 {r}")
}

void host5Via1(bool q0, to bool q1) {
    let r: string = call5(by: () => $"{q0}-{0}")
    print($"c5 {r}")
}

void host5Via2(bool q0, to bool q1) {
    let r: string = relay5(by: () => $"{q0}-{0}")
