    print($"c2 {r}")
}

void host2Via1() {
    let r: i64 = call2(by: () => 9 - 2 + 1)
    print($"c2 {r}")
}

void host2Via2() {
    let r: i64 = relay2(by: () => 9 - 2 + 1)
    print($"c2 {r}")
}

string call3(bool a0, to string a1, by ((bool, string) -> string) f) => f(a0, a1)

string relay3(bool a0, to string a1, by ((bool, string) -> string) f) => call3(a0, to: a1, by: f)

void host3Direct() {
    let k1: string = ""
    let p1: string = "ab"
    let r: string = $"{p1}-{k1}"
    print($"c3 {r}")
}

void host3Local() {
    let k1: string = ""
    let f: (bool, string) -> string uses alloc = (p0, p1) => $"{p1}-{k1}"
    let r: string = f(false, "ab")
    print($"c3 {r}")
}

void host3Via1() {
    let k1: string = ""
    let r: string = call3(a0: false, to: "ab", by: (p0, p1) => $"{p1}-{k1}")
    print($"c3 {r}")
}

void host3Via2() {
    let k1: string = ""
    let r: string = relay3(a0: false, to: "ab", by: (p0, p1) => $"{p1}-{k1}")
    print($"c3 {r}")
}

