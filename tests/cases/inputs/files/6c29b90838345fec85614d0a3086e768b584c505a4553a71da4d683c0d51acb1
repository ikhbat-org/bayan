i64 call0(i64 a0, by (i64 -> i64) f) => f(a0)

i64 relay0(i64 a0, by (i64 -> i64) f) => call0(a0, by: f)

void host0Direct(i64 q0) {
    let p0: i64 = -5
    let r: i64 = q0 * p0
    print($"c0 {r}")
}

void host0Local(i64 q0) {
    let f: i64 -> i64 = p0 => {
        return q0 * p0
    }
    let r: i64 = f(-5)
    print($"c0 {r}")
}

void host0Via1(i64 q0) {
    let r: i64 = call0(-5, by: p0 => {
        return q0 * p0
    })
    print($"c0 {r}")
}

void host0Via2(i64 q0) {
    let f: i64 -> i64 = p0 => {
        return q0 * p0
    }
    let r: i64 = relay0(-5, by: f)
    print($"c0 {r}")
}

i64 call1(string a0, to i64 a1, by ((string, i64) -> i64) f) => f(a0, a1)

i64 relay1(string a0, to i64 a1, by ((string, i64) -> i64) f) => call1(a0, to: a1, by: f)

void host1Direct() {
    let p1: i64 = -7
    let r: i64 = p1 - 2
    print($"c1 {r}")
}

void host1Local() {
    let f: (string, i64) -> i64 = (p0, p1) => p1 - 2
    let r: i64 = f("bayan", -7)
    print($"c1 {r}")
}

void host1Via1() {
    let r: i64 = call1("bayan", to: -7, by: (p0, p1) => p1 - 2)
    print($"c1 {r}")
}

void host1Via2() {
    let r: i64 = relay1("bayan", to: -7, by: (p0, p1) => p1 - 2)
    print($"c1 {r}")
}

i64 call2(by (() -> i64) f) => f()

i64 relay2(by (() -> i64) f) => call2(by: f)

void host2Direct() {
    let r: i64 = 9 - 2 + 1
    print($"c2 {r}")
}

void host2Local() {
    let f: () -> i64 = () => 9 - 2 + 1
