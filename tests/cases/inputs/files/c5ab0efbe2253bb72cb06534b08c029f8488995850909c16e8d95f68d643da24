string call0(string a0, to bool a1, by ((string, bool) -> string) f) => f(a0, a1)

string relay0(string a0, to bool a1, by ((string, bool) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let k0: bool = false
    let p0: string = "x"
    let r: string = $"{p0}-{k0}"
    print($"c0 {r}")
}

void host0Local() {
    let k0: bool = false
    let f: (string, bool) -> string uses alloc = (p0, p1) => $"{p0}-{k0}"
    let r: string = f("x", true)
    print($"c0 {r}")
}

void host0Via1() {
    let k0: bool = false
    let r: string = call0("x", to: true, by: (p0, p1) => $"{p0}-{k0}")
    print($"c0 {r}")
}

void host0Via2() {
    let k0: bool = false
    let r: string = relay0("x", to: true, by: (p0, p1) => $"{p0}-{k0}")
    print($"c0 {r}")
}

string call1(i64 a0, to bool a1, by ((i64, bool) -> string) f) => f(a0, a1)

string relay1(i64 a0, to bool a1, by ((i64, bool) -> string) f) => call1(a0, to: a1, by: f)

void host1Direct(bool q0, to i64 q1) {
    let p1: bool = false
    let r: string = $"{p1}-{q0}"
    print($"c1 {r}")
}

void host1Local(bool q0, to i64 q1) {
    let f: (i64, bool) -> string uses alloc = (p0, p1) => {
        return $"{p1}-{q0}"
    }
    let r: string = f(13, false)
    print($"c1 {r}")
}

void host1Via1(bool q0, to i64 q1) {
    let r: string = call1(13, to: false, by: (p0, p1) => {
        return $"{p1}-{q0}"
    })
    print($"c1 {r}")
}

void host1Via2(bool q0, to i64 q1) {
    let r: string = relay1(13, to: false, by: (p0, p1) => {
        return $"{p1}-{q0}"
    })
    print($"c1 {r}")
}

i64 call2(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => f(a0, a1)

i64 relay2(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => call2(a0, to: a1, by: f)

void host2Direct(bool q0, to i64 q1) {
    let p0: i64 = 10
    let r: i64 = q1 + p0
    print($"c2 {r}")
}

void host2Local(bool q0, to i64 q1) {
    let f: (i64, bool) -> i64 = (p0, p1) => {
        return q1 + p0
    }
    let r: i64 = f(10, false)
    print($"c2 {r}")
}

void host2Via1(bool q0, to i64 q1) {
    let r: i64 = call2(10, to: false, by: (p0, p1) => {
        return q1 + p0
    })
    print($"c2 {r}")
}

void host2Via2(bool q0, to i64 q1) {
    let f: (i64, bool) -> i64 = (p0, p1) => {
        return q1 + p0
    }
    let r: i64 = relay2(10, to: false, by: f)
    print($"c2 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct(q0: false, to: -9)
    host2Direct(q0: false, to: 10)
    print("== local")
    host0Local()
    host1Local(q0: false, to: -9)
    host2Local(q0: false, to: 10)
    print("== via1")
    host0Via1()
    host1Via1(q0: false, to: -9)
    host2Via1(q0: false, to: 10)
    print("== via2")
    host0Via2()
    host1Via2(q0: false, to: -9)
    host2Via2(q0: false, to: 10)
}
