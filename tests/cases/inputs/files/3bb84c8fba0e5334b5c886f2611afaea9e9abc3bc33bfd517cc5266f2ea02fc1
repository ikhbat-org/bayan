    print($"c0 {r}")
}

void host0Via1() {
    let r: bool = call0("x", to: "x", by: fn0)
    print($"c0 {r}")
}

void host0Via2() {
    let r: bool = relay0("x", to: "x", by: fn0)
    print($"c0 {r}")
}

