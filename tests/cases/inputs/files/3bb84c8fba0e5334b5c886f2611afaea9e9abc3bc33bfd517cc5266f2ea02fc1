bool fn0(string p0, to string p1) => 5 > 7

bool call0(string a0, to string a1, by ((string, string) -> bool) f) => f(a0, a1)

bool relay0(string a0, to string a1, by ((string, string) -> bool) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let r: bool = fn0("x", to: "x")
    print($"c0 {r}")
}

void host0Local() {
    let f: (string, string) -> bool = fn0
