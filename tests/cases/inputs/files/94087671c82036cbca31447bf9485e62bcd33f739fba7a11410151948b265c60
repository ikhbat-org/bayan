bool fn0(i64 p0, to bool p1) {
    return p0 < 4 || p1
}

bool call0(i64 a0, to bool a1, by ((i64, bool) -> bool) f) => f(a0, a1)

bool relay0(i64 a0, to bool a1, by ((i64, bool) -> bool) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let r: bool = fn0(0, to: false)
    print($"c0 {r}")
}

void host0Local() {
    let f: (i64, bool) -> bool = fn0
    let r: bool = f(0, false)
    print($"c0 {r}")
}

void host0Via1() {
    let r: bool = call0(0, to: false, by: fn0)
    print($"c0 {r}")
}

void host0Via2() {
    let f: (i64, bool) -> bool = fn0
    let r: bool = relay0(0, to: false, by: f)
    print($"c0 {r}")
}

bool call1(i64 a0, to bool a1, by ((i64, bool) -> bool) f) => f(a0, a1)

bool relay1(i64 a0, to bool a1, by ((i64, bool) -> bool) f) => call1(a0, to: a1, by: f)

void host1Direct(i64 q0) {
    let p0: i64 = 15
    let r: bool = p0 > q0
    print($"c1 {r}")
}

void host1Local(i64 q0) {
    let f: (i64, bool) -> bool = (p0, p1) => p0 > q0
    let r: bool = f(15, false)
    print($"c1 {r}")
}

void host1Via1(i64 q0) {
    let r: bool = call1(15, to: false, by: (p0, p1) => p0 > q0)
    print($"c1 {r}")
}

void host1Via2(i64 q0) {
    let f: (i64, bool) -> bool = (p0, p1) => p0 > q0
    let r: bool = relay1(15, to: false, by: f)
    print($"c1 {r}")
}

bool call2(by (() -> bool) f) => f()

bool relay2(by (() -> bool) f) => call2(by: f)

void host2Direct() {
    let r: bool = 8 < 3
    print($"c2 {r}")
}

void host2Local() {
    let f: () -> bool = () => {
        return 8 < 3
    }
    let r: bool = f()
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(by: () => {
        return 8 < 3
    })
    print($"c2 {r}")
}

void host2Via2() {
    let r: bool = relay2(by: () => {
        return 8 < 3
    })
    print($"c2 {r}")
}

i64 call3(i64 a0, to i64 a1, by ((i64, i64) -> i64) f) => f(a0, a1)

i64 relay3(i64 a0, to i64 a1, by ((i64, i64) -> i64) f) => call3(a0, to: a1, by: f)

void host3Direct(bool q0, to string q1) {
    let k0: i64 = 5
    let r: i64 = 3 * k0
    print($"c3 {r}")
}

void host3Local(bool q0, to string q1) {
    let k0: i64 = 5
    let f: (i64, i64) -> i64 = (p0, p1) => 3 * k0
    let r: i64 = f(-5, 4)
    print($"c3 {r}")
}

void host3Via1(bool q0, to string q1) {
    let k0: i64 = 5
    let r: i64 = call3(-5, to: 4, by: (p0, p1) => 3 * k0)
    print($"c3 {r}")
}

void host3Via2(bool q0, to string q1) {
    let k0: i64 = 5
    let f: (i64, i64) -> i64 = (p0, p1) => 3 * k0
    let r: i64 = relay3(-5, to: 4, by: f)
    print($"c3 {r}")
}

i64 fn4(bool p0, to i64 p1) {
    return 7 + 0 + p1
}

i64 call4(bool a0, to i64 a1, by ((bool, i64) -> i64) f) => f(a0, a1)

i64 relay4(bool a0, to i64 a1, by ((bool, i64) -> i64) f) => call4(a0, to: a1, by: f)

void host4Direct() {
    let r: i64 = fn4(p0: true, to: 12)
    print($"c4 {r}")
}

void host4Local() {
    let f: (bool, i64) -> i64 = fn4
    let r: i64 = f(true, 12)
    print($"c4 {r}")
}

void host4Via1() {
    let r: i64 = call4(a0: true, to: 12, by: fn4)
    print($"c4 {r}")
}

void host4Via2() {
    let f: (bool, i64) -> i64 = fn4
    let r: i64 = relay4(a0: true, to: 12, by: f)
    print($"c4 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct(16)
    host2Direct()
    host3Direct(q0: false, to: "ab")
    host4Direct()
    print("== local")
    host0Local()
    host1Local(16)
    host2Local()
    host3Local(q0: false, to: "ab")
    host4Local()
    print("== via1")
    host0Via1()
    host1Via1(16)
    host2Via1()
    host3Via1(q0: false, to: "ab")
    host4Via1()
    print("== via2")
    host0Via2()
    host1Via2(16)
    host2Via2()
    host3Via2(q0: false, to: "ab")
    host4Via2()
}
