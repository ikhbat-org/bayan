i64 call0(bool a0, to string a1, by ((bool, string) -> i64) f) => f(a0, a1)

i64 relay0(bool a0, to string a1, by ((bool, string) -> i64) f) => call0(a0, to: a1, by: f)

void host0Direct(string q0) {
    let k0: i64 = 0
    let r: i64 = k0 + k0 + k0
    print($"c0 {r}")
}

void host0Local(string q0) {
    let k0: i64 = 0
    let f: (bool, string) -> i64 = (p0, p1) => {
        return k0 + k0 + k0
    }
    let r: i64 = f(false, "x")
    print($"c0 {r}")
}

void host0Via1(string q0) {
    let k0: i64 = 0
    let r: i64 = call0(a0: false, to: "x", by: (p0, p1) => {
        return k0 + k0 + k0
    })
    print($"c0 {r}")
}

void host0Via2(string q0) {
    let k0: i64 = 0
    let f: (bool, string) -> i64 = (p0, p1) => {
        return k0 + k0 + k0
    }
    let r: i64 = relay0(a0: false, to: "x", by: f)
    print($"c0 {r}")
}

bool call1(by (() -> bool) f) => f()

bool relay1(by (() -> bool) f) => call1(by: f)

void host1Direct() {
    let r: bool = 9 > 6 && 5 == 6
    print($"c1 {r}")
}

void host1Local() {
    let f: () -> bool = () => 9 > 6 && 5 == 6
    let r: bool = f()
    print($"c1 {r}")
}

void host1Via1() {
    let r: bool = call1(by: () => 9 > 6 && 5 == 6)
    print($"c1 {r}")
}

void host1Via2() {
    let f: () -> bool = () => 9 > 6 && 5 == 6
    let r: bool = relay1(by: f)
    print($"c1 {r}")
}

string call2(by (() -> string) f) => f()

string relay2(by (() -> string) f) => call2(by: f)

void host2Direct() {
    let k1: bool = true
    let r: string = $"{k1}-{9}"
    print($"c2 {r}")
}

void host2Local() {
    let k1: bool = true
    let f: () -> string uses alloc = () => $"{k1}-{9}"
    let r: string = f()
    print($"c2 {r}")
}

void host2Via1() {
    let k1: bool = true
    let r: string = call2(by: () => $"{k1}-{9}")
    print($"c2 {r}")
}

void host2Via2() {
    let k1: bool = true
    let r: string = relay2(by: () => $"{k1}-{9}")
    print($"c2 {r}")
}

i64 call3(bool a0, by (bool -> i64) f) => f(a0)

i64 relay3(bool a0, by (bool -> i64) f) => call3(a0, by: f)

void host3Direct() {
    let r: i64 = 9 * 5 + 7
    print($"c3 {r}")
}

void host3Local() {
    let f: bool -> i64 = p0 => 9 * 5 + 7
    let r: i64 = f(false)
    print($"c3 {r}")
}

void host3Via1() {
    let r: i64 = call3(a0: false, by: p0 => 9 * 5 + 7)
    print($"c3 {r}")
}

void host3Via2() {
    let f: bool -> i64 = p0 => 9 * 5 + 7
    let r: i64 = relay3(a0: false, by: f)
    print($"c3 {r}")
}

void main() {
    print("== direct")
    host0Direct("x")
    host1Direct()
    host2Direct()
    host3Direct()
    print("== local")
    host0Local("x")
    host1Local()
    host2Local()
    host3Local()
    print("== via1")
    host0Via1("x")
    host1Via1()
    host2Via1()
    host3Via1()
    print("== via2")
    host0Via2("x")
    host1Via2()
    host2Via2()
    host3Via2()
}
