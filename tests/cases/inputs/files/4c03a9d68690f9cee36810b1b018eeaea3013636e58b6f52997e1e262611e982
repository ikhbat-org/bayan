interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    i64 m2(i64 x) => m1(x) + m1(6)
    string m3() uses alloc => $"m3 {m1(3)} {m1(7)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 4 + f1
    i64 m1(i64 x) => 4 * f0
    // override
    i64 m2(i64 x) => f0 * f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + f1
    i64 m1(i64 x) => 9 * f1
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * f0
    i64 m1(i64 x) => f1 + 9
    // override
    i64 m2(i64 x) => 8 - f0
    // override
    string m3() => $"S02 m3 {f1 * f0}"
}

void roS00(S00 v) {
    print($"m1 {v.m1(8)}")
    print(v.m3())
    print($"m1 {v.m1(-3)}")
    print($"m2 {v.m2(-3)}")
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1(8)}")
    print(v.m3())
    print($"m1 {v.m1(-3)}")
    print($"m2 {v.m2(-3)}")
}

