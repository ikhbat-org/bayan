interface IGen1 {
    i64 m0(i64 x)
    string m1() uses alloc
    string m2() uses alloc => $"m2 {m0(9)} {m0(5)}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - x
    string m1() => $"S10 {5 * 8}"
    // override
    string m2() => $"S10 m2 {f1 + f1}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + f1
    string m1() => $"S11 {f0 + f0}"
    // override
    string m2() => $"S11 m2 {f0 * f1}"
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 - f1
    string m1() => $"S12 {1 - 9}"
}

