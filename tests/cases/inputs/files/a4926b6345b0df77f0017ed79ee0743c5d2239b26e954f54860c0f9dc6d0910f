interface IGen0 {
    i64 m0
    void m1(ref this, i64 by)
    void m2(ref this, i64 by)
    i64 m3
    i64 m4(i64 x) => m0 + m3
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * 7
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    void m2(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m3 => 1 - f0
    // override
    i64 m4(i64 x) => f0 * f0
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 1 - 2
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m3 => f1 - f0
    // override
    i64 m4(i64 x) => f0 + f0
}

void roS00(S00 v) {
    print($"m4 {v.m4(8)}")
    print($"m4 {v.m4(-3)}")
}

void rwS00(ref S00 v) {
    v.m2(3)
    print($"m4 {v.m4(8)}")
    v.m1(-1)
    v.m1(0)
    print($"m4 {v.m4(-3)}")
}

void roS01(S01 v) {
    print($"m4 {v.m4(8)}")
    print($"m4 {v.m4(-3)}")
}

void rwS01(ref S01 v) {
    v.m2(3)
    print($"m4 {v.m4(8)}")
    v.m1(-1)
    v.m1(0)
    print($"m4 {v.m4(-3)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print($"m4 {v.m4(8)}")
    print($"m4 {v.m4(-3)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    v.m2(3)
    print($"m4 {v.m4(8)}")
    v.m1(-1)
    v.m1(0)
    print($"m4 {v.m4(-3)}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m4 {v.m4(8)}")
    print($"m4 {v.m4(-3)}")
}

void rwDyn0(dyn ref IGen0 v) {
    v.m2(3)
    print($"m4 {v.m4(8)}")
    v.m1(-1)
    v.m1(0)
    print($"m4 {v.m4(-3)}")
}

interface IGen1 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    i64 m2(i64 x) => m1(x) + m0(5)
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 * x
    i64 m1(i64 x) => 6 * f1
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 6 - x
    i64 m1(i64 x) => f0 + f1
    // override
    i64 m2(i64 x) => x - 5
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 8 * 8
    i64 m1(i64 x) => f1 * 4
}

