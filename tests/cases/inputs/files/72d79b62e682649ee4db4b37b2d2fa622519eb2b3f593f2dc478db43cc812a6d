interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    void m2(ref this, i64 by)
    string m3() uses alloc
    i64 m4(i64 x) => m1(x) + m0
    string m5() uses alloc => $"m5 {m1(0)} {m1(9)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 5 * f0
    i64 m1(i64 x) => 3 - x
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    string m3() => $"S00 {2 + f0}"
    // override
    i64 m4(i64 x) => 7 * f0
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 * f0
    i64 m1(i64 x) => 4 + 4
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    string m3() => $"S01 {f0 - f1}"
    // override
    string m5() => $"S01 m5 {f1 + f0}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 * f0
    i64 m1(i64 x) => f1 * f0
    void m2(ref this, i64 by) {
        f0 += by * 3
    }
    string m3() => $"S02 {f0 - f1}"
    // override
    i64 m4(i64 x) => x + x
    // override
    string m5() => $"S02 m5 {f1 * f0}"
}

void roS00(S00 v) {
    print($"m1 {v.m1(3)}")
    print(v.m3())
    print(v.m5())
    print($"m4 {v.m4(2)}")
    print($"m1 {v.m1(-2)}")
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1(3)}")
    print(v.m3())
    print(v.m5())
    print($"m4 {v.m4(2)}")
    print($"m1 {v.m1(-2)}")
}

