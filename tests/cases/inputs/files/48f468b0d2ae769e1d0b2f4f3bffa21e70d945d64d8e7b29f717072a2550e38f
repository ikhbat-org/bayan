interface IGen1 {
    i64 m0
    string m1() uses alloc
    i64 m2(i64 x)
    i64 m3(i64 x) => m2(x) + m0
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f0 - f0
    string m1() => $"S10 {f1 + 7}"
    i64 m2(i64 x) => 6 * 4
    // override
    i64 m3(i64 x) => x * 2
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 4 - f1
    string m1() => $"S11 {f1 - 7}"
    i64 m2(i64 x) => 6 * f0
    // override
    i64 m3(i64 x) => 8 * f1
}

void roS10(S10 v) {
    print(v.m1())
    print($"m3 {v.m3(3)}")
    print($"m2 {v.m2(-3)}")
    print($"m2 {v.m2(-3)}")
    print($"m3 {v.m3(-3)}")
    print(v.m1())
    print(v.m1())
}

void rwS10(ref S10 v) {
    print(v.m1())
    print($"m3 {v.m3(3)}")
    print($"m2 {v.m2(-3)}")
    print($"m2 {v.m2(-3)}")
