interface IGen0 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    string m2() uses alloc
    i64 m3(i64 x) => m0(x) + m1(4)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 6 - f0
    i64 m1(i64 x) => 6 + x
    string m2() => $"S00 {f0 + f1}"
    // override
    i64 m3(i64 x) => f1 * f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x + f1
    i64 m1(i64 x) => 6 - f1
    string m2() => $"S01 {f1 * 2}"
    // override
    i64 m3(i64 x) => 6 - f1
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 5 - x
    i64 m1(i64 x) => f1 * f0
    string m2() => $"S02 {f1 - f0}"
}

void roS00(S00 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print($"m3 {v.m3(1)}")
    print(v.m2())
    print($"m1 {v.m1(8)}")
}

void rwS00(ref S00 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
