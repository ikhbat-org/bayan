interface IGen0 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    i64 m2(i64 x) => m0(x) + m0(8)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + 8
    i64 m1(i64 x) => f1 - 4
    // override
    i64 m2(i64 x) => f0 * f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - f1
    i64 m1(i64 x) => f1 - f0
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 8 + 1
    i64 m1(i64 x) => 3 + f1
    // override
    i64 m2(i64 x) => x - 4
}

void roS00(S00 v) {
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(6)}")
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(4)}")
    print($"m0 {v.m0(7)}")
}

void rwS00(ref S00 v) {
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(6)}")
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(4)}")
    print($"m0 {v.m0(7)}")
}

