void roVia0<T>(T v) where T : IGen0 {
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(6)}")
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(4)}")
    print($"m0 {v.m0(7)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
