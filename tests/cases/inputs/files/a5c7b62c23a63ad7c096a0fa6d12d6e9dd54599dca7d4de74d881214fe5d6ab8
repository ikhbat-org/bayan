    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(4)}")
    print($"m0 {v.m0(7)}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(6)}")
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(4)}")
