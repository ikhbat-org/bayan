        print($"S02 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: -5, f1: 2 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -4 }
