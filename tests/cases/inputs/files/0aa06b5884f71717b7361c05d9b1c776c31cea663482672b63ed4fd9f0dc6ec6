void pats(V v, by i64 n, to i64? p) {
    var r = 0
    switch v {
        case .a(let k): r = k
        case .b: r = 2
    }
    switch v {
        case .a(let k) when k > n: r = 1
        case .a(let k) when k > (p ?? g()): r = 3
        case .a(let k) when k > (h() catch 0): r = 5
        default: r = 4
    }
}

