interface IGen0 {
    i64 m0(i64 x)
    i64 m1
    void m2(ref this, i64 by)
    string m3() uses alloc => $"m3 {m1} {m0(4)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + f0
    i64 m1 => f1 + f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * f1
    i64 m1 => 6 - 1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m3() => $"S01 m3 {7 - 1}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * f0
    i64 m1 => f0 * f0
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

void roS00(S00 v) {
    print(v.m3())
    print($"m1 {v.m1}")
    print($"m0 {v.m0(8)}")
    print($"m1 {v.m1}")
    print(v.m3())
    print(v.m3())
}

void rwS00(ref S00 v) {
    print(v.m3())
    print($"m1 {v.m1}")
    print($"m0 {v.m0(8)}")
    print($"m1 {v.m1}")
    print(v.m3())
    print(v.m3())
    v.m2(0)
}

