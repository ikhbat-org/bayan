interface IGen1 {
    i64 m0
    i64 m1
    void m2(ref this, i64 by)
    string m3() uses alloc
    i64 m4(i64 x) => m1 + m0
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f0 + 2
    i64 m1 => 8 + f0
    void m2(ref this, i64 by) {
        f0 += by * 3
    }
    string m3() => $"S10 {f1 * f1}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 3 - f0
    i64 m1 => 7 * f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    string m3() => $"S11 {f0 + f1}"
    // override
    i64 m4(i64 x) => f1 + x
}

void roS10(S10 v) {
    print($"m1 {v.m1}")
    print($"m1 {v.m1}")
    print(v.m3())
    print(v.m3())
    print(v.m3())
    print($"m4 {v.m4(-3)}")
    print($"m0 {v.m0}")
}

void rwS10(ref S10 v) {
    print($"m1 {v.m1}")
    v.m2(6)
    print($"m1 {v.m1}")
    print(v.m3())
    print(v.m3())
    print(v.m3())
    print($"m4 {v.m4(-3)}")
    print($"m0 {v.m0}")
}

