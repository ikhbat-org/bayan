f64 zero() => 0.0
f64 negZero() => -zero()

string kindsText(in List<BNode> ns) {
    var sb = StrBuf()
    for n in ns {
        sb.append($" {boundKind(n)}")
    }
    return $"{sb.finish()}"
}

string typeText(in Ctx c, for BNode n) {
    let k = boundKind(n)
    var t: Type = -1
    if isExprKind(k) {
        t = exprType(in c, for: n)
    } else if isPatternKind(k) {
        t = patternInput(in c, for: n)
    } else {
        return "-"
    }
    if kindOf(t) == .primitive {
        return $"{primKindOf(typeIndex(t))}"
    }
    return $"{kindOf(t)}"
}

BExpr leafE(ref Ctx c, at i64 i) {
    let sp = TextSpan { start: 0, length: 0 }
    switch i {
        case 0: return addLiteral(ref c, from: BLiteral { span: sp, type: prim(.i64), value: Constant { kind: .integer } })
        case 1: return addDefault(ref c, from: BDefault { span: sp, type: prim(.i64) })
        case 2: return addThis(ref c, from: BThis { span: sp, type: prim(.i64) })
        case 3: return addErrorExpr(ref c, from: BErrorExpr { span: sp })
        case 4: return addTypeRef(ref c, from: BTypeRef { span: sp, referenced: prim(.i64) })
        default: return addSymbolLiteral(ref c, from: BSymbolLiteral { span: sp, text: "s" })
    }
}

BStmt leafS(ref Ctx c, at i64 i) {
    let sp = TextSpan { start: 0, length: 0 }
    switch i {
        case 0: return addErrorStmt(ref c, from: BErrorStmt { span: sp })
        case 1: return addBreak(ref c, from: BBreak { span: sp, target: 0 })
        case 2: return addContinue(ref c, from: BContinue { span: sp, target: 0 })
        default: return addSetOnPanic(ref c, from: BSetOnPanic { span: sp, handler: 0 })
    }
}

BPattern leafP(ref Ctx c, at i64 i) {
    let sp = TextSpan { start: 0, length: 0 }
    switch i {
        case 0: return addBindPattern(ref c, from: BBindPattern { span: sp, inputType: prim(.i64) })
        case 1: return addUnionPattern(ref c, from: BUnionPattern { span: sp, inputType: prim(.i64), variant: 0 })
        case 2: return addErrorPattern(ref c, from: BErrorPattern { span: sp, inputType: prim(.i64), variant: 0 })
        default: return addPropertyPattern(ref c, from: BPropertyPattern { span: sp, inputType: prim(.i64), valueType: prim(.i64) })
    }
}

BStmt leafBlock(ref Ctx c) {
    let s = leafS(ref c, at: 0)
    return addBlock(ref c, from: BBlock { span: TextSpan { start: 0, length: 0 }, statements: [s] })
}

BExpr leafLocal(ref Ctx c) => addLocal(ref c, from: BLocal { span: TextSpan { start: 0, length: 0 }, local: 0 })

void printNode(in Ctx c, for BNode n, as string label) {
    let sp = nodeSpan(in c, for: n)
    let ch = children(in c, for: n)
    let d = descendants(in c, for: n)
    print($"{label} {boundKind(n)} {sp.start}+{sp.length} {typeText(in c, for: n)}:{kindsText(in ch)} |{kindsText(in d)}")
}

