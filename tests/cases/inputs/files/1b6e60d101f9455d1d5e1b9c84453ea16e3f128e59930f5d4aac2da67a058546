    host0Local(6, to: true)
    host1Local()
    host2Local()
    host3Local()
    host4Local()
    host5Local()
    print("== via1")
    host0Via1(6, to: true)
    host1Via1()
    host2Via1()
    host3Via1()
    host4Via1()
    host5Via1()
    print("== via2")
    host0Via2(6, to: true)
    host1Via2()
    host2Via2()
    host3Via2()
    host4Via2()
    host5Via2()
}
