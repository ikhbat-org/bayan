interface IGen0 {
    i64 m0
    i64 m1
    void m2(ref this, i64 by)
    i64 m3
    i64 m4(i64 x) => m1 + m1
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + f0
    i64 m1 => f0 - f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m3 => f1 * f1
    // override
    i64 m4(i64 x) => 3 * f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * 4
    i64 m1 => 1 * f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m3 => f1 + 6
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 9 + 9
    i64 m1 => 2 - f0
    void m2(ref this, i64 by) {
        f0 += by * 3
    }
    i64 m3 => 1 * 6
    // override
    i64 m4(i64 x) => 3 - f1
}

void roS00(S00 v) {
    print($"m4 {v.m4(-3)}")
    print($"m4 {v.m4(5)}")
    print($"m4 {v.m4(-3)}")
    print($"m1 {v.m1}")
    print($"m4 {v.m4(-1)}")
    print($"m3 {v.m3}")
}

void rwS00(ref S00 v) {
    print($"m4 {v.m4(-3)}")
    print($"m4 {v.m4(5)}")
    print($"m4 {v.m4(-3)}")
    print($"m1 {v.m1}")
