interface IGen1 {
    i64 m0
    i64 m1(i64 x)
    i64 m2
    i64 m3(i64 x) => m2 + m0
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 8 + f0
    i64 m1(i64 x) => 7 + x
    i64 m2 => 2 - f1
}

struct S11 : IGen1 {
    i64 f0
