interface IGen0 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    void m2(ref this, i64 by)
    i64 m3(i64 x)
    string m4() uses alloc => $"m4 {m3(2)} {m3(5)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 - 5
    i64 m1(i64 x) => f0 - f0
    void m2(ref this, i64 by) {
        f0 += by * 3
    }
    i64 m3(i64 x) => f1 + f1
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 * f0
    i64 m1(i64 x) => f0 + 8
    void m2(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m3(i64 x) => f0 * f1
}

void roS00(S00 v) {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
    v.m2(8)
}

void roS01(S01 v) {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
}

void rwS01(ref S01 v) {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
    v.m2(8)
}

void roVia0<T>(T v) where T : IGen0 {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
    v.m2(8)
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
}

void rwDyn0(dyn ref IGen0 v) {
    print($"m1 {v.m1(-1)}")
    print($"m1 {v.m1(5)}")
    print(v.m4())
    v.m2(8)
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: -4, f1: 1 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -5 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: -4, f1: 1 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -5 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: -4, f1: 1 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 9, f1: -5 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
}
