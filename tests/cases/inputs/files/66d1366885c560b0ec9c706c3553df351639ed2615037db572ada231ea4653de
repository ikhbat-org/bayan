i64 call0(i64 a0, to i64 a1, by ((i64, i64) -> i64) f) => f(a0, a1)

i64 relay0(i64 a0, to i64 a1, by ((i64, i64) -> i64) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let p1: i64 = -4
    let r: i64 = p1 - 6
    print($"c0 {r}")
}

void host0Local() {
    let f: (i64, i64) -> i64 = (p0, p1) => p1 - 6
    let r: i64 = f(-7, -4)
    print($"c0 {r}")
}

void host0Via1() {
    let r: i64 = call0(-7, to: -4, by: (p0, p1) => p1 - 6)
    print($"c0 {r}")
}

void host0Via2() {
    let f: (i64, i64) -> i64 = (p0, p1) => p1 - 6
    let r: i64 = relay0(-7, to: -4, by: f)
    print($"c0 {r}")
}

string call1(i64 a0, to string a1, by ((i64, string) -> string) f) => f(a0, a1)

string relay1(i64 a0, to string a1, by ((i64, string) -> string) f) => call1(a0, to: a1, by: f)

void host1Direct() {
    let p0: i64 = -4
    let r: string = $"{6}-{p0}"
    print($"c1 {r}")
}

void host1Local() {
    let f: (i64, string) -> string uses alloc = (p0, p1) => {
        return $"{6}-{p0}"
    }
    let r: string = f(-4, "x")
    print($"c1 {r}")
}

void host1Via1() {
    let r: string = call1(-4, to: "x", by: (p0, p1) => {
        return $"{6}-{p0}"
    })
    print($"c1 {r}")
}

void host1Via2() {
    let r: string = relay1(-4, to: "x", by: (p0, p1) => {
        return $"{6}-{p0}"
    })
    print($"c1 {r}")
}

i64 call2(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => f(a0, a1)

i64 relay2(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let k0: i64 = -6
    let r: i64 = 9 - k0 + 9
    print($"c2 {r}")
}

void host2Local() {
    let k0: i64 = -6
    let f: (i64, bool) -> i64 = (p0, p1) => {
        return 9 - k0 + 9
    }
    let r: i64 = f(-8, false)
    print($"c2 {r}")
}

void host2Via1() {
    let k0: i64 = -6
    let r: i64 = call2(-8, to: false, by: (p0, p1) => {
        return 9 - k0 + 9
    })
    print($"c2 {r}")
}

void host2Via2() {
    let k0: i64 = -6
    let r: i64 = relay2(-8, to: false, by: (p0, p1) => {
        return 9 - k0 + 9
    })
    print($"c2 {r}")
}

string call3(i64 a0, by (i64 -> string) f) => f(a0)

string relay3(i64 a0, by (i64 -> string) f) => call3(a0, by: f)

void host3Direct() {
    let p0: i64 = 1
    let r: string = $"{p0}-{p0}"
    print($"c3 {r}")
}

void host3Local() {
    let f: i64 -> string uses alloc = p0 => $"{p0}-{p0}"
    let r: string = f(1)
    print($"c3 {r}")
}

void host3Via1() {
    let r: string = call3(1, by: p0 => $"{p0}-{p0}")
    print($"c3 {r}")
}

void host3Via2() {
    let r: string = relay3(1, by: $"{it}-{it}")
    print($"c3 {r}")
}

i64 call4(bool a0, by (bool -> i64) f) => f(a0)

i64 relay4(bool a0, by (bool -> i64) f) => call4(a0, by: f)

void host4Direct(i64 q0) {
    let r: i64 = q0 + 6
    print($"c4 {r}")
}

void host4Local(i64 q0) {
    let f: bool -> i64 = p0 => q0 + 6
    let r: i64 = f(true)
    print($"c4 {r}")
}

void host4Via1(i64 q0) {
    let r: i64 = call4(a0: true, by: p0 => q0 + 6)
    print($"c4 {r}")
}

void host4Via2(i64 q0) {
    let f: bool -> i64 = p0 => q0 + 6
    let r: i64 = relay4(a0: true, by: f)
    print($"c4 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct()
    host2Direct()
    host3Direct()
    host4Direct(8)
    print("== local")
    host0Local()
    host1Local()
    host2Local()
    host3Local()
    host4Local(8)
    print("== via1")
    host0Via1()
    host1Via1()
    host2Via1()
    host3Via1()
    host4Via1(8)
    print("== via2")
    host0Via2()
    host1Via2()
    host2Via2()
    host3Via2()
    host4Via2(8)
}
