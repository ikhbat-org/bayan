string relay0(bool a0, to bool a1, by ((bool, bool) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let k0: bool = false
    let p1: bool = false
    let r: string = $"{p1}-{k0}"
    print($"c0 {r}")
}

void host0Local() {
    let k0: bool = false
    let f: (bool, bool) -> string uses alloc = (p0, p1) => {
        return $"{p1}-{k0}"
    }
    let r: string = f(true, false)
    print($"c0 {r}")
}

void host0Via1() {
    let k0: bool = false
    let r: string = call0(a0: true, to: false, by: (p0, p1) => {
        return $"{p1}-{k0}"
    })
    print($"c0 {r}")
}

void host0Via2() {
    let k0: bool = false
    let r: string = relay0(a0: true, to: false, by: (p0, p1) => {
        return $"{p1}-{k0}"
    })
    print($"c0 {r}")
}

