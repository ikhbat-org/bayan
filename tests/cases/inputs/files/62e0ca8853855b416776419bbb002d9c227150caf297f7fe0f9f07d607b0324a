bool fn0(bool p0) => 0 > 8 && 8 < 9

bool call0(bool a0, by (bool -> bool) f) => f(a0)

bool relay0(bool a0, by (bool -> bool) f) => call0(a0, by: f)

void host0Direct() {
    let r: bool = fn0(p0: false)
    print($"c0 {r}")
}

void host0Local() {
    let f: bool -> bool = fn0
    let r: bool = f(false)
    print($"c0 {r}")
}

void host0Via1() {
    let r: bool = call0(a0: false, by: fn0)
    print($"c0 {r}")
}

void host0Via2() {
    let f: bool -> bool = fn0
    let r: bool = relay0(a0: false, by: f)
    print($"c0 {r}")
}

string call1(by (() -> string) f) => f()

string relay1(by (() -> string) f) => call1(by: f)

void host1Direct() {
    let r: string = $"{8}-{0}"
    print($"c1 {r}")
}

void host1Local() {
    let f: () -> string uses alloc = () => {
        return $"{8}-{0}"
    }
    let r: string = f()
    print($"c1 {r}")
}

void host1Via1() {
    let r: string = call1(by: () => {
        return $"{8}-{0}"
    })
    print($"c1 {r}")
}

void host1Via2() {
    let r: string = relay1(by: () => {
        return $"{8}-{0}"
    })
    print($"c1 {r}")
}

string fn2(i64 p0) => $"{p0}-{p0}"

string call2(i64 a0, by (i64 -> string) f) => f(a0)

string relay2(i64 a0, by (i64 -> string) f) => call2(a0, by: f)

void host2Direct() {
    let r: string = fn2(7)
    print($"c2 {r}")
}

void host2Local() {
    let f: i64 -> string uses alloc = fn2
    let r: string = f(7)
    print($"c2 {r}")
}

void host2Via1() {
    let r: string = call2(7, by: fn2)
    print($"c2 {r}")
}

void host2Via2() {
    let r: string = relay2(7, by: fn2)
    print($"c2 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct()
    host2Direct()
    print("== local")
    host0Local()
    host1Local()
    host2Local()
    print("== via1")
    host0Via1()
    host1Via1()
    host2Via1()
    print("== via2")
    host0Via2()
    host1Via2()
    host2Via2()
}
