void main() {
    print("== direct")
    {
        var v = S00 { f0: 6, f1: 6 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 8, f1: 9 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: -2, f1: 5 }
        roS02(v)
        rwS02(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 6, f1: 6 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
