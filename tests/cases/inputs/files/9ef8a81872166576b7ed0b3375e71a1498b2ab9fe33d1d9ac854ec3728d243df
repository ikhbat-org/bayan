interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    i64 m2(i64 x)
    string m3() uses alloc => $"m3 {m2(7)} {m2(4)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 5 + 5
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m2(i64 x) => f1 * f1
    // override
    string m3() => $"S00 m3 {f0 * f1}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 7 * f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2(i64 x) => x - f1
    // override
    string m3() => $"S01 m3 {f1 - 8}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + f0
    void m1(ref this, i64 by) {
        f0 += by * 3
    }
    i64 m2(i64 x) => 6 * f0
}

void roS00(S00 v) {
    print($"m0 {v.m0(6)}")
    print($"m0 {v.m0(3)}")
    print(v.m3())
    print($"m0 {v.m0(-1)}")
    print($"m2 {v.m2(7)}")
    print(v.m3())
}

void rwS00(ref S00 v) {
    print($"m0 {v.m0(6)}")
    print($"m0 {v.m0(3)}")
    v.m1(3)
    print(v.m3())
    print($"m0 {v.m0(-1)}")
    print($"m2 {v.m2(7)}")
    v.m1(-1)
    print(v.m3())
}

