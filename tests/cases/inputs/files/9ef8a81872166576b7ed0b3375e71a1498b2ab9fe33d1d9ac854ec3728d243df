        roVia0(v)
        rwVia0(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 6, f1: 6 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 8, f1: 9 }
        roDyn0(v)
