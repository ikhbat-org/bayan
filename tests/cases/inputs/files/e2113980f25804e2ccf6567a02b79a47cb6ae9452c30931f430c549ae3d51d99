interface IGen0 {
    i64 m0
    void m1(ref this, i64 by)
    string m2() uses alloc
    i64 m3(i64 x) => m0 + m0
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * 2
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    string m2() => $"S00 {5 * f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + 8
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    string m2() => $"S01 {f0 - f1}"
    // override
    i64 m3(i64 x) => f1 - f0
}

void roS00(S00 v) {
    print(v.m2())
    print($"m3 {v.m3(2)}")
    print($"m0 {v.m0}")
    print(v.m2())
    print($"m3 {v.m3(0)}")
}

void rwS00(ref S00 v) {
    print(v.m2())
    v.m1(-3)
    print($"m3 {v.m3(2)}")
    print($"m0 {v.m0}")
    print(v.m2())
    print($"m3 {v.m3(0)}")
}

void roS01(S01 v) {
    print(v.m2())
