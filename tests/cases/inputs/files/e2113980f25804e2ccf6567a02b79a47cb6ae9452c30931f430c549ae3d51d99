    print($"m3 {v.m3(0)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print(v.m2())
    print($"m3 {v.m3(2)}")
    print($"m0 {v.m0}")
    print(v.m2())
    print($"m3 {v.m3(0)}")
