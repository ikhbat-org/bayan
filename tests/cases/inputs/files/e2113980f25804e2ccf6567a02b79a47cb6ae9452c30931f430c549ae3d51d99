interface IGen1 {
    i64 m0
    i64 m1
    string m2() uses alloc => $"m2 {m1} {m0}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 4 + 1
    i64 m1 => 4 - f1
    // override
    string m2() => $"S10 m2 {f1 - 7}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 4 + f1
    i64 m1 => f0 + 5
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 4 * f1
    i64 m1 => f0 * f0
}

