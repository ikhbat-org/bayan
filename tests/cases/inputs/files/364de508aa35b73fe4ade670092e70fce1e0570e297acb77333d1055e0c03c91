void tcDiag(string name) {
    var c = tcLoad(name)
    print($"== {name}")
    let mark = c.diagnostics.length
    let fns = copyIds(in c.modules[c.entryModule].allFunctions)
    for fn in fns {
        if c.functions[fn].body != -1 && !functionIsGeneric(ref c, by: fn) && !functionIsInstance(ref c, by: fn) { analyzeRegions(ref c, for: fn) }
    }
    for i in mark..c.diagnostics.length {
        let pos = linePosition(c.files[c.diagnostics[i].file].text.span, at: c.diagnostics[i].span.start)
        let fixText = c.diagnostics[i].hasFix ? $"fix {c.diagnostics[i].fixSpan.start}..{c.diagnostics[i].fixSpan.end} {c.diagnostics[i].fixReplacement}" : ""
        print($"{c.diagnostics[i].code} {pos.line}:{pos.column} {c.diagnostics[i].message} |{c.diagnostics[i].label}|{c.diagnostics[i].help}|{fixText}")
    }
}void tcBagged(string name) {
    var c = tcLoad(name)
    print($"== bag {name}")
    let outer = pushBag(ref c)
    let fns = copyIds(in c.modules[c.entryModule].allFunctions)
    for fn in fns {
        if c.functions[fn].body != -1 && !functionIsGeneric(ref c, by: fn) && !functionIsInstance(ref c, by: fn) { t42AnalyzeRegions(ref c, for: fn) }
    }
    popBag(ref c, to: outer)
    var churn = List<string>()
    for i in 0..4096 { churn.append($"churn {i} xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") }
    let b = c.bags.length - 1
    for d in c.bags[b].items {
        let pos = linePosition(c.files[d.file].text.span, at: d.span.start)
        let fixText = d.hasFix ? $"fix {d.fixSpan.start}..{d.fixSpan.end} {d.fixReplacement}" : ""
        print($"{d.code} {pos.line}:{pos.column} {d.message} |{d.label}|{d.help}|{fixText}")
    }
}

