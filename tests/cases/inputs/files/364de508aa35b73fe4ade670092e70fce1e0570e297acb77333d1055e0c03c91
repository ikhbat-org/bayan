        for k in 1..args.length { tcDiag(args[k]) }
        return 0
    }
    if args.length > 0 && args[0] == "bagged" {
        for k in 1..args.length { tcBagged(args[k]) }
        return 0
    }
    for name in args {
        if name == "pure" { tcPure() } else if name == "compute" { tcCompute() } else { tcRun(name) }
    }
    return 0
