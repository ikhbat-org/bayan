struct Point {
    i64 x
    i64 y
    i64 sum() => x + y
}

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 owned(i64 n) {
    var a = List<i64>()
    a.append(n)
    let b = move a
    return b.length
}

string greet(string name) uses alloc => $"hello {name}"

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += safe(total)
        if total >= 0 {
            total += Point { x: total, y: 2 }.sum()
            if total >= 0 {
                total += Point { x: total, y: 2 }.sum()
                if total >= 0 {
                    total += Point { x: total, y: 2 }.sum()
                    if total >= 0 {
                        total += Point { x: total, y: 2 }.sum()
                        if total >= 0 {
                            print(greet($"{total}"))
                            if total >= 0 {
                                total = parseDigit(total)
                                print(greet($"{total}"))
                                total += 1
                            }
                        }
                    }
                }
            }
        }
    }
    print($"{total}")
}
