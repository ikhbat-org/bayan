string call0(bool a0, to bool a1, by ((bool, bool) -> string) f) => f(a0, a1)

string relay0(bool a0, to bool a1, by ((bool, bool) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let p0: bool = false
    let p1: bool = true
    let r: string = $"{p1}-{p0}"
    print($"c0 {r}")
}

void host0Local() {
    let f: (bool, bool) -> string uses alloc = (p0, p1) => {
        return $"{p1}-{p0}"
    }
    let r: string = f(false, true)
    print($"c0 {r}")
}

void host0Via1() {
    let r: string = call0(a0: false, to: true, by: (p0, p1) => {
        return $"{p1}-{p0}"
    })
    print($"c0 {r}")
}

void host0Via2() {
    let r: string = relay0(a0: false, to: true, by: (p0, p1) => {
        return $"{p1}-{p0}"
    })
    print($"c0 {r}")
}

string call1(i64 a0, to i64 a1, by ((i64, i64) -> string) f) => f(a0, a1)

string relay1(i64 a0, to i64 a1, by ((i64, i64) -> string) f) => call1(a0, to: a1, by: f)

void host1Direct() {
    let k1: i64 = 2
    let r: string = $"{3}-{k1}"
    print($"c1 {r}")
}

void host1Local() {
    let k1: i64 = 2
    let f: (i64, i64) -> string uses alloc = (p0, p1) => {
        return $"{3}-{k1}"
    }
    let r: string = f(15, 10)
    print($"c1 {r}")
}

void host1Via1() {
    let k1: i64 = 2
    let r: string = call1(15, to: 10, by: (p0, p1) => {
        return $"{3}-{k1}"
    })
    print($"c1 {r}")
}

void host1Via2() {
    let k1: i64 = 2
    let r: string = relay1(15, to: 10, by: (p0, p1) => {
        return $"{3}-{k1}"
    })
    print($"c1 {r}")
}

bool call2(i64 a0, by (i64 -> bool) f) => f(a0)

bool relay2(i64 a0, by (i64 -> bool) f) => call2(a0, by: f)

void host2Direct() {
    let p0: i64 = 18
    let r: bool = p0 < 8
    print($"c2 {r}")
}

void host2Local() {
    let f: i64 -> bool = p0 => {
        return p0 < 8
    }
    let r: bool = f(18)
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(18, by: p0 => {
        return p0 < 8
    })
    print($"c2 {r}")
}

void host2Via2() {
    let r: bool = relay2(18, by: p0 => {
        return p0 < 8
    })
    print($"c2 {r}")
}

i64 call3(string a0, to bool a1, by ((string, bool) -> i64) f) => f(a0, a1)

i64 relay3(string a0, to bool a1, by ((string, bool) -> i64) f) => call3(a0, to: a1, by: f)

void host3Direct() {
    let r: i64 = 8 - 0 - 3
    print($"c3 {r}")
}

void host3Local() {
    let f: (string, bool) -> i64 = (p0, p1) => 8 - 0 - 3
    let r: i64 = f("", true)
    print($"c3 {r}")
}

void host3Via1() {
    let r: i64 = call3("", to: true, by: (p0, p1) => 8 - 0 - 3)
    print($"c3 {r}")
}

void host3Via2() {
    let r: i64 = relay3("", to: true, by: (p0, p1) => 8 - 0 - 3)
    print($"c3 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct()
    host2Direct()
    host3Direct()
    print("== local")
    host0Local()
    host1Local()
    host2Local()
    host3Local()
    print("== via1")
    host0Via1()
    host1Via1()
    host2Via1()
    host3Via1()
    print("== via2")
    host0Via2()
    host1Via2()
    host2Via2()
    host3Via2()
}
