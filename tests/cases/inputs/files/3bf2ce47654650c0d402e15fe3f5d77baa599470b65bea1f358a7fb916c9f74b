interface IGen1 {
    i64 m0(i64 x)
    string m1() uses alloc
    i64 m2(i64 x) => m0(x) + m0(1)
    i64 m3(i64 x) => m0(x) + m0(3)
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 7 + f0
    string m1() => $"S10 {8 - 6}"
    // override
    i64 m3(i64 x) => 2 + x
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 - f1
    string m1() => $"S11 {f1 + f0}"
    // override
    i64 m2(i64 x) => f0 + 9
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + x
    string m1() => $"S12 {f1 + f0}"
    // override
    i64 m2(i64 x) => f0 - f0
    // override
    i64 m3(i64 x) => f0 + f1
}

