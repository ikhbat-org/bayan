interface IGen0 {
    i64 m0
    void m1(ref this, i64 by)
    i64 m2
    string m3() uses alloc
    string m4() uses alloc => $"m4 {m2} {m2}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 - f1
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m2 => 9 - f0
    string m3() => $"S00 {6 * f0}"
    // override
    string m4() => $"S00 m4 {f1 + f1}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + f1
    void m1(ref this, i64 by) {
        f0 += by * 3
    }
    i64 m2 => f1 + f1
    string m3() => $"S01 {f1 + 7}"
    // override
    string m4() => $"S01 m4 {6 * 8}"
}

void roS00(S00 v) {
    print($"m0 {v.m0}")
    print($"m2 {v.m2}")
    print(v.m3())
}

void rwS00(ref S00 v) {
    v.m1(3)
    print($"m0 {v.m0}")
    print($"m2 {v.m2}")
    print(v.m3())
}

void roS01(S01 v) {
    print($"m0 {v.m0}")
