enum Color {
    red
    green
}

i64 colorCode(Color c) => c switch {
    .red => 1,
    .green => 2,
}

interface IArea {
    i64 area()
}

struct Box : IArea {
    i64 w
    i64 h
    i64 area() => w * h
}

i64 biggerArea<T>(T a, to T b) where T : IArea => a.area() > b.area() ? a.area() : b.area()

i64 apply(i64 n, by i64 -> i64 f) => f(n)

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 orZero(i64? n) => n ?? 0

string greet(string name) uses alloc => $"hello {name}"

i64 stock(Map<string, i64> m) => m.length

const limit: i64 = 100

i64 widen(i32 n) => i64(n)

(i64 lo, i64 hi) bounds(i64 n) => (lo: 0, hi: n)

i64 twice(i64 n) => n * 2

test "twice doubles" {
    assert twice(2) == 4
}

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += biggerArea(Box { w: 1, h: 2 }, to: Box { w: 3, h: total })
        if total >= 0 {
            print(greet($"{total}"))
            if total >= 0 {
                total += colorCode(Color.green)
                if total >= 0 {
                    total += safe(total)
                    if total >= 0 {
                        total += bounds(total).hi
                        total += 1
                    }
                }
            }
        }
    var unset2: i64
    total = unset2
    }
    print($"{total}")
}
