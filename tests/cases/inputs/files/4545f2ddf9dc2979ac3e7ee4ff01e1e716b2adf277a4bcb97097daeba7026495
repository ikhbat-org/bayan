interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    i64 m2(i64 x)
    string m3() uses alloc => $"m3 {m2(0)} {m1(4)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 - f0
    i64 m1(i64 x) => f0 - f0
    i64 m2(i64 x) => f1 * f0
    // override
    string m3() => $"S00 m3 {f0 + f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 7 - 9
    i64 m1(i64 x) => x + 5
    i64 m2(i64 x) => x - x
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 5 + f1
    i64 m1(i64 x) => f1 + 1
    i64 m2(i64 x) => f0 - f0
}

void roS00(S00 v) {
    print($"m2 {v.m2(-3)}")
    print($"m1 {v.m1(3)}")
    print(v.m3())
    print($"m1 {v.m1(-3)}")
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2(-3)}")
    print($"m1 {v.m1(3)}")
    print(v.m3())
    print($"m1 {v.m1(-3)}")
}

