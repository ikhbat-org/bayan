interface IGen1 {
    i64 m0
    void m1(ref this, i64 by)
    i64 m2(i64 x)
    string m3() uses alloc => $"m3 {m2(8)} {m2(3)}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 5 - f0
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2(i64 x) => f1 * f0
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f0 * f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2(i64 x) => f1 * x
    // override
    string m3() => $"S11 m3 {1 + f0}"
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f1 - f1
    void m1(ref this, i64 by) {
        f0 += by * 2
    }
    i64 m2(i64 x) => 4 - 6
    // override
    string m3() => $"S12 m3 {f1 * f0}"
}

void roS10(S10 v) {
    print(v.m3())
    print($"m2 {v.m2(9)}")
    print($"m0 {v.m0}")
}

void rwS10(ref S10 v) {
    v.m1(2)
    print(v.m3())
    print($"m2 {v.m2(9)}")
    print($"m0 {v.m0}")
}

