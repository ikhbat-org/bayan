    print($"m5 {v.m5(9)}")
    print($"m5 {v.m5(7)}")
    print($"m5 {v.m5(2)}")
    print($"m3 {v.m3(0)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m5 {v.m5(9)}")
    print($"m5 {v.m5(7)}")
    print($"m5 {v.m5(2)}")
    print($"m3 {v.m3(0)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
