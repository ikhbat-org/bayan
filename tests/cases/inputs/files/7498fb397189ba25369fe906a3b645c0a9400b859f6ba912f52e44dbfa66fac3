interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    string m2() uses alloc
    i64 m3(i64 x)
    string m4() uses alloc => $"m4 {m1(5)} {m1(5)}"
    i64 m5(i64 x) => m0 + m0
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 3 - 7
    i64 m1(i64 x) => x + f0
    string m2() => $"S00 {f0 - 4}"
    i64 m3(i64 x) => f1 - x
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 8 - f1
    i64 m1(i64 x) => f0 * x
    string m2() => $"S01 {6 + f0}"
    i64 m3(i64 x) => 1 + 8
}

void roS00(S00 v) {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m5 {v.m5(9)}")
    print($"m5 {v.m5(7)}")
    print($"m5 {v.m5(2)}")
    print($"m3 {v.m3(0)}")
}

void rwS00(ref S00 v) {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m5 {v.m5(9)}")
    print($"m5 {v.m5(7)}")
    print($"m5 {v.m5(2)}")
    print($"m3 {v.m3(0)}")
}

void roS01(S01 v) {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
