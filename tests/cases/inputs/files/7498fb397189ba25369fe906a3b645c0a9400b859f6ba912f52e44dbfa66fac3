}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m5 {v.m5(9)}")
    print($"m5 {v.m5(7)}")
    print($"m5 {v.m5(2)}")
    print($"m3 {v.m3(0)}")
}

void rwDyn0(dyn ref IGen0 v) {
    print($"m3 {v.m3(1)}")
    print($"m1 {v.m1(9)}")
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m5 {v.m5(9)}")
    print($"m5 {v.m5(7)}")
    print($"m5 {v.m5(2)}")
    print($"m3 {v.m3(0)}")
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 2, f1: 7 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 1, f1: -1 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 2, f1: 7 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 1, f1: -1 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 2, f1: 7 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 1, f1: -1 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
}
