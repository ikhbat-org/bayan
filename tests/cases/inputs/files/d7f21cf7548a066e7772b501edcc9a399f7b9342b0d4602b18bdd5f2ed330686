bool call0(string a0, by (string -> bool) f) => f(a0)

bool relay0(string a0, by (string -> bool) f) => call0(a0, by: f)

void host0Direct(i64 q0, to string q1) {
    let r: bool = 2 > q0 || 1 < 3
    print($"c0 {r}")
}

void host0Local(i64 q0, to string q1) {
    let f: string -> bool = p0 => 2 > q0 || 1 < 3
    let r: bool = f("ab")
    print($"c0 {r}")
}

void host0Via1(i64 q0, to string q1) {
    let r: bool = call0("ab", by: p0 => 2 > q0 || 1 < 3)
    print($"c0 {r}")
}

void host0Via2(i64 q0, to string q1) {
    let f: string -> bool = p0 => 2 > q0 || 1 < 3
    let r: bool = relay0("ab", by: f)
    print($"c0 {r}")
}

bool call1(by (() -> bool) f) => f()

bool relay1(by (() -> bool) f) => call1(by: f)

void host1Direct() {
    let k0: bool = false
    let k1: string = "ab"
    let r: bool = k1 == "bayan" && !k0
    print($"c1 {r}")
}

void host1Local() {
    let k0: bool = false
    let k1: string = "ab"
    let f: () -> bool = () => k1 == "bayan" && !k0
    let r: bool = f()
    print($"c1 {r}")
}

void host1Via1() {
    let k0: bool = false
    let k1: string = "ab"
    let r: bool = call1(by: () => k1 == "bayan" && !k0)
    print($"c1 {r}")
}

void host1Via2() {
    let k0: bool = false
    let k1: string = "ab"
    let r: bool = relay1(by: () => k1 == "bayan" && !k0)
    print($"c1 {r}")
}

string fn2(string p0, to i64 p1) {
    return $"{p0}-{p0}"
}

string call2(string a0, to i64 a1, by ((string, i64) -> string) f) => f(a0, a1)

string relay2(string a0, to i64 a1, by ((string, i64) -> string) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let r: string = fn2("ab", to: 17)
    print($"c2 {r}")
}

void host2Local() {
    let f: (string, i64) -> string uses alloc = fn2
    let r: string = f("ab", 17)
    print($"c2 {r}")
}

void host2Via1() {
    let r: string = call2("ab", to: 17, by: fn2)
    print($"c2 {r}")
}

void host2Via2() {
    let r: string = relay2("ab", to: 17, by: fn2)
    print($"c2 {r}")
}

string call3(i64 a0, to string a1, by ((i64, string) -> string) f) => f(a0, a1)

string relay3(i64 a0, to string a1, by ((i64, string) -> string) f) => call3(a0, to: a1, by: f)

void host3Direct(i64 q0) {
    let k1: string = "bayan"
    let p0: i64 = -3
    let r: string = $"{p0}-{k1}"
    print($"c3 {r}")
}

void host3Local(i64 q0) {
    let k1: string = "bayan"
    let f: (i64, string) -> string uses alloc = (p0, p1) => $"{p0}-{k1}"
    let r: string = f(-3, "bayan")
    print($"c3 {r}")
}

void host3Via1(i64 q0) {
    let k1: string = "bayan"
    let r: string = call3(-3, to: "bayan", by: (p0, p1) => $"{p0}-{k1}")
    print($"c3 {r}")
}

void host3Via2(i64 q0) {
    let k1: string = "bayan"
    let r: string = relay3(-3, to: "bayan", by: (p0, p1) => $"{p0}-{k1}")
    print($"c3 {r}")
}

void main() {
    print("== direct")
    host0Direct(6, to: "")
    host1Direct()
    host2Direct()
    host3Direct(6)
    print("== local")
    host0Local(6, to: "")
    host1Local()
    host2Local()
    host3Local(6)
    print("== via1")
    host0Via1(6, to: "")
    host1Via1()
    host2Via1()
    host3Via1(6)
    print("== via2")
    host0Via2(6, to: "")
    host1Via2()
    host2Via2()
    host3Via2(6)
}
