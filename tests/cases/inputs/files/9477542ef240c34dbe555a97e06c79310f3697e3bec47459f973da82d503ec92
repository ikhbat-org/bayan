        roVia1(v)
        rwVia1(ref v)
        print($"S11 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 5, f1: 3 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -3, f1: 1 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S10 { f0: 0, f1: 5 }
        roDyn1(v)
        rwDyn1(v)
        print($"S10 {v.f0} {v.f1}")
    }
    {
        var v = S11 { f0: -2, f1: 9 }
        roDyn1(v)
        rwDyn1(v)
        print($"S11 {v.f0} {v.f1}")
    }
}
