void main() {
    print("== direct")
    {
        var v = S00 { f0: 5, f1: 3 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -3, f1: 1 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S10 { f0: 0, f1: 5 }
        roS10(v)
        rwS10(ref v)
        print($"S10 {v.f0} {v.f1}")
    }
    {
        var v = S11 { f0: -2, f1: 9 }
        roS11(v)
        rwS11(ref v)
        print($"S11 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 5, f1: 3 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -3, f1: 1 }
        roVia0(v)
        rwVia0(ref v)
