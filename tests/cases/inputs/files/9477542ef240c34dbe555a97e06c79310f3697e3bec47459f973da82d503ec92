interface IGen0 {
    i64 m0(i64 x)
    string m1() uses alloc
    string m2() uses alloc
    i64 m3(i64 x) => m0(x) + m0(7)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * 1
    string m1() => $"S00 {1 * f1}"
    string m2() => $"S00 {f1 - f1}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + f1
    string m1() => $"S01 {f0 + f1}"
    string m2() => $"S01 {7 - f0}"
    // override
    i64 m3(i64 x) => f0 - f1
}

void roS00(S00 v) {
    print(v.m2())
    print(v.m1())
    print(v.m1())
    print(v.m1())
    print($"m0 {v.m0(1)}")
    print($"m3 {v.m3(7)}")
}

void rwS00(ref S00 v) {
    print(v.m2())
    print(v.m1())
    print(v.m1())
    print(v.m1())
    print($"m0 {v.m0(1)}")
    print($"m3 {v.m3(7)}")
}

