interface IGen1 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    i64 m2(i64 x)
    i64 m3(i64 x) => m2(x) + m1(3)
    string m4() uses alloc => $"m4 {m0(7)} {m2(4)}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * x
    i64 m1(i64 x) => 9 + f0
    i64 m2(i64 x) => f0 + 8
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 5 - f0
    i64 m1(i64 x) => 8 - f0
    i64 m2(i64 x) => f0 * x
    // override
    i64 m3(i64 x) => f0 + f0
}

void roS10(S10 v) {
    print($"m3 {v.m3(0)}")
    print($"m1 {v.m1(4)}")
    print($"m1 {v.m1(4)}")
    print($"m1 {v.m1(2)}")
}

void rwS10(ref S10 v) {
    print($"m3 {v.m3(0)}")
