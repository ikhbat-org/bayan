i32 main(ReadOnlySpan<string> args) {
    print("== all")
    var c = Ctx {
        files: List<SourceFile>(),
        modules: List<Mod>(),
        diagnostics: List<Diag>(),
        bags: List<DiagBag>(),
        displayRoot: args[0],
    }
    var i: i64 = 1
    while i + 1 < args.length {
        if args[i] == "pathof" {
            print($"pathof {args[i + 1]} {t26PathOf(ref c, for: args[i + 1])}")
        } else {
            print($"name {args[i + 1]} {programName(ref c, for: args[i + 1])}")
        }
        i += 2
    }
    return 0
}