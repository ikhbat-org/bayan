interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    string m2() uses alloc
    string m3() uses alloc => $"m3 {m0(1)} {m0(3)}"
    i64 m4(i64 x) => m0(x) + m0(7)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 4 - x
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    string m2() => $"S00 {f0 - f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 5 * f0
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    string m2() => $"S01 {f1 - 7}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + f0
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    string m2() => $"S02 {f1 + f0}"
    // override
    string m3() => $"S02 m3 {8 + f0}"
}

void roS00(S00 v) {
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void rwS00(ref S00 v) {
    v.m1(-3)
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void roS01(S01 v) {
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void rwS01(ref S01 v) {
    v.m1(-3)
    print($"m4 {v.m4(1)}")
