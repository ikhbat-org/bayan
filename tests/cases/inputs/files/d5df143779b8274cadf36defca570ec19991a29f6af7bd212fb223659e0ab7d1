void roVia0<T>(T v) where T : IGen0 {
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    v.m1(-3)
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void rwDyn0(dyn ref IGen0 v) {
    v.m1(-3)
    print($"m4 {v.m4(1)}")
    print($"m4 {v.m4(2)}")
    print($"m4 {v.m4(2)}")
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 2, f1: 8 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -5, f1: 7 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 3, f1: 4 }
        roS02(v)
        rwS02(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 2, f1: 8 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -5, f1: 7 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 3, f1: 4 }
        roVia0(v)
        rwVia0(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 2, f1: 8 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -5, f1: 7 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 3, f1: 4 }
        roDyn0(v)
        rwDyn0(v)
        print($"S02 {v.f0} {v.f1}")
    }
}
