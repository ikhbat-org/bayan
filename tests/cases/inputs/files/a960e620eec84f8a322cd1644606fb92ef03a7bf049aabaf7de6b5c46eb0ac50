interface IGen0 {
    i64 m0
    string m1() uses alloc
    i64 m2(i64 x) => m0 + m0
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 9 * f1
    string m1() => $"S00 {f0 + f0}"
    // override
    i64 m2(i64 x) => x * f0
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + f1
    string m1() => $"S01 {f1 - 1}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + f1
    string m1() => $"S02 {f0 + f0}"
}

void roS00(S00 v) {
    print(v.m1())
    print($"m2 {v.m2(6)}")
    print($"m0 {v.m0}")
    print($"m2 {v.m2(7)}")
    print(v.m1())
}

void rwS00(ref S00 v) {
    print(v.m1())
    print($"m2 {v.m2(6)}")
    print($"m0 {v.m0}")
    print($"m2 {v.m2(7)}")
    print(v.m1())
}

