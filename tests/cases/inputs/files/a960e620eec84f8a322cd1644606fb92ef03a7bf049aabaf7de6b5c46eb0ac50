interface IGen1 {
    i64 m0
    string m1() uses alloc
    i64 m2(i64 x) => m0 + m0
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 6 + 2
    string m1() => $"S10 {f0 * 1}"
    // override
    i64 m2(i64 x) => f0 - f1
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f0 + 1
    string m1() => $"S11 {f1 - 3}"
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f1 - f0
    string m1() => $"S12 {4 - f1}"
}

void roS10(S10 v) {
    print($"m0 {v.m0}")
    print($"m2 {v.m2(-1)}")
    print($"m0 {v.m0}")
    print(v.m1())
}

