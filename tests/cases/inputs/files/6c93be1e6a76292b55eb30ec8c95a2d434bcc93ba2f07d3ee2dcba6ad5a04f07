            files: List<SourceFile>(),
            modules: List<Mod>(),
            diagnostics: List<Diag>(),
            bags: List<DiagBag>(),
            library: op != "diag",
            packageRoot: "tmp/t39-cases",
            displayRoot: "tmp/t39-cases",
        }
        c.entryModule = loadModule(ref c, for: "main", at: "tmp/t39-cases", from: move sources, by: -1)
        buildLexicon(ref c)
        declare(ref c)
        print($"== {op}.{args[i + 1]}")
        if op == "diag" || op == "lib" {
            bindAll(ref c)
            tcT39Diags(ref c)
        } else if op == "wr" {
            bindAll(ref c)
            tcWritten(ref c)
            tcT39Diags(ref c)
        } else {
            tcExh(ref c, by: args[i + 1])
        }
        i += 2
    }
    return 0
}