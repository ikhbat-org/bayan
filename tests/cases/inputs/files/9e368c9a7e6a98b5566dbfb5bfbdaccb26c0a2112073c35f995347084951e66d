interface IGen0 {
    i64 m0(i64 x)
    string m1() uses alloc
    i64 m2(i64 x)
    i64 m3(i64 x) => m0(x) + m2(2)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x + 3
    string m1() => $"S00 {f1 - 4}"
    i64 m2(i64 x) => f1 - f0
    // override
    i64 m3(i64 x) => f1 + f0
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + 8
    string m1() => $"S01 {f0 - f0}"
    i64 m2(i64 x) => 7 + f1
}

void roS00(S00 v) {
    print($"m0 {v.m0(2)}")
    print($"m0 {v.m0(1)}")
    print(v.m1())
    print(v.m1())
    print($"m0 {v.m0(0)}")
}

void rwS00(ref S00 v) {
    print($"m0 {v.m0(2)}")
    print($"m0 {v.m0(1)}")
    print(v.m1())
    print(v.m1())
    print($"m0 {v.m0(0)}")
}

void roS01(S01 v) {
    print($"m0 {v.m0(2)}")
