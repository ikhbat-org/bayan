void main() {
    print("== direct")
    {
        var v = S00 { f0: 6, f1: 8 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -2, f1: 1 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S10 { f0: -1, f1: 5 }
