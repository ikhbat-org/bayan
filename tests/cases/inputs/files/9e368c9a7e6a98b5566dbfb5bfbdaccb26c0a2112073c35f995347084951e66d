interface IGen1 {
    i64 m0(i64 x)
    i64 m1
    void m2(ref this, i64 by)
    string m3() uses alloc => $"m3 {m0(4)} {m0(2)}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * x
    i64 m1 => f1 * f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m3() => $"S10 m3 {f0 * f0}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x + f1
    i64 m1 => f0 + f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

void roS10(S10 v) {
    print($"m0 {v.m0(3)}")
    print(v.m3())
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(-2)}")
    print($"m1 {v.m1}")
    print(v.m3())
}

void rwS10(ref S10 v) {
    print($"m0 {v.m0(3)}")
    print(v.m3())
    v.m2(4)
    print($"m0 {v.m0(8)}")
    print($"m0 {v.m0(-2)}")
    print($"m1 {v.m1}")
    v.m2(9)
    print(v.m3())
}

