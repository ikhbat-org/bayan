i64 call3(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => f(a0, a1)

i64 relay3(i64 a0, to bool a1, by ((i64, bool) -> i64) f) => call3(a0, to: a1, by: f)

void host3Direct() {
    let p0: i64 = 2
