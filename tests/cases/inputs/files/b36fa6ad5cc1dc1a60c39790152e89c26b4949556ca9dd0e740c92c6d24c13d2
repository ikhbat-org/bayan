string call0(by (() -> string) f) => f()

string relay0(by (() -> string) f) => call0(by: f)

void host0Direct() {
    let k0: i64 = -7
    let k1: string = "x"
    let r: string = $"{k0}-{k1}"
    print($"c0 {r}")
}

void host0Local() {
    let k0: i64 = -7
    let k1: string = "x"
    let f: () -> string uses alloc = () => $"{k0}-{k1}"
    let r: string = f()
    print($"c0 {r}")
}

void host0Via1() {
    let k0: i64 = -7
    let k1: string = "x"
    let r: string = call0(by: () => $"{k0}-{k1}")
    print($"c0 {r}")
}

void host0Via2() {
    let k0: i64 = -7
    let k1: string = "x"
    let r: string = relay0(by: () => $"{k0}-{k1}")
