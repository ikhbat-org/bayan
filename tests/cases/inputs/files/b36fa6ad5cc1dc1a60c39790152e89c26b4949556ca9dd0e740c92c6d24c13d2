}

bool call1(i64 a0, by (i64 -> bool) f) => f(a0)

bool relay1(i64 a0, by (i64 -> bool) f) => call1(a0, by: f)

void host1Direct(i64 q0) {
    let r: bool = q0 > 1 || 3 < q0
    print($"c1 {r}")
}

void host1Local(i64 q0) {
    let f: i64 -> bool = p0 => {
        return q0 > 1 || 3 < q0
    }
    let r: bool = f(2)
    print($"c1 {r}")
}

void host1Via1(i64 q0) {
    let r: bool = call1(2, by: p0 => {
        return q0 > 1 || 3 < q0
    })
    print($"c1 {r}")
}

void host1Via2(i64 q0) {
    let f: i64 -> bool = p0 => {
        return q0 > 1 || 3 < q0
    }
    let r: bool = relay1(2, by: f)
    print($"c1 {r}")
