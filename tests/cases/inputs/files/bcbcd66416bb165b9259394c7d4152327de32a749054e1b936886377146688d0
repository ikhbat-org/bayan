string call0(bool a0, to bool a1, by ((bool, bool) -> string) f) => f(a0, a1)

string relay0(bool a0, to bool a1, by ((bool, bool) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let k0: i64 = 16
    let k1: string = "x"
    let r: string = $"{k1}-{k0}"
    print($"c0 {r}")
}

void host0Local() {
    let k0: i64 = 16
    let k1: string = "x"
    let f: (bool, bool) -> string uses alloc = (p0, p1) => {
        return $"{k1}-{k0}"
    }
    let r: string = f(false, false)
    print($"c0 {r}")
}

void host0Via1() {
    let k0: i64 = 16
    let k1: string = "x"
    let r: string = call0(a0: false, to: false, by: (p0, p1) => {
        return $"{k1}-{k0}"
    })
    print($"c0 {r}")
}

void host0Via2() {
    let k0: i64 = 16
    let k1: string = "x"
    let r: string = relay0(a0: false, to: false, by: (p0, p1) => {
        return $"{k1}-{k0}"
    })
    print($"c0 {r}")
}

bool call1(by (() -> bool) f) => f()

bool relay1(by (() -> bool) f) => call1(by: f)

void host1Direct() {
    let r: bool = 1 < 5
    print($"c1 {r}")
}

void host1Local() {
    let f: () -> bool = () => 1 < 5
    let r: bool = f()
    print($"c1 {r}")
}

void host1Via1() {
    let r: bool = call1(by: () => 1 < 5)
    print($"c1 {r}")
}

void host1Via2() {
    let f: () -> bool = () => 1 < 5
    let r: bool = relay1(by: f)
    print($"c1 {r}")
}

bool fn2(i64 p0, to string p1) => p0 > 6

bool call2(i64 a0, to string a1, by ((i64, string) -> bool) f) => f(a0, a1)

bool relay2(i64 a0, to string a1, by ((i64, string) -> bool) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let r: bool = fn2(8, to: "")
    print($"c2 {r}")
}

void host2Local() {
    let f: (i64, string) -> bool = fn2
    let r: bool = f(8, "")
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(8, to: "", by: fn2)
    print($"c2 {r}")
}

void host2Via2() {
    let r: bool = relay2(8, to: "", by: fn2)
    print($"c2 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct()
    host2Direct()
    print("== local")
    host0Local()
    host1Local()
    host2Local()
    print("== via1")
    host0Via1()
    host1Via1()
    host2Via1()
    print("== via2")
    host0Via2()
    host1Via2()
    host2Via2()
}
