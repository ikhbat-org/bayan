interface IGen0 {
    i64 m0(i64 x)
    i64 m1
    string m2() uses alloc => $"m2 {m1} {m1}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 * f0
    i64 m1 => f0 * 4
    // override
    string m2() => $"S00 m2 {f1 + f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + 9
    i64 m1 => 1 + f1
    // override
    string m2() => $"S01 m2 {6 * 7}"
}

void roS00(S00 v) {
    print($"m1 {v.m1}")
    print($"m0 {v.m0(-1)}")
    print($"m1 {v.m1}")
    print($"m1 {v.m1}")
    print(v.m2())
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1}")
    print($"m0 {v.m0(-1)}")
    print($"m1 {v.m1}")
    print($"m1 {v.m1}")
    print(v.m2())
}

