interface IGen1 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    void m2(ref this, i64 by)
    string m3() uses alloc => $"m3 {m0(7)} {m0(8)}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - 5
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    void m2(ref this, i64 by) {
        f0 += by * 1
    }
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + x
    void m1(ref this, i64 by) {
        f0 += by * 3
    }
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 * f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

void roS10(S10 v) {
    print(v.m3())
    print(v.m3())
    print($"m0 {v.m0(2)}")
}

void rwS10(ref S10 v) {
    print(v.m3())
    print(v.m3())
    print($"m0 {v.m0(2)}")
    v.m2(-1)
}

