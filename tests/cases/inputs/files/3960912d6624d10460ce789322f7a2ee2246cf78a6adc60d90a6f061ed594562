interface IGen0 {
    i64 m0
    void m1(ref this, i64 by)
    i64 m2
    i64 m3(i64 x)
    i64 m4(i64 x) => m0 + m3(6)
    string m5() uses alloc => $"m5 {m0} {m3(1)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + 9
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2 => 7 - 5
    i64 m3(i64 x) => f1 * 8
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 6 - f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2 => f0 + f0
    i64 m3(i64 x) => f0 * f1
    // override
    i64 m4(i64 x) => 4 - f1
    // override
    string m5() => $"S01 m5 {f0 + 6}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 2 + f0
    void m1(ref this, i64 by) {
        f0 += by * 3
    }
    i64 m2 => f1 + f1
    i64 m3(i64 x) => f0 - f0
    // override
    i64 m4(i64 x) => x - 5
}

void roS00(S00 v) {
    print($"m3 {v.m3(1)}")
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void rwS00(ref S00 v) {
    print($"m3 {v.m3(1)}")
    v.m1(4)
    v.m1(6)
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void roS01(S01 v) {
    print($"m3 {v.m3(1)}")
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void rwS01(ref S01 v) {
    print($"m3 {v.m3(1)}")
    v.m1(4)
    v.m1(6)
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void roS02(S02 v) {
    print($"m3 {v.m3(1)}")
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void rwS02(ref S02 v) {
    print($"m3 {v.m3(1)}")
    v.m1(4)
    v.m1(6)
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print($"m3 {v.m3(1)}")
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print($"m3 {v.m3(1)}")
    v.m1(4)
    v.m1(6)
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m3 {v.m3(1)}")
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void rwDyn0(dyn ref IGen0 v) {
    print($"m3 {v.m3(1)}")
    v.m1(4)
    v.m1(6)
    print(v.m5())
    print($"m4 {v.m4(5)}")
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 6, f1: 9 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -1, f1: 1 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 3, f1: 0 }
        roS02(v)
        rwS02(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 6, f1: 9 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -1, f1: 1 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 3, f1: 0 }
        roVia0(v)
        rwVia0(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 6, f1: 9 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -1, f1: 1 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 3, f1: 0 }
        roDyn0(v)
        rwDyn0(v)
        print($"S02 {v.f0} {v.f1}")
    }
}
