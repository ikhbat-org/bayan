void roVia0<T>(T v) where T : IGen0 {
    print($"m0 {v.m0}")
    print($"m1 {v.m1}")
    print(v.m3())
    print($"m0 {v.m0}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print($"m0 {v.m0}")
    print($"m1 {v.m1}")
    print(v.m3())
    print($"m0 {v.m0}")
    v.m2(4)
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m0 {v.m0}")
    print($"m1 {v.m1}")
    print(v.m3())
    print($"m0 {v.m0}")
}

void rwDyn0(dyn ref IGen0 v) {
    print($"m0 {v.m0}")
    print($"m1 {v.m1}")
    print(v.m3())
    print($"m0 {v.m0}")
    v.m2(4)
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 7, f1: 7 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 7, f1: -4 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: -2, f1: 1 }
        roS02(v)
        rwS02(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 7, f1: 7 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
