interface IGen0 {
    i64 m0
    i64 m1
    void m2(ref this, i64 by)
    string m3() uses alloc
    i64 m4(i64 x) => m0 + m1
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 2 + 7
    i64 m1 => 9 - f1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    string m3() => $"S00 {f1 - f1}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 + f0
    i64 m1 => f1 + 1
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    string m3() => $"S01 {f1 - f0}"
    // override
    i64 m4(i64 x) => f1 + x
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 * f0
    i64 m1 => 3 * f1
    void m2(ref this, i64 by) {
        f0 += by * 3
    }
    string m3() => $"S02 {9 - 9}"
    // override
    i64 m4(i64 x) => f0 * 9
}

void roS00(S00 v) {
    print($"m0 {v.m0}")
    print($"m1 {v.m1}")
    print(v.m3())
    print($"m0 {v.m0}")
}

void rwS00(ref S00 v) {
    print($"m0 {v.m0}")
    print($"m1 {v.m1}")
    print(v.m3())
    print($"m0 {v.m0}")
    v.m2(4)
}

