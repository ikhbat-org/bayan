void roDyn0(dyn ref readonly IGen0 v) {
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

void rwDyn0(dyn ref IGen0 v) {
    v.m1(3)
    v.m1(-2)
    v.m1(2)
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

interface IGen1 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    i64 m2
    void m3(ref this, i64 by)
    i64 m4(i64 x) => m2 + m2
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 - f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    i64 m2 => f1 + 9
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * f1
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m2 => 2 - 9
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S12 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 8 + f0
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m2 => f1 - f1
    void m3(ref this, i64 by) {
        f0 += by * 3
    }
    // override
    i64 m4(i64 x) => 2 - 6
}

void roS10(S10 v) {
    print($"m4 {v.m4(-2)}")
    print($"m4 {v.m4(-2)}")
    print($"m2 {v.m2}")
}

void rwS10(ref S10 v) {
    print($"m4 {v.m4(-2)}")
    print($"m4 {v.m4(-2)}")
    v.m3(-1)
    v.m3(6)
    print($"m2 {v.m2}")
    v.m1(-3)
}

