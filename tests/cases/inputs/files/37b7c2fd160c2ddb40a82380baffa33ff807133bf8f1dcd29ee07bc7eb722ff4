interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    string m2() uses alloc => $"m2 {m0(3)} {m0(9)}"
    i64 m3(i64 x) => m0(x) + m0(9)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 5 + f0
    void m1(ref this, i64 by) {
        f0 += by * 2
    }
    // override
    string m2() => $"S00 m2 {1 * f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 1 * f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m2() => $"S01 m2 {3 + f0}"
}

void roS00(S00 v) {
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

void rwS00(ref S00 v) {
    v.m1(3)
    v.m1(-2)
    v.m1(2)
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

void roS01(S01 v) {
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

void rwS01(ref S01 v) {
    v.m1(3)
    v.m1(-2)
    v.m1(2)
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    v.m1(3)
    v.m1(-2)
    v.m1(2)
    print(v.m2())
    print($"m3 {v.m3(8)}")
    print($"m3 {v.m3(8)}")
