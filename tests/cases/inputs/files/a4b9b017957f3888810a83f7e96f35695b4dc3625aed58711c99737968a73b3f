interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    i64 m2(i64 x) => m0(x) + m0(5)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - 5
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 - x
    void m1(ref this, i64 by) {
        f0 += by * 3
    }
    // override
    i64 m2(i64 x) => f0 + 7
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 * f0
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
}

void roS00(S00 v) {
    print($"m2 {v.m2(3)}")
    print($"m0 {v.m0(-1)}")
    print($"m2 {v.m2(3)}")
}

void rwS00(ref S00 v) {
    v.m1(2)
    v.m1(7)
    print($"m2 {v.m2(3)}")
    v.m1(-3)
    print($"m0 {v.m0(-1)}")
    print($"m2 {v.m2(3)}")
}

