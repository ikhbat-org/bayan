interface IGen1 {
    i64 m0(i64 x)
    string m1() uses alloc
    void m2(ref this, i64 by)
    void m3(ref this, i64 by)
    i64 m4(i64 x) => m0(x) + m0(2)
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 1 + x
    string m1() => $"S10 {f0 * f1}"
    void m2(ref this, i64 by) {
        f0 += by * 2
    }
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + f0
    string m1() => $"S11 {f1 + 4}"
    void m2(ref this, i64 by) {
        f0 += by * 3
    }
    void m3(ref this, i64 by) {
        f0 += by * 3
    }
}

void roS10(S10 v) {
    print($"m0 {v.m0(2)}")
}

void rwS10(ref S10 v) {
    print($"m0 {v.m0(2)}")
    v.m3(-1)
    v.m3(3)
    v.m3(0)
    v.m3(7)
}

void roS11(S11 v) {
    print($"m0 {v.m0(2)}")
}

void rwS11(ref S11 v) {
