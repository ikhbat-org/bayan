interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    i64 m2
    void m3(ref this, i64 by)
    i64 m4(i64 x) => m0 + m2
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * f0
    i64 m1(i64 x) => x + 7
    i64 m2 => 6 * 4
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 + 1
    i64 m1(i64 x) => f1 * f0
    i64 m2 => f1 * f0
    void m3(ref this, i64 by) {
        f0 += by * 1
    }
    // override
    i64 m4(i64 x) => 1 * x
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 + f0
    i64 m1(i64 x) => x * x
    i64 m2 => f1 + f0
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

void roS00(S00 v) {
    print($"m1 {v.m1(0)}")
    print($"m4 {v.m4(7)}")
    print($"m4 {v.m4(5)}")
    print($"m2 {v.m2}")
}

void rwS00(ref S00 v) {
    print($"m1 {v.m1(0)}")
    print($"m4 {v.m4(7)}")
    v.m3(9)
    v.m3(4)
    print($"m4 {v.m4(5)}")
    print($"m2 {v.m2}")
}

