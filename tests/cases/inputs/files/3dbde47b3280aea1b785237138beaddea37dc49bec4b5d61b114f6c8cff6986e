void host4Via2(bool q0, to string q1) {
    let r: string = relay4(-4, by: p0 => {
        return $"{7}-{q1}"
    })
    print($"c4 {r}")
}

void main() {
    print("== direct")
    host0Direct("x", to: 9)
    host1Direct(-7, to: false)
    host2Direct()
    host3Direct()
    host4Direct(q0: false, to: "bayan")
    print("== local")
    host0Local("x", to: 9)
