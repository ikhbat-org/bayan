void main() {
    print("== direct")
    {
        var v = S00 { f0: 5, f1: 9 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 0, f1: 7 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
