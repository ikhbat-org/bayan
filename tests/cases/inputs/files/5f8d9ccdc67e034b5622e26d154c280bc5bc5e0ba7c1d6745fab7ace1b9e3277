interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    string m2() uses alloc
    string m3() uses alloc => $"m3 {m0(0)} {m0(0)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + f1
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    string m2() => $"S00 {4 + 4}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 * x
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    string m2() => $"S01 {f1 * f1}"
    // override
    string m3() => $"S01 m3 {1 * 8}"
}

void roS00(S00 v) {
    print(v.m3())
    print(v.m3())
    print($"m0 {v.m0(3)}")
    print(v.m2())
    print($"m0 {v.m0(2)}")
    print(v.m3())
    print(v.m3())
}

void rwS00(ref S00 v) {
    print(v.m3())
    print(v.m3())
    v.m1(-1)
    print($"m0 {v.m0(3)}")
    print(v.m2())
    print($"m0 {v.m0(2)}")
    print(v.m3())
    print(v.m3())
}

