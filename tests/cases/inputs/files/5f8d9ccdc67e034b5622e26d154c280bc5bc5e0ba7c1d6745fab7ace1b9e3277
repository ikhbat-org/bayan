interface IGen1 {
    i64 m0
    i64 m1(i64 x)
    string m2() uses alloc => $"m2 {m1(7)} {m0}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => 3 + 9
    i64 m1(i64 x) => 4 - f0
    // override
    string m2() => $"S10 m2 {3 + f1}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0 => f0 + f1
    i64 m1(i64 x) => x * f0
    // override
    string m2() => $"S11 m2 {f0 + f1}"
}

void roS10(S10 v) {
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m1 {v.m1(2)}")
    print($"m0 {v.m0}")
    print(v.m2())
    print(v.m2())
    print($"m1 {v.m1(-3)}")
}

