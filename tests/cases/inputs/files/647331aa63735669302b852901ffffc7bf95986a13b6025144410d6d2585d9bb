union Shape {
    circle(i64 r)
    square(i64 side)
    none
}

i64 area(Shape s) => s switch {
    .circle(let r) => r * r * 3,
    .square(let side) => side * side,
    .none => 0,
}

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 owned(i64 n) {
    var a = List<i64>()
    a.append(n)
    let b = move a
    return b.length
}

i64 orZero(i64? n) => n ?? 0

const limit: i64 = 100

i64 widen(i32 n) => i64(n)

i64 twice(i64 n) => n * 2

test "twice doubles" {
    assert twice(2) == 4
}

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += owned(total)
        if total >= 0 {
            total += safe(total)
            if total >= 0 {
                total += owned(total)
                if total >= 0 {
                    total += limit
                    if total >= 0 {
                        total += orZero(null)
                        if total >= 0 {
                            var owned2 = List<i64>()
                            owned2.append(total)
                            let taken2 = move owned2
                            total = owned2.length + taken2.length
                            total += widen(i32(3))
                            total += 1
                        }
                    }
                }
            }
        }
    }
    print($"{total}")
}
