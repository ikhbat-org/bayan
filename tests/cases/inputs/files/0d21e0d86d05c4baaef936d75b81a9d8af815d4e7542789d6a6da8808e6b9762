void roVia0<T>(T v) where T : IGen0 {
    print(v.m4())
    print(v.m4())
    print($"m0 {v.m0(6)}")
    print(v.m4())
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print(v.m4())
    print(v.m4())
    v.m3(5)
    print($"m0 {v.m0(6)}")
    v.m3(2)
    print(v.m4())
}

void roDyn0(dyn ref readonly IGen0 v) {
    print(v.m4())
    print(v.m4())
    print($"m0 {v.m0(6)}")
    print(v.m4())
}

void rwDyn0(dyn ref IGen0 v) {
    print(v.m4())
    print(v.m4())
    v.m3(5)
    print($"m0 {v.m0(6)}")
    v.m3(2)
    print(v.m4())
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 3, f1: 5 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -1, f1: 8 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: -1, f1: 4 }
        roS02(v)
        rwS02(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 3, f1: 5 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -1, f1: 8 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
