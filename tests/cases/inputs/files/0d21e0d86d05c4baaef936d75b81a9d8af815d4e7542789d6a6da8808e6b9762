interface IGen0 {
    i64 m0(i64 x)
    i64 m1
    string m2() uses alloc
    void m3(ref this, i64 by)
    string m4() uses alloc => $"m4 {m1} {m0(1)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 4 + f1
    i64 m1 => f1 + f1
    string m2() => $"S00 {1 * f0}"
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + f0
    i64 m1 => f1 - 6
    string m2() => $"S01 {f1 + f0}"
    void m3(ref this, i64 by) {
        f0 += by * 3
    }
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 3 + x
    i64 m1 => 9 + f0
    string m2() => $"S02 {9 - f0}"
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m4() => $"S02 m4 {f1 - f1}"
}

void roS00(S00 v) {
    print(v.m4())
    print(v.m4())
    print($"m0 {v.m0(6)}")
    print(v.m4())
}

void rwS00(ref S00 v) {
    print(v.m4())
    print(v.m4())
    v.m3(5)
    print($"m0 {v.m0(6)}")
    v.m3(2)
    print(v.m4())
}

void roS01(S01 v) {
    print(v.m4())
    print(v.m4())
    print($"m0 {v.m0(6)}")
    print(v.m4())
}

