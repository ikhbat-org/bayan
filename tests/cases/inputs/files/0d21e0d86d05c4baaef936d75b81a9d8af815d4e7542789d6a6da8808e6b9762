        var v = S02 { f0: -1, f1: 4 }
        roVia0(v)
        rwVia0(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 3, f1: 5 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -1, f1: 8 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: -1, f1: 4 }
        roDyn0(v)
        rwDyn0(v)
        print($"S02 {v.f0} {v.f1}")
    }
}
