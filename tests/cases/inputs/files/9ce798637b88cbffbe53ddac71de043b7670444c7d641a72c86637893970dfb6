enum Color {
    red
    green
}

i64 colorCode(Color c) => c switch {
    .red => 1,
    .green => 2,
}

interface IArea {
    i64 area()
}

struct Box : IArea {
    i64 w
    i64 h
    i64 area() => w * h
}

i64 biggerArea<T>(T a, to T b) where T : IArea => a.area() > b.area() ? a.area() : b.area()

i64 orZero(i64? n) => n ?? 0

i64 stock(Map<string, i64> m) => m.length

const limit: i64 = 100

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += orZero(null)
        if total >= 0 {
            total += orZero(null)
            if total >= 0 {
                total += stock(["a": 1, "b": total])
                if total >= 0 {
                    total += orZero(null)
                    if total >= 0 {
                        total += orZero(null)
                        if total >= 0 {
                            total += orZero(null)
                            if total >= 0 {
