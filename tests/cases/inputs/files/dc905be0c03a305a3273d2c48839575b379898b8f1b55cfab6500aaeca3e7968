string call0(by (() -> string) f) => f()

string relay0(by (() -> string) f) => call0(by: f)

void host0Direct() {
    let k0: string = "ab"
    let r: string = $"{k0}-{k0}"
    print($"c0 {r}")
}

void host0Local() {
    let k0: string = "ab"
    let f: () -> string uses alloc = () => $"{k0}-{k0}"
    let r: string = f()
    print($"c0 {r}")
}

void host0Via1() {
    let k0: string = "ab"
    let r: string = call0(by: () => $"{k0}-{k0}")
    print($"c0 {r}")
}

void host0Via2() {
    let k0: string = "ab"
    let r: string = relay0(by: () => $"{k0}-{k0}")
    print($"c0 {r}")
}

