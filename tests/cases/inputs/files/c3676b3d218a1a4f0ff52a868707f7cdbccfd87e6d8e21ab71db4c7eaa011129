/// Every field default bound, as the C# `BindAll` does (generics.byn:151-160).
void tcDefaults(ref Ctx c) {
    for m in 0..c.modules.length {
        let structs = copyIds(in c.modules[m].structs)
        for s in structs {
            let fields = copyIds(in c.structs[s].fields)
            for f in fields {
                if c.fields[f].hasDefault {
                    var b = t13NewBinder(c.structs[s].file, owner: s)
                    c.fields[f].defaultValue = bindFieldDefault(ref b, through: ref c, for: f)
                }
            }
        }
    }
}

/// `tcDiags` from 0, only the codes T21 reports.
void tcT21Diags(ref Ctx c) {
    var keep = Map<string, bool>()
    keep["BYN2112"] = true
    keep["BYN2602"] = true
    keep["BYN2787"] = true
    keep["BYN2789"] = true
    keep["BYN2782"] = true
    keep["BYN2783"] = true
    keep["BYN2784"] = true
    keep["BYN2785"] = true
    keep["BYN3207"] = true

    for i in 0..c.diagnostics.length {
        if !keep.contains(c.diagnostics[i].code) { continue }
        let pos = linePosition(c.files[c.diagnostics[i].file].text.span, at: c.diagnostics[i].span.start)
        let fixText = c.diagnostics[i].hasFix ? $"fix {c.diagnostics[i].fixSpan.start}..{c.diagnostics[i].fixSpan.end} {c.diagnostics[i].fixReplacement}" : ""
        print($"{c.diagnostics[i].code} {pos.line}:{pos.column} {c.diagnostics[i].message} |{c.diagnostics[i].label}|{c.diagnostics[i].help}|{fixText}")
    }
}

string tcDiagSource(string name) {
    if name == "no-constructor" { return "struct Point {\n    i64 x\n    i64 y\n}\n\nlet p = Point(1, 2)\n" }
    if name == "literal-needs-try" { return "struct Order {\n    i64 quantity requires it > 0\n}\n\nOrder order(i64 n) fails ValidationError<Order> => Order { quantity: n }\n" }
    if name == "trust-reason" { return "let u: Untrusted<string> = Untrusted(\"x\")\nprint(trust(u))\nprint(trust(u, \"checked\"))\n" }
    if name == "collection-copy-unique-element" { return "struct Holder {\n    List<i64> items\n}\n\nvoid use(Arena a) {\n    let lists = List<List<i64>>()\n    let l = lists.copy(to: a)\n    let maps = Map<string, StrBuf>()\n    let m = maps.copy(to: a)\n    let keyed = Map<i64, Holder>()\n    let k = keyed.copy(to: a)\n    let owned = List<Owned<i64>?>()\n    let o = owned.copy(to: a)\n    let fine = Map<string, i64[2]>()\n    let f = fine.copy(to: a)\n}\n" }
    if name == "unique-move-from-field" { return "// Only a local or a `move` parameter can be moved (BYN2782).\nstruct Bag {\n    List<i64> items\n}\n\nList<i64> make() => List<i64>()\n\nvoid take(List<i64> plain) {\n    let bag = Bag { items: List<i64>() }\n    let lists = List<List<i64>>()\n    let a = move bag.items\n    let b = move lists[0]\n    let c = move plain\n    let e = move make()\n    let n: i64 = 1\n    let g = move n\n}\n\nvoid takeShared(ref List<i64> shared) {\n    let d = move shared\n}\n\nvoid takeOwned(move List<i64> owned) {\n    let f = move owned\n}\n" }
    if name == "move-with-parenthesized" { return "// `move (tx with { … })` moves a fresh value, not a local (BYN2782).\nstruct Ledger {\n    string label\n    List<i64> items\n}\n\nvoid main() {\n    let tx = Ledger { label: \"daily\", items: List<i64>() }\n    let copy = move (tx with { label: \"copy\" })\n    print($\"{copy.label}\")\n}\n" }
    return ""
}
