bool call0(i64 a0, by (i64 -> bool) f) => f(a0)

bool relay0(i64 a0, by (i64 -> bool) f) => call0(a0, by: f)

void host0Direct() {
    let p0: i64 = 13
    let r: bool = p0 > 6 && 5 < p0
    print($"c0 {r}")
}

void host0Local() {
    let f: i64 -> bool = p0 => p0 > 6 && 5 < p0
    let r: bool = f(13)
    print($"c0 {r}")
}

void host0Via1() {
    let r: bool = call0(13, by: p0 => p0 > 6 && 5 < p0)
    print($"c0 {r}")
}

void host0Via2() {
    let r: bool = relay0(13, by: p0 => p0 > 6 && 5 < p0)
    print($"c0 {r}")
}

i64 call1(bool a0, to string a1, by ((bool, string) -> i64) f) => f(a0, a1)

i64 relay1(bool a0, to string a1, by ((bool, string) -> i64) f) => call1(a0, to: a1, by: f)

void host1Direct() {
    let r: i64 = 0 * 6 + 8
    print($"c1 {r}")
}

void host1Local() {
    let f: (bool, string) -> i64 = (p0, p1) => 0 * 6 + 8
    let r: i64 = f(false, "")
    print($"c1 {r}")
}

void host1Via1() {
    let r: i64 = call1(a0: false, to: "", by: (p0, p1) => 0 * 6 + 8)
    print($"c1 {r}")
}

void host1Via2() {
    let f: (bool, string) -> i64 = (p0, p1) => 0 * 6 + 8
    let r: i64 = relay1(a0: false, to: "", by: f)
    print($"c1 {r}")
}

string call2(i64 a0, to string a1, by ((i64, string) -> string) f) => f(a0, a1)

string relay2(i64 a0, to string a1, by ((i64, string) -> string) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let p0: i64 = 18
    let r: string = $"{1}-{p0}"
    print($"c2 {r}")
}

void host2Local() {
    let f: (i64, string) -> string uses alloc = (p0, p1) => {
        return $"{1}-{p0}"
    }
    let r: string = f(18, "bayan")
    print($"c2 {r}")
}

void host2Via1() {
    let r: string = call2(18, to: "bayan", by: (p0, p1) => {
        return $"{1}-{p0}"
    })
    print($"c2 {r}")
}

void host2Via2() {
    let r: string = relay2(18, to: "bayan", by: (p0, p1) => {
        return $"{1}-{p0}"
    })
    print($"c2 {r}")
}

