string call0(bool a0, to string a1, by ((bool, string) -> string) f) => f(a0, a1)

string relay0(bool a0, to string a1, by ((bool, string) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct() {
    let p0: bool = true
    let p1: string = "ab"
    let r: string = $"{p0}-{p1}"
    print($"c0 {r}")
}

void host0Local() {
    let f: (bool, string) -> string uses alloc = (p0, p1) => $"{p0}-{p1}"
    let r: string = f(true, "ab")
    print($"c0 {r}")
}

void host0Via1() {
    let r: string = call0(a0: true, to: "ab", by: (p0, p1) => $"{p0}-{p1}")
    print($"c0 {r}")
}

void host0Via2() {
    let r: string = relay0(a0: true, to: "ab", by: (p0, p1) => $"{p0}-{p1}")
    print($"c0 {r}")
}

string call1(i64 a0, by (i64 -> string) f) => f(a0)

string relay1(i64 a0, by (i64 -> string) f) => call1(a0, by: f)

void host1Direct() {
    let k0: string = "ab"
    let r: string = k0
    print($"c1 {r}")
}

void host1Local() {
    let k0: string = "ab"
    let f: i64 -> string = p0 => k0
    let r: string = f(19)
    print($"c1 {r}")
}

void host1Via1() {
    let k0: string = "ab"
    let r: string = call1(19, by: p0 => k0)
    print($"c1 {r}")
}

void host1Via2() {
    let k0: string = "ab"
    let r: string = relay1(19, by: p0 => k0)
    print($"c1 {r}")
}

bool call2(bool a0, by (bool -> bool) f) => f(a0)

bool relay2(bool a0, by (bool -> bool) f) => call2(a0, by: f)

void host2Direct(string q0) {
    let r: bool = q0 == ""
    print($"c2 {r}")
}

void host2Local(string q0) {
    let f: bool -> bool = p0 => {
        return q0 == ""
    }
    let r: bool = f(false)
    print($"c2 {r}")
}

void host2Via1(string q0) {
    let r: bool = call2(a0: false, by: p0 => {
        return q0 == ""
    })
    print($"c2 {r}")
}

void host2Via2(string q0) {
    let r: bool = relay2(a0: false, by: p0 => {
        return q0 == ""
    })
    print($"c2 {r}")
}

string call3(i64 a0, to bool a1, by ((i64, bool) -> string) f) => f(a0, a1)

string relay3(i64 a0, to bool a1, by ((i64, bool) -> string) f) => call3(a0, to: a1, by: f)

void host3Direct(i64 q0, to string q1) {
    let k1: string = ""
    let r: string = k1
    print($"c3 {r}")
}

void host3Local(i64 q0, to string q1) {
    let k1: string = ""
    let f: (i64, bool) -> string = (p0, p1) => k1
    let r: string = f(16, false)
    print($"c3 {r}")
}

void host3Via1(i64 q0, to string q1) {
    let k1: string = ""
    let r: string = call3(16, to: false, by: (p0, p1) => k1)
    print($"c3 {r}")
}

void host3Via2(i64 q0, to string q1) {
    let k1: string = ""
    let r: string = relay3(16, to: false, by: (p0, p1) => k1)
    print($"c3 {r}")
}

void main() {
    print("== direct")
    host0Direct()
    host1Direct()
    host2Direct("bayan")
    host3Direct(-9, to: "x")
    print("== local")
    host0Local()
    host1Local()
    host2Local("bayan")
    host3Local(-9, to: "x")
    print("== via1")
    host0Via1()
    host1Via1()
    host2Via1("bayan")
    host3Via1(-9, to: "x")
    print("== via2")
    host0Via2()
    host1Via2()
    host2Via2("bayan")
    host3Via2(-9, to: "x")
}
