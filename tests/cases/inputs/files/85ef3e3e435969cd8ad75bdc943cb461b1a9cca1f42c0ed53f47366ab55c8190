interface IGen0 {
    i64 m0(i64 x)
    string m1() uses alloc
    string m2() uses alloc => $"m2 {m0(1)} {m0(6)}"
    i64 m3(i64 x) => m0(x) + m0(8)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - f0
    string m1() => $"S00 {4 + 7}"
    // override
    string m2() => $"S00 m2 {f0 * 3}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 4 - 8
    string m1() => $"S01 {2 + f0}"
}

void roS00(S00 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void rwS00(ref S00 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void roS01(S01 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void rwS01(ref S01 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void rwDyn0(dyn ref IGen0 v) {
    print(v.m2())
    print(v.m2())
    print(v.m2())
    print(v.m1())
    print($"m0 {v.m0(4)}")
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: -4, f1: 4 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -4, f1: 2 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: -4, f1: 4 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -4, f1: 2 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: -4, f1: 4 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: -4, f1: 2 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
}
