interface IGen1 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    void m2(ref this, i64 by)
    string m3() uses alloc => $"m3 {m0(3)} {m0(9)}"
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 9 - 5
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x * 2
    void m1(ref this, i64 by) {
        f1 = f0 - by
    }
    void m2(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m3() => $"S11 m3 {f1 * f0}"
}

void roS10(S10 v) {
    print(v.m3())
    print($"m0 {v.m0(6)}")
}

void rwS10(ref S10 v) {
    v.m2(2)
    print(v.m3())
    print($"m0 {v.m0(6)}")
    v.m1(3)
}

void roS11(S11 v) {
    print(v.m3())
