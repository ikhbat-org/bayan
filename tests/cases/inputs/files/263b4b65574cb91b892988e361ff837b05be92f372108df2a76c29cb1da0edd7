interface IGen0 {
    i64 m0
    i64 m1
    i64 m2
    void m3(ref this, i64 by)
    string m4() uses alloc => $"m4 {m0} {m0}"
    string m5() uses alloc => $"m5 {m0} {m2}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 + f0
    i64 m1 => 1 - f0
    i64 m2 => f0 + f0
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    string m4() => $"S00 m4 {f0 - 3}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 3 - f0
    i64 m1 => f1 - f0
    i64 m2 => 9 + 6
    void m3(ref this, i64 by) {
        f0 += by * 2
    }
    // override
    string m5() => $"S01 m5 {f1 * 5}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 - f0
    i64 m1 => f0 - 5
    i64 m2 => f1 - f0
    void m3(ref this, i64 by) {
        f0 += by * 2
    }
}

void roS00(S00 v) {
    print($"m2 {v.m2}")
    print(v.m4())
    print($"m1 {v.m1}")
    print($"m1 {v.m1}")
    print($"m2 {v.m2}")
    print(v.m4())
    print(v.m5())
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2}")
    v.m3(6)
    print(v.m4())
    print($"m1 {v.m1}")
    print($"m1 {v.m1}")
    print($"m2 {v.m2}")
    print(v.m4())
    print(v.m5())
}

