struct Point {
    i64 x
}

union Shape {
    circle(f64 r)
    dot
}

let p = Point { x: 1 }
let s: Shape = .circle(r: 2.0)
let m: Map<string, i64> = ["a": 1]
assert p.nope == 1
assert undefinedName
assert 1 + "a" == 2
assert i8(300) == 0
assert 9223372036854775807 + 1 > 0
assert s.r > 1.0
assert m["a"] == 1
assert [1, 2].length + p.x == 3
assert -(-5) == 5 && !true == false