interface IGen0 {
    i64 m0
    string m1() uses alloc
    string m2() uses alloc => $"m2 {m0} {m0}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 * f0
    string m1() => $"S00 {f0 * f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 * f0
    string m1() => $"S01 {f0 * f1}"
    // override
    string m2() => $"S01 m2 {f0 * f1}"
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 1 * f0
    string m1() => $"S02 {2 + f1}"
    // override
    string m2() => $"S02 m2 {7 + 8}"
}

void roS00(S00 v) {
    print(v.m1())
    print(v.m1())
    print(v.m1())
    print($"m0 {v.m0}")
    print(v.m1())
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

void rwS00(ref S00 v) {
    print(v.m1())
    print(v.m1())
    print(v.m1())
    print($"m0 {v.m0}")
    print(v.m1())
    print(v.m2())
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
}

