void host4Local(bool q0) {
    let f: (bool, i64) -> string uses alloc = (p0, p1) => $"{p0}-{q0}"
    let r: string = f(false, 16)
    print($"c4 {r}")
}

void host4Via1(bool q0) {
    let r: string = call4(a0: false, to: 16, by: (p0, p1) => $"{p0}-{q0}")
    print($"c4 {r}")
}

void host4Via2(bool q0) {
    let r: string = relay4(a0: false, to: 16, by: (p0, p1) => $"{p0}-{q0}")
    print($"c4 {r}")
}

string fn5(bool p0) => $"{6}-{p0}"

string call5(bool a0, by (bool -> string) f) => f(a0)

string relay5(bool a0, by (bool -> string) f) => call5(a0, by: f)

void host5Direct() {
    let r: string = fn5(p0: true)
    print($"c5 {r}")
}

void host5Local() {
    let f: bool -> string uses alloc = fn5
    let r: string = f(true)
    print($"c5 {r}")
}

void host5Via1() {
    let r: string = call5(a0: true, by: fn5)
    print($"c5 {r}")
}

void host5Via2() {
    let r: string = relay5(a0: true, by: fn5)
