interface IGen0 {
    i64 m0
    i64 m1
    i64 m2
    void m3(ref this, i64 by)
    i64 m4(i64 x) => m0 + m2
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 2 - f1
    i64 m1 => 9 * f1
    i64 m2 => f0 - 5
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f1 - f0
    i64 m1 => f1 * f0
    i64 m2 => 5 - 9
    void m3(ref this, i64 by) {
        f1 = f0 - by
    }
    // override
    i64 m4(i64 x) => x * f0
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 2 - 8
    i64 m1 => 9 - f0
    i64 m2 => 9 * 1
    void m3(ref this, i64 by) {
        f0 += by * 3
    }
}

void roS00(S00 v) {
    print($"m0 {v.m0}")
    print($"m4 {v.m4(6)}")
    print($"m2 {v.m2}")
    print($"m4 {v.m4(7)}")
    print($"m4 {v.m4(-1)}")
    print($"m0 {v.m0}")
}

