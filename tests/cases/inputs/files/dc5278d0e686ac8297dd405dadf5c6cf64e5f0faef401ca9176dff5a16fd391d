interface IGen1 {
    i64 m0(i64 x)
    string m1() uses alloc
    i64 m2(i64 x) => m0(x) + m0(2)
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f1 + f1
    string m1() => $"S10 {f0 - f1}"
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 - f1
    string m1() => $"S11 {8 * f0}"
}

struct S12 : IGen1 {
