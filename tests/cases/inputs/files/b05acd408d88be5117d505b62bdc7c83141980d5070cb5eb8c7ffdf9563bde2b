string call0(i64 a0, to i64 a1, by ((i64, i64) -> string) f) => f(a0, a1)

string relay0(i64 a0, to i64 a1, by ((i64, i64) -> string) f) => call0(a0, to: a1, by: f)

void host0Direct(bool q0, to i64 q1) {
    let k0: bool = q1 > 0
    let p1: i64 = 3
    let r: string = $"{k0}-{p1}"
    print($"c0 {r}")
}

void host0Local(bool q0, to i64 q1) {
    let k0: bool = q1 > 0
    let f: (i64, i64) -> string uses alloc = (p0, p1) => {
        return $"{k0}-{p1}"
    }
    let r: string = f(-9, 3)
    print($"c0 {r}")
}

void host0Via1(bool q0, to i64 q1) {
    let k0: bool = q1 > 0
    let r: string = call0(-9, to: 3, by: (p0, p1) => {
        return $"{k0}-{p1}"
    })
    print($"c0 {r}")
}

void host0Via2(bool q0, to i64 q1) {
    let k0: bool = q1 > 0
    let r: string = relay0(-9, to: 3, by: (p0, p1) => {
        return $"{k0}-{p1}"
    })
    print($"c0 {r}")
}

string call1(by (() -> string) f) => f()

string relay1(by (() -> string) f) => call1(by: f)

void host1Direct() {
    let r: string = $"{6}-{6}"
    print($"c1 {r}")
}

void host1Local() {
    let f: () -> string uses alloc = () => {
        return $"{6}-{6}"
    }
    let r: string = f()
    print($"c1 {r}")
}

void host1Via1() {
    let r: string = call1(by: () => {
        return $"{6}-{6}"
    })
    print($"c1 {r}")
}

void host1Via2() {
    let r: string = relay1(by: () => {
        return $"{6}-{6}"
    })
    print($"c1 {r}")
}

bool call2(bool a0, to string a1, by ((bool, string) -> bool) f) => f(a0, a1)

bool relay2(bool a0, to string a1, by ((bool, string) -> bool) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let p0: bool = false
    let r: bool = p0
    print($"c2 {r}")
}

void host2Local() {
    let f: (bool, string) -> bool = (p0, p1) => p0
    let r: bool = f(false, "bayan")
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(a0: false, to: "bayan", by: (p0, p1) => p0)
    print($"c2 {r}")
}

void host2Via2() {
    let r: bool = relay2(a0: false, to: "bayan", by: (p0, p1) => p0)
    print($"c2 {r}")
}

void main() {
    print("== direct")
    host0Direct(q0: false, to: 3)
    host1Direct()
    host2Direct()
    print("== local")
    host0Local(q0: false, to: 3)
    host1Local()
    host2Local()
    print("== via1")
    host0Via1(q0: false, to: 3)
    host1Via1()
    host2Via1()
    print("== via2")
    host0Via2(q0: false, to: 3)
    host1Via2()
    host2Via2()
}
