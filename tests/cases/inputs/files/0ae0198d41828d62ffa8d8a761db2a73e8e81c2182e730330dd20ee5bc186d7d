string call4(bool a0, by (bool -> string) f) => f(a0)

string relay4(bool a0, by (bool -> string) f) => call4(a0, by: f)

void host4Direct(i64 q0) {
    let p0: bool = false
    let r: string = $"{p0}-{q0}"
    print($"c4 {r}")
}

void host4Local(i64 q0) {
    let f: bool -> string uses alloc = p0 => $"{p0}-{q0}"
    let r: string = f(false)
    print($"c4 {r}")
}

void host4Via1(i64 q0) {
    let r: string = call4(a0: false, by: $"{it}-{q0}")
    print($"c4 {r}")
}

void host4Via2(i64 q0) {
    let r: string = relay4(a0: false, by: p0 => $"{p0}-{q0}")
    print($"c4 {r}")
}

i64 call5(bool a0, to bool a1, by ((bool, bool) -> i64) f) => f(a0, a1)

i64 relay5(bool a0, to bool a1, by ((bool, bool) -> i64) f) => call5(a0, to: a1, by: f)

void host5Direct() {
    let r: i64 = 6 + 7
    print($"c5 {r}")
}

void host5Local() {
    let f: (bool, bool) -> i64 = (p0, p1) => 6 + 7
    let r: i64 = f(false, true)
    print($"c5 {r}")
}

void host5Via1() {
    let r: i64 = call5(a0: false, to: true, by: (p0, p1) => 6 + 7)
    print($"c5 {r}")
}

void host5Via2() {
    let f: (bool, bool) -> i64 = (p0, p1) => 6 + 7
    let r: i64 = relay5(a0: false, to: true, by: f)
    print($"c5 {r}")
}

