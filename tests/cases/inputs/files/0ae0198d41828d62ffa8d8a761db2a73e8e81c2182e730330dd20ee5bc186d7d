i64 call0(by (() -> i64) f) => f()

i64 relay0(by (() -> i64) f) => call0(by: f)

void host0Direct(string q0) {
    let k0: i64 = 17
    let r: i64 = k0 + k0
    print($"c0 {r}")
}

void host0Local(string q0) {
    let k0: i64 = 17
    let f: () -> i64 = () => k0 + k0
    let r: i64 = f()
    print($"c0 {r}")
}

void host0Via1(string q0) {
    let k0: i64 = 17
    let r: i64 = call0(by: () => k0 + k0)
    print($"c0 {r}")
}

void host0Via2(string q0) {
    let k0: i64 = 17
    let f: () -> i64 = () => k0 + k0
    let r: i64 = relay0(by: f)
    print($"c0 {r}")
}

string call1(i64 a0, by (i64 -> string) f) => f(a0)

string relay1(i64 a0, by (i64 -> string) f) => call1(a0, by: f)

void host1Direct() {
    let k0: string = ""
    let p0: i64 = -2
    let r: string = $"{k0}-{p0}"
    print($"c1 {r}")
}

void host1Local() {
    let k0: string = ""
    let f: i64 -> string uses alloc = p0 => $"{k0}-{p0}"
    let r: string = f(-2)
    print($"c1 {r}")
}

void host1Via1() {
    let k0: string = ""
    let r: string = call1(-2, by: $"{k0}-{it}")
    print($"c1 {r}")
}

void host1Via2() {
    let k0: string = ""
    let r: string = relay1(-2, by: $"{k0}-{it}")
    print($"c1 {r}")
}

bool call2(i64 a0, by (i64 -> bool) f) => f(a0)

bool relay2(i64 a0, by (i64 -> bool) f) => call2(a0, by: f)

void host2Direct() {
    let p0: i64 = 13
    let r: bool = p0 == 5
    print($"c2 {r}")
}

void host2Local() {
    let f: i64 -> bool = p0 => p0 == 5
    let r: bool = f(13)
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(13, by: p0 => p0 == 5)
    print($"c2 {r}")
}

void host2Via2() {
    let f: i64 -> bool = p0 => p0 == 5
    let r: bool = relay2(13, by: f)
    print($"c2 {r}")
}

bool call3(string a0, by (string -> bool) f) => f(a0)

bool relay3(string a0, by (string -> bool) f) => call3(a0, by: f)

void host3Direct(i64 q0) {
    let r: bool = q0 == 7
    print($"c3 {r}")
