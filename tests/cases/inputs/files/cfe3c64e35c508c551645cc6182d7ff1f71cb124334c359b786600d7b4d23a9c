struct Point {
    i64 x
    i64 y
    i64 sum() => x + y
}

enum Color {
    red
    green
}

i64 colorCode(Color c) => c switch {
    .red => 1,
    .green => 2,
}

interface IArea {
    i64 area()
}

struct Box : IArea {
    i64 w
    i64 h
    i64 area() => w * h
}

i64 biggerArea<T>(T a, to T b) where T : IArea => a.area() > b.area() ? a.area() : b.area()

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 sumAll(List<i64> xs) {
    var sum: i64 = 0
    for x in xs { sum += x }
    var i = 0
    while i < xs.length { i += 1 }
    return sum + i
}

i64 owned(i64 n) {
    var a = List<i64>()
    a.append(n)
    let b = move a
    return b.length
}

i64 orZero(i64? n) => n ?? 0

i64 stock(Map<string, i64> m) => m.length

i64 widen(i32 n) => i64(n)

i64 twice(i64 n) => n * 2

test "twice doubles" {
    assert twice(2) == 4
}

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += biggerArea(Box { w: 1, h: 2 }, to: Box { w: 3, h: total })
        if total >= 0 {
            total += biggerArea(Box { w: 1, h: 2 }, to: Box { w: 3, h: total })
            if total >= 0 {
                total += twice(total)
                if total >= 0 {
                    total += owned(total)
                    total += 1
                }
            total = parseDigit(total)
            }
        }
    }
    print($"{total}")
}
