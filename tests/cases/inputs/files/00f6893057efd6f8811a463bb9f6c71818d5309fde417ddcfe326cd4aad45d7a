        roVia1(v)
        rwVia1(ref v)
        print($"S11 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 6, f1: 6 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
