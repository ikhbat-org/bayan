interface IGen1 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    i64 m2(i64 x) => m1(x) + m0(7)
}

struct S10 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 7 + f1
    i64 m1(i64 x) => f1 + f0
    // override
    i64 m2(i64 x) => 4 - f1
}

struct S11 : IGen1 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 1 - f1
    i64 m1(i64 x) => 9 * 1
    // override
    i64 m2(i64 x) => x * x
}

void roS10(S10 v) {
    print($"m0 {v.m0(-3)}")
    print($"m0 {v.m0(-3)}")
    print($"m0 {v.m0(1)}")
    print($"m0 {v.m0(3)}")
}

void rwS10(ref S10 v) {
    print($"m0 {v.m0(-3)}")
