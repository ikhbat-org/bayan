interface IGen0 {
    i64 m0(i64 x)
    i64 m1(i64 x)
    i64 m2(i64 x)
    string m3() uses alloc
    i64 m4(i64 x) => m0(x) + m2(6)
    i64 m5(i64 x) => m2(x) + m1(9)
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 * f0
    i64 m1(i64 x) => f0 + f0
    i64 m2(i64 x) => 2 - 8
    string m3() => $"S00 {2 * f1}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x - 3
    i64 m1(i64 x) => f1 + f0
    i64 m2(i64 x) => f1 - x
    string m3() => $"S01 {f0 - f1}"
    // override
    i64 m4(i64 x) => f1 * 7
    // override
    i64 m5(i64 x) => f1 + f1
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => f0 + f0
    i64 m1(i64 x) => 4 * 9
    i64 m2(i64 x) => f1 - f1
    string m3() => $"S02 {6 - f0}"
    // override
    i64 m4(i64 x) => x * x
    // override
    i64 m5(i64 x) => f0 - 7
}

void roS00(S00 v) {
    print($"m2 {v.m2(-2)}")
    print($"m5 {v.m5(7)}")
    print(v.m3())
    print($"m1 {v.m1(4)}")
    print($"m5 {v.m5(-1)}")
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2(-2)}")
    print($"m5 {v.m5(7)}")
    print(v.m3())
    print($"m1 {v.m1(4)}")
    print($"m5 {v.m5(-1)}")
}

