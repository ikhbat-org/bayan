struct Point {
    i64 x
    i64 y
    i64 sum() => x + y
}

union Shape {
    circle(i64 r)
    square(i64 side)
    none
}

i64 area(Shape s) => s switch {
    .circle(let r) => r * r * 3,
    .square(let side) => side * side,
    .none => 0,
}

i64 apply(i64 n, by i64 -> i64 f) => f(n)

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 sumAll(List<i64> xs) {
    var sum: i64 = 0
    for x in xs { sum += x }
    var i = 0
    while i < xs.length { i += 1 }
    return sum + i
}

