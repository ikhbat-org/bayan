interface IGen0 {
    i64 m0(i64 x)
    void m1(ref this, i64 by)
    i64 m2(i64 x)
    string m3() uses alloc => $"m3 {m2(1)} {m0(6)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => 4 + x
    void m1(ref this, i64 by) {
        f0 += by * 1
    }
    i64 m2(i64 x) => f0 + 9
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0(i64 x) => x + 8
    void m1(ref this, i64 by) {
        f0 += by * 2
    }
    i64 m2(i64 x) => f0 + f1
}

void roS00(S00 v) {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    print($"m0 {v.m0(-3)}")
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    v.m1(2)
    print($"m0 {v.m0(-3)}")
}

void roS01(S01 v) {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    print($"m0 {v.m0(-3)}")
}

void rwS01(ref S01 v) {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    v.m1(2)
    print($"m0 {v.m0(-3)}")
}

void roVia0<T>(T v) where T : IGen0 {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    print($"m0 {v.m0(-3)}")
}

void rwVia0<T>(ref T v) where T : IGen0 {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    v.m1(2)
    print($"m0 {v.m0(-3)}")
}

void roDyn0(dyn ref readonly IGen0 v) {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    print($"m0 {v.m0(-3)}")
}

void rwDyn0(dyn ref IGen0 v) {
    print($"m2 {v.m2(4)}")
    print(v.m3())
    v.m1(2)
    print($"m0 {v.m0(-3)}")
}

void main() {
    print("== direct")
    {
        var v = S00 { f0: 5, f1: 8 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 3, f1: -3 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 5, f1: 8 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 3, f1: -3 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 5, f1: 8 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 3, f1: -3 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
}
