bool call0(string a0, by (string -> bool) f) => f(a0)

bool relay0(string a0, by (string -> bool) f) => call0(a0, by: f)

void host0Direct() {
    let r: bool = 5 == 0
    print($"c0 {r}")
}

void host0Local() {
    let f: string -> bool = p0 => 5 == 0
    let r: bool = f("ab")
    print($"c0 {r}")
}

void host0Via1() {
    let r: bool = call0("ab", by: p0 => 5 == 0)
    print($"c0 {r}")
}

void host0Via2() {
    let f: string -> bool = p0 => 5 == 0
    let r: bool = relay0("ab", by: f)
    print($"c0 {r}")
}

i64 call1(string a0, to bool a1, by ((string, bool) -> i64) f) => f(a0, a1)

i64 relay1(string a0, to bool a1, by ((string, bool) -> i64) f) => call1(a0, to: a1, by: f)

void host1Direct(string q0, to i64 q1) {
