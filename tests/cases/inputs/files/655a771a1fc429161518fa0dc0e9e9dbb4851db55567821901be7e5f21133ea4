interface IGen0 {
    i64 m0
    i64 m1
    i64 m2
    string m3() uses alloc => $"m3 {m2} {m0}"
    i64 m4(i64 x) => m2 + m1
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 + f0
    i64 m1 => f0 - f0
    i64 m2 => 5 - f0
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 5 - f0
    i64 m1 => f1 * f1
    i64 m2 => f1 + f1
    // override
    string m3() => $"S01 m3 {7 + f0}"
    // override
    i64 m4(i64 x) => f0 * f1
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 4 + f1
    i64 m1 => f1 * f1
    i64 m2 => 7 * f0
}

void roS00(S00 v) {
    print($"m2 {v.m2}")
    print($"m2 {v.m2}")
    print($"m0 {v.m0}")
    print($"m4 {v.m4(6)}")
    print($"m4 {v.m4(9)}")
    print($"m2 {v.m2}")
    print($"m2 {v.m2}")
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2}")
    print($"m2 {v.m2}")
    print($"m0 {v.m0}")
    print($"m4 {v.m4(6)}")
    print($"m4 {v.m4(9)}")
    print($"m2 {v.m2}")
    print($"m2 {v.m2}")
}

