void main() {
    print("== direct")
    {
        var v = S00 { f0: 0, f1: 5 }
        roS00(v)
        rwS00(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 6, f1: 8 }
        roS01(v)
        rwS01(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 5, f1: -1 }
        roS02(v)
        rwS02(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== constraint")
    {
        var v = S00 { f0: 0, f1: 5 }
        roVia0(v)
        rwVia0(ref v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 6, f1: 8 }
        roVia0(v)
        rwVia0(ref v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 5, f1: -1 }
        roVia0(v)
        rwVia0(ref v)
        print($"S02 {v.f0} {v.f1}")
    }
    print("== dyn")
    {
        var v = S00 { f0: 0, f1: 5 }
        roDyn0(v)
        rwDyn0(v)
        print($"S00 {v.f0} {v.f1}")
    }
    {
        var v = S01 { f0: 6, f1: 8 }
        roDyn0(v)
        rwDyn0(v)
        print($"S01 {v.f0} {v.f1}")
    }
    {
        var v = S02 { f0: 5, f1: -1 }
        roDyn0(v)
        rwDyn0(v)
        print($"S02 {v.f0} {v.f1}")
    }
}
