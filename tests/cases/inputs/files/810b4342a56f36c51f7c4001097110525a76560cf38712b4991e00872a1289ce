struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
    }
    void pay(ref this is .draft, i64 amount) becomes .paid {
        become .paid(amount)
    }
    i64 trackingNumber() {
        switch this {
            case .paid:
                return 1
            default:
                return -1
        }
    }
}

struct Counter {
    i64 n
}

i64? half(i64 n) => n % 2 == 0 ? n / 2 : null

void main() {
    var n = 3
    var o = Counter { n: 0 }
    o.n = 1
    n = 2
    n += 1
    n++
    while n > 0 {
        n -= 1
        continue if n == 1
        break if n == 0
    }
    do {
        n += 1
    } while n < 4
    outer: for i in 0..4 {
        for j in 0..4 {
            continue outer if j > i
            break outer if i == 3
        }
    }
    var m = 40
    while let h = half(m) {
        m = h
    }
    {
        n = 0
    }
    assert n == 0
    using let arena = Arena()
    provide allocator: arena {
        print("x")
    }
}
