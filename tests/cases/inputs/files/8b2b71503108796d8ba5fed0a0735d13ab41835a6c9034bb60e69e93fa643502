    m[K0 { f0: Tint.red, f1: i64(7) }] = 1
    m[make(0)] = 0
    n[make(0)] = 1
    n[K0 { f0: Tint.red, f1: i64(7) }] = 0
    m[K0 { f0: Tint.green, f1: i64(7000028) }] = 1
    m[make(22)] = 22
    n[make(22)] = 1
