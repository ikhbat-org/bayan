    n[make(11)] = 1
    n[K0 { f0: Tint.blue, f1: i64(3000016) }] = 11
    m[K0 { f0: Tint.green, f1: i64(2000013) }] = 1
    m[make(7)] = 7
    n[make(7)] = 1
    n[K0 { f0: Tint.green, f1: i64(2000013) }] = 7
    m[K0 { f0: Tint.blue, f1: i64(4000019) }] = 1
    m[make(14)] = 14
    n[make(14)] = 1
    n[K0 { f0: Tint.blue, f1: i64(4000019) }] = 14
    print($"{m.length} {n.length}")
    print($"{m[make(5)]} {n[K0 { f0: Tint.blue, f1: i64(1000010) }]} {m.contains(K0 { f0: Tint.blue, f1: i64(1000010) })}")
    print($"{m[make(3)]} {n[K0 { f0: Tint.red, f1: i64(1000010) }]} {m.contains(K0 { f0: Tint.red, f1: i64(1000010) })}")
    print($"{m[make(8)]} {n[K0 { f0: Tint.blue, f1: i64(2000013) }]} {m.contains(K0 { f0: Tint.blue, f1: i64(2000013) })}")
    print($"{m[make(0)]} {n[K0 { f0: Tint.red, f1: i64(7) }]} {m.contains(K0 { f0: Tint.red, f1: i64(7) })}")
