enum Tint {
    red
    green
    blue
}

Tint tint(i64 c) {
    if c < 1 {
        return .red
    }
    if c < 2 {
        return .green
    }
    return .blue
}

struct K0 {
    Tint f0
    i64 f1
}

K0 make(i64 code) {
    return K0 { f0: tint(code / 1 % 3), f1: (code / 3 % 8) * 1000003 + 7 }
}

void main() {
    var m = Map<K0, i64>()
    var n = Map<K0, i64>()
    m[K0 { f0: Tint.blue, f1: i64(1000010) }] = 1
    m[make(5)] = 5
    n[make(5)] = 1
    n[K0 { f0: Tint.blue, f1: i64(1000010) }] = 5
    m[K0 { f0: Tint.red, f1: i64(1000010) }] = 1
