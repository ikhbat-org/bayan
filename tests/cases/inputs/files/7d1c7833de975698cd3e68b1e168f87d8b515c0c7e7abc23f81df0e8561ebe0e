interface IGen0 {
    i64 m0
    i64 m1(i64 x)
    i64 m2(i64 x)
    string m3() uses alloc
    i64 m4(i64 x) => m1(x) + m1(2)
    string m5() uses alloc => $"m5 {m0} {m1(6)}"
}

struct S00 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => f0 + f1
    i64 m1(i64 x) => f0 * f0
    i64 m2(i64 x) => f1 - x
    string m3() => $"S00 {f1 + f0}"
    // override
    i64 m4(i64 x) => 8 - 5
    // override
    string m5() => $"S00 m5 {f1 + f0}"
}

struct S01 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 8 - f0
    i64 m1(i64 x) => f1 - 3
    i64 m2(i64 x) => f1 - x
    string m3() => $"S01 {2 * f0}"
    // override
    i64 m4(i64 x) => x + 5
}

struct S02 : IGen0 {
    i64 f0
    i64 f1

    i64 m0 => 1 * 6
    i64 m1(i64 x) => f0 - f0
    i64 m2(i64 x) => f1 - x
    string m3() => $"S02 {f0 + f1}"
    // override
    string m5() => $"S02 m5 {2 * 8}"
}

void roS00(S00 v) {
    print($"m2 {v.m2(-3)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m4 {v.m4(3)}")
    print($"m1 {v.m1(1)}")
    print(v.m5())
    print(v.m3())
}

void rwS00(ref S00 v) {
    print($"m2 {v.m2(-3)}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m0 {v.m0}")
    print($"m4 {v.m4(3)}")
    print($"m1 {v.m1(1)}")
    print(v.m5())
    print(v.m3())
}

