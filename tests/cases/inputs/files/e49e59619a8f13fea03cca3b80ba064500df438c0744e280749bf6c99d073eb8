struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
    }
    bool isPaid => this is .paid
    bool isDraft => this is .draft
    bool isBig => id > 10
    bool isPaidEmpty => this is .paid()
    bool isPaidBound => this is .paid p
    bool ready
    i64 ship(this is .paid) => id
}
i64 run(Order order, Order other) {
    if order.isPaid {
        if other.isPaid {
            return order.ship() + other.ship()
        }
        return order.ship()
    }
    return 0
}
