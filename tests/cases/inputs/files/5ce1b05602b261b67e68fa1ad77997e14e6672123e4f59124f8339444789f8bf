string call0(i64 a0, by (i64 -> string) f) => f(a0)

string relay0(i64 a0, by (i64 -> string) f) => call0(a0, by: f)

void host0Direct(bool q0, to string q1) {
    let r: string = $"{q1}-{9}"
    print($"c0 {r}")
}

void host0Local(bool q0, to string q1) {
    let f: i64 -> string uses alloc = p0 => $"{q1}-{9}"
    let r: string = f(5)
    print($"c0 {r}")
}

void host0Via1(bool q0, to string q1) {
    let r: string = call0(5, by: p0 => $"{q1}-{9}")
    print($"c0 {r}")
}

void host0Via2(bool q0, to string q1) {
    let r: string = relay0(5, by: p0 => $"{q1}-{9}")
    print($"c0 {r}")
}

string call1(i64 a0, to i64 a1, by ((i64, i64) -> string) f) => f(a0, a1)

string relay1(i64 a0, to i64 a1, by ((i64, i64) -> string) f) => call1(a0, to: a1, by: f)

void host1Direct() {
    let p0: i64 = -7
    let p1: i64 = -4
    let r: string = $"{p1}-{p0}"
    print($"c1 {r}")
}

void host1Local() {
    let f: (i64, i64) -> string uses alloc = (p0, p1) => $"{p1}-{p0}"
    let r: string = f(-7, -4)
    print($"c1 {r}")
}

void host1Via1() {
    let r: string = call1(-7, to: -4, by: (p0, p1) => $"{p1}-{p0}")
    print($"c1 {r}")
}

void host1Via2() {
    let r: string = relay1(-7, to: -4, by: (p0, p1) => $"{p1}-{p0}")
    print($"c1 {r}")
}

bool call2(bool a0, to bool a1, by ((bool, bool) -> bool) f) => f(a0, a1)

bool relay2(bool a0, to bool a1, by ((bool, bool) -> bool) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let r: bool = 2 == 0
    print($"c2 {r}")
}

void host2Local() {
    let f: (bool, bool) -> bool = (p0, p1) => 2 == 0
    let r: bool = f(true, true)
    print($"c2 {r}")
}

void host2Via1() {
    let r: bool = call2(a0: true, to: true, by: (p0, p1) => 2 == 0)
    print($"c2 {r}")
}

void host2Via2() {
    let r: bool = relay2(a0: true, to: true, by: (p0, p1) => 2 == 0)
    print($"c2 {r}")
}

bool fn3() {
    return 8 < 2 && 1 < 2
}

bool call3(by (() -> bool) f) => f()

bool relay3(by (() -> bool) f) => call3(by: f)

void host3Direct() {
    let r: bool = fn3()
    print($"c3 {r}")
}

void host3Local() {
    let f: () -> bool = fn3
    let r: bool = f()
    print($"c3 {r}")
}

void host3Via1() {
    let r: bool = call3(by: fn3)
    print($"c3 {r}")
}

void host3Via2() {
    let r: bool = relay3(by: fn3)
    print($"c3 {r}")
}

i64 call4(by (() -> i64) f) => f()

i64 relay4(by (() -> i64) f) => call4(by: f)

void host4Direct(string q0, to i64 q1) {
    let k0: i64 = q1 + 1
    let r: i64 = k0 - q1 + k0
    print($"c4 {r}")
}

void host4Local(string q0, to i64 q1) {
    let k0: i64 = q1 + 1
    let f: () -> i64 = () => k0 - q1 + k0
    let r: i64 = f()
    print($"c4 {r}")
}

void host4Via1(string q0, to i64 q1) {
    let k0: i64 = q1 + 1
    let r: i64 = call4(by: () => k0 - q1 + k0)
    print($"c4 {r}")
}

void host4Via2(string q0, to i64 q1) {
    let k0: i64 = q1 + 1
    let r: i64 = relay4(by: () => k0 - q1 + k0)
    print($"c4 {r}")
}

void main() {
    print("== direct")
    host0Direct(q0: false, to: "")
    host1Direct()
    host2Direct()
    host3Direct()
