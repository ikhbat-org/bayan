    print("== local")
    host0Local(q0: false, to: "")
    host1Local()
    host2Local()
    host3Local()
    host4Local("x", to: 10)
    print("== via1")
    host0Via1(q0: false, to: "")
    host1Via1()
    host2Via1()
    host3Via1()
    host4Via1("x", to: 10)
    print("== via2")
    host0Via2(q0: false, to: "")
