struct Point {
    i64 x
    i64 y
    i64 sum() => x + y
}

union error ParseError {
    empty
    badDigit(i64 at)
}

i64 parseDigit(i64 n) fails ParseError {
    if n < 0 { fail .badDigit(n) }
    return n
}

i64 viaTry(i64 n) fails ParseError {
    let d = try parseDigit(n)
    return d + 1
}

i64 safe(i64 n) => viaTry(n) catch 0

i64 owned(i64 n) {
    var a = List<i64>()
    a.append(n)
    let b = move a
    return b.length
}

i64 orZero(i64? n) => n ?? 0

i64 stock(Map<string, i64> m) => m.length

const limit: i64 = 100

i64 twice(i64 n) => n * 2

test "twice doubles" {
    assert twice(2) == 4
}

void main() {
    var total: i64 = 0
    if total >= 0 {
        total += twice(total)
        total = "text0"
        if total >= 0 {
            total += twice(total)
            if total >= 0 {
                total += orZero(null)
                if total >= 0 {
                    total += owned(total)
                    if total >= 0 {
                        total += Point { x: total, y: 2 }.sum()
                        if total >= 0 {
                            total += owned(total)
                            if total >= 0 {
                                total += owned(total)
                                total += 1
                            }
                        }
                    }
                }
            }
        }
    }
    print($"{total}")
}
