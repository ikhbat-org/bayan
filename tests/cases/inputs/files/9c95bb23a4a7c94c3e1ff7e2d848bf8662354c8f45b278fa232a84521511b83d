i64 call0(by (() -> i64) f) => f()

i64 relay0(by (() -> i64) f) => call0(by: f)

void host0Direct(i64 q0) {
    let r: i64 = q0 - 4 + 7
    print($"c0 {r}")
}

void host0Local(i64 q0) {
    let f: () -> i64 = () => q0 - 4 + 7
    let r: i64 = f()
    print($"c0 {r}")
}

void host0Via1(i64 q0) {
    let r: i64 = call0(by: () => q0 - 4 + 7)
    print($"c0 {r}")
}

void host0Via2(i64 q0) {
    let r: i64 = relay0(by: () => q0 - 4 + 7)
    print($"c0 {r}")
}

string call1(bool a0, by (bool -> string) f) => f(a0)

string relay1(bool a0, by (bool -> string) f) => call1(a0, by: f)

void host1Direct() {
    let p0: bool = false
    let r: string = $"{p0}-{p0}"
    print($"c1 {r}")
}

void host1Local() {
    let f: bool -> string uses alloc = p0 => $"{p0}-{p0}"
    let r: string = f(false)
    print($"c1 {r}")
}

void host1Via1() {
    let r: string = call1(a0: false, by: p0 => $"{p0}-{p0}")
    print($"c1 {r}")
}

void host1Via2() {
    let r: string = relay1(a0: false, by: $"{it}-{it}")
    print($"c1 {r}")
}

i64 call2(i64 a0, to i64 a1, by ((i64, i64) -> i64) f) => f(a0, a1)

i64 relay2(i64 a0, to i64 a1, by ((i64, i64) -> i64) f) => call2(a0, to: a1, by: f)

void host2Direct() {
    let p0: i64 = -1
    let p1: i64 = 0
    let r: i64 = p1 - p0
    print($"c2 {r}")
}

void host2Local() {
    let f: (i64, i64) -> i64 = (p0, p1) => {
        return p1 - p0
    }
    let r: i64 = f(-1, 0)
    print($"c2 {r}")
}

void host2Via1() {
    let r: i64 = call2(-1, to: 0, by: (p0, p1) => {
        return p1 - p0
    })
    print($"c2 {r}")
}

void host2Via2() {
    let r: i64 = relay2(-1, to: 0, by: (p0, p1) => {
        return p1 - p0
    })
    print($"c2 {r}")
}

i64 call3(by (() -> i64) f) => f()

i64 relay3(by (() -> i64) f) => call3(by: f)

void host3Direct(i64 q0, to string q1) {
    let k0: i64 = -2
    let r: i64 = q0 + q0 - k0
    print($"c3 {r}")
}

void host3Local(i64 q0, to string q1) {
    let k0: i64 = -2
    let f: () -> i64 = () => q0 + q0 - k0
    let r: i64 = f()
    print($"c3 {r}")
}

void host3Via1(i64 q0, to string q1) {
    let k0: i64 = -2
    let r: i64 = call3(by: () => q0 + q0 - k0)
    print($"c3 {r}")
}

void host3Via2(i64 q0, to string q1) {
    let k0: i64 = -2
    let f: () -> i64 = () => q0 + q0 - k0
    let r: i64 = relay3(by: f)
    print($"c3 {r}")
}

string fn4(bool p0, to string p1) => $"{p0}-{1}"

string call4(bool a0, to string a1, by ((bool, string) -> string) f) => f(a0, a1)

string relay4(bool a0, to string a1, by ((bool, string) -> string) f) => call4(a0, to: a1, by: f)

void host4Direct() {
    let r: string = fn4(p0: true, to: "x")
    print($"c4 {r}")
}

void host4Local() {
    let f: (bool, string) -> string uses alloc = fn4
    let r: string = f(true, "x")
    print($"c4 {r}")
}

void host4Via1() {
    let r: string = call4(a0: true, to: "x", by: fn4)
    print($"c4 {r}")
}

void host4Via2() {
    let r: string = relay4(a0: true, to: "x", by: fn4)
    print($"c4 {r}")
}

i64 call5(string a0, to i64 a1, by ((string, i64) -> i64) f) => f(a0, a1)

i64 relay5(string a0, to i64 a1, by ((string, i64) -> i64) f) => call5(a0, to: a1, by: f)

void host5Direct(string q0, to i64 q1) {
    let k0: i64 = q1 + 4
    let r: i64 = 7 + q1 - k0
    print($"c5 {r}")
}

void host5Local(string q0, to i64 q1) {
    let k0: i64 = q1 + 4
    let f: (string, i64) -> i64 = (p0, p1) => 7 + q1 - k0
    let r: i64 = f("x", -9)
    print($"c5 {r}")
}

void host5Via1(string q0, to i64 q1) {
    let k0: i64 = q1 + 4
    let r: i64 = call5("x", to: -9, by: (p0, p1) => 7 + q1 - k0)
    print($"c5 {r}")
}

void host5Via2(string q0, to i64 q1) {
    let k0: i64 = q1 + 4
    let r: i64 = relay5("x", to: -9, by: (p0, p1) => 7 + q1 - k0)
    print($"c5 {r}")
}

