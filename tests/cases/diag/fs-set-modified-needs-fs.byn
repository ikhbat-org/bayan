// `Fs.setModified` reads or writes the file system, so a public function calling it declares `fs` (BYN6002).
public void undeclared(string p) fails IoError {
    try Fs.setModified(p, to: Time.fromNanos(0))
}

public void declared(string p) uses fs fails IoError {
    try Fs.setModified(p, to: Time.fromNanos(0))
}

void main() {
    print("ok")
}
