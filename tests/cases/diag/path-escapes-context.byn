// `Path.fileName` and `Path.relative` allocate from `context.allocator`, so a result made inside `provide` borrows that arena.
void main() {
    var name = ""
    var rel = ""
    {
        using let arena = Arena()
        provide allocator: arena {
            print(Path.fileName("/a/inside"))
            name = Path.fileName("/a/b.txt")
            rel = Path.relative(from: "/a", to: "/a/b")
        }
    }
    print(name)
    print(rel)
}
