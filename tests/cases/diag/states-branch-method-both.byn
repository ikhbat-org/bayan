struct Order {
    states {
        draft(string msg)
        paid(i64 code)
    }
    void pay(ref this is .draft) becomes .paid {
        become .paid(42)
    }
    void draftOnly(this is .draft) {
        print(msg)
    }
    void paidOnly(this is .paid) {
        print($"{code}")
    }
}
struct Gate {
    states {
        shut
        ajar(i64 width)
    }
    void open(ref this is .shut, bool wide) becomes .ajar {
        if wide {
            become .ajar(2)
        } else {
            become .ajar(1)
        }
        widthOnly()
    }
    void widthOnly(this is .ajar) {
        print($"{width}")
    }
}
void main() {
    var o = Order.draft { msg: "hi" }
    o.pay()
    var g = Gate.shut {}
    g.open(wide: true)
}
