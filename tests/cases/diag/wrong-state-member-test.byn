struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
    }
    bool isPaid => this is .paid
    bool isPaidAndBig => (this is .paid) and id > 10
    i64 ship(this is .paid) => id
}

i64 run(Order order) {
    if order.isPaid {
        return order.ship()
    }
    if order.isPaidAndBig {
        return order.ship()
    }
    return 0
}
