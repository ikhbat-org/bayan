union error E {
    bad
}

void step() fails E { }

void run() fails E {
    var xs = List<i64>()
    xs.append(7)
    var s: ReadOnlySpan<i64> = []
    for i in 0..100 {
        print($"{s.length}")
        defer failing xs.append(i)
        s = xs.span
        try step()
    }
}

void main() {
    run() catch { print("e") }
}
