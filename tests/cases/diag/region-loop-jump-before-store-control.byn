void main() {
    var xs = List<i64>()
    let ys = List<i64>()
    var s: ReadOnlySpan<i64> = []
    outer: for k in 0..3 {
        if s.length > 0 { print($"{s[0]}") }
        for j in 0..3 {
            if j == 2 && k == 1 {
                s = ys.span
                continue outer
            }
            xs.append(j)
        }
        s = xs.span
    }
}
