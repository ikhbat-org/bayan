struct Order {
    states {
        draft(string msg)
        paid(i64 code)
    }
    void pay(ref this is .draft) becomes .paid {
        become .paid(42)
    }
    void draftOnly(this is .draft) {
        print(msg)
    }
    void paidOnly(this is .paid) {
        print($"{code}")
    }
}
void run(bool flag, i64 n) {
    var o = Order.draft { msg: "hi" }
    var i: i64 = 0
    while i < n {
        o = Order.paid { code: 1 }
        i += 1
    }
    if flag {
        o = Order.paid { code: 2 }
    }
    o.paidOnly()
}
void main() { run(flag: false, n: 0) }
