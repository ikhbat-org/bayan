// InterfaceUseTests.ConformingValuesConvertToDynRef: a conformer converts to `dyn ref` and to `dyn ref readonly`, through a
// return, a generic `ref T` and a `let`; no diagnostic.
interface IShape {
    i64 area()
    string describe() => $"area {area()}"
}

struct Circle : IShape {
    i64 r

    i64 area() => 3 * r * r
}

struct Square {
    i64 side
}

void show(dyn ref IShape s) => print(s.describe())

void peek(dyn ref readonly IShape s) => print($"{s.area()}")

dyn ref IShape pick(ref Circle c) => c

void forward<T>(ref T shape) where T : IShape {
    show(shape)
    let r: dyn ref readonly IShape = shape
    peek(r)
}

void run() {
    var c = Circle { r: 2 }
    show(c)
    let d: dyn ref IShape = c
    peek(d)
    peek(pick(ref c))
    forward(ref c)
}

run()
