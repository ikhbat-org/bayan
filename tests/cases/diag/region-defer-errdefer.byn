union error StepError {
    /// The step was told to fail.
    told
}

i64 work(bool shouldFail) fails StepError {
    var xs = List<i64>()
    xs.append(5)
    let s = xs.span
    defer failing print($"{s[0]}")
    for i in 0..100 { xs.append(i) }
    fail .told if shouldFail
    return xs.length
}

void main() {
    let n = work(shouldFail: false) catch 0
    print($"{n}")
}
