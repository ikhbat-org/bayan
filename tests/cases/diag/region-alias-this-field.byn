void g(ref List<i64> xs, from ReadOnlySpan<i64> s) {
    for i in 0..100 { xs.append(i) }
    print($"{s[0]}")
}
struct S {
    List<i64> xs
    void f(ref this) {
        g(ref this.xs, from: this.xs.span)
    }
}
void main() {
    var obj = S { xs: List<i64>() }
    obj.xs.append(5)
    obj.f()
}
