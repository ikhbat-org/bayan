interface IBump {
    void bump(ref this)
}

struct Inner : IBump {
    i64 x

    void bump(ref this) {
        x = -5
    }
}

struct Outer {
    Inner inner requires it.x > 0
    i64 n requires it > 0
    List<i64> items requires it.length > 0
    Map<string, i64> m requires it.length > 0

    void own(ref this) {
        set(ref n)
        set(ref inner.x)
        fill(out inner)
        inner.x = -7
        inner.bump()
        items.clear()
        items[0] = 3
        m["a"] = 1
        poke(inner)
    }
}

void set(ref i64 v) {
    v = -1
}

void fill(out Inner v) {
    v = Inner { x: -2 }
}

void poke(dyn ref IBump r) {
    r.bump()
}
