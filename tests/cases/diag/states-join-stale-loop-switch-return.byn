struct Order {
    states {
        draft(string msg)
        paid(i64 code)
    }
    void pay(ref this is .draft) becomes .paid {
        become .paid(42)
    }
    void draftOnly(this is .draft) {
        print(msg)
    }
    void paidOnly(this is .paid) {
        print($"{code}")
    }
}
void run(i64 k, by i64 n) {
    var o = Order.draft { msg: "hi" }
    var i: i64 = 0
    while i < n {
        o = Order.paid { code: 1 }
        i += 1
    }
    switch k {
        case 1:
            return
    }
    o.paidOnly()
}
void main() { run(0, by: 0) }
