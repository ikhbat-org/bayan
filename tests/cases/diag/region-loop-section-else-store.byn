void main() {
    var xs = List<i64>()
    var s: ReadOnlySpan<i64> = []
    for i in 0..10 {
        switch i % 2 {
            case 0:
                xs.append(i)
                if i > 4 {
                    print("x")
                } else {
                    s = xs.span
                }
            default:
                print("y")
        }
    }
    print($"{s.length}")
}
