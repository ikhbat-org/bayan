struct Row {
    List<i32> items
}

void curve(Span<i32> xs, by i32 bonus) {
    for i in 0..xs.length {
        xs[i] = xs[i] + bonus
    }
}

void main() {
    var a: List<i32> = [72, 91, 85]
    curve(a[1..3], by: 5)
    var b: List<i32> = [1, 2, 3, 4]
    curve(b[1..][0..2], by: 1)
    var r = Row { items: [1, 2, 3] }
    curve(r.items[0..2], by: 1)
    var d: i32[3] = [1, 2, 3]
    curve(d[..^1], by: 1)
    var e: List<i32> = [1, 2, 3]
    curve(e[0..=1], by: 1)
    var g: List<i32> = [1, 2, 3]
    let gs: Span<i32> = g[0..2]
    var h: List<i32> = [1, 2, 3]
    let hs = h[0..2]
    hs[0] = 1
    var k: List<i32> = [1, 2, 3]
    let ks = k[1..]
    curve(ks, by: 1)
    print($"{a[0]} {b[0]} {r.items[0]} {d[0]} {e[0]} {gs.length} {h[0]} {k[1]}")
}
