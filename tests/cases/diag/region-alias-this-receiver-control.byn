struct S {
    List<i64> xs
    List<i64> ys
    void f(ref this, ReadOnlySpan<i64> s) {
        for i in 0..100 { this.xs.append(i) }
        print($"{s[0]}")
    }
    void g(ref this) {
        this.f(this.ys.span)
    }
}
void main() {
    var obj = S { xs: List<i64>(), ys: List<i64>() }
    obj.ys.append(5)
    obj.g()
}
