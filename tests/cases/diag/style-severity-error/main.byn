// `lints: ["guards.postfix": .error]`: the lint is an error, so `bayan check` fails.
union error CartError {
    empty
}

void check(List<i32> lines) fails CartError {
    if lines.isEmpty {
        fail .empty
    }
}

void main() fails CartError {
    let lines: List<i32> = [1]
    try check(lines)
}
