List<string> f(ref Arena a) uses alloc {
    let buf = stackalloc u8[16]
    var sb = StrBuf(buf)
    sb.append("hi")
    var xs = List<string>()
    xs.append(sb.view)
    var ys = List<string>()
    provide allocator: a { ys = xs.copy() }
    return ys
}
void main() uses alloc {
    var a = Arena()
    let xs = f(ref a)
    print(xs[0])
}
