// BYN1077: `bayan fix` refills each banner to column 80; the fixed copy prints the same.

// ── Short ─────
i32 one() => 1

// ── Long ─────────────────────────────────────────────────────────────────────────────
i32 two() => 2

void main() {
    // ── Inside a body ───
    print($"{one()}{two()}")
}
