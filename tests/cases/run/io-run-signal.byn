// os: unix
// A child killed by a signal fails `Io.run` with `.signaled`, whose payload is the signal number (no 128 + n exit code).
void main() {
    let killed: string[2] = ["-c", "kill -9 $$"]
    let r = Io.run("sh", killed.span) catch switch {
        .signaled(let s) => {
            print($"signaled {s}")
            return
        },
        IoError e => {
            print($"io {e}")
            return
        },
    }
    print($"exit {r.exitCode}")
}
