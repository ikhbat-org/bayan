// A `ref this` map-field store (Q747) of an arena value returned through two levels, and a store through an `out` parameter (Q745) in the same function compile when the borrower lives inside the arena block.
string mk(string s, from Arena a) {
    return s.copy(to: a)
}

string mk2(string s, from Arena a) {
    return mk(s, from: a)
}

struct Bag {
    Map<i64, string> m

    void put(ref this, string v) {
        m[1] = v
    }
}

void pass(string s, to out string g) {
    g = s
}

void main() {
    {
        using let arena = Arena()
        var b = Bag { m: Map<i64, string>() }
        var kept = ""
        let name = mk2("ann", from: arena)
        b.put(name)
        pass(name, to: out kept)
        print(b.m[1])
        print(kept)
    }
}
