== diag/for-dyn-ref-variable-borrows.byn
interface IThing {
    i64 get()
}

struct S : IThing {
    i64 n

    i64 get() => n
}

// The variable of `for x: dyn ref I in xs` points into `xs`: kept past the loop, it still borrows `xs`.
void main() {
    var keep = List<S>()
    keep.append(S { n: 7 })
    var xs = List<S>()
    xs.append(S { n: 1 })
    var d: dyn ref IThing = keep[0]
    for x: dyn ref IThing in xs {
        d = x
    }
    for i in 0..100 {
        xs.append(S { n: i })
    }
    print($"{d.get()}")
    var e: dyn ref readonly IThing = keep[0]
    for x: dyn ref readonly IThing in xs {
        e = x
    }
    xs.clear()
    print($"{e.get()}")
}
