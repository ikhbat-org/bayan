// A function returning a span lends a `ref` argument only when the argument has storage to point into: a plain struct does not.
struct C {
    i64 n

    void bump(ref this) {
        n += 1
    }
}

ReadOnlySpan<i64> pick(ref C c, from ReadOnlySpan<i64> xs) {
    c.n += 1
    return xs
}

void main() {
    var xs = List<i64>()
    xs.append(1)
    var c = C { n: 0 }
    let s = pick(ref c, from: xs.span)
    c.bump()
