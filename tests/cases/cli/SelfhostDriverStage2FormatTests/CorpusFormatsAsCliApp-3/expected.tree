union error ReadError { broken }

struct Rows {
    i64 at
    i64 limit

    i64? next(ref this) fails ReadError {
        if at >= limit {
            return null
        }
        at += 1
        return at
    }
}

void run() fails ReadError {
    var rows = Rows { at: 0, limit: 5 }
    for try row in rows {
        print($"row {row}")
        break if row == 2
    }
    print($"rows.at {rows.at}")
}

try run()
== run/for-try.byn
union error ReadError { broken }

/// Yields 1..limit; fails on the step after `failAt` when `failAt` is set.
struct Rows {
    i64 at
    i64 limit
    i64 failAt

    i64? next(ref this) fails ReadError {
        if failAt > 0 && at == failAt {
            fail .broken
        }
        if at >= limit {
            return null
        }
        at += 1
        return at
    }
}

i64 total(through i64 limit, at i64 failAt) fails ReadError {
    var sum = 0
    for try row in (Rows { at: 0, limit: limit, failAt: failAt }) {
        print($"row {row}")
        continue if row == 2
        sum += row
    }
    return sum
}

print($"total {try total(through: 4, at: 0)}")
let failed = total(through: 4, at: 3) catch -1
print($"failed {failed}")
== run/for-user-break-defer.byn
struct Digits : IIndexable {
    type Item = i64

    i64 size

    i64 count => size

    i64 get(i64 index) => index * 10
}

struct Countdown : IEnumerator {
    type Item = i64

    i64 left

    bool moveNext(ref this) {
        left -= 1
        return left >= 0
    }

    i64 current => left
}

void indexed() {
    defer print("indexed deferred")
    let digits = Digits { size: 5 }
    var seen = 0
    for d in digits {
        defer print($"after {d}")
        seen += 1
        print($"saw {d}")
        break if seen == 2
    }
    print($"indexed saw {seen}")
}

void enumerated() {
    defer print("enumerated deferred")
    var steps = Countdown { left: 5 }
    var seen = 0
    for n in steps {
        defer print($"after {n}")
        seen += 1
        print($"saw {n}")
        break if seen == 2
    }
    print($"enumerated saw {seen}, left {steps.left}")
}

void main() {
    indexed()
    enumerated()
}
