== run/io-run-directory.byn
// os: unix
// `Io.run(…, directory:)` runs the child there; a directory that does not exist, or a file, fails before anything starts.
string listIn(string dir) fails IoError {
    let ls: string[2] = ["-c", "ls; echo > ../started.txt"]
    let r = try Io.run("sh", ls.span, directory: dir)
    return $"exit {r.exitCode}, [{r.stdout}]"
}

string describe(string dir) => listIn(dir) catch switch {
    .notFound      => "not found",
    .notADirectory => "not a directory",
    _              => "some other error",
}

void main() fails IoError {
    try Io.createDirectory("sub")
    let marker: u8[2] = [104, 105]
    try Io.writeFile("sub/marker.txt", marker.span)
    print(describe("sub"))
    try Io.remove("started.txt")
    print(describe("no-such-dir"))
    print(describe("sub/marker.txt"))
    // Nothing started for either: the child would have written `started.txt` beside `sub`.
    print((try Io.listDir(".")).joined(by: ", "))
    // Without `directory:` the child runs in ours.
    let here: string[2] = ["-c", "ls"]
    print((try Io.run("sh", here.span)).stdout)
}
== run/io-run-env-path.byn
// os: unix
// A bare program name is searched in our PATH, not the child's: `env: PATH` reaches the child but does not change which
// `sh` runs, with or without `directory:` (plan 007, Q1247).
void main() fails IoError {
    try Io.createDirectory("bin")
    let setup: string[2] = ["-c", "printf '#!/bin/sh\\necho decoy\\n' > bin/sh && chmod +x bin/sh"]
    let _ = try Io.run("sh", setup.span)
    var env = Map<string, string?>()
    env["PATH"] = "bin"
    let show: string[2] = ["-c", "echo \"real sh, PATH=$PATH\""]
    print((try Io.run("sh", show.span, env: env)).stdout)
    print((try Io.run("sh", show.span, directory: ".", env: env)).stdout)
}
== run/io-run-env-unset.byn
// os: unix
// A null `env:` value removes the inherited variable of its name; a string still adds or overrides one, and the others
// stay visible (plan 007).
void main() fails IoError {
    let show: string[2] = [
        "-c",
        "printf '%s|%s|%s\\n' \"${HOME-unset}\" \"${BAYAN_T5_ADDED-unset}\" \"${PATH:+path inherited}\"",
    ]
    var env = Map<string, string?>()
    env["HOME"] = null
    env["BAYAN_T5_ADDED"] = "added"
    print((try Io.run("sh", show.span, env: env)).stdout)
    // The same name overridden instead, and a removed entry is not passed at all.
    env["HOME"] = "/overridden"
    let _ = env.remove("BAYAN_T5_ADDED")
    print((try Io.run("sh", show.span, env: env)).stdout)
    // Unsetting a name the environment does not have changes nothing.
    var absent = Map<string, string?>()
    absent["BAYAN_T5_ABSENT"] = null
    let probe: string[2] = ["-c", "printf '[%s]\\n' \"${BAYAN_T5_ABSENT-unset}\""]
    print((try Io.run("sh", probe.span, env: absent)).stdout)
}
== run/io-run-env.byn
// os: unix
// `Io.run(…, env:)` adds or overrides variables over the inherited environment; the others stay visible.
void main() fails IoError {
    let show: string[2] = ["-c", "printf '%s|%s|%s\\n' \"$BAYAN_T5_ADDED\" \"$HOME\" \"${PATH:+path inherited}\""]
    var env = Map<string, string?>()
    env["BAYAN_T5_ADDED"] = "added"
    env["HOME"] = "/overridden"
    print((try Io.run("sh", show.span, env: env)).stdout)
    // The map is only read: it is still ours after the call.
    print($"{env.length} entries")
    // An empty map changes nothing.
    let empty = Map<string, string?>()
    let added: string[2] = ["-c", "printf '[%s]\\n' \"$BAYAN_T5_ADDED\""]
    print((try Io.run("sh", added.span, env: empty)).stdout)
}
