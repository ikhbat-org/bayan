// Overloads differ by particle set; a call picks the one its labels fit.

struct Pos {
    i64 x

    Pos plus(by i64 d) => Pos { x: x + d }

    Pos plus(from i64 a, to i64 b) => Pos { x: x - a + b }
}

i64 shift(i64 x, by i64 d) => x + d
i64 shift(i64 x, from i64 a, to i64 b) => x - a + b

let p = Pos { x: 1 }
print($"{p.plus(by: 2).x} {p.plus(from: 1, to: 9).x}")
print($"{shift(1, by: 2)} {shift(1, from: 2, to: 5)}")
== run/owned-expr.byn
union Expr {
    lit(i64 v)
    add(Owned<Expr> l, Owned<Expr> r)
    mul(Owned<Expr> l, Owned<Expr> r)
}

i64 eval(Expr e) => e switch {
    .lit(let v)        => v,
    .add(let l, let r) => eval(l.value) + eval(r.value),
    .mul(let l, let r) => eval(l.value) * eval(r.value),
}

// n + (n - 1) + ... + 1, built recursively.
Expr sum(i64 n) {
    if n == 1 {
        return .lit(1)
    }
    return .add(Owned(Expr.lit(n)), Owned(sum(n - 1)))
}

// (1 + 2) * sum(4), built fresh each call.
Expr sample() => Expr.mul(Owned(Expr.add(Owned(Expr.lit(1)), Owned(Expr.lit(2)))), Owned(sum(4)))

i64 depth(Expr e) {
    switch e {
        case .lit(_):
            return 1
        case .add(let l, let r):
            let a = depth(l.value)
            let b = depth(r.value)
            return 1 + (a > b ? a : b)
        case .mul(let l, let r):
            let a = depth(l.value)
            let b = depth(r.value)
            return 1 + (a > b ? a : b)
    }
}

void main() {
    using let arena = Arena()
    provide allocator: arena {
        let left = Expr.add(Owned(Expr.lit(1)), Owned(Expr.lit(2)))
        let e = sample()
        print($"{e}")
        print($"{eval(e)} {depth(e)}")
        let shared = Owned(sample())
        let copy = Owned(sample())
        print($"{copy.value == e} {eval(copy.value)}")
        let again = sample()
        print($"{again == e} {again == left} {shared == copy}")
        print($"{eval(sum(1000))}")
    }
}
== run/owned-list.byn
struct Node {
    i64 item
    Owned<Node>? next

    void formatInto(ref StrBuf sb) {
        sb.append($"Node {{ item: {item}, next: {next} }}")
    }

    i64 total() {
        if (next is { } n) {
            return item + n.total()
        }
        return item
    }
}

struct Tree {
    string     name
    List<Tree> children
}

Owned<Node>? push(i64 item, to move Owned<Node>? head) => Owned(Node { item: item, next: move head })

string show(Owned<Node>? head) {
    if (head is { } n) {
        return $"{n.item} {show(n.next)}"
    }
    return ""
}

i64 count(Tree t) {
    var n: i64 = 1
    for c in t.children {
        n += count(c)
    }
    return n
}

void main() {
    using let arena = Arena()
    provide allocator: arena {
        var head: Owned<Node>? = null
        for i in 1..6 {
            head = push(i, to: move head)
        }
        print(show(head))
        if (head is not { } h) {
            return
        }
        print($"{h.total()} {h.item} {h.value.item}")
        let two = Owned(Node { item: 2, next: Owned(Node { item: 1, next: null }) })
        print($"{two}")
        print($"{two == Owned(Node { item: 2, next: Owned(Node { item: 1, next: null }) })} {two == h}")

        var root = Tree { name: "root", children: List<Tree>() }
        var leaf = Tree { name: "leaf", children: List<Tree>() }
        leaf.children.append(Tree { name: "deep", children: List<Tree>() })
        root.children.append(move leaf)
        root.children.append(Tree { name: "other", children: List<Tree>() })
        print($"{count(root)}")
    }
}
