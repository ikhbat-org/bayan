    b++
    b--
    ++b
    _ = f()
    if a > 0 {
        print("pos")
    } else if a < 0 {
        print("neg")
    } else {
        print("zero")
    }
    unless ok {
        retry()
    }
    while b > 0 {
        b--
    }
    do {
        b++
    } while b < 10
    for i in 0..10 {
        total += i
    }
    for x in xs {
        print(x)
    }
    for i: i64 in 0..=n {}
    for y in ys {}
    outer: for row in grid {
        for cell in row {
            break outer if cell == 0
            continue outer
        }
    }
    defer close(f)
    defer failing rollback()
    defer failing(e) {
        log(e)
    }
    provide allocator: arena {
        work()
    }
    {
        nested()
    }

    return
}
