== run/io-run-named.byn
// os: unix
// `Io.run`'s named arguments `directory:`, `input:` and `env:` come after `args`, in any subset and order;
// one left out keeps today's behavior for that aspect.
void main() fails IoError {
    try Io.createDirectory("sub")
    let mark: u8[1] = [49]
    try Io.writeFile("sub/in-sub", mark.span)
    let script: string[2] = [
        "-c",
        "if [ -f in-sub ]; then printf sub; else printf here; fi; printf ':%s:' \"$BAYAN_T5_NAMED\"; cat; echo",
    ]
    let input: u8[2] = [105, 110]
    var env = Map<string, string?>()
    env["BAYAN_T5_NAMED"] = "env"
    let none: List<u8> = List<u8>()
    print((try Io.run("sh", script.span, input: none.span)).stdout)
    print((try Io.run("sh", script.span, directory: "sub", input: none.span)).stdout)
    print((try Io.run("sh", script.span, input: input.span)).stdout)
    print((try Io.run("sh", script.span, env: env, input: none.span)).stdout)
    print((try Io.run("sh", script.span, env: env, input: input.span, directory: "sub")).stdout)
    print((try Io.run("sh", script.span, directory: "sub", env: env, input: input.span)).stdout)
    let plain: string[2] = ["-c", "printf '[%s]' \"$BAYAN_T5_NAMED\""]
    print((try Io.run("sh", plain.span, directory: "sub")).stdout)
    print((try Io.run("sh", plain.span, env: env, directory: "sub")).stdout)
}
== run/io-run-omitted.byn
// os: unix
// With `timeout:` each stream keeps its first and last 64 KiB; what lies between shows as one `… N bytes omitted …` line,
// and a character cut at either end is U+FFFD (Q1227, as the C# test runner's `BoundedCapture`). Without `timeout:` every
// byte is kept.
void main() fails IoError {
    let script: string[2] = [
        "-c",
        "head -c 65535 /dev/zero | tr '\\000' a; printf '\\303\\251'; head -c 70000 /dev/zero | tr '\\000' b; printf '\\303\\251'; head -c 65535 /dev/zero | tr '\\000' c",
    ]
    let bounded = try Io.run("sh", script.span, timeout: Millis(60000))
    let s = bounded.stdout
    let first = s.position("\n") ?? -1
    let last = s.lastPosition("\n") ?? -1
    print(
        $"exit {bounded.exitCode}, {s.bytes.length} bytes, head {first} bytes, tail {s.bytes.length - last - 1} bytes",
    )
    print(Utf8.decode(s.bytes[first + 1..last], invalid: .replace))
    print($"replaced {s.count("\u{FFFD}")}")
    let whole = try Io.run("sh", script.span)
    print($"whole {whole.stdout.bytes.length} bytes")
}
== run/io-run-relative-program.byn
// os: unix
// A program named with a `/` is found against our directory, not the `directory:` the child runs in: `./tool` with
// `directory: "sub"` runs our `tool` (in `sub`), not `sub/tool`, as it does without `directory:` (plan 007, Q1247).
void main() fails IoError {
    let setup: string[2] = [
        "-c",
        "mkdir -p sub && printf '#!/bin/sh\\n[ \"${PWD##*/}\" = sub ] && echo ours in sub || echo ours here\\n' > tool && printf '#!/bin/sh\\necho theirs\\n' > sub/tool && chmod +x tool sub/tool",
    ]
    let _ = try Io.run("sh", setup.span)
    let none: string[1] = [""]
    print((try Io.run("./tool", none.span)).stdout)
    print((try Io.run("./tool", none.span, directory: "sub")).stdout)
}
== run/io-run-signal.byn
// os: unix
// A child killed by a signal fails `Io.run` with `.signaled`, whose payload is the signal number (no 128 + n exit code)
// and what the child wrote to each stream before it died (Q1157).
void main() {
    let killed: string[2] = ["-c", "printf o; printf e >&2; kill -9 $$"]
    let r = Io.run("sh", killed.span) catch switch {
        .signaled(let s, let output, let errors) => {
            print($"signaled {s} stdout '{output}' stderr '{errors}'")
            return
        },
        IoError e => {
            print($"io {e}")
            return
        },
    }
    print($"exit {r.exitCode}")
}
