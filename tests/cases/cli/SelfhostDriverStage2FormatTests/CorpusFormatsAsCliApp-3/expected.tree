== diag/valid-control-flow.byn
union error ParseError {
    /// Nothing to parse.
    empty
    /// Not a digit.
    notDigit
}

i64 parse(string s) fails ParseError {
    fail .empty if s.isEmpty
    return 1
}

i64 sign(i64 n) {
    if n < 0 {
        return -1
    }
    return n == 0 ? 0 : 1
}

never stop() {
    panic("stop")
}

i64 classify(i64 n) => n switch {
    < 0 => -1,
    0   => 0,
    _   => 1,
}

i64 safe(string s) => parse(s) catch 0

i64 relay(string s) fails ParseError => try parse(s)

i64 handled(string s) => parse(s) catch switch {
    .empty    => 0,
    .notDigit => -1,
}

outer: for i in 0..3 {
    for j in 0..3 {
        continue outer if j == i
        break outer if i == 2
    }
}
