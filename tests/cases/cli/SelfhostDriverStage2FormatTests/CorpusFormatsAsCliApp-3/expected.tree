// A literal symbol and `Symbol.intern` of the same text built at run time are one symbol (spec 008 R2, R3).
void main() {
    let a: Symbol = "total"
    var buf = StrBuf(capacity: 16)
    buf.append("tot")
    buf.append("al")
    let b = Symbol.intern(buf.view)
    print($"{a == b}")
    let c = Symbol.intern("totals")
    print($"{a == c}")
}
== run/symbol-literals.byn
// Each position where a string literal becomes a `Symbol` keeps its text (spec 008 R2, R4).
struct Entry {
    Symbol name = "entry"
    i32    rank
}

Symbol same(Symbol a) => a

Symbol keyword() {
    return "let"
}

void main() {
    let typed: Symbol = "total"
    var mutable: Symbol = """raw"""
    let optional: Symbol? = "maybe"
    let entry = Entry { name: "field", rank: 1 }
    let defaulted = Entry { rank: 2 }
    let names: List<Symbol> = ["x", "y"]
    let keys: Map<Symbol, i32> = ["one": 1, "two": 2]
    print(typed.text)
    print(mutable.text)
    print($"{optional ?? "none"}")
    print(same("argument").text)
    print(entry.name.text)
    print(defaulted.name.text)
    print(keyword().text)
    print($"{names[0]}{names[1]}")
    for (key, value) in keys {
        print($"{key} {value}")
    }
    print($"{"total" == typed} {typed != "totals"} {typed < "u"} {"a" <= typed} {typed > "a"} {"z" >= typed}")
    mutable = "other"
    print($"[{mutable}]")
}
== run/symbol-order.byn
// Symbols order by text, whatever order they were interned in (spec 008 R1).
Symbol read(string text) uses alloc {
    var buf = StrBuf(capacity: 4)
    buf.append(text)
    return Symbol.intern(buf.view)
}

void main() {
    // Literals, then the same texts interned at run time `b` first.
    let x: Symbol = "b"
    let y: Symbol = "a"
    print($"{y < x}")
    print($"{x}{y}")
    let rx = read("b")
    let ry = read("a")
    print($"{ry < rx}")
    print($"{rx}{ry}")
    // Texts no literal holds, interned `d` first, so their IDs run against their order.
    let d = read("d")
    let c = read("c")
    print($"{c < d} {c <= d} {d > c} {d >= c} {d < c}")
    print($"{d}{c}")
}
