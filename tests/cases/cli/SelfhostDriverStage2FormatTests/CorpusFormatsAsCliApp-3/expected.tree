// A failing `main` exits with the variant's `[ExitCode(n)]`, or 1 without one.
union error ConfigError {
    /// The configuration file is missing.
    missing
    /// The configuration is malformed.
    @exitCode(3)
    malformed
}

void load(bool broken) fails ConfigError {
    fail .malformed if broken
}

void main() fails ConfigError {
    try load(broken: false)
    print("loaded once")
    try load(broken: true)
    print("not reached")
}
== run/map-basics.byn
enum Suit {
    clubs
    diamonds
    hearts
    spades
}

struct Inventory {
    string owner
    Map<string, i64> stock

    void formatInto(ref StrBuf sb) {
        sb.append($"Inventory {{ owner: {owner}, stock: {stock} }}")
    }
}

void restock(ref Inventory inv, for string item, by i64 n) {
    let have = inv.stock.tryGet(at: item) ?? 0
    inv.stock[item] = have + n
}

// String keys: updates keep the first position, a removed key goes to the end when re-inserted.
var prices = Map<string, i64>()
prices["tea"] = 3
prices["cake"] = 5
prices["jam"] = 2
prices["tea"] = 4
print($"{prices} count={prices.length}")
if prices.contains("cake") {
    print($"cake costs {prices["cake"]}")
}
print($"scone: {prices.tryGet(at: "scone") ?? 0}")
print($"has jam: {prices.contains("jam")}, has milk: {prices.contains("milk")}")
print($"remove cake: {prices.remove("cake")}, again: {prices.remove("cake")}")
prices["cake"] = 6
for e in prices {
    print($"  {e.key} = {e.value}")
}

// Enum keys.
var counts = Map<Suit, i32>()
let hand: Suit[6] = [.spades, .hearts, .spades, .clubs, .spades, .hearts]
for s in hand {
    counts[s] = (counts.tryGet(at: s) ?? 0) + 1
}
print($"{counts}")

// Integer, rune and bool keys.
var squares = Map<i64, i64>()
for i in 0..5 {
    squares[i * i] = i
}
print($"{squares}")
var letters = Map<rune, bool>()
for c in "banana" {
    letters[c] = true
}
print($"{letters}")
var answers = Map<bool, string>()
answers[true] = "yes"
answers[false] = "no"
print($"{answers[true]} {answers[false]}")

// A map in a struct field.
var inv = Inventory { owner: "ada", stock: Map<string, i64>() }
restock(ref inv, for: "bolts", by: 10)
restock(ref inv, for: "nuts", by: 4)
restock(ref inv, for: "bolts", by: 5)
print($"{inv}")

// Inside a `using` arena.
{
    using var arena = Arena()
    provide allocator: arena {
        var seen = Map<i64, i64>()
        for i in 0..1000 {
            seen[i % 7] = i
        }
        var total: i64 = 0
        for e in seen {
            total += e.value
        }
        print($"arena map: {seen.length} keys, total {total}")
    }
}

prices.clear()
print($"cleared: {prices} count={prices.length}")
prices["bread"] = 1
print($"{prices}")
