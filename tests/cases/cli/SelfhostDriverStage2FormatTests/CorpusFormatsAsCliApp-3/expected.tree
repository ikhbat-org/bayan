== run/self-hosting-lambdas.byn
enum TokenKind {
    ident
    number
    plus
    end
}

struct Token {
    TokenKind kind
    i64       start
    string    text
}

union error LexError {
    bad(i64 at, string why)
}

bool any(Span<Token> ts, by (Token -> bool) p) {
    for t in ts {
        if p(t) {
            return true
        }
    }
    return false
}

i64 indexWhere(Span<Token> ts, by (Token -> bool) p) {
    var i: i64 = 0
    for t in ts {
        if p(t) {
            return i
        }
        i += 1
    }
    return -1
}

i64 countWhere(Span<Token> ts, by (Token -> bool) p) {
    var n: i64 = 0
    for t in ts {
        if p(t) {
            n += 1
        }
    }
    return n
}

bool isNumber(Token t) => t.kind == TokenKind.number

i64 firstMatch(Span<Token> ts, by (Token -> bool) p) => indexWhere(ts, by: p)

i64 findFrom(Span<Token> ts, by (Token -> bool) p) => firstMatch(ts, by: p)

bool ordered(Span<Token> ts, by ((Token, Token) -> bool) before) {
    var i: i64 = 1
    while i < ts.length {
        if !before(ts[i - 1], ts[i]) {
            return false
        }
        i += 1
    }
    return true
}

string upper(string s) fails LexError {
    fail .bad(at: 0, why: "empty") if s.isEmpty
    return $"<{s}>"
}

string render(Token t, by (string -> string fails LexError) hook) fails LexError => try hook(t.text)

void main() {
    let ts: Span<Token> = [
        Token { kind: .ident, start: 0, text: "x" },
        Token { kind: .plus, start: 2, text: "+" },
        Token { kind: .number, start: 4, text: "42" },
        Token { kind: .end, start: 6, text: "" },
    ]
    print($"{any(ts, by: it.kind == TokenKind.plus)} {any(ts, by: it.start > 10)}")
    print($"{any(ts, by: isNumber)} {indexWhere(ts, by: isNumber)}")
    print($"{indexWhere(ts, by: it.text == "+")} {indexWhere(ts, by: it.kind == TokenKind.end)}")
    let offset = 2
    print($"{ordered(ts, by: (a, b) => a.start + offset <= b.start)}")
    let wide = 3
    print($"{ordered(ts, by: (a, b) => a.start + wide <= b.start)}")
    print($"{findFrom(ts, by: isNumber)} {findFrom(ts, by: it.start == offset)} {findFrom(ts, by: it.start > 99)}")
    print($"{countWhere(ts, by: t => t.start >= offset)}")
    print(render(ts[2], by: upper) catch "?")
    let r = render(ts[3], by: upper) catch switch {
        .bad e => $"bad {e.at} {e.why}",
    }
    print(r)
    let tag = "id"
    print(render(ts[0], by: s => $"{tag}:{s}") catch "?")
}
== run/self-hosting-shape.byn
enum TokenKind {
    number
    plus
    star
}

struct Token {
    TokenKind kind
    i64       value
}

struct unique TokenList : IIndexable {
    type Item = Token

    List<Token> tokens

    i64 count => tokens.length

    Token get(i64 index) => tokens[index]
}

struct unique TokenStream : IEnumerator {
    type Item = Token

    List<Token> tokens
    i64         at

    bool moveNext(ref this) {
        at += 1
        return at < tokens.length
    }

    Token current => tokens[at]
}

interface INode {
    i64 eval()

    string name

    string describe() => $"{name} = {eval()}"
}

struct Num : INode {
    i64 value

    i64 eval() => value

    string name => $"num {value}"
}

struct Add : INode {
    i64 left
    i64 right

    i64 eval() => left + right

    string name => $"add {left} {right}"
}

struct Mul : INode {
    i64 left
    i64 right

    i64 eval() => left * right

    string name => $"mul {left} {right}"

    string describe() => $"product of {left} and {right} is {eval()}"
}

void visitStatic<T>(T node) where T : INode {
    print($"static: {node.describe()}")
}

void visitDyn(dyn ref readonly INode node) {
    print($"dyn: {node.describe()}")
}

List<Token> lex() {
    var tokens = List<Token>()
    tokens.append(Token { kind: .number, value: 2 })
    tokens.append(Token { kind: .plus, value: 0 })
    tokens.append(Token { kind: .number, value: 3 })
    tokens.append(Token { kind: .star, value: 0 })
    tokens.append(Token { kind: .number, value: 4 })
    return tokens
}

void main() {
    let list = TokenList { tokens: lex() }
    var numbers = 0
    for t in list {
        print($"token {t.kind} {t.value}")
        numbers += t.kind == .number ? 1 : 0
    }
    print($"{numbers} numbers")

    var stream = TokenStream { tokens: lex(), at: -1 }
    var sum = 0
    for t in stream {
        sum += t.value
    }
    print($"sum {sum}, stream at {stream.at}")

    let n = Num { value: 2 }
    let a = Add { left: 2, right: 3 }
    let m = Mul { left: 5, right: 4 }
    visitStatic(n)
    visitStatic(a)
    visitStatic(m)
    visitDyn(n)
    visitDyn(a)
    visitDyn(m)
}
== run/selfhost-symbol-tables.byn
// The binder port's symbol tables in Bayan: interned names, a keyword literal, a scope chain, composite keys (spec 008 R12).
enum TokenKind {
    letKeyword
    varKeyword
    funcKeyword
    identifier
}

struct MemberKey {
    i32    owner
    Symbol name
}

Symbol readName(string src, from i64 start, until i64 end) uses alloc {
    return Symbol.intern(src[start..end])
}

i32 resolve(Symbol name, through List<Map<Symbol, i32>> scopes) {
    var i = scopes.length - 1
    while i >= 0 {
        if scopes[i].contains(name) {
            return scopes[i][name]
        }
        i -= 1
    }
    return -1
}

void main() {
    let keywords: Map<Symbol, TokenKind> = ["let": .letKeyword, "var": .varKeyword, "func": .funcKeyword]
    let src = "func area let width var height let width func inner let height let depth"

    // Slice the words out of the source and intern each one.
    var words = List<Symbol>()
    var start: i64 = 0
    for i in 0..src.length + 1 {
        if i == src.length || src[i..i + 1] == " " {
            if i > start {
                words.append(readName(src, from: start, until: i))
            }
            start = i + 1
        }
    }

    // Declare each name after a keyword: `func` opens a scope, `let` and `var` declare in the innermost.
    var scopes = List<Map<Symbol, i32>>()
    scopes.append(Map<Symbol, i32>())
    var declared: Map<(i32 scope, Symbol name), i32> = []
    var members: Map<MemberKey, TokenKind> = []
    var order = List<Symbol>()
    var next: i32 = 0
    for w in 0..words.length - 1 {
        let kind = keywords.contains(words[w]) ? keywords[words[w]] : TokenKind.identifier
        if kind == .identifier {
            continue
        }
        let name = words[w + 1]
        let scope = i32(scopes.length - 1)
        if kind == .funcKeyword {
            scopes[scope][name] = next
            scopes.append(Map<Symbol, i32>())
        } else {
            if declared.contains((scope, name)) {
                print($"{name} redeclared in scope {scope}, first {declared[(scope, name)]}")
                continue
            }
            scopes[scope][name] = next
        }
        declared[(scope, name)] = next
        members[MemberKey { owner: scope, name: name }] = kind
        order.append(name)
        next += 1
    }

    // Look names up innermost first; a missing name resolves to -1.
    for text in ["width", "height", "area", "inner", "depth", "radius"] {
        print($"{text} -> {resolve(Symbol.intern(text), through: scopes)}")
    }
    print($"keyword let: {keywords.contains(words[2])}, identifier width: {keywords.contains(words[3])}")
    print($"member (1, height): {members[MemberKey { owner: 1, name: "height" }]}")

    // The declarations, in declaration order.
    for (key, value) in declared {
        print($"{value}: scope {key.scope} {key.name} {members[MemberKey { owner: key.scope, name: key.name }]}")
    }
    var line = StrBuf()
    for name in order {
        line.append($" {name}")
    }
    print($"order:{line.view}")
}
