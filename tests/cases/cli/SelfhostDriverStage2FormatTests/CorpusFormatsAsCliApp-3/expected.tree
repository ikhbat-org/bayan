== typed/lambda-rollback.byn
i64 apply((i64 -> i64) f, to i64 x) => f(x)

// `sum` first meets an `i64`, so the body binds twice; the lambda is lifted once, from the second pass.
i64 total(i64 start) {
    var sum = 0
    sum = start
    return apply(x => x + 1, to: sum)
}

void main() {
    print($"{total(1)}")
}
== typed/pending-peers-accumulator.byn
let xs = List<i32>()
var i = 0
var total = 0
while i < xs.length {
    total += i
    i += 1
}
total = total + i
print($"{total}")
== typed/pending-peers-chain.byn
let xs = List<i32>()
var a = 0
var b = 0
a = b
while b < xs.length {
    b += 1
}
print($"{a}")
== typed/pending-peers-unconstrained.byn
var a = 0
var b = 0
a = b
b += a
print($"{a < b}")
