== diag/panic-handler-restricted.byn
union error E {
    bad
}

i64 step() fails E {
    return 1
}

i64 work() fails E {
    var count = 0
    defer panicking {
        let n = try step()
        count = n
        let xs = List<i64>()
        return 0
    }
    for i in 0..3 {
        defer panicking {
            break
        }
        defer panicking {
            continue
        }
    }
    count += 1
    return count
}

void onCrash(Panic p) {
    let s = $"{p.message}"
    return
}

