== diag/switch-move-guard-mutate.byn
// In `switch move …` a `when` guard only reads the arm's bindings (BYN2791): a guard that fails gives the value back.
struct Bag {
    List<i64> items

    public i64 grow(ref this) uses alloc {
        this.items.append(1)
        return this.items.length
    }
}

union Slot {
    full(Bag b)
    empty
}

bool bump(ref List<i64> xs) {
    xs.append(7)
    return true
}

bool fill(out List<i64> xs) {
    xs = List<i64>()
    return true
}

bool keep(move Bag b) => true

void inspect(move Slot s) {
    switch move s {
        case .full(var x) when x.grow() > 5:
            print("call")
        case .full(var x) when x.items.removeLast() > 0:
            print("builtin")
        case .full(var x) when x.items.take().length > 0:
            print("take")
        case .full(var x) when bump(ref x.items):
            print("ref")
        case .full(var x) when fill(out x.items):
            print("out")
        case .full(let x) when keep(move x):
            print("move")
        case .full(let x) when x.items.length > 0:
            print("read")
        default:
    }
}

void inspectValue(move Slot t) {
    let n = (move t) switch {
        .full(var y) when y.grow() > 5       => 1,
        .full(var y) when bump(ref y.items)  => 2,
        .full(let y) when keep(move y)       => 3,
        .full(let y) when y.items.length > 0 => 4,
        _                                    => 0,
    }
    print($"{n}")
}
== diag/switch-move-overlap.byn
// A pattern in `switch move …` may not bind the same storage twice (BYN2790).
struct Ledger {
    List<i64> items
}

union Box {
    full(Ledger ledger)
    empty
}

void keep(move List<i64> xs) { }

void inspect() {
    let a = List<i64>()
    switch move a {
        case let x and let y:
            keep(move x)
        default:
    }
    let l = Ledger { items: List<i64>() }
    switch move l {
        case Ledger { items: let it } whole:
            keep(move it)
        default:
    }
    let m = Ledger { items: List<i64>() }
    switch move m {
        case { items: let p, items: let q }:
            keep(move p)
            keep(move q)
        default:
    }
    let b = Box.full(Ledger { items: List<i64>() })
    switch move b {
        case .full({ items: let p, items: let q }):
            keep(move p)
            keep(move q)
        default:
    }
}
