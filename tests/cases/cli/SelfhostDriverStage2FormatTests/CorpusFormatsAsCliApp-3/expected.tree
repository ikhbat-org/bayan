== diag/ref-this-argument-modifies-borrowed-field.byn
// Passing `ref this` hands the callee the whole receiver: it may change every field, so a live span into a field conflicts (BYN3004).
struct B {
    List<i64> items

    void run(ref this) {
        let s = items.span
        wipe(ref this)
        print($"{s[0]}")
    }

    void reset(ref this) {
        wipe(ref this)
    }

    // A `ref this` method whose body passes `ref this` on changes every field too.
    void outer(ref this) {
        let s = items.span
        reset()
        print($"{s[0]}")
    }
}

void wipe(ref B b) {
    b.items.clear()
    b.items.append(7)
}

void main() {
    var b = B { items: List<i64>() }
    b.items.append(1)
    b.run()
    b.outer()
}
== diag/ref-this-field-argument-while-borrowed.byn
interface IThing {
    i64 get()
}

struct S : IThing {
    i64 n

    i64 get() => n
}

void grow(ref List<S> l) {
    l.append(S { n: 2 })
}

struct B {
    List<S> items

    // Passing a field by `ref` lets the callee grow it, like passing a local list.
    void run(ref this) {
        let d: dyn ref IThing = items[0]
        grow(ref items)
        grow(ref this.items)
        print($"{d.get()}")
    }
}

void main() {
    var b = B { items: List<S>() }
    b.items.append(S { n: 1 })
    b.run()
}
