union Mode {
    read = 1
    write = 2
    append
    none = -1
}

union Reply {
    ok = 200
    notFound = 404
    moved(string to)
}

string describe(Mode m) => m switch {
    .read   => "read",
    .write  => "write",
    .append => "append",
    .none   => "none",
}

void show(Reply r) {
