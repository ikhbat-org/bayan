== typed/state-types.byn
struct Order {
    i64 id

    states {
        draft
        paid(i64 payment)
        shipped
    }

    void pay(ref this is .draft, i64 amount) becomes .paid {
        become .paid(amount)
    }

    i64 receipt(this is .paid or .shipped) => id
}

i64 archive(Order order is .paid or .shipped) => order.receipt()

i64 refund(Order.paid order) {
    let any: Order = order
    let done: Order is .paid or .shipped = order
    return archive(order) + done.id + any.id
}

let paid = Order.paid { id: 1, payment: 5 }
let draft: Order.draft = { id: 2 }
print($"{refund(paid)} {draft.id}")
== typed/symbol-literals.byn
// A string literal where a `Symbol` is expected is a `Symbol` fixed at compile time (spec 008 R2).
struct Entry {
    Symbol name = "entry"
    i32    rank
}

bool same(Symbol a, to Symbol b) => a == b

Symbol keyword() {
    return "let"
}

void main() {
    let typed: Symbol = "total"
    var mutable: Symbol = """raw"""
    let optional: Symbol? = "maybe"
    let argument: bool = same("a", to: typed)
    let entry = Entry { name: "field", rank: 1 }
    let returned = keyword()
    let names: List<Symbol> = ["x", "y"]
    let left: bool = "total" == typed
    let right: bool = typed != "totals"
    let lt: bool = typed < "u"
    let le: bool = "a" <= typed
    let gt: bool = typed > "a"
    let ge: bool = "z" >= typed
    mutable = "other"
}
== typed/symbol-text.byn
// `sym.text` is a `string` that borrows nothing, so it may outlive the `Symbol` it came from; `$"{sym}"` writes the text.
string name(Symbol s) => s.text

string literalText() {
    let s: Symbol = "total"
    let text: string = s.text
    return text
}

string internedText(string source) {
    let s = Symbol.intern(source)
    return s.text
}

void main() {
    let s: Symbol = "name"
    let length: i64 = s.text.length
    let shown: string = $"[{s}] {s, width: 8}"
    print($"{s} {name(s)}")
}
== typed/symbol-type.byn
// `Symbol` is a built-in, copyable type: compared with `==`/`!=`, ordered by text, defaultable in `slot`.
bool same(Symbol a, to Symbol b) => a == b

bool compare(Symbol a, to Symbol b) {
    let x: Symbol = a
    let ne: bool = x != b
    let lt: bool = x < b
    let le: bool = x <= b
    let gt: bool = x > b
    let ge: bool = x >= b
    return ne && lt && le && gt && ge
}

Symbol copyTwice(Symbol a) {
    let first = a
    let second = a
    return first
}

void fill(ref Map<i32, Symbol> names) {
    let name: Symbol = names.slot(1)
}

void main() {
}
