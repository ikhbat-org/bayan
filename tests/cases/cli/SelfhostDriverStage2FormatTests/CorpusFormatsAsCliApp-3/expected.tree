== run/dyn-ref-this-region.byn
// In a method, `this` is the caller's data: a `dyn ref` lent from it by a `ref this` argument or call outlives the method's blocks.
interface IThing { i64 get() }

struct S : IThing {
    i64 n

    i64 get() => n
}

struct Box {
    S inner

    dyn ref IThing pick(ref this) => inner

    void run(ref this) {
        var other = S { n: 1 }
        var late: dyn ref IThing = other
        {
            late = take(ref this)
        }
        print($"{late.get()}")
        {
            late = pick()
        }
        print($"{late.get()}")
    }
}

dyn ref IThing take(ref Box b) => b.inner

void main() {
    var b = Box { inner: S { n: 2 } }
    b.run()
}
== run/dyn-ref-unique.byn
interface IStack {
    i64 count

    void push(ref this, i64 v) uses alloc

    i64 top()
}

struct unique Stack : IStack {
    List<i64> items

    i64 count => items.length

    void push(ref this, i64 v) {
        items.append(v)
    }

    i64 top() => items[items.length - 1]
}

void fill(dyn ref IStack s) {
    s.push(1)
    s.push(2)
    s.push(3)
}

void report(dyn ref readonly IStack s) => print($"{s.count} items, top {s.top()}")

void main() {
    var s = Stack { items: List<i64>() }
    fill(s)
    report(s)
    fill(s)
    report(s)
    print($"still owned: {s.items.length}")
}
