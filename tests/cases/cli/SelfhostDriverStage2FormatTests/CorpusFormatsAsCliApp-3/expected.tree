== diag/moved-while-borrowed.byn
// Moving a value hands its storage to a new owner, which may grow or free it: a borrow into it ends there (BYN3006).
interface IThing {
    i64 get()
}

struct unique S : IThing {
    List<i64> xs

    i64 get() => xs[0]
}

union Slot {
    full(S s)
    empty
}

S make() {
    var xs = List<i64>()
    xs.append(42)
    return S { xs: move xs }
}

void keep(move S s) {
    print($"{s.xs.length}")
}

void dynRef() {
    var s = make()
    let d: dyn ref IThing = s
    var t = move s
    t.xs.append(1)
    print($"{d.get()}")
}

void readonlyDynRef() {
    let s = make()
    let d: dyn ref readonly IThing = s
    keep(move s)
    print($"{d.get()}")
}

void spanOfField() {
    let s = make()
    let sp: ReadOnlySpan<i64> = s.xs.span
    var t = move s
    t.xs.append(1)
    print($"{sp[0]}")
}

// The result may point into what `slot` holds: it borrows `slot`.
Span<i64> items(ref Slot slot, by Span<i64> none) => none

void switchMove() {
    var slot = Slot.full(make())
    let none: i64[1] = [0]
    let sp: Span<i64> = items(ref slot, by: none)
    switch move slot {
        case .full(var x):
            x.xs.append(1)
        default:
    }
    print($"{sp[0]}")
}

void take() {
    var xs = List<i64>()
    xs.append(1)
    let sp: ReadOnlySpan<i64> = xs.span
    var ys = xs.take()
    ys.append(2)
    print($"{sp[0]}")
}

void main() {
    dynRef()
    readonlyDynRef()
    spanOfField()
    switchMove()
    take()
}
