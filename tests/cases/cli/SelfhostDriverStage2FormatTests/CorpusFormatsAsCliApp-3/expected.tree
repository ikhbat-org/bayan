== run/unions.byn
union Shape {
    circle(f32 r)
    rect(f32 w, f32 h)
    none
}

public union Token {
    number(i64 value)
    word(string text)
    end
}

struct Slot {
    string label
    Shape  shape

    void formatInto(ref StrBuf sb) {
        sb.append($"Slot {{ label: {label}, shape: {shape} }}")
    }
}

f32 area(Shape s) => s switch {
    .circle(let r)      => 3 * r * r,
    .rect(let w, let h) => w * h,
    .none               => 0,
}

void describe(Shape s) {
    switch s {
        case Shape.circle(let r) when r > 10:
            print("big circle")
        case .circle(let r):
            print($"circle {r}")
        case .rect(let w, _):
            print($"rect of width {w}")
        case Shape.none:
            print("nothing")
    }
}

Shape square(f32 side) => .rect(side, side)

let c = Shape.circle(1)
let r = square(2)
let n: Shape = .none
print($"{c} {r} {n}")
print($"{Shape.rect(w: 2, h: 3)}")
print($"{area(c)} {area(r)} {area(n)}")
describe(c)
describe(Shape.circle(20))
describe(r)
describe(n)

print($"{c == Shape.circle(1)} {c == Shape.circle(2)} {c != r} {n == Shape.none} {r == .rect(2, 2)}")

if r is .rect(let rw, let rh) {
    print($"is rect {rw}x{rh}")
}
if c is .rect(_, _) {
    print("unreachable")
} else {
    print("c is not a rect")
}
print($"{n is .none} {c is Shape.circle(1)}")

var shapes = List<Shape>()
shapes.append(c)
shapes.append(.rect(1, 2))
shapes.append(Shape.none)
var total: f32 = 0
for s in shapes {
    total += area(s)
    print($"list {s}")
}
print($"total {total}")

let slot = Slot { label: "first", shape: .circle(3) }
print($"{slot}")
print($"{slot == Slot { label: "first", shape: Shape.circle(3) }}")

let maybe: Shape? = shapes[1]
let missing: Shape? = null
print($"{maybe} {missing}")
print(maybe switch { null => "none", .rect(let w, _) => $"rect {w}", _ => "other" })

var tokens = List<Token>()
tokens.append(Token.number(42))
tokens.append(.word("hi"))
tokens.append(.end)
for t in tokens {
    let text = t switch {
        .number(let v) => $"number {v}",
        .word(let w)   => $"word {w}",
        .end           => "end",
    }
    print($"{text} {t}")
}
== run/unique-checker-clean.byn
// mode: debug
// Valid ownership transfers run clean under the debug-build checker: moves in loops with reassignment,
// `return move`, `take()`, struct literals with `move`, and List, Map and StrBuf storage that grows.
struct Bag {
    string    name
    List<i64> items
}

union Payload {
    items(List<i64> items)
    empty
}

i64 sum(move List<i64> xs) {
    var total: i64 = 0
    for x in xs {
        total += x
    }
    return total
}

List<i64> grow(move List<i64> xs, by i64 count) {
    var ys = move xs
    for i in 0..count {
        ys.append(i)
    }
    return move ys
}

Bag pack(string name, until i64 count) {
    var items = List<i64>()
    for i in 0..count {
        items.append(i)
    }
    var bag = Bag { name: name, items: move items }
    bag.items.append(100)
    return move bag
}

i64 count(Payload p) => p switch {
    .items(let items) => items.length,
    .empty => 0,
}

void main() {
    var batches = List<List<i64>>()
    var batch = List<i64>()
    for round in 0..4 {
        for i in 0..20 {
            batch.append(round * 100 + i)
        }
        batches.append(move batch)
        batch = List<i64>()
    }
    print($"batches {batches.length} {batches[3].length} {batch.length}")

    var total: i64 = 0
    var xs = List<i64>()
    for round in 0..3 {
        xs.append(round)
        xs = grow(move xs, by: 10)
        total += xs.length
    }
    print($"grown {xs.length} {total} {sum(move xs)}")

    let bag = pack("bag", until: 30)
    print($"{bag.name} {bag.items.length} {bag.items[30]}")

    var owner = Bag { name: "owner", items: List<i64>() }
    for i in 0..50 {
        owner.items.append(i)
    }
    let taken = owner.items.take()
    owner.items.append(7)
    print($"taken {taken.length} left {owner.items.length}")

    var counts = Map<string, i64>()
    for i in 0..200 {
        counts[$"k{i % 70}"] = i
    }
    counts["k0"] += 1
    let moved = move counts
    print($"map {moved.length} {moved["k0"]}")

    var sb = StrBuf()
    for i in 0..100 {
        sb.append("abc")
    }
    sb.append($"{sb.length}")
    let text = move sb
    print($"strbuf {text.length}")

    var p = Payload.items(List<i64>())
    var inner = List<i64>()
    inner.append(1)
    inner.append(2)
    p = Payload.items(move inner)
    print($"payload {count(p)}")

    var kept: i64 = 0
    for round in 0..5 {
        using let arena = Arena()
        provide allocator: arena {
            var local = List<i64>()
            for i in 0..300 {
                local.append(i)
            }
            var other = move local
            other.append(round)
            kept += other.length
        }
    }
    print($"arenas {kept}")
}
