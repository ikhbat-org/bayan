// Model check for Map (L3): MapModelTests replays the same xorshift sequence against an
// insertion-ordered reference model in C# and compares it with map-model.stdout.
u64 next(ref u64 state) {
    var x = state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    state = x
    return x
}

var state: u64 = 0x9E3779B97F4A7C15
var m = Map<i64, i64>()
for step in 0..5000 {
    let r = next(ref state)
    let key = i64(r % 64)
    if (r >> 8) % 3 == 2 {
        let _ = m.remove(key)
    } else {
        m[key] = step
    }
}
print($"count {m.length}")
for e in m {
    print($"{e.key} {e.value}")
}
== run/map-slot.byn
struct Tally {
    i64    hits = 0
    string note = "new"

    void formatInto(ref StrBuf sb) {
        sb.append($"Tally {{ hits: {hits}, note: {note} }}")
    }
}

// `slot` inserts the default for a missing key, so counting needs no lookup first.
var words = Map<string, i64>()
let text: string[7] = ["the", "cat", "saw", "the", "dog", "the", "cat"]
for w in text {
    words.slot(w) += 1
}
print($"{words} length={words.length}")

// `tryGet(at:)` reads without inserting.
print($"cat {words.tryGet(at: "cat") ?? 0}, cow {words.tryGet(at: "cow") ?? -1}, length={words.length}")
print($"contains cow: {words.contains("cow")}, contains dog: {words.contains("dog")}")

// Writes and compound writes through `map[k]` (on a present key; `slot` inserts): an update keeps the key's position.
words["saw"] = 10
words["the"] += 5
words.slot("owl") += 2
print($"{words}")

// A removed key goes to the end when inserted again.
print($"remove cat: {words.remove("cat")}, again: {words.remove("cat")}")
words.slot("cat") += 1
for e in words {
    print($"  {e.key} = {e.value}")
}

// `ref map.slot(k)` and struct defaults from field initializers.
void bump(ref i64 n) {
    n += 100
}
bump(ref words.slot("dog"))
bump(ref words.slot("eel"))
print($"dog {words["dog"]}, eel {words["eel"]}, length={words.length}")
var tallies = Map<rune, Tally>()
for c in "abca" {
    tallies.slot(c).hits += 1
}
tallies.slot('z').note = "set"
print($"{tallies}")

words.clear()
print($"cleared: {words} length={words.length}")
