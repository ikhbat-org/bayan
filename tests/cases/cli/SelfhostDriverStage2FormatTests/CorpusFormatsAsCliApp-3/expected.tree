// suq-order.byn — Sūq-0 slice 4: an order's lifecycle without typestate
// Typestate is not implemented, so the state is a union field and every transition checks it
// at run time, like the C# baseline. Needs Money from suq-money.byn.
// Money, Currency and PricingError copied from suq-money.byn: run goldens are single-file.

public enum Currency {
    myr
    sgd
    usd
}

string code(Currency c) => c switch { .myr => "MYR", .sgd => "SGD", .usd => "USD" }

public union error PricingError {
    /// the currencies differ
    currencyMismatch
    /// the amount does not fit in i64
    overflow
}

const maxCents: i64 = 9223372036854775807

/// An amount in minor units (sen, cents) of one currency.
public struct Money {
    public i64      cents
    public Currency currency

    public Money plus(Money other) fails PricingError {
        fail .currencyMismatch if other.currency != currency
        fail .overflow if other.cents > 0 && cents > maxCents - other.cents
        return Money { cents: cents + other.cents, currency: currency }
    }

    public Money minus(Money other) fails PricingError {
        fail .currencyMismatch if other.currency != currency
        return Money { cents: cents - other.cents, currency: currency }
    }

    public Money times(i32 qty) => Money { cents: cents * qty, currency: currency }

    /// This amount at a rate in basis points (800 = 8%), rounded half up. Non-negative amounts.
    public Money atRate(i64 basisPoints) fails PricingError {
        fail .overflow if basisPoints > 0 && cents > (maxCents - 5000) / basisPoints
        return Money { cents: (cents * basisPoints + 5000) / 10000, currency: currency }
    }

    /// Writes "MYR 12.50". Drives `$"{m}"`.
    public void formatInto(ref StrBuf sb) {
        sb.append(code(currency))
        sb.append(" ")
        var whole = cents
        if cents < 0 {
            sb.append("-")
            whole = -cents
        }
        sb.append($"{whole / 100}.")
        sb.append("0") if whole % 100 < 10
        sb.append($"{whole % 100}")
    }
}

public enum LineStatus {
    active
    removed
    backordered
}

public struct Line {
    public string     sku
    public i32        qty
    public Money      unitPrice
    public i64        unitGrams
    public LineStatus status
}

public union OrderState {
    draft
    placed
    paid(string payment)
    shipped(string payment, string tracking)
    cancelled(string reason)
}

public union error OrderError {
    /// the order is not in a state that allows this
    wrongState
    /// no active lines
    empty
    /// more lines than an order may have
    tooManyLines
    /// a line's currency is not the order's
    currencyMismatch
    /// a line breaks its rules
    invalidLine
}

const maxLines: i32 = 200

/// Holds a list, so it is unique.
public struct Order {
    public i64        id
    public Currency   currency
    public List<Line> lines
    public OrderState state

    public Money total() {
        var sum: i64 = 0
        for line in lines {
            sum = sum + line.unitPrice.cents * line.qty if line.status == .active
        }
        return Money { cents: sum, currency: currency }
    }

    public string statusLabel() => state switch {
        .draft         => "Draft",
        .placed        => "Awaiting payment",
        .paid(_)       => "Paid",
        .shipped(_, _) => "On its way",
        .cancelled(_)  => "Cancelled",
    }

    public string tracking() => state switch {
        .draft             => "",
        .placed            => "",
        .paid(_)           => "",
        .shipped(_, let t) => t,
        .cancelled(_)      => "",
    }

    public void addLine(ref this, Line line) uses alloc fails OrderError {
        fail .wrongState unless state is .draft
        fail .tooManyLines if lines.length >= maxLines
        fail .currencyMismatch if line.unitPrice.currency != currency
        fail .invalidLine if line.qty < 1 || line.qty > 999 || line.unitGrams <= 0
        lines.append(line)
    }

    public void removeLine(ref this, string sku) fails OrderError {
        fail .wrongState if !(state is .draft || state is .placed)
        for i in 0..lines.length {
            lines[i] = lines[i] with { status: .removed } if lines[i].sku == sku
        }
    }

    public void place(ref this) fails OrderError {
        fail .wrongState unless state is .draft
        var any = false
        for line in lines {
            any = true if line.status == .active
        }
        fail .empty unless any
        state = .placed
    }

    public void markPaid(ref this, string payment) fails OrderError {
        fail .wrongState unless state is .placed
        state = .paid(payment)
    }

    public void markShipped(ref this, string tracking) fails OrderError {
        let payment = state switch {
            .draft         => "",
            .placed        => "",
            .paid(let p)   => p,
            .shipped(_, _) => "",
            .cancelled(_)  => "",
        }
        fail .wrongState unless state is .paid(_)
        state = .shipped(payment, tracking)
    }

    public void cancel(ref this, string reason) fails OrderError {
        fail .wrongState if !(state is .draft || state is .placed)
        state = .cancelled(reason)
    }
}

string errorName(OrderError e) => e switch {
    .wrongState       => "wrongState",
    .empty            => "empty",
    .tooManyLines     => "tooManyLines",
    .currencyMismatch => "currencyMismatch",
    .invalidLine      => "invalidLine",
}

Line tea() =>
    Line { sku: "TEA-0001", qty: 2, unitPrice: Money { cents: 1200, currency: .myr }, unitGrams: 100, status: .active }

// 1. the happy path
var order = Order { id: 7, currency: .myr, lines: [], state: .draft }
try order.addLine(tea())
try order.place()
print($"placed: {order.statusLabel()}, total {order.total()}")
try order.markPaid("pay_123")
try order.markShipped("EX123456789MY")
print($"shipped: {order.statusLabel()}, tracking {order.tracking()}")

// 2. a failed transition leaves the state unchanged
var empty = Order { id: 8, currency: .myr, lines: [], state: .draft }
empty.place() catch switch { OrderError e => print($"place empty: {errorName(e)}") }
print($"still: {empty.statusLabel()}")

// 3. wrong state is a run-time error here (a compile error with typestate)
var early = Order { id: 9, currency: .myr, lines: [], state: .draft }
early.markShipped("EX123456789MY") catch switch { OrderError e => print($"ship a draft: {errorName(e)}") }

// 4. removed lines don't count
var removed = Order { id: 10, currency: .myr, lines: [], state: .draft }
try removed.addLine(tea())
try removed.removeLine("TEA-0001")
print($"after remove: total {removed.total()}")
removed.place() catch switch { OrderError e => print($"place removed-only: {errorName(e)}") }

// 5. rules on lines
var bad = Order { id: 11, currency: .myr, lines: [], state: .draft }
bad.addLine(tea() with { qty: 0 }) catch switch { OrderError e => print($"qty 0: {errorName(e)}") }
bad.addLine(
    tea() with { unitPrice: Money { cents: 1200, currency: .sgd } },
) catch switch { OrderError e => print($"SGD line: {errorName(e)}") }

// 6. cancel only before payment
var paidOrder = Order { id: 12, currency: .myr, lines: [], state: .draft }
try paidOrder.addLine(tea())
try paidOrder.place()
try paidOrder.markPaid("pay_9")
paidOrder.cancel("changed mind") catch switch { OrderError e => print($"cancel paid: {errorName(e)}") }
print($"final: {paidOrder.statusLabel()}")
== run/suq-packing.byn
// suq-packing.byn — Sūq-0 slice 3: zero-allocation box packing, pick order, check digits
// All working storage is caller-owned (`stackalloc`); the packing loop allocates nothing.

public struct PackItem {
    public string sku
    public i64    grams
    public u8     aisle
    public u16    bay

    bool comesAfter(PackItem other) => aisle > other.aisle || (aisle == other.aisle && bay > other.bay)
}

public struct BoxSize {
    public string name
    public i64    capacity
    public i64    tare
}

BoxSize boxSizes(i64 i) => i switch {
    0 => BoxSize { name: "S", capacity: 2000, tare: 150 },
    1 => BoxSize { name: "M", capacity: 5000, tare: 300 },
    _ => BoxSize { name: "L", capacity: 12000, tare: 600 },
}

public union error PackError {
    /// an item is heavier than the largest box can hold
    tooHeavy
}

/// Index of the smallest box an item fits in on its own, or -1.
i32 findSmallestBox(i64 grams) {
    for i in 0..3 {
        return i if boxSizes(i).capacity - boxSizes(i).tare >= grams
    }
    return -1
}

public struct PackedBox {
    public i32 kind
    public i64 load
}

/// First-fit decreasing. Fills `boxes` (kind and load, which includes tare) and returns the number
/// of boxes. `order` is scratch. Ties keep input order.
public i32 pack(ReadOnlySpan<PackItem> items, by Span<i32> order, to Span<PackedBox> boxes) fails PackError {
    let n = items.length
    for i in 0..n {
        order[i] = i32(i)
    }
    // insertion sort, heaviest first; strict `<` keeps it stable
    for i in 1..n {
        let current = order[i]
        var j = i
        while j > 0 && items[order[j - 1]].grams < items[current].grams {
            order[j] = order[j - 1]
            j = j - 1
        }
        order[j] = current
    }

    var count = 0
    for k in 0..n {
        let i = order[k]
        let grams = items[i].grams
        let size = findSmallestBox(grams)
        fail .tooHeavy if size < 0
        var box = -1
        for b in 0..count {
            if box < 0 && boxes[b].load + grams <= boxSizes(boxes[b].kind).capacity {
                box = b
            }
        }
        if box < 0 {
            box = count
            boxes[box] = PackedBox { kind: size, load: boxSizes(size).tare }
            count = count + 1
        }
        boxes[box].load = boxes[box].load + grams
    }
    return count
}

/// Pick order: by aisle, then bay; stable.
public void sortPicks(ReadOnlySpan<PackItem> items, to Span<i32> order) {
    for i in 0..items.length {
        order[i] = i32(i)
    }
    for i in 1..items.length {
        let current = order[i]
        var j = i
        while j > 0 && items[order[j - 1]].comesAfter(items[current]) {
            order[j] = order[j - 1]
            j = j - 1
        }
        order[j] = current
    }
}

/// FNV-1a reduced to one digit. Wrapping multiply is the algorithm, so `*%`.
public u8 computeCheckDigit(string text) {
    var h: u32 = 2166136261
    for c in text {
        h = (h ^ u32(c)) *% 16777619
    }
    return u8(h % 10)
}

void report(ReadOnlySpan<PackItem> items, as string name) {
    let order: Span<i32> = stackalloc i32[64]
    let boxes: Span<PackedBox> = stackalloc PackedBox[64]
    let count = pack(items, by: order, to: boxes) catch {
        print($"{name}: tooHeavy")
        return
    }
    print($"{name}: {count} boxes")
    for b in 0..count {
        print($"  box {b}: {boxSizes(boxes[b].kind).name} {boxes[b].load} g")
    }
}

let mixed: List<PackItem> = [
    PackItem { sku: "RUG-0001", grams: 4000, aisle: 3, bay: 1 },
    PackItem { sku: "TEA-0001", grams: 300, aisle: 1, bay: 4 },
    PackItem { sku: "MUG-0001", grams: 500, aisle: 1, bay: 2 },
]
let bed: List<PackItem> = [PackItem { sku: "BED-0001", grams: 15000, aisle: 9, bay: 1 }]

var sample: List<PackItem> = []
for i in 0..40 {
    sample.append(
        PackItem { sku: $"ITM-{1000 + i}", grams: 100 + (i * 37) % 900, aisle: u8(1 + i % 6), bay: u16(i % 20) },
    )
}

report(mixed.span, as: "mixed")
report(bed.span, as: "bed")
report(sample.span, as: "sample")

let picks: Span<i32> = stackalloc i32[64]
