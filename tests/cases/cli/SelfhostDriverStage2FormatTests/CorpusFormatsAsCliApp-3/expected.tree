    let s = sb.finish()
    sb.insert("b", at: 0)
    print(s)
}

void takeAfterView() {
    var sb = StrBuf()
    sb.append("a")
    let s = sb.view
    let t = sb.take()
    print(s)
}

void main() {
    insertAfterFinish()
    takeAfterView()
}
