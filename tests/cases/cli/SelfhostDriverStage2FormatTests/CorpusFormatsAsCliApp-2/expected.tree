test "parse then encode is json.dumps" (string input, i32 indent, string expected) {
    assert (try Json.encode(try tree(input), indent: indent)) == expected
}

test "the reader gives every token kind, then null" {
    assert (
        try tokensOf("{\"a\": [1.5e1, true, false, null, \"x\", {}]}")
    ) == "{ key:a [ number:15/1.5e1 flag:true flag:false null text:x { } ] } "
}

test "next stays null after the end" {
    var reader = JsonReader.over(" 7 ")
    assert (try reader.next()) is .number(let value, _) && value == 7.0
    assert (try reader.next()) is null
    assert (try reader.next()) is null
}

test "a number keeps its text and its value" {
    assert (try Json.encode(try tree("[1E5, 1.0, -0, 1e400]"))) == "[1E5, 1.0, -0, 1e400]"
    assert (try tree("2.5e-1")) is .number(let value, _) && value == 0.25
}

test "duplicate keys are kept in order" {
    let v = try tree("{\"k\": 1, \"j\": 2, \"k\": 3}")
    assert v is .object(let members) && members.length == 3 && members[0].key == "k" && members[2].key == "k"
}

test "escapes decode to their runes" {
    assert (try tree("\"\\u00e9\\ud83d\\ude00\\n\\/\"")) is .text(let value) && value == "é😀\n/"
    assert (try tree("\"\\u00C9\\uE000\"")) is .text(let upper) && upper == "É\u{E000}"
}

test "encode writes a built tree as json.dumps does" {
    var members = List<JsonMember>()
    members.append(JsonMember { key: "name", value: .text(value: "Bayān") })
    members.append(JsonMember { key: "tags", value: .list(items: List<JsonValue>()) })
    members.append(JsonMember { key: "meta", value: .object(members: List<JsonMember>()) })
    members.append(JsonMember { key: "n", value: .number(value: 3.0, text: "3") })
    members.append(JsonMember { key: "ok", value: .nothing })
    let v = JsonValue.object(members: move members)
    assert (try Json.encode(v)) == "{\"name\": \"Bay\\u0101n\", \"tags\": [], \"meta\": {}, \"n\": 3, \"ok\": null}"
    assert (
        try Json.encode(v, indent: 2)
    ) == "{\n  \"name\": \"Bay\\u0101n\",\n  \"tags\": [],\n  \"meta\": {},\n  \"n\": 3,\n  \"ok\": null\n}"
}

test "encode writes a built number's text only when it is a JSON number" {
    let inf = f64.tryParse("1e400") ?? 0.0
    assert inf > 1e308
    assert (try Json.encode(JsonValue.number(value: 1.0, text: "1, \"admin\": true"))) == "1"
    assert (try Json.encode(JsonValue.number(value: 2.5, text: ""))) == "2.5"
    assert (try Json.encode(JsonValue.number(value: 3.0, text: "nan"))) == "3"
    assert (try Json.encode(JsonValue.number(value: 0.25, text: "true"))) == "0.25"
    assert (try Json.encode(JsonValue.number(value: 100000.0, text: "1E5"))) == "1E5"
    assert (try Json.encode(JsonValue.number(value: -0.0005, text: "-0.5e-3"))) == "-0.5e-3"
    assert Json.encode(JsonValue.number(value: inf, text: "inf")) fails JsonError.nonFinite
    assert Json.encode(JsonValue.number(value: -inf, text: "")) fails JsonError.nonFinite
    assert encodeErrorOf(JsonValue.number(value: inf - inf, text: "nan")) == "nonFinite"
    assert (try Json.encode(JsonValue.number(value: inf, text: "1e400"))) == "1e400"
}

test "encode refuses a tree nested past 128 levels" {
    assert (try Json.encode(nested(128))) == $"{"[".repeated(128)}null{"]".repeated(128)}"
    assert encodeErrorOf(nested(129)) == "nestedTooDeep"
    var members = List<JsonMember>()
    members.append(JsonMember { key: "a", value: nested(128) })
    assert Json.encode(JsonValue.object(members: move members)) fails JsonError.nestedTooDeep
    assert encodeErrorOf(nested(1000000)) == "nestedTooDeep"
    var deep = JsonValue.object(members: List<JsonMember>())
    for _ in 0..128 {
        var items = List<JsonValue>()
        items.append(move deep)
        deep = .list(items: move items)
    }
    assert Json.encode(deep) fails JsonError.nestedTooDeep
}

@cases(
    ("", "syntax unexpected end of input @0 1:1"),
    ("  ", "syntax unexpected end of input @2 1:3"),
    ("[1,", "syntax unexpected end of input @3 1:4"),
    ("1 2", "syntax unexpected content after the value @2 1:3"),
    ("[1 2]", "syntax expected `,` or `]` @3 1:4"),
    ("{\"a\": 1 \"b\": 2}", "syntax expected `,` or `}` @8 1:9"),
    ("{\"a\" 1}", "syntax expected `:` @5 1:6"),
    ("{1: 2}", "syntax expected a string key @1 1:2"),
    ("{\"a\": 1,}", "syntax expected a string key @8 1:9"),
    ("[1,]", "syntax expected a value @3 1:4"),
    ("NaN", "syntax expected a value @0 1:1"),
    ("Infinity", "syntax expected a value @0 1:1"),
    ("-Infinity", "syntax invalid number @0 1:1"),
    ("+1", "syntax expected a value @0 1:1"),
    (".5", "syntax expected a value @0 1:1"),
    ("01", "syntax leading zero in a number @0 1:1"),
    ("-01", "syntax leading zero in a number @0 1:1"),
    ("1.", "syntax invalid number @0 1:1"),
    ("1.e5", "syntax invalid number @0 1:1"),
    ("1e", "syntax invalid number @0 1:1"),
    ("1e+", "syntax invalid number @0 1:1"),
    ("-", "syntax invalid number @0 1:1"),
    ("tru", "syntax expected a value @0 1:1"),
    ("\"abc", "syntax unterminated string @0 1:1"),
    ("\"a\u{1}\"", "syntax control character in a string @2 1:3"),
    ("\"a\\x\"", "syntax invalid escape @2 1:3"),
    ("\"\\u12g4\"", "syntax invalid \\u escape @1 1:2"),
    ("\"\\u12G4\"", "syntax invalid \\u escape @1 1:2"),
    ("\"\\u-123\"", "syntax invalid \\u escape @1 1:2"),
    ("\"\\ud83d\\ue000\"", "syntax lone surrogate @1 1:2"),
    ("\"\\ud83d\"", "syntax lone surrogate @1 1:2"),
    ("\"\\ud83d\\u0041\"", "syntax lone surrogate @1 1:2"),
    ("\"\\ude00\"", "syntax lone surrogate @1 1:2"),
    ("[\"\\ud83d\\u12\"]", "syntax invalid \\u escape @8 1:9"),
    ("[\n  \"é\", x]", "syntax expected a value @10 2:8"),
    ("[1] x", "syntax unexpected content after the value @4 1:5"),
)
test "parse refuses broken text" (string input, string expected) {
    assert errorOf(input) == expected
}

test "line and column are reported past one line" {
    assert errorOf($"[1,\n{" ".repeated(70000)}x") == "syntax expected a value @70004 2:70001"
}

test "line and column hold values past i32" {
    assert describe(
        JsonError.syntax(message: "m", offset: 0, line: 3000000000, column: 4000000000),
    ) == "syntax m @0 3000000000:4000000000"
    assert describe(
        JsonError.tooDeep(offset: 0, line: 3000000000, column: 4000000000),
    ) == "tooDeep @0 3000000000:4000000000"
}

test "nesting past 128 levels is tooDeep" {
    assert errorOf("[".repeated(128)) == "syntax unexpected end of input @128 1:129"
    assert errorOf("[".repeated(129)) == "tooDeep @128 1:129"
    assert errorOf($"{"{\"a\":".repeated(128)}{{") == "tooDeep @640 1:641"
    assert Json.parse("[".repeated(100000)) fails JsonError.tooDeep
}

test "a reader error is the parse error" {
    var reader = JsonReader.over("[}")
    assert (try reader.next()) is .startList
    assert reader.next() fails JsonError.syntax
}
"""

const stdSource1: string = """// std.json pull reader (spec 016 T4, 015 S7): RFC 8259 text as a stream of tokens, one per `next()`.

/// One step of a JSON text: a container bound, an object key, or a scalar.
public union JsonToken {
    startObject
    endObject
    startList
    endList
    key(string name)
    text(string value)
    number(f64 value, string text)
    flag(bool value)
    nothing
}

/// Why a JSON text was refused (at a byte offset, with the 1-based line and column in runes of that offset), or why
/// `Json.encode` refused a tree.
public union error JsonError {
    syntax(string message, i64 offset, i64 line, i64 column)
    tooDeep(i64 offset, i64 line, i64 column)
    /// A number to encode is NaN or infinite and its text is not a JSON number.
    nonFinite
    /// A tree to encode nests deeper than `maxDepth`.
    nestedTooDeep
}

/// Lists and objects nest at most this deep: a deeper text is `tooDeep` and a deeper tree to encode `nestedTooDeep`,
/// never a stack overflow in a caller that recurses per level (docs/memory-leaks.md rule 5). 128 is the decoder default
/// of spec §15.4.
const maxDepth: i64 = 128

/// What the reader accepts next.
union ReadState {
    begin
    listFirst
    listValue
    listNext
    objectFirst
    objectKey
    objectColon
    objectValue
    objectNext
    done
}

/// A pull reader over one JSON text: `next()` gives the next token, `null` after the value and its trailing
/// whitespace, and fails on the first byte that breaks RFC 8259.
public struct JsonReader {
    string     text
    i64        pos       = 0
    i64        line      = 1
    i64        lineStart = 0
    ReadState  state     = .begin
    /// One entry per open container, `true` for an object.
    List<bool> open

    /// A reader at the start of `text`.
    public static JsonReader over(string text) uses alloc {
        return JsonReader { text: text, open: List<bool>() }
    }

    /// The next token, or `null` once the value has been read and only whitespace follows it.
    public JsonToken? next(ref this) uses alloc fails JsonError {
        skipSpace()
        if state is .done {
            fail .syntax(
                message: "unexpected content after the value",
                offset: pos,
                line: line,
                column: columnAt(pos),
            ) if pos < text.length
            return null
        }
        fail .syntax(
            message: "unexpected end of input",
            offset: pos,
            line: line,
            column: columnAt(pos),
        ) if pos >= text.length
        if state is .listNext {
            return close(as: .endList) if peek() == ']'
            fail .syntax(
                message: "expected `,` or `]`",
                offset: pos,
                line: line,
                column: columnAt(pos),
            ) if peek() != ','
            pos += 1
            skipSpace()
            state = .listValue
        } else if state is .objectNext {
            return close(as: .endObject) if peek() == '}'
            fail .syntax(
                message: "expected `,` or `}`",
                offset: pos,
                line: line,
                column: columnAt(pos),
            ) if peek() != ','
            pos += 1
            skipSpace()
            state = .objectKey
        } else if state is .objectColon {
            fail .syntax(message: "expected `:`", offset: pos, line: line, column: columnAt(pos)) if peek() != ':'
            pos += 1
            skipSpace()
            state = .objectValue
        }
        fail .syntax(
            message: "unexpected end of input",
            offset: pos,
            line: line,
            column: columnAt(pos),
        ) if pos >= text.length
        let b = peek()
        return close(as: .endList) if state is .listFirst && b == ']'
        return close(as: .endObject) if state is .objectFirst && b == '}'
        if state is .objectFirst or .objectKey {
            fail .syntax(message: "expected a string key", offset: pos, line: line, column: columnAt(pos)) if b != '"'
            let name = try readString()
            state = .objectColon
            return .key(name: name)
        }
        return try readValue()
    }

    /// The byte at `pos`, or 0 at the end.
    u8 peek() => pos < text.length ? text.bytes[pos] : 0

    void skipSpace(ref this) {
        while pos < text.length {
            let b = text.bytes[pos]
            if b == '\n' {
                line += 1
                lineStart = pos + 1
            } else if b != ' ' && b != '\t' && b != '\r' {
                return
            }
            pos += 1
        }
    }

    /// The 1-based column of `at` on the current line, counted in runes.
    i64 columnAt(i64 at) => text[lineStart..at].runeCount + 1

    /// After a value: what the enclosing container accepts next.
    void finishValue(ref this) {
        if open.length == 0 {
            state = .done
        } else if open[open.length - 1] {
            state = .objectNext
        } else {
            state = .listNext
        }
    }

    JsonToken close(ref this, as JsonToken token) {
        pos += 1
        let _ = open.removeLast()
        finishValue()
        return token
    }

    JsonToken openContainer(ref this, bool object) uses alloc fails JsonError {
        fail .tooDeep(offset: pos, line: line, column: columnAt(pos)) if open.length >= maxDepth
        pos += 1
        open.append(object)
        state = object ? .objectFirst : .listFirst
        return object ? .startObject : .startList
    }

    JsonToken readValue(ref this) uses alloc fails JsonError {
        let b = peek()
        return try openContainer(object: true) if b == '{'
        return try openContainer(object: false) if b == '['
        if b == '"' {
            let value = try readString()
            finishValue()
            return .text(value: value)
        }
        return try readNumber() if b == '-' || (b >= '0' && b <= '9')
        if literal("true") {
            finishValue()
            return .flag(value: true)
        }
        if literal("false") {
            finishValue()
            return .flag(value: false)
        }
        if literal("null") {
            finishValue()
            return .nothing
        }
        fail .syntax(message: "expected a value", offset: pos, line: line, column: columnAt(pos))
    }

    /// Whether `word` starts at `pos`; if so, steps over it.
    bool literal(ref this, string word) {
        return false if !text[pos..].startsWith(word)
        pos += word.length
        return true
    }

    /// RFC 8259 §6: `-`? (`0` | [1-9] digits) (`.` digits)? ([eE] [+-]? digits)?
    JsonToken readNumber(ref this) fails JsonError {
        let start = pos
        if peek() == '-' {
            pos += 1
        }
        if peek() == '0' {
            pos += 1
            fail .syntax(
                message: "leading zero in a number",
                offset: start,
                line: line,
                column: columnAt(start),
            ) if isDigit(peek())
        } else if isDigit(peek()) {
            while isDigit(peek()) {
                pos += 1
            }
        } else {
            fail .syntax(message: "invalid number", offset: start, line: line, column: columnAt(start))
        }
        if peek() == '.' {
            pos += 1
            fail .syntax(
                message: "invalid number",
                offset: start,
                line: line,
                column: columnAt(start),
            ) if !isDigit(peek())
            while isDigit(peek()) {
                pos += 1
            }
        }
        if peek() == 'e' || peek() == 'E' {
            pos += 1
            if peek() == '+' || peek() == '-' {
                pos += 1
            }
            fail .syntax(
                message: "invalid number",
                offset: start,
                line: line,
                column: columnAt(start),
            ) if !isDigit(peek())
            while isDigit(peek()) {
                pos += 1
            }
        }
        let digits = text[start..pos]
        let value = f64.tryParse(digits)
            ?? fail .syntax(message: "invalid number", offset: start, line: line, column: columnAt(start))
        finishValue()
        return .number(value: value, text: digits)
    }

    /// The string at `pos` (its opening `"`), unescaped; a text without escapes is a slice of the input.
    string readString(ref this) uses alloc fails JsonError {
        let start = pos
        pos += 1
        var sb = StrBuf()
        var escaped = false
        var run = pos
        while true {
            fail .syntax(
                message: "unterminated string",
                offset: start,
                line: line,
                column: columnAt(start),
            ) if pos >= text.length
            let b = text.bytes[pos]
            if b == '"' {
                pos += 1
                return text[run..pos - 1] if !escaped
                sb.append(text[run..pos - 1])
                return $"{sb.finish()}"
            }
            fail .syntax(
                message: "control character in a string",
                offset: pos,
                line: line,
                column: columnAt(pos),
            ) if b < 0x20
            if b != '\\' {
                pos += 1
                continue
            }
            escaped = true
            sb.append(text[run..pos])
            let at = pos
            pos += 1
            let e = peek()
            if e == '"' || e == '\\' || e == '/' {
                sb.append(text[pos..pos + 1])
                pos += 1
            } else if e == 'b' {
                sb.append("\u{8}")
                pos += 1
            } else if e == 'f' {
                sb.append("\u{C}")
                pos += 1
            } else if e == 'n' {
                sb.append("\n")
                pos += 1
            } else if e == 'r' {
                sb.append("\r")
                pos += 1
            } else if e == 't' {
                sb.append("\t")
                pos += 1
            } else if e == 'u' {
                pos += 1
                var cp = try hex4(escapeAt: at)
                if cp is 0xD800..=0xDBFF {
                    fail .syntax(
                        message: "lone surrogate",
                        offset: at,
                        line: line,
                        column: columnAt(at),
                    ) if !text[pos..].startsWith("\\u")
                    let second = pos
                    pos += 2
                    let low = try hex4(escapeAt: second)
                    fail .syntax(
                        message: "lone surrogate",
                        offset: at,
                        line: line,
                        column: columnAt(at),
                    ) if low is < 0xDC00
                        or > 0xDFFF
                    cp = 0x10000 + (cp - 0xD800) * 0x400 + (low - 0xDC00)
                } else if cp is 0xDC00..=0xDFFF {
                    fail .syntax(message: "lone surrogate", offset: at, line: line, column: columnAt(at))
                }
                sb.append($"{rune(cp)}")
            } else {
                fail .syntax(message: "invalid escape", offset: at, line: line, column: columnAt(at))
            }
            run = pos
        }
    }

    /// Four hex digits at `pos` as a code unit; `escapeAt` is the `\` of the escape, for the error.
    u32 hex4(ref this, i64 escapeAt) fails JsonError {
        var value: u32 = 0
        for _ in 0..4 {
            let b = peek()
            var d: u32 = 0
            if b >= '0' && b <= '9' {
                d = u32(b - '0')
            } else if b >= 'a' && b <= 'f' {
                d = u32(b - 'a') + 10
            } else if b >= 'A' && b <= 'F' {
                d = u32(b - 'A') + 10
            } else {
                fail .syntax(message: "invalid \\u escape", offset: escapeAt, line: line, column: columnAt(escapeAt))
            }
            value = value * 16 + d
            pos += 1
        }
        return value
    }
}

bool isDigit(u8 b) => b >= '0' && b <= '9'
"""

const stdSource2: string = """// std.json tree (spec 016 T4, 015 S7): `JsonValue` built on `JsonReader`, and `Json.encode`.

/// A JSON value. A number keeps its text, so `Json.encode` writes it back as read (a built one whose text is not a
/// JSON number is written from its value, and refused when that is not finite); an object keeps its members in text order, duplicate keys included.
public union JsonValue {
    nothing
    flag(bool value)
    number(f64 value, string text)
    text(string value)
    list(List<JsonValue> items)
    object(List<JsonMember> members)
}

/// One `key: value` of an object.
public struct JsonMember {
    public string    key
    public JsonValue value
}

/// Parsing JSON text into a tree and writing a tree as text.
public struct Json {
    /// The value `text` holds, read with `JsonReader`; outside data, so `Untrusted`.
    public static Untrusted<JsonValue> parse(string text) uses alloc fails JsonError {
        var reader = JsonReader.over(text)
        let first = (try reader.next()) ?? panic("std.json: a reader gives a token before its end")
        let value = try treeOf(ref reader, from: first)
        let _ = try reader.next()
        return Untrusted(move value)
    }

    /// `v` as text, the layout of Python's `json.dumps(v, indent=indent)` with `ensure_ascii`: compact with `, ` and
    /// `: ` when `indent` is 0 or less, else one item per line, `indent` spaces per level. A number is its text when that
    /// is a JSON number (RFC 8259 §6), else its value as shortest digits, so a built number never writes invalid JSON or
    /// text outside itself; NaN and ±infinity fail `nonFinite` (spec §6.6). Lists and objects nesting deeper than
    /// `maxDepth` fail `nestedTooDeep`, before the recursion goes past that depth.
    public static string encode(JsonValue v, i32 indent = 0) uses alloc fails JsonError {
        var sb = StrBuf()
        try encodeInto(ref sb, from: v, by: i64(indent), at: 0)
        return $"{sb.finish()}"
    }
}

/// The value that starts with `first`; the reader's depth limit bounds the recursion.
JsonValue treeOf(ref JsonReader reader, from JsonToken first) uses alloc fails JsonError {
    switch first {
        case .startList:
            var items = List<JsonValue>()
            while true {
                let token = (try reader.next()) ?? panic("std.json: a reader gives a token before its end")
                return .list(items: move items) if token is .endList
                items.append(try treeOf(ref reader, from: token))
            }
        case .startObject:
            var members = List<JsonMember>()
            while true {
                let token = (try reader.next()) ?? panic("std.json: a reader gives a token before its end")
                switch token {
                    case .endObject: return .object(members: move members)
                    case .key(let name):
                        let next = (try reader.next()) ?? panic("std.json: a reader gives a token before its end")
                        members.append(JsonMember { key: name, value: try treeOf(ref reader, from: next) })
                    default: panic("std.json: a reader gives a key or `}` in an object")
                }
            }
        case .text(let value): return .text(value: value)
        case .number(let value, let text): return .number(value: value, text: text)
        case .flag(let value): return .flag(value: value)
        case .nothing: return .nothing
        default: panic("std.json: a reader starts a value with a value token")
    }
}

/// `v` at nesting `level` (the number of lists and objects around it); a list or object at `maxDepth` fails.
void encodeInto(ref StrBuf sb, from JsonValue v, by i64 indent, at i64 level) uses alloc fails JsonError {
    switch v {
        case .nothing: sb.append("null")
        case .flag(let value): sb.append(value ? "true" : "false")
        case .number(let value, let text): try numberInto(ref sb, from: value, as: text)
        case .text(let value): quoteInto(ref sb, from: value)
        case .list(let items):
            fail .nestedTooDeep if level >= maxDepth
            if items.length == 0 {
                sb.append("[]")
                return
            }
            sb.append("[")
            for i in 0..items.length {
                separate(ref sb, by: indent, at: level + 1, first: i == 0)
                try encodeInto(ref sb, from: items[i], by: indent, at: level + 1)
            }
            newline(ref sb, by: indent, at: level)
            sb.append("]")
        case .object(let members):
            fail .nestedTooDeep if level >= maxDepth
            if members.length == 0 {
                sb.append("{}")
                return
            }
            sb.append("{")
            for i in 0..members.length {
                separate(ref sb, by: indent, at: level + 1, first: i == 0)
                quoteInto(ref sb, from: members[i].key)
                sb.append(": ")
                try encodeInto(ref sb, from: members[i].value, by: indent, at: level + 1)
            }
            newline(ref sb, by: indent, at: level)
            sb.append("}")
    }
}

/// `text` when it is one whole JSON number, else `value`, which fails `nonFinite` when it is not finite (only then is
/// `value - value` not 0).
void numberInto(ref StrBuf sb, from f64 value, as string text) uses alloc fails JsonError {
    if isNumberText(text) {
        sb.append(text)
        return
    }
    fail .nonFinite if value - value != 0.0
    sb.append($"{value}")
}

/// Whether `text` is exactly one JSON number, as `JsonReader` reads it.
bool isNumberText(string text) uses alloc {
    var reader = JsonReader.over(text)
    let token = reader.next() catch { return false }
    return token is .number(_, let digits) && digits.length == text.length
}

/// Before an item: `, ` (compact) or `,` and a new line (indented); the first item has no comma.
void separate(ref StrBuf sb, by i64 indent, at i64 level, bool first) {
    if !first {
        sb.append(indent > 0 ? "," : ", ")
    }
    newline(ref sb, by: indent, at: level)
}

void newline(ref StrBuf sb, by i64 indent, at i64 level) {
    return if indent <= 0
    sb.append("\n")
    sb.appendRepeated(' ', by: indent * level)
}

/// `s` as a JSON string with Python's `ensure_ascii` escapes: `\uXXXX` (lowercase, a surrogate pair above U+FFFF)
/// for every rune outside `' '..'~'` that has no short escape.
void quoteInto(ref StrBuf sb, from string s) {
    sb.append("\"")
    for r in s.runes {
        let cp = r.value
        if r == '"' {
            sb.append("\\\"")
        } else if r == '\\' {
            sb.append("\\\\")
        } else if r == '\n' {
            sb.append("\\n")
        } else if r == '\r' {
            sb.append("\\r")
        } else if r == '\t' {
            sb.append("\\t")
        } else if cp == 0x8 {
            sb.append("\\b")
        } else if cp == 0xC {
            sb.append("\\f")
        } else if cp is 0x20..=0x7E {
            sb.append($"{r}")
        } else if cp > 0xFFFF {
            let v = cp - 0x10000
            unitInto(ref sb, from: 0xD800 + v / 0x400)
            unitInto(ref sb, from: 0xDC00 + v % 0x400)
        } else {
            unitInto(ref sb, from: cp)
        }
    }
    sb.append("\"")
}

void unitInto(ref StrBuf sb, from u32 unit) {
    sb.append("\\u")
    let digits = string(unit, as: .hex)
    sb.appendRepeated('0', by: 4 - digits.length)
    sb.append(digits)
}
"""
== semantics/symbols.byn
// T3: Symbols/Symbols.cs (the symbol structs and `AliasPlaceholder`), one arena per class.
//
// Symbols copy facts, they do not store syntax. Each symbol keeps its `file` (a `Ctx.files` index),
// `declIndex` (its index in `c.files[file].unit.members`, or the enclosing decl's for a nested one)
// and `memberIndex` (-1 when not nested), its `TextSpan` location (`span`), the declaration's `Name`
// (`name` plus `nameSpan`), the `Modifiers` bits, the `Accessibility`, and the `///` doc. The scalar
// facts copied from the C# `.Decl` are:
//   * names and spans — `name`, `nameSpan`, `span` (and `doc`, an attribute's `@name`s).
//   * flags — `modifiers` bits, `hasDefault`, `isStatic`/`isMutating`/`hasFails`/`infersErrors`,
//     `isUsing`, `borrowsSubject`, `isCatch`, `written`, `isParameter`, `resolving`.
//   * counts — `ordinal`, `tag`, `code`, `exitCode`, `index`, `state` (and `of` for error sets).
//   * the `becomes`/`refThis`/`moveThis` name-and-span scalars.
// Anything that is syntax (a member list, a default expression, a `where` clause, a `requires` rule,
// or a `uses` clause) is re-read from the retained tree through `declIndex`/`memberIndex` at the
// point of use; the declare pass (`declare.byn`, T5+) fills the `List<…Id>` member lists from the
// tree.
//
// References between symbols are handles (`StructId`, `FuncId`, …), lists of symbols are
// `List<…Id>`, and the C# dictionaries are `Map<string, …Id>` (insertion order matches the C#
// `Dictionary` for add-only use). Symbol structs holding a `List` or `Map` are `unique`, so they are
// read by chained field access, never copied into a `let`. Every function takes `ref Ctx c` as its
// unlabeled object; later parameters carry a particle (`by` an operand, `for` a name).

import parser

// ── Enums ────────────────────────────────────────────────────────────────────

/// C# `Accessibility`: `Private`, `Module`, `Public`.
public enum Accessibility {
    privateKeyword
    module
    publicKeyword
}

/// C# `FunctionKind`.
public enum FunctionKind {
    function
    method
    constructor
    getter
    main
    testKeyword
    builtin
    lambda
    invoke
}

/// C# `LocalKind`.
public enum LocalKind {
    letKeyword
    varKeyword
    constKeyword
    parameter
    forVariable
    patternVariable
    temp
}

/// C# `BuiltinFunction`.
public enum BuiltinFunction {
    none
    print
    log
    panic
    todo
    listNew
    arenaNew
    strBufNew
    strBufGrow
    strBufOver
    ownedNew
    untrustedNew
    trust
    ioReadFile
    ioReadText
    ioWriteFile
    ioRemove
    ioCreateDirectory
    ioRemoveDirectory
    ioListDir
    ioRun
    ioRunBatch
    ioMonotonicNanos
    ioRandomU64
    ioStdout
    ioStderr
    ioStdin
    ioStdinReadAllBytes
    utf8Decode
    utf8TryDecode
    utf8DecodeReplace
    hexEncode
    hexDecode
    symbolIntern
    stringInvalidUtf8At
    intParse
    enumFromOrdinal
    enumParse
    pathIsRooted
    pathRelative
    pathFileName
    pathDirectoryName
    pathCombine
    pathCombineSpan
    pathFullPath
    envGet
    fsFileExists
    fsRename
    fsCopy
    fsModified
    fsSetModified
    fsRealPath
    timeNow
    timeFromNanos
}

// ── Symbols ──────────────────────────────────────────────────────────────────

public struct StructSymbol {
    public string              name
    public TextSpan            nameSpan     = TextSpan { start: 0, length: 0 }
    public TextSpan            span         = TextSpan { start: 0, length: 0 }
    public ModId               module       = -1
    public FileId              file         = -1
    public i64                 declIndex    = -1
    public i64                 memberIndex  = -1
    public Accessibility       access       = .module
    public i64                 modifiers    = 0
    public string?             doc          = null
    /// The `T.Field` enum generated for a `requires` struct, or -1.
    public EnumId              fieldEnum    = -1
    public List<FieldId>       fields       = []
    public List<PropertyId>    properties   = []
    public List<FuncId>        methods      = []
    public List<FuncId>        constructors = []
    public List<TypeParamId>   typeParams   = []
    public StructId            template     = -1
    public List<Type>          typeArgs     = []
    public Map<string, Type>   typeMap      = []
    public List<InterfaceId>   bases        = []
    public List<ConformanceId> conformances = []
    /// The `@name` attribute names in order (for `@noEquality`/`@sealed`).
    public List<string>        attributes   = []
}

public struct FieldSymbol {
    public string        name
    public TextSpan      nameSpan     = TextSpan { start: 0, length: 0 }
    public TextSpan      span         = TextSpan { start: 0, length: 0 }
    public StructId      owner        = -1
    public FileId        file         = -1
    public i64           declIndex    = -1
    public i64           memberIndex  = -1
    public Accessibility access       = .module
    public i64           modifiers    = 0
    public Type          type         = -1
    public bool          hasDefault   = false
    /// T4 (Q539): C# `Default`, the bound default value, or -1.
    public BExpr         defaultValue = -1
}

public struct PropertySymbol {
    public string        name
    public TextSpan      nameSpan    = TextSpan { start: 0, length: 0 }
    public TextSpan      span        = TextSpan { start: 0, length: 0 }
    public StructId      owner       = -1
    public FileId        file        = -1
    public i64           declIndex   = -1
    public i64           memberIndex = -1
    public Accessibility access      = .module
    public i64           modifiers   = 0
    public Type          type        = -1
    public FuncId        getter      = -1
}

public struct FunctionSymbol {
    public string            name
    public TextSpan          nameSpan       = TextSpan { start: 0, length: 0 }
    public TextSpan          span           = TextSpan { start: 0, length: 0 }
    public ModId             module         = -1
    public FunctionKind      kind           = .function
    public Accessibility     access         = .module
    public i64               modifiers      = 0
    public FileId            file           = -1
    public i64               declIndex      = -1
    public i64               memberIndex    = -1
    public StructId          owner          = -1
    public InterfaceId       iface          = -1
    public bool              isAbstract     = false
    public bool              isStatic       = false
    public List<LocalId>     parameters     = []
    public Type              returnType     = -1
    public List<ErrorSetId>  errorSets      = []
    public List<VariantId>   excludedErrors = []
    public bool              hasFails       = false
    public bool              infersErrors   = false
    public BuiltinFunction   builtin        = .none
    public List<LocalId>     locals         = []
    public bool              isMutating     = false
    public List<TypeParamId> typeParams     = []
    public FuncId            template       = -1
    public List<Type>        typeArgs       = []
    public List<LocalId>     captures       = []
    public FuncId            enclosing      = -1
    public Map<string, Type> typeMap        = []
    /// The `becomes .s` name, or null.
    public string?           becomes        = null
    public TextSpan?         refThis        = null
    public TextSpan?         moveThis       = null
    /// T4 (Q539): C# `Body` (a `BoundBlock`) or -1, and `Requires`.
    public BStmt             body           = -1
    public List<BExpr>       requirements   = []
}

public struct InterfaceSymbol {
    public string            name
    public TextSpan          nameSpan        = TextSpan { start: 0, length: 0 }
    public TextSpan          span            = TextSpan { start: 0, length: 0 }
    public ModId             module          = -1
    public FileId            file            = -1
    public i64               declIndex       = -1
    public i64               memberIndex     = -1
    public Accessibility     access          = .module
    public i64               modifiers       = 0
    public List<FuncId>      methods         = []
    public List<FuncId>      properties      = []
    public List<TypeParamId> associatedTypes = []
    /// The `Self` type parameter constrained to this interface, or -1 until needed.
    public TypeParamId       self            = -1
    public List<TypeParamId> typeParams      = []
    public InterfaceId       template        = -1
    public List<Type>        typeArgs        = []
    public Map<string, Type> typeMap         = []
}

/// The C# `Conformance`: one struct's conformance to one interface instance.
public struct Conformance {
    public StructId             type            = -1
    public InterfaceId          iface           = -1
    public Map<FuncId, FuncId>  witnesses       = []
    public Map<FuncId, FieldId> fieldWitnesses  = []
    public Map<string, Type>    associatedTypes = []
}

/// The C# `LocalSymbol`, also carrying `ParameterSymbol`'s fields (`isParameter` says which).
public struct LocalSymbol {
    public string    name
    public TextSpan  nameSpan       = TextSpan { start: 0, length: 0 }
    public TextSpan  span           = TextSpan { start: 0, length: 0 }
    public Type      type           = -1
    public LocalKind kind           = .letKeyword
    public bool      isUsing        = false
    public i64       id             = -1
    public bool      borrowsSubject = false
    public bool      isCatch        = false
    public TextSpan? keywordSpan    = null
    public TextSpan? guardSpan      = null
    public bool      written        = false
    /// `ParameterSymbol`'s fields:
    public bool      isParameter    = false
    public parser.ParamModifier modifier = .none
    public i64       ordinal        = -1
    /// T4 (Q539): C# `Constant`, and `ParameterSymbol.Default` (-1 for none).
    public Constant? constant       = null
    public BExpr     defaultValue   = -1
}

public struct ConstSymbol {
    public string         name
    public TextSpan       nameSpan      = TextSpan { start: 0, length: 0 }
    public TextSpan       span          = TextSpan { start: 0, length: 0 }
    public ModId          module        = -1
    public FileId         file          = -1
    public i64            declIndex     = -1
    public Type           type          = -1
    /// Binding state, to detect constants defined in terms of themselves.
    public i64            state         = 0
    public bool           isStaticArray = false
    /// T4 (Q539): C# `Value`, `Bound` (-1 for none) and `Elements`.
    public Constant?      value         = null
    public BExpr          bound         = -1
    public List<Constant> elements      = []
}

public struct ErrorSetSymbol {
    public string          name
    public TextSpan        nameSpan    = TextSpan { start: 0, length: 0 }
    public TextSpan        span        = TextSpan { start: 0, length: 0 }
    public ModId           module      = -1
    public FileId          file        = -1
    public i64             declIndex   = -1
    public i64             memberIndex = -1
    public Accessibility   access      = .module
    public i64             modifiers   = 0
    public List<VariantId> variants    = []
    /// For `ValidationError<T>`, that `T`; -1 when absent.
    public Type            of          = -1
}

public struct ErrorVariantSymbol {
    public string        name
    public TextSpan      nameSpan    = TextSpan { start: 0, length: 0 }
    public TextSpan      span        = TextSpan { start: 0, length: 0 }
    public ErrorSetId    set         = -1
    public FileId        file        = -1
    public i64           declIndex   = -1
    public i64           memberIndex = -1
    public i64           code        = 0
    public string?       doc         = null
    public List<LocalId> fields      = []
    public i64           exitCode    = 1
}

public struct TestSymbol {
    public string   title
    public TextSpan span      = TextSpan { start: 0, length: 0 }
    public FuncId   function  = -1
    public FileId   file      = -1
    public i64      declIndex = -1
}

public struct EnumSymbol {
    public string             name
    public TextSpan           nameSpan    = TextSpan { start: 0, length: 0 }
    public TextSpan           span        = TextSpan { start: 0, length: 0 }
    public ModId              module      = -1
    public FileId             file        = -1
    public i64                declIndex   = -1
    public i64                memberIndex = -1
    public Accessibility      access      = .module
    public i64                modifiers   = 0
    public List<EnumMemberId> members     = []
    public List<EnumFieldId>  fields      = []
    public FuncId             fromOrdinal = -1
    public FuncId             parse       = -1
    /// For `T.Field` (J23): the struct whose fields are the members, or -1.
    public StructId           fieldsOf    = -1
}

public struct EnumFieldSymbol {
    public string   name
    public TextSpan nameSpan = TextSpan { start: 0, length: 0 }
    public TextSpan span     = TextSpan { start: 0, length: 0 }
    public EnumId   owner    = -1
    public Type     type     = -1
    public i64      index    = -1
}

public struct EnumMemberSymbol {
    public string          name
    public TextSpan        nameSpan = TextSpan { start: 0, length: 0 }
    public TextSpan        span     = TextSpan { start: 0, length: 0 }
    public EnumId          owner    = -1
    public i64             ordinal  = -1
    public string?         doc      = null
    /// T4 (Q539): C# `Values`, one per enum field; null where C# has null.
    public List<Constant?> values   = []
}

public struct UnionSymbol {
    public string            name
    public TextSpan          nameSpan    = TextSpan { start: 0, length: 0 }
    public TextSpan          span        = TextSpan { start: 0, length: 0 }
    public ModId             module      = -1
    public FileId            file        = -1
    public i64               declIndex   = -1
    public i64               memberIndex = -1
    public Accessibility     access      = .module
    public i64               modifiers   = 0
    public List<VariantId>   variants    = []
    public List<TypeParamId> typeParams  = []
    public UnionId           template    = -1
    public List<Type>        typeArgs    = []
    public Map<string, Type> typeMap     = []
}

public struct UnionVariantSymbol {
    public string        name
    public TextSpan      nameSpan    = TextSpan { start: 0, length: 0 }
    public TextSpan      span        = TextSpan { start: 0, length: 0 }
    public UnionId       owner       = -1
    public FileId        file        = -1
    public i64           declIndex   = -1
    public i64           memberIndex = -1
    public i64           tag         = -1
    public string?       doc         = null
    public List<LocalId> fields      = []
}

/// The C# `TypeParameterType`'s data: its name and its `where`-clause constraints.
public struct TypeParam {
    public string name
    public List<InterfaceId> constraints = []
}

/// A `type X = T` alias or a `union error S = A, B`; resolved to its target on first use.
public struct AliasPlaceholder {
    public string   name
    public TextSpan nameSpan  = TextSpan { start: 0, length: 0 }
    public TextSpan span      = TextSpan { start: 0, length: 0 }
    public FileId   file      = -1
    public i64      declIndex = -1
    public i64      modifiers = 0
    public Type     target    = -1
    public bool     resolving = false
}

// ── Arena construction ───────────────────────────────────────────────────────

StructId newStruct(ref Ctx c, by move StructSymbol s) {
    c.structs.append(move s)
    return c.structs.length - 1
}

FieldId newField(ref Ctx c, by move FieldSymbol s) {
    c.fields.append(move s)
    return c.fields.length - 1
}

PropertyId newProperty(ref Ctx c, by move PropertySymbol s) {
    c.properties.append(move s)
    return c.properties.length - 1
}

FuncId newFunction(ref Ctx c, by move FunctionSymbol s) {
    c.functions.append(move s)
    return c.functions.length - 1
}

InterfaceId newInterface(ref Ctx c, by move InterfaceSymbol s) {
    c.interfaces.append(move s)
    return c.interfaces.length - 1
}

ConformanceId newConformance(ref Ctx c, by move Conformance s) {
    c.conformances.append(move s)
    return c.conformances.length - 1
}

LocalId newLocal(ref Ctx c, by move LocalSymbol s) {
    c.locals.append(move s)
    return c.locals.length - 1
}

ConstId newConst(ref Ctx c, by move ConstSymbol s) {
    c.consts.append(move s)
    return c.consts.length - 1
}

ErrorSetId newErrorSet(ref Ctx c, by move ErrorSetSymbol s) {
    c.errorSets.append(move s)
    return c.errorSets.length - 1
}

VariantId newErrorVariant(ref Ctx c, by move ErrorVariantSymbol s) {
    c.errorVariants.append(move s)
    return c.errorVariants.length - 1
}

TestId newTest(ref Ctx c, by move TestSymbol s) {
    c.tests.append(move s)
    return c.tests.length - 1
}

EnumId newEnum(ref Ctx c, by move EnumSymbol s) {
    c.enums.append(move s)
    return c.enums.length - 1
}

EnumFieldId newEnumField(ref Ctx c, by move EnumFieldSymbol s) {
    c.enumFields.append(move s)
    return c.enumFields.length - 1
}

EnumMemberId newEnumMember(ref Ctx c, by move EnumMemberSymbol s) {
    c.enumMembers.append(move s)
    return c.enumMembers.length - 1
}

UnionId newUnion(ref Ctx c, by move UnionSymbol s) {
    c.unions.append(move s)
    return c.unions.length - 1
}

VariantId newUnionVariant(ref Ctx c, by move UnionVariantSymbol s) {
    c.unionVariants.append(move s)
    return c.unionVariants.length - 1
}

TypeParamId newTypeParam(ref Ctx c, by move TypeParam s) {
    c.typeParams.append(move s)
    return c.typeParams.length - 1
}

AliasId newAlias(ref Ctx c, by move AliasPlaceholder s) {
    c.aliases.append(move s)
    return c.aliases.length - 1
}

// ── Named-type handles ───────────────────────────────────────────────────────

public Type structTypeOf(StructId s) => makeType(.structType, at: s)

public Type interfaceTypeOf(InterfaceId i) => makeType(.interfaceType, at: i)

public Type enumTypeOf(EnumId e) => makeType(.enumType, at: e)

public Type unionTypeOf(UnionId u) => makeType(.unionType, at: u)

public Type errorSetTypeOf(ErrorSetId e) => makeType(.errorSet, at: e)

public Type typeParamTypeOf(TypeParamId tp) => makeType(.typeParam, at: tp)

// ── Display helpers ──────────────────────────────────────────────────────────

/// The C# `TypeSymbol.Qualify`: prefix a declared name with its module when qualifying is on and the
/// module is not `builtin`.
public string qualify(ref Ctx c, by ModId module, for string name) uses alloc =>
    c.qualifyModules && c.modules[module].name != "builtin" ? $"{c.modules[module].name}.{name}" : name

/// The C# `StructSymbol.DisplayName`.
public string structDisplayName(ref Ctx c, by StructId s) uses alloc {
    let name = c.structs[s].name
    let module = c.structs[s].module
    let q = qualify(ref c, by: module, for: name)
    var typeArgs = copyIds(in c.structs[s].typeArgs)
    if typeArgs.length > 0 {
        var sb = StrBuf()
        sb.append($"{q}<")
        for i in 0..typeArgs.length {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(typeDisplay(ref c, by: typeArgs[i]))
        }
        sb.append(">")
        return $"{sb.finish()}"
    }
    var typeParams = copyIds(in c.structs[s].typeParams)
    if typeParams.length > 0 {
        var sb = StrBuf()
        sb.append($"{name}<")
        for i in 0..typeParams.length {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(c.typeParams[typeParams[i]].name)
        }
        sb.append(">")
        return $"{sb.finish()}"
    }
    return q
}

/// The C# `InterfaceSymbol.DisplayName`.
public string interfaceDisplayName(ref Ctx c, by InterfaceId i) uses alloc {
    let name = c.interfaces[i].name
    let module = c.interfaces[i].module
    let q = qualify(ref c, by: module, for: name)
    var typeArgs = copyIds(in c.interfaces[i].typeArgs)
    if typeArgs.length > 0 {
        var sb = StrBuf()
        sb.append($"{q}<")
        for k in 0..typeArgs.length {
            if k > 0 {
                sb.append(", ")
            }
            sb.append(typeDisplay(ref c, by: typeArgs[k]))
        }
        sb.append(">")
        return $"{sb.finish()}"
    }
    var typeParams = copyIds(in c.interfaces[i].typeParams)
    if typeParams.length > 0 {
        var sb = StrBuf()
        sb.append($"{name}<")
        for k in 0..typeParams.length {
            if k > 0 {
                sb.append(", ")
            }
            sb.append(c.typeParams[typeParams[k]].name)
        }
        sb.append(">")
        return $"{sb.finish()}"
    }
    return q
}

/// The C# `EnumSymbol.DisplayName` (`T.Field` for a generated field enum).
public string enumDisplayName(ref Ctx c, by EnumId e) uses alloc {
    let fieldsOf = c.enums[e].fieldsOf
    if fieldsOf != -1 {
        let fName = c.structs[fieldsOf].name
        let fModule = c.structs[fieldsOf].module
        return $"{qualify(ref c, by: fModule, for: fName)}.Field"
    }
    let module = c.enums[e].module
    let name = c.enums[e].name
    return qualify(ref c, by: module, for: name)
}

/// The C# `UnionSymbol.DisplayName`.
public string unionDisplayName(ref Ctx c, by UnionId u) uses alloc {
    let name = c.unions[u].name
    let module = c.unions[u].module
    let q = qualify(ref c, by: module, for: name)
    var typeArgs = copyIds(in c.unions[u].typeArgs)
    if typeArgs.length > 0 {
        var sb = StrBuf()
        sb.append($"{q}<")
        for i in 0..typeArgs.length {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(typeDisplay(ref c, by: typeArgs[i]))
        }
        sb.append(">")
        return $"{sb.finish()}"
    }
    var typeParams = copyIds(in c.unions[u].typeParams)
    if typeParams.length > 0 {
        var sb = StrBuf()
        sb.append($"{name}<")
        for i in 0..typeParams.length {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(c.typeParams[typeParams[i]].name)
        }
        sb.append(">")
        return $"{sb.finish()}"
    }
    return q
}

/// The C# `ErrorSetSymbol.DisplayName`.
public string errorSetDisplayName(ref Ctx c, by ErrorSetId e) uses alloc {
    let name = c.errorSets[e].name
    let module = c.errorSets[e].module
    let of = c.errorSets[e].of
    return qualify(ref c, by: module, for: name) if of == -1
    return $"{name}<{typeDisplay(ref c, by: of)}>"
}

/// The C# `ErrorSetSymbol.DisplayNameAmong`: qualify when a peer would read the same.
public string displayNameAmong(ref Ctx c, by ErrorSetId e, for in List<ErrorSetId> among) uses alloc {
    let own = errorSetDisplayName(ref c, by: e)
    var peer = false
    for p in among {
        if p != e && errorSetDisplayName(ref c, by: p) == own {
            peer = true
            break
        }
    }
    return own if !peer
    let outer = c.qualifyModules
    c.qualifyModules = true
    let result = errorSetDisplayName(ref c, by: e)
    c.qualifyModules = outer
    return result
}

/// The C# `FunctionSymbol.DisplaySignature`.
public string functionDisplaySignature(ref Ctx c, by FuncId f) uses alloc {
    let name = c.functions[f].name
    let owner = c.functions[f].owner
    var params = copyIds(in c.functions[f].parameters)
    var sb = StrBuf()
    if owner != -1 {
        sb.append($"{c.structs[owner].name}.")
    }
    sb.append($"{name}(")
    for i in 0..params.length {
        if i > 0 {
            sb.append(", ")
        }
        let p = c.locals[params[i]]
        sb.append($"{typeDisplay(ref c, by: p.type)} {p.name}")
    }
    sb.append(")")
    return $"{sb.finish()}"
}

/// The C# `ErrorVariantSymbol.Summary`: the doc's first line, trimmed, or the name.
public string errorVariantSummary(ref Ctx c, by VariantId v) {
    let doc = c.errorVariants[v].doc
    if doc is not null {
        if doc.length > 0 {
            let nl = doc.position("\n")
            return doc[0..nl].trimmed() if nl is not null
            return doc.trimmed()
        }
    }
    return c.errorVariants[v].name
}

// ── Lookups ──────────────────────────────────────────────────────────────────

/// The C# `StructSymbol.FindField`, or -1.
public FieldId findField(ref Ctx c, by StructId s, for string name) {
    for f in c.structs[s].fields {
        return f if c.fields[f].name == name
    }
    return -1
}

/// The C# `StructSymbol.FindProperty`, or -1.
public PropertyId findProperty(ref Ctx c, by StructId s, for string name) {
    for p in c.structs[s].properties {
        return p if c.properties[p].name == name
    }
    return -1
}

/// The C# `StructSymbol.FindMethods`.
public List<FuncId> findMethods(ref Ctx c, by StructId s, for string name) uses alloc {
    var result = List<FuncId>()
    for m in c.structs[s].methods {
        if c.functions[m].name == name {
            result.append(m)
        }
    }
    return result
}

/// The C# `InterfaceSymbol.FindMethods`.
public List<FuncId> findInterfaceMethods(ref Ctx c, by InterfaceId i, for string name) uses alloc {
    var result = List<FuncId>()
    for m in c.interfaces[i].methods {
        if c.functions[m].name == name {
            result.append(m)
        }
    }
    return result
}

/// The C# `InterfaceSymbol.FindProperty`, or -1.
public FuncId findInterfaceProperty(ref Ctx c, by InterfaceId i, for string name) {
    for p in c.interfaces[i].properties {
        return p if c.functions[p].name == name
    }
    return -1
}

/// The C# `ErrorSetSymbol.Find`, or -1.
public VariantId findErrorVariant(ref Ctx c, by ErrorSetId e, for string name) {
    for v in c.errorSets[e].variants {
        return v if c.errorVariants[v].name == name
    }
    return -1
}

/// The C# `EnumSymbol.Find`, or -1.
public EnumMemberId findEnumMember(ref Ctx c, by EnumId e, for string name) {
    for m in c.enums[e].members {
        return m if c.enumMembers[m].name == name
    }
    return -1
}

/// The C# `EnumSymbol.FindField`, or -1.
public EnumFieldId findEnumField(ref Ctx c, by EnumId e, for string name) {
    for f in c.enums[e].fields {
        return f if c.enumFields[f].name == name
    }
    return -1
}

/// The C# `UnionSymbol.Find`, or -1.
public VariantId findUnionVariant(ref Ctx c, by UnionId u, for string name) {
    for v in c.unions[u].variants {
        return v if c.unionVariants[v].name == name
    }
    return -1
}

// ── Computed members ─────────────────────────────────────────────────────────

/// The C# `StructSymbol.IsGeneric`.
public bool structIsGeneric(ref Ctx c, by StructId s) uses alloc {
    return true if c.structs[s].typeParams.length > 0
    var args = copyIds(in c.structs[s].typeArgs)
    for a in args {
        return true if occurs(ref c, by: a)
    }
    return false
}

/// The C# `InterfaceSymbol.IsGeneric`.
public bool interfaceIsGeneric(ref Ctx c, by InterfaceId i) uses alloc {
    return true if c.interfaces[i].typeParams.length > 0
    var args = copyIds(in c.interfaces[i].typeArgs)
    for a in args {
        return true if occurs(ref c, by: a)
    }
    return false
}

/// The C# `UnionSymbol.IsGeneric`.
public bool unionIsGeneric(ref Ctx c, by UnionId u) uses alloc {
    return true if c.unions[u].typeParams.length > 0
    var args = copyIds(in c.unions[u].typeArgs)
    for a in args {
        return true if occurs(ref c, by: a)
    }
    return false
}

/// The C# `FunctionSymbol.IsGeneric`.
public bool functionIsGeneric(ref Ctx c, by FuncId f) uses alloc {
    let owner = c.functions[f].owner
    let iface = c.functions[f].iface
    let enclosing = c.functions[f].enclosing
    return true if c.functions[f].typeParams.length > 0
    var args = copyIds(in c.functions[f].typeArgs)
    for a in args {
        return true if occurs(ref c, by: a)
    }
    return true if owner != -1 && structIsGeneric(ref c, by: owner)
    return true if iface != -1
    return true if enclosing != -1 && functionIsGeneric(ref c, by: enclosing)
    return false
}

/// The C# `FunctionSymbol.IsInstance`.
public bool functionIsInstance(ref Ctx c, by FuncId f) {
    let template = c.functions[f].template
    let owner = c.functions[f].owner
    let enclosing = c.functions[f].enclosing
    return true if template != -1
    return true if owner != -1 && c.structs[owner].template != -1
    return true if enclosing != -1 && functionIsInstance(ref c, by: enclosing)
    return false
}

/// The C# `FunctionSymbol.HasThis`.
public bool functionHasThis(ref Ctx c, by FuncId f) {
    let owner = c.functions[f].owner
    let iface = c.functions[f].iface
    return false if owner == -1 && iface == -1
    return false if c.functions[f].isStatic
    let kind = c.functions[f].kind
    return kind is .method or .getter or .constructor
}

/// The C# `StructSymbol.IsDefaultable`.
public bool structIsDefaultable(ref Ctx c, by StructId s) uses alloc {
    var fields = copyIds(in c.structs[s].fields)
    for f in fields {
        return false if !c.fields[f].hasDefault || (c.fields[f].modifiers & 16) != 0
    }
    return true
}

/// The C# `FieldSymbol.IsRequired`.
public bool fieldIsRequired(ref Ctx c, by FieldId f) => (c.fields[f].modifiers & 16) != 0

/// The C# `FieldSymbol.IsReadonly`.
public bool fieldIsReadonly(ref Ctx c, by FieldId f) => (c.fields[f].modifiers & 8) != 0

/// The C# `LocalSymbol.IsMutable`.
public bool localIsMutable(ref Ctx c, by LocalId l) =>
    c.locals[l].kind is .varKeyword or .temp

/// The C# `ParameterSymbol.IsByRef`.
public bool paramIsByRef(ref Ctx c, by LocalId l) =>
    c.locals[l].isParameter && (c.locals[l].modifier is .refKeyword or .outKeyword)

/// The C# `TypeParameterType`'s name.
public string typeParamDisplayName(ref Ctx c, by TypeParamId tp) => c.typeParams[tp].name
== semantics/typed.byn
// T26: TypedDump.cs (`bayan types`): every bound function with the resolved type of each parameter and
// local, as the indented JSON `Utf8JsonWriter` writes with `UnsafeRelaxedJsonEscaping` (format in
// `docs/typed-dump.md`). Functions go in module, file and source order; bindings in bind order,
// parameters first. Generic templates only, never instances. The writer's output is built by hand:
// two-space indent, `"key": value`, an empty array as `[]` (Q645).

/// TypedDump.cs:15 `Version`.
const typedDumpVersion: i64 = 1

/// TypedDump.cs:17 `ToJson`.
public string typedDump(ref Ctx c) uses alloc {
    var sb = StrBuf()
    sb.append("{\n")
    sb.append($"  \"version\": {typedDumpVersion},\n")
    sb.append("  \"functions\": [")
    var any = false
    for module in 0..c.modules.length {
        // `File is not null && Location is not null && !IsInstance`: a symbol with a file has a location (Q645).
        var functions = List<FuncId>()
        for k in 0..c.modules[module].allFunctions.length {
            let f = c.modules[module].allFunctions[k]
            if c.functions[f].file >= 0 && !functionIsInstance(ref c, by: f) {
                functions.append(f)
            }
        }
        t26OrderFunctions(ref c, by: module, to: ref functions)
        for fn in functions {
            sb.append(any ? ",\n    {\n" : "\n    {\n")
            any = true
            let path = c.files[c.functions[fn].file].path
            sb.append($"      \"path\": {t26JsonString(t26PathOf(ref c, for: path))},\n")
            var owner = c.functions[fn].owner
            if owner < 0 {
                owner = c.functions[t26Outermost(ref c, for: fn)].owner
            }
            let name = owner < 0 ? c.functions[fn].name : $"{c.structs[owner].name}.{c.functions[fn].name}"
            sb.append($"      \"name\": {t26JsonString(name)},\n")
            t26WriteSpan(ref sb, by: c.functions[fn].span, at: "      ")
            sb.append(",\n      \"bindings\": [")
            var anyLocal = false
            for k in 0..c.functions[fn].locals.length {
                let local = c.functions[fn].locals[k]
                // `l.Location is not null`: a Bayan local always has one (Q645).
                continue if c.locals[local].kind == .temp
                sb.append(anyLocal ? ",\n        {\n" : "\n        {\n")
                anyLocal = true
                sb.append($"          \"name\": {t26JsonString(c.locals[local].name)},\n")
                sb.append($"          \"kind\": {t26JsonString(t26KindOf(ref c, for: local))},\n")
                t26WriteSpan(ref sb, by: c.locals[local].span, at: "          ")
                sb.append($",\n          \"type\": {t26JsonString(typeDisplay(ref c, by: c.locals[local].type))}\n")
                sb.append("        }")
            }
            sb.append(anyLocal ? "\n      ]" : "]")
            if c.functions[fn].kind == .lambda {
                t26WriteCaptures(ref c, for: fn, to: ref sb)
            }
            sb.append("\n    }")
        }
    }
    sb.append(any ? "\n  ]\n" : "]\n")
    sb.append("}\n")
    return $"{sb.finish()}"
}

/// TypedDump.cs:29-31: `OrderBy(module.Files.IndexOf(f.File)).ThenBy(span start).ThenBy(span end)`, a stable
/// sort (insertion, so equal keys keep `AllFunctions` order).
void t26OrderFunctions(ref Ctx c, by ModId module, to ref List<FuncId> functions) {
    for i in 1..functions.length {
        var j = i
        while j > 0 && t26FunctionBefore(ref c, by: module, from: functions[j], to: functions[j - 1]) {
            let t = functions[j]
            functions[j] = functions[j - 1]
            functions[j - 1] = t
            j -= 1
        }
    }
}

/// Whether `a` sorts strictly before `b` by file index in `module`, span start, then span end.
bool t26FunctionBefore(ref Ctx c, by ModId module, from FuncId a, to FuncId b) {
    let fa = t26FileIndex(ref c, by: module, for: c.functions[a].file)
    let fb = t26FileIndex(ref c, by: module, for: c.functions[b].file)
    return fa < fb if fa != fb
    let sa = c.functions[a].span
    let sb = c.functions[b].span
    return sa.start < sb.start if sa.start != sb.start
    return sa.end < sb.end
}

/// The C# `module.Files.IndexOf(file)`: -1 when `file` is not one of the module's.
i64 t26FileIndex(ref Ctx c, by ModId module, for FileId file) {
    for i in 0..c.modules[module].files.length {
        return i if c.modules[module].files[i] == file
    }
    return -1
}

/// TypedDump.cs:61 `WriteCaptures`: a lambda's captures, each as the type the lambda reads it as (a
/// narrowed optional is its inner type).
void t26WriteCaptures(ref Ctx c, for FuncId lambda, to ref StrBuf sb) {
    var bound: BExpr = -1
    let enclosing = c.functions[lambda].enclosing
    if enclosing >= 0 && c.functions[enclosing].body != -1 {
        for n in descendants(in c, for: c.functions[enclosing].body) {
            if boundKind(n) == .lambda && c.bLambdas[boundIndex(n)].lambda == lambda {
                bound = n
                break
            }
        }
    }
    sb.append(",\n      \"captures\": [")
    var any = false
    if bound != -1 {
        for k in 0..c.bLambdas[boundIndex(bound)].captures.length {
            let capture = c.bLambdas[boundIndex(bound)].captures[k]
            sb.append(any ? ",\n        {\n" : "\n        {\n")
            any = true
            sb.append($"          \"name\": {t26JsonString(c.locals[c.bLocals[boundIndex(capture)].local].name)},\n")
            sb.append($"          \"type\": {t26JsonString(typeDisplay(ref c, by: exprType(in c, for: capture)))}\n")
            sb.append("        }")
        }
    }
    sb.append(any ? "\n      ]" : "]")
}

/// TypedDump.cs:75 `Outermost`.
FuncId t26Outermost(ref Ctx c, for FuncId fn) {
    var f = fn
    while c.functions[f].enclosing >= 0 {
        f = c.functions[f].enclosing
    }
    return f
}

/// TypedDump.cs:81 `WriteSpan`: `"span": { "start": …, "end": … }` at `indent`.
void t26WriteSpan(ref StrBuf sb, by TextSpan span, at string indent) {
    sb.append($"{indent}\"span\": {{\n")
    sb.append($"{indent}  \"start\": {span.start},\n")
    sb.append($"{indent}  \"end\": {span.end}\n")
    sb.append($"{indent}}}")
}

/// TypedDump.cs:89 `PathOf`: a rooted path relative to `DisplayRoot`, with forward slashes.
string t26PathOf(ref Ctx c, for string path) {
    let shown = Path.isRooted(path) ? Path.relative(c.displayRoot, to: path) : path
    var sb = StrBuf()
    var start: i64 = 0
    var k: i64 = 0
    for b in shown.bytes {
        if b == 0x5C {
            sb.append(shown[start..k])
            sb.append("/")
            start = k + 1
        }
        k += 1
    }
    sb.append(shown[start..shown.length])
    return $"{sb.finish()}"
}

/// TypedDump.cs:92 `KindOf`.
string t26KindOf(ref Ctx c, for LocalId local) {
    switch c.locals[local].kind {
        case .parameter: return "param"
        case .varKeyword: return "var"
        case .constKeyword: return "const"
        case .forVariable: return "for"
        case .patternVariable: return "pattern"
        default: return c.locals[local].isCatch ? "catch" : "let"
    }
}

/// A JSON string literal as `JavaScriptEncoder.UnsafeRelaxedJsonEscaping` writes it: `"` and `\`, the
/// short escapes `\b \t \n \f \r`, `\u00XX` for other C0 controls, DEL and C1 controls, ` `/` `,
/// and a code point above U+FFFF as its UTF-16 surrogate pair; everything else as is (Q645).
string t26JsonString(string s) {
    var sb = StrBuf()
    sb.append("\"")
    let bytes = s.bytes
    var i: i64 = 0
    while i < bytes.length {
        let d = decodeAt(bytes, at: i)
        let v = i64(d.value)
        if v == 0x22 {
            sb.append("\\\"")
        } else if v == 0x5C {
            sb.append("\\\\")
        } else if v == 0x08 {
            sb.append("\\b")
        } else if v == 0x09 {
            sb.append("\\t")
        } else if v == 0x0A {
            sb.append("\\n")
        } else if v == 0x0C {
            sb.append("\\f")
        } else if v == 0x0D {
            sb.append("\\r")
        } else if v is < 0x20 or 0x7F..=0x9F or 0x2028 or 0x2029 {
            sb.append($"\\u{t26Hex4(v)}")
        } else if v > 0xFFFF {
            let u = v - 0x10000
            sb.append($"\\u{t26Hex4(0xD800 + (u >> 10))}\\u{t26Hex4(0xDC00 + (u & 0x3FF))}")
        } else {
            sb.append(s[i..i + d.length])
        }
        i += d.length
    }
    sb.append("\"")
    return $"{sb.finish()}"
}

/// `v` (below 0x10000) as four upper-case hex digits.
string t26Hex4(i64 v) {
    let digits = "0123456789ABCDEF"
    var sb = StrBuf()
    var shift: i64 = 12
    while shift >= 0 {
        let d = (v >> shift) & 0xF
        sb.append(digits[d..d + 1])
        shift -= 4
    }
    return $"{sb.finish()}"
}
== semantics/typeresolve.byn
// T8: TypeResolver.cs.
//
// Each C# method is a function taking the resolver as `through in TypeResolver r`. Lambdas and local
// functions became private helpers (`t8…`): C#'s deferred `CheckKey` closure is a `.keyCheck` `Work`
// item plus `t8CheckKey` (Q556), and `Effects`'s local `Add` is `t8AddEffect`. An alias is a `Type`
// of kind word 25, one past `TypeKind` (Q555), so `Mod.types` can hold it as C# holds `AliasPlaceholder`.

import parser

// The C# `TypeResolver` instance: the file whose imports resolve names, the struct whose type
// parameters are in scope (-1 none) and the substitutions in force.
struct TypeResolver {
    FileId   file
    StructId container = -1
    Map<string, Type> typeArgs = []
}

// ── Aliases as types (Q555) ──────────────────────────────────────────────────

const t8AliasKind: i64 = 25

/// The `Type` an `AliasPlaceholder` stands for in `Mod.types` until `expand` follows it.
Type t8AliasType(AliasId alias) => (t8AliasKind << 32) | alias

bool t8IsAlias(Type t) => (t >> 32) == t8AliasKind

// ── Syntax helpers ───────────────────────────────────────────────────────────

string t8Text(in Ctx c, from FileId f, at TextSpan span) => $"{getText(c.files[f].text.span, at: span)}"

/// The span of a type syntax node (the C# `TypeSyntax.Span`; the parser's `typeSpan` is private).
TextSpan t8TypeSpan(in parser.TypeSyntax t) {
    switch t {
        case .namedType(let n): return n.value.span
        case .optionalType(let n): return n.value.span
        case .arrayType(let n): return n.value.span
        case .tupleType(let n): return n.value.span
        case .functionTypeSyntax(let n): return n.value.span
        case .dynType(let n): return n.value.span
        case .refinedType(let n): return n.value.span
        case .pointerType(let n): return n.value.span
        case .none: return TextSpan { start: 0, length: 0 }
    }
}

/// Swaps `put` into `c.files[f].unit.members[i]` and returns what was there, so a declaration can be
/// read while `c` is passed by `ref` (BYN3005); a nested alias of the same file still finds its own.
parser.Decl t8TakeDecl(ref Ctx c, from FileId f, at i64 i, by move parser.Decl put) {
    var members = c.files[f].unit.members.take()
    var tail = List<parser.Decl>()
    while members.length > i + 1 {
        tail.append(members.removeLast())
    }
    let old = members.removeLast()
    members.append(move put)
    while tail.length > 0 {
        members.append(tail.removeLast())
    }
    c.files[f].unit.members = move members
    return old
}

/// The sets of an error set or an error union.
List<ErrorSetId> t8SetsOf(ref Ctx c, for Type t) {
    return copyIds(in c.errorUnionTypes[typeIndex(t)].sets) if kindOf(t) == .errorUnion
    var sets = List<ErrorSetId>()
    sets.append(typeIndex(t))
    return sets
}

/// A `Binder` for `BindArraySize`, in the resolver's file and struct (the C# `new Binder(…)`).
Binder t8Binder(in TypeResolver r) => Binder {
    file: r.file,
    owner: r.container,
    scopes: [],
    targets: [],
    lambdas: [],
    lambdaCount: [],
    seeds: [],
    pending: [],
    constraints: [],
    peers: [],
    nonNullLocals: [],
    stateFacts: [],
    errorNarrowed: [],
}

/// The C# `Compilation.MembersDeclared`.
bool t8MembersDeclared(in Ctx c) => c.membersDeclared

/// The C# `Builtins.IoError`/`Utf8Error`/`ParseError`: the set of that name from a `<builtin>` file (Q557).
Type t8BuiltinSet(in Ctx c, for string name) {
    for i in 0..c.errorSets.length {
        return errorSetTypeOf(i) if c.errorSets[i].name == name && t8IsBuiltinFile(in c, for: c.errorSets[i].file)
    }
    return errorType()
}

/// The C# `Builtins.Rule`: the union of that name from a `<builtin>` file (Q557).
Type t8BuiltinUnion(in Ctx c, for string name) {
    for i in 0..c.unions.length {
        return unionTypeOf(i) if c.unions[i].name == name && t8IsBuiltinFile(in c, for: c.unions[i].file)
    }
    return errorType()
}

bool t8IsBuiltinFile(in Ctx c, for FileId f) => f < 0 || c.files[f].path == "<builtin>"

// ── TypeResolver ─────────────────────────────────────────────────────────────

Type resolve(ref Ctx c, through in TypeResolver r, for in parser.TypeSyntax syntax, bool allowVoid = false) {
    let t = resolveCore(ref c, through: in r, for: in syntax)
    if isVoid(t) && !allowVoid {
        report(ref c, for: .voidValue, from: r.file, at: t8TypeSpan(in syntax), by: ("", "", "", "", ""))
        return errorType()
    }
    if kindOf(t) == .interfaceType {
        let name = interfaceDisplayName(ref c, by: typeIndex(t))
        report(
            ref c,
            for: .interfaceAsType,
            from: r.file,
            at: t8TypeSpan(in syntax),
            by: (name, "", "", "", ""),
            label: "an interface",
            help: $"write `dyn ref {name}` or add a `where` constraint",
        )
        return errorType()
    }
    return t
}

/// A base or a `where` bound, where an interface is allowed.
Type resolveBound(ref Ctx c, through in TypeResolver r, for in parser.NamedType syntax) =>
    resolveNamed(ref c, through: in r, for: in syntax)

Type resolveCore(ref Ctx c, through in TypeResolver r, for in parser.TypeSyntax syntax) {
    switch syntax {
        case .optionalType(let o):
            let inner = resolve(ref c, through: in r, for: in o.value.inner)
            return errorType() if functionTypeNotHere(
                ref c,
                for: inner,
                from: r.file,
                at: t8TypeSpan(in o.value.inner),
                as: "the value of an optional",
            )
            if kindOf(inner) == .optional {
                let shown = typeDisplay(ref c, by: inner)
                report(ref c, for: .nestedOptional, from: r.file, at: o.value.span, by: (shown, "", "", "", ""))
                return inner
            }
            return isError(inner) ? inner : internOptional(ref c, by: inner)
        case .arrayType(let a):
            let element = resolve(ref c, through: in r, for: in a.value.element)
            return errorType() if functionTypeNotHere(
                ref c,
                for: element,
                from: r.file,
                at: t8TypeSpan(in a.value.element),
                as: "an array element",
            )
            var b = t8Binder(in r)
            let size = bindArraySize(ref b, through: ref c, for: in a.value.size)
            return isError(element) || size < 0 ? errorType() : internArray(ref c, by: element, at: size)
        case .tupleType(let t):
            var fields = List<TupleField>()
            for e in t.value.elements {
                var name: string? = null
                if (e.name is { } n) {
                    name = t8Text(in c, from: r.file, at: n)
                }
                let type = resolve(ref c, through: in r, for: in e.type)
                fields.append(TupleField { name: name, type: type })
            }
            var placed = 0
            var failed = false
            for i in 0..fields.length {
                if functionTypeNotHere(
                    ref c,
                    for: fields[i].type,
                    from: r.file,
                    at: t8TypeSpan(in t.value.elements[i].type),
                    as: "a tuple element"
                ) {
                    placed += 1
                }
                if isError(fields[i].type) {
                    failed = true
                }
            }
            return placed > 0 || failed ? errorType() : internTuple(ref c, for: in fields)
        case .functionTypeSyntax(let f):
            var parameters = List<Type>()
            for p in f.value.params {
                parameters.append(resolve(ref c, through: in r, for: in p))
            }
            let result = resolve(ref c, through: in r, for: in f.value.returnKeyword, allowVoid: true)
            var failed = false
            var failSets = List<ErrorSetId>()
            if (f.value.failsKeyword is { } clause) {
                for e in clause.errors {
                    let t = resolve(ref c, through: in r, for: in e)
                    if kindOf(t) == .errorSet || kindOf(t) == .errorUnion {
                        let sets = t8SetsOf(ref c, for: t)
                        for set in sets {
                            if !listContains(in failSets, by: set) {
                                failSets.append(set)
                            }
                        }
                    } else {
                        if !isError(t) {
                            let shown = typeDisplay(ref c, by: t)
                            report(
                                ref c,
                                for: .notAnErrorSet,
                                from: r.file,
                                at: t8TypeSpan(in e),
                                by: (shown, "", "", "", ""),
                            )
                        }
                        failed = true
                    }
                }
            }
            var effects = List<string>()
            if (f.value.usesKeyword is { } usesClause) {
                effects = effectsOf(ref c, through: in r, for: in usesClause)
            }
            var badParameter = false
            for p in parameters {
                if isError(p) {
                    badParameter = true
                }
            }
            return failed
                || isError(result)
                || badParameter ? errorType() : internFunction(
                    ref c,
                    for: in parameters,
                    to: result,
                    by: in failSets,
                    as: in effects,
                )
        case .namedType(let n):
            return resolveNamed(ref c, through: in r, for: in n.value)
        case .dynType(let d):
            return resolveDyn(ref c, through: in r, for: in d.value)
        case .refinedType(let rt):
            let inner = resolve(ref c, through: in r, for: in rt.value.inner)
            return resolveStates(ref c, through: in r, for: inner, by: in rt.value.states)
        default:
            return errorType()
    }
}

Type resolveNamed(ref Ctx c, through in TypeResolver r, for in parser.NamedType n) {
    let name = n.path[n.path.length - 1]
    let module = c.files[r.file].module
    if n.path.length == 1 {
        let text = t8Text(in c, from: r.file, at: name)
        let parameter = r.typeArgs.tryGet(at: text)
        if parameter is not null {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return parameter
        }
        let primitive = primitiveByName(text)
        if primitive is not null {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return primitive
        }
        if text is "Span" or "ReadOnlySpan" or "List" or "Owned" or "Untrusted" {
            if n.args.length != 1 {
                report(
                    ref c,
                    for: .wrongTypeArgumentCount,
                    from: r.file,
                    at: n.span,
                    by: (text, "1", string(n.args.length), "", ""),
                )
                return errorType()
            }
            let element = resolve(ref c, through: in r, for: in n.args[0])
            return element if isError(element)
            var position = "a type argument"
            if text == "List" {
                position = "a list element"
            }
            if text is "Span" or "ReadOnlySpan" {
                position = "a span element"
            }
            return errorType() if functionTypeNotHere(
                ref c,
                for: element,
                from: r.file,
                at: t8TypeSpan(in n.args[0]),
                as: position,
            )
            return internSpan(ref c, by: element, readOnly: false) if text == "Span"
            return internSpan(ref c, by: element, readOnly: true) if text == "ReadOnlySpan"
            return internOwned(ref c, by: element) if text == "Owned"
            return internUntrusted(ref c, by: element) if text == "Untrusted"
            return internList(ref c, by: element)
        }
        if text == "Result" {
            if n.args.length != 2 {
                report(
                    ref c,
                    for: .wrongTypeArgumentCount,
                    from: r.file,
                    at: n.span,
                    by: (text, "2", string(n.args.length), "", ""),
                )
                return errorType()
            }
            let value = resolve(ref c, through: in r, for: in n.args[0])
            let error = resolve(ref c, through: in r, for: in n.args[1])
            return errorType() if isError(value) || isError(error)
            return errorType() if functionTypeNotHere(
                ref c,
                for: value,
                from: r.file,
                at: t8TypeSpan(in n.args[0]),
                as: "a type argument",
            )
            if kindOf(error) != .errorSet {
                let shown = typeDisplay(ref c, by: error)
                report(
                    ref c,
                    for: .notAnErrorSet,
                    from: r.file,
                    at: t8TypeSpan(in n.args[1]),
                    by: (shown, "", "", "", ""),
                )
                return errorType()
            }
            if value == prim(.void) || value == prim(.neverKind) {
                let shown = typeDisplay(ref c, by: value)
                report(
                    ref c,
                    for: .unsupported,
                    from: r.file,
                    at: t8TypeSpan(in n.args[0]),
                    by: ($"`Result<{shown}, …>`", "", "", "", ""),
                )
                return errorType()
            }
            return internResult(ref c, by: value, to: error)
        }
        // One map serves both (Q371): `HashMap` is reported once and then resolves as `Map`, so nothing cascades.
        if text == "HashMap" {
            let rest = t8Text(
                in c,
                from: r.file,
                at: TextSpan { start: n.span.start + name.length, length: n.span.length - name.length },
            )
            let written = $"Map{rest}"
            report(
                ref c,
                for: .hashMapNotSupported,
                from: r.file,
                at: name,
                by: ("", "", "", "", ""),
                help: $"write `{written}`",
                hasFix: true,
                fixSpan: n.span,
                fixReplacement: written,
            )
            return resolveMap(ref c, through: in r, for: in n)
        }
        return resolveMap(ref c, through: in r, for: in n) if text == "Map"
        if text is "Arena" or "StrBuf" or "ProcessResult" or "Panic" or "FormatSpec" or "Symbol" {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return builtinType(.arena) if text == "Arena"
            return builtinType(.strBuf) if text == "StrBuf"
            return builtinType(.processResult) if text == "ProcessResult"
            return builtinType(.panic) if text == "Panic"
            return builtinType(.formatSpec) if text == "FormatSpec"
            return builtinType(.symbol)
        }
        if text is "dec" or "decimal" {
            report(ref c, for: .unsupported, from: r.file, at: n.span, by: ("the `dec` type", "", "", "", ""))
            return errorType()
        }
        let found = lookup(in c, for: module, by: text)
        if found is not null {
            let t = expand(ref c, through: in r, for: found)
            return construct(ref c, through: in r, for: in n, by: t, at: name)
        }
        if text is "IoError" or "Utf8Error" or "ParseError" {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return t8BuiltinSet(in c, for: text)
        }
        if text == "Time" {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return builtinType(.time)
        }
        if text == "Millis" {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return builtinType(.millis)
        }
        // `ValidationError<T>`: a set per `T`, whose `invalid` carries the violations of a struct with `requires` (J23).
        // Without `T` there is no `T.Field`, so the bare name is BYN2023 (revision 0011).
        if text == "ValidationError" {
            if n.args.length != 1 {
                report(
                    ref c,
                    for: .wrongTypeArgumentCount,
                    from: r.file,
                    at: n.span,
                    by: (text, "1", string(n.args.length), "", ""),
                )
                return errorType()
            }
            let arg = resolve(ref c, through: in r, for: in n.args[0])
            return isError(arg) ? errorType() : errorSetTypeOf(validationErrorOf(ref c, for: arg))
        }
        if text == "Rule" {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return t8BuiltinUnion(in c, for: "Rule")
        }
        // `Violation<T>` only for a struct with `requires`; any other `T` falls through to BYN2002.
        if text == "Violation" && n.args.length == 1 {
            let of = resolve(ref c, through: in r, for: in n.args[0])
            if kindOf(of) == .structType && c.structs[typeIndex(of)].fieldEnum >= 0 {
                let validation = validationErrorOf(ref c, for: of)
                let invalid = c.errorVariants[c.errorSets[validation].variants[0]].fields[0]
                return c.listTypes[typeIndex(c.locals[invalid].type)]
            }
        }
        let builtin = findInterface(ref c, for: text)
        if builtin >= 0 {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return interfaceTypeOf(builtin)
        }
        let suggestion = suggestType(ref c, through: in r, for: text)
        var help = ""
        if suggestion is not null {
            help = $"did you mean `{suggestion}`?"
        }
        report(ref c, for: .unknownType, from: r.file, at: name, by: (text, "", "", "", ""), help: help)
        return errorType()
    }
    let head = t8Text(in c, from: r.file, at: n.path[0])
    let last = t8Text(in c, from: r.file, at: name)
    if n.path.length == 2 {
        let owner = r.typeArgs.tryGet(at: head)
        if owner is not null {
            noTypeArgs(ref c, through: in r, for: in n, at: name)
            return resolveAssociated(ref c, through: in r, for: in n, by: owner)
        }
    }
    let headType = lookup(in c, for: module, by: head) ?? errorType()
    let headStruct = kindOf(headType) == .structType
    if n.path.length == 2 && last == "Field" && headStruct && c.structs[typeIndex(headType)].fieldEnum >= 0 {
        noTypeArgs(ref c, through: in r, for: in n, at: name)
        return enumTypeOf(c.structs[typeIndex(headType)].fieldEnum)
    }
    // `Order.paid`: a camelCase last segment names a state of the struct; derived shapes are PascalCase (J56).
    // ASCII only (Q558): C# `char.IsLower` is Unicode.
    let first = last.length > 0 ? last.bytes[0] : 0
    if n.path.length == 2 && first >= 0x61 && first <= 0x7A && headStruct {
        // The C# `ResolveNamed(n with { Path = [n.Path[0]] })`: the head names a struct, so that is `Construct` on it.
        let t = expand(ref c, through: in r, for: headType)
        let owner = construct(ref c, through: in r, for: in n, by: t, at: n.path[0])
        var names = List<TextSpan>()
        names.append(name)
        return resolveStates(ref c, through: in r, for: owner, by: in names)
    }
    if n.path.length == 2 {
        let imported = c.files[r.file].imports.tryGet(at: head)
        if imported is not null {
            let found = lookup(in c, for: imported, by: last)
            if found is not null {
                checkVisible(ref c, through: in r, for: found, at: name)
                let expanded = expand(ref c, through: in r, for: found)
                return construct(ref c, through: in r, for: in n, by: expanded, at: name)
            }
            let joined = t8JoinPath(in c, from: r.file, for: in n.path)
            report(ref c, for: .unknownType, from: r.file, at: name, by: (joined, "", "", "", ""))
            return errorType()
        }
    }
    let joined = t8JoinPath(in c, from: r.file, for: in n.path)
    var help = ""
    if n.path.length == 2 {
        help = $"add `import {head}`; `{head}` is not an imported module"
    }
    report(ref c, for: .unknownType, from: r.file, at: n.span, by: (joined, "", "", "", ""), help: help)
    return errorType()
}

/// The `Map`/`HashMap` arm of `ResolveNamed` (C# reaches it by `goto case "Map"`).
Type resolveMap(ref Ctx c, through in TypeResolver r, for in parser.NamedType n) {
    if n.args.length != 2 {
        report(
            ref c,
            for: .wrongTypeArgumentCount,
            from: r.file,
            at: n.span,
            by: ("Map", "2", string(n.args.length), "", ""),
        )
        return errorType()
    }
    let key = resolve(ref c, through: in r, for: in n.args[0])
    let value = resolve(ref c, through: in r, for: in n.args[1])
    return errorType() if isError(key) || isError(value)
    let badKey = functionTypeNotHere(ref c, for: key, from: r.file, at: t8TypeSpan(in n.args[0]), as: "a map key")
    let badValue = functionTypeNotHere(ref c, for: value, from: r.file, at: t8TypeSpan(in n.args[1]), as: "a map value")
    return errorType() if badKey || badValue
    return internMap(ref c, by: key, to: value) if kindOf(key) == .typeParam
    let span = t8TypeSpan(in n.args[0])
    // The fields of a struct key, or of one inside a tuple key, may not be declared yet; the check waits until they are.
    if !t8MembersDeclared(in c) && (kindOf(key) == .structType || kindOf(key) == .tuple) {
        afterMembersDeclared(
            ref c,
            for: in Work { kind: .keyCheck, subject: key, args: List<Type>(), file: r.file, span: span },
        )
    } else if !t8CheckKey(ref c, for: key, from: r.file, at: span) {
        return errorType()
    }
    return internMap(ref c, by: key, to: value)
}

/// The C# `CheckKey` closure of `ResolveNamed` (Q556): BYN2814/BYN2209-style key diagnostics; false when `key` is not a key.
bool t8CheckKey(ref Ctx c, for Type key, from FileId f, at TextSpan span) {
    return true if isValidKey(ref c, by: key)
    let shown = typeDisplay(ref c, by: key)
    let part = invalidKeyPart(ref c, by: key)
    if part is not null {
        let partShown = typeDisplay(ref c, by: part.type)
        let what = kindOf(key) == .tuple ? "element" : "field"
        report(
            ref c,
            for: .keyPartNotHashable,
            from: f,
            at: span,
            by: (shown, what, part.part, partShown, ""),
            help: "use a field that identifies the value as the key, such as an id or a `Symbol`",
        )
    } else {
        report(
            ref c,
            for: .invalidMapKey,
            from: f,
            at: span,
            by: (shown, "", "", "", ""),
            help: "use an integer type, `rune`, `bool`, `string`, `Symbol`, a plain enum, or a tuple or struct of those as the key",
        )
    }
    return false
}

string t8JoinPath(in Ctx c, from FileId f, for in List<TextSpan> path) {
    var sb = StrBuf()
    for i in 0..path.length {
        if i > 0 {
            sb.append(".")
        }
        sb.append(t8Text(in c, from: f, at: path[i]))
    }
    return $"{sb.finish()}"
}

/// The state type `T.s` or `T is .a or .b` of `owner`; a state it does not declare is BYN7007.
Type resolveStates(ref Ctx c, through in TypeResolver r, for Type owner, by in List<TextSpan> names) {
    return owner if isError(owner)
    var states: UnionId = -1
    if kindOf(owner) == .structType {
        states = statesOf(ref c, for: typeIndex(owner))
    }
    var found = List<VariantId>()
    for n in names {
        let text = t8Text(in c, from: r.file, at: n)
        var state: VariantId = -1
        if states >= 0 {
            state = findUnionVariant(ref c, by: states, for: text)
        }
        if state < 0 {
            let shown = typeDisplay(ref c, by: owner)
            report(
                ref c,
                for: .unknownState,
                from: r.file,
                at: n,
                by: (shown, text, "", "", ""),
                help: $"check the states declared in `{shown}`",
            )
            return errorType()
        }
        found.append(state)
    }
    return internState(ref c, by: typeIndex(owner), for: in found)
}

/// `dyn ref I` and `dyn ref readonly I`; `dyn I` and interfaces that are not dyn-safe are diagnostics.
Type resolveDyn(ref Ctx c, through in TypeResolver r, for in parser.DynType d) {
    var inner = errorType()
    switch d.inner {
        case .namedType(let n): inner = resolveNamed(ref c, through: in r, for: in n.value)
        default: inner = errorType()
    }
    return inner if isError(inner)
    if kindOf(inner) != .interfaceType {
        let shown = typeDisplay(ref c, by: inner)
        report(
            ref c,
            for: .notAnInterface,
            from: r.file,
            at: t8TypeSpan(in d.inner),
            by: (shown, "", "", "", ""),
            label: "after `dyn`",
            help: "name an `interface` after `dyn ref`",
        )
        return errorType()
    }
    let i = typeIndex(inner)
    let shown = interfaceDisplayName(ref c, by: i)
    if !d.isRef {
        report(
            ref c,
            for: .dynByValue,
            from: r.file,
            at: d.span,
            by: (shown, "", "", "", ""),
            label: "an owned dynamic value",
            help: $"write `dyn ref {shown}`",
        )
        return errorType()
    }
    // Checked on the declaration, so it holds before the interface's members are declared.
    var member = ""
    var reason = ""
    let f = c.interfaces[i].file
    let declIndex = c.interfaces[i].declIndex
    if f >= 0 && declIndex >= 0 {
        switch c.files[f].unit.members[declIndex] {
            case .interfaceDecl(let decl):
                for m in decl.value.members {
                    break if member != ""
                    switch m {
                        case .functionDecl(let fd):
                            if fd.value.typeParams.length > 0 {
                                member = t8Text(in c, from: f, at: fd.value.name)
                                reason = "is generic"
                            }
                        case .associatedTypeDecl(let a):
                            member = t8Text(in c, from: f, at: a.value.name)
                            reason = "is an associated type"
                        default:
                            continue
                    }
                }
            default:
                reason = ""
        }
    }
    if member != "" {
        report(
            ref c,
            for: .notDynSafe,
            from: r.file,
            at: d.span,
            by: (shown, member, reason, "", ""),
            label: "used with `dyn` here",
            help: "use a `where` constraint instead",
        )
        return errorType()
    }
    return internDynRef(ref c, by: i, readOnly: d.isReadOnly)
}

/// Whether interface `i`'s declaration has `type <name>` (the C# `c.Decl.Members.Any(m => m is AssociatedTypeDecl …)`).
bool t8DeclaresType(in Ctx c, for InterfaceId i, by string name) {
    let f = c.interfaces[i].file
    let declIndex = c.interfaces[i].declIndex
    return false if f < 0 || declIndex < 0
    switch c.files[f].unit.members[declIndex] {
        case .interfaceDecl(let decl):
            for m in decl.value.members {
                switch m {
                    case .associatedTypeDecl(let a):
                        return true if t8Text(in c, from: f, at: a.value.name) == name
                    default:
                        continue
                }
            }
            return false
        default:
            return false
    }
}

/// `T.Item`: an associated type of `T`'s constraints in a template, the conformer's binding in an
/// instance (the C# `AssociatedType`; renamed because T11 owns `associatedType`).
Type resolveAssociated(ref Ctx c, through in TypeResolver r, for in parser.NamedType n, by Type owner) {
    let name = t8Text(in c, from: r.file, at: n.path[1])
    if kindOf(owner) == .typeParam {
        let p = typeIndex(owner)
        var declared = false
        for i in c.typeParams[p].constraints {
            if t8DeclaresType(in c, for: i, by: name) {
                declared = true
            }
        }
        return typeParamTypeOf(associatedType(ref c, for: p, by: name)) if declared
    }
    if kindOf(owner) == .structType {
        let bound = associatedBinding(ref c, for: typeIndex(owner), by: name)
        return bound if bound != -1
    }
    let shown = typeDisplay(ref c, by: owner)
    var help = ""
    if kindOf(owner) == .typeParam {
        help = $"add a `where {shown} : …` bound on an interface declaring `type {name}`"
    }
    report(ref c, for: .unknownType, from: r.file, at: n.span, by: ($"{shown}.{name}", "", "", "", ""), help: help)
    return errorType()
}

Type? lookup(in Ctx c, for ModId module, by string name) => c.modules[module].types.tryGet(at: name)

void checkVisible(ref Ctx c, through in TypeResolver r, for Type t, at TextSpan name) {
    var access: Accessibility = .publicKeyword
    if t8IsAlias(t) {
        access = accessOf(u16(c.aliases[typeIndex(t)].modifiers))
    } else {
        switch kindOf(t) {
            case .structType: access = c.structs[typeIndex(t)].access
            case .errorSet: access = c.errorSets[typeIndex(t)].access
            case .enumType: access = c.enums[typeIndex(t)].access
            case .unionType: access = c.unions[typeIndex(t)].access
            case .interfaceType: access = c.interfaces[typeIndex(t)].access
            default: access = .publicKeyword
        }
    }
    if access != .publicKeyword {
        let text = t8Text(in c, from: r.file, at: name)
        report(
            ref c,
            for: .notVisible,
            from: r.file,
            at: name,
            by: (text, "", "", "", ""),
            label: "not `public`",
            help: $"mark `{text}` `public` to use it from another module",
        )
    }
}

/// The type an alias or `union error` composition names, resolved once.
Type expandAlias(ref Ctx c, through in TypeResolver r, for AliasId alias) =>
    expand(ref c, through: in r, for: t8AliasType(alias))

/// Follows aliases to their targets.
Type expand(ref Ctx c, through in TypeResolver r, for Type t) {
    return t if !t8IsAlias(t)
    let a = typeIndex(t)
    return c.aliases[a].target if c.aliases[a].target != -1
    if c.aliases[a].resolving {
        let name = c.aliases[a].name
        report(
            ref c,
            for: .circularAlias,
            from: c.aliases[a].file,
            at: c.aliases[a].nameSpan,
            by: (name, "", "", "", ""),
        )
        c.aliases[a].target = errorType()
        return errorType()
    }
    c.aliases[a].resolving = true
    let file = c.aliases[a].file
    let declIndex = c.aliases[a].declIndex
    let resolver = TypeResolver { file: file }
    let decl = t8TakeDecl(ref c, from: file, at: declIndex, by: .none)
    var target = errorType()
    switch decl {
        case .errorSetDecl(let s): target = errorSet(ref c, through: in resolver, for: in s.value)
        case .typeAliasDecl(let ta): target = resolve(ref c, through: in resolver, for: in ta.value.target)
        default: target = errorType()
    }
    let placeholder = t8TakeDecl(ref c, from: file, at: declIndex, by: move decl)
    c.aliases[a].resolving = false
    if c.aliases[a].target == -1 {
        c.aliases[a].target = target
    }
    return c.aliases[a].target
}

/// The sets named by `union error S = A, B except .c`, one set or an error union less its excluded cases.
Type errorSet(ref Ctx c, through in TypeResolver r, for in parser.ErrorSetDecl decl) {
    var sets = List<ErrorSetId>()
    var excluded = List<VariantId>()
    for member in decl.members {
        let t = resolve(ref c, through: in r, for: in member)
        if kindOf(t) == .errorSet || kindOf(t) == .errorUnion {
            // A case stays excluded only while every member that brings in its set excludes it.
            var dropped = List<VariantId>()
            if kindOf(t) == .errorUnion {
                dropped = copyIds(in c.errorUnionTypes[typeIndex(t)].excluded)
            }
            let memberSets = t8SetsOf(ref c, for: t)
            for set in memberSets {
                if listContains(in sets, by: set) {
                    var kept = List<VariantId>()
                    for v in excluded {
                        if c.errorVariants[v].set != set || listContains(in dropped, by: v) {
                            kept.append(v)
                        }
                    }
                    excluded = move kept
                    continue
                }
                sets.append(set)
                for v in dropped {
                    if c.errorVariants[v].set == set {
                        excluded.append(v)
                    }
                }
            }
        } else if !isError(t) {
            let shown = typeDisplay(ref c, by: t)
            report(ref c, for: .notAnErrorSet, from: r.file, at: t8TypeSpan(in member), by: (shown, "", "", "", ""))
        }
    }
    return errorType() if sets.length == 0
    for name in decl.exceptNames {
        let text = t8Text(in c, from: r.file, at: name)
        var matched = false
        for set in sets {
            let v = findErrorVariant(ref c, by: set, for: text)
            if v >= 0 {
                matched = true
                if !listContains(in excluded, by: v) {
                    excluded.append(v)
                }
            }
        }
        if !matched {
            let joined = errorUnionOf(ref c, for: in sets, as: in List<VariantId>())
            let shown = typeDisplay(ref c, by: joined)
            report(ref c, for: .unknownVariant, from: r.file, at: name, by: (text, shown, "", "", ""))
        }
    }
    var empty = true
    for set in sets {
        for v in c.errorSets[set].variants {
            if !listContains(in excluded, by: v) {
                empty = false
            }
        }
    }
    if empty {
        let text = t8Text(in c, from: r.file, at: decl.name)
        report(ref c, for: .emptyErrorSet, from: r.file, at: decl.name, by: (text, "", "", "", ""))
    }
    return errorUnionOf(ref c, for: in sets, as: in excluded)
}

/// One `effect` alias of the module: its name and the names it lists.
struct T8EffectAlias {
    string       name
    List<string> effects
}

bool t8IsEffectPrimitive(string name) {
    return name is "alloc" or "suspend" or "net" or "fs" or "clock" or "random" or "env" or "process" or "console"
}

/// The C# local `Add` of `Effects` for a name inside an alias (never reported); `seen` stops alias cycles.
void t8AddEffect(
    in List<T8EffectAlias> aliases,
    for string name,
    to ref List<string> result,
    by ref List<string> seen
) {
    if t8IsEffectPrimitive(name) {
        result.append(name)
        return
    }
    for a in aliases {
        if a.name == name {
            return if listContainsString(in seen, by: name)
            seen.append(name)
            for e in a.effects {
                t8AddEffect(in aliases, for: e, to: ref result, by: ref seen)
            }
            return
        }
    }
}

/// The effects a function type's `uses` names, the module's `effect` aliases expanded; BYN6003 for an
/// unknown name (one inside an alias is reported by the effect analysis).
List<string> effectsOf(ref Ctx c, through in TypeResolver r, for in parser.UsesClause clause) {
    var aliases = List<T8EffectAlias>()
    let module = c.files[r.file].module
    for f in c.modules[module].files {
        for m in c.files[f].unit.members {
            switch m {
                case .effectDecl(let e):
                    var names = List<string>()
                    for x in e.value.effects {
                        names.append(t8Text(in c, from: f, at: x))
                    }
                    aliases.append(T8EffectAlias { name: t8Text(in c, from: f, at: e.value.name), effects: move names })
                default:
                    continue
            }
        }
    }
    var result = List<string>()
    var seen = List<string>()
    for name in clause.effects {
        let text = t8Text(in c, from: r.file, at: name)
        var known = t8IsEffectPrimitive(text)
        for a in aliases {
            if a.name == text {
                known = true
            }
        }
        if known {
            t8AddEffect(in aliases, for: text, to: ref result, by: ref seen)
        } else {
            reportUnknown(ref c, from: r.file, at: name)
        }
    }
    var distinct = List<string>()
    for e in result {
        if !listContainsString(in distinct, by: e) {
            distinct.append(e)
        }
    }
    return distinct
}

/// Applies the type arguments of `n` to a generic struct, union or interface (instantiating it), or checks
/// there are none; `last` is the segment the diagnostics name (Q559).
Type construct(ref Ctx c, through in TypeResolver r, for in parser.NamedType n, by Type t, at TextSpan last) {
    var parameters = List<TypeParamId>()
    if kindOf(t) == .structType {
        parameters = copyIds(in c.structs[typeIndex(t)].typeParams)
    }
    if kindOf(t) == .unionType {
        parameters = copyIds(in c.unions[typeIndex(t)].typeParams)
    }
    if kindOf(t) == .interfaceType {
        parameters = copyIds(in c.interfaces[typeIndex(t)].typeParams)
    }
    if parameters.length == 0 {
        noTypeArgs(ref c, through: in r, for: in n, at: last)
        return t
    }
    if n.args.length != parameters.length {
        let text = t8Text(in c, from: r.file, at: last)
        report(
            ref c,
            for: .wrongTypeArgumentCount,
            from: r.file,
            at: n.span,
            by: (text, string(parameters.length), string(n.args.length), "", ""),
        )
        return errorType()
    }
    var args = List<Type>()
    for a in n.args {
        args.append(resolve(ref c, through: in r, for: in a))
    }
    for a in args {
        return errorType() if isError(a)
    }
    var notHere = 0
    for i in 0..args.length {
        if functionTypeNotHere(ref c, for: args[i], from: r.file, at: t8TypeSpan(in n.args[i]), as: "a type argument") {
            notHere += 1
        }
    }
    return errorType() if notHere > 0
    var same = true
    for i in 0..args.length {
        if args[i] != typeParamTypeOf(parameters[i]) {
            same = false
        }
    }
    return t if same
    return instantiateType(ref c, for: t, by: in args, from: r.file, at: n.span)
}

void noTypeArgs(ref Ctx c, through in TypeResolver r, for in parser.NamedType n, at TextSpan last) {
    if n.args.length > 0 {
        let text = t8Text(in c, from: r.file, at: last)
        report(
            ref c,
            for: .wrongTypeArgumentCount,
            from: r.file,
            at: n.span,
            by: (text, "0", string(n.args.length), "", ""),
        )
    }
}

/// ASCII lowercase (Q558): the C# `ToLowerInvariant` is Unicode.
string t8Lower(string s) {
    var bytes = List<u8>()
    for b in s.bytes {
        bytes.append(b >= 0x41 && b <= 0x5A ? b + 0x20 : b)
    }
    return $"{utf8(bytes.span)}"
}

/// A type name differing from `text` only in (ASCII) case, or a common misspelling (`boolean`, `str`).
string? suggestType(ref Ctx c, through in TypeResolver r, for string text) {
    let lower = t8Lower(text)
    let module = c.files[r.file].module
    for e in c.modules[module].types {
        return $"{e.key}" if t8Lower(e.key) == lower
    }
    let builtins = [
        "Span",
        "ReadOnlySpan",
        "List",
        "Map",
        "HashMap",
        "Owned",
        "Untrusted",
        "Result",
        "Arena",
        "StrBuf",
        "IoError",
        "Utf8Error",
        "ParseError",
        "ValidationError",
        "Violation",
        "Rule",
        "ProcessResult",
        "Panic",
        "FormatSpec",
        "Symbol",
        "Time",
        "Millis",
    ]
    for name in builtins {
        return name if t8Lower(name) == lower
    }
    return lower if primitiveByName(lower) is not null
    return "bool" if lower == "boolean"
    return "string" if lower == "str"
    return null
}
== semantics/types.byn
// T3: Symbols/Types.cs plus interning; `range` returns ctx.byn's `Big`.
//
// A `Type` is `(TypeKind << 32) | index` (ctx.byn). Primitives, `ErrorType`, `NullType`, the four
// `TextViewType`s and the `BuiltinType`s need no arena: their index is the C# enum ordinal. Named
// types (struct, interface, enum, union, error set, type parameter) have reference identity: their
// index is their symbol arena index. Constructed types (optional, span, dynRef, list, map, owned,
// untrusted, array, range, tuple, function, result, state, errorUnion) compare structurally in C#:
// each has an arena of its parts plus a `Map` cache keyed by those parts, so `intern…` returns the
// existing handle when the parts match and C# `Equals` becomes `==` on handles.
//
// Constructed-type arenas and their data structs live on `Ctx` (ctx.byn): `optionalTypes`/`listTypes`/
// `ownedTypes`/`untrustedTypes`/`rangeTypes: List<Type>`, `spanTypes: List<SpanData>`,
// `dynRefTypes: List<DynRefData>`, `mapTypes: List<MapData>`, `arrayTypes: List<ArrayData>`,
// `tupleTypes: List<List<TupleField>>`, `functionTypes: List<FunctionData>`, `resultTypes: List<ResultData>`,
// `stateTypes: List<StateData>`, `errorUnionTypes: List<ErrorUnionData>`, plus one `Map<string, i64>`
// intern cache per kind. Keys are unambiguous strings over the parts (length-prefixed for strings).
//
// Every function takes `ref Ctx c` as its unlabeled object; later parameters carry a particle
// (`by` an operand, `to`/`at`/`for`/`as` the others).

// ── Kinds ────────────────────────────────────────────────────────────────────

/// The kind word of a `Type`; the ordinals are fixed.
public enum TypeKind {
    primitive
    error
    nullType
    typeParam
    optional
    span
    textView
    dynRef
    list
    map
    owned
    untrusted
    array
    range
    tuple
    function
    result
    state
    builtin
    errorUnion
    structType
    interfaceType
    enumType
    unionType
    errorSet
    /// The C# `AliasPlaceholder` (Compilation.cs:1986): a `type` alias or `union error` composition in a module's `types`
    /// before it is expanded; neither a struct nor an error set (`typeresolve.byn` `t8AliasKind`).
    alias
}

/// The C# `PrimitiveKind`; `never` is a keyword, so `Never` is `neverKind`.
public enum PrimitiveKind {
    i8
    i16
    i32
    i64
    u8
    u16
    u32
    u64
    isize
    usize
    f32
    f64
    bool
    char
    string
    void
    neverKind
}

/// The C# `TextViewKind`.
public enum TextViewKind {
    runes
    utf16
    lines
    parts
}

/// The C# `BuiltinKind`.
public enum BuiltinKind {
    arena
    strBuf
    io
    hex
    utf8
    ioStream
    ioInput
    processResult
    panic
    formatSpec
    symbol
    path
    target
    env
    fs
    time
    millis
}

// ── Handles ──────────────────────────────────────────────────────────────────

public Type makeType(TypeKind kind, at i64 index) => (i64(kind.ordinal) << 32) | index

public TypeKind kindOf(Type t) {
    switch t >> 32 {
        case 0: return .primitive
        case 1: return .error
        case 2: return .nullType
        case 3: return .typeParam
        case 4: return .optional
        case 5: return .span
        case 6: return .textView
        case 7: return .dynRef
        case 8: return .list
        case 9: return .map
        case 10: return .owned
        case 11: return .untrusted
        case 12: return .array
        case 13: return .range
        case 14: return .tuple
        case 15: return .function
        case 16: return .result
        case 17: return .state
        case 18: return .builtin
        case 19: return .errorUnion
        case 20: return .structType
        case 21: return .interfaceType
        case 22: return .enumType
        case 23: return .unionType
        case 24: return .errorSet
        default: return .alias
    }
}

public PrimitiveKind primKindOf(i64 i) {
    switch i {
        case 0: return .i8
        case 1: return .i16
        case 2: return .i32
        case 3: return .i64
        case 4: return .u8
        case 5: return .u16
        case 6: return .u32
        case 7: return .u64
        case 8: return .isize
        case 9: return .usize
        case 10: return .f32
        case 11: return .f64
        case 12: return .bool
        case 13: return .char
        case 14: return .string
        case 15: return .void
        default: return .neverKind
    }
}

public TextViewKind textViewKindOf(i64 i) {
    switch i {
        case 0: return .runes
        case 1: return .utf16
        case 2: return .lines
        default: return .parts
    }
}

public BuiltinKind builtinKindOf(i64 i) {
    switch i {
        case 0: return .arena
        case 1: return .strBuf
        case 2: return .io
        case 3: return .hex
        case 4: return .utf8
        case 5: return .ioStream
        case 6: return .ioInput
        case 7: return .processResult
        case 8: return .panic
        case 9: return .formatSpec
        case 10: return .symbol
        case 12: return .target
        case 13: return .env
        case 14: return .fs
        case 15: return .time
        case 16: return .millis
        default: return .path
    }
}

bool listContains(in List<i64> xs, by i64 x) {
    for e in xs {
        return true if e == x
    }
    return false
}

bool listContainsString(in List<string> xs, by string x) {
    for e in xs {
        return true if e == x
    }
    return false
}

i64 typeIndex(Type t) => t & 0xFFFFFFFF

public bool typeEquals(Type a, as Type b) => a == b

// ── Non-arena types ──────────────────────────────────────────────────────────

public Type prim(PrimitiveKind k) => makeType(.primitive, at: k.ordinal)

public Type errorType() => makeType(.error, at: 0)

public Type nullType() => makeType(.nullType, at: 0)

public Type textViewType(TextViewKind k) => makeType(.textView, at: k.ordinal)

public Type builtinType(BuiltinKind k) => makeType(.builtin, at: k.ordinal)

/// The C# `PrimitiveType.ByName` (all 29 names), or null.
Type? primitiveByName(string name) {
    switch name {
        case "i8": return prim(.i8)
        case "i16": return prim(.i16)
        case "i32": return prim(.i32)
        case "i64": return prim(.i64)
        case "u8": return prim(.u8)
        case "u16": return prim(.u16)
        case "u32": return prim(.u32)
        case "u64": return prim(.u64)
        case "isize": return prim(.isize)
        case "usize": return prim(.usize)
        case "f32": return prim(.f32)
        case "f64": return prim(.f64)
        case "bool": return prim(.bool)
        case "rune": return prim(.char)
        case "string": return prim(.string)
        case "void": return prim(.void)
        case "never": return prim(.neverKind)
        case "sbyte": return prim(.i8)
        case "short": return prim(.i16)
        case "int": return prim(.i32)
        case "long": return prim(.i64)
        case "byte": return prim(.u8)
        case "ushort": return prim(.u16)
        case "uint": return prim(.u32)
        case "ulong": return prim(.u64)
        case "nint": return prim(.isize)
        case "nuint": return prim(.usize)
        case "float": return prim(.f32)
        case "double": return prim(.f64)
    }
    return null
}

/// The C# `PrimitiveType.Name`.
public string primitiveName(PrimitiveKind k) {
    switch k {
        case .i8: return "i8"
        case .i16: return "i16"
        case .i32: return "i32"
        case .i64: return "i64"
        case .u8: return "u8"
        case .u16: return "u16"
        case .u32: return "u32"
        case .u64: return "u64"
        case .isize: return "isize"
        case .usize: return "usize"
        case .f32: return "f32"
        case .f64: return "f64"
        case .bool: return "bool"
        case .char: return "rune"
        case .string: return "string"
        case .void: return "void"
        case .neverKind: return "never"
    }
}

/// The C# `PrimitiveType.Bits`.
public i64 primitiveBits(PrimitiveKind k) {
    switch k {
        case .i8: return 8
        case .i16: return 16
        case .i32: return 32
        case .i64: return 64
        case .u8: return 8
        case .u16: return 16
        case .u32: return 32
        case .u64: return 64
        case .isize: return 64
        case .usize: return 64
        case .f32: return 32
        case .f64: return 64
        case .bool: return 0
        case .char: return 32
        case .string: return 0
        case .void: return 0
        case .neverKind: return 0
    }
}

// ── Predicates ───────────────────────────────────────────────────────────────

public bool isError(Type t) => kindOf(t) == .error

public bool isNever(Type t) => t == prim(.neverKind)

public bool isVoid(Type t) => t == prim(.void)

public bool isBool(Type t) => t == prim(.bool)

public bool isString(Type t) => t == prim(.string)

public bool isInteger(Type t) {
    return false if kindOf(t) != .primitive
    let i = typeIndex(t)
    return i is 0..=9
}

public bool isFloat(Type t) {
    return false if kindOf(t) != .primitive
    let i = typeIndex(t)
    return i is 10 or 11
}

public bool isNumeric(Type t) => isInteger(t) || isFloat(t)

public bool isSignedInteger(Type t) {
    return false if kindOf(t) != .primitive
    let i = typeIndex(t)
    return i is 0 or 1 or 2 or 3 or 8
}

public bool isUnsignedInteger(Type t) => isInteger(t) && !isSignedInteger(t)

/// The C# `TypeSymbol.IsBorrow` (every override in `Types.cs`; the symbol classes do not override it).
public bool isBorrow(ref Ctx c, by Type t) {
    switch kindOf(t) {
        case .span: return true
        case .textView: return true
        case .dynRef: return true
        case .function: return true
        case .optional: return isBorrow(ref c, by: c.optionalTypes[typeIndex(t)])
        case .tuple:
            for i in 0..c.tupleTypes[typeIndex(t)].length {
                return true if isBorrow(ref c, by: c.tupleTypes[typeIndex(t)][i].type)
            }
            return false
        case .result: return isBorrow(ref c, by: c.resultTypes[typeIndex(t)].value)
        case .builtin: return builtinKindOf(typeIndex(t)) == .strBuf
        default: return false
    }
}

// ── Primitive ranges ─────────────────────────────────────────────────────────

/// The C# `PrimitiveType.Range`; a non-integer kind is a caller bug.
public struct TypeRange {
    public Big min
    public Big max
}

/// The smallest and largest value of an integer kind, via T5's `bigMin`/`bigMax`.
public TypeRange range(PrimitiveKind k) {
    switch k {
        case .i8: return TypeRange { min: bigMin(8, signed: true), max: bigMax(8, signed: true) }
        case .i16: return TypeRange { min: bigMin(16, signed: true), max: bigMax(16, signed: true) }
        case .i32: return TypeRange { min: bigMin(32, signed: true), max: bigMax(32, signed: true) }
        case .i64: return TypeRange { min: bigMin(64, signed: true), max: bigMax(64, signed: true) }
        case .isize: return TypeRange { min: bigMin(64, signed: true), max: bigMax(64, signed: true) }
        case .u8: return TypeRange { min: bigMin(8, signed: false), max: bigMax(8, signed: false) }
        case .u16: return TypeRange { min: bigMin(16, signed: false), max: bigMax(16, signed: false) }
        case .u32: return TypeRange { min: bigMin(32, signed: false), max: bigMax(32, signed: false) }
        case .u64: return TypeRange { min: bigMin(64, signed: false), max: bigMax(64, signed: false) }
        case .usize: return TypeRange { min: bigMin(64, signed: false), max: bigMax(64, signed: false) }
        default: return TypeRange { min: bigZero(), max: bigZero() }
    }
}

// ── Copy and key helpers ─────────────────────────────────────────────────────

/// A copy of `xs` (used to pass a list `in` to a `ref Ctx` function without borrowing `c`).
List<i64> copyIds(in List<i64> xs) {
    var r = List<i64>()
    for x in xs {
        r.append(x)
    }
    return r
}

List<string> copyStrings(in List<string> xs) {
    var r = List<string>()
    for x in xs {
        r.append(x)
    }
    return r
}

List<TupleField> copyTupleFields(in List<TupleField> xs) {
    var r = List<TupleField>()
    for f in xs {
        r.append(f)
    }
    return r
}

string joinIds(in List<i64> xs) {
    var sb = StrBuf()
    for i in 0..xs.length {
        if i > 0 {
            sb.append(",")
        }
        sb.append(string(xs[i]))
    }
    return $"{sb.finish()}"
}

/// A length-prefixed join of effect names (unambiguous regardless of their bytes).
string joinUses(in List<string> xs) {
    var sb = StrBuf()
    for x in xs {
        sb.append($"{x.length}:{x}")
    }
    return $"{sb.finish()}"
}

/// The structural key of a tuple type: each field's type plus a length-prefixed name.
string tupleKey(in List<TupleField> fields) {
    var sb = StrBuf()
    for f in fields {
        sb.append(string(f.type))
        if (f.name is { } nm) {
            sb.append($"={nm.length}:{nm}|")
        } else {
            sb.append("|")
        }
    }
    return $"{sb.finish()}"
}

// ── Interning ────────────────────────────────────────────────────────────────

public Type internOptional(ref Ctx c, by Type inner) uses alloc {
    let key = string(inner)
    let found = c.optionalIntern.tryGet(at: key)
    return makeType(.optional, at: found) if found is not null
    let id = c.optionalTypes.length
    c.optionalTypes.append(inner)
    c.optionalIntern[key] = id
    return makeType(.optional, at: id)
}

public Type internSpan(ref Ctx c, by Type element, bool readOnly) uses alloc {
    let key = $"{element},{readOnly}"
    let found = c.spanIntern.tryGet(at: key)
    return makeType(.span, at: found) if found is not null
    let id = c.spanTypes.length
    c.spanTypes.append(SpanData { element: element, readOnly: readOnly })
    c.spanIntern[key] = id
    return makeType(.span, at: id)
}

public Type internDynRef(ref Ctx c, by InterfaceId iface, bool readOnly) uses alloc {
    let key = $"{iface},{readOnly}"
    let found = c.dynRefIntern.tryGet(at: key)
    return makeType(.dynRef, at: found) if found is not null
    let id = c.dynRefTypes.length
    c.dynRefTypes.append(DynRefData { iface: iface, readOnly: readOnly })
    c.dynRefIntern[key] = id
    return makeType(.dynRef, at: id)
}

public Type internList(ref Ctx c, by Type element) uses alloc {
    let key = string(element)
    let found = c.listIntern.tryGet(at: key)
    return makeType(.list, at: found) if found is not null
    let id = c.listTypes.length
    c.listTypes.append(element)
    c.listIntern[key] = id
    return makeType(.list, at: id)
}

public Type internMap(ref Ctx c, by Type key, to Type value) uses alloc {
    let k = $"{key},{value}"
    let found = c.mapIntern.tryGet(at: k)
    return makeType(.map, at: found) if found is not null
    let id = c.mapTypes.length
    c.mapTypes.append(MapData { key: key, value: value })
    c.mapIntern[k] = id
    return makeType(.map, at: id)
}

public Type internOwned(ref Ctx c, by Type inner) uses alloc {
    let key = string(inner)
    let found = c.ownedIntern.tryGet(at: key)
    return makeType(.owned, at: found) if found is not null
    let id = c.ownedTypes.length
    c.ownedTypes.append(inner)
    c.ownedIntern[key] = id
    return makeType(.owned, at: id)
}

public Type internUntrusted(ref Ctx c, by Type inner) uses alloc {
    let key = string(inner)
    let found = c.untrustedIntern.tryGet(at: key)
    return makeType(.untrusted, at: found) if found is not null
    let id = c.untrustedTypes.length
    c.untrustedTypes.append(inner)
    c.untrustedIntern[key] = id
    return makeType(.untrusted, at: id)
}

public Type internArray(ref Ctx c, by Type element, at i64 length) uses alloc {
    let key = $"{element},{length}"
    let found = c.arrayIntern.tryGet(at: key)
    return makeType(.array, at: found) if found is not null
    let id = c.arrayTypes.length
    c.arrayTypes.append(ArrayData { element: element, length: length })
    c.arrayIntern[key] = id
    return makeType(.array, at: id)
}

public Type internRange(ref Ctx c, by Type element) uses alloc {
    let key = string(element)
    let found = c.rangeIntern.tryGet(at: key)
    return makeType(.range, at: found) if found is not null
    let id = c.rangeTypes.length
    c.rangeTypes.append(element)
    c.rangeIntern[key] = id
    return makeType(.range, at: id)
}

public Type internTuple(ref Ctx c, for in List<TupleField> fields) uses alloc {
    let key = tupleKey(in fields)
    let found = c.tupleIntern.tryGet(at: key)
    return makeType(.tuple, at: found) if found is not null
    let id = c.tupleTypes.length
    c.tupleTypes.append(copyTupleFields(in fields))
    c.tupleIntern[key] = id
    return makeType(.tuple, at: id)
}

public Type internFunction(
    ref Ctx c,
    for in List<Type> parameters,
    to Type ret,
    by in List<ErrorSetId> errorSets,
    as in List<string> effects
) uses alloc {
    var sortedFails = copyIds(in errorSets)
    sortedFails.sort()
    var sortedUses = copyStrings(in effects)
    sortedUses.sort()
    let key = $"{joinIds(in parameters)};{ret};{joinIds(in sortedFails)};{joinUses(in sortedUses)}"
    let found = c.functionIntern.tryGet(at: key)
    return makeType(.function, at: found) if found is not null
    let id = c.functionTypes.length
    var params = copyIds(in parameters)
    c.functionTypes.append(
        FunctionData { parameters: move params, ret: ret, errorSets: move sortedFails, effects: move sortedUses },
    )
    c.functionIntern[key] = id
    return makeType(.function, at: id)
}

public Type internResult(ref Ctx c, by Type value, to Type error) uses alloc {
    let key = $"{value},{error}"
    let found = c.resultIntern.tryGet(at: key)
    return makeType(.result, at: found) if found is not null
    let id = c.resultTypes.length
    c.resultTypes.append(ResultData { value: value, error: error })
    c.resultIntern[key] = id
    return makeType(.result, at: id)
}

public Type internState(ref Ctx c, by StructId s, for in List<VariantId> states) uses alloc {
    var distinct = List<VariantId>()
    for v in states {
        if !listContains(in distinct, by: v) {
            distinct.append(v)
        }
    }
    distinct.sort()
    let key = $"{s}|{joinIds(in distinct)}"
    let found = c.stateIntern.tryGet(at: key)
    return makeType(.state, at: found) if found is not null
    let id = c.stateTypes.length
    c.stateTypes.append(StateData { s: s, states: move distinct })
    c.stateIntern[key] = id
    return makeType(.state, at: id)
}

/// The C# `ErrorUnionType.Of`: one set and no exclusions returns the set itself.
public Type errorUnionOf(ref Ctx c, for in List<ErrorSetId> sets, as in List<VariantId> excluded) uses alloc {
    return errorSetTypeOf(sets[0]) if sets.length == 1 && excluded.length == 0
    let key = $"{joinIds(in sets)}|{joinIds(in excluded)}"
    let found = c.errorUnionIntern.tryGet(at: key)
    return makeType(.errorUnion, at: found) if found is not null
    let id = c.errorUnionTypes.length
    c.errorUnionTypes.append(ErrorUnionData { sets: copyIds(in sets), excluded: copyIds(in excluded) })
    c.errorUnionIntern[key] = id
    return makeType(.errorUnion, at: id)
}

// ── Display ──────────────────────────────────────────────────────────────────

/// The C# `TextViewType.DisplayName`.
string textViewName(TextViewKind k) {
    switch k {
        case .runes: return "RuneView"
        case .utf16: return "Utf16View"
        case .lines: return "LineView"
        default: return "PartView"
    }
}

/// The C# `BuiltinType.Name`.
string builtinName(BuiltinKind k) {
    switch k {
        case .arena: return "Arena"
        case .strBuf: return "StrBuf"
        case .io: return "Io"
        case .hex: return "Hex"
        case .utf8: return "Utf8"
        case .ioStream: return "IoStream"
        case .ioInput: return "IoInput"
        case .processResult: return "ProcessResult"
        case .panic: return "Panic"
        case .formatSpec: return "FormatSpec"
        case .symbol: return "Symbol"
        case .target: return "Target"
        case .env: return "Env"
        case .fs: return "Fs"
        case .time: return "Time"
        case .millis: return "Millis"
        default: return "Path"
    }
}

string tupleDisplay(ref Ctx c, by i64 idx) {
    let len = c.tupleTypes[idx].length
    var sb = StrBuf()
    sb.append("(")
    for i in 0..len {
        if i > 0 {
            sb.append(", ")
        }
        let f = c.tupleTypes[idx][i]
        if (f.name is { } nm) {
            sb.append($"{typeDisplay(ref c, by: f.type)} {nm}")
        } else {
            sb.append(typeDisplay(ref c, by: f.type))
        }
    }
    sb.append(")")
    return $"{sb.finish()}"
}

string functionDisplay(ref Ctx c, by i64 idx) {
    let plen = c.functionTypes[idx].parameters.length
    let ret = c.functionTypes[idx].ret
    let flen = c.functionTypes[idx].errorSets.length
    let ulen = c.functionTypes[idx].effects.length
    var sb = StrBuf()
    if plen == 1
            && kindOf(c.functionTypes[idx].parameters[0]) != .tuple
            && kindOf(c.functionTypes[idx].parameters[0]) != .function {
        sb.append(typeDisplay(ref c, by: c.functionTypes[idx].parameters[0]))
    } else {
        sb.append("(")
        for i in 0..plen {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(typeDisplay(ref c, by: c.functionTypes[idx].parameters[i]))
        }
        sb.append(")")
    }
    sb.append(" -> ")
    if kindOf(ret) == .function && (flen > 0 || ulen > 0) {
        sb.append($"({typeDisplay(ref c, by: ret)})")
    } else {
        sb.append(typeDisplay(ref c, by: ret))
    }
    if ulen > 0 {
        sb.append(" uses ")
        for i in 0..ulen {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(c.functionTypes[idx].effects[i])
        }
    }
    if flen > 0 {
        sb.append(" fails ")
        for i in 0..flen {
            if i > 0 {
                sb.append(", ")
            }
            sb.append(errorSetDisplayName(ref c, by: c.functionTypes[idx].errorSets[i]))
        }
    }
    return $"{sb.finish()}"
}

string stateDisplay(ref Ctx c, by i64 idx) {
    let s = c.stateTypes[idx].s
    let slen = c.stateTypes[idx].states.length
    let st = structDisplayName(ref c, by: s)
    return $"{st}.{c.unionVariants[c.stateTypes[idx].states[0]].name}" if slen == 1
    var sb = StrBuf()
    sb.append($"{st} is ")
    for i in 0..slen {
        if i > 0 {
            sb.append(" or ")
        }
        sb.append($".{c.unionVariants[c.stateTypes[idx].states[i]].name}")
    }
    return $"{sb.finish()}"
}

string errorUnionDisplay(ref Ctx c, by i64 idx) {
    let setLen = c.errorUnionTypes[idx].sets.length
    let exLen = c.errorUnionTypes[idx].excluded.length
    return "error" if setLen == 0
    var sets = copyIds(in c.errorUnionTypes[idx].sets)
    var sb = StrBuf()
    for i in 0..setLen {
        if i > 0 {
            sb.append(" | ")
        }
        sb.append(displayNameAmong(ref c, by: sets[i], for: in sets))
    }
    if exLen > 0 {
        sb.append(" except ")
        for j in 0..exLen {
            if j > 0 {
                sb.append(", ")
            }
            sb.append($".{c.errorVariants[c.errorUnionTypes[idx].excluded[j]].name}")
        }
    }
    return $"{sb.finish()}"
}

/// The C# `TypeSymbol.DisplayName` for every kind.
public string typeDisplay(ref Ctx c, by Type t) uses alloc {
    switch kindOf(t) {
        case .primitive: return primitiveName(primKindOf(typeIndex(t)))
        case .error: return "?"
        case .nullType: return "null"
        case .typeParam: return c.typeParams[typeIndex(t)].name
        case .optional: return $"{typeDisplay(ref c, by: c.optionalTypes[typeIndex(t)])}?"
        case .span:
            let s = c.spanTypes[typeIndex(t)]
            let inner = typeDisplay(ref c, by: s.element)
            return s.readOnly ? $"ReadOnlySpan<{inner}>" : $"Span<{inner}>"
        case .textView: return textViewName(textViewKindOf(typeIndex(t)))
        case .dynRef:
            let d = c.dynRefTypes[typeIndex(t)]
            let inner = interfaceDisplayName(ref c, by: d.iface)
            return d.readOnly ? $"dyn ref readonly {inner}" : $"dyn ref {inner}"
        case .list: return $"List<{typeDisplay(ref c, by: c.listTypes[typeIndex(t)])}>"
        case .map:
            let m = c.mapTypes[typeIndex(t)]
            return $"Map<{typeDisplay(ref c, by: m.key)}, {typeDisplay(ref c, by: m.value)}>"
        case .owned: return $"Owned<{typeDisplay(ref c, by: c.ownedTypes[typeIndex(t)])}>"
        case .untrusted: return $"Untrusted<{typeDisplay(ref c, by: c.untrustedTypes[typeIndex(t)])}>"
        case .array:
            let a = c.arrayTypes[typeIndex(t)]
            return $"{typeDisplay(ref c, by: a.element)}[{a.length}]"
        case .range: return $"Range<{typeDisplay(ref c, by: c.rangeTypes[typeIndex(t)])}>"
        case .tuple: return tupleDisplay(ref c, by: typeIndex(t))
        case .function: return functionDisplay(ref c, by: typeIndex(t))
        case .result:
            let r = c.resultTypes[typeIndex(t)]
            return $"Result<{typeDisplay(ref c, by: r.value)}, {typeDisplay(ref c, by: r.error)}>"
        case .state: return stateDisplay(ref c, by: typeIndex(t))
        case .builtin: return builtinName(builtinKindOf(typeIndex(t)))
        case .errorUnion: return errorUnionDisplay(ref c, by: typeIndex(t))
        case .structType: return structDisplayName(ref c, by: typeIndex(t))
        case .interfaceType: return interfaceDisplayName(ref c, by: typeIndex(t))
        case .enumType: return enumDisplayName(ref c, by: typeIndex(t))
        case .unionType: return unionDisplayName(ref c, by: typeIndex(t))
        case .errorSet: return errorSetDisplayName(ref c, by: typeIndex(t))
        case .alias: return c.aliases[typeIndex(t)].name
    }
}

// ── Tuple/range/map views ────────────────────────────────────────────────────

/// The C# `MapType.Entry`: `(K key, V value)`.
public Type mapEntry(ref Ctx c, by Type map) uses alloc {
    let m = c.mapTypes[typeIndex(map)]
    var fields = List<TupleField>()
    fields.append(TupleField { name: "key", type: m.key })
    fields.append(TupleField { name: "value", type: m.value })
    return internTuple(ref c, for: in fields)
}

/// The C# `RangeType.Layout`: `(element, element, bool)`.
public Type rangeLayout(ref Ctx c, by Type range) uses alloc {
    let e = c.rangeTypes[typeIndex(range)]
    var fields = List<TupleField>()
    fields.append(TupleField { name: null, type: e })
    fields.append(TupleField { name: null, type: e })
    fields.append(TupleField { name: null, type: prim(.bool) })
    return internTuple(ref c, for: in fields)
}

/// The C# `TextViewType.Element`.
public Type textViewElement(TextViewKind k) {
    switch k {
        case .runes: return prim(.char)
        case .utf16: return prim(.u16)
        default: return prim(.string)
    }
}

// ── Keys, occurs, tuple index ────────────────────────────────────────────────

/// The C# `MapType.IsValidKey` with an empty path.
public bool isValidKey(ref Ctx c, by Type t) uses alloc {
    var path = List<i64>()
    return isValidKeyInner(ref c, by: t, for: ref path)
}

/// The C# `MapType.IsValidKey` walk, holding the structs being checked.
bool isValidKeyInner(ref Ctx c, by Type t, for ref List<i64> path) {
    switch kindOf(t) {
        case .tuple:
            for i in 0..c.tupleTypes[typeIndex(t)].length {
                let ft = c.tupleTypes[typeIndex(t)][i].type
                return false if kindOf(ft) != .typeParam && !isValidKeyInner(ref c, by: ft, for: ref path)
            }
            return true
        case .structType:
            let s = typeIndex(t)
            return false if listContainsString(in c.structs[s].attributes, by: "noEquality")
            return false if listContains(in path, by: s)
            path.append(s)
            var valid = true
            for j in 0..c.structs[s].fields.length {
                let ft = c.fields[c.structs[s].fields[j]].type
                if kindOf(ft) != .typeParam && !isValidKeyInner(ref c, by: ft, for: ref path) {
                    valid = false
                    break
                }
            }
            path.remove(at: path.length - 1)
            return valid
        default:
            return isInteger(t) || isString(t) || t == prim(.char) || isBool(t) || t == builtinType(.symbol)
                || (kindOf(t) == .enumType && c.enums[typeIndex(t)].fields.length == 0)
    }
}

/// The C# `MapType.InvalidKeyPart`'s result.
public struct InvalidKeyPart {
    public string part
    public Type   type
}

string fieldPartName(in TupleField f, at i64 i) {
    if (f.name is { } nm) {
        return nm
    }
    return string(i + 1)
}

/// The C# `MapType.InvalidKeyPart`: the first non-key part of a tuple or struct.
InvalidKeyPart? invalidKeyPart(ref Ctx c, by Type t) {
    switch kindOf(t) {
        case .tuple:
            for i in 0..c.tupleTypes[typeIndex(t)].length {
                let f = c.tupleTypes[typeIndex(t)][i]
                return InvalidKeyPart { part: fieldPartName(in f, at: i), type: f.type } if kindOf(f.type) != .typeParam
                    && !isValidKey(ref c, by: f.type)
            }
            return null
        case .structType:
            let s = typeIndex(t)
            return null if listContainsString(in c.structs[s].attributes, by: "noEquality")
            for j in 0..c.structs[s].fields.length {
                let f = c.fields[c.structs[s].fields[j]]
                return InvalidKeyPart { part: f.name, type: f.type } if kindOf(f.type) != .typeParam
                    && !isValidKey(ref c, by: f.type)
            }
            return null
        default:
            return null
    }
}

/// The C# `TypeParameterType.Occurs`.
bool occurs(ref Ctx c, by Type t) {
    switch kindOf(t) {
        case .typeParam: return true
        case .optional: return occurs(ref c, by: c.optionalTypes[typeIndex(t)])
        case .span: return occurs(ref c, by: c.spanTypes[typeIndex(t)].element)
        case .list: return occurs(ref c, by: c.listTypes[typeIndex(t)])
        case .map:
            return occurs(ref c, by: c.mapTypes[typeIndex(t)].key) || occurs(ref c, by: c.mapTypes[typeIndex(t)].value)
        case .array: return occurs(ref c, by: c.arrayTypes[typeIndex(t)].element)
        case .tuple:
            for i in 0..c.tupleTypes[typeIndex(t)].length {
                return true if occurs(ref c, by: c.tupleTypes[typeIndex(t)][i].type)
            }
            return false
        case .result: return occurs(ref c, by: c.resultTypes[typeIndex(t)].value)
        case .structType: return structIsGeneric(ref c, by: typeIndex(t))
        case .state: return structIsGeneric(ref c, by: c.stateTypes[typeIndex(t)].s)
        case .unionType: return unionIsGeneric(ref c, by: typeIndex(t))
        case .function:
            let flen = c.functionTypes[typeIndex(t)].parameters.length
            for i in 0..flen {
                return true if occurs(ref c, by: c.functionTypes[typeIndex(t)].parameters[i])
            }
            return occurs(ref c, by: c.functionTypes[typeIndex(t)].ret)
        case .interfaceType: return interfaceIsGeneric(ref c, by: typeIndex(t))
        case .dynRef: return interfaceIsGeneric(ref c, by: c.dynRefTypes[typeIndex(t)].iface)
        default: return false
    }
}

/// The C# `TupleType.IndexOf` (`name` or `item1`, `item2`, …), or -1.
i64 tupleIndexOf(ref Ctx c, by Type tuple, for string name) {
    let len = c.tupleTypes[typeIndex(tuple)].length
    for i in 0..len {
        let f = c.tupleTypes[typeIndex(tuple)][i]
        var matches = false
        if (f.name is { } nm) {
            if nm == name {
                matches = true
            }
        }
        if $"item{i + 1}" == name {
            matches = true
        }
        return i if matches
    }
    return -1
}
