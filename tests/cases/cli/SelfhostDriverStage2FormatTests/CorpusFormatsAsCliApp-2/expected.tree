}

public struct BFormatSpec {
    public i64  radix  = 0
    public bool debug  = false
    public i64  width  = 0
    public u32  fill   = 32
    public i64  align  = -1
    public i64  digits = -1
}

public struct UserIteration {
    public IterationKind kind
    public FuncId        advance      = -1
    public FuncId        item         = -1
    public LocalId       spill        = -1
    public FieldId       advanceField = -1
    public FieldId       itemField    = -1
}

public struct BSwitchSection {
    public TextSpan    span
    public BPattern    pattern = -1
