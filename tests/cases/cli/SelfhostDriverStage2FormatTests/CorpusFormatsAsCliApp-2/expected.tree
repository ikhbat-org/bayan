== driver/dist.byn
// The command `dist` of the self-hosted driver (spec 017 T12). Ports `Dist.cs` :18 `Run`, :110 `ResolveTargets`, :135 `ReadSource`, :147
// `InputsHash`, :164 `BuildInfo`, :196 `RefreshLatest` and :214 `CopyDirectory`. `clean` is cache.byn `cleanCommand` (spec 017 T3). An IO
// failure the C# lets escape (an unhandled exception) panics here (Q1151).

import semantics

/// Dist.cs:132 `SourceState`: the commit (null without one) and dirtiness of the work tree.
struct DistSource {
    string? commit
    bool    dirty
}

/// Scaffold.cs:171 `Git` with any number of arguments (scaffold.byn `scaffoldGit` takes two): `git -C <dir>` stands for
/// `WorkingDirectory = dir` (Q1009); stdout trimmed.
ScaffoldGitResult distGit(string git, at string dir, by in List<string> args) uses alloc, process {
    var all = List<string>()
    all.append("-C")
    all.append(dir)
    for a in args {
        all.append(a)
    }
    // coverage-exempt: Q1151 the catch is reached only if the `git` that was just found cannot start; the C# `Process.Start` throws there (Scaffold.cs:177)
    let r = Io.run(git, all.span) catch { panic($"cannot run {git}") }
    return ScaffoldGitResult { code: r.exitCode, stdout: r.stdout.trimmed() }
}

/// Dist.cs:18 `Run`. `kept` is the command and its arguments.
i32 distCommand(in List<string> kept, by ref DCtx d) uses alloc, clock, console, env, fs, process, random {
    var path: string? = null
    var targetArg: string? = null
    var modeArg: string? = null
    var force = false
    var allowDirty = false
    var json = false
    let args = t2Rest(kept)
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--target" && i + 1 < args.length {
            i += 1
            targetArg = args[i]
        } else if a == "--mode" && i + 1 < args.length {
            i += 1
            modeArg = args[i]
        } else if a == "--force" {
            force = true
        } else if a == "--allow-dirty" {
            allowDirty = true
        } else if a == "--diagnostics" && i + 1 < args.length && (args[i + 1] == "json" || args[i + 1] == "text") {
            i += 1
            json = args[i] == "json"
        } else if a.startsWith("-") || path is not null {
            Io.stderr.write($"bayan: unexpected argument `{a}`\n")
            Io.stderr.write(
                "usage: bayan dist [<dir>] [--target <t>|all] [--mode debug|safe|fast] [--force] [--allow-dirty]\n",
            )
            return exitUsage
        } else {
            path = a
        }
        i += 1
    }
    let dir = path ?? "."
    unless t1FileExists(Path.combine(dir, "package.byn")) {
        Io.stderr.write($"bayan: `{dir}` isn't a project (no `package.byn`); scripts and loose files have no dist\n")
        return exitUsage
    }
    var mode = modeArg ?? "safe"
    if mode != "debug" && mode != "safe" && mode != "fast" {
        Io.stderr.write($"bayan: unknown mode `{mode}` (expected debug, safe or fast)\n")
        return exitUsage
    }

    let o = T5Options { path: dir, mode: mode, json: json }
    let symbols = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    var compiled = t5Compile(
        in o,
        by: in symbols,
        to: ref reported,
        through: ref ok,
        ascii: d.styleErr.ascii,
        width: d.styleErr.width,
        isTty: d.stderrTty,
    )
    unless ok {
        return exitFailure
    }
    if compiled.library {
        Io.stderr.write(
            $"bayan: `{compiled.packageName}` is a library; library distribution arrives later, with FFI export\n",
        )
        return exitUsage
    }
    var version = ""
    var distTargets = List<string>()
    // coverage-exempt: Q1151 a project has a manifest (`package.byn` exists, checked above); the C# `compiled.Manifest!` (Dist.cs:55) has no null branch
    if (compiled.manifest is { } manifest) {
        version = manifest.version
        if modeArg is null {
            mode = manifest.distMode
        }
        for t in manifest.distTargets {
            distTargets.append(t)
        }
    }
    let targets = distResolveTargets(targetArg, by: in distTargets) ?? return exitUsage

    let root = Path.fullPath(compiled.displayRoot)
    let source = distReadSource(root)
    var dirty = false
    if source is not null {
        dirty = source.dirty
    }
    if dirty && !allowDirty {
        Io.stderr.write("bayan: the git tree has uncommitted changes, so this build couldn't be traced to a commit\n")
        Io.stderr.write("  help: commit first, or pass `--allow-dirty` (recorded in BUILDINFO.json)\n")
        return exitUsage
    }

    let distDir = Path.combine(root, "dist")
    let versionDir = Path.combine(distDir, version)
    if t5DirectoryExists(versionDir) && !force {
        Io.stderr.write($"bayan: `dist/{version}/` already exists, and a released version never changes\n")
        Io.stderr.write("  help: bump `version` in package.byn, or pass `--force` to rebuild this one\n")
        return exitUsage
    }

    let cSource = t5EmitC(ref compiled, by: mode)
    let plan = DistPlan {
        name: compiled.packageName,
        program: semantics.programName(ref compiled, for: dir),
        root: root,
        version: version,
        mode: mode,
        json: json,
    }
    let code = distBuild(
        cSource,
        by: in plan,
        for: in targets,
        from: source,
        through: ref d,
        at: in symbols,
    ) catch switch {
        // coverage-exempt: Q1151 an IO failure the C# lets escape as an unhandled exception (Dist.cs:85-102)
        IoError e => panic($"bayan: {e}"),
    }
    return code
}

/// What `Run` has settled when it reaches the builds: the package name and its short name, the project root, the version, the mode and `--diagnostics json`.
struct DistPlan {
    string name
    string program
    string root
    string version
    string mode
    bool   json
}

/// Dist.cs:83-106 from `EmitC` on: the builds into the staging directory, `SHA256SUMS`, `BUILDINFO.json`, the move into place and `latest/`.
i32 distBuild(
    string cSource,
    by in DistPlan plan,
    for in List<string> targets,
    from DistSource? source,
    through ref DCtx d,
    at in semantics.T26Symbols symbols
) uses alloc, clock, console, env, fs, process, random fails IoError {
    let distDir = Path.combine(plan.root, "dist")
    let versionDir = Path.combine(distDir, plan.version)
    let staging = Path.combine(distDir, $".{plan.version}.tmp")
    if t5DirectoryExists(staging) {
        t3RemoveEntry(staging)
    }
    var exes = List<string>()
    var hashes: Map<string, string> = []
    for target in targets {
        let exe = $"{target}/{targetExecutableName(plan.program, for: target)}"
        let output = Path.combine(staging, exe)
        try Io.createDirectory(Path.combine(staging, target))
        var progress = start(in d.styleErr, by: d.stderrTty, through: plan.json, for: "building")
        let built = t9Build(cSource, by: plan.mode, to: output, for: target, through: ref d)
        done(ref progress)
        unless built.result.succeeded {
            t5ReportToolchain(built.result, by: plan.json, for: symbols)
            t3RemoveEntry(staging)
            return exitToolchain
        }
        let bytes = try Io.readFile(output)
        exes.append(exe)
        hashes[exe] = Hex.encode(sha256(bytes.span).span)
    }
    exes.sort()
    var sums = StrBuf()
    for exe in exes {
        sums.append($"{hashes[exe]}  {exe}\n")
    }
    try Io.writeFile(Path.combine(staging, "SHA256SUMS"), $"{sums.finish()}".bytes)
    let hashed = try distInputsHash(plan.root)
    if hashed is null {
        t3RemoveEntry(staging)
        return exitFailure
    }
    let inputs = hashed
    try Io.writeFile(
        Path.combine(staging, "BUILDINFO.json"),
        distBuildInfo(plan.name, by: plan.version, for: plan.mode, to: in targets, from: source, through: inputs).bytes,
    )
    if t5DirectoryExists(versionDir) {
        t3RemoveEntry(versionDir)
    }
    try t9MoveDirectory(staging, to: versionDir)
    var copied = DistWalk {}
    let latest = try distRefreshLatest(distDir, through: ref copied)
    return exitFailure if copied.over
    Io.stdout.write(
        $"built {plan.name} {plan.version} ({plan.mode}) for {t5Join(in targets)} in dist/{plan.version}/\n",
    )
    // coverage-exempt: Q1153 `RefreshLatest` returns null only when `dist/` holds no semantic-version directory, and the one just published is named by a validated version (Dist.cs:201)
    if latest is not null {
        Io.stdout.write($"dist/latest/ is {latest}\n")
    }
    return exitOk
}

/// Dist.cs:110 `ResolveTargets`: `--target` (a name, `host` or `all`), else `dist.targets`, else the host. Null after reporting.
List<string>? distResolveTargets(string? arg, by in List<string> manifestTargets) uses alloc, console {
    var names = List<string>()
    if arg == "all" {
        names = targetNames()
    } else if arg is not null {
        names.append(arg)
    } else if manifestTargets.length > 0 {
        for t in manifestTargets {
            names.append(t)
        }
    } else {
        names.append("host")
    }
    var targets = List<string>()
    for name in names {
        let target = name == "host" ? t5HostTarget() : name
        unless targetIsKnown(target) {
            Io.stderr.write($"bayan: unknown target `{name}` (expected host, all, {t5Join(in targetNames())})\n")
            return null
        }
        var seen = false
        for t in targets {
            if t == target {
                seen = true
            }
        }
        unless seen {
            targets.append(target)
        }
    }
    return targets
}

/// Dist.cs:135 `ReadSource`: the commit and dirtiness of the git work tree holding `root`; null outside one or when it ignores the project.
DistSource? distReadSource(string root) uses alloc, env, fs, process {
    let git = ccFindOnPath("git", for: Target.os) ?? return null
    let inside = scaffoldGit(git, at: root, for: "rev-parse", through: "--is-inside-work-tree")
    return null if !(inside.code == 0 && inside.stdout == "true")
    // A project the enclosing repository ignores isn't in any of its commits.
    var ignored = List<string>()
    ignored.append("check-ignore")
    ignored.append("-q")
    ignored.append("package.byn")
    return null if distGit(git, at: root, by: in ignored).code == 0
    let head = scaffoldGit(git, at: root, for: "rev-parse", through: "HEAD")
    var commit: string? = null
    if head.code == 0 {
        commit = head.stdout
    }
    var status = List<string>()
    status.append("status")
    status.append("--porcelain")
    status.append("--")
    status.append(".")
    let porcelain = distGit(git, at: root, by: in status)
    return DistSource { commit: commit, dirty: !(porcelain.code == 0 && porcelain.stdout == "") }
}

/// What a walk keeps and what it has spent (docs/memory-leaks.md rules 1 and 5): the collected names with their paths, the counts of
/// files and directories, the bytes read, and whether a budget was crossed. A walk that crosses a budget stops, after one line (Q1154).
struct DistWalk {
    List<string>        names     = []
    Map<string, string> paths     = []
    i64                 fileCount = 0
    i64                 dirCount  = 0
    i64                 bytes     = 0
    bool                over      = false
}

const distMaxFiles: i64 = 20000
const distMaxDirs: i64  = 4000
const distMaxDepth: i64 = 64
const distMaxBytes: i64 = 67108864

/// The one line of a crossed budget (every caller returns at once, so a walk says it once).
void distStop(string what, through ref DistWalk w) uses alloc, console {
    w.over = true
    Io.stderr.write($"bayan: dist: {what}; stopped (docs/memory-leaks.md rule 1)\n")
}

/// `AttributesToSkip = ReparsePoint` (Dist.cs:151) without `lstat`: `path` is under a resolved directory, so it is a link exactly when its
/// real path differs from it; a link whose target is missing does not resolve and is one too (Q1150).
bool distIsLink(string path) uses alloc, fs {
    let real = realPath(path) catch return true
    return real != path
}

/// The `.byn` files under `dir` (a resolved directory), by their name relative to the project (`rel` is `dir`'s), links skipped. Bounded by the
/// depth, directory and file budgets.
void distCollect(string dir, by string rel, through ref DistWalk w, at i64 depth)
        uses alloc, console, fs
        fails IoError {
    if depth > distMaxDepth {
        distStop("the sources are nested deeper than 64 directories", through: ref w)
        return
    }
    w.dirCount += 1
    if w.dirCount > distMaxDirs {
        distStop("the sources hold more than 4000 directories", through: ref w)
        return
    }
    // `EnumerationOptions.IgnoreInaccessible` (Dist.cs:151, on by default): a directory that cannot be listed is skipped (Q1155); a directory is an entry that is no file, since `t5DirectoryExists` lists it
    let entries = Io.listDir(dir) catch return
    for name in entries {
        return if w.over
        let path = Path.combine(dir, name)
        continue if distIsLink(path)
        let relative = $"{rel}/{name}"
        if !Fs.fileExists(path) {
            try distCollect(path, by: relative, through: ref w, at: depth + 1)
        } else if t6IsByn(name) {
            w.fileCount += 1
            if w.fileCount > distMaxFiles {
                distStop("the sources hold more than 20000 .byn files", through: ref w)
                return
            }
            w.names.append(relative)
            w.paths[relative] = path
        }
    }
}

/// Dist.cs:147 `InputsHash`: SHA-256 over `package.byn` and every `.byn` under `src/`, by relative path; null after the line of a crossed budget
/// (at most 64 MiB of input is held at once, the digest being one-shot). The C# feeds `IncrementalHash`; one digest over the concatenation is the
/// same value (Q1150).
string? distInputsHash(string root) uses alloc, console, fs fails IoError {
    var w = DistWalk {}
    w.names.append("package.byn")
    w.paths["package.byn"] = Path.combine(root, "package.byn")
    let src = Path.combine(root, "src")
    // coverage-exempt: Q1151 an app compiles only with `src/app/`, so `src/` exists (Dist.cs:150 `Directory.Exists(src)` has no false arm here either)
    if t5DirectoryExists(src) {
        try distCollect(try realPath(src), by: "src", through: ref w, at: 0)
    }
    return null if w.over
    w.names.sort()
    var all = List<u8>()
    for i in 0..w.names.length {
        let name = w.names[i]
        for b in name.bytes {
            all.append(b)
        }
        all.append(0)
        let bytes = try Io.readFile(w.paths[name])
        w.bytes += bytes.length
        if w.bytes > distMaxBytes {
            distStop("the sources hold more than 64 MiB", through: ref w)
            return null
        }
        for b in bytes {
            all.append(b)
        }
        all.append(0)
    }
    return $"sha256:{Hex.encode(sha256(all.span).span)}"
}

/// Dist.cs:164 `BuildInfo`: `Utf8JsonWriter` indented by two spaces, ending in a newline. The values (a kebab package name, a semantic version, a
/// mode, target names, a commit hash and a hex digest) hold no character the writer escapes.
string distBuildInfo(
    string name,
    by string release,
    for string mode,
    to in List<string> targets,
    from DistSource? source,
    through string inputs
) uses alloc {
    var sb = StrBuf()
    sb.append("{\n")
    sb.append($"  \"package\": \"{name}\",\n")
    sb.append($"  \"version\": \"{release}\",\n")
    sb.append($"  \"compiler\": \"bayan {version}\",\n")
    sb.append($"  \"mode\": \"{mode}\",\n")
    sb.append("  \"targets\": [\n")
    for i in 0..targets.length {
        sb.append($"    \"{targets[i]}\"{i + 1 < targets.length ? "," : ""}\n")
    }
    sb.append("  ],\n")
    if source is not null {
        sb.append("  \"source\": {\n")
        if (source.commit is { } commit) {
            sb.append($"    \"commit\": \"{commit}\",\n")
        } else {
            sb.append("    \"commit\": null,\n")
        }
        sb.append($"    \"dirty\": {source.dirty ? "true" : "false"}\n")
        sb.append("  },\n")
    } else {
        sb.append("  \"source\": null,\n")
    }
    sb.append($"  \"inputs\": \"{inputs}\"\n")
    sb.append("}\n")
    return $"{sb.finish()}"
}

/// Dist.cs:196 `RefreshLatest`: `dist/latest/` rebuilt as a copy of the highest version present (by semantic version, not build time), staged
/// in `dist/.latest.tmp/` and renamed into place; that version, or null when `dist/` holds none.
string? distRefreshLatest(string distDir, through ref DistWalk w) uses alloc, console, fs fails IoError {
    var newest = ""
    var found = false
    let entries = try Io.listDir(distDir)
    for name in entries {
        continue if !(semantics.t10IsSemanticVersion(name) && t5DirectoryExists(Path.combine(distDir, name)))
        if !found || semantics.compareVersions(name, to: newest) > 0 {
            newest = name
            found = true
        }
    }
    // coverage-exempt: Q1153 no version directory at all (Dist.cs:201); the caller has just published one
    unless found {
        return null
    }
    let staging = Path.combine(distDir, ".latest.tmp")
    if t5DirectoryExists(staging) {
        t3RemoveEntry(staging)
    }
    try distCopyDirectory(Path.combine(distDir, newest), to: staging, through: ref w, at: 0)
    if w.over {
        t3RemoveEntry(staging)
        return null
    }
    try Io.writeFile(Path.combine(staging, "VERSION"), $"{newest}\n".bytes)
    let latest = Path.combine(distDir, "latest")
    if t5DirectoryExists(latest) {
        t3RemoveEntry(latest)
    }
    try t9MoveDirectory(staging, to: latest)
    return newest
}

/// Dist.cs:214 `CopyDirectory`: the files with their mode bits (`Fs.copy`), then each subdirectory. Bounded by the depth, directory and file
/// budgets of `w`: past one it says so and stops.
void distCopyDirectory(string from, to string dest, through ref DistWalk w, at i64 depth)
        uses alloc, console, fs
        fails IoError {
    if depth > distMaxDepth {
        distStop("a release is nested deeper than 64 directories", through: ref w)
        return
    }
    w.dirCount += 1
    if w.dirCount > distMaxDirs {
        distStop("a release holds more than 4000 directories", through: ref w)
        return
    }
    try Io.createDirectory(dest)
    let entries = try Io.listDir(from)
    var subdirectories = List<string>()
    for name in entries {
        if t5DirectoryExists(Path.combine(from, name)) {
            subdirectories.append(name)
        } else {
            w.fileCount += 1
            if w.fileCount > distMaxFiles {
                distStop("a release holds more than 20000 files", through: ref w)
                return
            }
            try Fs.copy(Path.combine(from, name), to: Path.combine(dest, name))
        }
    }
    for name in subdirectories {
        return if w.over
        try distCopyDirectory(Path.combine(from, name), to: Path.combine(dest, name), through: ref w, at: depth + 1)
    }
}
== driver/doctor.byn
// `bayan doctor` of the self-hosted driver (spec 017 T5): ports `Doctor.cs` 1-122 and `Toolchain.cs` `FindCompiler`'s `$BAYAN_CC` branch (:114-115),
// which `Doctor` reads; `CacheDirectory` and `Stats` come from cache.byn (`cacheDirectory`, `cacheStats`). `Doctor.Run` ignores its arguments.

import semantics

/// `Doctor.Level` (Doctor.cs:13).
enum T5Level {
    ok
    note
    broken
}

/// `Doctor.Check` (Doctor.cs:17); a null `fix` is C#'s `Fix = null`.
struct T5Check {
    T5Level level  = .ok
    string  name   = ""
    string  detail = ""
    string? fix    = null
}

/// `Role` of Style.cs:3 for the four roles `Render` paints.
enum T5Role {
    error
    help
    success
    note
}

const t5ZigUrl: string = "https://ziglang.org"

/// CliApp.cs:33 `VersionLine`'s commit has no source in the driver (Q1091): the row prints `(commit selfhost)`.
const t5Commit: string = "selfhost"

/// `Style.Paint` (Style.cs:68) with the palette of `style` (`t7Prefix`) when `style.color`.
string t5Paint(T5Role role, by DStyle style, for string text) uses alloc {
    unless style.color {
        return $"{text}"
    }
    var index = 4
    switch role {
        case .error:
            index = 0
        case .help:
            index = 2
        case .success:
            index = 3
        case .note:
            index = 4
    }
    let prefix = t7Prefix(by: style.palette, for: index)
    return $"{prefix}{text}\u{1b}[0m"
}

/// CliApp.cs:101 `Doctor.Run` (Doctor.cs:19): the checks in order, rendered to stdout; 4 when one fails.
i32 doctorCommand(by in DCtx d) uses alloc, clock, console, env, fs, process {
    var checks = List<T5Check>()
    // `Messages.DoctorVersion` with the commit of Q1091
    checks.append(T5Check { level: .ok, name: "bayan", detail: $"{version} (commit {t5Commit})" })
    // coverage-exempt: Q1092 `Target.os` is a constant of the host, so no row runs on a machine with no Bayan target
    if (targetHost() is { } host) {
        checks.append(T5Check { level: .ok, name: "host", detail: $"{host}" })
    } else {
        // coverage-exempt: Q1092 the no-host row
        checks.append(
            T5Check {
                level: .broken,
                name: "host",
                detail: "this machine has no Bayan target",
                fix: "build on linux, macos or windows, x64 or arm64",
            },
        )
    }
    checks.append(t5CCompiler())
    checks.append(t5Zig())
    checks.append(t5Git())
    checks.append(t5Cache())
    Io.stdout.write(t5Render(in checks, by: d.styleOut))
    for c in checks {
        return exitToolchain if c.level == .broken
    }
    return exitOk
}

/// Doctor.cs:37 `Render`.
string t5Render(in List<T5Check> checks, by DStyle style) uses alloc {
    let symbols = semantics.t26Symbols(style.ascii)
    var width = 0
    for c in checks {
        if c.name.length > width {
            width = c.name.length
        }
    }
    var sb = StrBuf()
    for c in checks {
        if c.level == .broken {
            sb.append($"{t5Paint(.error, by: style, for: $"{symbols.cross} {c.name}: {c.detail}")}\n")
        } else {
            let mark = t5Paint(c.level == .ok ? .success : .note, by: style, for: symbols.dot)
            var padded = StrBuf()
            padded.append(c.name)
            for _ in c.name.length..width {
                padded.append(" ")
            }
            sb.append($"{mark} {padded.finish()}  {c.detail}\n")
        }
        if (c.fix is { } fix) {
            sb.append($"{t5Paint(.help, by: style, for: $"  help: {fix}")}\n")
        }
    }
    return $"{sb.finish()}"
}

/// Doctor.cs:50 `CCompiler`.
T5Check t5CCompiler() uses alloc, env, fs, process {
    let fromEnv = (Env.get("BAYAN_CC") ?? "").length > 0
    let compiler = t5FindCompiler()
    return T5Check {
        level: .broken,
        name: "C compiler",
        detail: "none found",
        fix: $"install zig ({t5ZigUrl}), or set BAYAN_CC to a C compiler",
    } if compiler.length == 0
    let command = ccJoin(in compiler)
    var args = List<string>()
    for i in 1..compiler.length {
        args.append(compiler[i])
    }
    args.append("--version")
    if (t5Version(compiler[0], by: in args) is { } found) {
        return T5Check { level: .ok, name: "C compiler", detail: $"{command} ({found})" }
    }
    return T5Check {
        level: .broken,
        name: "C compiler",
        detail: $"BAYAN_CC is `{command}`, which can't be run",
        fix: "point BAYAN_CC at a C compiler, or unset it to use zig",
    } if fromEnv
    return T5Check {
        level: .broken,
        name: "C compiler",
        detail: $"`{command}` can't be run",
        fix: "reinstall it, or set BAYAN_CC to a working C compiler",
    }
}

/// Toolchain.cs:107 `FindCompiler`: `$BAYAN_CC` split on spaces (:110), else cc.byn `ccFindCompiler`; empty is C#'s null.
List<string> t5FindCompiler() uses alloc, env, fs {
    if ((Env.get("BAYAN_CC") ?? "") is { } cc && cc.length > 0) {
        var found = List<string>()
        for part in cc.parts(by: " ") {
            if part.length > 0 {
                found.append($"{part}")
            }
        }
        // the C# `compiler[0]` of Doctor.cs:56 throws IndexOutOfRangeException on no words; the driver panics (Q1095)
        if found.length == 0 {
            panic("BAYAN_CC is set but names no program")
        }
        return found
    }
    return ccFindCompiler()
}

/// Doctor.cs:63 `Zig`.
T5Check t5Zig() uses alloc, env, fs, process {
    let found = ccFindOnPath("zig", for: Target.os)
    if found is null {
        return T5Check {
            level: .note,
            name: "zig",
            detail: "not found; building for other targets needs it",
            fix: $"install zig ({t5ZigUrl})",
        }
    }
    let zig = found
    var args = List<string>()
    args.append("version")
    if (t5Version(zig, by: in args) is { } v) {
        return T5Check { level: .ok, name: "zig", detail: $"{zig} ({v})" }
    }
    return T5Check { level: .broken, name: "zig", detail: $"{zig} can't be run", fix: $"reinstall zig ({t5ZigUrl})" }
}

/// Doctor.cs:72 `Git`.
T5Check t5Git() uses alloc, env, fs, process {
    let found = ccFindOnPath("git", for: Target.os)
    if found is null {
        return T5Check {
            level: .note,
            name: "git",
            detail: "not found; `bayan new` skips `git init`, `bayan dist` records no commit, `bayan test --changed` is unavailable",
            fix: "install git",
        }
    }
    let git = found
    var args = List<string>()
    args.append("--version")
    if (t5Version(git, by: in args) is { } v) {
        return T5Check { level: .ok, name: "git", detail: $"{git} ({v})" }
    }
    return T5Check { level: .note, name: "git", detail: $"{git} can't be run", fix: "reinstall git" }
}

/// Doctor.cs:81 `Cache`: `Directory.CreateDirectory`, a probe file written and deleted, then cache.byn `cacheStats`.
T5Check t5Cache() uses alloc, clock, env, fs {
    let dir = cacheDirectory()
    Io.createDirectory(dir) catch switch { IoError e => return t5CacheBroken(dir, by: $"{e}") }
    let probe = Path.combine(dir, $".doctor-{Io.monotonicNanos()}")
    Io.writeFile(probe, "".bytes) catch switch { IoError e => return t5CacheBroken(dir, by: $"{e}") }
    // coverage-exempt: Q1092 the probe file was written a line earlier; only a race removes it
    Io.remove(probe) catch switch { IoError e => return t5CacheBroken(dir, by: $"{e}") }
    let stats = cacheStats()
    // `{2:0.0}` of `Bytes / 1024.0 / 1024.0`: exact in binary, so half-up on the tenths is .NET's rounding (cache.byn `cacheCommand`)
    let tenths = (stats.bytes * 10 + 524288) / 1048576
    return T5Check {
        level: .ok,
        name: "cache",
        detail: $"{dir} (writable, {stats.programs} programs, {tenths / 10}.{tenths % 10} MB)",
    }
}

/// The `catch` of Doctor.cs:93.
T5Check t5CacheBroken(string dir, by string message) {
    return T5Check {
        level: .broken,
        name: "cache",
        detail: $"{dir} isn't writable: {message}",
        fix: "set BAYAN_CACHE to a writable directory",
    }
}

/// Doctor.cs:100 `Version`: the first line `file` prints for `args`, trimmed (stdout, else stderr); null if it can't run or fails.
string? t5Version(string file, by in List<string> args) uses alloc, process {
    let r = Io.run(file, args.span) catch return null
    let text = r.stdout.length > 0 ? r.stdout : r.stderr
    unless r.exitCode == 0 {
        return null
    }
    for line in text.parts(by: "\n") {
        return $"{line.trimmed()}"
    }
    // coverage-exempt: Q1092 `parts` yields at least one part (an empty text gives one empty part), so the loop always returns; the C# `Split('\n')[0]` has no such line
    return null
}
== driver/explain.byn
// The command `explain` of the self-hosted driver (spec 017 T1). Ports `CliApp.cs` :1089 `Explain` and :1107 `ExplainText`;
// the embedded `docs/diagnostics/BYN####.md` are the constants of `diagdocs.byn` (plan D2). Takes the arguments `run` kept
// (the command first).

/// CliApp.cs:1089 `Explain`.
i32 explainCommand(List<string> kept) uses alloc, console {
    let args = t2Rest(kept)
    if args.length != 1 {
        Io.stderr.write("bayan: expected one diagnostic code, e.g. `bayan explain BYN0003`\n")
        return exitUsage
    }
    if (explainText(args[0]) is { } text) {
        Io.stdout.write(text)
        return exitOk
    }
    Io.stderr.write($"bayan: no explanation for `{args[0]}`\n")
    return exitUsage
}

/// CliApp.cs:1107 `ExplainText`: the document for a code, matched case-insensitively; null when the code is malformed or has none.
string? explainText(string code) uses alloc {
    let name = t1Trim(code).uppercased()
    return null if name.length != 7 || !name.startsWith("BYN")
    for i in 3..7 {
        let b = name.bytes[i]
        return null if b is < 0x30 or > 0x39
    }
    return diagDoc(name)
}

/// `char.IsWhiteSpace` for a code point of the Basic Multilingual Plane (the set `string.Trim` removes).
bool t1IsWhiteSpace(i64 cp) {
    return true if cp is 0x09..=0x0d
    return true if cp is 0x2000..=0x200a
    return cp is 0x20 or 0x85 or 0xa0 or 0x1680 or 0x2028 or 0x2029 or 0x202f or 0x205f or 0x3000
}

/// The code point and byte size of the UTF-8 sequence of `text` at byte `i`.
(i64 cp, i64 size) t1Decode(string text, at i64 i) {
    let b = i64(text.bytes[i])
    var size: i64 = 4
    var cp = b & 0x07
    if b < 0x80 {
        return (cp: b, size: 1)
    } else if b < 0xe0 {
        size = 2
        cp = b & 0x1f
    } else if b < 0xf0 {
        size = 3
        cp = b & 0x0f
    }
    for k in 1..size {
        cp = (cp << 6) | (i64(text.bytes[i + k]) & 0x3f)
    }
    return (cp: cp, size: size)
}

/// `string.Trim()` of CliApp.cs:1109: removes the `char.IsWhiteSpace` characters from both ends (`trimmed()` removes only ASCII ones).
string t1Trim(string text) {
    var start: i64 = 0
    var end = text.length
    while start < end {
        let c = t1Decode(text, at: start)
        unless t1IsWhiteSpace(c.cp) {
            break
        }
        start += c.size
    }
    while end > start {
        var i = end - 1
        while i > start && (text.bytes[i] & 0xc0) == 0x80 {
            i -= 1
        }
        let c = t1Decode(text, at: i)
        unless t1IsWhiteSpace(c.cp) {
            break
        }
        end = i
    }
    return text[start..end]
}
== driver/features.byn
// The command `features` of the self-hosted driver (spec 017 T2). Ports `Features.cs`: `Run` :19, `ToJson` :33 and
// `Declarations` :73. The C# `GetType().Name` of a syntax node comes from the name tables below (one arm per node kind of the
// selfhost parser, `SelfhostDefaultT2Tests` checks them against the C# types); a builtin's name is its case with the first
// letter raised, as `BuiltinMember.ToString()` writes it.

import lexer
import parser
import semantics

/// Features.cs:17 `Version`.
const featuresVersion: i64 = 1

/// Insertion into the set `items`, kept as a list in first-seen order (sorted by `t2Sorted`).
void t2Add(string item, to ref List<string> items) uses alloc {
    for x in items {
        return if x == item
    }
    items.append(item)
}

/// The `SortedSet<string>(StringComparer.Ordinal)` order of `items`.
void t2Sorted(through ref List<string> items) {
    for i in 1..items.length {
        var j = i
        while j > 0 && items[j] < items[j - 1] {
            let above = items[j - 1]
            items[j - 1] = items[j]
            items[j] = above
            j -= 1
        }
    }
}

/// `ToString()` of a `BuiltinMember` or `BuiltinFunction` case: the case name with its first letter raised.
string t2Pascal(string name) => $"{name[0..1].uppercased()}{name[1..name.length]}"

/// The `GetType().Name` of the syntax node an `Expr` is (`ExprSyntaxKind` is one case per `Expr` record).
string t2ExprName(semantics.ExprSyntaxKind kind) {
    switch kind {
        case .literalExpr: return "LiteralExpr"
        case .interpolatedExpr: return "InterpolatedExpr"
        case .nameExpr: return "NameExpr"
        case .thisExpr: return "ThisExpr"
        case .memberExpr: return "MemberExpr"
        case .targetMemberExpr: return "TargetMemberExpr"
        case .callExpr: return "CallExpr"
        case .indexExpr: return "IndexExpr"
        case .unaryExpr: return "UnaryExpr"
        case .binaryExpr: return "BinaryExpr"
        case .rangeExpr: return "RangeExpr"
        case .conditionalExpr: return "ConditionalExpr"
        // coverage-exempt: Q1078 a cast reports BYN1062 at parse, so the compile fails before the walk (tried)
        case .castExpr: return "CastExpr"
        case .isExpr: return "IsExpr"
        // coverage-exempt: Q1078 `except` is BYN2022 in v0.1, so the compile fails before the walk (tried)
        case .exceptExpr: return "ExceptExpr"
        case .inExpr: return "InExpr"
        case .switchExpr: return "SwitchExpr"
        case .tryExpr: return "TryExpr"
        case .moveExpr: return "MoveExpr"
        case .catchExpr: return "CatchExpr"
        case .caughtErrorExpr: return "CaughtErrorExpr"
        case .jumpExpr: return "JumpExpr"
        case .blockExpr: return "BlockExpr"
        case .structLiteralExpr: return "StructLiteralExpr"
        case .withExpr: return "WithExpr"
        case .spreadExpr: return "SpreadExpr"
        // coverage-exempt: Q1078 a map literal binds without an entry node of this syntax kind: the walk never sees it (tried, `["a": 1]`)
        case .mapEntryExpr: return "MapEntryExpr"
        case .collectionExpr: return "CollectionExpr"
        case .tupleExpr: return "TupleExpr"
        case .parenExpr: return "ParenExpr"
        case .lambdaExpr: return "LambdaExpr"
        case .stackallocExpr: return "StackallocExpr"
        // coverage-exempt: Q1078 a named pattern is BYN2022 in v0.1, so the compile fails before the walk (tried)
        case .patternExpr: return "PatternExpr"
        // coverage-exempt: Q1078 a parse error stops the compile before the walk, so the C# never sees an error node here
        case .errorExpr: return "ErrorExpr"
    }
}

/// The `GetType().Name` of a syntax node that is not an `Expr` (`NodeSyntaxKind`).
string t2NodeName(semantics.NodeSyntaxKind kind) {
    switch kind {
        case .blockStmt: return "BlockStmt"
        case .localDecl: return "LocalDecl"
        case .exprStmt: return "ExprStmt"
        case .assignStmt: return "AssignStmt"
        case .incDecStmt: return "IncDecStmt"
        case .returnStmt: return "ReturnStmt"
        case .failStmt: return "FailStmt"
        case .breakStmt: return "BreakStmt"
        case .continueStmt: return "ContinueStmt"
        case .becomeStmt: return "BecomeStmt"
        case .ifStmt: return "IfStmt"
        case .unlessStmt: return "UnlessStmt"
        case .guardedStmt: return "GuardedStmt"
        case .whileStmt: return "WhileStmt"
        case .doWhileStmt: return "DoWhileStmt"
        case .whileLetStmt: return "WhileLetStmt"
        case .forStmt: return "ForStmt"
        // coverage-exempt: Q1078 a loop label binds into the loop, with no node of this syntax kind (tried, `area: for`)
        case .labeledStmt: return "LabeledStmt"
        case .switchStmt: return "SwitchStmt"
        case .deferStmt: return "DeferStmt"
        case .assertStmt: return "AssertStmt"
        case .contextStmt: return "ContextStmt"
        // coverage-exempt: Q1078 a `;` reports a semicolon error at parse, so the compile fails before the walk
        case .emptyStmt: return "EmptyStmt"
        // coverage-exempt: Q1078 a parse error stops the compile before the walk, so the C# never sees an error node here
        case .errorStmt: return "ErrorStmt"
        case .constantPattern: return "ConstantPattern"
        case .relationalPattern: return "RelationalPattern"
        case .varPattern: return "VarPattern"
        case .discardPattern: return "DiscardPattern"
        case .declarationPattern: return "DeclarationPattern"
        case .notPattern: return "NotPattern"
        case .binaryPattern: return "BinaryPattern"
        case .propertyPattern: return "PropertyPattern"
        case .positionalPattern: return "PositionalPattern"
        case .variantPattern: return "VariantPattern"
        // coverage-exempt: Q1078 list patterns are BYN2022 in v0.1, so the compile fails before the walk (tried)
        case .slicePattern: return "SlicePattern"
        // coverage-exempt: Q1078 list patterns are BYN2022 in v0.1, so the compile fails before the walk (tried)
        case .listPattern: return "ListPattern"
        case .requiresRule: return "RequiresRule"
        case .globalStatement: return "GlobalStatement"
        // coverage-exempt: Q1078 no bound node carries a function declaration as its syntax node: the guard run missed it
        case .functionDecl: return "FunctionDecl"
        case .structDecl: return "StructDecl"
        case .name: return "Name"
        case .param: return "Param"
        case .argument: return "Argument"
    }
}

/// Features.cs:72 `Declarations` for the attributes of one declaration: each attribute, then its `because` clause.
void t2Attributes(in List<parser.AttributeSyntax> attributes, to ref List<string> nodes) uses alloc {
    for a in attributes {
        t2Add("AttributeSyntax", to: ref nodes)
        if a.becauseKeyword is not null {
            t2Add("BecauseClause", to: ref nodes)
        }
    }
}

/// Features.cs:72 `Declarations`: each declaration, nested members included, then its attributes and their `because` clauses.
void t2Declarations(in List<parser.Decl> decls, to ref List<string> nodes) uses alloc {
    for decl in decls {
        switch decl {
            case .importDecl(let n):
                t2Add("ImportDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .globalStatement(let n):
                t2Add("GlobalStatement", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .functionDecl(let n):
                t2Add("FunctionDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .structDecl(let n):
                t2Add("StructDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
                t2Declarations(in n.value.members, to: ref nodes)
            case .interfaceDecl(let n):
                t2Add("InterfaceDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
                t2Declarations(in n.value.members, to: ref nodes)
            case .getterDecl(let n):
                t2Add("GetterDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .associatedTypeDecl(let n):
                t2Add("AssociatedTypeDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .extensionDecl(let n):
                // coverage-exempt: Q1078 `extension` is BYN2022 in v0.1, so the compile fails before the walk
                t2Add("ExtensionDecl", to: ref nodes)
                // coverage-exempt: Q1078 `extension` is BYN2022 in v0.1, so the compile fails before the walk
                t2Attributes(in n.value.attributes, to: ref nodes)
                // coverage-exempt: Q1078 `extension` is BYN2022 in v0.1, so the compile fails before the walk
                t2Declarations(in n.value.members, to: ref nodes)
            case .fieldDecl(let n):
                t2Add("FieldDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .propertyDecl(let n):
                t2Add("PropertyDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .constructorDecl(let n):
                t2Add("ConstructorDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .errorEnumDecl(let n):
                t2Add("ErrorEnumDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .errorSetDecl(let n):
                t2Add("ErrorSetDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .enumDecl(let n):
                t2Add("EnumDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .unionDecl(let n):
                t2Add("UnionDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .typeAliasDecl(let n):
                t2Add("TypeAliasDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .effectDecl(let n):
                t2Add("EffectDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .testDecl(let n):
                t2Add("TestDecl", to: ref nodes)
                t2Attributes(in n.value.attributes, to: ref nodes)
            case .none:
                // coverage-exempt: Q1078 the `.none` declaration is never in a parsed list (the C# switch has no such arm)
                continue
        }
    }
}

/// Features.cs:41-51 for one function: the syntax kinds, builtins of its body (a `BoundBlock`, else nothing).
void t2Function(
    in semantics.Ctx c,
    for semantics.FuncId fn,
    to ref List<string> nodes,
    through ref List<string> builtins
) uses alloc {
    let body = c.functions[fn].body
    // coverage-exempt: Q1078 every function the C# counts has a block body here: no test row has a bodiless one
    return if body == -1 || semantics.boundKind(body) != .block
    for node in semantics.descendants(in c, for: body) {
        if (semantics.exprSyntax(in c, for: node) is { } e) {
            t2Add(t2ExprName(e.kind), to: ref nodes)
            if e.kind == .callExpr && e.becauseKeyword {
                t2Add("BecauseClause", to: ref nodes)
            }
            // coverage-exempt: Q1078 a bound node with neither syntax is not reached by the rows; the C# `else if` has no else
        } else if (semantics.nodeSyntax(in c, for: node) is { } s) {
            t2Add(t2NodeName(s.kind), to: ref nodes)
        }
        let index = node & 0xFFFFFFFF
        switch semantics.boundKind(node) {
            case .builtinCall:
                t2Add(t2Pascal($"{c.bBuiltinCalls[index].member}"), to: ref builtins)
            case .call:
                let builtin = c.functions[c.bCalls[index].function].builtin
                if builtin != .none {
                    t2Add(t2Pascal($"{builtin}"), to: ref builtins)
                }
            default:
                continue
        }
    }
}

/// Features.cs:61-66: `"name": [` items `]`, an empty array as `[]`, Utf8JsonWriter's indented layout.
void t2Array(string name, to ref StrBuf sb, from in List<string> items, at bool last) {
    if items.length == 0 {
        sb.append($"  \"{name}\": []")
    } else {
        sb.append($"  \"{name}\": [\n")
        for i in 0..items.length {
            sb.append($"    \"{items[i]}\"")
            sb.append(i + 1 < items.length ? ",\n" : "\n")
        }
        sb.append("  ]")
    }
    sb.append(last ? "\n" : ",\n")
}

/// Features.cs:33 `ToJson`.
string t2ToJson(in semantics.Ctx c) uses alloc {
    var nodes = List<string>()
    var builtins = List<string>()
    for m in c.modules {
        for f in m.files {
            t2Declarations(in c.files[f].unit.members, to: ref nodes)
        }
    }
    for m in c.modules {
        for fn in m.allFunctions {
            t2Function(in c, for: fn, to: ref nodes, through: ref builtins)
        }
        for t in m.tests {
            t2Function(in c, for: c.tests[t].function, to: ref nodes, through: ref builtins)
        }
    }
    var diagnostics = List<string>()
    for d in c.diagnostics {
        t2Add(d.code, to: ref diagnostics)
    }
    t2Sorted(through: ref nodes)
    t2Sorted(through: ref builtins)
    t2Sorted(through: ref diagnostics)
    var sb = StrBuf()
    sb.append("{\n")
    sb.append($"  \"version\": {featuresVersion},\n")
    t2Array("nodes", to: ref sb, from: in nodes, at: false)
    t2Array("builtins", to: ref sb, from: in builtins, at: false)
    t2Array("diagnostics", to: ref sb, from: in diagnostics, at: true)
    sb.append("}\n")
    return $"{sb.finish()}"
}

/// Features.cs:19 `Run`. `kept` is the arguments `run` kept, the command first.
i32 featuresCommand(in List<string> kept, by in DCtx d) {
    var used = false
    var args = List<string>()
    for i in 1..kept.length {
        if kept[i] == "--used" {
            used = true
        } else {
            args.append(kept[i])
        }
    }
    unless used {
        Io.stderr.write("usage: bayan features --used <path>\n")
        return exitUsage
    }
    let o = t5ParseBuildOptions(in args, by: false, for: false) ?? return exitUsage
    let symbols = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    let compiled = t5Compile(
        in o,
        by: in symbols,
        to: ref reported,
        through: ref ok,
        includeTests: true,
        ascii: d.styleErr.ascii,
        width: d.styleErr.width,
        isTty: d.stderrTty,
    )
    unless ok {
        return exitFailure
    }
    Io.stdout.write(t2ToJson(in compiled))
    return exitOk
}
== driver/fix.byn
// `bayan fix [<path>…]` of the self-hosted driver (spec 022 T9). Ports `FixCommand.cs` `Run`, `FixModule`, `TypedFixes`,
// `ErrorCount` and `Roots`.

import lexer
import parser
import semantics

/// A typed lint's fix in the file at `path` (a `TypedFixes` entry).
struct T9PathFix {
    string path
    T8Fix  fix
}

/// Applies the fix of every style lint (BYN1072–BYN1080), whatever its severity in `lints`; overlapping fixes wait for the next
/// pass, up to `d.maxPasses`. It does not run the formatter.
// FixCommand.cs: Run
i32 fixCommand(in List<string> kept, by in DCtx d) uses alloc, clock, console, fs {
    let args = t2Rest(in kept)
    for a in args {
        if a.startsWith("-") {
            Io.stderr.write("usage: bayan fix [<path>…]\n")
            return exitUsage
        }
    }
    var paths = List<string>()
    if args.length == 0 {
        paths.append(".")
    } else {
        for a in args {
            paths.append(a)
        }
    }
    for path in paths {
        continue if t6DirectoryExists(path) || Fs.fileExists(path)
        Io.stderr.write($"bayan: not found: {path}\n")
        return exitUsage
    }
    var exit = exitOk
    var files = List<string>()
    for path in paths {
        if t6DirectoryExists(path) {
            let root = realPath(path) catch switch {
                // coverage-exempt: Q1106 a directory that exists resolves
                IoError e => {
                    Io.stderr.write($"bayan: {path}: {e}\n")
                    return exitFailure
                }
            }
            for f in bynFiles(path, through: ref exit, by: root) {
                files.append(f)
            }
        } else {
            files.append(path)
        }
    }
    // The C# `SortedSet<string>(StringComparer.Ordinal)`: sorted, each once.
    files.sort()
    var sorted = List<string>()
    // A file named twice (`dup ./dup`, `. src`) is fixed once: a second copy would apply the fixes found before the first rewrote it.
    var reals: Map<string, bool> = []
    for f in files {
        continue if sorted.length > 0 && sorted[sorted.length - 1] == f
        if Path.fileName(f) != "package.byn" {
            let real = realPath(f) catch switch {
                // coverage-exempt: Q1106 a file that exists resolves
                IoError e => {
                    Io.stderr.write($"bayan: {f}: {e}\n")
                    return exitFailure
                }
            }
            unless reals.contains(real) {
                reals[real] = true
                sorted.append(f)
            }
        }
    }
    // `GroupBy` the full directory, in the order a directory first appears.
    var dirs = List<string>()
    for f in sorted {
        let dir = Path.directoryName(Path.fullPath(f)) ?? ""
        var seen = false
        for g in dirs {
            if g == dir {
                seen = true
            }
        }
        unless seen {
            dirs.append(dir)
        }
    }
    for dir in dirs {
        var module = List<string>()
        for f in sorted {
            if (Path.directoryName(Path.fullPath(f)) ?? "") == dir {
                module.append(f)
            }
        }
        fixModule(dir, for: in module, until: d.maxPasses, through: ref exit) catch switch {
            IoError e => {
                Io.stderr.write($"bayan: {dir}: {e}\n")
                exit = exitFailure
            }
        }
    }
    return exit
}

/// Fixes the files of one module until no fix applies, then prints each changed file's count. As `bayan format`, a file with a blocking
/// parse error is not fixed and its errors are rendered, and a pass whose fixed bytes no longer parse is abandoned for that file; either
/// sets `exit` to 1 (the C# `false`).
// FixCommand.cs: FixModule
void fixModule(string dir, for in List<string> files, until i64 maxPasses, through ref i32 exit)
        uses alloc, clock, console, fs
        fails IoError {
    var counts = List<i64>()
    var refused = List<bool>()
    for _ in files {
        counts.append(0)
        refused.append(false)
    }
    for _ in 0..maxPasses {
        let typed = try typedFixes(dir)
        var changed = false
        for k in 0..files.length {
            continue if refused[k]
            let real = try realPath(files[k])
            let bytes = try Io.readFile(real)
            var p = t8Parser(files[k], from: in bytes)
            let _ = parser.parseCompilationUnit(ref p)
            let blocking = fixBlocking(in p.lexed.diagnostics)
            if blocking.length > 0 {
                Io.stderr.write(t8RenderAll(files[k], from: in bytes, for: in blocking))
                refused[k] = true
                exit = exitFailure
                continue
            }
            parser.lintBanners(ref p)
            parser.keepComments(ref p)
            var fixes = List<T8Fix>()
            for lint in p.styleLints {
                if lint.hasFix {
                    fixes.append(T8Fix { span: lint.fixSpan, replacement: lint.fixReplacement })
                }
            }
            for t in typed {
                if t.path == real {
                    fixes.append(t.fix)
                }
            }
            continue if fixes.length == 0
            var applied: i64 = 0
            let fixedBytes = applyFixesCounting(in bytes, for: in fixes, to: ref applied)
            continue if t8SameBytes(in fixedBytes, as: in bytes)
            var check = t8Parser(files[k], from: in fixedBytes)
            let _ = parser.parseCompilationUnit(ref check)
            if fixBlocking(in check.lexed.diagnostics).length > 0 {
                // coverage-exempt: Q1122 through `rewriting it made it unparsable`
                Io.stderr.write(
                    $"bayan: {files[k]}: rewriting it made it unparsable, so the rewrite was abandoned and the file left unchanged\n",
                )
                refused[k] = true
                exit = exitFailure
                continue
            }
            try writeReplacing(real, from: in fixedBytes)
            counts[k] += applied
            changed = true
        }
        unless changed {
            break
        }
    }
    for k in 0..files.length {
        if counts[k] > 0 {
            Io.stdout.write($"fixed {files[k]} ({counts[k]})\n")
        }
    }
}

/// The tree's blocking errors: every code but an input form's. A report the parser withdrew (`unreport`, Q440) is gone from the C# bag.
// FixCommand.cs: FixModule (its `Blocking`)
List<T8Diagnostic> fixBlocking(in List<T8Diagnostic> diagnostics) uses alloc {
    var blocking = List<T8Diagnostic>()
    for d in diagnostics {
        if !d.code.isEmpty && !inputForms(d.code) {
            blocking.append(d)
        }
    }
    return blocking
}

/// The fixes of the lints that need types (BYN1078, and BYN1080 on a local), by full path, from a compilation of the module with
/// tests. Imports resolve under the first root that compiles cleanly: a project's `src/`, then the module's directory and its two
/// parents; otherwise under the one with the fewest errors.
// FixCommand.cs: TypedFixes
List<T9PathFix> typedFixes(string dir) uses alloc, clock, console, fs fails IoError {
    var paths = List<string>()
    for f in t5ModuleFiles(dir, includeTests: true) {
        if Path.fileName(f) != "package.byn" {
            paths.append(try realPath(f))
        }
    }
    var best: semantics.Ctx? = null
    var bestErrors: i64 = 0
    for root in fixRoots(dir) {
        var sources = List<lexer.SourceText>()
        for path in paths {
            let bytes = try Io.readFile(path)
            sources.append(lexer.SourceText.create(path, from: move bytes))
        }
        let options = T5CompilationOptions { includeTests: true }
        let c = semantics.create(from: move sources, at: root, by: in options)
        let errors = fixErrorCount(in c)
        if best is null || errors < bestErrors {
            bestErrors = errors
            best = move c
        }
        break if errors == 0
    }
    var fixes = List<T9PathFix>()
    if (best is { } found) {
        for lint in found.styleLints {
            if lint.hasFix {
                fixes.append(
                    T9PathFix {
                        path: found.files[lint.file].path,
                        fix: T8Fix { span: lint.fixSpan, replacement: lint.fixReplacement },
                    },
                )
            }
        }
    }
    return fixes
}

// FixCommand.cs: ErrorCount
i64 fixErrorCount(in semantics.Ctx c) {
    var n: i64 = 0
    for d in c.diagnostics {
        if !d.isWarning && !d.isNote {
            n += 1
        }
    }
    return n
}

// FixCommand.cs: Roots
List<string> fixRoots(string dir) uses alloc, fs {
    var roots = List<string>()
    var up = Path.directoryName(dir)
    while let u = up {
        let src = Path.combine(u, "src")
        if t1FileExists(Path.combine(u, "package.byn")) && dir.startsWith($"{src}/") {
            roots.append(src)
            break
        }
        up = Path.directoryName(u)
    }
    var at: string? = dir
    var i: i64 = 0
    while let a = at {
        break if i == 3
        roots.append(a)
        at = Path.directoryName(a)
        i += 1
    }
    return roots
}
== driver/format.byn
// `bayan format [--check] <path>` of the self-hosted driver (spec 017 T8). Ports `Format.cs` :17 `InputForms`, :41 `Run`, :284
// `WriteReplacing`, :301 `ApplyFixes`, :320 `FormatFile`, :366 `Restyle`, :407 `OtherUses`, :424 `OperatorFix` and :460 `Shape`, with
// `Parser.cs:76` `SyntaxTree.Parse` (the tree and its `Lints`, Parser.cs:15).

import lexer
import parser
import semantics

type T8Diagnostic = lexer.Diagnostic
type T8TextSpan   = lexer.TextSpan
type T8Ctx        = semantics.Ctx
type T8SourceFile = semantics.SourceFile
type T8Diag       = semantics.Diag

/// `Fix` of Diagnostic.cs:14: replace `span` with `replacement`.
struct T8Fix {
    T8TextSpan span
    string     replacement
}

/// Format.cs:17 `InputForms`: the input-form codes whose fix the formatter applies.
bool inputForms(string code) => code switch {
    "BYN1007"
        or "BYN1017"
        or "BYN1018"
        or "BYN1019"
        or "BYN1020"
        or "BYN1021"
        or "BYN1022"
        or "BYN1023"
        or "BYN1025" => true,
    "BYN1028" or "BYN1029" or "BYN1031" or "BYN1033" => true,
    "BYN1040"
        or "BYN1041"
        or "BYN1042"
        or "BYN1043"
        or "BYN1044"
        or "BYN1045"
        or "BYN1047"
        or "BYN1048"
        or "BYN1050"
        or "BYN1051"
        or "BYN1053"
        or "BYN1055"
        or "BYN1057"
        or "BYN1062" => true,
    "BYN1058" or "BYN1059" or "BYN1060" or "BYN1061" or "BYN1063" or "BYN1065" or "BYN1066" or "BYN1068" => true,
    "BYN6001" or "BYN6006" or "BYN7006" => true,
    _ => false,
}

/// Format.cs:27 `CSharpPrimitives`: C# primitive names and the sized names they mean (spec §3.1).
Map<string, string> cSharpPrimitives() uses alloc => [
    "sbyte": "i8",
    "byte": "u8",
    "short": "i16",
    "ushort": "u16",
    "int": "i32",
    "uint": "u32",
    "long": "i64",
    "ulong": "u64",
    "nint": "isize",
    "nuint": "usize",
    "float": "f32",
    "double": "f64",
]

/// Format.cs:33 `SizedPrimitives`: `CSharpPrimitives` with each key and value swapped.
Map<string, string> sizedPrimitives() uses alloc {
    var sized: Map<string, string> = []
    for (key, value) in cSharpPrimitives() {
        sized[value] = key
    }
    return sized
}

/// Format.cs:41 `Run`. `kept` is the command and its arguments.
i32 formatCommand(in List<string> kept, by in DCtx d) uses alloc, console, fs {
    let rest = t2Rest(in kept)
    var check = false
    var args = List<string>()
    for a in rest {
        if a == "--check" {
            check = true
        } else {
            args.append(a)
        }
    }
    if args.length != 1 || args[0].startsWith("-") {
        Io.stderr.write("usage: bayan format [--check] <path>\n")
        return exitUsage
    }
    let path = args[0]
    var exit = exitOk
    var files = List<string>()
    if t6DirectoryExists(path) {
        // The C#'s `RealPath(path)` (Format.cs:53) is outside its `try`: a directory that exists resolves (Q1106).
        let root = realPath(path) catch switch {
            // coverage-exempt: Q1106 through `return exitFailure`
            IoError e => {
                Io.stderr.write($"bayan: {path}: {e}\n")
                return exitFailure
            }
        }
        files = bynFiles(path, through: ref exit, by: root)
    } else if Fs.fileExists(path) {
        files.append(path)
    } else {
        Io.stderr.write($"bayan: not found: {path}\n")
        return exitUsage
    }
    files.sort()
    var manifests: Map<string, T6Found?> = []
    var packageNamesByRoot: Map<string, Map<string, bool>> = []
    for file in files {
        continue if Path.fileName(file) == "package.byn"
        let package = manifestFor(file, through: ref manifests) catch switch {
            IoError e => {
                Io.stderr.write($"bayan: {file}: {e}\n")
                exit = exitFailure
                continue
            }
        }
        var booleans = semantics.BooleanStyle.symbols
        var primitives = semantics.PrimitiveStyle.sized
        var declared: Map<string, bool> = []
        var layout = LayoutOptions {}
        if package is not null {
            if package.hasErrors {
                Io.stderr.write(package.report)
                exit = exitFailure
                continue
            }
            booleans = package.booleans
            primitives = package.primitives
            layout = LayoutOptions {
                indent: package.indent,
                width: package.width,
                align: package.align,
                trailingCommas: package.trailingCommas,
            }
            unless packageNamesByRoot.contains(package.dir) {
                packageNamesByRoot[package.dir] = packageNames(package.dir)
            }
            for (name, _) in packageNamesByRoot[package.dir] {
                declared[name] = true
            }
        }
        // Read and write the file the kernel opens, not the one a lexical `..` collapse names.
        let real = realPath(file) catch switch {
            IoError e => {
                Io.stderr.write($"bayan: {file}: {e}\n")
                exit = exitFailure
                continue
            }
        }
        let original = Io.readFile(real) catch switch {
            IoError e => {
                Io.stderr.write($"bayan: {file}: {e}\n")
                exit = exitFailure
                continue
            }
        }
        var unfixable = false
        let formatted = formatFile(
            file,
            from: in original,
            by: booleans,
            for: primitives,
            at: in declared,
            until: d.maxPasses,
            to: ref unfixable,
            as: layout,
        )
        if (formatted is { } bytes) {
            if unfixable {
                exit = exitFailure
            }
            if !t8SameBytes(in bytes, as: in original) {
                if check {
                    Io.stdout.write($"would format {file}\n")
                    exit = exitFailure
                } else {
                    writeReplacing(real, from: in bytes) catch switch {
                        IoError e => {
                            Io.stderr.write($"bayan: {file}: {e}\n")
                            exit = exitFailure
                            continue
                        }
                    }
                    Io.stdout.write($"formatted {file}\n")
                }
            }
        } else {
            exit = exitFailure
        }
    }
    return exit
}

/// `formatted.AsSpan().SequenceEqual(original)`: the same bytes in the same order.
bool t8SameBytes(in List<u8> a, as in List<u8> b) {
    return false if a.length != b.length
    for i in 0..a.length {
        return false if a[i] != b[i]
    }
    return true
}

/// Format.cs:284 `WriteReplacing`: writes `bytes` over `file`, already resolved by `realPath`, in place (Q1122).
// stub: T8 `WriteReplacing` temp file, mode, rename (blocked: Q1111)
void writeReplacing(string file, from in List<u8> bytes) fails IoError {
    try Io.writeFile(file, bytes.span)
}

/// Format.cs:301 `ApplyFixes`: the bytes with each distinct fix applied in order; a fix overlapping an earlier one is skipped.
List<u8> applyFixes(in List<u8> bytes, for in List<T8Fix> fixes) uses alloc {
    var applied: i64 = 0
    return applyFixesCounting(in bytes, for: in fixes, to: ref applied)
}

/// Format.cs:316 `ApplyFixes`, counting the fixes `applied`.
List<u8> applyFixesCounting(in List<u8> bytes, for in List<T8Fix> fixes, to ref i64 applied) uses alloc {
    // `fixes.Distinct().OrderBy(f => f.Span.Start)`: the first of each equal fix, then a stable sort by start.
    var ordered = List<T8Fix>()
    for f in fixes {
        var seen = false
        for g in ordered {
            if g.span.start == f.span.start && g.span.length == f.span.length {
                // coverage-exempt: Q1123
                if g.replacement == f.replacement {
                    seen = true
                }
            }
        }
        continue if seen
        ordered.append(f)
        var k = ordered.length - 1
        while k > 0 && ordered[k - 1].span.start > ordered[k].span.start {
            let moved = ordered[k - 1]
            ordered[k - 1] = ordered[k]
            ordered[k] = moved
            k -= 1
        }
    }
    var result = List<u8>()
    var at: i64 = 0
    for fix in ordered {
        continue if fix.span.start < at
        applied += 1
        for i in at..fix.span.start {
            result.append(bytes[i])
        }
        for b in fix.replacement.bytes {
            result.append(b)
        }
        at = fix.span.end
    }
    for i in at..bytes.length {
        result.append(bytes[i])
    }
    return result
}

/// The parser of Parser.cs:76 `Parser.Parse` over `bytes`. The C# `SyntaxTree` is that parser (its source, tokens and diagnostics), the
/// root `parseCompilationUnit` gives and the `Lints` `lintLineJoins` gives after it, kept by the callers as locals: a field of a struct
/// cannot be passed by `ref` beside its sibling (BYN3005) nor moved out (BYN2782).
parser.Parser t8Parser(string file, from in List<u8> bytes) uses alloc {
    var copy = List<u8>()
    for b in bytes {
        copy.append(b)
    }
    return parser.Parser.create(lexer.lex(lexer.SourceText.create(file, from: move copy), by: lexer.Keywords.build()))
}

/// `DiagnosticRenderer.RenderAll(diagnostics, includePath: true)` of the tree's errors: rendered against a `Ctx` holding `bytes` as file 0,
/// named `file` as the C# `SourceText` names it.
string t8RenderAll(string file, from in List<u8> bytes, for in List<T8Diagnostic> diagnostics) uses alloc {
    let empty = List<u8>()
    var p = parser.Parser.create(lexer.lex(lexer.SourceText.create(file, from: move empty), by: lexer.Keywords.build()))
    let unit = parser.parseCompilationUnit(ref p)
    var text = List<u8>()
    for b in bytes {
        text.append(b)
    }
    var c = T8Ctx {
        files: List<T8SourceFile>(),
        modules: List<semantics.Mod>(),
        diagnostics: List<T8Diag>(),
        bags: List<semantics.DiagBag>(),
    }
    c.files.append(
        T8SourceFile { path: file, displayPath: file, text: move text, unit: move unit, imports: Map<string, i64>() },
    )
    var diags = List<T8Diag>()
    for d in diagnostics {
        diags.append(T8Diag {
            code: d.code,
            file: 0,
            span: d.span,
            message: d.message,
            label: d.label,
            help: d.help,
            isWarning: false,
            hasFix: d.hasFix,
            fixSpan: d.fixSpan,
            fixReplacement: d.fixReplacement,
            related: List<semantics.Related>(),
        })
    }
    var omitted: i64 = 0
    return semantics.renderAll(in c, from: in diags, by: true, until: 2147483647, to: ref omitted)
}

/// `DiagnosticRenderer.RenderAll(manifest.Diagnostics, includePath: true)` (Format.cs:72): the manifest's diagnostics, which have no file (Q565),
/// rendered against a `Ctx` holding the text of `path` as file 0, named `package.byn` as the C# `SourceText` names it.
string t8RenderManifest(string path, from in List<T8Diag> diagnostics) uses alloc, fs {
    let text = Io.readFile(path) catch List<u8>()
    let empty = List<u8>()
    var p = parser.Parser.create(
        lexer.lex(lexer.SourceText.create("package.byn", from: move empty), by: lexer.Keywords.build()),
    )
    let unit = parser.parseCompilationUnit(ref p)
    var c = T8Ctx {
        files: List<T8SourceFile>(),
        modules: List<semantics.Mod>(),
        diagnostics: List<T8Diag>(),
        bags: List<semantics.DiagBag>(),
    }
    c.files.append(
        T8SourceFile {
            path: "package.byn",
            displayPath: "package.byn",
            text: move text,
            unit: move unit,
            imports: Map<string,
            i64>(),
        },
    )
    var diags = List<T8Diag>()
    for d in diagnostics {
        diags.append(T8Diag {
            code: d.code,
            file: 0,
            span: d.span,
            message: d.message,
            label: d.label,
            help: d.help,
            isWarning: d.isWarning,
            hasFix: d.hasFix,
            fixSpan: d.fixSpan,
            fixReplacement: d.fixReplacement,
            related: List<semantics.Related>(),
        })
    }
    var omitted: i64 = 0
    return semantics.renderAll(in c, from: in diags, by: true, until: 2147483647, to: ref omitted)
}

/// Format.cs:320 `FormatFile`: the file's bytes with every input-form fix applied, then the project's spellings; null after reporting a
/// blocking error. An input-form diagnostic left with no fix is reported and sets `unfixable`.
List<u8>? formatFile(
    string file,
    from in List<u8> bytes,
    by semantics.BooleanStyle booleans,
    for semantics.PrimitiveStyle primitives,
    at in Map<string,
    bool> declared,
    until i64 maxPasses,
    to ref bool unfixable,
    as LayoutOptions layout
) uses alloc, console {
    unfixable = false
    var converged = false
    var current = List<u8>()
    for b in bytes {
        current.append(b)
    }
    for pass in 0..maxPasses {
        var p = t8Parser(file, from: in current)
        let root = parser.parseCompilationUnit(ref p)
        let lints = parser.lintLineJoins(ref p)
        // `tree.Diagnostics`: a report the parser withdrew (`unreport`, Q440) is gone from the C# bag. Every parser code is an error.
        var blocking = List<T8Diagnostic>()
        for d in p.lexed.diagnostics {
            if !d.code.isEmpty && !inputForms(d.code) {
                blocking.append(d)
            }
        }
        if blocking.length > 0 {
            // After a rewrite the positions and snippets would point at text the file on disk does not hold.
            // coverage-exempt: Q1122 through `rewriting it made it unparsable`
            if pass == 0 {
                Io.stderr.write(t8RenderAll(file, from: in current, for: in blocking))
            } else {
                Io.stderr.write(
                    $"bayan: {file}: rewriting it made it unparsable, so the rewrite was abandoned and the file left unchanged\n",
                )
            }
            return null
        }
        var fixes = List<T8Fix>()
        for d in p.lexed.diagnostics {
            // coverage-exempt: Q1123
            if !d.code.isEmpty && inputForms(d.code) && d.hasFix {
                fixes.append(T8Fix { span: d.fixSpan, replacement: d.fixReplacement })
            }
        }
        for d in lints {
            fixes.append(T8Fix { span: d.fixSpan, replacement: d.fixReplacement })
        }
        var next = List<u8>()
        if fixes.length > 0 {
            next = applyFixes(in current, for: in fixes)
        } else {
            next = restyle(
                file,
                from: in current,
                by: in root,
                through: ref p,
                for: booleans,
                as: primitives,
                at: in declared,
            )
        }
        if fixes.length == 0 && t8SameBytes(in next, as: in current) {
            let laid = layoutApply(current, by: layout)
            if (laid.skipReason is { } reason) {
                Io.stderr.write($"bayan format: layout skipped for {file}: {reason}\n")
            }
            next = laid.output.copy()
        }
        if t8SameBytes(in next, as: in current) {
            var fixless = List<T8Diagnostic>()
            for d in p.lexed.diagnostics {
                // coverage-exempt: Q1123
                if !d.code.isEmpty && inputForms(d.code) {
                    fixless.append(d)
                }
            }
            if fixless.length > 0 {
                Io.stderr.write(t8RenderAll(file, from: in current, for: in fixless))
                unfixable = true
            }
            converged = true
            break
        }
        current = move next
    }
    // coverage-exempt: Q1122 through `unfixable = true`
    if !converged {
        Io.stderr.write($"bayan: {file}: still changing after {maxPasses} passes; left unfixed\n")
        unfixable = true
    }
    return current
}

/// Format.cs:366 `Restyle`: the bytes with primitive type names and boolean operators in the project's spelling (spec §3.1, §7.2). A
/// boolean rewrite is kept only when the file parses to the same tree after it, so `and`, `or` and `not` in patterns, and a `!` that is
/// not the operator, stay as written.
List<u8> restyle(
    string file,
    from in List<u8> bytes,
    by in parser.CompilationUnit tree,
    through ref parser.Parser p,
    for semantics.BooleanStyle booleans,
    as semantics.PrimitiveStyle primitives,
    at in Map<string,
    bool> declared
) uses alloc {
    let names = primitives == .sized ? cSharpPrimitives() : sizedPrimitives()
    var copy = List<u8>()
    for b in bytes {
        copy.append(b)
    }
    var lexed = lexer.lex(lexer.SourceText.create(file, from: move copy), by: lexer.Keywords.build())
    let tokens = lexed.tokens.copy()
    // Only a type, or a callee or receiver (`int(x)`, `i64.max`), is renamed: a field, binding, label or member spelled like a primitive
    // keeps its name. A callee or receiver is kept when the file, or another file of its package, uses the spelling as anything else,
    // since it may then be that binding.
    let typeNames = t8Starts(parser.typeNames(in tree, from: ref p))
    let calleeNames = t8Starts(parser.calleeAndReceiverNames(in tree, from: ref p))
    var others = otherUses(file, from: in bytes, by: in tree, through: ref p)
    for (name, _) in declared {
        others[name] = true
    }
    var renames = List<T8Fix>()
    var operators = List<T8Fix>()
    for i in 0..tokens.length {
        let token = tokens[i]
        var renamed = false
        if token.kind == .identifier && (typeNames.contains(token.start) || calleeNames.contains(token.start)) {
            let text = lexed.source.getText(T8TextSpan.fromBounds(token.start, until: token.end))
            if names.contains(text) && (typeNames.contains(token.start) || !others.contains(text)) {
                renames.append(
                    T8Fix { span: T8TextSpan { start: token.start, length: token.length }, replacement: names[text] },
                )
                renamed = true
            }
        }
        if !renamed {
            if (operatorFix(in bytes, from: in tokens, at: i, by: booleans) is { } fix) {
                operators.append(fix)
            }
        }
    }
    // The operators' offsets move with a rename, so they wait for the next pass.
    return applyFixes(in bytes, for: in renames) if renames.length > 0
    var result = List<u8>()
    for b in bytes {
        result.append(b)
    }
    return result if operators.length == 0
    let before = shape(in tree, from: ref p)
    let all = applyFixes(in bytes, for: in operators)
    var allParser = t8Parser(file, from: in all)
    let allRoot = parser.parseCompilationUnit(ref allParser)
    return all if shape(in allRoot, from: ref allParser) == before
    // Some operator is not a boolean one: try each alone, last first, so earlier offsets stay valid.
    var i = operators.length - 1
    while i >= 0 {
        var single = List<T8Fix>()
        single.append(operators[i])
        let one = applyFixes(in result, for: in single)
        var oneParser = t8Parser(file, from: in one)
        let oneRoot = parser.parseCompilationUnit(ref oneParser)
        if shape(in oneRoot, from: ref oneParser) == before {
            result = move one
        }
        i -= 1
    }
    return result
}

/// The start of each name, as the keys of a map (the C# `Select(n => n.Span.Start).ToHashSet()`).
Map<i64, bool> t8Starts(in List<T8TextSpan> names) uses alloc {
    var starts: Map<i64, bool> = []
    for n in names {
        starts[n.start] = true
    }
    return starts
}

/// Format.cs:407 `OtherUses`: every identifier the file spells other than as a type, a callee or receiver, or a member after a dot (the C#
/// `HashSet<string>`, as the keys of a map). The signature is walk.byn `t6OtherUses`'s.
Map<string, bool> otherUses(
    string file,
    from in List<u8> bytes,
    by in parser.CompilationUnit tree,
    through ref parser.Parser p
) uses alloc {
    var copy = List<u8>()
    for b in bytes {
        copy.append(b)
    }
    var lexed = lexer.lex(lexer.SourceText.create(file, from: move copy), by: lexer.Keywords.build())
    let tokens = lexed.tokens.copy()
    let typeNames = t8Starts(parser.typeNames(in tree, from: ref p))
    let calleeNames = t8Starts(parser.calleeAndReceiverNames(in tree, from: ref p))
    var found: Map<string, bool> = []
    for i in 0..tokens.length {
        let t = tokens[i]
        continue if t.kind != .identifier || typeNames.contains(t.start) || calleeNames.contains(t.start)
        continue if i > 0 && (tokens[i - 1].kind == .dot || tokens[i - 1].kind == .questionDot)
        found[lexed.source.getText(T8TextSpan.fromBounds(t.start, until: t.end))] = true
    }
    return found
}

/// A blank of `SpaceBefore`/`SpaceAfter` (Format.cs:428-429): space, tab, line feed or carriage return.
bool t8IsSpace(u8 b) => b is 0x20 or 0x09 or 0x0a or 0x0d

/// Format.cs:424 `OperatorFix`: the rewrite of token `i` into the other boolean spelling, or null when it is not one.
T8Fix? operatorFix(in List<u8> bytes, from in List<lexer.Token> tokens, at i64 i, by semantics.BooleanStyle booleans)
        uses alloc {
    let token = tokens[i]
    let span = T8TextSpan { start: token.start, length: token.length }
    if booleans == .words {
        let word = token.kind switch {
            .ampAmp => "and",
            .barBar => "or",
            .bang   => "not",
            _       => "",
        }
        return null if word.isEmpty
        // coverage-exempt: Q1144 through `token.start > 0`
        let spaceBefore = token.start > 0 && t8IsSpace(bytes[token.start - 1])
        // coverage-exempt: Q1144 through `token.end < bytes.length`
        let spaceAfter = token.end < bytes.length && t8IsSpace(bytes[token.end])
        let before = token.kind != .bang && !spaceBefore ? " " : ""
        return T8Fix { span: span, replacement: $"{before}{word}{spaceAfter ? "" : " "}" }
    }
    let symbol = token.kind switch {
        .andKeyword => "&&",
        .orKeyword  => "||",
        .notKeyword => "!",
        _           => "",
    }
    return null if symbol.isEmpty
    return T8Fix { span: span, replacement: symbol } if token.kind != .notKeyword
    // `not x` becomes `!x`: the blanks up to the operand go too, unless a comment or line break is there.
    let next = tokens[i + 1]
    for at in token.end..next.start {
        return null if bytes[at] != 0x20 && bytes[at] != 0x09
    }
    return T8Fix { span: T8TextSpan.fromBounds(token.start, until: next.start), replacement: symbol }
}

/// Format.cs:460 `Shape`: the tree's dump and its diagnostic codes, which a respelling must leave unchanged.
string shape(in parser.CompilationUnit tree, from ref parser.Parser p) uses alloc {
    var sb = StrBuf()
    parser.dump(in tree, from: ref p, to: ref sb)
    let dump = $"{sb.finish()}"
    var live = List<T8Diagnostic>()
    for d in p.lexed.diagnostics {
        // coverage-exempt: Q1123
        unless d.code.isEmpty {
            live.append(d)
        }
    }
    var diagnostics = ""
    if live.length > 0 {
        var rendered = StrBuf()
        lexer.renderAll(live.span, to: ref rendered, from: ref p.lexed.source)
        diagnostics = $"\n{rendered.finish()}"
    }
    var codes = StrBuf()
    for k in 0..live.length {
        if k > 0 {
            codes.append(" ")
        }
        codes.append(live[k].code)
    }
    return $"{dump[0..dump.length - diagnostics.length]}{codes.finish()}"
}
== driver/layout.byn
// The layout pass of `bayan format` (spec 022 T8). Ports `Layout.cs` (`Layout` and its `Engine`) function for function; each function
// names the member it ports. The C# `Decls` and `Blocks` iterators are walked in place by the passes that read them (`guideDecls`,
// `guideStmt`, `memberBlanks`, `shapes`), since a borrowed declaration cannot be collected into a list. The tree walks recurse as deep
// as the parser did when it built the tree, and every other loop is bounded by the token count.

import lexer
import parser
import semantics

/// Layout.cs: LayoutOptions. The project's layout knobs (`style` in `package.byn`).
struct LayoutOptions {
    i64                          indent         = 4
    i64                          width          = 120
    semantics.AlignStyle         align          = .runs
    semantics.TrailingCommaStyle trailingCommas = .multiline
}

/// Layout.cs: Apply. The laid-out bytes, or the input and why the layout was skipped.
struct LayoutResult {
    List<u8> output
    string?  skipReason
}

/// Layout.cs: Rounds. Rounds of the engine over its own output: a join can fit only once a later break has shortened its line.
const layoutRounds: i64 = 4

/// Layout.cs: GapItem. A newline, or a `//` comment (or a `#!`/`#:` line at the top) without its trailing blanks.
struct LayoutGapItem {
    bool isComment
    i64  start
    i64  end
}

/// Layout.cs: Gap.
struct LayoutGap {
    List<LayoutGapItem> items
    bool hasNewline
    bool hasBlank
}

/// Layout.cs: Frame. An open `{`, `(`, `[` (or the file), with the level of its line and its current statement.
struct LayoutFrame {
    lexer.TokenKind opener
    i64  line
    i64  statement       = 0
    i64  statementIndent = 0
    bool control         = false
    bool clause          = false
    i64  body            = -1
    bool inSwitch        = false
}

/// Layout.cs: Side.
enum LayoutSide {
    deferred
    space
    none
    keep
}

/// Layout.cs: Chain. A member chain: its receiver's first token, its last token, the `.` of each link, and those that break.
struct LayoutChain {
    i64       start
    i64       end
    List<i64> dots
    List<i64> breakable
    i64       lambdaCalls
}

/// The C# `(Start, End)` of `Unformatted`.
struct LayoutRegion {
    i64 start
    i64 end
}

/// What the passes read of an `AttributeSyntax`: its span, its name's span and the end of its `because` (0 without one).
struct LayoutAttribute {
    i64  start
    i64  end
    i64  nameStart
    i64  nameEnd
    bool hasBecause
    i64  becauseEnd
}

/// The C# `(Key, Columns)` of `Shapes`.
struct LayoutShape {
    string    key
    List<i64> columns
}

/// The C# `(Start, Group, Method)` of `MemberBlanks`.
struct LayoutMember {
    i64    start
    string group
    bool   method
}

/// The C# `(TokenKind, string)` of `Significant`.
struct LayoutTokenText {
    lexer.TokenKind kind
    string text
}

/// Layout.cs: Apply. Lays out `source`, spacing each product written tight (`a*b`). When that fails `layoutCheck` (`u8*p` is a pointer
/// to the parser), the file is laid out again with each such gap as written.
LayoutResult layoutApply(List<u8> source, by LayoutOptions options) uses alloc {
    let spaced = layoutApplyWith(source, by: options, for: true)
    return spaced if spaced.skipReason is null
    return layoutApplyWith(source, by: options, for: false)
}

/// The UTF-8 byte order mark's length at the start of `bytes`: 3 or 0.
i64 layoutBom(List<u8> bytes) => bytes.length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF ? 3 : 0

/// `Lexer.Lex(new SourceText("layout", bytes))`.
lexer.LexResult layoutLex(List<u8> bytes, by lexer.Keywords keywords) uses alloc {
    let copy = bytes.copy()
    return lexer.lex(lexer.SourceText.create("layout", from: move copy), by: keywords)
}

/// Layout.cs: Apply (the private overload).
LayoutResult layoutApplyWith(List<u8> source, by LayoutOptions options, for bool spaceProducts) uses alloc {
    let keywords = lexer.Keywords.build()
    let lexed = layoutLex(source, by: keywords)
    let tokens = lexed.tokens.copy()
    let bom = layoutBom(source)
    var gaps = List<LayoutGap>()
    unless layoutGaps(source, from: tokens, at: bom, to: ref gaps) {
        return LayoutResult {
            output: source.copy(),
            skipReason: "text between tokens that is neither whitespace nor a `//` comment",
        }
    }
    var p = parser.Parser.create(move lexed)
    let tree = parser.parseCompilationUnit(ref p)
    var engine = layoutEngine(source.copy(), from: move tokens, by: move gaps, at: bom, for: options, as: spaceProducts)
    var output = engine.render(tree)
    for round in 1..layoutRounds {
        let roundLexed = layoutLex(output, by: keywords)
        let roundTokens = roundLexed.tokens.copy()
        var roundGaps = List<LayoutGap>()
        unless layoutGaps(output, from: roundTokens, at: bom, to: ref roundGaps) {
            break
        }
        var roundParser = parser.Parser.create(move roundLexed)
        let roundTree = parser.parseCompilationUnit(ref roundParser)
        var roundEngine = layoutEngine(
            output.copy(),
            from: move roundTokens,
            by: move roundGaps,
            at: bom,
            for: options,
            as: spaceProducts,
        )
        let next = roundEngine.render(roundTree)
        break if t8SameBytes(in next, as: in output)
        output = move next
    }
    if (layoutCheck(
        source,
        from: engine.tokens,
        by: engine.gaps,
        at: tree,
        through: ref p,
        for: output,
    ) is { } reason) {
        return LayoutResult { output: source.copy(), skipReason: reason }
    }
    return LayoutResult { output: move output, skipReason: null }
}

/// Layout.cs: Gaps. The gap before each token into `gaps`; false when one holds something other than blanks, newlines and line comments.
bool layoutGaps(List<u8> source, from List<lexer.Token> tokens, at i64 bom, to ref List<LayoutGap> gaps) uses alloc {
    for i in 0..tokens.length {
        let start = i == 0 ? bom : tokens[i - 1].end
        var items = List<LayoutGapItem>()
        var at = start
        var blank = false
        var lineEmpty = i == 0
        while at < tokens[i].start {
            let b = source[at]
            if b is 0x20 or 0x09 or 0x0D {
                at += 1
                continue
            }
            if b == 0x0A {
                if lineEmpty && items.length > 0 {
                    blank = true
                }
                items.append(LayoutGapItem { isComment: false, start: at, end: at + 1 })
                lineEmpty = true
                at += 1
                continue
            }
            let shebang = b == 0x23 && i == 0 && (at == start || source[at - 1] == 0x0A)
            return false if !shebang && !(b == 0x2F && at + 1 < tokens[i].start && source[at + 1] == 0x2F)
            var end = at
            while end < tokens[i].start && source[end] != 0x0A {
                end += 1
            }
            var trimmed = end
            while trimmed > at
                    && (source[trimmed - 1] == 0x20 || source[trimmed - 1] == 0x09 || source[trimmed - 1] == 0x0D) {
                trimmed -= 1
            }
            items.append(LayoutGapItem { isComment: true, start: at, end: trimmed })
            lineEmpty = false
            at = end
        }
        var newline = false
        for x in items {
            if !x.isComment {
                newline = true
            }
        }
        gaps.append(LayoutGap { items: move items, hasNewline: newline, hasBlank: blank })
    }
    return true
}

/// Layout.cs: Check. Why `output` may not replace `source`, or null when it may. `p` is the parser that built `tree` from `source`.
string? layoutCheck(
    List<u8> source,
    from List<lexer.Token> tokens,
    by List<LayoutGap> gaps,
    at parser.CompilationUnit tree,
    through ref parser.Parser p,
    for List<u8> output
) uses alloc {
    let lexed = layoutLex(output, by: lexer.Keywords.build())
    let after = lexed.tokens.copy()
    let before = layoutSignificant(p.lexed.source, from: tokens)
    let now = layoutSignificant(lexed.source, from: after)
    return "the tokens changed" if before.length != now.length
    for k in 0..before.length {
        return "the tokens changed" if before[k].kind != now[k].kind || before[k].text != now[k].text
    }
    let adjacency = layoutAdjacency(source, from: tokens)
    let adjacencyAfter = layoutAdjacency(output, from: after)
    return "the spacing the parser reads changed" if adjacency.length != adjacencyAfter.length
    for k in 0..adjacency.length {
        return "the spacing the parser reads changed" if adjacency[k] != adjacencyAfter[k]
    }
    let bom = layoutBom(output)
    var afterGaps = List<LayoutGap>()
    unless layoutGaps(output, from: after, at: bom, to: ref afterGaps) {
        return "the comments changed"
    }
    let comments = layoutComments(source, from: gaps)
    let commentsAfter = layoutComments(output, from: afterGaps)
    return "the comments changed" if comments.length != commentsAfter.length
    for k in 0..comments.length {
        return "the comments changed" if comments[k] != commentsAfter[k]
    }
    var reparsed = parser.Parser.create(move lexed)
    let reparsedTree = parser.parseCompilationUnit(ref reparsed)
    var codes = List<string>()
    for d in p.lexed.diagnostics {
        unless d.code.isEmpty {
            codes.append(d.code)
        }
    }
    var codesAfter = List<string>()
    for d in reparsed.lexed.diagnostics {
        unless d.code.isEmpty {
            codesAfter.append(d.code)
        }
    }
    return "the diagnostics changed" if codes.length != codesAfter.length
    for k in 0..codes.length {
        return "the diagnostics changed" if codes[k] != codesAfter[k]
    }
    return "the tree changed" if shape(in tree, from: ref p) != shape(in reparsedTree, from: ref reparsed)
    return null
}

/// Whether token `i` is a trailing comma: a `,` before `)`, `]` or `}`.
bool layoutTrailing(List<lexer.Token> tokens, at i64 i) {
    return false if tokens[i].kind != .comma || i + 1 >= tokens.length
    let next = tokens[i + 1].kind
    return next is .closeParen or .closeBracket or .closeBrace
}

/// Layout.cs: Significant. The tokens as kind and text, less each trailing comma (a `,` before `)`, `]` or `}`).
List<LayoutTokenText> layoutSignificant(lexer.SourceText text, from List<lexer.Token> tokens) uses alloc {
    var result = List<LayoutTokenText>()
    for i in 0..tokens.length {
        continue if layoutTrailing(tokens, at: i)
        result.append(
            LayoutTokenText {
                kind: tokens[i].kind,
                text: text.getText(lexer.TextSpan.fromBounds(tokens[i].start, until: tokens[i].end)),
            },
        )
    }
    return result
}

/// Layout.cs: Adjacency. Whether a gap goes before each significant token, at the positions where the parser reads it (1 or 0), and 2
/// (the C# null) elsewhere.
List<i8> layoutAdjacency(List<u8> bytes, from List<lexer.Token> tokens) uses alloc {
    var result = List<i8>()
    for i in 0..tokens.length {
        continue if layoutTrailing(tokens, at: i)
        if layoutTriviaMatters(bytes, from: tokens, at: i) && !layoutStarGap(tokens, at: i) {
            result.append(tokens[i].hasTriviaBefore ? i8(1) : i8(0))
        } else {
            result.append(i8(2))
        }
    }
    return result
}

/// Layout.cs: TriviaMatters. Whether the parser branches on the gap before token `i` (`HasTriviaBefore` in Parser.cs): a `>` then `>`
/// or `>=`, a `..` then `.`, a `*` that may make a pointer, a numeric suffix, and `unlikely` before a gap.
bool layoutTriviaMatters(List<u8> bytes, from List<lexer.Token> tokens, at i64 i) {
    return false if i == 0 || i >= tokens.length
    let before = tokens[i - 1].kind
    let kind = tokens[i].kind
    return before == .greater && (kind is .greater or .greaterEquals)
        || before == .dotDot && kind == .dot
        || layoutStarGap(tokens, at: i)
        || kind == .numericSuffix
        || before == .identifier
        && layoutBytesAre(bytes, from: tokens[i - 1].start, until: tokens[i - 1].end, as: "unlikely")
}

/// Whether `bytes[start..end]` spell `word`.
bool layoutBytesAre(List<u8> bytes, from i64 start, until i64 end, as string word) {
    let w = word.bytes
    return false if end - start != w.length
    for k in 0..w.length {
        return false if bytes[start + k] != w[k]
    }
    return true
}

/// Layout.cs: StarGap. The gaps around a `*` that may make a pointer (`u8*`, `u8* p`).
bool layoutStarGap(List<lexer.Token> tokens, at i64 i) {
    let before = tokens[i - 1].kind
    let kind = tokens[i].kind
    return kind == .star && (layoutTypeEnd(before) || before == .star)
        || before == .star && !tokens[i - 1].hasTriviaBefore
}

/// Layout.cs: TypeEnd. A token a type can end with, so that a `*` after it may make a pointer.
bool layoutTypeEnd(lexer.TokenKind kind) =>
    kind == .identifier
    || kind == .greater
    || kind == .question
    || kind == .closeBracket
    || parser.isContextualKeyword(kind)

/// Layout.cs: Comments.
List<string> layoutComments(List<u8> bytes, from List<LayoutGap> gaps) uses alloc {
    var result = List<string>()
    for g in gaps {
        for x in g.items {
            if x.isComment {
                result.append(layoutString(layoutCommentText(bytes, from: x)))
            }
        }
    }
    return result
}

/// `Encoding.UTF8.GetString(bytes)`.
string layoutString(List<u8> bytes) uses alloc {
    let copy = bytes.copy()
    let text = lexer.SourceText.create("layout", from: move copy)
    return text.getText(lexer.TextSpan.fromBounds(0, until: bytes.length))
}

/// Layout.cs: CommentText. A comment as written, with one space after its `//` run when text follows it directly (proposal §3.8).
List<u8> layoutCommentText(List<u8> bytes, from LayoutGapItem item) uses alloc {
    var slashes: i64 = 0
    let length = item.end - item.start
    while slashes < length && bytes[item.start + slashes] == 0x2F {
        slashes += 1
    }
    var text = List<u8>()
    for k in item.start..item.end {
        text.append(bytes[k])
    }
    return text if slashes == 0
        || slashes == length
        || bytes[item.start + slashes] == 0x20
        || bytes[item.start + slashes] == 0x09
    var spaced = List<u8>()
    for k in 0..slashes {
        spaced.append(text[k])
    }
    spaced.append(0x20)
    for k in slashes..length {
        spaced.append(text[k])
    }
    return spaced
}

/// Layout.cs: Engine (its constructor).
LayoutEngine layoutEngine(
    move List<u8> source,
    from move List<lexer.Token> tokens,
    by move List<LayoutGap> gaps,
    at i64 bom,
    for LayoutOptions options,
    as bool spaceProducts
) uses alloc {
    let n = tokens.length
    var engine = LayoutEngine {
        source: move source,
        tokens: move tokens,
        gaps: move gaps,
        bom: bom,
        options: options,
        spaceProducts: spaceProducts,
        keywords: lexer.Keywords.build(),
        lineStart: List<bool>(),
        levelOf: List<i64>(),
        frozen: List<bool>(),
        inHole: List<bool>(),
        needsBlank: List<bool>(),
        matchOf: List<i64>(),
        dropComma: List<bool>(),
        addComma: List<bool>(),
        pad: List<i64>(),
        commentPad: List<i64>(),
        tightAfter: List<bool>(),
        tightBefore: List<bool>(),
        enclosing: List<i64>(),
        headerArrow: List<bool>(),
        output: List<u8>(),
    }
    for i in 0..n {
        engine.lineStart.append(false)
        engine.levelOf.append(0)
        engine.frozen.append(false)
        engine.inHole.append(false)
        engine.needsBlank.append(false)
        engine.matchOf.append(0)
        engine.dropComma.append(false)
        engine.addComma.append(false)
        engine.pad.append(0)
        engine.commentPad.append(0)
        engine.tightAfter.append(false)
        engine.tightBefore.append(false)
        engine.enclosing.append(0)
        engine.headerArrow.append(false)
    }
    return engine
}

/// Layout.cs: IsOpener.
bool layoutIsOpener(lexer.TokenKind kind) => kind is .openParen or .openBracket or .openBrace or .interpolationStart

/// Layout.cs: IsCloser.
bool layoutIsCloser(lexer.TokenKind kind) => kind is .closeParen or .closeBracket or .closeBrace or .interpolationEnd

/// Layout.cs: AfterLa. Whether a line ending in `kind` continues on the next (lā).
bool layoutAfterLa(lexer.TokenKind kind) => kind switch {
    .comma or .fatArrow or .openBrace or .openParen or .openBracket        => true,
    .dot or .dotDot or .dotDotEquals or .question or .questionQuestion     => true,
    .questionDot or .plus or .minus or .star or .slash or .percent         => true,
    .plusPercent or .minusPercent or .starPercent or .plusBar or .minusBar => true,
    .starBar or .amp or .ampAmp or .bar or .barBar or .caret               => true,
    .equalsEquals or .bangEquals or .less or .lessEquals or .greaterEquals => true,
    .lessLess or .andKeyword or .orKeyword or .isKeyword or .inKeyword     => true,
    .equals or .plusEquals or .minusEquals or .starEquals or .slashEquals  => true,
    .percentEquals or .ampEquals or .barEquals or .caretEquals             => true,
    .lessLessEquals or .questionQuestionEquals                             => true,
    _                                                                      => false,
}

/// Layout.cs: ExpressionBefore. Whether a name after `kind` starts an expression, not a declaration (`Type name(`).
bool layoutExpressionBefore(lexer.TokenKind kind) => kind switch {
    .identifier or .greater or .question or .closeBracket or .closeParen or .star => false,
    .returnKeyword or .tryKeyword or .awaitKeyword or .inKeyword or .isKeyword    => true,
    .andKeyword or .orKeyword or .notKeyword or .ifKeyword or .unlessKeyword      => true,
    .whileKeyword or .elseKeyword or .failKeyword or .yieldKeyword                => true,
    .deferKeyword or .errdeferKeyword or .assertKeyword or .caseKeyword           => true,
    .moveKeyword or .refKeyword or .outKeyword or .switchKeyword                  => true,
    _                                                                             => !lexer.isKeyword(kind),
}

/// Layout.cs: Piece.
bool layoutPiece(lexer.TokenKind kind) => kind switch {
    .interpolatedStringStart
        or .interpolatedStringText
        or .interpolationStart
        or .interpolationEnd
        or .interpolatedStringEnd => true,
    _ => false,
}

/// Layout.cs: OperandEnd.
bool layoutOperandEnd(lexer.TokenKind kind) => kind switch {
    .identifier or .integerLiteral or .floatLiteral or .numericSuffix or .charLiteral or .interpolatedStringEnd => true,
    .closeParen or .closeBracket or .thisKeyword or .nullKeyword or .trueKeyword or .falseKeyword => true,
    _ => lexer.isStringLiteral(kind) || parser.isContextualKeyword(kind),
}

/// Layout.cs: IsBinary.
bool layoutIsBinary(lexer.TokenKind kind) => kind switch {
    .fatArrow or .arrow or .equals or .equalsEquals or .bangEquals or .lessEquals or .greaterEquals => true,
    .questionQuestion or .questionQuestionEquals or .ampAmp or .barBar  => true,
    .slash or .percent or .plusPercent or .minusPercent or .starPercent => true,
    .plusBar or .minusBar or .starBar or .bar or .caret                 => true,
    .lessLess or .plusEquals or .minusEquals or .starEquals             => true,
    .slashEquals or .percentEquals or .ampEquals or .barEquals          => true,
    .caretEquals or .lessLessEquals                                     => true,
    _                                                                   => false,
}

/// The C# `decl.Span`.
lexer.TextSpan layoutDeclSpan(parser.Decl decl) => decl switch {
    .importDecl(let n)         => n.value.span,
    .globalStatement(let n)    => n.value.span,
    .functionDecl(let n)       => n.value.span,
    .structDecl(let n)         => n.value.span,
    .interfaceDecl(let n)      => n.value.span,
    .getterDecl(let n)         => n.value.span,
    .associatedTypeDecl(let n) => n.value.span,
    .extensionDecl(let n)      => n.value.span,
    .fieldDecl(let n)          => n.value.span,
    .propertyDecl(let n)       => n.value.span,
    .constructorDecl(let n)    => n.value.span,
    .errorEnumDecl(let n)      => n.value.span,
    .errorSetDecl(let n)       => n.value.span,
    .enumDecl(let n)           => n.value.span,
    .unionDecl(let n)          => n.value.span,
    .typeAliasDecl(let n)      => n.value.span,
    .effectDecl(let n)         => n.value.span,
    .testDecl(let n)           => n.value.span,
    .none                      => lexer.TextSpan.fromBounds(0, until: 0),
}

/// The C# `decl.GetType().Name`.
string layoutDeclType(parser.Decl decl) => decl switch {
    .importDecl(_)         => "ImportDecl",
    .globalStatement(_)    => "GlobalStatement",
    .functionDecl(_)       => "FunctionDecl",
    .structDecl(_)         => "StructDecl",
    .interfaceDecl(_)      => "InterfaceDecl",
    .getterDecl(_)         => "GetterDecl",
    .associatedTypeDecl(_) => "AssociatedTypeDecl",
    .extensionDecl(_)      => "ExtensionDecl",
    .fieldDecl(_)          => "FieldDecl",
    .propertyDecl(_)       => "PropertyDecl",
    .constructorDecl(_)    => "ConstructorDecl",
    .errorEnumDecl(_)      => "ErrorEnumDecl",
    .errorSetDecl(_)       => "ErrorSetDecl",
    .enumDecl(_)           => "EnumDecl",
    .unionDecl(_)          => "UnionDecl",
    .typeAliasDecl(_)      => "TypeAliasDecl",
    .effectDecl(_)         => "EffectDecl",
    .testDecl(_)           => "TestDecl",
    .none                  => "",
}

/// The C# `decl.Attributes`, as the spans the passes read.
List<LayoutAttribute> layoutAttributes(parser.Decl decl) uses alloc {
    switch decl {
        case .importDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .globalStatement(let n): return layoutAttributeSpans(n.value.attributes)
        case .functionDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .structDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .interfaceDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .getterDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .associatedTypeDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .extensionDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .fieldDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .propertyDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .constructorDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .errorEnumDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .errorSetDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .enumDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .unionDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .typeAliasDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .effectDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .testDecl(let n): return layoutAttributeSpans(n.value.attributes)
        case .none: return List<LayoutAttribute>()
    }
}

List<LayoutAttribute> layoutAttributeSpans(List<parser.AttributeSyntax> attributes) uses alloc {
    var result = List<LayoutAttribute>()
    for a in attributes {
        var hasBecause = false
        var becauseEnd: i64 = 0
        if (a.becauseKeyword is { } clause) {
            hasBecause = true
            becauseEnd = clause.span.end
        }
        result.append(LayoutAttribute {
            start: a.span.start,
            end: a.span.end,
            nameStart: a.name.start,
            nameEnd: a.name.end,
            hasBecause: hasBecause,
            becauseEnd: becauseEnd,
        })
    }
    return result
}

/// Layout.cs: Engine.Unformatted. The regions of `@unformatted because "…"` declarations (proposal §4.4), into `regions`.
void layoutUnformatted(List<parser.Decl> decls, from List<u8> bytes, to ref List<LayoutRegion> regions) uses alloc {
    for decl in decls {
        let span = layoutDeclSpan(decl)
        for a in layoutAttributes(decl) {
            if layoutBytesAre(bytes, from: a.nameStart, until: a.nameEnd, as: "unformatted") && a.hasBecause {
                regions.append(LayoutRegion { start: a.start, end: a.end > span.end ? a.end : span.end })
            }
        }
        switch decl {
            case .structDecl(let s): layoutUnformatted(s.value.members, from: bytes, to: ref regions)
            case .interfaceDecl(let n): layoutUnformatted(n.value.members, from: bytes, to: ref regions)
            case .extensionDecl(let e): layoutUnformatted(e.value.members, from: bytes, to: ref regions)
            default:
        }
    }
}

/// Layout.cs: Engine.OwnLineAttributes. A type or a function: the declarations whose attributes go on their own lines.
bool layoutOwnLineAttributes(parser.Decl decl) => decl switch {
    .structDecl(_) or .interfaceDecl(_) or .extensionDecl(_) or .enumDecl(_) or .unionDecl(_) => true,
    .errorEnumDecl(_)
        or .errorSetDecl(_)
        or .typeAliasDecl(_)
        or .functionDecl(_)
        or .constructorDecl(_)
        or .testDecl(_) => true,
    .importDecl(_)
        or .globalStatement(_)
        or .getterDecl(_)
        or .associatedTypeDecl(_)
        or .fieldDecl(_)
        or .propertyDecl(_) => false,
    .effectDecl(_) or .none => false,
}

/// Layout.cs: Engine.Group. `Modifiers.Static` is 4 (nodes.byn `modifierStatic`).
string layoutGroup(parser.Decl decl) {
    switch decl {
        case .fieldDecl(let f): return (f.value.modifiers & 4) != 0 ? "static" : "field"
        case .propertyDecl(let p): return (p.value.modifiers & 4) != 0 ? "static" : "property"
        case .functionDecl(let f): return (f.value.modifiers & 4) != 0 ? "static" : "method"
        case .getterDecl(_): return "property"
        case .constructorDecl(_): return "method"
        default: return layoutDeclType(decl)
    }
}

/// Layout.cs: Engine.
struct LayoutEngine {
    List<u8>          source
    List<lexer.Token> tokens
    List<LayoutGap>   gaps
    i64               bom
    LayoutOptions     options
    bool              spaceProducts
    lexer.Keywords    keywords
    List<bool>        lineStart
    List<i64>         levelOf
    List<bool>        frozen
    List<bool>        inHole
    List<bool>        needsBlank
    List<i64>         matchOf
    List<bool>        dropComma
    List<bool>        addComma
    List<i64>         pad
    List<i64>         commentPad
    List<bool>        tightAfter
    List<bool>        tightBefore
    List<i64>         enclosing
    List<bool>        headerArrow
    List<u8>          output

    /// Layout.cs: Engine.Render.
    List<u8> render(ref this, parser.CompilationUnit tree) uses alloc {
        for i in 0..tokens.length {
            lineStart[i] = i == 0 || gaps[i].hasNewline
        }
        freeze(tree.members)
        match()
        guide(tree.members)
        levels()
        joins()
        breaks()
        levels()
        topLevelBlanks(tree.members)
        memberBlanks(tree.members)
        if options.align == .runs {
            align(tree.members)
        }
        for b in 0..bom {
            output.append(source[b])
        }
        for i in 0..tokens.length {
            continue if dropComma[i]
            emitGap(i)
            for b in tokens[i].start..tokens[i].end {
                output.append(source[b])
            }
            if addComma[i] {
                output.append(0x2C)
            }
        }
        return output.copy()
    }

    /// Layout.cs: Engine.Kind.
    lexer.TokenKind kind(i64 i) {
        return tokens[i].kind if i >= 0 && i < tokens.length
        return .endOfFile
    }

    /// Layout.cs: Engine.Text, compared with `word`.
    bool textIs(i64 i, as string word) => layoutBytesAre(source, from: tokens[i].start, until: tokens[i].end, as: word)

    /// Layout.cs: Engine.Text.
    string text(i64 i) uses alloc {
        var bytes = List<u8>()
        for b in tokens[i].start..tokens[i].end {
            bytes.append(source[b])
        }
        return layoutString(bytes)
    }

    /// Layout.cs: Engine.Trivia.
    bool trivia(i64 i) => tokens[i].hasTriviaBefore

    /// Layout.cs: Engine.TokenAt. The first token starting at or after `offset`.
    i64 tokenAt(i64 offset) {
        var lo: i64 = 0
        var hi = tokens.length - 1
        while lo < hi {
            let mid = (lo + hi) / 2
            if tokens[mid].start < offset {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }

    // ── Frozen gaps: `@unformatted because "…"` declarations (proposal §4.4); a hole's line breaks ──

    /// Layout.cs: Engine.Freeze.
    void freeze(ref this, List<parser.Decl> members) uses alloc {
        var depth: i64 = 0
        for i in 0..tokens.length {
            if depth > 0 {
                inHole[i] = true
            }
            if tokens[i].kind == .interpolatedStringStart {
                depth += 1
            } else if tokens[i].kind == .interpolatedStringEnd && depth > 0 {
                depth -= 1
            }
        }
        var regions = List<LayoutRegion>()
        layoutUnformatted(members, from: source, to: ref regions)
        for r in regions {
            var i = tokenAt(r.start) + 1
            while i < tokens.length && tokens[i].end <= r.end {
                frozen[i] = true
                i += 1
            }
        }
    }

    // ── Indentation (pass 5) ─────────────────────────────────────────────────

    /// Layout.cs: Engine.OriginalIndent. The columns of the spaces and tabs that start the original line of token `i`; a tab is a level.
    i64 originalIndent(i64 i) {
        var at = tokens[i].start
        var n: i64 = 0
        while at > bom && (source[at - 1] == 0x20 || source[at - 1] == 0x09) {
            at -= 1
            n += source[at] == 0x09 ? options.indent : 1
        }
        return n
    }

    /// Layout.cs: Engine.Levels.
    void levels(ref this) uses alloc {
        var frames = List<LayoutFrame>()
        frames.append(LayoutFrame { opener: .endOfFile, line: -1 })
        var i: i64 = 0
        while i < tokens.length {
            var j = i + 1
            while j < tokens.length && !lineStart[j] {
                j += 1
            }
            let top = frames.length - 1
            let first = kind(i)
            var level: i64 = 0
            // A `{` that ends a header clause or a wrapped condition opens a body at the statement's level.
            var body: i64 = -1
            if first == .endOfFile {
                level = 0
            } else if first is .closeParen or .closeBracket or .closeBrace {
                level = frames[top].line > 0 ? frames[top].line : 0
                // `) {` closing a list opened on a clause or condition line opens that line's body.
                body = frames[top].body
            } else {
                let inGroup = frames[top].opener is .openParen or .openBracket
                let prev = kind(i - 1)
                var continues = false
                if i == 0 || prev == .openParen || prev == .openBracket || prev == .openBrace {
                    continues = false
                } else if prev == .comma {
                    // After `,` a line starts an entry, except in a top-level or clause list (`effect db = net,`, `uses net,`).
                    continues = !inGroup && (frames.length == 1 || frames[top].clause)
                } else if !inGroup && gaps[i].hasBlank {
                    continues = false
                } else {
                    // A line can start with a ternary's `?` or `:` only inside brackets, where it continues the entry.
                    continues = isWasl(i) || layoutAfterLa(prev) || first == .question || first == .colon
                }
                if !continues {
                    // A `case` body goes one level past its `case`.
                    level = frames[top].line + (frames[top].inSwitch && !(first is .caseKeyword or .defaultKeyword)
                        ? 2
                        : 1)
                    frames[top].statement = level
                    frames[top].statementIndent = originalIndent(i)
                    frames[top].control = first is .ifKeyword or .whileKeyword or .forKeyword or .unlessKeyword
                    frames[top].clause = false
                } else if (first == .requiresKeyword
                        || first == .catchKeyword
                        && prev == .closeBrace) && originalIndent(i) <= frames[top].statementIndent {
                    // A struct-level `requires` and a `catch` after `}` may sit at the statement's indentation (BYN5103 exempts them).
                    level = frames[top].statement
                } else {
                    let clause = isClause(i)
                    let wide = clause || frames[top].control || frames[top].clause
                    level = frames[top].statement + (wide ? 2 : 1)
                    if wide {
                        body = frames[top].statement
                    }
                    frames[top].clause = frames[top].clause || clause
                }
            }
            levelOf[i] = level
            for k in i..j {
                if layoutIsOpener(kind(k)) {
                    let line = kind(k) == .openBrace && body >= 0 ? body : level
                    // A group in a control header continues the header: its lines and its `{` keep the header's levels.
                    let outer = frames[frames.length - 1]
                    let header = kind(k) == .openParen && outer.control && !callLike(k - 1)
                    frames.append(LayoutFrame {
                        opener: kind(k),
                        line: line,
                        statement: header ? outer.statement : line,
                        statementIndent: originalIndent(i),
                        body: body,
                        control: header,
                        inSwitch: kind(k) == .openBrace
                            && (kind(k + 1) == .caseKeyword || kind(k + 1) == .defaultKeyword),
                    })
                } else if layoutIsCloser(kind(k)) {
                    if frames.length > 1 {
                        frames.remove(at: frames.length - 1)
                    }
                }
            }
            i = j
        }
    }

    /// Layout.cs: Engine.IsWasl. A token that joins the line it starts to the line before (waṣl), as the parser reads it.
    bool isWasl(i64 i) {
        let k = kind(i)
        return k == .dot
            || k == .questionDot
            || k == .questionQuestion
            || k == .ampAmp
            || k == .barBar
            || k == .andKeyword
            || k == .orKeyword
            || k == .catchKeyword
            || k == .exceptKeyword
            || k == .requiresKeyword
            || k == .failsKeyword
            || k == .usesKeyword || isClause(i)
    }

    /// Layout.cs: Engine.IsClause. A header clause keyword: `where`, `expects`, `uses`, `becomes` or `fails`.
    bool isClause(i64 i) {
        let k = kind(i)
        return true if k is .failsKeyword or .usesKeyword
        return false if k != .identifier
        return kind(i + 1) == .identifier && kind(i + 2) == .colon if textIs(i, as: "where")
        return kind(i + 1) == .dot if textIs(i, as: "becomes")
        if textIs(i, as: "expects") {
            let next = kind(i + 1)
            return next is .identifier or .bang or .notKeyword or .thisKeyword
        }
        return false
    }

    // ── Joins (pass 3) and breaks (pass 4): lists, chains, header clauses, conditions (proposal §3.4–§3.6) ──

    /// Layout.cs: Engine.Match.
    void match(ref this) uses alloc {
        var open = List<i64>()
        for i in 0..tokens.length {
            matchOf[i] = -1
            if layoutIsCloser(kind(i)) && open.length > 0 {
                let o = open[open.length - 1]
                open.remove(at: open.length - 1)
                matchOf[o] = i
                matchOf[i] = o
            }
            enclosing[i] = open.length > 0 ? open[open.length - 1] : -1
            if layoutIsOpener(kind(i)) {
                open.append(i)
            }
        }
    }

    /// Layout.cs: Engine.IsIndex. Whether the `[` at `o` is an index (`xs[i]`, `u8[4]`), not a list literal.
    bool isIndex(i64 o) => kind(o) == .openBracket && o > 0 && layoutOperandEnd(kind(o - 1))

    /// Layout.cs: Engine.Columns. The columns token `i` takes: its UTF-8 lead bytes.
    i64 columns(i64 i) {
        var n: i64 = 0
        for b in tokens[i].start..tokens[i].end {
            if (source[b] & 0xC0) != 0x80 {
                n += 1
            }
        }
        return n
    }

    /// Layout.cs: Engine.Multiline.
    bool multiline(i64 i) {
        for b in tokens[i].start..tokens[i].end {
            return true if source[b] == 0x0A
        }
        return false
    }

    /// Layout.cs: Engine.LineStartOf.
    i64 lineStartOf(i64 i) {
        var k = i
        while k > 0 && !lineStart[k] {
            k -= 1
        }
        return k
    }

    /// Layout.cs: Engine.LineEnd. The first token after `i` that starts a line, or the end of the file.
    i64 lineEnd(i64 i) {
        var k = i + 1
        while k < tokens.length - 1 {
            return k if lineStart[k]
            k += 1
        }
        return tokens.length - 1
    }

    /// Layout.cs: Engine.Width. The columns of tokens `[s, e)` written as one line from line start `s`; 0 when a token spans lines.
    i64 width(i64 s, until i64 e) uses alloc {
        var width = levelOf[s] * options.indent
        for k in s..e {
            continue if dropComma[k]
            return 0 if multiline(k)
            if k > s && space(k, from: tokens[k - 1].end) {
                width += 1
            }
            width += columns(k) + (addComma[k] ? 1 : 0)
        }
        return width
    }

    /// Layout.cs: Engine.Editable. Whether the structure over tokens `[start, end]` may change: none is frozen and it is not in an
    /// interpolation hole.
    bool editable(i64 start, through i64 end) {
        return false if inHole[start]
        for k in start..end + 1 {
            return false if frozen[k]
        }
        return true
    }

    /// Layout.cs: Engine.Items. The tokens directly inside the list `(o, c)`, stepping over nested brackets.
    List<i64> items(i64 o, until i64 c) uses alloc {
        var result = List<i64>()
        var k = o + 1
        while k < c {
            result.append(k)
            if layoutIsOpener(kind(k)) && matchOf[k] > k {
                k = matchOf[k]
            }
            k += 1
        }
        return result
    }

    /// Layout.cs: Engine.TrailingComma.
    bool trailingComma(i64 c) => kind(c - 1) == .comma && !dropComma[c - 1]

    /// Layout.cs: Engine.IsStructLiteral. A `{` that opens a struct literal or a `with` update: a type name or `with`, then `name:`.
    bool isStructLiteral(i64 o) {
        return false if kind(o) != .openBrace || matchOf[o] <= o
        let prev = kind(o - 1)
        return (prev is .identifier or .greater or .withKeyword) && kind(o + 1) == .identifier && kind(o + 2) == .colon
    }

    /// Layout.cs: Engine.CommaSafe. Whether the parser takes a trailing comma in the list `(o, c)`: an argument list, a `[ ]` literal or
    /// a struct literal. A parameter list (BYN1003), a lambda's, an index and a group do not.
    bool commaSafe(i64 o, until i64 c) uses alloc {
        let k = kind(o)
        return isStructLiteral(o) if k == .openBrace
        return lineStart[o] || !layoutOperandEnd(kind(o - 1)) if k == .openBracket
        return false if k != .openParen
        let name = o - 1
        return false if lineStart[o]
            || !(kind(name) == .identifier || parser.isContextualKeyword(kind(name)))
            || !callLike(name)
        let after = kind(c + 1)
        return false if after == .openBrace
            || after == .fatArrow
            || after == .arrow
            || after == .requiresKeyword
            || isClause(c + 1)
        return false if inPattern(o)
        // A spaced `?` is a ternary's; `T? name(` declares.
        return lineStart[name]
            || layoutExpressionBefore(kind(name - 1))
            || kind(name - 1) == .question && trivia(name - 1)
    }

    /// Layout.cs: Engine.InPattern. Whether the `(` at `o` holds a pattern (`case .some(let x)`, `is .pair(a, b)`).
    bool inPattern(i64 o) uses alloc {
        for k in items(o, until: matchOf[o]) {
            return true if (kind(k - 1) == .openParen && k - 1 == o
                || kind(k - 1) == .comma) && (kind(k) == .letKeyword || kind(k) == .varKeyword)
        }
        var k = o - 1
        while k >= 0 {
            let at = kind(k)
            if layoutIsCloser(at) && matchOf[k] >= 0 && matchOf[k] < k {
                k = matchOf[k]
            } else if layoutIsOpener(at)
                    || at == .comma
                    || at == .colon
                    || at == .equals
                    || at == .fatArrow
                    || at == .identifier && textIs(k, as: "where") {
                return false
            } else if at is .caseKeyword or .isKeyword or .exceptKeyword {
                return true
            }
            return false if lineStart[k]
            k -= 1
        }
        return false
    }

    /// Whether the gap before token `k` holds a comment.
    bool hasComment(i64 k) {
        for x in gaps[k].items {
            return true if x.isComment
        }
        return false
    }

    /// Layout.cs: Engine.Joins. Pass 3. A `( )` or `[ ]` list broken over lines joins when it fits, holds no comment, block or author's
    /// trailing comma (under `.multiline`). A chain broken only before its links joins when it fits and has fewer than three lambda calls.
    /// Under `.never` every trailing comma the parser can do without goes first.
    void joins(ref this) uses alloc {
        if options.trailingCommas != .multiline {
            for c in 1..tokens.length {
                if layoutIsCloser(kind(c)) && matchOf[c] >= 0 && kind(c - 1) == .comma && gaps[c - 1].items.length == 0
                        && commaSafe(matchOf[c], until: c) && editable(c - 1, through: c) {
                    dropComma[c - 1] = true
                }
            }
        }
        // A group breaks only before its own operators: the author's break after its `(` or before its `)` goes.
        for g in 1..tokens.length {
            continue if kind(g) != .openParen
                || matchOf[g] <= g + 1
                || callLike(g - 1)
                || kind(g - 1) == .greater
                || inPattern(g)
            let c = matchOf[g]
            var comma = false
            for k in items(g, until: c) {
                if kind(k) == .comma {
                    comma = true
                }
            }
            continue if comma
            if lineStart[g + 1] && !hasComment(g + 1) && editable(g + 1, through: g + 1) {
                lineStart[g + 1] = false
            }
            if lineStart[c] && !hasComment(c) && editable(c, through: c) {
                lineStart[c] = false
            }
        }
        var o: i64 = 0
        while o < tokens.length {
            if (kind(o) == .openParen || kind(o) == .openBracket) && matchOf[o] >= o {
                let c = matchOf[o]
                if joinable(o, until: c) {
                    var breaks = List<i64>()
                    for k in o + 1..c + 1 {
                        breaks.append(k)
                    }
                    if tryJoin(o, through: c, for: breaks) {
                        o = c
                    } else {
                        // A header with a `=>` body breaks after the `=>` before its parameters wrap.
                        let arrow = headerArrowAfter(c)
                        if arrow > 0 && !lineStart[arrow + 1] && editable(arrow + 1, through: arrow + 1) {
                            lineStart[arrow + 1] = true
                            if tryJoin(o, through: c, for: breaks) {
                                o = c
                            } else {
                                lineStart[arrow + 1] = false
                            }
                        }
                    }
                }
            }
            o += 1
        }
        let all = chains()
        for chain in all {
            var broken = false
            for d in chain.dots {
                if lineStart[d] {
                    broken = true
                }
            }
            continue if chain.lambdaCalls >= 3 || !broken || !editable(chain.start, through: chain.end)
            var only = true
            var k = chain.start + 1
            while k <= chain.end && only {
                if lineStart[k] {
                    var isDot = false
                    for d in chain.dots {
                        if d == k {
                            isDot = true
                        }
                    }
                    if !isDot || hasComment(k) {
                        only = false
                    }
                }
                k += 1
            }
            continue if !only
            // A chain in a ternary that has not broken joins: the ternary breaks first.
            if inUnbrokenTernary(chain.start) {
                for d in chain.dots {
                    lineStart[d] = false
                }
            } else {
                let _ = tryJoin(chain.start, through: chain.end, for: chain.dots)
            }
        }
    }

    /// Layout.cs: Engine.HeaderArrow. The header `=>` on the line after the parameter list closed at `c`, or -1.
    i64 headerArrowAfter(i64 c) {
        var k = c + 1
        while k < tokens.length && !lineStart[k] {
            return k if headerArrow[k]
            if layoutIsOpener(kind(k)) && matchOf[k] > k {
                k = matchOf[k]
            }
            k += 1
        }
        return -1
    }

    /// Layout.cs: Engine.InUnbrokenTernary. Whether token `i` is in an operand of a ternary inside `( )` or `[ ]` whose `?` has not
    /// broken.
    bool inUnbrokenTernary(i64 i) {
        let o = enclosing[i]
        return false if o < 0 || !(kind(o) == .openParen || kind(o) == .openBracket)
        var k = i - 1
        while k > o {
            if layoutIsCloser(kind(k)) && matchOf[k] >= 0 && matchOf[k] < k {
                k = matchOf[k]
            } else if kind(k) == .comma {
                return false
            } else if kind(k) == .question && trivia(k) {
                return !lineStart[k]
            }
            k -= 1
        }
        return false
    }

    /// Layout.cs: Engine.Joinable.
    bool joinable(i64 o, until i64 c) {
        var broken = false
        for k in o + 1..c + 1 {
            broken = broken || lineStart[k]
            if hasComment(k)
                    || frozen[k]
                    || inHole[k] && lineStart[k]
                    || multiline(k)
                    || kind(k) == .openBrace
                    || kind(k) == .closeBrace
                    || kind(k) == .comma
                    && (kind(k + 1) == .closeParen || kind(k + 1) == .closeBracket)
                    && !dropComma[k] {
                return false
            }
        }
        return broken && !frozen[o]
    }

    /// Layout.cs: Engine.TryJoin. Clears the line breaks before `breaks` when the line holding tokens `[start, end]` then fits.
    bool tryJoin(ref this, i64 start, through i64 end, for List<i64> breaks) uses alloc {
        var cleared = List<i64>()
        for k in breaks {
            if lineStart[k] {
                cleared.append(k)
            }
        }
        for k in cleared {
            lineStart[k] = false
        }
        let s = lineStartOf(start)
        return true if width(s, until: lineEnd(end)) <= options.width
        for k in cleared {
            lineStart[k] = true
        }
        return false
    }

    /// Layout.cs: Engine.IsLink. A `.` or `?.` and a name: a link of a member chain.
    bool isLink(i64 j) =>
        (kind(j) == .dot || kind(j) == .questionDot)
        && (kind(j + 1) == .identifier || parser.isContextualKeyword(kind(j + 1)))

    /// Layout.cs: Engine.ArmLine. Whether the line from link `j` holds a `=>` outside brackets: a switch arm, not a link.
    bool armLine(i64 j) {
        var depth: i64 = 0
        var k = j
        while k < tokens.length - 1 && (k == j || !lineStart[k]) {
            if layoutIsOpener(kind(k)) {
                depth += 1
            } else if layoutIsCloser(kind(k)) {
                depth -= 1
            } else if depth == 0 && kind(k) == .fatArrow {
                return true
            }
            k += 1
        }
        return false
    }

    /// Layout.cs: Engine.Chains. The member chains with two or more calls (`orders.where(…).take(50)`); a nested chain is its own.
    List<LayoutChain> chains() uses alloc {
        var result = List<LayoutChain>()
        var used = List<bool>()
        for i in 0..tokens.length {
            used.append(false)
        }
        for i in 1..tokens.length {
            continue if used[i] || !isLink(i) || lineStart[i] && (gaps[i].hasBlank || armLine(i))
            let prev = kind(i - 1)
            if !(prev == .identifier || prev == .closeParen || prev == .closeBracket || prev == .thisKeyword || prev == .interpolatedStringEnd
                    || lexer.isStringLiteral(prev) || parser.isContextualKeyword(prev)) {
                continue
            }
            var start = i - 1
            if layoutIsCloser(kind(start)) && matchOf[start] >= 0 {
                start = matchOf[start]
                if kind(start) != .interpolationStart && !lineStart[start]
                        && (kind(start - 1) == .identifier || parser.isContextualKeyword(kind(start - 1))) {
                    start -= 1
                }
            }
            var dots = List<i64>()
            var breakable = List<i64>()
            var calls: i64 = 0
            var lambdas: i64 = 0
            var end = i
            var j = i
            while isLink(j) && (j == i || !lineStart[j] || !gaps[j].hasBlank && !armLine(j)) {
                used[j] = true
                dots.append(j)
                var k = j + 2
                var call = false
                while (kind(k) == .openParen || kind(k) == .openBracket) && !lineStart[k] && matchOf[k] > k {
                    if kind(k) == .openParen && k == j + 2 {
                        call = true
                        if hasLambda(k, until: matchOf[k]) {
                            lambdas += 1
                        }
                    }
                    k = matchOf[k] + 1
                }
                if call {
                    calls += 1
                }
                // A `.member` after an index stays on its line (`c.items[i].payload`).
                if (call || breakable.length > 0) && kind(j - 1) != .closeBracket {
                    breakable.append(j)
                }
                end = k - 1
                j = k
            }
            if calls >= 2 {
                result.append(
                    LayoutChain {
                        start: start,
                        end: end,
                        dots: move dots,
                        breakable: move breakable,
                        lambdaCalls: lambdas,
                    },
                )
            }
        }
        return result
    }

    /// Layout.cs: Engine.HasLambda. Whether the arguments `(o, c)` hold a lambda: a `=>` or an implicit `it`.
    bool hasLambda(i64 o, until i64 c) {
        for k in o + 1..c {
            return true if kind(k) == .fatArrow || kind(k) == .identifier && textIs(k, as: "it")
        }
        return false
    }

    /// Layout.cs: Engine.Breaks. Pass 4. A chain with three or more lambda calls, or with one link already broken, breaks every link.
    /// A list broken over lines, or ending in the author's trailing comma, takes one item per line. Then each line past `width` breaks its
    /// condition, its header clauses, or its outermost chain or list, until every line fits or nothing is left to break.
    void breaks(ref this) uses alloc {
        let all = chains()
        for chain in all {
            var broken = false
            for d in chain.breakable {
                if lineStart[d] {
                    broken = true
                }
            }
            if (chain.lambdaCalls >= 3 || broken) && editable(chain.start, through: chain.end) {
                for d in chain.breakable {
                    lineStart[d] = true
                }
            }
        }
        for o in 0..tokens.length {
            continue if !(kind(o) == .openParen || kind(o) == .openBracket) || matchOf[o] < o
            let c = matchOf[o]
            let inner = items(o, until: c)
            var comma = false
            var started = false
            for k in inner {
                if kind(k) == .comma {
                    comma = true
                }
                if lineStart[k] {
                    started = true
                }
            }
            continue if !editable(o, through: c) || isIndex(o) || !comma
            if lineStart[c] || trailingComma(c) || started {
                breakList(o, until: c)
            }
        }
        for round in 0..tokens.length {
            levels()
            let lineChains = chains()
            var changed = false
            var s: i64 = 0
            while s < tokens.length - 1 {
                let e = lineEnd(s)
                if !frozen[s]
                        && !inHole[s]
                        && width(s, until: e) > options.width
                        && breakLine(s, until: e, for: lineChains) {
                    changed = true
                }
                s = e
            }
            break if !changed
        }
    }

    /// Layout.cs: Engine.BreakList. One item per line: a break after the opener and after each item, and the trailing comma the knob asks for.
    void breakList(ref this, i64 o, until i64 c) uses alloc {
        if o + 1 < c {
            lineStart[o + 1] = true
        }
        var starts = List<i64>()
        for k in items(o, until: c) {
            if (k == o + 1 || kind(k - 1) == .comma) && k < c {
                starts.append(k)
            }
        }
        var widths = List<i64>()
        let row = scalars(o, until: c, at: starts, to: ref widths) ? rowOf(o, at: starts, by: widths) : 1
        for n in 1..starts.length {
            lineStart[starts[n]] = n % row == 0
        }
        lineStart[c] = true
        if options.trailingCommas == .multiline && kind(c - 1) != .comma && o + 1 < c && commaSafe(o, until: c) {
            addComma[c - 1] = true
        }
    }

    /// Layout.cs: Engine.Scalars. Whether every item of the list literal `[o, c]` is a scalar (a number, a char, or a string of at most 16
    /// columns, signed or not) and no comment is inside; the columns of each item into `widths` when so (the C# null is false).
    bool scalars(i64 o, until i64 c, at List<i64> starts, to ref List<i64> widths) uses alloc {
        return false if kind(o) != .openBracket || isIndex(o) || starts.length < 2
        for k in o + 1..c + 1 {
            return false if hasComment(k)
        }
        for n in 0..starts.length {
            var k = starts[n]
            if kind(k) == .minus || kind(k) == .plus {
                k += 1
            }
            if !(kind(k) == .integerLiteral || kind(k) == .floatLiteral || kind(k) == .charLiteral
                    || kind(k) == .stringLiteral && !multiline(k) && columns(k) <= 16) {
                return false
            }
            if kind(k + 1) == .numericSuffix {
                k += 1
            }
            return false if !(kind(k + 1) == .comma || kind(k + 1) == .closeBracket)
            widths.append(width(starts[n], until: k + 1) - levelOf[starts[n]] * options.indent)
        }
        return true
    }

    /// Layout.cs: Engine.Row. The items per row of a broken scalar list: as many as the author's first row holds when rows of that many
    /// fit, otherwise the most that fit in every row (at least one).
    i64 rowOf(i64 o, at List<i64> starts, by List<i64> widths) {
        let indent = (levelOf[lineStartOf(o)] + 1) * options.indent
        var first: i64 = 1
        while first < starts.length && !gaps[starts[first]].hasNewline {
            first += 1
        }
        return first if rowFits(first, by: widths, at: indent)
        var n = (first < starts.length ? first : starts.length) - 1
        while n > 1 {
            return n if rowFits(n, by: widths, at: indent)
            n -= 1
        }
        return 1
    }

    /// Layout.cs: Engine.Row (its local `Fits`). Whether rows of `n` items fit in `width`.
    bool rowFits(i64 n, by List<i64> widths, at i64 indent) {
        var at: i64 = 0
        while at < widths.length {
            var width = indent + 1
            let end = widths.length < at + n ? widths.length : at + n
            for m in at..end {
                width += widths[m] + (m > at ? 2 : 0)
            }
            return false if width > options.width
            at += n
        }
        return true
    }

    /// Layout.cs: Engine.BreakLine. Breaks the over-wide line `[s, e)` at its widest structure; false when it has none.
    bool breakLine(ref this, i64 s, until i64 e, for List<LayoutChain> lineChains) uses alloc {
        var changed = false
        // A one-line body opens: `{` ends the line and `}` starts one.
        var p = kind(s) == .closeBrace && kind(s + 1) == .elseKeyword ? s + 1 : s
        let head = kind(p)
        if head is .ifKeyword or .whileKeyword or .unlessKeyword or .forKeyword or .elseKeyword {
            var k = p + 1
            var depth: i64 = 0
            while k < e {
                if layoutIsCloser(kind(k)) {
                    depth -= 1
                }
                if depth == 0 && kind(k) == .openBrace {
                    let c = matchOf[k]
                    if c > k + 1 && c < e && editable(k + 1, through: c) {
                        lineStart[k + 1] = true
                        lineStart[c] = true
                        return true
                    }
                    break
                }
                if layoutIsOpener(kind(k)) {
                    depth += 1
                }
                k += 1
            }
        }
        // A header with a `=>` body breaks after the `=>` first; its parameters wrap only if the header still does not fit.
        for k in s..e - 1 {
            if headerArrow[k] && !lineStart[k + 1] && editable(k + 1, through: k + 1) {
                lineStart[k + 1] = true
                return true
            }
        }
        // Header clauses after the `)` go one per line when the head before them fits.
        var clauseDepth: i64 = 0
        var closed = false
        var firstClause: i64 = -1
        for k in s..e {
            if layoutIsCloser(kind(k)) {
                clauseDepth -= 1
            }
            if clauseDepth == 0 && kind(k) == .closeParen {
                closed = true
            } else if clauseDepth == 0 && closed && k > s && isClause(k) {
                if firstClause < 0 {
                    break if width(s, until: k) > options.width
                    firstClause = k
                }
                if !lineStart[k] && editable(k, through: k) {
                    lineStart[k] = true
                    changed = true
                }
            }
            if layoutIsOpener(kind(k)) {
                clauseDepth += 1
            }
        }
        return true if changed
        // An expression breaks before each operator of its lowest level outside brackets, then inside the widest group.
        if kind(p) == .elseKeyword {
            p += 1
        }
        let control = p < e && (kind(p) == .ifKeyword || kind(p) == .whileKeyword || kind(p) == .unlessKeyword)
        var ops = lowestOperators(s, from: p, until: e)
        if ops.length == 0 {
            var widest: i64 = 0
            var depth: i64 = 0
            for k in s..e {
                if layoutIsCloser(kind(k)) {
                    depth = depth > 0 ? depth - 1 : 0
                }
                if depth == 0
                        && kind(k) == .openParen
                        && matchOf[k] > k + 1
                        && matchOf[k] < e
                        && (k == s || !callLike(k - 1))
                        && tokens[matchOf[k]].end - tokens[k].start > widest {
                    let inner = lowestOperators(k, from: k + 1, until: matchOf[k])
                    if inner.length > 0 {
                        widest = tokens[matchOf[k]].end - tokens[k].start
                        ops = inner.copy()
                    }
                }
                if layoutIsOpener(kind(k)) {
                    depth += 1
                }
            }
        }
        if ops.length > 0 {
            for k in ops {
                lineStart[k] = true
            }
            return true
        }
        // Otherwise the outermost chain or list on the line: a chain before a list at the same depth, then the leftmost.
        // A chain in a ternary that has not broken stays whole, and nothing breaks inside an index. A control head's
        // `(` never opens: a line after its `)` would end the condition (BYN1017).
        var depths = List<i64>()
        var ternary = List<bool>()
        var d: i64 = 0
        var q: i64 = -1
        for k in s..e {
            if layoutIsCloser(kind(k)) {
                d -= 1
            }
            if q >= 0 && (d < depths[q - s] || d == depths[q - s] && kind(k) == .comma) {
                q = -1
            }
            depths.append(d)
            if q < 0 && k > s && kind(k) == .question && trivia(k) {
                q = k
            }
            ternary.append(q >= 0 && d == depths[q - s])
            if layoutIsOpener(kind(k)) {
                d += 1
            }
        }
        var bestChain: i64 = -1
        var best: i64 = 2147483647
        for ci in 0..lineChains.length {
            let count = lineChains[ci].breakable.length
            continue if count == 0 || lineChains[ci].breakable[0] < s || lineChains[ci].breakable[count - 1] >= e
            var broken = false
            for b in lineChains[ci].breakable {
                if lineStart[b] {
                    broken = true
                }
            }
            continue if broken || !editable(lineChains[ci].start, through: lineChains[ci].end)
            continue if ternary[lineChains[ci].breakable[0] - s]
            if depths[lineChains[ci].breakable[0] - s] < best {
                best = depths[lineChains[ci].breakable[0] - s]
                bestChain = ci
            }
        }
        var bestList: i64 = -1
        for o in s..e {
            continue if !(kind(o) == .openParen || kind(o) == .openBracket || isStructLiteral(o))
                || isIndex(o)
                || control && o == p + 1
            let c = matchOf[o]
            continue if c <= o + 1
                || c >= e
                || depths[o - s] >= best
                || !editable(o, through: c)
                || kind(o) == .openParen && inPattern(o)
            // A group around one operand followed by a member (`(move parsed).trust()`) is an atom, as `xs[i].member` is.
            if kind(o) == .openParen
                    && (o == s || !callLike(o - 1))
                    && (kind(c + 1) == .dot || kind(c + 1) == .questionDot) {
                var comma = false
                for k in items(o, until: c) {
                    if kind(k) == .comma {
                        comma = true
                    }
                }
                continue if !comma
            }
            best = depths[o - s]
            bestList = o
            bestChain = -1
        }
        if bestChain >= 0 {
            for b in lineChains[bestChain].breakable {
                lineStart[b] = true
            }
            return true
        }
        return false if bestList < 0
        breakList(bestList, until: matchOf[bestList])
        return true
    }

    /// Layout.cs: Engine.LowestOperators. The operators of the lowest level in tokens `[from, e)` outside brackets that a line may
    /// start with, before any header clause: a ternary's `?` and `:` inside `( )` or a list's `[ ]` (at a statement's level a line
    /// starting with `?` ends the statement), then `??`, `||`, `&&` and their words outside an index.
    List<i64> lowestOperators(i64 s, from i64 start, until i64 e) uses alloc {
        var found = List<i64>()
        var levels = List<i64>()
        var ternaries: i64 = 0
        var depth: i64 = 0
        for k in start..e {
            if layoutIsCloser(kind(k)) {
                depth = depth > 0 ? depth - 1 : 0
            }
            if depth == 0 {
                break if k > s && isClause(k)
                let t = kind(k)
                var level: i64 = -1
                if t == .question && trivia(k) {
                    level = 0
                } else if t == .colon && ternaries > 0 {
                    level = 0
                } else if t == .questionQuestion {
                    level = 1
                } else if t is .barBar or .orKeyword {
                    level = 2
                } else if t is .ampAmp or .andKeyword {
                    level = 3
                }
                if t == .question && level == 0 {
                    ternaries += 1
                } else if t == .colon && level == 0 {
                    ternaries -= 1
                }
                let o = enclosing[k]
                // `if (a) ⏎ && b` would read `(a)` as the whole condition (BYN1017), on any line of the header.
                let afterHead = kind(k - 1) == .closeParen && matchOf[k - 1] > 0
                    && (kind(matchOf[k - 1] - 1) == .ifKeyword
                        || kind(matchOf[k - 1] - 1) == .whileKeyword
                        || kind(matchOf[k - 1] - 1) == .unlessKeyword)
                if level >= 0 && !lineStart[k] && editable(k, through: k) && !(o >= 0 && isIndex(o))
                        && (level > 0 || o >= 0 && (kind(o) == .openParen || kind(o) == .openBracket)) && !afterHead {
                    found.append(k)
                    levels.append(level)
                }
            }
            if layoutIsOpener(kind(k)) {
                depth += 1
            }
        }
        var lowest: i64 = 4
        for l in levels {
            if l < lowest {
                lowest = l
            }
        }
        var result = List<i64>()
        for n in 0..found.length {
            if levels[n] == lowest {
                result.append(found[n])
            }
        }
        return result
    }

    // ── Blank lines between top-level declarations (pass 7, proposal §3.7) ───

    /// Layout.cs: Engine.TopLevelBlanks.
    void topLevelBlanks(ref this, List<parser.Decl> members) uses alloc {
        for d in 1..members.length {
            continue if members[d - 1] is .globalStatement(_) || members[d] is .globalStatement(_)
            let a = layoutDeclSpan(members[d - 1])
            let b = layoutDeclSpan(members[d])
            let next = tokenAt(a.end)
            continue if next >= tokens.length - 1 || !gaps[next].hasNewline
            let nextEnd = d + 1 < members.length ? tokenAt(layoutDeclSpan(members[d + 1]).start) : tokens.length - 1
            let bEnd = tokenAt(b.end)
            let until = nextEnd < bEnd ? nextEnd : bEnd
            if oneLine(tokenAt(a.start), until: next) && oneLine(next, until: next + 1 > until ? next + 1 : until)
                    && layoutDeclType(members[d - 1]) == layoutDeclType(members[d])
                    && leadingKeywords(tokenAt(a.start)) == leadingKeywords(next) {
                continue
            }
            needsBlank[next] = true
        }
    }

    /// Layout.cs: Engine.OneLine. Whether tokens `[start, end)` lie on one line.
    bool oneLine(i64 start, until i64 end) {
        for i in start + 1..end {
            return false if lineStart[i]
        }
        return true
    }

    /// Layout.cs: Engine.LeadingKeywords.
    string leadingKeywords(i64 i) uses alloc {
        var words = StrBuf()
        var k = i
        while k < tokens.length && lexer.isKeyword(kind(k)) {
            if k > i {
                words.append(" ")
            }
            words.append(text(k))
            k += 1
        }
        return $"{words.finish()}"
    }

    // ── The guide's attributes, blocks, generics and member groups (docs/bayan-style.md, proposal §3.2) ──

    /// Layout.cs: Engine.Guide. An attribute before a type or function goes on its own line above it; one before a field or parameter
    /// stays inline. A statement block written on one line takes one statement per line, `{` ending the line and `}` starting one; a `=>`
    /// body and a block inside an expression (a lambda's) stay as written. The `<` and `>` of a generic list take no space inside.
    void guide(ref this, List<parser.Decl> members) uses alloc {
        guideDecls(members)
        for o in 1..tokens.length {
            let close = genericClose(o)
            if close > 0 {
                tightAfter[o] = true
                tightBefore[close] = true
            }
        }
    }

    /// Layout.cs: Engine.Guide over Layout.cs: Engine.Decls and Layout.cs: Engine.Blocks(Decl).
    void guideDecls(ref this, List<parser.Decl> decls) uses alloc {
        for decl in decls {
            let attributes = layoutAttributes(decl)
            if attributes.length > 0 && layoutOwnLineAttributes(decl) {
                let last = attributes[attributes.length - 1]
                let head = tokenAt(last.end > last.becauseEnd ? last.end : last.becauseEnd)
                if editable(tokenAt(attributes[0].start), through: head) {
                    for k in 1..attributes.length {
                        lineStart[tokenAt(attributes[k].start)] = true
                    }
                    lineStart[head] = true
                }
            }
            switch decl {
                case .functionDecl(let f):
                    unless f.value.expressionBody is .none {
                        let arrow = tokenAt(parser.exprSpan(in f.value.expressionBody).start) - 1
                        if arrow > 0 && kind(arrow) == .fatArrow {
                            headerArrow[arrow] = true
                        }
                    }
                    guideStmt(f.value.body)
                case .constructorDecl(let c): guideStmt(c.value.body)
                case .testDecl(let t): guideStmt(t.value.body)
                case .propertyDecl(let p): guideStmt(p.value.block)
                case .globalStatement(let g): guideStmt(g.value.statement)
                case .structDecl(let s): guideDecls(s.value.members)
                case .interfaceDecl(let n): guideDecls(n.value.members)
                case .extensionDecl(let x): guideDecls(x.value.members)
                default:
            }
        }
    }

    /// Layout.cs: Engine.Guide over Layout.cs: Engine.Blocks(Stmt): the statement blocks nested in `stmt`'s statements, not in expressions.
    void guideStmt(ref this, parser.Stmt stmt) uses alloc {
        switch stmt {
            case .blockStmt(let b):
                let o = tokenAt(b.value.span.start)
                // An empty arm stays on its label's line: `default: {}`.
                if b.value.statements.length == 0
                        && kind(o) == .openBrace
                        && kind(o - 1) == .colon
                        && matchOf[o] == o + 1
                        && !hasComment(o)
                        && gaps[o + 1].items.length == 0 && editable(o, through: o + 1) {
                    lineStart[o] = false
                }
                if b.value.statements.length > 0
                        && kind(o) == .openBrace
                        && matchOf[o] >= o
                        && editable(o, through: matchOf[o]) {
                    for s in b.value.statements {
                        lineStart[tokenAt(parser.stmtSpan(in s).start)] = true
                    }
                    lineStart[matchOf[o]] = true
                }
                for s in b.value.statements {
                    guideStmt(s)
                }
            case .ifStmt(let s):
                guideStmt(s.value.then)
                guideStmt(s.value.elseKeyword)
            case .unlessStmt(let s): guideStmt(s.value.body)
            case .guardedStmt(let s): guideStmt(s.value.statement)
            case .whileStmt(let s): guideStmt(s.value.body)
            case .doWhileStmt(let s): guideStmt(s.value.body)
            case .whileLetStmt(let s): guideStmt(s.value.body)
            case .forStmt(let s): guideStmt(s.value.body)
            case .labeledStmt(let s): guideStmt(s.value.statement)
            case .switchStmt(let s):
                for section in s.value.sections {
                    for x in section.statements {
                        guideStmt(x)
                    }
                }
            case .deferStmt(let s): guideStmt(s.value.body)
            case .contextStmt(let s): guideStmt(s.value.body)
            default:
        }
    }

    /// Layout.cs: Engine.GenericClose. The `>` closing a generic list opened by the `<` at `o`, or −1: a `<` right after a name, then on
    /// one line only tokens a type is made of, up to its `>`.
    i64 genericClose(i64 o) {
        return -1 if kind(o) != .less
            || trivia(o)
            || !(kind(o - 1) == .identifier || parser.isContextualKeyword(kind(o - 1)))
        var depth: i64 = 1
        var k = o + 1
        while k < tokens.length && !lineStart[k] {
            let at = kind(k)
            if at == .less {
                depth += 1
            } else if at == .greater {
                depth -= 1
                return k if depth == 0
            } else if !(at == .identifier || at == .comma || at == .dot || at == .question || at == .star || at == .openBracket
                    || at == .closeBracket
                    || at == .openParen
                    || at == .closeParen
                    || at == .integerLiteral
                    || at == .arrow
                    || parser.isContextualKeyword(at)) {
                return -1
            }
            k += 1
        }
        return -1
    }

    /// Layout.cs: Engine.MemberBlanks. Inside a type body, one blank line between member groups (fields, `states`, properties, static
    /// members, methods) and between two methods. A function body's statements are not members, so none goes there.
    void memberBlanks(ref this, List<parser.Decl> decls) uses alloc {
        let none = List<parser.UnionVariant>()
        for decl in decls {
            switch decl {
                case .structDecl(let s):
                    memberBlanksOf(s.value.members, for: s.value.states)
                    memberBlanks(s.value.members)
                case .interfaceDecl(let n):
                    memberBlanksOf(n.value.members, for: none)
                    memberBlanks(n.value.members)
                case .extensionDecl(let x):
                    memberBlanksOf(x.value.members, for: none)
                    memberBlanks(x.value.members)
                default:
            }
        }
    }

    /// Layout.cs: Engine.MemberBlanks, for one type body.
    void memberBlanksOf(ref this, List<parser.Decl> members, for List<parser.UnionVariant> states) uses alloc {
        var found = List<LayoutMember>()
        for m in members {
            found.append(
                LayoutMember {
                    start: memberStart(m),
                    group: layoutGroup(m),
                    method: m is .functionDecl(_) || m is .constructorDecl(_),
                },
            )
        }
        if states.length > 0 {
            let at = statesStart(tokenAt(states[0].span.start))
            if at >= 0 {
                found.append(LayoutMember { start: at, group: "states", method: false })
            }
        }
        // `items.Sort` by start: the starts are distinct tokens.
        for k in 1..found.length {
            var j = k
            while j > 0 && found[j - 1].start > found[j].start {
                let moved = found[j - 1]
                found[j - 1] = found[j]
                found[j] = moved
                j -= 1
            }
        }
        for k in 1..found.length {
            continue if found[k - 1].group == found[k].group && !(found[k - 1].method && found[k].method)
            let next = found[k].start
            if gaps[next].hasNewline && editable(next, through: next) {
                needsBlank[next] = true
            }
        }
    }

    /// Layout.cs: Engine.MemberStart.
    i64 memberStart(parser.Decl decl) uses alloc {
        let span = layoutDeclSpan(decl)
        let attributes = layoutAttributes(decl)
        return tokenAt(attributes[0].start < span.start ? attributes[0].start : span.start) if attributes.length > 0
        return tokenAt(span.start)
    }

    /// Layout.cs: Engine.StatesStart. The `states` word of the `states { … }` block holding the state at `first`, or −1.
    i64 statesStart(i64 first) {
        let o = first - 1
        return kind(o) == .openBrace && o > 0 && textIs(o - 1, as: "states") ? o - 1 : -1
    }

    // ── Alignment runs (pass 8, proposal §3.2, §3.3, §3.7) ───────────────────

    /// Layout.cs: Engine.Align. Pass 8. Consecutive lines of one shape at one level, with no blank or comment line between them, form a
    /// run, and the run pads the gap before each of its columns so that they start at one column. Then consecutive lines at one level
    /// that end in a comment align the comments. A column whose padding would push a line of its run past `width` stays unaligned in
    /// that run, and a line whose column sits after a gap the parser reads ends the run.
    void align(ref this, List<parser.Decl> members) uses alloc {
        var shapeMap: Map<i64, LayoutShape> = []
        shapes(members, by: true, to: ref shapeMap)
        arms(ref shapeMap)
        var lines = List<i64>()
        for i in 0..tokens.length - 1 {
            if lineStart[i] {
                lines.append(i)
            }
        }
        var run = List<i64>()
        for s in lines {
            var ok = shapeMap.contains(s) && plain(s)
            if ok {
                for k in shapeMap[s].columns {
                    if !(k < 0 || padded(s, at: k)) {
                        ok = false
                    }
                }
            }
            if run.length > 0
                    && (!ok
                    || shapeMap[s].key != shapeMap[run[0]].key
                    || levelOf[s] != levelOf[run[0]]
                    || separated(s)) {
                alignRun(run, by: shapeMap)
                run = List<i64>()
            }
            if ok {
                run.append(s)
            }
        }
        alignRun(run, by: shapeMap)
        run = List<i64>()
        for s in lines {
            let e = lineEnd(s)
            let ok = gaps[e].items.length > 0 && gaps[e].items[0].isComment && plain(s)
            if run.length > 0 && (!ok || levelOf[s] != levelOf[run[0]] || separated(s)) {
                alignComments(run)
                run = List<i64>()
            }
            if ok {
                run.append(s)
            }
        }
        alignComments(run)
    }

    /// Layout.cs: Engine.Shapes. The fields, properties and one-line top-level declarations that start a line, by their line.
    void shapes(List<parser.Decl> decls, by bool topLevel, to ref Map<i64, LayoutShape> shapeMap) uses alloc {
        for decl in decls {
            let span = layoutDeclSpan(decl)
            let start = tokenAt(span.start)
            let s = lineStartOf(start)
            let e = lineEnd(s)
            if (s == start || kind(s) == .at) && tokenAt(span.end) == e {
                var name: i64 = -1
                var hasBody = false
                // A top-level `const` parses as a statement but declares like the rest.
                var declares = true
                switch decl {
                    case .fieldDecl(let f): name = tokenAt(f.value.name.start)
                    case .propertyDecl(let p):
                        name = tokenAt(p.value.name.start)
                        hasBody = !(p.value.body is .none)
                    case .globalStatement(let g):
                        declares = false
                        switch g.value.statement {
                            case .localDecl(let l): declares = l.value.kind == .constKeyword
                            default:
                        }
                    default:
                }
                let isField = decl is .fieldDecl(_)
                let isProperty = decl is .propertyDecl(_)
                if topLevel && declares && firstAt(.equals, from: start, until: e) > 0 {
                    var columns = List<i64>()
                    columns.append(firstAt(.equals, from: start, until: e))
                    shapeMap[s] = LayoutShape {
                        key: $"{layoutDeclType(decl)} {leadingKeywords(start)}",
                        columns: move columns,
                    }
                } else if !topLevel && isField {
                    var columns = List<i64>()
                    columns.append(name)
                    columns.append(firstAt(.equals, from: name, until: e))
                    shapeMap[s] = LayoutShape { key: "field", columns: move columns }
                } else if !topLevel && isProperty && hasBody && firstAt(.fatArrow, from: name, until: e) > 0 {
                    var columns = List<i64>()
                    columns.append(name)
                    columns.append(firstAt(.fatArrow, from: name, until: e))
                    shapeMap[s] = LayoutShape { key: "property", columns: move columns }
                }
            }
            switch decl {
                case .structDecl(let d): shapes(d.value.members, by: false, to: ref shapeMap)
                case .interfaceDecl(let n): shapes(n.value.members, by: false, to: ref shapeMap)
                case .extensionDecl(let x): shapes(x.value.members, by: false, to: ref shapeMap)
                default:
            }
        }
    }

    /// Layout.cs: Engine.Arms. The one-line arms of each `switch { … }`: an arm that starts a line and ends it with its `,` or the `}`.
    void arms(ref Map<i64, LayoutShape> shapeMap) uses alloc {
        for o in 1..tokens.length {
            continue if kind(o) != .openBrace || kind(o - 1) != .switchKeyword || matchOf[o] < o
            let c = matchOf[o]
            for k in items(o, until: c) {
                continue if !lineStart[k] || !(k == o + 1 || kind(k - 1) == .comma)
                let e = lineEnd(k)
                continue if e > c || !(e == c || kind(e - 1) == .comma)
                var spans = false
                for m in k..e {
                    if layoutIsOpener(kind(m)) && matchOf[m] >= e {
                        spans = true
                    }
                }
                continue if spans
                let arrow = firstAt(.fatArrow, from: k, until: e)
                if arrow > 0 {
                    var columns = List<i64>()
                    columns.append(arrow)
                    shapeMap[k] = LayoutShape { key: "arm", columns: move columns }
                }
            }
        }
    }

    /// Layout.cs: Engine.First. The first `wanted` in tokens `[start, e)` outside brackets, or −1.
    i64 firstAt(lexer.TokenKind wanted, from i64 start, until i64 e) {
        var k = start
        while k < e {
            return k if kind(k) == wanted
            if layoutIsOpener(kind(k)) && matchOf[k] > k {
                k = matchOf[k]
            }
            k += 1
        }
        return -1
    }

    /// Layout.cs: Engine.Plain. Whether the line from `s` is one line, with no frozen token and not in a hole.
    bool plain(i64 s) uses alloc {
        let e = lineEnd(s)
        return false if inHole[s] || inHole[e] || width(s, until: e) == 0
        for k in s..e + 1 {
            return false if frozen[k]
        }
        return true
    }

    /// Layout.cs: Engine.Padded. Whether column token `k` follows a space on the line of `s` that padding may widen.
    bool padded(i64 s, at i64 k) uses alloc =>
        k > s
        && k < lineEnd(s)
        && space(k, from: tokens[k - 1].end)
        && !layoutTriviaMatters(source, from: tokens, at: k)

    /// Layout.cs: Engine.Separated. Whether a blank line, an inserted one or a `//` line comes before line start `s`; a `///` line does not.
    bool separated(i64 s) {
        return true if gaps[s].hasBlank || needsBlank[s]
        for k in 1..gaps[s].items.length {
            return true if gaps[s].items[k].isComment && !doc(gaps[s].items[k])
        }
        return false
    }

    /// Layout.cs: Engine.Doc. Whether the comment `item` is a `///` line.
    bool doc(LayoutGapItem item) {
        let n = item.end - item.start
        return false if n < 3
            || source[item.start] != 0x2f
            || source[item.start + 1] != 0x2f
            || source[item.start + 2] != 0x2f
        return n == 3 || source[item.start + 3] != 0x2f
    }

    /// Layout.cs: Engine.Pads. The padding the run has already put in tokens `(s, e)`.
    i64 pads(i64 s, until i64 e) {
        var n: i64 = 0
        for k in s + 1..e {
            n += pad[k]
        }
        return n
    }

    /// Layout.cs: Engine.LineWidth. The columns of the line from `s` with its padding, before any trailing comment.
    i64 lineWidth(i64 s) uses alloc => width(s, until: lineEnd(s)) + pads(s, until: lineEnd(s))

    /// Layout.cs: Engine.AlignRun.
    void alignRun(ref this, List<i64> lines, by Map<i64, LayoutShape> shapeMap) uses alloc {
        return if lines.length < 2
        var run = lines.copy()
        let key = shapeMap[run[0]].key
        let outliers = key is "field" or "property" or "arm"
        var restart = true
        // Each restart drops one line, so the loop ends within `lines.length` passes.
        while restart {
            restart = false
            return if run.length < 2
            for c in 0..shapeMap[run[0]].columns.length {
                // Only the lines that have the column take part: a field without a default has no `=`.
                var part = List<i64>()
                for s in run {
                    if shapeMap[s].columns[c] >= 0 {
                        part.append(s)
                    }
                }
                continue if part.length < 2
                var at = List<i64>()
                for s in part {
                    let column = shapeMap[s].columns[c]
                    at.append(width(s, until: column) + pads(s, until: column) + 1)
                }
                var target = at[0]
                var widest: i64 = 0
                for n in 0..at.length {
                    if at[n] > target {
                        target = at[n]
                        widest = n
                    }
                }
                var second: i64 = -2147483648
                for n in 0..at.length {
                    if n != widest && at[n] > second {
                        second = at[n]
                    }
                }
                // A line more than 8 columns past the next-widest leaves the run and stays unaligned.
                if outliers && target - second > 8 {
                    for s in run {
                        for k in shapeMap[s].columns {
                            if k >= 0 {
                                pad[k] = 0
                            }
                        }
                    }
                    let outlier = part[widest]
                    for n in 0..run.length {
                        if run[n] == outlier {
                            run.remove(at: n)
                            break
                        }
                    }
                    restart = true
                    break
                }
                var over = false
                for n in 0..part.length {
                    if at[n] < target && lineWidth(part[n]) + target - at[n] > options.width {
                        over = true
                    }
                }
                continue if over
                for n in 0..part.length {
                    pad[shapeMap[part[n]].columns[c]] = target - at[n]
                }
            }
        }
    }

    /// Layout.cs: Engine.AlignComments.
    void alignComments(ref this, List<i64> run) uses alloc {
        return if run.length < 2
        var at = List<i64>()
        for s in run {
            at.append(lineWidth(s) + 1)
        }
        var target = at[0]
        for x in at {
            if x > target {
                target = x
            }
        }
        for n in 0..run.length {
            let item = gaps[lineEnd(run[n])].items[0]
            let comment = layoutCommentText(source, from: item)
            var columns: i64 = 0
            for b in comment {
                if (b & 0xC0) != 0x80 {
                    columns += 1
                }
            }
            return if at[n] < target && target + columns > options.width
        }
        for n in 0..run.length {
            commentPad[lineEnd(run[n])] = target - at[n]
        }
    }

    // ── Writing a gap: blank lines (pass 7), comments, indentation (pass 5), spacing (pass 6) ──

    /// Layout.cs: Engine.EmitGap.
    void emitGap(ref this, i64 i) uses alloc {
        let start = i == 0 ? bom : tokens[i - 1].end
        if frozen[i] {
            for b in start..tokens[i].start {
                output.append(source[b])
            }
            return
        }
        if inHole[i] && gaps[i].hasNewline {
            hygiene(start, until: tokens[i].start)
            return
        }
        let eof = kind(i) == .endOfFile
        let count = gaps[i].items.length
        var at: i64 = 0
        if i > 0 && count > 0 && gaps[i].items[0].isComment {
            spaces(1 + commentPad[i])
            let item = gaps[i].items[0]
            add(item)
            at = 1
        }
        // A joined gap holds no comment (Joinable); a broken one held no newline.
        if i > 0 && !lineStart[i] {
            if eof {
                output.append(0x0A)
                return
            }
            if at == 0 && space(i, from: start) {
                spaces(1 + pad[i])
            }
            return
        }
        if i > 0 {
            output.append(0x0A)
            at += 1
        }
        // Each line between the token's line and the one before: the index of a comment item, or -1 for a blank line.
        var lines = List<i64>()
        var comment: i64 = -1
        while at < count {
            if gaps[i].items[at].isComment {
                comment = at
            } else {
                if comment >= 0 || lines.length == 0 || lines[lines.length - 1] >= 0 {
                    lines.append(comment)
                }
                comment = -1
            }
            at += 1
        }
        if comment >= 0 {
            lines.append(comment)
        }
        if i == 0 || kind(i - 1) == .openBrace {
            while lines.length > 0 && lines[0] < 0 {
                lines.remove(at: 0)
            }
        }
        if eof || kind(i) == .closeBrace {
            while lines.length > 0 && lines[lines.length - 1] < 0 {
                lines.remove(at: lines.length - 1)
            }
        }
        var blank = false
        for line in lines {
            if line < 0 {
                blank = true
            }
        }
        if needsBlank[i] && !blank {
            var withBlank = List<i64>()
            withBlank.append(-1)
            for line in lines {
                withBlank.append(line)
            }
            lines = move withBlank
        }
        let closer = kind(i) == .closeParen || kind(i) == .closeBracket || kind(i) == .closeBrace
        let commentLevel = eof ? 0 : closer ? levelOf[i] + 1 : levelOf[i]
        for line in lines {
            if line >= 0 {
                indent(commentLevel)
                let item = gaps[i].items[line]
                add(item)
            }
            output.append(0x0A)
        }
        if !eof {
            indent(levelOf[i])
        }
    }

    /// Layout.cs: Engine.Add.
    void add(ref this, LayoutGapItem item) uses alloc {
        for b in layoutCommentText(source, from: item) {
            output.append(b)
        }
    }

    /// Layout.cs: Engine.Indent.
    void indent(ref this, i64 level) uses alloc => spaces(level * options.indent)

    /// Layout.cs: Engine.Spaces.
    void spaces(ref this, i64 n) uses alloc {
        for k in 0..n {
            output.append(0x20)
        }
    }

    /// Layout.cs: Engine.Hygiene. The bytes as written, less the blanks and carriage returns before each newline (pass 1).
    void hygiene(ref this, i64 start, until i64 end) uses alloc {
        var blanks = start
        for at in start..end {
            let b = source[at]
            continue if b is 0x20 or 0x09 or 0x0D
            if b != 0x0A {
                for k in blanks..at {
                    output.append(source[k])
                }
            }
            output.append(b)
            blanks = at + 1
        }
        for k in blanks..end {
            output.append(source[k])
        }
    }

    // ── Horizontal spacing (pass 6, proposal §3.8) ───────────────────────────

    /// Layout.cs: Engine.Space. Whether one space goes between tokens `i` − 1 and `i` on one line.
    bool space(i64 i, from i64 start) uses alloc {
        let written = tokens[i].start > start
        // A product written tight takes a space each side (`price * quantity`); Check compares the trees.
        return true if spaceProducts && (tightProduct(i) || tightProduct(i - 1))
        // The parser reads the gap here (`>>`, `T...`, `u8*`, `30s`, `unlikely (a)`): keep it as written.
        return written if layoutTriviaMatters(source, from: tokens, at: i)
        // Generics are tight inside (`List<Sku>`).
        return written && merges(i) if tightAfter[i - 1] || tightBefore[i]
        let a = after(i - 1)
        let ahead = before(i)
        var spaced = false
        if a == .none || ahead == .none {
            spaced = false
        } else if a == .keep || ahead == .keep {
            spaced = written
        } else if a == .space || ahead == .space {
            spaced = true
        } else {
            spaced = written
        }
        return spaced || written && merges(i)
    }

    /// Layout.cs: Engine.Merges. Whether tokens `i` − 1 and `i` written together lex as something else (`- -x`).
    bool merges(i64 i) uses alloc {
        // A string piece lexes as itself only inside its string; it never merges with a neighbour.
        return false if layoutPiece(kind(i - 1)) || layoutPiece(kind(i))
        var joined = List<u8>()
        for b in tokens[i - 1].start..tokens[i - 1].end {
            joined.append(source[b])
        }
        for b in tokens[i].start..tokens[i].end {
            joined.append(source[b])
        }
        let lexed = lexer.lex(lexer.SourceText.create("layout", from: move joined), by: keywords)
        return lexed.tokens.length != 3
            || lexed.tokens[0].kind != tokens[i - 1].kind
            || lexed.tokens[1].kind != tokens[i].kind
    }

    /// Layout.cs: Engine.TightProduct. Whether token `i` is a `*` written tight between two operands on one line (`a*b`).
    bool tightProduct(i64 i) {
        if !(i > 0 && i + 1 < tokens.length && kind(
            i,
        ) == .star && !lineStart[i] && !lineStart[i + 1] && !trivia(i) && !trivia(i + 1)
                && layoutOperandEnd(kind(i - 1))) {
            return false
        }
        let next = kind(i + 1)
        return next == .identifier
            || next == .integerLiteral
            || next == .floatLiteral
            || next == .charLiteral
            || next == .openParen
            || next == .thisKeyword
            || next == .interpolatedStringStart
            || lexer.isStringLiteral(next)
            || parser.isContextualKeyword(next)
    }

    /// Layout.cs: Engine.IsUnary. Whether the `-`, `+`, `&`, `!` or `*` at `i` is a prefix operator.
    bool isUnary(i64 i) => lineStart[i] || !layoutOperandEnd(kind(i - 1))

    /// Layout.cs: Engine.Star. A `*`: prefix, binary (spaced before), or as written (`u8*`, `u8**`, `a*b`).
    LayoutSide star(i64 i, as LayoutSide prefix) {
        return prefix if lineStart[i]
        return .keep if kind(i - 1) == .star && !trivia(i)
        return prefix if !layoutOperandEnd(kind(i - 1))
        return trivia(i) ? .space : .keep
    }

    /// Layout.cs: Engine.After. What token `i` asks of the space after it.
    LayoutSide after(i64 i) {
        let k = kind(i)
        return .none if k is .interpolatedStringStart
            or .interpolatedStringText
            or .interpolationStart
            or .interpolationEnd
        return .none if k is .openParen
            or .openBracket
            or .dot
            or .questionDot
            or .at
            or .tilde
            or .dotDot
            or .dotDotEquals
        return .space if k is .comma or .colon
        return kind(i + 1) == .closeBrace ? .keep : .space if k == .openBrace
        return .space if layoutIsBinary(k)
        return isUnary(i) ? .none : .space if k is .minus or .plus or .amp
        return isUnary(i) ? .none : .keep if k == .bang
        return star(i, as: .none) if k == .star
        return kind(i - 1) == .dotDot ? .none : trivia(i) ? .space : .keep if k == .less
        return trivia(i) ? .space : .keep if k is .greater or .question
        return .keep if k is .plusPlus or .minusMinus or .hash or .semicolon
        return .deferred
    }

    /// Layout.cs: Engine.Before. What token `i` asks of the space before it.
    LayoutSide before(i64 i) {
        let k = kind(i)
        return .none if k is .interpolatedStringText
            or .interpolationStart
            or .interpolationEnd
            or .interpolatedStringEnd
        return .none if k is .closeParen or .closeBracket or .comma
        return .keep if k is .semicolon or .numericSuffix or .plusPlus or .minusMinus or .hash
        return kind(i - 1) == .openBrace ? .keep : .space if k == .closeBrace
        return .space if k == .openBrace
        return spacedColon(i) ? .space : .none if k == .colon
        if k is .dot or .questionDot {
            let prev = kind(i - 1)
            return .deferred if k == .dot && prev == .identifier && textIs(i - 1, as: "becomes")
            return prev == .identifier
                || prev == .closeParen
                || prev == .closeBracket
                || prev == .thisKeyword
                || prev == .interpolatedStringEnd
                || lexer.isStringLiteral(prev) || parser.isContextualKeyword(prev) ? .none : .deferred
        }
        return particleTuple(i) ? .space : callLike(i - 1) ? .none : .deferred if k is .openParen or .openBracket
        return layoutOperandEnd(kind(i - 1)) ? .none : .deferred if k is .dotDot or .dotDotEquals
        return .space if layoutIsBinary(k)
        return isUnary(i) ? .deferred : .space if k is .minus or .plus or .amp
        return isUnary(i) ? .deferred : .keep if k == .bang
        return star(i, as: .deferred) if k == .star
        return kind(i - 1) == .dotDot ? .none : trivia(i) ? .space : .keep if k == .less
        return trivia(i) ? .space : .keep if k is .greater or .question
        return .deferred
    }

    /// Layout.cs: Engine.ParticleTuple. Whether the `(` at `i` opens the tuple type of a parameter after its particle
    /// (`by (string a, string b) args`), not a call: the particle follows a `(` or `,` and a name follows the `)`.
    bool particleTuple(i64 i) {
        return false if kind(i) != .openParen || i < 2 || kind(i - 1) != .identifier
        return false if !(kind(i - 2) is .openParen or .comma)
        return false if !(textIs(i - 1, as: "from") || textIs(i - 1, as: "to") || textIs(i - 1, as: "until")
            || textIs(i - 1, as: "through")
            || textIs(i - 1, as: "at")
            || textIs(i - 1, as: "by")
            || textIs(i - 1, as: "for")
            || textIs(i - 1, as: "as"))
        let close = matchOf[i]
        return close > i && close + 1 < matchOf.length && kind(close + 1) == .identifier
    }

    /// Layout.cs: Engine.CallLike. Whether a `(` or `[` after token `i` is a call or an index: no space before it.
    bool callLike(i64 i) {
        let k = kind(i)
        return true if k == .closeParen || k == .closeBracket || parser.isContextualKeyword(k)
        return k == .identifier && !(textIs(i, as: "where") || textIs(i, as: "expects") || textIs(i, as: "becomes"))
    }

    /// Layout.cs: Engine.SpacedColon. Whether the `:` at `i` is a ternary's or a conformance's (`struct S : I`, `where T : I`).
    bool spacedColon(i64 i) {
        var depth: i64 = 0
        // A `,` at this level ends a ternary operand, so a `?` before it is another entry's (`f(c ? a : b, by: x)`).
        var pastComma = false
        var k = i - 1
        while k >= 0 {
            let at = kind(k)
            pastComma = true if at == .comma && depth == 0
            if at is .closeParen or .closeBracket or .closeBrace or .interpolationEnd {
                depth += 1
            } else if at is .openParen or .openBracket or .openBrace or .interpolationStart {
                return false if depth == 0
                depth -= 1
            } else if depth == 0
                    && (at == .structKeyword || at == .interfaceKeyword || at == .extensionKeyword || at == .question && trivia(
                        k,
                    ) && !pastComma
                    || at == .identifier && textIs(k, as: "where")) {
                return true
            }
            // A chain link continues its line, so the scan goes on through it to a `?` before the chain.
            return false if lineStart[k] && depth == 0 && !isWasl(k)
            k -= 1
        }
        return false
    }
}
== driver/main.byn
// bayan: the self-hosted compiler driver (spec 012). `Run` of CliApp.cs:37 with the global options of
// `TakeGlobalOptions` (CliApp.cs:328); commands the driver does not port are refused (R3).
//
//     bayan [--ascii] [--color auto|always|never] <command> [args]

import semantics

const exitOk: i32          = 0
const exitFailure: i32     = 1
const exitUsage: i32       = 2
const exitTestFailure: i32 = 3
const exitToolchain: i32   = 4

/// Toolchain.CompilerVersion (Toolchain.cs:33).
const version: string = "0.3.2"

/// Messages.Usage (Messages.cs:32), kept equal by SelfhostDriverTests.
const usageText: string = """
usage: bayan <command> [args]

commands:
  new <name>           create an app in a new directory [--lib|--script] [--vcs git|none] [--ci github|none]
  init [<dir>]         add a project's missing files to a directory (same options as new)
  lex [--json] <file>  print the token stream [--json: as one JSON object] (`-` reads stdin)
  parse [--ast] <file> check syntax; with --ast print the syntax tree
  types <path>         print each function's parameter and local types as JSON
  check <path>         report diagnostics for a program (a file or directory)
  build <path>         compile to an executable [-o <file>] [--mode debug|safe|fast] [--target <t>] [--emit-c]
                       [-v: print each phase's time and the output path]
  run <path>           compile and run [--mode debug|safe|fast] [-- <program args>]
  test <path>          compile and run the tests, each in its own process [--mode debug|safe|fast]
                       [--json: print the results as JSON instead]
                       [--changed [--base <ref>]: only modules with files changed since HEAD or <ref>]
                       [--only <text>: only tests whose name contains <text>; repeatable]
                       [-v: also list the passing and pending tests]
                       [--mutate: run every mutant against the tests that reach it; with --run <cmd>, run <cmd> once
                       per mutant instead, with BAYAN_MUTANT set (exit 0 survived, non-zero killed)]
  mutate --binary <exe> --sites <map.json> -- <cmd>
                       run <cmd> once per mutant site of a prebuilt --mutate binary, as test --mutate --run does
  dist [<dir>]         build release binaries into dist/<version>/ [--target <t>|all] [--mode m]
                       [--force: rebuild an existing version] [--allow-dirty: build from a dirty git tree]
  clean [<dir>]        remove out/ [--dist: also dist/] [--cache: also the global build cache]
  cache stats          show the shared build cache's location and size
  format <path>        rewrite input forms (those with a fix-it) in a `.byn` file or a directory of them,
                       and booleans and primitives to `style` in `package.byn` [--check: list, don't write]
  fix [<path>…]        apply every style lint's fix (whatever its severity in `lints`) to `.byn` files
                       or directories of them (default: the current directory); does not format
  audit <path>         list every `because` bypass and `unsafe` or `extern` declaration, with its reason
  features --used <path>
                       print the syntax node kinds, builtins and diagnostics a build touched, as JSON
  explain <code>       explain a diagnostic, e.g. `bayan explain BYN0003`
  <script>.byn         run a script, so `#!/usr/bin/env bayan` works
  doctor               check the C compiler, zig, git and the build cache, with fixes
  --version            print the compiler version and the commit it was built from
  --help               print this message

check, types, build, run, test and features take a project directory (one with `package.byn`; the
default inside a project), a script (a file starting with `#!`), or a file or directory of `.byn` files.

options for every command:
  --color auto|always|never
                       color for terminals (auto: on unless piped or NO_COLOR is set;
                       FORCE_COLOR turns it on, TERM=dumb off)
  --ascii              use ASCII symbols instead of ◆ ✗ │ (also with TERM=dumb or a non-UTF-8 locale)

options for check, types, build, run and test:
  --all                show every error instead of the first 20 (JSON is never capped)
  --diagnostics json   print each diagnostic to stderr as one JSON object per line
                       (code, severity, file, span, message, label, help, fixes)

exit codes:
  0  success
  1  compile errors
  2  usage errors (unknown command or option, missing path)
  3  test failures, or a coverage or mutation score below its minimum
  4  toolchain problems (no C compiler, unwritable cache, C compiler failure)

`bayan run` exits 1 when compilation fails and otherwise passes the program's own exit code
through unchanged, so it cannot tell a build failure from a program that exits 1. When that
matters, run `bayan build` first or read `--diagnostics json`.
"""

/// CliApp.cs:33 `VersionLine` with the commit replaced by `selfhost` (spec Q3).
string versionLine() => $"bayan {version} (selfhost)"

/// CliApp.cs:37 `Run`.
i32 run(ReadOnlySpan<string> args, through ref DCtx d) {
    var kept = List<string>()
    unless takeGlobalOptions(args, to: ref kept, through: ref d) {
        return exitUsage
    }
    // no-builtin: Q1117 the `Terminal` of CliApp.cs:27 is what `Run(args, stdout, stderr)` gives: neither stream a tty, width 0
    d.styleOut = decideStyle(d.color, by: d.ascii, through: false, for: 0)
    d.styleErr = decideStyle(d.color, by: d.ascii, through: false, for: 0)
    d.stderrTty = false
    if kept.length == 0 {
        Io.stderr.write($"{usageText}\n")
        return exitUsage
    }
    let command = kept[0]
    switch command {
        case "--version" or "version":
            Io.stdout.write($"{versionLine()}\n")
            return exitOk
        case "doctor":
            // coverage-exempt: Q1219 the C# `doctor` prints its own version line (Q1112), so no row compares it
            return doctorCommand(by: in d)
        case "--help" or "-h" or "help":
            Io.stdout.write($"{usageText}\n")
            return exitOk
        case "lex":
            return lexCommand(in kept)
        case "parse":
            return parseCommand(in kept)
        case "types":
            return typesCommand(in kept, by: in d)
        case "format":
            return formatCommand(in kept, by: in d)
        case "fix":
            return fixCommand(in kept, by: in d)
        case "audit":
            return auditCommand(in kept, by: in d)
        case "features":
            return featuresCommand(in kept, by: in d)
        case "explain":
            return explainCommand(kept)
        case "check":
            return checkCommand(in kept, by: in d)
        case "build":
            return buildCommand(in kept, by: ref d)
        case "run":
            return runProgram(in t2Rest(kept), by: ref d)
        case "test":
            return testCommand(in kept, by: ref d)
        case "mutate":
            return mutateBinary(in t2Rest(kept))
        case "new":
            let newArgs = t2Rest(kept)
            return scaffoldNew(newArgs.span)
        case "dist":
            return distCommand(in kept, by: ref d)
        case "cache":
            return cacheCommand(kept)
        case "clean":
            return cleanCommand(kept)
        case "init":
            let initArgs = t2Rest(kept)
            return scaffoldInit(initArgs.span)
        default:
            // `#!/usr/bin/env bayan` runs `bayan script.byn [args]` (CliApp.cs:97).
            if command.endsWith(".byn") && t1FileExists(command) {
                var script = List<string>()
                script.append(command)
                script.append("--")
                for a in t2Rest(kept) {
                    script.append(a)
                }
                return runProgram(in script, by: ref d)
            }
            Io.stderr.write($"bayan: unknown command `{command}`\n")
            if command == "fmt" {
                Io.stderr.write("the formatter is `bayan format`\n")
            }
            Io.stderr.write($"{usageText}\n")
            return exitUsage
    }
}

/// CliApp.cs:328 `TakeGlobalOptions`: `--color` and `--ascii` are removed from `args` into `kept` and `d`, before any `--`
/// and before a script run without a command; false after reporting a bad colour value.
bool takeGlobalOptions(ReadOnlySpan<string> args, to ref List<string> kept, through ref DCtx d) {
    var color = "auto"
    var command = false
    var i: i64 = 0
    while i < args.length {
        var value: string? = null
        // A script's arguments are its own (`bayan --ascii tool.byn --color never`).
        if args[i] == "--"
                || (!command && !args[i].startsWith("-") && args[i].endsWith(".byn") && t1FileExists(args[i])) {
            for k in i..args.length {
                kept.append(args[k])
            }
            break
        }
        if !args[i].startsWith("-") {
            command = true
        }
        if args[i] == "--ascii" {
            d.ascii = true
            i += 1
            continue
        }
        if args[i] == "--color" && i + 1 < args.length {
            i += 1
            value = args[i]
        } else if args[i].startsWith("--color=") {
            value = args[i]["--color=".length..args[i].length]
        } else if args[i] == "--color" {
            value = ""
        }
        if (value is not { } v) {
            kept.append(args[i])
            i += 1
            continue
        }
        if v != "auto" && v != "always" && v != "never" {
            Io.stderr.write($"bayan: unknown color setting `{v}` (expected auto, always or never)\n")
            return false
        }
        color = v
        i += 1
    }
    d.color = color
    return true
}

/// TerminalStyle.cs:13 `Decide`, palette included (:24-27, `t7Light`); the Windows code page arm of `Utf8` (:75-84) has no builtin (Q1117).
DStyle decideStyle(string colorFlag, by bool ascii, through bool isTty, for i64 width) uses alloc, env {
    let dumb = Env.get("TERM") == "dumb"
    var color = false
    switch colorFlag {
        case "always":
            color = true
        case "never":
            color = false
        default:
            if (Env.get("NO_COLOR") ?? "").length > 0 {
                color = false
            } else if (Env.get("FORCE_COLOR") ?? "").length > 0 && Env.get("FORCE_COLOR") != "0" {
                color = true
            } else if dumb {
                color = false
            } else {
                color = isTty
            }
    }
    var palette: i64 = 0
    if color {
        let term = Env.get("COLORTERM") ?? ""
        if term is "truecolor" or "24bit" {
            palette = t7Light() ? 1 : 2
        }
    }
    return DStyle {
        color: color,
        ascii: ascii || dumb || !t7Utf8(),
        width: isTty && width > 0 ? width : 100,
        palette: palette,
    }
}

/// TerminalStyle.cs:59 `Light`: `BAYAN_THEME`, else the background field of `COLORFGBG` (digits only, 7 or 9 to 15), else dark.
bool t7Light() uses alloc, env {
    let theme = Env.get("BAYAN_THEME") ?? ""
    return true if theme == "light"
    return false if theme == "dark"
    let fgbg = Env.get("COLORFGBG") ?? ""
    // digits after the last `;`; `int.TryParse` with `NumberStyles.None` rejects an empty, non-digit or out-of-range (above int.MaxValue) field
    var bg: i64 = 0
    var digits = 0
    var bad = false
    for c in fgbg.bytes {
        if c == 0x3b {
            bg = 0
            digits = 0
            bad = false
        } else if c is 0x30..=0x39 {
            bg = bg * 10 + i64(c) - 0x30
            digits += 1
            if bg > 2147483647 {
                bad = true
                bg = 0
            }
        } else {
            bad = true
        }
    }
    return false if bad || digits == 0
    return bg is 7 or 9..=15
}

/// `Palette.Prefix` (Style.cs:34) of the roles `error`, `warning`, `help`, `success`, `note` as 0 to 4, for `palette` (0 `Ansi16`, 1 `TruecolorLight`, 2 `TruecolorDark`); the hex rows are `Palette.Hex`.
string t7Prefix(by i64 palette, for i64 role) uses alloc {
    if palette == 0 {
        let rows = ["\u{1b}[31m", "\u{1b}[33m", "\u{1b}[34m", "\u{1b}[32m", "\u{1b}[2m"]
        return rows[role]
    }
    if palette == 1 {
        let rows = [
            "\u{1b}[38;2;180;35;24m",
            "\u{1b}[38;2;138;83;0m",
            "\u{1b}[38;2;31;58;95m",
            "\u{1b}[38;2;47;107;31m",
            "\u{1b}[38;2;95;94;90m",
        ]
        return rows[role]
    }
    let rows = [
        "\u{1b}[38;2;255;138;128m",
        "\u{1b}[38;2;242;193;78m",
        "\u{1b}[38;2;141;184;242m",
        "\u{1b}[38;2;143;214;148m",
        "\u{1b}[38;2;180;178;169m",
    ]
    return rows[role]
}

/// TerminalStyle.cs:66 `Utf8`: on Windows the console code page, which has no builtin and is read as UTF-8 (Q1117); elsewhere the first non-empty of `LC_ALL`, `LC_CTYPE`, `LANG` names UTF-8 (none set counts as UTF-8).
bool t7Utf8() uses alloc, env {
    // coverage-exempt: Q1117 through `let names` (the Windows arm)
    if Target.os == "windows" {
        // no-builtin: Q1117 TerminalStyle.cs:68-77 reads `Console.OutputEncoding.CodePage == 65001` on Windows, never the locale; read as UTF-8
        return true
    }
    let names = ["LC_ALL", "LC_CTYPE", "LANG"]
    for name in names {
        let locale = Env.get(name) ?? ""
        continue if locale.length == 0
        return locale.lowercased().contains("utf-8") || locale.lowercased().contains("utf8")
    }
    return true
}

/// The C# `File.Exists`: `path` reads and is not a directory.
bool t1FileExists(string path) {
    // Q31 (plan 013): the listing and the bytes are read only to test the path, so both are freed with the arena
    using let arena = Arena()
    provide allocator: arena {
        let _ = Io.listDir(path) catch {
            let _ = Io.readFile(path) catch return false
            return true
        }
    }
    return false
}

/// CliApp.cs:375 `IsScript`: a file whose first two bytes are `#!`. A copy of `semantics/cli.byn` `t26IsScript` (private there); T28 merges copies.
bool t1IsScript(string path) {
    unless t1FileExists(path) {
        return false
    }
    // coverage-exempt: Q918 the catch is reached only if the file changes between the reads at :219 and :229 (a race no test can stage); the C# has no such branch
    let bytes = Io.readFile(path) catch return false
    return bytes.length >= 2 && bytes[0] == 0x23 && bytes[1] == 0x21
}

/// CliApp.cs:384 `RefuseLibrary`: a library has nothing to build or run; `command` is the refused verb (`build`, `run`).
bool refuseLibrary(semantics.Ctx compiled, by string command) {
    unless compiled.library {
        return false
    }
    Io.stderr.write(
        $"bayan: `{compiled.packageName}` is a library, so there is no program to {command}; `bayan test` runs its tests\n",
    )
    return true
}

/// R3 (spec Q4): one stderr line naming `what`.
i32 refuse(string what) {
    Io.stderr.write($"error: `{what}` is not available in the self-hosted compiler; use the C# `bayan`\n")
    return exitUsage
}

i32 main(ReadOnlySpan<string> args) {
    var d = newDCtx()
    return run(args, through: ref d)
}
== driver/mutate.byn
// `test --mutate` and `mutate` of the self-hosted driver (spec 017 T13). Ports `CliApp.cs` :855 `MutateTests`, :888
// `MutateBinary`, :928 `ShellCommand`, :932 `RunExternal`, :951 `ReportGates`, :961 `ExternalLine`, :965 `StatusName`, :975
// `MutantLine` and :986 `ShellQuote`, with `MutationRunner.cs` :31 `Run`, :61 `Mutant`, :85 `RunExternal` and :127 `Exec`, and
// `ExternalSite.cs` :8 `From` and :14 `ReadAll`. The mutation report and gate are quality.byn.

import semantics
import emitter
import emitter.cprint
import std.json

/// `MutantStatus` (MutationRunner.cs), in its declaration order, which `Messages.MutateTotals` counts in.
enum MutantStatus {
    killed
    survived
    timeout
    notReached
    marked
    notEmitted
}

/// `ExternalSite` (ExternalSite.cs:6): a site as `<binary>.sites.json` carries it.
struct ExternalSite {
    i64     id
    string  file
    i64     line
    i64     column
    string  op
    string  original
    string  mutated
    bool    emitted      = true
    string? unobservable = null
}

/// `ExternalResult` (ExternalSite.cs:39): `seconds` is the run's `Elapsed.TotalSeconds`, 0 when not run.
struct ExternalResult {
    ExternalSite site
    MutantStatus status
    f64          seconds = 0.0
}

/// `MutantResult` (MutationRunner.cs) with its `SchemaSite` as `ExternalSite.From` makes it, the one form its readers use.
struct MutantResult {
    ExternalSite site
    MutantStatus status
    i64          runs     = 0
    i64?         killedBy = null
}

/// `MutationResult` (MutationRunner.cs).
struct MutationResult {
    List<MutantResult> mutants = []
    List<i64> excluded  = []
    i64       processes = 0
}

/// `Outcome` (MutationRunner.cs): `elapsedNanos` is `Elapsed`.
struct T13Outcome {
    i32  exitCode     = 0
    bool timedOut     = false
    i64  elapsedNanos = 0
}

/// CliApp.cs:855 `MutateTests`: one schemata build, then every mutant run against the tests that reach it, a line per mutant and
/// the totals; the site map is written beside the binary.
i32 mutateTests(in T11Options o, through ref semantics.Ctx compiled, by ref DCtx d)
        uses alloc, clock, console, env, fs, process, random {
    let none = List<string>()
    var schema = emitter.buildSchema(ref compiled, for: in none)
    let sites = emitter.sitesJson(in schema)
    var l = T11LCtx {}
    l.mutating = true
    l.mutants = schema.switches.take()
    let program = emitter.lower(ref compiled, to: ref l)
    let source = cprint.emit(ref compiled, from: in l.tree, through: in program, by: o.mode == "debug")
    let host = t5HostTarget()
    var output: string? = null
    if (t5PrepareOut(in compiled, by: o.mode, for: host, from: source) is { } dir) {
        output = Path.combine(
            dir,
            targetExecutableName($"{semantics.programName(ref compiled, for: o.path)}-mutate", for: host),
        )
    }
    let built = Io.monotonicNanos()
    var progress = start(in d.styleErr, by: d.stderrTty, through: o.json, for: "building")
    let native = t9Build(source, by: o.mode, to: output, for: null, through: ref d)
    done(ref progress)
    unless native.result.succeeded {
        t5ReportToolchain(native.result, by: o.json, for: t19Symbols(in d.styleErr))
        return exitToolchain
    }
    let executable = native.exe
    let path = emitter.sitesPath(executable)
    // `File.WriteAllText` throws, uncaught, when the site map cannot be written.
    // coverage-exempt: Q1258 an IO failure the C# lets escape
    Io.writeFile(path, sites.bytes) catch { panic($"cannot write {path}") }
    if (o.run is { } run) {
        let full = Path.fullPath(o.path)
        let root = compiled.manifest is not null ? compiled.displayRoot : t5DirectoryExists(
            o.path,
        ) ? full : Path.directoryName(full)
            ?? ""
        let map = externalSiteReadAll(sites) ?? panic("the site map just written is not one")
        return runExternal(
            in map,
            by: in shellCommand(run),
            for: executable,
            through: "bayan test --mutate --run",
            to: Path.combine(Path.combine(root, "out"), "test"),
            as: Io.monotonicNanos() - built,
            minMutation: t13MinMutation(in compiled),
        )
    }
    let work = Path.combine(t9TempPath(), $"bayan-mutate-{t9Unique(ref d)}")
    // `Directory.CreateTempSubdirectory` throws, uncaught, when the temporary directory cannot be written.
    // coverage-exempt: Q1258 an IO failure the C# lets escape
    Io.createDirectory(work) catch { panic($"cannot create the directory {work}") }
    var tests = List<i64>()
    for i in 0..program.tests.length {
        tests.append(i)
    }
    let result = mutationRun(executable, by: in schema, for: in tests, through: work, as: testTimeout())
    for t in result.excluded {
        Io.stderr.write($"test {compiled.tests[program.tests[t]].title} does not pass unmutated; left out\n")
    }
    var counts = [0, 0, 0, 0, 0, 0]
    for m in result.mutants {
        counts[t13Index(m.status)] += 1
    }
    print(
        $"{counts[0]} killed, {counts[1]} survived, {counts[2]} timeout, {counts[3]} not reached, {counts[4]} marked, {counts[5]} not emitted",
    )
    // CliApp.cs:878-879, inside the `try` whose `finally` deletes the work directory.
    var failed = false
    if (t13MinMutation(in compiled) is { } min) {
        let noSeconds = List<f64>()
        failed = reportGates(
            in gatesMutation(
                in qualityMutationResult(
                    "bayan test --mutate",
                    from: in result,
                    by: in schema,
                    through: 0,
                    for: in noSeconds,
                    as: 0,
                ),
                by: min,
            ),
        )
    }
    deleteWorkDir(work)
    return failed ? exitTestFailure : exitOk
}

/// `compiled.Manifest?.MinMutation`.
i64? t13MinMutation(in semantics.Ctx compiled) {
    if (compiled.manifest is { } manifest) {
        return manifest.minMutation
    }
    return null
}

/// The position of `s` in `MutantStatus`'s declaration order (`Enum.GetValues`).
i64 t13Index(MutantStatus s) {
    switch s {
        case .killed:
            return 0
        case .survived:
            return 1
        case .timeout:
            return 2
        case .notReached:
            return 3
        case .marked:
            return 4
        case .notEmitted:
            return 5
    }
}

/// CliApp.cs:888 `MutateBinary`: `bayan mutate --binary <exe> --sites <map.json> -- <cmd>`, the command run once per site of a
/// prebuilt schemata binary.
i32 mutateBinary(in List<string> args) uses alloc, clock, console, env, fs, process {
    var binary: string? = null
    var sites: string? = null
    var command = List<string>()
    var i: i64 = 0
    while i < args.length {
        if args[i] == "--binary" && i + 1 < args.length {
            i += 1
            binary = args[i]
        } else if args[i] == "--sites" && i + 1 < args.length {
            i += 1
            sites = args[i]
        } else if args[i] == "--" {
            for k in (i + 1)..args.length {
                command.append(args[k])
            }
            i = args.length
        } else {
            Io.stderr.write($"bayan: unexpected argument `{args[i]}`\n")
            return exitUsage
        }
        i += 1
    }
    let b = binary ?? ""
    let s = sites ?? ""
    if binary is null || sites is null || command.length == 0 {
        Io.stderr.write("bayan: usage: bayan mutate --binary <exe> --sites <map.json> -- <command>\n")
        return exitUsage
    }
    for path in [b, s] {
        unless Fs.fileExists(path) {
            Io.stderr.write($"bayan: not found: {path}\n")
            return exitUsage
        }
    }
    // `File.ReadAllText` throws, uncaught, when the existing site map cannot be read.
    // coverage-exempt: Q1258 an IO failure the C# lets escape
    let bytes = Io.readFile(s) catch { panic($"cannot read {s}") }
    let text = t13ReadAllText(in bytes)
    let map = externalSiteReadAll(text) ?? return t13BadSites(s)
    let full = Path.fullPath(b)
    var min: i64? = null
    if Fs.fileExists("package.byn") {
        // `Manifest.Read` throws, uncaught, when the existing manifest cannot be read.
        // coverage-exempt: Q1258 an IO failure the C# lets escape
        let manifest = semantics.manifestRead("package.byn") catch { panic("cannot read package.byn") }
        min = manifest.minMutation
    }
    return runExternal(
        in map,
        by: in command,
        for: full,
        through: "bayan mutate",
        to: Path.directoryName(full) ?? "",
        as: 0,
        minMutation: min,
    )
}

/// CliApp.cs:911-913: `Messages.MutateBadSites`, exit 2.
i32 t13BadSites(string sites) uses alloc, console {
    Io.stderr.write($"bayan: `{sites}` is not a version 1 site map\n")
    return exitUsage
}

/// CliApp.cs:918 `File.ReadAllText`: the bytes decoded in the encoding their byte order mark names, as `StreamReader`'s
/// `DetectEncoding` reads it (UTF-16 or UTF-32, either byte order, or UTF-8), else as UTF-8; the mark dropped, each invalid
/// sequence decoded as U+FFFD.
string t13ReadAllText(in List<u8> b) uses alloc {
    return t13DecodeWide(in b, from: 2, by: 2, as: true) if t13Starts(in b, for: [0xFE, 0xFF])
    return t13DecodeWide(in b, from: 4, by: 4, as: false) if t13Starts(in b, for: [0xFF, 0xFE, 0x00, 0x00])
    return t13DecodeWide(in b, from: 2, by: 2, as: false) if t13Starts(in b, for: [0xFF, 0xFE])
    return t13DecodeUtf8(in b, from: 3) if t13Starts(in b, for: [0xEF, 0xBB, 0xBF])
    return t13DecodeWide(in b, from: 4, by: 4, as: true) if t13Starts(in b, for: [0x00, 0x00, 0xFE, 0xFF])
    return t13DecodeUtf8(in b, from: 0)
}

/// `UTF8Encoding` decoding of `b` from `start`, with `Encoding`'s replacement fallback: each maximal subpart of an
/// ill-formed sequence (a lead byte and the continuation bytes that can follow it) becomes one U+FFFD.
string t13DecodeUtf8(in List<u8> b, from i64 start) uses alloc {
    var utf8 = List<u8>()
    var i = start
    while i < b.length {
        let c = i64(b[i])
        if c < 0x80 {
            utf8.append(b[i])
            i += 1
            continue
        }
        var need: i64 = 0
        var lo: i64 = 0x80
        var hi: i64 = 0xBF
        if c is 0xC2..=0xDF {
            need = 1
        } else if c is 0xE0..=0xEF {
            need = 2
            if c == 0xE0 {
                lo = 0xA0
            }
            if c == 0xED {
                hi = 0x9F
            }
        } else if c is 0xF0..=0xF4 {
            need = 3
            if c == 0xF0 {
                lo = 0x90
            }
            if c == 0xF4 {
                hi = 0x8F
            }
        }
        var k: i64 = 1
        while k <= need && i + k < b.length && i64(b[i + k]) >= lo && i64(b[i + k]) <= hi {
            k += 1
            lo = 0x80
            hi = 0xBF
        }
        if need > 0 && k > need {
            for j in i..i + k {
                utf8.append(b[j])
            }
        } else {
            t13AppendUtf8(ref utf8, for: 0xFFFD)
        }
        i += k
    }
    return Utf8.decode(utf8, invalid: .replace)
}

/// Whether `b` starts with `prefix`.
bool t13Starts(in List<u8> b, for ReadOnlySpan<u8> prefix) {
    return false if b.length < prefix.length
    for i in 0..prefix.length {
        return false if b[i] != prefix[i]
    }
    return true
}

/// `UnicodeEncoding` (`width` 2) or `UTF32Encoding` (`width` 4) decoding of `b` from `start`, with `Encoding`'s replacement
/// fallback: an unpaired surrogate, a value past U+10FFFF and a trailing partial unit each become U+FFFD.
string t13DecodeWide(in List<u8> b, from i64 start, by i64 width, as bool bigEndian) uses alloc {
    var utf8 = List<u8>()
    var i = start
    while i + width <= b.length {
        let u = t13Unit(in b, at: i, by: width, as: bigEndian)
        i += width
        var cp = u
        if width == 2 && u >= 0xD800 && u <= 0xDBFF {
            cp = 0xFFFD
            if i + 2 <= b.length {
                let low = t13Unit(in b, at: i, by: 2, as: bigEndian)
                if low is 0xDC00..=0xDFFF {
                    cp = 0x10000 + (u - 0xD800) * 1024 + (low - 0xDC00)
                    i += 2
                }
            }
        } else if u is 0xD800..=0xDFFF or > 0x10FFFF {
            cp = 0xFFFD
        }
        t13AppendUtf8(ref utf8, for: cp)
    }
    if i < b.length {
        t13AppendUtf8(ref utf8, for: 0xFFFD)
    }
    return Utf8.decode(utf8, invalid: .replace)
}

/// The `width`-byte unit of `b` at `i`, in the byte order `bigEndian` names.
i64 t13Unit(in List<u8> b, at i64 i, by i64 width, as bool bigEndian) {
    var u: i64 = 0
    for k in 0..width {
        u = u * 256 + i64(b[bigEndian ? i + k : i + width - 1 - k])
    }
    return u
}

/// `cp` appended to `utf8` as UTF-8.
void t13AppendUtf8(ref List<u8> utf8, for i64 cp) uses alloc {
    if cp < 0x80 {
        utf8.append(u8(cp))
    } else if cp < 0x800 {
        utf8.append(u8(0xC0 | (cp >> 6)))
        utf8.append(u8(0x80 | (cp & 0x3F)))
    } else if cp < 0x10000 {
        utf8.append(u8(0xE0 | (cp >> 12)))
        utf8.append(u8(0x80 | ((cp >> 6) & 0x3F)))
        utf8.append(u8(0x80 | (cp & 0x3F)))
    } else {
        utf8.append(u8(0xF0 | (cp >> 18)))
        utf8.append(u8(0x80 | ((cp >> 12) & 0x3F)))
        utf8.append(u8(0x80 | ((cp >> 6) & 0x3F)))
        utf8.append(u8(0x80 | (cp & 0x3F)))
    }
}

/// CliApp.cs:928 `ShellCommand`.
List<string> shellCommand(string command) uses alloc {
    // coverage-exempt: Q1258 through `["cmd", "/c", command]` Windows
    if Target.os == "windows" {
        return ["cmd", "/c", command]
    }
    return ["/bin/sh", "-c", command]
}

/// CliApp.cs:932 `RunExternal`: the command over `sites`, a line per site and the report summary, and `bayan-quality.json` written
/// to `reportDir`.
i32 runExternal(
    in List<ExternalSite> sites,
    by in List<string> command,
    for string binary,
    through string tool,
    to string reportDir,
    as i64 buildNanos,
    i64? minMutation = null
) uses alloc, clock, console, env, fs, process {
    let total = Io.monotonicNanos()
    let results = mutationRunExternal(in sites, by: in command, for: binary, as: testTimeout())
        ?? return t13BaselineFailed()
    let report = qualityMutation(tool, from: in results, by: buildNanos, as: Io.monotonicNanos() - total)
    let none = List<string>()
    Io.stdout.write(qualitySummary(in report, by: in none))
    // coverage-exempt: Q1258 through `Io.writeFile(path, qualityMutationJson` an IO failure the C# lets escape
    Io.createDirectory(reportDir) catch { panic($"cannot create the directory {reportDir}") }
    let path = Path.combine(reportDir, "bayan-quality.json")
    Io.writeFile(path, qualityMutationJson(in report).bytes) catch { panic($"cannot write {path}") }
    return reportGates(in gatesMutation(in report, by: minMutation)) ? exitTestFailure : exitOk
}

/// CliApp.cs:939-941: `Messages.MutateBaselineFailed`, exit 1.
i32 t13BaselineFailed() uses console {
    Io.stderr.write("bayan: the command does not exit 0 on the unmutated binary\n")
    return exitFailure
}

/// CliApp.cs:951 `ReportGates`: a line per failed gate, then what it misses; whether any failed.
bool reportGates(in List<GateFailure> failures) uses alloc, console {
    for f in failures {
        Io.stderr.write($"bayan: {f.name} {gatesFmt(f.covered, by: f.total)}% < {f.min}%\n")
        for line in f.missing {
            Io.stderr.write($"{line}\n")
        }
    }
    return failures.length > 0
}

/// CliApp.cs:961 `ExternalLine`.
string externalLine(in ExternalResult r) uses alloc => t13Line(in r.site, by: r.status)

/// CliApp.cs:965 `StatusName`.
string statusName(MutantStatus s) {
    switch s {
        case .killed:
            return "killed"
        case .survived:
            return "survived"
        case .timeout:
            return "timeout"
        case .notReached:
            return "not reached"
        case .marked:
            return "marked"
        case .notEmitted:
            return "not emitted"
    }
}

/// CliApp.cs:975 `MutantLine`.
string mutantLine(in MutantResult m) uses alloc => t13Line(in m.site, by: m.status)

/// `Messages.MutateLine` with `MutateTimeoutNote`, which `ExternalLine` and `MutantLine` both print.
string t13Line(in ExternalSite s, by MutantStatus status) uses alloc {
    return $"{s.file}:{s.line}:{s.column} {s.op} `{s.original}` -> `{s.mutated}`: {statusName(status)}{status == .timeout ? " (counted as killed)" : ""}"
}

/// CliApp.cs:986 `ShellQuote`: double quotes when nothing in `text` expands there, else single quotes with `'` as `'\''`.
string shellQuote(string text) uses alloc {
    for c in ["$", "`", "\\", "\"", "!"] {
        return $"'{text.replaced("'", by: "'\\''")}'" if text.contains(c)
    }
    return $"\"{text}\""
}

/// MutationRunner.cs:31 `Run`: each test once unmutated (mutant 0) with its reach file, then every site against the tests that
/// reach it. `onMutant` is the one caller's (CliApp.cs:866): the mutant's line on stdout.
MutationResult mutationRun(
    string executable,
    by in emitter.Schema schema,
    for in List<i64> tests,
    through string workDir,
    as i64 baselineMs
) uses alloc, clock, console, fs, process {
    var processes: i64 = 0
    var time: Map<i64, i64> = []
    var reach: Map<i64, Map<i64, bool>> = []
    var excluded = List<i64>()
    for t in tests {
        let path = Path.combine(workDir, $"reach.{t}")
        t9DeleteFile(path)
        let outcome = t13Exec(executable, at: t, by: 0, for: path, as: baselineMs)
        processes += 1
        // A pending test (exit 4) is left out without a warning; it is not meant to pass yet.
        // A timed-out run's exit code is -1 (`t13Run`), so `!timedOut` never fails after exit 4 and exit 0 is never timed out.
        // coverage-exempt: Q1258 through `if outcome.exitCode != 0 || outcome.timedOut` the conditions MutationRunner.cs:45-46 test
        continue if outcome.exitCode == 4 && !outcome.timedOut
        if outcome.exitCode != 0 || outcome.timedOut {
            excluded.append(t)
            continue
        }
        time[t] = outcome.elapsedNanos
        var ids: Map<i64, bool> = []
        // A run that exits 0 writes the reach file at exit (CEmitter.cs:182 `atexit`); reading it fails only on an IO error the C# lets escape.
        // coverage-exempt: Q1258 through `let text = Io.readText(path)` a passing run always writes its reach file
        if Fs.fileExists(path) {
            let text = Io.readText(path) catch { panic($"cannot read {path}") }
            for line in t11ReadAllLines(text) {
                ids[t9Digits(line, until: 2147483647) ?? panic($"`{line}` is not a site id")] = true
            }
        }
        reach[t] = move ids
    }
    var ran = List<i64>()
    for t in tests {
        if time.contains(t) {
            ran.append(t)
        }
    }
    var results = List<MutantResult>()
    for site in schema.sites {
        // Another process sweeps `bayan-mutate-*` directories idle for an hour; this one is in use.
        Fs.setModified(workDir, to: Time.now()) catch {}
        let result = t13Mutant(executable, by: in site, for: in ran, through: in reach, as: in time, to: ref processes)
        print(mutantLine(in result))
        results.append(result)
    }
    return MutationResult { mutants: move results, excluded: move excluded, processes: processes }
}

/// MutationRunner.cs:61 `Mutant`: a reaching test that fails or times out kills the site; a marked one that none kills is marked.
MutantResult t13Mutant(
    string executable,
    by in emitter.SchemaSite site,
    for in List<i64> tests,
    through in Map<i64,
    Map<i64,
    bool>> reach,
    as in Map<i64,
    i64> time,
    to ref i64 processes
) uses alloc, clock, process {
    let s = externalSiteFrom(in site)
    unless site.emitted {
        return MutantResult { site: s, status: .notEmitted }
    }
    var runs: i64 = 0
    for t in tests {
        unless reach[t].contains(site.id) {
            continue
        }
        let limit = t13Limit(time[t])
        let outcome = t13Exec(executable, at: t, by: site.id, for: null, as: limit)
        runs += 1
        processes += 1
        return MutantResult { site: s, status: .timeout, runs: runs, killedBy: t } if outcome.timedOut
        return MutantResult { site: s, status: .killed, runs: runs, killedBy: t } if outcome.exitCode != 0
    }
    // A marked mutant still runs; one a test kills stays killed so the report can warn that the mark is wrong.
    return MutantResult { site: s, status: .marked, runs: runs } if site.unobservable is not null
    return MutantResult { site: s, status: runs == 0 ? .notReached : .survived, runs: runs }
}

/// `TimeSpan.FromTicks(Math.Max(TimeSpan.TicksPerSecond, 5 * elapsed.Ticks))` in whole milliseconds, truncated as
/// `WaitForExit(limit)` (MutationRunner.cs:161) truncates it (Q1258).
i64 t13Limit(i64 elapsedNanos) {
    let ticks = elapsedNanos / 100
    let limit = ticks * 5 > 10000000 ? ticks * 5 : 10000000
    return limit / 10000
}

/// MutationRunner.cs:85 `RunExternal`: `command` once per emitted site with `BAYAN_MUTANT` set to its id and `BAYAN_BINARY` to
/// `binary` (CliApp.cs:936). Null when the unmutated run (mutant 0) cannot start or does not exit 0 within `baselineMs`.
List<ExternalResult>? mutationRunExternal(
    in List<ExternalSite> sites,
    by in List<string> command,
    for string binary,
    as i64 baselineMs
) uses alloc, clock, console, process {
    // The command could not be started (not found, not executable).
    let baseline = t13RunCommand(in command, at: 0, by: binary, as: baselineMs) ?? return null
    return null if baseline.timedOut || baseline.exitCode != 0
    let timeout = t13Limit(baseline.elapsedNanos)
    var results = List<ExternalResult>()
    for site in sites {
        var result = ExternalResult { site: site, status: .notEmitted }
        if site.emitted {
            // `Process.Start` throws, uncaught, when the command the baseline ran cannot start for a site (MutationRunner.cs:120).
            // coverage-exempt: Q1258 a command that started for the baseline cannot start for a site
            let outcome = t13RunCommand(in command, at: site.id, by: binary, as: timeout)
                ?? panic($"cannot run {command[0]}")
            let status: MutantStatus = outcome.timedOut ? .timeout : outcome.exitCode != 0 ? .killed : site.unobservable is not null ? .marked : .survived
            result = ExternalResult { site: site, status: status, seconds: f64(outcome.elapsedNanos / 100) / 1e7 }
        }
        print(externalLine(in result))
        results.append(result)
    }
    return results
}

/// `Run` (MutationRunner.cs:88) of the external command; null when it cannot start (`Win32Exception`).
T13Outcome? t13RunCommand(in List<string> command, at i64 mutant, by string binary, as i64 limitMs)
        uses alloc, clock, process {
    var args = List<string>()
    for k in 1..command.length {
        args.append(command[k])
    }
    var env: Map<string, string?> = []
    env["BAYAN_BINARY"] = binary
    env["BAYAN_MUTANT"] = $"{mutant}"
    return t13Run(command[0], by: in args, for: in env, as: limitMs)
}

/// MutationRunner.cs:127 `Exec`: `executable --test <test>` with `BAYAN_MUTANT` set and `BAYAN_SITE_REACH` set or removed.
T13Outcome t13Exec(string executable, at i64 index, by i64 mutant, for string? reachPath, as i64 limitMs)
        uses alloc, clock, process {
    var args = List<string>()
    args.append("--test")
    args.append($"{index}")
    var env: Map<string, string?> = []
    env["BAYAN_MUTANT"] = $"{mutant}"
    env["BAYAN_SITE_REACH"] = reachPath
    // `Process.Start` of the just-built executable throws, uncaught, when it cannot start.
    // coverage-exempt: Q1258 through `panic` the executable just built cannot start
    return t13Run(executable, by: in args, for: in env, as: limitMs) ?? panic($"cannot run {executable}")
}

/// MutationRunner.cs `Exec(psi, limit)`: the output is discarded; a signal-killed run is exit 128 + the signal, as
/// `Process.ExitCode` reports it. Null when the program cannot start.
T13Outcome? t13Run(string program, by in List<string> args, for in Map<string, string?> env, as i64 limitMs)
        uses alloc, clock, process {
    let clock = Io.monotonicNanos()
    let r = Io.run(program, args.span, env: env, timeout: Millis(limitMs)) catch switch {
        .timeout(
            _,
            _,
            _
        ) => return T13Outcome { exitCode: -1, timedOut: true, elapsedNanos: Io.monotonicNanos() - clock },
        .signaled(let s, let _, let _) => return T13Outcome {
            exitCode: 128 + s,
            elapsedNanos: Io.monotonicNanos() - clock,
        },
        IoError e => return null,
    }
    return T13Outcome { exitCode: r.exitCode, elapsedNanos: Io.monotonicNanos() - clock }
}

/// ExternalSite.cs:8 `From`.
ExternalSite externalSiteFrom(in emitter.SchemaSite s) uses alloc {
    return ExternalSite {
        id: s.id,
        file: s.site.file,
        line: s.site.line,
        column: s.site.column,
        op: s.site.op,
        original: s.site.original,
        mutated: s.site.mutated,
        emitted: s.emitted,
        unobservable: s.unobservable,
    }
}

/// ExternalSite.cs:14 `ReadAll`: a site map; null when it is not one this version understands. `JsonDocument.Parse` is
/// `std.json`'s reader with `JsonReaderOptions`' default depth limit, 64 (Q1258).
List<ExternalSite>? externalSiteReadAll(string text) uses alloc {
    let parsed = json.Json.parse(text) catch return null
    let root = (move parsed).trustUnchecked() because "a site map only names sites; each field is checked below"
    return null if t13Depth(in root) > 64
    switch root {
        case .object(let members):
            let version = t13Find(in members, for: "version")
            return null if version < 0 || t13Int(in members[version].value) != 1
            let sites = t13Find(in members, for: "sites")
            return null if sites < 0
            var list = List<ExternalSite>()
            switch members[sites].value {
                case .list(let items):
                    for s in items {
                        list.append(t13Site(in s) ?? return null)
                    }
                default:
                    return null
            }
            return list
        default:
            return null
    }
}

/// The nesting depth of `v` as `Utf8JsonReader` counts it against `MaxDepth`: one per object or array.
i64 t13Depth(in json.JsonValue v) {
    var deepest: i64 = 0
    switch v {
        case .object(let members):
            for m in members {
                let d = t13Depth(in m.value)
                if d > deepest {
                    deepest = d
                }
            }
            return deepest + 1
        case .list(let items):
            for x in items {
                let d = t13Depth(in x)
                if d > deepest {
                    deepest = d
                }
            }
            return deepest + 1
        default:
            return 0
    }
}

/// One site of `ReadAll`; null where the C# throws.
ExternalSite? t13Site(in json.JsonValue s) uses alloc {
    switch s {
        case .object(let members):
            let id = t13IntMember(in members, for: "id") ?? return null
            let file = t13Str(in members, for: "file") ?? return null
            let line = t13IntMember(in members, for: "line") ?? return null
            let column = t13IntMember(in members, for: "column") ?? return null
            let op = t13Str(in members, for: "operator") ?? return null
            let original = t13Str(in members, for: "original") ?? return null
            let mutated = t13Str(in members, for: "mutated") ?? return null
            var emitted = true
            let e = t13Find(in members, for: "emitted")
            if e >= 0 {
                switch members[e].value {
                    case .flag(let b):
                        emitted = b
                    default:
                        return null
                }
            }
            var unobservable: string? = null
            let u = t13Find(in members, for: "unobservable")
            if u >= 0 {
                switch members[u].value {
                    case .text(let v):
                        unobservable = v
                    case .nothing:
                        unobservable = null
                    default:
                        return null
                }
            }
            return ExternalSite {
                id: id,
                file: file,
                line: line,
                column: column,
                op: op,
                original: original,
                mutated: mutated,
                emitted: emitted,
                unobservable: unobservable,
            }
        default:
            return null
    }
}

/// `TryGetProperty`/`GetProperty`: the index of the last member named `key`, as `JsonDocument` reads a duplicate; -1 when none.
i64 t13Find(in List<json.JsonMember> members, for string key) {
    var found: i64 = -1
    for i in 0..members.length {
        if members[i].key == key {
            found = i
        }
    }
    return found
}

/// `GetProperty(key).GetInt32()`; null where it throws.
i64? t13IntMember(in List<json.JsonMember> members, for string key) uses alloc {
    let i = t13Find(in members, for: key)
    return null if i < 0
    return t13Int(in members[i].value)
}

/// `GetInt32`: a number written as an integer within `int`; null otherwise.
i64? t13Int(in json.JsonValue v) uses alloc {
    switch v {
        case .number(let _, let text):
            let negative = text.startsWith("-")
            let digits = t9Digits(negative ? text[1..text.length] : text, until: negative ? 2147483648 : 2147483647)
                ?? return null
            return negative ? -digits : digits
        default:
            return null
    }
}

/// ExternalSite.cs:12 `Str`: the member's string; null when it is missing, null or not a string.
string? t13Str(in List<json.JsonMember> members, for string key) uses alloc {
    let i = t13Find(in members, for: key)
    return null if i < 0
    switch members[i].value {
        case .text(let s):
            return s
        default:
            return null
    }
}
== driver/progress.byn
// The single progress line on stderr (Progress.cs, spec 005 R13). The C# draws it from a `Timer` once the operation outlives
// 300 ms and every 250 ms after. The language has no timer thread, so `start` reads `Io.monotonicNanos()` and `done` draws the frames
// the timer would have drawn by then, before it clears the line (Q1116).

/// The line's state: the C# `Progress` fields `_frames`, `_phase`, `_frame`, `_shown`, `_done`; `off` stands for its `TextWriter.Null` writer.
struct Progress {
    bool   off   = false
    bool   ascii = false
    string phase = ""
    i64    frame = 0
    bool   shown = false
    bool   done  = false
    /// `timed` is false for an inert `Progress {}` and when `after` is zero or less (the C# creates no `Timer`); `begun` is `Io.monotonicNanos()` at `start`, `after` the C# `threshold` in nanoseconds.
    bool   timed = false
    i64    begun = 0
    i64    after = 0
}

/// `Progress.DefaultThreshold` (Progress.cs:17) and `s_interval` (:18), in nanoseconds.
const progressThreshold: i64 = 300000000
const progressInterval: i64  = 250000000

/// The scalar's width in UTF-8 bytes.
i64 t7Utf8Length(i64 scalar) {
    return 1 if scalar < 0x80
    return 2 if scalar < 0x800
    return 3 if scalar < 0x10000
    return 4
}

/// TerminalStyle.cs:46 `Hidden` for one UTF-16 unit; a scalar above U+FFFF is never hidden.
bool t7Hidden(i64 c) {
    return c is < 0x20 or 0x7F..=0x9F or 0x61C or 0x200E or 0x200F or 0x202A..=0x202E or 0x2066..=0x2069
}

/// TerminalStyle.cs:34 `Visible`: C0, DEL, C1 and bidi controls written as `\u{hex}`.
string visible(string text) uses alloc {
    var any = false
    for r in text.runes {
        if t7Hidden(i64(u32(r))) {
            any = true
        }
    }
    unless any {
        return text
    }
    var sb = StrBuf()
    var from: i64 = 0
    var at: i64 = 0
    for r in text.runes {
        let scalar = i64(u32(r))
        let next = at + t7Utf8Length(scalar)
        if t7Hidden(scalar) {
            sb.append(text[from..at])
            sb.append("\\u{")
            sb.append(string(scalar, as: .hex))
            sb.append("}")
            from = next
        }
        at = next
    }
    sb.append(text[from..text.length])
    return $"{sb.finish()}"
}

/// Progress.cs:67 `Columns`: two per wide scalar, none per combining mark, one otherwise.
i64 columns(i64 scalar) {
    return 0 if scalar is 0x0300..=0x036F
    return 2 if scalar is 0x1100..=0x115F
        or 0x2E80..=0xA4CF
        or 0xAC00..=0xD7A3
        or 0xF900..=0xFAFF
        or 0xFE30..=0xFE4F
        or 0xFF00..=0xFF60
        or 0xFFE0..=0xFFE6
        or 0x1F300..=0x1F64F
        or 0x1F900..=0x1F9FF
        or 0x20000..=0x3FFFD
    return 1
}

/// Progress.cs:48 `Fit`: `phase` cut to `room` columns ending in `ellipsis`. The C# `ellipsis.Length` counts UTF-16 units: `length` is that count.
string fit(string phase, to i64 room, by string ellipsis, for i64 length) uses alloc {
    var width: i64 = 0
    for r in phase.runes {
        width += columns(i64(u32(r)))
    }
    return phase if width <= room
    let keep = room - length > 0 ? room - length : 0
    var kept: i64 = 0
    var used: i64 = 0
    for r in phase.runes {
        used += columns(i64(u32(r)))
        break if used > keep
        kept += 1
    }
    return $"{phase.runes.take(kept)}{ellipsis}"
}

/// Progress.cs:23 `Progress` and :31 `Start`: the line, or an inert one when it must not be shown. `after` is the C# `threshold` in nanoseconds; zero or less draws at once.
Progress start(in DStyle style, by bool isTty, through bool json, for string phase, i64 after = progressThreshold)
        uses alloc, clock, console, env {
    let off = !isTty || json || (Env.get("CI") ?? "").length > 0
    // symbols.Progress[0].Length and symbols.Ellipsis.Length are 3 for ASCII ("...") and 3 and 1 for Unicode
    let ellipsis = style.ascii ? "..." : "…"
    let ellipsisLength: i64 = style.ascii ? 3 : 1
    var p = Progress {
        off: off,
        ascii: style.ascii,
        phase: fit(visible(phase), to: style.width - 1 - 3 - 1, by: ellipsis, for: ellipsisLength),
        timed: after > 0,
        begun: Io.monotonicNanos(),
        after: after,
    }
    if after <= 0 {
        tick(ref p)
    }
    return p
}

/// Progress.cs:77 `Tick`: draws the next frame; a single-frame (ASCII) line is drawn once.
void tick(ref Progress p) uses alloc, console {
    return if p.done
    return if p.shown && p.ascii
    let frames: List<string> = p.ascii ? ["..."] : ["◆◇◇", "◇◆◇", "◇◇◆"]
    let text = $"\r{frames[p.frame % frames.length]} {p.phase}"
    p.frame += 1
    if !p.off {
        Io.stderr.write(text)
    }
    p.shown = true
}

/// Progress.cs:90 `Done`: clears the line; safe to call twice.
void done(ref Progress p) uses alloc, clock, console {
    return if p.done
    if p.timed && !p.ascii {
        // the timer's firings so far: one at `after`, then one per interval; a single-frame (ASCII) line is drawn once, below
        let elapsed = Io.monotonicNanos() - p.begun
        if elapsed >= p.after {
            let owed = 1 + (elapsed - p.after) / progressInterval - p.frame
            var i: i64 = 0
            while i < owed {
                tick(ref p)
                i += 1
            }
        }
    } else if p.timed && Io.monotonicNanos() - p.begun >= p.after {
        tick(ref p)
    }
    p.done = true
    return if !p.shown
    if !p.off {
        Io.stderr.write(p.ascii ? "\n" : "\r\u{1b}[2K")
    }
}
== driver/quality.byn
// The coverage half of the quality report of the self-hosted driver (spec 017 T11). Ports `QualityReport.cs` :109 `Coverage`,
// :150 `Json` with :228 `WriteCoverage` (the coverage form), :332 `Listing`, :344 `Percent`, :347 `CoverageSummary`, and
// `Gates.cs` :15 `Coverage`, :43 `Add`, :51 `Fmt`. The mutation half (T13): `QualityReport.cs` :47 `Suggest`, :64, :70 and :77
// `Mutation` (the `MutationResult` form, the external form and the shared one), :150 `Json` (the mutation form), :281
// `Warnings` with :297 `InMark` and :307 `Where`, :314 `Summary`, and `Gates.cs` :32 `Mutation`. The JSON is
// `Utf8JsonWriter`'s indented form (testreport.byn `T11Json`).

import emitter
import lexer
import semantics

/// `ReportBranch` (QualityReport.cs:18): `status` is hit, missed or unknown.
struct QualityBranch {
    i64    line
    i64    column
    bool   outcome
    string status
}

/// `ReportErrorPath` (QualityReport.cs:21).
struct QualityErrorPath {
    string       function
    string       variant
    bool         hit     = false
    bool         unknown = false
    List<string> origins = []
}

/// `FileCoverage` (QualityReport.cs:24) with the `ReportFile` path (:34).
struct QualityFile {
    string                 path
    List<i64>              coveredLines = []
    List<i64>              missedLines  = []
    List<i64>              unknownLines = []
    List<QualityBranch>    branches     = []
    List<QualityErrorPath> errorPaths   = []
}

/// `Tally` (QualityReport.cs:28).
struct QualityTally {
    i64 covered = 0
    i64 total   = 0
}

/// A coverage `QualityReport` (QualityReport.cs:40, `Kind` "coverage"): the timing in nanoseconds (`ReportTiming.BuildSeconds`, `TotalSeconds`).
struct QualityReport {
    string            tool
    i64               buildNanos = 0
    i64               totalNanos = 0
    List<QualityFile> files      = []
    QualityTally      lines      = {}
    QualityTally      branches   = {}
    QualityTally      errorPaths = {}
}

/// `GateFailure` (Gates.cs:6): `Percent` is `100.0 * covered / total`.
struct GateFailure {
    string       name
    i64          covered
    i64          total
    i64          min
    List<string> missing = []
}

/// QualityReport.cs:109 `Coverage`: `hits` merged over every test; when `timedOut` a counter nobody hit is unknown, never missed.
QualityReport qualityCoverage(
    string tool,
    by in emitter.CoverageMap map,
    from in Map<i64,
    u64> hits,
    for bool timedOut,
    through i64 buildNanos,
    as i64 totalNanos
) uses alloc {
    let unhit = timedOut ? "unknown" : "missed"
    var report = QualityReport { tool: tool, buildNanos: buildNanos, totalNanos: totalNanos }
    // `GroupBy(c => c.File)`: the files in first-appearance order.
    var fileIndex: Map<string, i64> = []
    for c in map.counters {
        // std modules (`<std>/...`) are the compiler's own source: they are no part of the package's coverage or its gate
        continue if c.file.startsWith("<std>/")
        unless fileIndex.contains(c.file) {
            fileIndex[c.file] = report.files.length
            report.files.append(QualityFile { path: c.file })
        }
    }
    for f in 0..report.files.length {
        let path = report.files[f].path
        // `GroupBy(c => c.Line).OrderBy(g => g.Key)`: a line is covered when every counter on it was hit.
        var lineHit: Map<i64, bool> = []
        for c in map.counters {
            continue if c.file != path || c.kind != "line"
            let hit = hits.contains(c.id)
            lineHit[c.line] = (lineHit.tryGet(at: c.line) ?? true) && hit
        }
        var lineKeys = List<i64>()
        for (line, _) in lineHit {
            lineKeys.append(line)
        }
        lineKeys.sort()
        for line in lineKeys {
            if lineHit[line] {
                report.files[f].coveredLines.append(line)
            } else if timedOut {
                report.files[f].unknownLines.append(line)
            } else {
                report.files[f].missedLines.append(line)
            }
        }
        for c in map.counters {
            continue if c.file != path || c.kind != "branch"
            report.files[f].branches.append(
                QualityBranch {
                    line: c.line,
                    column: c.column,
                    outcome: c.outcome == true,
                    status: hits.contains(c.id) ? "hit" : unhit,
                },
            )
        }
        // `GroupBy(c => (c.Function!, c.Variant!))`, in first-appearance order.
        var errorIndex: Map<string, i64> = []
        for c in map.counters {
            continue if c.file != path || c.kind != "error"
            let function = c.function ?? ""
            let variant = c.variant ?? ""
            let key = $"{function}\u{0}{variant}"
            unless errorIndex.contains(key) {
                errorIndex[key] = report.files[f].errorPaths.length
                report.files[f].errorPaths.append(QualityErrorPath { function: function, variant: variant })
            }
            let e = errorIndex[key]
            if hits.contains(c.id) {
                report.files[f].errorPaths[e].hit = true
                report.files[f].errorPaths[e].origins.append($"{c.origin ?? ""} {c.line}:{c.column}")
            }
        }
        for e in 0..report.files[f].errorPaths.length {
            report.files[f].errorPaths[e].unknown = timedOut && !report.files[f].errorPaths[e].hit
        }
    }
    for f in report.files {
        report.lines.covered += f.coveredLines.length
        report.lines.total += f.coveredLines.length + f.missedLines.length + f.unknownLines.length
        report.branches.covered += qualityHitBranches(in f)
        report.branches.total += f.branches.length
        report.errorPaths.covered += qualityHitErrorPaths(in f)
        report.errorPaths.total += f.errorPaths.length
    }
    return report
}

/// `f.Branches.Count(b => b.Status == "hit")`.
i64 qualityHitBranches(in QualityFile f) {
    var n: i64 = 0
    for b in f.branches {
        if b.status == "hit" {
            n += 1
        }
    }
    return n
}

/// `f.ErrorPaths.Count(e => e.Hit)`.
i64 qualityHitErrorPaths(in QualityFile f) {
    var n: i64 = 0
    for e in f.errorPaths {
        if e.hit {
            n += 1
        }
    }
    return n
}

/// QualityReport.cs:150 `Json` of a coverage report: `bayan-quality.json`.
string qualityJson(in QualityReport r) uses alloc {
    var w = T11Json {}
    t11JsonOpen(ref w, for: null, by: "{")
    t11JsonValue(ref w, for: "version", by: "1")
    t11JsonValue(ref w, for: "kind", by: t11JsonString("coverage"))
    t11JsonValue(ref w, for: "tool", by: t11JsonString(r.tool))
    t11JsonOpen(ref w, for: "timing", by: "{")
    t11JsonValue(ref w, for: "build_s", by: t11JsonSeconds(r.buildNanos))
    t11JsonValue(ref w, for: "total_s", by: t11JsonSeconds(r.totalNanos))
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "files", by: "[")
    for f in r.files {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "path", by: t11JsonString(f.path))
        qualityWriteCoverage(ref w, for: in f)
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
    t11JsonOpen(ref w, for: "totals", by: "{")
    t11JsonTally(ref w, for: "lines", by: in r.lines)
    t11JsonTally(ref w, for: "branches", by: in r.branches)
    t11JsonTally(ref w, for: "errorPaths", by: in r.errorPaths)
    t11JsonClose(ref w, by: "}")
    t11JsonClose(ref w, by: "}")
    return $"{t11JsonText(in w)}\n"
}

/// QualityReport.cs:207-213: one tally of `totals`.
void t11JsonTally(ref T11Json w, for string name, by in QualityTally tally) uses alloc {
    t11JsonOpen(ref w, for: name, by: "{")
    t11JsonValue(ref w, for: "covered", by: $"{tally.covered}")
    t11JsonValue(ref w, for: "total", by: $"{tally.total}")
    t11JsonClose(ref w, by: "}")
}

/// QualityReport.cs:228 `WriteCoverage`.
void qualityWriteCoverage(ref T11Json w, for in QualityFile f) uses alloc {
    t11JsonOpen(ref w, for: "lines", by: "{")
    t11JsonValue(ref w, for: "covered", by: $"{f.coveredLines.length}")
    t11JsonValue(ref w, for: "total", by: $"{f.coveredLines.length + f.missedLines.length + f.unknownLines.length}")
    t11JsonOpen(ref w, for: "missed", by: "[")
    for l in f.missedLines {
        t11JsonValue(ref w, for: null, by: $"{l}")
    }
    t11JsonClose(ref w, by: "]")
    t11JsonOpen(ref w, for: "unknown", by: "[")
    for l in f.unknownLines {
        t11JsonValue(ref w, for: null, by: $"{l}")
    }
    t11JsonClose(ref w, by: "]")
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "branches", by: "{")
    t11JsonValue(ref w, for: "covered", by: $"{qualityHitBranches(in f)}")
    t11JsonValue(ref w, for: "total", by: $"{f.branches.length}")
    for status in ["missed", "unknown"] {
        t11JsonOpen(ref w, for: status, by: "[")
        for b in f.branches {
            continue if b.status != status
            t11JsonOpen(ref w, for: null, by: "{")
            t11JsonValue(ref w, for: "line", by: $"{b.line}")
            t11JsonValue(ref w, for: "column", by: $"{b.column}")
            t11JsonValue(ref w, for: "outcome", by: b.outcome ? "true" : "false")
            t11JsonClose(ref w, by: "}")
        }
        t11JsonClose(ref w, by: "]")
    }
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "errorPaths", by: "[")
    for e in f.errorPaths {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "function", by: t11JsonString(e.function))
        t11JsonValue(ref w, for: "variant", by: t11JsonString(e.variant))
        t11JsonValue(ref w, for: "hit", by: e.hit ? "true" : "false")
        if e.unknown {
            t11JsonValue(ref w, for: "unknown", by: "true")
        }
        t11JsonOpen(ref w, for: "origins", by: "[")
        for o in e.origins {
            t11JsonValue(ref w, for: null, by: t11JsonString(o))
        }
        t11JsonClose(ref w, by: "]")
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
}

/// QualityReport.cs:332 `Listing`: `+` hit, `-` missed, `~` unknown, blank for no counter, then the source line.
string qualityListing(in QualityFile f, from in List<string> sourceLines) uses alloc {
    var sb = StrBuf()
    for i in 0..sourceLines.length {
        let n = i + 1
        let gutter = t11Has(
            in f.coveredLines,
            for: n,
        ) ? "+" : t11Has(in f.missedLines, for: n) ? "-" : t11Has(in f.unknownLines, for: n) ? "~" : " "
        sb.append($"{gutter} {sourceLines[i]}\n")
    }
    return $"{sb.finish()}"
}

/// QualityReport.cs:344 `Percent`.
string qualityPercent(in QualityTally t) uses alloc => t.total == 0 ? "100%" : $"{gatesFmt(t.covered, by: t.total)}%"

/// QualityReport.cs:347 `CoverageSummary`.
string qualityCoverageSummary(in QualityReport r) uses alloc {
    var sb = StrBuf()
    sb.append(
        $"coverage: lines {r.lines.covered}/{r.lines.total} ({qualityPercent(in r.lines)}), branches {r.branches.covered}/{r.branches.total} ({qualityPercent(in r.branches)}), error paths {r.errorPaths.covered}/{r.errorPaths.total} ({qualityPercent(in r.errorPaths)})\n",
    )
    for f in r.files {
        let lines = f.coveredLines.length + f.missedLines.length + f.unknownLines.length
        sb.append(
            $"  {f.path}: lines {f.coveredLines.length}/{lines}, branches {qualityHitBranches(in f)}/{f.branches.length}, error paths {qualityHitErrorPaths(in f)}/{f.errorPaths.length}\n",
        )
        for b in f.branches {
            continue if b.status == "hit"
            sb.append(
                $"{b.status == "missed" ? "uncovered" : "unknown"} branch: {f.path}:{b.line}:{b.column} never {b.outcome ? "true" : "false"}\n",
            )
        }
        for e in f.errorPaths {
            continue if e.hit
            sb.append($"{e.unknown ? "unknown" : "uncovered"} error path: {f.path}: {e.function} {e.variant}\n")
        }
    }
    return $"{sb.finish()}"
}

/// Gates.cs:15 `Coverage`: the measures below their minimum percentages (null: no minimum).
List<GateFailure> gatesCoverage(
    in QualityReport report,
    by i64? minLines,
    for i64? minBranches,
    through i64? minErrorPaths
) uses alloc {
    var failures = List<GateFailure>()
    var covered: i64 = 0
    var missing = List<string>()
    for f in report.files {
        covered += f.coveredLines.length
        for l in f.missedLines {
            missing.append($"uncovered line: {f.path}:{l}")
        }
    }
    gatesAdd(ref failures, for: "lines", by: minLines, through: covered, from: move missing)
    covered = 0
    var branches = List<string>()
    for f in report.files {
        covered += qualityHitBranches(in f)
        for b in f.branches {
            if b.status == "missed" {
                branches.append($"uncovered branch: {f.path}:{b.line}:{b.column} never {b.outcome ? "true" : "false"}")
            }
        }
    }
    gatesAdd(ref failures, for: "branches", by: minBranches, through: covered, from: move branches)
    covered = 0
    var errors = List<string>()
    for f in report.files {
        covered += qualityHitErrorPaths(in f)
        for e in f.errorPaths {
            if !e.hit && !e.unknown {
                errors.append($"uncovered error path: {e.function} {e.variant} ({f.path})")
            }
        }
    }
    gatesAdd(ref failures, for: "error paths", by: minErrorPaths, through: covered, from: move errors)
    return failures
}

/// Gates.cs:43 `Add`: the missing count is `missing`'s length unless `missingCount` is given.
void gatesAdd(
    ref List<GateFailure> failures,
    for string name,
    by i64? min,
    through i64 covered,
    from move List<string> missing,
    i64? missingCount = null
) uses alloc {
    let total = covered + (missingCount ?? missing.length)
    let m = min ?? return
    return if covered * 100 >= m * total
    failures.append(GateFailure { name: name, covered: covered, total: total, min: m, missing: move missing })
}

/// Gates.cs:32 `Mutation`: (killed + timeout) / (killed + timeout + survived) against the minimum; each survivor named.
List<GateFailure> gatesMutation(in MutationReport report, by i64? minMutation) uses alloc {
    var failures = List<GateFailure>()
    var missing = List<string>()
    for f in report.files {
        for m in f.mutants {
            if m.status == "survived" {
                missing.append(
                    $"survived mutant: {m.site.file}:{m.site.line}:{m.site.column} {m.site.op} `{m.site.original}` -> `{m.site.mutated}`",
                )
            }
        }
    }
    gatesAdd(
        ref failures,
        for: "mutation",
        by: minMutation,
        through: report.totals[0] + report.totals[2],
        from: move missing,
        missingCount: report.totals[1],
    )
    return failures
}

/// Gates.cs:51 `Fmt` of `100.0 * covered / total` (`0.###`): rounded to thousandths, half away from zero, trailing zeros dropped.
string gatesFmt(i64 covered, by i64 total) uses alloc {
    let thousandths = (200000 * covered + total) / (2 * total)
    let whole = thousandths / 1000
    let rest = thousandths % 1000
    return $"{whole}" if rest == 0
    var digits = rest < 10 ? $"00{rest}" : rest < 100 ? $"0{rest}" : $"{rest}"
    while digits.endsWith("0") {
        digits = digits[0..digits.length - 1]
    }
    return $"{whole}.{digits}"
}

/// `IReadOnlyList<int>.Contains` (QualityReport.cs:338).
bool t11Has(in List<i64> xs, for i64 x) {
    for y in xs {
        return true if y == x
    }
    return false
}

/// `ReportMutant` (QualityReport.cs:15): `status` is killed, survived, timeout, marked or not_reached.
struct ReportMutant {
    ExternalSite site
    string       status
    i64?         killedBy   = null
    string?      suggestion = null
}

/// `ReportFile` (QualityReport.cs:34) of a mutation report.
struct MutationFile {
    string path
    List<ReportMutant> mutants = []
}

/// One entry of `Operators` (QualityReport.cs:41): the operator and its counts in `Counts` order.
struct MutationOperator {
    string    op
    List<i64> counts = [0, 0, 0, 0, 0, 0]
}

/// A mutation `QualityReport` (QualityReport.cs:40, `Kind` "mutation"): build and total time in nanoseconds, the rest of
/// `ReportTiming` in seconds; `totals` and each operator's counts in `Counts` order.
struct MutationReport {
    string                 tool
    i64                    buildNanos = 0
    i64                    totalNanos = 0
    f64                    mean       = 0.0
    f64                    max        = 0.0
    f64                    share      = 0.0
    List<MutationFile>     files      = []
    List<i64>              totals     = [0, 0, 0, 0, 0, 0]
    List<MutationOperator> operators  = []
}

/// QualityReport.cs:43 `Counts`.
List<string> qualityCounts() uses alloc => ["killed", "survived", "timeout", "marked", "not_reached", "not_emitted"]

/// QualityReport.cs:47 `Suggest`: the sentence that says what test is missing, one per operator.
string qualitySuggest(string op) {
    switch op {
        case "boundary":
            return "add a case at the boundary value"
        case "relational":
            return "add a case where the two operands are equal and one where they differ"
        case "logical":
            return "add a case where exactly one operand holds"
        case "condition":
            return "add a case where the condition is false and one where it is true, and assert the difference"
        case "bool":
            return "add a case that depends on this value"
        case "arithmetic":
            return "add a case whose result differs under the changed operator"
        case "literal":
            return "add a case that depends on this exact number"
        case "negation":
            return "add a case with a non-zero operand and assert the sign"
        case "statement":
            return "assert the effect of this statement"
        case "emptyReturn":
            return "assert the returned value is not the empty value"
        case "variant":
            return "add a case that asserts which error variant is returned"
        default:
            return "add a case that fails under this change"
    }
}

/// QualityReport.cs:64 `Mutation` of a `MutationResult`: the schema's not-emitted counts, and each mutant's killing test.
MutationReport qualityMutationResult(
    string tool,
    from in MutationResult result,
    by in emitter.Schema schema,
    through i64 buildNanos,
    for in List<f64> mutantSeconds,
    as i64 totalNanos
) uses alloc {
    var notEmitted = List<MutationOperator>()
    // `Schema.NotEmitted` has every operator of `Mutator.Operators`, in that order, and no other (schemata.byn `find`).
    for op in emitter.mutatorOperators() {
        let k = qualityOperator(ref notEmitted, for: op)
        notEmitted[k].counts[5] = schema.notEmitted[op]
    }
    return qualityMutationOf(
        tool,
        from: in result.mutants,
        by: in notEmitted,
        through: buildNanos,
        for: in mutantSeconds,
        as: totalNanos,
    )
}

/// QualityReport.cs:70 `Mutation` of an external-mode run (R3): the candidates not emitted are the results with that status.
MutationReport qualityMutation(string tool, from in List<ExternalResult> results, by i64 buildNanos, as i64 totalNanos)
        uses alloc {
    var notEmitted = List<MutationOperator>()
    var seconds = List<f64>()
    var mutants = List<MutantResult>()
    for r in results {
        mutants.append(MutantResult { site: r.site, status: r.status })
        if r.status != .notEmitted {
            seconds.append(r.seconds)
            continue
        }
        let k = qualityOperator(ref notEmitted, for: r.site.op)
        notEmitted[k].counts[5] += 1
    }
    return qualityMutationOf(
        tool,
        from: in mutants,
        by: in notEmitted,
        through: buildNanos,
        for: in seconds,
        as: totalNanos,
    )
}

/// QualityReport.cs:77 `Mutation`; `notEmitted` carries each operator's count in its `not_emitted` slot.
MutationReport qualityMutationOf(
    string tool,
    from in List<MutantResult> mutants,
    by in List<MutationOperator> notEmitted,
    through i64 buildNanos,
    for in List<f64> mutantSeconds,
    as i64 totalNanos
) uses alloc {
    var report = MutationReport { tool: tool, buildNanos: buildNanos, totalNanos: totalNanos }
    var sum = 0.0
    for x in mutantSeconds {
        sum += x
        if x > report.max {
            report.max = x
        }
    }
    if mutantSeconds.length > 0 {
        report.mean = sum / f64(mutantSeconds.length)
    }
    let build = f64(buildNanos / 100) / 1e7
    if build > 0.0 {
        report.share = report.mean / build
    }
    for op in emitter.mutatorOperators() {
        let _ = qualityOperator(ref report.operators, for: op)
    }
    for n in notEmitted {
        let k = qualityOperator(ref report.operators, for: n.op)
        report.operators[k].counts[5] = n.counts[5]
    }
    for m in mutants {
        continue if m.status == .notEmitted
        let slot = qualitySlot(m.status)
        let k = qualityOperator(ref report.operators, for: m.site.op)
        report.operators[k].counts[slot] += 1
        var f: i64 = -1
        for i in 0..report.files.length {
            if report.files[i].path == m.site.file {
                f = i
            }
        }
        if f < 0 {
            f = report.files.length
            report.files.append(MutationFile { path: m.site.file })
        }
        report.files[f].mutants.append(
            ReportMutant {
                site: m.site,
                status: qualityCounts()[slot],
                killedBy: m.killedBy,
                suggestion: m.status == .survived ? qualitySuggest(m.site.op) : null,
            },
        )
    }
    for o in report.operators {
        for c in 0..6 {
            report.totals[c] += o.counts[c]
        }
    }
    return report
}

/// The index of `op` in `operators`, appended with zero counts when absent (the C# `Dictionary`, which keeps insertion order).
i64 qualityOperator(ref List<MutationOperator> operators, for string op) uses alloc {
    for i in 0..operators.length {
        return i if operators[i].op == op
    }
    operators.append(MutationOperator { op: op })
    return operators.length - 1
}

/// QualityReport.cs:139 `StatusName` as an index into `Counts`.
i64 qualitySlot(MutantStatus s) {
    switch s {
        case .killed:
            return 0
        case .survived:
            return 1
        case .timeout:
            return 2
        case .marked:
            return 3
        case .notReached:
            return 4
        case .notEmitted:
            // coverage-exempt: Q1258 `Mutation` skips a not-emitted mutant before it asks for the name
            return 5
    }
}

/// QualityReport.cs:150 `Json` of a mutation report: `bayan-quality.json`.
string qualityMutationJson(in MutationReport r) uses alloc {
    var w = T11Json {}
    t11JsonOpen(ref w, for: null, by: "{")
    t11JsonValue(ref w, for: "version", by: "1")
    t11JsonValue(ref w, for: "kind", by: t11JsonString("mutation"))
    t11JsonValue(ref w, for: "tool", by: t11JsonString(r.tool))
    t11JsonOpen(ref w, for: "timing", by: "{")
    t11JsonValue(ref w, for: "build_s", by: r.buildNanos == 0 ? "0" : t11JsonSeconds(r.buildNanos))
    t11JsonValue(ref w, for: "mean_mutant_s", by: qualityJsonNumber(r.mean))
    t11JsonValue(ref w, for: "max_mutant_s", by: qualityJsonNumber(r.max))
    t11JsonValue(ref w, for: "total_s", by: t11JsonSeconds(r.totalNanos))
    t11JsonValue(ref w, for: "mutant_share_of_build", by: qualityJsonNumber(r.share))
    t11JsonClose(ref w, by: "}")
    t11JsonOpen(ref w, for: "files", by: "[")
    for f in r.files {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "path", by: t11JsonString(f.path))
        t11JsonOpen(ref w, for: "mutants", by: "[")
        for m in f.mutants {
            t11JsonOpen(ref w, for: null, by: "{")
            t11JsonOpen(ref w, for: "site", by: "{")
            t11JsonValue(ref w, for: "id", by: $"{m.site.id}")
            t11JsonValue(ref w, for: "file", by: t11JsonString(m.site.file))
            t11JsonValue(ref w, for: "line", by: $"{m.site.line}")
            t11JsonValue(ref w, for: "column", by: $"{m.site.column}")
            t11JsonValue(ref w, for: "operator", by: t11JsonString(m.site.op))
            t11JsonValue(ref w, for: "original", by: t11JsonString(m.site.original))
            t11JsonValue(ref w, for: "mutated", by: t11JsonString(m.site.mutated))
            if (m.site.unobservable is { } u) {
                t11JsonValue(ref w, for: "unobservable", by: t11JsonString(u))
            }
            t11JsonClose(ref w, by: "}")
            t11JsonValue(ref w, for: "status", by: t11JsonString(m.status))
            if (m.killedBy is { } k) {
                t11JsonValue(ref w, for: "killedBy", by: $"{k}")
            }
            if (m.suggestion is { } s) {
                t11JsonValue(ref w, for: "suggestion", by: t11JsonString(s))
            }
            t11JsonClose(ref w, by: "}")
        }
        t11JsonClose(ref w, by: "]")
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
    qualityWriteCounts(ref w, for: "totals", by: in r.totals)
    t11JsonOpen(ref w, for: "operators", by: "{")
    for o in r.operators {
        qualityWriteCounts(ref w, for: o.op, by: in o.counts)
    }
    t11JsonClose(ref w, by: "}")
    t11JsonClose(ref w, by: "}")
    return $"{t11JsonText(in w)}\n"
}

/// QualityReport.cs:274 `WriteCounts`.
void qualityWriteCounts(ref T11Json w, for string name, by in List<i64> counts) uses alloc {
    t11JsonOpen(ref w, for: name, by: "{")
    let names = qualityCounts()
    for c in 0..6 {
        t11JsonValue(ref w, for: names[c], by: $"{counts[c]}")
    }
    t11JsonClose(ref w, by: "}")
}

/// QualityReport.cs:314 `Summary`: totals, each survivor with its suggestion, per-operator counts, timing and the warnings.
string qualitySummary(in MutationReport r, by in List<string> warnings) uses alloc {
    var sb = StrBuf()
    sb.append(
        $"mutation: {r.totals[0]} killed, {r.totals[1]} survived, {r.totals[2]} timeout, {r.totals[3]} marked, {r.totals[4]} not reached, {r.totals[5]} not emitted\n",
    )
    for f in r.files {
        for m in f.mutants {
            continue if m.status != "survived"
            let s = m.site
            sb.append(
                $"survived: {s.file}:{s.line}:{s.column}: {s.original} → {s.mutated} [{s.op}]\n  suggestion: {m.suggestion ?? ""}\n",
            )
        }
    }
    sb.append("operators:\n")
    let names = qualityCounts()
    for o in r.operators {
        sb.append($"  {o.op}: ")
        for c in 0..6 {
            sb.append($"{c > 0 ? ", " : ""}{o.counts[c]} {names[c].replaced("_", by: " ")}")
        }
        sb.append("\n")
    }
    let build = f64(r.buildNanos / 100) / 1e7
    let total = f64(r.totalNanos / 100) / 1e7
    sb.append(
        $"timing: build {qualityFmt(build)} s, mean {qualityFmt(r.mean)} s and max {qualityFmt(r.max)} s per mutant, total {qualityFmt(total)} s, mutant share of build {qualityFmt(r.share * 100.0)}%\n",
    )
    for w in warnings {
        sb.append($"{w}\n")
    }
    return $"{sb.finish()}"
}

/// QualityReport.cs:311 `Fmt` (`0.###`) of a non-negative value: rounded to thousandths, trailing zeros dropped.
string qualityFmt(f64 v) uses alloc {
    let thousandths = i64(v * 1000.0 + 0.5)
    let whole = thousandths / 1000
    let rest = thousandths % 1000
    return $"{whole}" if rest == 0
    var digits = rest < 10 ? $"00{rest}" : rest < 100 ? $"0{rest}" : $"{rest}"
    while digits.endsWith("0") {
        digits = digits[0..digits.length - 1]
    }
    return $"{whole}.{digits}"
}

/// `Utf8JsonWriter.WriteNumberValue(double)` of a non-negative value: the shortest round-trip digits, in `E` notation (`1E-05`,
/// `1.5E+17`) when the decimal exponent is below -4 or above 16, else in plain digits.
string qualityJsonNumber(f64 v) uses alloc {
    let text = $"{v}"
    // `text` as `0.<digits> × 10^point`: digits without the point, leading zeros dropped.
    var digits = ""
    var point: i64 = 0
    var seenPoint = false
    var exponent: i64 = 0
    var negative = false
    var inExponent = false
    for i in 0..text.length {
        let c = text[i..i + 1]
        if inExponent {
            if c == "-" {
                negative = true
            } else {
                exponent = exponent * 10 + i64(text.bytes[i]) - 48
            }
        } else if c == "e" {
            inExponent = true
        } else if c == "." {
            seenPoint = true
        } else if c == "0" && digits.length == 0 {
            if seenPoint {
                point -= 1
            }
        } else {
            digits = $"{digits}{c}"
            unless seenPoint {
                point += 1
            }
        }
    }
    while digits.endsWith("0") {
        digits = digits[0..digits.length - 1]
    }
    return "0" if digits.length == 0
    point += negative ? -exponent : exponent
    let scientific = point - 1
    if scientific is < -4 or > 16 {
        let mantissa = digits.length > 1 ? $"{digits[0..1]}.{digits[1..digits.length]}" : digits
        let size = scientific < 0 ? -scientific : scientific
        return $"{mantissa}E{scientific < 0 ? "-" : "+"}{size < 10 ? "0" : ""}{size}"
    }
    if point <= 0 {
        var zeros = ""
        for _ in 0..-point {
            zeros = $"{zeros}0"
        }
        return $"0.{zeros}{digits}"
    }
    if point >= digits.length {
        var whole = digits
        for _ in 0..point - digits.length {
            whole = $"{whole}0"
        }
        return whole
    }
    return $"{digits[0..point]}.{digits[point..digits.length]}"
}

/// QualityReport.cs:281 `Warnings`: the marked mutants a test killed, and the marks that cover no mutant (R7), each a one-line
/// warning; a mark whose file is not among `sources` is at 0:0.
List<string> qualityWarnings(
    in MutationResult result,
    by in emitter.Schema schema,
    for in semantics.Ctx c,
    from in List<lexer.SourceText> sources
) uses alloc {
    var warnings = List<string>()
    for m in result.mutants {
        if (m.site.unobservable is { } u) {
            if m.status is .killed or .timeout {
                warnings.append(
                    $"warning: {qualityWhere(in m.site)}: the mark is wrong: a test sees this ({m.site.original} → {m.site.mutated}, `{u}`)",
                )
            }
        }
    }
    for mark in c.unobservable {
        var found: i64 = -1
        for i in 0..sources.length {
            if found < 0 && sources[i].path == mark.file {
                found = i
            }
        }
        if found < 0 {
            warnings.append($"warning: {mark.file}:0:0: the mark covers no mutant (`{mark.reason}`)")
            continue
        }
        var source = lexer.SourceText.create(sources[found].path, from: sources[found].bytes.copy())
        var covered = false
        for s in schema.sites {
            if qualityInMark(in mark, for: in s.site, through: ref source) {
                covered = true
            }
        }
        continue if covered
        let at = source.getLinePosition(mark.span.start)
        warnings.append($"warning: {mark.file}:{at.line}:{at.column}: the mark covers no mutant (`{mark.reason}`)")
    }
    return warnings
}

/// QualityReport.cs:297 `InMark`: whether the site lies inside the mark's statement and the mark's operator argument, if any, is the
/// site's.
bool qualityInMark(
    in semantics.UnobservableMark mark,
    for in emitter.MutationSite site,
    through ref lexer.SourceText source
) uses alloc {
    return false if site.file != mark.file || (mark.op is not null && mark.op != site.op)
    var offset = source.getLineSpan(site.line - 1).start
    for _ in 1..site.column {
        offset += 1
        while offset < source.bytes.length && (source.bytes[offset] & 0xC0) == 0x80 {
            offset += 1
        }
    }
    return mark.span.start <= offset && offset + site.original.bytes.length <= mark.span.start + mark.span.length
}

/// QualityReport.cs:307 `Where`.
string qualityWhere(in ExternalSite s) uses alloc => $"{s.file}:{s.line}:{s.column}"
