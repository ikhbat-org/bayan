// T18: BinderExpressions.cs ~600-1155 (members, index, slice).

import lexer
import parser

enum MemberRefKind {
    none
    field
    propertyKeyword
    method
}

// The C# `Symbol?` `lookupMember` returns: a field, property or method of a type, by its arena id.
struct MemberRef {
    MemberRefKind kind
    i64 id = -1
}

struct RenamedResult {
    string   oldName
    string   newName
    bool     hasFix
    TextSpan fixSpan     = TextSpan { start: 0, length: 0 }
    string   replacement = ""
}

// ── Private helpers ──────────────────────────────────────────────────────────

string t18Text(in Ctx c, from FileId f, at TextSpan span) =>
    span.start < 0 ? c.syntheticNames[-1 - span.start] : $"{getText(c.files[f].text.span, at: span)}"

bool t18ContainsBraces(string text) {
    for b in text.bytes {
        return true if b is 0x7B or 0x7D
    }
    return false
}

// ── Entry points ─────────────────────────────────────────────────────────────

BExpr constantRef(ref Binder b, through ref Ctx c, at TextSpan span, for ConstId k) =>
    t21ConstantRef(ref b, through: ref c, at: span, for: k, from: -1)

/// `constantRef` that records `syntax` as the C# `Syntax` of the node it returns (Q849).
BExpr t21ConstantRef(ref Binder b, through ref Ctx c, at TextSpan span, for ConstId k, from i64 syntax) {
    bindConstant(ref c, for: k)
    return recordSyntaxNode(
        ref c,
        for: addStaticArray(ref c, from: BStaticArray { span: span, constId: k, type: c.consts[k].type }),
        at: syntax,
    ) if c.consts[k].isStaticArray
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: span }),
        at: syntax,
    ) if !(c.consts[k].value is { } value)
    return t21ConstantLiteral(ref c, at: span, as: c.consts[k].type, by: in value, from: syntax)
}

BExpr constantLiteral(ref Ctx c, at TextSpan span, as Type type, by in Constant value) =>
    t21ConstantLiteral(ref c, at: span, as: type, by: in value, from: -1)

/// `constantLiteral` that records `syntax` as the C# `Syntax` of the literal (Q849).
BExpr t21ConstantLiteral(ref Ctx c, at TextSpan span, as Type type, by in Constant value, from i64 syntax) {
    if type == builtinType(.symbol) {
        let sLit = addSymbolLiteral(ref c, from: BSymbolLiteral { span: span, text: value.text })
        setConstant(ref c, for: sLit, to: value)
        return recordSyntaxNode(ref c, for: sLit, at: syntax)
    }
    let lit = addLiteral(ref c, from: BLiteral { span: span, type: type, value: value })
    setConstant(ref c, for: lit, to: value)
    return recordSyntaxNode(ref c, for: lit, at: syntax)
}

MemberRef lookupMember(ref Ctx c, for Type t, by string name) {
    let tk = kindOf(t)
    if tk == .structType {
        let s = typeIndex(t)
        let f = findField(ref c, by: s, for: name)
        return MemberRef { kind: .field, id: f } if f != -1
        let p = findProperty(ref c, by: s, for: name)
        return MemberRef { kind: .propertyKeyword, id: p } if p != -1
        let methods = findMethods(ref c, by: s, for: name)
        return MemberRef { kind: .method, id: methods[0] } if methods.length > 0
    }
    if tk == .typeParam {
        for iface in copyIds(in c.typeParams[typeIndex(t)].constraints) {
            let p = findInterfaceProperty(ref c, by: iface, for: name)
            return MemberRef { kind: .method, id: p } if p != -1
            let methods = findInterfaceMethods(ref c, by: iface, for: name)
            return MemberRef { kind: .method, id: methods[0] } if methods.length > 0
        }
    }
    return MemberRef { kind: .none, id: -1 }
}

BExpr bindImplicitThisMember(ref Binder b, through ref Ctx c, for in parser.NameExpr n, by MemberRef member) {
    let syntax = syntaxLeaf(ref c, as: .nameExpr, at: n.span)
    let hostFn = host(b, through: c)
    let inInstance = hostFn != -1
        && !c.functions[hostFn].isStatic
        && (c.functions[hostFn].kind is .method or .getter or .constructor)
    return recordSyntaxNode(
        ref c,
        for: addMethodGroup(
            ref c,
            from: BMethodGroup { span: n.span, receiver: -1, function: member.id, typeArgs: List<TextSpan>() },
        ),
        at: syntax,
    ) if member.kind == .method
        && c.functions[member.id].isStatic
    let nameText = t18Text(in c, from: b.file, at: n.name)
    if !inInstance {
        let staticHost = host(b, through: c)
        let helpText = staticHost != -1
            && c.functions[staticHost].isStatic ? "call it on an instance; a `static` method has no `this`" : "set it in a constructor; field defaults cannot read other fields"
        report(
            ref b,
            through: ref c,
            for: .instanceMemberWithoutThis,
            at: n.span,
            by: (nameText, "", "", "", ""),
            help: helpText,
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }
    if inLambda(
        ref b,
        through: ref c,
        at: n.span,
        for: nameText,
        by: "it is read through `this`, which a lambda does not capture"
    ) {
        @unobservable because "Q607: inLambda is a stub; add a lambda read of an implicit this member when T35 lands"
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }
    let self = recordSyntaxNode(ref c, for: addThis(ref c, from: BThis { span: n.span, type: b.thisType }), at: syntax)
    switch member.kind {
        case .field:
            return recordSyntaxNode(
                ref c,
                for: addField(
                    ref c,
                    from: BField { span: n.span, receiver: self, field: member.id, type: c.fields[member.id].type },
                ),
                at: syntax,
            )
        case .propertyKeyword:
            return recordSyntaxNode(
                ref c,
                for: addCall(
                    ref c,
                    from: BCall {
                        span: n.span,
                        function: c.properties[member.id].getter,
                        receiver: self,
                        arguments: List<BExpr>(),
                        type: c.properties[member.id].type,
                    },
                ),
                at: syntax,
            )
        case .method:
            if c.functions[member.id].kind == .getter {
                @unobservable because "Q607: declareInterfaceMembers is a stub; add a getter-through-interface case when T38 lands"
                return recordSyntaxNode(
                    ref c,
                    for: addCall(
                        ref c,
                        from: BCall {
                            span: n.span,
                            function: member.id,
                            receiver: self,
                            arguments: List<BExpr>(),
                            type: c.functions[member.id].returnType,
                        },
                    ),
                    at: syntax,
                )
            }
            return recordSyntaxNode(
                ref c,
                for: addMethodGroup(
                    ref c,
                    from: BMethodGroup {
                        span: n.span,
                        receiver: self,
                        function: member.id,
                        typeArgs: List<TextSpan>(),
                    },
                ),
                at: syntax,
            )
        default:
            // coverage-exempt: Q853
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }
}

BExpr bindMember(ref Binder b, through ref Ctx c, for in parser.MemberExpr m) {
    let syntax = syntaxOfMember(ref c, from: in m)
    if m.nullConditional {
        report(ref b, through: ref c, for: .unsupported, at: m.span, by: ("`?.`", "", "", "", ""))
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
    }
    let target = bindExprOrType(ref b, through: ref c, for: in m.target)
    let name = t18Text(in c, from: b.file, at: m.member)
    let bk = boundKind(target)
    return target if bk == .errorExpr
    return t18BindModuleMember(
        ref b,
        through: ref c,
        for: m,
        to: c.bModuleRefs[boundIndex(target)].module,
        from: syntax,
    ) if bk == .moduleRef
    if bk == .typeRef {
        let refType = c.bTypeRefs[boundIndex(target)].referenced
        let tk = kindOf(refType)
        if tk == .errorSet {
            let set = typeIndex(refType)
            let variant = findErrorVariant(ref c, by: set, for: name)
            return recordSyntaxNode(
                ref c,
                for: addErrorVariant(ref c, from: BErrorVariant { span: m.span, variant: variant, type: refType }),
                at: syntax,
            ) if variant != -1
            var varNames = List<string>()
            for v in c.errorSets[set].variants {
                varNames.append(c.errorVariants[v].name)
            }
            let close = suggest(name, by: in varNames)
            let help = close is { } ? $"did you mean `{close}`?" : ""
            report(
                ref b,
                through: ref c,
                for: .unknownVariant,
                at: m.member,
                by: (name, errorSetDisplayName(ref c, by: set), "", "", ""),
                help: help,
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
        }
        return t18BindEnumStatic(ref b, through: ref c, for: m, to: typeIndex(refType), from: syntax) if tk == .enumType
        return t18BindVariant(
            ref b,
            through: ref c,
            at: m.span,
            by: m.member,
            to: typeIndex(refType),
            from: syntax,
        ) if tk == .unionType
        if tk == .structType {
            let s = typeIndex(refType)
            let methods = findMethods(ref c, by: s, for: name)
            let method: FuncId = methods.length > 0 ? methods[0] : -1
            if method != -1 && c.functions[method].isStatic {
                checkAccess(
                    ref b,
                    through: ref c,
                    for: c.functions[method].access,
                    from: c.functions[method].owner,
                    by: c.functions[method].module,
                    at: m.member,
                )
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: method, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            let help = (method != -1
                || findField(ref c, by: s, for: name) != -1
                || findProperty(
                    ref c,
                    by: s,
                    for: name,
                ) != -1) ? $"call it on a `{c.structs[s].name}` value; `{name}` belongs to a value, not the type" : ""
            report(
                ref b,
                through: ref c,
                for: .unknownMember,
                at: m.member,
                by: (name, c.structs[s].name, "", "", ""),
                help: help,
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
        }
        if tk == .builtin {
            let bKind = builtinKindOf(typeIndex(refType))
            if bKind == .io {
                let member = findIo(ref c, for: name)
                if member == -1 {
                    let near = suggest(
                        name,
                        by: in [
                            "readFile",
                            "readText",
                            "writeFile",
                            "remove",
                            "createDirectory",
                            "removeDirectory",
                            "listDir",
                            "run",
                            "runBatch",
                            "monotonicNanos",
                            "randomU64",
                            "stdout",
                            "stderr",
                            "stdin",
                        ],
                    )
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(
                        ref b,
                        through: ref c,
                        for: .unknownMember,
                        at: m.member,
                        by: (name, builtinName(bKind), "", "", ""),
                        help: help,
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }),
                        at: syntax,
                    )
                }
                return recordSyntaxNode(
                    ref c,
                    for: addCall(
                        ref c,
                        from: BCall {
                            span: m.span,
                            function: member,
                            receiver: -1,
                            arguments: List<BExpr>(),
                            type: c.functions[member].returnType,
                        },
                    ),
                    at: syntax,
                ) if c.functions[member].builtin is .ioStdout
                    or .ioStderr
                    or .ioStdin
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            if bKind == .hex {
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup {
                            span: m.span,
                            receiver: -1,
                            function: t9Function(ref c, for: "Hex.encode"),
                            typeArgs: List<TextSpan>(),
                        },
                    ),
                    at: syntax,
                ) if name == "encode"
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup {
                            span: m.span,
                            receiver: -1,
                            function: t9Function(ref c, for: "Hex.decode"),
                            typeArgs: List<TextSpan>(),
                        },
                    ),
                    at: syntax,
                ) if name == "decode"
                let near = suggest(name, by: in ["encode", "decode"])
                let help = near is { } ? $"did you mean `{near}`?" : ""
                report(
                    ref b,
                    through: ref c,
                    for: .unknownMember,
                    at: m.member,
                    by: (name, builtinName(bKind), "", "", ""),
                    help: help,
                )
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
            if bKind == .symbol {
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup {
                            span: m.span,
                            receiver: -1,
                            function: t9Function(ref c, for: "Symbol.intern"),
                            typeArgs: List<TextSpan>(),
                        },
                    ),
                    at: syntax,
                ) if name == "intern"
                let near = suggest(name, by: in ["intern"])
                let help = near is { } ? $"did you mean `{near}`?" : ""
                report(
                    ref b,
                    through: ref c,
                    for: .unknownMember,
                    at: m.member,
                    by: (name, builtinName(bKind), "", "", ""),
                    help: help,
                )
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
            if bKind == .utf8 {
                let member = findUtf8(ref c, for: name)
                if member == -1 {
                    let near = suggest(name, by: in ["decode", "tryDecode"])
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(
                        ref b,
                        through: ref c,
                        for: .unknownMember,
                        at: m.member,
                        by: (name, builtinName(bKind), "", "", ""),
                        help: help,
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }),
                        at: syntax,
                    )
                }
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            if bKind == .path {
                let member = findPath(ref c, for: name)
                if member == -1 {
                    let near = suggest(
                        name,
                        by: in ["isRooted", "relative", "fileName", "directoryName", "combine", "fullPath"],
                    )
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(
                        ref b,
                        through: ref c,
                        for: .unknownMember,
                        at: m.member,
                        by: (name, builtinName(bKind), "", "", ""),
                        help: help,
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }),
                        at: syntax,
                    )
                }
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            if bKind == .env {
                let member = findEnv(ref c, for: name)
                if member == -1 {
                    let near = suggest(name, by: in ["get"])
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(
                        ref b,
                        through: ref c,
                        for: .unknownMember,
                        at: m.member,
                        by: (name, builtinName(bKind), "", "", ""),
                        help: help,
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }),
                        at: syntax,
                    )
                }
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            if bKind == .fs {
                let member = findFs(ref c, for: name)
                if member == -1 {
                    let near = suggest(
                        name,
                        by: in ["fileExists", "rename", "copy", "modified", "setModified", "realPath"],
                    )
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(
                        ref b,
                        through: ref c,
                        for: .unknownMember,
                        at: m.member,
                        by: (name, builtinName(bKind), "", "", ""),
                        help: help,
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }),
                        at: syntax,
                    )
                }
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            if bKind == .time {
                let member = findTime(ref c, for: name)
                if member == -1 {
                    let near = suggest(name, by: in ["now", "fromNanos"])
                    let help = near is { } ? $"did you mean `{near}`?" : ""
                    report(
                        ref b,
                        through: ref c,
                        for: .unknownMember,
                        at: m.member,
                        by: (name, builtinName(bKind), "", "", ""),
                        help: help,
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }),
                        at: syntax,
                    )
                }
                return recordSyntaxNode(
                    ref c,
                    for: addMethodGroup(
                        ref c,
                        from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                    ),
                    at: syntax,
                )
            }
            if bKind == .target {
                if name is "os" or "arch" {
                    if (c.target is { } buildTarget) {
                        let split = hostTargetSplit(buildTarget)
                        let text = Constant { kind: .text, text: name == "os" ? split.os : split.arch }
                        return recordSyntaxNode(
                            ref c,
                            for: literal(ref c, at: m.span, as: prim(.string), by: text),
                            at: syntax,
                        )
                    }
                    return recordSyntaxNode(
                        ref c,
                        for: addHostTarget(ref c, from: BHostTarget { span: m.span, isOs: name == "os" }),
                        at: syntax,
                    )
                }
                let near = suggest(name, by: in ["os", "arch"])
                let help = near is { } ? $"did you mean `{near}`?" : ""
                report(
                    ref b,
                    through: ref c,
                    for: .unknownMember,
                    at: m.member,
                    by: (name, builtinName(bKind), "", "", ""),
                    help: help,
                )
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
        }
        if isString(refType) {
            let member = findString(ref c, for: name)
            return recordSyntaxNode(
                ref c,
                for: addMethodGroup(
                    ref c,
                    from: BMethodGroup { span: m.span, receiver: -1, function: member, typeArgs: List<TextSpan>() },
                ),
                at: syntax,
            ) if member != -1
            let codec = (name is "from" or "fromUtf8") ? "Utf8.decode" : (name == "tryFrom" ? "Utf8.tryDecode" : "")
            if codec != "" {
                report(
                    ref b,
                    through: ref c,
                    for: .renamedMember,
                    at: m.member,
                    by: ($"string.{name}", codec, "", "", ""),
                    label: "the old name",
                    help: $"write `{codec}`",
                    hasFix: true,
                    fixSpan: m.span,
                    fixReplacement: codec,
                )
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
            }
            let near = suggest(name, by: in ["invalidUtf8At"])
            let help = near is { } ? $"did you mean `{near}`?" : ""
            report(
                ref b,
                through: ref c,
                for: .unknownMember,
                at: m.member,
                by: (name, primitiveName(primKindOf(typeIndex(refType))), "", "", ""),
                help: help,
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
        }
        report(
            ref b,
            through: ref c,
            for: .unknownMember,
            at: m.member,
            by: (name, typeDisplay(ref c, by: refType), "", "", ""),
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
    }
    return t21BindValueMember(ref b, through: ref c, at: m.span, for: target, by: m.member, from: syntax)
}

/// A unit variant is a value; a variant with a payload is called like a function.
BExpr t18BindVariant(
    ref Binder b,
    through ref Ctx c,
    at TextSpan syntaxSpan,
    by TextSpan memberSpan,
    to UnionId u,
    from i64 syntax
) {
    let name = t18Text(in c, from: b.file, at: memberSpan)
    let foundVariant = findUnionVariant(ref c, by: u, for: name)
    if foundVariant != -1 {
        return recordSyntaxNode(
            ref c,
            for: addUnionNew(
                ref c,
                from: BUnionNew {
                    span: syntaxSpan,
                    variant: foundVariant,
                    payload: List<BExpr>(),
                    type: makeType(.unionType, at: u),
                },
            ),
            at: syntax,
        ) if c.unionVariants[foundVariant].fields.length == 0
        return recordSyntaxNode(
            ref c,
            for: addVariantGroup(ref c, from: BVariantGroup { span: syntaxSpan, variant: foundVariant }),
            at: syntax,
        )
    }
    var variantNames = List<string>()
    for v in c.unions[u].variants {
        variantNames.append(c.unionVariants[v].name)
    }
    let close = suggest(name, by: in variantNames)
    let help = close is { } ? $"did you mean `{close}`?" : ""
    report(
        ref b,
        through: ref c,
        for: .unknownUnionVariant,
        at: memberSpan,
        by: (name, c.unions[u].name, "", "", ""),
        help: help,
    )
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: syntaxSpan }), at: syntax)
}

/// `Color.red`, `Color.count`, `Color.values`, `Color.fromOrdinal` and `Color.parse`.
BExpr t18BindEnumStatic(ref Binder b, through ref Ctx c, for parser.MemberExpr m, to EnumId e, from i64 syntax) {
    let name = t18Text(in c, from: b.file, at: m.member)
    let foundMember = findEnumMember(ref c, by: e, for: name)
    return recordSyntaxNode(
        ref c,
        for: addEnumMember(
            ref c,
            from: BEnumMember { span: m.span, member: foundMember, type: makeType(.enumType, at: e) },
        ),
        at: syntax,
    ) if foundMember != -1
    switch name {
        case "count":
            let count = Constant { kind: .integer, integer: bigFromI64(c.enums[e].members.length) }
            let lit = recordSyntaxNode(
                ref c,
                for: addLiteral(ref c, from: BLiteral { span: m.span, type: prim(.i64), value: count }),
                at: syntax,
            )
            setConstant(ref c, for: lit, to: count)
            return lit
        case "values":
            let spanT = internSpan(ref c, by: makeType(.enumType, at: e), readOnly: true)
            return recordSyntaxNode(
                ref c,
                for: addEnumValues(ref c, from: BEnumValues { span: m.span, enumId: e, type: spanT }),
                at: syntax,
            )
        case "fromOrdinal":
            return recordSyntaxNode(
                ref c,
                for: addMethodGroup(
                    ref c,
                    from: BMethodGroup {
                        span: m.span,
                        receiver: -1,
                        function: c.enums[e].fromOrdinal,
                        typeArgs: List<TextSpan>(),
                    },
                ),
                at: syntax,
            )
        case "parse":
            return recordSyntaxNode(
                ref c,
                for: addMethodGroup(
                    ref c,
                    from: BMethodGroup {
                        span: m.span,
                        receiver: -1,
                        function: c.enums[e].parse,
                        typeArgs: List<TextSpan>(),
                    },
                ),
                at: syntax,
            )
        default:
            var candidates = List<string>()
            for mem in c.enums[e].members {
                candidates.append(c.enumMembers[mem].name)
            }
            candidates.append("count")
            candidates.append("values")
            candidates.append("fromOrdinal")
            candidates.append("parse")
            let close = suggest(name, by: in candidates)
            let help = close is { } ? $"did you mean `{close}`?" : ""
            report(
                ref b,
                through: ref c,
                for: .unknownEnumMember,
                at: m.member,
                by: (name, c.enums[e].name, "", "", ""),
                help: help,
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
    }
}

BExpr t18BindModuleMember(
    ref Binder b,
    through ref Ctx c,
    for parser.MemberExpr m,
    to ModId mod,
    from i64 syntax = -1
) {
    let name = t18Text(in c, from: b.file, at: m.member)
    if c.modules[mod].constants.contains(name) {
        let constId = c.modules[mod].constants[name]
        checkAccess(ref b, through: ref c, for: accessOf(0), from: -1, by: mod, at: m.member, publicRequired: true)
        return t21ConstantRef(ref b, through: ref c, at: m.span, for: constId, from: syntax)
    }
    if c.modules[mod].functions.contains(name) {
        let fnId = c.modules[mod].functions[name][0]
        checkAccess(ref b, through: ref c, for: c.functions[fnId].access, from: -1, by: mod, at: m.member)
        return recordSyntaxNode(
            ref c,
            for: addMethodGroup(
                ref c,
                from: BMethodGroup { span: m.span, receiver: -1, function: fnId, typeArgs: List<TextSpan>() },
            ),
            at: syntax,
        )
    }
    if c.modules[mod].types.contains(name) {
        var path = List<TextSpan>()
        switch m.target {
            case .nameExpr(let n): path.append(n.value.name)
            default: panic("a module member's target is a `NameExpr`")
        }
        path.append(m.member)
        let resolved = resolveType(
            ref b,
            through: ref c,
            for: in parser.TypeSyntax.namedType(
                Owned(NamedType { span: m.span, path: move path, args: List<parser.TypeSyntax>() }),
            ),
        )
        return recordSyntaxNode(
            ref c,
            for: addTypeRef(ref c, from: BTypeRef { span: m.span, referenced: resolved }),
            at: syntax,
        )
    }
    report(
        ref b,
        through: ref c,
        for: .unknownMember,
        at: m.member,
        by: (name, $"module {c.modules[mod].name}", "", "", ""),
    )
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: m.span }), at: syntax)
}

/// Reports a member the current code may not see. Module constants are always module-private in v0.1.
void checkAccess(
    ref Binder b,
    through ref Ctx c,
    for Accessibility access,
    from StructId owner,
    by ModId module,
    at TextSpan name,
    bool publicRequired = false
) {
    let currModule = c.files[b.file].module
    let nameText = t18Text(in c, from: b.file, at: name)
    if publicRequired && module != currModule {
        report(
            ref b,
            through: ref c,
            for: .notVisible,
            at: name,
            by: (nameText, "", "", "", ""),
            label: "module constants are not visible outside their module",
        )
        return
    }
    let builtinMod = t9Module(ref c)
    switch access {
        case .privateKeyword:
            if owner >= 0 && owner != b.owner {
                report(
                    ref b,
                    through: ref c,
                    for: .notVisible,
                    at: name,
                    by: (nameText, "", "", "", ""),
                    label: $"`private` to `{c.structs[owner].name}`",
                )
            } else if module != currModule && module != builtinMod {
                report(
                    ref b,
                    through: ref c,
                    for: .notVisible,
                    at: name,
                    by: (nameText, "", "", "", ""),
                    label: "not `public`",
                    help: $"mark `{nameText}` `public` to use it from another module",
                )
            }
        case .module:
            if module != currModule && module != builtinMod {
                report(
                    ref b,
                    through: ref c,
                    for: .notVisible,
                    at: name,
                    by: (nameText, "", "", "", ""),
                    label: "not `public`",
                    help: $"mark `{nameText}` `public` to use it from another module",
                )
            }
        default: {}
    }
}

BExpr bindValueMember(ref Binder b, through ref Ctx c, at TextSpan span, for BExpr target, by TextSpan member) =>
    t21BindValueMember(ref b, through: ref c, at: span, for: target, by: member, from: -1)

/// `bindValueMember` that records `syntax` as the C# `Syntax` of the nodes it builds (Q849).
BExpr t21BindValueMember(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    for BExpr target,
    by TextSpan member,
    from i64 syntax
) {
    let name = t18Text(in c, from: b.file, at: member)
    let targetType = exprType(in c, for: target)
    var lookupType = targetType
    if kindOf(targetType) == .state {
        @unobservable because "Q607: resolveStates and statesOf are stubs; add a union-with-states receiver when T38 lands"
        lookupType = makeType(.structType, at: c.stateTypes[typeIndex(targetType)].s)
    }

    let lk = kindOf(lookupType)
    if lk == .structType {
        let s = typeIndex(lookupType)
        let foundField = findField(ref c, by: s, for: name)
        if foundField != -1 {
            checkAccess(
                ref b,
                through: ref c,
                for: c.fields[foundField].access,
                from: s,
                by: c.structs[s].module,
                at: member,
            )
            return recordSyntaxNode(
                ref c,
                for: addField(
                    ref c,
                    from: BField { span: span, receiver: target, field: foundField, type: c.fields[foundField].type },
                ),
                at: syntax,
            )
        }

        let foundProp = findProperty(ref c, by: s, for: name)
        if foundProp != -1 {
            checkAccess(
                ref b,
                through: ref c,
                for: c.properties[foundProp].access,
                from: s,
                by: c.structs[s].module,
                at: member,
            )
            return recordSyntaxNode(
                ref c,
                for: addCall(
                    ref c,
                    from: BCall {
                        span: span,
                        function: c.properties[foundProp].getter,
                        receiver: target,
                        arguments: List<BExpr>(),
                        type: c.properties[foundProp].type,
                    },
                ),
                at: syntax,
            )
        }

        let methods = findMethods(ref c, by: s, for: name)
        if methods.length > 0 {
            let foundMethod = methods[0]
            checkAccess(
                ref b,
                through: ref c,
                for: c.functions[foundMethod].access,
                from: s,
                by: c.structs[s].module,
                at: member,
            )
            let recv = c.functions[foundMethod].isStatic ? -1 : target
            return recordSyntaxNode(
                ref c,
                for: addMethodGroup(
                    ref c,
                    from: BMethodGroup {
                        span: span,
                        receiver: recv,
                        function: foundMethod,
                        typeArgs: List<TextSpan>(),
                    },
                ),
                at: syntax,
            )
        }

        let states = statesOf(ref c, for: s)
        if states != -1 {
            let payload = t21BindPayloadField(
                ref b,
                through: ref c,
                at: span,
                for: target,
                from: states,
                by: member,
                to: syntax,
            )
            return payload if payload != -1
        }
    } else if lk is .errorSet or .errorUnion {
        @unobservable because "Q607: bindErrorCasePattern is a stub; add a narrowed error-set field read when T22 lands"
        if boundKind(target) == .local {
            let el = c.bLocals[boundIndex(target)].local
            if b.errorNarrowed.contains(el) {
                let v = b.errorNarrowed[el]
                for fi in 0..c.errorVariants[v].fields.length {
                    let f = c.errorVariants[v].fields[fi]
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorField(
                            ref c,
                            from: BErrorField { span: span, receiver: target, variant: v, index: fi },
                        ),
                        at: syntax,
                    ) if c.locals[f].name == name
                }
            }
        }
    } else if lk == .unionType {
        @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
        let u = typeIndex(lookupType)
        @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
        if boundKind(target) == .local {
            let l = c.bLocals[boundIndex(target)].local
            if b.narrowed.contains(l) {
                let v = b.narrowed[l]
                for fi in 0..c.unionVariants[v].fields.length {
                    let f = c.unionVariants[v].fields[fi]
                    return recordSyntaxNode(
                        ref c,
                        for: addUnionField(
                            ref c,
                            from: BUnionField { span: span, receiver: target, variant: v, index: fi },
                        ),
                        at: syntax,
                    ) if c.locals[f].name == name
                }
            }
        }
        @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
        var fieldVariant = -1
        for vi in 0..c.unions[u].variants.length {
            @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
            let v = c.unions[u].variants[vi]
            for fi in 0..c.unionVariants[v].fields.length {
                @unobservable because "Q607: bindPattern is a stub; add a narrowed union field read when T34 lands"
                let f = c.unionVariants[v].fields[fi]
                if c.locals[f].name == name {
                    fieldVariant = v
                    break
                }
            }
            break if fieldVariant != -1
        }
        if fieldVariant != -1 {
            report(
                ref b,
                through: ref c,
                for: .payloadNeedsPattern,
                at: member,
                by: (c.unions[u].name, name, "", "", ""),
                help: "match the variant and bind the field, as in `case .Variant(let x):`",
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
        }
    } else if lk == .tuple {
        let t = typeIndex(lookupType)
        let index = tupleIndexOf(ref c, by: lookupType, for: name)
        return recordSyntaxNode(
            ref c,
            for: addTupleElement(
                ref c,
                from: BTupleElement { span: span, receiver: target, index: index, type: c.tupleTypes[t][index].type },
            ),
            at: syntax,
        ) if index >= 0
    } else if lk == .enumType {
        let e = typeIndex(lookupType)
        let f = findEnumField(ref c, by: e, for: name)
        if f != -1 {
            let lit = recordSyntaxNode(
                ref c,
                for: literal(
                    ref c,
                    at: span,
                    as: prim(.i32),
                    by: Constant { kind: .integer, integer: bigFromI64(c.enumFields[f].index) },
                ),
                at: syntax,
            )
            return recordSyntaxNode(
                ref c,
                for: addBuiltinCall(
                    ref c,
                    from: BBuiltinCall {
                        span: span,
                        member: .enumField,
                        receiver: target,
                        arguments: [lit],
                        type: c.enumFields[f].type,
                    },
                ),
                at: syntax,
            )
        }
    } else if lk == .owned {
        let innerType = c.ownedTypes[typeIndex(lookupType)]
        if name != "value" && !isError(innerType) {
            let innerCall = shareSyntax(
                ref c,
                for: addBuiltinCall(
                    ref c,
                    from: BBuiltinCall {
                        span: nodeSpan(in c, for: target),
                        member: .ownedValue,
                        receiver: target,
                        arguments: List<BExpr>(),
                        type: innerType,
                    },
                ),
                from: target,
            )
            return t21BindValueMember(ref b, through: ref c, at: span, for: innerCall, by: member, from: syntax)
        }
    } else if lk == .optional {
        if name != "take" {
            let targetText = t18Text(in c, from: b.file, at: nodeSpan(in c, for: target))
            report(
                ref b,
                through: ref c,
                for: .memberOfOptional,
                at: member,
                by: (name, typeDisplay(ref c, by: lookupType), "", "", ""),
                help: $"check it first: `if ({targetText} is {{ }} value) {{ … value.{name} … }}`",
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
        }
    } else if lk == .error {
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    } else if lk == .typeParam {
        let tp = typeIndex(lookupType)
        if c.typeParams[tp].constraints.length > 0 {
            var foundMember: FuncId = -1
            for iface in copyIds(in c.typeParams[tp].constraints) {
                foundMember = findInterfaceProperty(ref c, by: iface, for: name)
                if foundMember == -1 {
                    let methods = findInterfaceMethods(ref c, by: iface, for: name)
                    if methods.length > 0 {
                        foundMember = methods[0]
                    }
                }
                @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
                break if foundMember != -1
            }
            if foundMember != -1 {
                @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
                return t18BindInterfaceMember(
                    ref b,
                    through: ref c,
                    at: span,
                    for: target,
                    by: foundMember,
                    from: member,
                    as: syntax,
                )
            }
            let self = c.interfaces[c.typeParams[tp].constraints[0]].self == tp
            var constraintList = List<string>()
            var constraints = copyIds(in c.typeParams[tp].constraints)
            for iface in constraints {
                constraintList.append($"`{interfaceDisplayName(ref c, by: iface)}`")
            }
            var sb = StrBuf()
            for ci in 0..constraintList.length {
                if ci > 0 {
                    sb.append(", ")
                }
                sb.append(constraintList[ci])
            }
            let joinedConstraints = $"{sb.finish()}"
            let help = self ? $"declare `{name}` in `{interfaceDisplayName(ref c, by: c.typeParams[tp].constraints[0])}`; a default method sees only its interface's members" : $"add an interface declaring `{name}` to the `where` clause"
            report(
                ref b,
                through: ref c,
                for: .constraintMember,
                at: member,
                by: (c.typeParams[tp].name, name, joinedConstraints, "", ""),
                help: help,
            )
            return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
        }
        report(
            ref b,
            through: ref c,
            for: .typeParameterMember,
            at: member,
            by: (name, c.typeParams[tp].name, "", "", ""),
            help: $"add `where {c.typeParams[tp].name} : …` naming an interface that declares `{name}`, or use a concrete type",
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    } else if lk == .dynRef {
        let d = c.dynRefTypes[typeIndex(lookupType)]
        var foundMember = findInterfaceProperty(ref c, by: d.iface, for: name)
        if foundMember == -1 {
            let methods = findInterfaceMethods(ref c, by: d.iface, for: name)
            if methods.length > 0 {
                foundMember = methods[0]
            }
        }
        if foundMember != -1 {
            @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
            if d.readOnly && c.functions[foundMember].isMutating {
                report(
                    ref b,
                    through: ref c,
                    for: .dynReadonlyMutation,
                    at: member,
                    by: (name, interfaceDisplayName(ref c, by: d.iface), "", "", ""),
                    label: "declared `ref this`",
                    help: $"take `dyn ref {interfaceDisplayName(ref c, by: d.iface)}`",
                )
                return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
            }
            @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
            return t18BindInterfaceMember(
                ref b,
                through: ref c,
                at: span,
                for: target,
                by: foundMember,
                from: member,
                as: syntax,
            )
        }
    }

    if (builtinProperty(ref c, for: targetType, by: name) is { } builtin) {
        @unobservable because "Q607: propertyType and bindCollection are stubs; add str.length and static-array length cases when T35 lands"
        var callType: Type = -1
        @unobservable because "Q607: propertyType and bindCollection are stubs; add str.length and static-array length cases when T35 lands"
        if kindOf(builtin.type) == .span && boundKind(target) == .staticArray {
            callType = internSpan(ref c, by: c.spanTypes[typeIndex(builtin.type)].element, readOnly: true)
        } else {
            callType = propertyType(ref b, through: ref c, for: builtin.member, as: builtin.type)
        }
        @unobservable because "Q607: propertyType and bindCollection are stubs; add str.length and static-array length cases when T35 lands"
        return recordSyntaxNode(
            ref c,
            for: addBuiltinCall(
                ref c,
                from: BBuiltinCall {
                    span: span,
                    member: builtin.member,
                    receiver: target,
                    arguments: List<BExpr>(),
                    type: callType,
                },
            ),
            at: syntax,
        )
    }
    @unobservable because "Q607: fact is a stub; add an Untrusted<string> length case when T19 lands"
    if kindOf(targetType) == .untrusted && (name is "length" or "isEmpty") {
        let innerType = c.untrustedTypes[typeIndex(targetType)]
        if (builtinProperty(ref c, for: innerType, by: name) is { } factProp) {
            return recordSyntaxNode(
                ref c,
                for: addBuiltinCall(
                    ref c,
                    from: BBuiltinCall {
                        span: span,
                        member: factProp.member,
                        receiver: fact(ref c, for: target),
                        arguments: List<BExpr>(),
                        type: factProp.type,
                    },
                ),
                at: syntax,
            )
        }
    }
    return recordSyntaxNode(
        ref c,
        for: addBuiltinGroup(ref c, from: BBuiltinGroup { span: span, receiver: target, name: name }),
        at: syntax,
    ) if hasMethod(ref c, for: targetType, by: name)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: span }),
        at: syntax,
    ) if reportRenamed(ref b, through: ref c, for: targetType, at: member)
    if name == "take" {
        report(
            ref b,
            through: ref c,
            for: .takeUnsupported,
            at: member,
            by: (typeDisplay(ref c, by: targetType), "", "", "", ""),
            help: "copy it, or move the whole local; only an owned collection or optional has an empty value to leave behind",
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    let label = name == "matches" && isString(targetType) ? "`matches` arrives with `std.regex` after v0.1" : ""
    let help = memberSuggestion(ref c, for: targetType, by: name) ?? ""
    report(
        ref b,
        through: ref c,
        for: .unknownMember,
        at: member,
        by: (name, typeDisplay(ref c, by: targetType), "", "", ""),
        label: label,
        help: help,
    )
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
}

/// A member of an interface, reached through a constrained type parameter or a `dyn ref`.
BExpr t18BindInterfaceMember(
    ref Binder b,
    through ref Ctx c,
    at TextSpan syntaxSpan,
    for BExpr target,
    by FuncId m,
    from TextSpan memberSpan,
    as i64 syntax
) {
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    if c.functions[m].typeParams.length > 0 {
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: memberSpan,
            by: ("calling a generic interface method", "", "", "", ""),
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: syntaxSpan }), at: syntax)
    }
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    if c.functions[m].kind == .getter {
        let returnType = returnTypeThrough(ref b, through: ref c, for: exprType(in c, for: target), by: m)
        return recordSyntaxNode(
            ref c,
            for: addCall(
                ref c,
                from: BCall {
                    span: syntaxSpan,
                    function: m,
                    receiver: target,
                    arguments: List<BExpr>(),
                    type: returnType,
                },
            ),
            at: syntax,
        )
    }
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    return recordSyntaxNode(
        ref c,
        for: addMethodGroup(
            ref c,
            from: BMethodGroup { span: syntaxSpan, receiver: target, function: m, typeArgs: List<TextSpan>() },
        ),
        at: syntax,
    )
}

/// The return type of interface member `m` called on `receiver`: an associated type `Item` is `T.Item`.
Type returnTypeThrough(ref Binder b, through ref Ctx c, for Type receiver, by FuncId m) {
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    if kindOf(receiver) == .typeParam {
        let tp = typeIndex(receiver)
        let iface = c.functions[m].iface
        if iface >= 0 && c.interfaces[iface].self != tp {
            let ret = c.functions[m].returnType
            if kindOf(ret) == .typeParam {
                let rIdx = typeIndex(ret)
                var foundAssoc = false
                for assoc in c.interfaces[iface].associatedTypes {
                    if assoc == rIdx {
                        foundAssoc = true
                        break
                    }
                }
                if foundAssoc {
                    let assocName = c.typeParams[rIdx].name
                    let assocId = associatedType(ref c, for: tp, by: assocName)
                    return makeType(.typeParam, at: assocId)
                }
            }
        }
    }
    @unobservable because "Q607: declareInterfaceMembers is a stub; add an interface member through a type parameter or dyn ref when T38 lands"
    return c.functions[m].returnType
}

/// BYN2230 and BYN2031: a member under its round-1 or C# name; the fix writes the new one.
bool reportRenamed(ref Binder b, through ref Ctx c, for Type type, at TextSpan member) {
    let name = t18Text(in c, from: b.file, at: member)
    if name is "toString" or "ToString" {
        report(
            ref b,
            through: ref c,
            for: .toStringCall,
            at: member,
            by: ("", "", "", "", ""),
            label: "not a Bayan method",
            help: "call `format()`, or interpolate the value: `$\"{x}\"`",
            hasFix: true,
            fixSpan: member,
            fixReplacement: "format",
        )
        return true
    }
    if (t18RenamedCall(ref b, through: ref c, for: type, at: member) is { } shape) {
        let helpText = shape.hasFix ? $"write `{shape.replacement}`" : $"write `{shape.newName}`"
        report(
            ref b,
            through: ref c,
            for: .renamedMember,
            at: member,
            by: (shape.oldName, shape.newName, "", "", ""),
            label: "the old name",
            help: helpText,
            hasFix: shape.hasFix,
            fixSpan: shape.fixSpan,
            fixReplacement: shape.replacement,
        )
        return true
    }
    var renamed: string? = null
    let isList = kindOf(type) == .list
    let isSpanT = kindOf(type) == .span
    let isArrayT = kindOf(type) == .array
    let isStr = isString(type)
    let isStrBuf = kindOf(type) == .builtin && builtinKindOf(typeIndex(type)) == .strBuf

    if isList && name == "add" {
        renamed = "append"
    } else if isStrBuf && name == "asString" {
        renamed = "finish"
    } else if isStr && name == "offset" {
        renamed = "position"
    } else if (isList || isSpanT) && name == "toList" {
        renamed = "copy"
    } else if isArrayT && name == "toList" {
        renamed = "span.copy"
    }
    return false if renamed is null
    let call = (name is "asString" or "toList") ? "()" : ""
    let ren = renamed ?? ""
    report(
        ref b,
        through: ref c,
        for: .renamedMember,
        at: member,
        by: ($"{name}{call}", $"{ren}{call}", "", "", ""),
        label: "the old name",
        help: $"rename it `{ren}`",
        hasFix: true,
        fixSpan: member,
        fixReplacement: ren,
    )
    return true
}

/// The renames that change the call's shape (J72, round 3 §27): the fix rewrites the member and its arguments,
/// so it is written only when the member is called with the old arguments.
RenamedResult? t18RenamedCall(ref Binder b, through ref Ctx c, for Type type, at TextSpan memberSpan) {
    let name = t18Text(in c, from: b.file, at: memberSpan)
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    var isCalleeMatch = false
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    var tail = TextSpan { start: memberSpan.start, length: 0 }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if (b.calleeOf is { } activeCall) {
        if activeCall.isMember
                && activeCall.member.start == memberSpan.start
                && activeCall.member.length == memberSpan.length {
            isCalleeMatch = true
            tail = TextSpan.fromBounds(memberSpan.start, until: activeCall.span.end)
        }
    }

    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isList = kindOf(type) == .list
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isArrayT = kindOf(type) == .array
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isMap = kindOf(type) == .map
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isStr = isString(type)
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    let isInt = isInteger(type)

    if isList && name == "removeRange" {
        @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
        if isCalleeMatch && (b.calleeOf is { } cCall) && cCall.argCount == 2 && cCall.firstTwoPlain {
            let from = t18Text(in c, from: b.file, at: cCall.arg0)
            let until = t18Text(in c, from: b.file, at: cCall.arg1)
            return RenamedResult {
                oldName: "removeRange",
                newName: "remove(from:until:)",
                hasFix: true,
                fixSpan: tail,
                replacement: $"remove(from: {from}, until: {until})",
            }
        }
        @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
        return RenamedResult {
            oldName: "removeRange",
            newName: "remove(from:until:)",
            hasFix: false,
            fixSpan: tail,
            replacement: "",
        }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isList && name == "replaceRange" {
        if isCalleeMatch && (b.calleeOf is { } rCall) && rCall.argCount == 2 && rCall.firstTwoPlain {
            let at = t18Text(in c, from: b.file, at: rCall.arg0)
            let by = t18Text(in c, from: b.file, at: rCall.arg1)
            return RenamedResult {
                oldName: "replaceRange",
                newName: "replace(at:by:)",
                hasFix: true,
                fixSpan: tail,
                replacement: $"replace(at: {at}, by: {by})",
            }
        }
        return RenamedResult {
            oldName: "replaceRange",
            newName: "replace(at:by:)",
            hasFix: false,
            fixSpan: tail,
            replacement: "",
        }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isMap && name == "getOr" {
        if isCalleeMatch && (b.calleeOf is { } mCall) && mCall.argCount == 2 && mCall.firstTwoPlain {
            if mCall.isMember {
                let key = t18Text(in c, from: b.file, at: mCall.arg0)
                let fallback = t18Text(in c, from: b.file, at: mCall.arg1)
                let mapText = t18Text(in c, from: b.file, at: mCall.target)
                return RenamedResult {
                    oldName: "getOr",
                    newName: "tryGet(at:) ??",
                    hasFix: true,
                    fixSpan: mCall.span,
                    replacement: $"({mapText}.tryGet(at: {key}) ?? {fallback})",
                }
            }
        }
        return RenamedResult {
            oldName: "getOr",
            newName: "tryGet(at:) ??",
            hasFix: false,
            fixSpan: tail,
            replacement: "",
        }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if (isList || isArrayT) && name == "asSpan" {
        return RenamedResult {
            oldName: "asSpan()",
            newName: "span",
            hasFix: true,
            fixSpan: tail,
            replacement: "span",
        } if isCalleeMatch
            && (b.calleeOf is { } sCall)
            && sCall.argCount == 0
        return RenamedResult { oldName: "asSpan()", newName: "span", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isStr && name == "toUtf16" {
        return RenamedResult {
            oldName: "toUtf16()",
            newName: "utf16",
            hasFix: true,
            fixSpan: tail,
            replacement: "utf16",
        } if isCalleeMatch
            && (b.calleeOf is { } uCall)
            && uCall.argCount == 0
        return RenamedResult { oldName: "toUtf16()", newName: "utf16", hasFix: false, fixSpan: tail, replacement: "" }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    if isInt && (name is "toHex" or "toBinary" or "toOctal") {
        let radix = name == "toHex" ? "hex" : (name == "toBinary" ? "binary" : "octal")
        if isCalleeMatch && (b.calleeOf is { } hCall) && hCall.argCount == 0 {
            if hCall.isMember {
                let targetText = t18Text(in c, from: b.file, at: hCall.target)
                return RenamedResult {
                    oldName: $"{name}()",
                    newName: $"string(x, as: .{radix})",
                    hasFix: true,
                    fixSpan: hCall.span,
                    replacement: $"string({targetText}, as: .{radix})",
                }
            }
        }
        return RenamedResult {
            oldName: $"{name}()",
            newName: $"string(x, as: .{radix})",
            hasFix: false,
            fixSpan: tail,
            replacement: "",
        }
    }
    @unobservable because "Q607: bindCall is a stub; add renamed-member fix cases when T20 lands"
    return null
}

string? memberSuggestion(ref Ctx c, for Type type, by string name) {
    return "use `length` for the size of anything" if name is "Length" or "Count" or "count" or "size" or "len"
    var candidates = List<string>()
    let tk = kindOf(type)
    if tk == .structType {
        let s = typeIndex(type)
        for f in c.structs[s].fields {
            candidates.append(c.fields[f].name)
        }
        for p in c.structs[s].properties {
            candidates.append(c.properties[p].name)
        }
        for m in c.structs[s].methods {
            candidates.append(c.functions[m].name)
        }
    } else if tk == .enumType {
        let e = typeIndex(type)
        for f in c.enums[e].fields {
            candidates.append(c.enumFields[f].name)
        }
        for n in names(ref c, for: type) {
            candidates.append(n)
        }
    } else {
        for n in names(ref c, for: type) {
            candidates.append(n)
        }
    }
    let close = suggest(name, by: in candidates)
    return $"did you mean `{close}`?" if close is not null
    return null
}

BExpr bindTargetMember(ref Binder b, through ref Ctx c, for in parser.TargetMemberExpr t, to Type expected) {
    let syntax = syntaxLeaf(ref c, as: .targetMemberExpr, at: t.span)
    var target = expected
    if expected != -1 {
        let ek = kindOf(expected)
        if ek == .optional {
            target = c.optionalTypes[typeIndex(expected)]
        } else if ek == .result {
            target = c.resultTypes[typeIndex(expected)].error
        }
    }

    if target == -1 {
        report(
            ref b,
            through: ref c,
            for: .noTargetType,
            at: t.span,
            by: (t18Text(in c, from: b.file, at: t.member), "", "", "", ""),
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    let tk = kindOf(target)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }),
        at: syntax,
    ) if tk == .error
    let name = t18Text(in c, from: b.file, at: t.member)

    if tk == .function {
        report(
            ref b,
            through: ref c,
            for: .memberNotLambda,
            at: t.span,
            by: (name, "", "", "", ""),
            help: $"write `it.{name}`",
            hasFix: true,
            fixSpan: t.span,
            fixReplacement: $"it.{name}",
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .errorSet {
        let set = typeIndex(target)
        let foundVariant = findErrorVariant(ref c, by: set, for: name)
        return recordSyntaxNode(
            ref c,
            for: addErrorVariant(ref c, from: BErrorVariant { span: t.span, variant: foundVariant, type: target }),
            at: syntax,
        ) if foundVariant != -1
        report(
            ref b,
            through: ref c,
            for: .unknownVariant,
            at: t.member,
            by: (name, errorSetDisplayName(ref c, by: set), "", "", ""),
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .errorUnion {
        let u = typeIndex(target)
        var matches = List<VariantId>()
        for set in copyIds(in c.errorUnionTypes[u].sets) {
            let v = findErrorVariant(ref c, by: set, for: name)
            if v != -1 {
                var excluded = false
                for ex in c.errorUnionTypes[u].excluded {
                    if ex == v {
                        excluded = true
                        break
                    }
                }
                if !excluded {
                    matches.append(v)
                }
            }
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorVariant(ref c, from: BErrorVariant { span: t.span, variant: matches[0], type: target }),
            at: syntax,
        ) if matches.length == 1
        if matches.length > 1 {
            var matchedSets = List<string>()
            for mv in matches {
                matchedSets.append(errorSetDisplayName(ref c, by: c.errorVariants[mv].set))
            }
            var sb = StrBuf()
            for mi in 0..matchedSets.length {
                if mi > 0 {
                    sb.append("`, `")
                }
                sb.append(matchedSets[mi])
            }
            report(ref b, through: ref c, for: .ambiguousVariant, at: t.span, by: (name, $"{sb.finish()}", "", "", ""))
        } else {
            report(
                ref b,
                through: ref c,
                for: .unknownVariant,
                at: t.member,
                by: (name, typeDisplay(ref c, by: target), "", "", ""),
            )
        }
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    if tk == .enumType {
        let e = typeIndex(target)
        let foundMember = findEnumMember(ref c, by: e, for: name)
        return recordSyntaxNode(
            ref c,
            for: addEnumMember(ref c, from: BEnumMember { span: t.span, member: foundMember, type: target }),
            at: syntax,
        ) if foundMember != -1
        var candidates = List<string>()
        for mem in c.enums[e].members {
            candidates.append(c.enumMembers[mem].name)
        }
        let close = suggest(name, by: in candidates)
        let help = close is { } ? $"did you mean `{close}`?" : ""
        report(
            ref b,
            through: ref c,
            for: .unknownEnumMember,
            at: t.member,
            by: (name, c.enums[e].name, "", "", ""),
            help: help,
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
    }
    return t18BindVariant(
        ref b,
        through: ref c,
        at: t.span,
        by: t.member,
        to: typeIndex(target),
        from: syntax,
    ) if tk == .unionType
    if tk == .structType {
        let methods = findMethods(ref c, by: typeIndex(target), for: name)
        let method: FuncId = methods.length > 0 ? methods[0] : -1
        return recordSyntaxNode(
            ref c,
            for: addMethodGroup(
                ref c,
                from: BMethodGroup { span: t.span, receiver: -1, function: method, typeArgs: List<TextSpan>() },
            ),
            at: syntax,
        ) if method != -1
            && c.functions[method].isStatic
    }
    report(
        ref b,
        through: ref c,
        for: .unknownMember,
        at: t.member,
        by: (name, typeDisplay(ref c, by: target), "", "", ""),
    )
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }), at: syntax)
}

BExpr bindIndex(ref Binder b, through ref Ctx c, for in parser.IndexExpr i) {
    let syntax = syntaxOfIndex(ref c, from: in i)
    let target = bindExpr(ref b, through: ref c, for: in i.target)
    let targetType = exprType(in c, for: target)
    if isError(targetType) {
        let _ = bindExpr(ref b, through: ref c, for: in i.index)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
    }
    if isString(targetType) {
        switch i.index {
            case .rangeExpr(let r):
                return bindSlice(ref b, through: ref c, for: in i, from: target, by: in r.value, as: prim(.string))
            default: {}
        }
        t18ReportStringIndexer(ref b, through: ref c, for: i)
        let _ = bindExpr(ref b, through: ref c, for: in i.index)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
    }
    if kindOf(targetType) == .map {
        let mapType = c.mapTypes[typeIndex(targetType)]
        let key = bindConverted(ref b, through: ref c, for: in i.index, to: mapType.key)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }),
            at: syntax,
        ) if isError(exprType(in c, for: key))
        return recordSyntaxNode(
            ref c,
            for: addBuiltinCall(
                ref c,
                from: BBuiltinCall {
                    span: i.span,
                    member: .mapIndex,
                    receiver: target,
                    arguments: [key],
                    type: mapType.value,
                },
            ),
            at: syntax,
        )
    }
    var element: Type = -1
    let tk = kindOf(targetType)
    if tk == .span {
        element = c.spanTypes[typeIndex(targetType)].element
    } else if tk == .list {
        element = c.listTypes[typeIndex(targetType)]
    } else if tk == .array {
        element = c.arrayTypes[typeIndex(targetType)].element
    }
    if element == -1 {
        report(
            ref b,
            through: ref c,
            for: .notIndexable,
            at: parser.exprSpan(in i.target),
            by: (typeDisplay(ref c, by: targetType), "", "", "", ""),
        )
        let _ = bindExpr(ref b, through: ref c, for: in i.index)
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }), at: syntax)
    }
    switch i.index {
        case .rangeExpr(let r):
            let isReadOnly = (tk == .span && c.spanTypes[typeIndex(targetType)].readOnly)
                || boundKind(target) == .staticArray
            let sliceType = internSpan(ref c, by: element, readOnly: isReadOnly)
            return bindSlice(ref b, through: ref c, for: in i, from: target, by: in r.value, as: sliceType)
        default: {}
    }

    var fromEnd = false
    var index: BExpr = -1
    switch i.index {
        case .unaryExpr(let u):
            if u.value.op == .fromEnd {
                fromEnd = true
                index = t18BindIndexValue(ref b, through: ref c, for: u.value.operand)
            } else {
                index = t18BindIndexValue(ref b, through: ref c, for: i.index)
            }
        default:
            index = t18BindIndexValue(ref b, through: ref c, for: i.index)
    }

    if tk == .array && (exprConstant(in c, for: index) is { } k) && k.kind == .integer {
        let arr = c.arrayTypes[typeIndex(targetType)]
        let n = bigToI64(k.integer)
        let effective = fromEnd ? arr.length - n : n
        if effective < 0 || effective >= arr.length || (fromEnd && n == 0) {
            let nStr = fromEnd ? $"^{n}" : $"{n}"
            report(
                ref b,
                through: ref c,
                for: .indexOutOfRange,
                at: parser.exprSpan(in i.index),
                by: (nStr, typeDisplay(ref c, by: targetType), "", "", ""),
            )
        }
    }
    return recordSyntaxNode(
        ref c,
        for: addIndex(
            ref c,
            from: BIndex { span: i.span, target: target, index: index, fromEnd: fromEnd, type: element },
        ),
        at: syntax,
    )
}

BExpr t18BindIndexValue(ref Binder b, through ref Ctx c, for parser.Expr syntax) {
    let index = bindExpr(ref b, through: ref c, for: in syntax, to: prim(.i64))
    let indexType = exprType(in c, for: index)
    return index if isError(indexType)
    let span = parser.exprSpan(in syntax)
    if !isInteger(indexType) {
        report(
            ref b,
            through: ref c,
            for: .typeMismatch,
            at: span,
            by: (typeDisplay(ref c, by: indexType), "an integer index", "", "", ""),
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: span }),
            at: syntaxNode(ref c, from: in syntax),
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addConversion(
            ref c,
            from: BConversion { span: span, operand: index, type: prim(.i64), kind: .numericCast },
        ),
        at: syntaxNode(ref c, from: in syntax),
    ) if isUnsignedInteger(indexType)
        && primitiveBits(primKindOf(typeIndex(indexType))) == 64
    return convert(ref b, through: ref c, for: index, to: prim(.i64), at: span)
}

BExpr bindSlice(
    ref Binder b,
    through ref Ctx c,
    for in parser.IndexExpr i,
    from BExpr target,
    by in parser.RangeExpr r,
    as Type type
) {
    var start: BExpr = -1
    var startFromEnd = false
    switch r.start {
        case .unaryExpr(let u):
            if u.value.op == .fromEnd {
                startFromEnd = true
                start = t18BindIndexValue(ref b, through: ref c, for: u.value.operand)
            } else {
                start = t18BindIndexValue(ref b, through: ref c, for: r.start)
            }
        case .none: {}
        default:
            start = t18BindIndexValue(ref b, through: ref c, for: r.start)
    }

    var end: BExpr = -1
    var endFromEnd = false
    switch r.end {
        case .unaryExpr(let u):
            if u.value.op == .fromEnd {
                endFromEnd = true
                end = t18BindIndexValue(ref b, through: ref c, for: u.value.operand)
            } else {
                end = t18BindIndexValue(ref b, through: ref c, for: r.end)
            }
        case .none: {}
        default:
            end = t18BindIndexValue(ref b, through: ref c, for: r.end)
    }

    return recordSyntaxNode(
        ref c,
        for: addSlice(
            ref c,
            from: BSlice {
                span: i.span,
                target: target,
                start: start,
                startFromEnd: startFromEnd,
                end: end,
                endFromEnd: endFromEnd,
                inclusive: r.inclusive,
                type: type,
            },
        ),
        at: syntaxOfIndex(ref c, from: in i),
    )
}

string interpolationSource(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    let text = t18Text(in c, from: b.file, at: parser.exprSpan(in e))
    switch e {
        case .literalExpr(let l):
            return text[1..text.length - 1] if l.value.kind == .string && !t18ContainsBraces(text)
        case .interpolatedExpr(_):
            return text[2..text.length - 1] if text.startsWith("$\"") && !text.startsWith("$\"\"\"")
        default: {}
    }
    return $"{{{text}}}"
}

/// BYN2201: strings have no indexer (spec §3.2); offer the four alternatives.
void t18ReportStringIndexer(ref Binder b, through ref Ctx c, for parser.IndexExpr i) {
    let targetSpan = parser.exprSpan(in i.target)
    let indexSpan = parser.exprSpan(in i.index)
    let s = t18Text(in c, from: b.file, at: targetSpan)
    let index = t18Text(in c, from: b.file, at: indexSpan)
    let diagSpan = TextSpan.fromBounds(targetSpan.end, until: i.span.end)
    let help = $"read a byte, slice, or take characters; `string` is UTF-8, so position {index} is not a character:\n  `{s}.bytes[{index}]`       the byte at offset {index} (applied below)\n  `{s}[a..b]`          the text between byte offsets a and b\n  `{s}.runes.take(n)`  the first n runes\n  `{s}.graphemes`      user-perceived characters"
    report(
        ref b,
        through: ref c,
        for: .stringIndexer,
        at: diagSpan,
        by: ("", "", "", "", ""),
        label: "strings have no indexer",
        help: help,
        hasFix: true,
        fixSpan: i.span,
        fixReplacement: $"{s}.bytes[{index}]",
    )
}
== semantics/express3.byn
// T19: BinderExpressions.cs ~1156-1640 (unary/binary/folding, coalesce, ranges, conditional, casts, struct/with).

import parser

BExpr bindUnary(ref Binder b, through ref Ctx c, for in parser.UnaryExpr u, to Type expected) {
    // C# `Syntax is UnaryExpr`, and `IsUntypedLiteral(Syntax)` for `-`/`+` on an untyped literal.
    let flags = (u.op is .negate or .plus)
        && isUntypedLiteral(in u.operand) ? syntaxUnary | syntaxUntypedLiteral : syntaxUnary
    if u.op == .negate {
        switch u.operand {
            case .literalExpr(let lit):
                if lit.value.kind is .integer or .floatKeyword {
                    let l = bindLiteral(
                        ref b,
                        through: ref c,
                        for: in lit.value,
                        to: expected,
                        negate: true,
                        whole: u.span,
                    )
                    return l if boundKind(l) != .literal
                    // `bl with { Syntax = u }`: the same literal, built on the unary expression.
                    let li = boundIndex(l)
                    let copy = recordSyntaxNode(
                        ref c,
                        for: addLiteral(
                            ref c,
                            from: BLiteral { span: u.span, type: c.bLiterals[li].type, value: c.bLiterals[li].value },
                        ),
                        at: syntaxOfUnary(ref c, from: in u),
                    )
                    if (exprConstant(in c, for: l) is { } lk) {
                        setConstant(ref c, for: copy, to: lk)
                    }
                    setSyntaxFlags(ref c, for: copy, to: flags)
                    return copy
                }
            default:
                let _ = 0
        }
    }
    if u.op == .fromEnd {
        report(ref b, through: ref c, for: .fromEndOutsideIndex, at: u.span, by: ("", "", "", "", ""))
        let n = recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: u.span }),
            at: syntaxOfUnary(ref c, from: in u),
        )
        setSyntaxFlags(ref c, for: n, to: flags)
        return n
    }
    let operand = bindExpr(ref b, through: ref c, for: in u.operand, to: u.op == .notKeyword ? prim(.bool) : expected)
    let t = exprType(in c, for: operand)
    if isError(t) {
        let n = recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: u.span }),
            at: syntaxOfUnary(ref c, from: in u),
        )
        setSyntaxFlags(ref c, for: n, to: flags)
        return n
    }
    if kindOf(t) == .typeParam {
        let n = recordSyntaxNode(
            ref c,
            for: t19TypeParameterOperator(ref b, through: ref c, at: u.span, for: t19UnaryText(u.op), by: t),
            at: syntaxOfUnary(ref c, from: in u),
        )
        setSyntaxFlags(ref c, for: n, to: flags)
        return n
    }
    // The C# `u.Op switch`; any other operator (`^`, returned above) is `false`.
    let ok = (u.op == .notKeyword && isBool(t))
        || (u.op == .complement && isInteger(t))
        || (u.op == .negate && (isSignedInteger(t) || isFloat(t)))
        || (u.op == .plus && isNumeric(t))
    if !ok {
        report(
            ref b,
            through: ref c,
            for: .badUnaryOperand,
            at: u.span,
            by: (t19UnaryText(u.op), typeDisplay(ref c, by: t), "", "", ""),
            help: u.op == .negate && isUnsignedInteger(t)
                ? "convert to a signed type first; unsigned values cannot be negative"
                : "",
        )
        let n = recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: u.span }),
            at: syntaxOfUnary(ref c, from: in u),
        )
        setSyntaxFlags(ref c, for: n, to: flags)
        return n
    }
    let result = recordSyntaxNode(
        ref c,
        for: addUnary(ref c, from: BUnary { span: u.span, op: u.op, operand: operand, type: t }),
        at: syntaxOfUnary(ref c, from: in u),
    )
    setSyntaxFlags(ref c, for: result, to: flags)
    if (exprConstant(in c, for: operand) is { } k) {
        if (foldUnary(ref c, for: u.op, by: in k, as: t) is { } folded) {
            if folded.kind == .integer
                    && kindOf(t) == .primitive
                    && !fits(folded.integer, for: primKindOf(typeIndex(t))) {
                report(
                    ref b,
                    through: ref c,
                    for: .constantOverflow,
                    at: u.span,
                    by: (typeDisplay(ref c, by: t), "", "", "", ""),
                )
                let n = recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: u.span }),
                    at: syntaxOfUnary(ref c, from: in u),
                )
                setSyntaxFlags(ref c, for: n, to: flags)
                return n
            }
            setConstant(ref c, for: result, to: folded)
            return result
        }
    }
    return result
}

string t19UnaryText(parser.UnaryOp op) {
    switch op {
        case .notKeyword: return "!"
        case .complement: return "~"
        case .negate: return "-"
        case .plus: return "+"
        default: return "^"
    }
}

string binaryText(parser.BinaryOp op) {
    switch op {
        case .add: return "+"
        case .sub: return "-"
        case .mul: return "*"
        case .div: return "/"
        case .rem: return "%"
        case .addWrap: return "+%"
        case .subWrap: return "-%"
        case .mulWrap: return "*%"
        case .addSat: return "+|"
        case .subSat: return "-|"
        case .mulSat: return "*|"
        case .shl: return "<<"
        case .shr: return ">>"
        case .lt: return "<"
        case .gt: return ">"
        case .le: return "<="
        case .ge: return ">="
        case .eq: return "=="
        case .ne: return "!="
        case .bitAnd: return "&"
        case .bitOr: return "|"
        case .bitXor: return "^"
        case .logicalAnd: return "&&"
        case .logicalOr: return "||"
        case .coalesce: return "??"
    }
}

bool t19IsComparison(parser.BinaryOp op) => op is .lt or .gt or .le or .ge or .eq or .ne

BExpr bindBinary(ref Binder b, through ref Ctx c, for in parser.BinaryExpr e, to Type expected) {
    // C# `nullTested`: 1 for the left operand, 2 for the right, 0 for none.
    // C# `LiteralExpr { Kind: LiteralKind.Null }` on either side.
    var leftNull = false
    var rightNull = false
    switch e.left {
        case .literalExpr(let l): leftNull = l.value.kind == .nullKeyword
        default: {}
    }
    switch e.right {
        case .literalExpr(let l): rightNull = l.value.kind == .nullKeyword
        default: {}
    }
    var nullTested = 0
    if e.op is .eq or .ne {
        if rightNull {
            nullTested = 1
        } else if leftNull {
            nullTested = 2
        }
    }
    switch e.op {
        case .logicalAnd or .logicalOr:
            let l = bindConverted(ref b, through: ref c, for: in e.left, to: prim(.bool))
            @unobservable because "Q613: bindPattern is a stub, so narrowing facts never form; add an is-pattern narrowing case when T34 lands"
            let scope = narrowedBegin(ref b, through: ref c, for: l, whenTrue: e.op == .logicalAnd)
            let r = bindConverted(ref b, through: ref c, for: in e.right, to: prim(.bool))
            narrowedEnd(ref b, through: ref c, by: move scope)
            let result = recordSyntaxNode(
                ref c,
                for: addBinary(ref c, from: BBinary { span: e.span, op: e.op, left: l, right: r, type: prim(.bool) }),
                at: syntaxOfBinary(ref c, from: in e),
            )
            if (exprConstant(in c, for: l) is { } lc) {
                if (exprConstant(in c, for: r) is { } rc) {
                    if (foldBinary(ref c, for: e.op, from: in lc, by: in rc, as: prim(.bool)) is { } k) {
                        setConstant(ref c, for: result, to: k)
                    }
                    return result
                }
            }
            return result
        case .coalesce:
            return bindCoalesce(ref b, through: ref c, for: in e, to: expected)
        default:
            let _ = 0
    }

    let arithmetic = !t19IsComparison(e.op)
    // C# `IsUntypedLiteral(Syntax)` for arithmetic on two untyped literals.
    let flags = arithmetic && isUntypedLiteral(in e.left) && isUntypedLiteral(in e.right) ? syntaxUntypedLiteral : 0
    var left: BExpr = -1
    var right: BExpr = -1
    // A string literal facing a `Symbol` binds as one (spec 008 R2), so the other operand goes first.
    if isUntypedLiteral(in e.left) && !isUntypedLiteral(in e.right)
            || !arithmetic && t19IsStringLiteral(in e.left) && !t19IsStringLiteral(in e.right) {
        right = t19Operand(
            ref b,
            through: ref c,
            for: in e.right,
            to: arithmetic ? expected : -1,
            arithmetic: arithmetic,
        )
        let rt = exprType(in c, for: right)
        left = bindExpr(
            ref b,
            through: ref c,
            for: in e.left,
            to: kindOf(rt) == .optional ? c.optionalTypes[typeIndex(rt)] : rt,
        )
    } else {
        left = t19Operand(
            ref b,
            through: ref c,
            for: in e.left,
            to: arithmetic ? expected : -1,
            arithmetic: arithmetic,
        )
        let lt = exprType(in c, for: left)
        let hint = e.op == .shl
            || e.op == .shr ? prim(.i32) : kindOf(lt) == .optional ? c.optionalTypes[typeIndex(lt)] : lt
        right = t19Operand(ref b, through: ref c, for: in e.right, to: hint, arithmetic: arithmetic)
    }
    if c.typedLints.length > 0 {
        noteLintOperand(ref c, for: b.file, at: parser.exprSpan(in e.left), by: left)
        noteLintOperand(ref c, for: b.file, at: parser.exprSpan(in e.right), by: right)
    }
    // `x is null` is valid only on an optional `x`: for `null == null` or a non-optional operand BYN2208 reports alone.
    if nullTested != 0 {
        let testedIsNull = nullTested == 1 ? leftNull : rightNull
        if !testedIsNull && kindOf(exprType(in c, for: nullTested == 1 ? left : right)) == .optional {
            let testedSpan = nullTested == 1 ? parser.exprSpan(in e.left) : parser.exprSpan(in e.right)
            let nullTest = $"{t15Text(in c, from: b.file, at: testedSpan)}{e.op == .eq ? " is null" : " is not null"}"
            report(
                ref b,
                through: ref c,
                for: .nullEquality,
                at: e.span,
                by: ("", "", "", "", ""),
                help: $"write `{nullTest}`",
                hasFix: true,
                fixSpan: e.span,
                fixReplacement: nullTest,
            )
        }
    }
    if isError(exprType(in c, for: left)) || isError(exprType(in c, for: right)) {
        let n = recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
            at: syntaxOfBinary(ref c, from: in e),
        )
        setSyntaxFlags(ref c, for: n, to: flags)
        return n
    }
    if e.op != .eq && e.op != .ne {
        var tp = t19TypeParameterOf(ref c, for: exprType(in c, for: left))
        if tp == -1 {
            tp = t19TypeParameterOf(ref c, for: exprType(in c, for: right))
        }
        if tp != -1 {
            let n = recordSyntaxNode(
                ref c,
                for: t19TypeParameterOperator(ref b, through: ref c, at: e.span, for: binaryText(e.op), by: tp),
                at: syntaxOfBinary(ref c, from: in e),
            )
            setSyntaxFlags(ref c, for: n, to: flags)
            return n
        }
    }

    if e.op is .shl or .shr {
        return t19BadOperands(
            ref b,
            through: ref c,
            for: in e,
            from: left,
            by: right,
        ) if !isInteger(exprType(in c, for: left))
            || !isInteger(exprType(in c, for: right))
        let lt = exprType(in c, for: left)
        let shift = recordSyntaxNode(
            ref c,
            for: addBinary(ref c, from: BBinary { span: e.span, op: e.op, left: left, right: right, type: lt }),
            at: syntaxOfBinary(ref c, from: in e),
        )
        setSyntaxFlags(ref c, for: shift, to: flags)
        return fold(ref b, through: ref c, for: shift, from: left, by: right, as: lt)
    }

    constrain(ref b, through: ref c, for: left, as: right, from: in e.right)
    constrain(ref b, through: ref c, for: right, as: left, from: in e.left)
    var common = common(ref c, for: exprType(in c, for: left), as: exprType(in c, for: right))
    if common == -1
            && (exprConstant(in c, for: left) is { } lk)
            && lk.kind == .integer
            && isInteger(exprType(in c, for: right)) {
        common = exprType(in c, for: right)
    }
    if common == -1
            && (exprConstant(in c, for: right) is { } rk)
            && rk.kind == .integer
            && isInteger(exprType(in c, for: left)) {
        common = exprType(in c, for: left)
    }
    return t19BadOperands(ref b, through: ref c, for: in e, from: left, by: right) if common == -1

    if isString(common) && e.op == .add {
        // Two plain literals merge into one literal, which (unlike an interpolation) stays a constant.
        if t19IsPlainStringLiteral(ref b, through: ref c, for: in e.left)
                && t19IsPlainStringLiteral(ref b, through: ref c, for: in e.right) {
            let lText = t15Text(in c, from: b.file, at: parser.exprSpan(in e.left))
            let rText = t15Text(in c, from: b.file, at: parser.exprSpan(in e.right))
            let merged = $"{lText[0..lText.length - 1]}{rText[1..]}"
            report(
                ref b,
                through: ref c,
                for: .stringConcatenation,
                at: e.span,
                by: ("", "", "", "", ""),
                help: $"write one literal: `{merged}`",
                hasFix: true,
                fixSpan: e.span,
                fixReplacement: merged,
            )
            let n = recordSyntaxNode(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
                at: syntaxOfBinary(ref c, from: in e),
            )
            setSyntaxFlags(ref c, for: n, to: flags)
            return n
        }
        let lSource = interpolationSource(ref b, through: ref c, for: in e.left)
        let rSource = interpolationSource(ref b, through: ref c, for: in e.right)
        report(
            ref b,
            through: ref c,
            for: .stringConcatenation,
            at: e.span,
            by: ("", "", "", "", ""),
            help: "write the parts as one interpolation: `$\"{a}{b}\"`, or `buf.append($\"{a}{b}\")` in a loop",
            hasFix: true,
            fixSpan: e.span,
            fixReplacement: $"$\"{lSource}{rSource}\"",
        )
        let n = recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
            at: syntaxOfBinary(ref c, from: in e),
        )
        setSyntaxFlags(ref c, for: n, to: flags)
        return n
    }

    // A bare case compares by code (Q312), so it needs no payload equality (Q344).
    let byCode = (e.op is .eq or .ne) && (kindOf(common) == .errorSet || kindOf(common) == .errorUnion)
        && (t19IsBareCase(in c, for: left) || t19IsBareCase(in c, for: right))
    return t19BadOperands(ref b, through: ref c, for: in e, from: left, by: right) if !byCode
        && !operatorApplies(ref c, for: e.op, as: common)
    left = convert(ref b, through: ref c, for: left, to: common, at: parser.exprSpan(in e.left), constrains: false)
    right = convert(ref b, through: ref c, for: right, to: common, at: parser.exprSpan(in e.right), constrains: false)
    let type = t19IsComparison(e.op) ? prim(.bool) : common
    let bound = recordSyntaxNode(
        ref c,
        for: addBinary(ref c, from: BBinary { span: e.span, op: e.op, left: left, right: right, type: type }),
        at: syntaxOfBinary(ref c, from: in e),
    )
    setSyntaxFlags(ref c, for: bound, to: flags)
    return fold(ref b, through: ref c, for: bound, from: left, by: right, as: common)
}

/// The C# local function `Operand`: a comparison of an untrusted value is a clean fact (spec §15.1).
BExpr t19Operand(ref Binder b, through ref Ctx c, for in parser.Expr e, to Type hint, bool arithmetic) {
    return bindExpr(ref b, through: ref c, for: in e, to: hint) if arithmetic
    let bound = bindExpr(ref b, through: ref c, for: in e, to: hint)
    return fact(ref c, for: bound)
}

BExpr fact(ref Ctx c, for BExpr value) {
    let vt = exprType(in c, for: value)
    if kindOf(vt) == .untrusted {
        let conv = shareSyntax(
            ref c,
            for: addConversion(
                ref c,
                from: BConversion {
                    span: nodeSpan(in c, for: value),
                    operand: value,
                    type: c.untrustedTypes[typeIndex(vt)],
                    kind: .identity,
                },
            ),
            from: value,
        )
        return t17SameSyntax(ref c, for: conv, from: value)
    }
    return value
}

bool t19IsStringLiteral(in parser.Expr e) {
    switch e {
        case .literalExpr(let l): return l.value.kind is .string or .rawString
        case .parenExpr(let p):
            switch p.value.inner {
                case .literalExpr(let l): return l.value.kind is .string or .rawString
                default: return false
            }
        default: return false
    }
}

bool t19IsPlainStringLiteral(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    switch e {
        case .literalExpr(let l):
            return false if l.value.kind != .string
            let text = t15Text(in c, from: b.file, at: l.value.span)
            return text.startsWith("\"") && !text.startsWith("\"\"\"")
        default: return false
    }
}

/// The type parameter `t` is, or the one inside an optional `t`; -1 for none.
Type t19TypeParameterOf(ref Ctx c, for Type t) {
    return t if kindOf(t) == .typeParam
    return c.optionalTypes[typeIndex(t)] if kindOf(t) == .optional
        && kindOf(c.optionalTypes[typeIndex(t)]) == .typeParam
    return -1
}

/// Without constraints a `T` is only copied, compared with `==`/`!=`, passed, stored, returned and formatted.
BExpr t19TypeParameterOperator(ref Binder b, through ref Ctx c, at TextSpan span, for string op, by Type tp) {
    let name = c.typeParams[typeIndex(tp)].name
    report(
        ref b,
        through: ref c,
        for: .typeParameterOperator,
        at: span,
        by: (op, name, "", "", ""),
        help: $"use a `{name}` only to copy, compare with `==` and `!=`, pass, store, return and format; type parameters have no constraints",
    )
    return addErrorExpr(ref c, from: BErrorExpr { span: span })
}

BExpr fold(ref Binder b, through ref Ctx c, for BExpr bound, from BExpr left, by BExpr right, as Type operandType) {
    if (exprConstant(in c, for: left) is not { } lc) {
        return bound
    }
    if (exprConstant(in c, for: right) is not { } rc) {
        return bound
    }
    let op = c.bBinaries[boundIndex(bound)].op
    let span = c.bBinaries[boundIndex(bound)].span
    let folded = foldBinary(ref c, for: op, from: in lc, by: in rc, as: operandType)
    if (folded is not { } k) {
        if (op is .div or .rem) && rc.kind == .integer && bigCmp(rc.integer, as: bigFromI64(0)) == 0 {
            report(ref b, through: ref c, for: .divisionByZero, at: span, by: ("", "", "", "", ""))
            return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: bound)
        }
        return bound
    }
    let bt = c.bBinaries[boundIndex(bound)].type
    if k.kind == .integer
            && kindOf(bt) == .primitive
            && isInteger(bt)
            && !fits(k.integer, for: primKindOf(typeIndex(bt))) {
        report(
            ref b,
            through: ref c,
            for: .constantOverflow,
            at: span,
            by: (primitiveName(primKindOf(typeIndex(bt))), "", "", "", ""),
        )
        return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: bound)
    }
    setConstant(ref c, for: bound, to: k)
    return bound
}

bool t19IsBareCase(in Ctx c, for BExpr e) {
    return c.bErrorVariants[boundIndex(e)].payload.length == 0 if boundKind(e) == .errorVariant
    if boundKind(e) == .conversion {
        let operand = c.bConversions[boundIndex(e)].operand
        return boundKind(operand) == .errorVariant && c.bErrorVariants[boundIndex(operand)].payload.length == 0
    }
    return false
}

bool operatorApplies(ref Ctx c, for parser.BinaryOp op, as Type t) {
    switch op {
        case .add or .sub or .mul or .div or .rem: return isNumeric(t)
        case .addWrap or .subWrap or .mulWrap or .addSat or .subSat or .mulSat: return isInteger(t)
        case .bitAnd or .bitOr or .bitXor: return isInteger(t) || isBool(t)
        case .lt
            or .gt
            or .le
            or .ge: return isNumeric(t)
            || t == prim(.char)
            || isString(t)
            || t == builtinType(.symbol)
        case .eq or .ne: return isEquatable(ref c, for: t)
        default: return false
    }
}

public bool isEquatable(ref Ctx c, for Type t) uses alloc {
    var seen = List<i64>()
    return t19IsEquatable(ref c, for: t, by: ref seen)
}

/// `Owned` compares the values it points to; a type reached again through one is assumed equatable.
bool t19IsEquatable(ref Ctx c, for Type t, by ref List<i64> seen) {
    let i = typeIndex(t)
    switch kindOf(t) {
        case .primitive:
            let k = primKindOf(i)
            return k != .void && k != .neverKind
        case .optional: return t19IsEquatable(ref c, for: c.optionalTypes[i], by: ref seen)
        case .result:
            return t19IsEquatable(ref c, for: c.resultTypes[i].value, by: ref seen)
                && t19IsEquatable(ref c, for: c.resultTypes[i].error, by: ref seen)
        case .owned: return t19IsEquatable(ref c, for: c.ownedTypes[i], by: ref seen)
        case .untrusted: return t19IsEquatable(ref c, for: c.untrustedTypes[i], by: ref seen)
        case .enumType or .typeParam: return true
        case .builtin: return t == builtinType(.symbol) || t == builtinType(.millis)
        case .errorSet:
            return true if listContains(in seen, by: t)
            seen.append(t)
            for vi in 0..c.errorSets[i].variants.length {
                let v = c.errorSets[i].variants[vi]
                for fi in 0..c.errorVariants[v].fields.length {
                    return false if !t19IsEquatable(
                        ref c,
                        for: c.locals[c.errorVariants[v].fields[fi]].type,
                        by: ref seen,
                    )
                }
            }
            return true
        case .errorUnion:
            for si in 0..c.errorUnionTypes[i].sets.length {
                return false if !t19IsEquatable(
                    ref c,
                    for: makeType(.errorSet, at: c.errorUnionTypes[i].sets[si]),
                    by: ref seen,
                )
            }
            return true
        case .structType:
            return true if listContains(in seen, by: t)
            seen.append(t)
            for fi in 0..c.structs[i].fields.length {
                return false if !t19IsEquatable(ref c, for: c.fields[c.structs[i].fields[fi]].type, by: ref seen)
            }
            return true
        case .unionType:
            return true if listContains(in seen, by: t)
            seen.append(t)
            for vi in 0..c.unions[i].variants.length {
                let v = c.unions[i].variants[vi]
                for fi in 0..c.unionVariants[v].fields.length {
                    return false if !t19IsEquatable(
                        ref c,
                        for: c.locals[c.unionVariants[v].fields[fi]].type,
                        by: ref seen,
                    )
                }
            }
            return true
        case .tuple:
            for fi in 0..c.tupleTypes[i].length {
                return false if !t19IsEquatable(ref c, for: c.tupleTypes[i][fi].type, by: ref seen)
            }
            return true
        case .array: return t19IsEquatable(ref c, for: c.arrayTypes[i].element, by: ref seen)
        default: return false
    }
}

BExpr t19BadOperands(ref Binder b, through ref Ctx c, for in parser.BinaryExpr e, from BExpr left, by BExpr right) {
    let lt = exprType(in c, for: left)
    let rt = exprType(in c, for: right)
    var help = ""
    if isNumeric(lt) && isNumeric(rt) {
        let shown = isWidening(rt, to: prim(.i64)) && isSignedInteger(lt) ? lt : rt
        help = $"convert one side explicitly, e.g. `({typeDisplay(ref c, by: shown)})…`; mixed signedness never converts implicitly"
    } else if lt == prim(.char) && isInteger(rt) {
        help = "use `(u32)c` for its value; a `rune` is a Unicode scalar, not a number"
    }
    report(
        ref b,
        through: ref c,
        for: .badBinaryOperands,
        at: e.span,
        by: (binaryText(e.op), typeDisplay(ref c, by: lt), typeDisplay(ref c, by: rt), "", ""),
        help: help,
    )
    let n = recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
        at: syntaxOfBinary(ref c, from: in e),
    )
    // C# `IsUntypedLiteral(Syntax)`: `e` is not a comparison, `&&`, `||` or `??`, and both sides are untyped literals.
    let untyped = !t19IsComparison(e.op) && isUntypedLiteral(in e.left) && isUntypedLiteral(in e.right)
    setSyntaxFlags(ref c, for: n, to: untyped ? syntaxUntypedLiteral : 0)
    return n
}

BExpr bindCoalesce(ref Binder b, through ref Ctx c, for in parser.BinaryExpr e, to Type expected) {
    let left = bindExpr(
        ref b,
        through: ref c,
        for: in e.left,
        to: expected == -1 ? -1 : internOptional(ref c, by: expected),
    )
    let lt = exprType(in c, for: left)
    if isError(lt) {
        let _ = bindExpr(ref b, through: ref c, for: in e.right)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
            at: syntaxOfBinary(ref c, from: in e),
        )
    }
    if kindOf(lt) != .optional {
        report(
            ref b,
            through: ref c,
            for: .coalesceNotOptional,
            at: parser.exprSpan(in e.left),
            by: (typeDisplay(ref c, by: lt), "", "", "", ""),
        )
        let _ = bindExpr(ref b, through: ref c, for: in e.right)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
            at: syntaxOfBinary(ref c, from: in e),
        )
    }
    let inner = c.optionalTypes[typeIndex(lt)]
    var right = bindExpr(ref b, through: ref c, for: in e.right, to: inner)
    let rt = exprType(in c, for: right)
    return recordSyntaxNode(
        ref c,
        for: addCoalesce(ref c, from: BCoalesce { span: e.span, left: left, right: right, type: inner }),
        at: syntaxOfBinary(ref c, from: in e),
    ) if isNever(rt)
    return recordSyntaxNode(
        ref c,
        for: addCoalesce(ref c, from: BCoalesce { span: e.span, left: left, right: right, type: lt }),
        at: syntaxOfBinary(ref c, from: in e),
    ) if kindOf(rt) == .optional
        && rt == lt
    right = convert(ref b, through: ref c, for: right, to: inner, at: parser.exprSpan(in e.right))
    return recordSyntaxNode(
        ref c,
        for: addCoalesce(ref c, from: BCoalesce { span: e.span, left: left, right: right, type: inner }),
        at: syntaxOfBinary(ref c, from: in e),
    )
}

BExpr bindRange(ref Binder b, through ref Ctx c, for in parser.RangeExpr r, to Type expected) {
    var open = false
    switch r.start {
        case .none: open = true
        default: {}
    }
    switch r.end {
        case .none: open = true
        default: {}
    }
    if open {
        report(
            ref b,
            through: ref c,
            for: .openRange,
            at: r.span,
            by: ("", "", "", "", ""),
            help: "use open ranges (`a..`, `..b`) only inside `[ ]`",
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: r.span }),
            at: syntaxLeaf(ref c, as: .rangeExpr, at: r.span),
        )
    }
    let hint = expected != -1 && kindOf(expected) == .range ? c.rangeTypes[typeIndex(expected)] : -1
    var start: BExpr = -1
    var end: BExpr = -1
    if isUntypedLiteral(in r.start) && !isUntypedLiteral(in r.end) {
        end = bindExpr(ref b, through: ref c, for: in r.end, to: hint)
        start = bindExpr(ref b, through: ref c, for: in r.start, to: exprType(in c, for: end))
    } else {
        start = bindExpr(ref b, through: ref c, for: in r.start, to: hint)
        end = bindExpr(ref b, through: ref c, for: in r.end, to: exprType(in c, for: start))
    }
    let st = exprType(in c, for: start)
    let et = exprType(in c, for: end)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: r.span }),
        at: syntaxLeaf(ref c, as: .rangeExpr, at: r.span),
    ) if isError(st)
        || isError(et)
    let common = common(ref c, for: st, as: et)
    if common == -1 || !(isInteger(common) || common == prim(.char)) {
        report(
            ref b,
            through: ref c,
            for: .badBinaryOperands,
            at: r.span,
            by: (r.inclusive ? "..=" : "..", typeDisplay(ref c, by: st), typeDisplay(ref c, by: et), "", ""),
            help: "make both range ends integers or chars of the same type",
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: r.span }),
            at: syntaxLeaf(ref c, as: .rangeExpr, at: r.span),
        )
    }
    let cs = convert(ref b, through: ref c, for: start, to: common, at: parser.exprSpan(in r.start))
    let ce = convert(ref b, through: ref c, for: end, to: common, at: parser.exprSpan(in r.end))
    return recordSyntaxNode(
        ref c,
        for: addRange(
            ref c,
            from: BRange {
                span: r.span,
                start: cs,
                end: ce,
                inclusive: r.inclusive,
                type: internRange(ref c, by: common),
            },
        ),
        at: syntaxLeaf(ref c, as: .rangeExpr, at: r.span),
    )
}

/// `x in a..=b`: a range pattern test whose ends may be computed at run time.
BExpr bindIn(ref Binder b, through ref Ctx c, for in parser.InExpr i) {
    let value = bindExpr(ref b, through: ref c, for: in i.value)
    let vt = exprType(in c, for: value)
    switch i.range {
        case .rangeExpr(let r):
            let range = bindRange(
                ref b,
                through: ref c,
                for: in r.value,
                to: isInteger(vt) || vt == prim(.char) ? internRange(ref c, by: vt) : -1,
            )
            return recordSyntaxNode(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }),
                at: syntaxLeaf(ref c, as: .inExpr, at: i.span),
            ) if boundKind(range) != .range
                || isError(vt)
            let rangeStart = c.bRanges[boundIndex(range)].start
            let rangeEnd = c.bRanges[boundIndex(range)].end
            let common = common(ref c, for: vt, as: exprType(in c, for: rangeStart))
            if common == -1 || !(isInteger(common) || common == prim(.char)) {
                report(
                    ref b,
                    through: ref c,
                    for: .badBinaryOperands,
                    at: i.span,
                    by: ("in", typeDisplay(ref c, by: vt), typeDisplay(ref c, by: exprType(in c, for: range)), "", ""),
                    help: "make the value and the range ends integers or chars of the same type",
                )
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }),
                    at: syntaxLeaf(ref c, as: .inExpr, at: i.span),
                )
            }
            let ps = convert(ref b, through: ref c, for: rangeStart, to: common, at: parser.exprSpan(in r.value.start))
            let pe = convert(ref b, through: ref c, for: rangeEnd, to: common, at: parser.exprSpan(in r.value.end))
            let pattern = recordSyntaxNode(
                ref c,
                for: addRangePattern(
                    ref c,
                    from: BRangePattern {
                        span: r.value.span,
                        inputType: common,
                        start: ps,
                        end: pe,
                        inclusive: r.value.inclusive,
                    },
                ),
                at: syntaxLeaf(ref c, as: .rangeExpr, at: r.value.span),
            )
            let converted = convert(ref b, through: ref c, for: value, to: common, at: parser.exprSpan(in i.value))
            return recordSyntaxNode(
                ref c,
                for: addIs(ref c, from: BIs { span: i.span, value: converted, pattern: pattern }),
                at: syntaxLeaf(ref c, as: .inExpr, at: i.span),
            )
        default:
            let other = bindExpr(ref b, through: ref c, for: in i.range)
            let ot = exprType(in c, for: other)
            if !isError(vt) && !isError(ot) {
                report(
                    ref b,
                    through: ref c,
                    for: .badBinaryOperands,
                    at: i.span,
                    by: ("in", typeDisplay(ref c, by: vt), typeDisplay(ref c, by: ot), "", ""),
                    help: "write a range after `in`: `x in a..=b`",
                )
            }
            return recordSyntaxNode(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: i.span }),
                at: syntaxLeaf(ref c, as: .inExpr, at: i.span),
            )
    }
}

BExpr bindConditional(ref Binder b, through ref Ctx c, for in parser.ConditionalExpr cond, to Type expected) {
    let condition = bindCondition(ref b, through: ref c, for: in cond.condition)
    var whenTrue = bindExpr(ref b, through: ref c, for: in cond.whenTrue, to: expected)
    var whenFalse = bindExpr(
        ref b,
        through: ref c,
        for: in cond.whenFalse,
        to: expected != -1 ? expected : exprType(in c, for: whenTrue),
    )
    let at = exprType(in c, for: whenTrue)
    let bt = exprType(in c, for: whenFalse)
    let type = expected != -1
        && implicit(ref c, from: at, to: expected) is not null
        && implicit(ref c, from: bt, to: expected) is not null ? expected : common(ref c, for: at, as: bt)
    if type == -1 {
        report(
            ref b,
            through: ref c,
            for: .branchTypeMismatch,
            at: cond.span,
            by: (typeDisplay(ref c, by: at), typeDisplay(ref c, by: bt), "", "", ""),
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: cond.span }),
            at: syntaxOfConditional(ref c, from: in cond),
        )
    }
    if kindOf(type) == .nullType {
        report(ref b, through: ref c, for: .cannotInferType, at: cond.span, by: ("null", "", "", "", ""))
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: cond.span }),
            at: syntaxOfConditional(ref c, from: in cond),
        )
    }
    whenTrue = convert(ref b, through: ref c, for: whenTrue, to: type, at: parser.exprSpan(in cond.whenTrue))
    whenFalse = convert(ref b, through: ref c, for: whenFalse, to: type, at: parser.exprSpan(in cond.whenFalse))
    let result = recordSyntaxNode(
        ref c,
        for: addConditional(
            ref c,
            from: BConditional {
                span: cond.span,
                condition: condition,
                whenTrue: whenTrue,
                whenFalse: whenFalse,
                type: type,
            },
        ),
        at: syntaxOfConditional(ref c, from: in cond),
    )
    if (exprConstant(in c, for: condition) is { } v) {
        if v.kind == .flag {
            if (exprConstant(in c, for: v.flag ? whenTrue : whenFalse) is { } k) {
                setConstant(ref c, for: result, to: k)
                return result
            }
        }
    }
    return result
}

BExpr bindCast(ref Binder b, through ref Ctx c, for in parser.CastExpr cast, from parser.Expr syntax) {
    return bindConversion(
        ref b,
        through: ref c,
        for: in syntax,
        to: resolveType(ref b, through: ref c, for: in cast.type),
        from: in cast.operand,
    )
}

/// `u8(x)` (or the input form `(u8)x`): a checked conversion that traps when the value does not fit.
BExpr bindConversion(
    ref Binder b,
    through ref Ctx c,
    for in parser.Expr e,
    to Type target,
    from in parser.Expr operandSyntax
) =>
    t21BindConversion(
        ref b,
        through: ref c,
        at: parser.exprSpan(in e),
        to: target,
        from: in operandSyntax,
        as: syntaxNode(ref c, from: in e),
    )

/// `bindConversion` where `span` and `syntax` are the C# `c`'s span and recorded node (Q849).
BExpr t21BindConversion(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    to Type target,
    from in parser.Expr operandSyntax,
    as i64 syntax
) {
    let operand = bindExpr(ref b, through: ref c, for: in operandSyntax, to: isNumeric(target) ? -1 : target)
    let ot = exprType(in c, for: operand)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: span }),
        at: syntax,
    ) if isError(target)
        || isError(ot)
    if (exprConstant(in c, for: operand) is { } n) && n.kind == .integer && isInteger(target)
            && (hasSyntax(in c, for: operand, by: syntaxLiteral) || hasSyntax(in c, for: operand, by: syntaxUnary)) {
        // `u8(300)` is a compile-time error rather than a runtime trap.
        return convert(ref b, through: ref c, for: operand, to: target, at: span)
    }
    if (explicit(ref c, from: ot, to: target) is not { } kind) {
        report(
            ref b,
            through: ref c,
            for: .invalidCast,
            at: span,
            by: (typeDisplay(ref c, by: ot), typeDisplay(ref c, by: target), "", "", ""),
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    return operand if kind == .identity
    // coverage-exempt: Q853
    return recordSyntaxNode(
        ref c,
        for: addDefault(ref c, from: BDefault { span: span, type: target }),
        at: syntax,
    ) if kind == .nullToOptional
    let conv = recordSyntaxNode(
        ref c,
        for: addConversion(ref c, from: BConversion { span: span, operand: operand, type: target, kind: kind }),
        at: syntax,
    )
    if (exprConstant(in c, for: operand) is { } k) {
        if (foldCast(ref c, for: in k, from: ot, to: target) is { } folded) {
            setConstant(ref c, for: conv, to: folded)
            return conv
        }
    }
    return conv
}

// ── Composite values ─────────────────────────────────────────────────────────

BExpr bindStructLiteral(
    ref Binder b,
    through ref Ctx c,
    for in parser.StructLiteralExpr s,
    from parser.Expr syntax,
    to Type expected
) {
    var type: Type = -1
    switch s.type {
        case .none:
            if expected != -1
                    && kindOf(expected) == .optional
                    && kindOf(c.optionalTypes[typeIndex(expected)]) == .structType {
                type = c.optionalTypes[typeIndex(expected)]
            } else if expected != -1 {
                type = expected
            } else {
                report(
                    ref b,
                    through: ref c,
                    for: .noTargetType,
                    at: s.span,
                    by: ("{ … }", "", "", "", ""),
                    help: "name the type: `Point { x: 1 }`",
                )
                return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }), from: in syntax)
            }
        default:
            type = resolveType(ref b, through: ref c, for: in s.type)
    }
    return recordSyntax(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
        from: in syntax,
    ) if isError(type)
    // `Order.paid { … }` builds a value in one state; with several states, none is named.
    let stateType: Type = kindOf(type) == .state ? type : -1
    @unobservable because "Q613: statesOf is a stub; add a struct literal of a states struct when T38 lands"
    let state: VariantId = stateType != -1
        && c.stateTypes[typeIndex(stateType)].states.length == 1 ? c.stateTypes[typeIndex(stateType)].states[0] : -1
    if stateType != -1 {
        type = makeType(.structType, at: c.stateTypes[typeIndex(stateType)].s)
    }
    if kindOf(type) != .structType {
        report(ref b, through: ref c, for: .notAStruct, at: s.span, by: (typeDisplay(ref c, by: type), "", "", "", ""))
        return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }), from: in syntax)
    }
    let st = typeIndex(type)
    let stName = c.structs[st].name
    if c.structs[st].constructors.length > 0 && st != b.owner {
        let ctor = c.structs[st].constructors[0]
        var parameters = StrBuf()
        for pi in 0..c.functions[ctor].parameters.length {
            @unobservable because "Q613: declareSignature is a stub; add a constructor with parameters case when T38 lands"
            if pi > 0 {
                parameters.append(", ")
            }
            parameters.append($"{c.locals[c.functions[ctor].parameters[pi]].name}: …")
        }
        report(
            ref b,
            through: ref c,
            for: .literalWithConstructor,
            at: s.span,
            by: (stName, "", "", "", ""),
            help: $"call the constructor: `{stName}({parameters.finish()})`",
        )
        return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }), from: in syntax)
    }
    if state == -1 {
        @unobservable because "Q613: statesOf is a stub; add a struct literal of a states struct when T38 lands"
        let states = statesOf(ref c, for: st)
        @unobservable because "Q613: statesOf is a stub; add a struct literal of a states struct when T38 lands"
        if states != -1 {
            var at = s.span
            switch s.type {
                case .none: {}
                default: at = t8TypeSpan(in s.type)
            }
            report(
                ref b,
                through: ref c,
                for: .stateLiteralNeedsState,
                at: at,
                by: (stName, c.unionVariants[c.unions[states].variants[0]].name, "", "", ""),
                help: "name the state the value starts in",
            )
            for init in s.fields {
                let _ = bindExpr(ref b, through: ref c, for: in init.value)
            }
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }), from: in syntax)
        }
    }
    var values = List<BExpr>()
    for _ in 0..c.structs[st].fields.length {
        values.append(-1)
    }
    var payload = List<BExpr>()
    if state != -1 {
        for _ in 0..c.unionVariants[state].fields.length {
            payload.append(-1)
        }
    }
    for init in s.fields {
        let name = t15Text(in c, from: b.file, at: init.name)
        let field = findField(ref c, by: st, for: name)
        @unobservable because "Q613: statesOf is a stub; add a struct literal of a states struct when T38 lands"
        if field == -1 && state != -1 {
            var payloadField: LocalId = -1
            for pf in c.unionVariants[state].fields {
                if c.locals[pf].name == name {
                    payloadField = pf
                    break
                }
            }
            if payloadField != -1 {
                let ordinal = c.locals[payloadField].ordinal
                if payload[ordinal] != -1 {
                    report(
                        ref b,
                        through: ref c,
                        for: .duplicateFieldInit,
                        at: init.name,
                        by: (c.locals[payloadField].name, "", "", "", ""),
                    )
                } else {
                    payload[ordinal] = bindConverted(
                        ref b,
                        through: ref c,
                        for: in init.value,
                        to: c.locals[payloadField].type,
                    )
                }
                continue
            }
        }
        if field == -1 {
            var names = List<string>()
            for f in c.structs[st].fields {
                names.append(c.fields[f].name)
            }
            let sug = suggest(name, by: in names)
            report(
                ref b,
                through: ref c,
                for: .unknownMember,
                at: init.name,
                by: (name, stName, "", "", ""),
                help: sug is { } sg ? $"did you mean `{sg}`?" : "",
            )
            let _ = bindExpr(ref b, through: ref c, for: in init.value)
            continue
        }
        checkAccess(
            ref b,
            through: ref c,
            for: c.fields[field].access,
            from: st,
            by: c.structs[st].module,
            at: init.name,
        )
        // The C# `FieldSymbol.Index`: the field's position among the struct's fields.
        var index: i64 = -1
        for fi in 0..c.structs[st].fields.length {
            if c.structs[st].fields[fi] == field {
                index = fi
            }
        }
        if values[index] != -1 {
            report(
                ref b,
                through: ref c,
                for: .duplicateFieldInit,
                at: init.name,
                by: (c.fields[field].name, "", "", "", ""),
            )
            continue
        }
        values[index] = bindConverted(ref b, through: ref c, for: in init.value, to: c.fields[field].type)
    }
    var missing = List<string>()
    for i in 0..values.length {
        continue if values[i] != -1
        let f = c.structs[st].fields[i]
        if fieldIsRequired(ref c, by: f) || !c.fields[f].hasDefault {
            missing.append(c.fields[f].name)
            values[i] = recordSyntax(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
                from: in syntax,
            )
        } else {
            let d = fieldDefault(ref c, for: st, by: f, from: b.file, at: s.span)
            @unobservable because "Q613: checkedValue is a stub; add a field default and a returned literal case when T21 lands"
            values[i] = d != -1 ? d : recordSyntax(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
                from: in syntax,
            )
        }
    }
    for i in 0..payload.length {
        @unobservable because "Q613: statesOf is a stub; add a struct literal of a states struct when T38 lands"
        continue if payload[i] != -1
        missing.append(c.locals[c.unionVariants[state].fields[i]].name)
        payload[i] = recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }), from: in syntax)
    }
    if missing.length > 0 {
        let first = findField(ref c, by: st, for: missing[0])
        let written = state == -1 ? stName : $"{stName}.{c.unionVariants[state].name}"
        var joined = StrBuf()
        var sets = StrBuf()
        for mi in 0..missing.length {
            if mi > 0 {
                joined.append("`, `")
                sets.append(", ")
            }
            joined.append(missing[mi])
            sets.append($"{missing[mi]}: …")
        }
        let label = missing.length == 1
            && first != -1
            && fieldIsRequired(ref c, by: first) ? $"`{c.fields[first].name}` is `required`" : ""
        report(
            ref b,
            through: ref c,
            for: .missingFields,
            at: s.span,
            by: (stName, joined.finish(), "", "", ""),
            label: label,
            help: $"set {missing.length == 1 ? "it" : "them"}: `{written} {{ {sets.finish()} }}`",
        )
        return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }), from: in syntax)
    }
    @unobservable because "Q613: checkedValue is a stub; add a field default and a returned literal case when T21 lands"
    if state == -1 {
        let literal = recordSyntax(
            ref c,
            for: addStructLiteral(
                ref c,
                from: BStructLiteral { span: s.span, structId: st, fields: move values, type: type },
            ),
            from: in syntax,
        )
        return checkedValue(ref b, through: ref c, for: in syntax, by: literal)
    }
    @unobservable because "Q613: checkedValue is a stub; add a field default and a returned literal case when T21 lands"
    let literal = recordSyntax(
        ref c,
        for: addStructLiteral(
            ref c,
            from: BStructLiteral {
                span: s.span,
                structId: st,
                fields: move values,
                state: state,
                payload: move payload,
                type: stateType,
            },
        ),
        from: in syntax,
    )
    @unobservable because "Q613: checkedValue is a stub; add a field default and a returned literal case when T21 lands"
    return checkedValue(ref b, through: ref c, for: in syntax, by: literal)
}

BExpr bindWith(ref Binder b, through ref Ctx c, for in parser.WithExpr w, from parser.Expr syntax) {
    let target = bindExpr(ref b, through: ref c, for: in w.target)
    let tt = exprType(in c, for: target)
    return recordSyntax(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: w.span }),
        from: in syntax,
    ) if isError(tt)
    if kindOf(tt) != .structType {
        report(
            ref b,
            through: ref c,
            for: .notAStruct,
            at: parser.exprSpan(in w.target),
            by: (typeDisplay(ref c, by: tt), "", "", "", ""),
        )
        return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: w.span }), from: in syntax)
    }
    let st = typeIndex(tt)
    var updates = List<BWithUpdate>()
    var changed = List<FieldId>()
    for init in w.fields {
        let name = t15Text(in c, from: b.file, at: init.name)
        let field = findField(ref c, by: st, for: name)
        if field == -1 {
            report(
                ref b,
                through: ref c,
                for: .unknownMember,
                at: init.name,
                by: (name, c.structs[st].name, "", "", ""),
            )
            continue
        }
        checkAccess(
            ref b,
            through: ref c,
            for: c.fields[field].access,
            from: st,
            by: c.structs[st].module,
            at: init.name,
        )
        if listContains(in changed, by: field) {
            report(
                ref b,
                through: ref c,
                for: .duplicateFieldInit,
                at: init.name,
                by: (c.fields[field].name, "", "", "", ""),
            )
            continue
        }
        let value = bindConverted(ref b, through: ref c, for: in init.value, to: c.fields[field].type)
        updates.append(BWithUpdate { field: field, value: value })
        changed.append(field)
    }
    let withNode = recordSyntax(
        ref c,
        for: addWith(ref c, from: BWith { span: w.span, target: target, updates: move updates, type: tt }),
        from: in syntax,
    )
    let fields: List<FieldId>? = move changed
    return checkedValue(ref b, through: ref c, for: in syntax, by: withNode, changed: in fields)
}
== semantics/express4.byn
// T35: BinderExpressions.cs ~1641-2158 (collections, map/tuple, spread, lambdas, stackalloc, interpolation).

import parser

/// BinderExpressions.cs:1641 BindCollection.
BExpr bindCollection(ref Binder b, through ref Ctx c, for in parser.CollectionExpr coll, to Type expected) {
    let target = expected != -1 && kindOf(expected) == .optional ? c.optionalTypes[typeIndex(expected)] : expected
    for e in coll.elements {
        return bindMapLiteral(ref b, through: ref c, for: in coll, to: target) if e is .mapEntryExpr(_)
    }
    return recordSyntaxNode(
        ref c,
        for: addCollection(ref c, from: BCollection { span: coll.span, type: target }),
        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
    ) if target != -1
        && kindOf(target) == .map
        && coll.elements.length == 0
    let element = t35ElementOf(ref c, for: target)
    return t35BindUntypedCollection(ref b, through: ref c, for: in coll) if element == -1
        && target == -1
        && coll.elements.length > 0
    if element == -1 {
        if target == -1 || isError(target) {
            if target == -1 {
                report(
                    ref b,
                    through: ref c,
                    for: .noTargetType,
                    at: coll.span,
                    by: ("[ … ]", "", "", "", ""),
                    help: "declare the type: `List<i64> xs = [1, 2]`",
                )
            }
        } else {
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: coll.span,
                by: ("a collection literal", typeDisplay(ref c, by: target), "", "", ""),
            )
        }
        for e in coll.elements {
            let _ = bindExpr(ref b, through: ref c, for: in e)
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        )
    }
    var elements = List<BExpr>()
    for e in coll.elements {
        switch e {
            case .spreadExpr(let s): elements.append(bindSpread(ref b, through: ref c, for: in s.value, to: element))
            default: elements.append(bindConverted(ref b, through: ref c, for: in e, to: element))
        }
    }
    return t35FinishCollection(ref b, through: ref c, for: in coll, to: target, from: in elements)
}

/// The C# `target switch { ListType l => l.Element, SpanType s => s.Element, ArrayType a => a.Element, _ => null }`
/// (BinderExpressions.cs:1646, :1734); -1 for null.
Type t35ElementOf(ref Ctx c, for Type t) {
    return -1 if t == -1
    switch kindOf(t) {
        case .list: return c.listTypes[typeIndex(t)]
        case .span: return c.spanTypes[typeIndex(t)].element
        case .array: return c.arrayTypes[typeIndex(t)].element
        default: return -1
    }
}

/// `type is NullType or PrimitiveType { Kind: PrimitiveKind.Void or PrimitiveKind.Never }` (BinderExpressions.cs:1683, :1805, :1870).
bool t35CannotInfer(Type t) => kindOf(t) == .nullType || isVoid(t) || isNever(t)

/// BinderExpressions.cs:1674 BindUntypedCollection: `[1, 2, 3]` with no target type, a fixed array of the first element's type.
BExpr t35BindUntypedCollection(ref Binder b, through ref Ctx c, for in parser.CollectionExpr coll) {
    var first: BExpr = -1
    switch coll.elements[0] {
        case .spreadExpr(let s): first = bindSpread(ref b, through: ref c, for: in s.value, to: -1)
        default: first = bindExpr(ref b, through: ref c, for: in coll.elements[0])
    }
    let element = exprType(in c, for: first)
    let span0 = parser.exprSpan(in coll.elements[0])
    if isError(element) {
        for i in 1..coll.elements.length {
            let _ = bindExpr(ref b, through: ref c, for: in coll.elements[i])
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        )
    }
    if t35CannotInfer(element) {
        report(
            ref b,
            through: ref c,
            for: .cannotInferType,
            at: span0,
            by: (t15Text(in c, from: b.file, at: span0), "", "", "", ""),
            help: "declare the type: `List<i64> xs = [1, 2]`",
        )
        for i in 1..coll.elements.length {
            let _ = bindExpr(ref b, through: ref c, for: in coll.elements[i])
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        )
    }
    if functionTypeNotHere(ref c, for: element, from: b.file, at: span0, as: "an array element") {
        for i in 1..coll.elements.length {
            let _ = bindExpr(ref b, through: ref c, for: in coll.elements[i])
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        )
    }
    if boundKind(first) != .spread {
        first = convert(ref b, through: ref c, for: first, to: element, at: span0)
    }
    var elements = List<BExpr>()
    elements.append(first)
    for i in 1..coll.elements.length {
        switch coll.elements[i] {
            case .spreadExpr(let s): elements.append(bindSpread(ref b, through: ref c, for: in s.value, to: element))
            default: elements.append(bindConverted(ref b, through: ref c, for: in coll.elements[i], to: element))
        }
    }
    let array = internArray(ref c, by: element, at: t35KnownLength(ref c, for: in elements) ?? elements.length)
    return t35FinishCollection(ref b, through: ref c, for: in coll, to: array, from: in elements)
}

/// BinderExpressions.cs:1700 FinishCollection: spreads into stack storage must have a compile-time length. `elements[i]` is
/// bound from `coll.elements[i]`, so C#'s `BoundErrorExpr { Syntax: SpreadExpr }` is an error bound from a spread element (Q675).
BExpr t35FinishCollection(
    ref Binder b,
    through ref Ctx c,
    for in parser.CollectionExpr coll,
    to Type target,
    from in List<BExpr> elements
) {
    for i in 0..elements.length {
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        ) if boundKind(elements[i]) == .errorExpr
            && coll.elements[i] is .spreadExpr(_)
    }
    if kindOf(target) != .list {
        for e in elements {
            continue if boundKind(e) != .spread
            let operand = c.bSpreads[boundIndex(e)].operand
            let operandType = exprType(in c, for: operand)
            continue if kindOf(operandType) == .array
            let openSpan = c.bSpreads[boundIndex(e)].span
            let openType = c.bSpreads[boundIndex(e)].type
            let text = t15Text(in c, from: b.file, at: openSpan)
            let shape = kindOf(target) == .span ? "Span" : "T[N]"
            report(
                ref b,
                through: ref c,
                for: .notConstant,
                at: openSpan,
                by: ($"the length of `{text}` in a `{shape}` literal", "", "", "", ""),
                label: $"a `{typeDisplay(ref c, by: operandType)}` has a run-time length",
                help: $"spread a fixed array `T[N]` here, or build a list: `List<{typeDisplay(ref c, by: openType)}> all = {t15Text(in c, from: b.file, at: coll.span)}`",
            )
            return recordSyntaxNode(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
                at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
            )
        }
    }
    if kindOf(target) == .array {
        let known = t35KnownLength(ref c, for: in elements)
        if known is null || c.arrayTypes[typeIndex(target)].length != known {
            let knownText = known is { } k ? $"{k}" : ""
            report(
                ref b,
                through: ref c,
                for: .arrayLengthMismatch,
                at: coll.span,
                by: (typeDisplay(ref c, by: target), knownText, "", "", ""),
            )
        }
    }
    var copy = List<BExpr>()
    for e in elements {
        copy.append(e)
    }
    return recordSyntaxNode(
        ref c,
        for: addCollection(ref c, from: BCollection { span: coll.span, type: target, elements: move copy }),
        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
    )
}

/// BinderExpressions.cs:1717 KnownLength: each spread fixed array counts its length; null if a spread's length is known only at run time.
i64? t35KnownLength(ref Ctx c, for in List<BExpr> elements) {
    var n: i64 = 0
    for e in elements {
        if boundKind(e) != .spread {
            n += 1
        } else {
            let operandType = exprType(in c, for: c.bSpreads[boundIndex(e)].operand)
            if kindOf(operandType) == .array {
                n += c.arrayTypes[typeIndex(operandType)].length
            } else {
                return null
            }
        }
    }
    return n
}

/// BinderExpressions.cs:1730 BindSpread: `..xs` in a list, span or array literal; any element type when `element` is -1.
BExpr bindSpread(ref Binder b, through ref Ctx c, for in parser.SpreadExpr s, to Type element) {
    let operand = bindExpr(ref b, through: ref c, for: in s.operand)
    let operandType = exprType(in c, for: operand)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
        at: syntaxLeaf(ref c, as: .spreadExpr, at: s.span),
    ) if isError(operandType)
    let item = t35ElementOf(ref c, for: operandType)
    let text = t15Text(in c, from: b.file, at: parser.exprSpan(in s.operand))
    if item == -1 {
        var help = "spread a `List`, `Span` or fixed array; a single value goes in without `..`"
        if element != -1 && implicit(ref c, from: operandType, to: element) is not null {
            help = $"drop the `..` to add `{text}` as one element"
        }
        report(
            ref b,
            through: ref c,
            for: .spreadNotSequence,
            at: s.span,
            by: (text, typeDisplay(ref c, by: operandType), "", "", ""),
            label: "not a `List`, `Span` or fixed array",
            help: help,
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
            at: syntaxLeaf(ref c, as: .spreadExpr, at: s.span),
        )
    }
    if element != -1 && item != element {
        let itemName = typeDisplay(ref c, by: item)
        let elementName = typeDisplay(ref c, by: element)
        report(
            ref b,
            through: ref c,
            for: .typeMismatch,
            at: s.span,
            by: (itemName, elementName, "", "", ""),
            label: $"`{text}` holds `{itemName}`",
            help: $"spread a sequence of `{elementName}`, or change the literal's element type to `{itemName}`",
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
            at: syntaxLeaf(ref c, as: .spreadExpr, at: s.span),
        )
    }
    if isUnique(ref c, for: item) {
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: s.span,
            by: ($"spreading elements that own memory (`{typeDisplay(ref c, by: item)}`)", "", "", "", ""),
            help: "add the elements one at a time with `move`",
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
            at: syntaxLeaf(ref c, as: .spreadExpr, at: s.span),
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addSpread(ref c, from: BSpread { span: s.span, operand: operand, type: item }),
        at: syntaxLeaf(ref c, as: .spreadExpr, at: s.span),
    )
}

/// BinderExpressions.cs:1768 BindMapLiteral: `["k": v, …]`, a `Map` typed by the target or, without one, by the first entry.
/// C#'s `entries` array is `coll.elements` from index `start` (every element is an entry past the first check).
BExpr bindMapLiteral(ref Binder b, through ref Ctx c, for in parser.CollectionExpr coll, to Type target) {
    for e in coll.elements {
        continue if e is .mapEntryExpr(_)
        report(
            ref b,
            through: ref c,
            for: .mapLiteralMixed,
            at: parser.exprSpan(in e),
            by: ("", "", "", "", ""),
            label: "no `key:` here",
            help: "write every element as `key: value`, or remove the keys to make a list",
        )
        for x in coll.elements {
            t35BindMapPart(ref b, through: ref c, for: in x)
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        )
    }
    var parts = List<BExpr>()
    var map: Type = -1
    var start: i64 = 0
    if target != -1 && kindOf(target) == .map {
        map = target
    } else if target == -1 {
        switch coll.elements[0] {
            case .mapEntryExpr(let first):
                let keySpan = parser.exprSpan(in first.value.key)
                let valueSpan = parser.exprSpan(in first.value.value)
                let key = bindExpr(ref b, through: ref c, for: in first.value.key)
                let value = bindExpr(ref b, through: ref c, for: in first.value.value)
                let keyType = exprType(in c, for: key)
                let valueType = exprType(in c, for: value)
                if isError(keyType) || isError(valueType) {
                    for i in 1..coll.elements.length {
                        t35BindMapPart(ref b, through: ref c, for: in coll.elements[i])
                    }
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
                        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
                    )
                }
                if !isValidKey(ref c, by: keyType) {
                    if (invalidKeyPart(ref c, by: keyType) is { } part) {
                        report(
                            ref b,
                            through: ref c,
                            for: .keyPartNotHashable,
                            at: keySpan,
                            by: (
                                typeDisplay(ref c, by: keyType),
                                kindOf(keyType) == .tuple
                                    ? "element"
                                    : "field",
                                part.part,
                                typeDisplay(ref c, by: part.type),
                                ""
                            ),
                            help: "use a field that identifies the value as the key, such as an id or a `Symbol`",
                        )
                    } else {
                        report(
                            ref b,
                            through: ref c,
                            for: .invalidMapKey,
                            at: keySpan,
                            by: (typeDisplay(ref c, by: keyType), "", "", "", ""),
                            help: "use an integer type, `rune`, `bool`, `string`, `Symbol`, a plain enum, or a tuple or struct of those as the key",
                        )
                    }
                    for i in 1..coll.elements.length {
                        t35BindMapPart(ref b, through: ref c, for: in coll.elements[i])
                    }
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
                        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
                    )
                }
                if t35CannotInfer(valueType) {
                    report(
                        ref b,
                        through: ref c,
                        for: .cannotInferType,
                        at: valueSpan,
                        by: (t15Text(in c, from: b.file, at: valueSpan), "", "", "", ""),
                        help: $"declare the type: `Map<{typeDisplay(ref c, by: keyType)}, i64?> m = [ … ]`",
                    )
                    for i in 1..coll.elements.length {
                        t35BindMapPart(ref b, through: ref c, for: in coll.elements[i])
                    }
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
                        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
                    )
                }
                if functionTypeNotHere(ref c, for: valueType, from: b.file, at: valueSpan, as: "a map value") {
                    for i in 1..coll.elements.length {
                        t35BindMapPart(ref b, through: ref c, for: in coll.elements[i])
                    }
                    return recordSyntaxNode(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
                        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
                    )
                }
                map = internMap(ref c, by: keyType, to: valueType)
                parts.append(convert(ref b, through: ref c, for: key, to: keyType, at: keySpan))
                parts.append(convert(ref b, through: ref c, for: value, to: valueType, at: valueSpan))
                start = 1
            default: {}
        }
    } else {
        if !isError(target) {
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: coll.span,
                by: ("a map literal", typeDisplay(ref c, by: target), "", "", ""),
            )
        }
        for x in coll.elements {
            t35BindMapPart(ref b, through: ref c, for: in x)
        }
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        )
    }
    let keyType = c.mapTypes[typeIndex(map)].key
    let valueType = c.mapTypes[typeIndex(map)].value
    for i in start..coll.elements.length {
        switch coll.elements[i] {
            case .mapEntryExpr(let e):
                parts.append(bindConverted(ref b, through: ref c, for: in e.value.key, to: keyType))
                parts.append(bindConverted(ref b, through: ref c, for: in e.value.value, to: valueType))
            default: {}
        }
    }
    for p in parts {
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: coll.span }),
            at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
        ) if isError(exprType(in c, for: p))
    }
    return recordSyntaxNode(
        ref c,
        for: addCollection(ref c, from: BCollection { span: coll.span, type: map, elements: move parts }),
        at: syntaxLeaf(ref c, as: .collectionExpr, at: coll.span),
    )
}

/// BinderExpressions.cs:1838 BindMapPart: binds the parts of a map literal element for recovery.
void t35BindMapPart(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    switch e {
        case .mapEntryExpr(let entry):
            let _ = bindExpr(ref b, through: ref c, for: in entry.value.key)
            let _ = bindExpr(ref b, through: ref c, for: in entry.value.value)
        case .spreadExpr(let s):
            let _ = bindExpr(ref b, through: ref c, for: in s.value.operand)
        default:
            let _ = bindExpr(ref b, through: ref c, for: in e)
    }
}

/// BinderExpressions.cs:1849 BindTuple.
BExpr bindTuple(ref Binder b, through ref Ctx c, for in parser.TupleExpr t, to Type expected) {
    let target = expected != -1 && kindOf(expected) == .optional ? c.optionalTypes[typeIndex(expected)] : expected
    if target != -1 && kindOf(target) == .tuple && c.tupleTypes[typeIndex(target)].length == t.elements.length {
        var values = List<BExpr>()
        for i in 0..t.elements.length {
            let fieldName = c.tupleTypes[typeIndex(target)][i].name
            let fieldType = c.tupleTypes[typeIndex(target)][i].type
            if (t.elements[i].name is { } n) {
                if fieldName is not null {
                    let text = t15Text(in c, from: b.file, at: n)
                    if text != fieldName {
                        report(ref b, through: ref c, for: .tupleNameMismatch, at: n, by: (text, fieldName, "", "", ""))
                    }
                }
            }
            values.append(bindConverted(ref b, through: ref c, for: in t.elements[i].value, to: fieldType))
        }
        return recordSyntaxNode(
            ref c,
            for: addTuple(ref c, from: BTuple { span: t.span, tupleType: target, elements: move values }),
            at: syntaxLeaf(ref c, as: .tupleExpr, at: t.span),
        )
    }
    var elements = List<BExpr>()
    for e in t.elements {
        elements.append(bindExpr(ref b, through: ref c, for: in e.value))
    }
    var anyError = target != -1 && isError(target)
    for e in elements {
        if isError(exprType(in c, for: e)) {
            anyError = true
        }
    }
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }),
        at: syntaxLeaf(ref c, as: .tupleExpr, at: t.span),
    ) if anyError
    var fields = List<TupleField>()
    for i in 0..elements.length {
        let type = exprType(in c, for: elements[i])
        if t35CannotInfer(type) {
            report(
                ref b,
                through: ref c,
                for: .cannotInferType,
                at: t.elements[i].span,
                by: (t15Text(in c, from: b.file, at: t.elements[i].span), "", "", "", ""),
            )
            return recordSyntaxNode(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }),
                at: syntaxLeaf(ref c, as: .tupleExpr, at: t.span),
            )
        }
        var name: string? = null
        if (t.elements[i].name is { } n) {
            name = t15Text(in c, from: b.file, at: n)
        }
        fields.append(TupleField { name: name, type: type })
    }
    var notHere: i64 = 0
    for i in 0..fields.length {
        if functionTypeNotHere(
            ref c,
            for: fields[i].type,
            from: b.file,
            at: parser.exprSpan(in t.elements[i].value),
            as: "a tuple element"
        ) {
            notHere += 1
        }
    }
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }),
        at: syntaxLeaf(ref c, as: .tupleExpr, at: t.span),
    ) if notHere > 0
    let tupleType = internTuple(ref c, for: in fields)
    return recordSyntaxNode(
        ref c,
        for: addTuple(ref c, from: BTuple { span: t.span, tupleType: tupleType, elements: move elements }),
        at: syntaxLeaf(ref c, as: .tupleExpr, at: t.span),
    )
}

/// BinderExpressions.cs:1888 BindLambda: a lambda, lifted to a `.lambda` function of the module and bound inline with its own
/// scope, loops and `return`; the outer locals it reads are its captures (spec 007 R6, R8). `expected` -1 is C#'s null.
BExpr bindLambda(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    for in List<TextSpan> parameters,
    from in parser.Expr? body,
    by in parser.BlockStmt? block,
    to Type expected
) {
    if expected == -1 {
        report(
            ref b,
            through: ref c,
            for: .noTargetType,
            at: span,
            by: (t15Text(in c, from: b.file, at: span), "", "", "", ""),
            help: "write the function type it has, such as `let f: i64 -> i64 = x => x`",
        )
        return addErrorExpr(ref c, from: BErrorExpr { span: span })
    }
    let fi = typeIndex(expected)
    let count = c.functionTypes[fi].parameters.length
    if parameters.length != count {
        var names = "x"
        if count != 1 {
            var sb = StrBuf()
            sb.append("(")
            for i in 0..count {
                if i > 0 {
                    sb.append(", ")
                }
                sb.append($"{rune(u32(0x61 + i))}")
            }
            sb.append(")")
            names = $"{sb.finish()}"
        }
        report(
            ref b,
            through: ref c,
            for: .lambdaArity,
            at: span,
            by: ($"{parameters.length}", typeDisplay(ref c, by: expected), $"{count}", "", ""),
            help: $"write {count} parameter name(s): `{names} => …`",
        )
        return addErrorExpr(ref c, from: BErrorExpr { span: span })
    }
    if b.fn == -1 {
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: span,
            by: ("a lambda outside a function body", "", "", "", ""),
        )
        return addErrorExpr(ref c, from: BErrorExpr { span: span })
    }
    // Numbered in the order the enclosing function's lambdas are bound, which is source order (L009).
    let ordinal = (b.lambdaCount.tryGet(at: b.fn) ?? 0) + 1
    b.lambdaCount[b.fn] = ordinal
    var errorSets = List<ErrorSetId>()
    for e in c.functionTypes[fi].errorSets {
        errorSets.append(e)
    }
    var paramTypes = List<Type>()
    for p in c.functionTypes[fi].parameters {
        paramTypes.append(p)
    }
    let module = c.files[b.file].module
    let hasFails = errorSets.length > 0
    let lambda = newFunction(ref c, by: FunctionSymbol {
        name: $"{c.functions[b.fn].name}$lambda{ordinal}",
        span: span,
        module: module,
        kind: .lambda,
        file: b.file,
        returnType: c.functionTypes[fi].ret,
        hasFails: hasFails,
        enclosing: b.fn,
        errorSets: move errorSets,
    })
    c.modules[module].allFunctions.append(lambda)
    // `break`, `continue`, `return` and `defer` in the body are the lambda's own.
    let fn = b.fn
    var targets = List<JumpTarget>()
    for t in b.targets {
        targets.append(t)
    }
    let deferDepth = b.deferDepth
    let inPanicHandler = b.inPanicHandler
    let firstStatementFile = b.firstStatementFile
    let firstStatementSpan = b.firstStatementSpan
    b.fn = lambda
    b.deferDepth = 0
    b.inPanicHandler = false
    b.firstStatementFile = -1
    b.targets = List<JumpTarget>()
    b.lambdas.append((lambda, List<BExpr>()))
    pushScope(ref b)
    for i in 0..parameters.length {
        checkValueName(ref b, through: ref c, at: parameters[i])
        let local = newLocal(ref c, by: LocalSymbol {
            name: t15Text(in c, from: b.file, at: parameters[i]),
            nameSpan: parameters[i],
            span: parameters[i],
            type: paramTypes[i],
            kind: .parameter,
            id: b.nextLocalId,
            isParameter: true,
            modifier: .none,
            ordinal: i,
        })
        b.nextLocalId += 1
        addLocal(ref b, through: ref c, at: parameters[i], for: local)
    }
    var lambdaParams = List<LocalId>()
    for l in c.functions[lambda].locals {
        if c.locals[l].isParameter {
            lambdaParams.append(l)
        }
    }
    for l in lambdaParams {
        c.functions[lambda].parameters.append(l)
    }
    var lambdaBody: BStmt = -1
    if (block is { } blk) {
        lambdaBody = bindBlock(ref b, through: ref c, for: in blk)
    } else if (body is { } e) {
        var statements = List<BStmt>()
        statements.append(bindExpressionBody(ref b, through: ref c, for: in e))
        lambdaBody = recordSyntax(
            ref c,
            for: addBlock(ref c, from: BBlock { span: parser.exprSpan(in e), statements: move statements }),
            from: in e,
        )
    }
    c.functions[lambda].body = lambdaBody
    popScope(ref b)
    var captures = List<BExpr>()
    switch b.lambdas[b.lambdas.length - 1] {
        case (let _, let caps):
            for x in caps {
                captures.append(x)
            }
    }
    b.lambdas.remove(at: b.lambdas.length - 1)
    for t in targets {
        b.targets.append(t)
    }
    b.fn = fn
    b.deferDepth = deferDepth
    b.inPanicHandler = inPanicHandler
    b.firstStatementFile = firstStatementFile
    b.firstStatementSpan = firstStatementSpan
    return addLambda(
        ref c,
        from: BLambda { span: span, lambda: lambda, captures: move captures, functionType: expected },
    )
}

/// BinderExpressions.cs:1950 InLambda: a read of `this` inside a lambda, which does not capture it: BYN2821 (spec 007 R8).
bool inLambda(ref Binder b, through ref Ctx c, at TextSpan span, for string name, by string reason) {
    return false if b.fn == -1 || c.functions[b.fn].kind != .lambda
    report(
        ref b,
        through: ref c,
        for: .cannotCapture,
        at: span,
        by: (name, reason, "", "", ""),
        help: "copy the fields you need into `let` values first",
    )
    return true
}

/// The lambda of `b.lambdas[i]` (C# `_lambdas[i].Lambda`).
FuncId t35LambdaAt(in Binder b, at i64 i) {
    switch b.lambdas[i] {
        case (let lambda, let _): return lambda
    }
}

/// BinderExpressions.cs:1961 Capture: records `local`, read as `type`, as a capture of each lambda being bound that it is outer
/// to; false after BYN2821 when it is mutable or a parameter with a modifier (spec 007 R8).
bool capture(ref Binder b, through ref Ctx c, for in parser.NameExpr n, by LocalId local, as Type type) {
    return true if b.lambdas.length == 0
        || listContains(in c.functions[t35LambdaAt(in b, at: b.lambdas.length - 1)].locals, by: local)
    var reason: string? = null
    var help = ""
    if c.locals[local].isParameter && c.locals[local].modifier != .none {
        var m = ""
        switch c.locals[local].modifier {
            case .refKeyword: m = "ref"
            case .moveKeyword: m = "move"
            case .outKeyword: m = "out"
            case .inKeyword: m = "in"
            case .none: m = "none"
        }
        reason = $"it is a `{m}` parameter"
        help = "pass it as a plain parameter"
    } else if localIsMutable(ref c, by: local) {
        reason = "it is a `var`"
        help = "copy it into a `let` first"
    }
    if (reason is { } why) {
        report(
            ref b,
            through: ref c,
            for: .cannotCapture,
            at: n.span,
            by: (c.locals[local].name, why, "", "", ""),
            help: help,
        )
        return false
    }
    var i = b.lambdas.length - 1
    while i >= 0 && !listContains(in c.functions[t35LambdaAt(in b, at: i)].locals, by: local) {
        let lambda = t35LambdaAt(in b, at: i)
        if listContains(in c.functions[lambda].captures, by: local) {
            i -= 1
            continue
        }
        c.functions[lambda].captures.append(local)
        let read = recordSyntaxNode(
            ref c,
            for: addLocalNode(ref c, at: n.span, for: local),
            at: syntaxLeaf(ref c, as: .nameExpr, at: n.span),
        )
        c.bLocals[boundIndex(read)].type = type
        var caps = List<BExpr>()
        switch b.lambdas[i] {
            case (let _, let old):
                for x in old {
                    caps.append(x)
                }
        }
        caps.append(read)
        b.lambdas[i] = (lambda, move caps)
        i -= 1
    }
    return true
}

/// BinderExpressions.cs:1985 BindStackalloc.
BExpr bindStackalloc(ref Binder b, through ref Ctx c, for in parser.StackallocExpr s) {
    let element = resolveType(ref b, through: ref c, for: in s.element)
    let count = bindConverted(ref b, through: ref c, for: in s.count, to: prim(.i64))
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
        at: syntaxLeaf(ref c, as: .stackallocExpr, at: s.span),
    ) if isError(element)
        || isError(exprType(in c, for: count))
    let countSpan = parser.exprSpan(in s.count)
    let k = exprConstant(in c, for: count)
    if k is null || k.kind != .integer {
        report(
            ref b,
            through: ref c,
            for: .notConstant,
            at: countSpan,
            by: ("a `stackalloc` length", "", "", "", ""),
            help: "use a constant length: `stackalloc u8[64]`; v0.1 supports no other",
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
            at: syntaxLeaf(ref c, as: .stackallocExpr, at: s.span),
        )
    }
    let n = k.integer
    if bigCmp(n, as: bigZero()) <= 0 || bigCmp(n, as: bigFromI64(1048576)) > 0 {
        report(
            ref b,
            through: ref c,
            for: .literalOutOfRange,
            at: countSpan,
            by: (bigText(n), "a `stackalloc` length (1 to 1048576)", "", "", ""),
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
            at: syntaxLeaf(ref c, as: .stackallocExpr, at: s.span),
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addStackalloc(
            ref c,
            from: BStackalloc {
                span: s.span,
                element: element,
                count: bigToI64(n),
                type: internSpan(ref c, by: element, readOnly: false),
            },
        ),
        at: syntaxLeaf(ref c, as: .stackallocExpr, at: s.span),
    )
}

/// The member text of `e` when it is a `.member` (C# `TargetMemberExpr { Member.Text: var m }`), else null.
string? t35TargetMember(in Ctx c, from FileId f, for in parser.Expr e) {
    switch e {
        case .targetMemberExpr(let tm): return t15Text(in c, from: f, at: tm.value.member)
        default: return null
    }
}

/// BinderExpressions.cs:2004 BindInterpolated.
BExpr bindInterpolated(ref Binder b, through ref Ctx c, for in parser.InterpolatedExpr i) {
    var parts = List<BInterpolationPart>()
    for part in i.parts {
        switch part {
            case .interpolationText(let text):
                parts.append(BInterpolationPart { text: text.value.text })
            case .interpolationHole(let hole):
                let value = bindExpr(ref b, through: ref c, for: in hole.value.expr)
                let valueType = exprType(in c, for: value)
                // `as: .debug` shows a struct without `formatInto` in its literal form (SPEC §6.6).
                var debug = false
                for a in hole.value.specs {
                    if (a.name is { } an) {
                        if t15Text(in c, from: b.file, at: an) == "as"
                                && t35TargetMember(in c, from: b.file, for: in a.value) == "debug" {
                            debug = true
                        }
                    }
                }
                if !isError(valueType) {
                    var seen = List<Type>()
                    let why = debug ? t35WhyNotDebugFormattable(
                        ref c,
                        for: valueType,
                        by: ref seen,
                    ) : whyNotFormattable(ref c, for: valueType, by: ref seen)
                    if why is not null {
                        var help = ""
                        if kindOf(valueType) == .structType && !debug {
                            help = $"add `formatInto(ref StrBuf)` to `{c.structs[typeIndex(valueType)].name}`, or use `{{x, as: .debug}}`"
                        }
                        report(
                            ref b,
                            through: ref c,
                            for: .notFormattable,
                            at: parser.exprSpan(in hole.value.expr),
                            by: (typeDisplay(ref c, by: valueType), "", "", "", ""),
                            label: why,
                            help: help,
                        )
                    }
                }
                var spec: BFormatSpec? = null
                if !(hole.value.specs.length == 0 || isError(valueType)) {
                    spec = bindFormatSpec(ref b, through: ref c, for: in hole.value.specs, as: valueType)
                }
                parts.append(BInterpolationPart { value: value, spec: spec })
        }
    }
    return recordSyntaxNode(
        ref c,
        for: addInterpolated(ref c, from: BInterpolated { span: i.span, parts: move parts }),
        at: syntaxLeaf(ref c, as: .interpolatedExpr, at: i.span),
    )
}

/// BinderExpressions.cs:2030 BindFormatSpec: `as:` a radix on integers or `.debug`, `digits:` on floats, `width:`, `fill:` and
/// `align:` on any value (spec §16.4). Each is a constant; a spec that does not apply is BYN2021.
BFormatSpec bindFormatSpec(ref Binder b, through ref Ctx c, for in List<parser.Argument> specs, as Type type) {
    var spec = BFormatSpec { radix: 0, debug: false, width: 0, fill: 32, align: -1, digits: -1 }
    var seen = List<string>()
    for a in specs {
        var name = ""
        if (a.name is { } an) {
            name = t15Text(in c, from: b.file, at: an)
        }
        if listContainsString(in seen, by: name) {
            report(ref b, through: ref c, for: .duplicateArgument, at: a.span, by: (name, "", "", "", ""))
            continue
        }
        seen.append(name)
        let member = t35TargetMember(in c, from: b.file, for: in a.value)
        let valueSpan = parser.exprSpan(in a.value)
        let radixType = t9Type(ref c, for: "Radix")
        var radixMember: EnumMemberId = -1
        if member is not null {
            radixMember = findEnumMember(ref c, by: typeIndex(radixType), for: member)
        }
        if name == "as" && member == "debug" {
            spec.debug = true
        } else if name == "as" && member is not null && radixMember != -1 {
            if !isInteger(type) && !t35TakesFormatSpec(ref c, for: type) {
                report(
                    ref b,
                    through: ref c,
                    for: .unknownParameter,
                    at: a.span,
                    by: (typeDisplay(ref c, by: type), $"as: .{member}", "", "", ""),
                )
            } else {
                let ordinal = c.enumMembers[radixMember].ordinal
                spec.radix = ordinal == 0 ? 2 : ordinal == 1 ? 8 : ordinal == 2 ? 10 : 16
            }
        } else if name == "as" {
            let _ = bindConverted(ref b, through: ref c, for: in a.value, to: radixType)
        } else if name is "width" or "digits" {
            let n = bindConverted(ref b, through: ref c, for: in a.value, to: prim(.i64))
            continue if isError(exprType(in c, for: n))
            let k = exprConstant(in c, for: n)
            if k is null || k.kind != .integer {
                report(
                    ref b,
                    through: ref c,
                    for: .notConstant,
                    at: valueSpan,
                    by: ($"a format spec's `{name}`", "", "", "", ""),
                )
                continue
            }
            let v = k.integer
            if name == "width" && (bigCmp(v, as: bigZero()) < 0 || bigCmp(v, as: bigFromI64(1024)) > 0) {
                report(
                    ref b,
                    through: ref c,
                    for: .literalOutOfRange,
                    at: valueSpan,
                    by: (bigText(v), "a format spec's `width` (0 to 1024)", "", "", ""),
                )
            } else if name == "digits" && (bigCmp(v, as: bigZero()) < 0 || bigCmp(v, as: bigFromI64(15)) > 0) {
                report(
                    ref b,
                    through: ref c,
                    for: .literalOutOfRange,
                    at: valueSpan,
                    by: (bigText(v), "a format spec's `digits` (0 to 15)", "", "", ""),
                )
            } else if name == "digits" && !isFloat(type) && !t35TakesFormatSpec(ref c, for: type) {
                report(
                    ref b,
                    through: ref c,
                    for: .unknownParameter,
                    at: a.span,
                    by: (typeDisplay(ref c, by: type), "digits", "", "", ""),
                )
            } else if name == "width" {
                spec.width = bigToI64(v)
            } else {
                spec.digits = bigToI64(v)
            }
        } else if name == "fill" {
            let fill = bindConverted(ref b, through: ref c, for: in a.value, to: prim(.char))
            continue if isError(exprType(in c, for: fill))
            if (exprConstant(in c, for: fill) is { } k) {
                spec.fill = k.rune
            } else {
                report(
                    ref b,
                    through: ref c,
                    for: .notConstant,
                    at: valueSpan,
                    by: ("a format spec's `fill`", "", "", "", ""),
                )
            }
        } else if name == "align" && (member == "start" || member == "end" || member == "center") {
            spec.align = member == "start" ? 0 : member == "end" ? 1 : 2
        } else if name == "align" {
            report(
                ref b,
                through: ref c,
                for: .unknownEnumMember,
                at: valueSpan,
                by: (member ?? t15Text(in c, from: b.file, at: valueSpan), "align", "", "", ""),
            )
        } else {
            report(
                ref b,
                through: ref c,
                for: .unknownParameter,
                at: a.span,
                by: (typeDisplay(ref c, by: type), name, "", "", ""),
            )
        }
    }
    return spec
}

/// BinderExpressions.cs:2087 IsFormattable.
bool isFormattable(ref Ctx c, for Type t) {
    var seen = List<Type>()
    return whyNotFormattable(ref c, for: t, by: ref seen) is null
}

/// BinderExpressions.cs:2093 WhyNotFormattable: null when `t` formats; otherwise the part that does not ("" for `t` itself).
/// `Owned` formats the value it points to; a type reached again is assumed formattable.
string? whyNotFormattable(ref Ctx c, for Type t, by ref List<Type> seen) {
    let i = typeIndex(t)
    switch kindOf(t) {
        case .primitive: return !(isVoid(t) || isNever(t)) ? null : ""
        case .errorSet or .errorUnion or .enumType or .typeParam: return null
        case .builtin: return builtinKindOf(i) == .symbol || builtinKindOf(i) == .millis ? null : ""
        case .optional: return t35Part(ref c, for: "the value", as: c.optionalTypes[i], by: ref seen)
        case .result: return t35Part(ref c, for: "the value", as: c.resultTypes[i].value, by: ref seen)
        case .owned: return whyNotFormattable(ref c, for: c.ownedTypes[i], by: ref seen)
        // Structs have no default display (SPEC §6.6): only `formatInto` formats one.
        case .structType: return t35HasFormatInto(ref c, for: i) ? null : ""
        case .unionType:
            return null if listContains(in seen, by: t)
            seen.append(t)
            var variants = List<VariantId>()
            for v in c.unions[i].variants {
                variants.append(v)
            }
            for v in variants {
                var fields = List<LocalId>()
                for f in c.unionVariants[v].fields {
                    fields.append(f)
                }
                for f in fields {
                    let w = t35Part(
                        ref c,
                        for: $"`{c.unionVariants[v].name}` field `{c.locals[f].name}`",
                        as: c.locals[f].type,
                        by: ref seen,
                    )
                    return w if w is not null
                }
            }
            return null
        case .tuple:
            var types = List<Type>()
            for f in c.tupleTypes[i] {
                types.append(f.type)
            }
            for k in 0..types.length {
                let w = t35Part(ref c, for: $"element {k + 1}", as: types[k], by: ref seen)
                return w if w is not null
            }
            return null
        case .map:
            let key = c.mapTypes[i].key
            let value = c.mapTypes[i].value
            let w = t35Part(ref c, for: "the key", as: key, by: ref seen)
            return w if w is not null
            return t35Part(ref c, for: "the value", as: value, by: ref seen)
        // Lists, spans and arrays do not format; an unformattable element is still named.
        case .list: return t35Part(ref c, for: "an element", as: c.listTypes[i], by: ref seen) ?? ""
        case .span: return t35Part(ref c, for: "an element", as: c.spanTypes[i].element, by: ref seen) ?? ""
        case .array: return t35Part(ref c, for: "an element", as: c.arrayTypes[i].element, by: ref seen) ?? ""
        default: return ""
    }
}

/// BinderExpressions.cs:2114 WhyNotDebugFormattable: as `whyNotFormattable`, under `as: .debug`: a struct formats when each of its fields does.
string? t35WhyNotDebugFormattable(ref Ctx c, for Type t, by ref List<Type> seen) {
    if kindOf(t) == .structType && !t35TakesFormatSpec(ref c, for: t) {
        return null if listContains(in seen, by: t)
        seen.append(t)
        var fields = List<FieldId>()
        for f in c.structs[typeIndex(t)].fields {
            fields.append(f)
        }
        for f in fields {
            let ft = c.fields[f].type
            if (t35WhyNotDebugFormattable(ref c, for: ft, by: ref seen) is { } why) {
                return why == "" ? $"field `{c.fields[f].name}` is `{typeDisplay(ref c, by: ft)}`" : why
            }
        }
        return null
    }
    return whyNotFormattable(ref c, for: t, by: ref seen)
}

/// BinderExpressions.cs:2123 Part: why `part` of a type does not format, naming it when it is the culprit.
string? t35Part(ref Ctx c, for string name, as Type part, by ref List<Type> seen) {
    if (whyNotFormattable(ref c, for: part, by: ref seen) is { } why) {
        return why == "" ? $"{name} is `{typeDisplay(ref c, by: part)}`" : why
    }
    return null
}

/// BinderExpressions.cs:2127 PropertyType: the type of a built-in property, with the builtin enums `BuiltinMembers` cannot name.
Type propertyType(ref Binder b, through ref Ctx c, for BuiltinMember member, as Type type) {
    switch member {
        case .formatSpecRadix: return t9Type(ref c, for: "Radix")
        case .formatSpecAlign: return t9Type(ref c, for: "Align")
        default: return type
    }
}

/// BinderExpressions.cs:2135 HasFormatInto: matches the C emitter's `formatInto` lookup.
bool t35HasFormatInto(ref Ctx c, for StructId s) {
    var methods = List<FuncId>()
    for m in c.structs[s].methods {
        methods.append(m)
    }
    for m in methods {
        let n = c.functions[m].parameters.length
        if c.functions[m].name == "formatInto" && !c.functions[m].isStatic && !c.functions[m].hasFails && (n is 1 or 2)
                && paramIsByRef(ref c, by: c.functions[m].parameters[0])
                && c.locals[c.functions[m].parameters[0]].type == builtinType(.strBuf)
                && (n == 1
                || (!paramIsByRef(ref c, by: c.functions[m].parameters[1])
                && c.locals[c.functions[m].parameters[1]].type == builtinType(.formatSpec))) {
            return true
        }
    }
    return false
}

/// BinderExpressions.cs:2141 TakesFormatSpec: whether `t` is a struct whose `formatInto` takes the hole's `FormatSpec`.
bool t35TakesFormatSpec(ref Ctx c, for Type t) {
    return false if kindOf(t) != .structType
    var methods = List<FuncId>()
    for m in c.structs[typeIndex(t)].methods {
        methods.append(m)
    }
    for m in methods {
        if c.functions[m].name == "formatInto"
                && !c.functions[m].isStatic
                && !c.functions[m].hasFails
                && c.functions[m].parameters.length == 2
                && paramIsByRef(ref c, by: c.functions[m].parameters[0])
                && c.locals[c.functions[m].parameters[0]].type == builtinType(.strBuf)
                && !paramIsByRef(ref c, by: c.functions[m].parameters[1])
                && c.locals[c.functions[m].parameters[1]].type == builtinType(.formatSpec) {
            return true
        }
    }
    return false
}

/// C# `Host` (BinderExpressions.cs:1939-1946): the function whose body is being bound, skipping enclosing lambdas.
/// Pre-ported for T17/T18 (user decision 2026-10-31); T35 must not rewrite it.
FuncId host(Binder b, through Ctx c) {
    var fn = b.fn
    while fn != -1 && c.functions[fn].kind == .lambda {
        fn = c.functions[fn].enclosing
    }
    return fn
}
== semantics/flow.byn
// T23: FlowAnalysis.cs.
//
// Checks that need control flow, run once every body is bound and error sets are inferred: definite assignment
// (locals declared without a value, `out` parameters), missing returns, unreachable code, that each `try`
// propagates only declared errors, and that a function that `becomes` a state does not return normally without
// `become`. The C# `HashSet<LocalSymbol>` sets are `List<LocalId>` searched in order; a `JumpTarget` is its
// `Ctx.jumpTargets` index, which is its identity.

import parser

/// C# `FlowAnalysis.State`: reachability plus the set of tracked locals assigned on every path.
struct FlowState {
    bool reachable = true
    List<LocalId> assigned = []
    /// A `become` ran on every path.
    bool became    = false
}

/// The C# `FlowAnalysis` instance: the function, its file, and the per-run sets.
struct Flow {
    FuncId              fn
    FileId              file
    /// Locals that start unassigned: `var x;` and `out` parameters.
    List<LocalId>       tracked   = []
    List<LocalId>       reported  = []
    Map<i64, FlowState> breaks    = []
    Map<i64, FlowState> continues = []
}

void analyzeFlow(ref Ctx c, for FuncId fn) {
    return if c.functions[fn].file == -1 || c.functions[fn].body == -1
    var f = Flow { fn: fn, file: c.functions[fn].file }
    t23Run(ref f, through: ref c)
}

FlowState t23Clone(in FlowState s) {
    var a = List<LocalId>()
    for x in s.assigned {
        a.append(x)
    }
    return FlowState { reachable: s.reachable, assigned: move a, became: s.became }
}

FlowState t23Unreachable() => FlowState { reachable: false }

/// Paths meeting: assigned only if assigned on every reachable path.
FlowState t23Join(in FlowState s, by in FlowState other) {
    return t23Clone(in other) if !s.reachable
    return t23Clone(in s) if !other.reachable
    var r = t23Clone(in s)
    var kept = List<LocalId>()
    for x in r.assigned {
        if listContains(in other.assigned, by: x) {
            kept.append(x)
        }
    }
    r.assigned = move kept
    r.became = r.became && other.became
    return move r
}

void t23Assign(ref FlowState s, by LocalId l) {
    if !listContains(in s.assigned, by: l) {
        s.assigned.append(l)
    }
}

void t23Run(ref Flow f, through ref Ctx c) {
    let fn = f.fn
    for p in c.functions[fn].parameters {
        if c.locals[p].modifier == .outKeyword {
            t23Track(ref f, by: p)
        }
    }
    let body = c.functions[fn].body
    let statements = copyIds(in c.bBlocks[boundIndex(body)].statements)
    let end = t23Block(ref f, through: ref c, for: in statements, by: FlowState {})
    return if !end.reachable
    let bodyEnd = c.bBlocks[boundIndex(body)].span.end
    let closing = TextSpan { start: bodyEnd - 1 > 0 ? bodyEnd - 1 : 0, length: 1 }
    let returns = c.functions[fn].returnType
    let kind = c.functions[fn].kind
    if !isVoid(returns) && !isError(returns) && kind != .main && kind != .testKeyword && kind != .constructor {
        if isNever(returns) {
            report(
                ref c,
                for: .neverReturns,
                from: f.file,
                at: closing,
                by: (c.functions[fn].name, "", "", "", ""),
                help: "end every path with `panic(…)` or a call that never returns",
            )
        } else {
            let shown = typeDisplay(ref c, by: returns)
            report(
                ref c,
                for: .missingReturn,
                from: f.file,
                at: closing,
                by: (c.functions[fn].name, shown, "", "", ""),
                help: "add a `return` (or `panic(…)`) on the paths that reach the end",
            )
        }
        return
    }
    t23CheckOutAssigned(ref f, through: ref c, for: in end, at: closing)
    t23CheckBecame(ref f, through: ref c, for: in end, at: closing)
}

void t23Track(ref Flow f, by LocalId l) {
    if !listContains(in f.tracked, by: l) {
        f.tracked.append(l)
    }
}

void t23CheckOutAssigned(ref Flow f, through ref Ctx c, for in FlowState state, at TextSpan span) {
    let fn = f.fn
    for p in copyIds(in c.functions[fn].parameters) {
        if c.locals[p].modifier == .outKeyword && !listContains(in state.assigned, by: p) {
            let name = c.locals[p].name
            report(
                ref c,
                for: .outNotAssigned,
                from: f.file,
                at: span,
                by: (name, "", "", "", ""),
                help: $"assign `{name}` before every `return`",
            )
        }
    }
}

/// BYN7009: a normal return from a function that `becomes .s` must follow a `become`; not after BYN7010.
void t23CheckBecame(ref Flow f, through ref Ctx c, for in FlowState state, at TextSpan span) {
    let fn = f.fn
    return if state.became
    let becomes = c.functions[fn].becomes ?? return
    return if c.functions[fn].kind == .method && !c.functions[fn].isStatic && c.functions[fn].refThis is null
    report(
        ref c,
        for: .missingBecome,
        from: f.file,
        at: span,
        by: (c.functions[fn].name, becomes, "", "", ""),
        help: $"add `become .{becomes}(…)` before returning, or fail",
    )
}

// ── Statements ───────────────────────────────────────────────────────────────

FlowState t23Block(ref Flow f, through ref Ctx c, for in List<BStmt> statements, by move FlowState start) {
    var state = move start
    var warned = false
    for s in statements {
        if !state.reachable
                && !warned
                && boundKind(s) != .errorStmt
                && !(boundKind(s) == .block && c.bBlocks[boundIndex(s)].statements.length == 0) {
            report(ref c, for: .unreachableCode, from: f.file, at: nodeSpan(in c, for: s), by: ("", "", "", "", ""))
            warned = true
        }
        state = t23Statement(ref f, through: ref c, for: s, by: move state)
    }
    return move state
}

/// C# `Constant?.Value as bool?`: the constant's `bool`, or null when it is not a `bool` constant.
bool? t23ConstantBool(in Ctx c, for BExpr e) {
    let k = exprConstant(in c, for: e) ?? return null
    return null if k.kind != .flag
    return k.flag
}

FlowState t23Statement(ref Flow f, through ref Ctx c, for BStmt s, by move FlowState start) {
    var state = move start
    let i = boundIndex(s)
    switch boundKind(s) {
        case .block:
            let statements = copyIds(in c.bBlocks[i].statements)
            return t23Block(ref f, through: ref c, for: in statements, by: move state)
        case .localDecl:
            let local = c.bLocalDecls[i].local
            let initializer = c.bLocalDecls[i].initializer
            if initializer == -1 {
                t23Track(ref f, by: local)
                return move state
            }
            state = t23Expr(ref f, through: ref c, for: initializer, by: move state)
            t23Assign(ref state, by: local)
            return move state
        case .exprStmt:
            return t23Expr(ref f, through: ref c, for: c.bExprStmts[i].expr, by: move state)
        case .assertStmt:
            return t23Expr(ref f, through: ref c, for: c.bAsserts[i].condition, by: move state)
        case .assign:
            let target = c.bAssigns[i].target
            let value = c.bAssigns[i].value
            if c.bAssigns[i].op is null && boundKind(target) == .local {
                let l = c.bLocals[boundIndex(target)].local
                state = t23Expr(ref f, through: ref c, for: value, by: move state)
                t23Assign(ref state, by: l)
                return move state
            }
            state = t23Expr(ref f, through: ref c, for: target, by: move state)
            return t23Expr(ref f, through: ref c, for: value, by: move state)
        case .returnStmt:
            let value = c.bReturns[i].value
            if value != -1 {
                state = t23Expr(ref f, through: ref c, for: value, by: move state)
            }
            if state.reachable {
                let span = c.bReturns[i].span
                t23CheckOutAssigned(ref f, through: ref c, for: in state, at: span)
                t23CheckBecame(ref f, through: ref c, for: in state, at: span)
            }
            return t23Unreachable()
        case .failStmt:
            let _ = t23Expr(ref f, through: ref c, for: c.bFails[i].error, by: move state)
            return t23Unreachable()
        case .breakStmt:
            t23Merge(ref f.breaks, for: c.bBreaks[i].target, by: in state)
            return t23Unreachable()
        case .continueStmt:
            t23Merge(ref f.continues, for: c.bContinues[i].target, by: in state)
            return t23Unreachable()
        case .ifStmt:
            let condition = c.bIfs[i].condition
            let then = c.bIfs[i].then
            let elseBranch = c.bIfs[i].elseBranch
            let neverIf = c.bIfs[i].isNever
            state = t23Expr(ref f, through: ref c, for: condition, by: move state)
            let constant = t23ConstantBool(in c, for: condition)
            let thenStart = constant == false ? t23Unreachable() : t23Clone(in state)
            var thenState = t23Statement(ref f, through: ref c, for: then, by: move thenStart)
            if neverIf {
                thenState = t23Unreachable()
            }
            var otherwise = t23Unreachable()
            if constant == true {
                otherwise = t23Unreachable()
            } else if elseBranch == -1 {
                otherwise = t23Clone(in state)
            } else {
                otherwise = t23Statement(ref f, through: ref c, for: elseBranch, by: t23Clone(in state))
            }
            return t23Join(in thenState, by: in otherwise)
        case .whileStmt:
            let condition = c.bWhiles[i].condition
            let body = c.bWhiles[i].body
            let target = c.bWhiles[i].target
            state = t23Expr(ref f, through: ref c, for: condition, by: move state)
            let constant = t23ConstantBool(in c, for: condition)
            let bodyStart = constant == false ? t23Unreachable() : t23Clone(in state)
            let _ = t23Statement(ref f, through: ref c, for: body, by: move bodyStart)
            let after = constant == true ? t23Unreachable() : move state
            return t23Exit(ref f, for: target, by: move after)
        case .doWhile:
            let condition = c.bDoWhiles[i].condition
            let target = c.bDoWhiles[i].target
            var body = t23Statement(ref f, through: ref c, for: c.bDoWhiles[i].body, by: t23Clone(in state))
            if f.continues.contains(target) {
                body = t23Join(in body, by: in f.continues[target])
                let _ = f.continues.remove(target)
            }
            let afterCondition = t23Expr(ref f, through: ref c, for: condition, by: move body)
            let after = t23ConstantBool(in c, for: condition) == true ? t23Unreachable() : move afterCondition
            return t23Exit(ref f, for: target, by: move after)
        case .forStmt:
            let body = c.bFors[i].body
            let target = c.bFors[i].target
            state = t23Expr(ref f, through: ref c, for: c.bFors[i].iterable, by: move state)
            let _ = t23Statement(ref f, through: ref c, for: body, by: t23Clone(in state))
            return t23Exit(ref f, for: target, by: move state)
        case .switchStmt:
            let target = c.bSwitches[i].target
            state = t23Expr(ref f, through: ref c, for: c.bSwitches[i].value, by: move state)
            var after = c.bSwitches[i].exhaustive ? t23Unreachable() : t23Clone(in state)
            let count = c.bSwitches[i].sections.length
            for k in 0..count {
                let guard = c.bSwitches[i].sections[k].guard
                let sectionBody = copyIds(in c.bSwitches[i].sections[k].body)
                var branch = t23Clone(in state)
                if guard != -1 {
                    branch = t23Expr(ref f, through: ref c, for: guard, by: move branch)
                }
                let ended = t23Block(ref f, through: ref c, for: in sectionBody, by: move branch)
                after = t23Join(in after, by: in ended)
            }
            return t23Exit(ref f, for: target, by: move after)
        case .deferStmt:
            let _ = t23Statement(ref f, through: ref c, for: c.bDefers[i].body, by: t23Clone(in state))
            return move state
        case .errdeferStmt:
            let _ = t23Statement(ref f, through: ref c, for: c.bErrdefers[i].body, by: t23Clone(in state))
            return move state
        case .panicDefer:
            let _ = t23Statement(ref f, through: ref c, for: c.bPanicDefers[i].body, by: t23Clone(in state))
            return move state
        case .contextStmt:
            let body = c.bContexts[i].body
            state = t23Expr(ref f, through: ref c, for: c.bContexts[i].allocator, by: move state)
            return t23Statement(ref f, through: ref c, for: body, by: move state)
        case .becomeStmt:
            let payload = copyIds(in c.bBecomes[i].payload)
            for a in payload {
                state = t23Expr(ref f, through: ref c, for: a, by: move state)
            }
            state.became = true
            return move state
        case .errorStmt:
            // An unknown state was already reported (BYN7007); count the `become` so BYN7009 does not follow it.
            if t23IsBecomeSyntax(ref c, for: f.file, at: c.bErrorStmts[i].span) {
                state.became = true
            }
            return move state
        default:
            return move state
    }
}

/// C# `Syntax: BecomeStmt` for a `BoundErrorStmt`, which keeps only its span: the statement's text starts with the
/// `become` keyword (Q631).
bool t23IsBecomeSyntax(ref Ctx c, for FileId file, at TextSpan span) {
    let text = c.files[file].text.span
    let word = "become".bytes
    return false if span.start + word.length > text.length
    for k in 0..word.length {
        return false if text[span.start + k] != word[k]
    }
    return true if span.start + word.length == text.length
    let next = i64(text[span.start + word.length])
    let letter = next is 97..=122 or 65..=90 or 48..=57 or 95
    return !letter
}

void t23Merge(ref Map<i64, FlowState> map, for i64 target, by in FlowState state) {
    return if !state.reachable
    if map.contains(target) {
        let joined = t23Join(in map[target], by: in state)
        map[target] = move joined
    } else {
        map[target] = t23Clone(in state)
    }
}

FlowState t23Exit(ref Flow f, for i64 target, by move FlowState after) {
    let _ = f.continues.remove(target)
    if f.breaks.contains(target) {
        let joined = t23Join(in after, by: in f.breaks[target])
        let _ = f.breaks.remove(target)
        return move joined
    }
    return move after
}

// ── Expressions ──────────────────────────────────────────────────────────────

/// C# `arm.Value is BoundBlockExpr { Type.IsNever: true }`.
bool t23IsNeverBlock(in Ctx c, for BExpr e) => boundKind(e) == .blockExpr && isNever(c.bBlockExprs[boundIndex(e)].type)

FlowState t23Expr(ref Flow f, through ref Ctx c, for BExpr e, by move FlowState start) {
    var state = move start
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            let l = c.bLocals[i].local
            if state.reachable
                    && listContains(in f.tracked, by: l)
                    && !listContains(in state.assigned, by: l)
                    && !listContains(in f.reported, by: l) {
                f.reported.append(l)
                let isParameter = c.locals[l].isParameter
                let line = linePosition(c.files[f.file].text.span, at: c.locals[l].nameSpan.start).line
                let label = isParameter ? "an `out` parameter starts unassigned" : $"declared without a value on line {line}"
                let help = isParameter ? "" : "assign it on every path before this, or give the declaration a value"
                report(
                    ref c,
                    for: .useBeforeAssign,
                    from: f.file,
                    at: c.bLocals[i].span,
                    by: (c.locals[l].name, "", "", "", ""),
                    label: label,
                    help: help,
                )
            }
            return move state
        case .binary:
            let op = c.bBinaries[i].op
            if op is .logicalAnd or .logicalOr {
                let right = c.bBinaries[i].right
                state = t23Expr(ref f, through: ref c, for: c.bBinaries[i].left, by: move state)
                let rightState = t23Expr(ref f, through: ref c, for: right, by: t23Clone(in state))
                return t23Join(in state, by: in rightState)
            }
            return t23Default(ref f, through: ref c, for: e, by: move state)
        case .conditional:
            let whenTrue = c.bConditionals[i].whenTrue
            let whenFalse = c.bConditionals[i].whenFalse
            state = t23Expr(ref f, through: ref c, for: c.bConditionals[i].condition, by: move state)
            let t = t23Expr(ref f, through: ref c, for: whenTrue, by: t23Clone(in state))
            let o = t23Expr(ref f, through: ref c, for: whenFalse, by: t23Clone(in state))
            return t23Join(in t, by: in o)
        case .coalesce:
            let right = c.bCoalesces[i].right
            state = t23Expr(ref f, through: ref c, for: c.bCoalesces[i].left, by: move state)
            let r = t23Expr(ref f, through: ref c, for: right, by: t23Clone(in state))
            return t23Join(in state, by: in r)
        case .switchExpr:
            state = t23Expr(ref f, through: ref c, for: c.bSwitchExprs[i].value, by: move state)
            var after = t23Unreachable()
            let count = c.bSwitchExprs[i].arms.length
            for k in 0..count {
                let guard = c.bSwitchExprs[i].arms[k].guard
                let value = c.bSwitchExprs[i].arms[k].value
                var branch = t23Clone(in state)
                if guard != -1 {
                    branch = t23Expr(ref f, through: ref c, for: guard, by: move branch)
                }
                branch = t23Expr(ref f, through: ref c, for: value, by: move branch)
                // A block arm of a value-giving `catch switch` must leave, as a `catch` block does (J49).
                let neverBlock = t23IsNeverBlock(in c, for: value)
                    || (boundKind(value) == .conversion
                        && t23IsNeverBlock(in c, for: c.bConversions[boundIndex(value)].operand))
                if neverBlock && branch.reachable {
                    let end = nodeSpan(in c, for: value).end
                    report(
                        ref c,
                        for: .catchBlockCompletes,
                        from: f.file,
                        at: TextSpan { start: end - 1 > 0 ? end - 1 : 0, length: 1 },
                        by: ("", "", "", "", ""),
                        help: "leave the block instead of falling through; the call returns a value",
                    )
                    branch = t23Unreachable()
                }
                after = t23Join(in after, by: in branch)
            }
            return move after
        case .call:
            let function = c.bCalls[i].function
            let receiver = c.bCalls[i].receiver
            let arguments = copyIds(in c.bCalls[i].arguments)
            if receiver != -1 {
                state = t23Expr(ref f, through: ref c, for: receiver, by: move state)
            }
            var outs = List<LocalId>()
            for k in 0..arguments.length {
                let arg = arguments[k]
                if k < c.functions[function].parameters.length
                        && c.locals[c.functions[function].parameters[k]].modifier == .outKeyword
                        && boundKind(arg) == .local {
                    outs.append(c.bLocals[boundIndex(arg)].local)
                } else {
                    state = t23Expr(ref f, through: ref c, for: arg, by: move state)
                }
            }
            for l in outs {
                t23Assign(ref state, by: l)
            }
            // A `becomes` call on `this` counts as `become` (BYN7003's third form makes the caller declare it; revision 0010).
            if receiver != -1 && boundKind(receiver) == .thisRef && c.functions[function].becomes is not null {
                state.became = true
            }
            return isNever(c.bCalls[i].type) ? t23Unreachable() : move state
        case .tryExpr:
            let operand = c.bTries[i].operand
            t23CheckPropagation(ref f, through: ref c, at: c.bTries[i].span, for: operand, by: -1)
            state = t23Expr(ref f, through: ref c, for: operand, by: move state)
            return move state
        case .catchExpr:
            let operand = c.bCatches[i].operand
            let variant = c.bCatches[i].variant
            let handlerExpr = c.bCatches[i].handler
            let became = state.became
            state = t23Expr(ref f, through: ref c, for: operand, by: move state)
            if variant != -1 && boundKind(operand) == .call {
                let call = boundIndex(operand)
                let callee = c.bCalls[call].function
                let set = c.errorVariants[variant].set
                let sets = copyIds(in c.functions[callee].errorSets)
                let excluded = copyIds(in c.functions[callee].excludedErrors)
                if !listContains(in sets, by: set) && sets.length > 0 || listContains(in excluded, by: variant) {
                    let shown = typeDisplay(ref c, by: errorUnionOf(ref c, for: in sets, as: in excluded))
                    report(
                        ref c,
                        for: .unknownVariant,
                        from: f.file,
                        at: c.catchVariantSpans[e],
                        by: (c.errorVariants[variant].name, shown, "", "", ""),
                    )
                } else {
                    t23CheckPropagation(ref f, through: ref c, at: c.bCatches[i].span, for: operand, by: variant)
                }
            }
            // A failed `becomes` call left the state unchanged, so the handler's path has not run `become` (revision 0010 erratum).
            var failed = t23Clone(in state)
            failed.became = became
            var handler = t23Expr(ref f, through: ref c, for: handlerExpr, by: move failed)
            if t23IsNeverBlock(in c, for: handlerExpr) && handler.reachable {
                let end = nodeSpan(in c, for: handlerExpr).end
                let name = boundKind(operand) == .call ? c.functions[c.bCalls[boundIndex(operand)].function].name : ""
                report(
                    ref c,
                    for: .catchBlockCompletes,
                    from: f.file,
                    at: TextSpan { start: end - 1 > 0 ? end - 1 : 0, length: 1 },
                    by: ("", "", "", "", ""),
                    help: $"leave the block instead of falling through; `{name}` returns a value",
                )
                handler = t23Unreachable()
            }
            return t23Join(in state, by: in handler)
        case .jump:
            return t23Statement(ref f, through: ref c, for: c.bJumps[i].jump, by: move state)
        case .blockExpr:
            let block = c.bBlockExprs[i].block
            let statements = copyIds(in c.bBlocks[boundIndex(block)].statements)
            return t23Block(ref f, through: ref c, for: in statements, by: move state)
        case .isExpr:
            let value = c.bIses[i].value
            let pattern = c.bIses[i].pattern
            if boundKind(pattern) == .rangePattern {
                let r = boundIndex(pattern)
                let rangeEnd = c.bRangePatterns[r].end
                let rangeStart = c.bRangePatterns[r].start
                state = t23Expr(ref f, through: ref c, for: value, by: move state)
                state = t23Expr(ref f, through: ref c, for: rangeStart, by: move state)
                return t23Expr(ref f, through: ref c, for: rangeEnd, by: move state)
            }
            return t23Expr(ref f, through: ref c, for: value, by: move state)
        default:
            return t23Default(ref f, through: ref c, for: e, by: move state)
    }
}

/// The C# `default` arm of `Expr`: every expression child in order, then unreachable after a `never` value.
FlowState t23Default(ref Flow f, through ref Ctx c, for BExpr e, by move FlowState start) {
    var state = move start
    let kids = children(in c, for: e)
    for child in kids {
        if isExprKind(boundKind(child)) {
            state = t23Expr(ref f, through: ref c, for: child, by: move state)
        }
    }
    return isNever(exprType(in c, for: e)) && boundKind(e) != .errorExpr ? t23Unreachable() : move state
}

/// A `try` (or partial `catch`) passes the callee's errors on; the caller must be able to fail with them.
void t23CheckPropagation(ref Flow f, through ref Ctx c, at TextSpan span, for BExpr operand, by VariantId caught) {
    return if boundKind(operand) != .call
    let callee = c.bCalls[boundIndex(operand)].function
    let sets = caught == -1 ? copyIds(in c.functions[callee].errorSets) : uncaught(ref c, for: callee, by: caught)
    return if sets.length == 0
    let fn = f.fn
    return if c.functions[fn].infersErrors || c.functions[fn].kind == .main || c.functions[fn].kind == .testKeyword
    if !c.functions[fn].hasFails {
        var names = List<string>()
        for s in sets {
            names.append(errorSetDisplayName(ref c, by: s))
        }
        report(
            ref c,
            for: .propagateFromInfallible,
            from: f.file,
            at: span,
            by: (c.functions[fn].name, t23JoinText(in names, by: "`, `"), "", "", ""),
            help: $"handle the error with `catch`, or declare `fails {t23JoinText(in names, by: ", ")}`",
        )
        return
    }
    for set in sets {
        continue if listContains(in c.functions[fn].errorSets, by: set)
        var named = copyIds(in c.functions[fn].errorSets)
        named.append(set)
        var shown = List<string>()
        for s in named {
            shown.append(displayNameAmong(ref c, by: s, for: in named))
        }
        let own = displayNameAmong(ref c, by: set, for: in named)
        report(
            ref c,
            for: .undeclaredError,
            from: f.file,
            at: span,
            by: (own, c.functions[fn].name, "", "", ""),
            help: $"add it to the signature: `fails {t23JoinText(in shown, by: ", ")}`",
        )
    }
    // A case the caller takes out with `except` must not arrive from the callee.
    for s in sets {
        let variants = copyIds(in c.errorSets[s].variants)
        for v in variants {
            if v != caught
                    && listContains(in c.functions[fn].excludedErrors, by: v)
                    && !listContains(in c.functions[callee].excludedErrors, by: v) {
                let setName = errorSetDisplayName(ref c, by: c.errorVariants[v].set)
                let vName = c.errorVariants[v].name
                report(
                    ref c,
                    for: .undeclaredError,
                    from: f.file,
                    at: span,
                    by: ($"{setName}.{vName}", c.functions[fn].name, "", "", ""),
                    help: $"handle it with `catch ({setName}.{vName})`, or remove `.{vName}` from the `except` list",
                )
            }
        }
    }
}

/// C# `string.Join(separator, parts)`.
string t23JoinText(in List<string> parts, by string separator) {
    var sb = StrBuf()
    for k in 0..parts.length {
        if k > 0 {
            sb.append(separator)
        }
        sb.append(parts[k])
    }
    return $"{sb.finish()}"
}
== semantics/fold.byn
// T6: Binding/ConstantFolding.cs.
//
// Compile-time evaluation. Integers are `Big` (callers check the result fits), floats `f64`, characters
// a `u32` scalar. Returns null when the operation is left to run time (division by zero, out-of-range
// shifts, …). `Wrap` and `Saturate` are T5's `bigWrap`/`bigSaturate`; C#'s nullable `fields` is an
// empty map.

import parser

Constant t6Integer(Big n) => Constant { kind: .integer, integer: n }

Constant t6Real(f64 d) => Constant { kind: .real, real: d }

Constant t6Flag(bool flag) => Constant { kind: .flag, flag: flag }

/// `ConstantFolding.Wrap`: a non-integer `type` leaves `n` as it is.
Big t6Wrap(Big n, as Type type) {
    return n if !isInteger(type)
    return bigWrap(n, to: primitiveBits(primKindOf(typeIndex(type))), signed: isSignedInteger(type))
}

Constant? foldUnary(ref Ctx c, for parser.UnaryOp op, by in Constant operand, as Type type) {
    switch op {
        case .plus:
            return operand
        case .negate:
            return t6Integer(bigNeg(operand.integer)) if operand.kind == .integer
            return t6Real(-operand.real) if operand.kind == .real
            return null
        case .notKeyword:
            return t6Flag(flag: !operand.flag) if operand.kind == .flag
            return null
        case .complement:
            return t6Integer(t6Wrap(bigNot(operand.integer), as: type)) if operand.kind == .integer
                && kindOf(type) == .primitive
            return null
        default:
            return null
    }
}

Constant? foldBinary(ref Ctx c, for parser.BinaryOp op, from in Constant l, by in Constant r, as Type type) {
    return null if l.kind != r.kind
    switch l.kind {
        case .integer:
            return t6IntegerOp(op, from: l.integer, by: r.integer, as: type)
        case .real:
            let a = l.real
            let b = r.real
            switch op {
                case .add: return t6Real(a + b)
                case .sub: return t6Real(a - b)
                case .mul: return t6Real(a * b)
                case .div: return t6Real(a / b)
                case .rem: return t6Real(a % b)
                default: return t6Compare(op, by: t6RealOrder(a, as: b), equal: a == b)
            }
        case .flag:
            let a = l.flag
            let b = r.flag
            switch op {
                case .logicalAnd: return t6Flag(flag: a && b)
                case .logicalOr: return t6Flag(flag: a || b)
                case .eq: return t6Flag(flag: a == b)
                case .ne: return t6Flag(flag: a != b)
                case .bitAnd: return t6Flag(flag: a && b)
                case .bitOr: return t6Flag(flag: a || b)
                case .bitXor: return t6Flag(flag: a != b)
                default: return null
            }
        case .rune:
            var order: i64 = 0
            if l.rune < r.rune {
                order = -1
            }
            if l.rune > r.rune {
                order = 1
            }
            return t6Compare(op, by: order, equal: l.rune == r.rune)
        case .text:
            return t6Compare(op, by: 0, equal: l.text == r.text) if op is .eq or .ne
            return null
    }
}

/// `double.CompareTo`: NaN orders below every number and equals itself.
i64 t6RealOrder(f64 a, as f64 b) {
    return -1 if a < b
    return 1 if a > b
    return 0 if a == b
    return b != b ? 0 : -1 if a != a
    return 1
}

Constant? t6Compare(parser.BinaryOp op, by i64 order, bool equal) {
    switch op {
        case .lt: return t6Flag(flag: order < 0)
        case .gt: return t6Flag(flag: order > 0)
        case .le: return t6Flag(flag: order <= 0)
        case .ge: return t6Flag(flag: order >= 0)
        case .eq: return t6Flag(flag: equal)
        case .ne: return t6Flag(flag: !equal)
        default: return null
    }
}

Constant? t6IntegerOp(parser.BinaryOp op, from Big a, by Big b, as Type type) {
    switch op {
        case .add: return t6Integer(bigAdd(a, by: b))
        case .sub: return t6Integer(bigSub(a, by: b))
        case .mul: return t6Integer(bigMul(a, by: b))
        case .div: return bigEq(b, as: bigZero()) ? null : t6Integer(bigDiv(a, by: b))
        case .rem: return bigEq(b, as: bigZero()) ? null : t6Integer(bigRem(a, by: b))
        case .bitAnd: return t6Integer(bigAnd(a, by: b))
        case .bitOr: return t6Integer(bigOr(a, by: b))
        case .bitXor: return t6Integer(bigXor(a, by: b))
        default:
    }
    if isInteger(type) {
        let bits = primitiveBits(primKindOf(typeIndex(type)))
        let signed = isSignedInteger(type)
        let inShift = bigCmp(b, as: bigZero()) >= 0 && bigCmp(b, as: bigFromI64(bits)) < 0
        switch op {
            case .addWrap: return t6Integer(t6Wrap(bigAdd(a, by: b), as: type))
            case .subWrap: return t6Integer(t6Wrap(bigSub(a, by: b), as: type))
            case .mulWrap: return t6Integer(t6Wrap(bigMul(a, by: b), as: type))
            case .addSat: return t6Integer(bigSaturate(bigAdd(a, by: b), to: bits, signed: signed))
            case .subSat: return t6Integer(bigSaturate(bigSub(a, by: b), to: bits, signed: signed))
            case .mulSat: return t6Integer(bigSaturate(bigMul(a, by: b), to: bits, signed: signed))
            case .shl:
                return t6Integer(t6Wrap(bigShl(a, by: bigToI64(b)), as: type)) if inShift
            case .shr:
                return t6Integer(bigShr(a, by: bigToI64(b))) if inShift
            default:
        }
    }
    return t6Compare(op, by: i64(bigCmp(a, as: b)), equal: bigEq(a, as: b))
}

/// The value of `e` with the given locals and fields of `this` replaced by constants, or null when some
/// part of it is only known at run time.
Constant? evaluate(ref Ctx c, for BExpr e, from in Map<LocalId, Constant> locals, by in Map<FieldId, Constant> fields) {
    if (exprConstant(in c, for: e) is { } k) {
        return k
    }
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            return locals.tryGet(at: c.bLocals[i].local)
        case .field:
            return null if boundKind(c.bFields[i].receiver) != .thisRef
            return fields.tryGet(at: c.bFields[i].field)
        case .conversion:
            let kind = c.bConversions[i].kind
            return null if kind != .identity && kind != .widen && kind != .numericCast
            let operand = c.bConversions[i].operand
            let to = c.bConversions[i].type
            if (evaluate(ref c, for: operand, from: in locals, by: in fields) is { } v) {
                return foldCast(ref c, for: in v, from: exprType(in c, for: operand), to: to)
            }
            return null
        case .unary:
            let op = c.bUnaries[i].op
            let type = c.bUnaries[i].type
            if (evaluate(ref c, for: c.bUnaries[i].operand, from: in locals, by: in fields) is { } o) {
                return foldUnary(ref c, for: op, by: in o, as: type)
            }
            return null
        case .binary:
            let op = c.bBinaries[i].op
            let left = c.bBinaries[i].left
            let right = c.bBinaries[i].right
            if op is .logicalAnd or .logicalOr {
                // Short-circuits like the run-time test, so a decided left side is enough.
                let l = evaluate(ref c, for: left, from: in locals, by: in fields) ?? return null
                return l if l.kind == .flag && l.flag == (op == .logicalOr)
                return evaluate(ref c, for: right, from: in locals, by: in fields)
            }
            let x = evaluate(ref c, for: left, from: in locals, by: in fields) ?? return null
            let y = evaluate(ref c, for: right, from: in locals, by: in fields) ?? return null
            return foldBinary(ref c, for: op, from: in x, by: in y, as: exprType(in c, for: left))
        case .isExpr:
            let p = c.bIses[i].pattern
            return null if boundKind(p) != .rangePattern
            let value = c.bIses[i].value
            let start = c.bRangePatterns[boundIndex(p)].start
            let end = c.bRangePatterns[boundIndex(p)].end
            let inclusive = c.bRangePatterns[boundIndex(p)].inclusive
            let v = evaluate(ref c, for: value, from: in locals, by: in fields) ?? return null
            let s = evaluate(ref c, for: start, from: in locals, by: in fields) ?? return null
            let n = evaluate(ref c, for: end, from: in locals, by: in fields) ?? return null
            let vt = exprType(in c, for: value)
            let low = foldBinary(ref c, for: .ge, from: in v, by: in s, as: vt)
            let high = foldBinary(ref c, for: inclusive ? .le : .lt, from: in v, by: in n, as: vt)
            if low is not null {
                if high is not null {
                    return t6Flag(flag: low.flag && high.flag) if low.kind == .flag && high.kind == .flag
                }
            }
            return null
        default:
            return null
    }
}

/// A cast of a constant, or null when the value does not fit (left to the run-time check).
Constant? foldCast(ref Ctx c, for in Constant value, from Type a, to Type t) {
    return null if kindOf(t) != .primitive
    switch value.kind {
        case .integer:
            let n = value.integer
            if isInteger(t) {
                let r = range(primKindOf(typeIndex(t)))
                return t6Integer(n) if bigCmp(n, as: r.min) >= 0 && bigCmp(n, as: r.max) <= 0
                return null
            }
            if isFloat(t) {
                let d = bigToF64(n)
                return t6Real(t == prim(.f32) ? f64(f32(d)) : d)
            }
            if t == prim(.char) {
                if bigCmp(n, as: bigZero()) >= 0 && bigCmp(n, as: bigFromI64(0x10FFFF)) <= 0 {
                    let v = bigToI64(n)
                    return Constant { kind: .rune, rune: u32(v) } if v is < 0xD800 or > 0xDFFF
                }
                return null
            }
        case .real:
            let d = value.real
            return t6Real(t == prim(.f32) ? f64(f32(d)) : d) if isFloat(t)
            if isInteger(t) {
                return t6Integer(bigZero()) if d != d
                let r = range(primKindOf(typeIndex(t)))
                return t6Integer(r.min) if d <= bigToF64(r.min)
                return t6Integer(r.max) if d >= bigToF64(r.max)
                return t6Integer(bigFromF64(d))
            }
        case .rune:
            if isInteger(t) {
                let n = bigFromI64(i64(value.rune))
                return t6Integer(n) if bigCmp(n, as: range(primKindOf(typeIndex(t))).max) <= 0
                return null
            }
        default:
    }
    return value if a == t
    return null
}
== semantics/generics.byn
// T13: Compilation.cs 1363-1952 (BindAll, instantiation, error sets, mutation/requires), method for
// method in C# order. C# state with no home in Ctx lives in ctx.byn's `// ── T13 state` section (Q704,
// Q710); a C# `Decl` is the symbol's `declIndex`/`memberIndex` into its file's tree (Q581).

import parser

// What `instantiatingBegin` saved for `instantiatingEnd`: the C# `Instantiating`'s locals around
// `work()` (Q704). `outer` is the sink to restore (`_scratch`), `bag` the scratch pushed, `site`/`span`
// the use, and the `outerSite…` fields the `_instantiationSite` to restore.
struct InstantiatingScope {
    i64      outer
    i64      bag
    FileId   site
    TextSpan span
    bool     outerHasSite
    FileId   outerSiteFile
    TextSpan outerSiteSpan
}

/// The C# `_firstPass` tuple: the function instances a first pass created, and what creating them reported.
struct FirstPass {
    List<FuncId> instances
    /// The `Ctx.bags` index of the pass's `DiagnosticBag`.
    i64          bag
    List<Diag>   errors
}

/// The C# `MutationCheck(Binder, Callee, Receiver)`. The binder is what `checkMutation` reads of it: its file and
/// its constructor's function (C# `Binder.Function`, the host of any lambda being bound), or -1 for none (Q657).
struct MutationCheck {
    FileId source
    FuncId function
    FuncId callee
    BExpr  receiver
}

/// The C# `RequiresCheck(Source, Call, Callee, Arguments)`. `Call` is its span and the file and span
/// of each argument value written in it; `argumentFiles` is the file of each argument's syntax (Q582).
struct RequiresCheck {
    FileId         source
    TextSpan       callSpan
    List<Location> callArgs
    FuncId         callee
    List<BExpr>    arguments
    List<FileId>   argumentFiles
}

/// C# `InstantiationLabel`.
const instantiationLabel: string = "the generic code needs this of its type arguments"

string t13Text(in Ctx c, from FileId f, at TextSpan span) => $"{getText(c.files[f].text.span, at: span)}"

Diag t13CloneDiag(in Diag d) {
    var rel = List<Related>()
    for r in d.related {
        rel.append(Related { span: r.span, label: r.label })
    }
    return Diag {
        code: d.code,
        file: d.file,
        span: d.span,
        message: d.message,
        label: d.label,
        help: d.help,
        isWarning: d.isWarning,
        hasFix: d.hasFix,
        fixSpan: d.fixSpan,
        fixReplacement: d.fixReplacement,
        related: move rel,
    }
}

/// `(_scratch ?? Diagnostics).Add(d)`: `addDiag` without its `c.quiet` gate, as C# `target.Add`/`AddRange` has none (Q580).
void t13Add(ref Ctx c, by move Diag d) {
    if c.sink >= 0 {
        c.bags[c.sink].items.append(move d)
    } else {
        c.diagnostics.append(move d)
    }
}

/// `Diagnostics.HasErrors`.
bool t13HasErrors(in Ctx c) {
    for d in c.diagnostics {
        return true if !d.isWarning
    }
    return false
}

/// The C# `_instances` key `(Generic, Args)`: `f` and a function, or `t` and a type handle, then each argument.
string t13Key(string kind, for i64 generic, by in List<Type> args) {
    var sb = StrBuf()
    sb.append($"{kind}{generic}:")
    for a in args {
        sb.append($"{a},")
    }
    return $"{sb.finish()}"
}

Binder t13NewBinder(FileId file, FuncId fn = -1, StructId owner = -1) => Binder {
    file: file,
    fn: fn,
    owner: owner,
    scopes: [],
    targets: [],
    lambdas: [],
    lambdaCount: [],
    seeds: [],
    pending: [],
    constraints: [],
    peers: [],
    nonNullLocals: [],
    stateFacts: [],
    errorNarrowed: [],
}

// ── Bodies ───────────────────────────────────────────────────────────────────

/// Compilation.cs:1364 BindAll.
void bindAll(ref Ctx c) {
    checkConformances(ref c)
    // Before the constants, which may build a checked value (J38). `Checks` in insertion order.
    for i in 0..c.checks.length {
        var owner: StructId = -1
        for (s, idx) in c.checksOf {
            if idx == i {
                owner = s
            }
        }
        var rules = List<StructRule>()
        for r in c.checks[i].rules {
            // coverage-exempt: Q746
            rules.append(
                StructRule { span: r.span, field: r.field, condition: r.condition, reads: copyIds(in r.reads) },
            )
        }
        let checks = StructChecks { check: c.checks[i].check, rules: move rules }
        var b = t13NewBinder(c.structs[owner].file, fn: checks.check, owner: owner)
        bindChecks(ref b, through: ref c, for: in checks)
    }
    for m in 0..c.modules.length {
        let consts = copyIds(in c.modules[m].allConstants)
        for k in consts {
            bindConstant(ref c, for: k)
        }
    }
    for m in 0..c.modules.length {
        let enums = copyIds(in c.modules[m].enums)
        for e in enums {
            var b = t13NewBinder(c.enums[e].file)
            bindEnumArguments(ref b, through: ref c, for: e)
        }
    }
    var exitCodes = List<ExitCodeRef>()
    for entry in c.exitCodes {
        exitCodes.append(entry)
    }
    for entry in exitCodes {
        // C#'s `(variant, attribute, file)`: the attribute's own file is the tuple's `file` (Q583).
        let f = entry.attribute.file
        let d = entry.attribute.declIndex
        let vIdx = entry.attribute.memberIndex
        let aIdx = entry.attribute.itemIndex
        switch c.files[f].unit.members[d] {
            case .errorEnumDecl(let ed):
                var b = t13NewBinder(f)
                let code = bindExitCode(ref b, through: ref c, for: in ed.value.variants[vIdx].attributes[aIdx])
                c.errorVariants[entry.variant].exitCode = code
            default:
                // coverage-exempt: Q746
                panic("internal error: an exit code that is not on an error variant")
        }
    }
    for m in 0..c.modules.length {
        let structs = copyIds(in c.modules[m].structs)
        for s in structs {
            let fields = copyIds(in c.structs[s].fields)
            for f in fields {
                if c.fields[f].hasDefault {
                    let _ = fieldDefault(ref c, for: s, by: f, from: c.structs[s].file, at: c.fields[f].nameSpan)
                }
            }
        }
    }
    for m in 0..c.modules.length {
        var fns = List<FuncId>()
        for fn in c.modules[m].allFunctions {
            fns.append(fn)
        }
        for fn in fns {
            if !functionIsInstance(ref c, by: fn) {
                bindFunction(ref c, for: fn)
            }
        }
    }
    while c.instantiationWork.length > 0 {
        let kind = c.instantiationWork[0].kind
        let site = c.instantiationWork[0].file
        let span = c.instantiationWork[0].span
        let instance = c.instantiationWork[0].instance
        let target = c.instantiationWork[0].memberIndex
        // C#'s `work.Instance`: a `bindFunction`'s `memberIndex`, set only by `instantiateFunction` (Q721).
        let workInstance = kind == .bindFunction ? target : -1
        let subject = c.instantiationWork[0].subject
        c.instantiationWork.remove(at: 0)
        let scope = instantiatingBegin(ref c, from: site, at: span)
        switch kind {
            case .bindFunction:
                bindFunction(ref c, for: instance)
            case .fieldDefault:
                let _ = fieldDefault(ref c, for: StructId(typeIndex(subject)), by: target, from: site, at: span)
            default:
                // coverage-exempt: Q746
                panic($"internal error: instantiation work of kind {kind.ordinal}")
        }
        instantiatingEnd(ref c, by: scope, instance: workInstance)
    }
    inferErrorSets(ref c)
    t42AnalyzeEffects(ref c)
    checkMutation(ref c)
    checkRequires(ref c)
    summarizeRegions(ref c)
    for m in 0..c.modules.length {
        let fns = copyIds(in c.modules[m].allFunctions)
        for fn in fns {
            let hasBody = c.functions[fn].body != -1
            let isInstance = functionIsInstance(ref c, by: fn)
            // Ownership is checked once, on the template, where every type parameter counts as unique.
            if hasBody && !isInstance && !c.skipOwnershipCheck {
                analyzeOwnership(ref c, for: fn)
            }
            // Like ownership, the lint judges the source once, on the template.
            if hasBody && !isInstance {
                lintNeverReassignedVar(ref c, for: fn)
            }
            if hasBody && !isInstance {
                checkPanicHandler(ref c, for: fn)
            }
            if hasBody && !functionIsGeneric(ref c, by: fn) {
                if isInstance {
                    t13AnalyzeInstance(ref c, for: fn)
                    continue
                }
                analyzeFlow(ref c, for: fn)
                t42AnalyzeRegions(ref c, for: fn)
                lintSpanParameter(ref c, for: fn)
                // coverage-exempt: Q746
            } else if hasBody && c.functions[fn].iface != -1 && !c.functions[fn].isAbstract {
                // A default is analysed on its template, so it is checked with no conformer; its clones repeat nothing it reports.
                t13AnalyzeInstance(ref c, for: fn)
            }
        }
    }
    // coverage-exempt: Q746
    if !t13HasErrors(in c) && c.instantiationErrors.length > 0 {
        // coverage-exempt: Q746
        let d = t13CloneDiag(in c.instantiationErrors[0])
        // coverage-exempt: Q746
        let path = d.file >= 0 ? c.files[d.file].path : ""
        // coverage-exempt: Q746
        panic($"internal error: instantiating a generic reported {d.code} at {path}: {d.message}")
    }
    if c.modules[c.entryModule].main == -1
            && !c.includeTests
            && !c.library
            && c.modules[c.entryModule].files.length > 0
            && !t13HasErrors(in c) {
        report(
            ref c,
            for: .noMain,
            from: c.modules[c.entryModule].files[0],
            at: TextSpan { start: 0, length: 0 },
            by: ("", "", "", "", ""),
        )
    }
}

// ── Generics ─────────────────────────────────────────────────────────────────

/// Compilation.cs:1451 Substitution.
Map<string, Type> t13Substitution(
    in Ctx c,
    from in Map<string,
    Type>? outer,
    for in List<TypeParamId> parameters,
    by in List<Type> args
) {
    var map = Map<string, Type>()
    if (outer is { } o) {
        for (k, v) in o {
            map[k] = v
        }
    }
    for i in 0..parameters.length {
        map[c.typeParams[parameters[i]].name] = args[i]
    }
    return map
}

/// Compilation.cs:1467 Instantiating, before `work()`.
InstantiatingScope instantiatingBegin(ref Ctx c, from FileId site, at TextSpan span) {
    let outer = pushBag(ref c)
    let bag = c.sink
    let scope = InstantiatingScope {
        outer: outer,
        bag: bag,
        site: site,
        span: span,
        outerHasSite: c.hasInstantiationSite,
        outerSiteFile: c.instantiationSiteFile,
        outerSiteSpan: c.instantiationSiteSpan,
    }
    if !c.hasInstantiationSite {
        c.hasInstantiationSite = true
        c.instantiationSiteFile = site
        c.instantiationSiteSpan = span
    }
    c.instantiating += 1
    return scope
}

/// `Reported(d)`: the same code, source and span already in the target or in `Diagnostics`.
bool t13Reported(in Ctx c, by in Diag d) {
    if c.sink >= 0 {
        for t in c.bags[c.sink].items {
            return true if t.code == d.code && t.file == d.file && t.span == d.span
        }
    }
    for t in c.diagnostics {
        return true if t.code == d.code && t.file == d.file && t.span == d.span
    }
    return false
}

/// Compilation.cs:1467 Instantiating, after `work()`: forwards the type-argument rules to the use, holds the rest.
void instantiatingEnd(ref Ctx c, by InstantiatingScope scope, FuncId instance = -1) {
    c.sink = scope.outer
    c.hasInstantiationSite = scope.outerHasSite
    c.instantiationSiteFile = scope.outerSiteFile
    c.instantiationSiteSpan = scope.outerSiteSpan
    c.instantiating -= 1
    let count = c.bags[scope.bag].items.length
    for i in 0..count {
        var d = t13CloneDiag(in c.bags[scope.bag].items[i])
        continue if d.isWarning
        let code = d.code
        let always = code == codeText(.invalidMapKey)
            || code == codeText(.keyPartNotHashable)
            || code == codeText(.badBinaryOperands)
            || code == codeText(.notFormattable) || code == codeText(.constraintNotSatisfied)
        let unlessReported = code == codeText(.functionTypeNotHere)
            || code == codeText(.unsupported)
            || code == codeText(.implicitCopy)
        if always || unlessReported && !t13Reported(in c, by: in d) {
            d.file = scope.site
            d.span = scope.span
            d.label = instantiationLabel
            t13Add(ref c, by: move d)
        } else if code == codeText(.assignmentChangesState) && instance != -1 && !t13Reported(in c, by: in d) {
            let name = c.functions[instance].name
            var related = List<Related>()
            if d.file == scope.site {
                related.append(Related { span: d.span, label: $"in `{name}`" })
            }
            d.file = scope.site
            d.span = scope.span
            d.label = instantiationLabel
            d.help = $"call `{name}` with a type without states; it replaces a value of its type argument whole"
            d.related = move related
            t13Add(ref c, by: move d)
        } else if code == codeText(.circularFieldDefault) {
            if !t13Reported(in c, by: in d) {
                t13Add(ref c, by: move d)
            }
        } else {
            c.instantiationErrors.append(move d)
        }
    }
}

/// `fn.Decl` for a function, method or interface member: declares its signature and checks its
/// constraints (the `Declare` closure of InstantiateFunction); false when a constraint fails.
bool t13DeclareInstance(ref Ctx c, for FuncId fn, by FuncId template, to in List<Type> args, bool check) {
    let file = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    let owner = c.functions[fn].owner
    let parameters = copyIds(in c.functions[template].typeParams)
    var typeMap = Map<string, Type>()
    for (k, v) in c.functions[fn].typeMap {
        typeMap[k] = v
    }
    var satisfied = true
    switch c.files[file].unit.members[d] {
        case .functionDecl(let n):
            declareSignature(ref c, for: fn, from: in n.value, by: file, owner: owner)
            if check {
                satisfied = checkConstraints(
                    ref c,
                    for: in parameters,
                    through: in n.value.where,
                    from: file,
                    as: owner,
                    by: in typeMap,
                    to: in args,
                )
            }
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let f):
                    declareSignature(ref c, for: fn, from: in f.value, by: file, owner: owner)
                    if check {
                        satisfied = checkConstraints(
                            ref c,
                            for: in parameters,
                            through: in f.value.where,
                            from: file,
                            as: owner,
                            by: in typeMap,
                            to: in args,
                        )
                    }
                default:
                    panic("internal error: a generic method without a function declaration")
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let f):
                    declareSignature(ref c, for: fn, from: in f.value, by: file, owner: owner)
                    if check {
                        satisfied = checkConstraints(
                            ref c,
                            for: in parameters,
                            through: in f.value.where,
                            from: file,
                            as: owner,
                            by: in typeMap,
                            to: in args,
                        )
                    }
                default:
                    panic("internal error: a generic member without a function declaration")
            }
        default:
            panic("internal error: a generic function without a function declaration")
    }
    return satisfied
}

/// A handle as C# sees it: -1 is null.
i64? t13Handle(i64 h) => h == -1 ? null : h

/// `_firstPass`, or null.
i64? t13FirstPass(in Ctx c) => t13Handle(c.firstPass)

/// The `Declare` closure run inside `Instantiating`, into the first pass's bag when there is one
/// (InstantiateFunction's `_firstPass` branch); false when a constraint fails.
bool t13DeclareAt(
    ref Ctx c,
    for FuncId fn,
    by FuncId template,
    to in List<Type> args,
    from FileId site,
    at TextSpan span,
    bool check
) {
    if (t13FirstPass(in c) is { } pass) {
        c.firstPasses[pass].instances.append(fn)
        let outer = c.sink
        c.sink = c.firstPasses[pass].bag
        let errors = c.instantiationErrors.length
        let scope = instantiatingBegin(ref c, from: site, at: span)
        let satisfied = t13DeclareInstance(ref c, for: fn, by: template, to: in args, check: check)
        instantiatingEnd(ref c, by: scope)
        c.sink = outer
        while c.instantiationErrors.length > errors {
            let d = t13CloneDiag(in c.instantiationErrors[errors])
            c.firstPasses[pass].errors.append(move d)
            c.instantiationErrors.remove(at: errors)
        }
        return satisfied
    }
    let scope = instantiatingBegin(ref c, from: site, at: span)
    let satisfied = t13DeclareInstance(ref c, for: fn, by: template, to: in args, check: check)
    instantiatingEnd(ref c, by: scope)
    return satisfied
}

/// Compilation.cs:1502 InstantiateFunction: declared now, bound when the worklist drains.
FuncId instantiateFunction(ref Ctx c, for FuncId template, by in List<Type> args, from FileId site, at TextSpan span) {
    let key = t13Key("f", for: template, by: in args)
    return FuncId(c.instanceKeys[key]) if c.instanceKeys.contains(key)
    let owner = c.functions[template].owner
    var typeMap = Map<string, Type>()
    if owner != -1 {
        typeMap = t13Substitution(
            in c,
            from: in c.structs[owner].typeMap,
            for: in c.functions[template].typeParams,
            by: in args,
        )
    } else {
        typeMap = t13Substitution(in c, from: null, for: in c.functions[template].typeParams, by: in args)
    }
    var typeArgs = List<Type>()
    for a in args {
        typeArgs.append(a)
    }
    let module = c.functions[template].module
    let fn = newFunction(ref c, by: FunctionSymbol {
        name: c.functions[template].name,
        nameSpan: c.functions[template].nameSpan,
        span: c.functions[template].span,
        module: module,
        kind: c.functions[template].kind,
        access: c.functions[template].access,
        modifiers: c.functions[template].modifiers,
        file: c.functions[template].file,
        declIndex: c.functions[template].declIndex,
        memberIndex: c.functions[template].memberIndex,
        owner: owner,
        isStatic: c.functions[template].isStatic,
        template: template,
        typeArgs: move typeArgs,
        typeMap: move typeMap,
        // C# `Decl = template.Decl` (Q656 (e)).
        becomes: c.functions[template].becomes,
        refThis: c.functions[template].refThis,
        moveThis: c.functions[template].moveThis,
    })
    c.instanceKeys[key] = fn
    c.modules[module].allFunctions.append(fn)
    // The template checked the calls in its own body, so a call in an instance is not checked again.
    let check = c.instantiating == 0
    let satisfied = t13DeclareAt(ref c, for: fn, by: template, to: in args, from: site, at: span, check: check)
    // A body bound with a non-conforming argument would only repeat BYN2807 as unknown members.
    if !functionIsGeneric(ref c, by: fn) && satisfied {
        c.instantiationWork.append(
            Work { kind: .bindFunction, args: List<Type>(), instance: fn, file: site, span: span, memberIndex: fn },
        )
    }
    return fn
}

/// The `where` clauses of a type's declaration, checked against `args` (the `Check` of CheckConstraintsAt).
bool t13CheckTypeConstraints(ref Ctx c, for Type instance) {
    let kind = kindOf(instance)
    let id = typeIndex(instance)
    var file: FileId = -1
    var d: i64 = -1
    var parameters = List<TypeParamId>()
    var args = List<Type>()
    var typeMap = Map<string, Type>()
    switch kind {
        case .structType:
            let template = c.structs[id].template
            file = c.structs[template].file
            d = c.structs[template].declIndex
            parameters = copyIds(in c.structs[template].typeParams)
            args = copyIds(in c.structs[id].typeArgs)
            for (k, v) in c.structs[id].typeMap {
                typeMap[k] = v
            }
        case .unionType:
            let template = c.unions[id].template
            file = c.unions[template].file
            d = c.unions[template].declIndex
            parameters = copyIds(in c.unions[template].typeParams)
            args = copyIds(in c.unions[id].typeArgs)
            for (k, v) in c.unions[id].typeMap {
                typeMap[k] = v
            }
        case .interfaceType:
            let template = c.interfaces[id].template
            file = c.interfaces[template].file
            d = c.interfaces[template].declIndex
            parameters = copyIds(in c.interfaces[template].typeParams)
            args = copyIds(in c.interfaces[id].typeArgs)
            for (k, v) in c.interfaces[id].typeMap {
                typeMap[k] = v
            }
        default:
            panic("internal error: a constraint check of a type that is not generic")
    }
    switch c.files[file].unit.members[d] {
        case .structDecl(let n):
            return checkConstraints(
                ref c,
                for: in parameters,
                through: in n.value.where,
                from: file,
                as: -1,
                by: in typeMap,
                to: in args,
            )
        case .unionDecl(let n):
            return checkConstraints(
                ref c,
                for: in parameters,
                through: in n.value.where,
                from: file,
                as: -1,
                by: in typeMap,
                to: in args,
            )
        case .interfaceDecl(let n):
            return checkConstraints(
                ref c,
                for: in parameters,
                through: in n.value.where,
                from: file,
                as: -1,
                by: in typeMap,
                to: in args,
            )
        default:
            panic("internal error: a generic type without a declaration")
    }
}

/// A `_pendingConstraints` entry (`Work { kind: .constraint }`): `Instantiating(site, span, CheckConstraints(…))`.
/// T11's `runWork` runs it when T14 drains the list (Q581).
void t13RunConstraint(ref Ctx c, for in Work work) {
    let scope = instantiatingBegin(ref c, from: work.file, at: work.span)
    let _ = t13CheckTypeConstraints(ref c, for: work.subject)
    instantiatingEnd(ref c, by: scope)
}

/// Compilation.cs:1556 CheckConstraints: BYN2807 for each argument that does not conform to its
/// parameter's `where` bounds; false when one does not.
bool checkConstraints(
    ref Ctx c,
    for in List<TypeParamId> parameters,
    through in List<parser.WhereClause> clauses,
    from FileId file,
    as StructId owner,
    by in Map<string,
    Type>? typeMap,
    to in List<Type> args
) {
    var satisfied = true
    var typeArgs = Map<string, Type>()
    if (typeMap is { } tm) {
        for (k, v) in tm {
            typeArgs[k] = v
        }
    }
    let types = TypeResolver { file: file, container: owner, typeArgs: move typeArgs }
    for k in 0..parameters.length {
        continue if c.typeParams[parameters[k]].constraints.length == 0
        let name = c.typeParams[parameters[k]].name
        // The bound is resolved again with the arguments, so `IOrder<T>` is `IOrder<Point>` here.
        // C# flattens the clauses' bounds (`SelectMany`), so the first failure ends this parameter.
        var done = false
        for w in clauses {
            break if done
            continue if t13Text(in c, from: file, at: w.param) != name
            for bound in w.bounds {
                if t13CheckBound(ref c, for: in bound, through: in types, by: args[k], from: file) {
                    satisfied = false
                    done = true
                    break
                }
            }
        }
    }
    return satisfied
}

/// One bound of CheckConstraints; true when it reported BYN2807. C# bounds are `NamedType` (Nodes.cs:108).
bool t13CheckBound(
    ref Ctx c,
    for in parser.TypeSyntax bound,
    through in TypeResolver types,
    by Type arg,
    from FileId file
) {
    switch bound {
        case .namedType(let n):
            let quiet = quietlyBegin(ref c)
            let resolved = resolveBound(ref c, through: in types, for: in n.value)
            quietlyEnd(ref c, to: quiet)
            return false if kindOf(resolved) != .interfaceType
            let i = InterfaceId(typeIndex(resolved))
            return false if t13Conforms(in c, for: arg, to: i)
            let missing = t13MissingMember(ref c, for: arg, to: i)
            let shown = typeDisplay(ref c, by: resolved)
            var help = $"pass a struct that conforms to `{shown}`; only structs conform to interfaces"
            switch kindOf(arg) {
                case .structType:
                    help = $"add `: {shown}` to `{typeDisplay(ref c, by: arg)}` and provide `{missing}`"
                case .typeParam:
                    let p = c.typeParams[typeIndex(arg)].name
                    help = $"add `where {p} : {shown}` to the declaration of `{p}`"
                case .primitive:
                    help = $"pass a struct that conforms to `{shown}`; primitives do not conform to interfaces"
                default:
                    help = $"pass a struct that conforms to `{shown}`; only structs conform to interfaces"
            }
            report(
                ref c,
                for: .constraintNotSatisfied,
                from: file,
                at: n.value.span,
                by: (typeDisplay(ref c, by: arg), shown, missing, "", ""),
                help: help,
            )
            return true
        default:
            panic("internal error: a `where` bound that is not a named type")
    }
}

/// Compilation.cs:1585 CheckConstraintsAt: the constraint check of a type instance, now or once
/// conformances are checked.
void t13CheckConstraintsAt(
    ref Ctx c,
    from FileId site,
    at TextSpan span,
    for in List<TypeParamId> parameters,
    by Type instance
) {
    var any = false
    for p in parameters {
        if c.typeParams[p].constraints.length != 0 {
            any = true
        }
    }
    return if !any
    let work = Work { kind: .constraint, subject: instance, args: List<Type>(), file: site, span: span }
    if conformancesChecked(ref c) {
        t13RunConstraint(ref c, for: in work)
    } else {
        c.pendingConstraints.append(move work)
    }
}

/// Compilation.cs:1595 Conforms: a struct when it lists the interface; a type parameter when its own
/// bounds include it (D5: primitives never do).
bool t13Conforms(in Ctx c, for Type t, to InterfaceId i) {
    return true if isError(t)
    switch kindOf(t) {
        case .structType:
            for conf in c.structs[typeIndex(t)].conformances {
                return true if c.conformances[conf].iface == i
            }
            return false
        case .typeParam:
            for constraint in c.typeParams[typeIndex(t)].constraints {
                return true if constraint == i
            }
            return false
        default:
            return false
    }
}

/// Compilation.cs:1604 MissingMember: the first abstract member of `i` that `t` does not have, for BYN2807.
string t13MissingMember(ref Ctx c, for Type t, to InterfaceId i) {
    var members = copyIds(in c.interfaces[i].methods)
    for p in c.interfaces[i].properties {
        members.append(p)
    }
    // A stable sort by where each member is declared (`OrderBy`).
    for a in 1..members.length {
        var j = a
        while j > 0 && c.functions[members[j]].nameSpan.start < c.functions[members[j - 1]].nameSpan.start {
            let x = members[j]
            members[j] = members[j - 1]
            members[j - 1] = x
            j -= 1
        }
    }
    var abstracts = List<FuncId>()
    for m in members {
        if c.functions[m].isAbstract {
            abstracts.append(m)
        }
    }
    for m in abstracts {
        let name = c.functions[m].name
        return name if kindOf(t) != .structType
        let s = StructId(typeIndex(t))
        return name if findProperty(ref c, by: s, for: name) == -1 && findMethods(ref c, by: s, for: name).length == 0
    }
    return c.functions[abstracts[0]].name if abstracts.length > 0
    return c.functions[members[0]].name if members.length > 0
    return $": {typeDisplay(ref c, by: interfaceTypeOf(i))}"
}

/// Compilation.cs:1615 InstantiateType: the instantiation of a generic struct, union or interface at
/// `args`, with its members.
Type instantiateType(ref Ctx c, for Type template, by in List<Type> args, from FileId site, at TextSpan span) {
    let key = t13Key("t", for: template, by: in args)
    return Type(c.instanceKeys[key]) if c.instanceKeys.contains(key)
    // As for functions: a type named inside an instance was checked in its template.
    let check = c.instantiating == 0
    var typeArgs = List<Type>()
    for a in args {
        typeArgs.append(a)
    }
    switch kindOf(template) {
        case .structType:
            let s = StructId(typeIndex(template))
            let typeMap = t13Substitution(in c, from: null, for: in c.structs[s].typeParams, by: in args)
            let id = newStruct(ref c, by: StructSymbol {
                name: c.structs[s].name,
                nameSpan: c.structs[s].nameSpan,
                span: c.structs[s].span,
                module: c.structs[s].module,
                file: c.structs[s].file,
                declIndex: c.structs[s].declIndex,
                memberIndex: c.structs[s].memberIndex,
                access: c.structs[s].access,
                modifiers: c.structs[s].modifiers, doc: c.structs[s].doc,
                template: s,
                typeArgs: move typeArgs,
                typeMap: move typeMap,
            })
            let instance = structTypeOf(id)
            c.instanceKeys[key] = instance
            let parameters = copyIds(in c.structs[s].typeParams)
            if check {
                t13CheckConstraintsAt(ref c, from: site, at: span, for: in parameters, by: instance)
            }
            let members = instantiatingBegin(ref c, from: site, at: span)
            declareMembers(ref c, for: id)
            instantiatingEnd(ref c, by: members)
            if conformancesChecked(ref c) {
                let conforming = instantiatingBegin(ref c, from: site, at: span)
                conform(ref c, for: id)
                instantiatingEnd(ref c, by: conforming)
            }
            return instance if structIsGeneric(ref c, by: id)
            let fields = copyIds(in c.structs[id].fields)
            for f in fields {
                if c.fields[f].hasDefault {
                    c.instantiationWork.append(
                        Work {
                            kind: .fieldDefault,
                            subject: instance,
                            args: List<Type>(),
                            file: site,
                            span: span,
                            memberIndex: f,
                        },
                    )
                }
            }
            // Cloned defaults (with a Template) are queued by Conform.
            var fns = copyIds(in c.structs[id].methods)
            for p in c.structs[id].properties {
                fns.append(c.properties[p].getter)
            }
            for k in c.structs[id].constructors {
                fns.append(k)
            }
            for fn in fns {
                if c.functions[fn].template == -1 {
                    c.instantiationWork.append(
                        Work { kind: .bindFunction, args: List<Type>(), instance: fn, file: site, span: span },
                    )
                }
            }
            return instance
        case .unionType:
            let u = UnionId(typeIndex(template))
            let typeMap = t13Substitution(in c, from: null, for: in c.unions[u].typeParams, by: in args)
            let id = newUnion(ref c, by: UnionSymbol {
                name: c.unions[u].name,
                nameSpan: c.unions[u].nameSpan,
                span: c.unions[u].span,
                module: c.unions[u].module,
                file: c.unions[u].file,
                declIndex: c.unions[u].declIndex,
                memberIndex: c.unions[u].memberIndex,
                access: c.unions[u].access,
                modifiers: c.unions[u].modifiers,
                template: u,
                typeArgs: move typeArgs,
                typeMap: move typeMap,
            })
            let instance = unionTypeOf(id)
            c.instanceKeys[key] = instance
            let parameters = copyIds(in c.unions[u].typeParams)
            if check {
                t13CheckConstraintsAt(ref c, from: site, at: span, for: in parameters, by: instance)
            }
            let variants = instantiatingBegin(ref c, from: site, at: span)
            declareUnionVariants(ref c, for: id)
            instantiatingEnd(ref c, by: variants)
            return instance
        case .interfaceType:
            let i = InterfaceId(typeIndex(template))
            let typeMap = t13Substitution(in c, from: null, for: in c.interfaces[i].typeParams, by: in args)
            let id = newInterface(ref c, by: InterfaceSymbol {
                name: c.interfaces[i].name,
                nameSpan: c.interfaces[i].nameSpan,
                span: c.interfaces[i].span,
                module: c.interfaces[i].module,
                file: c.interfaces[i].file,
                declIndex: c.interfaces[i].declIndex,
                memberIndex: c.interfaces[i].memberIndex,
                access: c.interfaces[i].access,
                modifiers: c.interfaces[i].modifiers,
                template: i,
                typeArgs: move typeArgs,
                typeMap: move typeMap,
            })
            let instance = interfaceTypeOf(id)
            c.instanceKeys[key] = instance
            let parameters = copyIds(in c.interfaces[i].typeParams)
            if check {
                t13CheckConstraintsAt(ref c, from: site, at: span, for: in parameters, by: instance)
            }
            // A `where` bound can name an instance before the template's members are declared.
            if c.interfaceMembersDeclared {
                let declaring = instantiatingBegin(ref c, from: site, at: span)
                declareInterfaceMembers(ref c, for: id)
                instantiatingEnd(ref c, by: declaring)
            } else {
                c.pendingInterfaces.append(
                    Work { kind: .interfaceMembers, subject: instance, args: List<Type>(), file: site, span: span },
                )
            }
            return instance
        default:
            panic($"`{typeDisplay(ref c, by: template)}` is not generic")
    }
}

/// Compilation.cs:1670 FieldDefault: an instance's default is bound on first use, as a literal can
/// need it before the worklist drains; so is any other struct's (Q1100), with -2 in `defaultValue`
/// while it binds, and BYN2034 when a default reaches itself.
BExpr fieldDefault(ref Ctx c, for StructId s, by FieldId f, from FileId site, at TextSpan span) {
    if c.fields[f].defaultValue == -2 {
        report(
            ref c,
            for: .circularFieldDefault,
            from: c.structs[s].file,
            at: c.fields[f].nameSpan,
            by: ($"{c.structs[s].name}.{c.fields[f].name}", "", "", "", ""),
        )
        return -1
    }
    if c.fields[f].defaultValue == -1 && c.fields[f].hasDefault {
        if c.structs[s].template != -1 {
            let scope = instantiatingBegin(ref c, from: site, at: span)
            if c.fields[f].defaultValue == -1 {
                c.fields[f].defaultValue = -2
                var b = t13NewBinder(c.structs[s].file, owner: s)
                c.fields[f].defaultValue = bindFieldDefault(ref b, through: ref c, for: f)
            }
            instantiatingEnd(ref c, by: scope)
        } else {
            c.fields[f].defaultValue = -2
            var b = t13NewBinder(c.structs[s].file, owner: s)
            c.fields[f].defaultValue = bindFieldDefault(ref b, through: ref c, for: f)
        }
    }
    return c.fields[f].defaultValue
}

/// Compilation.cs:1678 TemplateOf: itself for a generic function's instance, its twin for a member of
/// a generic struct's instance. A `Decl` is `(file, declIndex, memberIndex)`.
FuncId? templateOf(ref Ctx c, for FuncId f) {
    return c.functions[f].template if c.functions[f].template != -1
    let owner = c.functions[f].owner
    return null if owner == -1 || c.structs[owner].template == -1
    return null if c.functions[f].declIndex == -1
    for m in c.structs[c.structs[owner].template].methods {
        return m if c.functions[m].file == c.functions[f].file
            && c.functions[m].declIndex == c.functions[f].declIndex
            && c.functions[m].memberIndex == c.functions[f].memberIndex
    }
    return null
}

/// Compilation.cs:1682 AnalyzeInstance: flow and region analysis of an instantiation; what two
/// instantiations both find is reported once.
void t13AnalyzeInstance(ref Ctx c, for FuncId fn) {
    let outer = pushBag(ref c)
    let bag = c.sink
    analyzeFlow(ref c, for: fn)
    analyzeRegions(ref c, for: fn)
    lintSpanParameter(ref c, for: fn)
    popBag(ref c, to: outer)
    let count = c.bags[bag].items.length
    for i in 0..count {
        let d = t13CloneDiag(in c.bags[bag].items[i])
        let key = $"{d.code}|{d.file}|{d.span.start}|{d.span.length}"
        if !c.instanceAnalysisSeen.contains(key) {
            c.instanceAnalysisSeen[key] = 1
            c.diagnostics.append(move d)
        }
    }
}

/// Compilation.cs:1697 BindConstant.
void bindConstant(ref Ctx c, for ConstId k) {
    return if c.consts[k].state == 2
    if c.consts[k].state == 1 {
        report(
            ref c,
            for: .circularConstant,
            from: c.consts[k].file,
            at: c.consts[k].nameSpan,
            by: (c.consts[k].name, "", "", "", ""),
        )
        c.consts[k].type = errorType()
        c.consts[k].state = 2
        return
    }
    c.consts[k].state = 1
    var b = t13NewBinder(c.consts[k].file)
    bindModuleConstant(ref b, through: ref c, for: k)
    c.consts[k].state = 2
}

/// `fn.Enclosing` to the outermost function (`Outermost` in BindFunction).
FuncId t13Outermost(in Ctx c, for FuncId f) {
    var o = f
    while let e = t13Handle(c.functions[o].enclosing) {
        o = e
    }
    return o
}

/// Compilation.cs:1716 BindFunction: binds a body; when an untyped `var` literal in it meets another
/// integer type first (spec R4), binds it again with that type, discarding the first pass.
void bindFunction(ref Ctx c, for FuncId fn) {
    let checkCount = c.mutationChecks.length
    let requireCount = c.requiresChecks.length
    let locals = c.functions[fn].locals.length
    let outer = c.firstPass
    c.bags.append(DiagBag { items: List<Diag>(), previous: -1 })
    c.firstPasses.append(FirstPass { instances: List<FuncId>(), bag: c.bags.length - 1, errors: List<Diag>() })
    let pass = c.firstPasses.length - 1
    c.firstPass = pass
    let seeds = t13BindBody(ref c, for: fn, by: null)
    c.firstPass = outer
    let instances = copyIds(in c.firstPasses[pass].instances)
    if seeds is null {
        // `outer?.Instances.AddRange(pass.Instances)`
        if (t13FirstPass(in c) is { } o) {
            for i in instances {
                c.firstPasses[o].instances.append(i)
            }
        }
        let bag = c.firstPasses[pass].bag
        var held = List<Diag>()
        for d in c.bags[bag].items {
            held.append(t13CloneDiag(in d))
        }
        reportHeld(ref c, for: in held)
        var errors = List<Diag>()
        for d in c.firstPasses[pass].errors {
            errors.append(t13CloneDiag(in d))
        }
        for d in errors {
            c.instantiationErrors.append(t13CloneDiag(in d))
        }
        return
    }
    // The functions the first pass instantiated go with it, and so do their diagnostics.
    for instance in instances {
        let key = t13Key("f", for: c.functions[instance].template, by: in c.functions[instance].typeArgs)
        let _ = c.instanceKeys.remove(key)
        let module = c.functions[instance].module
        if (t13Find(in c.modules[module].allFunctions, for: instance) is { } at) {
            c.modules[module].allFunctions.remove(at: at)
        }
    }
    // `w.Instance is null || !pass.Instances.Contains(w.Instance)`: C#'s `w.Instance` is a `bindFunction`'s
    // `memberIndex` (Q721), and an instance is never -1.
    var work = List<Work>()
    for w in c.instantiationWork {
        if w.kind != .bindFunction || !t13Contains(in instances, for: w.memberIndex) {
            work.append(
                Work {
                    kind: w.kind,
                    subject: w.subject,
                    args: copyIds(in w.args),
                    instance: w.instance,
                    file: w.file,
                    span: w.span,
                    declIndex: w.declIndex,
                    memberIndex: w.memberIndex,
                    atSite: w.atSite,
                    siteFile: w.siteFile,
                    siteSpan: w.siteSpan,
                },
            )
        }
    }
    c.instantiationWork = move work
    while c.mutationChecks.length > checkCount {
        c.mutationChecks.remove(at: c.mutationChecks.length - 1)
    }
    var checks = List<RequiresCheck>()
    for i in 0..requireCount {
        var args = List<Location>()
        for x in c.requiresChecks[i].callArgs {
            args.append(Location { file: x.file, span: x.span })
        }
        checks.append(
            RequiresCheck {
                source: c.requiresChecks[i].source,
                callSpan: c.requiresChecks[i].callSpan,
                callArgs: move args,
                callee: c.requiresChecks[i].callee,
                arguments: copyIds(in c.requiresChecks[i].arguments),
                argumentFiles: copyIds(in c.requiresChecks[i].argumentFiles),
            },
        )
    }
    c.requiresChecks = move checks
    var kept = List<LocalId>()
    for i in 0..locals {
        kept.append(c.functions[fn].locals[i])
    }
    c.functions[fn].locals = move kept
    // The lambdas it lifted, in the body or in those instances, are lifted again by the second pass.
    var owners = copyIds(in instances)
    owners.append(fn)
    for m in 0..c.modules.length {
        var lifted = List<FuncId>()
        for f in c.modules[m].allFunctions {
            switch c.functions[f].kind {
                case .lambda:
                    if !t13Contains(in owners, for: t13Outermost(in c, for: f)) {
                        lifted.append(f)
                    }
                default:
                    lifted.append(f)
            }
        }
        c.modules[m].allFunctions = move lifted
    }
    let _ = t13BindBody(ref c, for: fn, by: seeds)
}

/// Compilation.cs:1765 BindBody: a first pass (no `seeds`) returns the seeds a second pass needs, if
/// any; `release`'s empty list is C#'s null (Q582).
List<(LocalId, Type)>? t13BindBody(ref Ctx c, for FuncId fn, by in List<(LocalId, Type)>? seeds) {
    let file = c.functions[fn].file
    var owner = c.functions[fn].owner
    var d = c.functions[fn].declIndex
    var m = c.functions[fn].memberIndex
    switch c.functions[fn].kind {
        case .function or .method:
            // `when fn.Decl is { } decl`
            return null if d == -1
        case .getter:
            if (t13Handle(c.functions[fn].iface) is { } _) {
                // `_interfaceGetters[fn]`: the getter's own member of the interface.
                owner = -1
            } else {
                // `fn.Owner.Properties.First(p => p.Getter == fn)`, then its `Decl`.
                var found = false
                for p in c.structs[owner].properties {
                    if !found && c.properties[p].getter == fn {
                        d = c.properties[p].declIndex
                        m = c.properties[p].memberIndex
                        found = true
                    }
                }
                if !found {
                    panic("internal error: a getter without its property")
                }
            }
        case .constructor:
            // `_constructorBodies[fn]`: the constructor's own member of the struct.
            owner = c.functions[fn].owner
        case .testKeyword:
            owner = -1
        case .main:
            return null if c.mainStatementsFn != fn
            owner = -1
        default:
            return null
    }
    var b = t13NewBinder(file, fn: fn, owner: owner)
    if (seeds is { } s) {
        for x in s {
            b.seeds.append(x)
        }
    } else {
        let _ = hold(ref b, through: ref c)
    }
    if c.functions[fn].kind == .main {
        // A copy: `c.mainStatements` cannot be lent while `c` is passed by `ref` (Q718).
        var statements = List<SyntaxRef>()
        for r in c.mainStatements {
            statements.append(r)
        }
        bindMain(ref b, through: ref c, for: in statements)
    } else if c.functions[fn].kind == .testKeyword {
        bindTest(ref b, through: ref c, for: c.testBodies[fn])
    } else {
        switch c.files[file].unit.members[d] {
            case .functionDecl(let n):
                bindFunctionBody(ref b, through: ref c, for: in n.value)
            case .structDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let f):
                        bindFunctionBody(ref b, through: ref c, for: in f.value)
                    case .propertyDecl(let p):
                        bindGetter(ref b, through: ref c, for: in p.value)
                    case .constructorDecl(let k):
                        bindConstructor(ref b, through: ref c, for: in k.value)
                    default:
                        panic("internal error: a struct member without a body")
                }
            case .interfaceDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let f):
                        bindFunctionBody(ref b, through: ref c, for: in f.value)
                    case .propertyDecl(let p):
                        bindGetter(ref b, through: ref c, for: in p.value)
                    default:
                        panic("internal error: an interface member without a body")
                }
            default:
                panic("internal error: a function without a declaration")
        }
    }
    if seeds is null {
        let next = release(ref b, through: ref c)
        return next if next.length > 0
    }
    return null
}

/// Compilation.cs:1801 InferErrorSets: the union of what each body propagates, to a fixed point.
void inferErrorSets(ref Ctx c) {
    // A lambda's sets are its function type's, never inferred.
    var inferred = List<FuncId>()
    for m in 0..c.modules.length {
        for f in c.modules[m].allFunctions {
            let kind = c.functions[f].kind
            if kind != .lambda && (c.functions[f].infersErrors || kind == .main || kind == .testKeyword) {
                inferred.append(f)
            }
        }
    }
    // `changed`, as the number of sets added in a round.
    var changes: i64 = 1
    while changes > 0 {
        changes = 0
        for fn in inferred {
            let before = c.functions[fn].errorSets.length
            if functionIsInstance(ref c, by: fn) {
                if (templateOf(ref c, for: fn) is { } template) {
                    let sets = copyIds(in c.functions[template].errorSets)
                    for set in sets {
                        if !t13Contains(in c.functions[fn].errorSets, for: set) {
                            c.functions[fn].errorSets.append(set)
                        }
                    }
                    changes += c.functions[fn].errorSets.length - before
                    continue
                }
            }
            continue if c.functions[fn].body == -1
            let sets = propagated(ref c, for: c.functions[fn].body)
            for set in sets {
                continue if t13Contains(in c.functions[fn].errorSets, for: set)
                c.functions[fn].errorSets.append(set)
            }
            changes += c.functions[fn].errorSets.length - before
        }
    }
    for fn in inferred {
        let kind = c.functions[fn].kind
        if (kind is .main or .testKeyword) && c.functions[fn].errorSets.length > 0 {
            c.functions[fn].hasFails = true
        }
    }
}

/// The index of the first `x` in `xs`, or null.
i64? t13Find(in List<i64> xs, for i64 x) {
    for i in 0..xs.length {
        return i if xs[i] == x
    }
    return null
}

bool t13Contains(in List<i64> xs, for i64 x) => t13Find(in xs, for: x) is not null

/// Compilation.cs:1885 CheckMutation: a method is mutating when it is declared `ref this`. Every call of one needs a
/// writable receiver, and a method that writes `this` without `ref this` is BYN2115.
void checkMutation(ref Ctx c) {
    for i in 0..c.mutationChecks.length {
        let callee = c.mutationChecks[i].callee
        continue if !c.functions[callee].isMutating
        let fn = c.mutationChecks[i].function
        let receiver = c.mutationChecks[i].receiver
        var b = t13NewBinder(c.mutationChecks[i].source, fn: fn)
        let why = $"`{c.functions[callee].name}` modifies it"
        if !(fn != -1 && functionIsInstance(ref c, by: fn)) {
            let _ = checkWritable(ref b, through: ref c, for: receiver, at: nodeSpan(in c, for: receiver), by: why)
        } else {
            let _ = checkGuardWrite(ref b, through: ref c, for: receiver, at: nodeSpan(in c, for: receiver), by: why)
        }
    }
    var writes = List<(FuncId, TextSpan)>()
    for (fn, w) in c.thisWrites {
        writes.append((fn, w.span))
    }
    for w in writes {
        switch w {
            case (let fn, let span): reportMutatesWithoutRefThis(ref c, for: fn, at: span)
        }
    }
}

/// Compilation.cs:1862 CheckRequires: a `requires` clause that the call's constant arguments make
/// false is BYN2321 at the argument.
void checkRequires(ref Ctx c) {
    for i in 0..c.requiresChecks.length {
        let callee = c.requiresChecks[i].callee
        let source = c.requiresChecks[i].source
        let parameters = copyIds(in c.functions[callee].parameters)
        let arguments = copyIds(in c.requiresChecks[i].arguments)
        var values = Map<LocalId, Constant>()
        for a in 0..arguments.length {
            if (exprConstant(in c, for: arguments[a]) is { } k) {
                values[parameters[a]] = k
            }
        }
        let clauses = copyIds(in c.functions[callee].requirements)
        for clause in clauses {
            let fields = Map<FieldId, Constant>()
            let result = evaluate(ref c, for: clause, from: in values, by: in fields)
            var isFalse = false
            if result is not null {
                isFalse = result.kind == .flag && !result.flag
            }
            continue if !isFalse
            var read = List<LocalId>()
            for n in descendants(in c, for: clause) {
                if boundKind(n) == .local {
                    read.append(c.bLocals[boundIndex(n)].local)
                }
            }
            var at: LocalId = -1
            for p in parameters {
                continue if !t13Contains(in read, for: p) || !values.contains(p)
                // `ReferenceEquals(a.Value, …Syntax)`: the same file and span (Q582).
                let written = nodeSpan(in c, for: arguments[c.locals[p].ordinal])
                let writtenFile = c.requiresChecks[i].argumentFiles[c.locals[p].ordinal]
                var inCall = false
                for a in c.requiresChecks[i].callArgs {
                    if a.file == writtenFile && a.span == written {
                        inCall = true
                    }
                }
                if inCall {
                    at = p
                    break
                }
            }
            let span = at == -1 ? c.requiresChecks[i].callSpan : nodeSpan(in c, for: arguments[c.locals[at].ordinal])
            let text = t13Text(in c, from: c.functions[callee].file, at: nodeSpan(in c, for: clause))
            let name = c.functions[callee].name
            report(
                ref c,
                for: .requiresViolated,
                from: source,
                at: span,
                by: (t13Text(in c, from: source, at: span), text, name, "", ""),
                label: "fails the contract",
                help: $"pass a value that meets `requires {text}`",
            )
        }
    }
}

/// Compilation.cs:1890 InvokeSymbol: what a call through a value of `type` calls; one symbol per
/// type, whose parameters `_0`, `_1`, … carry no particle (spec 007 R9).
FuncId invokeSymbol(ref Ctx c, for Type type) {
    return FuncId(c.invokeSymbols[type]) if c.invokeSymbols.contains(type)
    let data = typeIndex(type)
    var parameters = List<LocalId>()
    for i in 0..c.functionTypes[data].parameters.length {
        parameters.append(newLocal(ref c, by: LocalSymbol {
            name: $"_{i}",
            type: c.functionTypes[data].parameters[i],
            kind: .parameter,
            isParameter: true,
            modifier: .none,
            ordinal: i,
        }))
    }
    let invoke = newFunction(ref c, by: FunctionSymbol {
        name: "invoke",
        module: c.entryModule,
        kind: .invoke,
        returnType: c.functionTypes[data].ret,
        hasFails: c.functionTypes[data].errorSets.length > 0,
        parameters: move parameters,
        errorSets: copyIds(in c.functionTypes[data].errorSets),
    })
    c.invokeSymbols[type] = invoke
    return invoke
}

/// `p.Syntax?.Default is not null`: the parameter's syntax in `fn.Decl` has a default (Q581).
bool t13SyntaxDefault(in Ctx c, for FuncId f, by LocalId p) {
    let file = c.functions[f].file
    let d = c.functions[f].declIndex
    let m = c.functions[f].memberIndex
    let ordinal = c.locals[p].ordinal
    return false if file == -1 || d == -1
    switch c.files[file].unit.members[d] {
        case .functionDecl(let n):
            return ordinal < n.value.params.length && n.value.params[ordinal].defaultKeyword is not .none
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let k):
                    return ordinal < k.value.params.length && k.value.params[ordinal].defaultKeyword is not .none
                case .constructorDecl(let k):
                    return ordinal < k.value.params.length && k.value.params[ordinal].defaultKeyword is not .none
                default:
                    return false
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let k):
                    return ordinal < k.value.params.length && k.value.params[ordinal].defaultKeyword is not .none
                default:
                    return false
            }
        default:
            return false
    }
}

/// Compilation.cs:1901 ParameterDefault: bound on first use.
BExpr? parameterDefault(ref Ctx c, for FuncId f, by LocalId p) {
    if c.locals[p].defaultValue == -1 && t13SyntaxDefault(in c, for: f, by: p) {
        var b = t13NewBinder(c.functions[f].file, fn: -1, owner: c.functions[f].owner)
        if c.functions[f].typeMap.length > 0 {
            var map = Map<string, Type>()
            for (k, v) in c.functions[f].typeMap {
                map[k] = v
            }
            b.typeArgs = move map
        }
        c.locals[p].defaultValue = bindParameterDefault(ref b, through: ref c, for: p)
    }
    return null if c.locals[p].defaultValue == -1
    return c.locals[p].defaultValue
}

/// Compilation.cs:1912 ErrorSetsOf: empty (any error) while an inferred set is still being computed.
List<ErrorSetId> errorSetsOf(ref Ctx c, for FuncId fn) {
    let kind = c.functions[fn].kind
    return List<ErrorSetId>() if c.functions[fn].infersErrors || kind == .main || kind == .testKeyword
    return copyIds(in c.functions[fn].errorSets)
}

/// Compilation.cs:1919 ReportHeld: what a first-pass binder held back, into the sink.
void reportHeld(ref Ctx c, for in List<Diag> held) {
    for d in held {
        t13Add(ref c, by: t13CloneDiag(in d))
    }
}
== semantics/json.byn
// T26: the CLI's lines around the diagnostics (Messages.cs:128-139), `ProgramName` (CliApp.cs:535) and
// `--diagnostics json` (DiagnosticJson.cs).
// Each message is its `Messages.cs` format with the arguments in place; `mark` is the style's symbol
// (`Symbols.Ellipsis`, `Cross` or `Dot`).

/// Messages.cs:128 `DiagCapped`: `{0} and {1} more errors (use --all to show them)`.
string capLine(string mark, by i64 omitted) => $"{mark} and {omitted} more errors (use --all to show them)"

/// Messages.cs:134 `BuildFailed`: `{0} build failed: {1}, {2}`, the counts from `ErrorsOne`/`ErrorsMany`
/// (`{0} error`/`{0} errors`) and `WarningsOne`/`WarningsMany` (`{0} warning`/`{0} warnings`), as
/// CliApp.cs:519-522 picks them.
string buildFailed(string mark, by i64 errors, as i64 warnings) {
    let e = errors == 1 ? $"{errors} error" : $"{errors} errors"
    let w = warnings == 1 ? $"{warnings} warning" : $"{warnings} warnings"
    return $"{mark} build failed: {e}, {w}"
}

/// Messages.cs:139 `BuildExplain`: `  explain: bayan explain {0}`.
string buildExplain(string code) => $"  explain: bayan explain {code}"

/// Messages.cs:133 `CheckSummary`: `{0} checked {1} in {2}`; `seconds` is `Messages.Seconds` (`{0}s`).
public string checkSummary(string mark, for string program, by string seconds) uses alloc =>
    $"{mark} checked {program} in {seconds}"

/// CliApp.cs:535 `ProgramName`: a project's short name, else the file's (a `main.byn` is named after its
/// directory) or the directory's.
public string programName(ref Ctx c, for string path) uses alloc, fs {
    if (c.manifest is { } m) {
        return t10ShortName(in m)
    }
    let full = t11FullPath(path)
    var name = t11DirectoryExists(full) ? t26FileName(t26TrimEndSlash(full)) : t26FileNameWithoutExtension(full)
    if name == "main" && !t11DirectoryExists(full) {
        name = t26FileName(t11DirectoryName(full))
    }
    return name
}

/// The C# `Path.GetFileName`.
string t26FileName(string path) {
    return Path.fileName(path)
}

/// The C# `Path.GetFileNameWithoutExtension`: the file name up to its last `.`.
string t26FileNameWithoutExtension(string path) {
    let name = t26FileName(path)
    var dot: i64 = -1
    var i: i64 = 0
    for b in name.bytes {
        if b == 0x2E {
            dot = i
        }
        i += 1
    }
    return name if dot < 0
    return name[0..dot]
}

/// The C# `TrimEnd(Path.DirectorySeparatorChar)` (CliApp.cs:539): `path` without its trailing separators. The
/// separator is the middle byte of `Path.combine("a", "b")`, which .NET joins with `DirectorySeparatorChar`.
string t26TrimEndSlash(string path) {
    let separator = Path.combine("a", "b").bytes[1]
    var end = path.length
    while end > 0 && path.bytes[end - 1] == separator {
        end -= 1
    }
    return path[0..end]
}

/// DiagnosticJson.cs:18 `Render`: `d` as one compact JSON object, the bytes `Utf8JsonWriter` writes with
/// `UnsafeRelaxedJsonEscaping`. `file` is the path the renderer prints; an empty label or help is the C#
/// `null` (Q646).
string t26DiagnosticJson(in Ctx c, for in Diag d) {
    var sb = StrBuf()
    sb.append(
        $"{{\"code\":{t26JsonString(d.code)},\"severity\":{t26JsonString(severityName(d.isWarning, isNote: d.isNote))}",
    )
    if d.file >= 0 {
        sb.append($",\"file\":{t26JsonString(c.files[d.file].displayPath)},\"span\":")
        t26JsonSpan(ref sb, from: in c, for: d.file, at: d.span)
    } else {
        sb.append(",\"file\":null,\"span\":null")
    }
    sb.append($",\"message\":{t26JsonString(d.message)}")
    sb.append($",\"label\":{t26JsonOptional(d.label)},\"help\":{t26JsonOptional(d.help)},\"fixes\":[")
    if d.hasFix && d.file >= 0 {
        sb.append("{\"span\":")
        t26JsonSpan(ref sb, from: in c, for: d.file, at: d.fixSpan)
        sb.append($",\"replacement\":{t26JsonString(d.fixReplacement)}}}")
    }
    sb.append("]}")
    return $"{sb.finish()}"
}

/// DiagnosticJson.cs:61 `RenderAll`: one object per line, each line ending in `\n`.
string t26DiagnosticJsonAll(in Ctx c, from in List<Diag> diags) {
    var sb = StrBuf()
    for d in diags {
        sb.append(t26DiagnosticJson(in c, for: in d))
        sb.append("\n")
    }
    return $"{sb.finish()}"
}

/// DiagnosticJson.cs:68 `WriteSpan`: byte offsets and one-based line and column (diag.byn `linePosition`).
void t26JsonSpan(ref StrBuf sb, from in Ctx c, for FileId file, at TextSpan span) {
    let start = linePosition(c.files[file].text.span, at: span.start)
    let end = linePosition(c.files[file].text.span, at: span.end)
    sb.append($"{{\"start\":{span.start},\"end\":{span.end},\"line\":{start.line},\"column\":{start.column}")
    sb.append($",\"endLine\":{end.line},\"endColumn\":{end.column}}}")
}

/// DiagnosticJson.cs:82 `WriteOptional`.
string t26JsonOptional(string value) => value.length == 0 ? "null" : t26JsonString(value)
== semantics/main.byn
// bayan-check: the self-hosted checker. Ports the `check` and `types` subset of `CliApp` (CliApp.cs:141
// `Types`, :151 `ParseBuildOptions`, :259 `Compile`, :298 `Report`, :315 `TakeGlobalOptions`, :362 `IsScript`,
// :441 `Check`, :513 `Failed`, :528 `ProgramName` in json.byn), `DiagnosticJson` (json.byn) and the golden
// harness's compilation (DiagTests.cs:20-26). Plain style only: `--color` is checked but paints nothing, and
// the symbols are `Symbols.Unicode`, or `Symbols.Ascii` with `--ascii` (Q646).
//
//     bayan-check [--ascii] [--color <when>] [<check options>] [--spans] <path>
//                                    as `bayan check <path>` (R1); `--spans` also prints a
//                                    `span out of range:` line per diagnostic span outside its file (L023)
//     bayan-check [--ascii] [--color <when>] --types [<check options>] <path>
//                                    as `bayan types <path>` (R2)
//     bayan-check --golden [--tests] [--include-path] [--spans] --package <dir> <file>
//                                    `<file>` compiled alone with `<dir>` as package root, as `DiagTests`
//                                    does, and its diagnostics rendered uncapped to stdout; exit 0
//     bayan-check --many <dir>       `== <name>` and, for every `*.byn` in `<dir>` in name order, its
//                                    `--golden --package <dir>` output and `--spans` lines (corpora, L023),
//                                    then `exit <n>` when that input's exit is not 0
//     bayan-check --time <path>      the nanoseconds `check` spends parsing and checking `<path>`, and
//                                    `parse … check …` on stderr (R7)
//     bayan-check --codes            `code\tmessage` for every `SemaCode`, in `DiagnosticCodes.cs` order
//
// `<check options>` are `ParseBuildOptions`'s with `allowOutput: false`: `--all`, `--mode <m>`,
// `--diagnostics json|text` and `-- <ignored>`. A mode flag is the first argument after the global
// options. Paths are absolute (R1): Bayan has no current directory (Q571).

import lexer
import parser

i32 usage() {
    Io.stderr.write(
        "usage: bayan-check [--ascii] [--color <when>] [--types] [--all] [--mode <m>] [--diagnostics json|text] [--spans] <path> | --golden [--tests] [--include-path] [--spans] --package <dir> <file> | --many <dir> | --time <path> | --codes\n",
    )
    return exitUsage
}

/// DiagTests.cs:20-26: `<file>` compiled alone with `<dir>` as root, tests included with `--tests`, the
/// capabilities and name of `<dir>/package.byn` when there is one, rendered by `RenderAll` uncapped.
i32 golden(in List<string> args) {
    var tests = false
    var includePath = false
    var spans = false
    var dir: string? = null
    var file: string? = null
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--tests" {
            tests = true
        } else if a == "--include-path" {
            includePath = true
        } else if a == "--spans" {
            spans = true
        } else if a == "--package" && i + 1 < args.length {
            i += 1
            dir = args[i]
        } else if file is null && !a.startsWith("-") {
            file = a
        } else {
            return usage()
        }
        i += 1
    }
    let root = dir ?? return usage()
    let path = file ?? return usage()
    var capabilities: List<string>? = null
    var packageName: string? = null
    let manifestPath = t11Combine(root, by: "package.byn")
    if t26FileExists(manifestPath) {
        // Q565: an unreadable `package.byn` reads as an empty one (BYN3100).
        let m = manifestRead(manifestPath) catch manifestParse(lexer.SourceText.create("package.byn", from: List<u8>()))
        if (m.capabilities is { } caps) {
            capabilities = copyStrings(in caps)
        }
        packageName = m.name
    }
    let options = CompilationOptions { includeTests: tests, capabilities: move capabilities, packageName: packageName }
    // `Golden.Load` names the source by its file name.
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create(t26FileName(path), from: t11ReadAllBytes(path)))
    var c = create(from: move sources, at: root, by: in options)
    var omitted: i64 = 0
    Io.stdout.write(renderAll(in c, from: in c.diagnostics, by: includePath, until: noLimit, to: ref omitted))
    if spans {
        t26CheckSpans(ref c)
    }
    return exitOk
}

/// `--many`: every `*.byn` in `dir`, in name order, as `--golden --package <dir>` prints it, then its
/// `--spans` lines; the shape of `bayan-parse --many` (src/parser/main.byn:58). Exits 0, or the
/// last per-input exit that is neither 0 nor 1.
i32 many(string dir) {
    var names = Io.listDir(dir) catch return usage()
    names.sort()
    var worst = exitOk
    for name in names {
        unless name.endsWith(".byn") {
            continue
        }
        let path = t11Combine(dir, by: name)
        var args = List<string>()
        args.append("--package")
        args.append(dir)
        if name.endsWith(".test.byn") {
            args.append("--tests")
        }
        args.append("--spans")
        args.append(path)
        print($"== {name}")
        // One `exit <n>` line after an input whose `golden` exit is not 0; none for 0, so a clean
        // `--many` prints what `--golden` prints (SelfhostSemanticsTests.ManyMatchesCompilation).
        let exit = golden(in args)
        if exit != exitOk {
            print($"exit {exit}")
            if exit != exitFailure {
                worst = exit
            }
        }
    }
    return worst
}

/// `--time` (R7): `check`'s compile of `path`, timed by `Compilation.ParseTime`/`CheckTime`
/// (compile.byn:96, :107); the total on stdout as `bayan-parse --time` does (src/parser/main.byn:80).
i32 timed(string path, by in T26Symbols symbols) {
    var args = List<string>()
    args.append(path)
    let o = t26ParseBuildOptions(in args, allowSpans: false) ?? return exitUsage
    var reported = List<T26Reported>()
    var ok = false
    let c = t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    print($"{c.parseTime + c.checkTime}")
    Io.stderr.write($"parse {c.parseTime} check {c.checkTime}\n")
    return exitOk
}

/// `--codes`: `code\tmessage` for every `SemaCode` (codes.byn:785 `allSemaCodes`), as `bayan-parse --codes`
/// prints `ParseCode` (src/parser/main.byn:99).
i32 printCodes() {
    for code in allSemaCodes() {
        print($"{codeText(code)}\t{messageFormat(code)}")
    }
    return exitOk
}

i32 main(ReadOnlySpan<string> args) {
    // CliApp.cs:315 `TakeGlobalOptions`: `--color` and `--ascii` come out of everything before a `--`. The
    // arguments are `check`'s (R1), so a command is always given and the script branch never applies.
    var ascii = false
    var rest = List<string>()
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--" {
            for k in i..args.length {
                rest.append(args[k])
            }
            break
        }
        var value: string? = null
        if a == "--ascii" {
            ascii = true
        } else if a == "--color" && i + 1 < args.length {
            i += 1
            value = args[i]
        } else if a.startsWith("--color=") {
            value = a["--color=".length..a.length]
        } else if a == "--color" {
            value = ""
        } else {
            rest.append(a)
        }
        if (value is { } v) {
            if v != "auto" && v != "always" && v != "never" {
                Io.stderr.write($"bayan: unknown color setting `{v}` (expected auto, always or never)\n")
                return exitUsage
            }
        }
        i += 1
    }
    let symbols = t26Symbols(ascii)
    let mode = rest.length > 0 ? rest[0] : ""
    if mode == "--types" {
        rest.remove(at: 0)
        return types(in rest, by: in symbols)
    }
    if mode == "--golden" {
        rest.remove(at: 0)
        return golden(in rest)
    }
    return rest.length == 2 ? many(rest[1]) : usage() if mode == "--many"
    return rest.length == 2 ? timed(rest[1], by: in symbols) : usage() if mode == "--time"
    return rest.length == 1 ? printCodes() : usage() if mode == "--codes"
    return check(in rest, by: in symbols)
}
== semantics/manifest.byn
// T10: Bayan.Syntax/Packages/Manifest.cs.
//
// `package.byn` (spec §19.2) is data only: `Type { field: value, … }` (`field = value` is still read, with
// BYN3104) where a value is a string, an integer, `true`, `false`, `.name`, `[value, …]`, `[key: value, …]`
// or another `Type { … }`. The C# `Value` records become `T10Value`s in one arena, referred to by index
// (-1 for C#'s `null`); the C# `Reader` class is `T10Reader` plus a `ref List<Diag>` for its sink.
// Manifest diagnostics have no file (`file` -1): the C# `Diagnostic.Source` is the manifest's own text,
// which the caller (T26) renders (Q565). Casing is ASCII only, as in Q442 (Q566).

import lexer

enum PackageKind {
    app
    lib
}

public enum BooleanStyle {
    symbols
    words
}

public enum PrimitiveStyle {
    sized
    csharp
}

public enum AlignStyle {
    runs
    none
}

// `.never` in a manifest; `never` is a keyword here, so the case is `omit`.
public enum TrailingCommaStyle {
    multiline
    omit
}

public enum LintSeverity {
    none
    suggestion
    warning
    error
}

// The C# `Grammar`: the package's extra lexicon words and irregular forms.
struct Grammar {
    List<string>        verbs       = []
    List<string>        nouns       = []
    List<string>        adjectives  = []
    List<string>        collectives = []
    Map<string, string> forms       = []
}

// The C# `Manifest`; `capabilities` is null when the package lists none.
public struct Manifest {
    string                           name           = ""
    public string                    version        = ""
    i64                              edition        = 2027
    PackageKind                      kind           = .app
    List<string>?                    capabilities   = null
    public List<string>              distTargets    = []
    public string                    distMode       = "safe"
    public i64?                      minLines       = null
    public i64?                      minBranches    = null
    public i64?                      minErrorPaths  = null
    public i64?                      minMutation    = null
    public bool                      summary        = true
    public i64                       indent         = 4
    public i64                       width          = 120
    public AlignStyle                align          = .runs
    public TrailingCommaStyle        trailingCommas = .multiline
    public Map<string, LintSeverity> lints          = t10DefaultLints()
    public BooleanStyle              booleans       = .symbols
    public PrimitiveStyle            primitives     = .sized
    Grammar                          grammar        = {}
    public List<Diag>                diagnostics    = []
}

// ── Values (the C# `Value` records) ──────────────────────────────────────────

enum T10ValueKind {
    stringValue
    intValue
    boolValue
    enumValue
    listValue
    mapValue
    objectValue
}

/// One `field: value` of an object value; `value` indexes `T10Reader.values`.
struct T10Field {
    string   name
    TextSpan nameSpan
    i64      value
}

/// A C# `Value`: `text` is a string's contents, an enum's name or an object's type; `number` an int, or a bool as 1 or 0; a list's items and a
/// map's values are in `items`, a map's keys in `keys`, all indexes into `T10Reader.values`.
struct T10Value {
    T10ValueKind   kind
    TextSpan       span
    string         text   = ""
    i64            number = 0
    List<i64>      items  = []
    List<i64>      keys   = []
    List<T10Field> fields = []
}

/// The C# `Reader`: the manifest's bytes and tokens, a position and the value arena.
struct T10Reader {
    List<u8>          bytes
    List<lexer.Token> tokens
    i64               pos    = 0
    List<T10Value>    values = []
}

// ── Entry points ─────────────────────────────────────────────────────────────

/// Manifest.cs:73 `HasErrors`, as a count.
public i64 manifestErrorCount(in Manifest m) {
    var n: i64 = 0
    for d in m.diagnostics {
        unless d.isWarning {
            n += 1
        }
    }
    return n
}

/// Manifest.cs:75 `Read`. Fails as C#'s `File.ReadAllBytes` throws; a caller that keeps Q565's reading of an unreadable file as an empty
/// one (BYN3100) catches at its call site.
public Manifest manifestRead(string path) uses alloc, fs fails IoError {
    let bytes = try Io.readFile(path)
    return manifestParse(lexer.SourceText.create("package.byn", from: move bytes))
}

/// Manifest.cs:77 `Parse`.
Manifest manifestParse(move lexer.SourceText source) {
    var m = Manifest {}
    var lexed = lexer.lex(move source, by: lexer.Keywords.build())
    for d in lexed.diagnostics {
        m.diagnostics.append(t10FromLexer(in d))
    }
    return m if manifestErrorCount(in m) > 0
    var bytes = List<u8>()
    for b in lexed.source.bytes {
        bytes.append(b)
    }
    var tokens = List<lexer.Token>()
    for t in lexed.tokens {
        tokens.append(t)
    }
    var r = T10Reader { bytes: move bytes, tokens: move tokens }
    var diags = List<Diag>()
    let root = t10ReadValue(ref r, to: ref diags)
    if root >= 0 && !t10AtEnd(in r) {
        t10Fail(in r, for: "the end of the file after `Package { … }`", to: ref diags)
    }
    for d in diags {
        m.diagnostics.append(t10CopyDiag(in d))
    }
    return m if manifestErrorCount(in m) > 0
    if r.values[root].kind != .objectValue || r.values[root].text != "Package" {
        t10Report(ref m, for: .manifestNotData, at: r.values[root].span, by: t10Args("`Package { … }`", by: ""))
        return m
    }
    t10Bind(ref m, from: in r, at: root)
    return m
}

// ── Bind ─────────────────────────────────────────────────────────────────────

const t10NameExpected: string    = "a string `namespace/name` of lowercase words joined by `-`, e.g. `\"local/tally\"`"
const t10VersionExpected: string = "a semantic version string, e.g. `\"0.1.0\"`"

/// Manifest.cs:96 `Bind`.
void t10Bind(ref Manifest m, from in T10Reader r, at i64 package) {
    let fields = t10Fields(ref m, from: in r, at: package, by: t10PackageFields(), for: [])
    let name = t10Required(ref m, from: in r, for: in fields, by: "name", at: package)
    if name >= 0 {
        if (t10Text(ref m, from: in r, at: name, for: "name", as: t10NameExpected) is { } n) {
            if t10IsPackageName(n) {
                m.name = n
            } else {
                t10Invalid(ref m, from: in r, at: name, for: "name", as: t10NameExpected)
            }
        }
    }
    let version = t10Required(ref m, from: in r, for: in fields, by: "version", at: package)
    if version >= 0 {
        if (t10Text(ref m, from: in r, at: version, for: "version", as: t10VersionExpected) is { } v) {
            if t10IsSemanticVersion(v) {
                m.version = v
            } else {
                t10Invalid(ref m, from: in r, at: version, for: "version", as: t10VersionExpected)
            }
        }
    }
    if fields.contains("edition") {
        let edition = fields["edition"]
        if r.values[edition].kind == .intValue && r.values[edition].number == 2027 {
            m.edition = 2027
        } else {
            t10Invalid(ref m, from: in r, at: edition, for: "edition", as: "`2027`, the only edition so far")
        }
    }
    if fields.contains("kind") {
        let kind = fields["kind"]
        if t10IsEnum(in r, at: kind, as: "app") {
            m.kind = .app
        } else if t10IsEnum(in r, at: kind, as: "lib") {
            m.kind = .lib
        } else {
            t10Invalid(ref m, from: in r, at: kind, for: "kind", as: "`.app` or `.lib`")
        }
    }
    if fields.contains("capabilities") {
        let capabilities = fields["capabilities"]
        if t10IsListOf(in r, at: capabilities, as: .enumValue) {
            var names = List<string>()
            for item in r.values[capabilities].items {
                names.append(r.values[item].text)
            }
            m.capabilities = move names
        } else {
            t10Invalid(
                ref m,
                from: in r,
                at: capabilities,
                for: "capabilities",
                as: "a list of capabilities, e.g. `[.fs, .net]`",
            )
        }
    }
    if fields.contains("test") {
        t10BindTests(ref m, from: in r, at: fields["test"])
    }
    if fields.contains("style") {
        t10BindStyle(ref m, from: in r, at: fields["style"])
    }
    if fields.contains("grammar") {
        t10BindGrammar(ref m, from: in r, at: fields["grammar"])
    }
    if fields.contains("dist") {
        t10BindDist(ref m, from: in r, at: fields["dist"])
    }
}

/// The `test` part of `Bind` (Manifest.cs:157-163): `lines`, `branches`, `errorPaths`, `mutation` and `summary`.
void t10BindTests(ref Manifest m, from in T10Reader r, at i64 tests) {
    if r.values[tests].kind != .objectValue || r.values[tests].text != "Tests" {
        t10Invalid(ref m, from: in r, at: tests, for: "test", as: "a `Tests { … }`")
        return
    }
    let fields = t10Fields(ref m, from: in r, at: tests, by: t10TestsFields(), for: [])
    m.minLines = t10Percent(ref m, from: r, at: fields, for: "lines")
    m.minBranches = t10Percent(ref m, from: r, at: fields, for: "branches")
    m.minErrorPaths = t10Percent(ref m, from: r, at: fields, for: "errorPaths")
    m.minMutation = t10Percent(ref m, from: r, at: fields, for: "mutation")
    if fields.contains("summary") {
        let summary = fields["summary"]
        if r.values[summary].kind == .boolValue {
            m.summary = r.values[summary].number != 0
        } else {
            t10Invalid(ref m, from: in r, at: summary, for: "test.summary", as: "`true` or `false`")
        }
    }
}

/// Manifest.cs:268 `Percent`: the field's value from 0 to 100, null when absent or invalid (reported).
i64? t10Percent(ref Manifest m, from T10Reader r, at Map<string, i64> fields, for string name) uses alloc {
    unless fields.contains(name) {
        return null
    }
    let value = fields[name]
    // coverage-exempt: Q1217 an int value is an integer literal, never below 0 (Manifest.cs:451 `IntValue` too)
    return r.values[value].number if r.values[value].kind == .intValue
        && r.values[value].number >= 0
        && r.values[value].number <= 100
    t10Invalid(ref m, from: in r, at: value, for: $"test.{name}", as: "a percentage from 0 to 100, e.g. `80`")
    return null
}

/// The `style` part of Manifest.cs:96 `Bind`.
void t10BindStyle(ref Manifest m, from in T10Reader r, at i64 style) {
    if r.values[style].kind != .objectValue || r.values[style].text != "Style" {
        t10Invalid(ref m, from: in r, at: style, for: "style", as: "a `Style { … }`")
        return
    }
    let fields = t10Fields(ref m, from: in r, at: style, by: t10StyleFields(), for: t10RemovedStyleFields())
    if fields.contains("indent") {
        let indent = fields["indent"]
        if r.values[indent].kind == .intValue && r.values[indent].number > 0 && r.values[indent].number <= 2147483647 {
            m.indent = r.values[indent].number
        } else {
            t10Invalid(ref m, from: in r, at: indent, for: "style.indent", as: "a positive integer, e.g. `4`")
        }
    }
    if fields.contains("width") {
        let width = fields["width"]
        if r.values[width].kind == .intValue && r.values[width].number > 0 && r.values[width].number <= 2147483647 {
            m.width = r.values[width].number
        } else {
            t10Invalid(ref m, from: in r, at: width, for: "style.width", as: "a positive integer, e.g. `120`")
        }
    }
    if fields.contains("align") {
        let align = fields["align"]
        if t10IsEnum(in r, at: align, as: "runs") {
            m.align = .runs
        } else if t10IsEnum(in r, at: align, as: "none") {
            m.align = .none
        } else {
            t10Invalid(ref m, from: in r, at: align, for: "style.align", as: "`.runs` or `.none`")
        }
    }
    if fields.contains("trailingCommas") {
        let trailingCommas = fields["trailingCommas"]
        if t10IsEnum(in r, at: trailingCommas, as: "multiline") {
            m.trailingCommas = .multiline
        } else if t10IsEnum(in r, at: trailingCommas, as: "never") {
            m.trailingCommas = .omit
        } else if r.values[trailingCommas].kind == .boolValue {
            t10Invalid(
                ref m,
                from: in r,
                at: trailingCommas,
                for: "style.trailingCommas",
                as: "`.multiline` or `.never`, not `true` or `false`",
            )
        } else {
            t10Invalid(
                ref m,
                from: in r,
                at: trailingCommas,
                for: "style.trailingCommas",
                as: "`.multiline` or `.never`",
            )
        }
    }
    if fields.contains("braces") {
        t10Invalid(
            ref m,
            from: in r,
            at: fields["braces"],
            for: "style.braces",
            as: "removed: there is no brace knob, `{` always ends the line",
        )
    }
    if fields.contains("maxLine") {
        t10Invalid(ref m, from: in r, at: fields["maxLine"], for: "style.maxLine", as: "removed: use `style.width`")
    }
    if fields.contains("lints") {
        let lints = fields["lints"]
        if r.values[lints].kind == .mapValue {
            for i in 0..r.values[lints].keys.length {
                let key = r.values[lints].keys[i]
                let severity = r.values[lints].items[i]
                if r.values[key].kind != .stringValue || !m.lints.contains(r.values[key].text) {
                    var names = StrBuf()
                    let known = t10LintNames()
                    for j in 0..known.length {
                        if j > 0 {
                            names.append(", ")
                        }
                        names.append($"`{known[j]}`")
                    }
                    t10Invalid(
                        ref m,
                        from: in r,
                        at: key,
                        for: "style.lints",
                        as: $"a known lint name: {names.finish()}",
                    )
                } else if t10IsEnum(in r, at: severity, as: "none") {
                    m.lints[r.values[key].text] = .none
                } else if t10IsEnum(in r, at: severity, as: "suggestion") {
                    m.lints[r.values[key].text] = .suggestion
                } else if t10IsEnum(in r, at: severity, as: "warning") {
                    m.lints[r.values[key].text] = .warning
                } else if t10IsEnum(in r, at: severity, as: "error") {
                    m.lints[r.values[key].text] = .error
                } else {
                    t10Invalid(
                        ref m,
                        from: in r,
                        at: severity,
                        for: "style.lints",
                        as: $"`.none`, `.suggestion`, `.warning` or `.error` for `{r.values[key].text}`",
                    )
                }
            }
        } else if r.values[lints].kind != .listValue || r.values[lints].items.length != 0 {
            t10Invalid(
                ref m,
                from: in r,
                at: lints,
                for: "style.lints",
                as: "a map from a lint name to `.none`, `.suggestion`, `.warning` or `.error`, e.g. `[\"guards.postfix\": .warning]`",
            )
        }
    }
    if fields.contains("booleans") {
        let booleans = fields["booleans"]
        if t10IsEnum(in r, at: booleans, as: "symbols") {
            m.booleans = .symbols
        } else if t10IsEnum(in r, at: booleans, as: "words") {
            m.booleans = .words
        } else {
            t10Invalid(ref m, from: in r, at: booleans, for: "style.booleans", as: "`.symbols` or `.words`")
        }
    }
    if fields.contains("primitives") {
        let primitives = fields["primitives"]
        if t10IsEnum(in r, at: primitives, as: "sized") {
            m.primitives = .sized
        } else if t10IsEnum(in r, at: primitives, as: "csharp") {
            m.primitives = .csharp
        } else {
            t10Invalid(ref m, from: in r, at: primitives, for: "style.primitives", as: "`.sized` or `.csharp`")
        }
    }
}

/// The `grammar` part of Manifest.cs:114 `Bind`.
void t10BindGrammar(ref Manifest m, from in T10Reader r, at i64 grammar) {
    if r.values[grammar].kind != .objectValue || r.values[grammar].text != "Grammar" {
        t10Invalid(ref m, from: in r, at: grammar, for: "grammar", as: "a `Grammar { … }`")
        return
    }
    let fields = t10Fields(ref m, from: in r, at: grammar, by: t10GrammarFields(), for: [])
    t10BindWords(ref m, from: in r, for: in fields, by: "verbs")
    t10BindWords(ref m, from: in r, for: in fields, by: "nouns")
    t10BindWords(ref m, from: in r, for: in fields, by: "adjectives")
    t10BindWords(ref m, from: in r, for: in fields, by: "collectives")
    t10CheckOverlap(ref m, from: r, for: fields)
    if fields.contains("forms") {
        let forms = fields["forms"]
        if t10IsStringMap(in r, at: forms) {
            for i in 0..r.values[forms].keys.length {
                let word = r.values[r.values[forms].keys[i]].text
                let form = r.values[r.values[forms].items[i]].text
                m.grammar.forms[word] = form
            }
        } else if r.values[forms].kind != .listValue || r.values[forms].items.length != 0 {
            t10Invalid(
                ref m,
                from: in r,
                at: forms,
                for: "grammar.forms",
                as: "a map from a word to its form, e.g. `[\"upsert\": \"upserted\"]`",
            )
        }
    }
}

/// One of `verbs`, `nouns`, `adjectives`, `collectives` in Manifest.cs:214 `Grammar.Collectives`: the words join the set, duplicates once.
void t10BindWords(ref Manifest m, from in T10Reader r, for in Map<string, i64> fields, by string field) {
    unless fields.contains(field) {
        return
    }
    let list = fields[field]
    unless t10IsListOf(in r, at: list, as: .stringValue) {
        t10Invalid(ref m, from: in r, at: list, for: $"grammar.{field}", as: "a list of words, e.g. `[\"upsert\"]`")
        return
    }
    for item in r.values[list].items {
        let word = r.values[item].text
        switch field {
            case "verbs": t10AddWord(ref m.grammar.verbs, by: word)
            case "nouns": t10AddWord(ref m.grammar.nouns, by: word)
            case "adjectives": t10AddWord(ref m.grammar.adjectives, by: word)
            default: t10AddWord(ref m.grammar.collectives, by: word)
        }
    }
}

/// `HashSet.Add`: `word` joins `words` unless it is there.
void t10AddWord(ref List<string> words, by string word) {
    for w in words {
        return if w == word
    }
    words.append(word)
}

/// The `dist` part of Manifest.cs:96 `Bind`.
void t10BindDist(ref Manifest m, from in T10Reader r, at i64 dist) {
    if r.values[dist].kind != .objectValue || r.values[dist].text != "Dist" {
        t10Invalid(ref m, from: in r, at: dist, for: "dist", as: "a `Dist { … }`")
        return
    }
    let fields = t10Fields(ref m, from: in r, at: dist, by: t10DistFields(), for: [])
    if fields.contains("targets") {
        let targets = fields["targets"]
        if t10IsListOf(in r, at: targets, as: .enumValue) {
            for item in r.values[targets].items {
                m.distTargets.append(kebabOf(r.values[item].text))
            }
        } else {
            t10Invalid(
                ref m,
                from: in r,
                at: targets,
                for: "dist.targets",
                as: "a list of targets, e.g. `[.host, .linuxX64]`",
            )
        }
    }
    if fields.contains("mode") {
        let mode = fields["mode"]
        if t10IsEnum(in r, at: mode, as: "debug")
                || t10IsEnum(in r, at: mode, as: "safe")
                || t10IsEnum(in r, at: mode, as: "fast") {
            m.distMode = r.values[mode].text
        } else {
            t10Invalid(ref m, from: in r, at: mode, for: "dist.mode", as: "`.debug`, `.safe` or `.fast`")
        }
    }
}

List<string> t10PackageFields() =>
    ["name", "version", "edition", "kind", "codes", "capabilities", "deps", "test", "dist", "style", "grammar"]

List<string> t10TestsFields() => ["lines", "branches", "errorPaths", "mutation", "summary", "diffCoverage", "nightly"]

List<string> t10DistFields() => ["targets", "mode"]

List<string> t10StyleFields() => ["indent", "width", "align", "trailingCommas", "booleans", "primitives", "lints"]

/// Manifest.cs:47 `RemovedStyleFields`.
List<string> t10RemovedStyleFields() => ["braces", "maxLine"]

/// Manifest.cs:50 `LintNames`, in order.
List<string> t10LintNames() => [
    "guards.postfix",
    "lambdas.it",
    "nesting.depth",
    "functions.length",
    "conditions.named",
    "sections.banner",
    "conditions.patterns",
    "literals.empty",
    "optionals.bind",
]

/// Manifest.cs:50 `LintNames` defaults, the C# `_lints` initializer (Manifest.cs:117).
Map<string, LintSeverity> t10DefaultLints() => [
    "guards.postfix": .suggestion,
    "lambdas.it": .suggestion,
    "nesting.depth": .suggestion,
    "functions.length": .none,
    "conditions.named": .suggestion,
    "sections.banner": .suggestion,
    "conditions.patterns": .suggestion,
    "literals.empty": .suggestion,
    "optionals.bind": .suggestion,
]

List<string> t10GrammarFields() => ["verbs", "nouns", "adjectives", "collectives", "forms"]

/// Manifest.cs:345 `Fields`: the known fields by name (and the `removed` ones, read so each is reported on its own); unknown and repeated ones are reported.
Map<string, i64> t10Fields(
    ref Manifest m,
    from in T10Reader r,
    at i64 obj,
    by in List<string> known,
    for in List<string> removed
) {
    var fields: Map<string, i64> = []
    for f in r.values[obj].fields {
        if !t10Contains(in known, for: f.name) && !t10Contains(in removed, for: f.name) {
            var help = StrBuf()
            help.append("use one of the fields ")
            for i in 0..known.length {
                if i > 0 {
                    help.append(", ")
                }
                help.append($"`{known[i]}`")
            }
            t10Report(
                ref m,
                for: .manifestUnknownField,
                at: f.nameSpan,
                by: t10Args(f.name, by: r.values[obj].text),
                help: $"{help.finish()}",
            )
        } else if fields.contains(f.name) {
            t10Report(ref m, for: .manifestNotData, at: f.nameSpan, by: t10Args($"`{f.name}` only once", by: ""))
        } else {
            fields[f.name] = f.value
        }
    }
    return fields
}

bool t10Contains(in List<string> xs, for string x) {
    for s in xs {
        return true if s == x
    }
    return false
}

/// Manifest.cs:229 `Required`: the field's value, or -1 after BYN3103 at the object's type name.
i64 t10Required(ref Manifest m, from in T10Reader r, for in Map<string, i64> fields, by string name, at i64 package) {
    return fields[name] if fields.contains(name)
    let span = TextSpan { start: r.values[package].span.start, length: r.values[package].text.length }
    t10Report(ref m, for: .manifestMissingField, at: span, by: t10Args(name, by: ""))
    return -1
}

/// Manifest.cs:236 `Text`: a string value's contents, or null after BYN3102.
string? t10Text(ref Manifest m, from in T10Reader r, at i64 value, for string field, as string expected) {
    return r.values[value].text if r.values[value].kind == .stringValue
    t10Invalid(ref m, from: in r, at: value, for: field, as: expected)
    return null
}

/// Manifest.cs:291 `CheckOverlap`: a word in two classes is an error, except a verb that is also a noun; the
/// words compare in lowercase and a word repeated within one list is no overlap.
void t10CheckOverlap(ref Manifest m, from T10Reader r, for Map<string, i64> fields) {
    var seen: Map<string, string> = []
    let classes: List<string> = ["verbs", "nouns", "adjectives", "collectives"]
    for field in classes {
        unless fields.contains(field) {
            continue
        }
        let list = fields[field]
        continue if r.values[list].kind != .listValue
        // A list already reported as not a list of words is not read again (one BYN3102 per mistake).
        var allWords = true
        for item in r.values[list].items {
            if r.values[item].kind != .stringValue {
                allWords = false
            }
        }
        unless allWords {
            continue
        }
        for item in r.values[list].items {
            // coverage-exempt: Q1203
            continue if r.values[item].kind != .stringValue
            let word = lowerAscii(r.values[item].text)
            if seen.contains(word) && seen[word] != field && !(seen[word] == "verbs" && field == "nouns") {
                let other = seen[word]
                t10Invalid(
                    ref m,
                    from: in r,
                    at: item,
                    for: $"grammar.{field}",
                    as: $"free of `{r.values[item].text}`, which `grammar.{other}` lists; only a verb that is also a noun may be in two lists",
                )
            } else if !seen.contains(word) {
                seen[word] = field
            }
        }
    }
}

/// Manifest.cs:243 `Invalid`: BYN3102 at the value.
void t10Invalid(ref Manifest m, from in T10Reader r, at i64 value, for string field, as string expected) {
    t10Report(ref m, for: .manifestInvalidValue, at: r.values[value].span, by: t10Args(field, by: expected))
}

/// Manifest.cs:246 `Report`.
void t10Report(
    ref Manifest m,
    for SemaCode code,
    at TextSpan span,
    by (string a0, string a1, string a2, string a3, string a4) args,
    string help = ""
) {
    m.diagnostics.append(Diag {
        code: codeText(code),
        span: span,
        message: format(messageFormat(code), by: args),
        help: help,
        isWarning: isWarning(code),
        hasFix: false,
        fixSpan: TextSpan { start: 0, length: 0 },
        fixReplacement: "",
        related: List<Related>(),
    })
}

(string a0, string a1, string a2, string a3, string a4) t10Args(string a, by string b) =>
    (a0: a, a1: b, a2: "", a3: "", a4: "")

/// `value is EnumValue { Name: name }`.
bool t10IsEnum(in T10Reader r, at i64 value, as string name) =>
    r.values[value].kind == .enumValue && r.values[value].text == name

/// `value is ListValue list && list.Items.All(i => i is <kind>)`.
bool t10IsListOf(in T10Reader r, at i64 value, as T10ValueKind kind) {
    return false if r.values[value].kind != .listValue
    for item in r.values[value].items {
        return false if r.values[item].kind != kind
    }
    return true
}

/// `value is MapValue map && map.Entries.All(e => e is (StringValue, StringValue))`.
bool t10IsStringMap(in T10Reader r, at i64 value) {
    return false if r.values[value].kind != .mapValue
    for i in 0..r.values[value].keys.length {
        return false if r.values[r.values[value].keys[i]].kind != .stringValue
        return false if r.values[r.values[value].items[i]].kind != .stringValue
    }
    return true
}

/// A lexer diagnostic as a `Diag`: an error with no file and no related spans.
Diag t10FromLexer(in lexer.Diagnostic d) => Diag {
    code: d.code,
    span: d.span,
    message: d.message,
    label: d.label,
    help: d.help,
    hasFix: d.hasFix,
    fixSpan: d.fixSpan,
    fixReplacement: d.fixReplacement,
    related: List<Related>(),
}

/// A copy of a reader diagnostic (which has no related spans).
Diag t10CopyDiag(in Diag d) => Diag {
    code: d.code,
    file: d.file,
    span: d.span,
    message: d.message,
    label: d.label,
    help: d.help,
    isWarning: d.isWarning,
    isNote: d.isNote,
    hasFix: d.hasFix,
    fixSpan: d.fixSpan,
    fixReplacement: d.fixReplacement,
    related: List<Related>(),
}

// ── Names and versions ───────────────────────────────────────────────────────

/// Manifest.cs:250 `KebabOf`: `linuxX64` → `linux-x64`.
public string kebabOf(string camel) uses alloc {
    var buf = List<u8>()
    for b in camel.bytes {
        if b is 0x41..=0x5A {
            buf.append(0x2D)
            buf.append(b + 32)
        } else {
            buf.append(b)
        }
    }
    var sb = StrBuf()
    appendUtf8(buf.span, to: ref sb)
    return $"{sb.finish()}"
}

/// Manifest.cs:262 `CamelOf`: `my-lib` → `myLib`.
public string camelOf(string kebab) uses alloc {
    let t = kebab.bytes
    var buf = List<u8>()
    var i: i64 = 0
    while i < t.length {
        if t[i] == 0x2D && i + 1 < t.length {
            i += 1
            let c = t[i]
            buf.append(c >= 0x61 && c <= 0x7A ? c - 32 : c)
        } else {
            buf.append(t[i])
        }
        i += 1
    }
    var sb = StrBuf()
    appendUtf8(buf.span, to: ref sb)
    return $"{sb.finish()}"
}

/// The part of `name` after the `/` (the C# `ShortName`).
string t10ShortName(in Manifest m) {
    let t = m.name.bytes
    let slash = t10IndexOf(t, for: 0x2F)
    return m.name[slash + 1..t.length]
}

/// `CliApp.EntryModule`: a library's entry module is its short name in camelCase, an app's is `app`.
string t10EntryModule(in Manifest m) => m.kind == .lib ? camelOf(t10ShortName(in m)) : "app"

bool t10IsAsciiLower(u8 c) => c is 0x61..=0x7A

bool t10IsAsciiDigit(u8 c) => c is 0x30..=0x39

bool t10IsAsciiLetterOrDigit(u8 c) => t10IsAsciiLower(c) || t10IsAsciiDigit(c) || (c is 0x41..=0x5A)

/// Manifest.cs:274 `IsKebabName`: lowercase words joined by `-`.
public bool t10IsKebabName(ReadOnlySpan<u8> text) {
    return false if text.length == 0 || !t10IsAsciiLower(text[0]) || text[text.length - 1] == 0x2D
    for i in 0..text.length {
        let c = text[i]
        if c == 0x2D {
            return false if text[i - 1] == 0x2D
        } else if !t10IsAsciiLower(c) && !t10IsAsciiDigit(c) {
            return false
        }
    }
    return true
}

/// Manifest.cs:285 `IsPackageName`: exactly one `/` between two kebab names.
bool t10IsPackageName(string text) {
    let t = text.bytes
    let slash = t10IndexOf(t, for: 0x2F)
    return false if slash < 0
    return false if t10IndexOf(t[slash + 1..t.length], for: 0x2F) >= 0
    return t10IsKebabName(t[0..slash]) && t10IsKebabName(t[slash + 1..t.length])
}

/// Manifest.cs:292 `IsSemanticVersion`: `MAJOR.MINOR.PATCH`, each 1–18 digits without a leading zero,
/// then optional `-pre` and `+build` dot-separated identifiers of `[0-9A-Za-z-]`.
public bool t10IsSemanticVersion(string text) {
    let t = text.bytes
    let plus = t10IndexOf(t, for: 0x2B)
    let main = plus < 0 ? t : t[0..plus]
    return false if plus >= 0 && !t10Identifiers(t[plus + 1..t.length])
    let dash = t10IndexOf(main, for: 0x2D)
    let core = dash < 0 ? main : main[0..dash]
    return false if dash >= 0 && !t10Identifiers(main[dash + 1..main.length])
    var parts: i64 = 0
    var start: i64 = 0
    for i in 0..core.length + 1 {
        continue if i < core.length && core[i] != 0x2E
        let p = core[start..i]
        return false if p.length is 0 or > 18
        for c in p {
            unless t10IsAsciiDigit(c) {
                return false
            }
        }
        return false if p.length > 1 && p[0] == 0x30
        parts += 1
        start = i + 1
    }
    return parts == 3
}

/// Manifest.cs:355 `CompareVersions`: the numeric core, then a release above its prereleases, then the prerelease text ordinally;
/// negative, zero or positive. Both are valid semantic versions.
public i64 compareVersions(string a, to string b) uses alloc {
    let pa = splitVersion(a)
    let pb = splitVersion(b)
    for i in 0..3 {
        return pa.core[i] < pb.core[i] ? -1 : 1 if pa.core[i] != pb.core[i]
    }
    if (pa.pre is { } x) {
        // A prerelease is below a release.
        let y = pb.pre ?? return -1
        let u = x.bytes
        let w = y.bytes
        var k: i64 = 0
        while k < u.length && k < w.length {
            // coverage-exempt: Q1152 the only caller visits names in `Io.listDir` order (ordinal), so a name never sorts below the best so far inside a prerelease
            return u[k] < w[k] ? -1 : 1 if u[k] != w[k]
            k += 1
        }
        return u.length - w.length
    }
    // coverage-exempt: Q1152 a release sorts before its prereleases, so `a` is never a release against a prerelease `b` (see above)
    return pb.pre is null ? 0 : 1
}

/// The numeric core and the prerelease of a version, as `SplitVersion` returns them.
struct VersionParts {
    List<i64> core
    string?   pre
}

/// Manifest.cs:368 `SplitVersion`: the three numbers of `v` and its prerelease (null without one); the build metadata after `+` is dropped.
/// `v` is a valid semantic version (each number 1-18 digits), so a number fits `i64`.
VersionParts splitVersion(string v) uses alloc {
    let t = v.bytes
    let plus = t10IndexOf(t, for: 0x2B)
    let main = plus < 0 ? t : t[0..plus]
    let dash = t10IndexOf(main, for: 0x2D)
    let core = dash < 0 ? main : main[0..dash]
    var numbers = List<i64>()
    var value: i64 = 0
    for i in 0..core.length + 1 {
        if i < core.length && core[i] != 0x2E {
            value = value * 10 + (i64(core[i]) - 0x30)
            continue
        }
        numbers.append(value)
        value = 0
    }
    var pre: string? = null
    if dash >= 0 {
        var sb = StrBuf()
        appendUtf8(main[dash + 1..main.length], to: ref sb)
        pre = $"{sb.finish()}"
    }
    return VersionParts { core: move numbers, pre: pre }
}

/// The local `Identifiers` of Manifest.cs:301: non-empty dot-separated runs of `[0-9A-Za-z-]`.
bool t10Identifiers(ReadOnlySpan<u8> text) {
    var length: i64 = 0
    for c in text {
        if c == 0x2E {
            return false if length == 0
            length = 0
        } else if t10IsAsciiLetterOrDigit(c) || c == 0x2D {
            length += 1
        } else {
            return false
        }
    }
    return length > 0
}

i64 t10IndexOf(ReadOnlySpan<u8> text, for u8 b) {
    for i in 0..text.length {
        return i if text[i] == b
    }
    return -1
}

// ── Reader (the C# `Manifest.Reader`) ────────────────────────────────────────

lexer.Token t10Current(in T10Reader r) {
    let last = r.tokens.length - 1
    return r.tokens[r.pos < last ? r.pos : last]
}

bool t10AtEnd(in T10Reader r) => t10Current(in r).kind == .endOfFile

TextSpan t10SpanOf(lexer.Token t) => TextSpan { start: t.start, length: t.length }

string t10TextOf(in T10Reader r, for lexer.Token t) {
    var sb = StrBuf()
    appendUtf8(r.bytes.span[t.start..t.end], to: ref sb)
    return $"{sb.finish()}"
}

/// `Reader.Fail`: BYN3100 at the current token, unless an error is already reported.
void t10Fail(in T10Reader r, for string expected, to ref List<Diag> diags) {
    for d in diags {
        unless d.isWarning {
            return
        }
    }
    diags.append(Diag {
        code: codeText(.manifestNotData),
        span: t10SpanOf(t10Current(in r)),
        message: format(messageFormat(.manifestNotData), by: t10Args(expected, by: "")),
        help: "write strings, integers, `true`/`false`, `.names`, `[lists]` or `Type { field: value }`; no calls or expressions",
        hasFix: false,
        fixSpan: TextSpan { start: 0, length: 0 },
        fixReplacement: "",
        related: List<Related>(),
    })
}

bool t10Accept(ref T10Reader r, for lexer.TokenKind kind) {
    return false if t10Current(in r).kind != kind
    r.pos += 1
    return true
}

/// Field and enum names may be keywords (`test`, `async`).
bool t10IsName(lexer.TokenKind kind) => kind == .identifier || lexer.isKeyword(kind)

bool t10AcceptName(ref T10Reader r) {
    unless t10IsName(t10Current(in r).kind) {
        return false
    }
    r.pos += 1
    return true
}

i64 t10Add(ref T10Reader r, by move T10Value v) {
    r.values.append(move v)
    return r.values.length - 1
}

/// `Reader.ReadValue`: the index of the value read, or -1 (C#'s `null`) after a failure.
i64 t10ReadValue(ref T10Reader r, to ref List<Diag> diags) {
    let t = t10Current(in r)
    if t.kind == .stringLiteral {
        let text = $"{t10DecodeString(r.bytes.span[t.start..t.end])}"
        r.pos += 1
        let val = T10Value { kind: .stringValue, span: t10SpanOf(t), text: text }
        return t10Add(ref r, by: move val)
    }
    if t.kind == .integerLiteral {
        if (t10ParseLong(r.bytes.span[t.start..t.end]) is { } n) {
            r.pos += 1
            let val = T10Value { kind: .intValue, span: t10SpanOf(t), number: n }
            return t10Add(ref r, by: move val)
        }
    }
    if t.kind is .trueKeyword or .falseKeyword {
        r.pos += 1
        let val = T10Value { kind: .boolValue, span: t10SpanOf(t), number: t.kind == .trueKeyword ? 1 : 0 }
        return t10Add(ref r, by: move val)
    }
    if t.kind == .dot && t10IsName(r.tokens[r.pos + 1].kind) {
        let name = r.tokens[r.pos + 1]
        r.pos += 2
        let text = $"{t10TextOf(in r, for: name)}"
        let val = T10Value { kind: .enumValue, span: TextSpan.fromBounds(t.start, until: name.end), text: text }
        return t10Add(ref r, by: move val)
    }
    if t.kind == .openBracket {
        r.pos += 1
        var items = List<i64>()
        var keys = List<i64>()
        // The first entry decides: `[a, b]` is a list, `[a: x, b: y]` a map (-1 undecided, 0 list, 1 map).
        var isMap: i64 = -1
        while !t10Accept(ref r, for: .closeBracket) {
            let item = t10ReadValue(ref r, to: ref diags)
            return -1 if item < 0
            if isMap < 0 {
                isMap = t10Current(in r).kind == .colon ? 1 : 0
            }
            if isMap == 1 {
                unless t10Accept(ref r, for: .colon) {
                    t10Fail(in r, for: "`:` and a value", to: ref diags)
                    return -1
                }
                let value = t10ReadValue(ref r, to: ref diags)
                return -1 if value < 0
                keys.append(item)
                items.append(value)
            } else {
                items.append(item)
            }
            if !t10Accept(ref r, for: .comma) && t10Current(in r).kind != .closeBracket {
                t10Fail(in r, for: "`,` or `]`", to: ref diags)
                return -1
            }
        }
        let span = TextSpan.fromBounds(t.start, until: r.tokens[r.pos - 1].end)
        return t10Add(
            ref r,
            by: T10Value { kind: .mapValue, span: span, items: move items, keys: move keys },
        ) if isMap == 1
        return t10Add(ref r, by: T10Value { kind: .listValue, span: span, items: move items })
    }
    if t.kind == .identifier && r.tokens[r.pos + 1].kind == .openBrace {
        r.pos += 2
        var fields = List<T10Field>()
        while !t10Accept(ref r, for: .closeBrace) {
            let name = t10Current(in r)
            var ok = t10AcceptName(ref r)
            if ok && !t10Accept(ref r, for: .colon) {
                ok = t10Current(in r).kind == .equals
            }
            unless ok {
                t10Fail(in r, for: "`field: value` or `}`", to: ref diags)
                return -1
            }
            if t10Current(in r).kind == .equals {
                let eq = t10Current(in r)
                let afterColon = r.tokens[r.pos - 1].kind == .colon
                diags.append(Diag {
                    code: codeText(.manifestEquals),
                    span: t10SpanOf(eq),
                    message: format(messageFormat(.manifestEquals), by: t10Args("", by: "")),
                    label: "the input form",
                    help: afterColon ? "remove the `=`" : "write `:` after the field name",
                    hasFix: true,
                    fixSpan: TextSpan.fromBounds(name.end, until: eq.end),
                    fixReplacement: ":",
                    related: List<Related>(),
                })
                r.pos += 1
            }
            let value = t10ReadValue(ref r, to: ref diags)
            return -1 if value < 0
            let fieldName = $"{t10TextOf(in r, for: name)}"
            fields.append(T10Field { name: fieldName, nameSpan: t10SpanOf(name), value: value })
            if !t10Accept(ref r, for: .comma) && t10Current(in r).kind != .closeBrace {
                t10Fail(in r, for: "`,` or `}`", to: ref diags)
                return -1
            }
        }
        let span = TextSpan.fromBounds(t.start, until: r.tokens[r.pos - 1].end)
        let type = $"{t10TextOf(in r, for: t)}"
        let val = T10Value { kind: .objectValue, span: span, text: type, fields: move fields }
        return t10Add(ref r, by: move val)
    }
    t10Fail(in r, for: "a string, an integer, `true`, `false`, `.name`, `[…]` or `Type { … }`", to: ref diags)
    return -1
}

/// `long.TryParse(text.Replace("_", ""), NumberStyles.None)`: decimal digits only, at least one, in `i64`.
i64? t10ParseLong(ReadOnlySpan<u8> text) {
    var value: i64 = 0
    var digits: i64 = 0
    for b in text {
        continue if b == 0x5F
        unless t10IsAsciiDigit(b) {
            return null
        }
        let d = i64(b - 0x30)
        return null if value > (9223372036854775807 - d) / 10
        value = value * 10 + d
        digits += 1
    }
    return null if digits == 0
    return value
}

/// `LiteralDecoder.DecodeString` over the token's bytes: the text between the quotes with `\n \r \t \0
/// \\ \" \'` and `\u{…}` unescaped; any other `\` stays as written. Escapes are ASCII, so bytes stand for
/// C#'s chars (Q567).
string t10DecodeString(ReadOnlySpan<u8> token) {
    let start = t10IndexOf(token, for: 0x22) + 1
    let end = token.length > start && token[token.length - 1] == 0x22 ? token.length - 1 : token.length
    var buf = List<u8>()
    var i = start
    while i < end {
        let c = token[i]
        if c != 0x5C || i + 1 >= end {
            buf.append(c)
            i += 1
            continue
        }
        let next = token[i + 1]
        var escaped: i64 = -1
        switch next {
            case 0x6E: escaped = 0x0A
            case 0x72: escaped = 0x0D
            case 0x74: escaped = 0x09
            case 0x30: escaped = 0
            case 0x5C: escaped = 0x5C
            case 0x22: escaped = 0x22
            case 0x27: escaped = 0x27
            default: escaped = -1
        }
        if escaped >= 0 {
            buf.append(u8(escaped))
            i += 2
            continue
        }
        if next == 0x75 && i + 2 < end && token[i + 2] == 0x7B {
            let close = t10IndexOf(token[i + 3..end], for: 0x7D)
            let scalar = close > 0 ? t10ParseScalar(token[i + 3..i + 3 + close]) : -1
            if scalar >= 0 {
                t10AppendScalar(ref buf, by: scalar)
                i += 4 + close
                continue
            }
        }
        buf.append(c)
        i += 1
    }
    var sb = StrBuf()
    appendUtf8(buf.span, to: ref sb)
    return $"{sb.finish()}"
}

/// `int.TryParse(hex, AllowHexSpecifier)` then `Rune.IsValid`: hex digits only, at most 8 after leading
/// zeros (a ninth overflows `int`; 8 digits above `0x7FFFFFFF` wrap negative), not a surrogate. -1 if not.
i64 t10ParseScalar(ReadOnlySpan<u8> hex) {
    var value: i64 = 0
    var significant: i64 = 0
    for c in hex {
        var digit: i64 = -1
        if t10IsAsciiDigit(c) {
            digit = i64(c - 0x30)
        } else if c is 0x61..=0x66 {
            digit = i64(c - 0x61) + 10
        } else if c is 0x41..=0x46 {
            digit = i64(c - 0x41) + 10
        }
        return -1 if digit < 0
        if significant > 0 || digit > 0 {
            significant += 1
        }
        return -1 if significant > 8
        value = value * 16 + digit
    }
    return -1 if value is > 0x10FFFF or 0xD800..=0xDFFF
    return value
}

/// Appends the UTF-8 encoding of a valid scalar value.
void t10AppendScalar(ref List<u8> buf, by i64 v) {
    if v < 0x80 {
        buf.append(u8(v))
    } else if v < 0x800 {
        buf.append(u8(0xC0 | (v >> 6)))
        buf.append(u8(0x80 | (v & 0x3F)))
    } else if v < 0x10000 {
        buf.append(u8(0xE0 | (v >> 12)))
        buf.append(u8(0x80 | ((v >> 6) & 0x3F)))
        buf.append(u8(0x80 | (v & 0x3F)))
    } else {
        buf.append(u8(0xF0 | (v >> 18)))
        buf.append(u8(0x80 | ((v >> 12) & 0x3F)))
        buf.append(u8(0x80 | ((v >> 6) & 0x3F)))
        buf.append(u8(0x80 | (v & 0x3F)))
    }
}
== semantics/naming.byn
// T7: Naming.cs, Lexicon.cs and Particles.cs.
//
// Casing rules (spec §5.1): types are `PascalCase`, everything else `camelCase`, acronyms longer than
// two letters are written as words (`HttpClient`, `IO`). Also the grammar checker (BYN5xxx). Casing is
// ASCII only (Q550): C#'s `char.IsUpper`/`ToUpperInvariant` are Unicode, Bayan has no case table, so
// letters outside ASCII count as uncased and stay with the word they follow.

import lexer
import parser

// ── Lexicon.cs ───────────────────────────────────────────────────────────────

/// Fills `c.lexiconVerbs`/`lexiconNouns`/`lexiconAdjectives`/`lexiconCollectives`/`lexiconIrregularPlurals`/`lexiconIrregularSingulars` with the built-in word list
/// (docs/bayan-grammar.md §7, §13); a second call does nothing. Inflected forms are derived, not listed.
void buildLexicon(ref Ctx c) {
    return if c.lexiconVerbs.length > 0
    c.lexiconVerbs = [
        "accept", "access", "acquire", "add", "adjust", "advance", "align", "allocate", "allow", "annotate",
        "append", "apply", "approve", "archive", "ask", "assert", "assign", "attach", "authenticate", "authorize",
        "await", "begin", "bind", "block", "borrow", "break", "bring", "buffer", "build", "bump",
        "buy", "cache", "calculate", "call", "cancel", "capture", "cast", "change", "charge", "check",
        "choose", "claim", "clamp", "classify", "clean", "clear", "clip", "clone", "close", "collect",
        "combine", "come", "comment", "commit", "compare", "compile", "complete", "compose", "compress", "compute",
        "concat", "configure", "confirm", "connect", "consume", "contain", "convert", "copy", "correct", "count",
        "create", "credit", "cut", "debit", "decide", "declare", "decode", "decompress", "decrement", "decrypt",
        "deduct", "define", "delete", "deliver", "deposit", "dequeue", "derive", "describe", "destroy", "detach",
        "detect", "determine", "disable", "discard", "dispatch", "display", "dispose", "divide", "do", "double",
        "drain", "draw", "drop", "dump", "echo", "edit", "emit", "empty", "enable", "encode",
        "encrypt", "end", "enqueue", "ensure", "enter", "equal", "erase", "escape", "evaluate", "exclude",
        "execute", "exit", "expand", "expect", "explain", "export", "extend", "extract", "fail", "fetch",
        "fill", "filter", "find", "finish", "fix", "flag", "flatten", "flip", "flush", "fold",
        "follow", "force", "format", "free", "freeze", "fulfil", "fulfill", "gather", "generate", "get",
        "give", "go", "grant", "group", "grow", "guard", "hand", "handle", "hash", "hide",
        "hold", "ignore", "import", "include", "increment", "indent", "index", "init", "initialize", "insert",
        "inspect", "install", "interpolate", "invert", "invoke", "issue", "join", "jump", "keep", "kill",
