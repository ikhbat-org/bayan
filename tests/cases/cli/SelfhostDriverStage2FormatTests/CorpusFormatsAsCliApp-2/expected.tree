    effectBoundExceeded
    contextBlockInput
    unknownHandler
    wrongState
    payloadNotInState
    becomeUndeclared
    becomeOtherState
    becomesCallUndeclared
    stateSwitchNotExhaustive
    stateLiteralNeedsState
    singleStateInline
    unknownState
    stateShadowsStatic
    missingBecome
    becomesNeedsRef
    becomesOnRefParameter
    assignmentChangesState
    missingBecause
    expectsReadsUntrusted
}

