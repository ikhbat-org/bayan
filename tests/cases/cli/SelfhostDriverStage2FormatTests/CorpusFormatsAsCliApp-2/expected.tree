// T6: CEmitter.cs 61-178 (`Emit`, `Run`, symbol table), 288-396 (`EmitMain`, names, `FilePath`).
// Header only (T1): the entry point with its final signature. `Run()`'s section order is one function here.

import semantics
import emitter.ltree

/// CEmitter.cs:61 `Emit`: the C translation unit for `program`. The lowered nodes are in `t`.
public string emit(ref Ctx c, from in ltree.LTree t, through in ltree.LoweredProgram program, by bool ownershipChecks)
        uses alloc {
    var cc = CCtx { ownershipChecks: ownershipChecks, packageRoot: c.packageRoot }
    for i in 0..program.testFunctions.length {
        cc.testIndex[program.testFunctions[i].symbol] = i
    }
    return t6Run(ref cc, from: ref c, through: in t, for: in program)
}

/// CEmitter.cs:63 `Run`: the sections of the translation unit, in order.
public string t6Run(ref CCtx cc, from ref Ctx c, through in ltree.LTree t, for in ltree.LoweredProgram program)
        uses alloc {
    var bodies = StrBuf()
    var protos = StrBuf()
    for f in program.functions {
        t6EmitFunction(ref cc, from: ref c, through: in t, for: in f, to: ref protos, by: ref bodies)
    }
    for f in program.testFunctions {
        t6EmitFunction(ref cc, from: ref c, through: in t, for: in f, to: ref protos, by: ref bodies)
    }
    let main = t6EmitMain(ref cc, from: ref c, through: in program)

    var errors = StrBuf()
    let variants = c.errorVariants.length
    errors.append("static const byn_str byn_errors[] = {\n")
    if variants == 0 {
        errors.append("    BYN_STR(\"\", 0),\n")
    }
    for v in 0..variants {
        errors.append($"    {stringLiteral(semantics.errorVariantSummary(ref c, by: v))},\n")
    }
    errors.append("};\n\n")
    errors.append("static __attribute__((unused)) void byn_w_error(byn_writer* w, uint32_t code) {\n")
    errors.append($"    if (code == 0 || code > {variants}) byn_w_str(w, BYN_STR(\"no error\", 8));\n")
    errors.append("    else byn_w_str(w, byn_errors[code - 1]);\n}\n\n")
    errors.append("static const uint8_t byn_exit_codes[] = {")
    if variants == 0 {
        errors.append("1")
    } else {
        for v in 0..variants {
            if v > 0 {
                errors.append(", ")
            }
            errors.append($"{c.errorVariants[v].exitCode}")
        }
    }
    errors.append("};\n\n")

    var statics = StrBuf()
    for name in cc.staticOrder {
        statics.append(cc.statics[name])
    }
    let symbolIndex = t6SymbolTable(ref cc, to: ref statics)
    let types = emitTypes(ref cc, from: ref c)
    var enums = StrBuf()
    for j in 0..c.moduleOrder.length {
        let m = c.moduleOrder[j]
        for k in 0..c.modules[m].enums.length {
            enums.append(
                $"typedef int32_t {cType(ref cc, from: ref c, for: semantics.enumTypeOf(c.modules[m].enums[k]))};\n",
            )
        }
    }
    let enumText = enums.finish()
    var sb = StrBuf()
    sb.append("/* Generated by the Bayan compiler. Do not edit. */\n")
    // The checker's runtime declarations, also when this file is compiled by hand without -DBYN_DEBUG.
    if cc.ownershipChecks {
        sb.append("#ifndef BYN_DEBUG\n#define BYN_DEBUG\n#endif\n")
    }
    sb.append("#include \"bayan-rt.h\"\n#include <math.h>\n#include <stdlib.h>\n\n")
    for (path, name) in cc.files {
        sb.append($"static const char {name}[] = {cString(path)};\n")
    }
    sb.append("\n")
    sb.append(enumText)
    if enumText.length > 0 {
        sb.append("\n")
    }
    sb.append(types)
    sb.append(statics.finish())
    sb.append(errors.finish())
    if program.mutants {
        sb.append(t10MutantSelector)
    }
    if program.covering {
        sb.append(t10CoverageCounters(program.coverage.count))
    }
    sb.append(protos.finish())
    sb.append("\n")
    for h in cc.helperOrder {
        sb.append($"{cc.helpers[h].proto};\n")
    }
    sb.append("\n")
    for v in cc.vtableOrder {
        sb.append(cc.vtables[v])
    }
    if cc.vtableOrder.length > 0 {
        sb.append("\n")
    }
    for h in cc.helperOrder {
        sb.append($"{cc.helpers[h].body}\n")
    }
    sb.append(bodies.finish())
    sb.append(main)
    var text = $"{sb.finish()}"
    // A literal's index is known once every literal is seen; the marks cannot clash, as `Escape` writes control bytes as octal.
    if cc.symbols {
        text = t6SymbolIndexes(text, by: in symbolIndex)
    }
    return t6ResolveResets(text)
}

/// CEmitter.cs:69-73: `new FunctionEmitter(this, f)`, its signature as a prototype and its body.
void t6EmitFunction(
    ref CCtx cc,
    from ref Ctx c,
    through in ltree.LTree t,
    for in ltree.LoweredFunction f,
    to ref StrBuf protos,
    by ref StrBuf bodies
) uses alloc {
    protos.append(signature(ref cc, from: ref c, through: in t, for: in f))
    protos.append(";\n")
    bodies.append(emitFunction(ref cc, from: ref c, through: in t, for: in f))
    bodies.append("\n")
}

/// CEmitter.cs:123 `SymbolTable`: appends `byn_symtab`, the distinct literal texts sorted by UTF-8 bytes with `""` first (R2),
/// and returns each literal's index by first-seen number.
List<i64> t6SymbolTable(ref CCtx cc, to ref StrBuf sb) uses alloc {
    var indexes = List<i64>()
    return indexes if !cc.symbols
    var sorted = List<string>()
    var seen = Map<string, bool>()
    for text in cc.symbolTexts {
        if !seen.contains(text) {
            seen[text] = true
            sorted.append(text)
        }
    }
    if !seen.contains("") {
        sorted.append("")
    }
    sorted.sort()
    sb.append("static const byn_str byn_symtab[] = {\n")
    for text in sorted {
        sb.append($"    {stringLiteral(text)},\n")
    }
    sb.append("};\n\n")
    var position = Map<string, i64>()
    for i in 0..sorted.length {
        position[sorted[i]] = i
    }
    for text in cc.symbolTexts {
        indexes.append(position[text])
    }
    return indexes
}

/// CEmitter.cs:118 `Regex.Replace(text, "\u0001(\\d+)\u0001", m => symbolIndex[int.Parse(m)])`.
string t6SymbolIndexes(string text, by in List<i64> symbolIndex) uses alloc {
    var sb = StrBuf()
    let bytes = text.bytes
    var start = 0
    var i = 0
    while i < bytes.length {
        if i64(bytes[i]) == 1 {
            var j = i + 1
            var n = 0
            while j < bytes.length && i64(bytes[j]) >= 48 && i64(bytes[j]) <= 57 {
                n = n * 10 + i64(bytes[j]) - 48
                j += 1
            }
            // coverage-exempt: Q787
            if j > i + 1 && j < bytes.length && i64(bytes[j]) == 1 {
                sb.append(text[start..i])
                sb.append($"{symbolIndex[n]}")
                start = j + 1
                i = j + 1
                continue
            }
        }
        i += 1
    }
    sb.append(text[start..bytes.length])
    return $"{sb.finish()}"
}

/// CEmitter.cs:170 `ResolveResets`: turns each `#line generated` into `#line N "main.c"` naming the line after it, so
/// debuggers step over generated code.
string t6ResolveResets(string text) uses alloc {
    return text if !text.contains("#line generated")
    var sb = StrBuf()
    var start = 0
    var n = 0
    for p in 0..text.bytes.length + 1 {
        if p == text.bytes.length || i64(text.bytes[p]) == 10 {
            if n > 0 {
                sb.append("\n")
            }
            let line = text[start..p]
            if line == "#line generated" {
                sb.append($"#line {n + 2} {cString("main.c")}")
            } else {
                sb.append(line)
            }
            n += 1
            start = p + 1
        }
    }
    return $"{sb.finish()}"
}

/// CEmitter.cs:288 `EmitMain`.
public string t6EmitMain(ref CCtx cc, from ref Ctx c, through in ltree.LoweredProgram program) uses alloc {
    var sb = StrBuf()
    sb.append($"int main(int argc, char** argv) {{\n    {errorCType(ref cc, from: ref c)} err = {{0}};\n")
    if program.mutants {
        sb.append("    byn_mutant_read();\n")
    }
    if program.covering {
        if program.tests.length > 0 {
            sb.append("    byn_cov_start(argc == 3 && strcmp(argv[1], \"--test\") == 0 ? argv[2] : NULL);\n")
        } else {
            sb.append("    byn_cov_start(NULL);\n")
        }
    }
    // Map and symbol hashing is seeded per run; tests get a fixed seed so they are reproducible.
    if cc.hashes || cc.symbols {
        if program.tests.length > 0 {
            sb.append("    byn_hash_seed_init(argc == 3 && strcmp(argv[1], \"--test\") == 0);\n")
        } else {
            sb.append("    byn_hash_seed_init(false);\n")
        }
    }
    // The literal table first and in order, so literal N is ID N and `Symbol.intern` of its text finds it.
    if cc.symbols {
        sb.append("    byn_sym_init(byn_symtab, (uint32_t)(sizeof byn_symtab / sizeof byn_symtab[0]));\n")
    }
    if program.tests.length > 0 {
        sb.append("    if (argc == 3 && strcmp(argv[1], \"--test\") == 0) {\n        switch (atoi(argv[2])) {\n")
        for i in 0..program.tests.length {
            let fn = program.testFunctions[i].symbol
            // coverage-exempt: Q787
            sb.append(
                $"        case {i}: {c.functions[fn].hasFails ? "err = " : ""}{functionName(ref cc, from: ref c, for: fn)}(); break;\n",
            )
        }
        sb.append("        default: return 2;\n        }\n")
        sb.append("        if (err.code != 0) { byn_report_error(byn_errors[err.code - 1]); return 1; }\n")
        sb.append("        byn_stdout_flush();\n        return 0;\n    }\n")
    } else {
        sb.append("    (void)argv;\n")
    }
    var exit = "0"
    if program.main != -1 {
        let main = program.main
        // Arguments are checked for UTF-8 before `main` runs, whether or not it takes them.
        sb.append("    byn_str* byn_argv = byn_args(&argc, argv);\n")
        var args = List<string>()
        if c.functions[main].parameters.length == 1 {
            let parameterType = c.locals[c.functions[main].parameters[0]].type
            args.append($"({cType(ref cc, from: ref c, for: parameterType)}){{byn_argv, argc > 1 ? argc - 1 : 0}}")
        } else {
            sb.append("    (void)byn_argv;\n")
        }
        let returnsCode = c.functions[main].returnType == semantics.prim(.i32)
        if returnsCode {
            sb.append("    int32_t code = 0;\n")
            exit = "code"
        }
        if c.functions[main].hasFails && returnsCode {
            args.append("&code")
        }
        var joined = StrBuf()
        for i in 0..args.length {
            if i > 0 {
                joined.append(", ")
            }
            joined.append(args[i])
        }
        let call = $"{functionName(ref cc, from: ref c, for: main)}({joined.finish()})"
        sb.append($"    {c.functions[main].hasFails ? "err = " : returnsCode ? "code = " : ""}{call};\n")
    } else {
        sb.append("    (void)argc;\n")
    }
    sb.append(
        "    if (err.code != 0) { byn_report_error(byn_errors[err.code - 1]); return byn_exit_codes[err.code - 1]; }\n",
    )
    sb.append($"    byn_stdout_flush();\n    return {exit};\n}}\n")
    return $"{sb.finish()}"
}

/// CEmitter.cs:137 `SymbolLiteral` (Q845): the C value of symbol literal `text`, numbering the text on first sight.
public string symbolLiteral(ref CCtx cc, for string text) uses alloc {
    cc.symbols = true
    if !cc.symbolIds.contains(text) {
        cc.symbolIds[text] = cc.symbolTexts.length
        cc.symbolTexts.append(text)
    }
    let k = cc.symbolIds[text]
    return $"((byn_sym){{{rune(symbolMark)}{k}{rune(symbolMark)}}})"
}

/// CEmitter.cs:150 `SymbolText` (Q845): the C expression for the interned text of the symbol `s` (C text).
public string symbolText(ref CCtx cc, for string s) uses alloc {
    cc.symbols = true
    return $"byn_sym_text({s})"
}

/// CEmitter.cs:157 `SymbolIntern` (Q845): the C expression for `Symbol.intern` of `text` (C text).
public string symbolIntern(ref CCtx cc, for string text) uses alloc {
    cc.symbols = true
    return $"byn_sym_intern({text})"
}

/// CEmitter.cs:348 `FunctionName` (Q845): the C name of function `fn`.
public string functionName(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn) uses alloc {
    let kind = c.functions[fn].kind
    return $"byn_test_{cc.testIndex[fn]}" if kind == .testKeyword
    let module = c.modules[c.functions[fn].module].cName
    return $"byn_{module}__main" if kind == .main
    let name = c.functions[fn].name
    // `f$lambda2` in an instance of `f` is named after that instance, so each instantiation has its own.
    if kind == .lambda {
        let at = name.lastPosition("$lambda") ?? -1
        return $"{functionName(ref cc, from: ref c, for: c.functions[fn].enclosing)}__lambda{name[at + 7..name.length]}"
    }
    let owner = c.functions[fn].owner
    if owner != -1 {
        var member = ""
        switch kind {
            case .constructor: member = $"init{t6IndexOf(in c.structs[owner].constructors, for: fn)}"
            case .getter: member = $"get_{name}"
            default: member = $"{name}{t6Overload(in semantics.findMethods(ref c, by: owner, for: name), for: fn)}"
        }
        let typeArgs = t2Copy(in c.structs[owner].typeArgs)
        return $"byn_{module}__{c.structs[owner].name}{t2TypeArgs(ref c, for: in typeArgs)}__{member}"
    }
    let template = c.functions[fn].template
    var overloads = List<semantics.FuncId>()
    if c.modules[c.functions[fn].module].functions.contains(name) {
        for o in c.modules[c.functions[fn].module].functions[name] {
            overloads.append(o)
        }
    }
    let fnArgs = t2Copy(in c.functions[fn].typeArgs)
    return $"byn_{module}__{name}{t6Overload(in overloads, for: template == -1 ? fn : template)}{t2TypeArgs(ref c, for: in fnArgs)}"
}

/// `List.IndexOf`: the position of `f` in `fns`, -1 when it is not there.
i64 t6IndexOf(in List<semantics.FuncId> fns, for semantics.FuncId f) {
    for i in 0..fns.length {
        return i if fns[i] == f
    }
    return -1
}

/// CEmitter.cs:369 `Overload`: the `__o1` that tells a second overload from the first (J65); empty for the first.
string t6Overload(in List<semantics.FuncId> overloads, for semantics.FuncId f) uses alloc {
    let i = t6IndexOf(in overloads, for: f)
    return i > 0 ? $"__o{i}" : ""
}

/// CEmitter.cs:374 `FieldName` (Q845): `name` as a C member name, avoiding C keywords.
public string fieldName(string name) uses alloc {
    for w in cKeywords() {
        return $"{name}_" if w == name
    }
    return name
}

/// CEmitter.cs:376 `FileName` (Q845): the C name of the static that holds `fn`'s file path, registering it.
public string fileName(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn) uses alloc {
    let relative = filePath(ref cc, from: ref c, for: fn)
    if !cc.files.contains(relative) {
        let name = $"byn_file_{cc.files.length}"
        cc.files[relative] = name
    }
    return cc.files[relative]
}

/// CEmitter.cs:388 `FilePath` (Q845): the path panics and `#line` name `fn`'s file by.
public string filePath(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn) uses alloc {
    let file = c.functions[fn].file
    let path = file == -1 ? "" : c.files[file].path
    // Project files are already relative to the project root; a loose file is named from its directory.
    var relative = path.replaced("\\", by: "/")
    if Path.isRooted(path) {
        relative = Path.relative(cc.packageRoot, to: path).replaced("\\", by: "/")
    }
    if relative.startsWith("..") {
        relative = Path.fileName(path)
    }
    return relative
}

/// CEmitter.cs:184 `MutantSelector`: a `--mutate` build's selector, `BAYAN_MUTANT`, and its reach log, `BAYAN_SITE_REACH`.
const t10MutantSelector: string = """
    #include <stdio.h>

    static int64_t byn_mutant;
    static const char* byn_reach_path;
    static uint8_t* byn_reach_bits;
    static int64_t byn_reach_cap;

    static void byn_reach_write(void) {
        FILE* f = fopen(byn_reach_path, "w");
        if (f == NULL) return;
        for (int64_t i = 0; i < byn_reach_cap; i++)
            if (byn_reach_bits[i]) fprintf(f, "%lld\n", (long long)i);
        fclose(f);
    }

    static bool byn_mutant_is(int64_t id) {
        if (byn_reach_path != NULL && id >= 0 && id < INT32_MAX) {
            if (id >= byn_reach_cap) {
                int64_t cap = id + 64;
                uint8_t* bits = (uint8_t*)realloc(byn_reach_bits, (size_t)cap);
                if (bits == NULL) abort();
                memset(bits + byn_reach_cap, 0, (size_t)(cap - byn_reach_cap));
                byn_reach_bits = bits;
                byn_reach_cap = cap;
            }
            byn_reach_bits[id] = 1;
        }
        return byn_mutant == id;
    }

    static void byn_mutant_read(void) {
        const char* r = getenv("BAYAN_SITE_REACH");
        if (r != NULL && *r != 0) {
            byn_reach_path = r;
            atexit(byn_reach_write);
        }
        const char* s = getenv("BAYAN_MUTANT");
        int64_t n = 0;
        if (s == NULL || *s == 0) return;
        for (; *s != 0; s++) {
            if (*s < '0' || *s > '9' || n > (INT64_MAX - 9) / 10) return;
            n = n * 10 + (*s - '0');
        }
        byn_mutant = n;
    }


    """

/// CEmitter.cs:240 `CoverageCounters`: a `--coverage` build's `count` counters (at least one) and their writer.
string t10CoverageCounters(i64 count) uses alloc {
    return $"{t10CoverageHead}static uint64_t byn_cov[{count > 1 ? count : 1}];\n{t10CoverageTail}"
}

const t10CoverageHead: string = """
    #include <stdio.h>
    #ifdef _WIN32
    #include <process.h>
    #define byn_cov_pid() ((unsigned long long)_getpid())
    #elif defined(__wasi__)
    #define byn_cov_pid() 0ULL
    #else
    #include <unistd.h>
    #define byn_cov_pid() ((unsigned long long)getpid())
    #endif


    """

const t10CoverageTail: string = """
    static char* byn_cov_path;

    static void byn_cov_write(void) {
        char* path = byn_cov_path;
        byn_cov_path = NULL;
        if (path == NULL) return;
        FILE* f = fopen(path, "w");
        free(path);
        if (f == NULL) return;
        fputs("bayan-coverage 1\n", f);
        for (size_t i = 0; i < sizeof byn_cov / sizeof byn_cov[0]; i++)
            if (byn_cov[i] != 0) fprintf(f, "%llu %llu\n", (unsigned long long)i, (unsigned long long)byn_cov[i]);
        fclose(f);
    }

    /* The file is `<BAYAN_COVERAGE>.<test index>` under `--test`, else `<BAYAN_COVERAGE>.<pid>`. */
    static void byn_cov_start(const char* test) {
        const char* prefix = getenv("BAYAN_COVERAGE");
        if (prefix == NULL || *prefix == 0) return;
        size_t n = strlen(prefix) + (test != NULL ? strlen(test) : 20) + 2;
        byn_cov_path = malloc(n);
        if (byn_cov_path == NULL) return;
        if (test != NULL) snprintf(byn_cov_path, n, "%s.%s", prefix, test);
        else snprintf(byn_cov_path, n, "%s.%llu", prefix, byn_cov_pid());
        byn_cov_flush = byn_cov_write;
        atexit(byn_cov_write);
    }


    """
== emitter/cprint/types.byn
// T7: CEmitter.cs 477-587 (`EmitTypes`), 600-681 (`SlotSignature`, `FunctionSignature`, `FunctionThunk`, `Vtable`).

import semantics

/// CEmitter.cs:477 `EmitTypes`: forward typedefs for every named type, then the definitions with by-value members first.
public string emitTypes(ref CCtx cc, from ref Ctx c) uses alloc {
    var defs = StrBuf()
    var done = Map<string, bool>()
    // Defining a type can name new ones (an element type), so iterate to a fixed point.
    var i = 0
    while i < cc.typeOrder.length {
        let name = cc.typeOrder[i]
        t7Define(ref cc, from: ref c, through: ref defs, to: ref done, for: name)
        i += 1
    }
    var sb = StrBuf()
    for name in cc.typeOrder {
        sb.append($"typedef struct {name} {name};\n")
    }
    sb.append("\n")
    sb.append(defs.finish())
    return $"{sb.finish()}"
}

/// CEmitter.cs:481 `Define`: appends the definition of named type `name` to `defs`, after those of the types it holds by value.
void t7Define(ref CCtx cc, from ref Ctx c, through ref StrBuf defs, to ref Map<string, bool> done, for string name)
        uses alloc {
    return if done.contains(name)
    done[name] = true
    let t = cc.types[name]
    let i = i64(t & 0xFFFFFFFF)
    var memberTypes = List<Type>()
    var decls = List<string>()
    var payloads = List<Type>()
    switch semantics.kindOf(t) {
        case .structType:
            var fields = List<semantics.FieldId>()
            for f in c.structs[i].fields {
                fields.append(f)
            }
            for f in fields {
                let ft = c.fields[f].type
                memberTypes.append(ft)
                decls.append($"{cType(ref cc, from: ref c, for: ft)} {fieldName(c.fields[f].name)}")
            }
            if c.states.contains(i) {
                // After the fields, the state's tag and its payload, laid out like a union (spec §3.17).
                memberTypes.append(semantics.prim(.u8))
                decls.append("uint8_t tag")
                var held = List<semantics.VariantId>()
                for v in c.unions[c.states[i]].variants {
                    if c.unionVariants[v].fields.length > 0 {
                        held.append(v)
                    }
                }
                if held.length > 0 {
                    memberTypes.append(semantics.prim(.u8))
                    decls.append(t7VariantUnion(ref cc, from: ref c, for: in held, as: false))
                }
                t7Payloads(ref c, for: in held, to: ref payloads, as: false)
            } else if fields.length == 0 {
                memberTypes.append(semantics.prim(.bool))
                decls.append("char unused")
            }
        case .optional:
            let inner = c.optionalTypes[i]
            memberTypes.append(semantics.prim(.bool))
            decls.append("bool has")
            memberTypes.append(inner)
            decls.append($"{cType(ref cc, from: ref c, for: inner)} value")
        case .errorSet or .errorUnion:
            // The code, then the largest payload: a case with fields has a struct named by its code (SPEC §3.12).
            memberTypes.append(semantics.prim(.u32))
            decls.append("uint32_t code")
            var cases = List<semantics.VariantId>()
            for v in 0..c.errorVariants.length {
                if c.errorVariants[v].fields.length > 0 {
                    cases.append(v)
                }
            }
            // coverage-exempt: Q790
            if cases.length > 0 {
                memberTypes.append(semantics.prim(.u32))
                decls.append(t7VariantUnion(ref cc, from: ref c, for: in cases, as: true))
            }
            t7Payloads(ref c, for: in cases, to: ref payloads, as: true)
        case .result:
            let error = c.resultTypes[i].error
            let value = c.resultTypes[i].value
            memberTypes.append(error)
            decls.append($"{cType(ref cc, from: ref c, for: error)} err")
            memberTypes.append(value)
            decls.append($"{cType(ref cc, from: ref c, for: value)} value")
        case .span:
            memberTypes.append(semantics.prim(.i64))
            decls.append($"{cType(ref cc, from: ref c, for: c.spanTypes[i].element)}* ptr")
            memberTypes.append(semantics.prim(.i64))
            decls.append("int64_t len")
        case .list:
            memberTypes.append(semantics.prim(.i64))
            decls.append($"{cType(ref cc, from: ref c, for: c.listTypes[i])}* ptr")
            memberTypes.append(semantics.prim(.i64))
            decls.append("int64_t len")
            memberTypes.append(semantics.prim(.i64))
            decls.append("int64_t cap")
            memberTypes.append(semantics.prim(.i64))
            decls.append("byn_alloc* alloc")
        case .map:
            memberTypes.append(semantics.prim(.i64))
            decls.append("byn_map_hdr h")
            memberTypes.append(semantics.prim(.i64))
            decls.append($"{cType(ref cc, from: ref c, for: c.mapTypes[i].key)}* keys")
            memberTypes.append(semantics.prim(.i64))
            decls.append($"{cType(ref cc, from: ref c, for: c.mapTypes[i].value)}* vals")
        case .array:
            let element = c.arrayTypes[i].element
            memberTypes.append(element)
            decls.append($"{cType(ref cc, from: ref c, for: element)} v[{c.arrayTypes[i].length}]")
        case .tuple:
            var types = List<Type>()
            for f in c.tupleTypes[i] {
                types.append(f.type)
            }
            for k in 0..types.length {
                memberTypes.append(types[k])
                decls.append($"{cType(ref cc, from: ref c, for: types[k])} item{k + 1}")
            }
        case .dynRef:
            // Slot parameters may be incomplete types, so the table needs no other definition first.
            let iface = c.dynRefTypes[i].iface
            let vt = $"byn_vt_{key(ref c, for: semantics.makeType(.interfaceType, at: iface))}"
            defs.append($"struct {vt} {{\n")
            for m in t7Slots(in c, for: iface) {
                var ignored = List<string>()
                defs.append(
                    $"    {t7SlotSignature(ref cc, from: ref c, for: m, by: $"(*{slotName(ref c, for: m)})", to: ref ignored)};\n",
                )
            }
            defs.append("};\n\n")
            memberTypes.append(semantics.prim(.i64))
            decls.append("void* data")
            memberTypes.append(semantics.prim(.i64))
            decls.append($"const struct {vt}* vt")
        case .function:
            // Q1: round 4 redoes this (CEmitter.cs:557-560).
            // The code and the environment it is called with; parameter and return types need only their typedefs.
            var ignored = List<string>()
            memberTypes.append(semantics.prim(.i64))
            decls.append(t7FunctionSignature(ref cc, from: ref c, for: t, by: "(*fn)", to: ref ignored))
            memberTypes.append(semantics.prim(.i64))
            decls.append("void* env")
        case .unionType:
            // Unit variants have no struct; a union of only unit variants has no `u`.
            memberTypes.append(semantics.prim(.i32))
            decls.append("int32_t tag")
            var variants = List<semantics.VariantId>()
            for v in c.unions[i].variants {
                if c.unionVariants[v].fields.length > 0 {
                    variants.append(v)
                }
            }
            if variants.length > 0 {
                memberTypes.append(semantics.prim(.i32))
                decls.append(t7VariantUnion(ref cc, from: ref c, for: in variants, as: false))
            }
            t7Payloads(ref c, for: in variants, to: ref payloads, as: false)
        // C# has no default: any other named type gets an empty definition.
        default:
    }
    var deps = List<Type>()
    for m in memberTypes {
        deps.append(m)
    }
    for p in payloads {
        deps.append(p)
    }
    for ty in deps {
        if semantics.kindOf(ty) != .primitive {
            let dep = cType(ref cc, from: ref c, for: ty)
            if cc.types.contains(dep) {
                t7Define(ref cc, from: ref c, through: ref defs, to: ref done, for: dep)
            }
        }
    }
    defs.append($"struct {name} {{\n")
    for d in decls {
        defs.append($"    {d};\n")
    }
    defs.append("};\n\n")
}

/// The `union { struct { fields } name; ... } u` member of a state or union (`p` of an error): `errors` for error variants (`e{code}`).
string t7VariantUnion(ref CCtx cc, from ref Ctx c, for in List<semantics.VariantId> variants, as bool errors)
        uses alloc {
    var sb = StrBuf()
    sb.append("union {\n")
    for v in variants {
        var fields = List<semantics.LocalId>()
        var vname = ""
        if errors {
            for f in c.errorVariants[v].fields {
                fields.append(f)
            }
            vname = $"e{c.errorVariants[v].code}"
        } else {
            for f in c.unionVariants[v].fields {
                fields.append(f)
            }
            vname = fieldName(c.unionVariants[v].name)
        }
        sb.append("        struct { ")
        for f in fields {
            sb.append($"{cType(ref cc, from: ref c, for: c.locals[f].type)} {fieldName(c.locals[f].name)}; ")
        }
        sb.append($"}} {vname};\n")
    }
    // The state's and the union's member is `u`, the error's `p`.
    sb.append(errors ? "    } p" : "    } u")
    return $"{sb.finish()}"
}

/// The field types of `variants`, in order, appended to `payloads`.
void t7Payloads(ref Ctx c, for in List<semantics.VariantId> variants, to ref List<Type> payloads, as bool errors)
        uses alloc {
    for v in variants {
        if errors {
            for f in c.errorVariants[v].fields {
                payloads.append(c.locals[f].type)
            }
        } else {
            for f in c.unionVariants[v].fields {
                payloads.append(c.locals[f].type)
            }
        }
    }
}

/// CEmitter.cs:603 `Slots`: the vtable slots of `i`: one per method and getter, defaults included.
List<semantics.FuncId> t7Slots(in Ctx c, for semantics.InterfaceId i) uses alloc {
    var r = List<semantics.FuncId>()
    for m in c.interfaces[i].methods {
        r.append(m)
    }
    for m in c.interfaces[i].properties {
        r.append(m)
    }
    return r
}

/// CEmitter.cs:605 `SlotName`: the vtable slot name of interface method or getter `m`.
public string slotName(ref Ctx c, for semantics.FuncId m) uses alloc {
    return $"get_{c.functions[m].name}" if c.functions[m].kind == .getter
    return fieldName(c.functions[m].name)
}

/// CEmitter.cs:609 `SlotSignature`: a slot's C signature around `declarator`, in `Signature`'s `fails` convention with
/// `void* self` first; `args` are the names of the parameters after `self`.
string t7SlotSignature(
    ref CCtx cc,
    from ref Ctx c,
    for semantics.FuncId m,
    by string declarator,
    to ref List<string> args
) uses alloc {
    let ret = c.functions[m].returnType
    let returnsValue = !semantics.isVoid(ret) && !semantics.isNever(ret)
    var ps = List<string>()
    ps.append("void* self")
    var parameters = List<semantics.LocalId>()
    for p in c.functions[m].parameters {
        parameters.append(p)
    }
    for k in 0..parameters.length {
        args.append($"a{k}")
        let byRef = c.locals[parameters[k]].modifier == .refKeyword || c.locals[parameters[k]].modifier == .outKeyword
        let star = byRef ? "*" : ""
        ps.append($"{cType(ref cc, from: ref c, for: c.locals[parameters[k]].type)}{star} a{k}")
    }
    let failing = c.functions[m].hasFails
    if failing && returnsValue {
        args.append("byn_out")
        ps.append($"{cType(ref cc, from: ref c, for: ret)}* byn_out")
    }
    let head = failing ? errorCType(ref cc, from: ref c) : cType(ref cc, from: ref c, for: ret)
    return $"{head} {declarator}({t7Join(in ps)})"
}

/// CEmitter.cs:629 `FunctionSignature`: a function type's C signature around `declarator`, in `Signature`'s `fails` convention
/// with `void* env` first; `args` are the names of the parameters after `env`.
string t7FunctionSignature(ref CCtx cc, from ref Ctx c, for Type f, by string declarator, to ref List<string> args)
        uses alloc {
    // Q1: round 4 redoes this (CEmitter.cs:629-645).
    let i = i64(f & 0xFFFFFFFF)
    let failing = c.functionTypes[i].errorSets.length > 0
    let ret = c.functionTypes[i].ret
    var ps = List<string>()
    ps.append("void* env")
    var parameters = List<Type>()
    for p in c.functionTypes[i].parameters {
        parameters.append(p)
    }
    for k in 0..parameters.length {
        args.append($"a{k}")
        ps.append($"{cType(ref cc, from: ref c, for: parameters[k])} a{k}")
    }
    if failing && !semantics.isVoid(ret) && !semantics.isNever(ret) {
        args.append("byn_out")
        ps.append($"{cType(ref cc, from: ref c, for: ret)}* byn_out")
    }
    let head = failing ? errorCType(ref cc, from: ref c) : cType(ref cc, from: ref c, for: ret)
    return $"{head} {declarator}({t7Join(in ps)})"
}

/// `string.Join(", ", xs)`.
string t7Join(in List<string> xs) uses alloc {
    var sb = StrBuf()
    for k in 0..xs.length {
        if k > 0 {
            sb.append(", ")
        }
        sb.append(xs[k])
    }
    return $"{sb.finish()}"
}

/// CEmitter.cs:648 `FunctionThunk`: the name of the helper that calls named function `fn` as a value of function type `type`, registering it.
public string functionThunk(ref CCtx cc, from ref Ctx c, for semantics.FuncId fn, as Type type) uses alloc {
    // Q1: round 4 redoes this (CEmitter.cs:646-654).
    let name = $"bynh_fnthunk_{functionName(ref cc, from: ref c, for: fn)}"
    var args = List<string>()
    let proto = $"static {t7FunctionSignature(ref cc, from: ref c, for: type, by: name, to: ref args)}"
    let i = i64(type & 0xFFFFFFFF)
    let ret = c.functionTypes[i].ret
    let returns = c.functionTypes[i].errorSets.length > 0 || (!semantics.isVoid(ret) && !semantics.isNever(ret))
    let returnWord = returns ? "return " : ""
    return helper(
        ref cc,
        for: name,
        from: proto,
        as: $"{{\n    (void)env;\n    {returnWord}{functionName(ref cc, from: ref c, for: fn)}({t7Join(in args)});\n}}\n",
    )
}

/// CEmitter.cs:661 `Vtable`: the name of struct `s`'s vtable for interface `i`, registering it; a thunk per slot casts `self` to the conformer.
public string vtable(ref CCtx cc, from ref Ctx c, for semantics.StructId s, as semantics.InterfaceId i) uses alloc {
    let sType = semantics.makeType(.structType, at: s)
    let iType = semantics.makeType(.interfaceType, at: i)
    let name = $"bynh_vtab_{key(ref c, for: sType)}_{key(ref c, for: iType)}"
    return name if cc.vtables.contains(name)
    var conformance: semantics.ConformanceId = -1
    for k in c.structs[s].conformances {
        if conformance == -1 && c.conformances[k].iface == i {
            conformance = k
        }
    }
    // C# `First` throws when the struct has no conformance to `i`.
    if conformance == -1 {
        panic($"no conformance of {c.structs[s].name} to {c.interfaces[i].name}")
    }
    var thunks = List<string>()
    for m in t7Slots(in c, for: i) {
        let thunk = $"bynh_vt_{key(ref c, for: sType)}_{key(ref c, for: iType)}_{slotName(ref c, for: m)}"
        var args = List<string>()
        let proto = $"static {t7SlotSignature(ref cc, from: ref c, for: m, by: thunk, to: ref args)}"
        var call = ""
        if c.conformances[conformance].fieldWitnesses.contains(m) {
            let field = c.conformances[conformance].fieldWitnesses[m]
            call = $"(({cType(ref cc, from: ref c, for: sType)}*)self)->{fieldName(c.fields[field].name)}"
        } else {
            var all = List<string>()
            all.append($"({cType(ref cc, from: ref c, for: sType)}*)self")
            for a in args {
                all.append(a)
            }
            call = $"{functionName(ref cc, from: ref c, for: c.conformances[conformance].witnesses[m])}({t7Join(in all)})"
        }
        let ret = c.functions[m].returnType
        let returns = c.functions[m].hasFails || (!semantics.isVoid(ret) && !semantics.isNever(ret))
        let returnWord = returns ? "return " : ""
        thunks.append(helper(ref cc, for: thunk, from: proto, as: $"{{\n    {returnWord}{call};\n}}\n"))
    }
    cc.vtables[name] = $"static const struct byn_vt_{key(ref c, for: iType)} {name} = {{ {t7Join(in thunks)} }};\n"
    cc.vtableOrder.append(name)
    return name
}
== emitter/lctx.byn
// T1: Lowerer.cs 37-41 and 48-76 (the lowerer's state: `FunctionLowerer`'s fields, scopes and cleanups); T10: 42-47.
//
// The lowered tree itself (`LKind`, the `L*` records, `LTree`) is the `ltree` module (`emitter/ltree/`), which the
// printer reads too. Each task's `LCtx` fields live in its own `// ── Tn state` section.

import semantics
import emitter.ltree

public type Ctx                = semantics.Ctx
public type TextSpan           = semantics.TextSpan
public type Type               = semantics.Type
public type FuncId             = semantics.FuncId
public type LocalId            = semantics.LocalId
public type VariantId          = semantics.VariantId
public type TestId             = semantics.TestId
public type BExpr              = semantics.BExpr
public type BStmt              = semantics.BStmt
public type BPattern           = semantics.BPattern
public type BInterpolationPart = semantics.BInterpolationPart
public type LNode              = ltree.LNode
public type LTree              = ltree.LTree
public type LoweredFunction    = ltree.LoweredFunction
public type LoweredProgram     = ltree.LoweredProgram

// ── Cleanups (Lowerer.cs:61-76) ──────────────────────────────────────────────

/// `Cleanup`: `DeferCleanup`, `ErrdeferCleanup`, `RestoreContext`, `FreeArena`, `PopPanicHandler`.
public union LCleanup {
    deferCleanup(BStmt body)
    errdeferCleanup(LocalId error, BStmt body)
    restoreContext(TextSpan span, i64 slot)
    freeArena(TextSpan span, LocalId arena)
    popPanicHandler(TextSpan span, i64 slot)
}

/// `Scope`.
public struct LScope {
    public List<LCleanup> cleanups = []
}

/// `_targets` value: the break label, the continue label and the cleanup depth of a jump target.
public struct LTarget {
    public string  breakLabel
    public string? continueLabel = null
    public i64     depth
}

// ── The lowerer's state ──────────────────────────────────────────────────────

/// Everything the lowering reads and writes for one program: the arenas of the lowered kinds, then
/// `FunctionLowerer`'s fields. Each task adds its fields in its own `// ── Tn state` section.
public struct LCtx {
    /// The lowered nodes built so far (arenas, one per `LKind`); the printer reads them.
    public LTree tree = {}

    // ── T1 state: FunctionLowerer (Lowerer.cs:40-41, 48-59)
    /// `_fn`.
    public FuncId              fn           = -1
    /// `_out` and the capture stack (D5): the current output list is the last; `captureBegin` pushes, `captureEnd` pops.
    public List<List<BStmt>>   outs         = []
    /// `_locals`: the locals used, in first-use order.
    public List<LocalId>       locals       = []
    /// `_seen`.
    public Map<LocalId, bool>  seen         = []
    /// `_scopes`.
    public List<LScope>        scopes       = []
    /// `_targets`, keyed by `JumpTarget.id` (D6).
    public Map<i64, LTarget>   targets      = []
    /// `_labels`.
    public i64                 labelCount   = 0
    /// `_contextSlots`.
    public i64                 contextSlots = 0
    /// `_panicSlots`.
    public i64                 panicSlots   = 0
    /// `_shown != null`: while an `assert` condition is lowered.
    public bool                showing      = false
    /// `_shown`: the sub-expressions the assert shows, each with its stored value once lowered (-1 before).
    public Map<BExpr, BExpr>   shown        = []
    /// `_ran`: the shown sub-expressions that may not run (a lazy side), each with the flag set when it does.
    public Map<BExpr, LocalId> ran          = []

    // ── T10 state: FunctionLowerer (Lowerer.cs:42-47). The caller of `lower` sets `mutating`/`mutants` (a `--mutate`
    // build) or `covering`/`coverage` (a `--coverage` build) first, C#'s `mutants`/`coverage` arguments of `Lower`.
    /// `_mutants is not null`.
    public bool                       mutating = false
    /// `_mutants`: the mutant switch of each bound node a mutant replaces.
    public Map<semantics.BNode, BoundMutantSwitch> mutants = []
    /// `_plain`: the nodes whose mutant switch is being lowered.
    public Map<semantics.BNode, bool> plain    = []
    /// `_coverage is not null`.
    public bool                       covering = false
    /// `_coverage`: the probes.
    public CoverageProbes             coverage = {}
    /// `_probing`: the conditions whose branch probe is being lowered.
    public Map<semantics.BNode, bool> probing  = []
}
== emitter/lower.byn
// T2: Lowerer.cs 11-35 (`Lowerer.Lower`), 78-93 (`FunctionLowerer.Lower`), 95-351 (helpers, cleanup).
//
// `FunctionLowerer` is not an object: its fields are `LCtx`'s, reset by `lowerFunction` as `new FunctionLowerer`
// would. A lowered handle has no `Type`/`Syntax` the semantics accessors know, so
// `t2Type`/`t2Span` answer for both trees (Q763).

import semantics
import emitter.ltree

type LFreeArena       = ltree.LFreeArena
type LPopPanicHandler = ltree.LPopPanicHandler
type LReturn          = ltree.LReturn
type LSetContext      = ltree.LSetContext
type LUnionField      = ltree.LUnionField
type LUnionTag        = ltree.LUnionTag
type BAssign          = semantics.BAssign
type BBinary          = semantics.BBinary
type BBlock           = semantics.BBlock
type BDefault         = semantics.BDefault
type BExprStmt        = semantics.BExprStmt
type BIf              = semantics.BIf
type BLiteral         = semantics.BLiteral
type BLocal           = semantics.BLocal
type BStructLiteral   = semantics.BStructLiteral
type BThis            = semantics.BThis
type BUnary           = semantics.BUnary
type Big              = semantics.Big
type Constant         = semantics.Constant
type LocalSymbol      = semantics.LocalSymbol

/// Lowerer.cs:18 `Lowerer.Lower`. The arenas of the lowered nodes are on `l`; C#'s `mutants`/`coverage` arguments are
/// `l.mutating`/`l.mutants` and `l.covering`/`l.coverage`, set by the caller.
public LoweredProgram lower(ref Ctx c, to ref LCtx l) uses alloc {
    for d in c.diagnostics {
        if !d.isWarning {
            panic("cannot lower a compilation with errors")
        }
    }
    var functions = List<LoweredFunction>()
    var tests = List<TestId>()
    var testFunctions = List<LoweredFunction>()
    for k in 0..c.moduleOrder.length {
        let m = c.moduleOrder[k]
        for i in 0..c.modules[m].allFunctions.length {
            let fn = c.modules[m].allFunctions[i]
            continue if c.functions[fn].body == -1
                || c.functions[fn].kind == .testKeyword
                || semantics.functionIsGeneric(ref c, by: fn)
            functions.append(lowerFunction(ref c, through: ref l, for: fn))
        }
        for i in 0..c.modules[m].tests.length {
            let t = c.modules[m].tests[i]
            tests.append(t)
            testFunctions.append(lowerFunction(ref c, through: ref l, for: c.tests[t].function))
        }
    }
    let coverage = CoverageProbes {
        count: l.coverage.count,
        statements: l.coverage.statements.take(),
        branches: l.coverage.branches.take(),
        errors: l.coverage.errors.take(),
    }
    return LoweredProgram {
        functions: move functions,
        main: c.modules[c.entryModule].main,
        tests: move tests,
        testFunctions: move testFunctions,
        mutants: l.mutating,
        covering: l.covering,
        coverage: move coverage,
    }
}

/// Lowerer.cs:78 `FunctionLowerer.Lower`, after resetting `l`'s per-function fields (`new FunctionLowerer(fn, …)`).
LoweredFunction lowerFunction(ref Ctx c, through ref LCtx l, for FuncId fn) uses alloc {
    l.fn = fn
    l.outs = List<List<BStmt>>()
    l.outs.append(List<BStmt>())
    l.locals = List<LocalId>()
    l.seen = Map<LocalId, bool>()
    l.scopes = List<LScope>()
    l.targets = Map<i64, LTarget>()
    l.labelCount = 0
    l.contextSlots = 0
    l.panicSlots = 0
    l.showing = false
    l.shown = Map<BExpr, BExpr>()
    l.ran = Map<BExpr, LocalId>()
    l.plain = Map<semantics.BNode, bool>()
    l.probing = Map<semantics.BNode, bool>()
    let body = c.functions[fn].body
    let bodySpan = semantics.nodeSpan(in c, for: body)
    l.scopes.append(LScope {})
    if c.functions[fn].kind == .constructor {
        let s = c.functions[fn].owner
        var defaults = List<BExpr>()
        for i in 0..c.structs[s].fields.length {
            let f = c.structs[s].fields[i]
            let d = c.fields[f].defaultValue
            defaults.append(
                d != -1 ? d : semantics.addDefault(ref c, from: BDefault { span: bodySpan, type: c.fields[f].type }),
            )
        }
        let structType = semantics.makeType(.structType, at: s)
        let target = semantics.addThis(ref c, from: BThis { span: bodySpan, type: structType })
        let value = semantics.addStructLiteral(
            ref c,
            from: BStructLiteral { span: bodySpan, structId: s, fields: move defaults, type: structType },
        )
        emit(
            ref l,
            for: semantics.addAssign(ref c, from: BAssign { span: bodySpan, target: target, value: value, op: null }),
        )
    }
    let statements = copyStmts(in c.bBlocks[i64(body & 0xFFFFFFFF)].statements)
    for s in statements {
        lowerStatement(ref c, through: ref l, for: s)
    }
    emitCleanups(ref c, through: ref l, at: 0, for: -1)
    l.scopes.remove(at: 0)
    if c.functions[fn].kind == .constructor {
        emit(ref l, for: ltree.addLReturn(ref l.tree, from: LReturn { span: bodySpan, value: -1 }))
    }
    let lowered = l.outs.removeLast()
    var locals = List<LocalId>()
    for x in l.locals {
        locals.append(x)
    }
    let block = semantics.addBlock(ref c, from: BBlock { span: bodySpan, statements: move lowered })
    return LoweredFunction {
        symbol: fn,
        locals: move locals,
        contextSlots: l.contextSlots,
        panicSlots: l.panicSlots,
        body: block,
    }
}

/// A copy of `xs`, so the lowering can grow `c`'s arenas while it walks them.
List<BStmt> copyStmts(in List<BStmt> xs) uses alloc {
    var r = List<BStmt>()
    for x in xs {
        r.append(x)
    }
    return r
}

// ── Helpers ──────────────────────────────────────────────────────────────────

/// Lowerer.cs:97 `Emit`.
void emit(ref LCtx l, for BStmt s) uses alloc {
    l.outs[l.outs.length - 1].append(s)
}

/// Lowerer.cs:99 `Note`.
void note(ref Ctx c, through ref LCtx l, for LocalId local) uses alloc {
    // A lambda reads its captures through its environment, not as locals of its own.
    // Q1: round 4 redoes this (Lowerer.cs:102).
    return if c.locals[local].isParameter
    for x in c.functions[l.fn].captures {
        return if x == local
    }
    unless l.seen.contains(local) {
        l.seen[local] = true
        l.locals.append(local)
    }
}

/// Lowerer.cs:106 `NewTemp`.
LocalId newTemp(ref Ctx c, through ref LCtx l, for Type type) uses alloc {
    c.locals.append(LocalSymbol { name: "t", type: type, kind: .temp })
    let t = c.locals.length - 1
    note(ref c, through: ref l, for: t)
    return t
}

/// Lowerer.cs:113 `NewLabel`.
string newLabel(ref LCtx l, for string kind) uses alloc {
    l.labelCount += 1
    return $"{kind}_{l.labelCount}"
}

/// Lowerer.cs:116 `Capture` (D5): later output goes to a fresh list.
public void captureBegin(ref LCtx l) uses alloc {
    l.outs.append(List<BStmt>())
}

/// Lowerer.cs:116 `Capture` (D5): the list `captureBegin` started, with output going back to the one below.
public List<BStmt> captureEnd(ref LCtx l) {
    return l.outs.removeLast()
}

/// Lowerer.cs:131 `CaptureExpr` (D5): the lowered value, with the statements it needs first in `pre`.
BExpr captureExpr(ref Ctx c, through ref LCtx l, for BExpr e, bool lvalue, to ref List<BStmt> pre) uses alloc {
    captureBegin(ref l)
    let value = lvalue ? lowerLvalue(ref c, through: ref l, for: e) : lowerExpr(ref c, through: ref l, for: e)
    pre = captureEnd(ref l)
    return value
}

/// Lowerer.cs:138 `Block`.
BStmt block(ref Ctx c, at TextSpan span, for move List<BStmt> statements) uses alloc {
    return semantics.addBlock(ref c, from: BBlock { span: span, statements: move statements })
}

/// Lowerer.cs:140 `Bool`.
BExpr boolLiteral(ref Ctx c, at TextSpan span, by bool value) uses alloc {
    let e = semantics.addLiteral(
        ref c,
        from: BLiteral { span: span, type: semantics.prim(.bool), value: Constant { kind: .flag, flag: value } },
    )
    semantics.setConstant(ref c, for: e, to: Constant { kind: .flag, flag: value })
    return e
}

/// Lowerer.cs:142 `I64`.
BExpr i64Literal(ref Ctx c, at TextSpan span, by i64 value) uses alloc {
    let lo: u64 = value >= 0 ? u64(value) : ~u64(-(value + 1))
    let hi: u64 = value >= 0 ? 0 : 0xFFFFFFFFFFFFFFFF
    let e = semantics.addLiteral(
        ref c,
        from: BLiteral {
            span: span,
            type: semantics.prim(.i64),
            value: Constant { kind: .integer, integer: Big { lo: lo, hi: hi } },
        },
    )
    semantics.setConstant(ref c, for: e, to: Constant { kind: .integer, integer: Big { lo: lo, hi: hi } })
    return e
}

/// Lowerer.cs:145 `Not`.
BExpr notExpr(ref Ctx c, through in LCtx l, for BExpr e) uses alloc {
    return semantics.addUnary(
        ref c,
        from: BUnary {
            span: t2Span(in c, through: in l, for: e),
            op: .notKeyword,
            operand: e,
            type: semantics.prim(.bool),
        },
    )
}

/// Lowerer.cs:147 `And`.
BExpr andExpr(ref Ctx c, through in LCtx l, for BExpr a, by BExpr b) uses alloc {
    return b if isTrueLiteral(in c, for: a)
    return a if isTrueLiteral(in c, for: b)
    return semantics.addBinary(
        ref c,
        from: BBinary {
            span: t2Span(in c, through: in l, for: a),
            op: .logicalAnd,
            left: a,
            right: b,
            type: semantics.prim(.bool),
        },
    )
}

/// `e is BoundLiteral { Value.Value: true }`.
bool isTrueLiteral(in Ctx c, for BExpr e) {
    return false if ltree.isLowered(e) || semantics.boundKind(e) != .literal
    let v = c.bLiterals[i64(e & 0xFFFFFFFF)].value
    return v.kind == .flag && v.flag
}

/// Lowerer.cs:150 `Or`.
BExpr orExpr(ref Ctx c, through in LCtx l, for BExpr a, by BExpr b) uses alloc {
    return semantics.addBinary(
        ref c,
        from: BBinary {
            span: t2Span(in c, through: in l, for: a),
            op: .logicalOr,
            left: a,
            right: b,
            type: semantics.prim(.bool),
        },
    )
}

/// Lowerer.cs:152 `Local`.
BExpr localExpr(ref Ctx c, at TextSpan span, for LocalId local) uses alloc {
    // `semantics.addLocal` (bound.byn:1211) resolves to binder.byn:260's private `addLocal` here (BYN2005), so this is
    // its body (Q763).
    c.bLocals.append(BLocal { span: span, local: local, type: c.locals[local].type })
    return semantics.makeBound(.local, at: c.bLocals.length - 1)
}

/// Lowerer.cs:154 `IsNever`.
bool isNeverExpr(BExpr e) => ltree.isLowered(e) && ltree.lKindOf(e) == .neverValue

/// `e is LVoid`.
bool isVoidExpr(BExpr e) => ltree.isLowered(e) && ltree.lKindOf(e) == .voidValue

/// `e.Type` for a bound or lowered expression (LoweredNodes.cs:83-127).
Type t2Type(in Ctx c, through in LCtx l, for BExpr e) => ltree.typeOf(in c, through: in l.tree, for: e)

/// `n.Syntax.Span` for a bound or lowered node.
TextSpan t2Span(in Ctx c, through in LCtx l, for semantics.BNode n) => ltree.spanOf(in c, through: in l.tree, for: n)

/// `BoundTree.Children(node)`: a lowered node has none there (its fields are walked by `anyNode`).
List<semantics.BNode> t2Children(in Ctx c, for semantics.BNode n) uses alloc {
    return List<semantics.BNode>() if ltree.isLowered(n)
    return semantics.children(in c, for: n)
}

/// `n is BoundExpr`, for a bound or lowered node.
bool t2IsExpr(semantics.BNode n) {
    return ltree.lKindOf(n).ordinal >= ltree.LKind.optionalHas.ordinal if ltree.isLowered(n)
    return semantics.isExprKind(semantics.boundKind(n))
}

/// Lowerer.cs:157 `IsTrivial`: cheap and free of effects, safe to evaluate more than once or later.
bool isTrivial(in Ctx c, through in LCtx l, for BExpr e) {
    if ltree.isLowered(e) {
        let i = ltree.lIndexOf(e)
        switch ltree.lKindOf(e) {
            case .voidValue: return true
            case .optionalValue: return isTrivial(in c, through: in l, for: l.tree.optionalValues[i].optional)
            case .unionTag: return isTrivial(in c, through: in l, for: l.tree.unionTags[i].unionValue)
            case .unionField: return isTrivial(in c, through: in l, for: l.tree.unionFields[i].unionValue)
            case .errorCode: return isTrivial(in c, through: in l, for: l.tree.errorCodes[i].error)
            case .errorField: return isTrivial(in c, through: in l, for: l.tree.errorFields[i].error)
            default: return false
        }
    }
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .errorVariant:
            for p in c.bErrorVariants[i].payload {
                unless isTrivial(in c, through: in l, for: p) {
                    return false
                }
            }
            return true
        case .literal
            or .symbolLiteral
            or .hostTarget
            or .defaultValue
            or .local
            or .thisRef
            or .enumMember
            or .enumValues
            or .staticArray: return true
        case .field: return isTrivial(in c, through: in l, for: c.bFields[i].receiver)
        case .tupleElement: return isTrivial(in c, through: in l, for: c.bTupleElements[i].receiver)
        case .moveExpr: return isTrivial(in c, through: in l, for: c.bMoves[i].operand)
        default: return false
    }
}

/// Lowerer.cs:173 `IsRepeatable`: trivial and free of `move`, since a move records its slot.
bool isRepeatable(in Ctx c, through in LCtx l, for BExpr e) {
    if ltree.isLowered(e) {
        let i = ltree.lIndexOf(e)
        switch ltree.lKindOf(e) {
            case .optionalValue: return isRepeatable(in c, through: in l, for: l.tree.optionalValues[i].optional)
            case .unionTag: return isRepeatable(in c, through: in l, for: l.tree.unionTags[i].unionValue)
            case .unionField: return isRepeatable(in c, through: in l, for: l.tree.unionFields[i].unionValue)
            case .errorCode: return isRepeatable(in c, through: in l, for: l.tree.errorCodes[i].error)
            case .errorField: return isRepeatable(in c, through: in l, for: l.tree.errorFields[i].error)
            default: return isTrivial(in c, through: in l, for: e)
        }
    }
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .moveExpr: return false
        case .field: return isRepeatable(in c, through: in l, for: c.bFields[i].receiver)
        case .tupleElement: return isRepeatable(in c, through: in l, for: c.bTupleElements[i].receiver)
        case .errorVariant:
            for p in c.bErrorVariants[i].payload {
                unless isRepeatable(in c, through: in l, for: p) {
                    return false
                }
            }
            return true
        default: return isTrivial(in c, through: in l, for: e)
    }
}

/// Lowerer.cs:187 `IsLvalue`.
bool isLvalue(in Ctx c, through in LCtx l, for BExpr e) {
    if ltree.isLowered(e) {
        switch ltree.lKindOf(e) {
            case .indexUnchecked: return true
            case .optionalValue: return isLvalue(
                in c,
                through: in l,
                for: l.tree.optionalValues[ltree.lIndexOf(e)].optional,
            )
            default: return false
        }
    }
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .local or .thisRef or .index or .staticArray: return true
        case .builtinCall: return c.bBuiltinCalls[i].member is .mapIndexSet or .mapSlot
        case .field: return isLvalue(in c, through: in l, for: c.bFields[i].receiver)
        case .tupleElement: return isLvalue(in c, through: in l, for: c.bTupleElements[i].receiver)
        default: return false
    }
}

/// Lowerer.cs:197 `HasEffects`.
bool hasEffects(in Ctx c, through in LCtx l, for BExpr e) uses alloc {
    if ltree.isLowered(e) {
        switch ltree.lKindOf(e) {
            case .assignExpr or .sequence or .nextChar: return true
            default: break
        }
    } else {
        switch semantics.boundKind(e) {
            case .call or .builtinCall: return true
            default: break
        }
    }
    unless isTrivial(in c, through: in l, for: e) {
        for x in t2Children(in c, for: e) {
            return true if t2IsExpr(x) && hasEffects(in c, through: in l, for: x)
        }
    }
    return ltree.isLowered(e)
        && ltree.lKindOf(e) == .optionalValue
        && hasEffects(in c, through: in l, for: l.tree.optionalValues[ltree.lIndexOf(e)].optional)
}

/// Lowerer.cs:203 `Spill`.
BExpr spill(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    return e if isNeverExpr(e) || isVoidExpr(e)
    let t = newTemp(ref c, through: ref l, for: t2Type(in c, through: in l, for: e))
    let span = t2Span(in c, through: in l, for: e)
    emitAssign(ref c, through: ref l, to: localExpr(ref c, at: span, for: t), as: e)
    return localExpr(ref c, at: span, for: t)
}

/// Lowerer.cs:215 `Become`: stores the payload in the state's part of `this`, then the tag. The payload is evaluated
/// into temporaries first, since it may read the old state's fields from the same storage.
void lowerBecome(ref Ctx c, through ref LCtx l, for BStmt b) uses alloc {
    let i = i64(b & 0xFFFFFFFF)
    let span = c.bBecomes[i].span
    let state = c.bBecomes[i].state
    var payload = List<BExpr>()
    for p in c.bBecomes[i].payload {
        payload.append(p)
    }
    var lowered = List<BExpr>()
    unless operands(ref c, through: ref l, for: in payload, as: in List<bool>(), to: ref lowered) {
        return
    }
    var values = List<BExpr>()
    for v in lowered {
        values.append(semantics.exprConstant(in c, for: v) is null ? spill(ref c, through: ref l, for: v) : v)
    }
    let self = semantics.addThis(
        ref c,
        from: BThis { span: span, type: semantics.makeType(.structType, at: c.functions[l.fn].owner) },
    )
    for k in 0..values.length {
        let field = ltree.addLUnionField(
            ref l.tree,
            from: LUnionField { span: span, unionValue: self, variant: state, index: k },
        )
        emitAssign(ref c, through: ref l, to: field, as: values[k])
    }
    let tag = c.unionVariants[state].tag
    let lo: u64 = tag >= 0 ? u64(tag) : ~u64(-(tag + 1))
    let hi: u64 = tag >= 0 ? 0 : 0xFFFFFFFFFFFFFFFF
    let tagValue = semantics.addLiteral(
        ref c,
        from: BLiteral {
            span: span,
            type: semantics.prim(.i32),
            value: Constant { kind: .integer, integer: Big { lo: lo, hi: hi } },
        },
    )
    semantics.setConstant(ref c, for: tagValue, to: Constant { kind: .integer, integer: Big { lo: lo, hi: hi } })
    emitAssign(
        ref c,
        through: ref l,
        to: ltree.addLUnionTag(ref l.tree, from: LUnionTag { span: span, unionValue: self }),
        as: tagValue,
    )
}

/// Lowerer.cs:226 `EmitAssign`: stores `value` in `target`, or just evaluates it when it does not complete.
void emitAssign(ref Ctx c, through ref LCtx l, to BExpr target, as BExpr value) uses alloc {
    return if isNeverExpr(value)
    if semantics.isNever(t2Type(in c, through: in l, for: value)) || isVoidExpr(value) {
        emitEffect(ref c, through: ref l, for: value)
        return
    }
    emit(
        ref l,
        for: semantics.addAssign(
            ref c,
            from: BAssign { span: t2Span(in c, through: in l, for: value), target: target, value: value, op: null },
        ),
    )
}

/// Lowerer.cs:237 `EmitEffect`.
void emitEffect(ref Ctx c, through ref LCtx l, for BExpr value) uses alloc {
    return if isNeverExpr(value) || isVoidExpr(value) || isTrivial(in c, through: in l, for: value)
    emit(
        ref l,
        for: semantics.addExprStmt(
            ref c,
            from: BExprStmt { span: t2Span(in c, through: in l, for: value), expr: value },
        ),
    )
}

/// Lowerer.cs:248 `Operands`: lowers operands so they are evaluated left to right: when a later operand needs
/// statements first, or two operands have effects (C leaves their order unspecified), earlier operands are stored in
/// temporaries. Operand `i` stays addressable when `lvalues[i]` is true (C#'s `lvalues?.Invoke(i) ?? false`; an
/// empty list is C#'s null). Returns false for C#'s null, with `values` the lowered operands otherwise.
bool operands(
    ref Ctx c,
    through ref LCtx l,
    for in List<BExpr> ops,
    as in List<bool> lvalues,
    to ref List<BExpr> values
) uses alloc {
    let n = ops.length
    var pres = List<List<BStmt>>()
    for i in 0..n {
        var pre = List<BStmt>()
        values.append(
            captureExpr(ref c, through: ref l, for: ops[i], lvalue: i < lvalues.length && lvalues[i], to: ref pre),
        )
        pres.append(move pre)
    }
    var barrier: i64 = -1
    for i in 0..n {
        if pres[i].length > 0 {
            barrier = i
        }
    }
    var effects = List<i64>()
    for i in 0..n {
        if hasEffects(in c, through: in l, for: values[i]) {
            effects.append(i)
        }
    }
    if effects.length >= 2 && effects[effects.length - 1] > barrier {
        barrier = effects[effects.length - 1]
    }
    // An operand moving a local a later operand reads happens first, as its own statement, so the read sees the local moved.
    var movedFirst = List<bool>()
    for i in 0..n {
        var moved = false
        for j in i + 1..n {
            if anyNode(in c, through: in l, for: values[j], by: .readsLocalMovedBy(values[i])) {
                moved = true
                break
            }
            for s in pres[j] {
                if anyNode(in c, through: in l, for: s, by: .readsLocalMovedBy(values[i])) {
                    moved = true
                    break
                }
            }
            break if moved
        }
        movedFirst.append(moved)
    }
    for i in 0..n {
        for s in pres[i] {
            emit(ref l, for: s)
        }
        return false if isNeverExpr(values[i])
        let lvalue = i < lvalues.length && lvalues[i]
        // coverage-exempt: Q774
        if (i < barrier && !isTrivial(in c, through: in l, for: values[i]) || movedFirst[i]) && !lvalue
                && !isVoidExpr(values[i]) {
            values[i] = spill(ref c, through: ref l, for: values[i])
        }
    }
    return true
}

/// The `test` lambdas `Any` is called with (Lowerer.cs:262-263, 291), since a lambda cannot read `c` (Q763).
union T2AnyTest {
    /// `x => x is BoundMove { Operand: BoundLocal r } && r.Local == l` (`Moves`).
    movesLocal(LocalId local)
    /// `x => x is BoundLocal r && Moves(mover, r.Local)` (`Operands`).
    readsLocalMovedBy(BExpr mover)
}

bool t2Passes(in Ctx c, through in LCtx l, for semantics.BNode x, by T2AnyTest probe) uses alloc {
    return false if ltree.isLowered(x)
    let i = i64(x & 0xFFFFFFFF)
    switch probe {
        case .movesLocal(let local):
            return false if semantics.boundKind(x) != .moveExpr
            let operand = c.bMoves[i].operand
            return !ltree.isLowered(operand)
                && semantics.boundKind(operand) == .local
                && c.bLocals[i64(operand & 0xFFFFFFFF)].local == local
        case .readsLocalMovedBy(let mover):
            return semantics.boundKind(x) == .local && moves(in c, through: in l, for: mover, by: c.bLocals[i].local)
    }
}

/// Lowerer.cs:275 `Any`: whether `node` or a node inside it passes `test`.
bool anyNode(in Ctx c, through in LCtx l, for semantics.BNode node, by T2AnyTest probe) uses alloc {
    return true if t2Passes(in c, through: in l, for: node, by: probe)
    if ltree.isLowered(node) {
        let i = ltree.lIndexOf(node)
        switch ltree.lKindOf(node) {
            case .optionalHas: return anyNode(in c, through: in l, for: l.tree.optionalHass[i].optional, by: probe)
            case .optionalValue: return anyNode(in c, through: in l, for: l.tree.optionalValues[i].optional, by: probe)
            case .unionTag: return anyNode(in c, through: in l, for: l.tree.unionTags[i].unionValue, by: probe)
            case .unionField: return anyNode(in c, through: in l, for: l.tree.unionFields[i].unionValue, by: probe)
            case .errorCode: return anyNode(in c, through: in l, for: l.tree.errorCodes[i].error, by: probe)
            case .errorField: return anyNode(in c, through: in l, for: l.tree.errorFields[i].error, by: probe)
            case .assignExpr:
                return anyNode(in c, through: in l, for: l.tree.assignExprs[i].target, by: probe)
                    || anyNode(in c, through: in l, for: l.tree.assignExprs[i].value, by: probe)
            case .sequence:
                for e in l.tree.sequences[i].effects {
                    return true if anyNode(in c, through: in l, for: e, by: probe)
                }
                return anyNode(in c, through: in l, for: l.tree.sequences[i].value, by: probe)
            case .failingCall: return anyNode(in c, through: in l, for: l.tree.failingCalls[i].call, by: probe)
            default: return false
        }
    }
    return false if semantics.boundKind(node) == .local
    for x in t2Children(in c, for: node) {
        return true if anyNode(in c, through: in l, for: x, by: probe)
    }
    return false
}

/// Lowerer.cs:291 `Moves`: whether `node` moves local `local`.
bool moves(in Ctx c, through in LCtx l, for semantics.BNode node, by LocalId local) uses alloc =>
    anyNode(in c, through: in l, for: node, by: .movesLocal(local))

// ── Cleanup ──────────────────────────────────────────────────────────────────

/// Lowerer.cs:296 `CaptureGuard`: a guarded defer body (`defer stmt if c`) with its condition read now, at registration (J20).
BStmt captureGuard(ref Ctx c, through ref LCtx l, for BStmt body) uses alloc {
    return body if ltree.isLowered(body) || semantics.boundKind(body) != .ifStmt
    let i = i64(body & 0xFFFFFFFF)
    // coverage-exempt: Q765
    return body if !c.bIfs[i].guarded || c.bIfs[i].elseBranch != -1
    let read = c.bIfs[i].condition
    let condition = spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: read))
    return semantics.addIf(ref c, from: BIf {
        span: c.bIfs[i].span,
        condition: condition,
        then: c.bIfs[i].then,
        elseBranch: c.bIfs[i].elseBranch,
        isNever: c.bIfs[i].isNever,
        guarded: c.bIfs[i].guarded,
    })
}

/// Lowerer.cs:300 `EmitCleanups`: the cleanups of scopes `depth` and deeper, innermost first; errdefers only when
/// failing with `error` (-1 is C#'s null).
void emitCleanups(ref Ctx c, through ref LCtx l, at i64 depth, for LocalId error) uses alloc {
    var i = l.scopes.length - 1
    while i >= depth {
        var j = l.scopes[i].cleanups.length - 1
        while j >= 0 {
            emitCleanup(ref c, through: ref l, at: i, for: l.scopes[i].cleanups[j], by: error)
            j -= 1
        }
        i -= 1
    }
}

/// Lowerer.cs:311 `EmitCleanup`.
void emitCleanup(ref Ctx c, through ref LCtx l, at i64 scopeIndex, for LCleanup cleanup, by LocalId error) uses alloc {
    switch cleanup {
        case .deferCleanup(let body):
            lowerOutside(ref c, through: ref l, at: scopeIndex, for: body)
        case .errdeferCleanup(let binding, let body):
            return if error == -1
            if binding != -1 {
                note(ref c, through: ref l, for: binding)
                let span = t2Span(in c, through: in l, for: body)
                let target = localExpr(ref c, at: span, for: binding)
                let value = localExpr(ref c, at: span, for: error)
                emit(
                    ref l,
                    for: semantics.addAssign(
                        ref c,
                        from: BAssign { span: span, target: target, value: value, op: null },
                    ),
                )
            }
            lowerOutside(ref c, through: ref l, at: scopeIndex, for: body)
        case .restoreContext(let span, let slot):
            emit(ref l, for: ltree.addLSetContext(ref l.tree, from: LSetContext { span: span, arena: -1, slot: slot }))
        case .freeArena(let span, let arena):
            let value = localExpr(ref c, at: span, for: arena)
            emit(ref l, for: ltree.addLFreeArena(ref l.tree, from: LFreeArena { span: span, arena: value }))
        case .popPanicHandler(let span, let slot):
            emit(ref l, for: ltree.addLPopPanicHandler(ref l.tree, from: LPopPanicHandler { span: span, slot: slot }))
    }
}

/// Lowerer.cs:338 `LowerOutside`: lowers a cleanup body as if its own scope and everything inside it had already ended.
void lowerOutside(ref Ctx c, through ref LCtx l, at i64 scopeIndex, for BStmt body) uses alloc {
    // `saved` holds the removed scopes innermost first; they go back outermost first, as `AddRange(saved)`.
    var saved = List<LScope>()
    while l.scopes.length > scopeIndex {
        saved.append(l.scopes.removeLast())
    }
    lowerStatement(ref c, through: ref l, for: body)
    while saved.length > 0 {
        l.scopes.append(saved.removeLast())
    }
}
== emitter/lowerassert.byn
// T5: Lowerer.cs 1376-1728 (`Printable`, `Assert`, `Write`, `SwitchExpr`, `TryFrom`).
//
// `Assert`, `AssertFails`, `Shown` and `IsLiteral` read `e.Syntax` through T21's `exprSyntax` (Q849); the source text
// is `Ctx.files[...].text` of the lowered function's file. A `x with { ... }` copy of a bound node is a new node that
// carries the old one's `Constant` and syntax facts (`t5Copied`).

import semantics
import parser
import emitter.ltree

type T5LGoto          = ltree.LGoto
type T5LLabel         = ltree.LLabel
type T5LNever         = ltree.LNever
type T5LOptionalValue = ltree.LOptionalValue
type T5LPanic         = ltree.LPanic
type T5LVoid          = ltree.LVoid
type T5LWrite         = ltree.LWrite

/// Lowerer.cs:1376 `Printable`.
public bool printable(Type t) {
    return semantics.isInteger(t)
        || semantics.isFloat(t)
        || semantics.isBool(t)
        || semantics.isString(t)
        || semantics.kindOf(t) == .enumType
}

/// `e is BoundBuiltinCall { Member: member }`.
bool t5IsBuiltin(Ctx c, for BExpr e, by semantics.BuiltinMember member) =>
    !ltree.isLowered(e) && semantics.boundKind(e) == .builtinCall && c.bBuiltinCalls[e & 0xFFFFFFFF].member == member

/// The `Constant` and syntax facts (Q537) of `old`, which `old with { ... }` keeps, set on its copy.
BExpr t5Copied(ref Ctx c, from BExpr old, as BExpr copy) uses alloc {
    if (c.constants.tryGet(at: old) is { } k) {
        c.constants[copy] = k
    }
    if (c.syntaxFlags.tryGet(at: old) is { } f) {
        c.syntaxFlags[copy] = f
    }
    return copy
}

/// `b with { Member = member, Receiver = receiver, Arguments = arguments }` for a builtin call `b`.
BExpr t5Builtin(
    ref Ctx c,
    from BExpr b,
    as semantics.BuiltinMember member,
    to BExpr receiver,
    by move List<BExpr> arguments
) uses alloc {
    let i = i64(b & 0xFFFFFFFF)
    let span = c.bBuiltinCalls[i].span
    let type = c.bBuiltinCalls[i].type
    let copy = semantics.addBuiltinCall(
        ref c,
        from: BBuiltinCall { span: span, member: member, receiver: receiver, arguments: move arguments, type: type },
    )
    return t5Copied(ref c, from: b, as: copy)
}

/// The arguments of the builtin call `b`.
List<BExpr> t5Arguments(Ctx c, for BExpr b) uses alloc {
    var r = List<BExpr>()
    for a in c.bBuiltinCalls[b & 0xFFFFFFFF].arguments {
        r.append(a)
    }
    return r
}

/// Whether `m` is one of the members that change their receiver (Lowerer.cs:1582).
bool t5Mutating(semantics.BuiltinMember m) {
    switch m {
        case .listAdd
            or .listClear
            or .listRemoveLast
            or .listRemoveRange
            or .listRemoveThrough
            or .listRemoveAt
            or .listRemoveAtRange: return true
        case .listReplace or .listSort: return true
        case .mapIndexSet or .mapSlot or .mapRemove or .mapClear: return true
        case .strBufAppend
            or .strBufAppendRepeated
            or .strBufInsert
            or .strBufClear
            or .arrayAsSpan
            or .listMutableSpan
            or .arrayMutableSpan: return true
        default: return false
    }
}

/// A literal of `type` with constant `k`.
BExpr t5Literal(ref Ctx c, at TextSpan span, by Type type, as Constant k) uses alloc {
    return semantics.addLiteral(ref c, from: BLiteral { span: span, type: type, value: k })
}

/// `fits` and `value op bound` (C#'s local `Check`); `fits` -1 is C#'s null.
BExpr t5Check(
    ref Ctx c,
    through LCtx l,
    at TextSpan span,
    for BExpr fits,
    by parser.BinaryOp op,
    to BExpr value,
    as BExpr bound
) uses alloc {
    let check = semantics.addBinary(
        ref c,
        from: BBinary { span: span, op: op, left: value, right: bound, type: semantics.prim(.bool) },
    )
    return check if fits == -1
    return andExpr(ref c, through: l, for: fits, by: check)
}

/// `_fn.File!.Source.GetText(TextSpan.FromBounds(start, end))`.
string t5Source(Ctx c, through LCtx l, from i64 start, to i64 end) uses alloc =>
    $"{Utf8.tryDecode(c.files[c.functions[l.fn].file].text.span[start..end]) ?? ""}"

/// Lowerer.cs:1394 `Assert`'s local `After`: where the text after `left` resumes, its blanks skipped, before `end`.
i64 t5After(Ctx c, through LCtx l, for TextSpan left, to i64 end) {
    let bytes = c.files[c.functions[l.fn].file].text.span
    var at = left.start + left.length
    while at < end && (bytes[at] is 32 or 9 or 10 or 13) {
        at += 1
    }
    return at
}

/// Lowerer.cs:1399 `Assert`'s local `Anchor`: where the value of the recorded syntax node `node` is hung.
i64 t5Anchor(Ctx c, through LCtx l, for semantics.ExprSyntax node, to i64 end) {
    switch node.kind {
        case .parenExpr: return t5Anchor(c, through: l, for: semantics.exprSyntaxNode(c, at: node.inner), to: end)
        case .memberExpr: return node.member.start
        case .callExpr: return t5Anchor(c, through: l, for: semantics.exprSyntaxNode(c, at: node.callee), to: end)
        case .binaryExpr: return t5After(c, through: l, for: semantics.exprSyntaxNode(c, at: node.left).span, to: end)
        case .isExpr: return t5After(c, through: l, for: semantics.exprSyntaxNode(c, at: node.value).span, to: end)
        case .indexExpr: return t5After(c, through: l, for: semantics.exprSyntaxNode(c, at: node.target).span, to: end)
        case .conditionalExpr: return t5After(
            c,
            through: l,
            for: semantics.exprSyntaxNode(c, at: node.condition).span,
            to: end,
        )
        default: return node.span.start
    }
}

/// Lowerer.cs:1384 `Assert`: lowers the `assert` statement `s`, appending to the current output list.
public void lowerAssert(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let a = i64(s & 0xFFFFFFFF)
    if c.bAsserts[a].failsWith != -1 {
        assertFails(ref c, through: ref l, for: s, by: c.bAsserts[a].failsWith)
        return
    }
    let span = c.bAsserts[a].span
    let start = span.start
    // The parser ends the statement at its condition (`ExpectEnd` takes no `;`), so this is `syntax.Condition.Span.End`.
    let end = span.start + span.length
    var exprs = List<BExpr>()
    var mayNotRuns = List<bool>()
    shown(c, through: l, for: c.bAsserts[a].condition, by: false, to: ref exprs, as: ref mayNotRuns)
    // The first (outermost) node at a column wins: an implicit conversion shares its operand's syntax.
    var keys = List<i64>()
    var columns = List<BExpr>()
    var lazy = List<bool>()
    for k in 0..exprs.length {
        var anchor = ltree.spanOf(c, through: l.tree, for: exprs[k]).start // coverage-exempt: Q780
        if (semantics.exprSyntax(c, for: exprs[k]) is { } syntax) {
            anchor = t5Anchor(c, through: l, for: syntax, to: end)
        }
        let column = powerAssertColumn(t5Source(c, through: l, from: start, to: anchor))
        var seen = false
        for x in keys {
            if x == column {
                seen = true
            }
        }
        continue if seen
        keys.append(column)
        columns.append(exprs[k])
        lazy.append(mayNotRuns[k])
        // Kept in column order (C#'s `SortedDictionary`).
        var at = keys.length - 1
        while at > 0 && keys[at - 1] > column {
            keys[at] = keys[at - 1]
            columns[at] = columns[at - 1]
            lazy[at] = lazy[at - 1]
            at -= 1
        }
        keys[at] = column
        columns[at] = exprs[k]
        lazy[at] = mayNotRuns[k]
    }
    l.showing = true
    l.shown = Map<BExpr, BExpr>()
    l.ran = Map<BExpr, LocalId>()
    for k in 0..columns.length {
        let e = columns[k]
        l.shown[e] = -1
        unless lazy[k] {
            continue
        }
        let flag = newTemp(ref c, through: ref l, for: semantics.prim(.bool))
        let at = ltree.spanOf(c, through: l.tree, for: e)
        emitAssign(
            ref c,
            through: ref l,
            to: localExpr(ref c, at: at, for: flag),
            as: boolLiteral(ref c, at: at, by: false),
        )
        l.ran[e] = flag
    }
    let condition = lowerExpr(ref c, through: ref l, for: c.bAsserts[a].condition)
    let values = l.shown.take()
    let ran = l.ran.take()
    l.showing = false
    return if isNeverExpr(condition)
    let statement = powerAssertFlatten(t5Source(c, through: l, from: start, to: end))
    var kept = List<i64>()
    var keptValues = List<BExpr>()
    var flags = List<LocalId>()
    var always = List<bool>()
    for k in 0..columns.length {
        let v = values[columns[k]]
        continue if v == -1 || isNeverExpr(v)
        kept.append(keys[k])
        keptValues.append(v)
        let flag = ran.tryGet(at: columns[k]) ?? -1
        flags.append(flag)
        always.append(flag == -1)
    }
    var panic: BStmt = -1
    if kept.length == 0 {
        panic = ltree.addLPanic(ref l.tree, from: T5LPanic { span: span, message: statement })
    } else {
        var parts = List<BInterpolationPart>()
        parts.append(BInterpolationPart { text: statement })
        var guards = List<BExpr>()
        guards.append(-1)
        var guarded = false
        for piece in powerAssertDiagram(kept, by: always) {
            let guard = t5Guard(ref c, through: l, for: piece, at: span, by: flags)
            if guard == -1
                    && piece.value < 0
                    && guards[guards.length - 1] == -1
                    && parts[parts.length - 1].value == -1 {
                let text = parts[parts.length - 1].text ?? ""
                parts[parts.length - 1] = BInterpolationPart { text: $"{text}{piece.text}" }
            } else {
                if piece.value < 0 {
                    parts.append(BInterpolationPart { text: piece.text })
                } else {
                    parts.append(BInterpolationPart { value: keptValues[piece.value] })
                }
                guards.append(guard)
                if guard != -1 {
                    guarded = true
                }
            }
        }
        var write = T5LWrite { span: span, sink: .panic, parts: move parts }
        if guarded {
            write.guards = move guards
        }
        panic = ltree.addLWrite(ref l.tree, from: move write)
    }
    var body = List<BStmt>()
    body.append(panic)
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: notExpr(ref c, through: l, for: condition),
                then: block(ref c, at: span, for: move body),
                elseBranch: -1,
            },
        ),
    )
}

/// Lowerer.cs:1437 `Assert`'s local `Guard`: the condition `piece` is written under (-1 for always), from the flags of the kept columns.
BExpr t5Guard(ref Ctx c, through LCtx l, for PowerAssertPiece piece, at TextSpan span, by List<LocalId> flags)
        uses alloc {
    var g: BExpr = -1
    for k in piece.allShown {
        let t = localExpr(ref c, at: span, for: flags[k])
        g = g == -1 ? t : andExpr(ref c, through: l, for: g, by: t)
    }
    for k in piece.noneShown {
        let t = notExpr(ref c, through: l, for: localExpr(ref c, at: span, for: flags[k]))
        g = g == -1 ? t : andExpr(ref c, through: l, for: g, by: t)
    }
    if piece.anyFrom != -1 {
        var t = localExpr(ref c, at: span, for: flags[piece.anyFrom])
        for k in piece.anyFrom + 1..flags.length {
            t = orExpr(ref c, through: l, for: t, by: localExpr(ref c, at: span, for: flags[k]))
        } // coverage-exempt: Q780
        g = g == -1 ? t : andExpr(ref c, through: l, for: g, by: t)
    }
    return g
}

/// Lowerer.cs:1470 `AssertFails`'s local `Is`: whether the error in `error` is `v`.
BExpr t5IsVariant(ref Ctx c, at TextSpan span, for LocalId error, by VariantId v) uses alloc {
    let variant = semantics.addErrorVariant(
        ref c,
        from: BErrorVariant { span: span, variant: v, type: semantics.errorSetTypeOf(c.errorVariants[v].set) },
    )
    return semantics.addBinary(
        ref c,
        from: BBinary {
            span: span,
            op: .eq,
            left: localExpr(ref c, at: span, for: error),
            right: variant,
            type: semantics.prim(.bool),
        },
    )
}

/// Lowerer.cs:1465 `AssertFails`: lowers `assert f() fails E[.x]` (`s`, whose error set is `set`), appending to the current output list.
void assertFails(ref Ctx c, through ref LCtx l, for BStmt s, by semantics.ErrorSetId set) uses alloc {
    let a = i64(s & 0xFFFFFFFF)
    let span = c.bAsserts[a].span
    let call = c.bAsserts[a].condition
    let r = lowerFailingCall(ref c, through: ref l, for: call) ?? return
    var expected: BExpr = -1
    if c.bAsserts[a].failsCase != -1 {
        expected = t5IsVariant(ref c, at: span, for: r.error, by: c.bAsserts[a].failsCase)
    } else {
        for v in t4Copy(c.errorSets[set].variants) {
            let t = t5IsVariant(ref c, at: span, for: r.error, by: v)
            expected = expected == -1 ? t : orExpr(ref c, through: l, for: expected, by: t)
        }
    }
    let statement = powerAssertFlatten(t5Source(c, through: l, from: span.start, to: span.start + span.length))
    var anchor = ltree.spanOf(c, through: l.tree, for: call).start // coverage-exempt: Q780
    if (semantics.exprSyntax(c, for: call) is { } syntax) {
        anchor = syntax.span.start
        if syntax.callee != -1 && semantics.exprSyntaxNode(c, at: syntax.callee).kind == .memberExpr {
            anchor = semantics.exprSyntaxNode(c, at: syntax.callee).member.start
        }
    }
    let gap = " ".repeated(powerAssertColumn(t5Source(c, through: l, from: span.start, to: anchor)))
    let failed = lowerFailed(ref c, through: ref l, at: span, for: r.error)
    var parts = List<BInterpolationPart>()
    parts.append(
        BInterpolationPart { text: $"{statement}\n{powerAssertIndent}{gap}{powerAssertBar}\n{powerAssertIndent}{gap}" },
    )
    parts.append(BInterpolationPart { text: "returned" })
    var guards = List<BExpr>()
    guards.append(-1)
    guards.append(notExpr(ref c, through: l, for: failed))
    let fn = c.bCalls[call & 0xFFFFFFFF].function
    for e in t4Copy(c.functions[fn].errorSets) {
        for v in t4Copy(c.errorSets[e].variants) {
            let owner = semantics.errorSetDisplayName(ref c, by: c.errorVariants[v].set)
            parts.append(BInterpolationPart { text: $"failed with {owner}.{c.errorVariants[v].name}" })
            guards.append(t5IsVariant(ref c, at: span, for: r.error, by: v))
        }
    }
    if printable(c.bCalls[call & 0xFFFFFFFF].type) {
        parts.append(BInterpolationPart { text: " " })
        parts.append(BInterpolationPart { value: r.result })
        guards.append(notExpr(ref c, through: l, for: failed))
        guards.append(notExpr(ref c, through: l, for: failed))
    }
    var body = List<BStmt>()
    body.append(
        ltree.addLWrite(
            ref l.tree,
            from: T5LWrite { span: span, sink: .panic, parts: move parts, guards: move guards },
        ),
    )
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: notExpr(ref c, through: l, for: expected),
                then: block(ref c, at: span, for: move body),
                elseBranch: -1,
            },
        ),
    )
}

/// Lowerer.cs:1501 `Shown`: appends the sub-expressions of `e` shown on failure, outermost first, to `exprs`, and whether each may not run to `mayNotRuns`.
void shown(
    Ctx c,
    through LCtx l,
    for BExpr e,
    by bool mayNotRun,
    to ref List<BExpr> exprs,
    as ref List<bool> mayNotRuns
) uses alloc {
    var literal = false // coverage-exempt: Q780
    if (semantics.exprSyntax(c, for: e) is { } syntax) {
        literal = isLiteral(c, for: syntax)
    }
    if printable(ltree.typeOf(c, through: l.tree, for: e)) && !literal {
        exprs.append(e)
        mayNotRuns.append(mayNotRun)
    }
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .binary:
            let op = c.bBinaries[i].op
            if op is .logicalAnd or .logicalOr {
                shown(c, through: l, for: c.bBinaries[i].left, by: mayNotRun, to: ref exprs, as: ref mayNotRuns)
                shown(c, through: l, for: c.bBinaries[i].right, by: true, to: ref exprs, as: ref mayNotRuns)
                return
            }
        case .conditional:
            shown(c, through: l, for: c.bConditionals[i].condition, by: mayNotRun, to: ref exprs, as: ref mayNotRuns)
            shown(c, through: l, for: c.bConditionals[i].whenTrue, by: true, to: ref exprs, as: ref mayNotRuns)
            shown(c, through: l, for: c.bConditionals[i].whenFalse, by: true, to: ref exprs, as: ref mayNotRuns)
            return
        case .coalesce:
            shown(c, through: l, for: c.bCoalesces[i].left, by: mayNotRun, to: ref exprs, as: ref mayNotRuns)
            shown(c, through: l, for: c.bCoalesces[i].right, by: true, to: ref exprs, as: ref mayNotRuns)
            return
        case .isExpr:
            shown(c, through: l, for: c.bIses[i].value, by: mayNotRun, to: ref exprs, as: ref mayNotRuns)
            return
        case .unary or .field or .tupleElement or .unionField or .call or .builtinCall or .conversion or .index: break
        default: return
    }
    for child in semantics.children(c, for: e) { // coverage-exempt: Q780
        if semantics.isExprKind(semantics.boundKind(child)) {
            shown(c, through: l, for: child, by: mayNotRun, to: ref exprs, as: ref mayNotRuns)
        }
    }
}

/// Lowerer.cs:1519 `IsLiteral`: whether `syntax` is a literal, possibly parenthesized or signed.
bool isLiteral(Ctx c, for semantics.ExprSyntax syntax) {
    switch syntax.kind {
        case .literalExpr: return true
        case .parenExpr: return isLiteral(c, for: semantics.exprSyntaxNode(c, at: syntax.inner))
        case .unaryExpr: return (syntax.op is .negate or .plus)
            && isLiteral(c, for: semantics.exprSyntaxNode(c, at: syntax.operand))
        default: return false
    }
}

/// Lowerer.cs:1528 `CallParts` (Q845): the call `e` with its receiver and arguments lowered, or -1 when one never returns.
public BExpr lowerCallParts(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let function = c.bCalls[i].function
    let span = c.bCalls[i].span
    let type = c.bCalls[i].type
    let invoke = c.functions[function].kind == .invoke
    let hasReceiver = c.bCalls[i].receiver != -1 && (semantics.functionHasThis(ref c, by: function) || invoke)
    var ops = List<BExpr>()
    var lvalues = List<bool>()
    if hasReceiver {
        let receiver = c.bCalls[i].receiver
        ops.append(receiver)
        lvalues.append(isLvalueShape(ref c, through: ref l, for: receiver))
    }
    let offset: i64 = hasReceiver ? 1 : 0
    for k in 0..c.bCalls[i].arguments.length {
        ops.append(c.bCalls[i].arguments[k])
        let p = k
        lvalues.append(
            p < c.functions[function].parameters.length
                && semantics.paramIsByRef(ref c, by: c.functions[function].parameters[p]),
        )
    }
    var parts = List<BExpr>()
    unless operands(ref c, through: ref l, for: ops, as: lvalues, to: ref parts) {
        return -1
    }
    var receiver: BExpr = -1
    if hasReceiver {
        receiver = parts[0]
        // A function value is named twice in C (its code and its environment), so anything but a local is evaluated once first.
        if !isLvalue(c, through: l, for: receiver)
                // coverage-exempt: Q780
                || invoke && (ltree.isLowered(receiver) || semantics.boundKind(receiver) != .local) {
            receiver = spill(ref c, through: ref l, for: receiver)
        }
        // `map[k].f()` with `ref this` changes the stored value; reading through the panicking index first keeps a missing key out.
        if t5IsBuiltin(c, for: receiver, by: .mapIndexSet) {
            let place = lowerStable(ref c, through: ref l, for: receiver)
            let read = t5Builtin(
                ref c,
                from: place,
                as: .mapIndex,
                to: c.bBuiltinCalls[place & 0xFFFFFFFF].receiver,
                by: t5Arguments(c, for: place),
            )
            emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: read }))
            receiver = place
        }
    }
    var arguments = List<BExpr>()
    for k in offset..parts.length {
        arguments.append(parts[k])
    }
    let copy = semantics.addCall(
        ref c,
        from: BCall { span: span, function: function, receiver: receiver, arguments: move arguments, type: type },
    )
    return t5Copied(ref c, from: e, as: copy)
}

/// Lowerer.cs:1561 `BuiltinCall` (Q844): the lowered builtin call `e`, with its statements appended to the current output list.
public BExpr lowerBuiltinCall(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let member = c.bBuiltinCalls[i].member
    let span = c.bBuiltinCalls[i].span
    let type = c.bBuiltinCalls[i].type
    let receiver = c.bBuiltinCalls[i].receiver
    if member == .strBufAppend {
        let first = c.bBuiltinCalls[i].arguments[0]
        if !ltree.isLowered(first) && semantics.boundKind(first) == .interpolated {
            let target = lowerLvalue(ref c, through: ref l, for: receiver)
            return target if isNeverExpr(target)
            return lowerWriteParts(ref c, through: ref l, for: e, by: .strBuf, to: target, as: first)
        }
    }
    // `x.take()`: move the value out, then leave the type's empty value in the place, evaluated once.
    if member is .listTake or .mapTake or .strBufTake or .optionalTake {
        var place = lowerLvalue(ref c, through: ref l, for: receiver)
        return place if isNeverExpr(place)
        place = lowerStable(ref c, through: ref l, for: place)
        // `map[k].take()` reads through the panicking index, so a missing key is not inserted.
        var read = place
        if t5IsBuiltin(c, for: place, by: .mapIndexSet) {
            read = t5Builtin(
                ref c,
                from: place,
                as: .mapIndex,
                to: c.bBuiltinCalls[place & 0xFFFFFFFF].receiver,
                by: t5Arguments(c, for: place),
            )
        }
        let taken = spill(ref c, through: ref l, for: read)
        var empty: BExpr = -1
        if member == .strBufTake {
            empty = semantics.addCall(ref c, from: BCall { span: span, function: c.builtinStrBufGrow, type: type })
        } else {
            empty = semantics.addDefault(ref c, from: BDefault { span: span, type: type })
        }
        emitAssign(ref c, through: ref l, to: place, as: empty)
        return taken
    }
    let mutating = t5Mutating(member)
    var ops = List<BExpr>()
    ops.append(receiver)
    for a in c.bBuiltinCalls[i].arguments {
        ops.append(a)
    }
    // `slot` inserts the value type's default: field initializers for a struct, zero otherwise.
    if member == .mapSlot && ops.length == 2 {
        if semantics.kindOf(type) == .structType {
            let sid = i64(type & 0xFFFFFFFF)
            var values = List<BExpr>()
            for k in 0..c.structs[sid].fields.length {
                let field = c.structs[sid].fields[k]
                var value = c.fields[field].defaultValue
                // coverage-exempt: Q780
                if value == -1 {
                    value = semantics.addDefault(ref c, from: BDefault { span: span, type: c.fields[field].type })
                }
                values.append(value)
            }
            ops.append(
                semantics.addStructLiteral(
                    ref c,
                    from: BStructLiteral { span: span, structId: sid, fields: move values, type: type },
                ),
            )
        } else {
            ops.append(semantics.addDefault(ref c, from: BDefault { span: span, type: type }))
        }
    }
    var lvalues = List<bool>()
    lvalues.append(mutating && isLvalueShape(ref c, through: ref l, for: receiver))
    var parts = List<BExpr>()
    unless operands(ref c, through: ref l, for: ops, as: lvalues, to: ref parts) {
        return ltree.addLNever(ref l.tree, from: T5LNever { span: span, type: type })
    }
    var lowered = parts[0]
    if mutating && !isLvalue(c, through: l, for: lowered) {
        lowered = spill(ref c, through: ref l, for: lowered)
    } else if !mutating && !isTrivial(c, through: l, for: lowered) && (member is .listAsSpan or .strBufAsString) {
        lowered = spill(ref c, through: ref l, for: lowered)
    }
    var arguments = List<BExpr>()
    for k in 1..parts.length {
        arguments.append(parts[k])
    }
    let copy = t5Copied(
        ref c,
        from: e,
        as: semantics.addBuiltinCall(
            ref c,
            from: BBuiltinCall { span: span, member: member, receiver: lowered, arguments: move arguments, type: type },
        ),
    )
    if semantics.isVoid(type) {
        emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: copy }))
        return ltree.addLVoid(ref l.tree, from: T5LVoid { span: span })
    }
    return copy
}

/// Lowerer.cs:1609 `Stable` (Q844): `place` with every operand that a later write could change spilled to a temporary.
public BExpr lowerStable(ref Ctx c, through ref LCtx l, for BExpr place) uses alloc {
    if ltree.isLowered(place) {
        if ltree.lKindOf(place) == .optionalValue {
            let i = ltree.lIndexOf(place)
            let span = l.tree.optionalValues[i].span
            let type = l.tree.optionalValues[i].type
            let optional = lowerStable(ref c, through: ref l, for: l.tree.optionalValues[i].optional)
            return ltree.addLOptionalValue(
                ref l.tree,
                from: T5LOptionalValue { span: span, optional: optional, type: type },
            )
        }
    } else {
        let i = i64(place & 0xFFFFFFFF)
        switch semantics.boundKind(place) {
            case .field:
                let span = c.bFields[i].span
                let field = c.bFields[i].field
                let type = c.bFields[i].type
                let receiver = lowerStable(ref c, through: ref l, for: c.bFields[i].receiver)
                return t5Copied(
                    ref c,
                    from: place,
                    as: semantics.addField(
                        ref c,
                        from: BField { span: span, receiver: receiver, field: field, type: type },
                    ),
                )
            case .tupleElement:
                let span = c.bTupleElements[i].span
                let index = c.bTupleElements[i].index
                let type = c.bTupleElements[i].type
                let receiver = lowerStable(ref c, through: ref l, for: c.bTupleElements[i].receiver)
                return t5Copied(
                    ref c,
                    from: place,
                    as: semantics.addTupleElement(
                        ref c,
                        from: BTupleElement { span: span, receiver: receiver, index: index, type: type },
                    ),
                )
            // A list's elements live behind its pointer, so a copy of a non-addressable list still names them.
            case .index:
                let span = c.bIndexes[i].span
                let fromEnd = c.bIndexes[i].fromEnd
                let type = c.bIndexes[i].type
                let index = c.bIndexes[i].index
                let target = lowerStable(ref c, through: ref l, for: c.bIndexes[i].target)
                let at = isTrivial(c, through: l, for: index) ? index : spill(ref c, through: ref l, for: index)
                return t5Copied(
                    ref c,
                    from: place,
                    as: semantics.addIndex(
                        ref c,
                        from: BIndex { span: span, target: target, index: at, fromEnd: fromEnd, type: type },
                    ),
                )
            case .builtinCall:
                let member = c.bBuiltinCalls[i].member
                if member is .mapIndexSet or .mapSlot {
                    let receiver = lowerStable(ref c, through: ref l, for: c.bBuiltinCalls[i].receiver)
                    var arguments = List<BExpr>()
                    for k in 0..c.bBuiltinCalls[i].arguments.length {
                        let a = c.bBuiltinCalls[i].arguments[k]
                        arguments.append(isTrivial(c, through: l, for: a) ? a : spill(ref c, through: ref l, for: a))
                    }
                    return t5Builtin(ref c, from: place, as: member, to: receiver, by: move arguments)
                }
            default: break
        }
    }
    return isTrivial(c, through: l, for: place)
        || isLvalue(c, through: l, for: place) ? place : spill(ref c, through: ref l, for: place)
}

/// Lowerer.cs:1621 `Write` (Q845): the lowered write of interpolated `text` to `sink` (`target` -1 when the sink has none) for `call`.
public BExpr lowerWrite(
    ref Ctx c,
    through ref LCtx l,
    for BExpr call,
    by ltree.WriteSink sink,
    to BExpr target,
    as BExpr text
) uses alloc {
    return lowerWriteParts(ref c, through: ref l, for: call, by: sink, to: target, as: text)
}

/// Lowerer.cs:1624 `WriteParts` (Q845): as `lowerWrite`, with `level` (a log level or print stream, -1 for none) lowered after the parts and written as the target.
public BExpr lowerWriteParts(
    ref Ctx c,
    through ref LCtx l,
    for BExpr call,
    by ltree.WriteSink sink,
    to BExpr target,
    as BExpr text,
    at BExpr level = -1
) uses alloc {
    let ti = i64(text & 0xFFFFFFFF)
    let span = ltree.spanOf(c, through: l.tree, for: call)
    var values = List<BExpr>()
    for k in 0..c.bInterpolateds[ti].parts.length {
        let v = c.bInterpolateds[ti].parts[k].value
        continue if v == -1
        // A `Symbol` writes its text (spec 008 R4).
        let t = ltree.typeOf(c, through: l.tree, for: v)
        if semantics.kindOf(t) == .builtin && semantics.builtinKindOf(i64(t & 0xFFFFFFFF)) == .symbol {
            values.append(
                semantics.addBuiltinCall(
                    ref c,
                    from: BBuiltinCall {
                        span: ltree.spanOf(c, through: l.tree, for: v),
                        member: .symbolText,
                        receiver: v,
                        type: semantics.prim(.string),
                    },
                ),
            )
        } else {
            values.append(v)
        }
    }
    if level != -1 {
        values.append(level)
    }
    var lowered = List<BExpr>()
    unless operands(ref c, through: ref l, for: values, as: List<bool>(), to: ref lowered) {
        return ltree.addLNever(
            ref l.tree,
            from: T5LNever { span: span, type: ltree.typeOf(c, through: l.tree, for: call) },
        )
    }
    var written = target
    if level != -1 {
        written = lowered[lowered.length - 1]
        unless isTrivial(c, through: l, for: written) {
            // Spilling the target evaluates it ahead of the call (the emitter would evaluate it last inside the
            // call), so the parts before it are spilled first to keep them evaluated before it.
            for j in 0..lowered.length - 1 {
                unless isTrivial(c, through: l, for: lowered[j]) {
                    lowered[j] = spill(ref c, through: ref l, for: lowered[j])
                }
            }
            written = spill(ref c, through: ref l, for: written)
        }
    }
    var parts = List<BInterpolationPart>()
    var next: i64 = 0
    for k in 0..c.bInterpolateds[ti].parts.length {
        let p = c.bInterpolateds[ti].parts[k]
        if p.value == -1 {
            parts.append(p)
        } else {
            parts.append(BInterpolationPart { text: p.text, value: lowered[next], spec: p.spec })
            next += 1
        }
    }
    emit(
        ref l,
        for: ltree.addLWrite(ref l.tree, from: T5LWrite { span: span, sink: sink, target: written, parts: move parts }),
    )
    return ltree.addLVoid(ref l.tree, from: T5LVoid { span: span })
}

/// Lowerer.cs:1652 `SwitchExpr` (Q845): the lowered switch expression `e`, with its statements appended to the current output list.
public BExpr lowerSwitchExpr(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let si = i64(e & 0xFFFFFFFF)
    let span = c.bSwitchExprs[si].span
    let type = c.bSwitchExprs[si].type
    var value = lowerExpr(ref c, through: ref l, for: c.bSwitchExprs[si].value)
    return value if isNeverExpr(value)
    unless isRepeatable(c, through: l, for: value) {
        value = spill(ref c, through: ref l, for: value)
    }
    let result: LocalId = semantics.isNever(type) ? -1 : newTemp(ref c, through: ref l, for: type)
    let end = newLabel(ref l, for: "switch_end")
    for k in 0..c.bSwitchExprs[si].arms.length {
        let arm = c.bSwitchExprs[si].arms[k]
        let match = lowerMatch(ref c, through: ref l, for: arm.pattern, at: value)
        captureBegin(ref l)
        lowerClaim(ref c, through: ref l, for: arm.pattern)
        let v = lowerExpr(ref c, through: ref l, for: arm.value)
        if result != -1 {
            emitAssign(ref c, through: ref l, to: localExpr(ref c, at: arm.span, for: result), as: v)
        } else {
            emitEffect(ref c, through: ref l, for: v)
        }
        emit(ref l, for: ltree.addLGoto(ref l.tree, from: T5LGoto { span: arm.span, label: end }))
        let body = captureEnd(ref l)
        if arm.guard == -1 {
            emit(
                ref l,
                for: semantics.addIf(
                    ref c,
                    from: BIf { span: arm.span, condition: match, then: block(ref c, at: arm.span, for: move body) },
                ),
            )
            continue
        }
        var pre = List<BStmt>()
        let guard = captureExpr(ref c, through: ref l, for: arm.guard, lvalue: false, to: ref pre)
        if pre.length == 0 {
            emit(
                ref l,
                for: semantics.addIf(
                    ref c,
                    from: BIf {
                        span: arm.span,
                        condition: andExpr(ref c, through: l, for: match, by: guard),
                        then: block(ref c, at: arm.span, for: move body),
                    },
                ),
            )
        } else {
            pre.append(
                semantics.addIf(
                    ref c,
                    from: BIf { span: arm.span, condition: guard, then: block(ref c, at: arm.span, for: move body) },
                ),
            )
            emit(
                ref l,
                for: semantics.addIf(
                    ref c,
                    from: BIf { span: arm.span, condition: match, then: block(ref c, at: arm.span, for: move pre) },
                ),
            )
        }
    }
    emit(ref l, for: ltree.addLPanic(ref l.tree, from: T5LPanic { span: span, message: "no switch arm matched" }))
    emit(ref l, for: ltree.addLLabel(ref l.tree, from: T5LLabel { span: span, name: end }))
    return ltree.addLNever(ref l.tree, from: T5LNever { span: span, type: type }) if result == -1
    return localExpr(ref c, at: span, for: result)
}

/// Lowerer.cs:1692 `TryFrom` (Q845): the lowered `T.tryFrom` conversion `e`, with its statements appended to the current output list.
public BExpr lowerTryFrom(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let ti = i64(e & 0xFFFFFFFF)
    let span = c.bTryFroms[ti].span
    let target = c.bTryFroms[ti].target
    let type = c.bTryFroms[ti].type
    var value = lowerExpr(ref c, through: ref l, for: c.bTryFroms[ti].operand)
    return value if isNeverExpr(value)
    unless isRepeatable(c, through: l, for: value) {
        value = spill(ref c, through: ref l, for: value)
    }
    let from = ltree.typeOf(c, through: l.tree, for: value)
    var fits: BExpr = -1
    if semantics.isInteger(target) && semantics.isFloat(from) {
        let r = semantics.range(semantics.primKindOf(i64(target & 0xFFFFFFFF)))
        let min = semantics.bigToF64(r.min)
        let max = semantics.bigToF64(r.max)
        // A value above min - 1 truncates into range; when min - 1 rounds to min in `from` (i64 from f64, i32
        // from f32) no value lies between them, so the bound is min itself, inclusive.
        let below = from == semantics.prim(.f32) ? f64(f32(min - 1.0)) : min - 1.0
        if below == min {
            fits = t5Check(
                ref c,
                through: l,
                at: span,
                for: fits,
                by: .ge,
                to: value,
                as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .real, real: min }),
            )
        } else {
            fits = t5Check(
                ref c,
                through: l,
                at: span,
                for: fits,
                by: .gt,
                to: value,
                as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .real, real: below }),
            )
        }
        fits = t5Check(
            ref c,
            through: l,
            at: span,
            for: fits,
            by: .lt,
            to: value,
            as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .real, real: max + 1.0 }),
        )
    } else if semantics.isInteger(target) {
        let r = semantics.range(semantics.primKindOf(i64(target & 0xFFFFFFFF)))
        let fr = semantics.range(semantics.primKindOf(i64(from & 0xFFFFFFFF)))
        if semantics.bigCmp(fr.min, as: r.min) < 0 {
            fits = t5Check(
                ref c,
                through: l,
                at: span,
                for: fits,
                by: .ge,
                to: value,
                as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .integer, integer: r.min }),
            )
        }
        if semantics.bigCmp(r.max, as: fr.max) < 0 {
            fits = t5Check(
                ref c,
                through: l,
                at: span,
                for: fits,
                by: .le,
                to: value,
                as: t5Literal(ref c, at: span, by: from, as: Constant { kind: .integer, integer: r.max }),
            )
        }
    }
    let converted = from == target ? value : semantics.addConversion(
        ref c,
        from: BConversion { span: span, operand: value, type: target, kind: .numericCast },
    )
    let some = semantics.addConversion(
        ref c,
        from: BConversion { span: span, operand: converted, type: type, kind: .toOptional },
    )
    return some if fits == -1
    let none = semantics.addDefault(ref c, from: BDefault { span: span, type: type })
    return lowerExpr(
        ref c,
        through: ref l,
        for: semantics.addConditional(
            ref c,
            from: BConditional { span: span, condition: fits, whenTrue: some, whenFalse: none, type: type },
        ),
    )
}
== emitter/lowerexpr.byn
// T4: Lowerer.cs 899-1088 (`Expr`, `LowerExpr`), 1173-1375 (`ShortCircuit` .. `Call`), 1729-1794 (failure).
// T10: Lowerer.cs:910-911 (mutants, branch probes), 1089-1172 (mutant schemata, coverage) and :1760 (`CountError`).

import semantics
import emitter.ltree

type BBlockExpr        = semantics.BBlockExpr
type BBuiltinCall      = semantics.BBuiltinCall
type BCall             = semantics.BCall
type BCatch            = semantics.BCatch
type BCollection       = semantics.BCollection
type BConditional      = semantics.BConditional
type BConversion       = semantics.BConversion
type BErrorVariant     = semantics.BErrorVariant
type BField            = semantics.BField
type BIndex            = semantics.BIndex
type T4BMove           = semantics.BMove
type BRangePattern     = semantics.BRangePattern
type BSlice            = semantics.BSlice
type BTuple            = semantics.BTuple
type BTupleElement     = semantics.BTupleElement
type BUnionNew         = semantics.BUnionNew
type T4LErrorCode      = ltree.LErrorCode
type T4LErrorField     = ltree.LErrorField
type T4LFailingCall    = ltree.LFailingCall
type T4LFunctionValue  = ltree.LFunctionValue
type T4LGoto           = ltree.LGoto
type T4LIndexUnchecked = ltree.LIndexUnchecked
type T4LLabel          = ltree.LLabel
type T4LLoop           = ltree.LLoop
type T4LNever          = ltree.LNever
type T4LOptionalHas    = ltree.LOptionalHas
type T4LOptionalValue  = ltree.LOptionalValue
type T4LReturnError    = ltree.LReturnError
type T4LVoid           = ltree.LVoid
type T10LCount         = ltree.LCount
type T10LMutantIs      = ltree.LMutantIs
type T10LSequence      = ltree.LSequence
type TupleField        = semantics.TupleField

/// Lowerer.cs:899 `Expr`: the lowered form of `e`, with its statements appended to the current output list.
public BExpr lowerExpr(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    return lowerExprNode(ref c, through: ref l, for: e) if !l.showing || !l.shown.contains(e)
    var value = lowerExprNode(ref c, through: ref l, for: e)
    if semantics.exprConstant(in c, for: value) is null {
        value = spill(ref c, through: ref l, for: value)
    }
    if l.ran.contains(e) && !isNeverExpr(value) {
        let span = t2Span(in c, through: in l, for: e)
        emitAssign(
            ref c,
            through: ref l,
            to: localExpr(ref c, at: span, for: l.ran[e]),
            as: boolLiteral(ref c, at: span, by: true),
        )
    }
    l.shown[e] = value
    return value
}

/// A C# `with` copy keeps the record's `Constant` (BoundNodes.cs:27): `copy` gets `e`'s.
BExpr t4Keep(ref Ctx c, from BExpr e, to BExpr copy) uses alloc {
    if (semantics.exprConstant(in c, for: e) is { } k) {
        semantics.setConstant(ref c, for: copy, to: k)
    }
    return copy
}

/// A copy of `xs`, so the arena it lives in can grow while it is read.
List<BExpr> t4Copy(in List<BExpr> xs) uses alloc {
    var r = List<BExpr>()
    for x in xs {
        r.append(x)
    }
    return r
}

/// `new LNever(e.Syntax, e.Type)`.
BExpr t4Never(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    return ltree.addLNever(
        ref l.tree,
        from: T4LNever { span: t2Span(in c, through: in l, for: e), type: t2Type(in c, through: in l, for: e) },
    )
}

/// Lowerer.cs:908 `LowerExpr` (renamed: `lowerExpr` is `Expr`).
BExpr lowerExprNode(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    return mutantExpr(ref c, through: ref l, for: e) if mutantSwitch(in l, for: e)
    if l.covering && l.coverage.branches.contains(e) && !l.probing.contains(e) {
        l.probing[e] = true
        return branchProbe(ref c, through: ref l, for: e)
    }
    if ltree.isLowered(e) {
        panic($"cannot lower {t4TypeName(e)}")
    }
    let i = i64(e & 0xFFFFFFFF)
    let span = semantics.nodeSpan(in c, for: e)
    switch semantics.boundKind(e) {
        case .errorVariant:
            if c.bErrorVariants[i].payload.length > 0 {
                let ops = t4Copy(in c.bErrorVariants[i].payload)
                var payload = List<BExpr>()
                unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref payload) {
                    return t4Never(ref c, through: ref l, for: e)
                }
                let n = semantics.addErrorVariant(
                    ref c,
                    from: BErrorVariant { span: span, variant: c.bErrorVariants[i].variant, payload: move payload },
                )
                return t4Keep(ref c, from: e, to: n)
            }
            return e
        case .literal
            or .symbolLiteral
            or .hostTarget
            or .defaultValue
            or .thisRef
            or .enumMember
            or .enumValues
            or .staticArray:
            return e
        case .local:
            note(ref c, through: ref l, for: c.bLocals[i].local)
            return e
        case .field:
            let receiver = lowerExpr(ref c, through: ref l, for: c.bFields[i].receiver)
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(receiver)
            return t4Keep(
                ref c,
                from: e,
                to: semantics.addField(
                    ref c,
                    from: BField { span: span, receiver: receiver, field: c.bFields[i].field },
                ),
            )
        case .tupleElement:
            let receiver = lowerExpr(ref c, through: ref l, for: c.bTupleElements[i].receiver)
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(receiver)
            let n = semantics.addTupleElement(
                ref c,
                from: BTupleElement {
                    span: span,
                    receiver: receiver,
                    index: c.bTupleElements[i].index,
                    type: c.bTupleElements[i].type,
                },
            )
            return t4Keep(ref c, from: e, to: n)
        case .unionField:
            let receiver = lowerExpr(ref c, through: ref l, for: c.bUnionFields[i].receiver)
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(receiver)
            return ltree.addLUnionField(
                ref l.tree,
                from: LUnionField {
                    span: span,
                    unionValue: receiver,
                    variant: c.bUnionFields[i].variant,
                    index: c.bUnionFields[i].index,
                },
            )
        case .errorField:
            let receiver = lowerExpr(ref c, through: ref l, for: c.bErrorFields[i].receiver)
            // coverage-exempt: Q774
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(receiver)
            return ltree.addLErrorField(
                ref l.tree,
                from: T4LErrorField {
                    span: span,
                    error: receiver,
                    variant: c.bErrorFields[i].variant,
                    index: c.bErrorFields[i].index,
                },
            )
        case .call:
            return lowerCall(ref c, through: ref l, for: e)
        case .builtinCall:
            return lowerBuiltinCall(ref c, through: ref l, for: e)
        case .tryFrom:
            return lowerTryFrom(ref c, through: ref l, for: e)
        case .unary:
            let operand = lowerExpr(ref c, through: ref l, for: c.bUnaries[i].operand)
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(operand)
            return t4Keep(
                ref c,
                from: e,
                to: semantics.addUnary(
                    ref c,
                    from: BUnary { span: span, op: c.bUnaries[i].op, operand: operand, type: c.bUnaries[i].type },
                ),
            )
        case .binary:
            return lowerShortCircuit(ref c, through: ref l, for: e) if c.bBinaries[i].op is .logicalAnd or .logicalOr
            var ops = List<BExpr>()
            ops.append(c.bBinaries[i].left)
            ops.append(c.bBinaries[i].right)
            var parts = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref parts) {
                return t4Never(ref c, through: ref l, for: e)
            }
            let n = semantics.addBinary(
                ref c,
                from: BBinary {
                    span: span,
                    op: c.bBinaries[i].op,
                    left: parts[0],
                    right: parts[1],
                    type: c.bBinaries[i].type,
                },
            )
            return t4Keep(ref c, from: e, to: n)
        case .conversion:
            let kind = c.bConversions[i].kind
            let lvalue = kind is .arrayToSpan or .toDynRef
            var operand = lvalue ? lowerLvalue(
                ref c,
                through: ref l,
                for: c.bConversions[i].operand,
            ) : lowerExpr(ref c, through: ref l, for: c.bConversions[i].operand)
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(operand)
            return operand if kind == .fromNever
            return ltree.addLOptionalValue(
                ref l.tree,
                from: T4LOptionalValue { span: span, optional: operand, type: c.bConversions[i].type },
            ) if kind == .narrow
            if kind == .listToSpan && !isTrivial(in c, through: in l, for: operand) {
                operand = spill(ref c, through: ref l, for: operand)
            }
            return t4Keep(
                ref c,
                from: e,
                to: semantics.addConversion(
                    ref c,
                    from: BConversion { span: span, operand: operand, type: c.bConversions[i].type, kind: kind },
                ),
            )
        case .conditional:
            return lowerConditional(ref c, through: ref l, for: e)
        case .coalesce:
            return lowerCoalesce(ref c, through: ref l, for: e)
        case .structLiteral:
            // The fields, then a state literal's payload, in source order.
            var ops = t4Copy(in c.bStructLiterals[i].fields)
            let count = ops.length
            for p in c.bStructLiterals[i].payload {
                ops.append(p)
            }
            var values = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref values) {
                return t4Never(ref c, through: ref l, for: e)
            }
            var fields = List<BExpr>()
            var payload = List<BExpr>()
            for k in 0..values.length {
                if k < count {
                    fields.append(values[k])
                } else {
                    payload.append(values[k])
                }
            }
            let n = semantics.addStructLiteral(
                ref c,
                from: BStructLiteral {
                    span: span,
                    structId: c.bStructLiterals[i].structId,
                    fields: move fields,
                    state: c.bStructLiterals[i].state,
                    payload: move payload,
                    type: c.bStructLiterals[i].type,
                },
            )
            return t4Keep(ref c, from: e, to: n)
        case .unionNew:
            let ops = t4Copy(in c.bUnionNews[i].payload)
            var payload = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref payload) {
                return t4Never(ref c, through: ref l, for: e)
            }
            let n = semantics.addUnionNew(
                ref c,
                from: BUnionNew {
                    span: span,
                    variant: c.bUnionNews[i].variant,
                    payload: move payload,
                    type: c.bUnionNews[i].type,
                },
            )
            return t4Keep(ref c, from: e, to: n)
        case .withExpr:
            let target = lowerExpr(ref c, through: ref l, for: c.bWiths[i].target)
            return target if isNeverExpr(target)
            let copy = newTemp(ref c, through: ref l, for: c.bWiths[i].type)
            emitAssign(ref c, through: ref l, to: localExpr(ref c, at: span, for: copy), as: target)
            var fields = List<semantics.FieldId>()
            var updates = List<BExpr>()
            for u in c.bWiths[i].updates {
                fields.append(u.field)
                updates.append(u.value)
            }
            for k in 0..fields.length {
                let v = lowerExpr(ref c, through: ref l, for: updates[k])
                return t4Never(ref c, through: ref l, for: e) if isNeverExpr(v)
                let field = semantics.addField(
                    ref c,
                    from: BField { span: span, receiver: localExpr(ref c, at: span, for: copy), field: fields[k] },
                )
                emitAssign(ref c, through: ref l, to: field, as: v)
            }
            return localExpr(ref c, at: span, for: copy)
        case .tuple:
            let ops = t4Copy(in c.bTuples[i].elements)
            var elements = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref elements) {
                return t4Never(ref c, through: ref l, for: e)
            }
            return t4Keep(
                ref c,
                from: e,
                to: semantics.addTuple(
                    ref c,
                    from: BTuple { span: span, tupleType: c.bTuples[i].tupleType, elements: move elements },
                ),
            )
        case .range:
            // A range held as a value is its layout tuple; `for` over a range literal does not come here.
            var ops = List<BExpr>()
            ops.append(c.bRanges[i].start)
            ops.append(c.bRanges[i].end)
            var bounds = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref bounds) {
                return t4Never(ref c, through: ref l, for: e)
            }
            bounds.append(boolLiteral(ref c, at: span, by: c.bRanges[i].inclusive))
            let layout = semantics.rangeLayout(ref c, by: c.bRanges[i].type)
            return semantics.addTuple(ref c, from: BTuple { span: span, tupleType: layout, elements: move bounds })
        case .collection:
            return lowerCollection(ref c, through: ref l, for: e)
        case .index:
            let target0 = c.bIndexes[i].target
            let arrayTarget = semantics.kindOf(semantics.exprType(in c, for: target0)) == .array
            var ops = List<BExpr>()
            ops.append(target0)
            ops.append(c.bIndexes[i].index)
            var lvalues = List<bool>()
            lvalues.append(arrayTarget && isLvalueShape(ref c, through: ref l, for: target0))
            var parts = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in lvalues, to: ref parts) {
                return t4Never(ref c, through: ref l, for: e)
            }
            let target = arrayTarget
                && !isLvalue(
                    in c,
                    through: in l,
                    for: parts[0],
                ) ? spill(ref c, through: ref l, for: parts[0]) : parts[0]
            let n = semantics.addIndex(
                ref c,
                from: BIndex {
                    span: span,
                    target: target,
                    index: parts[1],
                    fromEnd: c.bIndexes[i].fromEnd,
                    type: c.bIndexes[i].type,
                },
            )
            return t4Keep(ref c, from: e, to: n)
        case .slice:
            return lowerSlice(ref c, through: ref l, for: e)
        case .isExpr:
            var value = lowerExpr(ref c, through: ref l, for: c.bIses[i].value)
            return t4Never(ref c, through: ref l, for: e) if isNeverExpr(value)
            let pattern = c.bIses[i].pattern
            // `x in a..=b` may compute its ends at run time (a pattern's ends are constants): the value is read first.
            if semantics.boundKind(pattern) == .rangePattern {
                let r = i64(pattern & 0xFFFFFFFF)
                if semantics.exprConstant(in c, for: c.bRangePatterns[r].start) is null
                        || semantics.exprConstant(in c, for: c.bRangePatterns[r].end) is null {
                    if semantics.exprConstant(in c, for: value) is null {
                        value = spill(ref c, through: ref l, for: value)
                    }
                    var start = lowerExpr(ref c, through: ref l, for: c.bRangePatterns[r].start)
                    unless isRepeatable(in c, through: in l, for: start) {
                        start = spill(ref c, through: ref l, for: start)
                    }
                    let end = lowerExpr(ref c, through: ref l, for: c.bRangePatterns[r].end)
                    return t4Never(ref c, through: ref l, for: e) if isNeverExpr(start) || isNeverExpr(end)
                    let copy = semantics.addRangePattern(
                        ref c,
                        from: BRangePattern {
                            span: c.bRangePatterns[r].span,
                            inputType: c.bRangePatterns[r].inputType,
                            start: start,
                            end: end,
                            inclusive: c.bRangePatterns[r].inclusive,
                        },
                    )
                    return lowerMatch(ref c, through: ref l, for: copy, at: value)
                }
            }
            unless isRepeatable(in c, through: in l, for: value) {
                value = spill(ref c, through: ref l, for: value)
            }
            return lowerMatch(ref c, through: ref l, for: pattern, at: value)
        case .switchExpr:
            return lowerSwitchExpr(ref c, through: ref l, for: e)
        case .tryExpr:
            return lowerTry(ref c, through: ref l, for: e)
        case .moveExpr:
            let operand = lowerExpr(ref c, through: ref l, for: c.bMoves[i].operand)
            return semantics.addMove(ref c, from: T4BMove { span: span, operand: operand })
        case .catchExpr:
            return lowerCatch(ref c, through: ref l, for: e)
        case .jump:
            lowerStatement(ref c, through: ref l, for: c.bJumps[i].jump)
            return t4Never(ref c, through: ref l, for: e)
        case .blockExpr:
            lowerStatement(ref c, through: ref l, for: c.bBlockExprs[i].block)
            return t4Never(ref c, through: ref l, for: e) if semantics.isNever(c.bBlockExprs[i].type)
            return ltree.addLVoid(ref l.tree, from: T4LVoid { span: span })
        case .stackalloc:
            let array = semantics.internArray(ref c, by: c.bStackallocs[i].element, at: c.bStackallocs[i].count)
            let storage = newTemp(ref c, through: ref l, for: array)
            let none = semantics.addDefault(ref c, from: BDefault { span: span, type: array })
            emit(
                ref l,
                for: semantics.addAssign(
                    ref c,
                    from: BAssign {
                        span: span,
                        target: localExpr(ref c, at: span, for: storage),
                        value: none,
                        op: null,
                    },
                ),
            )
            return semantics.addConversion(
                ref c,
                from: BConversion {
                    span: span,
                    operand: localExpr(ref c, at: span, for: storage),
                    type: c.bStackallocs[i].type,
                    kind: .arrayToSpan,
                },
            )
        case .functionRef:
            return ltree.addLFunctionValue(
                ref l.tree,
                from: T4LFunctionValue {
                    span: span,
                    function: c.bFunctionRefs[i].function,
                    env: -1,
                    functionType: c.bFunctionRefs[i].functionType,
                },
            )
        case .lambda:
            // Q1: round 4 redoes this (Lowerer.cs:1064-1075).
            return ltree.addLFunctionValue(
                ref l.tree,
                from: T4LFunctionValue {
                    span: span,
                    function: c.bLambdas[i].lambda,
                    env: -1,
                    functionType: c.bLambdas[i].functionType,
                },
            ) if c.bLambdas[i].captures.length == 0
            // The captures are copied, as the declared types of their locals, into a tuple in this frame: the environment.
            let captures = t4Copy(in c.bLambdas[i].captures)
            var fields = List<TupleField>()
            for x in captures {
                fields.append(TupleField { name: null, type: c.locals[c.bLocals[x & 0xFFFFFFFF].local].type })
            }
            let tuple = semantics.internTuple(ref c, for: in fields)
            let env = newTemp(ref c, through: ref l, for: tuple)
            var ops = List<BExpr>()
            for x in captures {
                ops.append(localExpr(ref c, at: c.bLocals[x & 0xFFFFFFFF].span, for: c.bLocals[x & 0xFFFFFFFF].local))
            }
            var values = List<BExpr>()
            // coverage-exempt: Q774
            unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref values) {
                return t4Never(ref c, through: ref l, for: e)
            }
            emitAssign(
                ref c,
                through: ref l,
                to: localExpr(ref c, at: span, for: env),
                as: semantics.addTuple(ref c, from: BTuple { span: span, tupleType: tuple, elements: move values }),
            )
            return ltree.addLFunctionValue(
                ref l.tree,
                from: T4LFunctionValue {
                    span: span,
                    function: c.bLambdas[i].lambda,
                    env: env,
                    functionType: c.bLambdas[i].functionType,
                },
            )
        case .interpolated:
            // Outside an output call the text goes into a temporary growable `StrBuf` (from `context.allocator`).
            let buf = newTemp(ref c, through: ref l, for: semantics.builtinType(.strBuf))
            let grow = semantics.addCall(
                ref c,
                from: BCall {
                    span: span,
                    function: c.builtinStrBufGrow,
                    receiver: -1,
                    arguments: List<BExpr>(),
                    type: semantics.builtinType(.strBuf),
                },
            )
            emit(
                ref l,
                for: semantics.addAssign(
                    ref c,
                    from: BAssign { span: span, target: localExpr(ref c, at: span, for: buf), value: grow, op: null },
                ),
            )
            return t4Never(
                ref c,
                through: ref l,
                for: e,
            ) if isNeverExpr(
                lowerWriteParts(
                    ref c,
                    through: ref l,
                    for: e,
                    by: .strBuf,
                    to: localExpr(ref c, at: span, for: buf),
                    as: e,
                ),
            )
            return semantics.addBuiltinCall(
                ref c,
                from: BBuiltinCall {
                    span: span,
                    member: .strBufAsString,
                    receiver: localExpr(ref c, at: span, for: buf),
                    arguments: List<BExpr>(),
                    type: semantics.prim(.string),
                },
            )
        default:
            panic($"cannot lower {t4TypeName(e)}")
    }
}

/// `e.GetType().Name` for the expressions `lowerExprNode` cannot lower.
string t4TypeName(BExpr e) {
    if ltree.isLowered(e) {
        // coverage-exempt: Q774 through `default: return $"{ltree.lKindOf(e)}"`
        switch ltree.lKindOf(e) {
            case .optionalHas: return "LOptionalHas"
            case .optionalValue: return "LOptionalValue"
            case .unionTag: return "LUnionTag"
            case .unionField: return "LUnionField"
            case .errorCode: return "LErrorCode"
            case .errorField: return "LErrorField"
            case .assignExpr: return "LAssignExpr"
            case .sequence: return "LSequence"
            case .indexUnchecked: return "LIndexUnchecked"
            case .nextChar: return "LNextChar"
            case .neverValue: return "LNever"
            case .functionValue: return "LFunctionValue"
            case .mutantIs: return "LMutantIs"
            case .count: return "LCount"
            case .voidValue: return "LVoid"
            default: return $"{ltree.lKindOf(e)}"
        }
    }
    switch semantics.boundKind(e) {
        case .spread: return "BoundSpread"
        // coverage-exempt: Q774 through `default: return $"{semantics.boundKind(e)}"`
        case .errorExpr: return "BoundErrorExpr"
        case .typeRef: return "BoundTypeRef"
        case .moduleRef: return "BoundModuleRef"
        case .methodGroup: return "BoundMethodGroup"
        case .variantGroup: return "BoundVariantGroup"
        case .builtinGroup: return "BoundBuiltinGroup"
        default: return $"{semantics.boundKind(e)}"
    }
}

// ── Mutant schemata (Lowerer.cs:1091-1142) ───────────────────────────────────

/// Lowerer.cs:1091 `MutantSwitch`: whether `node` has a mutant switch to lower (read it from `l.mutants[node]`).
bool mutantSwitch(in LCtx l, for semantics.BNode node) =>
    l.mutating && !l.plain.contains(node) && l.mutants.contains(node)

/// Lowerer.cs:1098 `MutantExpr`: `(byn_mutant == id ? mutated : original)` when no arm needs statements first; otherwise,
/// so only the selected arm's prelude runs, `if (byn_mutant == id) { pre_m; t = m } else { pre_o; t = o }`. The switch is
/// `l.mutants[key]`.
BExpr mutantExpr(ref Ctx c, through ref LCtx l, for semantics.BNode key) uses alloc {
    let span = l.mutants[key].span
    let original = l.mutants[key].original
    var ids = List<i64>()
    var nodes = List<semantics.BNode>()
    for m in l.mutants[key].mutants {
        ids.append(m.id)
        nodes.append(m.node)
    }
    l.plain[original] = true
    var armValues = List<BExpr>()
    var armPres = List<List<BStmt>>()
    for k in 0..nodes.length {
        var pre = List<BStmt>()
        armValues.append(captureExpr(ref c, through: ref l, for: nodes[k], lvalue: false, to: ref pre))
        armPres.append(move pre)
    }
    var plainPre = List<BStmt>()
    let plainValue = captureExpr(ref c, through: ref l, for: original, lvalue: false, to: ref plainPre)
    let type = t2Type(in c, through: in l, for: original)
    // coverage-exempt: Q1099
    var simple = plainPre.length == 0 && !isNeverExpr(plainValue) && !semantics.isNever(type)
    for k in 0..armValues.length {
        // coverage-exempt: Q1099
        if armPres[k].length != 0 || isNeverExpr(armValues[k]) {
            simple = false
        }
    }
    if simple {
        var value = plainValue
        var i = armValues.length - 1
        while i >= 0 {
            let probe = ltree.addLMutantIs(ref l.tree, from: T10LMutantIs { span: span, id: ids[i] })
            value = semantics.addConditional(
                ref c,
                from: BConditional {
                    span: span,
                    condition: probe,
                    whenTrue: armValues[i],
                    whenFalse: value,
                    type: type,
                },
            )
            i -= 1
        }
        let _ = l.plain.remove(key: original)
        return value
    }
    let result = newTemp(ref c, through: ref l, for: type)
    let target = localExpr(ref c, at: span, for: result)
    captureBegin(ref l)
    for s in plainPre {
        emit(ref l, for: s)
    }
    emitAssign(ref c, through: ref l, to: target, as: plainValue)
    let plainArm = captureEnd(ref l)
    var chain = block(ref c, at: span, for: move plainArm)
    var i = armValues.length - 1
    while i >= 0 {
        captureBegin(ref l)
        for s in armPres[i] {
            emit(ref l, for: s)
        }
        emitAssign(ref c, through: ref l, to: target, as: armValues[i])
        let arm = captureEnd(ref l)
        var rest = List<BStmt>()
        rest.append(chain)
        let probe = ltree.addLMutantIs(ref l.tree, from: T10LMutantIs { span: span, id: ids[i] })
        chain = semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: probe,
                then: block(ref c, at: span, for: move arm),
                elseBranch: block(ref c, at: span, for: move rest),
            },
        )
        i -= 1
    }
    emit(ref l, for: chain)
    let _ = l.plain.remove(key: original)
    // coverage-exempt: Q1099
    return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: type }) if semantics.isNever(type)
    return target
}

/// Lowerer.cs:1128 `MutantStatement`: `if (byn_mutant == id) { mutated } else { original }`, each arm lowered on its own.
/// The switch is `l.mutants[key]`.
void mutantStatement(ref Ctx c, through ref LCtx l, for semantics.BNode key) uses alloc {
    let span = l.mutants[key].span
    let original = l.mutants[key].original
    var ids = List<i64>()
    var nodes = List<semantics.BNode>()
    for m in l.mutants[key].mutants {
        ids.append(m.id)
        nodes.append(m.node)
    }
    l.plain[original] = true
    captureBegin(ref l)
    lowerStatement(ref c, through: ref l, for: original)
    let plainArm = captureEnd(ref l)
    var chain = block(ref c, at: span, for: move plainArm)
    var i = nodes.length - 1
    while i >= 0 {
        captureBegin(ref l)
        lowerStatement(ref c, through: ref l, for: nodes[i])
        let arm = captureEnd(ref l)
        var rest = List<BStmt>()
        rest.append(chain)
        let probe = ltree.addLMutantIs(ref l.tree, from: T10LMutantIs { span: span, id: ids[i] })
        chain = semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: probe,
                then: block(ref c, at: span, for: move arm),
                elseBranch: block(ref c, at: span, for: move rest),
            },
        )
        i -= 1
    }
    emit(ref l, for: chain)
    let _ = l.plain.remove(key: original)
}

// ── Coverage (Lowerer.cs:1143-1171) ──────────────────────────────────────────

/// Lowerer.cs:1146 `BranchProbe`: `(c ? (byn_cov[t]++, true) : (byn_cov[f]++, false))`: the condition counts its outcome.
BExpr branchProbe(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let whenTrue = l.coverage.branches[e].whenTrue
    let whenFalse = l.coverage.branches[e].whenFalse
    let value = lowerExprNode(ref c, through: ref l, for: e)
    if isNeverExpr(value) {
        let _ = l.probing.remove(key: e)
        return value
    }
    let span = t2Span(in c, through: in l, for: e)
    let probe = semantics.addConditional(ref c, from: BConditional {
        span: span,
        condition: value,
        whenTrue: t10Outcome(ref c, through: ref l, at: span, for: whenTrue, by: true),
        whenFalse: t10Outcome(ref c, through: ref l, at: span, for: whenFalse, by: false),
        type: semantics.prim(.bool),
    })
    let _ = l.probing.remove(key: e)
    return probe
}

/// Lowerer.cs:1154 `Outcome` (a local function of `BranchProbe`).
BExpr t10Outcome(ref Ctx c, through ref LCtx l, at TextSpan span, for i64 id, by bool outcome) uses alloc {
    var effects = List<BExpr>()
    effects.append(ltree.addLCount(ref l.tree, from: T10LCount { span: span, id: id }))
    return ltree.addLSequence(
        ref l.tree,
        from: T10LSequence { span: span, effects: move effects, value: boolLiteral(ref c, at: span, by: outcome) },
    )
}

/// Lowerer.cs:1161 `CountError`: on the error-return edge of `origin`, the counter of the variant in `error`.
void countError(ref Ctx c, through ref LCtx l, for semantics.BNode origin, by LocalId error) uses alloc {
    return if !l.covering || !l.coverage.errors.contains(origin)
    let syntax = l.coverage.errors[origin].span
    var variants = List<VariantId>()
    var ids = List<i64>()
    for v in l.coverage.errors[origin].variants {
        variants.append(v.variant)
        ids.append(v.id)
    }
    for k in 0..variants.length {
        let code = Constant { kind: .integer, integer: Big { lo: u64(c.errorVariants[variants[k]].code), hi: 0 } }
        let literal = semantics.addLiteral(
            ref c,
            from: BLiteral { span: syntax, type: semantics.prim(.u32), value: code },
        )
        semantics.setConstant(ref c, for: literal, to: code)
        let errorCode = ltree.addLErrorCode(
            ref l.tree,
            from: T4LErrorCode { span: syntax, error: localExpr(ref c, at: syntax, for: error) },
        )
        let probe = lowerEqual(ref c, at: syntax, for: errorCode, by: literal)
        var counted = List<BStmt>()
        counted.append(
            semantics.addExprStmt(
                ref c,
                from: BExprStmt {
                    span: syntax,
                    expr: ltree.addLCount(ref l.tree, from: T10LCount { span: syntax, id: ids[k] }),
                },
            ),
        )
        emit(
            ref l,
            for: semantics.addIf(
                ref c,
                from: BIf {
                    span: syntax,
                    condition: probe,
                    then: block(ref c, at: syntax, for: move counted),
                    elseBranch: -1,
                },
            ),
        )
    }
}

/// Lowerer.cs:1173 `ShortCircuit`.
BExpr lowerShortCircuit(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bBinaries[i].span
    let left = lowerExpr(ref c, through: ref l, for: c.bBinaries[i].left)
    return left if isNeverExpr(left)
    var pre = List<BStmt>()
    let right = captureExpr(ref c, through: ref l, for: c.bBinaries[i].right, lvalue: false, to: ref pre)
    // coverage-exempt: Q774
    return t4Keep(
        ref c,
        from: e,
        to: semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: c.bBinaries[i].op, left: left, right: right, type: c.bBinaries[i].type },
        ),
    ) if pre.length == 0
        && !isNeverExpr(right)
    // `t = left; if (t) { pre; t = right; }` for &&, `if (!t)` for ||.
    let t = newTemp(ref c, through: ref l, for: semantics.prim(.bool))
    emitAssign(ref c, through: ref l, to: localExpr(ref c, at: span, for: t), as: left)
    pre.append(
        semantics.addAssign(
            ref c,
            from: BAssign { span: span, target: localExpr(ref c, at: span, for: t), value: right, op: null },
        ),
    )
    if isNeverExpr(right) {
        let _ = pre.removeLast()
    }
    var cond = localExpr(ref c, at: span, for: t)
    if c.bBinaries[i].op == .logicalOr {
        cond = notExpr(ref c, through: in l, for: cond)
    }
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf { span: span, condition: cond, then: block(ref c, at: span, for: move pre), elseBranch: -1 },
        ),
    )
    return localExpr(ref c, at: span, for: t)
}

/// Lowerer.cs:1190 `Conditional`.
BExpr lowerConditional(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bConditionals[i].span
    let type = c.bConditionals[i].type
    let condition = lowerExpr(ref c, through: ref l, for: c.bConditionals[i].condition)
    return condition if isNeverExpr(condition)
    var preTrue = List<BStmt>()
    let whenTrue = captureExpr(ref c, through: ref l, for: c.bConditionals[i].whenTrue, lvalue: false, to: ref preTrue)
    var preFalse = List<BStmt>()
    let whenFalse = captureExpr(
        ref c,
        through: ref l,
        for: c.bConditionals[i].whenFalse,
        lvalue: false,
        to: ref preFalse,
    )
    // coverage-exempt: Q774 through `return t4Keep(ref c, from: e, to: semantics.addConditional(`
    if preTrue.length == 0 && preFalse.length == 0 && !isNeverExpr(whenTrue) && !isNeverExpr(whenFalse)
            && !semantics.isNever(t2Type(in c, through: in l, for: whenTrue))
            && !semantics.isNever(t2Type(in c, through: in l, for: whenFalse)) {
        return t4Keep(
            ref c,
            from: e,
            to: semantics.addConditional(
                ref c,
                from: BConditional {
                    span: span,
                    condition: condition,
                    whenTrue: whenTrue,
                    whenFalse: whenFalse,
                    type: type,
                },
            ),
        )
    }
    let result = newTemp(ref c, through: ref l, for: type)
    let target = localExpr(ref c, at: span, for: result)
    captureBegin(ref l)
    for s in preTrue {
        emit(ref l, for: s)
    }
    emitAssign(ref c, through: ref l, to: target, as: whenTrue)
    let t = captureEnd(ref l)
    captureBegin(ref l)
    for s in preFalse {
        emit(ref l, for: s)
    }
    emitAssign(ref c, through: ref l, to: target, as: whenFalse)
    let f = captureEnd(ref l)
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: condition,
                then: block(ref c, at: span, for: move t),
                elseBranch: block(ref c, at: span, for: move f),
            },
        ),
    )
    return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: type }) if semantics.isNever(type)
    return target
}

/// Lowerer.cs:1207 `Coalesce` (Q844): the lowered `??` expression `e`, with its statements appended to the current output list.
public BExpr lowerCoalesce(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bCoalesces[i].span
    let type = c.bCoalesces[i].type
    var left = lowerExpr(ref c, through: ref l, for: c.bCoalesces[i].left)
    return left if isNeverExpr(left)
    unless isRepeatable(in c, through: in l, for: left) {
        left = spill(ref c, through: ref l, for: left)
    }
    let keepsOptional = semantics.kindOf(type) == .optional
    let inner = c.optionalTypes[i64(semantics.exprType(in c, for: c.bCoalesces[i].left) & 0xFFFFFFFF)]
    let present = keepsOptional ? left : ltree.addLOptionalValue(
        ref l.tree,
        from: T4LOptionalValue { span: span, optional: left, type: inner },
    )
    var pre = List<BStmt>()
    let right = captureExpr(ref c, through: ref l, for: c.bCoalesces[i].right, lvalue: false, to: ref pre)
    // coverage-exempt: Q774
    if pre.length == 0 && !isNeverExpr(right) && !semantics.isNever(t2Type(in c, through: in l, for: right)) {
        let has = ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: left })
        return semantics.addConditional(
            ref c,
            from: BConditional { span: span, condition: has, whenTrue: present, whenFalse: right, type: type },
        )
    }
    let result = newTemp(ref c, through: ref l, for: type)
    let target = localExpr(ref c, at: span, for: result)
    captureBegin(ref l)
    for s in pre {
        emit(ref l, for: s)
    }
    emitAssign(ref c, through: ref l, to: target, as: right)
    var missing = captureEnd(ref l)
    var found = List<BStmt>()
    found.append(semantics.addAssign(ref c, from: BAssign { span: span, target: target, value: present, op: null }))
    let has = ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: left })
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: has,
                then: block(ref c, at: span, for: move found),
                elseBranch: block(ref c, at: span, for: move missing),
            },
        ),
    )
    return target
}

/// Lowerer.cs:1225 `Collection`.
BExpr lowerCollection(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bCollections[i].span
    let type = c.bCollections[i].type
    let elements0 = t4Copy(in c.bCollections[i].elements)
    switch semantics.kindOf(type) {
        case .list:
            return e if elements0.length == 0
            let list = newTemp(ref c, through: ref l, for: type)
            let empty = t4Keep(
                ref c,
                from: e,
                to: semantics.addCollection(
                    ref c,
                    from: BCollection { span: span, type: type, elements: List<BExpr>() },
                ),
            )
            emitAssign(ref c, through: ref l, to: localExpr(ref c, at: span, for: list), as: empty)
            for element in elements0 {
                let spread = semantics.boundKind(element) == .spread
                let v = lowerExpr(
                    ref c,
                    through: ref l,
                    for: spread ? c.bSpreads[i64(element & 0xFFFFFFFF)].operand : element,
                )
                return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: type }) if isNeverExpr(v)
                if spread {
                    lowerAddEach(
                        ref c,
                        through: ref l,
                        for: element,
                        from: spill(ref c, through: ref l, for: v),
                        to: list,
                        at: span,
                    )
                    continue
                }
                var args = List<BExpr>()
                args.append(v)
                let add = semantics.addBuiltinCall(
                    ref c,
                    from: BBuiltinCall {
                        span: span,
                        member: .listAdd,
                        receiver: localExpr(ref c, at: span, for: list),
                        arguments: move args,
                        type: semantics.prim(.void),
                    },
                )
                emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: add }))
            }
            return localExpr(ref c, at: span, for: list)
        case .map:
            return e if elements0.length == 0
            let map = newTemp(ref c, through: ref l, for: type)
            let empty = t4Keep(
                ref c,
                from: e,
                to: semantics.addCollection(
                    ref c,
                    from: BCollection { span: span, type: type, elements: List<BExpr>() },
                ),
            )
            emitAssign(ref c, through: ref l, to: localExpr(ref c, at: span, for: map), as: empty)
            let valueType = c.mapTypes[i64(type & 0xFFFFFFFF)].value
            var k: i64 = 0
            while k < elements0.length {
                var ops = List<BExpr>()
                ops.append(elements0[k])
                ops.append(elements0[k + 1])
                var entry = List<BExpr>()
                unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref entry) {
                    return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: type })
                }
                var args = List<BExpr>()
                args.append(entry[0])
                let slot = semantics.addBuiltinCall(
                    ref c,
                    from: BBuiltinCall {
                        span: span,
                        member: .mapIndexSet,
                        receiver: localExpr(ref c, at: span, for: map),
                        arguments: move args,
                        type: valueType,
                    },
                )
                emit(
                    ref l,
                    for: semantics.addAssign(
                        ref c,
                        from: BAssign { span: span, target: slot, value: entry[1], op: null },
                    ),
                )
                k += 2
            }
            return localExpr(ref c, at: span, for: map)
        case .span:
            return semantics.addDefault(ref c, from: BDefault { span: span, type: type }) if elements0.length == 0
            var elements = List<BExpr>()
            let ok = t4AnySpread(
                in c,
                for: in elements0,
            ) ? lowerExpanded(
                ref c,
                through: ref l,
                for: in elements0,
                to: ref elements,
            ) : operands(ref c, through: ref l, for: in elements0, as: in List<bool>(), to: ref elements)
            unless ok {
                return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: type })
            }
            let array = semantics.internArray(
                ref c,
                by: c.spanTypes[i64(type & 0xFFFFFFFF)].element,
                at: elements.length,
            )
            let storage = newTemp(ref c, through: ref l, for: array)
            emitAssign(
                ref c,
                through: ref l,
                to: localExpr(ref c, at: span, for: storage),
                as: semantics.addCollection(
                    ref c,
                    from: BCollection { span: span, type: array, elements: move elements },
                ),
            )
            return semantics.addConversion(
                ref c,
                from: BConversion {
                    span: span,
                    operand: localExpr(ref c, at: span, for: storage),
                    type: type,
                    kind: .arrayToSpan,
                },
            )
        default:
            var elements = List<BExpr>()
            let ok = t4AnySpread(
                in c,
                for: in elements0,
            ) ? lowerExpanded(
                ref c,
                through: ref l,
                for: in elements0,
                to: ref elements,
            ) : operands(ref c, through: ref l, for: in elements0, as: in List<bool>(), to: ref elements)
            unless ok {
                return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: type })
            }
            return t4Keep(
                ref c,
                from: e,
                to: semantics.addCollection(
                    ref c,
                    from: BCollection { span: span, type: type, elements: move elements },
                ),
            )
    }
}

/// `c.Elements.Any(e => e is BoundSpread)`.
bool t4AnySpread(in Ctx c, for in List<BExpr> elements) {
    for x in elements {
        return true if semantics.boundKind(x) == .spread
    }
    return false
}

/// Lowerer.cs:1284 `Expanded`: the elements of an array or span literal with each spread fixed array replaced by its
/// elements, evaluated left to right: every operand that is not trivial is stored first. False for C#'s null.
bool lowerExpanded(ref Ctx c, through ref LCtx l, for in List<BExpr> elements, to ref List<BExpr> values) uses alloc {
    for element in elements {
        let spread = semantics.boundKind(element) == .spread
        let s = i64(element & 0xFFFFFFFF)
        let v = lowerExpr(ref c, through: ref l, for: spread ? c.bSpreads[s].operand : element)
        return false if isNeverExpr(v)
        if spread {
            let source = spill(ref c, through: ref l, for: v)
            let length = c.arrayTypes[i64(semantics.exprType(in c, for: c.bSpreads[s].operand) & 0xFFFFFFFF)].length
            for k in 0..length {
                let index = i64Literal(ref c, at: c.bSpreads[s].span, by: k)
                values.append(
                    ltree.addLIndexUnchecked(
                        ref l.tree,
                        from: T4LIndexUnchecked {
                            span: c.bSpreads[s].span,
                            target: source,
                            index: index,
                            type: c.bSpreads[s].type,
                        },
                    ) because "k is below the fixed length of the array being spread",
                )
            }
            continue
        }
        values.append(isTrivial(in c, through: in l, for: v) ? v : spill(ref c, through: ref l, for: v))
    }
    return true
}

/// Lowerer.cs:1305 `AddEach` (D5): `ListAdd`s each element of the list, span or array in `source`, in order, to `list`.
/// The C# `add` lambda's one caller (Lowerer.cs:1240) adds to the list temporary, so that is the body here; `at` is
/// the collection's span, the lambda's `c.Syntax`.
void lowerAddEach(
    ref Ctx c,
    through ref LCtx l,
    for BExpr spread,
    from BExpr source,
    to LocalId list,
    at TextSpan outer
) uses alloc {
    let s = i64(spread & 0xFFFFFFFF)
    let span = c.bSpreads[s].span
    var lengthMember = semantics.BuiltinMember.arrayLength
    switch semantics.kindOf(t2Type(in c, through: in l, for: source)) {
        case .span: lengthMember = .spanLength
        case .list: lengthMember = .listLength
        default: break
    }
    let index = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
    emitAssign(
        ref c,
        through: ref l,
        to: localExpr(ref c, at: span, for: index),
        as: i64Literal(ref c, at: span, by: 0),
    )
    let done = newLabel(ref l, for: "break")
    captureBegin(ref l)
    let length = semantics.addBuiltinCall(
        ref c,
        from: BBuiltinCall {
            span: span,
            member: lengthMember,
            receiver: source,
            arguments: List<BExpr>(),
            type: semantics.prim(.i64),
        },
    )
    let more = semantics.addBinary(
        ref c,
        from: BBinary {
            span: span,
            op: .lt,
            left: localExpr(ref c, at: span, for: index),
            right: length,
            type: semantics.prim(.bool),
        },
    )
    var exit = List<BStmt>()
    exit.append(ltree.addLGoto(ref l.tree, from: T4LGoto { span: span, label: done }))
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: notExpr(ref c, through: in l, for: more),
                then: block(ref c, at: span, for: move exit),
                elseBranch: -1,
            },
        ),
    )
    var args = List<BExpr>()
    args.append(
        ltree.addLIndexUnchecked(
            ref l.tree,
            from: T4LIndexUnchecked {
                span: span,
                target: source,
                index: localExpr(ref c, at: span, for: index),
                type: c.bSpreads[s].type,
            },
        ) because "the loop leaves before index reaches the source length",
    )
    let add = semantics.addBuiltinCall(
        ref c,
        from: BBuiltinCall {
            span: outer,
            member: .listAdd,
            receiver: localExpr(ref c, at: outer, for: list),
            arguments: move args,
            type: semantics.prim(.void),
        },
    )
    emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: outer, expr: add }))
    let next = semantics.addBinary(
        ref c,
        from: BBinary {
            span: span,
            op: .addWrap,
            left: localExpr(ref c, at: span, for: index),
            right: i64Literal(ref c, at: span, by: 1),
            type: semantics.prim(.i64),
        },
    )
    emit(
        ref l,
        for: semantics.addAssign(
            ref c,
            from: BAssign { span: span, target: localExpr(ref c, at: span, for: index), value: next, op: null },
        ),
    )
    var body = captureEnd(ref l)
    emit(
        ref l,
        for: ltree.addLLoop(ref l.tree, from: T4LLoop { span: span, body: block(ref c, at: span, for: move body) }),
    )
    emit(ref l, for: ltree.addLLabel(ref l.tree, from: T4LLabel { span: span, name: done }))
}

/// Lowerer.cs:1330 `Slice`.
BExpr lowerSlice(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bSlices[i].span
    let target0 = c.bSlices[i].target
    var ops = List<BExpr>()
    ops.append(target0)
    if c.bSlices[i].start != -1 {
        ops.append(c.bSlices[i].start)
    }
    if c.bSlices[i].end != -1 {
        ops.append(c.bSlices[i].end)
    }
    let arrayTarget = semantics.kindOf(semantics.exprType(in c, for: target0)) == .array
    var lvalues = List<bool>()
    lvalues.append(arrayTarget && isLvalueShape(ref c, through: ref l, for: target0))
    var parts = List<BExpr>()
    unless operands(ref c, through: ref l, for: in ops, as: in lvalues, to: ref parts) {
        return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: c.bSlices[i].type })
    }
    var target = arrayTarget
        && !isLvalue(in c, through: in l, for: parts[0]) ? spill(ref c, through: ref l, for: parts[0]) : parts[0]
    if !isTrivial(in c, through: in l, for: target) && !arrayTarget {
        target = spill(ref c, through: ref l, for: target)
    }
    var k: i64 = 1
    var start: BExpr = -1
    if c.bSlices[i].start != -1 {
        start = parts[k]
        k += 1
    }
    let end = c.bSlices[i].end == -1 ? -1 : parts[k]
    let n = semantics.addSlice(
        ref c,
        from: BSlice {
            span: span,
            target: target,
            start: start,
            startFromEnd: c.bSlices[i].startFromEnd,
            end: end,
            endFromEnd: c.bSlices[i].endFromEnd,
            inclusive: c.bSlices[i].inclusive,
            type: c.bSlices[i].type,
        },
    )
    return t4Keep(ref c, from: e, to: n)
}

/// Lowerer.cs:1346 `Call`.
BExpr lowerCall(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bCalls[i].span
    let fn = c.bCalls[i].function
    switch c.functions[fn].builtin {
        case .print:
            if semantics.boundKind(c.bCalls[i].arguments[0]) == .interpolated {
                // The stream is the target, as a log level is.
                return lowerWriteParts(
                    ref c,
                    through: ref l,
                    for: e,
                    by: .print,
                    to: -1,
                    as: c.bCalls[i].arguments[0],
                    at: c.bCalls[i].arguments[1],
                )
            }
        case .log:
            if semantics.boundKind(c.bCalls[i].arguments[0]) == .interpolated {
                // The level is the target, evaluated after the text's parts as in the plain-string call.
                return lowerWriteParts(
                    ref c,
                    through: ref l,
                    for: e,
                    by: .log,
                    to: -1,
                    as: c.bCalls[i].arguments[0],
                    at: c.bCalls[i].arguments[1],
                )
            }
        case .panic:
            if semantics.boundKind(c.bCalls[i].arguments[0]) == .interpolated {
                let _ = lowerWrite(ref c, through: ref l, for: e, by: .panic, to: -1, as: c.bCalls[i].arguments[0])
                return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: c.bCalls[i].type })
            }
        default: break
    }
    if c.functions[fn].hasFails {
        panic($"call of failing `{c.functions[fn].name}` outside try/catch")
    }
    let lowered = lowerCallParts(ref c, through: ref l, for: e)
    return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: c.bCalls[i].type }) if lowered == -1
    if semantics.isNever(c.bCalls[i].type) {
        emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: lowered }))
        return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: c.bCalls[i].type })
    }
    if semantics.isVoid(c.bCalls[i].type) {
        emit(ref l, for: semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: lowered }))
        return ltree.addLVoid(ref l.tree, from: T4LVoid { span: span })
    }
    return lowered
}

// ── Failure ──────────────────────────────────────────────────────────────────

/// Lowerer.cs:1732 `FailingCall` (Q845): the error temporary and the result of the lowered failing call `operand`, or
/// null when an operand never returns.
public (LocalId error, BExpr result)? lowerFailingCall(ref Ctx c, through ref LCtx l, for BExpr operand) uses alloc {
    let i = i64(operand & 0xFFFFFFFF)
    let span = c.bCalls[i].span
    let fn = c.bCalls[i].function
    // A `requires` check takes the built value as `this`; the value, not the void call, is the result.
    // coverage-exempt: Q774
    if c.functions[fn].name == "requires" && c.functions[fn].owner != -1 {
        let value = spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: c.bCalls[i].receiver))
        return null if isNeverExpr(value)
        let sets = t4Copy(in c.functions[fn].errorSets)
        let check = newTemp(
            ref c,
            through: ref l,
            for: semantics.errorUnionOf(ref c, for: in sets, as: in List<VariantId>()),
        )
        let args = t4Copy(in c.bCalls[i].arguments)
        let call = t4Keep(
            ref c,
            from: operand,
            to: semantics.addCall(
                ref c,
                from: BCall { span: span, function: fn, receiver: value, arguments: move args, type: c.bCalls[i].type },
            ),
        )
        emit(
            ref l,
            for: ltree.addLFailingCall(
                ref l.tree,
                from: T4LFailingCall { span: span, error: check, call: call, result: -1 },
            ),
        )
        return (error: check, result: value)
    }
    let lowered = lowerCallParts(ref c, through: ref l, for: operand)
    return null if lowered == -1
    let sets = t4Copy(in c.functions[fn].errorSets)
    let error = newTemp(
        ref c,
        through: ref l,
        for: semantics.errorUnionOf(ref c, for: in sets, as: in List<VariantId>()),
    )
    let type = c.bCalls[i].type
    let result = semantics.isVoid(type) || semantics.isNever(type) ? -1 : newTemp(ref c, through: ref l, for: type)
    emit(
        ref l,
        for: ltree.addLFailingCall(
            ref l.tree,
            from: T4LFailingCall { span: span, error: error, call: lowered, result: result },
        ),
    )
    return (error: error, result: ltree.addLVoid(ref l.tree, from: T4LVoid { span: span })) if result == -1
    return (error: error, result: localExpr(ref c, at: span, for: result))
}

/// Lowerer.cs:1752 `Failed` (Q845): the condition that holds when the error in `error` is set.
public BExpr lowerFailed(ref Ctx c, through ref LCtx l, at TextSpan span, for LocalId error) uses alloc {
    let code = ltree.addLErrorCode(
        ref l.tree,
        from: T4LErrorCode { span: span, error: localExpr(ref c, at: span, for: error) },
    )
    let zero = semantics.addLiteral(
        ref c,
        from: BLiteral {
            span: span,
            type: semantics.prim(.u32),
            value: Constant { kind: .integer, integer: Big { lo: 0, hi: 0 } },
        },
    )
    return semantics.addBinary(
        ref c,
        from: BBinary { span: span, op: .ne, left: code, right: zero, type: semantics.prim(.bool) },
    )
}

/// Lowerer.cs:1756 `Propagate`: runs the cleanups (errdefers included) and fails the function with `error`; `span` is
/// `origin`'s.
List<BStmt> lowerPropagate(ref Ctx c, through ref LCtx l, at TextSpan span, for LocalId error, by BExpr origin)
        uses alloc {
    captureBegin(ref l)
    emitCleanups(ref c, through: ref l, at: 0, for: error)
    countError(ref c, through: ref l, for: origin, by: error)
    emit(
        ref l,
        for: ltree.addLReturnError(
            ref l.tree,
            from: T4LReturnError { span: span, code: localExpr(ref c, at: span, for: error) },
        ),
    )
    return captureEnd(ref l)
}

/// Lowerer.cs:1764 `Try`.
BExpr lowerTry(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bTries[i].span
    let r = lowerFailingCall(ref c, through: ref l, for: c.bTries[i].operand)
        ?? return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: c.bTries[i].type })
    let propagate = lowerPropagate(ref c, through: ref l, at: span, for: r.error, by: e)
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: lowerFailed(ref c, through: ref l, at: span, for: r.error),
                then: block(ref c, at: span, for: move propagate),
                elseBranch: -1,
            },
        ),
    )
    return r.result
}

/// Lowerer.cs:1771 `Catch`.
BExpr lowerCatch(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    let i = i64(e & 0xFFFFFFFF)
    let span = c.bCatches[i].span
    let r = lowerFailingCall(ref c, through: ref l, for: c.bCatches[i].operand)
        ?? return ltree.addLNever(ref l.tree, from: T4LNever { span: span, type: c.bCatches[i].type })
    // coverage-exempt: Q774
    let target = !ltree.isLowered(r.result) && semantics.boundKind(r.result) == .local ? r.result : -1
    captureBegin(ref l)
    let binding = c.bCatches[i].binding
    if binding != -1 {
        note(ref c, through: ref l, for: binding)
        emit(
            ref l,
            for: semantics.addAssign(
                ref c,
                from: BAssign {
                    span: span,
                    target: localExpr(ref c, at: span, for: binding),
                    value: localExpr(ref c, at: span, for: r.error),
                    op: null,
                },
            ),
        )
    }
    let h = lowerExpr(ref c, through: ref l, for: c.bCatches[i].handler)
    if target != -1 {
        emitAssign(ref c, through: ref l, to: target, as: h)
    } else {
        emitEffect(ref c, through: ref l, for: h)
    }
    var handler = captureEnd(ref l)
    let variant = c.bCatches[i].variant
    if variant != -1 {
        let caught = semantics.addErrorVariant(ref c, from: BErrorVariant { span: span, variant: variant })
        let other = semantics.addBinary(
            ref c,
            from: BBinary {
                span: span,
                op: .ne,
                left: localExpr(ref c, at: span, for: r.error),
                right: caught,
                type: semantics.prim(.bool),
            },
        )
        let propagate = lowerPropagate(ref c, through: ref l, at: span, for: r.error, by: e)
        var checkedBody = List<BStmt>()
        checkedBody.append(
            semantics.addIf(
                ref c,
                from: BIf {
                    span: span,
                    condition: other,
                    then: block(ref c, at: span, for: move propagate),
                    elseBranch: -1,
                },
            ),
        )
        for s in handler {
            checkedBody.append(s)
        }
        handler = move checkedBody
    }
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf {
                span: span,
                condition: lowerFailed(ref c, through: ref l, at: span, for: r.error),
                then: block(ref c, at: span, for: move handler),
                elseBranch: -1,
            },
        ),
    )
    return r.result
}
== emitter/lowerpat.byn
// T4: Lowerer.cs 1796-1926 (`Match`, `Claim`, `Step`, `Equal`).

import semantics
import emitter.ltree

type T4LAssignExpr = ltree.LAssignExpr
type BBindPattern  = semantics.BBindPattern
type BMemberStep   = semantics.BMemberStep
type T4LClaim      = ltree.LClaim
type T4LSequence   = ltree.LSequence

/// Lowerer.cs:1799 `Match`: the condition that holds when `subject` matches `pattern`, binding as it goes.
public BExpr lowerMatch(ref Ctx c, through ref LCtx l, for BPattern pattern, at BExpr subject) uses alloc {
    let value = subject
    let i = i64(pattern & 0xFFFFFFFF)
    let valueType = t2Type(in c, through: in l, for: value)
    let optional = semantics.kindOf(valueType) == .optional
    switch semantics.boundKind(pattern) {
        case .bindPattern:
            let span = c.bBindPatterns[i].span
            let local = c.bBindPatterns[i].local
            return boolLiteral(ref c, at: span, by: true) if local == -1
            note(ref c, through: ref l, for: local)
            return t4Bind(ref c, through: ref l, at: span, for: local, as: value)
        case .constantPattern:
            let span = c.bConstantPatterns[i].span
            let constant = c.bConstantPatterns[i].value
            // coverage-exempt: Q774
            return notExpr(
                ref c,
                through: in l,
                for: ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: value }),
            ) if !ltree.isLowered(constant)
                && semantics.boundKind(constant) == .defaultValue
                && optional
            // coverage-exempt: Q774
            if optional && semantics.kindOf(t2Type(in c, through: in l, for: constant)) != .optional {
                let has = ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: value })
                let eq = lowerEqual(
                    ref c,
                    at: span,
                    for: t4Inner(ref c, through: ref l, at: span, for: value),
                    by: constant,
                )
                return andExpr(ref c, through: in l, for: has, by: eq)
            }
            return lowerEqual(ref c, at: span, for: value, by: constant)
        case .relationalPattern:
            let span = c.bRelationalPatterns[i].span
            let v = optional ? t4Inner(ref c, through: ref l, at: span, for: value) : value
            let cond = semantics.addBinary(
                ref c,
                from: BBinary {
                    span: span,
                    op: c.bRelationalPatterns[i].op,
                    left: v,
                    right: c.bRelationalPatterns[i].value,
                    type: semantics.prim(.bool),
                },
            )
            unless optional {
                return cond
            }
            return andExpr(
                ref c,
                through: in l,
                for: ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: value }),
                by: cond,
            )
        case .rangePattern:
            let span = c.bRangePatterns[i].span
            let v = optional ? t4Inner(ref c, through: ref l, at: span, for: value) : value
            let low = semantics.addBinary(
                ref c,
                from: BBinary {
                    span: span,
                    op: .ge,
                    left: v,
                    right: c.bRangePatterns[i].start,
                    type: semantics.prim(.bool),
                },
            )
            let high = semantics.addBinary(
                ref c,
                from: BBinary {
                    span: span,
                    op: c.bRangePatterns[i].inclusive ? .le : .lt,
                    left: v,
                    right: c.bRangePatterns[i].end,
                    type: semantics.prim(.bool),
                },
            )
            let cond = andExpr(ref c, through: in l, for: low, by: high)
            unless optional {
                return cond
            }
            return andExpr(
                ref c,
                through: in l,
                for: ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: value }),
                by: cond,
            )
        case .notPattern:
            return notExpr(
                ref c,
                through: in l,
                for: lowerMatch(ref c, through: ref l, for: c.bNotPatterns[i].operand, at: value),
            )
        case .binaryPattern:
            let left = lowerMatch(ref c, through: ref l, for: c.bBinaryPatterns[i].left, at: value)
            let right = lowerMatch(ref c, through: ref l, for: c.bBinaryPatterns[i].right, at: value)
            return andExpr(ref c, through: in l, for: left, by: right) if c.bBinaryPatterns[i].isAnd
            return orExpr(ref c, through: in l, for: left, by: right)
        case .propertyPattern:
            let span = c.bPropertyPatterns[i].span
            var tests = List<BExpr>()
            var target = value
            if optional {
                tests.append(ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: value }))
                target = t4Inner(ref c, through: ref l, at: span, for: value)
            }
            var k: i64 = 0
            while k < c.bPropertyPatterns[i].subpatterns.length {
                var member = target
                var s: i64 = 0
                while s < c.bPropertyPatterns[i].subpatterns[k].path.length {
                    member = lowerStep(ref c, at: span, for: member, by: c.bPropertyPatterns[i].subpatterns[k].path[s])
                    s += 1
                }
                tests.append(
                    lowerMatch(ref c, through: ref l, for: c.bPropertyPatterns[i].subpatterns[k].pattern, at: member),
                )
                k += 1
            }
            let d = c.bPropertyPatterns[i].designation
            if d != -1 {
                note(ref c, through: ref l, for: d)
                tests.append(t4Bind(ref c, through: ref l, at: span, for: d, as: target))
            }
            return boolLiteral(ref c, at: span, by: true) if tests.length == 0
            return t4All(ref c, through: in l, for: in tests)
        case .unionPattern:
            let span = c.bUnionPatterns[i].span
            let variant = c.bUnionPatterns[i].variant
            let target = optional ? t4Inner(ref c, through: ref l, at: span, for: value) : value
            let tag = Constant {
                kind: .integer,
                integer: Big {
                    lo: c.unionVariants[variant].tag >= 0 ? u64(
                        c.unionVariants[variant].tag,
                    ) : ~u64(-(c.unionVariants[variant].tag + 1)),
                    hi: c.unionVariants[variant].tag >= 0 ? 0 : 0xFFFFFFFFFFFFFFFF,
                },
            }
            var tests = List<BExpr>()
            if optional {
                tests.append(ltree.addLOptionalHas(ref l.tree, from: T4LOptionalHas { span: span, optional: value }))
            }
            let literal = semantics.addLiteral(
                ref c,
                from: BLiteral { span: span, type: semantics.prim(.i32), value: tag },
            )
            semantics.setConstant(ref c, for: literal, to: tag)
            tests.append(
                lowerEqual(
                    ref c,
                    at: span,
                    for: ltree.addLUnionTag(ref l.tree, from: LUnionTag { span: span, unionValue: target }),
                    by: literal,
                ),
            )
            var k: i64 = 0
            while k < c.bUnionPatterns[i].subpatterns.length {
                let field = ltree.addLUnionField(
                    ref l.tree,
                    from: LUnionField { span: span, unionValue: target, variant: variant, index: k },
                )
                tests.append(lowerMatch(ref c, through: ref l, for: c.bUnionPatterns[i].subpatterns[k], at: field))
                k += 1
            }
            let d = c.bUnionPatterns[i].designation
            if d != -1 {
                note(ref c, through: ref l, for: d)
                tests.append(t4Bind(ref c, through: ref l, at: span, for: d, as: target))
            }
            return t4All(ref c, through: in l, for: in tests)
        case .errorPattern:
            let span = c.bErrorPatterns[i].span
            let variant = c.bErrorPatterns[i].variant
            let code = Constant { kind: .integer, integer: Big { lo: u64(c.errorVariants[variant].code), hi: 0 } }
            let literal = semantics.addLiteral(
                ref c,
                from: BLiteral { span: span, type: semantics.prim(.u32), value: code },
            )
            semantics.setConstant(ref c, for: literal, to: code)
            var tests = List<BExpr>()
            tests.append(
                lowerEqual(
                    ref c,
                    at: span,
                    for: ltree.addLErrorCode(ref l.tree, from: T4LErrorCode { span: span, error: value }),
                    by: literal,
                ),
            )
            var k: i64 = 0
            while k < c.bErrorPatterns[i].subpatterns.length {
                let field = ltree.addLErrorField(
                    ref l.tree,
                    from: T4LErrorField { span: span, error: value, variant: variant, index: k },
                )
                tests.append(lowerMatch(ref c, through: ref l, for: c.bErrorPatterns[i].subpatterns[k], at: field))
                k += 1
            }
            return t4All(ref c, through: in l, for: in tests)
        default:
            // coverage-exempt: Q774 the binder makes only the pattern kinds above.
            panic($"cannot lower pattern {t4TypeName(pattern)}")
    }
}

/// `Inner()` (Lowerer.cs:1803): the value of the optional `value`.
BExpr t4Inner(ref Ctx c, through ref LCtx l, at TextSpan span, for BExpr value) uses alloc {
    let inner = c.optionalTypes[i64(t2Type(in c, through: in l, for: value) & 0xFFFFFFFF)]
    return ltree.addLOptionalValue(ref l.tree, from: T4LOptionalValue { span: span, optional: value, type: inner })
}

/// `new LSequence(syntax, [new LAssignExpr(syntax, Local(syntax, local), value)], Bool(syntax, true))`.
BExpr t4Bind(ref Ctx c, through ref LCtx l, at TextSpan span, for LocalId local, as BExpr value) uses alloc {
    var effects = List<BExpr>()
    effects.append(
        ltree.addLAssignExpr(
            ref l.tree,
            from: T4LAssignExpr { span: span, target: localExpr(ref c, at: span, for: local), value: value },
        ),
    )
    let yes = boolLiteral(ref c, at: span, by: true)
    return ltree.addLSequence(ref l.tree, from: T4LSequence { span: span, effects: move effects, value: yes })
}

/// `tests.Aggregate(And)`: the left fold of the non-empty `tests`.
BExpr t4All(ref Ctx c, through in LCtx l, for in List<BExpr> tests) uses alloc {
    var all = tests[0]
    var k: i64 = 1
    while k < tests.length {
        all = andExpr(ref c, through: in l, for: all, by: tests[k])
        k += 1
    }
    return all
}

/// Lowerer.cs:1889 `Claim` (Q844): takes ownership of what pattern `p` binds, appending to the current output list.
public void lowerClaim(ref Ctx c, through ref LCtx l, for BPattern p) uses alloc {
    let i = i64(p & 0xFFFFFFFF)
    switch semantics.boundKind(p) {
        case .bindPattern:
            let local = c.bBindPatterns[i].local
            if local != -1 && !c.locals[local].borrowsSubject {
                emit(
                    ref l,
                    for: ltree.addLClaim(ref l.tree, from: T4LClaim { span: c.bBindPatterns[i].span, local: local }),
                )
            }
        case .notPattern:
            lowerClaim(ref c, through: ref l, for: c.bNotPatterns[i].operand)
        case .binaryPattern:
            lowerClaim(ref c, through: ref l, for: c.bBinaryPatterns[i].left)
            lowerClaim(ref c, through: ref l, for: c.bBinaryPatterns[i].right)
        case .propertyPattern:
            var subs = List<BPattern>()
            for sub in c.bPropertyPatterns[i].subpatterns {
                subs.append(sub.pattern)
            }
            for sub in subs {
                lowerClaim(ref c, through: ref l, for: sub)
            }
            let d = c.bPropertyPatterns[i].designation
            if d != -1 && !c.locals[d].borrowsSubject {
                emit(
                    ref l,
                    for: ltree.addLClaim(ref l.tree, from: T4LClaim { span: c.bPropertyPatterns[i].span, local: d }),
                )
            }
        case .unionPattern:
            for sub in t4Copy(in c.bUnionPatterns[i].subpatterns) {
                lowerClaim(ref c, through: ref l, for: sub)
            }
            let d = c.bUnionPatterns[i].designation
            if d != -1 && !c.locals[d].borrowsSubject {
                emit(
                    ref l,
                    for: ltree.addLClaim(ref l.tree, from: T4LClaim { span: c.bUnionPatterns[i].span, local: d }),
                )
            }
        case .errorPattern:
            for sub in t4Copy(in c.bErrorPatterns[i].subpatterns) {
                lowerClaim(ref c, through: ref l, for: sub)
            }
        default: break
    }
}

/// Lowerer.cs:1917 `Step`.
BExpr lowerStep(ref Ctx c, at TextSpan span, for BExpr receiver, by in BMemberStep step) uses alloc {
    return semantics.addField(
        ref c,
        from: BField { span: span, receiver: receiver, field: step.field },
    ) if step.field != -1
    if step.propertyId != -1 {
        let p = step.propertyId
        return semantics.addCall(
            ref c,
            from: BCall {
                span: span,
                function: c.properties[p].getter,
                receiver: receiver,
                arguments: List<BExpr>(),
                type: c.properties[p].type,
            },
        )
    }
    if (step.builtin is { } b) {
        return semantics.addBuiltinCall(
            ref c,
            from: BBuiltinCall { span: span, member: b, receiver: receiver, arguments: List<BExpr>(), type: step.type },
        )
    }
    return semantics.addTupleElement(
        ref c,
        from: BTupleElement { span: span, receiver: receiver, index: step.tupleIndex, type: step.type },
    )
}

/// Lowerer.cs:1925 `Equal`.
BExpr lowerEqual(ref Ctx c, at TextSpan span, for BExpr a, by BExpr b) uses alloc {
    return semantics.addBinary(
        ref c,
        from: BBinary { span: span, op: .eq, left: a, right: b, type: semantics.prim(.bool) },
    )
}
== emitter/lowerstmt.byn
// T3: Lowerer.cs 352-898 (`Statement`, `Provide`, `Assign`, `Return`, `If`, loops, `Switch`, `Lvalue`).
//
// A C# `Capture(() => …)` is `captureBegin` … `captureEnd`; a C# tuple result is a named tuple. `_targets` is keyed by the `target` field of
// the jump statement, which is the identity of the C# `JumpTarget` (D6).

import parser
import semantics
import emitter.ltree

type T3LGoto             = ltree.LGoto
type T3LIndexUnchecked   = ltree.LIndexUnchecked
type T3LLabel            = ltree.LLabel
type T3LLoop             = ltree.LLoop
type T3LNever            = ltree.LNever
type T3LNextChar         = ltree.LNextChar
type T3LPushPanicHandler = ltree.LPushPanicHandler
type T3LReturnError      = ltree.LReturnError
type T3BBuiltinCall      = semantics.BBuiltinCall
type T3BCall             = semantics.BCall
type T3BCoalesce         = semantics.BCoalesce
type T3BConversion       = semantics.BConversion
type T3BField            = semantics.BField
type T3BIndex            = semantics.BIndex
type T3BTupleElement     = semantics.BTupleElement
type T3UserIteration     = semantics.UserIteration

/// Lowerer.cs:352 `Statement`: lowers `s`, appending to the current output list.
public void lowerStatement(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = semantics.nodeSpan(in c, for: s)
    if l.covering && l.coverage.statements.contains(s) && !l.plain.contains(s) {
        let probe = l.coverage.statements[s]
        emit(
            ref l,
            for: semantics.addExprStmt(
                ref c,
                from: BExprStmt {
                    span: probe.span,
                    expr: ltree.addLCount(ref l.tree, from: T10LCount { span: probe.span, id: probe.id }),
                },
            ),
        )
    }
    if mutantSwitch(in l, for: s) {
        mutantStatement(ref c, through: ref l, for: s)
        return
    }
    switch semantics.boundKind(s) {
        case .block:
            l.scopes.append(LScope {})
            let statements = copyStmts(in c.bBlocks[i].statements)
            for inner in statements {
                lowerStatement(ref c, through: ref l, for: inner)
            }
            emitCleanups(ref c, through: ref l, at: l.scopes.length - 1, for: -1)
            l.scopes.remove(at: l.scopes.length - 1)
        case .localDecl:
            let local = c.bLocalDecls[i].local
            let initializer = c.bLocalDecls[i].initializer
            note(ref c, through: ref l, for: local)
            if initializer != -1 {
                let target = localExpr(ref c, at: span, for: local)
                let value = lowerExpr(ref c, through: ref l, for: initializer)
                emitAssign(ref c, through: ref l, to: target, as: value)
            }
            if c.locals[local].isUsing && c.locals[local].type == semantics.builtinType(.arena) {
                l.scopes[l.scopes.length - 1].cleanups.append(.freeArena(span, local))
            }
        case .exprStmt:
            let value = lowerExpr(ref c, through: ref l, for: c.bExprStmts[i].expr)
            emitEffect(ref c, through: ref l, for: value)
        case .assertStmt:
            // T5's `lowerAssert` reads the condition's syntax through T21's `exprSyntax` (Q778).
            lowerAssert(ref c, through: ref l, for: s)
        case .setOnPanic:
            emit(ref l, for: s)
        case .assign:
            lowerAssign(ref c, through: ref l, for: s)
        case .returnStmt:
            lowerReturn(ref c, through: ref l, for: s)
        case .failStmt:
            let errorExpr = c.bFails[i].error
            let code = lowerExpr(ref c, through: ref l, for: errorExpr)
            break if isNeverExpr(code)
            let error = newTemp(ref c, through: ref l, for: t2Type(in c, through: in l, for: errorExpr))
            let target = localExpr(ref c, at: span, for: error)
            emitAssign(ref c, through: ref l, to: target, as: code)
            emitCleanups(ref c, through: ref l, at: 0, for: error)
            countError(ref c, through: ref l, for: s, by: error)
            let returned = localExpr(ref c, at: span, for: error)
            emit(ref l, for: ltree.addLReturnError(ref l.tree, from: T3LReturnError { span: span, code: returned }))
        case .breakStmt:
            let target = l.targets[c.bBreaks[i].target]
            emitCleanups(ref c, through: ref l, at: target.depth, for: -1)
            emit(ref l, for: ltree.addLGoto(ref l.tree, from: T3LGoto { span: span, label: target.breakLabel }))
        case .continueStmt:
            let target = l.targets[c.bContinues[i].target]
            emitCleanups(ref c, through: ref l, at: target.depth, for: -1)
            emit(
                ref l,
                for: ltree.addLGoto(ref l.tree, from: T3LGoto { span: span, label: target.continueLabel ?? "" }),
            )
        case .ifStmt:
            lowerIf(ref c, through: ref l, for: s)
        case .whileStmt:
            lowerWhile(ref c, through: ref l, for: s)
        case .doWhile:
            lowerDoWhile(ref c, through: ref l, for: s)
        case .forStmt:
            lowerFor(ref c, through: ref l, for: s)
        case .switchStmt:
            lowerSwitch(ref c, through: ref l, for: s)
        case .deferStmt:
            let body = captureGuard(ref c, through: ref l, for: c.bDefers[i].body)
            l.scopes[l.scopes.length - 1].cleanups.append(.deferCleanup(body))
        case .errdeferStmt:
            let error = c.bErrdefers[i].error
            let body = captureGuard(ref c, through: ref l, for: c.bErrdefers[i].body)
            l.scopes[l.scopes.length - 1].cleanups.append(.errdeferCleanup(error, body))
        case .panicDefer:
            // The handler runs while a panic is in progress, in place of every cleanup: none of the scopes' cleanups apply in it.
            let panicLocal = c.bPanicDefers[i].panic
            let handler = c.bPanicDefers[i].body
            if panicLocal != -1 {
                note(ref c, through: ref l, for: panicLocal)
            }
            let slot = l.panicSlots
            l.panicSlots += 1
            captureBegin(ref l)
            lowerOutside(ref c, through: ref l, at: 0, for: handler)
            let lowered = captureEnd(ref l)
            let body = block(ref c, at: semantics.nodeSpan(in c, for: handler), for: move lowered)
            emit(
                ref l,
                for: ltree.addLPushPanicHandler(
                    ref l.tree,
                    from: T3LPushPanicHandler { span: span, slot: slot, panic: panicLocal, body: body },
                ),
            )
            l.scopes[l.scopes.length - 1].cleanups.append(.popPanicHandler(span, slot))
        case .contextStmt:
            lowerProvide(ref c, through: ref l, for: s)
        case .becomeStmt:
            lowerBecome(ref c, through: ref l, for: s)
        // coverage-exempt: Q769 through `cannot lower {semantics.boundKind(s)}`
        default:
            panic($"cannot lower {semantics.boundKind(s)}")
    }
}

/// Lowerer.cs:460 `Provide`: `provide alloc: a { … }` sets the allocator for the body and restores the outer one on every exit.
void lowerProvide(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = c.bContexts[i].span
    let arena = lowerExpr(ref c, through: ref l, for: c.bContexts[i].allocator)
    return if isNeverExpr(arena)
    let slot = l.contextSlots
    l.contextSlots += 1
    emit(ref l, for: ltree.addLSetContext(ref l.tree, from: LSetContext { span: span, arena: arena, slot: slot }))
    l.scopes.append(LScope {})
    l.scopes[l.scopes.length - 1].cleanups.append(.restoreContext(span, slot))
    let statements = copyStmts(in c.bBlocks[i64(c.bContexts[i].body & 0xFFFFFFFF)].statements)
    for inner in statements {
        lowerStatement(ref c, through: ref l, for: inner)
    }
    emitCleanups(ref c, through: ref l, at: l.scopes.length - 1, for: -1)
    l.scopes.remove(at: l.scopes.length - 1)
}

/// Lowerer.cs:473 `Assign`.
void lowerAssign(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = c.bAssigns[i].span
    let aTarget = c.bAssigns[i].target
    let aValue = c.bAssigns[i].value
    let op = c.bAssigns[i].op
    if op is null {
        var ops = List<BExpr>()
        ops.append(aTarget)
        ops.append(aValue)
        var lvalues = List<bool>()
        lvalues.append(true)
        var parts = List<BExpr>()
        unless operands(ref c, through: ref l, for: in ops, as: in lvalues, to: ref parts) {
            return
        }
        // C leaves `*at(xs, i) = f(&xs)` unsequenced: the value is computed first, so a call
        // that grows the list cannot leave the store pointing at freed storage.
        let assigned = isTrivial(
            in c,
            through: in l,
            for: parts[1],
        ) ? parts[1] : spill(ref c, through: ref l, for: parts[1])
        emitAssign(ref c, through: ref l, to: parts[0], as: assigned)
        return
    }
    // `t op= v`: the target is evaluated once, so its index (if any) must be stable.
    var target = lowerLvalue(ref c, through: ref l, for: aTarget)
    if !ltree.isLowered(target) && semantics.boundKind(target) == .index {
        let k = i64(target & 0xFFFFFFFF)
        let index = c.bIndexes[k].index
        if !isTrivial(in c, through: in l, for: index) {
            let stable = spill(ref c, through: ref l, for: index)
            target = semantics.addIndex(
                ref c,
                from: T3BIndex {
                    span: c.bIndexes[k].span,
                    target: c.bIndexes[k].target,
                    index: stable,
                    fromEnd: c.bIndexes[k].fromEnd,
                    type: c.bIndexes[k].type,
                },
            )
        }
    } else if !ltree.isLowered(target) && semantics.boundKind(target) == .builtinCall
            && (c.bBuiltinCalls[i64(target & 0xFFFFFFFF)].member == .mapIndexSet
            // coverage-exempt: Q780 through `arguments.length > 0 {`
            || c.bBuiltinCalls[i64(target & 0xFFFFFFFF)].member == .mapSlot)
            && c.bBuiltinCalls[i64(target & 0xFFFFFFFF)].arguments.length > 0 {
        let k = i64(target & 0xFFFFFFFF)
        let key = c.bBuiltinCalls[k].arguments[0]
        if !isTrivial(in c, through: in l, for: key) {
            var arguments = List<BExpr>()
            arguments.append(spill(ref c, through: ref l, for: key))
            for m in 1..c.bBuiltinCalls[k].arguments.length {
                arguments.append(c.bBuiltinCalls[k].arguments[m])
            }
            target = semantics.addBuiltinCall(
                ref c,
                from: T3BBuiltinCall {
                    span: c.bBuiltinCalls[k].span,
                    member: c.bBuiltinCalls[k].member,
                    receiver: c.bBuiltinCalls[k].receiver,
                    arguments: move arguments,
                    type: c.bBuiltinCalls[k].type,
                },
            )
        }
    }
    // The old value is read before `v` runs, which may change or move the target.
    // `map[k] op= v` reads through the panicking index: only `slot` inserts a missing key.
    var current: BExpr = -1
    if !ltree.isLowered(target)
            && semantics.boundKind(target) == .builtinCall
            && c.bBuiltinCalls[i64(target & 0xFFFFFFFF)].member == .mapIndexSet {
        let k = i64(target & 0xFFFFFFFF)
        var arguments = List<BExpr>()
        for m in 0..c.bBuiltinCalls[k].arguments.length {
            arguments.append(c.bBuiltinCalls[k].arguments[m])
        }
        let read = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: c.bBuiltinCalls[k].span,
                member: .mapIndex,
                receiver: c.bBuiltinCalls[k].receiver,
                arguments: move arguments,
                type: c.bBuiltinCalls[k].type,
            },
        )
        current = spill(ref c, through: ref l, for: read)
    } else if isTrivial(in c, through: in l, for: aValue) {
        current = target
    } else {
        current = spill(ref c, through: ref l, for: target)
    }
    let targetType = t2Type(in c, through: in l, for: target)
    if op == .coalesce {
        // `t ??= v` is `t = t ?? v`: `v` runs only when `t` is null.
        let right = semantics.addConversion(
            ref c,
            from: T3BConversion { span: span, operand: aValue, type: targetType, kind: .toOptional },
        )
        let coalesce = semantics.addCoalesce(
            ref c,
            from: T3BCoalesce { span: span, left: current, right: right, type: targetType },
        )
        let coalesced = lowerCoalesce(ref c, through: ref l, for: coalesce)
        // coverage-exempt: Q777
        if !isNeverExpr(coalesced) {
            emitAssign(ref c, through: ref l, to: target, as: coalesced)
        }
        return
    }
    var value = lowerExpr(ref c, through: ref l, for: aValue)
    return if isNeverExpr(value)
    if !isTrivial(in c, through: in l, for: value) {
        value = spill(ref c, through: ref l, for: value)
    }
    let combined = semantics.addBinary(
        ref c,
        from: BBinary { span: span, op: op, left: current, right: value, type: targetType },
    )
    emitAssign(ref c, through: ref l, to: target, as: combined)
}

/// Lowerer.cs:510 `Return`.
void lowerReturn(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = c.bReturns[i].span
    let result = c.bReturns[i].value
    var value: BExpr = -1
    if result != -1 {
        value = lowerExpr(ref c, through: ref l, for: result)
        return if isNeverExpr(value)
        // coverage-exempt: Q777 through `value = -1`
        if semantics.isVoid(t2Type(in c, through: in l, for: value)) || isVoidExpr(value) {
            emitEffect(ref c, through: ref l, for: value)
            value = -1
        } else if !t3IsPlainValue(in c, for: value) && t3AnyCleanups(in l) {
            // Cleanups run after the value is read: a `defer` that changes a local must not change the result.
            value = spill(ref c, through: ref l, for: value)
        }
    }
    emitCleanups(ref c, through: ref l, at: 0, for: -1)
    emit(ref l, for: ltree.addLReturn(ref l.tree, from: LReturn { span: span, value: value }))
}

/// `value is BoundLiteral or BoundDefault or BoundErrorVariant { Payload.Length: 0 } or BoundEnumMember`.
bool t3IsPlainValue(in Ctx c, for BExpr value) {
    return false if ltree.isLowered(value)
    switch semantics.boundKind(value) {
        case .literal or .defaultValue or .enumMember: return true
        case .errorVariant: return c.bErrorVariants[i64(value & 0xFFFFFFFF)].payload.length == 0
        default: return false
    }
}

/// `_scopes.Any(s => s.Cleanups.Count > 0)`.
bool t3AnyCleanups(in LCtx l) {
    for scope in l.scopes {
        return true if scope.cleanups.length > 0
    }
    return false
}

/// Lowerer.cs:532 `If`.
void lowerIf(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = c.bIfs[i].span
    let thenStmt = c.bIfs[i].then
    let elseStmt = c.bIfs[i].elseBranch
    let isNeverIf = c.bIfs[i].isNever
    let condition = lowerExpr(ref c, through: ref l, for: c.bIfs[i].condition)
    return if isNeverExpr(condition)
    captureBegin(ref l)
    if !isNeverIf {
        lowerStatement(ref c, through: ref l, for: thenStmt)
    } else {
        // The panic is a cleanup of the block, so a `return`, `break`, `continue` or failure inside it still panics.
        l.scopes.append(LScope {})
        let message = semantics.addLiteral(
            ref c,
            from: BLiteral {
                span: span,
                type: semantics.prim(.string),
                value: Constant { kind: .text, text: "`if never` condition was true" },
            },
        )
        var arguments = List<BExpr>()
        arguments.append(message)
        let call = semantics.addCall(
            ref c,
            from: T3BCall {
                span: span,
                function: c.builtinPanic,
                receiver: -1,
                arguments: move arguments,
                type: semantics.prim(.neverKind),
            },
        )
        let panicStmt = semantics.addExprStmt(ref c, from: BExprStmt { span: span, expr: call })
        l.scopes[l.scopes.length - 1].cleanups.append(.deferCleanup(panicStmt))
        lowerStatement(ref c, through: ref l, for: thenStmt)
        emitCleanups(ref c, through: ref l, at: l.scopes.length - 1, for: -1)
        l.scopes.remove(at: l.scopes.length - 1)
    }
    let thenBody = captureEnd(ref l)
    var otherwise = List<BStmt>()
    if elseStmt != -1 {
        captureBegin(ref l)
        lowerStatement(ref c, through: ref l, for: elseStmt)
        otherwise = captureEnd(ref l)
    }
    let thenBlock = block(ref c, at: semantics.nodeSpan(in c, for: thenStmt), for: move thenBody)
    let elseBlock: BStmt = elseStmt == -1 ? -1 : block(
        ref c,
        at: semantics.nodeSpan(in c, for: elseStmt),
        for: move otherwise,
    )
    emit(
        ref l,
        for: semantics.addIf(
            ref c,
            from: BIf { span: span, condition: condition, then: thenBlock, elseBranch: elseBlock },
        ),
    )
}

/// Lowerer.cs:556 `EnterLoop`: fresh break and continue labels for `target`.
(string brk, string cont) enterLoop(ref LCtx l, for i64 target) uses alloc {
    let brk = newLabel(ref l, for: "break")
    let cont = newLabel(ref l, for: "continue")
    l.targets[target] = LTarget { breakLabel: brk, continueLabel: cont, depth: l.scopes.length }
    return (brk: brk, cont: cont)
}

/// `Emit(new BoundIf(span, condition, Block(span, [new LGoto(span, label)]), null))`, which Lowerer.cs:569 and the loops write out.
void t3GotoIf(ref Ctx c, through ref LCtx l, at TextSpan span, for BExpr condition, to string label) uses alloc {
    var jump = List<BStmt>()
    jump.append(ltree.addLGoto(ref l.tree, from: T3LGoto { span: span, label: label }))
    let then = block(ref c, at: span, for: move jump)
    emit(ref l, for: semantics.addIf(ref c, from: BIf { span: span, condition: condition, then: then }))
}

/// `Emit(new BoundIf(span, Not(condition), Block(span, [new LGoto(span, label)]), null))`.
void t3GotoIfNot(ref Ctx c, through ref LCtx l, at TextSpan span, for BExpr condition, to string label) uses alloc {
    let negated = notExpr(ref c, through: in l, for: condition)
    t3GotoIf(ref c, through: ref l, at: span, for: negated, to: label)
}

/// `Emit(new LLabel(span, name))`.
void t3Label(ref LCtx l, at TextSpan span, for string name) uses alloc {
    emit(ref l, for: ltree.addLLabel(ref l.tree, from: T3LLabel { span: span, name: name }))
}

/// `Emit(new LLoop(span, Block(span, body)))`.
void t3Loop(ref Ctx c, through ref LCtx l, at TextSpan span, for move List<BStmt> body) uses alloc {
    let loopBody = block(ref c, at: span, for: move body)
    emit(ref l, for: ltree.addLLoop(ref l.tree, from: T3LLoop { span: span, body: loopBody }))
}

/// Lowerer.cs:565 `ExitUnless`: `if (!condition) goto label;` with the condition's statements first.
void exitUnless(ref Ctx c, through ref LCtx l, for BExpr condition, to string label) uses alloc {
    let span = semantics.nodeSpan(in c, for: condition)
    let lowered = lowerExpr(ref c, through: ref l, for: condition)
    return if isNeverExpr(lowered)
    t3GotoIfNot(ref c, through: ref l, at: span, for: lowered, to: label)
}

/// Lowerer.cs:572 `While`.
void lowerWhile(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = c.bWhiles[i].span
    let condition = c.bWhiles[i].condition
    let loopBody = c.bWhiles[i].body
    let labels = enterLoop(ref l, for: c.bWhiles[i].target)
    captureBegin(ref l)
    exitUnless(ref c, through: ref l, for: condition, to: labels.brk)
    lowerStatement(ref c, through: ref l, for: loopBody)
    t3Label(ref l, at: span, for: labels.cont)
    let body = captureEnd(ref l)
    t3Loop(ref c, through: ref l, at: span, for: move body)
    t3Label(ref l, at: span, for: labels.brk)
}

/// Lowerer.cs:585 `DoWhile`.
void lowerDoWhile(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let i = i64(s & 0xFFFFFFFF)
    let span = c.bDoWhiles[i].span
    let condition = c.bDoWhiles[i].condition
    let loopBody = c.bDoWhiles[i].body
    let labels = enterLoop(ref l, for: c.bDoWhiles[i].target)
    captureBegin(ref l)
    lowerStatement(ref c, through: ref l, for: loopBody)
    t3Label(ref l, at: span, for: labels.cont)
    exitUnless(ref c, through: ref l, for: condition, to: labels.brk)
    let body = captureEnd(ref l)
    t3Loop(ref c, through: ref l, at: span, for: move body)
    t3Label(ref l, at: span, for: labels.brk)
}

/// Lowerer.cs:598 `For`.
void lowerFor(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let fi = i64(s & 0xFFFFFFFF)
    let span = c.bFors[fi].span
    let variableLocal = c.bFors[fi].variable
    let iterableExpr = c.bFors[fi].iterable
    let forBody = c.bFors[fi].body
    let forTarget = c.bFors[fi].target
    note(ref c, through: ref l, for: variableLocal)
    let variable = localExpr(ref c, at: span, for: variableLocal)
    if semantics.boundKind(iterableExpr) == .range {
        let ri = i64(iterableExpr & 0xFFFFFFFF)
        let start = c.bRanges[ri].start
        let end = c.bRanges[ri].end
        let inclusive = c.bRanges[ri].inclusive
        var ops = List<BExpr>()
        ops.append(start)
        ops.append(end)
        var bounds = List<BExpr>()
        unless operands(ref c, through: ref l, for: in ops, as: in List<bool>(), to: ref bounds) {
            return
        }
        let startType = t2Type(in c, through: in l, for: start)
        let i = newTemp(ref c, through: ref l, for: startType)
        let endLocal = newTemp(ref c, through: ref l, for: t2Type(in c, through: in l, for: end))
        let iTarget = localExpr(ref c, at: span, for: i)
        emitAssign(ref c, through: ref l, to: iTarget, as: bounds[0])
        let endTarget = localExpr(ref c, at: span, for: endLocal)
        emitAssign(ref c, through: ref l, to: endTarget, as: bounds[1])
        let labels = enterLoop(ref l, for: forTarget)
        let cmp: parser.BinaryOp = inclusive ? .le : .lt
        captureBegin(ref l)
        let iRead = localExpr(ref c, at: span, for: i)
        let endRead = localExpr(ref c, at: span, for: endLocal)
        let inRange = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: cmp, left: iRead, right: endRead, type: semantics.prim(.bool) },
        )
        t3GotoIfNot(ref c, through: ref l, at: span, for: inRange, to: labels.brk)
        let iCurrent = localExpr(ref c, at: span, for: i)
        emitAssign(ref c, through: ref l, to: variable, as: iCurrent)
        lowerStatement(ref c, through: ref l, for: forBody)
        t3Label(ref l, at: span, for: labels.cont)
        if inclusive {
            let left = localExpr(ref c, at: span, for: i)
            let right = localExpr(ref c, at: span, for: endLocal)
            let same = semantics.addBinary(
                ref c,
                from: BBinary { span: span, op: .eq, left: left, right: right, type: semantics.prim(.bool) },
            )
            t3GotoIf(ref c, through: ref l, at: span, for: same, to: labels.brk)
        }
        let stepTarget = localExpr(ref c, at: span, for: i)
        let stepLeft = localExpr(ref c, at: span, for: i)
        let stepOne = oneLiteral(ref c, at: span, for: startType)
        let step = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: .addWrap, left: stepLeft, right: stepOne, type: startType },
        )
        emit(
            ref l,
            for: semantics.addAssign(ref c, from: BAssign { span: span, target: stepTarget, value: step, op: null }),
        )
        let body = captureEnd(ref l)
        t3Loop(ref c, through: ref l, at: span, for: move body)
        t3Label(ref l, at: span, for: labels.brk)
        return
    }

    let userIteration = c.bFors[fi].userIteration
    if userIteration is not null {
        lowerUserFor(ref c, through: ref l, for: s, at: variable, by: userIteration)
        return
    }

    let iterable = lowerExpr(ref c, through: ref l, for: iterableExpr)
    return if isNeverExpr(iterable)
    let iterableType = t2Type(in c, through: in l, for: iterable)
    if semantics.isString(iterableType) {
        let text = spill(ref c, through: ref l, for: iterable)
        let pos = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
        let posTarget = localExpr(ref c, at: span, for: pos)
        let zero = i64Literal(ref c, at: span, by: 0)
        emitAssign(ref c, through: ref l, to: posTarget, as: zero)
        let labels = enterLoop(ref l, for: forTarget)
        captureBegin(ref l)
        let length = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: span,
                member: .stringLength,
                receiver: text,
                arguments: List<BExpr>(),
                type: semantics.prim(.i64),
            },
        )
        let posRead = localExpr(ref c, at: span, for: pos)
        let inside = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: .lt, left: posRead, right: length, type: semantics.prim(.bool) },
        )
        t3GotoIfNot(ref c, through: ref l, at: span, for: inside, to: labels.brk)
        let nextChar = ltree.addLNextChar(ref l.tree, from: T3LNextChar { span: span, text: text, position: pos })
        emitAssign(ref c, through: ref l, to: variable, as: nextChar)
        lowerStatement(ref c, through: ref l, for: forBody)
        t3Label(ref l, at: span, for: labels.cont)
        let body = captureEnd(ref l)
        t3Loop(ref c, through: ref l, at: span, for: move body)
        t3Label(ref l, at: span, for: labels.brk)
        return
    }

    if semantics.kindOf(iterableType) == .textView {
        // The view is a copy the cursor functions advance; `parts` counts its limit down in it.
        let copy = spill(ref c, through: ref l, for: iterable)
        let pos = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
        let posTarget = localExpr(ref c, at: span, for: pos)
        let zero = i64Literal(ref c, at: span, by: 0)
        emitAssign(ref c, through: ref l, to: posTarget, as: zero)
        let labels = enterLoop(ref l, for: forTarget)
        captureBegin(ref l)
        var moreArguments = List<BExpr>()
        moreArguments.append(localExpr(ref c, at: span, for: pos))
        let more = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: span,
                member: .textViewMore,
                receiver: copy,
                arguments: move moreArguments,
                type: semantics.prim(.bool),
            },
        )
        t3GotoIfNot(ref c, through: ref l, at: span, for: more, to: labels.brk)
        var nextArguments = List<BExpr>()
        nextArguments.append(localExpr(ref c, at: span, for: pos))
        let element = semantics.textViewElement(semantics.textViewKindOf(iterableType & 0xFFFFFFFF))
        let next = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: span,
                member: .textViewNext,
                receiver: copy,
                arguments: move nextArguments,
                type: element,
            },
        )
        emitAssign(ref c, through: ref l, to: variable, as: next)
        lowerStatement(ref c, through: ref l, for: forBody)
        t3Label(ref l, at: span, for: labels.cont)
        let body = captureEnd(ref l)
        t3Loop(ref c, through: ref l, at: span, for: move body)
        t3Label(ref l, at: span, for: labels.brk)
        return
    }

    if semantics.kindOf(iterableType) == .map {
        // Entries in insertion order; removed entries stay as tombstones until the next rehash.
        let map = spill(ref c, through: ref l, for: iterable)
        let slot = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
        let slotTarget = localExpr(ref c, at: span, for: slot)
        let zero = i64Literal(ref c, at: span, by: 0)
        emitAssign(ref c, through: ref l, to: slotTarget, as: zero)
        let labels = enterLoop(ref l, for: forTarget)
        captureBegin(ref l)
        let count = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: span,
                member: .mapSlotCount,
                receiver: map,
                arguments: List<BExpr>(),
                type: semantics.prim(.i64),
            },
        )
        let slotRead = localExpr(ref c, at: span, for: slot)
        let inside = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: .lt, left: slotRead, right: count, type: semantics.prim(.bool) },
        )
        t3GotoIfNot(ref c, through: ref l, at: span, for: inside, to: labels.brk)
        var liveArguments = List<BExpr>()
        liveArguments.append(localExpr(ref c, at: span, for: slot))
        let live = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: span,
                member: .mapSlotLive,
                receiver: map,
                arguments: move liveArguments,
                type: semantics.prim(.bool),
            },
        )
        t3GotoIfNot(ref c, through: ref l, at: span, for: live, to: labels.cont)
        var entryArguments = List<BExpr>()
        entryArguments.append(localExpr(ref c, at: span, for: slot))
        let entry = semantics.addBuiltinCall(
            ref c,
            from: T3BBuiltinCall {
                span: span,
                member: .mapSlotEntry,
                receiver: map,
                arguments: move entryArguments,
                type: c.locals[variableLocal].type,
            },
        )
        emitAssign(ref c, through: ref l, to: variable, as: entry)
        lowerStatement(ref c, through: ref l, for: forBody)
        t3Label(ref l, at: span, for: labels.cont)
        let stepTarget = localExpr(ref c, at: span, for: slot)
        let stepLeft = localExpr(ref c, at: span, for: slot)
        let stepOne = i64Literal(ref c, at: span, by: 1)
        let step = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: .addWrap, left: stepLeft, right: stepOne, type: semantics.prim(.i64) },
        )
        emit(
            ref l,
            for: semantics.addAssign(ref c, from: BAssign { span: span, target: stepTarget, value: step, op: null }),
        )
        let body = captureEnd(ref l)
        t3Loop(ref c, through: ref l, at: span, for: move body)
        t3Label(ref l, at: span, for: labels.brk)
        return
    }

    // Spans and lists are small headers: iterate over a copy. Arrays are iterated in place.
    let sequence = semantics.kindOf(iterableType) == .array
        && isLvalue(in c, through: in l, for: iterable) ? iterable : spill(ref c, through: ref l, for: iterable)
    var lengthMember: semantics.BuiltinMember = .arrayLength
    var element: Type = -1
    switch semantics.kindOf(iterableType) {
        case .span:
            lengthMember = .spanLength
            element = c.spanTypes[iterableType & 0xFFFFFFFF].element
        case .list:
            lengthMember = .listLength
            element = c.listTypes[iterableType & 0xFFFFFFFF]
        default:
            element = c.arrayTypes[iterableType & 0xFFFFFFFF].element
    }
    let index = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
    let indexTarget = localExpr(ref c, at: span, for: index)
    let zero = i64Literal(ref c, at: span, by: 0)
    emitAssign(ref c, through: ref l, to: indexTarget, as: zero)
    let labels = enterLoop(ref l, for: forTarget)
    captureBegin(ref l)
    let length = semantics.addBuiltinCall(
        ref c,
        from: T3BBuiltinCall {
            span: span,
            member: lengthMember,
            receiver: sequence,
            arguments: List<BExpr>(),
            type: semantics.prim(.i64),
        },
    )
    let indexRead = localExpr(ref c, at: span, for: index)
    let inside = semantics.addBinary(
        ref c,
        from: BBinary { span: span, op: .lt, left: indexRead, right: length, type: semantics.prim(.bool) },
    )
    t3GotoIfNot(ref c, through: ref l, at: span, for: inside, to: labels.brk)
    let itemIndex = localExpr(ref c, at: span, for: index)
    let item = ltree.addLIndexUnchecked(
        ref l.tree,
        from: T3LIndexUnchecked { span: span, target: sequence, index: itemIndex, type: element },
    ) because "the loop condition bounds the index"
    let converted = forItem(ref c, through: ref l, for: s, at: item)
    emitAssign(ref c, through: ref l, to: variable, as: converted)
    lowerStatement(ref c, through: ref l, for: forBody)
    t3Label(ref l, at: span, for: labels.cont)
    let stepTarget = localExpr(ref c, at: span, for: index)
    let stepLeft = localExpr(ref c, at: span, for: index)
    let stepOne = i64Literal(ref c, at: span, by: 1)
    let step = semantics.addBinary(
        ref c,
        from: BBinary { span: span, op: .addWrap, left: stepLeft, right: stepOne, type: semantics.prim(.i64) },
    )
    emit(
        ref l,
        for: semantics.addAssign(ref c, from: BAssign { span: span, target: stepTarget, value: step, op: null }),
    )
    let loopBody = captureEnd(ref l)
    t3Loop(ref c, through: ref l, at: span, for: move loopBody)
    t3Label(ref l, at: span, for: labels.brk)
}

/// A getter's witness (Lowerer.cs:756 `Call`): a field is read, a function is called on `subject`.
BExpr t3Witness(
    ref Ctx c,
    at TextSpan span,
    for BExpr subject,
    by FuncId function,
    to semantics.FieldId field,
    as move List<BExpr> arguments
) uses alloc {
    return semantics.addField(
        ref c,
        from: T3BField { span: span, receiver: subject, field: field, type: c.fields[field].type },
    ) if field != -1
    return semantics.addCall(
        ref c,
        from: T3BCall {
            span: span,
            function: function,
            receiver: subject,
            arguments: move arguments,
            type: c.functions[function].returnType,
        },
    )
}

/// Lowerer.cs:735 `UserFor`: `for` over an `IIndexable`: `count` is read once, then `get(i)` for each index below it.
/// Over an `IEnumerator`: `moveNext()` until it returns false, reading `current` after each true.
/// A place is walked in place; an rvalue enumerator goes to the binder's spill local, any other rvalue to a temporary.
void lowerUserFor(ref Ctx c, through ref LCtx l, for BStmt s, at BExpr variable, by T3UserIteration user) uses alloc {
    let fi = i64(s & 0xFFFFFFFF)
    let span = c.bFors[fi].span
    let iterableExpr = c.bFors[fi].iterable
    let forBody = c.bFors[fi].body
    let forTarget = c.bFors[fi].target
    var subject: BExpr = -1
    if user.spill != -1 {
        note(ref c, through: ref l, for: user.spill)
        let value = lowerExpr(ref c, through: ref l, for: iterableExpr)
        return if isNeverExpr(value)
        subject = localExpr(ref c, at: span, for: user.spill)
        emitAssign(ref c, through: ref l, to: subject, as: value)
    } else {
        subject = isLvalueShape(
            ref c,
            through: ref l,
            for: iterableExpr,
        ) ? lowerLvalue(ref c, through: ref l, for: iterableExpr) : lowerExpr(ref c, through: ref l, for: iterableExpr)
        return if isNeverExpr(subject)
        subject = lowerStable(ref c, through: ref l, for: subject)
        if !isLvalue(in c, through: in l, for: subject) {
            subject = spill(ref c, through: ref l, for: subject)
        }
    }
    if user.kind == .indexable {
        let count = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
        let countTarget = localExpr(ref c, at: span, for: count)
        let countValue = t3Witness(
            ref c,
            at: span,
            for: subject,
            by: user.advance,
            to: user.advanceField,
            as: List<BExpr>(),
        )
        emitAssign(ref c, through: ref l, to: countTarget, as: countValue)
        let index = newTemp(ref c, through: ref l, for: semantics.prim(.i64))
        let indexTarget = localExpr(ref c, at: span, for: index)
        let zero = i64Literal(ref c, at: span, by: 0)
        emitAssign(ref c, through: ref l, to: indexTarget, as: zero)
        let labels = enterLoop(ref l, for: forTarget)
        captureBegin(ref l)
        let indexRead = localExpr(ref c, at: span, for: index)
        let countRead = localExpr(ref c, at: span, for: count)
        let inside = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: .lt, left: indexRead, right: countRead, type: semantics.prim(.bool) },
        )
        t3GotoIfNot(ref c, through: ref l, at: span, for: inside, to: labels.brk)
        var itemArguments = List<BExpr>()
        itemArguments.append(localExpr(ref c, at: span, for: index))
        let got = t3Witness(ref c, at: span, for: subject, by: user.item, to: user.itemField, as: move itemArguments)
        let item = forItem(ref c, through: ref l, for: s, at: got)
        emitAssign(ref c, through: ref l, to: variable, as: item)
        lowerStatement(ref c, through: ref l, for: forBody)
        t3Label(ref l, at: span, for: labels.cont)
        let stepTarget = localExpr(ref c, at: span, for: index)
        let stepLeft = localExpr(ref c, at: span, for: index)
        let stepOne = i64Literal(ref c, at: span, by: 1)
        let step = semantics.addBinary(
            ref c,
            from: BBinary { span: span, op: .addWrap, left: stepLeft, right: stepOne, type: semantics.prim(.i64) },
        )
        emit(
            ref l,
            for: semantics.addAssign(ref c, from: BAssign { span: span, target: stepTarget, value: step, op: null }),
        )
        let body = captureEnd(ref l)
        t3Loop(ref c, through: ref l, at: span, for: move body)
        t3Label(ref l, at: span, for: labels.brk)
        return
    }
    let labels = enterLoop(ref l, for: forTarget)
    captureBegin(ref l)
    let advance = t3Witness(ref c, at: span, for: subject, by: user.advance, to: user.advanceField, as: List<BExpr>())
    t3GotoIfNot(ref c, through: ref l, at: span, for: advance, to: labels.brk)
    let got = t3Witness(ref c, at: span, for: subject, by: user.item, to: user.itemField, as: List<BExpr>())
    let item = forItem(ref c, through: ref l, for: s, at: got)
    emitAssign(ref c, through: ref l, to: variable, as: item)
    lowerStatement(ref c, through: ref l, for: forBody)
    t3Label(ref l, at: span, for: labels.cont)
    let loopBody = captureEnd(ref l)
    t3Loop(ref c, through: ref l, at: span, for: move loopBody)
    t3Label(ref l, at: span, for: labels.brk)
}

/// Lowerer.cs:797 `ForItem`: `for T x in e` with `T` other than the element, e.g. `dyn ref I`: the item is held in a temporary and converted.
/// A mutable `dyn ref` to an array or List element points at the element itself, so mutations through it persist.
BExpr forItem(ref Ctx c, through ref LCtx l, for BStmt s, at BExpr item) uses alloc {
    let fi = i64(s & 0xFFFFFFFF)
    let span = c.bFors[fi].span
    let variableType = c.locals[c.bFors[fi].variable].type
    let itemType = t2Type(in c, through: in l, for: item)
    return item if itemType == variableType
    let converted = semantics.implicit(ref c, from: itemType, to: variableType)
    // coverage-exempt: Q770
    return item if converted is null
    let kind = converted
    // coverage-exempt: Q770
    return semantics.addConversion(
        ref c,
        from: T3BConversion { span: span, operand: item, type: variableType, kind: kind },
    ) if ltree.isLowered(item)
        && ltree.lKindOf(item) == .indexUnchecked
        && semantics.kindOf(variableType) == .dynRef
        && !c.dynRefTypes[variableType & 0xFFFFFFFF].readOnly
    let held = spill(ref c, through: ref l, for: item)
    let conversion = semantics.addConversion(
        ref c,
        from: T3BConversion { span: span, operand: held, type: variableType, kind: kind },
    )
    return lowerExpr(ref c, through: ref l, for: conversion)
}

/// Lowerer.cs:805 `One`.
BExpr oneLiteral(ref Ctx c, at TextSpan span, for Type type) uses alloc {
    let e = semantics.addLiteral(
        ref c,
        from: BLiteral { span: span, type: type, value: Constant { kind: .integer, integer: Big { lo: 1, hi: 0 } } },
    )
    semantics.setConstant(ref c, for: e, to: Constant { kind: .integer, integer: Big { lo: 1, hi: 0 } })
    return e
}

/// Lowerer.cs:808 `Switch`: sections test in order; the pattern-less section is the fallback, lowered last.
void lowerSwitch(ref Ctx c, through ref LCtx l, for BStmt s) uses alloc {
    let si = i64(s & 0xFFFFFFFF)
    let span = c.bSwitches[si].span
    var value = lowerExpr(ref c, through: ref l, for: c.bSwitches[si].value)
    return if isNeverExpr(value)
    if !isRepeatable(in c, through: in l, for: value) {
        value = spill(ref c, through: ref l, for: value)
    }
    let end = newLabel(ref l, for: "switch_end")
    l.targets[c.bSwitches[si].target] = LTarget { breakLabel: end, depth: l.scopes.length }
    var fallback = -1
    for k in 0..c.bSwitches[si].sections.length {
        let pattern = c.bSwitches[si].sections[k].pattern
        let sectionSpan = c.bSwitches[si].sections[k].span
        if pattern == -1 {
            fallback = k
            continue
        }
        captureBegin(ref l)
        lowerClaim(ref c, through: ref l, for: pattern)
        l.scopes.append(LScope {})
        let statements = copyStmts(in c.bSwitches[si].sections[k].body)
        for inner in statements {
            lowerStatement(ref c, through: ref l, for: inner)
        }
        emitCleanups(ref c, through: ref l, at: l.scopes.length - 1, for: -1)
        l.scopes.remove(at: l.scopes.length - 1)
        emit(ref l, for: ltree.addLGoto(ref l.tree, from: T3LGoto { span: sectionSpan, label: end }))
        let body = captureEnd(ref l)
        let match = lowerMatch(ref c, through: ref l, for: pattern, at: value)
        let guardExpr = c.bSwitches[si].sections[k].guard
        if guardExpr == -1 {
            let bodyBlock = block(ref c, at: sectionSpan, for: move body)
            emit(ref l, for: semantics.addIf(ref c, from: BIf { span: sectionSpan, condition: match, then: bodyBlock }))
            continue
        }
        var pre = List<BStmt>()
        let guard = captureExpr(ref c, through: ref l, for: guardExpr, lvalue: false, to: ref pre)
        if pre.length == 0 {
            let both = andExpr(ref c, through: in l, for: match, by: guard)
            let bodyBlock = block(ref c, at: sectionSpan, for: move body)
            emit(ref l, for: semantics.addIf(ref c, from: BIf { span: sectionSpan, condition: both, then: bodyBlock }))
        } else {
            let bodyBlock = block(ref c, at: sectionSpan, for: move body)
            pre.append(semantics.addIf(ref c, from: BIf { span: sectionSpan, condition: guard, then: bodyBlock }))
            let preBlock = block(ref c, at: sectionSpan, for: move pre)
            emit(ref l, for: semantics.addIf(ref c, from: BIf { span: sectionSpan, condition: match, then: preBlock }))
        }
    }
    if fallback != -1 {
        l.scopes.append(LScope {})
        let statements = copyStmts(in c.bSwitches[si].sections[fallback].body)
        for inner in statements {
            lowerStatement(ref c, through: ref l, for: inner)
        }
        emitCleanups(ref c, through: ref l, at: l.scopes.length - 1, for: -1)
        l.scopes.remove(at: l.scopes.length - 1)
    }
    emit(ref l, for: ltree.addLLabel(ref l.tree, from: T3LLabel { span: span, name: end }))
}

/// Lowerer.cs:862 `Lvalue`: lowers an expression that must stay addressable (assignment target, `ref` argument, mutating receiver).
public BExpr lowerLvalue(ref Ctx c, through ref LCtx l, for BExpr e) uses alloc {
    // coverage-exempt: Q777
    return spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: e)) if ltree.isLowered(e)
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .local:
            note(ref c, through: ref l, for: c.bLocals[i].local)
            return e
        case .thisRef or .staticArray:
            return e
        case .field:
            let receiver = c.bFields[i].receiver
            let lowered = isLvalueShape(
                ref c,
                through: ref l,
                for: receiver,
            ) ? lowerLvalue(
                ref c,
                through: ref l,
                for: receiver,
            ) : spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: receiver))
            return semantics.addField(
                ref c,
                from: T3BField {
                    span: c.bFields[i].span,
                    receiver: lowered,
                    field: c.bFields[i].field,
                    type: c.bFields[i].type,
                },
            )
        case .tupleElement:
            let receiver = c.bTupleElements[i].receiver
            let lowered = isLvalueShape(
                ref c,
                through: ref l,
                for: receiver,
            ) ? lowerLvalue(
                ref c,
                through: ref l,
                for: receiver,
            ) : spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: receiver))
            return semantics.addTupleElement(
                ref c,
                from: T3BTupleElement {
                    span: c.bTupleElements[i].span,
                    receiver: lowered,
                    index: c.bTupleElements[i].index,
                    type: c.bTupleElements[i].type,
                },
            )
        case .index:
            let indexTarget = c.bIndexes[i].target
            let arrayTarget = semantics.kindOf(t2Type(in c, through: in l, for: indexTarget)) == .array
            var ops = List<BExpr>()
            ops.append(indexTarget)
            ops.append(c.bIndexes[i].index)
            var lvalues = List<bool>()
            lvalues.append(arrayTarget && isLvalueShape(ref c, through: ref l, for: indexTarget))
            var parts = List<BExpr>()
            unless operands(ref c, through: ref l, for: in ops, as: in lvalues, to: ref parts) {
                return ltree.addLNever(
                    ref l.tree,
                    from: T3LNever { span: c.bIndexes[i].span, type: c.bIndexes[i].type },
                )
            }
            let target = arrayTarget
                && !isLvalue(
                    in c,
                    through: in l,
                    for: parts[0],
                ) ? spill(ref c, through: ref l, for: parts[0]) : parts[0]
            return semantics.addIndex(
                ref c,
                from: T3BIndex {
                    span: c.bIndexes[i].span,
                    target: target,
                    index: parts[1],
                    fromEnd: c.bIndexes[i].fromEnd,
                    type: c.bIndexes[i].type,
                },
            )
        case .builtinCall:
            return lowerBuiltinCall(ref c, through: ref l, for: e) if c.bBuiltinCalls[i].member is .mapIndexSet
                or .mapSlot
            return spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: e))
        default:
            return spill(ref c, through: ref l, for: lowerExpr(ref c, through: ref l, for: e))
    }
}

/// Lowerer.cs:890 `IsLvalueShape`.
public bool isLvalueShape(ref Ctx c, through ref LCtx l, for BExpr e) {
    // coverage-exempt: Q777
    return false if ltree.isLowered(e)
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .local or .thisRef or .index or .staticArray:
            return true
        case .builtinCall:
            return c.bBuiltinCalls[i].member is .mapIndexSet or .mapSlot
        case .field:
            return isLvalueShape(ref c, through: ref l, for: c.bFields[i].receiver)
        case .tupleElement:
            return isLvalueShape(ref c, through: ref l, for: c.bTupleElements[i].receiver)
        default:
            return false
    }
}
== emitter/ltree/ltree.byn
// T1: LoweredNodes.cs 1-127 (the lowered tree; the lowerer's state is `emitter/lctx.byn`, Lowerer.cs 37-41 and 48-76).
// A module of its own so that `emitter` and `emitter.cprint` both read it without importing each other (D1).
//
// The lowered tree shares the bound tree's handle space (bound.byn:3): a lowered node is
// `(LKind << 32) | index` into a per-kind arena on `LTree`, -1 is null, and `LKind`'s ordinals start at 100,
// above `BoundKind`'s 77 members, so a `BStmt`/`BExpr` handle and a lowered one tell apart by kind without a
// tag. One struct per C# record, fields in C# order: `Node Syntax` is `TextSpan span`, a symbol is its
// semantics handle, `T[]` is a `List<T>`, and a base type computed from a field (`LOptionalValue`'s `Type`)
// is the field. The records that C# derives from `BoundStmt`/`BoundExpr` only for their `Syntax` and `Type`
// carry the same two facts: `span` and, where C# passes it, `type`.

import semantics

public type TextSpan           = semantics.TextSpan
public type Type               = semantics.Type
public type FuncId             = semantics.FuncId
public type LocalId            = semantics.LocalId
public type VariantId          = semantics.VariantId
public type TestId             = semantics.TestId
public type BExpr              = semantics.BExpr
public type BStmt              = semantics.BStmt
public type BPattern           = semantics.BPattern
public type BInterpolationPart = semantics.BInterpolationPart
public type BNode              = semantics.BNode

/// A lowered node, or a bound one: `(kind << 32) | index`; -1 is null.
public type LNode = i64

// ── Kinds ────────────────────────────────────────────────────────────────────

/// The first `LKind` ordinal; `BoundKind` has 77 members (0..76).
const lKindBase: i64 = 100

/// `LoweredNodes.cs` order. The handle's kind is `lKindBase + ordinal`.
public enum LKind {
    label
    gotoStmt
    loop
    returnStmt
    returnError
    failingCall
    write
    panic
    setContext
    freeArena
    pushPanicHandler
    popPanicHandler
    claim
    optionalHas
    optionalValue
    unionTag
    unionField
    errorCode
    errorField
    assignExpr
    sequence
    indexUnchecked
    nextChar
    neverValue
    functionValue
    mutantIs
    count
    voidValue
}

/// `WriteSink`.
public enum WriteSink {
    print
    panic
    strBuf
    log
}

public LNode lNode(LKind kind, at i64 index) => ((lKindBase + i64(kind.ordinal)) << 32) | index

/// Whether `n` is a lowered handle rather than a bound one.
public bool isLowered(LNode n) => n >= 0 && (n >> 32) >= lKindBase

public LKind lKindOf(LNode n) => LKind.fromOrdinal((n >> 32) - lKindBase) ?? .voidValue

public i64 lIndexOf(LNode n) => n & 0xFFFFFFFF

// ── Lowered records ──────────────────────────────────────────────────────────

/// A jump target; emitted as `name:;`.
public struct LLabel {
    public TextSpan span
    public string   name
}

public struct LGoto {
    public TextSpan span
    public string   label
}

/// `for (;;) { body }`; leave it only through `LGoto`.
public struct LLoop {
    public TextSpan span
    public BStmt    body
}

/// Returns normally. For a failing function the value goes to the result pointer and the error code is 0; a constructor returns its `this`. `value` -1 is C#'s null.
public struct LReturn {
    public TextSpan span
    public BExpr    value = -1
}

/// Returns the error code in `code` (a local of an error type) from a failing function.
public struct LReturnError {
    public TextSpan span
    public BExpr    code
}

/// `error = call(…, &result)` for a function that can fail.
public struct LFailingCall {
    public TextSpan span
    public LocalId  error
    public BExpr    call
    public LocalId  result = -1
}

/// Formats `parts` into a stack buffer and sends it to the sink. A part with a `guards` entry (-1 for none) is written only when that condition holds.
public struct LWrite {
    public TextSpan     span
    public WriteSink    sink
    public BExpr        target = -1
    public List<BInterpolationPart> parts
    public List<BExpr>? guards = null
}

/// Panics with a fixed message (failed `assert`, unmatched `switch`).
public struct LPanic {
    public TextSpan span
    public string   message
}

/// Sets `context.allocator` to `arena`, saving the previous one in slot `slot`; with no arena, restores the saved allocator.
public struct LSetContext {
    public TextSpan span
    public BExpr    arena = -1
    public i64      slot
}

/// Frees an arena declared with `using`.
public struct LFreeArena {
    public TextSpan span
    public BExpr    arena
}

/// Registers the `defer panicking` handler in slot `slot`.
public struct LPushPanicHandler {
    public TextSpan span
    public i64      slot
    public LocalId  panic = -1
    public BStmt    body
}

/// Unregisters the handler in slot `slot` as its scope ends.
public struct LPopPanicHandler {
    public TextSpan span
    public i64      slot
}

/// Debug builds: a `switch move x` binding owns its storage once its arm is selected; nothing otherwise.
public struct LClaim {
    public TextSpan span
    public LocalId  local
}

/// Whether an optional holds a value (type bool).
public struct LOptionalHas {
    public TextSpan span
    public BExpr    optional
}

/// The value inside an optional already known to hold one.
public struct LOptionalValue {
    public TextSpan span
    public BExpr    optional
    public Type     type
}

/// A union's tag: its variant's declaration index (type i32).
public struct LUnionTag {
    public TextSpan span
    public BExpr    unionValue
}

/// A payload field of a union already known to hold `variant`; its type is `variant`'s field `index`.
public struct LUnionField {
    public TextSpan  span
    public BExpr     unionValue
    public VariantId variant
    public i64       index
}

/// An error's code: its case's program-wide number, 0 for none (type u32).
public struct LErrorCode {
    public TextSpan span
    public BExpr    error
}

/// A payload field of an error already known to be `variant`.
public struct LErrorField {
    public TextSpan  span
    public BExpr     error
    public VariantId variant
    public i64       index
}

/// `(target = value)` as an expression; used for pattern bindings.
public struct LAssignExpr {
    public TextSpan span
    public BExpr    target
    public BExpr    value
}

/// C's comma operator: evaluates `effects`, then `value`.
public struct LSequence {
    public TextSpan    span
    public List<BExpr> effects
    public BExpr       value
}

/// An element read whose index the compiler proved in range (loop over a sequence).
public struct LIndexUnchecked {
    public TextSpan span
    public BExpr    target
    public BExpr    index
    public Type     type
}

/// The next char of `text` at byte offset `position` (a local), advancing it (type char).
public struct LNextChar {
    public TextSpan span
    public BExpr    text
    public LocalId  position
}

/// The value of an expression that never completes (it jumped, failed or panicked).
public struct LNever {
    public TextSpan span
    public Type     type
}

/// A function value: `function`'s code with `env` (the captures tuple) or no environment.
public struct LFunctionValue {
    public TextSpan span
    public FuncId   function
    // Q1: round 4 redoes this (LoweredNodes.cs:118).
    public LocalId env = -1
    public Type    functionType
}

/// Whether the process-wide selector `byn_mutant` is `id` (a `--mutate` build).
public struct LMutantIs {
    public TextSpan span
    public i64      id
}

/// Counts one hit of coverage counter `id` (a `--coverage` build).
public struct LCount {
    public TextSpan span
    public i64      id
}

/// The value of a `void` expression whose effects were already emitted.
public struct LVoid {
    public TextSpan span
}

// ── Coverage probes (CoverageProbes.cs; keyed by bound node, Q1098) ──────────

/// C# `BoundProbe`: the `Syntax` (its span) and the counter id.
public struct BoundProbe {
    public TextSpan span
    public i64      id
}

/// C# `BoundBranchProbe`.
public struct BoundBranchProbe {
    public TextSpan span
    public i64      whenTrue
    public i64      whenFalse
}

/// One `(ErrorVariantSymbol Variant, int Id)` of a `BoundErrorProbe`.
public struct ErrorProbeVariant {
    public VariantId variant
    public i64       id
}

/// C# `BoundErrorProbe`.
public struct BoundErrorProbe {
    public TextSpan span
    public List<ErrorProbeVariant> variants = []
}

/// C# `CoverageProbes`, keyed by bound node.
public struct CoverageProbes {
    public i64                          count      = 0
    public Map<BNode, BoundProbe>       statements = []
    public Map<BNode, BoundBranchProbe> branches   = []
    public Map<BNode, BoundErrorProbe>  errors     = []
}

// ── Program ──────────────────────────────────────────────────────────────────

/// `LoweredFunction`: a function body with every local (not parameter) it uses, in first-use order.
public struct LoweredFunction {
    public FuncId        symbol
    public List<LocalId> locals
    public i64           contextSlots
    public i64           panicSlots
    public BStmt         body
}

/// `LoweredProgram`, with a `Ctx` passed alongside instead of `Compilation`. C#'s `CoverageProbes? Coverage` is
/// `covering` and `coverage`: an optional unique value cannot be moved out of the lowerer's state.
public struct LoweredProgram {
    public List<LoweredFunction> functions
    public FuncId                main
    public List<TestId>          tests
    public List<LoweredFunction> testFunctions
    public bool                  mutants  = false
    public bool                  covering = false
    public CoverageProbes        coverage = {}
}

// ── Arenas ───────────────────────────────────────────────────────────────────

/// The arenas of the lowered kinds, one list per `LKind`.
public struct LTree {
    public List<LLabel>            labels            = []
    public List<LGoto>             gotoStmts         = []
    public List<LLoop>             loops             = []
    public List<LReturn>           returnStmts       = []
    public List<LReturnError>      returnErrors      = []
    public List<LFailingCall>      failingCalls      = []
    public List<LWrite>            writes            = []
    public List<LPanic>            panics            = []
    public List<LSetContext>       setContexts       = []
    public List<LFreeArena>        freeArenas        = []
    public List<LPushPanicHandler> pushPanicHandlers = []
    public List<LPopPanicHandler>  popPanicHandlers  = []
    public List<LClaim>            claims            = []
    public List<LOptionalHas>      optionalHass      = []
    public List<LOptionalValue>    optionalValues    = []
    public List<LUnionTag>         unionTags         = []
    public List<LUnionField>       unionFields       = []
    public List<LErrorCode>        errorCodes        = []
    public List<LErrorField>       errorFields       = []
    public List<LAssignExpr>       assignExprs       = []
    public List<LSequence>         sequences         = []
    public List<LIndexUnchecked>   indexUncheckeds   = []
    public List<LNextChar>         nextChars         = []
    public List<LNever>            neverValues       = []
    public List<LFunctionValue>    functionValues    = []
    public List<LMutantIs>         mutantIss         = []
    public List<LCount>            counts            = []
    public List<LVoid>             voidValues        = []
}

// ── Constructors ─────────────────────────────────────────────────────────────

public LNode addLLabel(ref LTree t, from move LLabel n) uses alloc {
    t.labels.append(move n)
    return lNode(.label, at: t.labels.length - 1)
}

public LNode addLGoto(ref LTree t, from move LGoto n) uses alloc {
    t.gotoStmts.append(move n)
    return lNode(.gotoStmt, at: t.gotoStmts.length - 1)
}

public LNode addLLoop(ref LTree t, from move LLoop n) uses alloc {
    t.loops.append(move n)
    return lNode(.loop, at: t.loops.length - 1)
}

public LNode addLReturn(ref LTree t, from move LReturn n) uses alloc {
    t.returnStmts.append(move n)
    return lNode(.returnStmt, at: t.returnStmts.length - 1)
}

public LNode addLReturnError(ref LTree t, from move LReturnError n) uses alloc {
    t.returnErrors.append(move n)
    return lNode(.returnError, at: t.returnErrors.length - 1)
}

public LNode addLFailingCall(ref LTree t, from move LFailingCall n) uses alloc {
    t.failingCalls.append(move n)
    return lNode(.failingCall, at: t.failingCalls.length - 1)
}

public LNode addLWrite(ref LTree t, from move LWrite n) uses alloc {
    t.writes.append(move n)
    return lNode(.write, at: t.writes.length - 1)
}

public LNode addLPanic(ref LTree t, from move LPanic n) uses alloc {
    t.panics.append(move n)
    return lNode(.panic, at: t.panics.length - 1)
}

public LNode addLSetContext(ref LTree t, from move LSetContext n) uses alloc {
    t.setContexts.append(move n)
    return lNode(.setContext, at: t.setContexts.length - 1)
}

public LNode addLFreeArena(ref LTree t, from move LFreeArena n) uses alloc {
    t.freeArenas.append(move n)
    return lNode(.freeArena, at: t.freeArenas.length - 1)
}

public LNode addLPushPanicHandler(ref LTree t, from move LPushPanicHandler n) uses alloc {
    t.pushPanicHandlers.append(move n)
    return lNode(.pushPanicHandler, at: t.pushPanicHandlers.length - 1)
}

public LNode addLPopPanicHandler(ref LTree t, from move LPopPanicHandler n) uses alloc {
    t.popPanicHandlers.append(move n)
    return lNode(.popPanicHandler, at: t.popPanicHandlers.length - 1)
}

public LNode addLClaim(ref LTree t, from move LClaim n) uses alloc {
    t.claims.append(move n)
    return lNode(.claim, at: t.claims.length - 1)
}

public LNode addLOptionalHas(ref LTree t, from move LOptionalHas n) uses alloc {
    t.optionalHass.append(move n)
    return lNode(.optionalHas, at: t.optionalHass.length - 1)
}

public LNode addLOptionalValue(ref LTree t, from move LOptionalValue n) uses alloc {
    t.optionalValues.append(move n)
    return lNode(.optionalValue, at: t.optionalValues.length - 1)
}

public LNode addLUnionTag(ref LTree t, from move LUnionTag n) uses alloc {
    t.unionTags.append(move n)
    return lNode(.unionTag, at: t.unionTags.length - 1)
}

public LNode addLUnionField(ref LTree t, from move LUnionField n) uses alloc {
    t.unionFields.append(move n)
    return lNode(.unionField, at: t.unionFields.length - 1)
}

public LNode addLErrorCode(ref LTree t, from move LErrorCode n) uses alloc {
    t.errorCodes.append(move n)
    return lNode(.errorCode, at: t.errorCodes.length - 1)
}

public LNode addLErrorField(ref LTree t, from move LErrorField n) uses alloc {
    t.errorFields.append(move n)
    return lNode(.errorField, at: t.errorFields.length - 1)
}

public LNode addLAssignExpr(ref LTree t, from move LAssignExpr n) uses alloc {
    t.assignExprs.append(move n)
    return lNode(.assignExpr, at: t.assignExprs.length - 1)
}

public LNode addLSequence(ref LTree t, from move LSequence n) uses alloc {
    t.sequences.append(move n)
    return lNode(.sequence, at: t.sequences.length - 1)
}

public LNode addLIndexUnchecked(ref LTree t, from move LIndexUnchecked n) uses alloc {
    t.indexUncheckeds.append(move n)
    return lNode(.indexUnchecked, at: t.indexUncheckeds.length - 1)
}

public LNode addLNextChar(ref LTree t, from move LNextChar n) uses alloc {
    t.nextChars.append(move n)
    return lNode(.nextChar, at: t.nextChars.length - 1)
}

public LNode addLNever(ref LTree t, from move LNever n) uses alloc {
    t.neverValues.append(move n)
    return lNode(.neverValue, at: t.neverValues.length - 1)
}

public LNode addLFunctionValue(ref LTree t, from move LFunctionValue n) uses alloc {
    t.functionValues.append(move n)
    return lNode(.functionValue, at: t.functionValues.length - 1)
}

public LNode addLMutantIs(ref LTree t, from move LMutantIs n) uses alloc {
    t.mutantIss.append(move n)
    return lNode(.mutantIs, at: t.mutantIss.length - 1)
}

public LNode addLCount(ref LTree t, from move LCount n) uses alloc {
    t.counts.append(move n)
    return lNode(.count, at: t.counts.length - 1)
}

public LNode addLVoid(ref LTree t, from move LVoid n) uses alloc {
    t.voidValues.append(move n)
    return lNode(.voidValue, at: t.voidValues.length - 1)
}

/// `e.Type` for a bound or lowered expression (LoweredNodes.cs:83-127; Q856, moved from lower.byn `t2Type`).
public Type typeOf(in semantics.Ctx c, through in LTree t, for LNode e) {
    unless isLowered(e) {
        return semantics.exprType(in c, for: e)
    }
    let i = lIndexOf(e)
    switch lKindOf(e) {
        case .optionalHas: return semantics.prim(.bool)
        case .optionalValue: return t.optionalValues[i].type
        case .unionTag: return semantics.prim(.i32)
        case .unionField: return c.locals[c.unionVariants[t.unionFields[i].variant].fields[t.unionFields[i].index]].type
        case .errorCode: return semantics.prim(.u32)
        case .errorField: return c.locals[c.errorVariants[t.errorFields[i].variant].fields[t.errorFields[i].index]].type
        case .assignExpr: return typeOf(in c, through: in t, for: t.assignExprs[i].target)
        case .sequence: return typeOf(in c, through: in t, for: t.sequences[i].value)
        case .indexUnchecked: return t.indexUncheckeds[i].type
        case .nextChar: return semantics.prim(.char)
        case .neverValue: return t.neverValues[i].type
        case .functionValue: return t.functionValues[i].functionType
        // coverage-exempt: Q1099 through `case .count: return semantics.prim(.void)`
        case .mutantIs: return semantics.prim(.bool)
        case .count: return semantics.prim(.void)
        case .voidValue: return semantics.prim(.void)
        // coverage-exempt: Q766
        default: return semantics.errorType()
    }
}

/// `n.Syntax.Span` for a bound or lowered node (Q856, moved from lower.byn `t2Span`).
public TextSpan spanOf(in semantics.Ctx c, through in LTree t, for LNode n) {
    unless isLowered(n) {
        return semantics.nodeSpan(in c, for: n)
    }
    let i = lIndexOf(n)
    switch lKindOf(n) {
        case .label: return t.labels[i].span
        case .gotoStmt: return t.gotoStmts[i].span
        case .loop: return t.loops[i].span
        case .returnStmt: return t.returnStmts[i].span
        case .returnError: return t.returnErrors[i].span
        case .failingCall: return t.failingCalls[i].span
        case .write: return t.writes[i].span
        case .panic: return t.panics[i].span
        case .setContext: return t.setContexts[i].span
        case .freeArena: return t.freeArenas[i].span
        case .pushPanicHandler: return t.pushPanicHandlers[i].span
        case .popPanicHandler: return t.popPanicHandlers[i].span
        case .claim: return t.claims[i].span
        case .optionalHas: return t.optionalHass[i].span
        case .optionalValue: return t.optionalValues[i].span
        case .unionTag: return t.unionTags[i].span
        case .unionField: return t.unionFields[i].span
        case .errorCode: return t.errorCodes[i].span
        case .errorField: return t.errorFields[i].span
        case .assignExpr: return t.assignExprs[i].span
        case .sequence: return t.sequences[i].span
        case .indexUnchecked: return t.indexUncheckeds[i].span
        case .nextChar: return t.nextChars[i].span
        case .neverValue: return t.neverValues[i].span
        case .functionValue: return t.functionValues[i].span
        // coverage-exempt: Q1099 through `case .count: return t.counts[i].span`
        case .mutantIs: return t.mutantIss[i].span
        case .count: return t.counts[i].span
        case .voidValue: return t.voidValues[i].span
    }
}
== emitter/main.byn
// bayan-emit: the self-hosted C emitter (spec 011). The arguments of `bayan-check` plus `--mode` and `--tests`,
// the shared CLI pieces of `semantics/cli.byn` (D2), then `lower` and `cprint.emit`. The C# it follows:
// `CliApp.EmitC` (CliApp.cs:409), the compilation of `RunTests.Execute` (RunTests.cs:70-83: the input alone,
// its directory as package root, tests with `*.test.byn`) and `bayan build --emit-c` (CliTests.cs:276-283).
//
//     bayan-emit [--ascii] [--color <when>] [--mode debug|safe|fast] [--tests] <path>
//                                    the C `bayan build --emit-c <path>` writes, on stdout
//     bayan-emit [--mode m] [--tests] --package <dir> <file>
//                                    `<file>` compiled alone with `<dir>` as package root, as `RunTests` does
//     bayan-emit [--mode m] --many <dir>
//                                    `== <name>` and, for every `*.byn` in `<dir>` in name order, its
//                                    `--package <dir>` output (`--tests` for `*.test.byn`), then `exit <n>`
//                                    when that input's exit is not 0
//     bayan-emit [--mode m] [--coverage] [--mutate] <path>
//                                    the C of a `--coverage` build (probes) or a `--mutate` build (mutant switches)
//     bayan-emit [--mode m] --time <path>
//                                    the nanoseconds spent in `lower` and `cprint.emit` on stdout, and
//                                    `lower … emit …` on stderr
//
// Paths are absolute (R1): Bayan has no current directory (Q571).

import lexer
import semantics
import emitter.cprint

type CompilationOptions = semantics.CompilationOptions
type T26Options         = semantics.T26Options

const exitOk: i32      = 0
const exitFailure: i32 = 1
const exitUsage: i32   = 2

i32 usage() {
    Io.stderr.write(
        "usage: bayan-emit [--ascii] [--color <when>] [--mode debug|safe|fast] [--tests] <path> | [--mode m] [--tests] --package <dir> <file> | [--mode m] --many <dir> | [--mode m] --time <path>\n",
    )
    return exitUsage
}

/// CliApp.cs:409 `EmitC` on a compiled program.
public string t12Emit(ref semantics.Ctx c, by string mode) uses alloc {
    var l = LCtx {}
    let program = lower(ref c, to: ref l)
    return cprint.emit(ref c, from: in l.tree, through: in program, by: mode == "debug")
}

/// `EmitC` with `--coverage` (CliApp.cs:639-641: `CoverageInstrumenter.Instrument`, then `Lower` with its probes) or
/// `--mutate` (CliApp.cs:840-842: `Schemata.Build`, then `Lower` with its switches); neither skips a file here.
string t10Emit(ref semantics.Ctx c, by string mode, through bool covering, as bool mutating) uses alloc, clock, fs {
    var l = LCtx {}
    let none = List<string>()
    if covering {
        var map = instrument(ref c, for: in none)
        l.covering = true
        l.coverage = CoverageProbes {
            count: map.probes.count,
            statements: map.probes.statements.take(),
            branches: map.probes.branches.take(),
            errors: map.probes.errors.take(),
        }
    }
    if mutating {
        var schema = buildSchema(ref c, for: in none)
        l.mutating = true
        l.mutants = schema.switches.take()
    }
    let program = lower(ref c, to: ref l)
    return cprint.emit(ref c, from: in l.tree, through: in program, by: mode == "debug")
}

bool t12HasErrors(in semantics.Ctx c) {
    for d in c.diagnostics {
        return true if !d.isWarning
    }
    return false
}

/// The compilation of `RunTests.Execute` (RunTests.cs:80): `file` alone, `dir` as package root, tests when `tests`.
semantics.Ctx t12Compile(string dir, at move List<u8> bytes, for string file, by bool tests) {
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create(Path.fileName(file), from: move bytes))
    let options = CompilationOptions { includeTests: tests }
    return semantics.create(from: move sources, at: dir, by: in options)
}

/// Reports `c` as `CliApp.Compile` does (CliApp.cs:298) and fails as `Failed` does (`build`), or with a bare exit 1 when
/// `tests` (`Test`, CliApp.cs:605), or emits it to stdout.
i32 t12Finish(
    ref semantics.Ctx c,
    for in T26Options o,
    by in semantics.T26Symbols symbols,
    through string mode,
    as bool tests,
    bool covering = false,
    bool mutating = false
) {
    var reported = List<semantics.T26Reported>()
    semantics.t26Report(in o, by: in symbols, for: ref c, to: ref reported)
    return tests ? exitFailure : semantics.t26Failed(in o, from: in reported, by: in symbols) if t12HasErrors(in c)
    if covering || mutating {
        Io.stdout.write(t10Emit(ref c, by: mode, through: covering, as: mutating))
        return exitOk
    }
    Io.stdout.write(t12Emit(ref c, by: mode))
    return exitOk
}

i32 t12Package(
    string dir,
    at string file,
    by bool tests,
    through string mode,
    for in semantics.T26Symbols symbols,
    bool covering = false,
    bool mutating = false
) {
    let bytes = Io.readFile(file) catch {
        Io.stderr.write($"bayan: not found: {file}\n")
        return exitFailure
    }
    var c = t12Compile(dir, at: move bytes, for: file, by: tests)
    let o = T26Options { path: file }
    return t12Finish(ref c, for: in o, by: in symbols, through: mode, as: tests, covering: covering, mutating: mutating)
}

/// `--many`: every `*.byn` in `dir`, in name order; the shape of `bayan-check --many`. Exits 0: the worst exit that is not 1 (src/semantics/main.byn:102-107), and a `--package` run is 0 or 1.
i32 t12Many(string dir, by string mode, for in semantics.T26Symbols symbols) {
    var names = Io.listDir(dir) catch return usage()
    names.sort()
    for name in names {
        unless name.endsWith(".byn") {
            continue
        }
        print($"== {name}")
        let exit = t12Package(dir, at: $"{dir}/{name}", by: name.endsWith(".test.byn"), through: mode, for: in symbols)
        if exit != exitOk {
            print($"exit {exit}")
        }
    }
    return exitOk
}

/// `--time`: `lower` and `cprint.emit` on the compilation of `path`, the total on stdout (the shape of `bayan-check --time`).
i32 t12Timed(string path, by string mode, through bool ascii) {
    let symbols = semantics.t26Symbols(ascii)
    var args = List<string>()
    args.append(path)
    let o = semantics.t26ParseBuildOptions(in args, allowSpans: false) ?? return exitUsage
    var reported = List<semantics.T26Reported>()
    var ok = false
    var c = semantics.t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    unless ok {
        return semantics.t26Failed(in o, from: in reported, by: in symbols)
    }
    var l = LCtx {}
    let t0 = Io.monotonicNanos()
    let program = lower(ref c, to: ref l)
    let t1 = Io.monotonicNanos()
    let text = cprint.emit(ref c, from: in l.tree, through: in program, by: mode == "debug")
    let t2 = Io.monotonicNanos()
    print($"{t2 - t0}")
    Io.stderr.write($"lower {t1 - t0} emit {t2 - t1} bytes {text.length}\n")
    return exitOk
}

i32 main(ReadOnlySpan<string> args) {
    var ascii = false
    var mode = "safe"
    var tests = false
    var package: string? = null
    var many: string? = null
    var time: string? = null
    var covering = false
    var mutating = false
    var rest = List<string>()
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--" {
            // CliApp.cs:325 `TakeGlobalOptions` and :163 `ParseBuildOptions` stop here: the rest is the program's.
            for k in i..args.length {
                rest.append(args[k])
            }
            break
        } else if a == "--ascii" {
            ascii = true
        } else if a == "--color" || a.startsWith("--color=") {
            // CliApp.cs:315 `TakeGlobalOptions`: the value is checked and paints nothing (plain style only).
            var value = ""
            if a == "--color" && i + 1 < args.length {
                i += 1
                value = args[i]
            } else if a != "--color" {
                value = a["--color=".length..a.length]
            }
            if value != "auto" && value != "always" && value != "never" {
                Io.stderr.write($"bayan: unknown color setting `{value}` (expected auto, always or never)\n")
                return exitUsage
            }
        } else if a == "--mode" && i + 1 < args.length {
            i += 1
            mode = args[i]
        } else if a == "--tests" {
            tests = true
        } else if a == "--coverage" {
            covering = true
        } else if a == "--mutate" {
            mutating = true
        } else if a == "--package" && i + 1 < args.length {
            i += 1
            package = args[i]
        } else if a == "--many" && i + 1 < args.length {
            i += 1
            many = args[i]
        } else if a == "--time" && i + 1 < args.length {
            i += 1
            time = args[i]
        } else {
            rest.append(a)
        }
        i += 1
    }
    if mode != "debug" && mode != "safe" && mode != "fast" {
        Io.stderr.write($"bayan: unknown mode `{mode}` (expected debug, safe or fast)\n")
        return exitUsage
    }
    let symbols = semantics.t26Symbols(ascii)
    if (many is { } dir) {
        return rest.length == 0 ? t12Many(dir, by: mode, for: in symbols) : usage()
    }
    if (time is { } path) {
        return rest.length == 0 ? t12Timed(path, by: mode, through: ascii) : usage()
    }
    if (package is { } root) {
        return rest.length == 1 ? t12Package(
            root,
            at: rest[0],
            by: tests,
            through: mode,
            for: in symbols,
            covering: covering,
            mutating: mutating,
        ) : usage()
    }
    let o = semantics.t26ParseBuildOptions(in rest, allowSpans: false) ?? return exitUsage
    var reported = List<semantics.T26Reported>()
    var ok = false
    var c = semantics.t26Compile(in o, by: in symbols, to: ref reported, through: ref ok, includeTests: tests)
    unless ok {
        return tests ? exitFailure : semantics.t26Failed(in o, from: in reported, by: in symbols)
    }
    // CliApp.cs:464 `RefuseLibrary` (`Build`; `Test` has none); `c.library` and `c.packageName` are the manifest's kind and name.
    if !tests && c.library {
        Io.stderr.write(
            $"bayan: `{c.packageName}` is a library, so there is no program to build; `bayan test` runs its tests\n",
        )
        return exitUsage
    }
    if covering || mutating {
        Io.stdout.write(t10Emit(ref c, by: mode, through: covering, as: mutating))
        return exitOk
    }
    Io.stdout.write(t12Emit(ref c, by: mode))
    return exitOk
}
== emitter/powerassert.byn
// T5: PowerAssert.cs 1-78.

/// `Bar`: the column bar.
const powerAssertBar: string = "│"

/// `Indent`: starts every diagram line, so the bars sit under the statement after the runtime's `panic: `.
const powerAssertIndent: string = "       "

/// `Piece`: `text`, or the value of column `value` when that is not -1. It is written when every column in `allShown`
/// is shown, none in `noneShown` is, and, when `anyFrom` is not -1, some column from that index on is (C#'s `When`,
/// `Unless` and `AnyFrom`; `anyFrom` -1 is null).
struct PowerAssertPiece {
    string    text
    i64       value
    List<i64> allShown
    List<i64> noneShown
    i64       anyFrom
}

/// One line of `Flatten`'s input with the blanks around its break cut off; `next` is where the next line starts, -1 for the last.
struct PowerAssertLine {
    i64 from
    i64 until
    i64 next
}

/// PowerAssert.cs:16 `Flatten`'s trimming of the line of `text` that starts at `start`: `TrimStart(' ', '\t')` when it is not the first line
/// and `TrimEnd(' ', '\t', '\r')` when it is not the last.
PowerAssertLine powerAssertLine(string text, at i64 start, by bool first) {
    var end = text.length
    var next: i64 = -1
    let at = text.position("\n", from: start) ?? -1
    if at >= 0 {
        end = at
        next = at + 1
    }
    var from = start
    var until = end
    if !first {
        while from < until && (text.bytes[from] is 32 or 9) {
            from += 1
        }
    }
    if next >= 0 {
        while until > from
                && (text.bytes[until - 1] == 32 || text.bytes[until - 1] == 9 || text.bytes[until - 1] == 13) {
            until -= 1
        }
    }
    return PowerAssertLine { from: from, until: until, next: next }
}

/// PowerAssert.cs:16 `Flatten`: source text on one line; each line break, with the blanks around it, becomes one space.
string powerAssertFlatten(string text) uses alloc {
    unless text.contains("\n") {
        return text
    }
    var sb = StrBuf()
    var start: i64 = 0
    var first = true
    while start >= 0 {
        let line = powerAssertLine(text, at: start, by: first)
        unless first {
            sb.append(" ")
        }
        sb.append(text[line.from..line.until])
        first = false
        start = line.next
    }
    return $"{sb.finish()}"
}

/// PowerAssert.cs:29 `Column` (Q848): the rune count of `before` once flattened.
public i64 powerAssertColumn(string before) {
    unless before.contains("\n") {
        return before.runeCount
    }
    var count: i64 = 0
    var start: i64 = 0
    var first = true
    while start >= 0 {
        let line = powerAssertLine(before, at: start, by: first)
        unless first {
            count += 1
        }
        count += before[line.from..line.until].runeCount
        first = false
        start = line.next
    }
    return count
}

/// PowerAssert.cs:47 `Diagram`'s local `Add`: appends a piece, dropping an `anyFrom` past the last column, and an `anyFrom`
/// that an always-shown column from there on satisfies, and the columns of `whens` that are always shown.
void powerAssertAdd(
    List<i64> columns,
    by List<bool> always,
    to ref List<PowerAssertPiece> pieces,
    for string text,
    at i64 value,
    through List<i64> whens,
    from List<i64> unlesses,
    as i64 anyFrom
) uses alloc {
    var from = anyFrom
    if from != -1 {
        return if from >= columns.length
        for j in from..columns.length {
            if always[j] {
                from = -1
                break
            }
        }
    }
    var kept = List<i64>()
    for k in whens {
        unless always[k] {
            kept.append(k)
        }
    }
    var noneShown = List<i64>()
    for k in unlesses {
        noneShown.append(k)
    }
    pieces.append(
        PowerAssertPiece { text: text, value: value, allShown: move kept, noneShown: move noneShown, anyFrom: from },
    )
}

/// PowerAssert.cs:47 `Diagram`'s local `Gap`.
string powerAssertGap(List<i64> columns, at i64 k) uses alloc {
    return " ".repeated(columns[k] - (k == 0 ? 0 : columns[k - 1] + 1))
}

/// PowerAssert.cs:47 `Diagram`: the pieces after the statement, for ascending, distinct `columns`: a row of bars, then
/// each value hung from its bar, rightmost first, under the bars to its left. A column that is not `always` shown (a side
/// that may not run) is shown only when its value was computed; the guards of the pieces say so, and name only such columns.
List<PowerAssertPiece> powerAssertDiagram(List<i64> columns, by List<bool> always) uses alloc {
    var pieces = List<PowerAssertPiece>()
    let none = List<i64>()
    let line = $"\n{powerAssertIndent}"
    // A missing column leaves a blank where its bar would be, but never at the end of the row.
    powerAssertAdd(columns, by: always, to: ref pieces, for: line, at: -1, through: none, from: none, as: 0)
    for k in 0..columns.length {
        var only = List<i64>()
        only.append(k)
        powerAssertAdd(
            columns,
            by: always,
            to: ref pieces,
            for: $"{powerAssertGap(columns, at: k)}{powerAssertBar}",
            at: -1,
            through: only,
            from: none,
            as: -1,
        )
        unless always[k] {
            powerAssertAdd(
                columns,
                by: always,
                to: ref pieces,
                for: $"{powerAssertGap(columns, at: k)} ",
                at: -1,
                through: none,
                from: only,
                as: k + 1,
            )
        }
    }
    var k = columns.length - 1
    while k >= 0 {
        var only = List<i64>()
        only.append(k)
        powerAssertAdd(columns, by: always, to: ref pieces, for: line, at: -1, through: only, from: none, as: -1)
        for j in 0..k {
            var both = List<i64>()
            both.append(k)
            both.append(j)
            var left = List<i64>()
            left.append(j)
            powerAssertAdd(
                columns,
                by: always,
                to: ref pieces,
                for: $"{powerAssertGap(columns, at: j)}{powerAssertBar}",
                at: -1,
                through: both,
                from: none,
                as: -1,
            )
            unless always[j] {
                powerAssertAdd(
                    columns,
                    by: always,
                    to: ref pieces,
                    for: $"{powerAssertGap(columns, at: j)} ",
                    at: -1,
                    through: only,
                    from: left,
                    as: -1,
                )
            }
        }
        powerAssertAdd(
            columns,
            by: always,
            to: ref pieces,
            for: powerAssertGap(columns, at: k),
            at: -1,
            through: only,
            from: none,
            as: -1,
        )
        powerAssertAdd(columns, by: always, to: ref pieces, for: "", at: k, through: only, from: none, as: -1)
        k -= 1
    }
    return pieces
}
== emitter/schemata.byn
// T10: Mutator.cs 49-342 (`Find`, `InTest`, the `Walker`, `Constant`, `OpText`, `Fits`, `Folds`; spec 013 R2, R4-R6) and
// Schemata.cs 23-162 (`SitesJson`, `SitesPath`, `Build`, `MarkOf`, `Rebinds`, `Offset`, `Transfer`). C# keys by `Node`
// reference where this keys by `t10SyntaxKey` (coverage.byn, Q1098), and computes on `Int128` where this computes on
// `Big` with the private `t10Big*` helpers below (Q1099).

import lexer
import parser
import semantics

const mutatorBoundary: string    = "boundary"
const mutatorRelational: string  = "relational"
const mutatorLogical: string     = "logical"
const mutatorCondition: string   = "condition"
const mutatorBool: string        = "bool"
const mutatorArithmetic: string  = "arithmetic"
const mutatorLiteral: string     = "literal"
const mutatorNegation: string    = "negation"
const mutatorStatement: string   = "statement"
const mutatorEmptyReturn: string = "emptyReturn"
const mutatorVariant: string     = "variant"

/// Mutator.cs:46 `Operators`, in the order of the table in SPEC §20.
public List<string> mutatorOperators() uses alloc {
    var ops = List<string>()
    ops.append(mutatorBoundary)
    ops.append(mutatorRelational)
    ops.append(mutatorLogical)
    ops.append(mutatorCondition)
    ops.append(mutatorBool)
    ops.append(mutatorArithmetic)
    ops.append(mutatorLiteral)
    ops.append(mutatorNegation)
    ops.append(mutatorStatement)
    ops.append(mutatorEmptyReturn)
    ops.append(mutatorVariant)
    return ops
}

/// C# `MutationSite`: where the mutant is, what changes, and the bound node that replaces `originalNode`.
public struct MutationSite {
    public string file
    public i64    line
    public i64    column
    public string op
    public string original
    public string mutated
    public FuncId function
    public BNode  originalNode
    public BNode  mutatedNode
}

/// C# `Mutations`.
public struct Mutations {
    public List<MutationSite> sites      = []
    public Map<string, i64>   notEmitted = []
}

/// C# `SchemaSite`.
public struct SchemaSite {
    public i64          id
    public MutationSite site
    public bool         emitted
    public string?      unobservable = null
}

/// C# `BoundMutant`.
public struct BoundMutant {
    public i64   id
    public BNode node
}

/// C# `BoundMutantSwitch`: the `Syntax` (its span), the original node and the mutants.
public struct BoundMutantSwitch {
    public TextSpan span
    public BNode    original
    public List<BoundMutant> mutants = []
}

/// C# `Schema`.
public struct Schema {
    public List<SchemaSite> sites      = []
    public Map<string, i64> notEmitted = []
    public Map<BNode, BoundMutantSwitch> switches = []
}

// ── Mutator (Mutator.cs:49-342) ──────────────────────────────────────────────

/// Mutator.cs:49 `Find`; an empty `skipFiles` is C#'s null.
public Mutations find(ref Ctx c, for in List<string> skipFiles) uses alloc {
    var w = MutatorWalker { source: lexer.SourceText.create("", from: List<u8>()) }
    for op in mutatorOperators() {
        w.notEmitted[op] = 0
    }
    var walked: Map<string, bool> = []
    for k in 0..c.moduleOrder.length {
        let m = c.moduleOrder[k]
        for i in 0..c.modules[m].allFunctions.length {
            let fn = c.modules[m].allFunctions[i]
            continue if c.functions[fn].body == -1
                || semantics.functionIsGeneric(ref c, by: fn)
                || coverageInTest(in c, for: fn)
            let kind = c.functions[fn].kind
            // coverage-exempt: Q1099
            continue if !(kind is .function or .method or .constructor or .getter or .main or .lambda)
            let file = c.functions[fn].file
            continue if file == -1 || t10Contains(in skipFiles, for: c.files[file].path)
            // Instances of one template share its body syntax, and so its sites.
            let key = t10SyntaxKey(in c, for: c.functions[fn].body, at: file)
            continue if walked.contains(key)
            walked[key] = true
            mutatorFunction(ref c, through: ref w, for: fn, at: file)
        }
    }
    return Mutations { sites: w.sites.take(), notEmitted: w.notEmitted.take() }
}

/// An integer literal indexing a fixed array: the array's length and whether the index counts from the end.
struct ArrayIndex {
    i64  length
    bool fromEnd
}

/// C# `Mutator.Walker`.
struct MutatorWalker {
    List<MutationSite>     sites         = []
    Map<string, i64>       notEmitted    = []
    FuncId                 fn            = -1
    FileId                 file          = -1
    lexer.SourceText       source
    /// `_arrayIndexes`, by literal.
    Map<BNode, ArrayIndex> arrayIndexes  = []
    /// `_uninitialized`.
    Map<LocalId, bool>     uninitialized = []
}

/// Mutator.cs:87 `Function`.
void mutatorFunction(ref Ctx c, through ref MutatorWalker w, for FuncId fn, at FileId file) uses alloc {
    w.fn = fn
    if w.file != file {
        w.source = lexer.SourceText.create(c.files[file].path, from: c.files[file].text.copy())
        w.file = file
    }
    w.uninitialized = []
    w.arrayIndexes = []
    let body = c.functions[fn].body
    for d in semantics.descendants(in c, for: body) {
        if semantics.boundKind(d) == .localDecl && c.bLocalDecls[d & 0xFFFFFFFF].initializer == -1 {
            w.uninitialized[c.bLocalDecls[d & 0xFFFFFFFF].local] = true
        }
    }
    // An `out` parameter must be assigned before every return (BYN2103).
    for p in c.functions[fn].parameters {
        if c.locals[p].modifier == .outKeyword {
            w.uninitialized[p] = true
        }
    }
    mutatorVisit(ref c, through: ref w, for: body, at: -1)
}

/// The literal of `BoundIndex.Index` as Mutator.cs:110 reads it: the index itself or the operand of its conversion; -1 for none.
BNode t10IndexLiteral(in Ctx c, for BExpr index) {
    return index if semantics.boundKind(index) == .literal
    if semantics.boundKind(index) == .conversion {
        let operand = c.bConversions[index & 0xFFFFFFFF].operand
        return operand if semantics.boundKind(operand) == .literal
    }
    return -1
}

/// Mutator.cs:99 `Visit`; `parent` -1 is C#'s null.
void mutatorVisit(ref Ctx c, through ref MutatorWalker w, for BNode node, at BNode parent) uses alloc {
    let kind = semantics.boundKind(node)
    // Patterns hold constants the switch checks for overlap and exhaustiveness; they are not mutated.
    return if semantics.isPatternKind(kind)
    let i = node & 0xFFFFFFFF
    let syntax = semantics.nodeSyntax(in c, for: node)
    var syntaxKind: semantics.NodeSyntaxKind? = null
    if syntax is not null {
        syntaxKind = syntax.kind
    }
    switch kind {
        case .binary:
            if (semantics.exprSyntax(in c, for: node) is { } be) {
                // coverage-exempt: Q1099
                if be.kind == .binaryExpr && be.binaryOp == c.bBinaries[i].op {
                    mutatorOnBinary(ref c, through: ref w, for: node, as: be)
                }
            }
        case .unary:
            if (semantics.exprSyntax(in c, for: node) is { } ue) {
                // coverage-exempt: Q1099
                if c.bUnaries[i].op == .negate && ue.kind == .unaryExpr && ue.op == .negate {
                    let operand = semantics.exprSyntaxNode(in c, at: ue.operand).span
                    mutatorAdd(
                        through: ref w,
                        as: mutatorNegation,
                        at: ue.span,
                        to: w.source.getText(operand),
                        for: node,
                        by: c.bUnaries[i].operand,
                    )
                }
            }
        case .literal:
            mutatorOnLiteral(ref c, through: ref w, for: node, at: parent)
        case .index:
            let target = semantics.exprType(in c, for: c.bIndexes[i].target)
            let index = t10IndexLiteral(in c, for: c.bIndexes[i].index)
            if semantics.kindOf(target) == .array && index != -1 {
                w.arrayIndexes[index] = ArrayIndex {
                    length: c.arrayTypes[target & 0xFFFFFFFF].length,
                    fromEnd: c.bIndexes[i].fromEnd,
                }
            }
        case .exprStmt:
            let expr = c.bExprStmts[i].expr
            let exprKind = semantics.boundKind(expr)
            if syntaxKind == .exprStmt
                    && (exprKind is .call or .builtinCall)
                    && semantics.isVoid(semantics.exprType(in c, for: expr)) {
                // A call's `out` argument is that variable's assignment (BYN2102, BYN2103).
                if exprKind == .call && t10AssignsUninitialized(in c, through: in w, for: expr) {
                    w.notEmitted[mutatorStatement] += 1
                } else {
                    mutatorRemove(ref c, through: ref w, for: node)
                }
            }
        case .assign:
            if syntaxKind == .assignStmt || syntaxKind == .incDecStmt {
                mutatorOnAssign(ref c, through: ref w, for: node)
            }
        case .returnStmt:
            let value = c.bReturns[i].value
            if syntaxKind == .returnStmt && value != -1 {
                // coverage-exempt: Q1099 through `if (rx.value is { } valueSyntax)`
                if syntax is not null {
                    if (syntax.value is { } valueSyntax) {
                        mutatorOnReturn(ref c, through: ref w, for: value, at: valueSyntax)
                    }
                }
            }
        case .failStmt:
            if syntaxKind == .failStmt {
                mutatorOnFail(ref c, through: ref w, for: node)
            }
        case .ifStmt:
            if syntaxKind == .ifStmt || syntaxKind == .unlessStmt || syntaxKind == .guardedStmt {
                mutatorOnCondition(ref c, through: ref w, for: c.bIfs[i].condition, as: false)
            }
        case .whileStmt:
            if syntaxKind == .whileStmt {
                mutatorOnCondition(ref c, through: ref w, for: c.bWhiles[i].condition, as: true)
            }
        case .doWhile:
            // coverage-exempt: Q1099
            if syntaxKind == .doWhileStmt {
                mutatorOnCondition(ref c, through: ref w, for: c.bDoWhiles[i].condition, as: true)
            }
        case .switchStmt:
            var guards = List<BExpr>()
            for section in c.bSwitches[i].sections {
                if section.guard != -1 {
                    guards.append(section.guard)
                }
            }
            for g in guards {
                mutatorOnCondition(ref c, through: ref w, for: g, as: false)
            }
        case .switchExpr:
            var guards = List<BExpr>()
            for arm in c.bSwitchExprs[i].arms {
                if arm.guard != -1 {
                    guards.append(arm.guard)
                }
            }
            for g in guards {
                mutatorOnCondition(ref c, through: ref w, for: g, as: false)
            }
        default: {}
    }
    let span = t10SyntaxSpan(in c, for: node)
    for child in semantics.children(in c, for: node) {
        // A child outside its parent's span was made by the binder (a default argument, an inlined constant).
        let childSpan = t10SyntaxSpan(in c, for: child)
        continue if childSpan.start < span.start || childSpan.end > span.end
        mutatorVisit(ref c, through: ref w, for: child, at: node)
    }
}

/// Mutator.cs:115: whether an `out` argument of `call` is an uninitialized local.
bool t10AssignsUninitialized(in Ctx c, through in MutatorWalker w, for BExpr call) {
    let ci = call & 0xFFFFFFFF
    let callee = c.bCalls[ci].function
    for k in 0..c.bCalls[ci].arguments.length {
        // coverage-exempt: Q1099
        continue if k >= c.functions[callee].parameters.length
        continue if c.locals[c.functions[callee].parameters[k]].modifier != .outKeyword
        let arg = c.bCalls[ci].arguments[k]
        return true if semantics.boundKind(arg) == .local && w.uninitialized.contains(c.bLocals[arg & 0xFFFFFFFF].local)
    }
    return false
}

/// Mutator.cs:145 `OnBinary`.
void mutatorOnBinary(ref Ctx c, through ref MutatorWalker w, for BExpr b, as semantics.ExprSyntax be) uses alloc {
    let i = b & 0xFFFFFFFF
    let op = c.bBinaries[i].op
    if op is .lt or .le or .gt or .ge {
        let boundary: parser.BinaryOp = op == .lt ? .le : op == .le ? .lt : op == .gt ? .ge : .gt
        mutatorChangeOp(ref c, through: ref w, as: mutatorBoundary, for: b, by: be, to: boundary)
        let relational: parser.BinaryOp = op == .lt ? .ge : op == .ge ? .lt : op == .gt ? .le : .gt
        mutatorChangeOp(ref c, through: ref w, as: mutatorRelational, for: b, by: be, to: relational)
    } else if op is .eq or .ne {
        mutatorChangeOp(ref c, through: ref w, as: mutatorRelational, for: b, by: be, to: op == .eq ? .ne : .eq)
    } else if op is .logicalAnd or .logicalOr {
        // `x is T t && t.f` reads what the left side proved; with `||` the right side would not bind.
        if t10HasIs(in c, for: c.bBinaries[i].left) {
            w.notEmitted[mutatorLogical] += 1
        } else {
            mutatorChangeOp(
                ref c,
                through: ref w,
                as: mutatorLogical,
                for: b,
                by: be,
                to: op == .logicalAnd ? .logicalOr : .logicalAnd,
            )
        }
    } else if op is .add or .sub or .mul or .div or .rem {
        let to: parser.BinaryOp = op == .add ? .sub : op == .sub ? .add : op == .mul ? .div : .mul
        // Two constant operands fold at compile time, where overflow and division by zero are errors.
        let type = c.bBinaries[i].type
        var folds = true
        if (t10IntegerConstant(in c, for: c.bBinaries[i].left) is { } l) {
            if (t10IntegerConstant(in c, for: c.bBinaries[i].right) is { } r) {
                if semantics.kindOf(type) == .primitive && !mutatorFolds(to, from: l, to: r, as: type) {
                    folds = false
                }
            }
        }
        if folds {
            mutatorChangeOp(ref c, through: ref w, as: mutatorArithmetic, for: b, by: be, to: to)
        } else {
            w.notEmitted[mutatorArithmetic] += 1
        }
    }
}

/// C# `e.Constant is { Value: Int128 n }`.
Big? t10IntegerConstant(in Ctx c, for BExpr e) {
    if (semantics.exprConstant(in c, for: e) is { } k) {
        return k.integer if k.kind == .integer
    }
    return null
}

/// C# `BoundTree.Descendants(n).Any(n => n is BoundIs)`.
bool t10HasIs(in Ctx c, for BNode n) uses alloc {
    for d in semantics.descendants(in c, for: n) {
        return true if semantics.boundKind(d) == .isExpr
    }
    return false
}

/// Mutator.cs:172 `ChangeOp`: replaces the operator token between the operands, keeping the source around it.
void mutatorChangeOp(
    ref Ctx c,
    through ref MutatorWalker w,
    as string op,
    for BExpr b,
    by semantics.ExprSyntax be,
    to parser.BinaryOp to
) uses alloc {
    let i = b & 0xFFFFFFFF
    let leftEnd = semantics.exprSyntaxNode(in c, at: be.left).span.end
    let between = TextSpan.fromBounds(leftEnd, until: be.right.start)
    let from = mutatorOpText(c.bBinaries[i].op)
    let at = leftEnd + t10IndexOf(w.source.getText(between), for: from)
    let mutated = $"{w.source.getText(TextSpan.fromBounds(be.span.start, until: at))}{mutatorOpText(to)}{w.source.getText(TextSpan.fromBounds(at + from.length, until: be.span.end))}"
    let n = c.bBinaries[i]
    let replacement = semantics.addBinary(
        ref c,
        from: BBinary { span: n.span, op: to, left: n.left, right: n.right, type: n.type },
    )
    mutatorAdd(through: ref w, as: op, at: be.span, to: mutated, for: b, by: replacement)
}

/// Mutator.cs:180 `OnLiteral`.
void mutatorOnLiteral(ref Ctx c, through ref MutatorWalker w, for BExpr l, at BNode parent) uses alloc {
    let i = l & 0xFFFFFFFF
    let value = c.bLiterals[i].value
    let le = semantics.exprSyntax(in c, for: l)
    if value.kind == .flag {
        if le is not null {
            // coverage-exempt: Q1099
            if le.kind == .literalExpr
                    && (le.literalKind is .trueKeyword or .falseKeyword)
                    && (le.literalKind == .trueKeyword) == value.flag {
                let flag = value.flag
                // coverage-exempt: Q1099
                let parentKind = parent == -1 ? semantics.BoundKind.literal : semantics.boundKind(parent)
                // `while true` is how a loop says it ends only by `break` or `return`; `while false` leaves code after it reachable.
                if flag && (parentKind is .whileStmt or .doWhile) {
                    w.notEmitted[mutatorBool] += 1
                } else {
                    let replacement = mutatorConstant(
                        ref c,
                        at: c.bLiterals[i].span,
                        as: semantics.prim(.bool),
                        by: Constant { kind: .flag, flag: !flag },
                    )
                    mutatorAdd(
                        through: ref w,
                        as: mutatorBool,
                        at: le.span,
                        to: flag ? "false" : "true",
                        for: l,
                        by: replacement,
                    )
                }
                return
            }
        }
    }
    let type = c.bLiterals[i].type
    // coverage-exempt: Q1099
    return if !semantics.isInteger(type) || value.kind != .integer
    let n = value.integer
    let e = le ?? return
    var literal: semantics.ExprSyntax? = null
    if e.kind == .literalExpr && e.literalKind == .integer {
        literal = e
        // coverage-exempt: Q1099 through `if operand.kind == .literalExpr && operand.literalKind == .integer { literal = operand }`
    } else if e.kind == .unaryExpr && e.op == .negate && e.operand != -1 {
        let operand = semantics.exprSyntaxNode(in c, at: e.operand)
        if operand.kind == .literalExpr && operand.literalKind == .integer {
            literal = operand
        }
    }
    let lit = literal ?? return
    var suffix = ""
    if (lit.suffix is { } s) {
        suffix = w.source.getText(s)
    }
    var candidates = List<Big>()
    candidates.append(t10BigAdd(n, to: t10Big(1)))
    candidates.append(t10BigSub(n, by: t10Big(1)))
    for m in candidates {
        if !mutatorFits(m, as: type)
                || !mutatorFoldsInParent(in c, for: l, by: m, at: parent, as: type)
                || !mutatorInBounds(through: in w, for: l, by: m) {
            w.notEmitted[mutatorLiteral] += 1
            continue
        }
        let replacement = mutatorConstant(
            ref c,
            at: c.bLiterals[i].span,
            as: type,
            by: Constant { kind: .integer, integer: m },
        )
        mutatorAdd(
            through: ref w,
            as: mutatorLiteral,
            at: e.span,
            to: $"{semantics.bigText(m)}{suffix}",
            for: l,
            by: replacement,
        )
    }
}

/// Mutator.cs:210 `FoldsInParent`: a literal operand of a constant arithmetic expression changes the folded value, which must still fold.
bool mutatorFoldsInParent(in Ctx c, for BExpr l, by Big value, at BNode parent, as Type type) {
    return true if parent == -1 || semantics.boundKind(parent) != .binary
    let b = c.bBinaries[parent & 0xFFFFFFFF]
    return true if !(b.op is .add or .sub or .mul or .div or .rem)
    // C# `b.Left == l` is record equality; the handle stands for the node here (Q1098).
    let other = b.left == l ? b.right : b.left
    let o = t10IntegerConstant(in c, for: other) ?? return true
    return b.left == l ? mutatorFolds(
        b.op,
        from: value,
        to: o,
        as: type,
    ) : mutatorFolds(b.op, from: o, to: value, as: type)
}

/// Mutator.cs:219 `InBounds`: a constant index into a fixed array must stay inside it.
bool mutatorInBounds(through in MutatorWalker w, for BExpr l, by Big value) {
    let a = w.arrayIndexes.tryGet(at: l) ?? return true
    let length = t10Big(a.length)
    let effective = a.fromEnd ? t10BigSub(length, by: value) : value
    let zero = t10Big(0)
    // coverage-exempt: Q1099
    return semantics.bigCmp(effective, as: zero) >= 0
        && semantics.bigCmp(effective, as: length) < 0
        && !(a.fromEnd && semantics.bigCmp(value, as: zero) == 0)
}

/// Mutator.cs:226 `OnAssign`.
void mutatorOnAssign(ref Ctx c, through ref MutatorWalker w, for BStmt a) uses alloc {
    let i = a & 0xFFFFFFFF
    let target = c.bAssigns[i].target
    if semantics.boundKind(target) == .local
            && w.uninitialized.contains(c.bLocals[target & 0xFFFFFFFF].local)
            && c.bAssigns[i].op is null {
        w.notEmitted[mutatorStatement] += 1
    } else {
        mutatorRemove(ref c, through: ref w, for: a)
    }
    // coverage-exempt: Q1099
    let s = semantics.nodeSyntax(in c, for: a) ?? return
    return if s.kind != .assignStmt
    return if !(s.assignOp is .add or .sub or .mul or .div or .rem)
    // coverage-exempt: Q1099 through `let valueSpan = s.value ?? return`
    let op = c.bAssigns[i].op ?? return
    let valueSpan = s.value ?? return
    let to: parser.BinaryOp = op == .add ? .sub : op == .sub ? .add : op == .mul ? .div : .mul
    let between = TextSpan.fromBounds(s.target.end, until: valueSpan.start)
    let opText = $"{mutatorOpText(op)}="
    let at = s.target.end + t10IndexOf(w.source.getText(between), for: opText)
    let mutated = $"{w.source.getText(TextSpan.fromBounds(s.span.start, until: at))}{mutatorOpText(to)}={w.source.getText(TextSpan.fromBounds(at + opText.length, until: s.span.end))}"
    let n = c.bAssigns[i]
    let replacement = semantics.addAssign(
        ref c,
        from: BAssign { span: n.span, target: n.target, value: n.value, op: to },
    )
    mutatorAdd(through: ref w, as: mutatorArithmetic, at: s.span, to: mutated, for: a, by: replacement)
}

/// Mutator.cs:239 `Remove`.
void mutatorRemove(ref Ctx c, through ref MutatorWalker w, for BStmt s) uses alloc {
    let replacement = semantics.addBlock(ref c, from: BBlock { span: semantics.nodeSpan(in c, for: s) })
    mutatorAdd(through: ref w, as: mutatorStatement, at: t10SyntaxSpan(in c, for: s), to: "", for: s, by: replacement)
}

/// Mutator.cs:241 `OnReturn`.
void mutatorOnReturn(ref Ctx c, through ref MutatorWalker w, for BExpr value, at TextSpan syntax) uses alloc {
    let type = semantics.exprType(in c, for: value)
    let empty = mutatorEmptyText(type) ?? ""
    if mutatorEmptyText(type) is null {
        w.notEmitted[mutatorEmptyReturn] += 1
        return
    }
    // Already the empty value: the mutant would be the program itself.
    return if semantics.boundKind(value) == .defaultValue || w.source.getText(syntax) == empty
    let replacement = semantics.addDefault(
        ref c,
        from: BDefault { span: semantics.nodeSpan(in c, for: value), type: type },
    )
    mutatorAdd(through: ref w, as: mutatorEmptyReturn, at: syntax, to: empty, for: value, by: replacement)
}

/// Mutator.cs:255 `EmptyText`: the empty value of `t` as source, or null when the type has none.
string? mutatorEmptyText(Type t) {
    return "0" if semantics.isInteger(t)
    return "0.0" if semantics.isFloat(t)
    return "false" if semantics.isBool(t)
    return "\"\"" if semantics.isString(t)
    return "null" if semantics.kindOf(t) == .optional
    return null
}

/// Mutator.cs:265 `OnFail`.
void mutatorOnFail(ref Ctx c, through ref MutatorWalker w, for BStmt f) uses alloc {
    var error = c.bFails[f & 0xFFFFFFFF].error
    // coverage-exempt: Q1099
    if semantics.boundKind(error) == .conversion {
        error = c.bConversions[error & 0xFFFFFFFF].operand
    }
    return if semantics.boundKind(error) != .errorVariant
    let ei = error & 0xFFFFFFFF
    let v = c.bErrorVariants[ei].variant
    let span = t10SyntaxSpan(in c, for: error)
    let text = w.source.getText(span)
    let paren = t10IndexOf(text, for: "(")
    let vName = c.errorVariants[v].name
    let name = t10LastIndexOf(text, for: $".{vName}", at: paren < 0 ? text.length - 1 : paren - 1) + 1
    let set = c.errorVariants[v].set
    for k in 0..c.errorSets[set].variants.length {
        let other = c.errorSets[set].variants[k]
        continue if other == v
        if !t10SameFields(in c, for: other, as: v) || t10Has(in c.functions[w.fn].excludedErrors, for: other) {
            w.notEmitted[mutatorVariant] += 1
            continue
        }
        let mutated = $"{text[0..name]}{c.errorVariants[other].name}{text[(name + vName.length)..text.length]}"
        let replacement = semantics.addErrorVariant(
            ref c,
            from: BErrorVariant {
                span: c.bErrorVariants[ei].span,
                variant: other,
                payload: c.bErrorVariants[ei].payload.copy(),
            },
        )
        mutatorAdd(through: ref w, as: mutatorVariant, at: span, to: mutated, for: error, by: replacement)
    }
}

/// Mutator.cs:275: the same number of fields, of the same types.
bool t10SameFields(in Ctx c, for VariantId a, as VariantId b) {
    return false if c.errorVariants[a].fields.length != c.errorVariants[b].fields.length
    for k in 0..c.errorVariants[a].fields.length {
        return false if c.locals[c.errorVariants[a].fields[k]].type != c.locals[c.errorVariants[b].fields[k]].type
    }
    return true
}

/// C# `List<ErrorVariantSymbol>.Contains`.
bool t10Has(in List<VariantId> xs, for VariantId x) {
    for y in xs {
        return true if y == x
    }
    return false
}

/// Mutator.cs:287 `OnCondition`.
void mutatorOnCondition(ref Ctx c, through ref MutatorWalker w, for BExpr cond, as bool loop) uses alloc {
    // Negating a pattern test would leave what it binds or narrows unproved where it is read.
    var constantTrue = false
    // coverage-exempt: Q1099
    if (semantics.exprConstant(in c, for: cond) is { } k) {
        constantTrue = k.kind == .flag && k.flag
    }
    if t10HasIs(in c, for: cond) || loop && constantTrue {
        w.notEmitted[mutatorCondition] += 1
        return
    }
    let span = t10SyntaxSpan(in c, for: cond)
    let replacement = semantics.addUnary(
        ref c,
        from: BUnary {
            span: semantics.nodeSpan(in c, for: cond),
            op: .notKeyword,
            operand: cond,
            type: semantics.prim(.bool),
        },
    )
    mutatorAdd(
        through: ref w,
        as: mutatorCondition,
        at: span,
        to: $"!({w.source.getText(span)})",
        for: cond,
        by: replacement,
    )
}

/// Mutator.cs:300 `Add`: a site at the start of `span`, the expression or statement the mutant replaces.
void mutatorAdd(
    through ref MutatorWalker w,
    as string op,
    at TextSpan span,
    to string mutated,
    for BNode original,
    by BNode replacement
) uses alloc {
    let pos = w.source.getLinePosition(span.start)
    w.sites.append(MutationSite {
        file: w.source.path, line: pos.line, column: pos.column, op: op, original: w.source.getText(
            span,
        ), mutated: mutated,
        function: w.fn, originalNode: original, mutatedNode: replacement,
    })
}

/// Mutator.cs:309 `Constant`: a literal whose `Constant` is its value.
BExpr mutatorConstant(ref Ctx c, at TextSpan span, as Type type, by Constant value) uses alloc {
    let n = semantics.addLiteral(ref c, from: BLiteral { span: span, type: type, value: value })
    c.constants[n] = value
    return n
}

/// Mutator.cs:315 `OpText`.
string mutatorOpText(parser.BinaryOp op) {
    switch op {
        case .add: return "+"
        case .sub: return "-"
        case .mul: return "*"
        case .div: return "/"
        case .rem: return "%"
        case .lt: return "<"
        case .gt: return ">"
        case .le: return "<="
        case .ge: return ">="
        case .eq: return "=="
        case .ne: return "!="
        case .logicalAnd: return "&&"
        case .logicalOr: return "||"
        // coverage-exempt: Q1099
        default: panic($"no operator text for {op}")
    }
}

/// Mutator.cs:323 `Fits`.
bool mutatorFits(Big n, as Type t) {
    let bits = semantics.primitiveBits(semantics.primKindOf(t & 0xFFFFFFFF))
    if semantics.isSignedInteger(t) {
        let top = t10BigPow2(bits - 1)
        return semantics.bigCmp(n, as: t10BigNeg(top)) >= 0 && semantics.bigCmp(n, as: top) < 0
    }
    return semantics.bigCmp(n, as: t10Big(0)) >= 0 && semantics.bigCmp(n, as: t10BigPow2(bits)) < 0
}

/// Mutator.cs:328 `Folds`: whether `l op r` folds without the binder's overflow or division-by-zero error.
bool mutatorFolds(parser.BinaryOp op, from Big l, to Big r, as Type t) {
    let zero = t10Big(0)
    return false if (op is .div or .rem) && semantics.bigCmp(r, as: zero) == 0
    var result = zero
    switch op {
        case .add: result = t10BigAdd(l, to: r)
        case .sub: result = t10BigSub(l, by: r)
        case .mul: result = t10BigMul(l, by: r)
        case .div: result = t10BigDiv(l, by: r, as: false)
        case .rem: result = t10BigDiv(l, by: r, as: true)
        default: {}
    }
    return mutatorFits(result, as: t)
}

// ── Int128 on Big (semantics/bigint.byn keeps its own private; Q1099) ────────

Big t10Big(i64 v) {
    // coverage-exempt: Q1099 through `return Big { lo: v >= 0 ? u64(v) : ~u64(-(v + 1)), hi: hi }`
    let hi: u64 = v >= 0 ? 0 : 0xFFFFFFFFFFFFFFFF
    return Big { lo: v >= 0 ? u64(v) : ~u64(-(v + 1)), hi: hi }
}

/// 2^k for 0 <= k <= 64.
Big t10BigPow2(i64 k) => k < 64 ? Big { lo: u64(1) << u64(k), hi: 0 } : Big { lo: 0, hi: 1 }

bool t10BigIsNeg(Big a) => (a.hi & 0x8000000000000000) != 0

Big t10BigAdd(Big a, to Big b) {
    let lo = a.lo +% b.lo
    let carry: u64 = lo < a.lo ? 1 : 0
    return Big { lo: lo, hi: a.hi +% b.hi +% carry }
}

Big t10BigNeg(Big a) => t10BigAdd(Big { lo: ~a.lo, hi: ~a.hi }, to: t10Big(1))

Big t10BigSub(Big a, by Big b) => t10BigAdd(a, to: t10BigNeg(b))

/// The full 128-bit product of two u64.
Big t10BigMulU64(u64 x, by u64 y) {
    let x0 = x & 0xFFFFFFFF
    let x1 = x >> 32
    let y0 = y & 0xFFFFFFFF
    let y1 = y >> 32
    let p00 = x0 * y0
    let p01 = x0 * y1
    let p10 = x1 * y0
    let p11 = x1 * y1
    let mid = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF)
    return Big {
        lo: (p00 & 0xFFFFFFFF) | ((mid & 0xFFFFFFFF) << 32),
        hi: p11 +% (p01 >> 32) +% (p10 >> 32) +% (mid >> 32),
    }
}

/// C# `Int128` `*`: the product modulo 2^128.
Big t10BigMul(Big a, by Big b) {
    let low = t10BigMulU64(a.lo, by: b.lo)
    return Big { lo: low.lo, hi: low.hi +% a.lo *% b.hi +% a.hi *% b.lo }
}

/// C# `Int128` `/` (truncating) or `%` (the sign of `a`); `b` is not zero.
Big t10BigDiv(Big a, by Big b, as bool remainder) {
    let na = t10BigIsNeg(a)
    let nb = t10BigIsNeg(b)
    let ua = na ? t10BigNeg(a) : a
    let ub = nb ? t10BigNeg(b) : b
    var q = Big { lo: 0, hi: 0 }
    var r = Big { lo: 0, hi: 0 }
    var bit: i64 = 127
    while bit >= 0 {
        let top = bit >= 64 ? (ua.hi >> u64(bit - 64)) & 1 : (ua.lo >> u64(bit)) & 1
        r = Big { lo: (r.lo << 1) | top, hi: (r.hi << 1) | (r.lo >> 63) }
        // coverage-exempt: Q1099 through `if bit >= 64 { q.hi`
        if r.hi > ub.hi || r.hi == ub.hi && r.lo >= ub.lo {
            r = t10BigSub(r, by: ub)
            if bit >= 64 {
                q.hi = q.hi | (u64(1) << u64(bit - 64))
            } else {
                q.lo = q.lo | (u64(1) << u64(bit))
            }
        }
        bit -= 1
    }
    return na ? t10BigNeg(r) : r if remainder
    return na != nb ? t10BigNeg(q) : q
}

// ── Strings (C# `IndexOf` and `LastIndexOf`, ordinal) ────────────────────────

/// The first byte offset of `needle` in `text`, or -1.
i64 t10IndexOf(string text, for string needle) {
    let t = text.bytes
    let n = needle.bytes
    var p: i64 = 0
    while p + n.length <= t.length {
        var same = true
        for k in 0..n.length {
            if t[p + k] != n[k] {
                same = false
                break
            }
        }
        return p if same
        p += 1
    }
    return -1
}

/// C# `LastIndexOf(needle, start)`: the last offset of `needle` that ends at or before `start`, or -1.
i64 t10LastIndexOf(string text, for string needle, at i64 start) {
    let t = text.bytes
    let n = needle.bytes
    var p = start - n.length + 1
    // coverage-exempt: Q1099 through `return -1`
    while p >= 0 {
        var same = p + n.length <= t.length
        if same {
            for k in 0..n.length {
                if t[p + k] != n[k] {
                    same = false
                    break
                }
            }
        }
        return p if same
        p -= 1
    }
    return -1
}

// ── Schemata (Schemata.cs:23-162) ────────────────────────────────────────────

/// Schemata.cs:60 `SitesPath`: where a `--mutate` build writes its site map.
public string sitesPath(string binary) uses alloc => $"{binary}.sites.json"

/// Schemata.cs:23 `SitesJson`: `Utf8JsonWriter` indented (two spaces, `\n`) with the relaxed encoder, and a final `\n`.
public string sitesJson(in Schema s) uses alloc {
    var sb = StrBuf()
    sb.append("{\n  \"version\": 1,\n  \"sites\": [")
    for k in 0..s.sites.length {
        let x = s.sites[k]
        sb.append(k == 0 ? "\n" : ",\n")
        sb.append("    {")
        sb.append(
            $"\n      \"id\": {x.id},\n      \"file\": {t10Json(x.site.file)},\n      \"line\": {x.site.line},\n      \"column\": {x.site.column},",
        )
        sb.append(
            $"\n      \"operator\": {t10Json(x.site.op)},\n      \"original\": {t10Json(x.site.original)},\n      \"mutated\": {t10Json(x.site.mutated)}",
        )
        if !x.emitted {
            sb.append(",\n      \"emitted\": false")
        }
        if (x.unobservable is { } u) {
            sb.append($",\n      \"unobservable\": {t10Json(u)}")
        }
        sb.append("\n    }")
    }
    if s.sites.length > 0 {
        sb.append("\n  ")
    }
    sb.append("]\n}\n")
    return $"{sb.finish()}"
}

/// A JSON string as `JavaScriptEncoder.UnsafeRelaxedJsonEscaping` writes it: `"` and `\` escaped, the control characters
/// as `\b \t \n \f \r` or `\u00XX`, everything else as is.
string t10Json(string s) uses alloc {
    var sb = StrBuf()
    sb.append("\"")
    let hex = "0123456789ABCDEF"
    var run: i64 = 0
    let b = s.bytes
    for k in 0..b.length {
        let ch = b[k]
        continue if ch >= 0x20 && ch != 0x22 && ch != 0x5C
        sb.append(s[run..k])
        run = k + 1
        if ch == 0x22 {
            sb.append("\\\"")
        } else if ch == 0x5C {
            sb.append("\\\\")
        } else if ch == 0x08 {
            sb.append("\\b")
        } else if ch == 0x09 {
            sb.append("\\t")
        } else if ch == 0x0A {
            sb.append("\\n")
        } else if ch == 0x0C {
            sb.append("\\f")
        } else if ch == 0x0D {
            sb.append("\\r")
        } else {
            sb.append($"\\u00{hex[i64(ch >> 4)..i64(ch >> 4) + 1]}{hex[i64(ch & 15)..i64(ch & 15) + 1]}")
        }
    }
    sb.append(s[run..b.length])
    sb.append("\"")
    return $"{sb.finish()}"
}

/// Schemata.cs:62 `Build`; an empty `skipFiles` is C#'s null.
public Schema buildSchema(ref Ctx c, for in List<string> skipFiles) uses alloc, clock, fs {
    var found = find(ref c, for: in skipFiles)
    var notEmitted = found.notEmitted.take()
    var sites = List<SchemaSite>()
    for k in 0..found.sites.length {
        let site = found.sites[k]
        let emitted = schemataRebinds(in c, for: in site)
        if !emitted {
            notEmitted[site.op] = (notEmitted.tryGet(at: site.op) ?? 0) + 1
        }
        sites.append(
            SchemaSite {
                id: sites.length + 1,
                site: site,
                emitted: emitted,
                unobservable: schemataMarkOf(in c, for: in site),
            },
        )
    }
    // `bySyntax`: the emitted sites of each syntax, in order, as a chain through `next` from `heads[key]`.
    var heads: Map<string, i64> = []
    var tails: Map<string, i64> = []
    var next = List<i64>()
    for k in 0..sites.length {
        next.append(-1)
        continue if !sites[k].emitted
        let s = sites[k].site
        let key = t10SyntaxKey(in c, for: s.originalNode, at: c.functions[s.function].file)
        if (tails.tryGet(at: key) is { } tail) {
            next[tail] = k
        } else {
            heads[key] = k
        }
        tails[key] = k
    }
    var switches: Map<BNode, BoundMutantSwitch> = []
    for m in 0..c.moduleOrder.length {
        let mod = c.moduleOrder[m]
        for i in 0..c.modules[mod].allFunctions.length {
            let fn = c.modules[mod].allFunctions[i]
            continue if c.functions[fn].body == -1
                || c.functions[fn].kind == .testKeyword
                || semantics.functionIsGeneric(ref c, by: fn)
            let file = c.functions[fn].file
            for node in semantics.descendants(in c, for: c.functions[fn].body) {
                // coverage-exempt: Q1099
                continue if switches.contains(node)
                let key = t10SyntaxKey(in c, for: node, at: file)
                var k = heads.tryGet(at: key) ?? continue
                var arms = List<BoundMutant>()
                while k != -1 {
                    let at = k
                    k = next[at]
                    let s = sites[at].site
                    continue if semantics.boundKind(s.originalNode) != semantics.boundKind(node)
                    let mutant = node == s.originalNode ? s.mutatedNode : schemataTransfer(ref c, for: in s, at: node)
                    if mutant != -1 {
                        arms.append(BoundMutant { id: sites[at].id, node: mutant })
                    }
                }
                if arms.length > 0 {
                    switches[node] = BoundMutantSwitch {
                        span: t10SyntaxSpan(in c, for: node),
                        original: node,
                        mutants: move arms,
                    }
                }
            }
        }
    }
    return Schema { sites: move sites, notEmitted: move notEmitted, switches: move switches }
}

/// Schemata.cs:101 `MarkOf`: the reason of the first `@unobservable` mark whose statement holds the site and whose operator argument, if any, is the site's.
string? schemataMarkOf(in Ctx c, for in MutationSite site) uses alloc {
    return null if c.unobservable.length == 0
    let file = c.functions[site.function].file
    // the per-site source copy is freed with the arena (Q31 option (a))
    using let arena = Arena()
    provide allocator: arena {
        var source = lexer.SourceText.create(c.files[file].path, from: c.files[file].text.copy())
        let start = schemataOffset(ref source, at: site.line, by: site.column)
        let end = start + site.original.bytes.length
        for m in c.unobservable {
            return m.reason if m.file == site.file
                && (m.op is null || m.op == site.op)
                && m.span.start <= start
                && end <= m.span.start + m.span.length
        }
    }
    return null
}

/// Schemata.cs:116 `Rebinds`: whether the program still compiles, ownership included, with the mutation applied to its source.
/// The mutant's re-bind runs in an arena of its own, freed before the next site (Q31 option (a)): only the bool leaves it.
bool schemataRebinds(in Ctx c, for in MutationSite site) uses alloc, clock, fs {
    let file = c.functions[site.function].file
    using let arena = Arena()
    provide allocator: arena {
        var source = lexer.SourceText.create(c.files[file].path, from: c.files[file].text.copy())
        var start = schemataOffset(ref source, at: site.line, by: site.column)
        var length = site.original.bytes.length
        // coverage-exempt: Q1099 through `panic($"internal error: mutation site`
        if source.getText(TextSpan { start: start, length: length }) != site.original {
            panic($"internal error: mutation site {site.file}:{site.line}:{site.column} is not `{site.original}`")
        }
        // `x = 1 if c` less its statement is ` if c`, which does not parse: the guarded statement goes whole.
        if site.op == mutatorStatement {
            let key = t10SyntaxKey(in c, for: site.originalNode, at: file)
            for n in semantics.descendants(in c, for: c.functions[site.function].body) {
                continue if semantics.boundKind(n) != .ifStmt || !t10SyntaxIs(in c, for: n, as: .guardedStmt)
                continue if t10SyntaxKey(in c, for: c.bIfs[n & 0xFFFFFFFF].then, at: file) != key
                let guarded = t10SyntaxSpan(in c, for: n)
                start = guarded.start
                length = guarded.length
                break
            }
        }
        var text = List<u8>()
        for k in 0..start {
            text.append(source.bytes[k])
        }
        for b in site.mutated.bytes {
            text.append(b)
        }
        for k in (start + length)..source.bytes.length {
            text.append(source.bytes[k])
        }
        let mutant = semantics.withFile(in c, from: in lexer.SourceText.create(source.path, from: move text))
        for d in mutant.diagnostics {
            return false if !d.isWarning
        }
    }
    return true
}

/// Schemata.cs:136 `Offset`: the byte offset of a one-based line and column, the column counting Unicode scalars.
i64 schemataOffset(ref lexer.SourceText source, at i64 line, by i64 column) uses alloc {
    var offset = source.getLineSpan(line - 1).start
    for col in 1..column {
        offset += 1
        while offset < source.bytes.length && (source.bytes[offset] & 0xC0) == 0x80 {
            offset += 1
        }
    }
    return offset
}

/// Schemata.cs:146 `Transfer`: the mutant of `site` at `node`, a generic instance's twin of its original node; -1 where its type differs.
BNode schemataTransfer(ref Ctx c, for in MutationSite site, at BNode node) uses alloc {
    let kind = semantics.boundKind(node)
    let isExpr = semantics.isExprKind(kind)
    // coverage-exempt: Q1099
    let sameType = isExpr
        && semantics.isExprKind(semantics.boundKind(site.originalNode))
        && semantics.exprType(in c, for: node) == semantics.exprType(in c, for: site.originalNode)
    let mutatedKind = semantics.boundKind(site.mutatedNode)
    let i = node & 0xFFFFFFFF
    // coverage-exempt: Q1099 through `if mutatedKind == .assign && kind == .assign {`
    return c.bUnaries[i].operand if site.op == mutatorNegation && kind == .unary
    return semantics.addUnary(
        ref c,
        from: BUnary {
            span: semantics.nodeSpan(in c, for: node),
            op: .notKeyword,
            operand: node,
            type: semantics.prim(.bool),
        },
    ) if site.op == mutatorCondition
        && isExpr
    return semantics.addBlock(
        ref c,
        from: BBlock { span: semantics.nodeSpan(in c, for: node) },
    ) if site.op == mutatorStatement
        && semantics.isStmtKind(kind)
    if (site.op == mutatorBool || site.op == mutatorLiteral) && mutatedKind == .literal && isExpr && sameType {
        // A mutated literal is a `bool` or an integer (Mutator.cs:187, :205).
        let span = semantics.nodeSpan(in c, for: node)
        let type = semantics.exprType(in c, for: node)
        let m = site.mutatedNode & 0xFFFFFFFF
        let value = Constant {
            kind: c.bLiterals[m].value.kind,
            integer: c.bLiterals[m].value.integer,
            flag: c.bLiterals[m].value.flag,
        }
        return mutatorConstant(ref c, at: span, as: type, by: value)
    }
    return semantics.addDefault(
        ref c,
        from: BDefault { span: semantics.nodeSpan(in c, for: node), type: semantics.exprType(in c, for: node) },
    ) if site.op == mutatorEmptyReturn
        && isExpr
        && sameType
    if site.op == mutatorVariant && mutatedKind == .errorVariant && kind == .errorVariant {
        let variant = c.bErrorVariants[site.mutatedNode & 0xFFFFFFFF].variant
        return semantics.addErrorVariant(
            ref c,
            from: BErrorVariant {
                span: c.bErrorVariants[i].span,
                variant: variant,
                payload: c.bErrorVariants[i].payload.copy(),
            },
        )
    }
    if mutatedKind == .binary && kind == .binary {
        let b = c.bBinaries[i]
        return semantics.addBinary(
            ref c,
            from: BBinary {
                span: b.span,
                op: c.bBinaries[site.mutatedNode & 0xFFFFFFFF].op,
                left: b.left,
                right: b.right,
                type: b.type,
            },
        )
    }
    if mutatedKind == .assign && kind == .assign {
        let a = c.bAssigns[i]
        return semantics.addAssign(
            ref c,
            from: BAssign {
                span: a.span,
                target: a.target,
                value: a.value,
                op: c.bAssigns[site.mutatedNode & 0xFFFFFFFF].op,
            },
        )
    }
    return -1
}
== lexer/diagnostics.byn
// Diagnostics: the lexer's message table, the diagnostic record and the plain-text renderer. Ports
// the lexer parts of `csharp/Bayan.Syntax/Diagnostics/{Diagnostic,DiagnosticCodes,DiagnosticRenderer}.cs`.

/// The lexer's entries of the message table (BYN0001–BYN0016, then BYN1047), in code order.
enum DiagnosticCode {
    bidiControl
    unexpectedCharacter
    unterminatedString
    unterminatedComment
    identifierNotNfc
    invalidEscape
    emptyCharLiteral
    unterminatedCharLiteral
    charLiteralTooLong
    invalidNumber
    suffixOnHexOrBinary
    reservedKeyword
    invalidUnicodeEscape
    unescapedCloseBrace
    invalidUtf8
    interpolationTooDeep
    blockComment
}

/// `BYN0001` for the first code, and so on; `blockComment` is the parser-range BYN1047.
string codeText(DiagnosticCode code) {
    return "BYN1047" if code == .blockComment
    let n = code.ordinal + 1
    return n < 10 ? $"BYN000{n}" : $"BYN00{n}"
}

/// The message template, in `string.Format` syntax.
string messageFormat(DiagnosticCode code) => code switch {
    .bidiControl             => "bidirectional control character U+{0} is not allowed outside string literals",
    .unexpectedCharacter     => "unexpected character `{0}`",
    .unterminatedString      => "unterminated string literal",
    .unterminatedComment     => "unterminated block comment",
    .identifierNotNfc        => "identifier `{0}` is not in Unicode normalization form C",
    .invalidEscape           => "invalid escape sequence `{0}`",
    .emptyCharLiteral        => "empty char literal",
    .unterminatedCharLiteral => "unterminated char literal",
    .charLiteralTooLong      => "a char literal holds exactly one Unicode scalar",
    .invalidNumber           => "invalid numeric literal: {0}",
    .suffixOnHexOrBinary     => "unit suffix `{0}` is not allowed on a {1} literal",
    .reservedKeyword         => "`{0}` is reserved and cannot be used as an identifier",
    .invalidUnicodeEscape    => "`{0}` is not a Unicode scalar value",
    .unescapedCloseBrace     => "`}}` in an interpolated string must be doubled",
    .invalidUtf8             => "source is not valid UTF-8 (byte 0x{0})",
    .interpolationTooDeep    => "interpolated strings are nested too deeply",
    .blockComment            => "`/* */` is an input form; write `//` lines",
}

/// `string.Format` for the templates above: `{0}`/`{1}` are replaced, `{{`/`}}` are unescaped.
string format(string template, by (string arg0, string arg1) args) {
    var sb = StrBuf()
    let t = template.bytes
    var i = 0
    while i < t.length {
        let b = t[i]
        if (b == '{' || b == '}') && i + 1 < t.length && t[i + 1] == b {
            sb.append(template[i..i + 1])
            i += 2
        } else if b == '{' && i + 2 < t.length && t[i + 2] == '}' {
            sb.append(t[i + 1] == '0' ? args.arg0 : args.arg1)
            i += 3
        } else {
            sb.append(template[i..i + 1])
            i += 1
        }
    }
    return $"{sb.finish()}"
}

/// A compiler diagnostic; every lexer diagnostic is an error (`error` is a keyword, so there is no
/// `Severity` enum). An empty `label` or `help` means none; `hasFix` says whether the
/// machine-applicable edit (replace `fixSpan` with `fixReplacement`) is present.
public struct Diagnostic {
    public string   code
    public TextSpan span
    public string   message
    public string   label
    public string   help
    public bool     hasFix
    public TextSpan fixSpan
    public string   fixReplacement
}

// ── Rendering ────────────────────────────────────────────────────────────────

const bar: string = "│"

/// Prose (message, label, help) wraps at this width; the lexer renders plain text for a pipe.
const wrapWidth: i64 = 100

/// Renders a diagnostic as plain text (the format `DiagnosticRendererTests` fixes):
///
///     error BYN2104: `total` is immutable
///
///       12 │     total += line.price;
///          │     ^^^^^ declared with `let` on line 9
///          │
///       help: declare it with `var` if it should change
///          │  9 │     var total = 0;
///          │    │     +++
void render(Diagnostic diagnostic, to ref StrBuf sb, from ref SourceText source) {
    let head = $"error {diagnostic.code}"
    var message = List<string>()
    wrap(diagnostic.message, to: ref message, by: Widths { first: wrapWidth - head.length - 2, rest: wrapWidth })
    sb.append($"{head}: ")
    appendLines(ref message, to: ref sb, by: "\n")
    sb.append("\n\n")

    let line = source.getLineIndex(diagnostic.span.start)
    let lineSpan = source.getLineSpan(line)

    var fixLines = List<string>()
    var fix = FixView { firstLine: 0, markStart: 0, markEnd: 0, marker: "+" }
    if diagnostic.hasFix {
        fix = applyFix(diagnostic.fixSpan, by: diagnostic.fixReplacement, from: ref source, to: ref fixLines)
    }

    var widestLine = line + 1
    if diagnostic.hasFix && fix.firstLine + fixLines.length > widestLine {
        widestLine = fix.firstLine + fixLines.length
    }
    let width = $"{widestLine}".length
    var blankBuf = StrBuf()
    blankBuf.append("  ")
    for i in 0..width {
        blankBuf.append(" ")
    }
    blankBuf.append($" {bar}")
    let blank = blankBuf.finish()

    sb.append($"  {lineNumber(line + 1, to: width)} {bar} ")
    display(source.bytes.span[lineSpan.start..lineSpan.end], to: ref sb)
    sb.append("\n")

    let underlineStart = diagnostic.span.start
    var underlineEnd = diagnostic.span.end < lineSpan.end ? diagnostic.span.end : lineSpan.end
    if underlineEnd < underlineStart {
        underlineEnd = underlineStart
    }
    var carets = runeCount(source.bytes.span[underlineStart..underlineEnd])
    if carets < 1 {
        carets = 1
    }
    let prefix = source.bytes.span[lineSpan.start..underlineStart]
    sb.append($"{blank} ")
    indent(prefix, to: ref sb)
    for i in 0..carets {
        sb.append("^")
    }
    unless diagnostic.label.isEmpty {
        let room = wrapWidth - (2 + width + 3 + runeCount(prefix) + carets + 1)
        var label = List<string>()
        wrap(diagnostic.label, to: ref label, by: Widths { first: room, rest: room })
        sb.append($" {label[0]}")
        for i in 1..label.length {
            sb.append($"\n{blank} ")
            indent(prefix, to: ref sb)
            for k in 0..carets + 1 {
                sb.append(" ")
            }
            sb.append(label[i])
        }
    }
    sb.append("\n")

    return if diagnostic.help.isEmpty && !diagnostic.hasFix

    sb.append($"{blank}\n")
    unless diagnostic.help.isEmpty {
        var help = List<string>()
        wrap(diagnostic.help, to: ref help, by: Widths { first: wrapWidth - 8, rest: wrapWidth - 8 })
        sb.append("  help: ")
        appendLines(ref help, to: ref sb, by: "\n        ")
        sb.append("\n")
    }
    if diagnostic.hasFix {
        var offset: i64 = 0
        for i in 0..fixLines.length {
            let text = fixLines[i].bytes
            sb.append($"{blank} {lineNumber(fix.firstLine + i + 1, to: width)} {bar} ")
            display(text, to: ref sb)
            sb.append("\n")
            let from = fix.markStart - offset > 0 ? fix.markStart - offset : 0
            let to = fix.markEnd - offset < text.length ? fix.markEnd - offset : text.length
            if to > from {
                sb.append($"{blank} ")
                for k in 0..width {
                    sb.append(" ")
                }
                sb.append($" {bar} ")
                indent(text[0..from], to: ref sb)
                let marks = runeCount(text[from..to])
                for k in 0..marks {
                    sb.append(fix.marker)
                }
                sb.append("\n")
            }
            offset += text.length + 1
        }
    }
}

/// Appends `lines` to `sb`, joined by `separator`.
void appendLines(ref List<string> lines, to ref StrBuf sb, by string separator) {
    for i in 0..lines.length {
        if i > 0 {
            sb.append(separator)
        }
        sb.append(lines[i])
    }
}

/// Line widths for `wrap`: the first line gets `first` columns, the rest `rest`.
struct Widths {
    i64 first
    i64 rest
}

/// Fills `lines` with `text` split into lines that fit `widths`. Words are never broken, so a long
/// word overflows its line.
void wrap(string text, to ref List<string> lines, by Widths widths) {
    let t = text.bytes
    var lineFrom: i64 = 0
    var lineEnd: i64 = -1
    var lineRunes: i64 = 0
    var from: i64 = 0
    for i in 0..t.length + 1 {
        let end = i == t.length || t[i] == 0x0A
        continue if !end && t[i] != 0x20
        let words = runeCount(t[from..i])
        let room = lines.length == 0 ? widths.first : widths.rest
        if lineEnd >= 0 && lineRunes + 1 + words > room {
            lines.append(text[lineFrom..lineEnd])
            lineFrom = from
            lineRunes = words
        } else {
            lineRunes += lineEnd >= 0 ? 1 + words : words
        }
        lineEnd = i
        if end {
            lines.append(text[lineFrom..lineEnd])
            lineFrom = i + 1
            lineEnd = -1
            lineRunes = 0
        }
        from = i + 1
    }
}

/// Renders diagnostics in source order (a stable sort by span start), separated by blank lines.
public void renderAll(ReadOnlySpan<Diagnostic> diagnostics, to ref StrBuf sb, from ref SourceText source) uses alloc {
    let order = sourceOrder(diagnostics)
    for k in 0..order.length {
        if k > 0 {
            sb.append("\n")
        }
        render(diagnostics[order[k]], to: ref sb, from: ref source)
    }
}

/// Indices of `diagnostics` in source order (a stable sort by span start).
public List<i64> sourceOrder(ReadOnlySpan<Diagnostic> diagnostics) uses alloc {
    var order = List<i64>()
    for i in 0..diagnostics.length {
        order.append(i)
        var j = order.length - 1
        while j > 0 && diagnostics[order[j - 1]].span.start > diagnostics[i].span.start {
            order[j] = order[j - 1]
            j -= 1
        }
        order[j] = i
    }
    return order
}

string lineNumber(i64 number, to i64 width) {
    let digits = $"{number}"
    var sb = StrBuf()
    for i in digits.length..width {
        sb.append(" ")
    }
    sb.append(digits)
    return $"{sb.finish()}"
}

/// The fix as shown: its first line, and the byte range in the shown lines to mark with `marker`.
struct FixView {
    i64    firstLine
    i64    markStart
    i64    markEnd
    string marker
}

/// Fills `lines` with the lines touched by the fix, replacement applied, and marks the inserted
/// text with `+`. A pure removal shows the original lines and marks the removed text with `-`.
FixView applyFix(TextSpan fix, by string replacement, from ref SourceText source, to ref List<string> lines) {
    let firstLine = source.getLineIndex(fix.start)
    let lastLine = source.getLineIndex(fix.end)
    let before = source.getText(TextSpan.fromBounds(source.getLineSpan(firstLine).start, until: fix.start))
    let after = source.getText(TextSpan.fromBounds(fix.end, until: source.getLineSpan(lastLine).end))
    let original = source.getText(fix)
    let o = original.bytes
    let r = replacement.bytes

    let common = o.length < r.length ? o.length : r.length
    var head: i64 = 0
    while head < common && o[head] == r[head] {
        head += 1
    }
    while head > 0 && ((head < o.length && (o[head] & 0xC0) == 0x80) || (head < r.length && (r[head] & 0xC0) == 0x80)) {
        head -= 1
    }
    var tail: i64 = 0
    while tail < common - head && o[o.length - 1 - tail] == r[r.length - 1 - tail] {
        tail += 1
    }
    while tail > 0 && (o[o.length - tail] & 0xC0) == 0x80 {
        tail -= 1
    }

    let inserted = r.length - head - tail > 0
    let shown = inserted ? replacement : original
    let text = $"{before}{shown}{after}"
    var from: i64 = 0
    for i in 0..text.length {
        if text.bytes[i] == 0x0A {
            lines.append(text[from..i])
            from = i + 1
        }
    }
    lines.append(text[from..])
    return FixView {
        firstLine: firstLine,
        markStart: before.length + head,
        markEnd: before.length + shown.length - tail,
        marker: inserted ? "+" : "-",
    }
}

/// Source text as shown in a diagnostic: control and bidi characters become U+FFFD, one scalar for
/// one, so carets still line up and the terminal cannot be made to reorder text.
void display(ReadOnlySpan<u8> text, to ref StrBuf sb) {
    var pos: i64 = 0
    while pos < text.length {
        let d = decodeAt(text, at: pos)
        let v = d.value
        let hidden = (v < 0x20 && v != 0x09) || v == 0x7F || (v is 0x202A..=0x202E) || (v is 0x2066..=0x2069)
        sb.append($"{rune(hidden ? replacementCharacter : v)}")
        pos += d.length
    }
}

/// Whitespace that lines up with `prefix`, keeping its tabs.
void indent(ReadOnlySpan<u8> prefix, to ref StrBuf sb) {
    var pos: i64 = 0
    while pos < prefix.length {
        let d = decodeAt(prefix, at: pos)
        sb.append(d.value == 0x09 ? "\t" : " ")
        pos += d.length
    }
}
== lexer/dump.byn
// Text and JSON forms of a token stream, as printed by `bayan lex` (the text form is kept in the
// `lex/` goldens). Ports `csharp/Bayan.Syntax/Lexing/TokenDump.cs`.

void dump(ref LexResult result, to ref StrBuf sb) {
    // By index: `getLinePosition` modifies `result.source`, so the loop may not borrow `result`.
    for i in 0..result.tokens.length {
        let token = result.tokens[i]
        let position = result.source.getLinePosition(token.start)
        if token.hasDoc {
            sb.append("    doc ")
            escape(result.source.bytes.span[token.docStart..token.docStart + token.docLength], to: ref sb)
            sb.append("\n")
        }
        sb.append($"{position.line}:{position.column} {kindName(token.kind)}")
        if token.length > 0 {
            sb.append(" ")
            escape(result.source.bytes.span[token.start..token.end], to: ref sb)
        }
        sb.append("\n")
    }
    if result.diagnostics.length > 0 {
        sb.append("\n")
        using var arena = Arena()
        let diagnostics = result.diagnostics.copy(to: arena)
        renderAll(diagnostics.span, to: ref sb, from: ref result.source)
    }
}

/// Backtick-quoted text with line breaks, tabs and invisible characters made visible.
public void escape(ReadOnlySpan<u8> text, to ref StrBuf sb) uses alloc {
    sb.append("`")
    var pos: i64 = 0
    while pos < text.length {
        let d = decodeAt(text, at: pos)
        let v = d.value
        if v == 0x0A {
            sb.append("\\n")
        } else if v == 0x0D {
            sb.append("\\r")
        } else if v == 0x09 {
            sb.append("\\t")
        } else if v is < 0x20 or 0x7F or 0x202A..=0x202E or 0x2066..=0x2069 or 0xFEFF {
            sb.append("\\u{")
            sb.append(hex(v, to: 1))
            sb.append("}")
        } else {
            sb.append($"{rune(v)}")
        }
        pos += d.length
    }
    sb.append("`")
}

/// `bayan lex --json`: one object with `tokens` and `diagnostics` (in source order), no
/// insignificant whitespace, then `\n`. Offsets are bytes; invalid UTF-8 in source text becomes
/// U+FFFD per maximal subpart.
void dumpJson(ref LexResult result, to ref StrBuf sb) {
    let bytes = result.source.bytes.span
    sb.append("{\"tokens\":[")
    for i in 0..result.tokens.length {
        let token = result.tokens[i]
        if i > 0 {
            sb.append(",")
        }
        sb.append($"{{\"kind\":\"{kindName(token.kind)}\",\"start\":{token.start},\"end\":{token.end},\"text\":")
        jsonString(bytes[token.start..token.end], to: ref sb)
        sb.append(",\"doc\":")
        if token.hasDoc {
            sb.append($"{{\"start\":{token.docStart},\"end\":{token.docStart + token.docLength}}}")
        } else {
            sb.append("null")
        }
        sb.append("}")
    }
    sb.append("],\"diagnostics\":[")
    let order = sourceOrder(result.diagnostics.span)
    for k in 0..order.length {
        let d = result.diagnostics[order[k]]
        if k > 0 {
            sb.append(",")
        }
        sb.append(
            $"{{\"code\":\"{d.code}\",\"severity\":\"error\",\"start\":{d.span.start},\"end\":{d.span.end},\"message\":",
        )
        jsonString(d.message.bytes, to: ref sb)
        sb.append(",\"label\":")
        jsonOptional(d.label, to: ref sb)
        sb.append(",\"help\":")
        jsonOptional(d.help, to: ref sb)
        sb.append(",\"fixes\":[")
        if d.hasFix {
            sb.append($"{{\"start\":{d.fixSpan.start},\"end\":{d.fixSpan.end},\"replacement\":")
            jsonString(d.fixReplacement.bytes, to: ref sb)
            sb.append("}")
        }
        sb.append("]}")
    }
    sb.append("]}\n")
}

/// `null` for an empty `text` (none), else its JSON string.
void jsonOptional(string text, to ref StrBuf sb) {
    if text.isEmpty {
        sb.append("null")
    } else {
        jsonString(text.bytes, to: ref sb)
    }
}

/// A JSON string: `\"` `\\` `\n` `\r` `\t`, other controls and DEL as `\u00XX`, the rest raw.
void jsonString(ReadOnlySpan<u8> text, to ref StrBuf sb) {
    sb.append("\"")
    var pos: i64 = 0
    while pos < text.length {
        let d = decodeAt(text, at: pos)
        let v = d.value
        if v == 0x22 {
            sb.append("\\\"")
        } else if v == 0x5C {
            sb.append("\\\\")
        } else if v == 0x0A {
            sb.append("\\n")
        } else if v == 0x0D {
            sb.append("\\r")
        } else if v == 0x09 {
            sb.append("\\t")
        } else if v is < 0x20 or 0x7F {
            sb.append("\\u")
            sb.append(hex(v, to: 4))
        } else {
            sb.append($"{rune(v)}")
        }
        pos += d.length
    }
    sb.append("\"")
}
== lexer/lexer.byn
// Hand-written lexer over UTF-8 bytes. Ports `csharp/Bayan.Syntax/Lexing/Lexer.cs` method by method;
// identifier classes and NFC come from the generated `unicode-tables.byn` instead of the .NET
// runtime and ICU, with NFC ported from `tools/Bayan.UnicodeGen/Nfc.cs`.

const maxInterpolationDepth: i64 = 32

public LexResult lex(move SourceText source, by Keywords keywords) uses alloc {
    var modes = List<ModeEntry>()
    for i in 0..maxInterpolationDepth + 1 {
        modes.append(ModeEntry { inText: false, braceDepth: 0, start: 0 })
    }
    var result = LexResult {
        source: move source,
        diagnostics: List<Diagnostic>(),
        modes: move modes,
        depth: 0,
        reportedTooDeep: false,
        pos: 0,
        tokenFlags: 0,
        docStart: -1,
        docEnd: -1,
        tokens: List<Token>(),
    }
    result.run(keywords)
    return result
}

// ── Unicode ──────────────────────────────────────────────────────────────────

/// Whether `cp` lies in one of the inclusive `lo, hi` pairs of `ranges`.
bool inRanges(ReadOnlySpan<u32> ranges, for u32 cp) {
    var lo: i64 = 0
    var hi = ranges.length / 2
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if ranges[mid * 2 + 1] < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < ranges.length / 2 && ranges[lo * 2] <= cp
}

/// `_` and the letter categories Lu Ll Lt Lm Lo Nl.
bool isIdentifierStart(u32 cp) => inRanges(identStartRanges, for: cp)

/// C# `char.IsUpper(text[0])`: whether the first scalar is Lu. Above U+FFFF C# sees a high surrogate, and the tables are BMP only, so it is false.
public bool firstIsUpper(ReadOnlySpan<u8> text) =>
    text.length > 0 && inRanges(upperRanges, for: decodeAt(text, at: 0).value)

/// C# `char.IsLower(text[0])`: whether the first scalar is Ll; false above U+FFFF like `firstIsUpper`.
public bool firstIsLower(ReadOnlySpan<u8> text) =>
    text.length > 0 && inRanges(lowerRanges, for: decodeAt(text, at: 0).value)

/// Identifier starts plus U+200C U+200D and Mn Mc Nd Pc.
bool isIdentifierContinue(u32 cp) => isIdentifierStart(cp) || inRanges(identContinueRanges, for: cp)

/// Length of the bidi control character at `pos` and its code point, or 0.
(i64 length, u32 codePoint) bidiControlAt(ReadOnlySpan<u8> text, at i64 pos) {
    return (length: 0, codePoint: 0) if pos + 2 >= text.length || text[pos] != 0xE2
    let b1 = text[pos + 1]
    let b2 = text[pos + 2]
    return (length: 3, codePoint: 0x2000 | (u32(b1 & 0x0F) << 6) | u32(b2 & 0x3F)) if (b1 == 0x80
        && b2 >= 0xAA
        && b2 <= 0xAE) || (b1 == 0x81 && b2 >= 0xA6 && b2 <= 0xA9)
    return (length: 0, codePoint: 0)
}

// NFC (UAX #15) over the generated tables: full canonical decomposition (Hangul algorithmic),
// canonical ordering by CCC, canonical composition with blocking.

const sBase: i64  = 0xAC00
const lBase: i64  = 0x1100
const vBase: i64  = 0x1161
const tBase: i64  = 0x11A7
const lCount: i64 = 19
const vCount: i64 = 21
const tCount: i64 = 28
const nCount: i64 = 588
const sCount: i64 = 11172

/// Index of the triple whose first entry is `cp` in `table`, or -1.
i64 findTriple(ReadOnlySpan<u32> table, for u32 cp) {
    var lo: i64 = 0
    var hi = table.length / 3
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if table[mid * 3] < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < table.length / 3 && table[lo * 3] == cp ? lo : -1
}

/// The canonical combining class of `cp`.
i64 ccc(u32 cp) {
    var lo: i64 = 0
    var hi = cccRanges.length / 3
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if cccRanges[mid * 3 + 1] < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < cccRanges.length / 3 && cccRanges[lo * 3] <= cp ? cccRanges[lo * 3 + 2] : 0
}

/// Appends the full canonical decomposition of `cp`.
void decompose(u32 cp, to ref List<u32> output) {
    let s = i64(cp) - sBase
    if s >= 0 && s < sCount {
        output.append(u32(lBase + s / nCount))
        output.append(u32(vBase + s % nCount / tCount))
        if s % tCount != 0 {
            output.append(u32(tBase + s % tCount))
        }
        return
    }
    let i = findTriple(decompIndex, for: cp)
    if i < 0 {
        output.append(cp)
        return
    }
    let offset = i64(decompIndex[i * 3 + 1])
    let length = i64(decompIndex[i * 3 + 2])
    for k in offset..offset + length {
        output.append(decompData[k])
    }
}

/// Stable sort of each run of non-starters by CCC.
void reorder(ref List<u32> cps) {
    for i in 1..cps.length {
        let c = ccc(cps[i])
        continue if c == 0
        let cp = cps[i]
        var j = i
        while j > 0 && ccc(cps[j - 1]) > c {
            cps[j] = cps[j - 1]
            j -= 1
        }
        cps[j] = cp
    }
}

/// Primary composite of the pair, or -1.
i64 composePair(u32 first, to u32 second) {
    let l = i64(first) - lBase
    let v = i64(second) - vBase
    return sBase + (l * vCount + v) * tCount if l >= 0 && l < lCount && v >= 0 && v < vCount
    let s = i64(first) - sBase
    let t = i64(second) - tBase
    return i64(first) + t if s >= 0 && s < sCount && s % tCount == 0 && t > 0 && t < tCount
    var lo: i64 = 0
    var hi = compPairs.length / 3
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let f = compPairs[mid * 3]
        if f < first || (f == first && compPairs[mid * 3 + 1] < second) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return compPairs[lo * 3 + 2] if lo < compPairs.length / 3
        && compPairs[lo * 3] == first
        && compPairs[lo * 3 + 1] == second
    return -1
}

/// Canonical composition in place; a character is blocked by an intervening one of equal or higher CCC.
void compose(ref List<u32> cps) {
    return if cps.length == 0
    var starterIndex: i64 = 0
    var lastCcc: i64 = ccc(cps[0]) == 0 ? 0 : 256
    var count: i64 = 1
    for i in 1..cps.length {
        let cp = cps[i]
        let c = ccc(cp)
        let composite = composePair(cps[starterIndex], to: cp)
        if composite >= 0 && (lastCcc < c || lastCcc == 0) {
            cps[starterIndex] = u32(composite)
            continue
        }
        if c == 0 {
            starterIndex = count
        }
        lastCcc = c
        cps[count] = cp
        count += 1
    }
    while cps.length > count {
        let _ = cps.removeLast()
    }
}

/// The NFC form of the scalars `input`.
List<u32> normalize(ReadOnlySpan<u32> input) {
    var cps = List<u32>()
    for cp in input {
        decompose(cp, to: ref cps)
    }
    reorder(ref cps)
    compose(ref cps)
    return cps
}

// ── Lexer state ──────────────────────────────────────────────────────────────

struct ModeEntry {
    /// True while scanning the text part of an interpolated string.
    bool inText
    /// Unclosed `{` inside an interpolation hole.
    i64  braceDepth
    /// Offset of the `$"` that opened this string.
    i64  start
}

/// The tokens and diagnostics of one source, and the lexer's state while it runs; the last token is `endOfFile`.
public struct LexResult {
    public SourceText       source
    public List<Diagnostic> diagnostics
    /// `maxInterpolationDepth + 1` entries; `modes[depth]` is the current one.
    List<ModeEntry>         modes
    i64                     depth
    bool                    reportedTooDeep
    i64                     pos
    u8                      tokenFlags
    i64                     docStart
    i64                     docEnd
    public List<Token>      tokens

    void run(ref this, Keywords keywords) {
        if source.bytes.length >= 3 && source.bytes[0] == 0xEF && source.bytes[1] == 0xBB && source.bytes[2] == 0xBF {
            pos = 3
        }
        while true {
            if modes[depth].inText {
                lexInterpolatedText()
                continue
            }
            skipTrivia()
            if pos >= source.bytes.length {
                if depth > 0 {
                    report(
                        .unterminatedString,
                        at: TextSpan { start: modes[depth].start, length: 2 },
                        label: "this string never ends",
                        help: "close the `{` and the string",
                    )
                }
                add(.endOfFile, at: TextSpan { start: pos, length: 0 })
                return
            }
            lexToken(keywords)
        }
    }

    // ── Plumbing ─────────────────────────────────────────────────────────────

    u8 peek(i64 offset = 0) => pos + offset < source.bytes.length ? source.bytes[pos + offset] : 0

    void add(ref this, TokenKind kind, at TextSpan span) {
        let docLength = docStart >= 0 ? docEnd - docStart : 0
        tokens.append(Token {
            kind: kind,
            tokenFlags: tokenFlags,
            start: span.start,
            length: span.length,
            docStart: docStart >= 0 ? docStart : 0,
            docLength: docLength,
        })
        tokenFlags = 0
        docStart = -1
    }

    void report(
        ref this,
        DiagnosticCode code,
        at TextSpan span,
        string arg0 = "",
        string arg1 = "",
        string label = "",
        string help = ""
    ) {
        diagnostics.append(Diagnostic {
            code: codeText(code),
            span: span,
            message: format(messageFormat(code), by: (arg0: arg0, arg1: arg1)),
            label: label,
            help: help,
            hasFix: false,
            fixSpan: span,
            fixReplacement: "",
        })
    }

    void reportFix(
        ref this,
        DiagnosticCode code,
        at TextSpan span,
        by string replacement,
        string arg0 = "",
        string label = "",
        string help = ""
    ) {
        diagnostics.append(Diagnostic {
            code: codeText(code),
            span: span,
            message: format(messageFormat(code), by: (arg0: arg0, arg1: "")),
            label: label,
            help: help,
            hasFix: true,
            fixSpan: span,
            fixReplacement: replacement,
        })
    }

    bool isIdentifierStartAt(i64 at) {
        return false if at >= source.bytes.length
        let b = source.bytes[at]
        return isAsciiIdentStart(b) if b < 0x80
        let d = decodeAt(source.bytes.span, at: at)
        return d.valid && isIdentifierStart(d.value)
    }

    /// Advances over one code point, reporting bidi controls and invalid UTF-8 unless allowed.
    void advanceCodePoint(ref this, bool allowBidi) {
        let b = source.bytes[pos]
        if b < 0x80 {
            pos += 1
            return
        }
        let bidi = bidiControlAt(source.bytes.span, at: pos)
        if bidi.length > 0 {
            unless allowBidi {
                reportBidi(bidi.codePoint, at: pos)
            }
            pos += bidi.length
            return
        }
        let d = decodeAt(source.bytes.span, at: pos)
        unless d.valid {
            report(.invalidUtf8, at: TextSpan { start: pos, length: 1 }, arg0: hex(b, to: 2))
            pos += 1
            return
        }
        pos += d.length
    }

    void reportBidi(ref this, u32 codePoint, at i64 start) {
        reportFix(
            .bidiControl,
            at: TextSpan { start: start, length: 3 },
            by: "",
            arg0: hex(codePoint, to: 4),
            label: "invisible character that reorders how the text displays",
            help: "remove it; bidi controls may only appear inside string literals (Trojan Source, CVE-2021-42574)",
        )
    }

    // ── Trivia ───────────────────────────────────────────────────────────────

    void skipTrivia(ref this) {
        while pos < source.bytes.length {
            let b = source.bytes[pos]
            if b == ' ' || b == '\t' || b == '\r' {
                pos += 1
                tokenFlags |= triviaBefore
            } else if b == '\n' {
                pos += 1
                tokenFlags |= triviaBefore | newlineBefore
            } else if b == '/' && peek(1) == '/' {
                let start = pos
                let isDoc = peek(2) == '/' && peek(3) != '/'
                while pos < source.bytes.length && source.bytes[pos] != '\n' {
                    advanceCodePoint(allowBidi: false)
                }
                if isDoc {
                    if docStart < 0 {
                        docStart = start
                    }
                    docEnd = pos
                }
                tokenFlags |= triviaBefore
            } else if b == '/' && peek(1) == '*' {
                let start = pos
                pos += 2
                while pos < source.bytes.length && !(source.bytes[pos] == '*' && peek(1) == '/') {
                    if source.bytes[pos] == '\n' {
                        tokenFlags |= newlineBefore
                    }
                    advanceCodePoint(allowBidi: false)
                }
                if pos >= source.bytes.length {
                    report(
                        .unterminatedComment,
                        at: TextSpan { start: start, length: 2 },
                        label: "comment starts here",
                        help: "close it with `*/`",
                    )
                } else {
                    pos += 2
                    reportFix(
                        .blockComment,
                        at: TextSpan.fromBounds(start, until: pos),
                        by: lineComments(start, until: pos),
                        label: "block comment",
                        help: "write each line with `//`",
                    )
                }
                tokenFlags |= triviaBefore
            } else if b == '#' && tokens.length == 0 && (peek(1) == '!' || peek(1) == ':') && isAtLineStart() {
                // Script shebang and `#:` directives at the top of a file.
                while pos < source.bytes.length && source.bytes[pos] != '\n' {
                    advanceCodePoint(allowBidi: false)
                }
                tokenFlags |= triviaBefore
            } else {
                return
            }
        }
    }

    /// BYN1047's fix for the comment `[start, end)`: one `//` line per trimmed content line, the outer
    /// blank lines dropped, at the indent of the `/*` line; code after `*/` moves to its own line.
    string lineComments(ref this, i64 start, until i64 end) {
        let text = source.bytes.span
        var lineStart = start
        while lineStart > 0 && text[lineStart - 1] != '\n' {
            lineStart -= 1
        }
        var indentEnd = lineStart
        while indentEnd < start && (text[indentEnd] == ' ' || text[indentEnd] == '\t') {
            indentEnd += 1
        }
        var starts = List<i64>()
        var ends = List<i64>()
        var at = start + 2
        while true {
            var lineEnd = at
            while lineEnd < end - 2 && text[lineEnd] != '\n' {
                lineEnd += 1
            }
            var a = at
            var b = lineEnd
            while a < b && (text[a] == ' ' || text[a] == '\t' || text[a] == '\r') {
                a += 1
            }
            while b > a && (text[b - 1] == ' ' || text[b - 1] == '\t' || text[b - 1] == '\r') {
                b -= 1
            }
            starts.append(a)
            ends.append(b)
            break if lineEnd >= end - 2
            at = lineEnd + 1
        }
        var first: i64 = 0
        var last = starts.length - 1
        if last > first && starts[last] == ends[last] {
            last -= 1
        }
        if last > first && starts[first] == ends[first] {
            first += 1
        }
        var sb = StrBuf()
        for i in first..last + 1 {
            if i > first {
                sb.append("\n")
                appendUtf8(text[lineStart..indentEnd], to: ref sb)
            }
            sb.append(starts[i] == ends[i] ? "//" : "// ")
            appendUtf8(text[starts[i]..ends[i]], to: ref sb)
        }
        var after = end
        while after < text.length && (text[after] == ' ' || text[after] == '\t' || text[after] == '\r') {
            after += 1
        }
        if after < text.length && text[after] != '\n' {
            sb.append("\n")
            appendUtf8(text[lineStart..indentEnd], to: ref sb)
        }
        return $"{sb.finish()}"
    }

    bool isAtLineStart() => pos == 0 || source.bytes[pos - 1] == '\n'

    // ── Tokens ───────────────────────────────────────────────────────────────

    void lexToken(ref this, Keywords keywords) {
        let start = pos
        let c = source.bytes[pos]

        if isAsciiIdentStart(c) {
            lexIdentifier(keywords)
            return
        }
        if isDigit(c) {
            lexNumber()
            return
        }
        if c >= 0x80 {
            let bidi = bidiControlAt(source.bytes.span, at: pos)
            if bidi.length > 0 {
                reportBidi(bidi.codePoint, at: pos)
                pos += bidi.length
                tokenFlags |= triviaBefore
                return
            }
            let d = decodeAt(source.bytes.span, at: pos)
            unless d.valid {
                report(.invalidUtf8, at: TextSpan { start: pos, length: 1 }, arg0: hex(c, to: 2))
                pos += 1
                return
            }
            if isIdentifierStart(d.value) {
                lexIdentifier(keywords)
                return
            }
            reportUnexpected(d.value, by: d.length)
            return
        }

        switch c {
            case '"':
                lexString(.stringLiteral, from: start, at: start)
            case '\'':
                lexChar()
            case '$':
                if peek(1) != '"' {
                    reportUnexpected(c, by: 1)
                    return
                }
                if depth + 1 >= modes.length {
                    unless reportedTooDeep {
                        report(.interpolationTooDeep, at: TextSpan { start: start, length: 2 })
                    }
                    reportedTooDeep = true
                    pos += 1
                    lexString(.stringLiteral, from: start, at: pos)
                    return
                }
                add(.interpolatedStringStart, at: TextSpan { start: start, length: 2 })
                pos += 2
                depth += 1
                modes[depth] = ModeEntry { inText: true, braceDepth: 0, start: start }
            case '{':
                if depth > 0 {
                    modes[depth].braceDepth += 1
                }
                single(.openBrace)
            case '}':
                if depth > 0 && modes[depth].braceDepth == 0 {
                    add(.interpolationEnd, at: TextSpan { start: start, length: 1 })
                    pos += 1
                    depth -= 1
                    return
                }
                if depth > 0 {
                    modes[depth].braceDepth -= 1
                }
                single(.closeBrace)
            case '(': single(.openParen)
            case ')': single(.closeParen)
            case '[': single(.openBracket)
            case ']': single(.closeBracket)
            case ';': single(.semicolon)
            case ',': single(.comma)
            case '@': single(.at)
            case '#': single(.hash)
            case '~': single(.tilde)
            case ':': single(.colon)
            case '.':
                if peek(1) == '.' {
                    addFixed(peek(2) == '=' ? TokenKind.dotDotEquals : TokenKind.dotDot, peek(2) == '=' ? 3 : 2)
                } else {
                    single(.dot)
                }
            case '?':
                if peek(1) == '?' {
                    addFixed(
                        peek(2) == '=' ? TokenKind.questionQuestionEquals : TokenKind.questionQuestion,
                        peek(2) == '=' ? 3 : 2,
                    )
                } else if peek(1) == '.' && !isDigit(peek(2)) {
                    addFixed(.questionDot, 2)
                } else {
                    single(.question)
                }
            case '+':
                addFixed(peek(1) switch {
                    '+' => TokenKind.plusPlus,
                    '=' => TokenKind.plusEquals,
                    '%' => TokenKind.plusPercent,
                    '|' => TokenKind.plusBar,
                    _   => TokenKind.plus,
                })
            case '-':
                addFixed(peek(1) switch {
                    '-' => TokenKind.minusMinus,
                    '>' => TokenKind.arrow,
                    '=' => TokenKind.minusEquals,
                    '%' => TokenKind.minusPercent,
                    '|' => TokenKind.minusBar,
                    _   => TokenKind.minus,
                })
            case '*':
                addFixed(peek(1) switch {
                    '=' => TokenKind.starEquals,
                    '%' => TokenKind.starPercent,
                    '|' => TokenKind.starBar,
                    _   => TokenKind.star,
                })
            case '/': addFixed(peek(1) == '=' ? TokenKind.slashEquals : TokenKind.slash)
            case '%': addFixed(peek(1) == '=' ? TokenKind.percentEquals : TokenKind.percent)
            case '^': addFixed(peek(1) == '=' ? TokenKind.caretEquals : TokenKind.caret)
            case '!': addFixed(peek(1) == '=' ? TokenKind.bangEquals : TokenKind.bang)
            case '&':
                addFixed(peek(1) switch { '&' => TokenKind.ampAmp, '=' => TokenKind.ampEquals, _ => TokenKind.amp })
            case '|':
                addFixed(peek(1) switch { '|' => TokenKind.barBar, '=' => TokenKind.barEquals, _ => TokenKind.bar })
            case '=':
                addFixed(
                    peek(1) switch { '=' => TokenKind.equalsEquals, '>' => TokenKind.fatArrow, _ => TokenKind.equals },
                )
            case '<':
                if peek(1) == '<' {
                    addFixed(peek(2) == '=' ? TokenKind.lessLessEquals : TokenKind.lessLess, peek(2) == '=' ? 3 : 2)
                } else {
                    addFixed(peek(1) == '=' ? TokenKind.lessEquals : TokenKind.less)
                }
            case '>':
                addFixed(peek(1) == '=' ? TokenKind.greaterEquals : TokenKind.greater)
            default:
                reportUnexpected(c, by: 1)
        }
    }

    void reportUnexpected(ref this, u32 cp, by i64 length) {
        let shown = cp < 0x20 || cp == 0x7F ? $"\\u{{{hex(cp, to: 1)}}}" : $"{rune(cp)}"
        report(.unexpectedCharacter, at: TextSpan { start: pos, length: length }, arg0: shown)
        pos += length
        tokenFlags |= triviaBefore
    }

    void single(ref this, TokenKind kind) => addFixed(kind, 1)

    /// Adds a fixed-length token; with no explicit length, two-character kinds are inferred.
    void addFixed(ref this, TokenKind kind, i64 length = 0) {
        let n = length == 0 ? kindText(kind).length : length
        add(kind, at: TextSpan { start: pos, length: n })
        pos += n
    }

    void lexIdentifier(ref this, Keywords keywords) {
        let start = pos
        var ascii = true
        while pos < source.bytes.length {
            let b = source.bytes[pos]
            if b < 0x80 {
                unless isAsciiIdentContinue(b) {
                    break
                }
                pos += 1
                continue
            }
            break if bidiControlAt(source.bytes.span, at: pos).length > 0
            let d = decodeAt(source.bytes.span, at: pos)
            break if !d.valid || !isIdentifierContinue(d.value)
            ascii = false
            pos += d.length
        }

        let span = source.bytes.span[start..pos]
        unless ascii {
            checkNfc(span, at: start)
            add(.identifier, at: TextSpan { start: start, length: pos - start })
            return
        }

        var kind = keywords.lookup(span)
        if kind == .identifier && peek() == '"' {
            if span.length == 1 && span[0] == 'c' {
                lexString(.cStringLiteral, from: start, at: pos)
                return
            }
            if sameBytes(span, as: "u16".bytes) {
                lexString(.u16StringLiteral, from: start, at: pos)
                return
            }
        }
        if isReservedKeyword(kind) {
            report(
                .reservedKeyword,
                at: TextSpan.fromBounds(start, until: pos),
                arg0: utf8(span),
                label: "reserved for a future version of Bayan",
                help: "choose another name",
            )
            kind = .identifier
        }
        add(kind, at: TextSpan { start: start, length: pos - start })
    }

    /// Reports BYN0005 when the identifier `span` (valid UTF-8) is not in NFC.
    void checkNfc(ref this, ReadOnlySpan<u8> span, at i64 start) {
        var input = List<u32>()
        var at: i64 = 0
        while at < span.length {
            let d = decodeAt(span, at: at)
            input.append(d.value)
            at += d.length
        }
        let normalized = normalize(input.span)
        var same = normalized.length == input.length
        if same {
            for i in 0..input.length {
                if normalized[i] != input[i] {
                    same = false
                }
            }
        }
        return if same
        var fix = StrBuf()
        for cp in normalized {
            fix.append($"{rune(cp)}")
        }
        reportFix(
            .identifierNotNfc,
            at: TextSpan.fromBounds(start, until: pos),
            by: fix.finish(),
            arg0: utf8(span),
            label: "same letters, different encoding",
            help: "use the composed (NFC) form; identifiers that look the same must be byte-identical",
        )
    }

    void lexNumber(ref this) {
        let start = pos
        var radix = ""
        var isFloat = false

        if source.bytes[pos] == '0' && (peek(1) | 0x20) == 'x' {
            radix = "hexadecimal"
            pos += 2
            scanDigits(.hex, from: start)
        } else if source.bytes[pos] == '0'
                && (peek(1) | 0x20) == 'b'
                && (peek(2) == '0' || peek(2) == '1' || peek(2) == '_') {
            radix = "binary"
            pos += 2
            scanDigits(.binary, from: start)
            if isDigit(peek()) {
                let bad = pos
                while isDigit(peek()) {
                    pos += 1
                }
                report(
                    .invalidNumber,
                    at: TextSpan.fromBounds(bad, until: pos),
                    arg0: "binary literals use only `0` and `1`",
                )
            }
        } else {
            scanDigits(.decimal, from: start)
            if peek() == '.' && isDigit(peek(1)) {
                isFloat = true
                pos += 1
                scanDigits(.decimal, from: start)
            }
            if (peek() | 0x20) == 'e'
                    && (isDigit(peek(1)) || ((peek(1) == '+' || peek(1) == '-') && isDigit(peek(2)))) {
                isFloat = true
                pos += peek(1) == '+' || peek(1) == '-' ? 2 : 1
                scanDigits(.decimal, from: start)
            }
        }

        add(
            isFloat ? TokenKind.floatLiteral : TokenKind.integerLiteral,
            at: TextSpan { start: start, length: pos - start },
        )

        if isIdentifierStartAt(pos) {
            let suffixStart = pos
            while pos < source.bytes.length {
                let b = source.bytes[pos]
                if b < 0x80 {
                    unless isAsciiIdentContinue(b) {
                        break
                    }
                    pos += 1
                    continue
                }
                let d = decodeAt(source.bytes.span, at: pos)
                break if !d.valid || !isIdentifierContinue(d.value)
                pos += d.length
            }
            add(.numericSuffix, at: TextSpan { start: suffixStart, length: pos - suffixStart })
            let suffix = source.bytes.span[suffixStart..pos]
            let builtIn = sameBytes(suffix, as: "u".bytes)
                || sameBytes(suffix, as: "l".bytes)
                || sameBytes(suffix, as: "ul".bytes)
            if !radix.isEmpty && !builtIn {
                report(
                    .suffixOnHexOrBinary,
                    at: TextSpan.fromBounds(suffixStart, until: pos),
                    arg0: utf8(suffix),
                    arg1: radix,
                    help: "write the value in decimal, or convert it with T(x), where T is the unit type",
                )
            }
        }
    }

    void scanDigits(ref this, DigitKind digits, from i64 literalStart) {
        let first = pos
        var digitsEnd = first
        while pos < source.bytes.length && (isDigitOf(digits, for: source.bytes[pos]) || source.bytes[pos] == '_') {
            if source.bytes[pos] != '_' {
                digitsEnd = pos + 1
            }
            pos += 1
        }
        // Only underscores after a prefix is still no digits; deleting them would not help. Trailing underscores are
        // reported and deleted as one run, so the fix leaves a valid literal.
        if digitsEnd == first && digits != .decimal {
            let prefix = digits == .hex ? "0x" : "0b"
            report(
                .invalidNumber,
                at: TextSpan.fromBounds(literalStart, until: pos),
                arg0: $"expected digits after `{prefix}`",
            )
        } else if digitsEnd < pos {
            reportFix(
                .invalidNumber,
                at: TextSpan.fromBounds(digitsEnd, until: pos),
                by: "",
                arg0: "`_` must sit between digits",
            )
        }
    }

    /// Lexes a string whose opening quote is at `quote`.
    void lexString(ref this, TokenKind kind, from i64 start, at i64 quote) {
        pos = quote
        if kind == .stringLiteral && peek(1) == '"' && peek(2) == '"' {
            pos += 3
            while pos < source.bytes.length && !(source.bytes[pos] == '"' && peek(1) == '"' && peek(2) == '"') {
                advanceCodePoint(allowBidi: true)
            }
            if pos >= source.bytes.length {
                report(
                    .unterminatedString,
                    at: TextSpan { start: start, length: 3 },
                    label: "raw string starts here",
                    help: "close it with `\"\"\"`",
                )
            } else {
                pos += 3
            }
            add(.rawStringLiteral, at: TextSpan { start: start, length: pos - start })
            return
        }

        pos += 1
        while true {
            if pos >= source.bytes.length || source.bytes[pos] == '\n' {
                let end = pos > start
                    && pos <= source.bytes.length
                    && pos > 0
                    && source.bytes[pos - 1] == '\r' ? pos - 1 : pos
                report(
                    .unterminatedString,
                    at: TextSpan.fromBounds(start, until: end),
                    label: "string ends at the end of the line",
                    help: "close it with `\"`; for text spanning lines use a raw `\"\"\"` string",
                )
                add(kind, at: TextSpan { start: start, length: end - start })
                return
            }
            let b = source.bytes[pos]
            if b == '"' {
                pos += 1
                add(kind, at: TextSpan { start: start, length: pos - start })
                return
            }
            if b == '\\' {
                scanEscape()
            } else {
                advanceCodePoint(allowBidi: true)
            }
        }
    }

    void lexInterpolatedText(ref this) {
        let modeStart = modes[depth].start
        let start = pos
        while true {
            if pos >= source.bytes.length || source.bytes[pos] == '\n' {
                addText(start)
                report(
                    .unterminatedString,
                    at: TextSpan { start: modeStart, length: 2 },
                    label: "this string never ends",
                    help: "close it with `\"`",
                )
                add(.interpolatedStringEnd, at: TextSpan { start: pos, length: 0 })
                depth -= 1
                return
            }
            let b = source.bytes[pos]
            if b == '"' {
                addText(start)
                add(.interpolatedStringEnd, at: TextSpan { start: pos, length: 1 })
                pos += 1
                depth -= 1
                return
            } else if b == '\\' {
                scanEscape()
            } else if (b == '{' && peek(1) == '{') || (b == '}' && peek(1) == '}') {
                pos += 2
            } else if b == '{' {
                if depth + 1 >= modes.length {
                    unless reportedTooDeep {
                        report(.interpolationTooDeep, at: TextSpan { start: pos, length: 1 })
                    }
                    reportedTooDeep = true
                    pos += 1
                    continue
                }
                addText(start)
                add(.interpolationStart, at: TextSpan { start: pos, length: 1 })
                pos += 1
                depth += 1
                modes[depth] = ModeEntry { inText: false, braceDepth: 0, start: modeStart }
                return
            } else if b == '}' {
                reportFix(.unescapedCloseBrace, at: TextSpan { start: pos, length: 1 }, by: "}}")
                pos += 1
            } else {
                advanceCodePoint(allowBidi: true)
            }
        }
    }

    void addText(ref this, i64 start) {
        if pos > start {
            add(.interpolatedStringText, at: TextSpan { start: start, length: pos - start })
        }
    }

    void lexChar(ref this) {
        let start = pos
        pos += 1
        if peek() == '\'' {
            pos += 1
            report(
                .emptyCharLiteral,
                at: TextSpan { start: start, length: 2 },
                help: "write the character between the quotes, e.g. `' '`",
            )
            add(.charLiteral, at: TextSpan { start: start, length: 2 })
            return
        }
        var scalars = 0
        while pos < source.bytes.length && source.bytes[pos] != '\'' && source.bytes[pos] != '\n' {
            if source.bytes[pos] == '\\' {
                scanEscape()
            } else {
                advanceCodePoint(allowBidi: false)
            }
            scalars += 1
        }
        if pos >= source.bytes.length || source.bytes[pos] != '\'' {
            report(.unterminatedCharLiteral, at: TextSpan.fromBounds(start, until: pos), help: "close it with `'`")
            add(.charLiteral, at: TextSpan { start: start, length: pos - start })
            return
        }
        pos += 1
        if scalars > 1 {
            report(
                .charLiteralTooLong,
                at: TextSpan.fromBounds(start, until: pos),
                help: "use a string literal (\"…\") for text",
            )
        }
        add(.charLiteral, at: TextSpan { start: start, length: pos - start })
    }

    void scanEscape(ref this) {
        let start = pos
        pos += 1
        if pos >= source.bytes.length || source.bytes[pos] == '\n' {
            report(.invalidEscape, at: TextSpan { start: start, length: 1 }, arg0: "\\")
            return
        }
        let e = source.bytes[pos]
        switch e {
            case 'n' or 'r' or 't' or '0' or '\\' or '"' or '\'':
                pos += 1
            case 'u':
                if peek(1) != '{' {
                    invalidEscape(start)
                    return
                }
                pos += 2
                let digitsStart = pos
                var value: i64 = 0
                while pos < source.bytes.length && hexValue(source.bytes[pos]) >= 0 && pos - digitsStart < 8 {
                    value = value * 16 + hexValue(source.bytes[pos])
                    pos += 1
                }
                let digits = pos - digitsStart
                if digits == 0 || peek() != '}' {
                    report(
                        .invalidEscape,
                        at: TextSpan.fromBounds(start, until: pos),
                        arg0: utf8(source.bytes.span[start..pos]),
                        help: "write `\\u{` followed by 1–6 hex digits and `}`",
                    )
                    return
                }
                pos += 1
                if digits > 6 || value > 0x10FFFF || (value is 0xD800..=0xDFFF) {
                    report(
                        .invalidUnicodeEscape,
                        at: TextSpan.fromBounds(start, until: pos),
                        arg0: utf8(source.bytes.span[start..pos]),
                        help: "use a scalar value in U+0000–U+D7FF or U+E000–U+10FFFF",
                    )
                }
            default:
                invalidEscape(start)
        }
    }

    /// The `default` arm of `scanEscape`.
    void invalidEscape(ref this, i64 start) {
        advanceCodePoint(allowBidi: true)
        report(
            .invalidEscape,
            at: TextSpan.fromBounds(start, until: pos),
            arg0: utf8(source.bytes.span[start..pos]),
            help: "use a valid escape: \\n \\r \\t \\0 \\\\ \\\" \\' and \\u{…}",
        )
    }
}

enum DigitKind {
    decimal
    hex
    binary
}

bool isDigitOf(DigitKind kind, for u8 b) => kind switch {
    .decimal => isDigit(b),
    .hex     => isDigit(b) || (b >= 'a' && b <= 'f') || (b >= 'A' && b <= 'F'),
    .binary  => b == '0' || b == '1',
}

bool isDigit(u8 b) => b >= '0' && b <= '9'

bool isAsciiIdentStart(u8 b) => (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'

bool isAsciiIdentContinue(u8 b) => isAsciiIdentStart(b) || isDigit(b)

i64 hexValue(u8 b) {
    return b - 0x30 if b >= '0' && b <= '9'
    return b - 0x61 + 10 if b >= 'a' && b <= 'f'
    return b - 0x41 + 10 if b >= 'A' && b <= 'F'
    return -1
}
== lexer/main.byn
// bayan-lex: the self-hosted lexer. Prints the same token dump as `bayan lex`.
//
//     bayan-lex [--json] [<path>|-] the token dump (`--json`: the JSON form) of `<path>`, or of stdin
//                               given `-` or no path; exit 0 if there are no error diagnostics, else 1
//     bayan-lex --many <dir>    `== <name>` and the dump of every `*.byn` in `<dir>`, in name order,
//                               preceded by a `span out of range` line for any span outside the input
//     bayan-lex --time <path>   only the nanoseconds spent lexing
//
// Exit 2 on a usage error or an unreadable file under `--many`/`--time`; exit 4 when the input of
// the token dump cannot be read.

const exitOk: i32      = 0
const exitFailure: i32 = 1
const exitUsage: i32   = 2
const exitInput: i32   = 4

i32 usage(string message) {
    Io.stderr.write($"bayan-lex: {message}\nusage: bayan-lex [--json] [<path>|-] | --many <dir> | --time <path>\n")
    return exitUsage
}

i32 fileNotFound(string path) {
    Io.stderr.write($"bayan: file not found: {path}\n")
    return exitUsage
}

i32 unreadable(string path) {
    Io.stderr.write($"bayan-lex: cannot read `{path}`\n")
    return exitInput
}

/// Lexes `path` and appends its dump (`json`: the JSON form) to `sb`; returns whether any diagnostic is an error.
public bool dumpFile(string path, from move List<u8> bytes, by Keywords keywords, to ref StrBuf sb, bool json)
        uses alloc {
    var result = lex(SourceText.create(path, from: move bytes), by: keywords)
    if json {
        dumpJson(ref result, to: ref sb)
    } else {
        dump(ref result, to: ref sb)
    }
    return !result.diagnostics.isEmpty
}

/// Appends a `span out of range` line for every token, doc or diagnostic span outside the input.
void checkSpans(ref LexResult result, to ref StrBuf sb) {
    let size = result.source.bytes.length
    for token in result.tokens {
        unless inside(TextSpan { start: token.start, length: token.length }, until: size) {
            sb.append($"span out of range: token {token.start}+{token.length}\n")
        }
        unless inside(TextSpan { start: token.docStart, length: token.docLength }, until: size) {
            sb.append($"span out of range: doc {token.docStart}+{token.docLength}\n")
        }
    }
    for d in result.diagnostics {
        unless inside(d.span, until: size) {
            sb.append($"span out of range: {d.code} {d.span.start}+{d.span.length}\n")
        }
        if d.hasFix && !inside(d.fixSpan, until: size) {
            sb.append($"span out of range: {d.code} fix {d.fixSpan.start}+{d.fixSpan.length}\n")
        }
    }
}

bool inside(TextSpan span, until i64 size) => span.start >= 0 && span.length >= 0 && span.end <= size

/// Dumps `path`, or stdin when `path` is `-`.
i32 lexOne(string path, by Keywords keywords, bool json) {
    var bytes = List<u8>()
    if path == "-" {
        bytes = Io.stdin.readAllBytes() catch {
            Io.stderr.write("bayan-lex: cannot read standard input\n")
            return exitInput
        }
    } else {
        bytes = Io.readFile(path) catch return unreadable(path)
    }
    var sb = StrBuf()
    let failed = dumpFile(path == "-" ? "<stdin>" : path, from: move bytes, by: keywords, to: ref sb, json: json)
    Io.stdout.write(sb.finish())
    return failed ? exitFailure : exitOk
}

i32 lexMany(string dir, by Keywords keywords) {
    let names = Io.listDir(dir) catch return usage($"cannot list `{dir}`")
    for name in names {
        unless name.endsWith(".byn") {
            continue
        }
        using let arena = Arena()
        provide allocator: arena {
            let path = $"{dir}/{name}"
            let bytes = Io.readFile(path) catch return fileNotFound(path)
            var sb = StrBuf()
            sb.append($"== {name}\n")
            var result = lex(SourceText.create(path, from: move bytes), by: keywords)
            checkSpans(ref result, to: ref sb)
            dump(ref result, to: ref sb)
            Io.stdout.write(sb.finish())
        }
    }
    return exitOk
}

i32 lexTimed(string path, by Keywords keywords) {
    let bytes = Io.readFile(path) catch return fileNotFound(path)
    let start = Io.monotonicNanos()
    let result = lex(SourceText.create(path, from: move bytes), by: keywords)
    let elapsed = Io.monotonicNanos() - start
    print($"{elapsed}")
    return result.tokens.isEmpty ? exitFailure : exitOk
}

i32 main(ReadOnlySpan<string> args) {
    let keywords = Keywords.build()
    return lexOne("-", by: keywords, json: false) if args.length == 0
    return lexOne("-", by: keywords, json: true) if args.length == 1 && args[0] == "--json"
    return lexOne(args[0], by: keywords, json: false) if args.length == 1 && !args[0].startsWith("--")
    return lexOne(args[1], by: keywords, json: true) if args.length == 2
        && args[0] == "--json"
        && !args[1].startsWith("--")
    return lexOne(args[0], by: keywords, json: true) if args.length == 2
        && args[1] == "--json"
        && !args[0].startsWith("--")
    return lexMany(args[1], by: keywords) if args.length == 2 && args[0] == "--many"
    return lexTimed(args[1], by: keywords) if args.length == 2 && args[0] == "--time"
    return usage("expected `[--json] [<path>|-]`, `--many <dir>` or `--time <path>`")
}
== lexer/source.byn
// Source text, spans and UTF-8. Ports `csharp/Bayan.Syntax/Text/{SourceText,TextSpan}.cs`, plus the
// parts of .NET's UTF-8 decoding the lexer relies on (`Rune.DecodeFromUtf8`, `Encoding.UTF8.GetString`).

/// A half-open range of UTF-8 byte offsets into a source.
public struct TextSpan {
    public i64 start
    public i64 length

    public i64 end => start + length

    public static TextSpan fromBounds(i64 start, until i64 end) => TextSpan { start: start, length: end - start }
}

/// One source file as UTF-8 bytes. Positions everywhere are byte offsets into `bytes`; line and
/// column are computed only when a human needs them.
public struct SourceText {
    public string   path
    public List<u8> bytes
    /// Empty until a line or column is first needed.
    List<i64>       lineStarts

    public i64 length => bytes.length

    public static SourceText create(string path, from move List<u8> bytes) uses alloc =>
        SourceText { path: path, bytes: move bytes, lineStarts: List<i64>() }

    i64 lineCount(ref this) {
        ensureLineStarts()
        return lineStarts.length
    }

    void ensureLineStarts(ref this) {
        unless lineStarts.isEmpty {
            return
        }
        lineStarts.append(0)
        for i in 0..bytes.length {
            if bytes[i] == 0x0A {
                lineStarts.append(i + 1)
            }
        }
    }

    /// Zero-based line index containing `offset`.
    public i64 getLineIndex(ref this, i64 offset) uses alloc {
        if offset < 0 || offset > length {
            panic("offset out of range")
        }
        ensureLineStarts()
        // The last line start <= offset.
        var lo: i64 = 0
        var hi = lineStarts.length
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if lineStarts[mid] <= offset {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo - 1
    }

    /// The span of line `lineIndex`, excluding its line terminator.
    public TextSpan getLineSpan(ref this, i64 lineIndex) uses alloc {
        ensureLineStarts()
        let start = lineStarts[lineIndex]
        var end = lineIndex + 1 < lineStarts.length ? lineStarts[lineIndex + 1] : length
        if end > start && bytes[end - 1] == 0x0A {
            end -= 1
        }
        if end > start && bytes[end - 1] == 0x0D {
            end -= 1
        }
        return TextSpan.fromBounds(start, until: end)
    }

    /// One-based line and column; the column counts Unicode scalars, not bytes.
    public (i64 line, i64 column) getLinePosition(ref this, i64 offset) uses alloc {
        let line = getLineIndex(offset)
        let start = lineStarts[line]
        var column: i64 = 1
        for i in start..offset {
            if (bytes[i] & 0xC0) != 0x80 {
                column += 1
            }
        }
        return (line: line + 1, column: column)
    }

    /// The text of `span`, with invalid UTF-8 replaced as `Encoding.UTF8.GetString` does.
    public string getText(TextSpan span) uses alloc => $"{utf8(bytes.span[span.start..span.end])}"
}

// ── UTF-8 ────────────────────────────────────────────────────────────────────

const replacementCharacter: u32 = 0xFFFD

/// One decoding step: a scalar and its length, or an invalid maximal subpart of `length` bytes.
struct Decoded {
    u32  value
    i64  length
    bool valid
}

bool isContinuation(ReadOnlySpan<u8> bytes, at i64 pos, from u8 lo, through u8 hi) =>
    pos < bytes.length && bytes[pos] >= lo && bytes[pos] <= hi

/// Decodes the scalar at `pos` like `Rune.DecodeFromUtf8`; an invalid or truncated sequence is
/// reported with the length of its maximal subpart (at least 1), as `Encoding.UTF8` replaces it.
Decoded decodeAt(ReadOnlySpan<u8> bytes, at i64 pos) {
    let b0 = bytes[pos]
    return Decoded { value: b0, length: 1, valid: true } if b0 < 0x80
    if b0 is 0xC2..=0xDF {
        unless isContinuation(bytes, at: pos + 1, from: 0x80, through: 0xBF) {
            return invalid(1)
        }
        return Decoded { value: (u32(b0 & 0x1F) << 6) | u32(bytes[pos + 1] & 0x3F), length: 2, valid: true }
    }
    if b0 is 0xE0..=0xEF {
        let lo: u8 = b0 == 0xE0 ? 0xA0 : 0x80
        let hi: u8 = b0 == 0xED ? 0x9F : 0xBF
        unless isContinuation(bytes, at: pos + 1, from: lo, through: hi) {
            return invalid(1)
        }
        unless isContinuation(bytes, at: pos + 2, from: 0x80, through: 0xBF) {
            return invalid(2)
        }
        let value = (u32(b0 & 0x0F) << 12) | (u32(bytes[pos + 1] & 0x3F) << 6) | u32(bytes[pos + 2] & 0x3F)
        return Decoded { value: value, length: 3, valid: true }
    }
    if b0 is 0xF0..=0xF4 {
        let lo: u8 = b0 == 0xF0 ? 0x90 : 0x80
        let hi: u8 = b0 == 0xF4 ? 0x8F : 0xBF
        unless isContinuation(bytes, at: pos + 1, from: lo, through: hi) {
            return invalid(1)
        }
        unless isContinuation(bytes, at: pos + 2, from: 0x80, through: 0xBF) {
            return invalid(2)
        }
        unless isContinuation(bytes, at: pos + 3, from: 0x80, through: 0xBF) {
            return invalid(3)
        }
        let value = (u32(b0 & 0x07) << 18) | (u32(bytes[pos + 1] & 0x3F) << 12) |
            (u32(bytes[pos + 2] & 0x3F) << 6) | u32(bytes[pos + 3] & 0x3F)
        return Decoded { value: value, length: 4, valid: true }
    }
    return invalid(1)
}

Decoded invalid(i64 length) => Decoded { value: replacementCharacter, length: length, valid: false }

/// Appends `bytes` decoded as `Encoding.UTF8.GetString` does: each invalid maximal subpart becomes U+FFFD.
void appendUtf8(ReadOnlySpan<u8> bytes, to ref StrBuf sb) {
    var pos: i64 = 0
    while pos < bytes.length {
        let d = decodeAt(bytes, at: pos)
        sb.append($"{rune(d.value)}")
        pos += d.length
    }
}

/// `bytes` as a string, with invalid UTF-8 replaced.
string utf8(ReadOnlySpan<u8> bytes) {
    var sb = StrBuf()
    appendUtf8(bytes, to: ref sb)
    return $"{sb.finish()}"
}

/// Number of scalars `bytes` decodes to, counting each replacement as one.
i64 runeCount(ReadOnlySpan<u8> bytes) {
    var count: i64 = 0
    var pos: i64 = 0
    while pos < bytes.length {
        pos += decodeAt(bytes, at: pos).length
        count += 1
    }
    return count
}

/// Upper-case hexadecimal, zero-padded to `digits`.
string hex(u32 value, to i64 digits) {
    var sb = StrBuf()
    var n: i64 = 1
    while n < 8 && (value >> u32(4 * n)) != 0 {
        n += 1
    }
    if n < digits {
        n = digits
    }
    var i = n - 1
    while i >= 0 {
        let d = (value >> u32(4 * i)) & 0xF
        sb.append($"{rune(d < 10 ? 0x30 + d : 0x37 + d)}")
        i -= 1
    }
    return $"{sb.finish()}"
}
== lexer/tokens.byn
// Tokens: kinds, flags, the token struct and keywords. Ports `TokenKind.cs`, `Token.cs` and
// `Keywords.cs` from `csharp/Bayan.Syntax/Lexing/`.

/// Member names are the C# `TokenKind` names with the first letter lowered; the dump raises it again.
public enum TokenKind {
    endOfFile

    // Names and literals
    identifier
    integerLiteral
    floatLiteral
    /// A suffix glued to a numeric literal: `5s`, `1u`, `1.5dec`.
    numericSuffix
    charLiteral
    stringLiteral
    rawStringLiteral
    cStringLiteral
    u16StringLiteral

    // Interpolated strings: $"a{x}b" lexes as Start Text HoleStart … HoleEnd Text End.
    interpolatedStringStart
    interpolatedStringText
    interpolationStart
    interpolationEnd
    interpolatedStringEnd

    // Punctuation
    openParen
    closeParen
    openBracket
    closeBracket
    openBrace
    closeBrace
    semicolon
    comma
    dot
    dotDot
    dotDotEquals
    colon
    question
    questionQuestion
    questionQuestionEquals
    questionDot
    fatArrow
    arrow
    at
    hash

    // Operators. `>>` and `>>=` are not tokens: the parser joins adjacent `>` tokens so that
    // `List<List<i64>>` closes two type argument lists.
    plus
    minus
    star
    slash
    percent
    plusPercent
    minusPercent
    starPercent
    plusBar
    minusBar
    starBar
    plusPlus
    minusMinus
    amp
    ampAmp
    bar
    barBar
    caret
    tilde
    bang
    equals
    equalsEquals
    bangEquals
    less
    lessEquals
    greater
    greaterEquals
    lessLess
    plusEquals
    minusEquals
    starEquals
    slashEquals
    percentEquals
    ampEquals
    barEquals
    caretEquals
    lessLessEquals

    // Keywords (spec §2.4). Order matters only for KeywordFirst/KeywordLast.
    structKeyword
    uniqueKeyword
    unionKeyword
    enumKeyword
    flagsKeyword
    openKeyword
    extensibleKeyword
    interfaceKeyword
    delegateKeyword
    extensionKeyword
    derivationKeyword
    attributeKeyword
    errorKeyword
    setKeyword
    unitKeyword
    distinctKeyword
    typeKeyword
    importKeyword
    asKeyword
    publicKeyword
    privateKeyword
    staticKeyword
    readonlyKeyword
    requiredKeyword
    constKeyword
    letKeyword
    varKeyword
    embedKeyword
    externKeyword
    unsafeKeyword
    ifKeyword
    elseKeyword
    unlessKeyword
    switchKeyword
    caseKeyword
    defaultKeyword
    forKeyword
    inKeyword
    whileKeyword
    doKeyword
    breakKeyword
    continueKeyword
    returnKeyword
    yieldKeyword
    deferKeyword
    errdeferKeyword
    usingKeyword
    contextKeyword
    failsKeyword
    tryKeyword
    catchKeyword
    neverKeyword
    noallocKeyword
    nosuspendKeyword
    suspendsKeyword
    asyncKeyword
    awaitKeyword
    isKeyword
    andKeyword
    orKeyword
    notKeyword
    withKeyword
    moveKeyword
    refKeyword
    outKeyword
    thisKeyword
    nullKeyword
    trueKeyword
    falseKeyword
    comptimeKeyword
    checkedKeyword
    testKeyword
    assertKeyword
    propertyKeyword
    fuzzKeyword
    modelKeyword
    requiresKeyword
    becauseKeyword
    usesKeyword
    exceptKeyword
    provideKeyword
    becomeKeyword
    failKeyword
    // Declaration-only, no meaning yet; contextual like the other declaration keywords.
    lawKeyword
    // Effect aliases (§14), contextual.
    effectKeyword
    // Accepted for C# compatibility.
    foreachKeyword
    newKeyword
    // Lexed so the parser can explain that it does not exist.
    gotoKeyword
    // Reserved: no meaning yet, may not be used as identifiers.
    actorKeyword
    macroKeyword
    selectKeyword
}

public bool isKeyword(TokenKind kind) =>
    kind.ordinal >= TokenKind.structKeyword.ordinal && kind.ordinal <= TokenKind.selectKeyword.ordinal

bool isReservedKeyword(TokenKind kind) =>
    kind.ordinal >= TokenKind.actorKeyword.ordinal && kind.ordinal <= TokenKind.selectKeyword.ordinal

public bool isStringLiteral(TokenKind kind) => kind switch {
    .stringLiteral or .rawStringLiteral or .cStringLiteral or .u16StringLiteral => true,
    _ => false,
}

/// The C# name of `kind`: its member name with the first byte upper-cased (plan Q52).
string kindName(TokenKind kind) {
    let name = kind.name
    return $"{rune(name.bytes[0] - 0x20)}{name[1..]}"
}

/// Source text of fixed tokens, for messages ("expected `;`").
public string kindText(TokenKind kind) uses alloc {
    return keywordText(kind) if isKeyword(kind)
    return kind switch {
        .endOfFile               => "end of file",
        .identifier              => "identifier",
        .integerLiteral          => "integer literal",
        .floatLiteral            => "float literal",
        .numericSuffix           => "numeric suffix",
        .charLiteral             => "char literal",
        .stringLiteral or .rawStringLiteral or .cStringLiteral or .u16StringLiteral => "string literal",
        .interpolatedStringStart => "$\"",
        .interpolatedStringText  => "interpolated text",
        .interpolationStart      => "{",
        .interpolationEnd        => "}",
        .interpolatedStringEnd   => "\"",
        .openParen               => "(",
        .closeParen              => ")",
        .openBracket             => "[",
        .closeBracket            => "]",
        .openBrace               => "{",
        .closeBrace              => "}",
        .semicolon               => ";",
        .comma                   => ",",
        .dot                     => ".",
        .dotDot                  => "..",
        .dotDotEquals            => "..=",
        .colon                   => ":",
        .question                => "?",
        .questionQuestion        => "??",
        .questionQuestionEquals  => "??=",
        .questionDot             => "?.",
        .fatArrow                => "=>",
        .arrow                   => "->",
        .at                      => "@",
        .hash                    => "#",
        .plus                    => "+",
        .minus                   => "-",
        .star                    => "*",
        .slash                   => "/",
        .percent                 => "%",
        .plusPercent             => "+%",
        .minusPercent            => "-%",
        .starPercent             => "*%",
        .plusBar                 => "+|",
        .minusBar                => "-|",
        .starBar                 => "*|",
        .plusPlus                => "++",
        .minusMinus              => "--",
        .amp                     => "&",
        .ampAmp                  => "&&",
        .bar                     => "|",
        .barBar                  => "||",
        .caret                   => "^",
        .tilde                   => "~",
        .bang                    => "!",
        .equals                  => "=",
        .equalsEquals            => "==",
        .bangEquals              => "!=",
        .less                    => "<",
        .lessEquals              => "<=",
        .greater                 => ">",
        .greaterEquals           => ">=",
        .lessLess                => "<<",
        .plusEquals              => "+=",
        .minusEquals             => "-=",
        .starEquals              => "*=",
        .slashEquals             => "/=",
        .percentEquals           => "%=",
        .ampEquals               => "&=",
        .barEquals               => "|=",
        .caretEquals             => "^=",
        .lessLessEquals          => "<<=",
        _                        => kindName(kind),
    }
}

/// Whitespace or a comment separates this token from the previous one.
const triviaBefore: u8  = 1
/// A line break separates this token from the previous one.
const newlineBefore: u8 = 2

/// A token is a kind plus byte offsets: no text is copied. A run of `///` lines directly before the
/// token is attached as its doc span.
public struct Token {
    public TokenKind kind
    public u8        tokenFlags
    public i64       start
    public i64       length
    public i64       docStart
    public i64       docLength

    public i64  end              => start + length
    public bool hasDoc           => docLength > 0
    public bool hasTriviaBefore  => (tokenFlags & triviaBefore) != 0
    public bool hasNewlineBefore => (tokenFlags & newlineBefore) != 0
}

// ── Keywords ─────────────────────────────────────────────────────────────────

/// The keyword text of a keyword kind: its member name without `Keyword`.
string keywordText(TokenKind kind) {
    let name = kind.name
    return name[0..name.length - 7]
}

/// Keyword kinds bucketed by first letter, so lookup compares a handful of byte strings.
public struct Keywords {
    /// Keyword ordinals grouped by first letter `a`..`z`.
    List<i32> byFirstByte
    /// `bucketStart[l]..bucketStart[l + 1]` is the bucket of letter `l` in `byFirstByte`.
    List<i64> bucketStart

    public static Keywords build() uses alloc {
        var keywords = Keywords { byFirstByte: List<i32>(), bucketStart: List<i64>() }
        for letter in 0..26 {
            keywords.bucketStart.append(keywords.byFirstByte.length)
            for ordinal in TokenKind.structKeyword.ordinal..=TokenKind.selectKeyword.ordinal {
                let kind = TokenKind.fromOrdinal(ordinal) ?? .identifier
                if kind.name.bytes[0] - 0x61 == letter {
                    keywords.byFirstByte.append(ordinal)
                }
            }
        }
        keywords.bucketStart.append(keywords.byFirstByte.length)
        return keywords
    }

    /// The keyword kind for an ASCII identifier, or `identifier`.
    public TokenKind lookup(ReadOnlySpan<u8> text) {
        // coverage-exempt: Q1086 scaffold passes a module name from `camelOf` (a lowercase first byte), so the `> 0x7A` branch is not reached through `new`
        return .identifier if text.length < 2 || text[0] < 0x61 || text[0] > 0x7A
        let letter = text[0] - 0x61
        for i in bucketStart[letter]..bucketStart[letter + 1] {
            let kind = TokenKind.fromOrdinal(byFirstByte[i]) ?? .identifier
            return kind if sameBytes(text, as: kind.name.bytes[0..kind.name.length - 7])
        }
        return .identifier
    }
}

public bool sameBytes(ReadOnlySpan<u8> a, as ReadOnlySpan<u8> b) {
    return false if a.length != b.length
    for i in 0..a.length {
        return false if a[i] != b[i]
    }
    return true
}
== lexer/unicode-tables.byn
// Generated by tools/Bayan.UnicodeGen; do not edit.
// Unicode version: 16.0.0
// .NET runtime: 10.0.14
// Command: dotnet run --project tools/Bayan.UnicodeGen -- --unicode 16.0.0 --out src/lexer/unicode-tables.byn
// All ranges are inclusive and sorted by first code point, for binary search.
// Hangul syllables are decomposed and composed algorithmically and appear in no table.

// identifier start (`_`, Lu Ll Lt Lm Lo Nl): pairs lo, hi
const identStartRanges: u32[1362] = [
