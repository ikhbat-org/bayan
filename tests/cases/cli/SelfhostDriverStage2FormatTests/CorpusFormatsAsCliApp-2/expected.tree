// T39: BinderCalls.cs ~1578-1956 (exhaustiveness, assignment, inc/dec, writability).

import parser

// ── Exhaustiveness ───────────────────────────────────────────────────────────

/// Reports a non-exhaustive `switch`. Expressions must always be exhaustive; statements only over finite types
/// (`bool`, error sets, enums, their optionals). Returns whether every value is covered. A null pattern or guard is -1.
bool checkExhaustive(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    as Type type,
    by in List<(BPattern, BExpr)> arms,
    bool statement
) {
    return true if isError(type)
    let domain = t39Domain(ref c, for: type)
    var covered = List<string>()
    for arm in arms {
        let pattern = arm.item1
        let guard = arm.item2
        return true if pattern == -1
        continue if guard != -1
        if irrefutable(ref c, for: pattern) {
            // Every union is declared in the package being compiled: there are no dependencies yet.
            if hasSyntax(in c, for: pattern, by: syntaxDiscard) && kindOf(type) == .unionType {
                var rest = List<string>()
                if (domain is { } all) {
                    for k in all {
                        if !listContainsString(in covered, by: k) {
                            rest.append(k)
                        }
                    }
                }
                report(
                    ref b,
                    through: ref c,
                    for: .wildcardOnLocalUnion,
                    at: nodeSpan(in c, for: pattern),
                    by: (typeDisplay(ref c, by: type), "", "", "", ""),
                    label: "matches every case added later",
                    help: rest.length > 0 ? $"list the cases instead: {t39Join(in rest)}" : "remove the `_` arm",
                )
            }
            return true
        }
        collect(ref c, for: pattern, as: type, to: ref covered)
    }
    var hasDomain = false
    var all = true
    var hasSome = false
    var missing = List<string>()
    if (domain is { } dom) {
        hasDomain = true
        for k in dom {
            if !listContainsString(in covered, by: k) {
                all = false
                missing.append(k == t39Some ? "a value" : k)
            }
            if k == t39Some {
                hasSome = true
            }
        }
    }
    return true if hasDomain && all
    return false if statement && (!hasDomain || hasSome)
    // A set none of whose variants is handled is named once, as the `catch switch` arm that would cover it.
    let unwrapped = unwrap(ref c, for: type)
    if kindOf(unwrapped) == .errorUnion && c.errorUnionTypes[typeIndex(unwrapped)].sets.length > 1 && hasDomain {
        var sets = List<ErrorSetId>()
        for s in c.errorUnionTypes[typeIndex(unwrapped)].sets {
            sets.append(s)
        }
        for set in sets {
            var keys = List<string>()
            for v in copyIds(in c.errorSets[set].variants) {
                keys.append(t39VariantKey(ref c, for: v, as: type))
            }
            var every = true
            for k in keys {
                if !listContainsString(in missing, by: k) {
                    every = false
                }
            }
            continue if keys.length == 0 || !every
            var at: i64 = 0
            for i in 0..missing.length {
                if missing[i] == keys[0] {
                    at = i
                    break
                }
            }
            var next = List<string>()
            for i in 0..missing.length {
                if i == at {
                    next.append(displayNameAmong(ref c, by: set, for: in sets))
                }
                if !listContainsString(in keys, by: missing[i]) {
                    next.append(missing[i])
                }
            }
            missing = move next
        }
    }
    if kindOf(unwrapped) == .errorUnion && c.errorUnionTypes[typeIndex(unwrapped)].sets.length > 1 && hasDomain {
        var sets = List<ErrorSetId>()
        for s in c.errorUnionTypes[typeIndex(unwrapped)].sets {
            sets.append(s)
        }
        var names: Map<string, string> = []
        for s in sets {
            for v in copyIds(in c.errorSets[s].variants) {
                let key = t39VariantKey(ref c, for: v, as: type)
                names[key] = $"{displayNameAmong(ref c, by: c.errorVariants[v].set, for: in sets)}.{c.errorVariants[v].name}"
            }
        }
        var shown = List<string>()
        for k in missing {
            shown.append(names.tryGet(at: k) ?? k)
        }
        missing = move shown
    }
    let listed = hasDomain && missing.length > 0
    report(
        ref b,
        through: ref c,
        for: .nonExhaustive,
        at: span,
        by: (typeDisplay(ref c, by: type), "", "", "", ""),
        label: listed ? $"not covered: {t39Join(in missing)}" : "",
        help: statement ? "add the missing cases or a `default:` section"
            // A `_` arm on a union of this package is BYN2712, so name the arms instead.
            : kindOf(type) == .unionType && listed ? $"add the missing arms: {t39Join(in missing)}"
            : "add the missing arms, or `_ => …` for the rest",
    )
    return false
}

const t39Some: string = "\0some"

/// `string.Join(", ", xs)`.
string t39Join(in List<string> xs) {
    var sb = StrBuf()
    for i in 0..xs.length {
        if i > 0 {
            sb.append(", ")
        }
        sb.append(xs[i])
    }
    return $"{sb.finish()}"
}

/// C# `HashSet.Add`.
void t39Add(ref List<string> set, by string k) {
    if !listContainsString(in set, by: k) {
        set.append(k)
    }
}

/// Every value of a finite type as a key; null for types with too many values to list.
List<string>? t39Domain(ref Ctx c, for Type type) {
    let i = typeIndex(type)
    var keys = List<string>()
    if type == prim(.bool) {
        keys.append("true")
        keys.append("false")
        return keys
    }
    switch kindOf(type) {
        case .errorSet:
            for v in copyIds(in c.errorSets[i].variants) {
                keys.append(t39VariantKey(ref c, for: v, as: type))
            }
            return keys
        case .enumType:
            for m in c.enums[i].members {
                keys.append($".{c.enumMembers[m].name}")
            }
            return keys
        case .unionType:
            for v in c.unions[i].variants {
                keys.append($".{c.unionVariants[v].name}")
            }
            return keys
        case .errorUnion:
            return null if c.errorUnionTypes[i].sets.length == 0
            var seen = List<i64>()
            for s in c.errorUnionTypes[i].sets {
                for v in copyIds(in c.errorSets[s].variants) {
                    continue if listContains(in c.errorUnionTypes[i].excluded, by: v) || listContains(in seen, by: v)
                    seen.append(v)
                }
            }
            for v in seen {
                keys.append(t39VariantKey(ref c, for: v, as: type))
            }
            return keys
        case .optional:
            if (t39Domain(ref c, for: c.optionalTypes[i]) is { } inner) {
                for k in inner {
                    keys.append(k)
                }
                keys.append("null")
                return keys
            }
            keys.append("null")
            keys.append(t39Some)
            return keys
        default:
            return null
    }
}

// Across sets a case is keyed by its program-wide code, not its text: `ValidationError<Point>` from two modules reads alike.
string t39VariantKey(ref Ctx c, for VariantId v, as Type type) {
    let u = unwrap(ref c, for: type)
    return $"\0code{c.errorVariants[v].code}" if kindOf(u) == .errorUnion
        && c.errorUnionTypes[typeIndex(u)].sets.length > 1
    return $".{c.errorVariants[v].name}"
}

bool irrefutable(ref Ctx c, for BPattern p) {
    let i = boundIndex(p)
    switch boundKind(p) {
        case .bindPattern:
            return true
        case .propertyPattern:
            return false if kindOf(c.bPropertyPatterns[i].inputType) == .optional
            let n = c.bPropertyPatterns[i].subpatterns.length
            for k in 0..n {
                return false if !irrefutable(ref c, for: c.bPropertyPatterns[i].subpatterns[k].pattern)
            }
            return true
        case .binaryPattern:
            let left = c.bBinaryPatterns[i].left
            let right = c.bBinaryPatterns[i].right
            return irrefutable(ref c, for: left) || irrefutable(ref c, for: right) if !c.bBinaryPatterns[i].isAnd
            return irrefutable(ref c, for: left) && irrefutable(ref c, for: right)
        default:
            return false
    }
}

/// `Subpatterns.All(Irrefutable)` over a list of patterns.
bool t39AllIrrefutable(ref Ctx c, for in List<BPattern> ps) {
    for p in ps {
        return false if !irrefutable(ref c, for: p)
    }
    return true
}

void collect(ref Ctx c, for BPattern p, as Type type, to ref List<string> covered) {
    let i = boundIndex(p)
    switch boundKind(p) {
        case .constantPattern:
            let value = c.bConstantPatterns[i].value
            let vi = boundIndex(value)
            switch boundKind(value) {
                case .defaultValue:
                    t39Add(ref covered, by: "null")
                    return
                case .errorVariant:
                    t39Add(ref covered, by: t39VariantKey(ref c, for: c.bErrorVariants[vi].variant, as: type))
                    return
                case .enumMember:
                    t39Add(ref covered, by: $".{c.enumMembers[c.bEnumMembers[vi].member].name}")
                    return
                default: {}
            }
            if (exprConstant(in c, for: value) is { } k) && k.kind == .flag {
                t39Add(ref covered, by: k.flag ? "true" : "false")
            }
        case .unionPattern:
            let subs = copyIds(in c.bUnionPatterns[i].subpatterns)
            if t39AllIrrefutable(ref c, for: in subs) {
                t39Add(ref covered, by: $".{c.unionVariants[c.bUnionPatterns[i].variant].name}")
            }
        case .errorPattern:
            let subs = copyIds(in c.bErrorPatterns[i].subpatterns)
            if t39AllIrrefutable(ref c, for: in subs) {
                t39Add(ref covered, by: t39VariantKey(ref c, for: c.bErrorPatterns[i].variant, as: type))
            }
        case .binaryPattern:
            let left = c.bBinaryPatterns[i].left
            let right = c.bBinaryPatterns[i].right
            if !c.bBinaryPatterns[i].isAnd {
                collect(ref c, for: left, as: type, to: ref covered)
                collect(ref c, for: right, as: type, to: ref covered)
            } else if irrefutable(ref c, for: right) {
                collect(ref c, for: left, as: type, to: ref covered)
            }
        case .propertyPattern:
            let input = c.bPropertyPatterns[i].inputType
            return if kindOf(input) != .optional
            let n = c.bPropertyPatterns[i].subpatterns.length
            for k in 0..n {
                return if !irrefutable(ref c, for: c.bPropertyPatterns[i].subpatterns[k].pattern)
            }
            t39Add(ref covered, by: t39Some)
            if (t39Domain(ref c, for: c.optionalTypes[typeIndex(input)]) is { } all) {
                for k in all {
                    t39Add(ref covered, by: k)
                }
            }
        case .notPattern:
            let operand = c.bNotPatterns[i].operand
            return if boundKind(operand) != .constantPattern
                || boundKind(c.bConstantPatterns[boundIndex(operand)].value) != .defaultValue
            return if kindOf(type) != .optional
            t39Add(ref covered, by: t39Some)
            if (t39Domain(ref c, for: c.optionalTypes[typeIndex(type)]) is { } rest) {
                for k in rest {
                    t39Add(ref covered, by: k)
                }
            }
        default: {}
    }
}

// ── Assignment and mutability ────────────────────────────────────────────────

parser.BinaryOp? compoundOperator(parser.AssignOp op) {
    switch op {
        case .add: return .add
        case .sub: return .sub
        case .mul: return .mul
        case .div: return .div
        case .rem: return .rem
        case .andKeyword: return .bitAnd
        case .orKeyword: return .bitOr
        case .xor: return .bitXor
        case .shl: return .shl
        case .shr: return .shr
        case .coalesce: return .coalesce
        default: return null
    }
}

BStmt bindAssign(ref Binder b, through ref Ctx c, for in parser.AssignStmt a) {
    var target = bindExpr(ref b, through: ref c, for: in a.target)
    // A local whose state is known is written as its declared type; the value's state is what it is known to be after.
    if boundKind(target) == .local && knownState(ref b, for: c.bLocals[boundIndex(target)].local) != -1 {
        target = shareSyntax(
            ref c,
            for: addLocalNode(ref c, at: c.bLocals[boundIndex(target)].span, for: c.bLocals[boundIndex(target)].local),
            from: target,
        )
    }
    let op = compoundOperator(a.op)
    let targetSpan = parser.exprSpan(in a.target)
    let valueSpan = parser.exprSpan(in a.value)
    if isError(exprType(in c, for: target)) {
        let _ = bindExpr(ref b, through: ref c, for: in a.value)
        return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
    }
    target = mapWriteTarget(ref c, for: target)
    if !t39CheckFieldWrite(ref b, through: ref c, for: target, at: a.span) {
        let _ = bindExpr(ref b, through: ref c, for: in a.value)
        return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
    }
    let _ = checkWritable(ref b, through: ref c, for: target, at: targetSpan, by: "")
    let targetType = exprType(in c, for: target)
    if op is null {
        let assigned = bindExpr(ref b, through: ref c, for: in a.value, to: targetType)
        constrain(ref b, through: ref c, for: target, as: assigned, from: in a.value)
        // A `ref` parameter or `this` keeps its state: only a value in the one state its type names may replace it (BYN7012).
        let tk = boundKind(target)
        var refOrThis = tk == .thisRef
        if tk == .local {
            let l = c.bLocals[boundIndex(target)].local
            refOrThis = c.locals[l].isParameter && c.locals[l].modifier == .refKeyword
        }
        let hasStates = kindOf(targetType) == .state
            || kindOf(targetType) == .structType && statesOf(ref c, for: typeIndex(targetType)) != -1
        if refOrThis && hasStates {
            var same = false
            if kindOf(targetType) == .state && c.stateTypes[typeIndex(targetType)].states.length == 1 {
                let one = c.stateTypes[typeIndex(targetType)].states[0]
                var givenType = exprType(in c, for: assigned)
                if (subject(ref b, through: ref c, for: assigned) is { } subj) {
                    givenType = subj.type
                }
                if kindOf(givenType) == .state && c.stateTypes[typeIndex(givenType)].states.length == 1 {
                    same = c.stateTypes[typeIndex(givenType)].states[0] == one
                }
            }
            if !same {
                let name = tk == .local ? c.locals[c.bLocals[boundIndex(target)].local].name : "this"
                report(
                    ref b,
                    through: ref c,
                    for: .assignmentChangesState,
                    at: a.span,
                    by: (name, "", "", "", ""),
                    help: "assign a value in the same state, or move the transition into a `becomes` method",
                )
                return recordAssignSyntax(
                    ref c,
                    for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
                    from: in a,
                )
            }
        }
        if tk == .local {
            let written = c.bLocals[boundIndex(target)].local
            forgetState(ref b, for: written)
            let at = exprType(in c, for: assigned)
            if kindOf(at) == .state {
                learnState(ref b, for: written, as: at)
            }
        } else if tk == .thisRef {
            forgetState(ref b, for: t15ThisFacts(ref b, through: ref c))
        }
        let pending = isPending(ref b, through: ref c, for: target)
        let converted = convert(
            ref b,
            through: ref c,
            for: assigned,
            to: targetType,
            at: valueSpan,
            constrains: !pending,
        )
        return recordAssignSyntax(
            ref c,
            for: addAssign(ref c, from: BAssign { span: a.span, target: target, value: converted }),
            from: in a,
        )
    }
    let bop = op
    if bop == .coalesce {
        if kindOf(targetType) != .optional {
            report(
                ref b,
                through: ref c,
                for: .coalesceNotOptional,
                at: targetSpan,
                by: (typeDisplay(ref c, by: targetType), "", "", "", ""),
            )
            return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
        }
        let converted = bindConverted(
            ref b,
            through: ref c,
            for: in a.value,
            to: c.optionalTypes[typeIndex(targetType)],
        )
        return recordAssignSyntax(
            ref c,
            for: addAssign(ref c, from: BAssign { span: a.span, target: target, value: converted, op: bop }),
            from: in a,
        )
    }
    let value = bindExpr(
        ref b,
        through: ref c,
        for: in a.value,
        to: bop == .shl || bop == .shr ? prim(.i32) : targetType,
    )
    let valueType = exprType(in c, for: value)
    return recordAssignSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
        from: in a,
    ) if isError(valueType)
    if bop is .shl or .shr {
        if !isInteger(targetType) || !isInteger(valueType) {
            report(
                ref b,
                through: ref c,
                for: .badBinaryOperands,
                at: a.span,
                by: (binaryText(bop), typeDisplay(ref c, by: targetType), typeDisplay(ref c, by: valueType), "", ""),
            )
            return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
        }
        return recordAssignSyntax(
            ref c,
            for: addAssign(ref c, from: BAssign { span: a.span, target: target, value: value, op: bop }),
            from: in a,
        )
    }
    constrain(ref b, through: ref c, for: target, as: value, from: in a.value)
    if isString(targetType) && bop == .add {
        let text = getText(c.files[b.file].text.span, at: targetSpan)
        var fix = StrBuf()
        fix.append($"{text} = $\"")
        fix.append("{")
        fix.append(text)
        fix.append("}")
        fix.append(interpolationSource(ref b, through: ref c, for: in a.value))
        fix.append("\"")
        report(
            ref b,
            through: ref c,
            for: .stringConcatenation,
            at: a.span,
            by: ("", "", "", "", ""),
            help: "write the parts as one interpolation: `s = $\"{s}{x}\"`, or build text in a `StrBuf`: `buf.append($\"{a}{b}\")`",
            hasFix: true,
            fixSpan: a.span,
            fixReplacement: $"{fix.finish()}",
        )
        return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
    }
    if !operatorApplies(ref c, for: bop, as: targetType) {
        report(
            ref b,
            through: ref c,
            for: .badBinaryOperands,
            at: a.span,
            by: (binaryText(bop), typeDisplay(ref c, by: targetType), typeDisplay(ref c, by: valueType), "", ""),
        )
        return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
    }
    let pending = isPending(ref b, through: ref c, for: target)
    let converted = convert(ref b, through: ref c, for: value, to: targetType, at: valueSpan, constrains: !pending)
    return recordAssignSyntax(
        ref c,
        for: addAssign(ref c, from: BAssign { span: a.span, target: target, value: converted, op: bop }),
        from: in a,
    )
}

BStmt bindIncDec(ref Binder b, through ref Ctx c, for in parser.IncDecStmt i) {
    var target = bindExpr(ref b, through: ref c, for: in i.target)
    let targetType = exprType(in c, for: target)
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: i.span }),
        as: .incDecStmt,
        at: i.span,
    ) if isError(targetType)
    if !isInteger(targetType) {
        report(
            ref b,
            through: ref c,
            for: .badUnaryOperand,
            at: i.span,
            by: (i.increment ? "++" : "--", typeDisplay(ref c, by: targetType), "", "", ""),
        )
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: i.span }),
            as: .incDecStmt,
            at: i.span,
        )
    }
    target = mapWriteTarget(ref c, for: target)
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: i.span }),
        as: .incDecStmt,
        at: i.span,
    ) if !t39CheckFieldWrite(ref b, through: ref c, for: target, at: i.span)
    let _ = checkWritable(ref b, through: ref c, for: target, at: parser.exprSpan(in i.target), by: "")
    let one = recordNodeSyntax(
        ref c,
        for: literal(
            ref c,
            at: i.span,
            as: exprType(in c, for: target),
            by: in Constant { kind: .integer, integer: bigFromI64(1) },
        ),
        as: .incDecStmt,
        at: i.span,
    )
    let op: parser.BinaryOp = i.increment ? .add : .sub
    return recordNodeSyntax(
        ref c,
        for: addAssign(ref c, from: BAssign { span: i.span, target: target, value: one, op: op }),
        as: .incDecStmt,
        at: i.span,
    )
}

/// J78 (O11, revision 0007): a field of a struct with `requires`, states or `@sealed` is written only by its own
/// methods (BYN3216 elsewhere); there, a field of a struct with `requires` is BYN3208, since the rules are checked at
/// construction. A constructor sets fields freely, and plain data is written anywhere.
bool t39CheckFieldWrite(ref Binder b, through ref Ctx c, for BExpr target, at TextSpan span) {
    return true if boundKind(target) != .field
    let field = c.bFields[boundIndex(target)].field
    let owner = c.fields[field].owner
    // Still a write for BYN2311, whichever way it is reported.
    let written = writtenLocal(ref c, for: target)
    if written != -1 {
        c.locals[written].written = true
    }
    let ownerDecl = c.structs[owner].template != -1 ? c.structs[owner].template : owner
    var own = false
    if b.owner != -1 {
        let s = b.owner
        own = s == owner || (c.structs[s].template != -1 ? c.structs[s].template : s) == ownerDecl
    }
    if !own {
        let reason = t39Invariant(ref c, for: ownerDecl) ?? return true
        let ownerName = c.structs[owner].name
        report(
            ref b,
            through: ref c,
            for: .fieldWriteOutside,
            at: span,
            by: (ownerName, c.fields[field].name, reason, "", ""),
            help: $"add a `ref this` method to `{ownerName}`, or build a new value with `with`",
        )
        return false
    }
    return true if (b.fn != -1 && c.functions[b.fn].kind == .constructor) || !c.checksOf.contains(ownerDecl)
    report(
        ref b,
        through: ref c,
        for: .checkedFieldAssignment,
        at: span,
        by: (c.structs[owner].name, "", "", "", ""),
        help: "build a new value with `with`: `try x with { f: v }`",
    )
    return false
}

/// Why BYN3216 protects `s`'s fields, the first of `requires`, states and `@sealed`; null for plain data.
string? t39Invariant(ref Ctx c, for StructId s) {
    let file = c.structs[s].file
    let d = c.structs[s].declIndex
    switch c.files[file].unit.members[d] {
        case .structDecl(let n):
            var hasRequires = n.value.rules.length > 0
            for m in n.value.members {
                switch m {
                    case .fieldDecl(let f):
                        if f.value.requiresClauses.length > 0 {
                            hasRequires = true
                        }
                    default: {}
                }
            }
            return "has `requires`" if hasRequires
            return "has states" if n.value.states.length > 0
            for a in n.value.attributes {
                return "is `@sealed`" if t11Text(in c, from: file, at: a.name) == "sealed"
            }
            return null
        default:
            panic("internal error: a struct without a struct declaration")
    }
}

/// `map[k]` as an assignment target: `=` inserts `k` when missing; `op=`, `++` and `--` read it first and panic (lowering).
BExpr mapWriteTarget(ref Ctx c, for BExpr target) {
    return target if boundKind(target) != .builtinCall || c.bBuiltinCalls[boundIndex(target)].member != .mapIndex
    let i = boundIndex(target)
    return shareSyntax(ref c, for: addBuiltinCall(ref c, from: BBuiltinCall {
        span: c.bBuiltinCalls[i].span,
        member: .mapIndexSet,
        receiver: c.bBuiltinCalls[i].receiver,
        arguments: copyIds(in c.bBuiltinCalls[i].arguments),
        type: c.bBuiltinCalls[i].type,
    }), from: target)
}

/// BYN2115 for a method that writes `this` at `span` first, with a fix inserting `ref this`. C# reports through the
/// binder that saw the write; its file is kept in `c.thisWrites` (Q694).
void reportMutatesWithoutRefThis(ref Ctx c, for FuncId fn, at TextSpan span) {
    let d = t39DeclFacts(ref c, for: fn)
    let file = c.thisWrites[fn].file
    report(
        ref c,
        for: .mutatesWithoutRefThis,
        from: file,
        at: span,
        by: (c.functions[fn].name, "", "", "", ""),
        label: "`this` is modified here",
        help: "declare it `ref this` as the first parameter",
        // A receiver written as `this is .s` gains only `ref`.
        hasFix: true,
        fixSpan: TextSpan { start: d.paramsStart, length: 0 },
        fixReplacement: d.receiverStates > 0 ? "ref " : d.params > 0 ? "ref this, " : "ref this",
    )
}

/// The first write to `this` in a method not declared `ref this` (C# `Compilation.ThisWrites`' value): the file of the
/// binder that saw it, and where (Q694).
struct T39ThisWrite {
    FileId   file
    TextSpan span
}

/// C# `fn.Decl!`'s `ParamsStart`, `ReceiverStates.Length` and `Params.Length`.
(i64 paramsStart, i64 receiverStates, i64 params) t39DeclFacts(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n): return (
            paramsStart: n.value.paramsStart,
            receiverStates: n.value.receiverStates.length,
            params: n.value.params.length
        )
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return (
                    paramsStart: x.value.paramsStart,
                    receiverStates: x.value.receiverStates.length,
                    params: x.value.params.length
                )
                default: {}
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return (
                    paramsStart: x.value.paramsStart,
                    receiverStates: x.value.receiverStates.length,
                    params: x.value.params.length
                )
                default: {}
            }
        case .extensionDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return (
                    paramsStart: x.value.paramsStart,
                    receiverStates: x.value.receiverStates.length,
                    params: x.value.params.length
                )
                default: {}
            }
        default: {}
    }
    panic("internal error: a method without a function declaration")
}

/// Reports when `target` may not be written. A write through `this` in a method not declared `ref this` is noted
/// for BYN2115; getters may not write. `why` is "" where C# has null.
bool checkWritable(ref Binder b, through ref Ctx c, for BExpr target, at TextSpan span, by string why) {
    let written = writtenLocal(ref c, for: target)
    if written != -1 {
        c.locals[written].written = true
    }
    return false if checkGuardWrite(ref b, through: ref c, for: target, at: span, by: why)
    let i = boundIndex(target)
    switch boundKind(target) {
        case .errorExpr:
            return false
        case .local:
            let l = c.bLocals[i].local
            if c.locals[l].borrowsSubject && isUnique(ref c, for: c.locals[l].type) {
                report(
                    ref b,
                    through: ref c,
                    for: .mutateBorrow,
                    at: span,
                    by: (c.locals[l].name, "", "", "", ""),
                    label: why,
                    help: "change the subject itself, or work on a `.copy(to: alloc)`; a loop or pattern variable of a unique type borrows from its subject",
                )
                return false
            }
            let kind = c.locals[l].kind
            let byRef = c.locals[l].isParameter && (c.locals[l].modifier is .refKeyword or .outKeyword)
            return true if kind == .varKeyword || kind == .temp || byRef
            t39ReportImmutable(ref b, through: ref c, for: l, at: span, by: why)
            return false
        case .thisRef:
            return true if b.fn != -1 && c.functions[b.fn].kind == .constructor
            if b.fn != -1 && c.functions[b.fn].kind == .method && !c.functions[b.fn].isStatic {
                let fn = b.fn
                if !c.functions[fn].isMutating
                        && !functionIsInstance(ref c, by: fn)
                        && (!c.thisWrites.contains(fn) || span.start < c.thisWrites[fn].span.start) {
                    c.thisWrites[fn] = T39ThisWrite { file: b.file, span: span }
                }
                return true
            }
            if b.fn != -1 && c.functions[b.fn].kind == .getter {
                report(
                    ref b,
                    through: ref c,
                    for: .getterMutates,
                    at: span,
                    by: (c.functions[b.fn].name, "", "", "", ""),
                    help: "make it a method if it needs to change the value",
                )
            } else {
                report(ref b, through: ref c, for: .mutateTemporary, at: span, by: ("", "", "", "", ""), label: why)
            }
            return false
        case .field:
            let field = c.bFields[i].field
            let receiver = c.bFields[i].receiver
            if fieldIsReadonly(ref c, by: field)
                    && !(b.fn != -1
                    && c.functions[b.fn].kind == .constructor
                    && c.functions[b.fn].owner == c.fields[field].owner
                    && boundKind(receiver) == .thisRef) {
                report(
                    ref b,
                    through: ref c,
                    for: .readonlyField,
                    at: span,
                    by: (c.fields[field].name, "", "", "", ""),
                    help: "set `readonly` fields only in a constructor or a struct literal",
                )
                return false
            }
            return checkWritable(ref b, through: ref c, for: receiver, at: span, by: why)
        case .tupleElement:
            return checkWritable(ref b, through: ref c, for: c.bTupleElements[i].receiver, at: span, by: why)
        case .index:
            let indexed = c.bIndexes[i].target
            let tt = exprType(in c, for: indexed)
            if kindOf(tt) == .span {
                if c.spanTypes[typeIndex(tt)].readOnly {
                    report(
                        ref b,
                        through: ref c,
                        for: .mutateTemporary,
                        at: span,
                        by: ("", "", "", "", ""),
                        label: "a `ReadOnlySpan` cannot be written through",
                    )
                    return false
                }
                return true
            }
            return checkWritable(ref b, through: ref c, for: indexed, at: span, by: why)
        case .builtinCall:
            let member = c.bBuiltinCalls[i].member
            return checkWritable(
                ref b,
                through: ref c,
                for: c.bBuiltinCalls[i].receiver,
                at: span,
                by: why,
            ) if member is .mapIndexSet
                or .mapSlot
            if member == .ownedValue {
                report(
                    ref b,
                    through: ref c,
                    for: .mutateTemporary,
                    at: span,
                    by: ("", "", "", "", ""),
                    label: why == "" ? "an `Owned` value is read-only" : $"{why}; an `Owned` value is read-only",
                    help: "build a new value and wrap it with `Owned(…)`",
                )
                return false
            }
            report(ref b, through: ref c, for: .mutateTemporary, at: span, by: ("", "", "", "", ""), label: why)
            return false
        case .staticArray:
            report(
                ref b,
                through: ref c,
                for: .mutateTemporary,
                at: span,
                by: ("", "", "", "", ""),
                label: why == "" ? "a `const` never changes" : $"{why}; a `const` never changes",
            )
            return false
        default:
            report(ref b, through: ref c, for: .mutateTemporary, at: span, by: ("", "", "", "", ""), label: why)
            return false
    }
}

/// The local a write lands in, even when the write is rejected (`x.f`, `x[i]`, a tuple element of `x`); -1 for none.
LocalId writtenLocal(ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local: return c.bLocals[i].local
        case .field: return writtenLocal(ref c, for: c.bFields[i].receiver)
        case .tupleElement: return writtenLocal(ref c, for: c.bTupleElements[i].receiver)
        case .index:
            return -1 if kindOf(exprType(in c, for: c.bIndexes[i].target)) == .span
            return writtenLocal(ref c, for: c.bIndexes[i].target)
        case .builtinCall:
            let member = c.bBuiltinCalls[i].member
            return writtenLocal(ref c, for: c.bBuiltinCalls[i].receiver) if member is .mapIndexSet or .mapSlot
            return -1
        default: return -1
    }
}

void t39ReportImmutable(ref Binder b, through ref Ctx c, for LocalId l, at TextSpan span, by string why) {
    var label = ""
    var help = ""
    var hasFix = false
    var fixSpan: TextSpan? = null
    switch c.locals[l].kind {
        case .letKeyword:
            label = $"declared with `let` on line {linePosition(c.files[b.file].text.span, at: c.locals[l].nameSpan.start).line}"
            help = "declare it with `var` if it should change"
            if (c.locals[l].keywordSpan is { } k) {
                hasFix = true
                fixSpan = k
            }
        case .constKeyword:
            label = "a `const` never changes"
        case .parameter:
            label = "parameters are immutable"
            help = "copy it into a local `var`, or take it by `ref` if the caller's value should change"
        case .forVariable:
            label = "loop variables are immutable"
            help = "copy it into a local `var` to change it"
        case .patternVariable:
            label = "pattern variables are immutable"
        default: {}
    }
    if why != "" {
        label = label == "" ? why : $"{why}; {label}"
    }
    report(
        ref b,
        through: ref c,
        for: .immutableAssignment,
        at: span,
        by: (c.locals[l].name, "", "", "", ""),
        label: label,
        help: help,
        hasFix: hasFix,
        fixSpan: fixSpan,
        fixReplacement: hasFix ? "var" : "",
    )
}
== semantics/cli.byn
// The CLI pieces bayan-check and bayan-emit share (moved unchanged from main.byn, 011 T1 D2): the exit codes,
// option parsing, `Compile`, `Report` and `Failed` of CliApp.cs (:151 `ParseBuildOptions`, :259 `Compile`,
// :298 `Report`, :513 `Failed`), `check` and `types`.

import lexer
import parser

const exitOk: i32      = 0
const exitFailure: i32 = 1
const exitUsage: i32   = 2

/// CliApp.cs:296 `ErrorLimit`.
const errorLimit: i64 = 20

/// C# `int.MaxValue` as `RenderAll`'s uncapped limit.
const noLimit: i64 = 2147483647

/// The `Symbols` members the CLI prints (Style.cs:59-60).
public struct T26Symbols {
    public string dot
    public string cross
    public string ellipsis
    // ── T19 state
    /// `Symbols.Bar` (Style.cs:59-60), which the diagnostic renderer draws its gutter with.
    public string bar     = "│"
    /// Whether `Style.Colors` is set; the four prefixes below are `Palette.Prefix` of `Role.Error`, `Warning`, `Help` and `Note` then.
    public bool   color   = false
    public string error   = ""
    public string warning = ""
    public string help    = ""
    public string note    = ""
    /// `Style.Width`: where prose in a diagnostic wraps.
    public i64    width   = 100
}

/// The `BuildOptions` subset `check` and `types` read (CliApp.cs:149).
public struct T26Options {
    public string  path
    public bool    json   = false
    public bool    all    = false
    public bool    spans  = false
    /// `--target` of `build` and `run` (012 T5, CliApp.cs:284 `Target: o.Target`); `check` and `types` leave it null.
    public string? target = null
}

/// A reported diagnostic as `Failed` reads it: its sort key (path, start), code and severity.
public struct T26Reported {
    public string path
    public i64    start
    public string code
    public bool   isWarning
    /// A style lint at `.suggestion`: counted neither as an error nor as a warning.
    public bool   isNote = false
}

public T26Symbols t26Symbols(
    bool ascii,
    bool color = false,
    i64 width = 100,
    string error = "",
    string warning = "",
    string help = "",
    string note = ""
) =>
    ascii ? T26Symbols {
        dot: "*",
        cross: "x",
        ellipsis: "...",
        bar: "|",
        color: color,
        error: error,
        warning: warning,
        help: help,
        note: note,
        width: width,
    }
    : T26Symbols {
        dot: "◆",
        cross: "✗",
        ellipsis: "…",
        bar: "│",
        color: color,
        error: error,
        warning: warning,
        help: help,
        note: note,
        width: width,
    }

/// The C# `File.Exists`: `path` reads and is not a directory.
bool t26FileExists(string path) {
    return false if t11DirectoryExists(path)
    let _ = Io.readFile(path) catch return false
    return true
}

/// CliApp.cs:151 `ParseBuildOptions` (`allowOutput: false`): `--`, `--mode`, `--diagnostics`, `--all`, and
/// bayan-check's `--spans`. Null after reporting.
public T26Options? t26ParseBuildOptions(in List<string> args, bool allowSpans) uses alloc, console, fs {
    var path: string? = null
    var json = false
    var all = false
    var spans = false
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        i += 1
        if a == "--" {
            // `programArgs`: `check` and `types` ignore them.
            break
        } else if a == "--mode" && i < args.length {
            // Toolchain.cs:68 `TryParseMode`; the mode itself does not change a check.
            let m = args[i]
            i += 1
            if m != "debug" && m != "safe" && m != "fast" {
                Io.stderr.write($"bayan: unknown mode `{m}` (expected debug, safe or fast)\n")
                return null
            }
        } else if a == "--diagnostics" && i < args.length {
            let format = args[i]
            i += 1
            if format == "json" {
                json = true
            } else if format == "text" {
                json = false
            } else {
                Io.stderr.write($"bayan: unknown diagnostics format `{format}` (expected json or text)\n")
                return null
            }
        } else if a == "--all" {
            all = true
        } else if a == "--spans" && allowSpans {
            spans = true
        } else {
            if path is not null || a.startsWith("-") {
                Io.stderr.write($"bayan: unexpected argument `{a}`\n")
                return null
            }
            path = a
        }
    }
    // `File.Exists("package.byn")` in the current directory has no Bayan form (Q571).
    if (path is { } p) {
        if !t26FileExists(p) && !t11DirectoryExists(p) {
            Io.stderr.write($"bayan: not found: {p}\n")
            return null
        }
        return T26Options { path: p, json: json, all: all, spans: spans }
    }
    Io.stderr.write("bayan: expected a file or directory (or run inside a project with a `package.byn`)\n")
    return null
}

/// A `Ctx` with nothing in it, standing for C#'s `null` `Compiled`.
Ctx t26EmptyCtx() => Ctx {
    files: List<SourceFile>(),
    modules: List<Mod>(),
    diagnostics: List<Diag>(),
    bags: List<DiagBag>(),
}

/// CliApp.cs:259 `Compile`: a project directory (one with `package.byn`), a script (a file starting with
/// `#!`, compiled alone) or a file or directory (the whole directory is the entry module). Prints
/// diagnostics and adds them to `reported`; `ok` is false where C# returns null. With `styleLints` (`check`), `t26StyleLints` follows.
public Ctx t26Compile(
    in T26Options o,
    by in T26Symbols symbols,
    to ref List<T26Reported> reported,
    through ref bool ok,
    bool includeTests = false,
    bool styleLints = false
) uses alloc, clock, console, fs {
    ok = false
    let manifestPath = t11Combine(o.path, by: "package.byn")
    if t11DirectoryExists(o.path) && t26FileExists(manifestPath) {
        let root = t11FullPath(o.path)
        // Q565: an unreadable `package.byn` reads as an empty one (BYN3100).
        let manifest = manifestRead(
            t11Combine(root, by: "package.byn"),
        ) catch manifestParse(lexer.SourceText.create("package.byn", from: List<u8>()))
        t26ReportManifest(
            in o,
            by: in symbols,
            for: in manifest,
            at: t11Combine(root, by: "package.byn"),
            to: ref reported,
        )
        return t26EmptyCtx() if manifestErrorCount(in manifest) > 0
        let entry = t10EntryModule(in manifest)
        unless t11DirectoryExists(t11Combine(t11Combine(root, by: "src"), by: entry)) {
            let kind = manifest.kind == .lib ? "a library" : "an app"
            Io.stderr.write(
                $"bayan: `{manifest.name}` is {kind}, so its code goes in `src/{entry}/`, which doesn't exist\n",
            )
            return t26EmptyCtx()
        }
        var capabilities: List<string>? = null
        if (manifest.capabilities is { } caps) {
            capabilities = copyStrings(in caps)
        }
        let options = CompilationOptions {
            includeTests: includeTests,
            library: manifest.kind == .lib,
            capabilities: move capabilities,
            packageName: manifest.name,
            target: o.target,
        }
        var c = fromProject(root, for: entry, by: in options)
        c.manifest = move manifest
        t26Report(in o, by: in symbols, for: ref c, to: ref reported)
        ok = !t11HasErrors(in c)
        if styleLints && ok {
            ok = t26StyleLints(o, by: symbols, for: c, to: ref reported)
        }
        return c
    }
    let options = CompilationOptions { includeTests: includeTests }
    var c = fromPath(o.path, by: in options, wholeDirectory: !t26IsScript(o.path))
    t26Report(in o, by: in symbols, for: ref c, to: ref reported)
    ok = !t11HasErrors(in c)
    if styleLints && ok {
        ok = t26StyleLints(o, by: symbols, for: c, to: ref reported)
    }
    return c
}

/// CliApp.cs: Compile, its `styleLints` step (`check` only, after an error-free compile): reports `StyleLintsAt` of the
/// compilation's manifest and returns false when one of them is an error. Under `--package <root>`, `lintRoot` is the root, whose
/// `package.byn` (if it reads without errors) sets the severities instead (the C# `lintManifest`).
public bool t26StyleLints(
    T26Options o,
    by T26Symbols symbols,
    for Ctx c,
    to ref List<T26Reported> reported,
    string? lintRoot = null
)
        uses alloc, console, fs {
    var lintManifest: Manifest? = null
    if lintRoot is not null && t26FileExists(t11Combine(lintRoot, by: "package.byn")) {
        // An unreadable one reads as an empty one (Q565), whose BYN3100 leaves the defaults.
        var read = manifestRead(
            t11Combine(lintRoot, by: "package.byn"),
        ) catch manifestParse(lexer.SourceText.create("package.byn", from: List<u8>()))
        if manifestErrorCount(in read) == 0 {
            lintManifest = move read
        }
    }
    let lints = lintManifest is not null ? styleLintsAt(c, by: lintManifest) : styleLintsAt(c, by: c.manifest)
    var ok = true
    for d in lints {
        reported.append(
            T26Reported {
                path: pathOf(in c, for: in d),
                start: d.span.start,
                code: d.code,
                isWarning: d.isWarning,
                isNote: d.isNote,
            },
        )
        if !d.isWarning && !d.isNote {
            ok = false
        }
    }
    return ok if lints.length == 0
    if o.json {
        Io.stderr.write(t26DiagnosticJsonAll(in c, from: in lints))
        return ok
    }
    var omitted: i64 = 0
    let rendered = renderAllBy(
        in c,
        from: in lints,
        by: true,
        until: o.all ? noLimit : errorLimit,
        to: ref omitted,
        through: in symbols,
    )
    Io.stderr.write(rendered)
    if omitted > 0 {
        Io.stderr.write($"{capLine(symbols.ellipsis, by: omitted)}\n")
    }
    return ok
}

/// CliApp.cs:298 `Report` for the compilation's diagnostics.
public void t26Report(in T26Options o, by in T26Symbols symbols, for ref Ctx c, to ref List<T26Reported> reported)
        uses alloc, console {
    for d in c.diagnostics {
        reported.append(
            T26Reported { path: pathOf(in c, for: in d), start: d.span.start, code: d.code, isWarning: d.isWarning },
        )
    }
    return if c.diagnostics.length == 0
    if o.json {
        Io.stderr.write(t26DiagnosticJsonAll(in c, from: in c.diagnostics))
        return
    }
    var omitted: i64 = 0
    let rendered = renderAllBy(
        in c,
        from: in c.diagnostics,
        by: true,
        until: o.all ? noLimit : errorLimit,
        to: ref omitted,
        through: in symbols,
    )
    Io.stderr.write(rendered)
    if omitted > 0 {
        Io.stderr.write($"{capLine(symbols.ellipsis, by: omitted)}\n")
    }
}

/// CliApp.cs:298 `Report` for a manifest's diagnostics. They have no file (Q565), so they render against
/// a `Ctx` holding the manifest's text as file 0, named `package.byn` as `Manifest.Read` names it.
void t26ReportManifest(
    in T26Options o,
    by in T26Symbols symbols,
    for in Manifest m,
    at string path,
    to ref List<T26Reported> reported
) {
    return if m.diagnostics.length == 0
    var c = t26EmptyCtx()
    let text = Io.readFile(path) catch List<u8>()
    let empty = List<u8>()
    var p = parser.Parser.create(
        lexer.lex(lexer.SourceText.create("package.byn", from: move empty), by: lexer.Keywords.build()),
    )
    let unit = parser.parseCompilationUnit(ref p)
    c.files.append(
        SourceFile {
            path: "package.byn",
            displayPath: "package.byn",
            text: move text,
            unit: move unit,
            imports: Map<string,
            i64>(),
        },
    )
    for d in m.diagnostics {
        var copy = t10CopyDiag(in d)
        copy.file = 0
        c.diagnostics.append(move copy)
    }
    t26Report(in o, by: in symbols, for: ref c, to: ref reported)
}

/// CliApp.cs:362 `IsScript`: a file whose first two bytes are `#!`.
bool t26IsScript(string path) {
    unless t26FileExists(path) {
        return false
    }
    let bytes = Io.readFile(path) catch return false
    return bytes.length >= 2 && bytes[0] == 0x23 && bytes[1] == 0x21
}

/// CliApp.cs:141 `Types`.
i32 types(in List<string> args, by in T26Symbols symbols) {
    let o = t26ParseBuildOptions(in args, allowSpans: false) ?? return exitUsage
    var reported = List<T26Reported>()
    var ok = false
    var c = t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    unless ok {
        return exitFailure
    }
    Io.stdout.write(typedDump(ref c))
    return exitOk
}

/// CliApp.cs:441 `Check`.
i32 check(in List<string> args, by in T26Symbols symbols) {
    let clock = Io.monotonicNanos()
    let o = t26ParseBuildOptions(in args, allowSpans: true) ?? return exitUsage
    var reported = List<T26Reported>()
    var ok = false
    var c = t26Compile(in o, by: in symbols, to: ref reported, through: ref ok, styleLints: true)
    if o.spans {
        t26CheckSpans(ref c)
    }
    unless ok {
        return t26Failed(in o, from: in reported, by: in symbols)
    }
    unless o.json {
        print(
            checkSummary(
                symbols.dot,
                for: programName(ref c, for: o.path),
                by: t26Seconds(Io.monotonicNanos() - clock),
            ),
        )
    }
    return exitOk
}

/// CliApp.cs:506 `Seconds`: `{0}s` with two decimals (`0.00` rounds half away from zero).
public string t26Seconds(i64 nanos) uses alloc {
    let hundredths = (nanos + 5000000) / 10000000
    let rest = hundredths % 100
    return rest < 10 ? $"{hundredths / 100}.0{rest}s" : $"{hundredths / 100}.{rest}s"
}

/// CliApp.cs:513 `Failed`: the footer after a failed compile; nothing in JSON mode, or when no error caused
/// the failure. The first error is the first of `DiagnosticRenderer.Sort` (path ordinal, then start; ties
/// keep order).
public i32 t26Failed(in T26Options o, from in List<T26Reported> reported, by in T26Symbols symbols)
        uses alloc, console {
    return exitFailure if o.json
    var first: i64 = -1
    var errors: i64 = 0
    var warnings: i64 = 0
    for i in 0..reported.length {
        if reported[i].isWarning {
            warnings += 1
            continue
        }
        continue if reported[i].isNote
        errors += 1
        if first < 0 || pathLess(reported[i].path, by: reported[first].path) ||
                (reported[i].path == reported[first].path && reported[i].start < reported[first].start) {
            first = i
        }
    }
    return exitFailure if first < 0
    Io.stderr.write("\n")
    Io.stderr.write(
        $"{paint(in symbols, by: symbols.error, for: buildFailed(symbols.cross, by: errors, as: warnings))}\n",
    )
    Io.stderr.write($"{buildExplain(reported[first].code)}\n")
    return exitFailure
}

/// L023's check (Bayan only): a `span out of range:` line for each diagnostic, related or fix span that
/// does not lie within its file.
void t26CheckSpans(ref Ctx c) {
    for d in c.diagnostics {
        continue if d.file < 0
        let size = c.files[d.file].text.length
        let path = c.files[d.file].displayPath
        t26CheckSpan(d.span, until: size, for: d.code, at: path)
        for r in d.related {
            t26CheckSpan(r.span, until: size, for: d.code, at: path)
        }
        if d.hasFix {
            t26CheckSpan(d.fixSpan, until: size, for: d.code, at: path)
        }
    }
}

void t26CheckSpan(TextSpan span, until i64 size, for string code, at string path) {
    return if span.start >= 0 && span.length >= 0 && span.end <= size
    print($"span out of range: {code} {path} {span.start}..{span.end} (size {size})")
}
== semantics/codes.byn
// T2: Bayan.Syntax/Diagnostics/DiagnosticCodes.cs, BYN2xxx-BYN8xxx plus BYN1016/1054/1056 and BYN1072-1080.
//
// The semantic message table: every descriptor in the BYN2000-BYN8999 ranges, in `DiagnosticCodes.cs`
// order, plus the three BYN1xxx codes the checker reports (Q526) and the style lints BYN1072-BYN1080 (spec 022,
// `Note` in C#; the parser reports them, recover.byn, and `bayan check` gives them their severity, compile.byn). Member names are the C# names with the
// first letter lowered, so `conversionMember` is BYN5009's second message form and `becomesCallUndeclared`
// is BYN7003's third, registered once each in C#.

/// Every descriptor a semantics pass reports, in `DiagnosticCodes.cs` order.
enum SemaCode {
    modifierNotAllowed
    tryCoversMore
    returnErrorInput
    undefinedName
    unknownType
    unknownMember
    unknownModule
    notVisible
    duplicateDeclaration
    shadowing
    typeCasing
    valueCasing
    importCycle
    circularAlias
    circularConstant
    duplicateMain
    noMain
    statementOutsideEntry
    instanceMemberWithoutThis
    thisOutsideMethod
    notAValue
    unknownLabel
    unknownParameter
    unsupported
    wrongTypeArgumentCount
    nestedOptional
    voidValue
    declarationAsBody
    nullEquality
    sameTypeShadowing
    nestedIt
    toStringCall
    unknownStdModule
    stdImportsPackage
    circularFieldDefault
    missingInitializer
    useBeforeAssign
    outNotAssigned
    immutableAssignment
    readonlyField
    mutateTemporary
    getterMutates
    requiredWithDefault
    missingFields
    duplicateFieldInit
    literalWithConstructor
    noConstructor
    recursiveStruct
    notAStruct
    mutatesWithoutRefThis
    refThisOnOperator
    refThisNotFirst
    stringIndexer
    typeMismatch
    literalOutOfRange
    constantOverflow
    divisionByZero
    invalidCast
    badUnaryOperand
    badBinaryOperands
    stringConcatenation
    coalesceNotOptional
    memberOfOptional
    notIndexable
    indexOutOfRange
    fromEndOutsideIndex
    openRange
    branchTypeMismatch
    cannotInferType
    noTargetType
    notConstant
    notCallable
    notIterable
    arrayLengthMismatch
    tupleNameMismatch
    interpolationNotAllowed
    notFormattable
    notDisposable
    ambiguousVariant
    unknownVariant
    invalidConstArray
    renamedMember
    whileLetNotOptional
    spreadNotSequence
    mapLiteralMixed
    missingArgument
    tooManyArguments
    duplicateArgument
    positionalAfterNamed
    argumentMustBeNamed
    argumentModifierMismatch
    retiredArgumentsSwapped
    spanParameterNeverWritten
    neverReassignedVar
    requiresNotBool
    requiresViolated
    retiredRequiresNotHere
    missingReturn
    missingReturnValue
    returnValueInVoid
    neverReturns
    unreachableCode
    jumpOutsideLoop
    continueSwitch
    labelNotOnLoop
    duplicateDefault
    nonExhaustive
    patternMismatch
    tryInDefer
    unhandledFailure
    undeclaredError
    propagateFromInfallible
    nothingToHandle
    errdeferWithoutFails
    publicInferredFails
    notAnErrorSet
    emptyErrorSet
    jumpOutOfDefer
    catchBlockCompletes
    panicHandlerRestricted
    panicHandlerReads
    onPanicPlacement
    panicHandlerReadsMoved
    unknownUnionVariant
    duplicateUnionVariant
    emptyUnion
    variantPatternArity
    payloadNeedsPattern
    variantNeedsPayload
    variantHasNoPayload
    recursiveUnion
    borrowPayload
    unionValueNotInteger
    unionValueOnPayload
    duplicateUnionValue
    wildcardOnLocalUnion
    unknownEnumMember
    duplicateEnumMember
    emptyEnum
    enumArgumentNotConstant
    invalidEnumParameter
    cannotInferTypeArgument
    conflictingTypeArgument
    genericArgumentCount
    typeParameterOperator
    typeParameterMember
    invalidMapKey
    recursiveByValue
    sharedStorageCopy
    unknownAttribute
    invalidMainSignature
    untrustedSink
    trustReason
    takeUnsupported
    switchMoveSubject
    owningPatternOverlap
    owningBindingMutatedInGuard
    invalidExitCode
    assertNotBool
    casesArity
    casesNotConstant
    implicitCopy
    useAfterMove
    cannotMove
    mutateBorrow
    copyUniqueElement
    mapSlotNoDefault
    interfaceName
    missingInterfaceMember
    interfaceMemberMismatch
    missingAssociatedType
    notAnInterface
    duplicateConformance
    constraintMember
    constraintNotSatisfied
    notDynSafe
    dynByValue
    staticAbstract
    extensionConformance
    whereUnknownParameter
    dynReadonlyMutation
    refThisMismatch
    nonStructConformance
    interfaceAsType
    lambdaArity
    cannotCapture
    functionTypeNotHere
    memberNotLambda
    notAFunctionValue
    hashMapNotSupported
    keyPartNotHashable
    stringNotSymbol
    borrowField
    borrowOutlivesSource
    borrowReturned
    modifiedWhileBorrowed
    refAndValue
    movedWhileBorrowed
    unusedValue
    duplicateErrorCase
    bareLiteralForDistinct
    ruleTargetNotField
    literalNeedsTry
    checkedFieldAssignment
    uniqueConst
    overlappingOverloads
    restEscapes
    ambiguousOverloadReference
    fieldWriteOutside
    borrowCrossesFiber
    requiresMixesFields
    unknownMutationOperator
    manifestNotData
    manifestUnknownField
