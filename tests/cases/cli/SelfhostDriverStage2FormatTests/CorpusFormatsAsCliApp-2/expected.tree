        "point", "pointer", "pool", "port", "position", "post", "power", "prefix", "price", "product",
        "profile", "program", "progress", "project", "property", "quantity", "queue", "range", "rate", "ratio",
        "reader", "reason", "receipt", "record", "rect", "rectangle", "ref", "region", "remainder", "report",
        "request", "response", "rest", "result", "results", "right", "role", "room", "root", "row",
        "rule", "rune", "runes", "salary", "scale", "schema", "scope", "score", "scratch", "screen",
        "second", "secret", "section", "seed", "segment", "sender", "sequence", "server", "service", "session",
        "set", "shape", "share", "shelf", "side", "sign", "signal", "size", "slot", "socket",
        "source", "space", "span", "speed", "sql", "stack", "stage", "start", "state", "status",
        "step", "stock", "store", "stream", "string", "struct", "style", "subtotal", "suffix", "sum",
        "summary", "supply", "symbol", "system", "table", "tag", "target", "task", "tax", "team",
        "temp", "term", "test", "text", "thing", "thousand", "thread", "threshold", "ticket", "time",
        "timeout", "timer", "title", "token", "tool", "top", "total", "trace", "track", "tree",
        "trivia", "type", "unit", "url", "user", "utf", "value", "values", "var", "vec",
        "vector", "version", "view", "volume", "wallet", "week", "weight", "width", "window", "word",
        "work", "world", "year", "zone",
    ]
    c.lexiconAdjectives = [
        "active", "actual", "ajar", "all", "any", "available", "average", "big", "blank", "busy", "current", "dark",
        "dead", "deep", "default", "dirty", "due", "early", "empty", "even", "exact", "external", "fast", "final",
        "fresh", "full", "global", "good", "high", "idle", "inner", "internal", "invalid", "large", "late", "lazy",
        "light", "live", "long", "low", "main", "many", "maximum", "minimum", "mutable", "native", "negative", "net",
        "new", "next", "odd", "old", "open", "other", "outer", "overdue", "own", "paid", "pending", "positive",
        "previous", "prime", "private", "public", "raw", "ready", "real", "red", "safe", "same", "short", "simple",
        "single", "slow", "small", "stale", "static", "strict", "unique", "upper", "valid", "visible", "whole", "zero",
    ]
    c.lexiconCollectives = [
        "span", "list", "map", "set", "array", "buffer", "queue", "stack", "batch", "history", "inventory", "catalog",
        "data", "metadata", "path", "text", "payload", "body", "order", "work",
    ]
    c.lexiconIrregularPlurals = ["people", "children", "criteria", "indices", "matrices", "data"]
    c.lexiconIrregularSingulars = ["person", "child", "criterion", "index", "matrix", "datum"]
}

/// Particles (spec §10), the prefixes of derived names, and function words a name may join with.
bool isParticleWord(string w) => w switch {
    "from" or "to" or "until" or "through" or "at" or "by" or "for" or "as" => true,
    _ => false,
}

bool isFunctionWord(string w) => w switch {
    "is" or "has" or "can" or "try" or "into" or "with" or "and" or "or" or "of" or "in" or "on" or "off" or "out" or
        "up" or "down" or "over" or "per" or "no" or "not" or "each" or "every" or "some" or "none" or "ok" or "if" or
        "else" or "then" or "also" or "only" or "again" or "once" or "self" or "twice" or "before" or "after" => true,
    _ => false,
}

/// Math vocabulary: a naming exemption, not a synonym (J70). There is no `log` member.
bool isMathWord(string w) => w switch {
    "abs" or "sign" or "sqrt" or "cbrt" or "pow" or "exp" or "ln" or "log2" or "log10" or "sin" or "cos" or "tan" or
        "asin" or "acos" or "atan2" or "radians" or "degrees" => true,
    _ => false,
}

// ── Naming.cs ────────────────────────────────────────────────────────────────

void checkType(ref Ctx c, from FileId f, at TextSpan name) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    return if text == "_"
    let fixedName = toPascal(text)
    if fixedName != text {
        report(
            ref c,
            for: .typeCasing,
            from: f,
            at: name,
            by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
            help: $"rename it `{fixedName}`",
            hasFix: true,
            fixSpan: name,
            fixReplacement: fixedName,
        )
    }
}

/// An interface name is `I`, then an uppercase letter, then PascalCase (`IShape`).
void checkInterface(ref Ctx c, from FileId f, at TextSpan name) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    if text.length > 1 && text.bytes[0] == 0x49 && isUpperAscii(text.bytes[1]) {
        checkType(ref c, from: f, at: name)
        return
    }
    let fixedName = $"I{toPascal(text)}"
    report(
        ref c,
        for: .interfaceName,
        from: f,
        at: name,
        by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
        label: "an interface name",
        help: $"rename it to `{fixedName}`",
        hasFix: true,
        fixSpan: name,
        fixReplacement: fixedName,
    )
}

void checkValue(ref Ctx c, from FileId f, at TextSpan name) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    return if text == "_"
    let fixedName = toCamel(text)
    if fixedName != text {
        let help = isUpperAscii(text.bytes[0]) && fixedName.length > 0 ?
            $"rename it `{fixedName}`; only types are PascalCase":
        $"rename it `{fixedName}`"
        report(
            ref c,
            for: .valueCasing,
            from: f,
            at: name,
            by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
            help: help,
            hasFix: true,
            fixSpan: name,
            fixReplacement: fixedName,
        )
    }
}

/// Grammar rules on the members of `s` (spec §5.2, `docs/bayan-grammar.md`): BYN50xx are pattern contracts
/// on all code, BYN51xx word-class lints on the public API only (J84). Math vocabulary (J70) is exempt from
/// BYN5001 and BYN5014; typestate states are not members and are not checked.
void checkMembers(ref Ctx c, for StructId s) {
    let grammar = grammarOf(ref c)
    checkMembersWith(ref c, for: s, by: grammar)
}

/// `checkMembers` with the project dictionary already read.
void checkMembersWith(ref Ctx c, for StructId s, by in Grammar grammar) {
    buildLexicon(ref c)
    let f = c.structs[s].file
    let structPublic = c.structs[s].access == .publicKeyword
    for i in 0..c.structs[s].methods.length {
        let fn = c.structs[s].methods[i]
        let name = c.functions[fn].nameSpan
        let text = $"{c.functions[fn].name}"
        let isStatic = c.functions[fn].isStatic
        let isMutating = c.functions[fn].isMutating
        let ret = c.functions[fn].returnType
        let noArgs = !isStatic && c.functions[fn].parameters.length == 0
        let isPublic = structPublic && c.functions[fn].access == .publicKeyword
        if isMutating && !isBool(ret) {
            checkParticiple(ref c, by: grammar, from: f, at: name, for: text)
        }
        checkParticleName(ref c, for: s, from: f, at: name, by: text, isStatic: isStatic)
        checkWords(
            ref c,
            by: grammar,
            from: f,
            at: name,
            for: text,
            as: isMutating ? "verbs" : isBool(ret) ? "adjectives" : "nouns",
        )
        if noArgs && isMutating && isStateName(text) {
            report(
                ref c,
                for: .stateMemberMutates,
                from: f,
                at: name,
                by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
                label: "declared `ref this`",
                help: "remove `ref this` so it only reads, or name the action with a verb",
            )
        }
        if text.length > 3 && text.startsWith("try") && isUpperAscii(text.bytes[3]) {
            let target = $"{lowerAscii(text[3..4])}{text[4..text.length]}"
            var failing: FuncId = -1
            for m in c.structs[s].methods {
                if c.functions[m].hasFails && c.functions[m].name == target {
                    failing = m
                    break
                }
            }
            if failing >= 0 && kindOf(ret) != .optional && !isBool(ret) && !isError(ret) {
                let failingType = typeDisplay(ref c, by: c.functions[failing].returnType)
                let failingName = $"{c.functions[failing].name}"
                let shown = typeDisplay(ref c, by: ret)
                report(
                    ref c,
                    for: .tryWrongReturn,
                    from: f,
                    at: returnTypeSpan(ref c, for: fn),
                    by: (a0: text[3..text.length], a1: failingType, a2: failingName, a3: "", a4: ""),
                    label: $"returns `{shown}`",
                    help: $"change it to return `{failingType}?` or `bool`, or remove `{text}` and call `try {failingName}()`",
                )
            }
        }
        if isPublic && isMutating {
            let words = wordSpans(text)
            if words.length > 0 && isThingNoun(lowerAscii(words[0].text)) {
                report(
                    ref c,
                    for: .nounOnMutator,
                    from: f,
                    at: name,
                    by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
                    help: "rename it with the verb for what it does to `this`",
                )
            }
        }
        if isPublic && noArgs && !isMutating && isBool(ret) {
            checkBoolState(ref c, from: f, at: name, for: text)
        }
    }
    for i in 0..c.structs[s].properties.length {
        let p = c.structs[s].properties[i]
        let name = c.properties[p].nameSpan
        let text = $"{c.properties[p].name}"
        checkParticleName(ref c, for: s, from: f, at: name, by: text, isStatic: false)
        checkWords(
            ref c,
            by: grammar,
            from: f,
            at: name,
            for: text,
            as: isBool(c.properties[p].type) ? "adjectives" : "nouns",
        )
        if isBool(c.properties[p].type) && structPublic && c.properties[p].access == .publicKeyword {
            checkBoolState(ref c, from: f, at: name, for: text)
        }
    }
    // BYN5104 to BYN5107 do not check the standard library (Q1191; all four, user 2026-11-11).
    return if !structPublic || c.modules[c.structs[s].module].directory.startsWith("<std>/")
    for field in copyIds(in c.structs[s].fields) {
        continue if c.fields[field].access != .publicKeyword
            || t7MemberRenamed(ref c, from: f, at: c.fields[field].declIndex, by: c.fields[field].memberIndex)
        let name = c.fields[field].nameSpan
        let text = $"{c.fields[field].name}"
        let type = c.fields[field].type
        unless checkCount(ref c, by: grammar, from: f, at: name, for: text, as: type) {
            checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: type)
        }
    }
    for p in copyIds(in c.structs[s].properties) {
        continue if c.properties[p].access != .publicKeyword
            || t7MemberRenamed(ref c, from: f, at: c.properties[p].declIndex, by: c.properties[p].memberIndex)
        let name = c.properties[p].nameSpan
        let text = $"{c.properties[p].name}"
        let type = c.properties[p].type
        unless checkCount(ref c, by: grammar, from: f, at: name, for: text, as: type) {
            checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: type)
        }
    }
    for fn in copyIds(in c.structs[s].methods) {
        continue if c.functions[fn].access != .publicKeyword
        t7CheckParameters(ref c, by: grammar, from: f, for: fn)
    }
    var publicMethods = List<FuncId>()
    for fn in copyIds(in c.structs[s].methods) {
        if c.functions[fn].access == .publicKeyword {
            publicMethods.append(fn)
        }
    }
    var others = List<string>()
    for field in copyIds(in c.structs[s].fields) {
        if c.fields[field].access == .publicKeyword {
            others.append($"{c.fields[field].name}")
        }
    }
    for p in copyIds(in c.structs[s].properties) {
        if c.properties[p].access == .publicKeyword {
            others.append($"{c.properties[p].name}")
        }
    }
    checkDoer(
        ref c,
        by: grammar,
        from: f,
        for: c.structs[s].module,
        at: c.structs[s].declIndex,
        as: c.structs[s].nameSpan,
        through: move publicMethods,
        until: move others,
    )
}

/// Ports `Naming.CheckSignatures`: BYN5104 and BYN5105 on the rest of a module's public API, once top-level signatures
/// are declared: the parameters of public top-level functions, a public interface's getters and its methods' parameters,
/// and the payload fields of a public union or error set (the struct members are `checkMembers`'s).
void checkSignatures(ref Ctx c, for ModId module) {
    // The standard library is not checked (Q1191; user 2026-11-11), as in `checkMembersWith` and `checkDoer`.
    return if c.modules[module].directory.startsWith("<std>/")
    let grammar = grammarOf(ref c)
    buildLexicon(ref c)
    for fn in copyIds(in c.modules[module].allFunctions) {
        // coverage-exempt: Q1200 through `|| functionIsInstance`
        if c.functions[fn].kind != .function || c.functions[fn].owner >= 0 || c.functions[fn].iface >= 0
                || functionIsInstance(ref c, by: fn) || c.functions[fn].access != .publicKeyword {
            continue
        }
        t7CheckParameters(ref c, by: grammar, from: c.functions[fn].file, for: fn)
    }
    for i in copyIds(in c.modules[module].interfaces) {
        continue if c.interfaces[i].access != .publicKeyword
        let source = c.interfaces[i].file
        for member in t7InterfaceGetters(ref c, for: i) {
            continue if member.renamed
            var getter: FuncId = -1
            for g in c.interfaces[i].properties {
                if c.functions[g].nameSpan == member.name {
                    getter = g
                    break
                }
            }
            // coverage-exempt: Q1200
            continue if getter < 0
            let text = $"{getText(c.files[source].text.span, at: member.name)}"
            let type = c.functions[getter].returnType
            unless checkCount(ref c, by: grammar, from: source, at: member.name, for: text, as: type) {
                checkNumber(ref c, by: grammar, from: source, at: member.name, for: text, as: type)
            }
        }
        for fn in copyIds(in c.interfaces[i].methods) {
            t7CheckParameters(ref c, by: grammar, from: source, for: fn)
        }
        var getters = List<string>()
        for g in copyIds(in c.interfaces[i].properties) {
            getters.append($"{c.functions[g].name}")
        }
        checkDoer(
            ref c,
            by: grammar,
            from: source,
            for: c.interfaces[i].module,
            at: c.interfaces[i].declIndex,
            as: c.interfaces[i].nameSpan,
            through: copyIds(in c.interfaces[i].methods),
            until: move getters,
        )
    }
    for u in copyIds(in c.modules[module].unions) {
        continue if c.unions[u].access != .publicKeyword
        let source = c.unions[u].file
        for v in t7Payloads(ref c, from: source, at: c.unions[u].declIndex) {
            let declared = findUnionVariant(ref c, by: u, for: v.variant)
            // coverage-exempt: Q1200
            if declared >= 0 {
                checkPayload(
                    ref c,
                    by: grammar,
                    from: source,
                    at: v.fields,
                    for: copyIds(in c.unionVariants[declared].fields),
                )
            }
        }
    }
    for set in copyIds(in c.modules[module].errorSets) {
        continue if c.errorSets[set].access != .publicKeyword
        let source = c.errorSets[set].file
        for v in t7Payloads(ref c, from: source, at: c.errorSets[set].declIndex) {
            let declared = findErrorVariant(ref c, by: set, for: v.variant)
            // coverage-exempt: Q1200
            if declared >= 0 {
                checkPayload(
                    ref c,
                    by: grammar,
                    from: source,
                    at: v.fields,
                    for: copyIds(in c.errorVariants[declared].fields),
                )
            }
        }
    }
}

/// The `foreach (var p in fn.Parameters) if (p.Syntax is { } syntax) CheckNumber(…, syntax.Name, p.Type)` loop of
/// `Naming.CheckMembers` and `Naming.CheckSignatures`: the parameters with syntax are read from the tree in
/// `fn.parameters` order, as `checkParticles` reads them (Q552), and reported in `f`.
void t7CheckParameters(ref Ctx c, by Grammar grammar, from FileId f, for FuncId fn) {
    let facts = paramFacts(ref c, for: fn)
    let params = copyIds(in c.functions[fn].parameters)
    for k in 0..params.length {
        // coverage-exempt: Q1200
        break if k >= facts.length
        let name = facts[k].name
        let text = $"{getText(c.files[c.functions[fn].file].text.span, at: name)}"
        checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: c.locals[params[k]].type)
    }
}

/// One `GetterDecl` or `PropertyDecl` of an interface's `Decl.Members`: its name and whether `IsRenamed` holds.
struct T7Getter {
    TextSpan name
    bool     renamed = false
}

/// The getter and property members of interface `i`'s declaration, in member order. Ports the `foreach (var member in i.Decl.Members)` `GetterDecl`/`PropertyDecl` switch of `Naming.CheckSignatures`.
List<T7Getter> t7InterfaceGetters(ref Ctx c, for InterfaceId i) {
    var found = List<T7Getter>()
    let f = c.interfaces[i].file
    switch c.files[f].unit.members[c.interfaces[i].declIndex] {
        case .interfaceDecl(let n):
            for m in n.value.members {
                switch m {
                    case .getterDecl(let g):
                        found.append(
                            T7Getter {
                                name: g.value.name,
                                renamed: isRenamed(g.value.attributes, from: c.files[f].text.span),
                            },
                        )
                    case .propertyDecl(let p):
                        found.append(
                            T7Getter {
                                name: p.value.name,
                                renamed: isRenamed(p.value.attributes, from: c.files[f].text.span),
                            },
                        )
                    default:
                        continue
                }
            }
        default:
            // coverage-exempt: Q1200
            return found
    }
    return found
}

/// One variant of a union or error set declaration: its name and its payload fields' name spans.
struct T7Payload {
    string         variant
    List<TextSpan> fields = []
}

/// The variants of the `UnionDecl` or `ErrorEnumDecl` at `declIndex` of file `f`, in declaration order. Ports the `UnionDecl`/`ErrorEnumDecl` variant walk of `Naming.CheckSignatures`.
List<T7Payload> t7Payloads(ref Ctx c, from FileId f, at i64 declIndex) {
    var found = List<T7Payload>()
    switch c.files[f].unit.members[declIndex] {
        case .unionDecl(let n):
            for v in n.value.variants {
                var fields = List<TextSpan>()
                for field in v.fields {
                    fields.append(field.name)
                }
                found.append(T7Payload { variant: $"{getText(c.files[f].text.span, at: v.name)}", fields: move fields })
            }
        case .errorEnumDecl(let n):
            for v in n.value.variants {
                var fields = List<TextSpan>()
                for field in v.fields {
                    fields.append(field.name)
                }
                found.append(T7Payload { variant: $"{getText(c.files[f].text.span, at: v.name)}", fields: move fields })
            }
        default:
            // coverage-exempt: Q1200
            return found
    }
    return found
}

/// Ports `Naming.CheckPayload`: each payload field whose declared parameter has its name's span is checked,
/// BYN5105 first, then BYN5104.
void checkPayload(ref Ctx c, by Grammar grammar, from FileId f, at List<TextSpan> fields, for List<LocalId> declared) {
    for name in fields {
        var field: LocalId = -1
        for p in declared {
            if c.locals[p].nameSpan == name {
                field = p
                break
            }
        }
        // coverage-exempt: Q1200
        continue if field < 0
        let text = $"{getText(c.files[f].text.span, at: name)}"
        let type = c.locals[field].type
        unless checkCount(ref c, by: grammar, from: f, at: name, for: text, as: type) {
            checkNumber(ref c, by: grammar, from: f, at: name, for: text, as: type)
        }
    }
}

/// Ports `Naming.CheckDoer`: BYN5106 and BYN5107 on a public struct or interface named for a doer or a tool by its last
/// word (revision 0021 Part 4): a built-in doer (`doerVerb`), `codec` (`encode` or `decode`), or a project verb's regular
/// doer noun (`upsert` → `upserter`, `scan` → `scanner`). BYN5106: a public member, static or instance, is named its verb
/// or a derived form (`tryX`, `xInto`, `xOp`). BYN5107: a tool (`isTool`) has no public `ref this` member. Other "-er"
/// words (`Carrier`, `User`), function-type aliases and stored function fields are not types named for a doer here and
/// are not checked, nor is the standard library. `declIndex` is the declaration `IsRenamed` reads; every method in
/// `methods` has a declaration (`m.Decl is not null` holds: struct and interface methods are declared from a `FunctionDecl`).
void checkDoer(
    ref Ctx c,
    by Grammar grammar,
    from FileId f,
    for ModId module,
    at i64 declIndex,
    as TextSpan name,
    through List<FuncId> methods,
    until List<string> others
) {
    let text = $"{getText(c.files[f].text.span, at: name)}"
    // The standard library is not checked (Q1191): `std.json`'s `JsonReader` reads with `next`.
    return if c.modules[module].directory.startsWith("<std>/")
        || t8DeclRenamed(ref c, from: f, at: declIndex)
        || !isAllAscii(text)
    let words = wordSpans(text)
    return if words.length == 0
    let noun = lowerAscii(words[words.length - 1].text)
    var verbs = List<string>()
    if noun == "codec" {
        verbs.append("encode")
        verbs.append("decode")
    } else if (doerVerb(noun) is { } verb) {
        verbs.append(verb)
    } else {
        var matches = List<string>()
        for v in grammar.verbs {
            if listContainsString(doerNouns(v), by: noun) {
                matches.append(v)
            }
        }
        t11SortOrdinal(ref matches)
        if matches.length > 0 {
            verbs.append(matches[0])
        }
    }
    return if verbs.length == 0
    var acted = false
    for m in methods {
        for v in verbs {
            if actsAs(c.functions[m].name, for: v) {
                acted = true
            }
        }
    }
    for m in others {
        for v in verbs {
            if actsAs(m, for: v) {
                acted = true
            }
        }
    }
    unless acted {
        var named = StrBuf()
        for k in 0..verbs.length {
            if k > 0 {
                named.append(" or ")
            }
            named.append($"`{verbs[k]}`")
        }
        report(
            ref c,
            for: .doerWithoutVerb,
            from: f,
            at: name,
            by: (a0: text, a1: verbs[0], a2: "", a3: "", a4: ""),
            help: $"add a member named {named.finish()}, or rename the type for what it is",
        )
    }
    unless isTool(noun) {
        return
    }
    for m in methods {
        if c.functions[m].isMutating {
            report(
                ref c,
                for: .instrumentChangesThis,
                from: f,
                at: c.functions[m].nameSpan,
                by: (a0: text, a1: $"{c.functions[m].name}", a2: "", a3: "", a4: ""),
                help: "remove `ref this` and keep fixed settings in fields, or rename the type as a doer if it is fed data step by step",
            )
        }
    }
}

/// The local `Acts` of `Naming.CheckDoer` for one verb `v`: `m` is `v`, `tryV`, `vInto` or `vOp`.
bool actsAs(string m, for string v) =>
    m == v || m == $"try{upperAscii(v[0..1])}{v[1..v.length]}" || m == $"{v}Into" || m == $"{v}Op"

/// `IsRenamed(decl)` for `CheckDoer`: the struct or interface declaration at `declIndex` of file `f`. A `type distinct`'s
/// struct is declared from its alias here; its C# `StructDecl` is built without attributes, so it is not renamed.
bool t8DeclRenamed(ref Ctx c, from FileId f, at i64 declIndex) {
    switch c.files[f].unit.members[declIndex] {
        case .structDecl(let n):
            return isRenamed(n.value.attributes, from: c.files[f].text.span)
        case .interfaceDecl(let n):
            return isRenamed(n.value.attributes, from: c.files[f].text.span)
        default:
            return false
    }
}

/// Ports `Naming.Doers`: the built-in doer and tool nouns and their verbs (revision 0021 Part 4); `codec` is `checkDoer`'s.
string? doerVerb(string noun) => noun switch {
    "parser"    => "parse",
    "builder"   => "build",
    "reader"    => "read",
    "writer"    => "write",
    "recorder"  => "record",
    "encoder"   => "encode",
    "decoder"   => "decode",
    "scanner"   => "scan",
    "loader"    => "load",
    "scheduler" => "schedule",
    "renderer"  => "render",
    "formatter" => "format",
    "handler"   => "handle",
    "hasher"    => "hash",
    "comparer"  => "compare",
    _           => null,
}

/// Ports `Naming.Tools`: the tool nouns of BYN5107: a tool keeps fixed settings and does not change `this`.
bool isTool(string noun) => noun switch {
    "hasher" or "comparer" or "codec" => true,
    _ => false,
}

/// Ports `Naming.DoerNouns`: a verb's doer noun by regular spelling: `-er`, `-r` after `e`, `-ier` after a consonant and
/// `y`, and a doubled final consonant (`scanner`).
List<string> doerNouns(string verb) {
    var nouns = List<string>()
    let n = verb.length
    return nouns if n < 2
    let last = verb.bytes[n - 1]
    if last == 0x65 {
        nouns.append($"{verb}r")
        return nouns
    }
    if last == 0x79 && !isVowel(verb.bytes[n - 2]) {
        nouns.append($"{verb[0..n - 1]}ier")
        return nouns
    }
    nouns.append($"{verb}er")
    if !isVowel(last) && last != 0x77 && last != 0x78 && last != 0x79 && isVowel(verb.bytes[n - 2]) {
        nouns.append($"{verb}{verb[n - 1..n]}er")
    }
    return nouns
}

/// Ports `Naming.IsRenamed`: a name under a rename attribute (`@json(name: …)`, `@column(…)`) is forced from outside
/// and exempt from BYN5104 and BYN5105 (grammar guide §1). `text` is the source the attribute names are read from.
bool isRenamed(List<parser.AttributeSyntax> attributes, from ReadOnlySpan<u8> text) {
    for a in attributes {
        let name = getText(text, at: a.name)
        return true if name is "json" or "column"
    }
    return false
}

/// `IsRenamed(f.Decl)` for a struct field or property: the `FieldDecl` or `PropertyDecl` at `memberIndex` of the
/// struct declaration at `declIndex`. A `type distinct`'s `value` field has no member (`memberIndex` -1), as its C#
/// `FieldDecl` is built without attributes.
bool t7MemberRenamed(ref Ctx c, from FileId f, at i64 declIndex, by i64 memberIndex) {
    return false if memberIndex < 0
    switch c.files[f].unit.members[declIndex] {
        case .structDecl(let n):
            switch n.value.members[memberIndex] {
                case .fieldDecl(let d):
                    return isRenamed(d.value.attributes, from: c.files[f].text.span)
                case .propertyDecl(let d):
                    return isRenamed(d.value.attributes, from: c.files[f].text.span)
                default:
                    // coverage-exempt: Q1200
                    return false
            }
        default:
            // coverage-exempt: Q1200
            return false
    }
}

/// Ports the local `IsLink` of `Naming.CheckNumber`: a particle or function word ends the head noun.
bool isLink(string w) => isParticleWord(lowerAscii(w)) || isFunctionWord(lowerAscii(w))

/// Ports `Naming.CheckNumber`. BYN5104: a collection (`List`, `Map`, spans, arrays, text views; `Untrusted`, `Owned`
/// and `?` looked through) is named with a plural or a collective, anything else with a singular; the last word decides
/// (revision 0021 Part 4), or the word before the first particle or function word. A `bool` is a state, not a noun,
/// and a type parameter may be either; neither is checked. A collection is reported only when its last word is a
/// known noun, so the plural in the message is always known; a number is never reported as plural.
void checkNumber(ref Ctx c, by Grammar grammar, from FileId f, at TextSpan name, for string text, as Type type) {
    return if isBool(type) || kindOf(type) == .typeParam || kindOf(type) == .error || text == "_" || !isAllAscii(text)
    let spans = wordSpans(text)
    return if spans.length == 0
    // A particle or function word ends the head noun: `modulesByDir` is decided by `modules`; `byPath` and `inGroup` by none.
    return if isLink(spans[0].text)
    var head: i64 = -1
    for k in 1..spans.length {
        if isLink(spans[k].text) {
            head = k
            break
        }
    }
    let at = head < 0 ? spans.length - 1 : head - 1
    let start = spans[at].start
    let headText = spans[at].text
    let word = lowerAscii(headText)
    return if listContainsString(c.lexiconCollectives, by: word) || listContainsString(grammar.collectives, by: word)
    var inner = type
    while kindOf(inner) == .untrusted || kindOf(inner) == .owned || kindOf(inner) == .optional {
        inner = kindOf(inner) == .untrusted ? c.untrustedTypes[typeIndex(inner)]
            : kindOf(inner) == .owned ? c.ownedTypes[typeIndex(inner)] : c.optionalTypes[typeIndex(inner)]
    }
    let kind = kindOf(inner)
    // coverage-exempt: Q1200
    if kind is .list or .map or .span or .array or .textView {
        // Only a noun has a plural: `covered`, `distinct` and `byKey` name a collection by what it holds or how it is keyed.
        return if looksPlural(ref c, for: word, by: grammar) || !isNoun(ref c, for: word, by: grammar)
        let pluralName = $"{text[0..start]}{matchCase(headText, as: plural(ref c, for: word, by: grammar))}{text[start + headText.length..text.length]}"
        report(
            ref c,
            for: .numberAgreement,
            from: f,
            at: name,
            by: (a0: text, a1: pluralName, a2: "", a3: "", a4: ""),
            help: $"rename it `{pluralName}`",
            hasFix: true,
            fixSpan: name,
            fixReplacement: pluralName,
        )
    } else if !isNumeric(inner)
            && !isString(inner)
            && isPlural(ref c, for: word, by: grammar)
            && !namesItsType(ref c, for: word, as: inner) {
        // A number named with a plural is a quantity in units (`cents`, `grams`); a count is BYN5105's. A string is one text
        // that may describe several things (`errors`), and a name that repeats its type's last word (`Keywords keywords`) is
        // named for its type (Q1190).
        let display = typeDisplay(ref c, by: type)
        if (singular(ref c, for: word, by: grammar) is { } one) {
            let singularName = $"{text[0..start]}{matchCase(headText, as: one)}{text[start + headText.length..text.length]}"
            report(
                ref c,
                for: .numberAgreementOne,
                from: f,
                at: name,
                by: (a0: text, a1: display, a2: "", a3: "", a4: ""),
                help: $"rename it `{singularName}`",
                hasFix: true,
                fixSpan: name,
                fixReplacement: singularName,
            )
        } else {
            report(
                ref c,
                for: .numberAgreementOne,
                from: f,
                at: name,
                by: (a0: text, a1: display, a2: "", a3: "", a4: ""),
            )
        }
    }
}

/// Ports `Naming.NamesItsType`: the last word of `type`'s name (before any `<`) is `word`, case aside: `CompilationOptions options`.
bool namesItsType(ref Ctx c, for string word, as Type type) {
    let display = typeDisplay(ref c, by: type)
    var cut = display.length
    for i in 0..display.length {
        if display.bytes[i] == 0x3C {
            cut = i
            break
        }
    }
    let words = wordSpans(display[0..cut])
    return words.length > 0 && lowerAscii(words[words.length - 1].text) == lowerAscii(word)
}

/// Ports `Naming.CheckCount`. BYN5105: an integer that counts items is singular noun + `Count`; `<plural>Count`,
/// `num<Plural>` and `numberOf<Plural>` are renamed (revision 0021 Part 4). `length` is not a count name. True when it
/// reports, so BYN5104 does not report the name again.
bool checkCount(ref Ctx c, by Grammar grammar, from FileId f, at TextSpan name, for string text, as Type type) {
    return false if !isInteger(type) || !isAllAscii(text)
    var words = List<string>()
    for w in wordSpans(text) {
        words.append(w.text)
    }
    var counted = List<string>()
    let n = words.length
    if n > 1 && words[n - 1] == "Count" {
        for k in 0..n - 1 {
            counted.append(words[k])
        }
    } else if n > 1 && words[0] == "num" {
        for k in 1..n {
            counted.append(words[k])
        }
    } else if n > 2 && words[0] == "number" && words[1] == "Of" {
        for k in 2..n {
            counted.append(words[k])
        }
    }
    return false if counted.length == 0
    let last = lowerAscii(counted[counted.length - 1])
    unless isPlural(ref c, for: last, by: grammar) {
        return false
    }
    let one = singular(ref c, for: last, by: grammar) ?? return false
    var head = StrBuf()
    for k in 0..counted.length - 1 {
        head.append(counted[k])
    }
    let headText = $"{head.finish()}"
    let fixedName = headText.length == 0 ? $"{one}Count"
        : $"{lowerAscii(headText[0..1])}{headText[1..headText.length]}{matchCase(counted[counted.length - 1], as: one)}Count"
    report(
        ref c,
        for: .countName,
        from: f,
        at: name,
        by: (a0: text, a1: fixedName, a2: "", a3: "", a4: ""),
        help: $"rename it `{fixedName}`",
        hasFix: true,
        fixSpan: name,
        fixReplacement: fixedName,
    )
    return true
}

/// Ports `Naming.IsPlural`: a plural the checker knows: an irregular plural, a project noun's `forms` entry (not a
/// verb's, Q1207), or a regular plural of a known noun.
bool isPlural(ref Ctx c, for string word, by Grammar grammar) {
    return true if listContainsString(c.lexiconIrregularPlurals, by: word)
    return singular(ref c, for: word, by: grammar) is not null
}

/// Ports `Naming.LooksPlural`: a word that may be a plural, for a collection's name: `isPlural`, or any word ending
/// in `s` but `ss`, `us` or `is`.
bool looksPlural(ref Ctx c, for string word, by Grammar grammar) =>
    isPlural(ref c, for: word, by: grammar)
    || word.endsWith("s") && !word.endsWith("ss") && !word.endsWith("us") && !word.endsWith("is")

/// Ports `Naming.Singular`: the singular of `word`: the project noun whose `forms` entry it is, else an irregular
/// plural's singular (`Lexicon.IrregularSingulars`), else the first regular base (`-ies`, `-es`, `-s` of the `Endings`
/// table) that is a known noun; null when none is known.
string? singular(ref Ctx c, for string word, by Grammar grammar) {
    for (key, form) in grammar.forms {
        return key if form == word && isNoun(ref c, for: key, by: grammar)
    }
    for k in 0..c.lexiconIrregularPlurals.length {
        return c.lexiconIrregularSingulars[k] if c.lexiconIrregularPlurals[k] == word
    }
    return null if word.endsWith("ss") || word.endsWith("us") || word.endsWith("is")
    let endings: List<string> = ["ies", "es", "s"]
    for ending in endings {
        continue if word.length <= ending.length + 1 || !word.endsWith(ending)
        let bare = word[0..word.length - ending.length]
        for r in endingReplacements(ending) {
            let candidate = $"{bare}{r}"
            return candidate if isNoun(ref c, for: candidate, by: grammar)
        }
    }
    return null
}

/// Ports `Naming.Plural`: the plural of `word`: a project noun's `forms` entry, else the irregular plural whose
/// singular it is (`Lexicon.IrregularSingulars`), else the regular spelling (`-s`, `-es`, `-ies`).
string plural(ref Ctx c, for string word, by Grammar grammar) {
    // coverage-exempt: Q1200
    if isNoun(ref c, for: word, by: grammar) {
        if (grammar.forms.tryGet(at: word) is { } form) {
            return form
        }
    }
    for k in 0..c.lexiconIrregularSingulars.length {
        return c.lexiconIrregularPlurals[k] if c.lexiconIrregularSingulars[k] == word
    }
    let n = word.length
    return $"{word[0..n - 1]}ies" if n > 1 && word.bytes[n - 1] == 0x79 && !isVowel(word.bytes[n - 2])
    return $"{word}es" if word.endsWith("s")
        || word.endsWith("x")
        || word.endsWith("z")
        || word.endsWith("ch")
        || word.endsWith("sh")
    return $"{word}s"
}

/// Ports `Naming.IsNoun`.
bool isNoun(ref Ctx c, for string word, by Grammar grammar) =>
    listContainsString(c.lexiconNouns, by: word) || listContainsString(grammar.nouns, by: word)

/// Ports `Naming.IsVerb`.
bool isVerb(ref Ctx c, for string word, by Grammar grammar) =>
    listContainsString(c.lexiconVerbs, by: word) || listContainsString(grammar.verbs, by: word)

/// Ports `Naming.MatchCase`: `word` spelled with the first letter's case of `like`: `Line`, `lines` → `Lines`; there is no all-caps branch, because spec §5.1 keeps only a two-letter acronym uppercase, so `URLS` would fail BYN2009 (`URL`, `urls` → `Urls`).
string matchCase(string like, as string word) {
    return word if word.length == 0 || !isUpperAscii(like.bytes[0])
    return $"{upperAscii(word[0..1])}{word[1..word.length]}"
}

/// BYN5001: an `-ed` name is a changed copy or a view, so a member that takes `ref this` is a plain verb (revision 0005).
void checkParticiple(ref Ctx c, by in Grammar grammar, from FileId f, at TextSpan name, for string text) {
    var stems = List<string>()
    // A form is read by its word's class: the -ed spelling for a verb only, the plural for a noun (revision 0021 Part 3).
    for (word, form) in grammar.forms {
        if form == text && isVerb(ref c, for: word, by: grammar) {
            stems.append(word)
        }
    }
    if stems.length == 0 {
        stems = participleStems(text)
    }
    return if stems.length == 0
    var stem = stems[0]
    for w in stems {
        if isVerb(ref c, for: w, by: grammar) {
            stem = w
            break
        }
    }
    report(
        ref c,
        for: .participleChangesThis,
        from: f,
        at: name,
        by: (a0: text, a1: stem, a2: "", a3: "", a4: ""),
        help: "name the member that changes `this` with the plain verb, and keep `-ed` for the copy or view",
    )
}

/// BYN5009: a particle is not a member name, and no instance member spells a conversion with `to` or `as`:
/// a view is a noun (`asSpan` → `span`), a conversion is `T(x)` (`toList` → `List(x)`).
void checkParticleName(ref Ctx c, for StructId s, from FileId f, at TextSpan name, by string text, bool isStatic) {
    if isParticleWord(text) {
        report(
            ref c,
            for: .particleAsMemberName,
            from: f,
            at: name,
            by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
            help: "rename the member, for example `tryGet(at:)` instead of `at(…)`",
        )
        return
    }
    return if isStatic
    let words = wordSpans(text)
    return if words.length < 2
    let particle = words[0].text
    return if (particle != "to" && particle != "as") || !isUpperAscii(words[1].text.bytes[0])
    let rest = text[particle.length..text.length]
    let lowered = lowerAscii(rest)
    let instead = particle == "as" ?
        $"{lowerAscii(rest[0..1])}{rest[1..rest.length]}":
    $"{isPrimitiveWord(lowered) ? lowered : rest}({toCamel(c.structs[s].name)})"
    report(
        ref c,
        for: .conversionMember,
        from: f,
        at: name,
        by: (a0: text, a1: particle, a2: instead, a3: "", a4: ""),
        help: "use a view noun, `copy()`, or a `T(x)` conversion",
    )
}

/// The primitive type names a `toX` conversion is written in lowercase: `toString` → `string(x)`.
bool isPrimitiveWord(string w) => w switch {
    "string" or "bool" or "rune" or "i8" or "i16" or "i32" or "i64" or "u8" or "u16" or "u32" or "u64" or "f32" or
        "f64" or "sbyte" or "byte" or "short" or "ushort" or "int" or "uint" or "long" or "ulong" or "float" or
        "double" => true,
    _ => false,
}

/// BYN5014: every word of a member name is a word the checker knows, from the lexicon or the project's
/// `grammar` (J85), directly or by a regular ending (`bases`). Names with letters outside ASCII, single
/// letters and math names are not checked. The help offers the three classes, the best guess first: `guess` is
/// `verbs` for a member that changes `this`, `adjectives` for a `bool` member, else `nouns`.
void checkWords(ref Ctx c, by in Grammar grammar, from FileId f, at TextSpan name, for string text, as string guess) {
    return if isMathWord(text) || !isAllAscii(text)
    for w in wordSpans(text) {
        let word = trimDigits(lowerAscii(w.text))
        continue if word.length < 2 || !isAllLowerLetters(word) || isMathWord(lowerAscii(w.text))
        continue if isKnown(ref c, for: word, by: grammar)
        report(
            ref c,
            for: .unknownWord,
            from: f,
            at: TextSpan { start: name.start + w.start, length: w.text.length },
            by: (a0: word, a1: "", a2: "", a3: "", a4: ""),
            help: $"add it to `grammar` in package.byn: {offer(guess, for: word)}, {offer(guess == "verbs" ? "nouns" : "verbs", for: word)} or {offer(guess == "adjectives" ? "nouns" : "adjectives", for: word)}",
        )
    }
}

/// Ports `Naming.Offer`.
string offer(string field, for string word) => $"`{field}: [\"{word}\"]`"

bool isKnown(ref Ctx c, for string word, by in Grammar grammar) {
    return true if isListed(ref c, for: word, by: grammar)
    for (_, form) in grammar.forms {
        return true if form == word
    }
    for b in bases(word) {
        return true if isListed(ref c, for: b, by: grammar)
    }
    return false
}

bool isListed(ref Ctx c, for string w, by in Grammar grammar) =>
    listContainsString(c.lexiconVerbs, by: w)
    || listContainsString(c.lexiconNouns, by: w)
    || listContainsString(c.lexiconAdjectives, by: w)
    || listContainsString(c.lexiconCollectives, by: w) || listContainsString(c.lexiconIrregularPlurals, by: w)
    || isParticleWord(w) || isFunctionWord(w)
    || listContainsString(grammar.verbs, by: w)
    || listContainsString(grammar.nouns, by: w)
    || listContainsString(grammar.adjectives, by: w)
    || listContainsString(grammar.collectives, by: w)

/// The words `word` may be a regular form of: plurals and third person (`-s`, `-es`, `-ies`), `-ed`, `-ing`,
/// doers (`-er`, `-or`), `-est`, `-ly`, and `un-`/`re-`; a doubled final consonant is undone (`runner` → `run`).
List<string> bases(string word) {
    var found = List<string>()
    let endings: List<string> = ["ies", "es", "s", "ied", "ed", "ing", "ier", "er", "ers", "or", "est", "ly"]
    for ending in endings {
        continue if word.length <= ending.length + 1 || !word.endsWith(ending)
        let bare = word[0..word.length - ending.length]
        for r in endingReplacements(ending) {
            found.append($"{bare}{r}")
        }
        if bare.length >= 3 && bare.bytes[bare.length - 1] == bare.bytes[bare.length - 2] {
            found.append(bare[0..bare.length - 1])
        }
        if ending == "ers" {
            let more = bases(word[0..word.length - 1])
            for b in more {
                found.append(b)
            }
        }
    }
    let prefixes: List<string> = ["un", "re"]
    for prefix in prefixes {
        continue if word.length <= prefix.length + 2 || !word.startsWith(prefix)
        let stripped = word[prefix.length..word.length]
        found.append(stripped)
        let more = bases(stripped)
        for b in more {
            found.append(b)
        }
    }
    return found
}

/// What replaces each ending of `bases`, in the C# `Endings` table's order.
List<string> endingReplacements(string ending) => ending switch {
    "ies" or "ied" or "ier" => ["y"],
    "s" or "ly" => [""],
    "ers"       => [],
    _           => ["", "e"],
}

/// Naming.cs:187 GrammarOf: the project dictionary from `package.byn` beside the package's sources (`displayRoot`),
/// lowered; empty without one. Read once per compilation and kept in `c.grammarRead`, as the C# caches it (a copy is returned: `Grammar` is unique).
Grammar grammarOf(ref Ctx c) {
    if !c.grammarKnown {
        c.grammarRead = readGrammar(ref c)
        c.grammarKnown = true
    }
    return lowerGrammar(in c.grammarRead)
}

Grammar readGrammar(ref Ctx c) {
    let path = t11Combine(c.displayRoot, by: "package.byn")
    // `File.Exists(path) ? Manifest.Read(path)`: a directory or a missing path is no file; a file that exists but cannot
    // be read is an empty grammar too (user 2026-11-11; Q565: an unreadable manifest reads as an empty one).
    return Grammar {} if t11DirectoryExists(path)
    let bytes = Io.readFile(path) catch switch {
        IoError e => return Grammar {},
    }
    let manifest = manifestParse(lexer.SourceText.create("package.byn", from: move bytes))
    return lowerGrammar(in manifest.grammar)
}

/// The index of the file the loader read as `"package.byn"`, or -1.
i64 packageFileIndex(in List<SourceFile> files) {
    for i in 0..files.length {
        return i if files[i].displayPath == "package.byn"
    }
    return -1
}

/// `grammar` with every word and form in lowercase.
Grammar lowerGrammar(in Grammar grammar) {
    var lower = Grammar {}
    for w in grammar.verbs {
        lower.verbs.append(lowerAscii(w))
    }
    for w in grammar.nouns {
        lower.nouns.append(lowerAscii(w))
    }
    for w in grammar.adjectives {
        lower.adjectives.append(lowerAscii(w))
    }
    for w in grammar.collectives {
        lower.collectives.append(lowerAscii(w))
    }
    for (word, form) in grammar.forms {
        lower.forms[lowerAscii(word)] = lowerAscii(form)
    }
    return lower
}

void checkBoolState(ref Ctx c, from FileId f, at TextSpan name, for string text) {
    if isStateName(text) || text.startsWith("contains") || text.startsWith("equals") || text.startsWith("matches")
            || text.startsWith("startsWith") || text.startsWith("endsWith") || text.startsWith("try") {
        return
    }
    let fixedName = $"is{upperAscii(text[0..1])}{text[1..text.length]}"
    report(
        ref c,
        for: .boolWithoutPrefix,
        from: f,
        at: name,
        by: (a0: text, a1: "", a2: "", a3: "", a4: ""),
        help: $"rename it `{fixedName}`",
        hasFix: true,
        fixSpan: name,
        fixReplacement: fixedName,
    )
}

/// `isX`, `hasX`, `canX`: the prefix, then a capital.
bool isStateName(string name) =>
    statePrefixed(name, by: "is") || statePrefixed(name, by: "has") || statePrefixed(name, by: "can")

bool statePrefixed(string name, by string prefix) =>
    name.length > prefix.length && name.startsWith(prefix) && isUpperAscii(name.bytes[prefix.length])

/// The verbs `name` may be the `-ed` form of, most likely first; empty when it is not a participle. Only a
/// single lowercase word ending in `-ed` counts: `sorted` → sort, `reversed` → reverse, `trimmed` → trim,
/// `copied` → copy. Words ending in `-eed`, words shorter than five letters and `isNotParticiple` are not.
List<string> participleStems(string name) {
    var stems = List<string>()
    return stems if name.length < 5
        || !name.endsWith("ed")
        || name.endsWith("eed")
        || !isAllLowerLetters(name)
        || isNotParticiple(name)
    let bare = name[0..name.length - 2]
    let n = bare.length
    let last = bare.bytes[n - 1]
    let prev = bare.bytes[n - 2]
    if last == 0x69 {
        stems.append($"{bare[0..n - 1]}y")
    }
    if n >= 4 && last == prev && !isVowel(last) && last != 0x6C && last != 0x73 {
        stems.append(bare[0..n - 1])
    }
    // `reversed`, `parsed`, `doubled`, `named` drop only the `d`; `sorted`, `joined` drop `ed`.
    let keepsE = last == 0x63 || last == 0x75 || last == 0x76 || last == 0x7A
        || (last == 0x73 && prev != 0x73) || (last == 0x6C && !isVowel(prev) && prev != 0x6C)
        || (n == 3 && !isVowel(bare.bytes[0]) && isVowel(bare.bytes[1]) && !isVowel(bare.bytes[2])
            && bare.bytes[2] != 0x77 && bare.bytes[2] != 0x78 && bare.bytes[2] != 0x79)
    let dropD = name[0..name.length - 1]
    if keepsE {
        stems.append(dropD)
        stems.append(bare)
    } else {
        stems.append(bare)
        stems.append(dropD)
    }
    return stems
}

bool isVowel(u8 b) => b is 0x61 or 0x65 or 0x69 or 0x6F or 0x75

/// Common words ending in `-ed` that are not the `-ed` form of a verb.
bool isNotParticiple(string w) => w switch {
    "hundred" or "embed" or "shred" or "naked" or "wicked" or "sacred" or "kindred" => true,
    _ => false,
}

/// The first word of a `ref this` member that names a thing, not an action (BYN5101).
bool isThingNoun(string w) => w switch {
    "size" or "length" or "total" or "sum" or "value" or "values" or "data" or "item" or "items" or "element" or
        "elements" or "result" or "results" or "name" or "id" or "state" or "status" or "info" or "content" or
        "contents" or "capacity" or "amount" or "number" or "key" or "keys" or "entry" or "entries" or "node" or
        "nodes" => true,
    _ => false,
}

string toPascal(string name) {
    let words = wordSpans(name)
    return name if words.length == 0
    var sb = StrBuf()
    for w in words {
        sb.append(capitalize(w.text))
    }
    return $"{sb.finish()}"
}

string toCamel(string name) {
    let words = wordSpans(name)
    return name if words.length == 0
    var sb = StrBuf()
    sb.append(lowerAscii(words[0].text))
    for i in 1..words.length {
        sb.append(capitalize(words[i].text))
    }
    return $"{sb.finish()}"
}

/// Two-letter acronyms stay uppercase (`IO`); other words are capitalized.
string capitalize(string word) {
    return word if word.length == 0
    return word if word.length == 2 && isUpperAscii(word.bytes[0]) && isUpperAscii(word.bytes[1])
    var bytes = List<u8>()
    for i in 0..word.length {
        let b = word.bytes[i]
        if i == 0 && isLowerAscii(b) {
            bytes.append(b - 32)
        } else if i > 0 && isUpperAscii(b) {
            bytes.append(b + 32)
        } else {
            bytes.append(b)
        }
    }
    return $"{utf8(bytes.span)}"
}

/// One word of a name and its byte offset in the name.
struct WordSpan {
    i64    start
    string text
}

/// Splits at underscores and case changes: `HTTPClient` → HTTP, Client; `parse_url` → parse, url;
/// `IOError` → IO, Error. Uncased letters and digits stay with the word they follow.
List<WordSpan> wordSpans(string name) {
    var words = List<WordSpan>()
    var start: i64 = 0
    var length: i64 = 0
    let n = name.length
    for i in 0..n {
        let ch = name.bytes[i]
        if ch == 0x5F {
            if length > 0 {
                words.append(WordSpan { start: start, text: name[start..start + length] })
            }
            length = 0
            continue
        }
        if isUpperAscii(ch) && length > 0 {
            let prev = name.bytes[i - 1]
            let nextIsLower = i + 1 < n && isLowerAscii(name.bytes[i + 1])
            if isLowerAscii(prev) || isDigitAscii(prev) || (isUpperAscii(prev) && nextIsLower) {
                words.append(WordSpan { start: start, text: name[start..start + length] })
                length = 0
            }
        }
        if length == 0 {
            start = i
        }
        length += 1
    }
    if length > 0 {
        words.append(WordSpan { start: start, text: name[start..start + length] })
    }
    return words
}

bool isUpperAscii(u8 b) => b is 0x41..=0x5A

bool isLowerAscii(u8 b) => b is 0x61..=0x7A

bool isDigitAscii(u8 b) => b is 0x30..=0x39

string lowerAscii(string s) {
    var bytes = List<u8>()
    for b in s.bytes {
        if isUpperAscii(b) {
            bytes.append(b + 32)
        } else {
            bytes.append(b)
        }
    }
    return $"{utf8(bytes.span)}"
}

string upperAscii(string s) {
    var bytes = List<u8>()
    for b in s.bytes {
        if isLowerAscii(b) {
            bytes.append(b - 32)
        } else {
            bytes.append(b)
        }
    }
    return $"{utf8(bytes.span)}"
}

bool isAllAscii(string s) {
    for b in s.bytes {
        return false if b >= 0x80
    }
    return true
}

bool isAllLowerLetters(string s) {
    for b in s.bytes {
        unless isLowerAscii(b) {
            return false
        }
    }
    return true
}

/// `s` without its trailing digits.
string trimDigits(string s) {
    var n = s.length
    while n > 0 && isDigitAscii(s.bytes[n - 1]) {
        n -= 1
    }
    return s[0..n]
}

/// The span of `fn`'s declared return type, read from the tree through its `declIndex`/`memberIndex`.
TextSpan returnTypeSpan(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    return c.functions[fn].nameSpan if f < 0 || d < 0
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n):
            return typeSyntaxSpan(in n.value.returnType)
        case .structDecl(let n):
            return memberReturnSpan(in n.value.members, at: m)
        case .interfaceDecl(let n):
            return memberReturnSpan(in n.value.members, at: m)
        case .extensionDecl(let n):
            return memberReturnSpan(in n.value.members, at: m)
        default:
            return c.functions[fn].nameSpan
    }
}

TextSpan memberReturnSpan(in List<parser.Decl> members, at i64 m) {
    return TextSpan { start: 0, length: 0 } if m < 0 || m >= members.length
    switch members[m] {
        case .functionDecl(let n):
            return typeSyntaxSpan(in n.value.returnType)
        default:
            return TextSpan { start: 0, length: 0 }
    }
}

TextSpan typeSyntaxSpan(in parser.TypeSyntax t) => t switch {
    .namedType(let n)          => n.value.span,
    .optionalType(let n)       => n.value.span,
    .arrayType(let n)          => n.value.span,
    .tupleType(let n)          => n.value.span,
    .functionTypeSyntax(let n) => n.value.span,
    .dynType(let n)            => n.value.span,
    .refinedType(let n)        => n.value.span,
    .pointerType(let n)        => n.value.span,
    .none                      => TextSpan { start: 0, length: 0 },
}

// ── Particles.cs ─────────────────────────────────────────────────────────────

/// The particle rule at a declaration (spec §10): one unlabeled required parameter, the object; every other
/// takes a particle (BYN5004, BYN5006); a particle appears once (BYN5013). The receiver is not a parameter
/// here, and a `bool` parameter is passed by name, so neither counts. The parameters are read from the tree
/// through `fn`'s `declIndex`/`memberIndex`, in `fn.parameters` order (Q552). Exempt: `extern` declarations
/// and a `rest` tail, which takes no label (J39).
void checkParticles(ref Ctx c, from FileId f, for FuncId fn) {
    return if c.functions[fn].template >= 0 || (c.functions[fn].modifiers & 128) != 0
    let params = paramFacts(ref c, for: fn)
    let fnName = $"{c.functions[fn].name}"
    var seen = List<string>()
    for p in params {
        if (p.particle is { } particle) {
            let text = $"{getText(c.files[f].text.span, at: particle)}"
            if listContainsString(seen, by: text) {
                report(
                    ref c,
                    for: .repeatedParticle,
                    from: f,
                    at: particle,
                    by: (a0: fnName, a1: text, a2: "", a3: "", a4: ""),
                    label: "used again",
                    help: "group the values in a struct, or choose another particle",
                )
            } else {
                seen.append(text)
            }
        }
    }
    var unlabeled = List<i64>()
    for i in 0..params.length {
        let isBoolParam = i < c.functions[fn].parameters.length && isBool(c.locals[c.functions[fn].parameters[i]].type)
        if params[i].isPlain && !isBoolParam {
            unlabeled.append(i)
        }
    }
    return if unlabeled.length < 2
    let name = c.functions[fn].kind == .constructor ? $"{c.structs[c.functions[fn].owner].name}" : fnName
    report(
        ref c,
        for: .particleRequired,
        from: f,
        at: c.functions[fn].nameSpan,
        by: (a0: name, a1: $"{unlabeled.length}", a2: "", a3: "", a4: ""),
        label: $"{unlabeled.length} unlabeled parameters",
        help: "keep one unlabeled parameter, the object",
    )
    for k in 1..unlabeled.length {
        let at = params[unlabeled[k]].name
        let paramName = $"{getText(c.files[f].text.span, at: at)}"
        report(
            ref c,
            for: .parameterNeedsParticle,
            from: f,
            at: at,
            by: (a0: paramName, a1: "", a2: "", a3: "", a4: ""),
            label: "needs a particle",
            help: "label it with `from`, `to`, `until`, `through`, `at`, `by`, `for` or `as`",
        )
    }
}

/// What the particle rule reads of one parameter's syntax.
struct ParamFacts {
    TextSpan? particle = null
    TextSpan  name
    /// No particle, no default and not a `rest` tail.
    bool      isPlain  = false
}

/// The parameters of `fn`'s declaration, or none when it has no function or constructor declaration.
List<ParamFacts> paramFacts(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    return List<ParamFacts>() if f < 0 || d < 0
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n):
            return paramFactsOf(in n.value.params)
        case .structDecl(let n):
            return memberParamFacts(in n.value.members, at: m)
        case .interfaceDecl(let n):
            return memberParamFacts(in n.value.members, at: m)
        case .extensionDecl(let n):
            return memberParamFacts(in n.value.members, at: m)
        default:
            return List<ParamFacts>()
    }
}

List<ParamFacts> memberParamFacts(in List<parser.Decl> members, at i64 m) {
    return List<ParamFacts>() if m < 0 || m >= members.length
    switch members[m] {
        case .functionDecl(let n):
            return paramFactsOf(in n.value.params)
        case .constructorDecl(let n):
            return paramFactsOf(in n.value.params)
        default:
            return List<ParamFacts>()
    }
}

List<ParamFacts> paramFactsOf(in List<parser.Param> params) {
    var facts = List<ParamFacts>()
    for p in params {
        facts.append(ParamFacts {
            particle: p.particle,
            name: p.name,
            isPlain: p.particle is null && p.defaultKeyword is .none && !p.rest,
        })
    }
    return facts
}
== semantics/ownership.byn
// T24: OwnershipAnalysis.cs and the three lints.
//
// Ownership of unique values (spec §3.11, §9.3), run once every body is bound: an existing unique value may not be
// stored without `move` or `copy` (BYN2780), and a moved local may not be used on any path until it is assigned again
// (BYN2781). The C# `Dictionary<LocalSymbol, TextSpan>` and `HashSet` fields are `List`s searched in order; a
// `JumpTarget` is its `Ctx.jumpTargets` index and a bound node its handle, which are their identities.

import parser

/// One entry of C# `State.Moved`: a local and where it was moved.
struct T24Moved {
    LocalId  local
    TextSpan site
}

/// C# `OwnershipAnalysis.State`: reachability plus the locals moved on some path, with where.
struct OwnState {
    bool reachable = true
    List<T24Moved> moved = []
}

/// C# `Cleanup`: a `defer`/`errdefer`, the locals its body reads and moves, and what was already moved when it was
/// registered; `panic` for a `defer panicking`.
struct T24Cleanup {
    TextSpan       site
    bool           onFailure   = false
    List<LocalId>  reads       = []
    List<T24Moved> moves       = []
    List<T24Moved> movedBefore = []
    bool           panic       = false
}

/// One entry of C# `_reported`: a code and a span.
struct T24Reported {
    string   code
    TextSpan span
}

/// The C# `OwnershipAnalysis` instance.
struct Ownership {
    FuncId             fn
    FileId             file
    Map<i64, OwnState> breaks    = []
    Map<i64, OwnState> continues = []
    List<T24Reported>  reported  = []
    /// Cleanups registered in the enclosing scopes, innermost last.
    List<T24Cleanup>   cleanups  = []
    /// How many cleanups were active where each loop or switch began: a jump to it runs the rest.
    Map<i64, i64>      depths    = []
}

void analyzeOwnership(ref Ctx c, for FuncId fn) {
    return if c.functions[fn].file == -1 || c.functions[fn].body == -1
    var a = Ownership { fn: fn, file: c.functions[fn].file }
    let statements = copyIds(in c.bBlocks[boundIndex(c.functions[fn].body)].statements)
    let _ = t24Block(ref a, through: ref c, for: in statements, by: OwnState {})
}

// ── State ────────────────────────────────────────────────────────────────────

List<T24Moved> t24CopyMoved(in List<T24Moved> xs) {
    var r = List<T24Moved>()
    for x in xs {
        r.append(T24Moved { local: x.local, site: x.site })
    }
    return r
}

OwnState t24Clone(in OwnState s) => OwnState { reachable: s.reachable, moved: t24CopyMoved(in s.moved) }

OwnState t24Unreachable() => OwnState { reachable: false }

/// The index of `l` in `moved`, or -1 (C# `Moved.TryGetValue`).
i64 t24Find(in List<T24Moved> moved, by LocalId l) {
    for k in 0..moved.length {
        return k if moved[k].local == l
    }
    return -1
}

/// C# `Moved[l] = site`.
void t24Set(ref List<T24Moved> moved, for LocalId l, at TextSpan site) {
    let k = t24Find(in moved, by: l)
    if k >= 0 {
        moved[k].site = site
    } else {
        moved.append(T24Moved { local: l, site: site })
    }
}

/// C# `Moved.Remove(l)`.
void t24Remove(ref List<T24Moved> moved, by LocalId l) {
    let k = t24Find(in moved, by: l)
    if k >= 0 {
        moved.remove(at: k)
    }
}

/// Paths meeting: moved if moved on any reachable path.
OwnState t24Join(in OwnState s, by in OwnState other) {
    return t24Clone(in other) if !s.reachable
    return t24Clone(in s) if !other.reachable
    var r = t24Clone(in s)
    for x in other.moved {
        if t24Find(in r.moved, by: x.local) < 0 {
            r.moved.append(T24Moved { local: x.local, site: x.site })
        }
    }
    return move r
}

bool t24SameAs(in OwnState s, by in OwnState other) {
    return false if s.reachable != other.reachable || s.moved.length != other.moved.length
    for x in s.moved {
        return false if t24Find(in other.moved, by: x.local) < 0
    }
    return true
}

bool t24SameSpan(TextSpan a, as TextSpan b) => a.start == b.start && a.length == b.length

void t24Report(
    ref Ownership a,
    through ref Ctx c,
    for SemaCode code,
    at TextSpan span,
    by string arg,
    string label = "",
    string help = "",
    bool hasFix = false,
    TextSpan? fixSpan = null,
    string fixReplacement = ""
) {
    let text = codeText(code)
    for r in a.reported {
        return if r.code == text && t24SameSpan(r.span, as: span)
    }
    a.reported.append(T24Reported { code: text, span: span })
    report(
        ref c,
        for: code,
        from: a.file,
        at: span,
        by: (arg, "", "", "", ""),
        label: label,
        help: help,
        hasFix: hasFix,
        fixSpan: fixSpan,
        fixReplacement: fixReplacement,
    )
}

i64 t24Line(in Ctx c, for FileId file, at i64 offset) => linePosition(c.files[file].text.span, at: offset).line

// ── Statements ───────────────────────────────────────────────────────────────

OwnState t24Block(ref Ownership a, through ref Ctx c, for in List<BStmt> statements, by move OwnState start) {
    var state = move start
    let depth = a.cleanups.length
    for s in statements {
        state = t24Statement(ref a, through: ref c, for: s, by: move state)
    }
    t24RunCleanups(ref a, through: ref c, for: in state, from: depth, failing: false)
    while a.cleanups.length > depth {
        let _ = a.cleanups.removeLast()
    }
    return move state
}

OwnState t24Statement(ref Ownership a, through ref Ctx c, for BStmt s, by move OwnState start) {
    var state = move start
    let i = boundIndex(s)
    switch boundKind(s) {
        case .block:
            let statements = copyIds(in c.bBlocks[i].statements)
            return t24Block(ref a, through: ref c, for: in statements, by: move state)
        case .localDecl:
            let local = c.bLocalDecls[i].local
            let initializer = c.bLocalDecls[i].initializer
            if initializer != -1 {
                state = t24Expr(ref a, through: ref c, for: initializer, by: move state)
                t24CheckStore(ref a, through: ref c, for: initializer)
            }
            t24Remove(ref state.moved, by: local)
            return move state
        case .exprStmt:
            return t24Expr(ref a, through: ref c, for: c.bExprStmts[i].expr, by: move state)
        case .assertStmt:
            return t24Expr(ref a, through: ref c, for: c.bAsserts[i].condition, by: move state)
        case .assign:
            let target = c.bAssigns[i].target
            let value = c.bAssigns[i].value
            if c.bAssigns[i].op is null && boundKind(target) == .local {
                let l = c.bLocals[boundIndex(target)].local
                state = t24Expr(ref a, through: ref c, for: value, by: move state)
                // `x = x with { … }` consumes the old `x`: a move, not a copy (revision 0007).
                if !t24IsSelfWith(in c, for: value, by: l) {
                    t24CheckStore(ref a, through: ref c, for: value)
                }
                t24Remove(ref state.moved, by: l)
                return move state
            }
            state = t24Expr(ref a, through: ref c, for: target, by: move state)
            state = t24Expr(ref a, through: ref c, for: value, by: move state)
            t24CheckStore(ref a, through: ref c, for: value)
            return move state
        case .returnStmt:
            let value = c.bReturns[i].value
            if value != -1 {
                state = t24Expr(ref a, through: ref c, for: value, by: move state)
                // A local or `move` parameter returned is going out of scope: it moves.
                if !t24IsMovable(in c, for: t24StripConversions(in c, for: value)) {
                    t24CheckStore(ref a, through: ref c, for: value)
                }
            }
            t24RunCleanups(ref a, through: ref c, for: in state, from: 0, failing: false)
            return t24Unreachable()
        case .failStmt:
            let after = t24Expr(ref a, through: ref c, for: c.bFails[i].error, by: move state)
            t24RunCleanups(ref a, through: ref c, for: in after, from: 0, failing: true)
            return t24Unreachable()
        case .breakStmt:
            let target = c.bBreaks[i].target
            t24RunCleanups(ref a, through: ref c, for: in state, from: a.depths.tryGet(at: target) ?? 0, failing: false)
            t24Merge(ref a.breaks, for: target, by: in state)
            return t24Unreachable()
        case .continueStmt:
            let target = c.bContinues[i].target
            t24RunCleanups(ref a, through: ref c, for: in state, from: a.depths.tryGet(at: target) ?? 0, failing: false)
            t24Merge(ref a.continues, for: target, by: in state)
            return t24Unreachable()
        case .ifStmt:
            let condition = c.bIfs[i].condition
            let thenBranch = c.bIfs[i].then
            let elseBranch = c.bIfs[i].elseBranch
            state = t24Expr(ref a, through: ref c, for: condition, by: move state)
            let constant = t23ConstantBool(in c, for: condition)
            let thenStart = constant == false ? t24Unreachable() : t24Clone(in state)
            let thenState = t24Statement(ref a, through: ref c, for: thenBranch, by: move thenStart)
            var otherwise = t24Unreachable()
            if constant == true {
                otherwise = t24Unreachable()
            } else if elseBranch == -1 {
                otherwise = t24Clone(in state)
            } else {
                otherwise = t24Statement(ref a, through: ref c, for: elseBranch, by: t24Clone(in state))
            }
            return t24Join(in thenState, by: in otherwise)
        case .whileStmt:
            // A move in the body reaches the next iteration: repeat until the entry state is stable.
            let condition = c.bWhiles[i].condition
            let body = c.bWhiles[i].body
            let target = c.bWhiles[i].target
            a.depths[target] = a.cleanups.length
            var entry = t24Clone(in state)
            while true {
                let head = t24Expr(ref a, through: ref c, for: condition, by: t24Clone(in entry))
                let bodyStart = t23ConstantBool(in c, for: condition) == false ? t24Unreachable() : t24Clone(in head)
                var bodyState = t24Statement(ref a, through: ref c, for: body, by: move bodyStart)
                if a.continues.contains(target) {
                    bodyState = t24Join(in bodyState, by: in a.continues[target])
                    let _ = a.continues.remove(target)
                }
                let next = t24Join(in state, by: in bodyState)
                if t24SameAs(in next, by: in entry) {
                    let after = t23ConstantBool(in c, for: condition) == true ? t24Unreachable() : move head
                    return t24Exit(ref a, for: target, by: move after)
                }
                entry = move next
            }
        case .doWhile:
            let condition = c.bDoWhiles[i].condition
            let body = c.bDoWhiles[i].body
            let target = c.bDoWhiles[i].target
            a.depths[target] = a.cleanups.length
            var entry = t24Clone(in state)
            while true {
                var bodyState = t24Statement(ref a, through: ref c, for: body, by: t24Clone(in entry))
                if a.continues.contains(target) {
                    bodyState = t24Join(in bodyState, by: in a.continues[target])
                    let _ = a.continues.remove(target)
                }
                let afterCondition = t24Expr(ref a, through: ref c, for: condition, by: move bodyState)
                let next = t24Join(in state, by: in afterCondition)
                if t24SameAs(in next, by: in entry) {
                    let after = t23ConstantBool(in c, for: condition) == true ? t24Unreachable() : move afterCondition
                    return t24Exit(ref a, for: target, by: move after)
                }
                entry = move next
            }
        case .forStmt:
            let body = c.bFors[i].body
            let target = c.bFors[i].target
            state = t24Expr(ref a, through: ref c, for: c.bFors[i].iterable, by: move state)
            a.depths[target] = a.cleanups.length
            var entry = t24Clone(in state)
            while true {
                var bodyState = t24Statement(ref a, through: ref c, for: body, by: t24Clone(in entry))
                if a.continues.contains(target) {
                    bodyState = t24Join(in bodyState, by: in a.continues[target])
                    let _ = a.continues.remove(target)
                }
                let next = t24Join(in state, by: in bodyState)
                return t24Exit(ref a, for: target, by: move entry) if t24SameAs(in next, by: in entry)
                entry = move next
            }
        case .switchStmt:
            let target = c.bSwitches[i].target
            state = t24Expr(ref a, through: ref c, for: c.bSwitches[i].value, by: move state)
            a.depths[target] = a.cleanups.length
            var after = t24Unreachable()
            // A guard that ran and failed has made its moves: later sections start from that too.
            var next = t24Clone(in state)
            let count = c.bSwitches[i].sections.length
            for k in 0..count {
                let pattern = c.bSwitches[i].sections[k].pattern
                let guard = c.bSwitches[i].sections[k].guard
                let sectionBody = copyIds(in c.bSwitches[i].sections[k].body)
                var branch = t24Bind(in c, for: pattern, by: t24Clone(in next))
                if guard != -1 {
                    branch = t24Expr(ref a, through: ref c, for: guard, by: move branch)
                    next = t24Join(in next, by: in branch)
                }
                let ended = t24Block(ref a, through: ref c, for: in sectionBody, by: t24Clone(in branch))
                after = t24Join(in after, by: in ended)
            }
            if !c.bSwitches[i].exhaustive {
                after = t24Join(in after, by: in next)
            }
            return t24Exit(ref a, for: target, by: move after)
        case .deferStmt:
            let body = c.bDefers[i].body
            let _ = t24Statement(ref a, through: ref c, for: body, by: t24Clone(in state))
            t24Register(ref a, through: ref c, for: body, at: c.bDefers[i].span, onFailure: false, by: in state)
            return move state
        case .errdeferStmt:
            let body = c.bErrdefers[i].body
            let _ = t24Statement(ref a, through: ref c, for: body, by: t24Clone(in state))
            t24Register(ref a, through: ref c, for: body, at: c.bErrdefers[i].span, onFailure: true, by: in state)
            return move state
        // A panic handler runs in place of the scope's cleanups, not at its exit: registered only so a later move of what it reads is BYN2615.
        case .panicDefer:
            let body = c.bPanicDefers[i].body
            let _ = t24Statement(ref a, through: ref c, for: body, by: t24Clone(in state))
            t24Register(
                ref a,
                through: ref c,
                for: body,
                at: c.bPanicDefers[i].span,
                onFailure: false,
                by: in state,
                panic: true,
            )
            return move state
        case .contextStmt:
            let body = c.bContexts[i].body
            state = t24Expr(ref a, through: ref c, for: c.bContexts[i].allocator, by: move state)
            return t24Statement(ref a, through: ref c, for: body, by: move state)
        default:
            return move state
    }
}

/// A pattern's bindings hold a fresh value each time it matches, as a declaration does.
OwnState t24Bind(in Ctx c, for BPattern pattern, by move OwnState start) {
    var state = move start
    return move state if pattern == -1
    for node in descendants(in c, for: pattern) {
        let i = boundIndex(node)
        switch boundKind(node) {
            case .bindPattern:
                if c.bBindPatterns[i].local != -1 {
                    t24Remove(ref state.moved, by: c.bBindPatterns[i].local)
                }
            case .propertyPattern:
                if c.bPropertyPatterns[i].designation != -1 {
                    t24Remove(ref state.moved, by: c.bPropertyPatterns[i].designation)
                }
            case .unionPattern:
                if c.bUnionPatterns[i].designation != -1 {
                    t24Remove(ref state.moved, by: c.bUnionPatterns[i].designation)
                }
            default:
                continue
        }
    }
    return move state
}

/// Registers a cleanup: the locals `body` reads (not those it only assigns) and moves.
void t24Register(
    ref Ownership a,
    through ref Ctx c,
    for BStmt body,
    at TextSpan site,
    bool onFailure,
    by in OwnState state,
    bool panic = false
) {
    var assigned = List<BNode>()
    var reads = List<LocalId>()
    var moves = List<T24Moved>()
    for n in descendants(in c, for: body) {
        let i = boundIndex(n)
        let kind = boundKind(n)
        if kind == .assign && c.bAssigns[i].op is null && boundKind(c.bAssigns[i].target) == .local {
            assigned.append(c.bAssigns[i].target)
        } else if kind == .local && !listContains(in assigned, by: n) {
            if !listContains(in reads, by: c.bLocals[i].local) {
                reads.append(c.bLocals[i].local)
            }
        } else if kind == .moveExpr && boundKind(c.bMoves[i].operand) == .local {
            let operand = c.bMoves[i].operand
            let m = c.bLocals[boundIndex(operand)].local
            if t24IsMovable(in c, for: operand) && isUnique(ref c, for: c.locals[m].type) {
                moves.append(T24Moved { local: m, site: c.bMoves[i].span })
            }
        }
    }
    a.cleanups.append(
        T24Cleanup {
            site: site,
            onFailure: onFailure,
            reads: move reads,
            moves: move moves,
            movedBefore: t24CopyMoved(in state.moved),
            panic: panic,
        },
    )
}

/// Runs the cleanups from `depth` up, innermost first, at an exit reached in `state`: a local one reads that was moved
/// after it was registered is a use after move, reported at the move.
void t24RunCleanups(ref Ownership a, through ref Ctx c, for in OwnState state, from i64 depth, bool failing) {
    return if !state.reachable
    var moved = t24CopyMoved(in state.moved)
    var i = a.cleanups.length - 1
    while i >= depth {
        let onFailure = a.cleanups[i].onFailure
        if a.cleanups[i].panic || onFailure && !failing {
            i -= 1
            continue
        }
        let line = t24Line(in c, for: a.file, at: a.cleanups[i].site.start)
        let reads = copyIds(in a.cleanups[i].reads)
        for l in reads {
            let k = t24Find(in moved, by: l)
            continue if k < 0
            let site = moved[k].site
            let b = t24Find(in a.cleanups[i].movedBefore, by: l)
            continue if b >= 0 && t24SameSpan(a.cleanups[i].movedBefore[b].site, as: site)
            let name = c.locals[l].name
            let label = $"{onFailure ? "a `defer failing`" : "a `defer`"} on line {line} uses it at scope exit"
            let help = $"move `{name}` before the `{onFailure ? "defer failing" : "defer"}`, or move a `.copy(to: alloc)` of it instead"
            t24Report(ref a, through: ref c, for: .useAfterMove, at: site, by: name, label: label, help: help)
        }
        for x in a.cleanups[i].moves {
            t24Set(ref moved, for: x.local, at: x.site)
        }
        i -= 1
    }
}

void t24Merge(ref Map<i64, OwnState> map, for i64 target, by in OwnState state) {
    return if !state.reachable
    if map.contains(target) {
        let joined = t24Join(in map[target], by: in state)
        map[target] = move joined
    } else {
        map[target] = t24Clone(in state)
    }
}

OwnState t24Exit(ref Ownership a, for i64 target, by move OwnState after) {
    let _ = a.continues.remove(target)
    if a.breaks.contains(target) {
        let joined = t24Join(in after, by: in a.breaks[target])
        let _ = a.breaks.remove(target)
        return move joined
    }
    return move after
}

// ── Expressions ──────────────────────────────────────────────────────────────

OwnState t24Expr(ref Ownership a, through ref Ctx c, for BExpr e, by move OwnState start) {
    var state = move start
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            let l = c.bLocals[i].local
            let k = t24Find(in state.moved, by: l)
            if state.reachable && k >= 0 {
                let name = c.locals[l].name
                let line = t24Line(in c, for: a.file, at: state.moved[k].site.start)
                t24Report(
                    ref a,
                    through: ref c,
                    for: .useAfterMove,
                    at: c.bLocals[i].span,
                    by: name,
                    label: $"moved on line {line}",
                    help: $"assign `{name}` a new value before using it again, or move a `.copy(to: alloc)` of it instead",
                )
            }
            return move state
        case .moveExpr:
            let operand = c.bMoves[i].operand
            state = t24Expr(ref a, through: ref c, for: operand, by: move state)
            if t24IsMovable(in c, for: operand) && boundKind(operand) == .local {
                let moved = c.bLocals[boundIndex(operand)].local
                if isUnique(ref c, for: c.locals[moved].type) {
                    let span = c.bMoves[i].span
                    t24Set(ref state.moved, for: moved, at: span)
                    for k in 0..a.cleanups.length {
                        if a.cleanups[k].panic && state.reachable && listContains(in a.cleanups[k].reads, by: moved) {
                            let name = c.locals[moved].name
                            let line = t24Line(in c, for: a.file, at: a.cleanups[k].site.start)
                            t24Report(
                                ref a,
                                through: ref c,
                                for: .panicHandlerReadsMoved,
                                at: span,
                                by: name,
                                label: $"the `defer panicking` on line {line} reads it after a later panic",
                                help: $"move `{name}` before the `defer panicking`, or read a `let` copied from it there",
                            )
                        }
                    }
                }
            }
            return move state
        case .tryExpr:
            state = t24Expr(ref a, through: ref c, for: c.bTries[i].operand, by: move state)
            t24RunCleanups(ref a, through: ref c, for: in state, from: 0, failing: true)
            return isNever(c.bTries[i].type) ? t24Unreachable() : move state
        case .binary:
            let op = c.bBinaries[i].op
            if op is .logicalAnd or .logicalOr {
                let right = c.bBinaries[i].right
                state = t24Expr(ref a, through: ref c, for: c.bBinaries[i].left, by: move state)
                let rightState = t24Expr(ref a, through: ref c, for: right, by: t24Clone(in state))
                return t24Join(in state, by: in rightState)
            }
            return t24Default(ref a, through: ref c, for: e, by: move state)
        case .conditional:
            let whenTrue = c.bConditionals[i].whenTrue
            let whenFalse = c.bConditionals[i].whenFalse
            state = t24Expr(ref a, through: ref c, for: c.bConditionals[i].condition, by: move state)
            let t = t24Expr(ref a, through: ref c, for: whenTrue, by: t24Clone(in state))
            let o = t24Expr(ref a, through: ref c, for: whenFalse, by: t24Clone(in state))
            return t24Join(in t, by: in o)
        case .coalesce:
            let right = c.bCoalesces[i].right
            state = t24Expr(ref a, through: ref c, for: c.bCoalesces[i].left, by: move state)
            let r = t24Expr(ref a, through: ref c, for: right, by: t24Clone(in state))
            return t24Join(in state, by: in r)
        case .switchExpr:
            state = t24Expr(ref a, through: ref c, for: c.bSwitchExprs[i].value, by: move state)
            var after = t24Unreachable()
            var next = t24Clone(in state)
            let count = c.bSwitchExprs[i].arms.length
            for k in 0..count {
                let pattern = c.bSwitchExprs[i].arms[k].pattern
                let guard = c.bSwitchExprs[i].arms[k].guard
                let value = c.bSwitchExprs[i].arms[k].value
                var branch = t24Bind(in c, for: pattern, by: t24Clone(in next))
                if guard != -1 {
                    branch = t24Expr(ref a, through: ref c, for: guard, by: move branch)
                    next = t24Join(in next, by: in branch)
                }
                let ended = t24Expr(ref a, through: ref c, for: value, by: t24Clone(in branch))
                after = t24Join(in after, by: in ended)
            }
            return move after
        case .call:
            let function = c.bCalls[i].function
            let receiver = c.bCalls[i].receiver
            let arguments = copyIds(in c.bCalls[i].arguments)
            if receiver != -1 {
                state = t24Expr(ref a, through: ref c, for: receiver, by: move state)
            }
            var outs = List<LocalId>()
            let parameters = copyIds(in c.functions[function].parameters)
            let builtin = c.functions[function].builtin
            for k in 0..arguments.length {
                let arg = arguments[k]
                let modifier = k < parameters.length ? c.locals[parameters[k]].modifier : parser.ParamModifier.none
                if modifier == .outKeyword && boundKind(arg) == .local {
                    outs.append(c.bLocals[boundIndex(arg)].local)
                    continue
                }
                state = t24Expr(ref a, through: ref c, for: arg, by: move state)
                if modifier == .moveKeyword || (k == 0 && (builtin is .ownedNew or .untrustedNew or .trust)) {
                    t24CheckStore(ref a, through: ref c, for: arg)
                }
            }
            for l in outs {
                t24Remove(ref state.moved, by: l)
            }
            return isNever(c.bCalls[i].type) ? t24Unreachable() : move state
        case .catchExpr:
            let handler = c.bCatches[i].handler
            state = t24Expr(ref a, through: ref c, for: c.bCatches[i].operand, by: move state)
            if c.bCatches[i].variant != -1 {
                t24RunCleanups(ref a, through: ref c, for: in state, from: 0, failing: true)
            }
            let h = t24Expr(ref a, through: ref c, for: handler, by: t24Clone(in state))
            return t24Join(in state, by: in h)
        case .jump:
            return t24Statement(ref a, through: ref c, for: c.bJumps[i].jump, by: move state)
        case .blockExpr:
            return t24Statement(ref a, through: ref c, for: c.bBlockExprs[i].block, by: move state)
        case .isExpr:
            return t24Expr(ref a, through: ref c, for: c.bIses[i].value, by: move state)
        default:
            return t24Default(ref a, through: ref c, for: e, by: move state)
    }
}

/// The C# `default` arm of `Expr`.
OwnState t24Default(ref Ownership a, through ref Ctx c, for BExpr e, by move OwnState start) {
    var state = move start
    for child in children(in c, for: e) {
        if isExprKind(boundKind(child)) {
            state = t24Expr(ref a, through: ref c, for: child, by: move state)
        }
    }
    for stored in t24StoredOperands(in c, for: e) {
        t24CheckStore(ref a, through: ref c, for: stored)
    }
    // A local read inside nested lambdas is a capture of each of them; only the function that owns it reports it.
    if boundKind(e) == .lambda {
        let captures = copyIds(in c.bLambdas[boundIndex(e)].captures)
        for capture in captures {
            if listContains(in c.functions[a.fn].locals, by: c.bLocals[boundIndex(capture)].local) {
                t24CheckStore(ref a, through: ref c, for: capture, captured: true)
            }
        }
    }
    return isNever(exprType(in c, for: e)) && boundKind(e) != .errorExpr ? t24Unreachable() : move state
}

/// Operands that `e` stores into a new location: elements, fields, payloads, inserted values.
List<BExpr> t24StoredOperands(in Ctx c, for BExpr e) {
    var r = List<BExpr>()
    let i = boundIndex(e)
    switch boundKind(e) {
        case .collection:
            for x in c.bCollections[i].elements {
                r.append(x)
            }
        case .structLiteral:
            for x in c.bStructLiterals[i].fields {
                r.append(x)
            }
        case .unionNew:
            for x in c.bUnionNews[i].payload {
                r.append(x)
            }
        case .tuple:
            for x in c.bTuples[i].elements {
                r.append(x)
            }
        case .withExpr:
            for u in c.bWiths[i].updates {
                r.append(u.value)
            }
        case .builtinCall:
            if c.bBuiltinCalls[i].member == .listAdd {
                r.append(c.bBuiltinCalls[i].arguments[0])
            }
        default:
            return r
    }
    return r
}

// ── Implicit copies (BYN2780) ────────────────────────────────────────────────

/// `value` is stored somewhere new: it must not be an existing unique value.
void t24CheckStore(ref Ownership a, through ref Ctx c, for BExpr value, bool captured = false) {
    return if !t24IsPlace(ref c, for: value)
    let why = whyUnique(ref c, for: exprType(in c, for: value)) ?? return
    let core = t24StripConversions(in c, for: value)
    let span = nodeSpan(in c, for: core)
    let text = $"{getText(c.files[a.file].text.span, at: span)}"
    // A lambda copies its captures; a copy or a move of the local would be captured the same way.
    if captured {
        t24Report(
            ref a,
            through: ref c,
            for: .implicitCopy,
            at: span,
            by: why,
            help: $"copy what the lambda needs from `{text}` into `let` values first",
        )
        return
    }
    if boundKind(core) == .withExpr {
        let target = t24StripConversions(in c, for: c.bWiths[boundIndex(core)].target)
        if t24IsMovable(in c, for: target) {
            let name = $"{getText(c.files[a.file].text.span, at: nodeSpan(in c, for: target))}"
            t24Report(
                ref a,
                through: ref c,
                for: .implicitCopy,
                at: span,
                by: why,
                help: $"write `move {name} with {{ … }}` to give up `{name}`",
            )
            return
        }
    }
    var options = List<string>()
    var hasFix = false
    var fixSpan = TextSpan { start: 0, length: 0 }
    var fixReplacement = ""
    if t24IsMovable(in c, for: core) {
        options.append($"hand the value over with `move {text}`")
        hasFix = true
        fixSpan = TextSpan { start: span.start, length: 0 }
        fixReplacement = "move "
    }
    let coreType = exprType(in c, for: core)
    if kindOf(coreType) == .list
            || kindOf(coreType) == .map
            || (kindOf(coreType) == .builtin && builtinKindOf(typeIndex(coreType)) == .strBuf) {
        options.append($"make an independent copy with `{text}.copy(to: alloc)`")
        if !hasFix {
            hasFix = true
            fixSpan = TextSpan { start: span.end, length: 0 }
            fixReplacement = ".copy(to: alloc)"
        }
    }
    if boundKind(core) == .local {
        let l = c.bLocals[boundIndex(core)].local
        if c.locals[l].isParameter && c.locals[l].modifier == .none {
            options.append($"declare the parameter `move {c.locals[l].name}` to take ownership")
        }
    }
    options.append("pass it by `ref` to share it instead")
    var sb = StrBuf()
    for k in 0..options.length {
        if k > 0 {
            sb.append("; ")
        }
        sb.append(options[k])
    }
    let help = $"{sb.finish()}"
    t24Report(
        ref a,
        through: ref c,
        for: .implicitCopy,
        at: span,
        by: why,
        help: help,
        hasFix: hasFix,
        fixSpan: fixSpan,
        fixReplacement: fixReplacement,
    )
}

/// Whether `value` is `local with { … }`, possibly under `try`, rebuilding `local` itself.
bool t24IsSelfWith(in Ctx c, for BExpr value, by LocalId local) {
    let core = t24StripConversions(in c, for: value)
    switch boundKind(core) {
        case .tryExpr:
            return t24IsSelfWith(in c, for: c.bTries[boundIndex(core)].operand, by: local)
        case .withExpr:
            let target = t24StripConversions(in c, for: c.bWiths[boundIndex(core)].target)
            return boundKind(target) == .local && c.bLocals[boundIndex(target)].local == local
        default:
            return false
    }
}

/// A local or `move` parameter this function owns, which `move` can hand over.
bool t24IsMovable(in Ctx c, for BExpr e) {
    return false if boundKind(e) != .local
    let l = c.bLocals[boundIndex(e)].local
    let kind = c.locals[l].kind
    return true if (kind is .letKeyword or .varKeyword or .patternVariable) && !c.locals[l].borrowsSubject
    return c.locals[l].isParameter && c.locals[l].modifier == .moveKeyword
}

/// Whether `e` reads existing storage (a local, parameter, field, element or `.value`) rather than making a fresh value.
bool t24IsPlace(ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local or .thisRef or .field or .tupleElement or .index:
            return true
        case .builtinCall:
            switch c.bBuiltinCalls[i].member {
                // `take()` hands over a fresh value; the place keeps an empty one.
                case .listTake or .mapTake or .strBufTake or .optionalTake:
                    return false
                case .ownedValue or .resultValue or .mapIndex or .mapIndexSet or .mapSlot or .mapTryGet or .listTryGet:
                    return true
                default:
                    return false
            }
        case .conversion:
            return t24IsPlace(ref c, for: c.bConversions[i].operand)
        case .conditional:
            return t24IsPlace(ref c, for: c.bConditionals[i].whenTrue)
                || t24IsPlace(ref c, for: c.bConditionals[i].whenFalse)
        case .coalesce:
            return t24IsPlace(ref c, for: c.bCoalesces[i].left) || t24IsPlace(ref c, for: c.bCoalesces[i].right)
        case .switchExpr:
            let count = c.bSwitchExprs[i].arms.length
            for k in 0..count {
                return true if t24IsPlace(ref c, for: c.bSwitchExprs[i].arms[k].value)
            }
            return false
        // A `with` copies only the fields it does not replace.
        case .withExpr:
            let target = c.bWiths[i].target
            let targetType = exprType(in c, for: target)
            return false if kindOf(targetType) != .structType
            return false if !t24IsPlace(ref c, for: target)
            let fields = copyIds(in c.structs[typeIndex(targetType)].fields)
            for f in fields {
                var updated = false
                for u in c.bWiths[i].updates {
                    if u.field == f {
                        updated = true
                    }
                }
                return true if !updated && isUnique(ref c, for: c.fields[f].type)
            }
            return false
        case .tryExpr:
            return t24IsPlace(ref c, for: c.bTries[i].operand)
        case .catchExpr:
            return t24IsPlace(ref c, for: c.bCatches[i].operand) || t24IsPlace(ref c, for: c.bCatches[i].handler)
        default:
            return false
    }
}

BExpr t24StripConversions(in Ctx c, for BExpr e) =>
    boundKind(e) == .conversion ? t24StripConversions(in c, for: c.bConversions[boundIndex(e)].operand) : e

// ── NeverReassignedVarLint.cs ────────────────────────────────────────────────

/// BYN2311: a `var` local or pattern binding that is never assigned or mutated through should be a `let`.
void lintNeverReassignedVar(ref Ctx c, for FuncId fn) {
    let file = c.functions[fn].file
    let body = c.functions[fn].body
    return if file == -1 || body == -1
    for node in descendants(in c, for: body) {
        var local: LocalId = -1
        if boundKind(node) == .localDecl && c.bLocalDecls[boundIndex(node)].initializer != -1 {
            local = c.bLocalDecls[boundIndex(node)].local
        }
        if boundKind(node) == .bindPattern {
            local = c.bBindPatterns[boundIndex(node)].local
        }
        continue if local == -1
        continue if c.locals[local].kind != .varKeyword || c.locals[local].written
        let keyword = c.locals[local].keywordSpan ?? continue
        report(
            ref c,
            for: .neverReassignedVar,
            from: file,
            at: c.locals[local].nameSpan,
            by: (c.locals[local].name, "", "", "", ""),
            help: "declare it with `let` to tell the reader the value never changes",
            hasFix: true,
            fixSpan: keyword,
            fixReplacement: "let",
        )
    }
}

// ── SpanParameterLint.cs ─────────────────────────────────────────────────────

/// A parameter's C# `Syntax.Type` where it is a `NamedType`: its span and its last path segment.
struct T24NamedParam {
    bool     named = false
    TextSpan span  = TextSpan { start: 0, length: 0 }
    TextSpan last  = TextSpan { start: 0, length: 0 }
}

/// BYN2310: a `Span<T>` parameter that the function only reads should be a `ReadOnlySpan<T>`.
void lintSpanParameter(ref Ctx c, for FuncId fn) {
    let file = c.functions[fn].file
    let body = c.functions[fn].body
    return if file == -1 || body == -1
    let parameters = copyIds(in c.functions[fn].parameters)
    let syntax = t24ParamSyntax(in c, for: fn)
    var candidates = List<LocalId>()
    for k in 0..parameters.length {
        let p = parameters[k]
        let t = c.locals[p].type
        if c.locals[p].modifier == .none
                && kindOf(t) == .span
                && !c.spanTypes[typeIndex(t)].readOnly
                && syntax[k].named {
            candidates.append(p)
        }
    }
    return if candidates.length == 0
    for node in descendants(in c, for: body) {
        let i = boundIndex(node)
        switch boundKind(node) {
            case .assign:
                t24Written(ref candidates, through: in c, for: c.bAssigns[i].target)
            case .call:
                if c.bCalls[i].receiver != -1 {
                    t24Written(ref candidates, through: in c, for: c.bCalls[i].receiver)
                }
                let callee = c.bCalls[i].function
                var j: i64 = 0
                while j < c.bCalls[i].arguments.length && j < c.functions[callee].parameters.length {
                    if c.locals[c.functions[callee].parameters[j]].modifier != .none {
                        t24Written(ref candidates, through: in c, for: c.bCalls[i].arguments[j])
                    }
                    j += 1
                }
            case .builtinCall:
                let member = c.bBuiltinCalls[i].member
                if member != .spanLength && member != .spanIsEmpty && member != .spanCopy {
                    t24Written(ref candidates, through: in c, for: c.bBuiltinCalls[i].receiver)
                }
            default:
                break
        }
        for child in children(in c, for: node) {
            continue if boundKind(child) != .local
            let l = c.bLocals[boundIndex(child)].local
            if listContains(in candidates, by: l) && !t24ReadOnlyUse(ref c, for: node, by: child) {
                t24RemoveId(ref candidates, by: l)
            }
        }
    }
    for k in 0..parameters.length {
        let p = parameters[k]
        continue if !listContains(in candidates, by: p)
        let element = typeDisplay(ref c, by: c.spanTypes[typeIndex(c.locals[p].type)].element)
        report(
            ref c,
            for: .spanParameterNeverWritten,
            from: file,
            at: syntax[k].span,
            by: (c.locals[p].name, element, "", "", ""),
            help: "take a `ReadOnlySpan`; it also accepts strings and read-only views",
            hasFix: true,
            fixSpan: syntax[k].last,
            fixReplacement: "ReadOnlySpan",
        )
    }
}

/// C# `Written`: the span parameter `target` goes through is written.
void t24Written(ref List<LocalId> candidates, through in Ctx c, for BExpr target) {
    let root = t24Root(in c, for: target)
    if root != -1 {
        t24RemoveId(ref candidates, by: root)
    }
}

void t24RemoveId(ref List<LocalId> xs, by LocalId x) {
    var kept = List<LocalId>()
    for y in xs {
        if y != x {
            kept.append(y)
        }
    }
    xs = move kept
}

/// Uses that only read the span's elements: indexing, length, iteration, copying, viewing read-only.
bool t24ReadOnlyUse(ref Ctx c, for BNode parent, by BExpr use) {
    let i = boundIndex(parent)
    switch boundKind(parent) {
        case .index:
            return c.bIndexes[i].target == use
        case .builtinCall:
            let member = c.bBuiltinCalls[i].member
            return member is .spanLength or .spanIsEmpty or .spanCopy
        case .forStmt:
            return c.bFors[i].iterable == use
        case .conversion:
            let t = c.bConversions[i].type
            return kindOf(t) == .span && c.spanTypes[typeIndex(t)].readOnly
        case .call:
            var at: i64 = -1
            for k in 0..c.bCalls[i].arguments.length {
                if at == -1 && c.bCalls[i].arguments[k] == use {
                    at = k
                }
            }
            let callee = c.bCalls[i].function
            return false if at < 0 || at >= c.functions[callee].parameters.length
            let p = c.functions[callee].parameters[at]
            let t = c.locals[p].type
            return c.locals[p].modifier == .none && kindOf(t) == .span && c.spanTypes[typeIndex(t)].readOnly
        default:
            return false
    }
}

/// The span parameter an lvalue path goes through (`p[i]`, `p[i].f`, `p[a..b][i]`); -1 for none.
LocalId t24Root(in Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local: return c.bLocals[i].local
        case .field: return t24Root(in c, for: c.bFields[i].receiver)
        case .tupleElement: return t24Root(in c, for: c.bTupleElements[i].receiver)
        case .index: return t24Root(in c, for: c.bIndexes[i].target)
        case .slice: return t24Root(in c, for: c.bSlices[i].target)
        default: return -1
    }
}

/// Each of `fn`'s parameters' C# `Syntax?.Type is NamedType`, found the way `t12Params` finds `decl.params[ordinal]`.
List<T24NamedParam> t24ParamSyntax(in Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    if d >= 0 {
        switch c.files[f].unit.members[d] {
            case .functionDecl(let n):
                return t24FromSyntax(in c, for: fn, from: in n.value.params)
            case .structDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let x): return t24FromSyntax(in c, for: fn, from: in x.value.params)
                    case .constructorDecl(let x): return t24FromSyntax(in c, for: fn, from: in x.value.params)
                    default: break
                }
            case .interfaceDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let x): return t24FromSyntax(in c, for: fn, from: in x.value.params)
                    default: break
                }
            case .extensionDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let x): return t24FromSyntax(in c, for: fn, from: in x.value.params)
                    default: break
                }
            default:
                break
        }
    }
    var result = List<T24NamedParam>()
    for p in c.functions[fn].parameters {
        result.append(T24NamedParam {})
    }
    return result
}

List<T24NamedParam> t24FromSyntax(in Ctx c, for FuncId fn, from in List<parser.Param> ps) {
    var result = List<T24NamedParam>()
    for p in c.functions[fn].parameters {
        let o = c.locals[p].ordinal
        switch ps[o].type {
            case .namedType(let n):
                result.append(
                    T24NamedParam { named: true, span: n.value.span, last: n.value.path[n.value.path.length - 1] },
                )
            default:
                result.append(T24NamedParam {})
        }
    }
    return result
}

// ── PanicHandlerCheck.cs ─────────────────────────────────────────────────────

/// Panic handlers can't recover: a `defer panicking` body and the function `Panic.onPanic` names may not assign or
/// allocate (BYN2612) and read only `let` bindings and parameters (BYN2613).
void checkPanicHandler(ref Ctx c, for FuncId fn) {
    let file = c.functions[fn].file
    let body = c.functions[fn].body
    return if file == -1 || body == -1
    if fn == c.onPanic {
        t24CheckHandler(ref c, for: fn, at: body, whole: true)
    } else {
        t24FindHandlers(ref c, for: fn, at: body)
    }
}

/// Checks each outermost `defer panicking` body; its nested handlers are checked with it.
void t24FindHandlers(ref Ctx c, for FuncId fn, at BNode node) {
    if boundKind(node) == .panicDefer {
        t24CheckHandler(ref c, for: fn, at: c.bPanicDefers[boundIndex(node)].body, whole: false)
        return
    }
    for child in children(in c, for: node) {
        t24FindHandlers(ref c, for: fn, at: child)
    }
}

void t24CheckHandler(ref Ctx c, for FuncId fn, at BNode body, bool whole) {
    let file = c.functions[fn].file
    var own = List<LocalId>()
    var sinks = List<BNode>()
    var targets = List<BNode>()
    for node in descendants(in c, for: body) {
        let i = boundIndex(node)
        var restricted = ""
        switch boundKind(node) {
            case .localDecl:
                own.append(c.bLocalDecls[i].local)
            case .bindPattern:
                if c.bBindPatterns[i].local != -1 {
                    own.append(c.bBindPatterns[i].local)
                }
            case .propertyPattern:
                if c.bPropertyPatterns[i].designation != -1 {
                    own.append(c.bPropertyPatterns[i].designation)
                }
            case .unionPattern:
                if c.bUnionPatterns[i].designation != -1 {
                    own.append(c.bUnionPatterns[i].designation)
                }
            case .forStmt:
                own.append(c.bFors[i].variable)
            case .catchExpr:
                if c.bCatches[i].binding != -1 {
                    own.append(c.bCatches[i].binding)
                }
            case .errdeferStmt:
                if c.bErrdefers[i].error != -1 {
                    own.append(c.bErrdefers[i].error)
                }
            case .panicDefer:
                if c.bPanicDefers[i].panic != -1 {
                    own.append(c.bPanicDefers[i].panic)
                }
            case .returnStmt:
                if whole {
                    restricted = "`return`"
                }
            case .breakStmt:
                if whole {
                    restricted = "`break`"
                }
            case .continueStmt:
                if whole {
                    restricted = "`continue`"
                }
            case .tryExpr:
                if whole {
                    restricted = "`try`"
                }
            case .assign:
                restricted = "assignment"
                targets.append(c.bAssigns[i].target)
            case .call:
                let builtin = c.functions[c.bCalls[i].function].builtin
                // Interpolation written straight into `print`, `panic` or `StrBuf.append` is formatted on the stack.
                if (builtin is .print or .panic) && c.bCalls[i].arguments.length > 0
                        && boundKind(c.bCalls[i].arguments[0]) == .interpolated {
                    sinks.append(c.bCalls[i].arguments[0])
                } else if t24AllocatingFunction(builtin) {
                    restricted = "allocation"
                }
            case .builtinCall:
                let member = c.bBuiltinCalls[i].member
                if member == .strBufAppend
                        && c.bBuiltinCalls[i].arguments.length == 1
                        && boundKind(c.bBuiltinCalls[i].arguments[0]) == .interpolated {
                    sinks.append(c.bBuiltinCalls[i].arguments[0])
                } else if t24AllocatingMember(member) {
                    restricted = "allocation"
                }
            case .interpolated:
                if !listContains(in sinks, by: node) {
                    restricted = "allocation"
                }
            case .collection:
                let t = c.bCollections[i].type
                if kindOf(t) == .list || kindOf(t) == .map {
                    restricted = "allocation"
                }
            case .local:
                let l = c.bLocals[i].local
                let kind = c.locals[l].kind
                if !listContains(in targets, by: node)
                        && !listContains(in own, by: l)
                        && (kind is .varKeyword or .temp) {
                    report(
                        ref c,
                        for: .panicHandlerReads,
                        from: file,
                        at: nodeSpan(in c, for: node),
                        by: ("", "", "", "", ""),
                        label: $"`{c.locals[l].name}` is not a `let` or a parameter",
                        help: "copy the value into a `let` before the handler and read that",
                    )
                }
            default:
                break
        }
        if restricted != "" {
            report(
                ref c,
                for: .panicHandlerRestricted,
                from: file,
                at: nodeSpan(in c, for: node),
                by: (restricted, "", "", "", ""),
                help: "remove it; panic handlers can't recover",
            )
        }
    }
}

bool t24AllocatingFunction(BuiltinFunction b) {
    switch b {
        case .listNew
            or .ownedNew
            or .strBufGrow
            or .strBufOver
            or .arenaNew
            or .utf8Decode
            or .utf8TryDecode
            or .utf8DecodeReplace
            or .hexEncode
            or .hexDecode
            or .symbolIntern
            or .ioReadFile
            or .ioReadText
            or .ioListDir
            or .ioStdinReadAllBytes
            or .ioRun
            or .ioRunBatch
            or .pathRelative
            or .pathFileName
            or .pathDirectoryName
            or .pathCombine
            or .pathCombineSpan
            or .pathFullPath
            or .envGet
            or .fsRealPath:
            return true
        default:
            return false
    }
}

bool t24AllocatingMember(BuiltinMember m) {
    switch m {
        case .spanCopy
            or .stringCopy
            or .listCopy
            or .mapCopy
            or .strBufCopy
            or .ioReadAll
            or .intToString
            or .listAdd
            or .listReplace
            or .mapSlot
            or .mapIndexSet
            or .stringLowercased
            or .stringUppercased
            or .stringReplaced
            or .stringRepeated
            or .stringPadded
            or .bytesToString
            or .stringJoined
            or .utf16Copy:
            return true
        default:
            return false
    }
}
== semantics/region.byn
// T25: RegionAnalysis.cs 1-~417 (regions, borrows, loans, Stmt/Expr/Compute).

// The C# records: a region is a lexical depth and a name; `source` marks a parameter's (or `this`'s) data in a summary.
struct Region {
    i64    depth
    string name
    i64    source = regionNoSource
}

/// C# `NoSource`.
const regionNoSource: i64 = -9223372036854775807

/// C# `This`: the index standing for `this` in a store summary.
const regionThis: i64 = -1

/// One entry of a C# store summary: `(Source, Target)` and the first place the body stores it (none for a broad callee).
struct StorePair {
    i64       source
    i64       target
    TextSpan? site = null
}

/// One entry of the C# `_loopItems` map: the iterable and its borrow.
struct LoopItem {
    BExpr  iterable
    Borrow borrow
}

// What a value may borrow from: regions, owning locals and, per owner, the position it was lent at.
struct Borrow {
    List<Region>       regions
    List<LocalId>      owners
    Map<LocalId, i64>? lends = null
}

struct Loan {
    LocalId owner
    LocalId holder = -1
    i64     created
    i64     loopEnd
}

struct Mutation {
    LocalId  target
    TextSpan span
    bool     moved   = false
    LocalId  through = -1
}

// One entry of the C# `_restTails` map: a region and the tail its rest parameter names.
struct RestTail {
    Region region
    string tail
}

// The C# `RegionAnalysis` instance state for one function.
struct Regions {
    FuncId                 fn
    FileId                 source
    Map<FieldId, LocalId>  thisFields        = []
    Map<LocalId, Borrow>   locals            = []
    Map<LocalId, i64>      depthOf           = []
    Map<LocalId, i64>      declaredAt        = []
    List<Loan>             loans             = []
    List<Mutation>         mutations         = []
    Map<LocalId, bool>     referentMayBorrow = []
    List<Borrow>           contexts          = []
    List<(i64, i64)>       reported          = []
    List<RestTail>         restTails         = []
    i64                    depth             = 0
    i64                    iteration         = 0
    List<Region>           environments      = []
    bool                   reporting         = false
    /// A by-value loop variable over a list, array, span or map, with the iterable and its borrow: its lists share the element's storage.
    Map<LocalId, LoopItem> loopItems         = []
    /// Set while computing `fn`'s store summary: nothing is reported, and stores into a target are recorded in `pairs`.
    bool                   summary           = false
    List<StorePair>        pairs             = []
    /// The parameters (or `regionThis`) the result may borrow.
    List<i64>              returns           = []
    /// The summary's target parameters, with their index.
    Map<LocalId, i64>      targets           = []
}

// ── The C# immutable sets (Q640): a `List` with no duplicates stands for `ImmutableHashSet`, copied on every change ──

/// C# `Borrow.None`.
Borrow t25None() => Borrow { regions: [], owners: [] }

/// C# `new Borrow([region], [])`.
Borrow t25Region(i64 depth, as string name) {
    var regions = List<Region>()
    regions.append(Region { depth: depth, name: name })
    return Borrow { regions: move regions, owners: [] }
}

/// C# `Borrow.IsEmpty`.
bool t25IsEmpty(Borrow b) => b.regions.length == 0 && b.owners.length == 0

/// A copy of `b`: the C# records are immutable, so sharing one is copying it here.
Borrow t25Copy(Borrow b) {
    var regions = List<Region>()
    for x in b.regions {
        regions.append(x)
    }
    var owners = List<LocalId>()
    for o in b.owners {
        owners.append(o)
    }
    return Borrow { regions: move regions, owners: move owners, lends: t25CopyLends(b.lends) }
}

/// C# `b with { Owners = [] }`.
Borrow t25WithoutOwners(Borrow b) {
    var regions = List<Region>()
    for x in b.regions {
        regions.append(x)
    }
    return Borrow { regions: move regions, owners: [], lends: t25CopyLends(b.lends) }
}

Map<LocalId, i64>? t25CopyLends(Map<LocalId, i64>? lends) {
    if (lends is { } l) {
        var m: Map<LocalId, i64> = []
        for (k, v) in l {
            m[k] = v
        }
        return move m
    }
    return null
}

/// C# `ImmutableHashSet<Region>.Add`.
void t25AddRegion(to ref List<Region> regions, by Region x) {
    for y in regions {
        return if y == x
    }
    regions.append(x)
}

/// C# `ImmutableHashSet<LocalSymbol>.Add`.
void t25AddOwner(to ref List<LocalId> owners, by LocalId x) {
    for y in owners {
        return if y == x
    }
    owners.append(x)
}

// ── RegionAnalysis.cs:31 Borrow.Union, :35 Lent, :38 Merge ───────────────────

Borrow unionBorrow(in Borrow a, by in Borrow b) {
    return t25Copy(a) if t25IsEmpty(b)
    return t25Copy(b) if t25IsEmpty(a)
    var regions = List<Region>()
    for x in a.regions {
        regions.append(x)
    }
    for x in b.regions {
        t25AddRegion(to: ref regions, by: x)
    }
    var owners = List<LocalId>()
    for o in a.owners {
        owners.append(o)
    }
    for o in b.owners {
        t25AddOwner(to: ref owners, by: o)
    }
    return Borrow { regions: move regions, owners: move owners, lends: t25Merge(a.lends, by: b.lends) }
}

Borrow lent(in Borrow b, for LocalId owner, at i64 at) {
    var regions = List<Region>()
    for x in b.regions {
        regions.append(x)
    }
    var owners = List<LocalId>()
    for o in b.owners {
        owners.append(o)
    }
    t25AddOwner(to: ref owners, by: owner)
    var one: Map<LocalId, i64> = []
    one[owner] = at
    let added: Map<LocalId, i64>? = move one
    return Borrow { regions: move regions, owners: move owners, lends: t25Merge(b.lends, by: added) }
}

Map<LocalId, i64>? t25Merge(Map<LocalId, i64>? a, by Map<LocalId, i64>? b) {
    return t25CopyLends(b) if a is null
    return t25CopyLends(a) if b is null
    var result: Map<LocalId, i64> = []
    if (a is { } x) {
        for (k, v) in x {
            result[k] = v
        }
    }
    if (b is { } y) {
        for (owner, at) in y {
            if result.contains(owner) {
                let other = result[owner]
                result[owner] = at < other ? at : other
            } else {
                result[owner] = at
            }
        }
    }
    return move result
}

// ── RegionAnalysis.cs:83 Analyze, :89 Run ────────────────────────────────────

void analyzeRegions(ref Ctx c, for FuncId fn) {
    return if c.functions[fn].file == -1 || c.functions[fn].body == -1
    var r = Regions { fn: fn, source: c.functions[fn].file }
    runRegions(ref r, through: ref c)
}

/// Q31 (plan 014): `analyzeRegions` with its working memory freed. The run is made in an arena; one that reported a
/// diagnostic or filled a `changedFields` memo entry (both arena memory) is undone and made again in `General`, so
/// what `Ctx` keeps, its LocalIds and its order are what a run in `General` gives. For templates only: an instance's
/// run reports into a bag, which `t42Undo` does not cover, so a run with a sink set stays in `General`.
void t42AnalyzeRegions(ref Ctx c, for FuncId fn) {
    if c.sink >= 0 {
        analyzeRegions(ref c, for: fn)
        return
    }
    var undone = false
    let mark = t42Mark(c)
    using let arena = Arena()
    provide allocator: arena {
        analyzeRegions(ref c, for: fn)
        undone = t42Undo(ref c, to: mark)
    }
    if undone {
        analyzeRegions(ref c, for: fn)
    }
}

/// The lengths `t42Undo` truncates back to.
struct T42Mark {
    i64 diagnostics
    i64 locals
    i64 memo
}

T42Mark t42Mark(Ctx c) =>
    T42Mark { diagnostics: c.diagnostics.length, locals: c.locals.length, memo: c.changedFieldsKeys.length }

/// Whether the run since `mark` left arena memory in `Ctx` (a diagnostic or a `changedFields` entry); if so, takes back
/// everything it added (diagnostics, stand-in locals, memo entries). Removing frees nothing, so this is safe before or
/// after the arena ends.
bool t42Undo(ref Ctx c, to T42Mark mark) {
    return false if c.diagnostics.length == mark.diagnostics && c.changedFieldsKeys.length == mark.memo
    while c.diagnostics.length > mark.diagnostics {
        let _ = c.diagnostics.removeLast()
    }
    while c.locals.length > mark.locals {
        let _ = c.locals.removeLast()
    }
    while c.changedFieldsKeys.length > mark.memo {
        let fn = c.changedFieldsKeys.removeLast()
        let _ = c.changedFields.remove(fn)
    }
    return true
}

/// `t41SummaryRun` in an arena, undone (`undone` set) when it filled a `changedFields` entry.
T41Changed t42SummaryInArena(
    ref Ctx c,
    for FuncId fn,
    by i64 known,
    from i64 returned,
    to ref List<StorePair> pairs,
    through ref List<i64> returns
) {
    var flags = T41Changed {}
    let mark = t42Mark(c)
    using let arena = Arena()
    provide allocator: arena {
        flags = t41SummaryRun(ref c, for: fn, by: known, from: returned, to: ref pairs, through: ref returns)
        flags.undone = t42Undo(ref c, to: mark)
    }
    return flags
}

/// Q745: each template's store and return summaries, one least fixpoint from none, recomputed in declaration order until no summary grows.
void summarizeRegions(ref Ctx c) {
    var functions = List<FuncId>()
    for m in 0..c.modules.length {
        let fns = copyIds(c.modules[m].allFunctions)
        for fn in fns {
            if c.functions[fn].file != -1 && c.functions[fn].body != -1 && !functionIsInstance(ref c, by: fn)
                    && (t41HasTargets(ref c, for: fn) || t41MayHold(ref c, for: c.functions[fn].returnType)) {
                functions.append(fn)
            }
        }
    }
    var changed = true
    while changed {
        changed = false
        for fn in functions {
            var known: i64 = 0
            if c.storeSummaries.contains(fn) {
                known = c.storeSummaries[fn].length
            }
            var returned: i64 = 0
            if c.returnSummaries.contains(fn) {
                returned = c.returnSummaries[fn].length
            }
            var pairs = List<StorePair>()
            var returns = List<i64>()
            // Q31 (plans 013, 014): each run is freed with its arena. A list keeps the allocator it was made with, so
            // `pairs`, `returns` and `c.locals` (grown by `fieldLocal`) stay in `General`. A run that filled a `changedFields`
            // memo entry (arena memory) is undone and made again in `General`, in today's order, from empty copies.
            var flags = t42SummaryInArena(
                ref c,
                for: fn,
                by: known,
                from: returned,
                to: ref pairs,
                through: ref returns,
            )
            if flags.undone {
                pairs.clear()
                returns.clear()
                flags = t41SummaryRun(ref c, for: fn, by: known, from: returned, to: ref pairs, through: ref returns)
            }
            let pairsChanged = flags.pairs
            let returnsChanged = flags.returns
            if pairsChanged {
                c.storeSummaries[fn] = move pairs
                changed = true
            }
            if returnsChanged {
                c.returnSummaries[fn] = move returns
                changed = true
            }
        }
    }
}

/// Whether a summary run changed the store pairs and the returns.
struct T41Changed {
    bool pairs   = false
    bool returns = false
    /// Q31 (plan 014): the run was made in an arena and undone (`t42Undo`); it has to be made again in `General`.
    bool undone  = false
}

/// One summary run of `fn`: its store pairs and returns, copied into `pairs` and `returns` when their counts differ from
/// `known` and `returned`; whether each did.
T41Changed t41SummaryRun(
    ref Ctx c,
    for FuncId fn,
    by i64 known,
    from i64 returned,
    to ref List<StorePair> pairs,
    through ref List<i64> returns
) {
    var r = Regions { fn: fn, source: c.functions[fn].file, summary: true }
    runRegions(ref r, through: ref c)
    var pairsChanged = false
    var returnsChanged = false
    if r.pairs.length != known {
        for p in r.pairs {
            pairs.append(p)
        }
        pairsChanged = true
    }
    if r.returns.length != returned {
        for x in r.returns {
            returns.append(x)
        }
        returnsChanged = true
    }
    return T41Changed { pairs: pairsChanged, returns: returnsChanged }
}

/// Whether `fn` has a summary target: a `ref`, `out` or writable `dyn ref` parameter, or a `ref this` receiver, that can hold a borrow.
bool t41HasTargets(ref Ctx c, for FuncId fn) {
    let ps = copyIds(c.functions[fn].parameters)
    for p in ps {
        return true if t41IsTarget(ref c, for: p)
    }
    let owner = c.functions[fn].owner
    return c.functions[fn].isMutating
        && functionHasThis(ref c, by: fn)
        && (owner == -1 || t41MayHold(ref c, for: structTypeOf(owner)))
}

bool t41IsTarget(ref Ctx c, for LocalId p) =>
    (t37RefOrOut(c, for: p) || t37WritableDynRef(c, for: c.locals[p].type)) && t41MayHold(ref c, for: c.locals[p].type)

/// Whether a value of `t` may borrow, counting a type parameter as one that may (a summary covers every instance).
bool t41MayHold(ref Ctx c, for Type t) {
    var seen = List<Type>()
    return mayBorrow(ref c, for: t, by: ref seen) || occurs(ref c, by: t)
}

/// C# `new Borrow([new Region(0, "the caller's data", source)], [])`.
Borrow t41Source(i64 source) {
    var regions = List<Region>()
    regions.append(Region { depth: 0, name: "the caller's data", source: source })
    return Borrow { regions: move regions, owners: [] }
}

void runRegions(ref Regions r, through ref Ctx c) {
    let ps = copyIds(in c.functions[r.fn].parameters)
    // C# `p.Syntax?.Rest`: T12's parameter syntax, one per parameter in order (Q641).
    let syntax = t12Params(in c, for: r.fn)
    for i in 0..ps.length {
        let p = ps[i]
        let type = c.locals[p].type
        // An arena parameter is a handle to the caller's arena: what it allocates outlives the call.
        let callerOwned = c.locals[p].modifier == .refKeyword
            || c.locals[p].modifier == .outKeyword
            || type == builtinType(.arena)
        r.depthOf[p] = callerOwned ? 0 : 1
        r.declaredAt[p] = -1
        // What a parameter points to belongs to the caller; the marker keeps that known after unions.
        if r.summary {
            if t41IsTarget(ref c, for: p) {
                r.targets[p] = i
            }
            if t41MayHold(ref c, for: type) {
                let caller = t25Region(0, as: "the caller's data")
                let own = t41Source(i)
                r.locals[p] = unionBorrow(caller, by: own)
            }
        } else {
            var seen = List<Type>()
            if mayBorrow(ref c, for: type, by: ref seen) {
                r.locals[p] = t25Region(0, as: "the caller's data")
            }
        }
        // A `rest` tail is borrowed for the call only (J62): it lives in the caller's frame for this statement.
        if (syntax[i].syntax is { } x) && x.isRest && kindOf(type) == .span {
            let tail = Region { depth: 1, name: $"`{c.locals[p].name}`" }
            t25SetRestTail(ref r, for: tail, to: c.locals[p].name)
            r.locals[p] = t25Region(1, as: $"`{c.locals[p].name}`")
        }
    }
    // The first pass collects what each local may borrow (a loop can store into a local
    // after its first use); the second reports against the complete picture.
    let body = c.functions[r.fn].body
    stmtRegions(ref r, through: ref c, for: body)
    r.reporting = true
    stmtRegions(ref r, through: ref c, for: body)
    if !r.summary {
        checkMutations(ref r, through: ref c)
    }
}

/// C# `_restTails[tail] = name`.
void t25SetRestTail(ref Regions r, for Region tail, to string name) {
    for k in 0..r.restTails.length {
        if r.restTails[k].region == tail {
            r.restTails[k].tail = name
            return
        }
    }
    r.restTails.append(RestTail { region: tail, tail: name })
}

// ── Statements: RegionAnalysis.cs:117 Stmt, :229 Iterate, :237 Declare ───────

void stmtRegions(ref Regions r, through ref Ctx c, for BStmt s) {
    let i = boundIndex(s)
    switch boundKind(s) {
        case .block:
            r.depth += 1
            let sts = copyIds(in c.bBlocks[i].statements)
            for st in sts {
                stmtRegions(ref r, through: ref c, for: st)
            }
            r.depth -= 1
        case .localDecl:
            let local = c.bLocalDecls[i].local
            let init = c.bLocalDecls[i].initializer
            declareBorrow(ref r, through: ref c, for: local, at: c.bLocalDecls[i].span.start)
            if init != -1 {
                let value = exprRegions(ref r, through: ref c, for: init)
                storeBorrow(ref r, through: ref c, for: local, by: in value, at: nodeSpan(in c, for: init))
                referBorrow(ref r, through: ref c, for: local, by: init)
            }
        case .exprStmt:
            let _ = exprRegions(ref r, through: ref c, for: c.bExprStmts[i].expr)
        case .assertStmt:
            let _ = exprRegions(ref r, through: ref c, for: c.bAsserts[i].condition)
        case .assign:
            let target = c.bAssigns[i].target
            let valueExpr = c.bAssigns[i].value
            let value = exprRegions(ref r, through: ref c, for: valueExpr)
            let _ = exprRegions(ref r, through: ref c, for: target)
            storeIntoBorrow(ref r, through: ref c, for: target, by: in value, at: nodeSpan(in c, for: valueExpr))
            if boundKind(target) == .local {
                referBorrow(ref r, through: ref c, for: c.bLocals[boundIndex(target)].local, by: valueExpr)
            }
        case .returnStmt:
            let valueExpr = c.bReturns[i].value
            if valueExpr != -1 {
                let value = exprRegions(ref r, through: ref c, for: valueExpr)
                checkReturn(ref r, through: ref c, for: in value, at: nodeSpan(in c, for: valueExpr))
            }
        case .failStmt:
            let _ = exprRegions(ref r, through: ref c, for: c.bFails[i].error)
        case .ifStmt:
            let then = c.bIfs[i].then
            let elseBranch = c.bIfs[i].elseBranch
            let _ = exprRegions(ref r, through: ref c, for: c.bIfs[i].condition)
            stmtRegions(ref r, through: ref c, for: then)
            if elseBranch != -1 {
                stmtRegions(ref r, through: ref c, for: elseBranch)
            }
        case .whileStmt:
            let body = c.bWhiles[i].body
            let _ = exprRegions(ref r, through: ref c, for: c.bWhiles[i].condition)
            iterateRegions(ref r, through: ref c, at: r.depth + 1, for: body)
        case .doWhile:
            let condition = c.bDoWhiles[i].condition
            iterateRegions(ref r, through: ref c, at: r.depth + 1, for: c.bDoWhiles[i].body)
            let _ = exprRegions(ref r, through: ref c, for: condition)
        case .forStmt:
            t25For(ref r, through: ref c, for: s)
        case .switchStmt:
            let value = exprRegions(ref r, through: ref c, for: c.bSwitches[i].value)
            for k in 0..c.bSwitches[i].sections.length {
                r.depth += 1
                let pattern = c.bSwitches[i].sections[k].pattern
                let guard = c.bSwitches[i].sections[k].guard
                let body = copyIds(in c.bSwitches[i].sections[k].body)
                if pattern != -1 {
                    t37BindPattern(ref r, through: ref c, for: pattern, by: in value)
                }
                if guard != -1 {
                    let _ = exprRegions(ref r, through: ref c, for: guard)
                }
                for st in body {
                    stmtRegions(ref r, through: ref c, for: st)
                }
                r.depth -= 1
            }
        case .deferStmt:
            stmtRegions(ref r, through: ref c, for: c.bDefers[i].body)
        case .errdeferStmt:
            let body = c.bErrdefers[i].body
            if c.bErrdefers[i].error != -1 {
                declareBorrow(ref r, through: ref c, for: c.bErrdefers[i].error, at: c.bErrdefers[i].span.start)
            }
            stmtRegions(ref r, through: ref c, for: body)
        case .panicDefer:
            let body = c.bPanicDefers[i].body
            if c.bPanicDefers[i].panic != -1 {
                declareBorrow(ref r, through: ref c, for: c.bPanicDefers[i].panic, at: c.bPanicDefers[i].span.start)
            }
            stmtRegions(ref r, through: ref c, for: body)
        case .contextStmt:
            let body = c.bContexts[i].body
            r.contexts.append(allocatedFrom(ref r, through: ref c, for: c.bContexts[i].allocator))
            stmtRegions(ref r, through: ref c, for: body)
            r.contexts.remove(at: r.contexts.length - 1)
        default:
            return
    }
}

/// The C# `case BoundFor f:` arm of `Stmt`.
void t25For(ref Regions r, through ref Ctx c, for BStmt s) {
    let i = boundIndex(s)
    let variable = c.bFors[i].variable
    let iterableExpr = c.bFors[i].iterable
    let body = c.bFors[i].body
    let span = c.bFors[i].span
    let user = c.bFors[i].userIteration is not null
    let iterable = exprRegions(ref r, through: ref c, for: iterableExpr)
    let iterableType = exprType(in c, for: iterableExpr)
    let kind = kindOf(iterableType)
    // The loop reads the collection on every iteration: it holds a loan on it.
    if r.reporting {
        var owners = List<LocalId>()
        for o in iterable.owners {
            owners.append(o)
        }
        var root = rootLocal(ref c, for: iterableExpr)
        if root == -1 {
            root = thisField(ref r, through: ref c, for: iterableExpr)
        }
        if root != -1 && (kind == .list || kind == .map || kind == .array || user) {
            t25AddOwner(to: ref owners, by: root)
        }
        for owner in owners {
            r.loans.append(Loan { owner: owner, holder: -1, created: span.start, loopEnd: span.end })
        }
    }
    r.depth += 1
    declareBorrow(ref r, through: ref c, for: variable, at: span.start)
    // A `dyn ref` variable points into an array or list, like `dyn ref I d = xs[i]`, or where a span points; any other is a copy.
    let dynRef = kindOf(c.locals[variable].type) == .dynRef
    let iterableSpan = nodeSpan(in c, for: iterableExpr)
    var item = t25None()
    if !dynRef {
        item = t25WithoutOwners(iterable)
    } else if kind is .list or .array {
        item = lendBorrow(ref r, through: ref c, for: iterableExpr, by: in iterable, at: iterableSpan.end)
    } else if kind == .span {
        item = t25Copy(iterable)
    } else {
        item = t25WithoutOwners(iterable)
    }
    storeBorrow(ref r, through: ref c, for: variable, by: in item, at: iterableSpan)
    // The item is a shallow copy the loop never frees, and `BorrowsSubject` refuses changing it (BYN2783).
    // coverage-exempt: Q746
    if !user && !dynRef && c.locals[variable].borrowsSubject && (kind is .list or .array or .span or .map) {
        r.loopItems[variable] = LoopItem { iterable: iterableExpr, borrow: t25Copy(iterable) }
    }
    if dynRef {
        var seen = List<Type>()
        var may = true
        switch kind {
            case .list: may = mayBorrow(ref c, for: c.listTypes[typeIndex(iterableType)], by: ref seen)
            case .array: may = mayBorrow(ref c, for: c.arrayTypes[typeIndex(iterableType)].element, by: ref seen)
            case .span: may = mayBorrow(ref c, for: c.spanTypes[typeIndex(iterableType)].element, by: ref seen)
            default: may = true
        }
        r.referentMayBorrow[variable] = may
    }
    iterateRegions(ref r, through: ref c, at: r.depth, for: body)
    r.depth -= 1
}

void iterateRegions(ref Regions r, through ref Ctx c, at i64 depth, for BStmt body) {
    let outer = r.iteration
    r.iteration = depth
    stmtRegions(ref r, through: ref c, for: body)
    r.iteration = outer
}

void declareBorrow(ref Regions r, through ref Ctx c, for LocalId local, at i64 position) {
    r.depthOf[local] = r.depth
    r.declaredAt[local] = position
}

// ── Expressions: RegionAnalysis.cs:245 Expr, :251 Compute, :367 Builtin ──────

Borrow exprRegions(ref Regions r, through ref Ctx c, for BExpr e) {
    let result = computeBorrow(ref r, through: ref c, for: e)
    var seen = List<Type>()
    let type = exprType(c, for: e)
    return move result if mayBorrow(ref c, for: type, by: ref seen) || r.summary && occurs(ref c, by: type)
    return t25None()
}

Borrow computeBorrow(ref Regions r, through ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            let local = c.bLocals[i].local
            return t25Copy(r.locals[local]) if r.locals.contains(local)
            return t25None()
        case .thisRef:
            return t41Source(regionThis) if r.summary
            return t25None()
        case .literal or .defaultValue or .errorVariant or .enumMember or .enumValues or .staticArray:
            return t25None()
        case .conversion:
            let operandExpr = c.bConversions[i].operand
            let kind = c.bConversions[i].kind
            let span = c.bConversions[i].span
            // A `dyn ref` to a span element points where the span points: it borrows what the span borrows.
            if kind == .toDynRef && boundKind(operandExpr) == .index {
                let target = c.bIndexes[boundIndex(operandExpr)].target
                let index = c.bIndexes[boundIndex(operandExpr)].index
                if kindOf(exprType(in c, for: target)) == .span {
                    let spanBorrow = exprRegions(ref r, through: ref c, for: target)
                    let _ = exprRegions(ref r, through: ref c, for: index)
                    return move spanBorrow
                }
            }
            let operand = exprRegions(ref r, through: ref c, for: operandExpr)
            return lendBorrow(
                ref r,
                through: ref c,
                for: operandExpr,
                by: in operand,
                at: span.end,
            ) if kind is .arrayToSpan
                or .listToSpan
                or .toDynRef
            return move operand
        case .moveExpr:
            // The new owner may grow or free the storage: a move ends every borrow into it.
            let operandExpr = c.bMoves[i].operand
            let span = c.bMoves[i].span
            let operand = exprRegions(ref r, through: ref c, for: operandExpr)
            let operandEnd = nodeSpan(in c, for: operandExpr).end
            mutateBorrow(
                ref r,
                through: ref c,
                for: operandExpr,
                at: TextSpan.fromBounds(span.start, until: span.end > operandEnd ? span.end : operandEnd),
                moved: true,
            )
            return move operand
        case .builtinCall:
            return builtinBorrow(ref r, through: ref c, for: e)
        case .call:
            return callBorrow(ref r, through: ref c, for: e)
        case .slice:
            let targetExpr = c.bSlices[i].target
            let start = c.bSlices[i].start
            let end = c.bSlices[i].end
            let span = c.bSlices[i].span
            let target = exprRegions(ref r, through: ref c, for: targetExpr)
            if start != -1 {
                let _ = exprRegions(ref r, through: ref c, for: start)
            }
            if end != -1 {
                let _ = exprRegions(ref r, through: ref c, for: end)
            }
            let kind = kindOf(exprType(in c, for: targetExpr))
            return lendBorrow(ref r, through: ref c, for: targetExpr, by: in target, at: span.end) if kind is .list
                or .array
            return move target
        case .index:
            // The element is a copy: it may point where the collection's data points, but not into the collection.
            let index = c.bIndexes[i].index
            let target = exprRegions(ref r, through: ref c, for: c.bIndexes[i].target)
            let _ = exprRegions(ref r, through: ref c, for: index)
            return t25WithoutOwners(target)
        case .spread:
            // Like an index: the elements are copies of what the sequence holds.
            let operand = exprRegions(ref r, through: ref c, for: c.bSpreads[i].operand)
            return t25WithoutOwners(operand)
        case .stackalloc:
            let span = c.bStackallocs[i].span
            return t25Region(r.depth, as: $"the `stackalloc` buffer on line {lineOf(ref r, through: ref c, at: span)}")
        case .collection:
            let elementExprs = copyIds(in c.bCollections[i].elements)
            let type = c.bCollections[i].type
            let span = c.bCollections[i].span
            var elements = t25None()
            for el in elementExprs {
                let b = exprRegions(ref r, through: ref c, for: el)
                elements = unionBorrow(in elements, by: in b)
            }
            switch kindOf(type) {
                case .span:
                    let literal = t25Region(
                        r.depth,
                        as: $"the array literal on line {lineOf(ref r, through: ref c, at: span)}",
                    )
                    return unionBorrow(in elements, by: in literal)
                case .list or .map:
                    return unionBorrow(in elements, by: in r.contexts[r.contexts.length - 1]) if r.contexts.length > 0
                    return move elements
                default:
                    return move elements
            }
        case .interpolated:
            // The text is a copy formatted into `context.allocator`: it borrows that, not its holes (Q43).
            var values = List<BExpr>()
            for part in c.bInterpolateds[i].parts {
                if part.value != -1 {
                    values.append(part.value)
                }
            }
            for v in values {
                let _ = exprRegions(ref r, through: ref c, for: v)
            }
            return t25Copy(r.contexts[r.contexts.length - 1]) if r.contexts.length > 0
            return t25None()
        case .jump:
            stmtRegions(ref r, through: ref c, for: c.bJumps[i].jump)
            return t25None()
        case .blockExpr:
            stmtRegions(ref r, through: ref c, for: c.bBlockExprs[i].block)
            return t25None()
        case .isExpr:
            let pattern = c.bIses[i].pattern
            let value = exprRegions(ref r, through: ref c, for: c.bIses[i].value)
            t37BindPattern(ref r, through: ref c, for: pattern, by: in value)
            return t25None()
        case .switchExpr:
            let value = exprRegions(ref r, through: ref c, for: c.bSwitchExprs[i].value)
            var result = t25None()
            for k in 0..c.bSwitchExprs[i].arms.length {
                let pattern = c.bSwitchExprs[i].arms[k].pattern
                let guard = c.bSwitchExprs[i].arms[k].guard
                let armValue = c.bSwitchExprs[i].arms[k].value
                t37BindPattern(ref r, through: ref c, for: pattern, by: in value)
                if guard != -1 {
                    let _ = exprRegions(ref r, through: ref c, for: guard)
                }
                let b = exprRegions(ref r, through: ref c, for: armValue)
                result = unionBorrow(in result, by: in b)
            }
            return move result
        case .catchExpr:
            let binding = c.bCatches[i].binding
            let handler = c.bCatches[i].handler
            let span = c.bCatches[i].span
            let operand = exprRegions(ref r, through: ref c, for: c.bCatches[i].operand)
            if binding != -1 {
                declareBorrow(ref r, through: ref c, for: binding, at: span.start)
            }
            let handled = exprRegions(ref r, through: ref c, for: handler)
            return unionBorrow(in operand, by: in handled)
        case .lambda:
            // A lambda borrows what its captures borrow, and its captures live in this frame,
            // overwritten by each iteration of the loop that creates it.
            let captureExprs = copyIds(in c.bLambdas[i].captures)
            let span = c.bLambdas[i].span
            var captures = t25None()
            for capture in captureExprs {
                let b = exprRegions(ref r, through: ref c, for: capture)
                captures = unionBorrow(in captures, by: in b)
            }
            return move captures if captureExprs.length == 0
            let environment = Region {
                depth: r.iteration > 1 ? r.iteration : 1,
                name: $"the lambda on line {lineOf(ref r, through: ref c, at: span)}",
            }
            t25AddRegion(to: ref r.environments, by: environment)
            let own = t25Region(environment.depth, as: environment.name)
            return unionBorrow(in captures, by: in own)
        default:
            var result = t25None()
            for child in children(in c, for: e) {
                // coverage-exempt: Q746
                if child != -1 && isExprKind(boundKind(child)) {
                    let b = exprRegions(ref r, through: ref c, for: child)
                    result = unionBorrow(in result, by: in b)
                }
            }
            return move result
    }
}

Borrow builtinBorrow(ref Regions r, through ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    let receiverExpr = c.bBuiltinCalls[i].receiver
    let argExprs = copyIds(in c.bBuiltinCalls[i].arguments)
    let member = c.bBuiltinCalls[i].member
    let span = c.bBuiltinCalls[i].span
    let receiver = exprRegions(ref r, through: ref c, for: receiverExpr)
    var args = List<Borrow>()
    for a in argExprs {
        args.append(exprRegions(ref r, through: ref c, for: a))
    }
    let stored = t41BuiltinStore(member)
    // coverage-exempt: Q746
    if stored != -1 && stored < args.length {
        storeIntoBorrow(
            ref r,
            through: ref c,
            for: receiverExpr,
            by: args[stored],
            at: nodeSpan(c, for: argExprs[stored]),
        )
    }
    // `finish()` points into the buffer's storage, which outlives the local: a loan on it, but not its scope.
    if member == .strBufAsString && hasSyntax(c, for: e, by: syntaxCall) {
        let buffer = rootLocal(ref c, for: receiverExpr)
        return lent(receiver, for: buffer, at: span.end) if buffer != -1
    }
    switch member {
        case .listAsSpan or .arrayAsSpan or .strBufAsString or .listMutableSpan or .arrayMutableSpan:
            return lendBorrow(ref r, through: ref c, for: receiverExpr, by: in receiver, at: span.end)
        default:
            break
    }
    // C# `case … when b.Arguments.Length > 0`: with no argument the member falls to the cases below.
    switch member {
        case .spanCopy or .stringCopy or .listCopy or .mapCopy or .strBufCopy:
            return allocatedFrom(ref r, through: ref c, for: argExprs[0]) if argExprs.length > 0
        default:
            break
    }
    switch member {
        case .ioReadAll or .intToString or .stringCopy or .stringLowercased or .stringUppercased
            or .stringReplaced or .stringRepeated or .stringJoined or .utf16Copy
            or .stringPadded or .bytesToString or .spanCopy or .listCopy:
            // Fresh text from `context.allocator`, like `Io.readText`.
            return t25Copy(r.contexts[r.contexts.length - 1]) if r.contexts.length > 0
            return t25None()
        case .listReplace or .listAdd:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25None()
        case .mapIndexSet or .mapSlot:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25WithoutOwners(receiver)
        case .listTake or .mapTake or .strBufTake or .optionalTake:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span, moved: true)
            return move receiver
        case .listRemoveLast:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25WithoutOwners(receiver)
        case .mapIndex or .mapTryGet or .listTryGet:
            return t25WithoutOwners(receiver)
        // An interned `Symbol`'s text lives until exit, like a literal.
        case .mapLength or .mapContains or .symbolText:
            return t25None()
        case .mapRemove or .mapClear or .listRemoveRange or .listRemoveThrough or .listRemoveAt
            or .listRemoveAtRange or .listSort:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25None()
        case .listClear or .strBufClear or .strBufInsert or .arenaReset:
            mutateBorrow(ref r, through: ref c, for: receiverExpr, at: span)
            return t25None()
        default:
            var acc = t25Copy(receiver)
            for a in args {
                acc = unionBorrow(in acc, by: in a)
            }
            return move acc
    }
}

/// The builtins' store summaries: the argument each stores into its receiver, or -1. Every other builtin stores none:
/// a `StrBuf` append or insert copies the text, `copy(to:)` copies into the arena, formatting copies.
i64 t41BuiltinStore(BuiltinMember member) {
    switch member {
        case .listAdd: return 0
        case .listReplace: return 1
        case .mapIndexSet: return 0
        case .mapSlot: return 0
        default: return -1
    }
}
== semantics/region2.byn
// T37: RegionAnalysis.cs 418-881 (calls, stores, mutations, last-use, reporting).

// ── Borrow and set helpers (C# `ImmutableHashSet` / `HashSet` operations) ────

Borrow t37CopyBorrow(in Borrow b) {
    var regions = List<Region>()
    for x in b.regions {
        regions.append(Region { depth: x.depth, name: x.name, source: x.source })
    }
    let owners = copyIds(in b.owners)
    if (b.lends is { } lends) {
        var copied: Map<LocalId, i64> = []
        for (k, v) in lends {
            copied[k] = v
        }
        return Borrow { regions: move regions, owners: move owners, lends: move copied }
    }
    return Borrow { regions: move regions, owners: move owners }
}

bool t37HasRegion(in List<Region> regions, for in Region region) {
    for x in regions {
        // coverage-exempt: Q746
        return true if x.depth == region.depth && x.name == region.name && x.source == region.source
    }
    return false
}

bool t37HasId(in List<i64> xs, for i64 x) {
    for y in xs {
        return true if y == x
    }
    return false
}

/// C# `HashSet.UnionWith`: appends each of `xs` not yet in `into`.
void t37UnionIds(ref List<i64> into, by in List<i64> xs) {
    for x in xs {
        if !t37HasId(in into, for: x) {
            into.append(x)
        }
    }
}

bool t37WritableDynRef(in Ctx c, for Type t) => kindOf(t) == .dynRef && !c.dynRefTypes[typeIndex(t)].readOnly

bool t37RefOrOut(in Ctx c, for LocalId p) => c.locals[p].modifier is .refKeyword or .outKeyword

bool t37SpanOrDynRef(Type t) => kindOf(t) == .span || kindOf(t) == .dynRef

// ── Calls ────────────────────────────────────────────────────────────────────

Borrow callBorrow(ref Regions r, through ref Ctx c, for BExpr call) {
    let ci = boundIndex(call)
    let fn = c.bCalls[ci].function
    let recv = c.bCalls[ci].receiver
    let span = c.bCalls[ci].span
    let callType = c.bCalls[ci].type
    let arguments = copyIds(c.bCalls[ci].arguments)
    let parameters = copyIds(c.functions[fn].parameters)
    var receiver = Borrow { regions: [], owners: [] }
    if recv != -1 {
        receiver = exprRegions(ref r, through: ref c, for: recv)
    }
    var args = List<Borrow>()
    for a in arguments {
        args.append(exprRegions(ref r, through: ref c, for: a))
    }
    let mutating = c.functions[fn].isMutating
    // A method that writes `this` modifies its receiver, like a write to one of its fields (Q78).
    if recv != -1 && mutating {
        mutateBorrow(ref r, through: ref c, for: recv, at: span)
    }
    // Through a writable `dyn ref` it modifies every owner the `dyn ref` borrows.
    if recv != -1 && t37WritableDynRef(in c, for: exprType(in c, for: recv)) && mutating {
        mutateOwners(ref r, through: ref c, for: recv, by: in receiver, at: span)
    }
    // A `ref this` call on `this` changes the fields its body changes structurally.
    if recv != -1 && boundKind(recv) == .thisRef && mutating && r.reporting {
        let fields = changedFields(ref r, through: ref c, for: fn)
        for field in fields {
            let local = fieldLocal(ref r, through: ref c, for: field)
            r.mutations.append(Mutation { target: local, span: span })
        }
    }
    var i: i64 = 0
    while i < arguments.length && i < parameters.length {
        let argument = arguments[i]
        let argSpan = nodeSpan(in c, for: argument)
        // An existing writable `dyn ref` passed on lets the callee modify every owner it borrows.
        let toDynRef = boundKind(argument) == .conversion && c.bConversions[boundIndex(argument)].kind == .toDynRef
        if t37WritableDynRef(in c, for: c.locals[parameters[i]].type)
                && t37WritableDynRef(in c, for: exprType(in c, for: argument))
                && !toDynRef {
            mutateOwners(ref r, through: ref c, for: argument, by: in args[i], at: argSpan)
        }
        let written = writtenArgument(in c, for: parameters[i], by: argument)
        if written == -1 {
            i += 1
            continue
        }
        // Writing an element through `ref xs[i]` does not reallocate `xs`; only what the callee can reach may change.
        var seen = List<Type>()
        if mayBorrow(ref c, for: exprType(in c, for: written), by: ref seen) {
            mutateBorrow(ref r, through: ref c, for: written, at: argSpan)
        }
        // `ref this` hands over the whole receiver: the callee may change any of its fields.
        var seenThis = List<Type>()
        // coverage-exempt: Q746
        if boundKind(written) == .thisRef
                && mayBorrow(ref c, for: exprType(in c, for: written), by: ref seenThis)
                && r.reporting
                && c.functions[r.fn].owner != -1 {
            let ownerFields = copyIds(in c.structs[c.functions[r.fn].owner].fields)
            for field in ownerFields {
                let local = fieldLocal(ref r, through: ref c, for: field)
                r.mutations.append(Mutation { target: local, span: argSpan })
            }
        }
        // Only a `ref` or `out` argument is passed by `ref` (BYN3005).
        let root = written != argument ? -1 : rootLocal(ref c, for: written)
        if root == -1 {
            i += 1
            continue
        }
        for j in 0..arguments.length {
            // A by-value copy of an element (`xs[0]` as an `i64`) cannot alias what the callee changes.
            // coverage-exempt: Q746
            let byRef = j < parameters.length && t37RefOrOut(in c, for: parameters[j])
            var seenJ = List<Type>()
            continue if j == i
                || !(rootLocal(
                    ref c,
                    for: arguments[j],
                ) == root && (byRef || mayBorrow(ref c, for: exprType(in c, for: arguments[j]), by: ref seenJ))
                    || t37HasId(in args[j].owners, for: root))
            let name = c.locals[root].name
            regionReport(
                ref r,
                through: ref c,
                for: .refAndValue,
                at: nodeSpan(in c, for: arguments[j]),
                by: (name, "", "", "", ""),
                label: $"`{name}` is also passed by `ref`",
                help: "copy the value into a local first, or make two calls",
            )
            break
        }
        i += 1
    }
    // What the callee may store from one argument (or its receiver) into another, by its summary.
    let template = templateOf(ref c, for: fn) ?? fn
    let stores = t41Stores(ref c, for: fn, by: call)
    for pair in stores {
        var target: BExpr = -1
        if pair.target == regionThis {
            // coverage-exempt: Q746
            if mutating {
                target = recv
            }
            // coverage-exempt: Q746
        } else if pair.target < arguments.length && pair.target < parameters.length {
            target = writtenArgument(c, for: parameters[pair.target], by: arguments[pair.target])
        }
        continue if target == -1
        var seenTarget = List<Type>()
        continue if !mayBorrow(ref c, for: exprType(c, for: target), by: ref seenTarget)
        var source = Borrow { regions: [], owners: [] }
        if pair.source == regionThis {
            source = t37CopyBorrow(receiver)
            // coverage-exempt: Q746
        } else if pair.source < args.length {
            source = t37CopyBorrow(args[pair.source])
        }
        var note: Related? = null
        // coverage-exempt: Q746
        if (pair.site is { } at) && c.functions[template].file != -1 && c.functions[template].file == r.source {
            let callee = c.functions[template].name
            note = Related {
                span: at,
                label: $"`{callee}` stores `{t41ParameterName(c, for: template, at: pair.source)}` into `{t41ParameterName(c, for: template, at: pair.target)}` here",
            }
        }
        t41StoreIntoBorrow(ref r, through: ref c, for: target, by: source, at: span, note: note)
    }
    // A callee with a body borrows what its return summary names; a builtin what its table entry names; any other, every argument (rule 4).
    // A function value's environment is not one, since no function type can be returned (BYN2822); what its captures borrow is (spec 007 R10).
    let builtin = c.functions[fn].builtin
    // C# `returned is not null`, and the set it names.
    var named = true
    var returned = List<i64>()
    if builtin != .none {
        named = t41BuiltinFresh(builtin)
    } else if t41IsBroad(c, for: fn) || c.functions[template].body == -1 {
        named = false
    } else if c.returnSummaries.contains(template) {
        returned = copyIds(c.returnSummaries[template])
    }
    var result = Borrow { regions: [], owners: [] }
    if !named || t37HasId(returned, for: regionThis) {
        result = t37CopyBorrow(receiver)
    }
    for k in 0..args.length {
        // coverage-exempt: Q746
        continue if named && k < parameters.length && !t37HasId(returned, for: k)
        if k < parameters.length && kindOf(c.locals[parameters[k]].type) == .function {
            var a = t37CopyBorrow(args[k])
            var kept = List<Region>()
            for x in args[k].regions {
                if !t37HasRegion(r.environments, for: x) {
                    kept.append(x)
                }
            }
            a.regions = move kept
            @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
            result = unionBorrow(result, by: a)
            // coverage-exempt: Q746
        } else if named && k < arguments.length && exprType(c, for: arguments[k]) == builtinType(.arena) {
            // An arena argument the result may borrow lends its memory, as `copy(to:)` does.
            let a = t41AllocatedFrom(ref r, through: ref c, for: arguments[k], by: args[k])
            result = unionBorrow(result, by: a)
        } else {
            @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
            result = unionBorrow(result, by: args[k])
        }
    }
    // A method returning a span or `dyn ref` may lend its own fields' storage: the result borrows the receiver.
    if recv != -1 && t37SpanOrDynRef(callType) {
        let lentReceiver = lendBorrow(ref r, through: ref c, for: recv, by: in receiver, at: span.end)
        @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
        result = unionBorrow(in result, by: in lentReceiver)
    }
    // So may a function returning one: the result lives no longer than any argument passed by `ref` (`in` is by value),
    // and borrows the storage of those with storage to lend.
    if t37SpanOrDynRef(callType) {
        var k: i64 = 0
        while k < arguments.length && k < parameters.length {
            if t37RefOrOut(in c, for: parameters[k]) {
                let lentArg = lendBorrow(ref r, through: ref c, for: arguments[k], by: in args[k], at: span.end)
                var seen = List<Type>()
                if mayLend(ref c, for: exprType(in c, for: arguments[k]), by: ref seen) {
                    @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
                    result = unionBorrow(in result, by: in lentArg)
                } else {
                    var regions = List<Region>()
                    for x in lentArg.regions {
                        regions.append(Region { depth: x.depth, name: x.name, source: x.source })
                    }
                    let bare = Borrow { regions: move regions, owners: [] }
                    @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
                    result = unionBorrow(in result, by: in bare)
                }
            }
            k += 1
        }
    }
    // Allocated from `context.allocator`: a list, an `Owned`, a growable `StrBuf`, or the text `Io.readText`, `Io.run` and `Utf8.decode` return (Q29).
    var seenList = List<Type>()
    if r.contexts.length > 0
            && (containsList(
                ref c,
                for: callType,
                by: ref seenList,
            )
            || builtin == .ioReadText
            || builtin == .ioRun
            || builtin == .ioRunBatch
            || builtin == .strBufGrow
            || builtin == .strBufOver
            || builtin == .utf8Decode
            || builtin == .utf8TryDecode
            || builtin == .utf8DecodeReplace
            || builtin == .hexEncode
            || builtin == .envGet || builtin == .fsRealPath
            || builtin == .pathRelative
            || builtin == .pathFileName
            || builtin == .pathDirectoryName
            || builtin == .pathCombine
            || builtin == .pathCombineSpan
            || builtin == .pathFullPath) {
        result = unionBorrow(in result, by: in r.contexts[r.contexts.length - 1])
    }
    return result
}

/// The (source, target) pairs a call of `fn` may store, a fixed order, with where its body does so. A function value,
/// an interface method or an `extern` function has no body to summarise: every argument and the receiver may go into every written one.
List<StorePair> t41Stores(ref Ctx c, for FuncId fn, by BExpr call) {
    let ci = boundIndex(call)
    let arguments = copyIds(c.bCalls[ci].arguments)
    let parameters = copyIds(c.functions[fn].parameters)
    var result = List<StorePair>()
    if t41IsBroad(c, for: fn) {
        var targets = List<i64>()
        var i: i64 = 0
        // coverage-exempt: Q746
        while i < arguments.length && i < parameters.length {
            if writtenArgument(c, for: parameters[i], by: arguments[i]) != -1 {
                targets.append(i)
            }
            i += 1
        }
        // coverage-exempt: Q746
        if c.functions[fn].isMutating && c.bCalls[ci].receiver != -1 {
            targets.append(regionThis)
        }
        var sources = List<i64>()
        for k in 0..arguments.length {
            sources.append(k)
        }
        sources.append(regionThis)
        for t in targets {
            for s in sources {
                if s != t {
                    result.append(StorePair { source: s, target: t })
                }
            }
        }
        return result
    }
    let template = templateOf(ref c, for: fn) ?? fn
    return result if !c.storeSummaries.contains(template)
    // C# `OrderBy(Target).ThenBy(Source)`: stable, so each pair goes after every pair not ordered after it.
    for p in c.storeSummaries[template] {
        var at = result.length
        for j in 0..result.length {
            if p.target < result[j].target || (p.target == result[j].target && p.source < result[j].source) {
                at = j
                break
            }
        }
        // `List` has no `insert`: append, then shift the tail up by one.
        result.append(p)
        var j = result.length - 1
        while j > at {
            result[j] = result[j - 1]
            j -= 1
        }
        result[at] = p
    }
    return result
}

/// A function value, an interface method or an `extern` function: no body to summarise.
bool t41IsBroad(Ctx c, for FuncId fn) =>
    // coverage-exempt: Q746
    c.functions[fn].kind == .invoke || c.functions[fn].isAbstract || (c.functions[fn].modifiers & 128) != 0 // the parser's `modifierExtern`

/// The builtin functions' return summaries: whether the builtin's result borrows no argument (an entry, always empty). `Io` results and
/// decoded or encoded text are fresh copies, and an interned `Symbol` lives until exit. Every other builtin's result borrows every argument (rule 4).
bool t41BuiltinFresh(BuiltinFunction builtin) =>
    builtin is .ioReadFile
    or .ioStdinReadAllBytes
    or .ioReadText
    or .ioListDir
    or .ioRun
    or .ioRunBatch
    or .utf8Decode
    or .utf8TryDecode
    or .utf8DecodeReplace
    or .stringInvalidUtf8At
    or .hexEncode
    or .hexDecode
    or .envGet
    or .fsRealPath
    or .symbolIntern
    or .pathRelative
    or .pathFileName
    or .pathDirectoryName
    or .pathCombine
    or .pathCombineSpan
    or .pathFullPath

string t41ParameterName(Ctx c, for FuncId fn, at i64 index) =>
    index == regionThis ? "this" : c.locals[c.functions[fn].parameters[index]].name

/// A borrow of `source`'s own storage (a span of an array or list, a `StrBuf`'s text), taken at `at`.
Borrow lendBorrow(ref Regions r, through ref Ctx c, for BExpr source, by in Borrow sourceBorrow, at i64 at) {
    return t37CopyBorrow(in sourceBorrow) if boundKind(source) == .staticArray
    var b = t37CopyBorrow(in sourceBorrow)
    // Inside a method returning a span or `dyn ref`, its own fields are the caller's data; the call site lends the receiver (Q75).
    // Either way it is a loan on that field: changing it structurally invalidates the borrow.
    let field = thisField(ref r, through: ref c, for: source)
    @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
    if field != -1 {
        b = lent(in b, for: field, at: at)
    }
    if t37SpanOrDynRef(c.functions[r.fn].returnType) && isThisRooted(in c, for: source) {
        let caller = Borrow { regions: [Region { depth: 0, name: "the caller's data" }], owners: [] }
        @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
        return unionBorrow(in b, by: in caller)
    }
    // In any other method they outlive the whole body, but cannot be returned.
    if isThisRooted(in c, for: source) {
        let temporary = Borrow {
            regions: [
                Region {
                    depth: 1,
                    name: $"the temporary on line {lineOf(ref r, through: ref c, at: nodeSpan(in c, for: source))}",
                },
            ],
            owners: [],
        }
        @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
        return unionBorrow(in b, by: in temporary)
    }
    let root = rootLocal(ref c, for: source)
    if root != -1 {
        // A list in a loop item is the iterable's: lend what the iterable lends (a span already names where it points).
        if kindOf(exprType(c, for: source)) == .list && r.loopItems.contains(root) {
            let iterable = r.loopItems[root].iterable
            let joined = unionBorrow(b, by: r.loopItems[root].borrow)
            return joined if kindOf(exprType(c, for: iterable)) == .span
            return lendBorrow(ref r, through: ref c, for: iterable, by: joined, at: at)
        }
        let depth = r.depthOf.tryGet(at: root) ?? 0
        if depth > 0 {
            let region = Region { depth: depth, name: $"`{c.locals[root].name}`" }
            if !t37HasRegion(in b.regions, for: in region) {
                b.regions.append(region)
            }
        }
        @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
        return lent(in b, for: root, at: at)
    }
    let temporary = Borrow {
        regions: [
            Region {
                depth: r.depth,
                name: $"the temporary on line {lineOf(ref r, through: ref c, at: nodeSpan(in c, for: source))}",
            },
        ],
        owners: [],
    }
    @unobservable because "Q684: exprRegions, unionBorrow and lent are T25 stubs; add callBorrow and lendBorrow cases when T25 lands"
    return unionBorrow(in b, by: in temporary)
}

/// Memory from the arena (or other allocator) `allocator`.
Borrow allocatedFrom(ref Regions r, through ref Ctx c, for BExpr allocator) {
    let borrow = exprRegions(ref r, through: ref c, for: allocator)
    return t41AllocatedFrom(ref r, through: ref c, for: allocator, by: borrow)
}

Borrow t41AllocatedFrom(ref Regions r, through ref Ctx c, for BExpr allocator, by Borrow borrow) {
    let root = rootLocal(ref c, for: allocator)
    return t37CopyBorrow(borrow) if root == -1
    let depth = r.depthOf.tryGet(at: root) ?? 0
    var regions = List<Region>()
    // coverage-exempt: Q746
    for x in borrow.regions {
        regions.append(Region { depth: x.depth, name: x.name, source: x.source })
    }
    if depth > 0 {
        let region = Region { depth: depth, name: $"arena `{c.locals[root].name}`" }
        // coverage-exempt: Q746
        if !t37HasRegion(in regions, for: in region) {
            regions.append(region)
        }
    }
    // In a summary, memory from an allocator parameter borrows that parameter.
    if r.summary {
        let ps = copyIds(c.functions[r.fn].parameters)
        for index in 0..ps.length {
            continue if ps[index] != root
            let region = Region { depth: 0, name: "the caller's data", source: index }
            // coverage-exempt: Q746
            if !t37HasRegion(regions, for: region) {
                regions.append(region)
            }
            break
        }
    }
    var owners = copyIds(in borrow.owners)
    // coverage-exempt: Q746
    if !t37HasId(in owners, for: root) {
        owners.append(root)
    }
    return Borrow { regions: move regions, owners: move owners }
}

/// C# `BindPattern` (RegionAnalysis.cs:512).
void t37BindPattern(ref Regions r, through ref Ctx c, for BPattern pattern, by in Borrow value) {
    let nodes = descendants(in c, for: pattern)
    for node in nodes {
        let ni = boundIndex(node)
        var local: LocalId = -1
        switch boundKind(node) {
            case .bindPattern:
                local = c.bBindPatterns[ni].local
            case .propertyPattern:
                local = c.bPropertyPatterns[ni].designation
            case .unionPattern:
                local = c.bUnionPatterns[ni].designation
            default: {}
        }
        continue if local == -1
        let span = nodeSpan(in c, for: node)
        declareBorrow(ref r, through: ref c, for: local, at: span.start)
        storeBorrow(ref r, through: ref c, for: local, by: in value, at: span)
    }
}

// ── Stores and escapes ───────────────────────────────────────────────────────

void storeBorrow(ref Regions r, through ref Ctx c, for LocalId local, by in Borrow value, at TextSpan span) {
    t41StoreBorrow(ref r, through: ref c, for: local, by: value, at: span)
}

/// C# `Store` with its `note`, the related span a summarised call's diagnostic carries.
void t41StoreBorrow(
    ref Regions r,
    through ref Ctx c,
    for LocalId local,
    by Borrow value,
    at TextSpan span,
    Related? note = null
) {
    return if value.regions.length == 0 && value.owners.length == 0
    var merged = Borrow { regions: [], owners: [] }
    if r.locals.contains(local) {
        merged = unionBorrow(in r.locals[local], by: in value)
    } else {
        let none = Borrow { regions: [], owners: [] }
        merged = unionBorrow(in none, by: in value)
    }
    r.locals[local] = move merged
    if r.summary && r.targets.contains(local) {
        t41Record(ref r, for: r.targets[local], by: value, at: span)
    }
    return if !r.reporting
    // The loan starts where the stored value's borrow of the owner was lent (`first(w.items.asSpan(), w.grow())`
    // conflicts), or once the value is stored: a mutating call that produces it (`b.pick()` on `ref this`) is not a conflict.
    for owner in value.owners {
        continue if owner == local
        var created = span.end
        if (value.lends is { } lends) {
            if lends.contains(owner) {
                let at = lends[owner]
                if span.start <= at && at < created {
                    created = at
                }
            }
        }
        r.loans.append(Loan { owner: owner, holder: local, created: created, loopEnd: 0 })
    }
    let holder = c.locals[local].name
    t41CheckOutlives(
        ref r,
        through: ref c,
        for: value,
        by: r.depthOf.tryGet(at: local) ?? 0,
        as: holder,
        at: span,
        note: note,
    )
}

/// Adds a pair to the summary for each parameter (or `this`) whose data `value` may hold.
void t41Record(ref Regions r, for i64 target, by Borrow value, at TextSpan span) {
    for region in value.regions {
        continue if region.source == regionNoSource || region.source == target
        var known = false
        for p in r.pairs {
            if p.source == region.source && p.target == target {
                known = true
                break
            }
        }
        if !known {
            r.pairs.append(StorePair { source: region.source, target: target, site: span })
        }
    }
}

/// A store into a local or a part of one; through `this` or a `ref` parameter it outlives the function.
void storeIntoBorrow(ref Regions r, through ref Ctx c, for BExpr target, by in Borrow value, at TextSpan span) {
    t41StoreIntoBorrow(ref r, through: ref c, for: target, by: value, at: span)
}

/// C# `StoreInto` with its `note`.
void t41StoreIntoBorrow(
    ref Regions r,
    through ref Ctx c,
    for BExpr target,
    by Borrow value,
    at TextSpan span,
    Related? note = null
) {
    let root = storeRoot(in c, for: target)
    if root != -1 {
        t41StoreBorrow(ref r, through: ref c, for: root, by: value, at: span, note: note)
        return
    }
    if r.summary && c.functions[r.fn].isMutating && isThisRooted(c, for: target) {
        t41Record(ref r, for: regionThis, by: value, at: span)
    }
    return if !r.reporting
    // A store through a span lands where the span points: it must live as long as the
    // longest-lived storage the span may point into (the caller's, when that is unknown).
    if boundKind(target) == .index && kindOf(exprType(in c, for: c.bIndexes[boundIndex(target)].target)) == .span {
        let view = rootLocal(ref c, for: c.bIndexes[boundIndex(target)].target)
        if view != -1 {
            var depth: i64 = 0
            if r.locals.contains(view) {
                var first = true
                for x in r.locals[view].regions {
                    if first || x.depth < depth {
                        depth = x.depth
                    }
                    first = false
                }
            }
            let holder = c.locals[view].name
            t41CheckOutlives(ref r, through: ref c, for: value, by: depth, as: holder, at: span, note: note)
            return
        }
    }
    t41CheckOutlives(ref r, through: ref c, for: value, by: 0, as: "this", at: span, note: note)
}

void checkOutlives(
    ref Regions r,
    through ref Ctx c,
    for in Borrow value,
    by i64 depth,
    as string holder,
    at TextSpan span
) {
    t41CheckOutlives(ref r, through: ref c, for: value, by: depth, as: holder, at: span)
}

/// C# `CheckOutlives` with its `note`.
void t41CheckOutlives(
    ref Regions r,
    through ref Ctx c,
    for Borrow value,
    by i64 depth,
    as string holder,
    at TextSpan span,
    Related? note = null
) {
    let ordered = t37Ordered(in value.regions)
    for region in ordered {
        continue if region.depth <= depth
        return if restEscapes(ref r, through: ref c, for: in region, at: span)
        regionReport(
            ref r,
            through: ref c,
            for: .borrowOutlivesSource,
            at: span,
            by: (region.name, holder, "", "", ""),
            label: $"{region.name} is freed at the end of its block",
            help: "copy the data with `.copy(to: alloc)` into an allocator that lives long enough",
            note: note,
        )
        return
    }
}

void checkReturn(ref Regions r, through ref Ctx c, for in Borrow value, at TextSpan span) {
    if r.summary {
        for region in value.regions {
            if region.source != regionNoSource && !t37HasId(r.returns, for: region.source) {
                r.returns.append(region.source)
            }
        }
    }
    return if !r.reporting
    let ordered = t37Ordered(in value.regions)
    for region in ordered {
        continue if region.depth <= 0
        return if restEscapes(ref r, through: ref c, for: in region, at: span)
        regionReport(
            ref r,
            through: ref c,
            for: .borrowReturned,
            at: span,
            by: (region.name, c.functions[r.fn].name, "", "", ""),
            help: "let the caller pass the buffer or allocator in, and borrow or allocate from that",
        )
        return
    }
}

bool restEscapes(ref Regions r, through ref Ctx c, for in Region region, at TextSpan span) {
    var found = false
    var name = ""
    for t in r.restTails {
        if t.region.depth == region.depth && t.region.name == region.name {
            found = true
            name = t.tail
            break
        }
    }
    return false if !found
    regionReport(
        ref r,
        through: ref c,
        for: .restEscapes,
        at: span,
        by: (name, "", "", "", ""),
        help: $"copy it first: `{name}.copy()`",
    )
    return true
}

// ── Structural modification while borrowed ───────────────────────────────────

void mutateBorrow(ref Regions r, through ref Ctx c, for BExpr target, at TextSpan span, bool moved = false) {
    return if !r.reporting
    let root = rootLocal(ref c, for: target)
    if root != -1 {
        r.mutations.append(Mutation { target: root, span: span, moved: moved })
        return
    }
    let field = thisField(ref r, through: ref c, for: target)
    if field != -1 {
        r.mutations.append(Mutation { target: field, span: span, moved: moved })
    }
}

void mutateOwners(ref Regions r, through ref Ctx c, for BExpr via, by in Borrow borrow, at TextSpan span) {
    // As for a `ref` argument: a write through it reallocates nothing unless the value it points to may hold such storage.
    return if !r.reporting
    let isLocal = boundKind(via) == .local
    let viaLocal = isLocal ? c.bLocals[boundIndex(via)].local : -1
    return if isLocal && !(r.referentMayBorrow.tryGet(at: viaLocal) ?? true)
    for owner in borrow.owners {
        r.mutations.append(Mutation { target: owner, span: span, through: viaLocal })
    }
}

void referBorrow(ref Regions r, through ref Ctx c, for LocalId local, by BExpr value) {
    return if kindOf(c.locals[local].type) != .dynRef
    var may = true
    switch boundKind(value) {
        case .conversion:
            let ci = boundIndex(value)
            if c.bConversions[ci].kind == .toDynRef {
                var seen = List<Type>()
                may = mayBorrow(ref c, for: exprType(in c, for: c.bConversions[ci].operand), by: ref seen)
            }
        case .local:
            may = r.referentMayBorrow.tryGet(at: c.bLocals[boundIndex(value)].local) ?? true
        default: {}
    }
    r.referentMayBorrow[local] = (r.referentMayBorrow.tryGet(at: local) ?? false) || may
}

/// C# `LastUse`, the local function of `CheckMutations`: `useLists` holds each local's use positions at `useOf[local]`.
i64 lastUse(
    in Regions r,
    for LocalId holder,
    by in Map<LocalId,
    i64> useOf,
    as in List<List<i64>> useLists,
    at in List<TextSpan> loops
) {
    let declared = r.declaredAt.tryGet(at: holder) ?? -1
    var end: i64 = -1
    return end if !useOf.contains(holder)
    for use in useLists[useOf[holder]] {
        if use > end {
            end = use
        }
        for loop in loops {
            if loop.start <= use && use < loop.end && !(loop.start <= declared && declared < loop.end) {
                if loop.end > end {
                    end = loop.end
                }
            }
        }
    }
    return end
}

void checkMutations(ref Regions r, through ref Ctx c) {
    return if r.mutations.length == 0 || r.loans.length == 0
    var useOf: Map<LocalId, i64> = []
    var useLists = List<List<i64>>()
    var loops = List<TextSpan>()
    let nodes = descendants(in c, for: c.functions[r.fn].body)
    for node in nodes {
        let k = boundKind(node)
        if k == .local {
            let l = c.bLocals[boundIndex(node)].local
            if !useOf.contains(l) {
                useOf[l] = useLists.length
                useLists.append(List<i64>())
            }
            useLists[useOf[l]].append(nodeSpan(in c, for: node).start)
        } else if k is .whileStmt or .doWhile or .forStmt {
            loops.append(nodeSpan(in c, for: node))
        }
    }
    for mi in 0..r.mutations.length {
        let target = r.mutations[mi].target
        let mSpan = r.mutations[mi].span
        let moved = r.mutations[mi].moved
        let through = r.mutations[mi].through
        for li in 0..r.loans.length {
            let holder = r.loans[li].holder
            let created = r.loans[li].created
            continue if r.loans[li].owner != target || created >= mSpan.end
            // Writing an element in place through the loop's own `dyn ref` variable leaves the loop's collection as it is.
            continue if holder == -1 && through != -1 && (r.declaredAt.tryGet(at: through) ?? -1) == created
            let end = holder == -1 ? r.loans[li].loopEnd : lastUse(
                in r,
                for: holder,
                by: in useOf,
                as: in useLists,
                at: in loops,
            )
            continue if end <= mSpan.end
            let targetName = c.locals[target].name
            let who = holder == -1 ? "the `for` loop" : $"`{c.locals[holder].name}`"
            var label = $"the loop over `{targetName}` is still running"
            if holder != -1 {
                label = $"`{c.locals[holder].name}` is used again on line {lineOf(ref r, through: ref c, at: TextSpan { start: end, length: 0 })}"
            }
            var help = $"finish using {who} first, or copy what it needs before changing `{targetName}`"
            if moved {
                help = $"finish using {who} first, or copy what it needs before moving `{targetName}`"
            } else if holder == -1 {
                help = $"collect the changes in another list and apply them to `{targetName}` after the loop"
            }
            regionReport(
                ref r,
                through: ref c,
                for: moved ? .movedWhileBorrowed : .modifiedWhileBorrowed,
                at: mSpan,
                by: (targetName, who, "", "", ""),
                label: label,
                help: help,
            )
            break
        }
    }
}

// ── Helpers ──────────────────────────────────────────────────────────────────

/// The local whose storage `e` names (`x`, `x.f`, `x[i]` of an array or list, `x.item1`), or -1.
LocalId rootLocal(ref Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            return c.bLocals[i].local
        case .field:
            return rootLocal(ref c, for: c.bFields[i].receiver)
        case .tupleElement:
            return rootLocal(ref c, for: c.bTupleElements[i].receiver)
        case .index:
            let k = kindOf(exprType(in c, for: c.bIndexes[i].target))
            return rootLocal(ref c, for: c.bIndexes[i].target) if k is .array or .list
            return -1
        default:
            return -1
    }
}

/// Whether `e` names storage of `this` (`this`, `f`, `f[i]` of an array or list field, `f[k]` or `f.slot(k)` of a map field).
bool isThisRooted(in Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .thisRef:
            return true
        case .field:
            return isThisRooted(in c, for: c.bFields[i].receiver)
        case .tupleElement:
            return isThisRooted(in c, for: c.bTupleElements[i].receiver)
        case .index:
            let k = kindOf(exprType(in c, for: c.bIndexes[i].target))
            return isThisRooted(in c, for: c.bIndexes[i].target) if k is .array or .list
            return false
        case .builtinCall:
            let m = c.bBuiltinCalls[i].member
            return isThisRooted(in c, for: c.bBuiltinCalls[i].receiver) if m is .mapIndexSet or .mapSlot
            return false
        default:
            return false
    }
}

/// The stand-in for the field of `this` whose storage `e` names (`f`, `f.g`, `f[i]`), or -1.
LocalId thisField(ref Regions r, through ref Ctx c, for BExpr e) {
    let field = thisFieldSymbol(in c, for: e)
    return field != -1 ? fieldLocal(ref r, through: ref c, for: field) : -1
}

LocalId fieldLocal(ref Regions r, through ref Ctx c, for FieldId field) {
    return r.thisFields[field] if r.thisFields.contains(field)
    c.locals.append(LocalSymbol { name: c.fields[field].name, type: c.fields[field].type, kind: .parameter })
    let local = c.locals.length - 1
    r.thisFields[field] = local
    return local
}

FieldId thisFieldSymbol(in Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .field:
            return c.bFields[i].field if boundKind(c.bFields[i].receiver) == .thisRef
            return thisFieldSymbol(in c, for: c.bFields[i].receiver)
        case .tupleElement:
            return thisFieldSymbol(in c, for: c.bTupleElements[i].receiver)
        case .index:
            let k = kindOf(exprType(in c, for: c.bIndexes[i].target))
            return thisFieldSymbol(in c, for: c.bIndexes[i].target) if k is .array or .list
            return -1
        default:
            return -1
    }
}

/// C# `ChangedFields`' Tarjan state: `Visit`'s `index`, `low`, `own` and `stack`.
struct T37Tarjan {
    Map<FuncId, i64> index = []
    Map<FuncId, i64> low   = []
    Map<FuncId, List<FieldId>> own = []
    List<FuncId>     stack = []
}

/// The fields of `this` that the `ref this` method `fn` changes structurally, as `mutateBorrow`
/// sees it. Computed once per method; methods that call each other on `this` share one set.
List<FieldId> changedFields(ref Regions r, through ref Ctx c, for FuncId fn) {
    return copyIds(in c.changedFields[fn]) if c.changedFields.contains(fn)
    // Tarjan's strongly connected components over `ref this` calls on `this`.
    var t = T37Tarjan {}
    changedFieldsVisit(ref t, through: ref c, for: fn)
    return copyIds(in c.changedFields[fn])
}

/// C# `Visit`, the local function of `ChangedFields`.
void changedFieldsVisit(ref T37Tarjan t, through ref Ctx c, for FuncId f) {
    let n = t.index.length
    t.index[f] = n
    t.low[f] = n
    t.stack.append(f)
    let direct = directChanges(ref c, for: f)
    var fields = copyIds(in direct.fields)
    for callee in direct.callees {
        if c.changedFields.contains(callee) {
            t37UnionIds(ref fields, by: in c.changedFields[callee])
            continue
        }
        if !t.index.contains(callee) {
            changedFieldsVisit(ref t, through: ref c, for: callee)
            if t.low[callee] < t.low[f] {
                t.low[f] = t.low[callee]
            }
            if c.changedFields.contains(callee) {
                t37UnionIds(ref fields, by: in c.changedFields[callee])
            }
        } else if t37HasId(in t.stack, for: callee) {
            if t.index[callee] < t.low[f] {
                t.low[f] = t.index[callee]
            }
        }
    }
    t.own[f] = move fields
    return if t.low[f] != t.index[f]
    var component = List<FuncId>()
    var all = List<FieldId>()
    while true {
        let member = t.stack.removeLast()
        component.append(member)
        t37UnionIds(ref all, by: in t.own[member])
        break if member == f
    }
    for m in component {
        c.changedFields[m] = copyIds(in all)
        c.changedFieldsKeys.append(m)
    }
}

/// C# `DirectChanges`' result.
struct T37Changes {
    List<FieldId> fields
    List<FuncId>  callees
}

/// The fields `fn`'s own body changes, and the `ref this` methods it calls on `this`.
T37Changes directChanges(ref Ctx c, for FuncId fn) {
    var fields = List<FieldId>()
    var callees = List<FuncId>()
    let owner = c.functions[fn].owner
    if c.functions[fn].body == -1 {
        // Unknown: it may change any of them.
        if owner != -1 {
            t37UnionIds(ref fields, by: in c.structs[owner].fields)
        }
        return T37Changes { fields: move fields, callees: move callees }
    }
    let nodes = descendants(in c, for: c.functions[fn].body)
    for node in nodes {
        let i = boundIndex(node)
        switch boundKind(node) {
            case .builtinCall:
                let m = c.bBuiltinCalls[i].member
                let changes = m is .listAdd
                    or .mapIndexSet
                    or .mapSlot
                    or .listRemoveLast
                    or .mapRemove
                    or .mapClear
                    or .listRemoveRange
                    or .listRemoveThrough
                    or .listRemoveAt
                    or .listRemoveAtRange
                    or .listReplace
                    or .listSort
                    or .listClear
                    or .strBufClear
                    or .strBufInsert
                    or .arenaReset
                    or .listTake
                    or .mapTake
                    or .strBufTake
                    or .optionalTake
                if changes {
                    let field = thisFieldSymbol(in c, for: c.bBuiltinCalls[i].receiver)
                    if field != -1 && !t37HasId(in fields, for: field) {
                        fields.append(field)
                    }
                }
            case .call:
                let callee = c.bCalls[i].function
                let recv = c.bCalls[i].receiver
                let mutating = c.functions[callee].isMutating
                if mutating && recv != -1 && boundKind(recv) == .thisRef {
                    callees.append(callee)
                } else if mutating && recv != -1 {
                    let receiver = thisFieldSymbol(in c, for: recv)
                    if receiver != -1 && !t37HasId(in fields, for: receiver) {
                        fields.append(receiver)
                    }
                }
                let arguments = copyIds(in c.bCalls[i].arguments)
                let parameters = copyIds(in c.functions[callee].parameters)
                var k: i64 = 0
                while k < arguments.length && k < parameters.length {
                    let written = writtenArgument(in c, for: parameters[k], by: arguments[k])
                    k += 1
                    continue if written == -1
                    var seen = List<Type>()
                    continue if !mayBorrow(ref c, for: exprType(in c, for: written), by: ref seen)
                    let argument = thisFieldSymbol(in c, for: written)
                    if argument != -1 {
                        if !t37HasId(in fields, for: argument) {
                            fields.append(argument)
                        }
                    } else if boundKind(written) == .thisRef && owner != -1 {
                        t37UnionIds(ref fields, by: in c.structs[owner].fields)
                    }
                }
            default: {}
        }
    }
    return T37Changes { fields: move fields, callees: move callees }
}

/// The place the callee may write through `parameter`: a `ref` or `out` argument, or the value a writable `dyn ref` parameter borrows; -1 for none.
BExpr writtenArgument(in Ctx c, for LocalId parameter, by BExpr argument) {
    return argument if t37RefOrOut(in c, for: parameter)
    return c.bConversions[boundIndex(argument)].operand if t37WritableDynRef(in c, for: c.locals[parameter].type)
        && boundKind(argument) == .conversion
        && c.bConversions[boundIndex(argument)].kind == .toDynRef
    return -1
}

/// The local a store into `e` lands in, including through a span or list element; -1 for none.
LocalId storeRoot(in Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .local:
            return c.bLocals[i].local
        case .field:
            return storeRoot(in c, for: c.bFields[i].receiver)
        case .tupleElement:
            return storeRoot(in c, for: c.bTupleElements[i].receiver)
        case .index:
            // A span's elements live wherever it points (often the caller's frame): not in the span local.
            return -1 if kindOf(exprType(in c, for: c.bIndexes[i].target)) == .span
            return storeRoot(in c, for: c.bIndexes[i].target)
        case .builtinCall:
            let m = c.bBuiltinCalls[i].member
            return storeRoot(in c, for: c.bBuiltinCalls[i].receiver) if m is .mapIndexSet or .mapSlot
            return -1
        default:
            return -1
    }
}

/// Whether a value of type `t` can point into memory it doesn't own.
bool mayBorrow(ref Ctx c, for Type t, by ref List<Type> seen) {
    let i = typeIndex(t)
    switch kindOf(t) {
        case .primitive:
            return isString(t)
        case .span or .list or .map or .owned or .dynRef or .textView or .function:
            return true
        case .builtin:
            return t == builtinType(.strBuf) || t == builtinType(.processResult)
        case .untrusted:
            return mayBorrow(ref c, for: c.untrustedTypes[i], by: ref seen)
        case .optional:
            return mayBorrow(ref c, for: c.optionalTypes[i], by: ref seen)
        case .result:
            return mayBorrow(ref c, for: c.resultTypes[i].value, by: ref seen)
        case .array:
            return mayBorrow(ref c, for: c.arrayTypes[i].element, by: ref seen)
        case .tuple:
            var types = List<Type>()
            for f in c.tupleTypes[i] {
                types.append(f.type)
            }
            for ft in types {
                return true if mayBorrow(ref c, for: ft, by: ref seen)
            }
            return false
        case .structType:
            return false if t37HasId(in seen, for: t)
            seen.append(t)
            var types = List<Type>()
            for f in c.structs[i].fields {
                types.append(c.fields[f].type)
            }
            for ft in types {
                return true if mayBorrow(ref c, for: ft, by: ref seen)
            }
            return false
        case .unionType:
            return false if t37HasId(in seen, for: t)
            seen.append(t)
            var types = List<Type>()
            for v in c.unions[i].variants {
                for f in c.unionVariants[v].fields {
                    types.append(c.locals[f].type)
                }
            }
            for ft in types {
                return true if mayBorrow(ref c, for: ft, by: ref seen)
            }
            return false
        default:
            return false
    }
}

/// Whether a `ref` to a `t` reaches storage a span or `dyn ref` can point into.
bool mayLend(ref Ctx c, for Type t, by ref List<Type> seen) {
    let i = typeIndex(t)
    let k = kindOf(t)
    return true if k is .array or .typeParam
    return true if isUnique(ref c, for: t)
    switch k {
        case .optional:
            return mayLend(ref c, for: c.optionalTypes[i], by: ref seen)
        case .tuple:
            var types = List<Type>()
            for f in c.tupleTypes[i] {
                types.append(f.type)
            }
            for ft in types {
                return true if mayLend(ref c, for: ft, by: ref seen)
            }
            return false
        case .structType:
            return false if t37HasId(in seen, for: t)
            seen.append(t)
            var types = List<Type>()
            for f in c.structs[i].fields {
                types.append(c.fields[f].type)
            }
            for ft in types {
                return true if mayLend(ref c, for: ft, by: ref seen)
            }
            return false
        case .unionType:
            return false if t37HasId(in seen, for: t)
            seen.append(t)
            var types = List<Type>()
            for v in c.unions[i].variants {
                for f in c.unionVariants[v].fields {
                    types.append(c.locals[f].type)
                }
            }
            for ft in types {
                return true if mayLend(ref c, for: ft, by: ref seen)
            }
            return false
        default:
            return mayBorrow(ref c, for: t, by: ref seen)
    }
}

bool containsList(ref Ctx c, for Type t, by ref List<Type> seen) {
    let i = typeIndex(t)
    switch kindOf(t) {
        case .list or .map or .owned:
            return true
        case .untrusted:
            return containsList(ref c, for: c.untrustedTypes[i], by: ref seen)
        case .optional:
            return containsList(ref c, for: c.optionalTypes[i], by: ref seen)
        case .result:
            return containsList(ref c, for: c.resultTypes[i].value, by: ref seen)
        case .array:
            return containsList(ref c, for: c.arrayTypes[i].element, by: ref seen)
        case .tuple:
            var types = List<Type>()
            for f in c.tupleTypes[i] {
                types.append(f.type)
            }
            for ft in types {
                return true if containsList(ref c, for: ft, by: ref seen)
            }
            return false
        case .structType:
            return false if t37HasId(in seen, for: t)
            seen.append(t)
            var types = List<Type>()
            for f in c.structs[i].fields {
                types.append(c.fields[f].type)
            }
            for ft in types {
                return true if containsList(ref c, for: ft, by: ref seen)
            }
            return false
        case .unionType:
            return false if t37HasId(in seen, for: t)
            seen.append(t)
            var types = List<Type>()
            for v in c.unions[i].variants {
                for f in c.unionVariants[v].fields {
                    types.append(c.locals[f].type)
                }
            }
            for ft in types {
                return true if containsList(ref c, for: ft, by: ref seen)
            }
            return false
        default:
            return false
    }
}

/// Shortest-lived first, so diagnostics name the same region on every run.
List<Region> t37Ordered(in List<Region> regions) {
    var result = List<Region>()
    for x in regions {
        var at = result.length
        for j in 0..result.length {
            if x.depth > result[j].depth || (x.depth == result[j].depth && x.name < result[j].name) {
                at = j
                break
            }
        }
        // `List` has no `insert`: append, then shift the tail up by one.
        result.append(Region { depth: x.depth, name: x.name, source: x.source })
        var j = result.length - 1
        while j > at {
            result[j] = result[j - 1]
            j -= 1
        }
        result[at] = Region { depth: x.depth, name: x.name, source: x.source }
    }
    return result
}

i64 lineOf(ref Regions r, through ref Ctx c, at TextSpan span) =>
    linePosition(c.files[r.source].text.span, at: span.start).line

/// C# `Report` (RegionAnalysis.cs:877): once per span, and only on the reporting pass.
void regionReport(
    ref Regions r,
    through ref Ctx c,
    for SemaCode code,
    at TextSpan span,
    by (string a0, string a1, string a2, string a3, string a4) args,
    string label = "",
    string help = "",
    Related? note = null
) {
    return if !r.reporting || r.summary
    for p in r.reported {
        return if p == (span.start, span.end)
    }
    r.reported.append((span.start, span.end))
    if note is not null {
        var related = List<Related>()
        related.append(note)
        addDiag(ref c, by: Diag {
            code: codeText(code),
            file: r.source,
            span: span,
            message: format(messageFormat(code), by: args),
            label: label,
            help: help,
            isWarning: isWarning(code),
            fixSpan: TextSpan { start: 0, length: 0 },
            related: move related,
        })
        return
    }
    report(ref c, for: code, from: r.source, at: span, by: args, label: label, help: help)
}
== semantics/states.byn
// T22: BinderStates.cs.

import parser

// The C# `(LocalSymbol Key, TypeSymbol Type)` tuple `Subject` returns.
struct SubjectResult {
    LocalId key
    Type    type
}

/// C# `fn.Decl`'s typestate parts (`Becomes`, `RefThis`, `MoveThis`, `ReceiverStates`), read from the function's
/// declaration where `t20DeclFacts` finds it (Q626); `found` is false where C# `Decl` is null.
struct T22DeclFacts {
    bool           found          = false
    TextSpan?      becomes        = null
    TextSpan?      refThis        = null
    TextSpan?      moveThis       = null
    List<TextSpan> receiverStates = []
}

T22DeclFacts t22FactsOf(in parser.FunctionDecl d) {
    var states = List<TextSpan>()
    for s in d.receiverStates {
        states.append(s)
    }
    return T22DeclFacts {
        found: true,
        becomes: d.becomes,
        refThis: d.refThis,
        moveThis: d.moveThis,
        receiverStates: move states,
    }
}

T22DeclFacts t22DeclFacts(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    return T22DeclFacts {} if d < 0
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n): return t22FactsOf(in n.value)
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return t22FactsOf(in x.value)
                default: break
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return t22FactsOf(in x.value)
                default: break
            }
        case .extensionDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return t22FactsOf(in x.value)
                default: break
            }
        default:
            break
    }
    return T22DeclFacts {}
}

/// C# `BecomesFix(fn, fn.Decl, state)`, at the declaration `t22DeclFacts` finds; null where C# `Decl` is null.
Fix? t22BecomesFixOf(ref Binder b, through ref Ctx c, for FuncId fn, by string state) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    return null if d < 0
    var fix: Fix? = null
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n): fix = becomesFix(ref b, through: ref c, for: fn, from: in n.value, by: state)
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): fix = becomesFix(ref b, through: ref c, for: fn, from: in x.value, by: state)
                default: break
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): fix = becomesFix(ref b, through: ref c, for: fn, from: in x.value, by: state)
                default: break
            }
        case .extensionDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): fix = becomesFix(ref b, through: ref c, for: fn, from: in x.value, by: state)
                default: break
            }
        default:
            break
    }
    return fix
}

/// C# `BindBecome` (BinderStates.cs:12). C# binds `b.Args` as a `CallExpr` spanning `b.Span`; `bindArgumentList` takes
/// those two (Q656).
BStmt bindBecome(ref Binder b, through ref Ctx c, for in parser.BecomeStmt s) {
    let stateText = t15Text(in c, from: b.file, at: s.state)
    let owner = b.fn != -1 ? c.functions[b.fn].owner : -1
    let states = owner != -1 ? statesOf(ref c, for: owner) : -1
    let state = states != -1 ? findUnionVariant(ref c, by: states, for: stateText) : -1
    if state == -1 {
        let name = owner != -1 ? c.structs[owner].name : b.fn != -1 ? c.functions[b.fn].name : "?"
        report(
            ref b,
            through: ref c,
            for: .unknownState,
            at: s.state,
            by: (name, stateText, "", "", ""),
            help: $"check the states declared in `{name}`",
        )
        bindArgumentListForRecovery(ref b, through: ref c, for: in s.args)
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: s.span }),
            as: .becomeStmt,
            at: s.span,
        )
    }
    let fn = b.fn
    let fnName = c.functions[fn].name
    let stateName = c.unionVariants[state].name
    let fields = copyIds(in c.unionVariants[state].fields)
    let decl = t22DeclFacts(ref c, for: fn)
    // A `becomes` without `ref this` is BYN7010 at the signature; its `become` reports nothing more (revision 0010).
    if !c.functions[fn].isStatic && decl.found && decl.becomes is not null && decl.refThis is null {
        let _ = t21BindArgumentList(
            ref b,
            through: ref c,
            for: in s.args,
            at: s.span,
            by: in fields,
            as: -1,
            enforceNames: false,
            displayName: $".{stateName}",
            syntax: syntaxAppend(
                ref c,
                from: ExprSyntax {
                    kind: .callExpr,
                    span: s.span,
                    callee: syntaxLeaf(ref c, as: .nameExpr, at: s.state),
                },
            ),
        )
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: s.span }),
            as: .becomeStmt,
            at: s.span,
        )
    }
    let keyword = TextSpan { start: s.span.start, length: "become".length }
    // A static method has no `this` to change; one that takes neither `ref this` nor `move this` is BYN2115 (Question 297).
    if c.functions[fn].isStatic {
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: keyword,
            by: ("`become` in a static method", "", "", "", ""),
            help: "remove `become`; only an instance method has a `this` to change",
        )
    } else if decl.moveThis is null {
        let thisExpr = recordNodeSyntax(
            ref c,
            for: addThis(ref c, from: BThis { span: s.span, type: structTypeOf(owner) }),
            as: .becomeStmt,
            at: s.span,
        )
        let _ = checkWritable(ref b, through: ref c, for: thisExpr, at: keyword, by: "`become` changes its state")
    }
    if (decl.becomes is { } becomes) {
        let becomesText = t15Text(in c, from: c.functions[fn].file, at: becomes)
        if becomesText != stateName {
            report(
                ref b,
                through: ref c,
                for: .becomeOtherState,
                at: s.state,
                by: (stateName, fnName, becomesText, "", ""),
                help: $"change the target to `.{becomesText}`, or declare `becomes .{stateName}`",
            )
        }
    } else {
        let help = $"add `becomes .{stateName}` to the signature of `{fnName}`"
        let fix = decl.found ? t22BecomesFixOf(ref b, through: ref c, for: fn, by: stateName) : null
        if fix is not null {
            report(
                ref b,
                through: ref c,
                for: .becomeUndeclared,
                at: keyword,
                by: (stateName, fnName, "", "", ""),
                help: help,
                hasFix: true,
                fixSpan: fix.span,
                fixReplacement: fix.replacement,
            )
        } else {
            report(
                ref b,
                through: ref c,
                for: .becomeUndeclared,
                at: keyword,
                by: (stateName, fnName, "", "", ""),
                help: help,
            )
        }
    }
    let payload = t21BindArgumentList(
        ref b,
        through: ref c,
        for: in s.args,
        at: s.span,
        by: in fields,
        as: -1,
        enforceNames: false,
        displayName: $".{stateName}",
        syntax: syntaxAppend(
            ref c,
            from: ExprSyntax { kind: .callExpr, span: s.span, callee: syntaxLeaf(ref c, as: .nameExpr, at: s.state) },
        ),
    )
    // The payload reads the old state; after it, `this` is in the new one.
    let facts = t15ThisFacts(ref b, through: ref c)
    forgetState(ref b, for: facts)
    var one = List<VariantId>()
    one.append(state)
    learnState(ref b, for: facts, as: internState(ref c, by: owner, for: in one))
    return recordNodeSyntax(
        ref c,
        for: addBecome(ref c, from: BBecome { span: s.span, state: state, payload: move payload }),
        as: .becomeStmt,
        at: s.span,
    )
}

void checkBecomesCall(
    ref Binder b,
    through ref Ctx c,
    for in parser.CallExpr call,
    from FuncId caller,
    by FuncId fn,
    to TextSpan state
) {
    // `to` is a name in the callee's declaration (Q626).
    let toText = t15Text(in c, from: c.functions[fn].file, at: state)
    let decl = t22DeclFacts(ref c, for: caller)
    return if (decl.becomes is { } own) && t15Text(in c, from: c.functions[caller].file, at: own) == toText
    var fix: Fix? = null
    if decl.found && decl.becomes is null {
        fix = t22BecomesFixOf(ref b, through: ref c, for: caller, by: toText)
    }
    let callerName = c.functions[caller].name
    let fnName = c.functions[fn].name
    if (fix is { } x) {
        report(
            ref b,
            through: ref c,
            for: .becomesCallUndeclared,
            at: call.span,
            by: (callerName, fnName, toText, "", ""),
            help: $"add `becomes .{toText}` to the signature of `{callerName}`",
            hasFix: true,
            fixSpan: x.span,
            fixReplacement: x.replacement,
        )
    } else {
        report(
            ref b,
            through: ref c,
            for: .becomesCallUndeclared,
            at: call.span,
            by: (callerName, fnName, toText, "", ""),
            help: $"add `becomes .{toText}` to the signature of `{callerName}`",
        )
    }
}

/// C# `BecomesFix` (BinderStates.cs:63).
Fix becomesFix(ref Binder b, through ref Ctx c, for FuncId fn, from in parser.FunctionDecl decl, by string state) {
    let at = afterParams(ref b, through: ref c, for: in decl)
    return Fix {
        span: TextSpan { start: at, length: 0 },
        replacement: $" becomes .{state}",
    } if decl.refThis is not null
        || !(c.functions[fn].kind == .method && !c.functions[fn].isStatic)
    let receiver = refReceiverFix(in decl)
    let between = t15Text(in c, from: b.file, at: TextSpan.fromBounds(receiver.span.end, until: at))
    return Fix {
        span: TextSpan.fromBounds(receiver.span.start, until: at),
        replacement: $"{receiver.replacement}{between} becomes .{state}",
    }
}

/// C# `AfterParams` (BinderStates.cs:76).
i64 afterParams(ref Binder b, through ref Ctx c, for in parser.FunctionDecl decl) {
    var at = decl.params.length > 0 ? decl.params[decl.params.length - 1].span.end : decl.paramsStart
    let length = c.files[b.file].text.length
    while at < length && c.files[b.file].text[at] != 41 {
        at += 1
    }
    at = at + 1 < length ? at + 1 : length
    for clause in decl.where {
        if clause.span.end > at {
            at = clause.span.end
        }
    }
    for clause in decl.requiresClauses {
        let end = parser.exprSpan(in clause).end
        if end > at {
            at = end
        }
    }
    if (decl.usesKeyword is { } clause) {
        if clause.span.end > at {
            at = clause.span.end
        }
    }
    return at
}

Type receiverStates(ref Binder b, through ref Ctx c, for FuncId fn) {
    let decl = t22DeclFacts(ref c, for: fn)
    return -1 if !decl.found || decl.receiverStates.length == 0
    let owner = c.functions[fn].owner
    return -1 if owner == -1
    let states = statesOf(ref c, for: owner)
    return -1 if states == -1
    var found = List<VariantId>()
    for n in decl.receiverStates {
        let v = findUnionVariant(ref c, by: states, for: t15Text(in c, from: c.functions[fn].file, at: n))
        if v != -1 {
            found.append(v)
        }
    }
    return -1 if found.length == 0
    return internState(ref c, by: owner, for: in found)
}

bool reportWrongState(
    ref Binder b,
    through ref Ctx c,
    for string callee,
    by BExpr value,
    as Type wanted,
    at TextSpan span
) {
    let isThis = boundKind(value) == .thisRef
    var known = exprType(in c, for: value)
    if isThis {
        let own = t22ThisStates(ref b, through: ref c)
        if own != -1 {
            known = own
        }
    }
    let of = kindOf(known) == .state ? structTypeOf(c.stateTypes[typeIndex(known)].s) : known
    return false if of != structTypeOf(c.stateTypes[typeIndex(wanted)].s)
        || implicit(ref c, from: known, to: wanted) is not null
    var names = StrBuf()
    for i in 0..c.stateTypes[typeIndex(wanted)].states.length {
        if i > 0 {
            names.append(" or .")
        }
        names.append(c.unionVariants[c.stateTypes[typeIndex(wanted)].states[i]].name)
    }
    let what = isThis ? "this" : t15Text(in c, from: b.file, at: span)
    report(
        ref b,
        through: ref c,
        for: .wrongState,
        at: span,
        by: (callee, what, $"{names.finish()}", typeDisplay(ref c, by: known), ""),
        help: stateTestHelp(ref b, through: ref c, for: t9Text(ref c, for: b.file, at: span), as: wanted)
            ?? "check the state with `is` or `switch` first",
    )
    return true
}

/// The member of `.s`, or null for any other expression.
TextSpan? targetMemberOf(parser.Expr e) {
    return t.value.member if e is .targetMemberExpr(let t)
    return null
}

/// The state a property body `this is .s` tests, or null for any other body: a constant pattern, or a variant pattern without payload or binding.
TextSpan? testedState(parser.Expr body) {
    switch body {
        case .isExpr(let x):
            return null if !(x.value.value is .thisExpr(_))
            switch x.value.pattern {
                case .constantPattern(let k): return targetMemberOf(k.value.value)
                case .variantPattern(let v):
                    return targetMemberOf(v.value.variant) if v.value.elements.length == 0 && v.value.binding is null
                default: {}
            }
        default: {}
    }
    return null
}

/// C# `StateTestHelp` (BinderStates.cs:117). Revision 0021 Part 5: inside `if x.p { … }`, when property `p` is exactly
/// `this is .s` and `.s` is wanted, the help says to test `x` itself. The help may read a member's body; narrowing must never do so.
string? stateTestHelp(ref Binder b, through ref Ctx c, for string value, as Type wanted) {
    let s = c.stateTypes[typeIndex(wanted)].s
    for k in 0..b.thenOf.length {
        continue if !b.thenOf[k].item1 || t9Text(ref c, for: b.file, at: b.thenOf[k].item2) != value
        let memberName = t9Text(ref c, for: b.file, at: b.thenOf[k].item3)
        let p = findProperty(ref c, by: s, for: memberName)
        continue if p == -1
        var tested: TextSpan? = null
        switch c.files[c.properties[p].file].unit.members[c.properties[p].declIndex] {
            case .structDecl(let n):
                switch n.value.members[c.properties[p].memberIndex] {
                    case .propertyDecl(let d): tested = testedState(d.value.body)
                    default: {}
                }
            case .interfaceDecl(let n):
                switch n.value.members[c.properties[p].memberIndex] {
                    case .propertyDecl(let d): tested = testedState(d.value.body)
                    default: {}
                }
            default: {}
        }
        if (tested is { } at) {
            let name = t9Text(ref c, for: c.properties[p].file, at: at)
            for v in c.stateTypes[typeIndex(wanted)].states {
                if c.unionVariants[v].name == name {
                    return $"`{memberName}` doesn't narrow; write `if {value} is .{name}`"
                }
            }
        }
    }
    return null
}

UnionId statesUnion(ref Ctx c, for Type t) {
    let u = unwrap(ref c, for: t)
    switch kindOf(u) {
        case .state: return statesOf(ref c, for: c.stateTypes[typeIndex(u)].s)
        case .structType: return statesOf(ref c, for: typeIndex(u))
        default: return -1
    }
}

StructId stateStruct(ref Ctx c, for Type t) {
    switch kindOf(t) {
        case .state: return c.stateTypes[typeIndex(t)].s
        case .structType: return typeIndex(t)
        default: return -1
    }
}

/// C# `PossibleStates` (BinderStates.cs:126).
List<VariantId> possibleStates(ref Ctx c, for Type t, by UnionId states) {
    let u = unwrap(ref c, for: t)
    return copyIds(in c.stateTypes[typeIndex(u)].states) if kindOf(u) == .state
    return copyIds(in c.unions[states].variants)
}

/// The index of the field named `name` in `fields`, or -1 (C# `FindIndex`).
i64 t22FieldIndex(Ctx c, for List<LocalId> fields, by string name) {
    for i in 0..fields.length {
        return i if c.locals[fields[i]].name == name
    }
    return -1
}

BExpr bindPayloadField(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    for BExpr target,
    from UnionId states,
    by TextSpan member
) =>
    t21BindPayloadField(ref b, through: ref c, at: span, for: target, from: states, by: member, to: -1)

/// `bindPayloadField` that records `syntax` as the C# `Syntax` of the nodes it builds (Q849).
BExpr t21BindPayloadField(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    for BExpr target,
    from UnionId states,
    by TextSpan member,
    to i64 syntax
) {
    let name = t15Text(in c, from: b.file, at: member)
    var holder: VariantId = -1
    for v in copyIds(in c.unions[states].variants) {
        if t22FieldIndex(c, for: copyIds(in c.unionVariants[v].fields), by: name) >= 0 {
            holder = v
            break
        }
    }
    return -1 if holder == -1
    let isThis = boundKind(target) == .thisRef
    var known = List<VariantId>()
    let own = isThis ? t22ThisStates(ref b, through: ref c) : -1
    if own != -1 {
        known = copyIds(in c.stateTypes[typeIndex(own)].states)
    } else {
        known = possibleStates(ref c, for: exprType(in c, for: target), by: states)
    }
    let first = copyIds(in c.unionVariants[known[0]].fields)
    let index = t22FieldIndex(c, for: copyIds(in first), by: name)
    var same = index >= 0
    if same {
        for v in known {
            if t22FieldIndex(c, for: copyIds(in c.unionVariants[v].fields), by: name) != index {
                same = false
                break
            }
            for i in 0..index + 1 {
                if c.locals[c.unionVariants[v].fields[i]].type != c.locals[first[i]].type {
                    same = false
                    break
                }
            }
            break if !same
        }
    }
    // Every state holds the field after the same field types, so C reads it through any of them (a common initial sequence).
    return recordSyntaxNode(
        ref c,
        for: addUnionField(ref c, from: BUnionField { span: span, receiver: target, variant: known[0], index: index }),
        at: syntax,
    ) if same
    var everywhere = index >= 0
    if everywhere {
        let type = c.locals[first[index]].type
        for v in known {
            var has = false
            for f in c.unionVariants[v].fields {
                if c.locals[f].name == name && c.locals[f].type == type {
                    has = true
                }
            }
            if !has {
                everywhere = false
                break
            }
        }
    }
    if everywhere {
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: span,
            by: ($"reading `{name}` from states that hold it at different places", "", "", "", ""),
            help: $"match one state with `is` or `switch` before reading `{name}`",
        )
        return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    let what = isThis ? "this" : t15Text(in c, from: b.file, at: nodeSpan(in c, for: target))
    let holderName = c.unionVariants[holder].name
    report(
        ref b,
        through: ref c,
        for: .payloadNotInState,
        at: span,
        by: (name, holderName, what, "", ""),
        help: $"match `.{holderName}` with `is` or `switch` before reading `{name}`",
    )
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
}

/// C# `CheckStatesExhaustive` (BinderStates.cs:160). `span` is the switch's; C# `s is SwitchExpr e` is `valueEnd` (the end of
/// `e.Value.Span`, -1 for a statement), and `st.Sections[^1]` is `lastSection` (null for an expression or no section; Q656).
bool checkStatesExhaustive(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    as Type type,
    from UnionId states,
    by in List<(BPattern, BExpr)> arms,
    until i64 valueEnd,
    to TextSpan? lastSection
) {
    var covered = List<string>()
    for arm in arms {
        let pattern = arm.item1
        let guard = arm.item2
        return true if pattern == -1
        continue if guard != -1
        return true if irrefutable(ref c, for: pattern)
        collect(ref c, for: pattern, as: type, to: ref covered)
    }
    var missing = List<VariantId>()
    for v in possibleStates(ref c, for: type, by: states) {
        if !listContainsString(in covered, by: $".{c.unionVariants[v].name}") {
            missing.append(v)
        }
    }
    return true if missing.length == 0
    let length = c.files[b.file].text.length
    var keyword = span.start
    if valueEnd >= 0 {
        let rest = t15Text(in c, from: b.file, at: TextSpan.fromBounds(valueEnd, until: length))
        keyword = valueEnd + (rest.position("switch") ?? -1)
    }
    var indent: i64 = 0
    if lastSection is not null {
        while lastSection.start - indent > 0
                && (c.files[b.file].text[lastSection.start - indent - 1] == 32
                || c.files[b.file].text[lastSection.start - indent - 1] == 9) {
            indent += 1
        }
    }
    for v in missing {
        let name = c.unionVariants[v].name
        let at = TextSpan { start: keyword, length: "switch".length }
        if lastSection is not null {
            let lead = t15Text(in c, from: b.file, at: TextSpan { start: lastSection.start - indent, length: indent })
            report(
                ref b,
                through: ref c,
                for: .stateSwitchNotExhaustive,
                at: at,
                by: (name, "", "", "", ""),
                help: $"add a `case .{name}` arm",
                hasFix: true,
                fixSpan: TextSpan { start: lastSection.end, length: 0 },
                fixReplacement: $"\n{lead}case .{name}:",
            )
        } else {
            report(
                ref b,
                through: ref c,
                for: .stateSwitchNotExhaustive,
                at: at,
                by: (name, "", "", "", ""),
                help: $"add a `case .{name}` arm",
            )
        }
    }
    return false
}

// ── What a local is known to be (spec §3.17) ─────────────────────────────────

/// C# `ThisStates` (BinderStates.cs:197): `KnownState(_thisFacts)`.
Type t22ThisStates(ref Binder b, through ref Ctx c) => knownState(ref b, for: t15ThisFacts(ref b, through: ref c))

SubjectResult? subject(ref Binder b, through ref Ctx c, for BExpr e) {
    switch boundKind(e) {
        case .local: return SubjectResult { key: c.bLocals[boundIndex(e)].local, type: exprType(in c, for: e) }
        case .thisRef:
            let key = t15ThisFacts(ref b, through: ref c)
            let own = t22ThisStates(ref b, through: ref c)
            return SubjectResult { key: key, type: own != -1 ? own : exprType(in c, for: e) }
        default: return null
    }
}

/// C# `IsOpen` (BinderStates.cs:207): the scope is `_scope` or one of its parents (Q715).
bool isOpen(ref Binder b, for i64 scope) {
    for s in b.scopeIds {
        return true if s == scope
    }
    return false
}

Type knownState(ref Binder b, for LocalId local) {
    var i = b.stateFacts.length - 1
    while i >= 0 {
        return b.stateFacts[i].item3 if b.stateFacts[i].item2 == local && isOpen(ref b, for: b.stateFacts[i].item1)
        i -= 1
    }
    return -1
}

void learnState(ref Binder b, for LocalId local, as Type type) {
    let scope = t16ScopeId(ref b)
    b.stateFacts.append((scope, local, type))
}

void forgetState(ref Binder b, for LocalId local) {
    var kept = List<(i64, LocalId, Type)>()
    for f in b.stateFacts {
        if f.item2 != local {
            kept.append(f)
        }
    }
    b.stateFacts = move kept
}

void forgetChangingStates(ref Binder b, through ref Ctx c) {
    let mutating = b.fn != -1 && c.functions[b.fn].isMutating
    var kept = List<(i64, LocalId, Type)>()
    for f in b.stateFacts {
        let isThis = (b.thisFacts is { } t) && f.item2 == t
        continue if localIsMutable(ref c, by: f.item2) || paramIsByRef(ref c, by: f.item2) || isThis && mutating
        kept.append(f)
    }
    b.stateFacts = move kept
}

List<(i64, LocalId, Type)> learnStates(ref Binder b, through ref Ctx c, for BExpr cond, bool whenTrue) {
    var learned = List<(i64, LocalId, Type)>()
    t22Collect(ref b, through: ref c, for: cond, when: whenTrue, to: ref learned)
    for f in learned {
        b.stateFacts.append(f)
    }
    return learned
}

/// C# `LearnStates`'s local function `Collect` (BinderStates.cs:241).
void t22Collect(ref Binder b, through ref Ctx c, for BExpr cond, bool when, to ref List<(i64, LocalId, Type)> learned) {
    switch boundKind(cond) {
        case .isExpr:
            let value = c.bIses[boundIndex(cond)].value
            let pattern = c.bIses[boundIndex(cond)].pattern
            if (subject(ref b, through: ref c, for: value) is { } s) {
                let type = narrow(ref c, for: s.type, by: pattern, matched: when)
                @unobservable because "Q627: statesOf is a stub; add cases on a struct with states when T38 lands"
                if type != -1 {
                    learned.append((t16ScopeId(ref b), s.key, type))
                }
            }
        case .unary:
            if c.bUnaries[boundIndex(cond)].op == .notKeyword {
                t22Collect(
                    ref b,
                    through: ref c,
                    for: c.bUnaries[boundIndex(cond)].operand,
                    when: !when,
                    to: ref learned,
                )
            }
        case .binary:
            let op = c.bBinaries[boundIndex(cond)].op
            if (op is .logicalAnd or .logicalOr) && when == (op == .logicalAnd) {
                t22Collect(ref b, through: ref c, for: c.bBinaries[boundIndex(cond)].left, when: when, to: ref learned)
                t22Collect(ref b, through: ref c, for: c.bBinaries[boundIndex(cond)].right, when: when, to: ref learned)
            }
        default: {}
    }
}

void unlearnStates(ref Binder b, by in List<(i64, LocalId, Type)> learned) {
    for f in learned {
        for i in 0..b.stateFacts.length {
            let g = b.stateFacts[i]
            if g.item1 == f.item1 && g.item2 == f.item2 && g.item3 == f.item3 {
                b.stateFacts.remove(at: i)
                break
            }
        }
    }
    var kept = List<(i64, LocalId, Type)>()
    for i in 0..b.stateFacts.length {
        if isOpen(ref b, for: b.stateFacts[i].item1) {
            kept.append(b.stateFacts[i])
        }
    }
    b.stateFacts = move kept
}

void learnArmState(ref Binder b, through ref Ctx c, for BExpr subject, by BPattern pattern) {
    // C# `Subject(subject)`, inlined: the parameter hides the function (Q628).
    var key: LocalId = -1
    var type: Type = -1
    switch boundKind(subject) {
        case .local:
            key = c.bLocals[boundIndex(subject)].local
            type = exprType(in c, for: subject)
        case .thisRef:
            key = t15ThisFacts(ref b, through: ref c)
            let own = t22ThisStates(ref b, through: ref c)
            type = own != -1 ? own : exprType(in c, for: subject)
        default: return
    }
    let narrowed = narrow(ref c, for: type, by: pattern, matched: true)
    if narrowed != -1 {
        learnState(ref b, for: key, as: narrowed)
    }
}

/// C# `Narrow` (BinderStates.cs:276); -1 for null.
Type narrow(ref Ctx c, for Type type, by BPattern pattern, bool matched) {
    return -1 if kindOf(type) == .optional
    let states = statesUnion(ref c, for: type)
    return -1 if states == -1
    let possible = possibleStates(ref c, for: type, by: states)
    // A match proves the tag even when a payload subpattern also had to hold; a failed match proves it only for a bare tag test.
    var tested = List<VariantId>()
    return -1 if !t22StatesOf(ref c, for: pattern, by: states, exact: !matched, to: ref tested)
    var left = List<VariantId>()
    for v in possible {
        if listContains(in tested, by: v) == matched {
            left.append(v)
        }
    }
    return -1 if left.length == 0 || left.length == possible.length
    let s = kindOf(type) == .state ? c.stateTypes[typeIndex(type)].s : typeIndex(type)
    return internState(ref c, by: s, for: in left)
}

/// C# `Narrow`'s local function `StatesOf` (BinderStates.cs:286): false for null, else the states in `into`.
bool t22StatesOf(ref Ctx c, for BPattern p, by UnionId states, bool exact, to ref List<VariantId> into) {
    switch boundKind(p) {
        case .unionPattern:
            var all = true
            for sp in copyIds(in c.bUnionPatterns[boundIndex(p)].subpatterns) {
                if !irrefutable(ref c, for: sp) {
                    all = false
                }
            }
            if !exact || all {
                into.append(c.bUnionPatterns[boundIndex(p)].variant)
                return true
            }
            return false
        case .binaryPattern:
            let left = c.bBinaryPatterns[boundIndex(p)].left
            let right = c.bBinaryPatterns[boundIndex(p)].right
            if !c.bBinaryPatterns[boundIndex(p)].isAnd {
                var l = List<VariantId>()
                var r = List<VariantId>()
                return false if !t22StatesOf(ref c, for: left, by: states, exact: exact, to: ref l)
                    || !t22StatesOf(ref c, for: right, by: states, exact: exact, to: ref r)
                for v in l {
                    into.append(v)
                }
                for v in r {
                    into.append(v)
                }
                return true
            }
            return t22StatesOf(
                ref c,
                for: left,
                by: states,
                exact: exact,
                to: ref into,
            ) if irrefutable(ref c, for: right)
            return false
        case .notPattern:
            var inner = List<VariantId>()
            return false if !t22StatesOf(
                ref c,
                for: c.bNotPatterns[boundIndex(p)].operand,
                by: states,
                exact: !exact,
                to: ref inner,
            )
            for v in c.unions[states].variants {
                if !listContains(in inner, by: v) {
                    into.append(v)
                }
            }
            return true
        default: return false
    }
}

void learnBecomes(ref Binder b, through ref Ctx c, for BExpr e) {
    let isTry = boundKind(e) == .tryExpr
    let call = isTry ? c.bTries[boundIndex(e)].operand : e
    return if boundKind(call) != .call
    let fn = c.bCalls[boundIndex(call)].function
    let r = c.bCalls[boundIndex(call)].receiver
    let owner = c.functions[fn].owner
    return if !c.functions[fn].isMutating || owner == -1
    let decl = t22DeclFacts(ref c, for: fn)
    if (decl.becomes is { } to) {
        return if c.functions[fn].hasFails && !isTry
        let states = statesOf(ref c, for: owner)
        return if states == -1
        let state = findUnionVariant(ref c, by: states, for: t15Text(in c, from: c.functions[fn].file, at: to))
        return if state == -1
        var one = List<VariantId>()
        one.append(state)
        let type = internState(ref c, by: owner, for: in one)
        if r != -1 && boundKind(r) == .local {
            learnState(ref b, for: c.bLocals[boundIndex(r)].local, as: type)
        } else if r != -1 && boundKind(r) == .thisRef {
            learnState(ref b, for: t15ThisFacts(ref b, through: ref c), as: type)
        }
    }
}
== semantics/stdsource.byn
// Generated by SelfhostStdSourceTests under BAYAN_UPDATE=1 from lib/std/; do not edit.

/// The C# `StdLibrary.Shipped` files (StdLibrary.cs:36): every `lib/std/**/*.byn`, its path under `std/`.
List<StdSource> stdShippedSources() {
    var sources = List<StdSource>()
    sources.append(StdSource { path: "json/json.test.byn", text: stdSource0 })
    sources.append(StdSource { path: "json/reader.byn", text: stdSource1 })
    sources.append(StdSource { path: "json/value.byn", text: stdSource2 })
    return sources
}

const stdSource0: string = """// Tests of std.json. The "parse then encode" table's expected encodings are python3 `json.dumps` output (indent 0 is
// `json.dumps(v)`, N is `json.dumps(v, indent=N)`) for `json.loads` of the input, recorded from a run, not written by hand.
// Number text is kept as read (`1e400`, `1E2`; spec 016), so the cases with such numbers are not python's output.

/// The tree of `text`, trusted for the test.
JsonValue tree(string text) uses alloc fails JsonError {
    return (try Json.parse(text)).trustUnchecked() because "test input is a literal"
}

/// `ok`, or the error `Json.parse(text)` fails with, as `describe` writes it.
string errorOf(string text) uses alloc {
    let _ = Json.parse(text) catch switch {
        JsonError e => return describe(e),
    }
    return "ok"
}

/// `ok`, or the error `Json.encode(v)` fails with, as `describe` writes it.
string encodeErrorOf(JsonValue v) uses alloc {
    let _ = Json.encode(v) catch switch {
        JsonError e => return describe(e),
    }
    return "ok"
}

/// `e` as `kind message @offset line:column`, or its kind alone when it has no position.
string describe(JsonError e) uses alloc => e switch {
    .syntax s      => $"syntax {s.message} @{s.offset} {s.line}:{s.column}",
    .tooDeep d     => $"tooDeep @{d.offset} {d.line}:{d.column}",
    .nonFinite     => "nonFinite",
    .nestedTooDeep => "nestedTooDeep",
}

/// `depth` lists, each holding the next, around `null`.
JsonValue nested(i64 depth) uses alloc {
    var v = JsonValue.nothing
    for _ in 0..depth {
        var items = List<JsonValue>()
        items.append(move v)
        v = .list(items: move items)
    }
    return v
}

/// The tokens of `text`, one word each.
string tokensOf(string text) uses alloc fails JsonError {
    var reader = JsonReader.over(text)
    var sb = StrBuf()
    while true {
        let token = (try reader.next()) ?? break
        let word = token switch {
            .startObject     => "{",
            .endObject       => "}",
            .startList       => "[",
            .endList         => "]",
            .key(let name)   => $"key:{name}",
            .text(let value) => $"text:{value}",
            .number(let value, let digits) => $"number:{value}/{digits}",
            .flag(let value) => $"flag:{value}",
            .nothing         => "null",
        }
        sb.append($"{word} ")
    }
    return $"{sb.finish()}"
}

@cases(
    ("null", 0, "null"),
    ("null", 2, "null"),
    ("null", 4, "null"),
    ("true", 0, "true"),
    ("true", 2, "true"),
