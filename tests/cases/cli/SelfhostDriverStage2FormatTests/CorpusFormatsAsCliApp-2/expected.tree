// Statements A. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 2116–2776: `ParseBlock`,
// `ParseStatement`, locals, conditions, `InGroup`, `ParseBody(Token, ref …)`, `MatchingClose`,
// `if`/`unless` and the helpers of the guarded statement, and the loops through `ParseFor`,
// `ParseParenFor` and `SkipPastCloseParen`. Owner:
//
// A C# `Diagnostic?` kept for later is its index in `p.lexed.diagnostics`, -1 for `null`, and
// `Replace(d, d with { Fix = … })` sets that entry's fix in place. The C# fields `_bracesReport` and
// `_bracesFix` are a `BracesReport` the caller passes down, since `Parser` is T1's (Q461).

import lexer

/// What the last BYN1018 report of a body carried: its index and its own braces fix, so `parseUnless`
/// can hand the fix back when the header fix is dropped (the C# `_bracesReport`, `_bracesFix`).
struct BracesReport {
    i64      report         = -1
    bool     hasFix         = false
    TextSpan fixSpan        = TextSpan { start: 0, length: 0 }
    string   fixReplacement = ""
}

/// With `rejectPostfix`, a block statement: `rejectPostfixAfterCompound` after the `}`.
Stmt parseBlock(ref Parser p, bool rejectPostfix = false) {
    let start = p.current().start
    let open = p.expect(.openBrace)
    return Stmt.blockStmt(
        Owned(BlockStmt { span: TextSpan { start: start, length: 0 }, statements: List<Stmt>() }),
    ) if open.length == 0
    lintNestingDepth(ref p, at: open)
    var statements = List<Stmt>()
    while p.kind() != .closeBrace && !p.atEnd() {
        // Functions do not nest: a function header on a new line means this block was never closed.
        break if p.current().hasNewlineBefore && isFunctionStart(ref p)
        let before = p.pos
        let errors = p.syntaxErrors
        statements.append(parseStatement(ref p))
        recoverIfNeeded(ref p, from: errors)
        if p.pos == before {
            let _ = p.advance()
        }
    }
    expectClose(ref p, from: open, for: "block")
    p.blockDepth -= 1
    if p.bindExits.length > 0 {
        lintBindExits(ref p, for: statements)
    }
    let span = p.spanFrom(start)
    if rejectPostfix {
        rejectPostfixAfterCompound(ref p)
    }
    return Stmt.blockStmt(Owned(BlockStmt {
        span: statementSpan(ref p, at: start, from: span),
        statements: move statements,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

Stmt parseStatement(ref Parser p) {
    let start = p.current().start
    if p.kind() == .at && isName(p.peek(1)) {
        let attributes = parseStatementAttributes(ref p)
        if p.atEnd() || p.kind() == .closeBrace {
            let _ = p.report(
                .expected,
                at: spanOf(p.current()),
                arg0: "a statement after the attribute",
                arg1: p.describe(p.current()),
            )
            return Stmt.errorStmt(Owned(ErrorStmt { span: p.spanFrom(start), attributes: move attributes }))
        }
        // C# sets `with { Span = SpanFrom(start), Attributes = attributes }` on the result, but a built node is
        // read-only (BYN2782, Q471): the node takes both when it is built (`statementSpan`, `takeStatementAttributes`),
        // after the statement's end (`;`, a rejected postfix) is consumed.
        let key = p.current().start
        p.statementAttributeKeys.append(key)
        p.statementAttributeStarts.append(start)
        p.statementAttributes.append(move attributes)
        let statement = parseStatement(ref p)
        let _ = takeStatementAttributes(ref p, at: key)
        return statement
    }
    switch p.kind() {
        // C# `RejectPostfixAfterCompound(…)` wraps these; it runs before the node is built (`statementSpan`).
        case .openBrace:
            return parseBlock(ref p, rejectPostfix: true)
        case .semicolon:
            let semicolon = p.advance()
            reportSemicolon(ref p, for: semicolon)
            return Stmt.emptyStmt(Owned(EmptyStmt {
                span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
                attributes: takeStatementAttributes(ref p, at: start),
            }))
        case .letKeyword or .varKeyword or .constKeyword or .usingKeyword:
            return parseLocal(ref p, from: start)
        case .ifKeyword:
            return parseIf(ref p, from: start, rejectPostfix: true)
        case .unlessKeyword:
            return parseUnless(ref p, from: start, rejectPostfix: true)
        case .whileKeyword:
            let whileKeyword = p.advance()
            let whileIndex = p.pos - 1
            if p.accept(.letKeyword) {
                let variable = expectName(ref p, "a variable name")
                let _ = p.expect(.equals)
                let value = parseBareCondition(ref p)
                // C# takes the span before it parses the block, so it ends at the value (work/todo.md).
                let span = p.spanFrom(start)
                let block = parseBlock(ref p)
                return Stmt.whileLetStmt(Owned(WhileLetStmt {
                    span: statementSpan(ref p, at: start, from: span),
                    variable: variable,
                    value: move value,
                    body: move block,
                    attributes: takeStatementAttributes(ref p, at: start),
                }))
            }
            var parenthesized = false
            var parens: i64 = -1
            let condition = parseCondition(ref p, to: ref parenthesized, for: ref parens)
            let conditionEnd = p.prevEnd
            lintWrappedCondition(ref p, from: whileIndex, for: condition)
            let body = parenthesized ? parseBody(ref p, by: whileKeyword, to: ref parens) : parseBlock(ref p)
            lintWhileBind(
                ref p,
                at: whileKeyword,
                for: condition,
                by: body,
                until: conditionEnd,
                parenthesized: parenthesized,
            )
            return Stmt.whileStmt(Owned(WhileStmt {
                span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
                condition: move condition,
                body: move body,
                attributes: takeStatementAttributes(ref p, at: start),
            }))
        case .doKeyword:
            let doKeyword = p.advance()
            let body = parseBody(ref p, by: doKeyword)
            let _ = p.expect(.whileKeyword)
            var parens: i64 = -1
            let paren = p.kind() == .openParen && endsBefore(ref p, at: matchingClose(ref p, at: p.pos) + 1)
            let condition = paren ? parseParenCondition(ref p, to: ref parens) : parseBareCondition(ref p)
            expectEnd(ref p)
            return Stmt.doWhileStmt(Owned(DoWhileStmt {
                span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
                body: move body,
                condition: move condition,
                attributes: takeStatementAttributes(ref p, at: start),
            }))
        case .forKeyword or .foreachKeyword:
            return parseFor(ref p, from: start)
        case .switchKeyword:
            return parseSwitchStatement(ref p, at: start)
        case .deferKeyword or .errdeferKeyword:
            return parseDefer(ref p, at: start)
        case .contextKeyword or .provideKeyword:
            return parseContext(ref p, at: start)
        case .becomeKeyword:
            let _ = p.advance()
            let _ = p.expect(.dot)
            let state = expectName(ref p, "a state name")
            let args = p.kind() == .openParen
                && !p.current().hasNewlineBefore ? parseArguments(ref p) : List<Argument>()
            expectEnd(ref p)
            return Stmt.becomeStmt(Owned(BecomeStmt {
                span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
                state: state,
                args: move args,
                attributes: takeStatementAttributes(ref p, at: start),
            }))
        case .gotoKeyword:
            return parseGoto(ref p, at: start)
        case .assertKeyword:
            let _ = p.advance()
            // `assert(x)` is `assert (x)`: the parentheses are part of the expression.
            let condition = parseExpression(ref p)
            // `assert f() fails E.x`: the call must fail with that error.
            var failure: Expr = .none
            if p.kind() == .failsKeyword && !breaksLine(ref p, at: p.pos) {
                let _ = p.advance()
                failure = parseExpression(ref p)
            }
            expectEnd(ref p)
            return Stmt.assertStmt(Owned(AssertStmt {
                span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
                condition: move condition,
                failsKeyword: move failure,
                attributes: takeStatementAttributes(ref p, at: start),
            }))
        case .identifier:
            if p.peek(1) == .colon {
                let label = nameOf(p.advance())
                let _ = p.advance()
                // C# takes the span before it parses the statement, so it ends at the `:` (work/todo.md).
                let span = p.spanFrom(start)
                let statement = parseStatement(ref p)
                return Stmt.labeledStmt(Owned(LabeledStmt {
                    span: statementSpan(ref p, at: start, from: span),
                    label: label,
                    statement: move statement,
                    attributes: takeStatementAttributes(ref p, at: start),
                }))
            }
        case .elseKeyword:
            let _ = p.report(
                .expected,
                at: spanOf(p.current()),
                arg0: "a statement",
                arg1: p.describe(p.current()),
                help: "remove this `else`; it has no matching `if`",
            )
            let _ = p.advance()
            return Stmt.errorStmt(Owned(ErrorStmt {
                span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
                attributes: takeStatementAttributes(ref p, at: start),
            }))
        default:
            let _ = start
    }

    return parseLocal(ref p, from: start) if isLocalDeclarationStart(ref p)

    var ended = false
    let simple = parseSimpleStatement(ref p, at: start, to: ref ended)
    return simple if ended
    return finishSimpleStatement(ref p, at: start, for: move simple)
}

/// Whether the innermost pending statement attributes (`Parser.statementAttributes`) are for the
/// statement whose first token starts at `start`.
bool hasStatementAttributes(ref Parser p, at i64 start) =>
    p.statementAttributeKeys.length > 0 && p.statementAttributeKeys[p.statementAttributeKeys.length - 1] == start

/// The span of the statement at `start`: with attributes it is the C# `with { Span = SpanFrom(start) }` from them,
/// so the statement's end must already be consumed.
TextSpan statementSpan(ref Parser p, at i64 start, from TextSpan span) =>
    hasStatementAttributes(
        ref p,
        at: start,
    ) ? p.spanFrom(p.statementAttributeStarts[p.statementAttributeStarts.length - 1]) : span

/// The pending attributes of the statement at `start`, taken off the stack; none when they are not its.
List<AttributeSyntax> takeStatementAttributes(ref Parser p, at i64 start) {
    unless hasStatementAttributes(ref p, at: start) {
        return List<AttributeSyntax>()
    }
    let _ = p.statementAttributeKeys.removeLast()
    let _ = p.statementAttributeStarts.removeLast()
    return p.statementAttributes.removeLast()
}

/// A statement used as the body of `if`, loops and cleanup: a block or a single statement.
Stmt parseEmbedded(ref Parser p) => parseStatement(ref p)

/// C#-style `T name = …` or `T name` at the end of its line.
bool isLocalDeclarationStart(ref Parser p) {
    return false if !isTypeNameToken(p.kind()) && p.kind() != .openParen
    let after = scanType(ref p, at: p.pos)
    return after > 0 && isName(p.kindAt(after)) && !p.lexed.tokens[after].hasNewlineBefore
        && (p.kindAt(after + 1) == .equals || endsBefore(ref p, at: after + 1))
}

Stmt parseLocal(ref Parser p, from i64 start) {
    let isUsing = p.accept(.usingKeyword)
    var kind = BindingKind.varKeyword
    let keyword = p.kind() == .letKeyword || p.kind() == .varKeyword || p.kind() == .constKeyword
    if p.accept(.letKeyword) {
        kind = .letKeyword
    } else if p.accept(.varKeyword) {
        kind = .varKeyword
    } else if p.accept(.constKeyword) {
        kind = .constKeyword
    } else if isUsing {
        kind = .letKeyword
    }

    var type: TypeSyntax = .none
    var name = TextSpan { start: 0, length: 0 }
    if isNameThenType(ref p, at: p.pos) {
        name = expectName(ref p, "a variable name")
        let _ = p.advance()
        type = parseRefinement(ref p, from: parseType(ref p, fatArrow: true, lists: true))
    } else if isTypeThenName(ref p, at: p.pos) {
        type = parseType(ref p, lists: true)
        name = expectName(ref p, "a variable name")
        // A `let` needs a value, so a local declared without one is a `var`.
        if !keyword && !isUsing {
            kind = p.kind() != .equals
                || isWrittenLater(ref p, for: name) ? BindingKind.varKeyword : BindingKind.letKeyword
        }
        reportTypeFirstLocal(ref p, as: kind, by: keyword, from: typeSpan(in type), for: name)
    } else {
        name = expectName(ref p, "a variable name")
    }
    var init: Expr = .none
    if p.accept(.equals) {
        init = kind == .constKeyword && isPatternExprStart(ref p) ? parsePatternExpr(ref p) : parseExpression(ref p)
    }
    if (p.kind() == .ifKeyword || p.kind() == .unlessKeyword) && !p.current().hasNewlineBefore {
        let _ = p.report(
            .postfixNotSimple,
            at: spanOf(p.current()),
            arg0: p.textOf(p.current()),
            help: "declare the variable, then assign it conditionally; a declaration cannot be conditional",
        )
        let _ = p.advance()
        let _ = parseExpression(ref p)
    }
    expectEnd(ref p)
    if kind == .letKeyword && !(type is .none) {
        lintEmptyLiteral(ref p, for: type, by: init)
    }
    return Stmt.localDecl(Owned(LocalDecl {
        span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
        kind: kind,
        usingKeyword: isUsing,
        type: move type,
        name: name,
        init: move init,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

/// The input form `T x` of a local binding (BYN1043); the fix writes `let x: T`, keeping a `let`, `var` or
/// `const` already written.
void reportTypeFirstLocal(ref Parser p, as BindingKind kind, by bool keyword, from TextSpan type, for TextSpan name) {
    let span = TextSpan.fromBounds(type.start, until: name.end)
    let typeText = p.lexed.source.getText(type)
    let nameText = p.lexed.source.getText(name)
    let word = kind switch {
        .letKeyword   => "let",
        .constKeyword => "const",
        _             => "var",
    }
    let prefix = keyword ? "" : $"{word} "
    let _ = p.reportFix(
        .typeNameOrder,
        at: span,
        through: span,
        by: $"{prefix}{nameText}: {typeText}",
        arg0: $"{typeText} {nameText}",
        arg1: $"{word} {nameText}: {typeText}",
        label: "type before name",
        help: $"write `{word} {nameText}: {typeText}`; local bindings put the name first",
    )
}

/// Whether the rest of the enclosing block assigns `name`, increments it or passes it as `ref` or `out`, so
/// the BYN1043 fix declares it `var` (J55). A write through a mutating method is not seen here; the binder
/// reports it (BYN2104) with a fix to `var`.
bool isWrittenLater(ref Parser p, for TextSpan name) {
    var depth: i64 = 0
    for i in p.pos..p.count {
        let kind = p.kindAt(i)
        if kind == .openBrace {
            depth += 1
        } else if kind == .closeBrace {
            depth -= 1
            return false if depth < 0
        } else if kind == .endOfFile {
            return false
        }
        continue if kind != .identifier
            || !hasText(ref p, at: i, as: name)
            || i > 0 && (p.kindAt(i - 1) == .dot || p.kindAt(i - 1) == .questionDot)
        if i > 0 {
            let before = p.kindAt(i - 1)
            return true if before is .refKeyword or .outKeyword or .plusPlus or .minusMinus
        }
        var j = i + 1
        while true {
            if p.kindAt(j) == .dot && isName(p.kindAt(j + 1)) {
                j += 2
                continue
            }
            if p.kindAt(j) == .openBracket {
                let close = matchingClose(ref p, at: j)
                if close > 0 {
                    j = close + 1
                    continue
                }
            }
            break
        }
        if isAssignmentKind(p.kindAt(j)) || p.kindAt(j) == .plusPlus || p.kindAt(j) == .minusMinus
                || p.kindAt(j) == .greater && p.kindAt(j + 1) == .greaterEquals {
            return true
        }
    }
    return false
}

/// Whether token `index` has the source text of `name` (the C# `Text(_tokens[i]) != name`).
bool hasText(ref Parser p, at i64 index, as TextSpan name) {
    let token = p.lexed.tokens[index]
    return false if token.length != name.length
    for k in 0..name.length {
        return false if p.lexed.source.bytes[token.start + k] != p.lexed.source.bytes[name.start + k]
    }
    return true
}

/// `=` and the compound assignments, the C# `TokenKind.Equals or TokenKind.PlusEquals or …` lists.
bool isAssignmentKind(TokenKind kind) => kind switch {
    .equals or .plusEquals or .minusEquals or .starEquals or .slashEquals or .percentEquals or .ampEquals
        or .barEquals or .caretEquals or .lessLessEquals or .questionQuestionEquals => true,
    _ => false,
}

/// The input form `(c)`; the parentheses are reported (BYN1017) unless a top-level `{` needs them.
Expr parseParenCondition(ref Parser p, to ref i64 parens) {
    parens = -1
    let open = p.current()
    let keep = inGroup(ref p, at: p.pos, for: .openBrace)
    let errors = p.errorCount()
    let _ = p.expect(.openParen)
    let condition = parseExpression(ref p)
    let close = p.expect(.closeParen)
    if !keep && close.length > 0 && p.errorCount() == errors {
        let span = TextSpan.fromBounds(open.start, until: close.end)
        // C# `Trim()` of the text between the parentheses.
        var from = open.end
        var until = close.start
        while from < until && isTrimmed(p.lexed.source.bytes[from]) {
            from += 1
        }
        while until > from && isTrimmed(p.lexed.source.bytes[until - 1]) {
            until -= 1
        }
        let inner = p.lexed.source.getText(TextSpan.fromBounds(from, until: until))
        let space = open.hasTriviaBefore ? "" : " "
        parens = p.reportFix(
            .parenthesizedCondition,
            at: span,
            through: span,
            by: $"{space}{inner}",
            label: "not needed",
            help: "remove the parentheses",
        )
    }
    return condition
}

/// The ASCII whitespace C# `string.Trim()` removes.
bool isTrimmed(u8 b) => b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == 0x0B || b == 0x0C

/// The body of `keyword` after a parenthesized condition: a block, or the input form of a single statement,
/// reported (BYN1018) with a fix that wraps it in `{ }`.
Stmt parseBody(ref Parser p, by Token keyword) {
    var header: i64 = -1
    return parseBody(ref p, by: keyword, to: ref header)
}

/// `header` is the report on the header (BYN1017, BYN1007, BYN1019, …), whose fix also needs the braces to
/// parse; updated to the report that replaces it.
Stmt parseBody(ref Parser p, by Token keyword, to ref i64 header) {
    var braces = BracesReport {}
    return parseBody(ref p, by: keyword, to: ref header, for: ref braces)
}

/// `parseBody` that also fills `braces` with its BYN1018 report, for `parseUnless`.
Stmt parseBody(ref Parser p, by Token keyword, to ref i64 header, for ref BracesReport braces) {
    return parseBlock(ref p) if p.kind() == .openBrace
    let gapStart = p.prevEnd
    let errors = p.errorCount()
    let seen = p.lexed.diagnostics.length
    let bodyPos = p.pos
    let body = parseStatement(ref p)
    return body if p.errorCount() != errors && isErrorStmt(in body)
    // At the end of the file the statement takes no token: there is no text to wrap in braces.
    return body if p.pos == bodyPos && p.kind() == .endOfFile
    // Only an inner fix overlaps the braces fix; a diagnostic without one (e.g. BYN1006) leaves it applicable.
    var clean = true
    for i in seen..p.lexed.diagnostics.length {
        if !p.lexed.diagnostics[i].code.isEmpty && p.lexed.diagnostics[i].hasFix {
            clean = false
        }
    }
    header = reportBraceless(
        ref p,
        by: keyword,
        from: gapStart,
        at: stmtSpan(in body),
        as: clean,
        to: header,
        for: ref braces,
    )
    return body
}

/// BYN1018 on `body`, a single statement after `keyword`. A `header` fix takes the braces too, so that fix
/// parses applied alone and BYN1018 has none of its own. Returns the header's report.
i64 reportBraceless(
    ref Parser p,
    by Token keyword,
    from i64 gapStart,
    at TextSpan body,
    as bool clean,
    to i64 header,
    for ref BracesReport braces
) {
    // A body that took no token (an `errorExpr` before `}`) starts past `prevEnd`: the braces then wrap nothing.
    let start = body.start < p.prevEnd ? body.start : p.prevEnd
    let text = p.lexed.source.getText(TextSpan.fromBounds(start, until: p.prevEnd))
    let gap = p.lexed.source.getText(TextSpan.fromBounds(gapStart, until: start))
    var gapHasNewline = false
    for i in gapStart..start {
        if p.lexed.source.bytes[i] == '\n' {
            gapHasNewline = true
        }
    }
    let openBrace = "{"
    let closeBrace = "}"
    var replacement = ""
    if gapHasNewline {
        let line = p.lexed.source.getLineSpan(p.lexed.source.getLineIndex(keyword.start))
        var end = line.start
        while end < line.end && (p.lexed.source.bytes[end] == ' ' || p.lexed.source.bytes[end] == '\t') {
            end += 1
        }
        let indent = p.lexed.source.getText(TextSpan.fromBounds(line.start, until: end))
        replacement = $" {openBrace}{gap}{text}\n{indent}{closeBrace}"
    } else {
        replacement = $" {openBrace} {text} {closeBrace}"
    }
    // A fix inside the body (e.g. a nested `if (x) s;`) would overlap this one, which copies the body's text: only
    // the inner one gets a fix, and the header's fix is dropped because without the braces it does not parse.
    var hasFix = clean
    let fixSpan = TextSpan.fromBounds(gapStart, until: p.prevEnd)
    let ownHasFix = hasFix
    if header >= 0 && p.lexed.diagnostics[header].hasFix {
        let hSpan = p.lexed.diagnostics[header].fixSpan
        let hReplacement = p.lexed.diagnostics[header].fixReplacement
        let merged = TextSpan.fromBounds(hSpan.start, until: fixSpan.end)
        // The merged fix copies the source up to this body (an `if`'s `then` block before a braceless `else`); a
        // fix in there would overlap it, so the header loses its fix and BYN1018 keeps its own.
        var overlaps = false
        if hasFix {
            for i in 0..p.lexed.diagnostics.length {
                if i != header && !p.lexed.diagnostics[i].code.isEmpty && p.lexed.diagnostics[i].hasFix
                        && p.lexed.diagnostics[i].fixSpan.start < merged.end
                        && p.lexed.diagnostics[i].fixSpan.end > merged.start {
                    overlaps = true
                }
            }
        }
        if hasFix && !overlaps {
            let between = p.lexed.source.getText(TextSpan.fromBounds(hSpan.end, until: fixSpan.start))
            p.lexed.diagnostics[header].fixSpan = merged
            p.lexed.diagnostics[header].fixReplacement = $"{hReplacement}{between}{replacement}"
        } else {
            p.lexed.diagnostics[header].hasFix = false
        }
        if !overlaps {
            hasFix = false
        }
    }
    let keywordText = p.textOf(keyword)
    if hasFix {
        braces.report = p.reportFix(
            .bodyNeedsBraces,
            at: body,
            through: fixSpan,
            by: replacement,
            arg0: keywordText,
            label: "a single statement",
            help: "wrap the statement in `{ }`",
        )
    } else {
        braces.report = p.report(
            .bodyNeedsBraces,
            at: body,
            arg0: keywordText,
            label: "a single statement",
            help: "wrap the statement in `{ }`",
        )
    }
    braces.hasFix = ownHasFix
    braces.fixSpan = fixSpan
    braces.fixReplacement = replacement
    return header
}

/// The condition of `if`, `unless`, `while` or `switch`. `(c)` followed by a statement is the parenthesized
/// input form (`parenthesized`); otherwise the condition is bare and its body a block. `parens` is the BYN1017
/// report on the parentheses, if any, for a caller whose own fix removes them.
Expr parseCondition(ref Parser p, to ref bool parenthesized, for ref i64 parens) {
    parens = -1
    parenthesized = isParenthesizedCondition(ref p)
    return parenthesized ? parseParenCondition(ref p, to: ref parens) : parseBareCondition(ref p)
}

/// At `(`: whether the group is the whole condition, i.e. a statement or `{` follows its `)`, rather than the
/// start of a longer bare condition such as `(a + b) * c > d {`.
bool isParenthesizedCondition(ref Parser p) {
    // `switch (a, b) {` is a bare tuple condition.
    return false if p.kind() != .openParen || inGroup(ref p, at: p.pos, for: .comma)
    let next = matchingClose(ref p, at: p.pos) + 1
    let kind = p.kindAt(next)
    // Mirrors C#'s clamp (`_tokens[Math.Min(next, _count - 1)]`) for an unclosed `(`, like `kindAt`.
    return true if kind == .openBrace
        || kind == .semicolon
        || p.lexed.tokens[next < p.count ? next : p.count - 1].hasNewlineBefore
    return true if kind == .identifier
    return kind != .isKeyword
        && kind != .asKeyword
        && kind != .catchKeyword
        && kind != .withKeyword
        && kind != .inKeyword if lexer.isKeyword(kind)
    // An operator: a bare condition reaches its `{` body before the statement ends; a statement such as `-x` does not.
    return !bodyBraceFirst(ref p, from: next)
}

/// Whether, from `index`, a top-level `{` comes before any `;`, `}`, assignment, line break that ends the
/// statement, or the end. A condition has no assignment, so `(ok) p = P { x: 1 }` is a statement.
bool bodyBraceFirst(ref Parser p, from i64 index) {
    var depth: i64 = 0
    for i in index..p.count {
        return false if depth == 0 && i > index && breaksLine(ref p, at: i) && !lineContinues(ref p, at: i)
        let kind = p.kindAt(i)
        switch kind {
            case .openParen or .openBracket:
                depth += 1
            case .closeParen or .closeBracket:
                depth -= 1
            case .openBrace:
                return true if depth == 0
            case .semicolon or .closeBrace or .endOfFile:
                return false
            default:
                return false if depth == 0 && isAssignmentKind(kind)
        }
    }
    return false
}

/// The index of the `)` closing the `(` at `open`, or the end of file.
i64 matchingClose(ref Parser p, at i64 open) {
    var depth: i64 = 0
    for i in open..p.count {
        switch p.kindAt(i) {
            case .openParen or .openBracket or .openBrace:
                depth += 1
            case .closeParen or .closeBracket or .closeBrace:
                depth -= 1
                return i if depth == 0
            default:
                continue
        }
    }
    return p.count - 1
}

/// A condition without parentheses: a `{` at its top level opens the body, not a struct literal (spec §7.2).
Expr parseBareCondition(ref Parser p) {
    let saved = p.setConditionStart(p.pos)
    let condition = parseExpression(ref p)
    p.conditionStart = saved
    return condition
}

/// Whether a `{` here may open a struct literal or property pattern: not at the top level of a bare condition.
bool braceLiteralAllowed(ref Parser p) {
    return true if p.conditionStart < 0
    var depth: i64 = 0
    for i in p.conditionStart..p.pos {
        switch p.kindAt(i) {
            case .openParen or .openBracket or .openBrace:
                depth += 1
            case .closeParen or .closeBracket or .closeBrace:
                depth -= 1
            default:
                continue
        }
    }
    return depth > 0
}

/// `unlikely` after `if`, as a word rather than a variable: something follows it after a space.
bool atUnlikely(ref Parser p) =>
    atContextual(ref p, as: "unlikely")
    && p.peekToken(1).hasTriviaBefore
    && p.peek(1) != .openBrace
    && canStartExpression(p.peek(1))

Stmt parseIf(ref Parser p, from i64 start, bool elseIf = false, bool rejectPostfix = false) {
    let keyword = p.advance()
    let keywordIndex = p.pos - 1
    var likelihood = Likelihood.none
    if p.kind() == .neverKeyword && p.peek(1) != .openBrace && canStartExpression(p.peek(1)) {
        let _ = p.advance()
        likelihood = .neverKeyword
    } else if atUnlikely(ref p) {
        let _ = p.advance()
        likelihood = .unlikely
    }
    var parenthesized = false
    var parens: i64 = -1
    let conditionStart = p.current().start
    let condition = parseCondition(ref p, to: ref parenthesized, for: ref parens)
    let conditionEnd = p.prevEnd
    lintWrappedCondition(ref p, from: keywordIndex, for: condition)
    // The BYN1017 fix leaves a bare condition, after which `then` and `else` must both be blocks: it braces both.
    let then = parenthesized ? parseBody(ref p, by: keyword, to: ref parens) : parseBlock(ref p)
    var otherwise: Stmt = .none
    if p.kind() == .elseKeyword {
        if p.current().hasNewlineBefore && isBlockStmt(in then) && p.kindAt(p.pos - 1) == .closeBrace {
            let _ = p.reportFix(
                .elseOnNewLine,
                at: spanOf(p.current()),
                through: TextSpan.fromBounds(p.prevEnd, until: p.current().start),
                by: " ",
                label: "on a new line",
                help: "move `else` up to the line of `}`",
            )
        }
        let elseKeyword = p.advance()
        if p.kind() == .ifKeyword {
            otherwise = parseIf(ref p, from: p.current().start, elseIf: true, rejectPostfix: true)
        } else {
            otherwise = parenthesized ? parseBody(ref p, by: elseKeyword, to: ref parens) : parseBlock(ref p)
        }
    }
    let span = p.spanFrom(start)
    if !elseIf && !parenthesized {
        lintPostfixGuard(ref p, at: span, for: condition, by: then, from: otherwise, as: likelihood)
    }
    lintIfBind(
        ref p,
        at: span,
        for: condition,
        by: then,
        from: otherwise,
        as: likelihood,
        through: TextSpan.fromBounds(conditionStart, until: conditionEnd),
        parenthesized: parenthesized,
        elseIf: elseIf,
    )
    if rejectPostfix {
        rejectPostfixAfterCompound(ref p)
    }
    return Stmt.ifStmt(Owned(IfStmt {
        span: statementSpan(ref p, at: start, from: span),
        condition: move condition,
        then: move then,
        elseKeyword: move otherwise,
        likelihood: likelihood,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

/// `x is null`. The C# `Unwrap` is the recursion through `parenExpr` in `checkUnlessCondition`: a union is
/// not returned by reference (Q461).
bool isNullTest(in Expr e) {
    switch e {
        case .isExpr(let n):
            switch n.value.pattern {
                case .constantPattern(let c):
                    switch c.value.value {
                        case .literalExpr(let l):
                            return l.value.kind == .nullKeyword
                        default:
                            return false
                    }
                default:
                    return false
            }
        default:
            return false
    }
}

/// After `unless` (statement or postfix): the input forms `unless !x` (BYN1007), `unless a && b` (BYN1022) and
/// `unless x is null` (BYN1023), each fixed to an `if` over `fixSpan`. Returns the report, or -1.
i64 checkUnlessCondition(ref Parser p, from in Expr condition, at TextSpan fixSpan) {
    switch condition {
        case .parenExpr(let n):
            return checkUnlessCondition(ref p, from: in n.value.inner, at: fixSpan)
        case .unaryExpr(let n):
            if n.value.op == .notKeyword {
                let operand = p.lexed.source.getText(exprSpan(in n.value.operand))
                return p.reportFix(
                    .unlessNegated,
                    at: fixSpan,
                    through: fixSpan,
                    by: $"if {operand}",
                    label: "`unless` already negates",
                    help: "use `if` with the condition as written",
                )
            }
        case .binaryExpr(let n):
            if n.value.op is .logicalAnd or .logicalOr {
                let text = p.lexed.source.getText(n.value.span)
                return p.reportFix(
                    .unlessCompound,
                    at: fixSpan,
                    through: fixSpan,
                    by: $"if !({text})",
                    label: "a compound condition",
                    help: "use `if` with the negated condition",
                )
            }
        case .isExpr(let n):
            if isNullTest(in condition) {
                let value = p.lexed.source.getText(exprSpan(in n.value.value))
                return p.reportFix(
                    .unlessNull,
                    at: fixSpan,
                    through: fixSpan,
                    by: $"if {value} is not null",
                    label: "a negated null test",
                    help: "use `if` with `is not null`",
                )
            }
        default:
            return -1
    }
    return -1
}

/// A likelihood word after `unless` (BYN1033), removed by the fix.
void skipUnlessLikelihood(ref Parser p) {
    return if !(p.kind() == .neverKeyword && p.peek(1) != .openBrace && canStartExpression(p.peek(1)))
        && !atUnlikely(ref p)
    let word = p.advance()
    let _ = p.reportFix(
        .unlessLikelihood,
        at: spanOf(word),
        through: TextSpan.fromBounds(word.start, until: p.current().start),
        by: "",
        arg0: p.textOf(word),
        label: "a likelihood word",
        help: "remove the word, or write `if unlikely` with the negated condition",
    )
}

Stmt parseUnless(ref Parser p, from i64 start, bool rejectPostfix = false) {
    let keyword = p.advance()
    let keywordIndex = p.pos - 1
    skipUnlessLikelihood(ref p)
    var parenthesized = false
    var parens: i64 = -1
    let condition = parseCondition(ref p, to: ref parenthesized, for: ref parens)
    lintWrappedCondition(ref p, from: keywordIndex, for: condition)
    // The `if` fix spans the parentheses and drops them, so it replaces the BYN1017 report.
    let check = checkUnlessCondition(
        ref p,
        from: in condition,
        at: TextSpan.fromBounds(keyword.start, until: p.prevEnd),
    )
    if check >= 0 {
        unreport(ref p, at: parens)
    }
    var header = check >= 0 ? check : parens
    var braces = BracesReport {}
    let body = parenthesized ? parseBody(ref p, by: keyword, to: ref header, for: ref braces) : parseBlock(ref p)
    // `braces` holds this body's own BYN1018, the C# `_bracesReport?.Span == body.Span`.
    let bracesReport = parenthesized ? braces.report : -1
    if p.kind() == .elseKeyword {
        let _ = p.report(
            .unlessWithElse,
            at: spanOf(p.current()),
            label: "`else` after `unless`",
            help: "use `if` with the opposite condition, so both branches read positively",
        )
        let _ = p.advance()
        // The `if` fix of BYN1007/1022/1023 leaves a bare condition, which needs a block after `else`.
        let otherwise = parseEmbedded(ref p)
        if !isBlockStmt(in otherwise) && check >= 0 && header >= 0 && p.lexed.diagnostics[header].hasFix {
            p.lexed.diagnostics[header].hasFix = false
            // The braces the header fix carried go back to BYN1018, so one fix still applies alone.
            if bracesReport >= 0 && !p.lexed.diagnostics[bracesReport].hasFix && braces.hasFix {
                p.lexed.diagnostics[bracesReport].hasFix = true
                p.lexed.diagnostics[bracesReport].fixSpan = braces.fixSpan
                p.lexed.diagnostics[bracesReport].fixReplacement = braces.fixReplacement
            }
        }
    }
    let span = p.spanFrom(start)
    if rejectPostfix {
        rejectPostfixAfterCompound(ref p)
    }
    return Stmt.unlessStmt(Owned(UnlessStmt {
        span: statementSpan(ref p, at: start, from: span),
        condition: move condition,
        body: move body,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

Stmt parseFor(ref Parser p, from i64 start) {
    let keyword = p.advance()
    let isTry = p.accept(.tryKeyword)
    return parseParenFor(ref p, from: start, by: keyword, tryKeyword: isTry) if keyword.kind == .foreachKeyword
        || p.kind() == .openParen && !isTupleLoopVariables(ref p)

    var type: TypeSyntax = .none
    var variable = TextSpan { start: 0, length: 0 }
    var names = List<TextSpan>()
    if p.kind() == .openParen {
        let groupStart = p.current().start
        let _ = p.advance()
        names.append(expectName(ref p, "a loop variable"))
        while p.accept(.comma) {
            names.append(expectName(ref p, "a loop variable"))
        }
        let _ = p.expect(.closeParen)
        // The C# `Name(SpanFrom(groupStart), "_")`; the dump prints `names` instead.
        variable = p.spanFrom(groupStart)
        // `for (x) in xs`: parentheses around one loop variable, accepted like the other input forms (§15).
        if names.length == 1 {
            variable = names[0]
            names = List<TextSpan>()
        }
    } else if isNameThenType(ref p, at: p.pos) {
        variable = expectName(ref p, "a loop variable")
        let _ = p.advance()
        type = parseType(ref p)
    } else if isTypeThenName(ref p, at: p.pos) {
        // `for T x in e` follows the local rule, not the declaration rule (§25): BYN1043 with a fix to `for x: T in e`.
        type = parseType(ref p)
        variable = expectName(ref p, "a loop variable")
        let typeSpanOf = typeSpan(in type)
        let span = TextSpan.fromBounds(typeSpanOf.start, until: variable.end)
        let typeText = p.lexed.source.getText(typeSpanOf)
        let variableText = p.lexed.source.getText(variable)
        let _ = p.reportFix(
            .typeNameOrder,
            at: span,
            through: span,
            by: $"{variableText}: {typeText}",
            arg0: $"for {typeText} {variableText}",
            arg1: $"for {variableText}: {typeText}",
            label: "type before name",
            help: $"write `for {variableText}: {typeText}`; loop variables put the name first",
        )
    } else {
        variable = expectName(ref p, "a loop variable")
    }
    let _ = p.expect(.inKeyword)
    let iterable = parseBareCondition(ref p)
    let body = parseBlock(ref p)
    return Stmt.forStmt(Owned(ForStmt {
        span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
        kind: .letKeyword,
        type: move type,
        variable: variable,
        iterable: move iterable,
        body: move body,
        tryKeyword: isTry,
        names: move names,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

/// At `(` after `for`: the tuple `(a, b) in`, as opposed to the input form `(let x in xs)`, which has `let`,
/// `var`, `in` or `;` at the group's top level.
bool isTupleLoopVariables(ref Parser p) =>
    !inGroup(ref p, at: p.pos, for: .letKeyword) && !inGroup(ref p, at: p.pos, for: .varKeyword)
    && !inGroup(ref p, at: p.pos, for: .inKeyword) && !inGroup(ref p, at: p.pos, for: .semicolon)

/// The input form `for (let x in xs)`, `foreach (var x in xs)`, reported (BYN1019) with a fix to `for x in xs`.
/// `tryKeyword` is the C# `with { Try = isTry }`, set before the node is wrapped.
Stmt parseParenFor(ref Parser p, from i64 start, by Token keyword, bool tryKeyword = false) {
    let open = p.expect(.openParen)
    var kind = BindingKind.letKeyword
    var type: TypeSyntax = .none
    if p.accept(.letKeyword) {
        kind = .letKeyword
    } else if p.accept(.varKeyword) {
        kind = .varKeyword
    }
    if isTypeThenName(ref p, at: p.pos) {
        type = parseType(ref p)
    }
    let name = expectName(ref p, "a loop variable")
    if p.kind() != .inKeyword {
        let _ = p.report(
            .cStyleFor,
            at: spanOf(p.current()),
            label: "expected `in`",
            help: "loop over a range instead: `for i in 0..n { … }`",
        )
        skipPastCloseParen(ref p)
        let body0 = parseEmbedded(ref p)
        return Stmt.forStmt(Owned(ForStmt {
            span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
            kind: kind,
            type: move type,
            variable: name,
            iterable: Expr.errorExpr(Owned(ErrorExpr { span: name })),
            body: move body0,
            tryKeyword: tryKeyword,
            attributes: takeStatementAttributes(ref p, at: start),
        }))
    }
    let _ = p.advance()
    let errors = p.errorCount()
    let iterable = parseExpression(ref p)
    let close = p.expect(.closeParen)
    var input: i64 = -1
    if close.length > 0 && p.errorCount() == errors {
        let span = TextSpan.fromBounds(keyword.kind == .foreachKeyword ? keyword.start : open.start, until: close.end)
        let typeText = isNoType(in type) ? "" : $"{p.lexed.source.getText(typeSpan(in type))} "
        let header = $"{typeText}{nameText(ref p, at: name)} in {p.lexed.source.getText(exprSpan(in iterable))}"
        let replacement = keyword.kind == .foreachKeyword ? $"for {header}" : open.hasTriviaBefore ? header : $" {header}"
        input = p.reportFix(
            .forInputForm,
            at: span,
            through: span,
            by: replacement,
            label: "the input form",
            help: "write the loop variable and iterable without parentheses",
        )
    }
    let body = parseBody(ref p, by: keyword, to: ref input)
    return Stmt.forStmt(Owned(ForStmt {
        span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
        kind: kind,
        type: move type,
        variable: name,
        iterable: move iterable,
        body: move body,
        tryKeyword: tryKeyword,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

void skipPastCloseParen(ref Parser p) {
    var depth: i64 = 0
    while !p.atEnd() {
        if p.kind() == .openParen {
            depth += 1
        } else if p.kind() == .closeParen {
            if depth == 0 {
                let _ = p.advance()
                return
            }
            depth -= 1
        } else if p.kind() == .openBrace || p.kind() == .closeBrace {
            return
        }
        let _ = p.advance()
    }
}

bool isBlockStmt(in Stmt s) {
    switch s {
        case .blockStmt(_):
            return true
        default:
            return false
    }
}

bool isErrorStmt(in Stmt s) {
    switch s {
        case .errorStmt(_):
            return true
        default:
            return false
    }
}

bool isNoType(in TypeSyntax t) {
    switch t {
        case .none:
            return true
        default:
            return false
    }
}

// ── Node spans ───────────────────────────────────────────────────────────────
// The C# `Node.Span` of a union child. No task owns these in the plan (Q460); `.none` has no span in
// C# (a `null` child) and gives an empty one here.

public TextSpan stmtSpan(in Stmt s) => s switch {
    .blockStmt(let n)    => n.value.span,
    .localDecl(let n)    => n.value.span,
    .exprStmt(let n)     => n.value.span,
    .assignStmt(let n)   => n.value.span,
    .incDecStmt(let n)   => n.value.span,
    .returnStmt(let n)   => n.value.span,
    .failStmt(let n)     => n.value.span,
    .breakStmt(let n)    => n.value.span,
    .continueStmt(let n) => n.value.span,
    .becomeStmt(let n)   => n.value.span,
    .ifStmt(let n)       => n.value.span,
    .unlessStmt(let n)   => n.value.span,
    .guardedStmt(let n)  => n.value.span,
    .whileStmt(let n)    => n.value.span,
    .doWhileStmt(let n)  => n.value.span,
    .whileLetStmt(let n) => n.value.span,
    .forStmt(let n)      => n.value.span,
    .labeledStmt(let n)  => n.value.span,
    .switchStmt(let n)   => n.value.span,
    .deferStmt(let n)    => n.value.span,
    .assertStmt(let n)   => n.value.span,
    .contextStmt(let n)  => n.value.span,
    .emptyStmt(let n)    => n.value.span,
    .errorStmt(let n)    => n.value.span,
    .none                => TextSpan { start: 0, length: 0 },
}

public TextSpan typeSpan(in TypeSyntax t) => t switch {
    .namedType(let n)          => n.value.span,
    .optionalType(let n)       => n.value.span,
    .arrayType(let n)          => n.value.span,
    .tupleType(let n)          => n.value.span,
    .functionTypeSyntax(let n) => n.value.span,
    .dynType(let n)            => n.value.span,
    .refinedType(let n)        => n.value.span,
    .pointerType(let n)        => n.value.span,
    .none                      => TextSpan { start: 0, length: 0 },
}

// ── Stand-ins (T15 deletes this section) ─────────────────────────────────────
// Helpers the statements call that sibling files own and that have no T1 stub, as statics of `T7` so
// they cannot collide with the real ones. Each has the signature T7 assumed (Q460) and the smallest body
// that builds; the C# one-liners are ported as is so the T7 tests can run. When the siblings merge, T15
// deletes this struct and drops the `` prefix at the call sites.
== parser/stmts2.byn
// Statements B. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 2667–3160: `switch`, switch and
// jump labels, `defer`, `return`, `fail`, `break`/`continue`, `provide`/context, assignment and
// inc/dec, expression statements. Owner:
//
// The dispatch cases for `assert`, `become`, labeled statements, `EmptyStmt` and `ErrorStmt` are
// inline in `ParseStatement` (stmts.byn, T7), not here; see Q465. Lines 2667–2777 (`ParseFor` and
// friends) are T7's loops. This file ports 2778–3136.

import lexer

// ── Switch ───────────────────────────────────────────────────────────────────

Stmt parseSwitchStatement(ref Parser p, at i64 start) {
    let _ = p.advance()
    var parenthesized = false
    var parens: i64 = -1
    let value = parseCondition(ref p, to: ref parenthesized, for: ref parens)
    let open = p.expect(.openBrace)
    var sections = List<SwitchSection>()
    while p.kind() == .caseKeyword || p.kind() == .defaultKeyword {
        let sectionStart = p.current().start
        let first = parseSwitchLabel(ref p)
        var labelSpan: TextSpan = TextSpan { start: 0, length: 0 }
        var labelPattern: Pattern = .none
        var labelGuard: Expr = .none
        switch move first {
            case { span: let s, pattern: let pat, guard: let g }:
                labelSpan = s
                labelPattern = move pat
                labelGuard = move g
        }
        while p.kind() == .caseKeyword || p.kind() == .defaultKeyword {
            let stackedAt = spanOf(p.current())
            let next = parseSwitchLabel(ref p)
            let _ = p.report(
                .stackedCaseLabels,
                at: stackedAt,
                label: "a second label for the same statements",
                help: "combine the patterns into one label, e.g. `case .sat or .sun:`",
            )
            if labelPattern is not .none && next.pattern is not .none {
                switch move next {
                    case { span: _, pattern: let np, guard: _ }:
                        let mergedSpan = TextSpan.fromBounds(
                            patternSpan(in labelPattern).start,
                            until: patternSpan(in np).end,
                        )
                        labelPattern = Pattern.binaryPattern(Owned(BinaryPattern {
                            span: mergedSpan,
                            isAnd: false,
                            left: move labelPattern,
                            right: move np,
                        }))
                }
            }
        }
        var statements = List<Stmt>()
        while p.kind() != .caseKeyword
                && p.kind() != .defaultKeyword
                && p.kind() != .closeBrace
                && p.kind() != .endOfFile {
            let before = p.pos
            let errors = p.syntaxErrors
            statements.append(parseStatement(ref p))
            recoverIfNeeded(ref p, from: errors)
            if p.pos == before {
                let _ = p.advance()
            }
        }
        sections.append(SwitchSection {
            span: p.spanFrom(sectionStart),
            label: SwitchLabel { span: labelSpan, pattern: move labelPattern, guard: move labelGuard },
            statements: move statements,
        })
    }
    if p.kind() != .closeBrace && !p.atEnd() {
        let _ = p.report(
            .expected,
            at: spanOf(p.current()),
            arg0: "`case`, `default` or `}`",
            arg1: p.describe(p.current()),
        )
    }
    while p.kind() != .closeBrace && !p.atEnd() {
        let _ = p.advance()
    }
    expectClose(ref p, from: open, for: "switch")
    return Stmt.switchStmt(Owned(SwitchStmt {
        span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
        value: move value,
        sections: move sections,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

SwitchLabel parseSwitchLabel(ref Parser p) {
    let start = p.current().start
    if p.accept(.defaultKeyword) {
        let _ = p.expect(.colon)
        return SwitchLabel { span: p.spanFrom(start), pattern: .none, guard: .none }
    }
    let _ = p.advance()
    let pattern = parseArmPattern(ref p, for: "case ")
    var guard: Expr = .none
    if atContextual(ref p, as: "when") {
        let _ = p.advance()
        guard = parseExpression(ref p)
    }
    let _ = p.expect(.colon)
    return SwitchLabel { span: p.spanFrom(start), pattern: move pattern, guard: move guard }
}

/// The pattern of a `case` or a switch arm: `except` is not allowed there (BYN1051).
Pattern parseArmPattern(ref Parser p, for string head) {
    let start = p.current().start
    let pattern = parsePattern(ref p)
    return move pattern if p.kind() != .exceptKeyword
    let keyword = p.advance()
    let excluded = parsePattern(ref p)
    let excludedText = p.lexed.source.getText(patternSpan(in excluded))
    let notPat = Pattern.notPattern(Owned(NotPattern { span: patternSpan(in excluded), operand: move excluded }))
    let help = $"write the arm as `{head}not {excludedText}`"
    if pattern is .discardPattern(_) {
        let _ = p.reportFix(
            .exceptInCase,
            at: spanOf(keyword),
            through: p.spanFrom(start),
            by: $"not {excludedText}",
            label: "not allowed here",
            help: help,
        )
        return move notPat
    }
    let _ = p.report(.exceptInCase, at: spanOf(keyword), label: "not allowed here", help: help)
    return Pattern.binaryPattern(
        Owned(BinaryPattern { span: p.spanFrom(start), isAnd: true, left: move pattern, right: move notPat }),
    )
}

// ── Defer ────────────────────────────────────────────────────────────────────

/// `defer`, `defer failing`, `defer panicking` (contextual words) or `errdefer`, each but the first with an optional `(name)`.
Stmt parseDefer(ref Parser p, at i64 start) {
    let keyword = p.advance()
    var kind: DeferKind = keyword.kind == .errdeferKeyword ? .failing : .always
    if kind == .failing {
        let _ = p.reportFix(
            .errdeferInput,
            at: spanOf(keyword),
            through: spanOf(keyword),
            by: "defer failing",
            label: "the input form",
            help: "write `defer failing`",
        )
    }
    // `failing` and `panicking` are words only here, and only when a statement or `(name)` binding follows.
    if kind == .always && (atContextual(ref p, as: "failing") || atContextual(ref p, as: "panicking"))
            && (startsDeferBody(ref p, at: 1) || isBinding(ref p, at: 1) && startsDeferBody(ref p, at: 4)) {
        kind = p.textOf(p.advance()) == "failing" ? .failing : .panicking
    }
    var binding: TextSpan? = null
    if kind != .always && isBinding(ref p, at: 0) {
        let _ = p.advance()
        binding = nameOf(p.advance())
        let _ = p.advance()
    }
    let span = p.spanFrom(start)
    let gapStart = p.prevEnd
    let errors = p.errorCount()
    let body = parseEmbedded(ref p)
    if body is .localDecl(_) {
        var braces = BracesReport {}
        let _ = reportBraceless(
            ref p,
            by: keyword,
            from: gapStart,
            at: stmtSpan(in body),
            as: p.errorCount() == errors,
            to: -1,
            for: ref braces,
        )
    }
    return Stmt.deferStmt(Owned(DeferStmt {
        span: statementSpan(ref p, at: start, from: span),
        kind: kind,
        binding: binding,
        body: move body,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

/// Whether a defer body starts at `n`: a statement on the same line.
bool startsDeferBody(ref Parser p, at i64 n) =>
    !p.peekToken(n).hasNewlineBefore && ((p.peek(n) is .identifier or .openBrace) || lexer.isKeyword(p.peek(n)))

bool isBinding(ref Parser p, at i64 n) =>
    p.peek(n) == .openParen && isName(p.peek(n + 1)) && p.peek(n + 2) == .closeParen

bool atContextual(ref Parser p, as string word) => p.kind() == .identifier && p.textOf(p.current()) == word

// ── Provide / context ────────────────────────────────────────────────────────

/// `provide allocator: a { … }`, or the input form `context (allocator: a) { … }` (BYN6006).
Stmt parseContext(ref Parser p, at i64 start) {
    let keyword = p.advance()
    let parenthesized = keyword.kind == .contextKeyword
    if parenthesized {
        let _ = p.expect(.openParen)
    }
    var values = List<NamedArg>()
    if !parenthesized || p.kind() != .closeParen {
        while true {
            let argStart = p.current().start
            let name = expectName(ref p, what: "a context name such as `allocator`")
            let _ = p.expect(.colon)
            let value = parenthesized ? parseExpression(ref p) : parseBareCondition(ref p)
            values.append(NamedArg { span: p.spanFrom(argStart), name: name, value: move value })
            break if !p.accept(.comma)
        }
    }
    if parenthesized {
        let _ = p.expect(.closeParen)
        let text = values.length == 0 ? "…"
            : p.lexed.source.getText(
                TextSpan.fromBounds(values[0].span.start, until: values[values.length - 1].span.end),
            )
        let help = $"write `provide {text} {{ }}` without the parentheses"
        if values.length == 0 {
            let _ = p.report(.contextBlockInput, at: spanOf(keyword), label: "the input form", help: help)
        } else {
            let _ = p.reportFix(
                .contextBlockInput,
                at: spanOf(keyword),
                through: TextSpan.fromBounds(keyword.start, until: p.prevEnd),
                by: $"provide {text}",
                label: "the input form",
                help: help,
            )
        }
    }
    let body = parseBlock(ref p)
    return Stmt.contextStmt(Owned(ContextStmt {
        span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
        values: move values,
        body: move body,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

// ── Goto ─────────────────────────────────────────────────────────────────────

Stmt parseGoto(ref Parser p, at i64 start) {
    let keyword = p.advance()
    if p.kind() == .caseKeyword || p.kind() == .defaultKeyword {
        let _ = p.report(
            .gotoKeyword,
            at: spanOf(keyword),
            label: "`goto case` does not exist",
            help: "combine patterns with `or`, or move shared code into a function; switch sections never fall through",
        )
        synchronize(ref p)
        return Stmt.errorStmt(Owned(ErrorStmt {
            span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
            attributes: takeStatementAttributes(ref p, at: start),
        }))
    }
    let _ = p.reportFix(
        .gotoKeyword,
        at: spanOf(keyword),
        through: spanOf(keyword),
        by: "break",
        label: "not a keyword in Bayan",
        help: "label the loop (`outer: for x in xs { … }`) and use `break outer` to leave it early",
    )
    var label: TextSpan? = null
    if p.kind() == .identifier && !p.current().hasNewlineBefore {
        label = nameOf(p.advance())
    }
    expectEnd(ref p)
    return Stmt.breakStmt(Owned(BreakStmt {
        span: statementSpan(ref p, at: start, from: p.spanFrom(start)),
        label: label,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

// ── Simple statements ────────────────────────────────────────────────────────

/// A statement that may take a postfix `if`/`unless`; its end is not consumed.
Stmt parseSimpleStatement(ref Parser p, at i64 start, to ref bool ended) {
    switch p.kind() {
        case .returnKeyword:
            let keyword = p.advance()
            var hasValue = canStartExpression(p.kind()) && !breaksLine(ref p, at: p.pos)
            // A value alone on the next line, or indented past `return`, reads as the operand that wandered off (BYN1042).
            let valueOnly = endsBefore(ref p, at: p.pos + 1) || lexer.isStringLiteral(p.kind())
                || p.kind() is .integerLiteral or .floatLiteral or .charLiteral or .interpolatedStringStart or .dot
                || indentAt(ref p, at: p.current().start).length > indentAt(ref p, at: keyword.start).length
            if breaksLine(ref p, at: p.pos)
                    && !hasBlankLineBefore(ref p, at: p.pos)
                    && valueOnly
                    && canStartExpression(p.kind())
                    && !isStatementKeyword(p.kind())
                    && !(p.kind() is .openBrace
                    or .openParen
                    or .openBracket
                    or .minus
                    or .returnKeyword
                    or .breakKeyword
                    or .continueKeyword) {
                reportOnNewLine(ref p, for: keyword)
                hasValue = true
            }
            var value: Expr = .none
            if hasValue {
                value = parseExpression(ref p)
            }
            let span = p.spanFrom(start)
            let key = simpleKey(ref p, at: start, to: ref ended)
            return Stmt.returnStmt(Owned(ReturnStmt {
                span: statementSpan(ref p, at: key, from: span),
                value: move value,
                attributes: takeStatementAttributes(ref p, at: key),
            }))
        case .failKeyword:
            let keyword = p.advance()
            if breaksLine(ref p, at: p.pos) && !hasBlankLineBefore(ref p, at: p.pos) && canStartExpression(p.kind())
                    && !isStatementKeyword(p.kind()) {
                reportOnNewLine(ref p, for: keyword)
            }
            let span = p.spanFrom(start)
            let error = parseExpression(ref p)
            let key = simpleKey(ref p, at: start, to: ref ended)
            return Stmt.failStmt(Owned(FailStmt {
                span: statementSpan(ref p, at: key, from: span),
                error: move error,
                attributes: takeStatementAttributes(ref p, at: key),
            }))
        case .breakKeyword:
            let span = p.spanFrom(start)
            let label = parseJumpLabel(ref p, for: p.advance())
            let key = simpleKey(ref p, at: start, to: ref ended)
            return Stmt.breakStmt(Owned(BreakStmt {
                span: statementSpan(ref p, at: key, from: span),
                label: label,
                attributes: takeStatementAttributes(ref p, at: key),
            }))
        case .continueKeyword:
            let span = p.spanFrom(start)
            let label = parseJumpLabel(ref p, for: p.advance())
            let key = simpleKey(ref p, at: start, to: ref ended)
            return Stmt.continueStmt(Owned(ContinueStmt {
                span: statementSpan(ref p, at: key, from: span),
                label: label,
                attributes: takeStatementAttributes(ref p, at: key),
            }))
        case .plusPlus or .minusMinus:
            let increment = p.advance().kind == .plusPlus
            let target = parseUnary(ref p)
            checkAssignable(ref p, for: in target)
            let span = p.spanFrom(start)
            let key = simpleKey(ref p, at: start, to: ref ended)
            return Stmt.incDecStmt(Owned(IncDecStmt {
                span: statementSpan(ref p, at: key, from: span),
                target: move target,
                increment: increment,
                attributes: takeStatementAttributes(ref p, at: key),
            }))
        default:
    }

    let errors = p.errorCount()
    let expr = parseExpression(ref p)
    let op = tryAssignOp(ref p)
    if !breaksLine(ref p, at: p.pos) && (op is { } assignOp) {
        let width = assignOp == .shr ? 2 : 1
        for _ in 0..width {
            let _ = p.advance()
        }
        checkAssignable(ref p, for: in expr)
        let value = parseExpression(ref p)
        let span = p.spanFrom(start)
        let key = simpleKey(ref p, at: start, to: ref ended)
        return Stmt.assignStmt(Owned(AssignStmt {
            span: statementSpan(ref p, at: key, from: span),
            target: move expr,
            op: assignOp,
            value: move value,
            attributes: takeStatementAttributes(ref p, at: key),
        }))
    }
    if p.kind() is .plusPlus or .minusMinus && !breaksLine(ref p, at: p.pos) {
        let increment = p.advance().kind == .plusPlus
        checkAssignable(ref p, for: in expr)
        let span = p.spanFrom(start)
        let key = simpleKey(ref p, at: start, to: ref ended)
        return Stmt.incDecStmt(Owned(IncDecStmt {
            span: statementSpan(ref p, at: key, from: span),
            target: move expr,
            increment: increment,
            attributes: takeStatementAttributes(ref p, at: key),
        }))
    }
    if p.errorCount() == errors && !isStatementExpression(in expr) {
        let _ = p.report(
            .invalidExpressionStatement,
            at: exprSpan(in expr),
            label: "the value is computed and discarded",
            help: "write `_ = f()` to discard a call's result; only calls, assignments and `++`/`--` can stand alone",
        )
    }
    let span = p.spanFrom(start)
    let key = simpleKey(ref p, at: start, to: ref ended)
    return Stmt.exprStmt(Owned(ExprStmt {
        span: statementSpan(ref p, at: key, from: span),
        expr: move expr,
        attributes: takeStatementAttributes(ref p, at: key),
    }))
}

/// The key a simple statement takes its attributes by: none when a postfix `if`/`unless` follows, whose
/// `GuardedStmt` takes them instead, as C# sets them on the statement `ParseStatement` returns. Without one the
/// statement ends here (`ended`): its `expectEnd`, run before the node is built so `statementSpan` takes in a `;`.
i64 simpleKey(ref Parser p, at i64 start, to ref bool ended) {
    return -1 if postfixFollows(ref p)
    expectEnd(ref p)
    ended = true
    return start
}

/// The label of `break`/`continue`: on its line, or alone on the next (BYN1042).
TextSpan? parseJumpLabel(ref Parser p, for Token keyword) {
    return null if p.kind() != .identifier
    return nameOf(p.advance()) if !p.current().hasNewlineBefore
    return null if !breaksLine(ref p, at: p.pos)
        || hasBlankLineBefore(ref p, at: p.pos)
        || !endsBefore(ref p, at: p.pos + 1)
    reportOnNewLine(ref p, for: keyword)
    return nameOf(p.advance())
}

/// BYN1042: the operand of `keyword` starts the next line; the fix joins it to the keyword's line.
void reportOnNewLine(ref Parser p, for Token keyword) {
    let _ = p.reportFix(
        .onNewLine,
        at: spanOf(p.current()),
        through: TextSpan.fromBounds(p.prevEnd, until: p.current().start),
        by: " ",
        arg0: p.textOf(keyword),
        label: "on the next line",
        help: $"move the value to the line of `{p.textOf(keyword)}`",
    )
}

bool isStatementExpression(in Expr expr) {
    switch expr {
        case .callExpr(_):
            return true
        case .tryExpr(let t):
            return isStatementExpression(in t.value.operand)
        case .catchExpr(let c):
            return isStatementExpression(in c.value.operand)
        case .binaryExpr(let b):
            return true if b.value.op == .coalesce && b.value.right is .jumpExpr(_)
            return false
        case .errorExpr(_):
            return true
        default:
            return false
    }
}

AssignOp? tryAssignOp(ref Parser p) {
    let op: AssignOp? = p.kind() switch {
        .equals                 => AssignOp.assign,
        .plusEquals             => AssignOp.add,
        .minusEquals            => AssignOp.sub,
        .starEquals             => AssignOp.mul,
        .slashEquals            => AssignOp.div,
        .percentEquals          => AssignOp.rem,
        .ampEquals              => AssignOp.andKeyword,
        .barEquals              => AssignOp.orKeyword,
        .caretEquals            => AssignOp.xor,
        .lessLessEquals         => AssignOp.shl,
        .questionQuestionEquals => AssignOp.coalesce,
        _                       => null,
    }
    return op if op is not null
    return AssignOp.shr if p.kind() == .greater && p.peek(1) == .greaterEquals && !p.peekToken(1).hasTriviaBefore
    return null
}

void checkAssignable(ref Parser p, for in Expr target) {
    switch target {
        case .nameExpr(_):
            // `_` or any name: assignable.
            return
        case .memberExpr(let m) when !m.value.nullConditional:
            return
        case .indexExpr(_):
            return
        case .errorExpr(_):
            return
        // `map.slot(k)` is a reference; the binder checks the receiver is a map.
        case .callExpr(let c) when c.value.callee is .memberExpr(let callee) && !callee.value.nullConditional
            && p.lexed.source.getText(callee.value.member) == "slot":
            return
        case .parenExpr(let paren):
            checkAssignable(ref p, for: in paren.value.inner)
            return
        default:
            let _ = p.report(
                .invalidAssignmentTarget,
                at: exprSpan(in target),
                help: "assign to a variable, a field or an indexed element",
            )
            return
    }
}

/// A postfix `if`/`unless` on the statement's line, then the end of the statement. Called only when one
/// follows (`simpleKey`); the chained condition and the end are consumed before the node is built (`statementSpan`).
Stmt finishSimpleStatement(ref Parser p, at i64 start, for move Stmt statement) {
    let stranded = strandedPostfix(ref p)
    if stranded {
        let _ = p.reportFix(
            .postfixOnNewLine,
            at: spanOf(p.current()),
            through: TextSpan.fromBounds(p.prevEnd, until: p.current().start),
            by: " ",
            arg0: p.textOf(p.current()),
            label: "on the next line",
            help: $"move the `{p.textOf(p.current())}` clause up to the statement's line",
        )
    }
    let keyword = p.advance()
    let isUnless = keyword.kind == .unlessKeyword
    let unlikely = !isUnless && atUnlikely(ref p)
    if unlikely {
        let _ = p.advance()
    }
    if isUnless {
        skipUnlessLikelihood(ref p)
    }
    let condition = parseExpression(ref p)
    if isUnless {
        let _ = checkUnlessCondition(
            ref p,
            from: in condition,
            at: TextSpan.fromBounds(keyword.start, until: exprSpan(in condition).end),
        )
    }
    let span = p.spanFrom(start)
    if (p.kind() is .ifKeyword or .unlessKeyword) && !breaksLine(ref p, at: p.pos) {
        let _ = p.report(
            .postfixChained,
            at: spanOf(p.current()),
            label: "a second condition",
            help: "combine the conditions with `&&` in one postfix `if`",
        )
        let _ = p.advance()
        let _ = parseExpression(ref p)
    }
    expectEnd(ref p)
    return Stmt.guardedStmt(Owned(GuardedStmt {
        span: statementSpan(ref p, at: start, from: span),
        statement: move statement,
        unlessKeyword: isUnless,
        condition: move condition,
        unlikely: unlikely,
        attributes: takeStatementAttributes(ref p, at: start),
    }))
}

/// A postfix `if`/`unless` alone on the next line, which still attaches (BYN1042).
bool strandedPostfix(ref Parser p) =>
    (p.kind() is .ifKeyword or .unlessKeyword) && breaksLine(ref p, at: p.pos) && !hasBlankLineBefore(ref p, at: p.pos)
    && p.peek(1) != .openParen && !bodyBraceFirst(ref p, from: p.pos + 1)

/// Whether a postfix `if`/`unless` that `finishSimpleStatement` attaches comes next.
bool postfixFollows(ref Parser p) =>
    (p.kind() is .ifKeyword or .unlessKeyword) && (strandedPostfix(ref p) || !p.current().hasNewlineBefore)

/// `{ … } if x` on one line: postfix conditions only attach to simple statements. The block, `if` or `unless`
/// calls it before building its node, so an attributed span takes it in (`statementSpan`).
void rejectPostfixAfterCompound(ref Parser p) {
    if (p.kind() is .ifKeyword or .unlessKeyword) && !p.current().hasNewlineBefore && p.peek(1) != .openParen
            && !bodyBraceFirst(ref p, from: p.pos + 1) {
        let _ = p.report(
            .postfixNotSimple,
            at: spanOf(p.current()),
            arg0: p.textOf(p.current()),
            help: "put the condition first: `if cond { … }`",
        )
        let _ = p.advance()
        let _ = parseExpression(ref p)
        expectEnd(ref p)
    }
}

// ── Node spans ───────────────────────────────────────────────────────────────

/// The `span` of a pattern node (the C# `Pattern.Span`).
public TextSpan patternSpan(in Pattern p) {
    switch p {
        case .constantPattern(let n): return n.value.span
        case .relationalPattern(let n): return n.value.span
        case .varPattern(let n): return n.value.span
        case .discardPattern(let n): return n.value.span
        case .declarationPattern(let n): return n.value.span
        case .notPattern(let n): return n.value.span
        case .binaryPattern(let n): return n.value.span
        case .propertyPattern(let n): return n.value.span
        case .positionalPattern(let n): return n.value.span
        case .variantPattern(let n): return n.value.span
        case .slicePattern(let n): return n.value.span
        case .listPattern(let n): return n.value.span
        case .none: return TextSpan { start: 0, length: 0 }
    }
}

// ── T8 stand-ins (T15 deletes) ───────────────────────────────────────────────

/// Stand-ins for siblings' helpers that have no stub on this branch, so this file builds on its own.
== parser/types.byn
// Types. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 1743–2113 (`IsTypeNameToken`, `IsDynAt`, `ScanType`,
// `IsTypeArrow`, `ScanFunctionType`, `ScanClauseList`, `ScanTypeArgs`, `ScanExprTypeArgs`, `CSharpTypeNames`,
// `ParseType`, `ParseFunctionType`, `ParseClauseList`, `ReadOnlyPointee`, `ParsePrefixPointer`, `PointeeText`,
// `ReportPointerOutsideExtern`, `ParseNamedType`, `MissingType`, `ParseTypeArgs`). Owner:
//
// The C# rewrites two finished nodes with `with`: a parenthesized lone function type gets the span of its
// parentheses, and `ReadOnlyPointee` widens the outer pointers of `readonly T*` and marks the innermost one.
// An `Owned` node is read-only and cannot be moved out of, so both are decided before the node is wrapped:
// `parseTypeParts` hands a function type back unwrapped (`ParsedType.function`), and the suffix loop builds the
// pointers `ReadOnlyPointee` would touch with their final span and flag (`readOnlyStart`, `starsEndType`).

import lexer

/// A type from `parseTypeParts`: a function type is not yet wrapped, so the caller can still set its span.
union ParsedType {
    done(TypeSyntax type)
    function(FunctionTypeSyntax node)
}

TypeSyntax wrapType(move ParsedType parsed) {
    switch move parsed {
        case .done(let type):
            return move type
        case .function(let node):
            return TypeSyntax.functionTypeSyntax(Owned(move node))
    }
}

bool isTypeNameToken(TokenKind kind) => kind is .identifier or .neverKeyword

/// Whether `dyn` at `index` starts a type: `dyn ref I` or `dyn I`.
bool isDynAt(ref Parser p, at i64 index) =>
    p.kindAt(index) == .identifier && lexer.sameBytes(p.text(p.lexed.tokens[index]), as: "dyn".bytes)
    && (p.kindAt(index + 1) == .refKeyword || isTypeNameToken(p.kindAt(index + 1)))

/// Speculatively scans a type starting at `index`; returns the index after it, or -1.
i64 scanType(ref Parser p, at i64 index) => scanTypeNested(ref p, at: index, nested: false).end

/// `scanType`; `nested` (inside a type's parentheses or type arguments, or where `parseType` takes BYN1055)
/// scans `=>` as a function type's arrow, and `function` says whether the type scanned is a function type.
(i64 end, bool function) scanTypeNested(ref Parser p, at i64 index, bool nested) {
    var at = index
    var i: i64 = 0
    if p.kindAt(at) == .openParen {
        i = at + 1
        var elements: i64 = 0
        var lone = false
        var names = true
        if p.kindAt(i) != .closeParen {
            while true {
                let elementStart = i
                let element = scanTypeNested(ref p, at: i, nested: true)
                i = element.end
                lone = element.function
                return (end: -1, function: false) if i < 0
                names = names && i == elementStart + 1
                if isName(p.kindAt(i)) {
                    i += 1
                    names = false
                }
                elements += 1
                break if p.kindAt(i) != .comma
                i += 1
            }
        }
        return (end: -1, function: false) if p.kindAt(i) != .closeParen
        i += 1
        // `(a, b) => …` at a statement start is a lambda, not a tuple type.
        return (end: -1, function: false) if !nested && names && p.kindAt(i) == .fatArrow
        return scanFunctionType(ref p, at: i, nested: nested) if isTypeArrow(ref p, at: i, nested: nested)
        return (end: -1, function: false) if elements < 2 && !(elements == 1 && lone)
    } else {
        if isDynAt(ref p, at: at) {
            at += 1
            if p.kindAt(at) == .refKeyword {
                at += 1
                if p.kindAt(at) == .readonlyKeyword {
                    at += 1
                }
            }
        }
        return (end: -1, function: false) if !isTypeNameToken(p.kindAt(at))
        i = at + 1
        while p.kindAt(i) == .dot && p.kindAt(i + 1) == .identifier {
            i += 2
        }
        if p.kindAt(i) == .less {
            i = scanTypeArgs(ref p, at: i)
            return (end: -1, function: false) if i < 0
        }
    }
    while true {
        if p.kindAt(i) == .question {
            i += 1
        } else if p.kindAt(i) == .openBracket && (p.kindAt(i + 1) == .integerLiteral || p.kindAt(i + 1) == .identifier)
                && p.kindAt(i + 2) == .closeBracket {
            i += 3
        } else if p.kindAt(i) == .star && !p.lexed.tokens[i].hasTriviaBefore {
            // `u8* p` is a pointer type; `a*b` is a product.
            var j = i
            while p.kindAt(j) == .star && !p.lexed.tokens[j].hasTriviaBefore {
                j += 1
            }
            return (end: i, function: false) if j >= p.count || !p.lexed.tokens[j].hasTriviaBefore
            i = j
        } else if isTypeArrow(ref p, at: i, nested: nested) {
            return scanFunctionType(ref p, at: i, nested: nested)
        } else {
            return (end: i, function: false)
        }
    }
}

/// Whether a function type's arrow is at `index`: `->`, or `=>` when `nested`.
bool isTypeArrow(ref Parser p, at i64 index, bool nested) =>
    p.kindAt(index) == .arrow || nested && !p.exprTypeArgs && p.kindAt(index) == .fatArrow

/// Scans `-> R uses e fails E` starting at the arrow; returns the index after it, or -1.
(i64 end, bool function) scanFunctionType(ref Parser p, at i64 index, bool nested) {
    var i = scanTypeNested(ref p, at: index + 1, nested: nested).end
    // Either order, once each: the parser reports `fails` before `uses` (BYN1065).
    var seenFails = false
    var seenUses = false
    while i > 0 && (p.kindAt(i) == .failsKeyword && !seenFails || p.kindAt(i) == .usesKeyword && !seenUses) {
        let names = p.kindAt(i) == .usesKeyword
        if names {
            seenUses = true
        } else {
            seenFails = true
        }
        i = scanClauseList(ref p, at: i + 1, names: names)
    }
    return (end: i, function: true)
}

/// Scans the types after `fails` or the names after `uses`, bare or parenthesized; returns the index after them, or -1.
i64 scanClauseList(ref Parser p, at i64 index, bool names) {
    let paren = p.kindAt(index) == .openParen
    var i = paren ? index + 1 : index
    while true {
        if names {
            i = isName(p.kindAt(i)) ? i + 1 : -1
        } else {
            i = scanTypeNested(ref p, at: i, nested: true).end
        }
        break if i < 0 || p.kindAt(i) != .comma
        i += 1
    }
    return i if !paren || i < 0
    return p.kindAt(i) == .closeParen ? i + 1 : -1
}

/// Scans `<T, U>` starting at the `<`; returns the index after `>`, or -1.
i64 scanTypeArgs(ref Parser p, at i64 index) {
    var i = index + 1
    while true {
        i = scanTypeNested(ref p, at: i, nested: true).end
        return -1 if i < 0
        if p.kindAt(i) == .comma {
            i += 1
            continue
        }
        return p.kindAt(i) == .greater ? i + 1 : -1
    }
}

/// `scanTypeArgs` for type arguments after a name in an expression.
i64 scanExprTypeArgs(ref Parser p, at i64 index) {
    let saved = p.setExprTypeArgs(value: true)
    let end = scanTypeArgs(ref p, at: index)
    p.exprTypeArgs = saved
    return end
}

/// The C# `CSharpTypeNames`: a C# type name written in a type position with the Bayan type it means, or `""`.
/// The C# parser rewrites the name's text; a `NamedType` path here is spans, so the dump applies this to a
/// one-name path without type arguments (Q455).
public string cSharpTypeName(string name) => name switch {
    "int"    => "i32",
    "long"   => "i64",
    "short"  => "i16",
    "byte"   => "u8",
    "uint"   => "u32",
    "ulong"  => "u64",
    "float"  => "f32",
    "double" => "f64",
    _        => "",
}

/// A type. With `fatArrow` (a parameter type, an alias target, a local's annotation, a type argument) `=>` after a
/// type is a function type's input form (BYN1055); elsewhere it is left to an expression body. With `lists` (the
/// same places but a type argument) a function type's `fails` and `uses` take comma lists; elsewhere one name or
/// a parenthesized list (Q352).
TypeSyntax parseType(ref Parser p, bool fatArrow = false, bool lists = false) =>
    wrapType(parseTypeParts(ref p, fatArrow: fatArrow, lists: lists))

/// `parseType` with a function type left unwrapped. `readOnlyStart` is the start of the `readonly` this type follows,
/// or -1 (the C# `ReadOnlyPointee`).
ParsedType parseTypeParts(ref Parser p, bool fatArrow = false, bool lists = false, i64 readOnlyStart = -1) {
    let start = p.current().start
    var type: TypeSyntax = .none
    return ParsedType.done(parsePrefixPointer(ref p)) if p.kind() == .star
    if p.kind() == .readonlyKeyword {
        let end = scanType(ref p, at: p.pos + 1)
        if end > 0 && p.kindAt(end - 1) == .star {
            let _ = p.advance()
            return parseTypeParts(ref p, readOnlyStart: readOnlyStart >= 0 ? readOnlyStart : start)
        }
    }
    if p.kind() == .openParen && scanTypeNested(ref p, at: p.pos, nested: fatArrow).end > 0 {
        let _ = p.advance()
        var elements = List<TupleTypeElement>()
        // A first element that is a function type, unnamed and alone, stays unwrapped until `)` says whether
        // the parentheses only group it.
        var lone = ParsedType.done(.none)
        var loneSpan = TextSpan { start: 0, length: 0 }
        var hasLone = false
        if p.kind() != .closeParen {
            do {
                let elementStart = p.current().start
                let element = parseTypeParts(ref p, fatArrow: true, lists: lists)
                let name: TextSpan? = isName(p.kind()) ? spanOf(p.advance()) : null
                let span = p.spanFrom(elementStart)
                if elements.length == 0 && name is null && element is .function(_) && p.kind() != .comma {
                    lone = move element
                    loneSpan = span
                    hasLone = true
                } else {
                    elements.append(TupleTypeElement { span: span, type: wrapType(move element), name: name })
                }
            } while p.accept(.comma)
        }
        let _ = p.expect(.closeParen)
        if p.kind() == .arrow || fatArrow && p.kind() == .fatArrow {
            if hasLone {
                elements.append(TupleTypeElement { span: loneSpan, type: wrapType(move lone), name: null })
            }
            return ParsedType.function(
                parseFunctionType(ref p, from: start, by: move elements, fatArrow: fatArrow, lists: lists),
            )
        }
        // `(Token -> bool) p`: the parentheses around a function type only group it.
        if hasLone {
            switch move lone {
                case .function(var node):
                    node.span = p.spanFrom(start)
                    type = TypeSyntax.functionTypeSyntax(Owned(move node))
                default:
                    type = .none
            }
        } else {
            type = TypeSyntax.tupleType(Owned(TupleType { span: p.spanFrom(start), elements: move elements }))
        }
    } else if isDynAt(ref p, at: p.pos) {
        let _ = p.advance()
        let isRef = p.accept(.refKeyword)
        let isReadOnly = isRef && p.accept(.readonlyKeyword)
        let inner = parseNamedType(ref p)
        type = TypeSyntax.dynType(
            Owned(DynType { span: p.spanFrom(start), isRef: isRef, isReadOnly: isReadOnly, inner: move inner }),
        )
    } else if isTypeNameToken(p.kind()) {
        type = parseNamedType(ref p)
    } else {
        return ParsedType.done(missingType(ref p))
    }

    // Whether the pointer built last is one `ReadOnlyPointee` widens, so the next one is not its innermost.
    var widened = false
    while true {
        if p.kind() == .question {
            let _ = p.advance()
            let inner = move type
            type = TypeSyntax.optionalType(Owned(OptionalType { span: p.spanFrom(start), inner: move inner }))
        } else if p.kind() == .openBracket
                && (p.peek(1) == .integerLiteral || p.peek(1) == .identifier)
                && p.peek(2) == .closeBracket {
            let _ = p.advance()
            let size = parsePrimary(ref p)
            let _ = p.expect(.closeBracket)
            let element = move type
            type = TypeSyntax.arrayType(
                Owned(ArrayType { span: p.spanFrom(start), element: move element, size: move size }),
            )
        } else if p.kind() == .star && !p.current().hasTriviaBefore {
            let widen = readOnlyStart >= 0 && starsEndType(ref p, fatArrow: fatArrow)
            let _ = p.advance()
            let span = p.spanFrom(start)
            let pointee = move type
            type = TypeSyntax.pointerType(Owned(PointerType {
                span: widen ? TextSpan.fromBounds(readOnlyStart, until: span.end) : span,
                pointee: move pointee,
                readOnly: widen && !widened,
            }))
            widened = widen
            if p.kind() != .star {
                reportPointerOutsideExtern(ref p, at: span)
            }
        } else if p.kind() == .arrow || fatArrow && p.kind() == .fatArrow {
            // Every node above spans from `start`, so this is `type.Span`.
            var parameters = List<TupleTypeElement>()
            parameters.append(TupleTypeElement { span: p.spanFrom(start), type: move type, name: null })
            return ParsedType.function(
                parseFunctionType(ref p, from: start, by: move parameters, fatArrow: fatArrow, lists: lists),
            )
        } else {
            return ParsedType.done(move type)
        }
    }
}

/// Whether the `*` at the cursor starts the last suffixes of the type: only `*`s follow it, so the pointers they
/// make are the outer ones `ReadOnlyPointee` rewrites (the C# rewrites the finished type; see the file comment).
bool starsEndType(ref Parser p, bool fatArrow) {
    var j = p.pos
    while p.kindAt(j) == .star && !p.lexed.tokens[j].hasTriviaBefore {
        j += 1
    }
    let k = p.kindAt(j)
    return false if k == .question || k == .arrow || fatArrow && k == .fatArrow
    return !(k == .openBracket && (p.kindAt(j + 1) == .integerLiteral || p.kindAt(j + 1) == .identifier)
        && p.kindAt(j + 2) == .closeBracket)
}

/// `-> R uses e fails E` after the parameter types of a function type, right-associative: `A -> B -> C` returns
/// `B -> C`. `=>` for the arrow is BYN1055, fixed to `->`; `fails` before `uses` is BYN1065.
FunctionTypeSyntax parseFunctionType(
    ref Parser p,
    from i64 start,
    by move List<TupleTypeElement> parameters,
    bool fatArrow,
    bool lists
) {
    for e in parameters {
        let name = e.name
        if name is not null {
            let _ = p.report(
                .expected,
                at: name,
                arg0: "`,` or `)`",
                arg1: $"`{p.lexed.source.getText(name)}`",
                label: "a parameter name",
                help: "remove the name; a function type lists only its parameter types",
            )
        }
    }
    let arrow = p.advance()
    if arrow.kind == .fatArrow {
        let _ = p.reportFix(
            .fatArrowFunctionType,
            at: spanOf(arrow),
            through: spanOf(arrow),
            by: "->",
            label: "the input form",
            help: "write the function type with `->`",
        )
    }
    let result = parseType(ref p, fatArrow: fatArrow, lists: lists)
    var failsClause: FailsClause? = null
    var usesClause: UsesClause? = null
    var clauses = List<SignatureClause>()
    // The C# takes the clause's span before its list is parsed (argument order), so it covers the keyword only.
    while p.kind() == .usesKeyword && usesClause is null || p.kind() == .failsKeyword && failsClause is null {
        let keyword = p.advance()
        let span = p.spanFrom(keyword.start)
        var rank: i64 = 4
        if keyword.kind == .usesKeyword {
            rank = 2
            let effects = parseClauseNames(ref p, lists: lists)
            usesClause = UsesClause { span: span, effects: move effects }
        } else {
            let errors = parseClauseTypes(ref p, lists: lists)
            failsClause = FailsClause { span: span, errors: move errors }
        }
        // The ranks of a declaration's clauses (`parseFunction`).
        clauses.append(SignatureClause { rank: rank, keyword: keyword, end: p.prevEnd })
    }
    reportClauseOrder(ref p, for: in clauses)
    return FunctionTypeSyntax {
        span: p.spanFrom(start),
        params: elementTypes(move parameters),
        returnKeyword: move result,
        failsKeyword: move failsClause,
        usesKeyword: move usesClause,
    }
}

/// `parameters.Select(p => p.Type)`: a `List` element cannot be moved out of, so each is popped and destructured,
/// and popped again to restore the order.
List<TypeSyntax> elementTypes(move List<TupleTypeElement> parameters) {
    var elements = move parameters
    var reversed = List<TypeSyntax>()
    while elements.length > 0 {
        let e = elements.removeLast()
        switch move e {
            case { type: let type }:
                reversed.append(move type)
        }
    }
    var types = List<TypeSyntax>()
    while reversed.length > 0 {
        types.append(reversed.removeLast())
    }
    return types
}

/// `ParseClauseList(lists, () => ParseType())`: the error types after a function type's `fails`, a comma list
/// with `lists`, else one, or a parenthesized list (Q352).
List<TypeSyntax> parseClauseTypes(ref Parser p, bool lists) {
    let paren = p.kind() == .openParen
    if paren {
        let _ = p.advance()
    }
    var items = List<TypeSyntax>()
    items.append(parseType(ref p))
    while (lists || paren) && p.accept(.comma) {
        items.append(parseType(ref p))
    }
    if paren {
        let _ = p.expect(.closeParen)
    }
    return items
}

/// `ParseClauseList(lists, () => ExpectName("an effect name"))`: the effects after a function type's `uses`.
List<TextSpan> parseClauseNames(ref Parser p, bool lists) {
    let paren = p.kind() == .openParen
    if paren {
        let _ = p.advance()
    }
    var items = List<TextSpan>()
    items.append(expectName(ref p, what: "an effect name"))
    while (lists || paren) && p.accept(.comma) {
        items.append(expectName(ref p, what: "an effect name"))
    }
    if paren {
        let _ = p.expect(.closeParen)
    }
    return items
}

/// `*T`, `*mut T` and `*const T`, the BYN1066 input forms of `T*` and `readonly T*`.
TypeSyntax parsePrefixPointer(ref Parser p) {
    let start = p.current().start
    let star = p.advance()
    let readOnly = p.accept(.constKeyword)
    if !readOnly && atContextual(ref p, as: "mut") && isTypeNameToken(p.peek(1)) {
        let _ = p.advance()
    }
    let pointee = parseType(ref p)
    let span = p.spanFrom(start)
    let canonical = $"{readOnly ? "readonly " : ""}{pointeeText(in pointee, from: ref p)}*"
    // `**T` nests input forms; the inner one gets the fix first, and has already raised BYN1067.
    let nested = pointee is .pointerType(_)
    if nested {
        let _ = p.report(
            .prefixPointerInput,
            at: spanOf(star),
            arg0: p.lexed.source.getText(span),
            arg1: canonical,
            label: "the input form",
            help: $"write the pointer after the type: `{canonical}`",
        )
    } else {
        let _ = p.reportFix(
            .prefixPointerInput,
            at: spanOf(star),
            through: span,
            by: canonical,
            arg0: p.lexed.source.getText(span),
            arg1: canonical,
            label: "the input form",
            help: $"write the pointer after the type: `{canonical}`",
        )
    }
    let type = TypeSyntax.pointerType(Owned(PointerType { span: span, pointee: move pointee, readOnly: readOnly }))
    if !nested {
        reportPointerOutsideExtern(ref p, at: span)
    }
    return type
}

/// The canonical text of a pointee: its source, or for a nested pointer the postfix spelling.
string pointeeText(in TypeSyntax pointee, from ref Parser p) {
    switch pointee {
        case .pointerType(let n):
            return $"{n.value.readOnly ? "readonly " : ""}{pointeeText(in n.value.pointee, from: ref p)}*"
        default:
            return p.lexed.source.getText(typeSpan(in pointee))
    }
}

/// BYN1067 at `span`, the C# `ReportPointerOutsideExtern(type)` with `type.Span`.
void reportPointerOutsideExtern(ref Parser p, at TextSpan span) {
    return if p.inExtern
    // Not through `report`: the type parsed in full, so no recovery is needed, and BYN1066 for a prefix pointer
    // starts at the same `*` and would make `report`'s same-start check drop this one.
    p.lexed.diagnostics.append(Diagnostic {
        code: codeText(.pointerOutsideExtern),
        span: span,
        message: format(messageFormat(.pointerOutsideExtern), by: (a0: "", a1: "", a2: "")),
        label: "a pointer type",
        help: "wrap the C call in an `extern` declaration",
        hasFix: false,
        fixSpan: span,
        fixReplacement: "",
    })
}

/// `Name`, `m.Name` or `Name<A>` without suffixes: a type, a base, a `where` bound or after `dyn`.
TypeSyntax parseNamedType(ref Parser p) {
    return missingType(ref p) if !isTypeNameToken(p.kind())
    let start = p.current().start
    var path = List<TextSpan>()
    path.append(spanOf(p.advance()))
    while p.kind() == .dot && p.peek(1) == .identifier {
        let _ = p.advance()
        path.append(spanOf(p.advance()))
    }
    var args = List<TypeSyntax>()
    if p.kind() == .less && scanTypeArgs(ref p, at: p.pos) > 0 {
        args = parseTypeArgs(ref p)
    }
    // The C# first rewrites a `CSharpTypeNames` name (`int` → `i32`, no diagnostic); that is the dump's here
    // (`cSharpTypeName`, Q455). `char` is not among them, so it reaches this branch either way.
    if path.length == 1
            && args.length == 0
            && lexer.sameBytes(p.lexed.source.bytes.span[path[0].start..path[0].end], as: "char".bytes) {
        let _ = p.reportFix(
            .charInput,
            at: path[0],
            through: path[0],
            by: "rune",
            label: "the input form",
            help: "rename the type to `rune`",
        )
    }
    return TypeSyntax.namedType(Owned(NamedType { span: p.spanFrom(start), path: move path, args: move args }))
}

/// The C# `NamedType` named `<missing>`: a one-name path of zero length at the cursor (Q455).
TypeSyntax missingType(ref Parser p) {
    let start = p.current().start
    let _ = p.report(.expectedType, at: spanOf(p.current()), arg0: p.describe(p.current()))
    var path = List<TextSpan>()
    path.append(TextSpan { start: start, length: 0 })
    return TypeSyntax.namedType(
        Owned(NamedType { span: TextSpan { start: start, length: 0 }, path: move path, args: List<TypeSyntax>() }),
    )
}

List<TypeSyntax> parseTypeArgs(ref Parser p) {
    let _ = p.advance()
    var args = List<TypeSyntax>()
    args.append(parseType(ref p, fatArrow: true))
    while p.accept(.comma) {
        args.append(parseType(ref p, fatArrow: true))
    }
    let _ = p.expect(.greater)
    return args
}

// ── T6 stand-ins (T15 deletes) ───────────────────────────────────────────────
== semantics/bigint.byn
// T5: the Big and BigParse operations declared in ctx.byn.

// ── Construction, parsing and text ───────────────────────────────────────────

/// The two's-complement bits of `v`.
u64 bigBitsOfI64(i64 v) => v >= 0 ? u64(v) : ~u64(-(v + 1))

/// `v` read as a two's-complement i64.
i64 bigI64OfBits(u64 v) => v < 0x8000000000000000 ? i64(v) : -i64(~v) - 1

/// Whether `a` is negative (its top bit is set).
bool bigIsNeg(Big a) => (a.hi & 0x8000000000000000) != 0

/// The zero `Big`.
Big bigZero() => Big { lo: 0, hi: 0 }

Big bigFromI64(i64 v) {
    let hi: u64 = v >= 0 ? 0 : 0xFFFFFFFFFFFFFFFF
    return Big { lo: bigBitsOfI64(v), hi: hi }
}

Big bigFromU64(u64 v) => Big { lo: v, hi: 0 }

/// A literal's value: digits, `_` separators, and an `0x`/`0X` or `0b`/`0B` prefix. `ok` is false on an
/// empty or bad digit; `overflow` is true above 2^127-1, where `value` is unspecified.
BigParse bigParse(string text) {
    let max = Big { lo: 0xFFFFFFFFFFFFFFFF, hi: 0x7FFFFFFFFFFFFFFF }
    let b = text.bytes
    var base: u64 = 10
    var i: i64 = 0
    if b.length >= 2 && b[0] == 48 {
        if b[1] is 120 or 88 {
            base = 16
            i = 2
        } else if b[1] is 98 or 66 {
            base = 2
            i = 2
        }
    }
    var acc = bigZero()
    var any = false
    var bad = false
    var overflow = false
    while i < b.length {
        let ch = b[i]
        i += 1
        continue if ch == 95
        var dv: u64 = 0
        if ch is 48..=57 {
            dv = u64(ch - 48)
        } else if ch is 97..=102 {
            dv = u64(ch - 87)
        } else if ch is 65..=70 {
            dv = u64(ch - 55)
        } else {
            bad = true
            break
        }
        if dv >= base {
            bad = true
            break
        }
        any = true
        if !overflow {
            let digitBig = Big { lo: dv, hi: 0 }
            let limit = bigUDivSmall(bigSub(max, by: digitBig), by: base).q
            if bigCmp(acc, as: limit) > 0 {
                overflow = true
            } else {
                acc = bigAdd(bigMul(acc, by: Big { lo: base, hi: 0 }), by: digitBig)
            }
        }
    }
    return BigParse { value: bigZero(), ok: false, overflow: false } if bad || !any
    return BigParse { value: acc, ok: true, overflow: overflow }
}

/// The literal's value in decimal, of any size (C#'s `BigInteger.ToString`), for the out-of-range message.
string literalDecimalText(string text) {
    let b = text.bytes
    var base: u64 = 10
    var i: i64 = 0
    if b.length >= 2 && b[0] == 48 {
        if b[1] is 120 or 88 {
            base = 16
            i = 2
        } else if b[1] is 98 or 66 {
            base = 2
            i = 2
        }
    }
    var digits = List<i64>()
    while i < b.length {
        let ch = b[i]
        i += 1
        continue if ch == 95
        var dv: u64 = 0
        if ch is 48..=57 {
            dv = u64(ch - 48)
        } else if ch is 97..=102 {
            dv = u64(ch - 87)
        } else if ch is 65..=70 {
            dv = u64(ch - 55)
        }
        var carry: u64 = dv
        for j in 0..digits.length {
            let v = u64(digits[j]) * base + carry
            digits[j] = i64(v % 10)
            carry = v / 10
        }
        while carry > 0 {
            digits.append(i64(carry % 10))
            carry = carry / 10
        }
    }
    return "0" if digits.length == 0
    var sb = StrBuf()
    for k in 0..digits.length {
        sb.append(string(digits[digits.length - 1 - k]))
    }
    return $"{sb.finish()}"
}

/// Signed decimal text, like `Int128.ToString()`.
public string bigText(Big n) uses alloc {
    return "0" if n.lo == 0 && n.hi == 0
    let neg = bigIsNeg(n)
    var m = neg ? bigNeg(n) : n
    var digits = List<i64>()
    while m.lo != 0 || m.hi != 0 {
        let t = bigUDivSmall(m, by: 10)
        m = t.q
        digits.append(i64(t.r))
    }
    var sb = StrBuf()
    if neg {
        sb.append("-")
    }
    for i in 0..digits.length {
        sb.append(string(digits[digits.length - 1 - i]))
    }
    return $"{sb.finish()}"
}

// ── Comparison ───────────────────────────────────────────────────────────────

/// Signed comparison: -1, 0 or 1.
public i32 bigCmp(Big a, as Big b) {
    let ah = bigI64OfBits(a.hi)
    let bh = bigI64OfBits(b.hi)
    return -1 if ah < bh
    return 1 if ah > bh
    return -1 if a.lo < b.lo
    return 1 if a.lo > b.lo
    return 0
}

bool bigEq(Big a, as Big b) => a.lo == b.lo && a.hi == b.hi

// ── Arithmetic ───────────────────────────────────────────────────────────────

/// Two's-complement negation, so `-MIN == MIN`.
Big bigNeg(Big a) {
    let lo = ~a.lo +% 1
    let hi = lo == 0 ? ~a.hi +% 1 : ~a.hi
    return Big { lo: lo, hi: hi }
}

/// Wrapping addition, modulo 2^128.
Big bigAdd(Big a, by Big b) {
    let lo = a.lo +% b.lo
    let carry: u64 = lo < a.lo ? 1 : 0
    let hi = a.hi +% b.hi
    return Big { lo: lo, hi: hi +% carry }
}

/// Wrapping subtraction, modulo 2^128.
Big bigSub(Big a, by Big b) {
    let lo = a.lo -% b.lo
    let borrow: u64 = a.lo < b.lo ? 1 : 0
    let hi = a.hi -% b.hi
    return Big { lo: lo, hi: hi -% borrow }
}

/// The low 128 bits of the product.
Big bigMul(Big a, by Big b) {
    let al = a.lo & 0xFFFFFFFF
    let ah = a.lo >> 32
    let bl = b.lo & 0xFFFFFFFF
    let bh = b.lo >> 32
    let ll = al * bl
    let lh = al * bh
    let hl = ah * bl
    let hh = ah * bh
    let mid = (ll >> 32) + (lh & 0xFFFFFFFF) + (hl & 0xFFFFFFFF)
    let lo = (mid << 32) | (ll & 0xFFFFFFFF)
    let hi = hh +% (lh >> 32) +% (hl >> 32) +% (mid >> 32) +% (a.lo *% b.hi) +% (a.hi *% b.lo)
    return Big { lo: lo, hi: hi }
}

/// Signed division, truncating toward zero; `b` is nonzero. `MIN / -1` wraps to `MIN`.
Big bigDiv(Big a, by Big b) {
    let negA = bigIsNeg(a)
    let negB = bigIsNeg(b)
    let ma = negA ? bigNeg(a) : a
    let mb = negB ? bigNeg(b) : b
    let q = bigUDiv(ma, by: mb)
    return negA == negB ? q : bigNeg(q)
}

/// Signed remainder, taking the sign of `a` like C#'s `%`; `b` is nonzero.
Big bigRem(Big a, by Big b) {
    let ma = bigIsNeg(a) ? bigNeg(a) : a
    let mb = bigIsNeg(b) ? bigNeg(b) : b
    let r = bigURem(ma, by: mb)
    return bigIsNeg(a) ? bigNeg(r) : r
}

// ── Unsigned helpers (the division below works on magnitudes) ────────────────

/// Unsigned comparison: -1, 0 or 1.
i32 bigUCmp(Big a, as Big b) {
    return -1 if a.hi < b.hi
    return 1 if a.hi > b.hi
    return -1 if a.lo < b.lo
    return 1 if a.lo > b.lo
    return 0
}

/// Logical (zero-filling) right shift by `n` in 0..127.
Big bigUShr(Big a, by i64 n) {
    return a if n == 0
    return Big { lo: a.hi >> (n - 64), hi: 0 } if n >= 64
    return Big { lo: (a.lo >> n) | (a.hi << (64 - n)), hi: a.hi >> n }
}

/// The number of significant bits in `v`; 0 for zero.
i64 bigU64BitLength(u64 v) {
    var n: i64 = 0
    var x = v
    while x != 0 {
        n += 1
        x = x >> 1
    }
    return n
}

/// The number of significant bits in an unsigned `Big`; 0 for zero.
i64 bigUBitLength(Big a) => a.hi != 0 ? 64 + bigU64BitLength(a.hi) : bigU64BitLength(a.lo)

/// Unsigned 128-bit division by a nonzero `b`, by long division from bit 127 down.
Big bigUDiv(Big a, by Big b) {
    var q = bigZero()
    var r = bigZero()
    var x = a
    for i in 0..128 {
        let bit = x.hi >> 63
        x = Big { lo: x.lo << 1, hi: (x.hi << 1) | (x.lo >> 63) }
        r = Big { lo: (r.lo << 1) | bit, hi: (r.hi << 1) | (r.lo >> 63) }
        if bigUCmp(r, as: b) >= 0 {
            r = bigSub(r, by: b)
            q = bigOr(q, by: bigShl(Big { lo: 1, hi: 0 }, by: 127 - i))
        }
    }
    return q
}

/// Unsigned remainder by a nonzero `b`.
Big bigURem(Big a, by Big b) => bigSub(a, by: bigMul(bigUDiv(a, by: b), by: b))

/// Unsigned division by a small `d` (< 2^32), 32 bits of quotient per step.
(Big q, u64 r) bigUDivSmall(Big a, by u64 d) {
    var r: u64 = 0
    let x3 = r * 4294967296 + (a.hi >> 32)
    let q3 = x3 / d
    r = x3 % d
    let x2 = r * 4294967296 + (a.hi & 0xFFFFFFFF)
    let q2 = x2 / d
    r = x2 % d
    let x1 = r * 4294967296 + (a.lo >> 32)
    let q1 = x1 / d
    r = x1 % d
    let x0 = r * 4294967296 + (a.lo & 0xFFFFFFFF)
    let q0 = x0 / d
    r = x0 % d
    return (q: Big { lo: (q1 << 32) | q0, hi: (q3 << 32) | q2 }, r: r)
}

// ── Shifts and bit operations ────────────────────────────────────────────────

/// Logical left shift by `n` in 0..127; bits shifted out are lost.
Big bigShl(Big a, by i64 n) {
    return a if n == 0
    return Big { lo: 0, hi: a.lo << (n - 64) } if n >= 64
    return Big { lo: a.lo << n, hi: (a.hi << n) | (a.lo >> (64 - n)) }
}

/// Arithmetic right shift by `n` in 0..127: the sign bit fills from the left.
Big bigShr(Big a, by i64 n) {
    return a if n == 0
    let fill: u64 = bigIsNeg(a) ? 0xFFFFFFFFFFFFFFFF : 0
    if n >= 64 {
        let k = n - 64
        let lo = k == 0 ? a.hi : (a.hi >> k) | (fill << (64 - k))
        return Big { lo: lo, hi: fill }
    }
    return Big { lo: (a.lo >> n) | (a.hi << (64 - n)), hi: (a.hi >> n) | (fill << (64 - n)) }
}

Big bigAnd(Big a, by Big b) => Big { lo: a.lo & b.lo, hi: a.hi & b.hi }

Big bigOr(Big a, by Big b) => Big { lo: a.lo | b.lo, hi: a.hi | b.hi }

Big bigXor(Big a, by Big b) => Big { lo: a.lo ^ b.lo, hi: a.hi ^ b.hi }

Big bigNot(Big a) => Big { lo: ~a.lo, hi: ~a.hi }

// ── Widths: range, fitting, wrap and saturation ──────────────────────────────

/// `PrimitiveType.Range.Min` for a width of 8, 16, 32 or 64.
Big bigMin(i64 bits, bool signed) {
    return bigZero() if !signed
    return bigNeg(bigShl(Big { lo: 1, hi: 0 }, by: bits - 1))
}

/// `PrimitiveType.Range.Max` for a width of 8, 16, 32 or 64.
Big bigMax(i64 bits, bool signed) {
    let one = Big { lo: 1, hi: 0 }
    return bigSub(bigShl(one, by: bits), by: one) if !signed
    return bigSub(bigShl(one, by: bits - 1), by: one)
}

/// Whether `n` is within the signed or unsigned range of `bits`.
bool bigFits(Big n, to i64 bits, bool signed) =>
    bigCmp(n, as: bigMin(bits, signed: signed)) >= 0 && bigCmp(n, as: bigMax(bits, signed: signed)) <= 0

/// `ConstantFolding.Wrap`: two's-complement truncation to `bits`.
Big bigWrap(Big n, to i64 bits, bool signed) {
    let one = Big { lo: 1, hi: 0 }
    let mask = bigSub(bigShl(one, by: bits), by: one)
    let m = bigAnd(n, by: mask)
    return bigSub(m, by: bigShl(one, by: bits)) if signed && bigCmp(m, as: bigMax(bits, signed: true)) > 0
    return m
}

/// `ConstantFolding.Saturate`: clamp to the width's minimum and maximum.
Big bigSaturate(Big n, to i64 bits, bool signed) {
    let mn = bigMin(bits, signed: signed)
    let mx = bigMax(bits, signed: signed)
    return mn if bigCmp(n, as: mn) < 0
    return mx if bigCmp(n, as: mx) > 0
    return n
}

// ── Conversions ──────────────────────────────────────────────────────────────

/// The value as an i64; the caller has checked `bigFits(n, to: 64, signed: true)`.
i64 bigToI64(Big n) => n.hi == 0 ? i64(n.lo) : bigI64OfBits(n.lo)

/// `(double)Int128`: the nearest double, ties to even.
public f64 bigToF64(Big n) {
    let neg = bigIsNeg(n)
    let m = neg ? bigNeg(n) : n
    let k = bigUBitLength(m)
    return neg ? -f64(m.lo) : f64(m.lo) if k <= 53
    let sh = k - 53
    let q = bigUShr(m, by: sh)
    let rem = bigSub(m, by: bigShl(q, by: sh))
    let half = bigShl(Big { lo: 1, hi: 0 }, by: sh - 1)
    let c = bigUCmp(rem, as: half)
    var qq = q
    if c > 0 || (c == 0 && (q.lo & 1) == 1) {
        qq = bigAdd(q, by: Big { lo: 1, hi: 0 })
    }
    var scale: f64 = 1.0
    for i in 0..sh {
        scale = scale * 2.0
    }
    let d = f64(qq.lo) * scale
    return neg ? -d : d
}

/// The integer part of `d`, truncated toward zero; the caller has clamped `d` to a 128-bit range.
Big bigFromF64(f64 d) {
    return bigZero() if d != d
    let neg = d < 0.0
    let a = neg ? -d : d
    return bigZero() if a < 1.0
    let hiPart = bigTruncToU64(a / 18446744073709551616.0)
    let loPart = bigTruncToU64(a - f64(hiPart) * 18446744073709551616.0)
    let m = Big { lo: loPart, hi: hiPart }
    return neg ? bigNeg(m) : m
}

/// The integer part of `x` as a u64, for `0 <= x < 2^64`.
u64 bigTruncToU64(f64 x) {
    return u64(i64(x)) if x < 4294967296.0
    let top = u64(i64(x / 4294967296.0))
    let bot = u64(i64(x - f64(top) * 4294967296.0))
    return (top << 32) | bot
}
== semantics/binder.byn
// T15: Binder.cs 1-514 (state, scopes, locals, entry points), cut after `BindArraySize`; `BindExitCode`
// (Binder.cs:517) belongs to T16. Methods follow the C# order. Helpers with a `t15` prefix stand for
// C# expressions that have no single Bayan call (spans of a union, a parameter's syntax, `Find`).

import parser
import lexer

// ── Helpers ──────────────────────────────────────────────────────────────────

/// The C# `Source.GetText(span)` of the file being bound.
string t15Text(in Ctx c, from FileId f, at TextSpan span) =>
    span.start < 0 ? c.syntheticNames[-1 - span.start] : $"{getText(c.files[f].text.span, at: span)}"

/// A copy of a held diagnostic (`Diag` is unique, so `held.Items` cannot be handed over by value).
Diag t15CloneDiag(in Diag d) {
    var rel = List<Related>()
    for r in d.related {
        rel.append(r)
    }
    return Diag {
        code: d.code,
        message: d.message,
        file: d.file,
        span: d.span,
        label: d.label,
        help: d.help,
        hasFix: d.hasFix,
        fixSpan: d.fixSpan,
        fixReplacement: d.fixReplacement,
        isWarning: d.isWarning,
        related: move rel,
    }
}

bool t15ContainsLocal(in List<LocalId> list, for LocalId id) {
    for x in list {
        return true if x == id
    }
    return false
}

/// The C# `Stmt.Span`, one arm per variant.
TextSpan t15StmtSpan(in parser.Stmt s) {
    switch s {
        case .blockStmt(let n): return n.value.span
        case .localDecl(let n): return n.value.span
        case .exprStmt(let n): return n.value.span
        case .assignStmt(let n): return n.value.span
        case .incDecStmt(let n): return n.value.span
        case .returnStmt(let n): return n.value.span
        case .failStmt(let n): return n.value.span
        case .breakStmt(let n): return n.value.span
        case .continueStmt(let n): return n.value.span
        case .becomeStmt(let n): return n.value.span
        case .ifStmt(let n): return n.value.span
        case .unlessStmt(let n): return n.value.span
        case .guardedStmt(let n): return n.value.span
        case .whileStmt(let n): return n.value.span
        case .doWhileStmt(let n): return n.value.span
        case .whileLetStmt(let n): return n.value.span
        case .forStmt(let n): return n.value.span
        case .labeledStmt(let n): return n.value.span
        case .switchStmt(let n): return n.value.span
        case .deferStmt(let n): return n.value.span
        case .assertStmt(let n): return n.value.span
        case .contextStmt(let n): return n.value.span
        case .emptyStmt(let n): return n.value.span
        case .errorStmt(let n): return n.value.span
        case .none: return TextSpan { start: 0, length: 0 }
    }
}

/// The scope new locals go to (the C# `_scope`). The C# binder starts with a root scope
/// (`_scope = new(null)`); a Bayan `Binder` literal starts with `scopes: []`, so the root is
/// opened here on first use (Q591), with its identity (Q715).
i64 t15Scope(ref Binder b) {
    if b.scopes.length == 0 {
        b.scopes.append(Map<string, LocalId>())
        b.scopeIds.append(b.nextScopeId)
        b.nextScopeId += 1
    }
    return b.scopes.length - 1
}

/// The C# `Scope.Lookup`: the innermost local named `name` in the current scope or an outer one, or -1.
LocalId t15Lookup(ref Binder b, for string name) {
    var i = t15Scope(ref b)
    while i >= 0 {
        return b.scopes[i][name] if b.scopes[i].contains(name)
        i -= 1
    }
    return -1
}

// ── Pass control (Hold, Release) ─────────────────────────────────────────────

/// Makes this binding a first pass: diagnostics are held until `release` (Q590: `held` is the bag
/// index plus one, 0 for none).
i64 hold(ref Binder b, through ref Ctx c) {
    c.bags.append(DiagBag { items: List<Diag>(), previous: c.sink })
    b.held = c.bags.length
    return b.held - 1
}

/// Ends a first pass: the `var` seeds, keyed by their `LocalDecl` (span start), when one is not `i32`,
/// reporting only the instantiation errors held; else an empty list (C#'s null) and every held report.
List<(LocalId, Type)> release(ref Binder b, through ref Ctx c) {
    let held = b.held - 1
    b.held = 0
    // A group of pending `var`s that met each other takes the first integer constraint any of them recorded;
    // a group with a member whose own first use is a float or string stays `i32` (Q74).
    var constraints = List<(i64, Type)>()
    for (decl, type) in b.constraints {
        constraints.append((decl, type))
    }
    var groups = Map<i64, Type>()
    for (decl, type) in constraints {
        if isInteger(type) {
            let peer = findPeer(ref b, for: decl)
            if !groups.contains(peer) {
                groups[peer] = type
            }
        }
    }
    for (decl, type) in constraints {
        if !isInteger(type) {
            let _ = groups.remove(findPeer(ref b, for: decl))
        }
    }
    var pending = List<i64>()
    for (local, decl) in b.pending {
        pending.append(decl)
    }
    var seeds = List<(LocalId, Type)>()
    var seeded = Map<i64, i64>()
    for decl in pending {
        let peer = findPeer(ref b, for: decl)
        if groups.contains(peer) {
            if seeded.contains(decl) {
                seeds[seeded[decl]] = (decl, groups[peer])
            } else {
                seeded[decl] = seeds.length
                seeds.append((decl, groups[peer]))
            }
        }
    }
    var wide = false
    for (decl, t) in seeds {
        if isInteger(t) && t != prim(.i32) {
            wide = true
        }
    }
    var items = List<Diag>()
    for i in 0..c.bags[held].items.length {
        if !wide || c.bags[held].items[i].label == "the generic code needs this of its type arguments" {
            items.append(t15CloneDiag(in c.bags[held].items[i]))
        }
    }
    reportHeld(ref c, for: in items)
    return seeds if wide
    return List<(LocalId, Type)>()
}

// ── Diagnostics, names and types ─────────────────────────────────────────────

/// Reports into the held bag during a first pass, else through the compilation.
void report(
    ref Binder b,
    through ref Ctx c,
    for SemaCode code,
    at TextSpan span,
    by (string a0, string a1, string a2, string a3, string a4) args,
    string label = "",
    string help = "",
    bool hasFix = false,
    TextSpan? fixSpan = null,
    string fixReplacement = ""
) {
    let outer = c.sink
    if b.held > 0 {
        c.sink = b.held - 1
    }
    report(
        ref c,
        for: code,
        from: b.file,
        at: span,
        by: args,
        label: label,
        help: help,
        hasFix: hasFix,
        fixSpan: fixSpan,
        fixReplacement: fixReplacement,
    )
    c.sink = outer
}

void checkValueName(ref Binder b, through ref Ctx c, at TextSpan name) {
    let outer = c.sink
    if b.held > 0 {
        c.sink = b.held - 1
    }
    checkValue(ref c, from: b.file, at: name)
    c.sink = outer
}

/// The C# constructor's `_thisType`, `container ?? fn.Interface.Self` (Q719), and `_types` map, `typeArgs ?? fn.TypeMap
/// ?? container.TypeMap`, taken once per binder (an empty Bayan map is C#'s null; Q592). Each entry point takes them
/// first, as the C# constructor does before any binding, so a lambda body (which moves `b.fn` to the lifted lambda)
/// keeps the enclosing ones.
void t15CaptureTypes(ref Binder b, through ref Ctx c) {
    return if b.typesCaptured
    b.typesCaptured = true
    if b.owner >= 0 {
        b.thisType = structTypeOf(b.owner)
    } else if b.fn >= 0 && c.functions[b.fn].iface >= 0 {
        b.thisType = t15InterfaceSelf(ref c, for: c.functions[b.fn].iface)
    }
    if (b.typeArgs is { } args) {
        for (k, v) in args {
            b.types[k] = v
        }
    } else if b.fn >= 0 && c.functions[b.fn].typeMap.length > 0 {
        for (k, v) in c.functions[b.fn].typeMap {
            b.types[k] = v
        }
    } else if b.owner >= 0 {
        for (k, v) in c.structs[b.owner].typeMap {
            b.types[k] = v
        }
    }
}

/// The C# `InterfaceSymbol.Self` (Symbols.cs:294): a `Self` type parameter constrained to the interface, made on first use.
Type t15InterfaceSelf(ref Ctx c, for InterfaceId i) {
    if c.interfaces[i].self == -1 {
        var constraints = List<InterfaceId>()
        constraints.append(i)
        c.interfaces[i].self = newTypeParam(ref c, by: TypeParam { name: "Self", constraints: move constraints })
    }
    return typeParamTypeOf(c.interfaces[i].self)
}

/// The C# `_types.Resolve(t)` under `Holding`: `_types` resolves in `b.owner` with the captured map.
Type resolveType(ref Binder b, through ref Ctx c, for in parser.TypeSyntax t) {
    t15CaptureTypes(ref b, through: ref c)
    var map = Map<string, Type>()
    for (k, v) in b.types {
        map[k] = v
    }
    let r = TypeResolver { file: b.file, container: b.owner, typeArgs: move map }
    let outer = c.sink
    if b.held > 0 {
        c.sink = b.held - 1
    }
    let type = resolve(ref c, through: in r, for: in t)
    c.sink = outer
    return type
}

// ── Scopes and locals ────────────────────────────────────────────────────────

void pushScope(ref Binder b) {
    let _ = t15Scope(ref b)
    b.scopes.append(Map<string, LocalId>())
    b.scopeIds.append(b.nextScopeId)
    b.nextScopeId += 1
}

void popScope(ref Binder b) {
    b.scopes.remove(at: b.scopes.length - 1)
    b.scopeIds.remove(at: b.scopeIds.length - 1)
}

LocalId declareLocal(ref Binder b, through ref Ctx c, at TextSpan name, as Type type, for LocalKind kind) {
    if kind != .temp {
        checkValueName(ref b, through: ref c, at: name)
    }
    let local = newLocal(ref c, by: LocalSymbol {
        name: t15Text(in c, from: b.file, at: name),
        nameSpan: name,
        span: name,
        type: type,
        kind: kind,
        id: b.nextLocalId,
    })
    b.nextLocalId += 1
    addLocal(ref b, through: ref c, at: name, for: local)
    return local
}

/// `DeclareLocal` of the C# parser's `Name(SpanFrom(groupStart), "_")` (Parser.cs:2722), a tuple `for` variable: the
/// selfhost parser keeps only the group's span (Q463), so the text `_` is given here. `CheckValue` returns on `_`
/// (Naming.cs:42) and `AddLocal` after `_fn.Locals.Add` (Binder.cs:145-146).
LocalId declareDiscard(ref Binder b, through ref Ctx c, at TextSpan name, as Type type, for LocalKind kind) {
    let local = newLocal(ref c, by: LocalSymbol {
        name: "_",
        nameSpan: name,
        span: name,
        type: type,
        kind: kind,
        id: b.nextLocalId,
    })
    b.nextLocalId += 1
    if b.fn >= 0 {
        c.functions[b.fn].locals.append(local)
    }
    return local
}

void addLocal(ref Binder b, through ref Ctx c, at TextSpan name, for LocalId local) {
    if b.fn >= 0 {
        c.functions[b.fn].locals.append(local)
    }
    let text = t15Text(in c, from: b.file, at: name)
    return if text == "_"
    let scope = t15Scope(ref b)
    // A `let` may take the name of another local in the same scope to give it a new type (HANDOFF §4).
    if c.locals[local].kind == .letKeyword && b.scopes[scope].contains(text) {
        let same = b.scopes[scope][text]
        let type = c.locals[local].type
        if c.locals[same].type == type && !isError(type) {
            let line = linePosition(c.files[b.file].text.span, at: c.locals[same].nameSpan.start).line
            report(
                ref b,
                through: ref c,
                for: .sameTypeShadowing,
                at: name,
                by: (text, typeDisplay(ref c, by: type), "", "", ""),
                label: $"`{text}` is declared on line {line}",
                help: "use the first one, or rename this one to say how it differs",
            )
        }
    } else {
        let existing = t15Lookup(ref b, for: text)
        if existing >= 0 {
            let line = linePosition(c.files[b.file].text.span, at: c.locals[existing].nameSpan.start).line
            report(
                ref b,
                through: ref c,
                for: .shadowing,
                at: name,
                by: (text, "", "", "", ""),
                label: $"already declared on line {line}",
                help: "pick a different name; Bayan does not let a local hide another one",
            )
        }
    }
    b.scopes[scope][text] = local
}

// ── Entry points ─────────────────────────────────────────────────────────────

void t15DeclareParameters(ref Binder b, through ref Ctx c) {
    var ps = List<LocalId>()
    for p in c.functions[b.fn].parameters {
        ps.append(p)
    }
    let scope = t15Scope(ref b)
    for p in ps {
        c.locals[p].id = b.nextLocalId
        b.nextLocalId += 1
        c.functions[b.fn].locals.append(p)
        b.scopes[scope][c.locals[p].name] = p
    }
}

/// The C# `_thisFacts`: the fact key for `this`, a `let` named `this` of the error type, made on first use (Q593).
LocalId t15ThisFacts(ref Binder b, through ref Ctx c) {
    if (b.thisFacts is { } made) {
        return made
    }
    let fresh = newLocal(ref c, by: LocalSymbol { name: "this", type: errorType(), kind: .letKeyword })
    b.thisFacts = fresh
    return fresh
}

void bindFunctionBody(ref Binder b, through ref Ctx c, for in parser.FunctionDecl decl) {
    t15CaptureTypes(ref b, through: ref c)
    t15DeclareParameters(ref b, through: ref c)
    // `this` starts in the states its receiver declares; a `become` or a `becomes` call on it may change that.
    let own = receiverStates(ref b, through: ref c, for: b.fn)
    if own != -1 {
        learnState(ref b, for: t15ThisFacts(ref b, through: ref c), as: own)
    }
    t15BindParameterDefaults(ref b, through: ref c)
    var checks = t15BindRequires(ref b, through: ref c, for: in decl)
    switch decl.body {
        case .blockStmt(let body):
            let any = body.value.statements.length > 0
            b.firstStatementFile = any ? b.file : -1
            if any {
                b.firstStatementSpan = t15StmtSpan(in body.value.statements[0])
            }
            let block = bindBlock(ref b, through: ref c, for: in body.value)
            if checks.length == 0 {
                c.functions[b.fn].body = block
            } else {
                checks.append(block)
                c.functions[b.fn].body = recordNodeSyntax(
                    ref c,
                    for: addBlock(ref c, from: BBlock { span: body.value.span, statements: move checks }),
                    as: .blockStmt,
                    at: body.value.span,
                )
            }
            return
        default:
            break
    }
    if decl.expressionBody is not .none {
        checks.append(bindExpressionBody(ref b, through: ref c, for: in decl.expressionBody))
        c.functions[b.fn].body = recordSyntax(
            ref c,
            for: addBlock(
                ref c,
                from: BBlock { span: parser.exprSpan(in decl.expressionBody), statements: move checks },
            ),
            from: in decl.expressionBody,
        )
    } else {
        // The parser already reported the missing body.
        // coverage-exempt: Q1105
        c.functions[b.fn].body = recordNodeSyntax(
            ref c,
            for: addBlock(ref c, from: BBlock { span: decl.span }),
            as: .functionDecl,
            at: decl.span,
        )
    }
}

/// Binds the `requires` clauses into entry checks that panic in every build mode.
List<BStmt> t15BindRequires(ref Binder b, through ref Ctx c, for in parser.FunctionDecl decl) {
    var conditions = List<BExpr>()
    var checks = List<BStmt>()
    for r in decl.requiresClauses {
        let span = parser.exprSpan(in r)
        let condition = bindExpr(ref b, through: ref c, for: in r, to: prim(.bool))
        let type = exprType(in c, for: condition)
        if !isBool(type) {
            if !isError(type) {
                report(
                    ref b,
                    through: ref c,
                    for: .requiresNotBool,
                    at: span,
                    by: (typeDisplay(ref c, by: type), "", "", "", ""),
                    help: "write a condition the arguments must meet, such as `count > 0`",
                )
            }
            continue
        }
        conditions.append(condition)
        t15CheckExpects(ref b, through: ref c, for: span, by: condition)
        let message = recordSyntax(
            ref c,
            for: literal(
                ref c,
                at: span,
                as: prim(.string),
                by: Constant { kind: .text, text: $"contract violated: {t15Text(in c, from: b.file, at: span)}" },
            ),
            from: in r,
        )
        var arguments = List<BExpr>()
        arguments.append(message)
        let panic = recordSyntax(
            ref c,
            for: addCall(
                ref c,
                from: BCall {
                    span: span,
                    function: t9Function(ref c, for: "panic"),
                    arguments: move arguments,
                    type: prim(.neverKind),
                },
            ),
            from: in r,
        )
        let negated = recordSyntax(
            ref c,
            for: addUnary(ref c, from: BUnary { span: span, op: .notKeyword, operand: condition, type: prim(.bool) }),
            from: in r,
        )
        let then = recordSyntax(ref c, for: addExprStmt(ref c, from: BExprStmt { span: span, expr: panic }), from: in r)
        checks.append(
            recordSyntax(
                ref c,
                for: addIf(ref c, from: BIf { span: span, condition: negated, then: then }),
                from: in r,
            ),
        )
    }
    c.functions[b.fn].requirements = move conditions
    return checks
}

/// An `expects` clause that reads an `Untrusted` parameter would trap on outside data (BYN8006); one that reads
/// a single parameter and nothing else belongs on that parameter's type as a `requires` (BYN5011).
void t15CheckExpects(ref Binder b, through ref Ctx c, for TextSpan clause, by BExpr condition) {
    let nodes = descendants(in c, for: condition)
    var reads = List<BExpr>()
    var hasThis = false
    for n in nodes {
        if boundKind(n) == .thisRef {
            hasThis = true
        }
        if boundKind(n) == .local {
            let l = c.bLocals[boundIndex(n)].local
            if t15ContainsLocal(in c.functions[b.fn].parameters, for: l) {
                reads.append(n)
            }
        }
    }
    var distinct = List<LocalId>()
    for read in reads {
        let l = c.bLocals[boundIndex(read)].local
        continue if t15ContainsLocal(in distinct, for: l)
        distinct.append(l)
        if kindOf(c.locals[l].type) == .untrusted {
            let name = c.locals[l].name
            report(
                ref b,
                through: ref c,
                for: .expectsReadsUntrusted,
                at: nodeSpan(in c, for: read),
                by: (name, "", "", "", ""),
                help: $"validate `{name}` with a type that has `requires` before the call",
            )
        }
    }
    return if distinct.length != 1 || hasThis
    let name = c.locals[distinct[0]].name
    report(
        ref b,
        through: ref c,
        for: .expectsSingleParameter,
        at: t15ExpectsKeyword(in c, from: b.file, at: clause),
        by: (name, "", "", "", ""),
        help: $"declare a type with `requires` for `{name}`",
    )
}

/// The `expects` keyword before the clause at `clause`, which the syntax tree does not keep; the clause if it is
/// the `requires` input form.
TextSpan t15ExpectsKeyword(in Ctx c, from FileId f, at TextSpan clause) {
    let bytes = c.files[f].text.span
    var end = clause.start
    while end > 0 && (bytes[end - 1] == 32 || bytes[end - 1] == 9 || bytes[end - 1] == 13 || bytes[end - 1] == 10) {
        end -= 1
    }
    let start = end - 7 > 0 ? end - 7 : 0
    let keyword = TextSpan { start: start, length: end - start }
    return getText(bytes, at: keyword) == "expects" ? keyword : clause
}

/// A `BoundLocal` of `local` (express.byn calls it too; Q594).
BExpr addLocalNode(ref Ctx c, at TextSpan span, for LocalId local) =>
    addLocal(ref c, from: BLocal { span: span, local: local, type: c.locals[local].type })

/// The state `BindChecks`' local `Add` closes over: `list` (-1 for null), the `invalid` variant, the statements,
/// the `broken_` flag declarations C# inserts at 0 (newest last here, since Bayan `List` has no insert; Q594), the
/// `broken` map and the declaration's span (C# `node`).
struct T28Checks {
    LocalId     list
    VariantId   invalid
    TextSpan    node
    List<BStmt> statements = []
    List<BStmt> flags      = []
    Map<FieldId, LocalId> broken = []
}

/// The `requires` checker of a struct (J23): binds each field's and the struct's rules into its `check`'s body
/// (Q594: the rules go to `c.checks[c.checksOf[b.owner]]`; `checks` is the caller's read-only copy). Every broken
/// rule adds a `Violation<T>`, and the check fails with `ValidationError<T>.invalid` holding them all. A struct rule
/// reading a field whose own rule broke is skipped (J43).
void bindChecks(ref Binder b, through ref Ctx c, for in StructChecks checks) {
    t15CaptureTypes(ref b, through: ref c)
    let s = b.owner
    let invalid = findErrorVariant(ref c, by: validationErrorOf(ref c, for: structTypeOf(s)), for: "invalid")
    let file = c.structs[s].file
    var node = TextSpan { start: 0, length: 0 }
    // C# `_struct.Decl` is a `StructDecl` for a distinct type too (Compilation.cs:496 builds one from the alias).
    switch c.files[file].unit.members[c.structs[s].declIndex] {
        case .structDecl(let d): node = d.value.span
        case .typeAliasDecl(let a): node = a.value.span
        default: panic("a struct is declared by a `StructDecl` or a `type distinct`")
    }
    // A distinct type has no `T.Field`, so its set is the payload-less one and the first broken rule fails.
    var list: LocalId = -1
    if c.errorVariants[invalid].fields.length != 0 {
        list = newLocal(
            ref c,
            by: LocalSymbol {
                name: "violations",
                type: c.locals[c.errorVariants[invalid].fields[0]].type,
                kind: .varKeyword,
                id: b.nextLocalId,
            },
        )
        b.nextLocalId += 1
    }
    var st = T28Checks { list: list, invalid: invalid, node: node }
    if list != -1 {
        let empty = recordNodeSyntax(
            ref c,
            for: addCollection(ref c, from: BCollection { span: node, type: c.locals[list].type }),
            as: .structDecl,
            at: node,
        )
        st.statements.append(
            recordNodeSyntax(
                ref c,
                for: addLocalDecl(ref c, from: BLocalDecl { span: node, local: list, initializer: empty }),
                as: .structDecl,
                at: node,
            ),
        )
    }
    let fields = copyIds(in c.structs[s].fields)
    switch c.files[file].unit.members[c.structs[s].declIndex] {
        case .structDecl(let d):
            for field in fields {
                switch d.value.members[c.fields[field].memberIndex] {
                    case .fieldDecl(let fd):
                        for r in fd.value.requiresClauses {
                            t28AddRule(ref b, through: ref c, for: in r, at: field, to: ref st)
                        }
                    default:
                        break
                }
            }
            for r in d.value.rules {
                if (r.at is { } at) {
                    let text = t15Text(in c, from: file, at: at)
                    if findField(ref c, by: s, for: text) == -1 {
                        let name = c.structs[s].name
                        report(
                            ref b,
                            through: ref c,
                            for: .ruleTargetNotField,
                            at: at,
                            by: (text, name, "", "", ""),
                            label: $"`.{text}`",
                            help: $"name a field of `{name}`",
                        )
                    }
                }
                t28AddRule(ref b, through: ref c, for: in r, at: -1, to: ref st)
            }
        case .typeAliasDecl(let a):
            // The struct's one field `value` carries the alias's `requires`; the struct has no rules of its own.
            for r in a.value.requiresClauses {
                t28AddRule(ref b, through: ref c, for: in r, at: fields[0], to: ref st)
            }
        default:
            break
    }
    var statements = List<BStmt>()
    var k = st.flags.length - 1
    while k >= 0 {
        statements.append(st.flags[k])
        k -= 1
    }
    for x in st.statements {
        statements.append(x)
    }
    if list == -1 {
        c.functions[b.fn].body = recordNodeSyntax(
            ref c,
            for: addBlock(ref c, from: BBlock { span: node, statements: move statements }),
            as: .structDecl,
            at: node,
        )
        return
    }
    let noArguments = List<BExpr>()
    let isEmpty = recordNodeSyntax(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall {
                span: node,
                member: .listIsEmpty,
                receiver: recordNodeSyntax(
                    ref c,
                    for: addLocalNode(ref c, at: node, for: list),
                    as: .structDecl,
                    at: node,
                ),
                arguments: move noArguments,
                type: prim(.bool),
            },
        ),
        as: .structDecl,
        at: node,
    )
    let any = recordNodeSyntax(
        ref c,
        for: addUnary(ref c, from: BUnary { span: node, op: .notKeyword, operand: isEmpty, type: prim(.bool) }),
        as: .structDecl,
        at: node,
    )
    var payload = List<BExpr>()
    payload.append(recordNodeSyntax(ref c, for: addLocalNode(ref c, at: node, for: list), as: .structDecl, at: node))
    let error = recordNodeSyntax(
        ref c,
        for: addErrorVariant(ref c, from: BErrorVariant { span: node, variant: invalid, payload: move payload }),
        as: .structDecl,
        at: node,
    )
    statements.append(
        recordNodeSyntax(
            ref c,
            for: addIf(
                ref c,
                from: BIf {
                    span: node,
                    condition: any,
                    then: recordNodeSyntax(
                        ref c,
                        for: addFail(ref c, from: BFail { span: node, error: error }),
                        as: .structDecl,
                        at: node,
                    ),
                },
            ),
            as: .structDecl,
            at: node,
        ),
    )
    c.functions[b.fn].body = recordNodeSyntax(
        ref c,
        for: addBlock(ref c, from: BBlock { span: node, statements: move statements }),
        as: .structDecl,
        at: node,
    )
}

/// `BindChecks`' local `Add(r, field)`; `field` -1 is C#'s null.
void t28AddRule(ref Binder b, through ref Ctx c, for in parser.RequiresRule r, at FieldId field, to ref T28Checks st) {
    b.itField = field
    b.itDepth = 1
    let condition = bindExpr(ref b, through: ref c, for: in r.condition, to: prim(.bool))
    b.itField = -1
    b.itDepth = 0
    let type = exprType(in c, for: condition)
    if !isBool(type) {
        if !isError(type) {
            report(
                ref b,
                through: ref c,
                for: .requiresNotBool,
                at: parser.exprSpan(in r.condition),
                by: (typeDisplay(ref c, by: type), "", "", "", ""),
                help: "write a condition the value must meet, such as `it > 0`",
            )
        }
        return
    }
    // The C# `StructRule.Reads`: the fields of `this` the condition reads, distinct, in order.
    var reads = List<FieldId>()
    for n in descendants(in c, for: condition) {
        if boundKind(n) == .field {
            let bf = boundIndex(n)
            if boundKind(c.bFields[bf].receiver) == .thisRef && !listContains(in reads, by: c.bFields[bf].field) {
                reads.append(c.bFields[bf].field)
            }
        }
    }
    // `StructRule.span` stands for the C# `Syntax`; its one reader wants `Syntax.Condition.Span` (Q655).
    c.checks[c.checksOf[b.owner]].rules.append(
        StructRule {
            span: parser.exprSpan(in r.condition),
            field: field,
            condition: condition,
            reads: copyIds(in reads),
        },
    )
    var failing = recordNodeSyntax(
        ref c,
        for: addUnary(ref c, from: BUnary { span: r.span, op: .notKeyword, operand: condition, type: prim(.bool) }),
        as: .requiresRule,
        at: r.span,
    )
    for read in reads {
        continue if read == field || !st.broken.contains(read)
        let flag = recordNodeSyntax(
            ref c,
            for: addLocalNode(ref c, at: r.span, for: st.broken[read]),
            as: .requiresRule,
            at: r.span,
        )
        let notBroken = recordNodeSyntax(
            ref c,
            for: addUnary(ref c, from: BUnary { span: r.span, op: .notKeyword, operand: flag, type: prim(.bool) }),
            as: .requiresRule,
            at: r.span,
        )
        failing = recordNodeSyntax(
            ref c,
            for: addBinary(
                ref c,
                from: BBinary { span: r.span, op: .logicalAnd, left: notBroken, right: failing, type: prim(.bool) },
            ),
            as: .requiresRule,
            at: r.span,
        )
    }
    // A struct rule is reported at its `at` field, else at the first field it reads.
    var at = field
    if at == -1 {
        if (r.at is { } name) {
            at = findField(ref c, by: b.owner, for: t15Text(in c, from: b.file, at: name))
        }
    }
    if at == -1 && reads.length > 0 {
        at = reads[0]
    }
    if at == -1 && c.structs[b.owner].fields.length > 0 {
        at = c.structs[b.owner].fields[0]
    }
    if st.list == -1 || at == -1 {
        var payload = List<BExpr>()
        if st.list != -1 {
            payload.append(
                recordNodeSyntax(
                    ref c,
                    for: addLocalNode(ref c, at: r.span, for: st.list),
                    as: .requiresRule,
                    at: r.span,
                ),
            )
        }
        let error = recordNodeSyntax(
            ref c,
            for: addErrorVariant(
                ref c,
                from: BErrorVariant { span: r.span, variant: st.invalid, payload: move payload },
            ),
            as: .requiresRule,
            at: r.span,
        )
        st.statements.append(
            recordNodeSyntax(
                ref c,
                for: addIf(
                    ref c,
                    from: BIf {
                        span: r.span,
                        condition: failing,
                        then: recordNodeSyntax(
                            ref c,
                            for: addFail(ref c, from: BFail { span: r.span, error: error }),
                            as: .requiresRule,
                            at: r.span,
                        ),
                    },
                ),
                as: .requiresRule,
                at: r.span,
            ),
        )
        return
    }
    let element = typeIndex(c.listTypes[typeIndex(c.locals[st.list].type)])
    var entryFields = List<BExpr>()
    let atName = c.fields[at].name
    let member = findEnumMember(ref c, by: c.structs[b.owner].fieldEnum, for: atName)
    entryFields.append(
        recordNodeSyntax(
            ref c,
            for: addEnumMember(ref c, from: BEnumMember { span: r.span, member: member }),
            as: .requiresRule,
            at: r.span,
        ),
    )
    entryFields.append(ruleOf(ref b, through: ref c, for: in r, at: field, by: condition))
    let entry = recordNodeSyntax(
        ref c,
        for: addStructLiteral(
            ref c,
            from: BStructLiteral { span: r.span, structId: element, fields: move entryFields },
        ),
        as: .requiresRule,
        at: r.span,
    )
    var arguments = List<BExpr>()
    arguments.append(entry)
    let add = recordNodeSyntax(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall {
                span: r.span,
                member: .listAdd,
                receiver: recordNodeSyntax(
                    ref c,
                    for: addLocalNode(ref c, at: r.span, for: st.list),
                    as: .requiresRule,
                    at: r.span,
                ),
                arguments: move arguments,
                type: prim(.void),
            },
        ),
        as: .requiresRule,
        at: r.span,
    )
    var then = recordNodeSyntax(
        ref c,
        for: addExprStmt(ref c, from: BExprStmt { span: r.span, expr: add }),
        as: .requiresRule,
        at: r.span,
    )
    if field != -1 {
        var flag: LocalId = -1
        if st.broken.contains(field) {
            flag = st.broken[field]
        } else {
            flag = newLocal(
                ref c,
                by: LocalSymbol {
                    name: $"broken_{c.fields[field].name}",
                    type: prim(.bool),
                    kind: .varKeyword,
                    id: b.nextLocalId,
                },
            )
            b.nextLocalId += 1
            st.broken[field] = flag
            let no = recordNodeSyntax(
                ref c,
                for: addLiteral(
                    ref c,
                    from: BLiteral { span: st.node, type: prim(.bool), value: Constant { kind: .flag, flag: false } },
                ),
                as: .structDecl,
                at: st.node,
            )
            st.flags.append(
                recordNodeSyntax(
                    ref c,
                    for: addLocalDecl(ref c, from: BLocalDecl { span: st.node, local: flag, initializer: no }),
                    as: .structDecl,
                    at: st.node,
                ),
            )
        }
        let yes = recordNodeSyntax(
            ref c,
            for: addLiteral(
                ref c,
                from: BLiteral { span: r.span, type: prim(.bool), value: Constant { kind: .flag, flag: true } },
            ),
            as: .requiresRule,
            at: r.span,
        )
        var both = List<BStmt>()
        both.append(then)
        both.append(
            recordNodeSyntax(
                ref c,
                for: addAssign(
                    ref c,
                    from: BAssign {
                        span: r.span,
                        target: recordNodeSyntax(
                            ref c,
                            for: addLocalNode(ref c, at: r.span, for: flag),
                            as: .requiresRule,
                            at: r.span,
                        ),
                        value: yes,
                    },
                ),
                as: .requiresRule,
                at: r.span,
            ),
        )
        then = recordNodeSyntax(
            ref c,
            for: addBlock(ref c, from: BBlock { span: r.span, statements: move both }),
            as: .requiresRule,
            at: r.span,
        )
    }
    st.statements.append(
        recordNodeSyntax(
            ref c,
            for: addIf(ref c, from: BIf { span: r.span, condition: failing, then: then }),
            as: .requiresRule,
            at: r.span,
        ),
    )
}

/// The `Rule` of a field's rule (J23): `it in a..=b` is `range` and `it.runeCount in a..=b` is `length`, with
/// constant integer ends; anything else is `custom`. `field` -1 is C#'s null.
BExpr ruleOf(ref Binder b, through ref Ctx c, for in parser.RequiresRule r, at FieldId field, by BExpr condition) {
    let rule = typeIndex(t8BuiltinUnion(in c, for: "Rule"))
    var shape: string? = null
    switch r.condition {
        case .inExpr(let ie):
            switch ie.value.value {
                case .nameExpr(let n):
                    if t15Text(in c, from: b.file, at: n.value.name) == "it" {
                        shape = "range"
                    }
                case .memberExpr(let m):
                    switch m.value.target {
                        case .nameExpr(let n):
                            if t15Text(in c, from: b.file, at: n.value.name) == "it"
                                    && t15Text(in c, from: b.file, at: m.value.member) == "runeCount" {
                                shape = "length"
                            }
                        default:
                            break
                    }
                default:
                    break
            }
        default:
            break
    }
    if field != -1 && boundKind(condition) == .isExpr {
        if (shape is { } sh) {
            let pattern = c.bIses[boundIndex(condition)].pattern
            if boundKind(pattern) == .rangePattern {
                let p = boundIndex(pattern)
                let start = t28RuleBound(ref c, for: c.bRangePatterns[p].start)
                let end = t28RuleBound(ref c, for: c.bRangePatterns[p].end)
                if start != -1 && end != -1 {
                    var payload = List<BExpr>()
                    payload.append(
                        recordSyntax(
                            ref c,
                            for: addRange(
                                ref c,
                                from: BRange {
                                    span: parser.exprSpan(in r.condition),
                                    start: start,
                                    end: end,
                                    inclusive: c.bRangePatterns[p].inclusive,
                                    type: internRange(ref c, by: prim(.i64)),
                                },
                            ),
                            from: in r.condition,
                        ),
                    )
                    return recordNodeSyntax(
                        ref c,
                        for: addUnionNew(
                            ref c,
                            from: BUnionNew {
                                span: r.span,
                                variant: findUnionVariant(ref c, by: rule, for: sh),
                                payload: move payload,
                            },
                        ),
                        as: .requiresRule,
                        at: r.span,
                    )
                }
            }
        }
    }
    return recordNodeSyntax(
        ref c,
        for: addUnionNew(
            ref c,
            from: BUnionNew { span: r.span, variant: findUnionVariant(ref c, by: rule, for: "custom") },
        ),
        as: .requiresRule,
        at: r.span,
    )
}

/// `RuleOf`'s local `Bound(e)`: an `i64` literal of `e`'s integer constant when it fits, else -1 (C#'s null).
BExpr t28RuleBound(ref Ctx c, for BExpr e) {
    if (exprConstant(in c, for: e) is { } k) {
        return shareSyntax(
            ref c,
            for: addLiteral(
                ref c,
                from: BLiteral {
                    span: nodeSpan(in c, for: e),
                    type: prim(.i64),
                    value: Constant { kind: .integer, integer: k.integer },
                },
            ),
            from: e,
        ) if k.kind == .integer
            && bigFits(k.integer, to: 64, signed: true)
    }
    return -1
}

void t15BindParameterDefaults(ref Binder b, through ref Ctx c) {
    var ps = List<LocalId>()
    for p in c.functions[b.fn].parameters {
        ps.append(p)
    }
    for p in ps {
        let _ = parameterDefault(ref c, for: b.fn, by: p)
    }
}

/// The function whose parameter `p` is (the C# `ParameterSymbol.Syntax` has no Bayan field; Q592).
FuncId t15ParameterOwner(in Ctx c, for LocalId p) {
    for f in 0..c.functions.length {
        return f if t15ContainsLocal(in c.functions[f].parameters, for: p)
    }
    return -1
}

BExpr bindParameterDefault(ref Binder b, through ref Ctx c, for LocalId p) {
    t15CaptureTypes(ref b, through: ref c)
    let f = t15ParameterOwner(in c, for: p)
    let ordinal = c.locals[p].ordinal
    let file = c.functions[f].file
    let member = c.functions[f].memberIndex
    switch c.files[file].unit.members[c.functions[f].declIndex] {
        case .functionDecl(let d):
            return t15BindDefault(
                ref b,
                through: ref c,
                for: in d.value.params[ordinal].defaultKeyword,
                as: c.locals[p].type,
            )
        case .structDecl(let d):
            switch d.value.members[member] {
                case .functionDecl(let m):
                    return t15BindDefault(
                        ref b,
                        through: ref c,
                        for: in m.value.params[ordinal].defaultKeyword,
                        as: c.locals[p].type,
                    )
                case .constructorDecl(let m):
                    return t15BindDefault(
                        ref b,
                        through: ref c,
                        for: in m.value.params[ordinal].defaultKeyword,
                        as: c.locals[p].type,
                    )
                default:
                    return -1
            }
        case .interfaceDecl(let d):
            switch d.value.members[member] {
                case .functionDecl(let m):
                    return t15BindDefault(
                        ref b,
                        through: ref c,
                        for: in m.value.params[ordinal].defaultKeyword,
                        as: c.locals[p].type,
                    )
                default:
                    return -1
            }
        case .extensionDecl(let d):
            switch d.value.members[member] {
                case .functionDecl(let m):
                    return t15BindDefault(
                        ref b,
                        through: ref c,
                        for: in m.value.params[ordinal].defaultKeyword,
                        as: c.locals[p].type,
                    )
                default:
                    return -1
            }
        default:
            return -1
    }
}

/// The body of `BindParameterDefault` once its syntax `d` is found.
BExpr t15BindDefault(ref Binder b, through ref Ctx c, for in parser.Expr d, as Type type) {
    let value = bindConverted(ref b, through: ref c, for: in d, to: type)
    let kind = boundKind(value)
    if exprConstant(in c, for: value) is null && kind != .errorExpr && kind != .defaultValue {
        report(
            ref b,
            through: ref c,
            for: .notConstant,
            at: parser.exprSpan(in d),
            by: ("a parameter default", "", "", "", ""),
        )
    }
    return value
}

BStmt bindExpressionBody(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    t15CaptureTypes(ref b, through: ref c)
    let span = parser.exprSpan(in e)
    return recordSyntax(
        ref c,
        for: addExprStmt(
            ref c,
            from: BExprStmt { span: span, expr: bindStatementExpression(ref b, through: ref c, for: in e) },
        ),
        from: in e,
    ) if isVoid(c.functions[b.fn].returnType)
    return recordSyntax(
        ref c,
        for: addReturn(
            ref c,
            from: BReturn {
                span: span,
                value: bindConverted(ref b, through: ref c, for: in e, to: c.functions[b.fn].returnType),
            },
        ),
        from: in e,
    )
}

void bindGetter(ref Binder b, through ref Ctx c, for in parser.PropertyDecl d) {
    t15CaptureTypes(ref b, through: ref c)
    switch d.block {
        case .blockStmt(let block):
            c.functions[b.fn].body = bindBlock(ref b, through: ref c, for: in block.value)
            return
        default:
            break
    }
    let span = parser.exprSpan(in d.body)
    var statements = List<BStmt>()
    statements.append(
        recordSyntax(
            ref c,
            for: addReturn(
                ref c,
                from: BReturn {
                    span: span,
                    value: bindConverted(ref b, through: ref c, for: in d.body, to: c.functions[b.fn].returnType),
                },
            ),
            from: in d.body,
        ),
    )
    c.functions[b.fn].body = recordSyntax(
        ref c,
        for: addBlock(ref c, from: BBlock { span: span, statements: move statements }),
        from: in d.body,
    )
}

/// The C# `decl.Body` is a `BlockStmt`; the parser's `Stmt` holds one for every constructor it builds.
void bindConstructor(ref Binder b, through ref Ctx c, for in parser.ConstructorDecl d) {
    t15CaptureTypes(ref b, through: ref c)
    t15DeclareParameters(ref b, through: ref c)
    t15BindParameterDefaults(ref b, through: ref c)
    switch d.body {
        case .blockStmt(let block):
            c.functions[b.fn].body = bindBlock(ref b, through: ref c, for: in block.value)
        default:
            break
    }
}

/// The C# `List<GlobalStatement>` is `c.mainStatements`' refs (Q718); each must name a top-level statement.
void bindMain(ref Binder b, through ref Ctx c, for in List<SyntaxRef> statements) {
    t15CaptureTypes(ref b, through: ref c)
    var bound = List<BStmt>()
    var span = TextSpan { start: 0, length: 0 }
    for i in 0..statements.length {
        let r = statements[i]
        switch c.files[r.file].unit.members[r.declIndex] {
            case .globalStatement(let g):
                if i == 0 {
                    b.firstStatementFile = r.file
                    b.firstStatementSpan = t15StmtSpan(in g.value.statement)
                    span = g.value.span
                }
                bound.append(bindStatement(ref b, through: ref c, for: in g.value.statement))
            default:
                panic("internal error: a main statement ref is not a top-level statement")
        }
    }
    c.functions[b.fn].infersErrors = true
    c.functions[b.fn].body = recordNodeSyntax(
        ref c,
        for: addBlock(ref c, from: BBlock { span: span, statements: move bound }),
        as: .globalStatement,
        at: span,
    )
}

/// A test body; a `@cases` case first binds each parameter as a `let` of its value. The C# `decl` and `values` are
/// `c.testBodies[fn]`'s refs (Q718): `hasValues` false is C#'s null `values` (Q593), and `body.caseArgument` names an
/// argument of `body.decl`'s own `@cases`.
void bindTest(ref Binder b, through ref Ctx c, for TestBody body) {
    t15CaptureTypes(ref b, through: ref c)
    c.functions[b.fn].infersErrors = true
    switch c.files[body.decl.file].unit.members[body.decl.declIndex] {
        case .testDecl(let d):
            switch d.value.body {
                case .blockStmt(let block):
                    if !body.hasValues {
                        c.functions[b.fn].body = bindBlock(ref b, through: ref c, for: in block.value)
                        return
                    }
                    var statements = List<BStmt>()
                    for i in 0..d.value.params.length {
                        let type = resolveType(ref b, through: ref c, for: in d.value.params[i].type)
                        let value = t15BindCaseValue(
                            ref b,
                            through: ref c,
                            for: in d.value.attributes[body.caseArgument.memberIndex].args[body.caseArgument.itemIndex].value,
                            at: i,
                            to: type,
                        )
                        let local = declareLocal(
                            ref b,
                            through: ref c,
                            at: d.value.params[i].name,
                            as: type,
                            for: .letKeyword,
                        )
                        statements.append(
                            recordNodeSyntax(
                                ref c,
                                for: addLocalDecl(
                                    ref c,
                                    from: BLocalDecl { span: d.value.params[i].span, local: local, initializer: value },
                                ),
                                as: .param,
                                at: d.value.params[i].span,
                            ),
                        )
                    }
                    statements.append(bindBlock(ref b, through: ref c, for: in block.value))
                    c.functions[b.fn].body = recordNodeSyntax(
                        ref c,
                        for: addBlock(ref c, from: BBlock { span: block.value.span, statements: move statements }),
                        as: .blockStmt,
                        at: block.value.span,
                    )
                default:
                    break
            }
        default:
            panic("internal error: a test body ref is not a test")
    }
}

/// The C# `values[i]` of a case: a tuple argument's element values, or the value alone (Compilation.cs:334).
BExpr t15BindCaseValue(ref Binder b, through ref Ctx c, for in parser.Expr arg, at i64 i, to Type type) {
    switch arg {
        case .tupleExpr(let tuple):
            return bindConverted(ref b, through: ref c, for: in tuple.value.elements[i].value, to: type)
        default:
            return bindConverted(ref b, through: ref c, for: in arg, to: type)
    }
}

BExpr bindFieldDefault(ref Binder b, through ref Ctx c, for FieldId f) {
    t15CaptureTypes(ref b, through: ref c)
    switch c.files[c.fields[f].file].unit.members[c.fields[f].declIndex] {
        case .structDecl(let s):
            switch s.value.members[c.fields[f].memberIndex] {
                case .fieldDecl(let d):
                    let value = bindConverted(
                        ref b,
                        through: ref c,
                        for: in d.value.defaultKeyword,
                        to: c.fields[f].type,
                    )
                    return value
                default:
                    return -1
            }
        default:
            return -1
    }
}

/// The arguments of each member of a data enum, matched like call arguments; each must be a constant (BYN2723).
/// The C# parameters are new locals (Q619).
void bindEnumArguments(ref Binder b, through ref Ctx c, for EnumId e) {
    t15CaptureTypes(ref b, through: ref c)
    var ps = List<LocalId>()
    let fields = copyIds(in c.enums[e].fields)
    for f in fields {
        ps.append(
            newLocal(
                ref c,
                by: LocalSymbol {
                    name: c.enumFields[f].name,
                    nameSpan: c.enumFields[f].nameSpan,
                    type: c.enumFields[f].type,
                    kind: .parameter,
                    isParameter: true,
                    modifier: .none,
                    ordinal: c.enumFields[f].index,
                },
            ),
        )
    }
    let file = c.enums[e].file
    switch c.files[file].unit.members[c.enums[e].declIndex] {
        case .enumDecl(let d):
            for m in d.value.members {
                let member = findEnumMember(ref c, by: e, for: t15Text(in c, from: file, at: m.name))
                continue if member == -1 || c.enumMembers[member].values.length != 0
                continue if m.args is null && d.value.params is null
                let name = $"{c.enums[e].name}.{c.enumMembers[member].name}"
                // C# `BindArguments(new CallExpr(d.Span, new NameExpr(d.Name.Span, …), d.Args ?? []), …)`: the arguments, the span,
                // and that `CallExpr` as the `Syntax` of a missing argument's `BoundErrorExpr` (BinderCalls.cs:452).
                let call = syntaxAppend(
                    ref c,
                    from: ExprSyntax {
                        kind: .callExpr,
                        span: m.span,
                        callee: syntaxLeaf(ref c, as: .nameExpr, at: m.name),
                    },
                )
                var args = List<BExpr>()
                if (m.args is { } given) {
                    args = t21BindArgumentList(
                        ref b,
                        through: ref c,
                        for: in given,
                        at: m.span,
                        by: in ps,
                        as: -1,
                        enforceNames: false,
                        displayName: name,
                        syntax: call,
                    )
                } else {
                    let none = List<parser.Argument>()
                    args = t21BindArgumentList(
                        ref b,
                        through: ref c,
                        for: in none,
                        at: m.span,
                        by: in ps,
                        as: -1,
                        enforceNames: false,
                        displayName: name,
                        syntax: call,
                    )
                }
                var values = List<Constant?>()
                for i in 0..args.length {
                    values.append(null)
                }
                c.enumMembers[member].values = move values
                for i in 0..args.length {
                    let arg = args[i]
                    continue if isError(exprType(in c, for: arg)) || isError(c.locals[ps[i]].type)
                    if boundKind(arg) == .enumMember {
                        let ordinal = c.enumMembers[c.bEnumMembers[boundIndex(arg)].member].ordinal
                        c.enumMembers[member].values[i] = Constant { kind: .integer, integer: bigFromI64(ordinal) }
                    } else if (exprConstant(in c, for: arg) is { } value) {
                        c.enumMembers[member].values[i] = value
                    } else {
                        report(
                            ref b,
                            through: ref c,
                            for: .enumArgumentNotConstant,
                            at: nodeSpan(in c, for: arg),
                            by: (c.locals[ps[i]].name, name, "", "", ""),
                            label: "computed at run time",
                            help: "use literals and `const`s only; enum data is static",
                        )
                    }
                }
            }
        default:
            break
    }
}

void bindModuleConstant(ref Binder b, through ref Ctx c, for ConstId k) {
    t15CaptureTypes(ref b, through: ref c)
    switch c.files[c.consts[k].file].unit.members[c.consts[k].declIndex] {
        case .globalStatement(let g):
            switch g.value.statement {
                case .localDecl(let decl):
                    t15BindConstant(ref b, through: ref c, for: k, by: in decl.value)
                default:
                    break
            }
        default:
            break
    }
}

/// The body of `BindModuleConstant` once `c.Decl` is found.
void t15BindConstant(ref Binder b, through ref Ctx c, for ConstId k, by in parser.LocalDecl decl) {
    var declared: Type = -1
    if decl.type is not .none {
        declared = resolveType(ref b, through: ref c, for: in decl.type)
        if functionTypeNotHere(ref c, for: declared, from: b.file, at: typeSyntaxSpan(in decl.type), as: "a constant") {
            declared = errorType()
        }
    }
    if decl.init is .none {
        report(
            ref b,
            through: ref c,
            for: .missingInitializer,
            at: decl.name,
            by: ("const", t15Text(in c, from: b.file, at: decl.name), "", "", ""),
        )
        c.consts[k].type = declared != -1 ? declared : errorType()
        return
    }
    var value = declared == -1 ? built(
        ref b,
        through: ref c,
        for: bindExpr(ref b, through: ref c, for: in decl.init),
        from: in decl.init,
    ) : bindConverted(ref b, through: ref c, for: in decl.init, to: declared)
    if declared == -1 {
        c.consts[k].type = defaultType(ref b, through: ref c, for: value, from: in decl.init)
        value = convert(ref b, through: ref c, for: value, to: c.consts[k].type, at: parser.exprSpan(in decl.init))
    } else {
        c.consts[k].type = declared
    }
    let type = c.consts[k].type
    if kindOf(type) == .array || kindOf(type) == .list || kindOf(type) == .span || decl.init is .collectionExpr(_) {
        t15BindStaticArray(ref b, through: ref c, for: k, by: in decl, as: value)
        return
    }
    if !checkUniqueConst(ref b, through: ref c, for: in decl, as: type)
            && exprConstant(in c, for: value) is null
            && !isError(exprType(in c, for: value)) {
        report(
            ref b,
            through: ref c,
            for: .notConstant,
            at: parser.exprSpan(in decl.init),
            by: ("a `const`", "", "", "", ""),
        )
    }
    c.consts[k].value = exprConstant(in c, for: value)
    c.consts[k].bound = value
}

/// A module-level `const T[N]` whose elements are literal numbers, `bool`s, `char`s or `string`s becomes static data (BYN2229 otherwise).
void t15BindStaticArray(ref Binder b, through ref Ctx c, for ConstId k, by in parser.LocalDecl decl, as BExpr value) {
    c.consts[k].bound = value
    return if isError(exprType(in c, for: value))
    let name = t15Text(in c, from: b.file, at: decl.name)
    let help = $"write `const T[N] {name} = [ … ]` with `T` a number type, `bool`, `rune` or `string`, and only literals or constants inside"
    let type = c.consts[k].type
    var element: Type = -1
    if kindOf(type) == .array {
        element = c.arrayTypes[typeIndex(type)].element
    }
    if !(isNumeric(element) || element == prim(.bool) || element == prim(.char) || element == prim(.string)) {
        let span = decl.type is not .none ? typeSyntaxSpan(in decl.type) : parser.exprSpan(in decl.init)
        report(ref b, through: ref c, for: .invalidConstArray, at: span, by: (name, "", "", "", ""), help: help)
        return
    }
    if boundKind(value) != .collection {
        report(
            ref b,
            through: ref c,
            for: .invalidConstArray,
            at: parser.exprSpan(in decl.init),
            by: (name, "", "", "", ""),
            help: help,
        )
        return
    }
    var elements = List<BExpr>()
    for x in c.bCollections[boundIndex(value)].elements {
        elements.append(x)
    }
    for x in elements {
        return if isError(exprType(in c, for: x))
    }
    for x in elements {
        if exprConstant(in c, for: x) is null {
            report(
                ref b,
                through: ref c,
                for: .invalidConstArray,
                at: nodeSpan(in c, for: x),
                by: (name, "", "", "", ""),
                label: "not a constant",
                help: help,
            )
            return
        }
    }
    c.consts[k].isStaticArray = true
    for x in elements {
        if (exprConstant(in c, for: x) is { } v) {
            c.consts[k].elements.append(v)
        }
    }
}

/// The `N` of `T[N]`: a non-negative integer constant, or -1 after an error.
i64 bindArraySize(ref Binder b, through ref Ctx c, for in parser.Expr size) {
    t15CaptureTypes(ref b, through: ref c)
    let value = bindConverted(ref b, through: ref c, for: in size, to: prim(.i64))
    return -1 if isError(exprType(in c, for: value))
    let span = parser.exprSpan(in size)
    if (exprConstant(in c, for: value) is { } k) {
        if k.kind == .integer {
            if bigIsNeg(k.integer) {
                report(
                    ref b,
                    through: ref c,
                    for: .literalOutOfRange,
                    at: span,
                    by: (bigText(k.integer), "an array length", "", "", ""),
                )
                return -1
            }
            return bigToI64(k.integer)
        }
    }
    report(ref b, through: ref c, for: .notConstant, at: span, by: ("an array length", "", "", "", ""))
    return -1
}
== semantics/binder2.byn
// T16: Binder.cs 516-980 (exit code, blocks, statement dispatch, assert, narrowing, labels, locals, while-let, for head).

import parser
import lexer

// What `narrowedBegin` saved for `narrowedEnd`: the C# `Narrowed`'s `Func` split in two around the
// caller's bind. `mark` is the `nonNullLocals` length to cut back to, `before` the state facts to keep and
// `learned` what `learnStates` added.
struct NarrowedScope {
    i64                        mark
    List<(i64, LocalId, Type)> before
    List<(i64, LocalId, Type)> learned
}

/// The C# `labelTarget ?? new JumpTarget(null, isLoop)`; a new target takes the next `c.jumpTargets` id.
JumpTarget t16Target(ref Ctx c, to JumpTarget? labelTarget, bool isLoop) {
    return labelTarget if labelTarget is not null
    return t16NewTarget(ref c, for: null, isLoop: isLoop)
}

/// The C# `new JumpTarget(label, isLoop)`.
JumpTarget t16NewTarget(ref Ctx c, for string? label, bool isLoop) {
    let target = JumpTarget {
        label: label,
        isLoop: isLoop,
        id: c.jumpTargets.length,
    }
    c.jumpTargets.append(target)
    return target
}

/// The C# `_scope` a fact is keyed by: its identity (Q715).
i64 t16ScopeId(ref Binder b) => b.scopeIds[t15Scope(ref b)]

/// The value of `@exitCode(n)`: one integer constant from 1 to 255, else BYN2772 and 1.
i32 bindExitCode(ref Binder b, through ref Ctx c, for in parser.AttributeSyntax a) {
    if a.args.length != 1 || a.args[0].name is not null || a.args[0].modifier != .none {
        report(ref b, through: ref c, for: .invalidExitCode, at: a.span, by: ("", "", "", "", ""))
        return 1
    }
    let value = bindExpr(ref b, through: ref c, for: in a.args[0].value)
    let vType = exprType(in c, for: value)
    return 1 if isError(vType)
    let vConst = exprConstant(in c, for: value)
    let valSpan = parser.exprSpan(in a.args[0].value)
    if !isInteger(vType) || vConst is null {
        report(ref b, through: ref c, for: .invalidExitCode, at: valSpan, by: ("", "", "", "", ""))
        return 1
    }
    if (vConst is { } k) {
        if k.integer.hi != 0 || k.integer.lo < 1 || k.integer.lo > 255 {
            report(
                ref b,
                through: ref c,
                for: .invalidExitCode,
                at: valSpan,
                by: ("", "", "", "", ""),
                help: "pick a code from 1 to 255; 0 means success, and exit codes above 255 do not survive the operating system",
            )
            return 1
        }
        return i32(k.integer.lo)
    }
    return 1
}

// ── Statements ───────────────────────────────────────────────────────────────

BStmt bindBlock(ref Binder b, through ref Ctx c, for in parser.BlockStmt block) {
    pushScope(ref b)
    var statements = List<BStmt>()
    for i in 0..block.statements.length {
        statements.append(bindStatement(ref b, through: ref c, for: in block.statements[i]))
    }
    popScope(ref b)
    return recordNodeSyntax(
        ref c,
        for: addBlock(ref c, from: BBlock { span: block.span, statements: move statements }),
        as: .blockStmt,
        at: block.span,
    )
}

/// A loop or `if` body: a block, or one statement in its own scope.
BStmt bindBody(ref Binder b, through ref Ctx c, for in parser.Stmt body) {
    switch body {
        case .blockStmt(let blk):
            return bindBlock(ref b, through: ref c, for: in blk.value)
        default:
            pushScope(ref b)
            let s = bindStatement(ref b, through: ref c, for: in body)
            popScope(ref b)
            return s
    }
}

/// The C# `Compilation.MutationOperators`: the operator names `@unobservable(<op>)` accepts (revision 0014 §3).
const t28MutationOperators: string[11] = [
    "boundary", "relational", "logical", "condition", "bool", "arithmetic", "literal", "negation", "statement",
    "emptyReturn", "variant",
]

/// Records an `@unobservable` mark (R7). A statement is bound more than once (first pass, generic instances); the
/// compilation keeps one mark per statement and operator. `stmt` is the C# `stmt.Span`.
void bindUnobservable(ref Binder b, through ref Ctx c, at TextSpan stmt, for in parser.AttributeSyntax attribute) {
    return if t15Text(in c, from: b.file, at: attribute.name) != "unobservable"
    var op: string? = null
    if attribute.args.length > 0 {
        let span = parser.exprSpan(in attribute.args[0].value)
        switch attribute.args[0].value {
            case .nameExpr(let n):
                op = t15Text(in c, from: b.file, at: n.value.name)
            default:
                op = t15Text(in c, from: b.file, at: span)
        }
        let text = op ?? ""
        var known = false
        for o in t28MutationOperators {
            if o == text {
                known = true
            }
        }
        if !known {
            var help = StrBuf()
            help.append("use one of ")
            for i in 0..t28MutationOperators.length {
                if i > 0 {
                    help.append(", ")
                }
                help.append($"`{t28MutationOperators[i]}`")
            }
            help.append(", or no argument for all")
            report(
                ref b,
                through: ref c,
                for: .unknownMutationOperator,
                at: span,
                by: (text, "", "", "", ""),
                label: "not an operator",
                help: $"{help.finish()}",
            )
            return
        }
    }
    var reason = ""
    if (attribute.becauseKeyword is { } r) {
        reason = r.reason
    }
    t28AddUnobservable(ref c, by: UnobservableMark { file: c.files[b.file].path, span: stmt, op: op, reason: reason })
}

/// C# `UnobservableMark`: one `@unobservable` mark; `op` null means every operator.
public struct UnobservableMark {
    public string   file
    public TextSpan span
    public string?  op
    public string   reason
}

/// The C# `Compilation.AddUnobservable`: keeps the first mark per file, span and operator (`*` keys a null operator,
/// which no operator name spells).
void t28AddUnobservable(ref Ctx c, by UnobservableMark mark) {
    let key = $"{mark.file}|{mark.span.start}|{mark.span.length}|{mark.op ?? "*"}"
    return if c.unobservableSeen.contains(key)
    c.unobservableSeen[key] = 1
    c.unobservable.append(mark)
}

/// The C# `foreach (var attribute in stmt.Attributes) BindUnobservable(stmt, attribute)`, one arm per variant.
void t28BindUnobservables(ref Binder b, through ref Ctx c, for in parser.Stmt stmt) {
    switch stmt {
        case .blockStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .localDecl(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .exprStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .assignStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .incDecStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .returnStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .failStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .breakStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .continueStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .becomeStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .ifStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .unlessStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .guardedStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .whileStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .doWhileStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .whileLetStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .forStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .labeledStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .switchStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .deferStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .assertStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .contextStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .emptyStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .errorStmt(let n):
            for a in n.value.attributes {
                bindUnobservable(ref b, through: ref c, at: n.value.span, for: in a)
            }
        case .none:
            return
    }
}

BStmt bindStatement(ref Binder b, through ref Ctx c, for in parser.Stmt stmt, JumpTarget? labelTarget = null) {
    t28BindUnobservables(ref b, through: ref c, for: in stmt)
    switch stmt {
        case .blockStmt(let blk):
            return bindBlock(ref b, through: ref c, for: in blk.value)
        case .localDecl(let d):
            return bindLocalDecl(ref b, through: ref c, for: in d.value)
        case .exprStmt(let e):
            let expr = bindStatementExpression(ref b, through: ref c, for: in e.value.expr)
            learnBecomes(ref b, through: ref c, for: expr)
            return recordNodeSyntax(
                ref c,
                for: addExprStmt(ref c, from: BExprStmt { span: e.value.span, expr: expr }),
                as: .exprStmt,
                at: e.value.span,
            )
        case .assignStmt(let a):
            if a.value.op == .assign {
                switch a.value.target {
                    case .memberExpr(let m):
                        switch m.value.target {
                            case .nameExpr(let n):
                                if t15Text(in c, from: b.file, at: n.value.name) == "Panic" {
                                    let member = t15Text(in c, from: b.file, at: m.value.member)
                                    return bindOnPanic(ref b, through: ref c, for: in a.value) if (member is "handler"
                                        or "onPanic") && t15Lookup(ref b, for: "Panic") == -1
                                }
                            default:
                        }
                    default:
                }
            }
            return bindAssign(ref b, through: ref c, for: in a.value)
        case .incDecStmt(let i):
            return bindIncDec(ref b, through: ref c, for: in i.value)
        case .returnStmt(let r):
            return bindReturn(ref b, through: ref c, for: in r.value)
        case .failStmt(let f):
            return bindFail(ref b, through: ref c, for: in f.value)
        case .breakStmt(let brk):
            return bindBreak(ref b, through: ref c, for: in brk.value)
        case .continueStmt(let cont):
            return bindContinue(ref b, through: ref c, for: in cont.value)
        case .ifStmt(let i):
            let cond = bindCondition(ref b, through: ref c, for: in i.value.condition)
            var thenCond = (false, TextSpan { start: 0, length: 0 }, TextSpan { start: 0, length: 0 })
            switch i.value.condition {
                case .memberExpr(let me):
                    thenCond = (true, parser.exprSpan(me.value.target), me.value.member)
                default: {}
            }
            b.thenOf.append(thenCond)
            let sThen = narrowedBegin(ref b, through: ref c, for: cond, whenTrue: true)
            let thenBranch = bindBody(ref b, through: ref c, for: in i.value.then)
            narrowedEnd(ref b, through: ref c, by: move sThen)
            let _ = b.thenOf.removeLast()
            var elseBranch: BStmt = -1
            switch i.value.elseKeyword {
                case .none:
                    let _ = 0
                default:
                    let sElse = narrowedBegin(ref b, through: ref c, for: cond, whenTrue: false)
                    elseBranch = bindBody(ref b, through: ref c, for: in i.value.elseKeyword)
                    narrowedEnd(ref b, through: ref c, by: move sElse)
            }
            return narrowAfter(ref b, through: ref c, for: recordNodeSyntax(ref c, for: addIf(ref c, from: BIf {
                span: i.value.span,
                condition: cond,
                then: thenBranch,
                elseBranch: elseBranch,
                isNever: i.value.likelihood == .neverKeyword,
            }), as: .ifStmt, at: i.value.span))
        case .unlessStmt(let u):
            let cond = negate(
                ref c,
                from: in u.value.condition,
                by: bindCondition(ref b, through: ref c, for: in u.value.condition),
            )
            let sThen = narrowedBegin(ref b, through: ref c, for: cond, whenTrue: true)
            let thenBranch = bindBody(ref b, through: ref c, for: in u.value.body)
            narrowedEnd(ref b, through: ref c, by: move sThen)
            return narrowAfter(ref b, through: ref c, for: recordNodeSyntax(ref c, for: addIf(ref c, from: BIf {
                span: u.value.span,
                condition: cond,
                then: thenBranch,
                elseBranch: -1,
                isNever: false,
            }), as: .unlessStmt, at: u.value.span))
        case .guardedStmt(let g):
            // The condition is evaluated first (spec §7.3); pattern variables it binds stay in scope.
            var cond = bindCondition(ref b, through: ref c, for: in g.value.condition)
            if g.value.unlessKeyword {
                cond = negate(ref c, from: in g.value.condition, by: cond)
            }
            let sThen = narrowedBegin(ref b, through: ref c, for: cond, whenTrue: true)
            let body = bindStatement(ref b, through: ref c, for: in g.value.statement)
            narrowedEnd(ref b, through: ref c, by: move sThen)
            return narrowAfter(ref b, through: ref c, for: recordNodeSyntax(ref c, for: addIf(ref c, from: BIf {
                span: g.value.span,
                condition: cond,
                then: body,
                elseBranch: -1,
                isNever: false,
                guarded: true,
            }), as: .guardedStmt, at: g.value.span))
        case .whileStmt(let w):
            let target = t16Target(ref c, to: labelTarget, isLoop: true)
            forgetChangingStates(ref b, through: ref c)
            pushScope(ref b)
            let cond = bindCondition(ref b, through: ref c, for: in w.value.condition)
            b.targets.append(target)
            let body = bindBody(ref b, through: ref c, for: in w.value.body)
            b.targets.remove(at: b.targets.length - 1)
            popScope(ref b)
            return recordNodeSyntax(ref c, for: addWhile(ref c, from: BWhile {
                span: w.value.span,
                condition: cond,
                body: body,
                target: target.id,
            }), as: .whileStmt, at: w.value.span)
        case .whileLetStmt(let w):
            forgetChangingStates(ref b, through: ref c)
            return bindWhileLet(
                ref b,
                through: ref c,
                for: in w.value,
                to: t16Target(ref c, to: labelTarget, isLoop: true),
            )
        case .doWhileStmt(let d):
            let target = t16Target(ref c, to: labelTarget, isLoop: true)
            forgetChangingStates(ref b, through: ref c)
            b.targets.append(target)
            let body = bindBody(ref b, through: ref c, for: in d.value.body)
            b.targets.remove(at: b.targets.length - 1)
            let cond = bindCondition(ref b, through: ref c, for: in d.value.condition)
            return recordNodeSyntax(ref c, for: addDoWhile(ref c, from: BDoWhile {
                span: d.value.span,
                body: body,
                condition: cond,
                target: target.id,
            }), as: .doWhileStmt, at: d.value.span)
        case .forStmt(let f):
            forgetChangingStates(ref b, through: ref c)
            return bindFor(ref b, through: ref c, for: in f.value, to: t16Target(ref c, to: labelTarget, isLoop: true))
        case .labeledStmt(let l):
            return bindLabeled(ref b, through: ref c, for: in l.value)
        case .switchStmt(let s):
            return bindSwitchStatement(
                ref b,
                through: ref c,
                for: in s.value,
                to: t16Target(ref c, to: labelTarget, isLoop: false),
            )
        case .deferStmt(let d):
            if d.value.kind == .always {
                b.deferDepth += 1
                let body = bindBody(ref b, through: ref c, for: in d.value.body)
                b.deferDepth -= 1
                return recordNodeSyntax(
                    ref c,
                    for: addDefer(ref c, from: BDefer { span: d.value.span, body: body }),
                    as: .deferStmt,
                    at: d.value.span,
                )
            }
            return bindErrdefer(ref b, through: ref c, for: in d.value) if d.value.kind == .failing
            return bindPanicDefer(ref b, through: ref c, for: in d.value)
        case .contextStmt(let cntx):
            return bindContext(ref b, through: ref c, for: in cntx.value)
        case .assertStmt(let a):
            return bindAssert(ref b, through: ref c, for: in a.value)
        case .becomeStmt(let bcm):
            return bindBecome(ref b, through: ref c, for: in bcm.value)
        // coverage-exempt: Q765 through `BErrorStmt { span: err.value.span }`
        case .emptyStmt(let em):
            return recordNodeSyntax(
                ref c,
                for: addBlock(ref c, from: BBlock { span: em.value.span, statements: List<BStmt>() }),
                as: .emptyStmt,
                at: em.value.span,
            )
        case .errorStmt(let err):
            return recordNodeSyntax(
                ref c,
                for: addErrorStmt(ref c, from: BErrorStmt { span: err.value.span }),
                as: .errorStmt,
                at: err.value.span,
            )
        // coverage-exempt: Q765 through `BErrorStmt { span: span }`
        default:
            let span = t15StmtSpan(in stmt)
            report(ref b, through: ref c, for: .unsupported, at: span, by: ("this statement", "", "", "", ""))
            return recordStmtSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: span }), from: in stmt)
    }
}

BExpr negate(ref Ctx c, from in parser.Expr syntax, by BExpr cond) {
    let span = parser.exprSpan(in syntax)
    if (exprConstant(in c, for: cond) is { } k) {
        if k.kind == .flag {
            let lit = recordSyntax(ref c, for: addLiteral(ref c, from: BLiteral {
                span: span,
                type: prim(.bool),
                value: Constant { kind: .flag, flag: !k.flag },
            }), from: in syntax)
            setConstant(ref c, for: lit, to: Constant { kind: .flag, flag: !k.flag })
            return lit
        }
    }
    return recordSyntax(ref c, for: addUnary(ref c, from: BUnary {
        span: span,
        op: .notKeyword,
        operand: cond,
        type: prim(.bool),
    }), from: in syntax)
}

BExpr bindCondition(ref Binder b, through ref Ctx c, for in parser.Expr e) =>
    bindConverted(ref b, through: ref c, for: in e, to: prim(.bool))

BStmt bindAssert(ref Binder b, through ref Ctx c, for in parser.AssertStmt a) {
    switch a.failsKeyword {
        case .none:
            let _ = 0
        default:
            return bindAssertFails(ref b, through: ref c, for: in a)
    }
    let condition = bindExpr(ref b, through: ref c, for: in a.condition, to: prim(.bool))
    let condType = exprType(in c, for: condition)
    if isError(condType) || implicit(ref c, from: condType, to: prim(.bool)) is not null {
        let conv = convert(ref b, through: ref c, for: condition, to: prim(.bool), at: parser.exprSpan(in a.condition))
        return recordNodeSyntax(
            ref c,
            for: addAssert(ref c, from: BAssert { span: a.span, condition: conv, failsWith: -1, failsCase: -1 }),
            as: .assertStmt,
            at: a.span,
        )
    }
    report(
        ref b,
        through: ref c,
        for: .assertNotBool,
        at: parser.exprSpan(in a.condition),
        by: (typeDisplay(ref c, by: condType), "", "", "", ""),
        label: "this is not a `bool`",
        help: "check the value against what you expect, e.g. `assert count == 3`",
    )
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
        as: .assertStmt,
        at: a.span,
    )
}

/// C# `StripParens(a.Condition) is CallExpr call`: walks the `parenExpr` chain in place (Q703); a call is bound with
/// `handled` set to it, anything else is bound as the whole condition with `handled` left as it was (Q597).
BExpr t16BindAssertOperand(ref Binder b, through ref Ctx c, for in parser.Expr e, from in parser.Expr condition) {
    switch e {
        case .parenExpr(let p):
            return t16BindAssertOperand(ref b, through: ref c, for: in p.value.inner, from: in condition)
        case .callExpr(let call):
            let saved = b.handled
            b.handled = call.value.span
            let operand = bindExpr(ref b, through: ref c, for: in e)
            b.handled = saved
            return operand
        default:
            return bindExpr(ref b, through: ref c, for: in condition)
    }
}

/// `assert f() fails E.x` or `assert f() fails E`: the call is handled here, not wrapped in `try`.
BStmt bindAssertFails(ref Binder b, through ref Ctx c, for in parser.AssertStmt a) {
    let operand = t16BindAssertOperand(ref b, through: ref c, for: in a.condition, from: in a.condition)
    if boundKind(operand) != .call || !c.functions[c.bCalls[boundIndex(operand)].function].hasFails {
        if !isError(exprType(in c, for: operand)) {
            report(
                ref b,
                through: ref c,
                for: .nothingToHandle,
                at: parser.exprSpan(in a.condition),
                by: ("assert … fails", "", "", "", ""),
            )
        }
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
            as: .assertStmt,
            at: a.span,
        )
    }
    let sets = errorSetsOf(ref c, for: c.bCalls[boundIndex(operand)].function)
    let errorType = errorUnionOf(ref c, for: in sets, as: in List<VariantId>())
    var boundSet: BExpr = -1
    var caseName: TextSpan? = null
    var setSpan = a.span
    switch a.failsKeyword {
        case .memberExpr(let m):
            boundSet = bindExprOrType(ref b, through: ref c, for: in m.value.target)
            caseName = m.value.member
            setSpan = parser.exprSpan(in m.value.target)
        default:
            boundSet = bindExprOrType(ref b, through: ref c, for: in a.failsKeyword)
            setSpan = parser.exprSpan(in a.failsKeyword)
    }
    if boundKind(boundSet) != .typeRef || kindOf(c.bTypeRefs[boundIndex(boundSet)].referenced) != .errorSet {
        report(
            ref b,
            through: ref c,
            for: .patternMismatch,
            at: setSpan,
            by: ($"`{t15Text(in c, from: b.file, at: setSpan)}`", typeDisplay(ref c, by: errorType), "", "", ""),
        )
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
            as: .assertStmt,
            at: a.span,
        )
    }
    let set = typeIndex(c.bTypeRefs[boundIndex(boundSet)].referenced)
    var variant: VariantId = -1
    if (caseName is { } cn) {
        variant = findErrorVariant(ref c, by: set, for: t15Text(in c, from: b.file, at: cn))
        if variant == -1 {
            let failsSpan = parser.exprSpan(in a.failsKeyword)
            var names = List<string>()
            for v in c.errorSets[set].variants {
                names.append(c.errorVariants[v].name)
            }
            let close = suggest(t15Text(in c, from: b.file, at: cn), by: in names)
            report(
                ref b,
                through: ref c,
                for: .patternMismatch,
                at: failsSpan,
                by: (
                    $"`{t15Text(in c, from: b.file, at: failsSpan)}`",
                    typeDisplay(ref c, by: errorSetTypeOf(set)),
                    "",
                    "",
                    ""
                ),
                help: close is { } s ? $"did you mean `{s}`?" : "",
            )
            return recordNodeSyntax(
                ref c,
                for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
                as: .assertStmt,
                at: a.span,
            )
        }
    }
    var listed = false
    for s in sets {
        if s == set {
            listed = true
        }
    }
    if sets.length > 0 && !listed {
        report(
            ref b,
            through: ref c,
            for: .patternMismatch,
            at: setSpan,
            by: ($"`{typeDisplay(ref c, by: errorSetTypeOf(set))}`", typeDisplay(ref c, by: errorType), "", "", ""),
        )
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
            as: .assertStmt,
            at: a.span,
        )
    }
    return recordNodeSyntax(ref c, for: addAssert(ref c, from: BAssert {
        span: a.span,
        condition: operand,
        failsWith: set,
        failsCase: variant,
    }), as: .assertStmt, at: a.span)
}

// ── Null narrowing (spec §7.2) ───────────────────────────────────────────────

/// A fact holds while its scope is open: the C# walk from `_scope` up its parents (Q715).
bool isNonNull(ref Binder b, for LocalId local) {
    for pair in b.nonNullLocals {
        continue if pair.item2 != local
        for s in b.scopeIds {
            return true if s == pair.item1
        }
    }
    return false
}

/// Binds code that runs only when `cond` is `whenTrue`: the C# `Narrowed` before `bind()`.
NarrowedScope narrowedBegin(ref Binder b, through ref Ctx c, for BExpr cond, bool whenTrue) {
    let mark = b.nonNullLocals.length
    let scope = t16ScopeId(ref b)
    for l in nonNullWhen(in c, for: cond, whenTrue: whenTrue) {
        b.nonNullLocals.append((scope, l))
    }
    var before = List<(i64, LocalId, Type)>()
    for f in b.stateFacts {
        before.append(f)
    }
    let learned = learnStates(ref b, through: ref c, for: cond, whenTrue: whenTrue)
    return NarrowedScope {
        mark: mark,
        before: move before,
        learned: move learned,
    }
}

/// The C# `Narrowed` after `bind()`.
void narrowedEnd(ref Binder b, through ref Ctx c, by move NarrowedScope scope) {
    while b.nonNullLocals.length > scope.mark {
        b.nonNullLocals.remove(at: b.nonNullLocals.length - 1)
    }
    // What the branch learned holds only when it ran.
    var kept = List<(i64, LocalId, Type)>()
    for f in b.stateFacts {
        for bf in scope.before {
            if bf.item1 == f.item1 && bf.item2 == f.item2 && bf.item3 == f.item3 {
                kept.append(f)
                break
            }
        }
    }
    b.stateFacts = move kept
    unlearnStates(ref b, by: in scope.learned)
}

/// When one branch always exits, the rest of the block runs only under the other.
BStmt narrowAfter(ref Binder b, through ref Ctx c, for BStmt i) {
    let node = c.bIfs[boundIndex(i)]
    let thenExits = exits(in c, for: node.then)
    let elseExits = node.elseBranch != -1 && exits(in c, for: node.elseBranch)
    if thenExits != elseExits {
        let scope = t16ScopeId(ref b)
        for l in nonNullWhen(in c, for: node.condition, whenTrue: elseExits) {
            b.nonNullLocals.append((scope, l))
        }
        let _ = learnStates(ref b, through: ref c, for: node.condition, whenTrue: elseExits)
    }
    return i
}

bool exits(in Ctx c, for BStmt s) {
    switch boundKind(s) {
        case .returnStmt or .breakStmt or .continueStmt:
            return true
        case .block:
            let n = c.bBlocks[boundIndex(s)].statements.length
            return n > 0 && exits(in c, for: c.bBlocks[boundIndex(s)].statements[n - 1])
        case .exprStmt:
            return isNever(exprType(in c, for: c.bExprStmts[boundIndex(s)].expr))
        case .ifStmt:
            let node = c.bIfs[boundIndex(s)]
            return node.elseBranch != -1 && exits(in c, for: node.then) && exits(in c, for: node.elseBranch)
        default:
            return false
    }
}

/// The let locals and parameters that `cond` being `whenTrue` proves present; `var`s can change, so they never narrow.
List<LocalId> nonNullWhen(in Ctx c, for BExpr cond, bool whenTrue) {
    var found = List<LocalId>()
    nonNullCollect(in c, for: cond, when: whenTrue, to: ref found)
    return found
}

/// The C# local function `Collect` of `NonNullWhen`.
void nonNullCollect(in Ctx c, for BExpr cond, bool when, to ref List<LocalId> found) {
    switch boundKind(cond) {
        case .isExpr:
            let i = c.bIses[boundIndex(cond)]
            return if boundKind(i.value) != .local
            let l = c.bLocals[boundIndex(i.value)].local
            return if kindOf(c.locals[l].type) != .optional
            return if !(c.locals[l].kind == .letKeyword
                || (c.locals[l].isParameter && (c.locals[l].modifier is .none or .inKeyword)))
            var proves = false
            if boundKind(i.pattern) == .notPattern
                    && boundKind(c.bNotPatterns[boundIndex(i.pattern)].operand) == .constantPattern
                    && boundKind(
                        c.bConstantPatterns[boundIndex(c.bNotPatterns[boundIndex(i.pattern)].operand)].value,
                    ) == .defaultValue {
                proves = when
            } else {
                proves = boundKind(i.pattern) == .constantPattern
                    && boundKind(c.bConstantPatterns[boundIndex(i.pattern)].value) == .defaultValue
                    && !when
            }
            if proves {
                found.append(l)
            }
        case .unary:
            let u = c.bUnaries[boundIndex(cond)]
            if u.op == .notKeyword {
                nonNullCollect(in c, for: u.operand, when: !when, to: ref found)
            }
        case .binary:
            let bin = c.bBinaries[boundIndex(cond)]
            if (bin.op is .logicalAnd or .logicalOr) && when == (bin.op == .logicalAnd) {
                nonNullCollect(in c, for: bin.left, when: when, to: ref found)
                nonNullCollect(in c, for: bin.right, when: when, to: ref found)
            }
        default:
    }
}

BStmt bindLabeled(ref Binder b, through ref Ctx c, for in parser.LabeledStmt l) {
    checkValueName(ref b, through: ref c, at: l.label)
    let text = t15Text(in c, from: b.file, at: l.label)
    var duplicate = false
    for t in b.targets {
        if t.label == text {
            duplicate = true
        }
    }
    if duplicate {
        report(
            ref b,
            through: ref c,
            for: .duplicateDeclaration,
            at: l.label,
            by: (text, "", "", "", ""),
            label: "an enclosing statement has this label",
        )
    }
    var isSwitch = false
    var onLoop = false
    switch l.statement {
        case .switchStmt(_):
            isSwitch = true
            onLoop = true
        case .whileStmt(_) or .whileLetStmt(_) or .doWhileStmt(_) or .forStmt(_):
            onLoop = true
        default:
    }
    let target = t16NewTarget(ref c, for: text, isLoop: !isSwitch)
    if !onLoop {
        report(ref b, through: ref c, for: .labelNotOnLoop, at: l.label, by: (text, "", "", "", ""))
        return bindStatement(ref b, through: ref c, for: in l.statement)
    }
    return bindStatement(ref b, through: ref c, for: in l.statement, labelTarget: target)
}

BStmt bindLocalDecl(ref Binder b, through ref Ctx c, for in parser.LocalDecl d) {
    var declared: Type = -1
    switch d.type {
        case .none:
            for s in b.seeds {
                if s.item1 == d.span.start {
                    if isInteger(s.item2) {
                        declared = s.item2
                    }
                    break
                }
            }
        default:
            declared = resolveType(ref b, through: ref c, for: in d.type)
    }
    var init: BExpr = -1
    switch d.init {
        case .none:
            if d.kind != .varKeyword {
                report(
                    ref b,
                    through: ref c,
                    for: .missingInitializer,
                    at: d.name,
                    by: (d.kind == .letKeyword ? "let" : "const", t15Text(in c, from: b.file, at: d.name), "", "", ""),
                    help: d.kind == .letKeyword
                        ? "give it a value, or declare it with `var` and assign it on every path before use"
                        : "",
                )
            } else if declared == -1 {
                let name = t15Text(in c, from: b.file, at: d.name)
                report(
                    ref b,
                    through: ref c,
                    for: .cannotInferType,
                    at: d.name,
                    by: (name, "", "", "", ""),
                    help: $"write the type: `var i64 {name}`",
                )
            }
        default:
            init = declared == -1 ? built(
                ref b,
                through: ref c,
                for: bindExpr(ref b, through: ref c, for: in d.init),
                from: in d.init,
            ) : bindConverted(ref b, through: ref c, for: in d.init, to: declared)
    }

    var type: Type = -1
    if declared != -1 {
        type = declared
    } else if init != -1 {
        type = defaultType(ref b, through: ref c, for: init, from: in d.init)
        init = convert(ref b, through: ref c, for: init, to: type, at: parser.exprSpan(in d.init))
    } else {
        type = errorType()
    }
    // A `var` can change state, so it holds the struct and what it is now is a fact (Question 295).
    var state: Type = -1
    if d.kind == .varKeyword && kindOf(type) == .state {
        state = type
        type = structTypeOf(c.stateTypes[typeIndex(state)].s)
    }

    let kind: LocalKind = d.kind == .letKeyword ? .letKeyword : (d.kind == .constKeyword ? .constKeyword : .varKeyword)
    let uniqueConst = d.kind == .constKeyword && checkUniqueConst(ref b, through: ref c, for: in d, as: type)
    if d.kind == .constKeyword
            && !uniqueConst
            && init != -1
            && exprConstant(in c, for: init) is null
            && !isError(exprType(in c, for: init)) {
        report(
            ref b,
            through: ref c,
            for: .notConstant,
            at: parser.exprSpan(in d.init),
            by: ("a `const`", "", "", "", ""),
        )
    }
    if d.usingKeyword {
        checkDisposable(ref b, through: ref c, for: in d, as: type)
    }
    let local = declareLocal(ref b, through: ref c, at: d.name, as: type, for: kind)
    if b.held > 0 && kind == .varKeyword && declared == -1 && type == prim(.i32) && isUntypedLiteral(in d.init) {
        b.pending[local] = d.span.start
    }
    c.locals[local].isUsing = d.usingKeyword
    if state != -1 {
        learnState(ref b, for: local, as: state)
    }
    let keyword = TextSpan { start: d.span.start, length: 3 }
    if (kind is .letKeyword or .varKeyword) && !d.usingKeyword
            && t15Text(in c, from: b.file, at: keyword) == (kind == .letKeyword ? "let" : "var") {
        c.locals[local].keywordSpan = keyword
    }
    if kind == .constKeyword {
        c.locals[local].constant = init == -1 ? null : exprConstant(in c, for: init)
    }
    return recordNodeSyntax(
        ref c,
        for: addLocalDecl(ref c, from: BLocalDecl { span: d.span, local: local, initializer: init }),
        as: .localDecl,
        at: d.span,
    )
}

/// BYN3209: a `const` holding a `struct unique` value; the fix declares it with `let`.
bool checkUniqueConst(ref Binder b, through ref Ctx c, for in parser.LocalDecl d, as Type type) {
    let keyword = TextSpan { start: d.span.start, length: 5 }
    let part = uniquePart(ref c, for: type)
    return false if part == -1 || kindOf(part) != .structType || t15Text(in c, from: b.file, at: keyword) != "const"
    report(
        ref b,
        through: ref c,
        for: .uniqueConst,
        at: keyword,
        by: ("", "", "", "", ""),
        label: $"`{typeDisplay(ref c, by: part)}` is `unique`",
        help: "declare it with `let`",
        hasFix: true,
        fixSpan: keyword,
        fixReplacement: "let",
    )
    return true
}

void checkDisposable(ref Binder b, through ref Ctx c, for in parser.LocalDecl d, as Type type) {
    return if type == builtinType(.arena) || kindOf(type) == .list || isError(type)
    report(
        ref b,
        through: ref c,
        for: .notDisposable,
        at: d.name,
        by: (typeDisplay(ref c, by: type), "", "", "", ""),
        help: "use `using` only for values that own memory: `Arena` and `List<T>`",
    )
}

/// The type a binding gets from its initializer when none is written.
Type defaultType(ref Binder b, through ref Ctx c, for BExpr init, from in parser.Expr syntax) {
    let t = exprType(in c, for: init)
    if kindOf(t) == .nullType {
        report(
            ref b,
            through: ref c,
            for: .cannotInferType,
            at: parser.exprSpan(in syntax),
            by: ("null", "", "", "", ""),
            help: "write the type: `i64? x = null`",
        )
        return errorType()
    }
    if isVoid(t) {
        report(ref b, through: ref c, for: .voidValue, at: parser.exprSpan(in syntax), by: ("", "", "", "", ""))
        return errorType()
    }
    return prim(.neverKind) if isNever(t)
    return t
}

/// `while let x = e { … }` is `while (e is { } x) { … }`.
BStmt bindWhileLet(ref Binder b, through ref Ctx c, for in parser.WhileLetStmt w, to JumpTarget target) {
    pushScope(ref b)
    let value = bindExpr(ref b, through: ref c, for: in w.value)
    let valType = exprType(in c, for: value)
    if kindOf(valType) != .optional && !isError(valType) {
        report(
            ref b,
            through: ref c,
            for: .whileLetNotOptional,
            at: parser.exprSpan(in w.value),
            by: (typeDisplay(ref c, by: valType), "", "", "", ""),
            help: $"loop with `while` and a condition, or bind it once: `let {t15Text(in c, from: b.file, at: w.variable)} = …`",
        )
    }
    let cond = recordNodeSyntax(ref c, for: addIs(ref c, from: BIs {
        span: w.span,
        value: value,
        pattern: bindPresent(ref b, through: ref c, at: w.variable, as: valType),
    }), as: .whileLetStmt, at: w.span)
    b.targets.append(target)
    let body = bindBody(ref b, through: ref c, for: in w.body)
    b.targets.remove(at: b.targets.length - 1)
    popScope(ref b)
    return recordNodeSyntax(ref c, for: addWhile(ref c, from: BWhile {
        span: w.span,
        condition: cond,
        body: body,
        target: target.id,
    }), as: .whileLetStmt, at: w.span)
}

/// Whether `e` reads existing storage, through any arm, conversion, field or index, rather than a temporary the loop owns.
bool isBorrowedPlace(ref Ctx c, for BExpr e) {
    switch boundKind(e) {
        case .local or .thisRef or .staticArray:
            return true
        case .builtinCall:
            let member = c.bBuiltinCalls[boundIndex(e)].member
            return true if member == .ownedValue
            return isBorrowedPlace(ref c, for: c.bBuiltinCalls[boundIndex(e)].receiver) if member is .mapIndex
                or .resultValue
                or .mapTryGet
                or .listTryGet
            return false
        case .field:
            return isBorrowedPlace(ref c, for: c.bFields[boundIndex(e)].receiver)
        case .tupleElement:
            return isBorrowedPlace(ref c, for: c.bTupleElements[boundIndex(e)].receiver)
        case .index:
            // A span points into existing storage, wherever the span itself came from.
            let target = c.bIndexes[boundIndex(e)].target
            return true if kindOf(exprType(in c, for: target)) == .span
            return isBorrowedPlace(ref c, for: target)
        case .conversion:
            return isBorrowedPlace(ref c, for: c.bConversions[boundIndex(e)].operand)
        case .conditional:
            let cd = c.bConditionals[boundIndex(e)]
            return isBorrowedPlace(ref c, for: cd.whenTrue) || isBorrowedPlace(ref c, for: cd.whenFalse)
        case .coalesce:
            let cl = c.bCoalesces[boundIndex(e)]
            return isBorrowedPlace(ref c, for: cl.left) || isBorrowedPlace(ref c, for: cl.right)
        case .switchExpr:
            var values = List<BExpr>()
            for arm in c.bSwitchExprs[boundIndex(e)].arms {
                values.append(arm.value)
            }
            for v in values {
                return true if isBorrowedPlace(ref c, for: v)
            }
            return false
        case .withExpr:
            // A `with` copies only the fields it does not replace.
            let target = c.bWiths[boundIndex(e)].target
            return false if kindOf(exprType(in c, for: target)) != .structType
            return false if !isBorrowedPlace(ref c, for: target)
            var updated = List<FieldId>()
            for u in c.bWiths[boundIndex(e)].updates {
                updated.append(u.field)
            }
            var fields = List<FieldId>()
            for f in c.structs[typeIndex(exprType(in c, for: target))].fields {
                fields.append(f)
            }
            for f in fields {
                var replaced = false
                for u in updated {
                    if u == f {
                        replaced = true
                    }
                }
                return true if !replaced && isUnique(ref c, for: c.fields[f].type)
            }
            return false
        case .tryExpr:
            return isBorrowedPlace(ref c, for: c.bTries[boundIndex(e)].operand)
        case .catchExpr:
            let ct = c.bCatches[boundIndex(e)]
            return isBorrowedPlace(ref c, for: ct.operand) || isBorrowedPlace(ref c, for: ct.handler)
        default:
            return false
    }
}

/// The pattern `{ } x`: on an optional, matches a present value and binds it unwrapped. `discard`: `name` is a tuple
/// `for try` variable's group, the C# parser's `_` (`declareDiscard`).
BPattern bindPresent(ref Binder b, through ref Ctx c, at TextSpan name, as Type input, bool discard = false) {
    let local = discard ? declareDiscard(
        ref b,
        through: ref c,
        at: name,
        as: unwrap(ref c, for: input),
        for: .patternVariable,
    ) : declareLocal(ref b, through: ref c, at: name, as: unwrap(ref c, for: input), for: .patternVariable)
    c.locals[local].borrowsSubject = true
    return recordNodeSyntax(ref c, for: addPropertyPattern(ref c, from: BPropertyPattern {
        span: name,
        inputType: input,
        valueType: unwrap(ref c, for: input),
        subpatterns: List<BSubpattern>(),
        designation: local,
    }), as: .name, at: name)
}

BStmt bindFor(ref Binder b, through ref Ctx c, for in parser.ForStmt f, to JumpTarget target) {
    pushScope(ref b)
    let iterable = bindExpr(ref b, through: ref c, for: in f.iterable)
    return bindForTry(ref b, through: ref c, for: in f, by: iterable, to: target) if f.tryKeyword
    var user: UserIteration? = null
    let itType = exprType(in c, for: iterable)
    var element = userElement(ref b, through: ref c, for: in f, by: iterable, to: ref user)
    if element == -1 {
        switch kindOf(itType) {
            case .range:
                element = c.rangeTypes[typeIndex(itType)]
            case .span:
                element = c.spanTypes[typeIndex(itType)].element
            case .list:
                element = c.listTypes[typeIndex(itType)]
            case .map:
                element = mapEntry(ref c, by: itType)
            case .array:
                element = c.arrayTypes[typeIndex(itType)].element
            case .textView:
                element = textViewElement(textViewKindOf(typeIndex(itType)))
            case .error:
                element = errorType()
            default:
                element = isString(itType) ? prim(.char) : notIterable(ref b, through: ref c, for: in f, as: itType)
        }
    }
    element = declaredElement(ref b, through: ref c, for: in f, as: element)
    // A writable `dyn ref` element borrows the array or list slot, so the loop mutates the iterable; a temporary is the loop's own.
    let writableRef = kindOf(element) == .dynRef && !c.dynRefTypes[typeIndex(element)].readOnly
    if writableRef && (kindOf(itType) == .list || kindOf(itType) == .array) && isBorrowedPlace(ref c, for: iterable) {
        let _ = checkWritable(
            ref b,
            through: ref c,
            for: iterable,
            at: parser.exprSpan(in f.iterable),
            by: $"it is borrowed element by element as `{typeDisplay(ref c, by: element)}`",
        )
    }
    // Through a `ReadOnlySpan` it would write elements the span may not change.
    if writableRef && kindOf(itType) == .span && c.spanTypes[typeIndex(itType)].readOnly {
        report(
            ref b,
            through: ref c,
            for: .mutateTemporary,
            at: parser.exprSpan(in f.iterable),
            by: ("", "", "", "", ""),
            label: "a `ReadOnlySpan` cannot be written through",
        )
    }
    // coverage-exempt: Q882
    let kind: LocalKind = f.kind == .varKeyword ? .varKeyword : .forVariable
    let variable = f.names.length > 0 ? declareDiscard(
        ref b,
        through: ref c,
        at: f.variable,
        as: element,
        for: kind,
    ) : declareLocal(ref b, through: ref c, at: f.variable, as: element, for: kind)
    c.locals[variable].borrowsSubject = true
    let body = bindForBody(ref b, through: ref c, for: in f, by: variable, to: target)
    popScope(ref b)
    return recordNodeSyntax(ref c, for: addFor(ref c, from: BFor {
        span: f.span,
        variable: variable,
        iterable: iterable,
        body: body,
        target: target.id,
        userIteration: user,
    }), as: .forStmt, at: f.span)
}
== semantics/binder3.byn
// T36: Binder.cs ~980-1468 (for bodies/iterators, return/fail, defer, context, switch statement).

import parser

type T28MemberExpr = parser.MemberExpr
type T28CallExpr   = parser.CallExpr
type T28TryExpr    = parser.TryExpr
type T28ParenExpr  = parser.ParenExpr

// ── Binder.cs:987 UserElement ────────────────────────────────────────────────

/// The `Item` of a struct conforming to `IIndexable` (preferred) or `IEnumerator`, with how the loop walks it in
/// `user`; -1 (C# null) when it conforms to neither. A named enumerator must be writable, since the loop calls
/// `moveNext(ref this)` on it; a temporary one is spilled to a hidden `var`.
Type userElement(
    ref Binder b,
    through ref Ctx c,
    for in parser.ForStmt f,
    by BExpr iterable,
    to ref UserIteration? user
) {
    let itType = exprType(in c, for: iterable)
    let iIndexable = findInterface(ref c, for: "IIndexable")
    let iEnumerator = findInterface(ref c, for: "IEnumerator")
    // Inside a generic body the loop is checked against the constraint; each instance rebinds it to the conformer's members.
    if kindOf(itType) == .typeParam {
        let tp = typeIndex(itType)
        var constraint: InterfaceId = -1
        for i in c.typeParams[tp].constraints {
            if i == iIndexable && constraint == -1 {
                constraint = i
            }
        }
        if constraint == -1 {
            for i in c.typeParams[tp].constraints {
                if i == iEnumerator && constraint == -1 {
                    constraint = i
                }
            }
        }
        return -1 if constraint == -1
        let k = boundKind(iterable)
        if constraint == iEnumerator && (k is .local or .thisRef or .field or .tupleElement or .index) {
            c.mutationChecks.append(
                MutationCheck {
                    source: b.file,
                    function: host(b, through: c),
                    callee: findInterfaceMethods(ref c, by: constraint, for: "moveNext")[0],
                    receiver: iterable,
                },
            )
        }
        return typeParamTypeOf(associatedType(ref c, for: tp, by: "Item"))
    }
    return -1 if kindOf(itType) != .structType
    let s = typeIndex(itType)
    var conf: ConformanceId = -1
    for k in c.structs[s].conformances {
        if c.conformances[k].iface == iIndexable && conf == -1 {
            conf = k
        }
    }
    if conf == -1 {
        for k in c.structs[s].conformances {
            if c.conformances[k].iface == iEnumerator && conf == -1 {
                conf = k
            }
        }
    }
    return -1 if conf == -1
    let iface = c.conformances[conf].iface
    let indexable = iface == iIndexable
    let advance = indexable ? findInterfaceProperty(
        ref c,
        by: iface,
        for: "count",
    ) : findInterfaceMethods(ref c, by: iface, for: "moveNext")[0]
    let item = indexable ? findInterfaceMethods(
        ref c,
        by: iface,
        for: "get",
    )[0] : findInterfaceProperty(ref c, by: iface, for: "current")
    // A missing member or `Item` is reported by the conformance check.
    let element = c.conformances[conf].associatedTypes.tryGet(at: "Item") ?? errorType()
    return errorType() if isError(element)
    let advanceWitness = witness(ref c, for: conf, by: advance)
    return errorType() if advanceWitness.fn == -1 && advanceWitness.field == -1
    let itemWitness = witness(ref c, for: conf, by: item)
    return errorType() if itemWitness.fn == -1 && itemWitness.field == -1
    if isUnique(ref c, for: element) {
        let name = c.structs[s].name
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: parser.exprSpan(in f.iterable),
            by: ($"a `for` over the unique `Item` `{typeDisplay(ref c, by: element)}` of `{name}`", "", "", "", ""),
            help: $"make `{name}.Item` a value that is not unique, such as an index, and look the item up in the loop",
        )
        return errorType()
    }
    var spill: LocalId = -1
    if !indexable {
        let k = boundKind(iterable)
        if k is .local or .thisRef or .field or .tupleElement or .index {
            c.mutationChecks.append(
                MutationCheck { source: b.file, function: host(b, through: c), callee: advance, receiver: iterable },
            )
        } else {
            let span = parser.exprSpan(in f.iterable)
            spill = newLocal(
                ref c,
                by: LocalSymbol {
                    name: $"enumerator_{b.nextLocalId}",
                    nameSpan: span,
                    span: span,
                    type: itType,
                    kind: .varKeyword,
                    id: b.nextLocalId,
                },
            )
            b.nextLocalId += 1
            if b.fn >= 0 {
                c.functions[b.fn].locals.append(spill)
            }
        }
    }
    user = UserIteration {
        kind: indexable ? .indexable : .enumerator,
        advance: advanceWitness.fn,
        item: itemWitness.fn,
        spill: spill,
        advanceField: advanceWitness.field,
        itemField: itemWitness.field,
    }
    return element
}

/// Binder.cs:1030 Witness: the struct's member standing for `member`, a function or (for a getter) a field; both -1 for none.
(FuncId fn, FieldId field) witness(ref Ctx c, for ConformanceId conf, by FuncId member) {
    if (c.conformances[conf].witnesses.tryGet(at: member) is { } fn) {
        return (fn: fn, field: -1)
    }
    return (fn: -1, field: c.conformances[conf].fieldWitnesses.tryGet(at: member) ?? -1)
}

// ── Binder.cs:1034 DeclaredElement ───────────────────────────────────────────

/// The element type, or the type written in `for T x in e` when the element converts to it.
Type declaredElement(ref Binder b, through ref Ctx c, for in parser.ForStmt f, as Type element) {
    return element if f.type is .none
    var result = element
    let declared = resolveType(ref b, through: ref c, for: in f.type)
    if !isError(declared)
            && !isError(element)
            && declared != element
            && implicit(ref c, from: element, to: declared) is null {
        report(
            ref b,
            through: ref c,
            for: .typeMismatch,
            at: parser.typeSpan(in f.type),
            by: (typeDisplay(ref c, by: element), typeDisplay(ref c, by: declared), "", "", ""),
        )
    } else if !isError(declared) {
        result = declared
    }
    return result
}

// ── Binder.cs:1045 BindForBody ───────────────────────────────────────────────

/// The loop body; for `for (k, v) in e`, preceded by one binding per element of the tuple `variable`.
BStmt bindForBody(ref Binder b, through ref Ctx c, for in parser.ForStmt f, by LocalId variable, to JumpTarget target) {
    var prelude = List<BStmt>()
    if f.names.length > 0 {
        let vt = c.locals[variable].type
        if kindOf(vt) == .tuple && c.tupleTypes[typeIndex(vt)].length == f.names.length {
            for i in 0..f.names.length {
                let name = f.names[i]
                let element = declareLocal(
                    ref b,
                    through: ref c,
                    at: name,
                    as: c.tupleTypes[typeIndex(vt)][i].type,
                    for: .forVariable,
                )
                c.locals[element].borrowsSubject = true
                let receiver = recordNodeSyntax(
                    ref c,
                    for: addLocal(ref c, from: BLocal { span: name, local: variable, type: c.locals[variable].type }),
                    as: .name,
                    at: name,
                )
                let value = recordNodeSyntax(
                    ref c,
                    for: addTupleElement(
                        ref c,
                        from: BTupleElement { span: name, receiver: receiver, index: i, type: c.locals[element].type },
                    ),
                    as: .name,
                    at: name,
                )
                prelude.append(
                    recordNodeSyntax(
                        ref c,
                        for: addLocalDecl(ref c, from: BLocalDecl { span: name, local: element, initializer: value }),
                        as: .name,
                        at: name,
                    ),
                )
            }
        } else {
            if !isError(vt) {
                report(
                    ref b,
                    through: ref c,
                    for: .patternMismatch,
                    at: f.variable,
                    by: ($"{f.names.length} names", typeDisplay(ref c, by: vt), "", "", ""),
                    help: "name one loop variable, or iterate over pairs such as a map's entries",
                )
            }
            for name in f.names {
                let _ = declareLocal(ref b, through: ref c, at: name, as: errorType(), for: .forVariable)
            }
        }
    }
    b.targets.append(target)
    let body = bindBody(ref b, through: ref c, for: in f.body)
    b.targets.remove(at: b.targets.length - 1)
    return body if prelude.length == 0
    prelude.append(body)
    return recordStmtSyntax(
        ref c,
        for: addBlock(ref c, from: BBlock { span: parser.stmtSpan(in f.body), statements: move prelude }),
        from: in f.body,
    )
}

// ── Binder.cs:1078 BindForTry ────────────────────────────────────────────────

/// `for try x in e { … }` over a value whose `next()` returns `T?` and fails: the loop owns the value (or borrows a
/// `var` in place) and runs `while (try seq.next() is { } x) { … }`, so a failing step propagates like any `try`.
BStmt bindForTry(ref Binder b, through ref Ctx c, for in parser.ForStmt f, by BExpr iterable, to JumpTarget target) {
    let itType = exprType(in c, for: iterable)
    if fallibleNext(ref c, for: itType) == -1 {
        if !isError(itType) {
            report(
                ref b,
                through: ref c,
                for: .notIterable,
                at: parser.exprSpan(in f.iterable),
                by: (typeDisplay(ref c, by: itType), "", "", "", ""),
                help: "give `for try` a value with a failing `next()` that returns `T?`; write `for x in …` for a sequence that cannot fail",
            )
        }
        if f.names.length > 0 {
            for name in f.names {
                let _ = declareLocal(ref b, through: ref c, at: name, as: errorType(), for: .forVariable)
            }
        } else {
            let _ = declareLocal(ref b, through: ref c, at: f.variable, as: errorType(), for: .forVariable)
        }
        let _ = bindBody(ref b, through: ref c, for: in f.body)
        popScope(ref b)
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
            as: .forStmt,
            at: f.span,
        )
    }
    let span = parser.exprSpan(in f.iterable)
    // A `var` (or `ref` parameter) is stepped in place, so its state advances; any other value is stepped in a hidden copy.
    let inPlace = boundKind(iterable) == .local
        && (localIsMutable(ref c, by: c.bLocals[boundIndex(iterable)].local)
            || paramIsByRef(ref c, by: c.bLocals[boundIndex(iterable)].local))
    var sequence: LocalId = -1
    if !inPlace {
        sequence = declareLocal(
            ref b,
            through: ref c,
            at: t28SyntheticName(ref c, for: $"<sequence {b.nextLocalId}>", at: span),
            as: itType,
            for: .temp,
        )
        // C# `new Location(Source, name.Span)`: the synthetic name stands at the iterable.
        c.locals[sequence].nameSpan = span
        c.locals[sequence].span = span
    }
    // f.Iterable cannot be copied out of its Owned tree (Q471), so the in-place receiver is rebuilt from its spans (Q679).
    let sequenceName = sequence == -1 ? "" : c.locals[sequence].name
    let receiver = sequence == -1 ? t28CloneLocalName(in f.iterable)
        : parser.Expr.nameExpr(
            Owned(
                NameExpr {
                    span: span,
                    name: t28SyntheticName(ref c, for: sequenceName, at: span),
                    typeArgs: List<parser.TypeSyntax>(),
                },
            ),
        )
    let member = parser.Expr.memberExpr(
        Owned(
            T28MemberExpr {
                span: span,
                target: move receiver,
                member: t28SyntheticName(ref c, for: "next", at: span),
                nullConditional: false,
            },
        ),
    )
    let call = parser.Expr.callExpr(
        Owned(T28CallExpr { span: span, callee: move member, args: List<parser.Argument>() }),
    )
    let next = parser.Expr.tryExpr(Owned(T28TryExpr { span: span, operand: move call }))
    let step = bindExpr(ref b, through: ref c, for: in next)
    let stepType = exprType(in c, for: step)
    if !(f.type is .none) {
        let declared = resolveType(ref b, through: ref c, for: in f.type)
        if !isError(declared) && !isError(unwrap(ref c, for: stepType)) && declared != unwrap(ref c, for: stepType) {
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: parser.typeSpan(in f.type),
                by: (
                    typeDisplay(ref c, by: unwrap(ref c, for: stepType)),
                    typeDisplay(ref c, by: declared),
                    "",
                    "",
                    ""
                ),
            )
        }
    }
    let pattern = bindPresent(ref b, through: ref c, at: f.variable, as: stepType, discard: f.names.length > 0)
    let body = bindForBody(
        ref b,
        through: ref c,
        for: in f,
        by: c.bPropertyPatterns[boundIndex(pattern)].designation,
        to: target,
    )
    popScope(ref b)
    let loop = recordNodeSyntax(ref c, for: addWhile(ref c, from: BWhile {
        span: f.span,
        condition: recordNodeSyntax(
            ref c,
            for: addIs(ref c, from: BIs { span: f.span, value: step, pattern: pattern }),
            as: .forStmt,
            at: f.span,
        ),
        body: body,
        target: target.id,
    }), as: .forStmt, at: f.span)
    return loop if sequence == -1
    var statements = List<BStmt>()
    statements.append(
        recordNodeSyntax(
            ref c,
            for: addLocalDecl(ref c, from: BLocalDecl { span: f.span, local: sequence, initializer: iterable }),
            as: .forStmt,
            at: f.span,
        ),
    )
    statements.append(loop)
    return recordNodeSyntax(
        ref c,
        for: addBlock(ref c, from: BBlock { span: f.span, statements: move statements }),
        as: .forStmt,
        at: f.span,
    )
}

/// A name the C# synthesizes for `for try` (`<sequence N>`, `next`): its text is not in the source, so it gets its own
/// span, `start` -1 - index into `c.syntheticNames`, which `t15Text` and `t18Text` read (Q679); `at` is the C# span
/// (`f.Iterable.Span`), kept in `c.syntheticSpans` for `addDiag` to report at (Q739).
TextSpan t28SyntheticName(ref Ctx c, for string text, at TextSpan span) {
    c.syntheticNames.append(text)
    c.syntheticSpans.append(span)
    return TextSpan { start: -c.syntheticNames.length, length: 0 }
}

/// The in-place receiver: a local bound from a name, possibly parenthesized (Q679).
parser.Expr t28CloneLocalName(in parser.Expr e) {
    switch e {
        case .nameExpr(let n):
            return parser.Expr.nameExpr(
                Owned(NameExpr { span: n.value.span, name: n.value.name, typeArgs: List<parser.TypeSyntax>() }),
            )
        case .parenExpr(let p):
            return parser.Expr.parenExpr(
                Owned(T28ParenExpr { span: p.value.span, inner: t28CloneLocalName(in p.value.inner) }),
            )
        default:
            panic("internal error: an in-place `for try` iterable is a local")
    }
}

/// Binder.cs:1107 FallibleNext: the `T? next() fails …` method that `for try` steps with, if `type` has one; -1 for none.
FuncId fallibleNext(ref Ctx c, for Type type) {
    return -1 if kindOf(type) != .structType
    for m in c.structs[typeIndex(type)].methods {
        if c.functions[m].name == "next"
                && !c.functions[m].isStatic
                && c.functions[m].hasFails
                && c.functions[m].parameters.length == 0
                && kindOf(c.functions[m].returnType) == .optional {
            return m
        }
    }
    return -1
}

// ── Binder.cs:1112 NotIterable ───────────────────────────────────────────────

Type notIterable(ref Binder b, through ref Ctx c, for in parser.ForStmt f, as Type type) {
    if fallibleNext(ref c, for: type) == -1 {
        report(
            ref b,
            through: ref c,
            for: .notIterable,
            at: parser.exprSpan(in f.iterable),
            by: (typeDisplay(ref c, by: type), "", "", "", ""),
            help: "use `for` over ranges (`0..n`), spans, lists, arrays, strings, or a type conforming to `IIndexable` or `IEnumerator`",
        )
    } else {
        report(
            ref b,
            through: ref c,
            for: .notIterable,
            at: parser.exprSpan(in f.iterable),
            by: (typeDisplay(ref c, by: type), "", "", "", ""),
            label: "each step can fail",
            help: "write `for try`",
            hasFix: true,
            fixSpan: TextSpan { start: f.span.start + "for".length, length: 0 },
            fixReplacement: " try",
        )
    }
    return errorType()
}

// ── Binder.cs:1123 BindReturn ────────────────────────────────────────────────

BStmt bindReturn(ref Binder b, through ref Ctx c, for in parser.ReturnStmt r) {
    return recordReturnSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: r.span }),
        from: in r,
    ) if inPanicHandler(ref b, through: ref c, at: r.span, for: "return")
    if b.deferDepth > 0 {
        report(ref b, through: ref c, for: .jumpOutOfDefer, at: r.span, by: ("return", "", "", "", ""))
        return recordReturnSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: r.span }), from: in r)
    }
    let fn = b.fn
    return recordReturnSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: r.span }),
        from: in r,
    ) if fn == -1
    let returnType = c.functions[fn].returnType
    if r.value is .none {
        if !isVoid(returnType) && !isError(returnType) {
            report(
                ref b,
                through: ref c,
                for: .missingReturnValue,
                at: r.span,
                by: (typeDisplay(ref c, by: returnType), "", "", "", ""),
            )
        }
        return recordReturnSyntax(ref c, for: addReturn(ref c, from: BReturn { span: r.span }), from: in r)
    }
    if c.functions[fn].hasFails {
        let failure = tryBindFailure(ref b, through: ref c, for: in r.value)
        if failure != -1 {
            // `return` always returns a value; an error leaves with `fail` (BYN1056).
            if boundKind(failure) == .errorVariant {
                let name = c.errorVariants[c.bErrorVariants[boundIndex(failure)].variant].name
                let keyword = TextSpan { start: r.span.start, length: "return".length }
                report(
                    ref b,
                    through: ref c,
                    for: .returnErrorInput,
                    at: keyword,
                    by: (name, "", "", "", ""),
                    label: "this leaves with an error",
                    help: $"leave with the error: `fail .{name}`",
                    hasFix: true,
                    fixSpan: keyword,
                    fixReplacement: "fail",
                )
            }
            return recordReturnSyntax(
                ref c,
                for: addFail(ref c, from: BFail { span: r.span, error: failure }),
                from: in r,
            )
        }
    }
    if isVoid(returnType) {
        let v = bindExpr(ref b, through: ref c, for: in r.value)
        return recordReturnSyntax(
            ref c,
            for: addExprStmt(ref c, from: BExprStmt { span: r.span, expr: v }),
            from: in r,
        ) if isNever(exprType(in c, for: v))
        if !isError(exprType(in c, for: v)) {
            let isMain = c.functions[fn].kind == .main
            report(
                ref b,
                through: ref c,
                for: .returnValueInVoid,
                at: parser.exprSpan(in r.value),
                by: (isMain ? "main" : c.functions[fn].name, "", "", "", ""),
                help: isMain ? "" : "declare a return type instead of `void`, or remove the value",
            )
        }
        return recordReturnSyntax(ref c, for: addReturn(ref c, from: BReturn { span: r.span }), from: in r)
    }
    return recordReturnSyntax(
        ref c,
        for: addReturn(
            ref c,
            from: BReturn {
                span: r.span,
                value: bindConverted(ref b, through: ref c, for: in r.value, to: returnType),
            },
        ),
        from: in r,
    )
}

// ── Binder.cs:1164 TryBindFailure ────────────────────────────────────────────

/// In a failing function, `return .variant` or `return Set.variant` fails with that error; -1 (C# null) otherwise.
BExpr tryBindFailure(ref Binder b, through ref Ctx c, for in parser.Expr value) {
    let fn = b.fn
    let returnType = c.functions[fn].returnType
    switch value {
        case .targetMemberExpr(let t):
            let name = t15Text(in c, from: b.file, at: t.value.member)
            return -1 if kindOf(returnType) == .errorSet || hasCase(ref c, for: returnType, by: name)
            let sets = copyIds(in c.functions[fn].errorSets)
            let matches = errorMatches(ref c, for: in sets, by: name)
            if matches.length == 1 {
                checkNotExcluded(ref b, through: ref c, for: matches[0], at: t.value.span)
                return recordSyntaxNode(
                    ref c,
                    for: addErrorVariant(ref c, from: BErrorVariant { span: t.value.span, variant: matches[0] }),
                    at: syntaxLeaf(ref c, as: .targetMemberExpr, at: t.value.span),
                )
            }
            if matches.length > 1 {
                report(
                    ref b,
                    through: ref c,
                    for: .ambiguousVariant,
                    at: t.value.span,
                    by: (name, matchedSets(ref c, for: in matches), "", "", ""),
                )
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: t.value.span }),
                    at: syntaxLeaf(ref c, as: .targetMemberExpr, at: t.value.span),
                )
            }
            if c.functions[fn].infersErrors && c.functions[fn].errorSets.length == 0 && isVoid(returnType) {
                report(
                    ref b,
                    through: ref c,
                    for: .unknownVariant,
                    at: t.value.span,
                    by: (name, "the inferred error set", "", "", ""),
                    help: "name the set: `fail MyError.x`",
                )
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: t.value.span }),
                    at: syntaxLeaf(ref c, as: .targetMemberExpr, at: t.value.span),
                )
            }
            return -1
        case .memberExpr(let m):
            return -1 if kindOf(returnType) == .errorSet
            let bound = bindExprOrType(ref b, through: ref c, for: in value)
            if boundKind(bound) == .errorVariant {
                let variant = c.bErrorVariants[boundIndex(bound)].variant
                checkCanFailWith(ref b, through: ref c, for: c.errorVariants[variant].set, at: m.value.span)
                checkNotExcluded(ref b, through: ref c, for: variant, at: m.value.span)
                return bound
            }
            return -1
        default:
            return -1
    }
}

/// Binder.cs:1207 HasCase: whether `.name` is a value of `type`, so `return .name` returns it.
bool hasCase(ref Ctx c, for Type type, by string name) {
    let t = kindOf(type) == .optional ? c.optionalTypes[typeIndex(type)] : type
    return findEnumMember(ref c, by: typeIndex(t), for: name) != -1 if kindOf(t) == .enumType
    return findUnionVariant(ref c, by: typeIndex(t), for: name) != -1 if kindOf(t) == .unionType
    return false
}

/// The C# `fn.ErrorSets.Select(s => s.Find(name)).Where(v => v is not null)`.
List<VariantId> errorMatches(ref Ctx c, for in List<ErrorSetId> sets, by string name) {
    var matches = List<VariantId>()
    for s in sets {
        let v = findErrorVariant(ref c, by: s, for: name)
        if v != -1 {
            matches.append(v)
        }
    }
    return matches
}

/// The C# `string.Join("`, `", matches.Select(m => m!.Set.DisplayName))`.
string matchedSets(ref Ctx c, for in List<VariantId> matches) {
    var sb = StrBuf()
    for i in 0..matches.length {
        if i > 0 {
            sb.append("`, `")
        }
        sb.append(errorSetDisplayName(ref c, by: c.errorVariants[matches[i]].set))
    }
    return $"{sb.finish()}"
}

// ── Binder.cs:1215 BindFail ──────────────────────────────────────────────────

/// `fail .x`, `fail Set.x` or `fail e`: leaves the function with the error.
BStmt bindFail(ref Binder b, through ref Ctx c, for in parser.FailStmt f) {
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
        as: .failStmt,
        at: f.span,
    ) if inPanicHandler(ref b, through: ref c, at: f.span, for: "fail")
    if b.deferDepth > 0 {
        report(ref b, through: ref c, for: .jumpOutOfDefer, at: f.span, by: ("fail", "", "", "", ""))
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
            as: .failStmt,
            at: f.span,
        )
    }
    let fn = b.fn
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
        as: .failStmt,
        at: f.span,
    ) if fn == -1
    let entry = c.functions[fn].kind is .main or .testKeyword
    // `(call?.Callee ?? f.Error) is TargetMemberExpr t`: its span and member, or null.
    var isCall = false
    var targetSpan: TextSpan? = null
    var member = TextSpan { start: 0, length: 0 }
    switch f.error {
        case .callExpr(let call):
            isCall = true
            switch call.value.callee {
                case .targetMemberExpr(let t):
                    targetSpan = t.value.span
                    member = t.value.member
                default:
            }
        case .targetMemberExpr(let t):
            targetSpan = t.value.span
            member = t.value.member
        default:
    }
    let errorSpan = parser.exprSpan(in f.error)
    if !c.functions[fn].hasFails && !entry {
        let named = targetSpan is not null ? $".{t15Text(in c, from: b.file, at: member)}"
            : typeDisplay(ref c, by: exprType(in c, for: bindExprOrType(ref b, through: ref c, for: in f.error)))
        report(
            ref b,
            through: ref c,
            for: .propagateFromInfallible,
            at: errorSpan,
            by: (c.functions[fn].name, named, "", "", ""),
            help: "declare the error in a `fails` clause, or handle it here",
        )
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
            as: .failStmt,
            at: f.span,
        )
    }
    if (targetSpan is { } tSpan) {
        let name = t15Text(in c, from: b.file, at: member)
        let sets = copyIds(in c.functions[fn].errorSets)
        let matches = errorMatches(ref c, for: in sets, by: name)
        if matches.length == 1 {
            if !entry {
                checkNotExcluded(ref b, through: ref c, for: matches[0], at: tSpan)
            }
            let variant = recordSyntaxNode(
                ref c,
                for: addErrorVariant(ref c, from: BErrorVariant { span: tSpan, variant: matches[0] }),
                at: syntaxLeaf(ref c, as: .targetMemberExpr, at: tSpan),
            )
            switch f.error {
                case .callExpr(let call):
                    let built = bindPayload(ref b, through: ref c, for: in call.value, by: variant)
                    return recordNodeSyntax(
                        ref c,
                        for: addFail(ref c, from: BFail { span: f.span, error: built }),
                        as: .failStmt,
                        at: f.span,
                    ) if boundKind(built) == .errorVariant
                    return recordNodeSyntax(
                        ref c,
                        for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
                        as: .failStmt,
                        at: f.span,
                    )
                default:
            }
            return recordNodeSyntax(
                ref c,
                for: addFail(ref c, from: BFail { span: f.span, error: variant }),
                as: .failStmt,
                at: f.span,
            ) if checkPayloadGiven(ref b, through: ref c, for: variant, from: in f.error)
            return recordNodeSyntax(
                ref c,
                for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
                as: .failStmt,
                at: f.span,
            )
        }
        switch f.error {
            case .callExpr(let call): bindArgumentsForRecovery(ref b, through: ref c, for: in call.value)
            default:
        }
        if matches.length > 1 {
            report(
                ref b,
                through: ref c,
                for: .ambiguousVariant,
                at: tSpan,
                by: (name, matchedSets(ref c, for: in matches), "", "", ""),
            )
        } else if c.functions[fn].errorSets.length == 0 {
            report(
                ref b,
                through: ref c,
                for: .unknownVariant,
                at: tSpan,
                by: (name, "the inferred error set", "", "", ""),
                help: "name the set: `fail MyError.x`",
            )
        } else {
            let none = List<VariantId>()
            let declared = errorUnionOf(ref c, for: in sets, as: in none)
            report(
                ref b,
                through: ref c,
                for: .undeclaredError,
                at: tSpan,
                by: ($".{name}", c.functions[fn].name, "", "", ""),
                help: $"name a case of `{typeDisplay(ref c, by: declared)}`",
            )
        }
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
            as: .failStmt,
            at: f.span,
        )
    }
    let error = bindExprOrType(ref b, through: ref c, for: in f.error)
    let errorType = exprType(in c, for: error)
    var sets = List<ErrorSetId>()
    if kindOf(errorType) == .errorSet {
        sets.append(typeIndex(errorType))
    } else if kindOf(errorType) == .errorUnion {
        sets = copyIds(in c.errorUnionTypes[typeIndex(errorType)].sets)
    } else {
        if !isError(errorType) {
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: errorSpan,
                by: (typeDisplay(ref c, by: errorType), "an error", "", "", ""),
            )
        }
        return recordNodeSyntax(
            ref c,
            for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
            as: .failStmt,
            at: f.span,
        )
    }
    if !entry {
        for set in sets {
            checkCanFailWith(ref b, through: ref c, for: set, at: errorSpan)
        }
    }
    if !entry && boundKind(error) == .errorVariant {
        checkNotExcluded(ref b, through: ref c, for: c.bErrorVariants[boundIndex(error)].variant, at: errorSpan)
    }
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: f.span }),
        as: .failStmt,
        at: f.span,
    ) if !isCall
        && !checkPayloadGiven(ref b, through: ref c, for: error, from: in f.error)
    return recordNodeSyntax(
        ref c,
        for: addFail(ref c, from: BFail { span: f.span, error: error }),
        as: .failStmt,
        at: f.span,
    )
}

/// Binder.cs:1274 CheckCanFailWith: BYN2603 for a set the `fails` clause does not name (unless it is inferred).
void checkCanFailWith(ref Binder b, through ref Ctx c, for ErrorSetId set, at TextSpan span) {
    let fn = b.fn
    for s in c.functions[fn].errorSets {
        return if s == set
    }
    return if c.functions[fn].infersErrors
    var named = copyIds(in c.functions[fn].errorSets)
    named.append(set)
    var sb = StrBuf()
    for i in 0..named.length {
        if i > 0 {
            sb.append(", ")
        }
        sb.append(displayNameAmong(ref c, by: named[i], for: in named))
    }
    report(
        ref b,
        through: ref c,
        for: .undeclaredError,
        at: span,
        by: (displayNameAmong(ref c, by: set, for: in named), c.functions[fn].name, "", "", ""),
        help: $"add it to the signature: `fails {sb.finish()}`",
    )
}

/// Binder.cs:1285 CheckNotExcluded: BYN2603 for a case the `fails` clause takes out with `except`.
void checkNotExcluded(ref Binder b, through ref Ctx c, for VariantId variant, at TextSpan span) {
    var excluded = false
    for v in c.functions[b.fn].excludedErrors {
        if v == variant {
            excluded = true
        }
    }
    return if !excluded
    let name = c.errorVariants[variant].name
    report(
        ref b,
        through: ref c,
        for: .undeclaredError,
        at: span,
        by: (
            $"{errorSetDisplayName(ref c, by: c.errorVariants[variant].set)}.{name}",
            c.functions[b.fn].name,
            "",
            "",
            ""
        ),
        help: $"pick another case, or remove `.{name}` from the `except` list",
    )
}

// ── Binder.cs:1292 FindTarget ────────────────────────────────────────────────

JumpTarget? findTarget(
    ref Binder b,
    through ref Ctx c,
    for TextSpan? label,
    bool loopOnly,
    at TextSpan span,
    by string keyword
) {
    return null if inPanicHandler(ref b, through: ref c, at: span, for: keyword)
    if b.deferDepth > 0 {
        report(ref b, through: ref c, for: .jumpOutOfDefer, at: span, by: (keyword, "", "", "", ""))
        return null
    }
    var i = b.targets.length - 1
    while i >= 0 {
        let t = b.targets[i]
        i -= 1
        if label is not null {
            let text = t15Text(in c, from: b.file, at: label)
            continue if t.label != text
            if loopOnly && !t.isLoop {
                report(ref b, through: ref c, for: .continueSwitch, at: label, by: (text, "", "", "", ""))
                return null
            }
            return t
        }
        return t if !loopOnly || t.isLoop
    }
    if label is not null {
        report(
            ref b,
            through: ref c,
            for: .unknownLabel,
            at: label,
            by: (t15Text(in c, from: b.file, at: label), "", "", "", ""),
        )
    } else {
        report(ref b, through: ref c, for: .jumpOutsideLoop, at: span, by: (keyword, "", "", "", ""))
    }
    return null
}

BStmt bindBreak(ref Binder b, through ref Ctx c, for in parser.BreakStmt s) {
    if (findTarget(ref b, through: ref c, for: s.label, loopOnly: false, at: s.span, by: "break") is { } t) {
        return recordNodeSyntax(
            ref c,
            for: addBreak(ref c, from: BBreak { span: s.span, target: t.id }),
            as: .breakStmt,
            at: s.span,
        )
    }
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: s.span }),
        as: .breakStmt,
        at: s.span,
    )
}

BStmt bindContinue(ref Binder b, through ref Ctx c, for in parser.ContinueStmt s) {
    if (findTarget(ref b, through: ref c, for: s.label, loopOnly: true, at: s.span, by: "continue") is { } t) {
        return recordNodeSyntax(
            ref c,
            for: addContinue(ref c, from: BContinue { span: s.span, target: t.id }),
            as: .continueStmt,
            at: s.span,
        )
    }
    return recordNodeSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: s.span }),
        as: .continueStmt,
        at: s.span,
    )
}

// ── Binder.cs:1328 BindErrdefer ──────────────────────────────────────────────

BStmt bindErrdefer(ref Binder b, through ref Ctx c, for in parser.DeferStmt d) {
    let fn = b.fn
    if !(fn != -1 && c.functions[fn].hasFails) && !(fn != -1 && (c.functions[fn].kind is .main or .testKeyword)) {
        report(
            ref b,
            through: ref c,
            for: .errdeferWithoutFails,
            at: d.span,
            by: ("", "", "", "", ""),
            help: "remove `failing` to run it on every exit, or add a `fails` clause to the function",
        )
    }
    pushScope(ref b)
    var err: LocalId = -1
    if (d.binding is { } name) {
        let none = List<VariantId>()
        let sets = fn == -1 ? List<ErrorSetId>() : copyIds(in c.functions[fn].errorSets)
        let type = fn == -1 ? errorType() : errorUnionOf(ref c, for: in sets, as: in none)
        err = declareLocal(ref b, through: ref c, at: name, as: type, for: .letKeyword)
        c.locals[err].isCatch = true
    }
    b.deferDepth += 1
    let body = bindBody(ref b, through: ref c, for: in d.body)
    b.deferDepth -= 1
    popScope(ref b)
    return recordNodeSyntax(
        ref c,
        for: addErrdefer(ref c, from: BErrdefer { span: d.span, error: err, body: body }),
        as: .deferStmt,
        at: d.span,
    )
}

// ── Binder.cs:1348 BindPanicDefer ────────────────────────────────────────────

/// `defer panicking [(p)] body`: `return`, `break`, `continue` and `try` in the body are BYN2612; T27's panic-handler check checks the rest.
BStmt bindPanicDefer(ref Binder b, through ref Ctx c, for in parser.DeferStmt d) {
    pushScope(ref b)
    var panic: LocalId = -1
    if (d.binding is { } name) {
        panic = declareLocal(ref b, through: ref c, at: name, as: builtinType(.panic), for: .letKeyword)
    }
    let deferDepth = b.deferDepth
    let inHandler = b.inPanicHandler
    b.deferDepth = 0
    b.inPanicHandler = true
    let body = bindBody(ref b, through: ref c, for: in d.body)
    b.deferDepth = deferDepth
    b.inPanicHandler = inHandler
    popScope(ref b)
    return recordNodeSyntax(
        ref c,
        for: addPanicDefer(ref c, from: BPanicDefer { span: d.span, panic: panic, body: body }),
        as: .deferStmt,
        at: d.span,
    )
}

// ── Binder.cs:1364 BindOnPanic ───────────────────────────────────────────────

/// `Panic.handler = f;` with `f` a named `void f(Panic p)`: only as the first statement of the program's entry
/// function, once (BYN2614). Round 2's `Panic.onPanic` is BYN2230 and binds the same way.
BStmt bindOnPanic(ref Binder b, through ref Ctx c, for in parser.AssignStmt a) {
    switch a.target {
        case .memberExpr(let m):
            if t15Text(in c, from: b.file, at: m.value.member) == "onPanic" {
                report(
                    ref b,
                    through: ref c,
                    for: .renamedMember,
                    at: m.value.member,
                    by: ("onPanic", "handler", "", "", ""),
                    label: "the old name",
                    help: "rename it `handler`",
                    hasFix: true,
                    fixSpan: m.value.member,
                    fixReplacement: "handler",
                )
            }
        default:
    }
    let bound = bindExprOrType(ref b, through: ref c, for: in a.value)
    let value = boundKind(bound) == .methodGroup ? bound : asValue(ref b, through: ref c, for: bound, from: in a.value)
    var handler: FuncId = -1
    let isGroup = boundKind(value) == .methodGroup
    let g = isGroup ? c.bMethodGroups[boundIndex(value)].function : -1
    if isGroup
            && c.bMethodGroups[boundIndex(value)].receiver == -1
            && g != -1
            && c.functions[g].kind == .function
            && !functionIsGeneric(ref c, by: g)
            && !c.functions[g].hasFails && isVoid(c.functions[g].returnType) && c.functions[g].parameters.length == 1
            && c.locals[c.functions[g].parameters[0]].modifier == .none
            && c.locals[c.functions[g].parameters[0]].type == builtinType(.panic) {
        handler = g
    } else if !isError(exprType(in c, for: value)) || isGroup {
        var shown = ""
        if isGroup {
            var sb = StrBuf()
            let ps = copyIds(in c.functions[g].parameters)
            for i in 0..ps.length {
                if i > 0 {
                    sb.append(", ")
                }
                sb.append(typeDisplay(ref c, by: c.locals[ps[i]].type))
            }
            shown = $"{typeDisplay(ref c, by: c.functions[g].returnType)} {c.functions[g].name}({sb.finish()})"
        } else {
            shown = typeDisplay(ref c, by: exprType(in c, for: value))
        }
        report(
            ref b,
            through: ref c,
            for: .typeMismatch,
            at: parser.exprSpan(in a.value),
            by: (shown, "void f(Panic p)", "", "", ""),
            help: "name a function declared `void f(Panic p)`",
        )
    }
    let entry = !c.library && b.fn != -1 && b.fn == c.modules[c.entryModule].main
    // C# `a != _firstStatement`, by file and full span (Q719).
    let first = b.firstStatementFile == b.file
        && b.firstStatementSpan.start == a.span.start
        && b.firstStatementSpan.length == a.span.length
    var misplaced = ""
    if !entry {
        misplaced = c.library ? "libraries cannot set it" : $"`{b.fn == -1 ? "" : c.functions[b.fn].name}` is not the program's entry function"
    } else if b.onPanicSet {
        misplaced = "set again here"
    } else if !first {
        misplaced = "not the first statement of `main`"
    }
    if misplaced != "" {
        report(
            ref b,
            through: ref c,
            for: .onPanicPlacement,
            at: a.span,
            by: ("", "", "", "", ""),
            label: misplaced,
            help: c.library
                ? "set `Panic.handler` in the program that uses this library"
                : "set it once, as the first statement of `main`",
        )
        return recordAssignSyntax(ref c, for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }), from: in a)
    }
    b.onPanicSet = true
    return recordAssignSyntax(
        ref c,
        for: addErrorStmt(ref c, from: BErrorStmt { span: a.span }),
        from: in a,
    ) if handler == -1
    c.onPanic = handler
    return recordAssignSyntax(
        ref c,
        for: addSetOnPanic(ref c, from: BSetOnPanic { span: a.span, handler: handler }),
        from: in a,
    )
}

// ── Binder.cs:1398 InPanicHandler ────────────────────────────────────────────

/// BYN2612 for `keyword` inside a `defer panicking` body; true when reported.
bool inPanicHandler(ref Binder b, through ref Ctx c, at TextSpan span, for string keyword) {
    return false if !b.inPanicHandler
    report(
        ref b,
        through: ref c,
        for: .panicHandlerRestricted,
        at: span,
        by: ($"`{keyword}`", "", "", "", ""),
        help: "remove it; panic handlers can't recover",
    )
    return true
}

// ── Binder.cs:1405 BindContext ───────────────────────────────────────────────

BStmt bindContext(ref Binder b, through ref Ctx c, for in parser.ContextStmt s) {
    var allocator: BExpr = -1
    for v in s.values {
        let name = t15Text(in c, from: b.file, at: v.name)
        // `alloc` is the handler's name; `allocator` is still accepted for it.
        if !(name is "alloc" or "allocator") {
            if name is "net" or "fs" or "clock" or "random" or "env" or "process" or "console" or "log" {
                report(
                    ref b,
                    through: ref c,
                    for: .unsupported,
                    at: v.name,
                    by: ($"the `{name}` handler", "", "", "", ""),
                )
            } else {
                report(
                    ref b,
                    through: ref c,
                    for: .unknownHandler,
                    at: v.name,
                    by: (name, "", "", "", ""),
                    label: name == "suspend" ? "`suspend` has no handler" : "not a handler",
                    help: "choose one of the handler names; `suspend` has no handler",
                )
            }
            continue
        }
        allocator = bindConverted(ref b, through: ref c, for: in v.value, to: builtinType(.arena))
    }
    // Every handler was reported: the body still runs, with the handlers it already has.
    return contextBody(ref b, through: ref c, for: in s) if allocator == -1 && s.values.length > 0
    if allocator == -1 {
        report(ref b, through: ref c, for: .missingArgument, at: s.span, by: ("allocator", "context", "", "", ""))
        allocator = addErrorExpr(ref c, from: BErrorExpr { span: s.span })
    }
    let body = contextBody(ref b, through: ref c, for: in s)
    return recordNodeSyntax(
        ref c,
        for: addContext(ref c, from: BContext { span: s.span, allocator: allocator, body: body }),
        as: .contextStmt,
        at: s.span,
    )
}

/// The C# `BindBlock(c.Body)`: the parser always gives `context` a block body (C# `BlockStmt Body`), so the default is unreachable.
BStmt contextBody(ref Binder b, through ref Ctx c, for in parser.ContextStmt s) {
    switch s.body {
        case .blockStmt(let block): return bindBlock(ref b, through: ref c, for: in block.value)
        default: return -1
    }
}

// ── Binder.cs:1432 BindSwitchStatement ───────────────────────────────────────

BStmt bindSwitchStatement(ref Binder b, through ref Ctx c, for in parser.SwitchStmt s, to JumpTarget target) {
    let subjectResult = bindSwitchSubject(ref b, through: ref c, for: in s.value)
    let value = subjectResult.value
    let owns = subjectResult.owns
    var sections = List<BSwitchSection>()
    b.targets.append(target)
    var sawDefault = false
    for section in s.sections {
        pushScope(ref b)
        var pattern: BPattern = -1
        if section.label.pattern is not .none {
            b.patternOwns = owns
            pattern = bindPattern(ref b, through: ref c, for: in section.label.pattern, as: exprType(in c, for: value))
            b.patternOwns = false
            if owns {
                checkOwningOverlap(ref b, through: ref c, for: pattern)
            }
            if owns && section.label.guard is not .none {
                guardBindings(ref c, for: pattern, at: parser.exprSpan(in section.label.guard))
            }
            if section.label.guard is .none {
                learnArmState(ref b, through: ref c, for: value, by: pattern)
            }
        } else {
            if sawDefault {
                report(ref b, through: ref c, for: .duplicateDefault, at: section.label.span, by: ("", "", "", "", ""))
            }
            sawDefault = true
        }
        let guard = section.label.guard is .none ? -1 : bindCondition(
            ref b,
            through: ref c,
            for: in section.label.guard,
        )
        var body = List<BStmt>()
        for st in section.statements {
            body.append(bindStatement(ref b, through: ref c, for: in st))
        }
        popScope(ref b)
        sections.append(BSwitchSection { span: section.span, pattern: pattern, guard: guard, body: move body })
    }
    b.targets.remove(at: b.targets.length - 1)
    var arms = List<(BPattern, BExpr)>()
    for x in sections {
        arms.append((x.pattern, x.guard))
    }
    let valueType = exprType(in c, for: value)
    var exhaustive = sawDefault
    if !sawDefault {
        let states = kindOf(valueType) == .optional ? -1 : statesUnion(ref c, for: valueType)
        if states != -1 {
            var subjectType = valueType
            if (subject(ref b, through: ref c, for: value) is { } found) {
                subjectType = found.type
            }
            let lastSection: TextSpan? = s.sections.length > 0 ? s.sections[s.sections.length - 1].span : null
            exhaustive = checkStatesExhaustive(
                ref b,
                through: ref c,
                at: s.span,
                as: subjectType,
                from: states,
                by: in arms,
                until: -1,
                to: lastSection,
            )
        } else {
            exhaustive = checkExhaustive(
                ref b,
                through: ref c,
                at: parser.exprSpan(in s.value),
                as: valueType,
                by: in arms,
                statement: true,
            )
        }
    }
    return recordNodeSyntax(
        ref c,
        for: addSwitch(
            ref c,
            from: BSwitch {
                span: s.span,
                value: value,
                sections: move sections,
                target: target.id,
                exhaustive: exhaustive,
            },
        ),
        as: .switchStmt,
        at: s.span,
    )
}
== semantics/bound.byn
// T4: BoundNodes.cs, BoundTree.cs and the BoundMethodGroup/BoundBuiltinGroup/BoundVariantGroup records from BinderExpressions.cs.
//
// A bound node is a handle `(BoundKind << 32) | index` into the per-kind arena on `Ctx` (`bLiterals`,
// `bCalls`, …); -1 is C#'s `null`. `BExpr`, `BStmt` and `BPattern` (ctx.byn) share the one `BoundKind`, so
// any of them is a `BNode`. One struct per C# record, fields in C# order: `Node Syntax` is `TextSpan span`,
// a symbol is its T3 handle, `T[]` is a `List<T>`, and a base type computed from a symbol or a child
// (`BoundLocal`'s `Local.Type`) is a trailing `type` the constructor fills. `BoundExpr.Constant` lives in
// `Ctx.constants` and the facts C# reads from `Syntax` in `Ctx.syntaxFlags`, both keyed by the handle (Q537).
// Helper records that are not nodes (`BSwitchArm`, `BSwitchSection`, …) are stored inline in their parent.

import parser

public type BNode = i64

// ── Kinds ────────────────────────────────────────────────────────────────────

/// Every concrete `BoundExpr`, `BoundStmt` and `BoundPattern` record of `BoundNodes.cs` in file order, then the
/// three group records of `BinderExpressions.cs`; keyword names are renamed (Q535). The ordinals are fixed.
public enum BoundKind {
    literal
    symbolLiteral
    hostTarget
    defaultValue
    local
    thisRef
    field
    tupleElement
    call
    builtinCall
    unary
    binary
    conversion
    tryFrom
    conditional
    coalesce
    structLiteral
    withExpr
    tuple
    collection
    spread
    index
    slice
    range
    isExpr
    switchExpr
    interpolated
    moveExpr
    tryExpr
    catchExpr
    jump
    blockExpr
    errorVariant
    enumMember
    unionNew
    enumValues
    staticArray
    stackalloc
    errorExpr
    typeRef
    moduleRef
    lambda
    functionRef
    block
    localDecl
    exprStmt
    assign
    returnStmt
    failStmt
    becomeStmt
    breakStmt
    continueStmt
    ifStmt
    whileStmt
    doWhile
    forStmt
    switchStmt
    deferStmt
    assertStmt
    errdeferStmt
    panicDefer
    setOnPanic
    contextStmt
    errorStmt
    constantPattern
    relationalPattern
    rangePattern
    bindPattern
    notPattern
    binaryPattern
    propertyPattern
    unionField
    unionPattern
    errorField
    errorPattern
    methodGroup
    variantGroup
    builtinGroup
}

/// C# `BuiltinMember`, in C# order.
public enum BuiltinMember {
    stringLength
    stringBytes
    stringIsEmpty
    stringRuneCount
    stringIsAscii
    stringCopy
    stringStartsWith
    stringEndsWith
    stringContains
    stringPosition
    stringLastPosition
    stringCount
    stringTrimmed
    stringTrimmedBy
    stringLowercased
    stringUppercased
    stringEquals
    stringReplaced
    stringRepeated
    stringJoined
    stringPadded
    bytesToString
    intTryParse
    stringRunes
    stringUtf16
    stringLines
    stringParts
    stringPartsRune
    runesTake
    runesSkip
    runesTakeLast
    utf16Copy
    textViewMore
    textViewNext
    spanLength
    spanIsEmpty
    spanCopy
    listCopy
    mapCopy
    strBufCopy
    listLength
    listIsEmpty
    listAdd
    listAsSpan
    listMutableSpan
    arrayMutableSpan
    listClear
    listRemoveLast
    listRemoveRange
    listRemoveThrough
    listRemoveAt
    listRemoveAtRange
    listReplace
    listSort
    listTryGet
    mapLength
    mapTryGet
    mapContains
    mapRemove
    mapClear
    mapIndex
    mapIndexSet
    mapSlot
    mapSlotCount
    mapSlotLive
    mapSlotEntry
    arrayLength
    arrayAsSpan
    arenaReset
    strBufAppend
    strBufAppendRepeated
    strBufInsert
    strBufLength
    strBufAsString
    strBufClear
    symbolText
    listTake
    mapTake
    strBufTake
    optionalTake
    charValue
    intToString
    resultIsOk
    resultValue
    resultError
    ownedValue
    ioWrite
    ioReadAll
    enumName
    enumOrdinal
    enumField
    processExitCode
    processStdout
    processStderr
    panicMessage
    formatSpecRadix
    formatSpecDebug
    formatSpecWidth
    formatSpecFill
    formatSpecAlign
    formatSpecDigits
    floatTryParse
    timeNanos
}

/// C# `ConversionKind`, in C# order.
public enum ConversionKind {
    identity
    widen
    numericCast
    charToInteger
    integerToChar
    toOptional
    nullToOptional
    listToSpan
    arrayToSpan
    stringToBytes
    toResult
    errorToResult
    fromNever
    narrow
    toFunction
    toDynRef
}

/// C# `IterationKind`.
public enum IterationKind {
    indexable
    enumerator
}

// ── Constants ────────────────────────────────────────────────────────────────

/// What a `Constant` holds: C#'s boxed `Int128`, `double`, `bool`, `string` or `Rune` (Q536).
public enum ConstantKind {
    integer
    real
    flag
    text
    rune
}

/// C# `ConstantValue`: only the field named by `kind` is meaningful.
public struct Constant {
    public ConstantKind kind
    public Big          integer = Big { lo: 0, hi: 0 }
    public f64          real    = 0.0
    public bool         flag    = false
    public string       text    = ""
    public u32          rune    = 0
}

/// `ConstantValue.ToString()`.
string constantText(in Constant k) {
    switch k.kind {
        case .integer: return bigText(k.integer)
        case .real: return realText(k.real)
        case .flag: return k.flag ? "true" : "false"
        case .text: return $"\"{k.text}\""
        case .rune: return $"{rune(k.rune)}"
    }
}

/// C#'s `double.ToString()` under the invariant culture: the shortest round-trip digits, in exponent form
/// `1E+20` / `1E-05` when the decimal exponent is at least 17 or below -4; `Infinity`, `-Infinity`, `NaN`.
public string realText(f64 v) uses alloc {
    return "NaN" if v != v
    let s = $"{v}"
    return "Infinity" if s == "inf"
    return "-Infinity" if s == "-inf"
    let b = s.bytes
    // Bayan prints the same shortest digits; re-lay them out C#'s way.
    var sb = StrBuf()
    var i = 0
    if i64(b[0]) == 45 {
        sb.append("-")
        i = 1
    }
    var d = List<i64>()
    var point = -1
    while i < b.length && i64(b[i]) != 101 {
        if i64(b[i]) == 46 {
            point = d.length
        } else {
            d.append(i64(b[i]) - 48)
        }
        i += 1
    }
    if point < 0 {
        point = d.length
    }
    var exp = 0
    if i < b.length {
        i += 1
        var negExp = false
        if i64(b[i]) == 45 {
            negExp = true
            i += 1
        }
        while i < b.length {
            exp = exp * 10 + i64(b[i]) - 48
            i += 1
        }
        if negExp {
            exp = -exp
        }
    }
    var lead = 0
    while lead < d.length && d[lead] == 0 {
        lead += 1
    }
    if lead == d.length {
        sb.append("0")
        return $"{sb.finish()}"
    }
    var last = d.length - 1
    while d[last] == 0 {
        last -= 1
    }
    // The decimal exponent of the first significant digit.
    let x = point - lead - 1 + exp
    if x is >= 17 or < -4 {
        sb.append($"{d[lead]}")
        if last > lead {
            sb.append(".")
            for j in lead + 1..last + 1 {
                sb.append($"{d[j]}")
            }
        }
        var ax = x
        if x < 0 {
            sb.append("E-")
            ax = -x
        } else {
            sb.append("E+")
        }
        if ax < 10 {
            sb.append("0")
        }
        sb.append($"{ax}")
        return $"{sb.finish()}"
    }
    if x < 0 {
        sb.append("0.")
        for j in 0..-x - 1 {
            sb.append("0")
        }
        for j in lead..last + 1 {
            sb.append($"{d[j]}")
        }
        return $"{sb.finish()}"
    }
    for j in 0..x + 1 {
        if lead + j <= last {
            sb.append($"{d[lead + j]}")
        } else {
            sb.append("0")
        }
    }
    if lead + x < last {
        sb.append(".")
        for j in lead + x + 1..last + 1 {
            sb.append($"{d[j]}")
        }
    }
    return $"{sb.finish()}"
}

// ── Handles ──────────────────────────────────────────────────────────────────

public BNode makeBound(BoundKind kind, at i64 index) => (i64(kind.ordinal) << 32) | index

public BoundKind boundKind(BNode n) => BoundKind.fromOrdinal(n >> 32) ?? .errorExpr

i64 boundIndex(BNode n) => n & 0xFFFFFFFF

public bool isStmtKind(BoundKind k) => k.ordinal >= BoundKind.block.ordinal && k.ordinal <= BoundKind.errorStmt.ordinal

public bool isPatternKind(BoundKind k) {
    switch k {
        case .constantPattern or .relationalPattern or .rangePattern or .bindPattern or .notPattern or .binaryPattern
            or .propertyPattern or .unionPattern or .errorPattern:
            return true
        default:
            return false
    }
}

public bool isExprKind(BoundKind k) => !isStmtKind(k) && !isPatternKind(k)

// ── Constants and syntax facts keyed by handle ───────────────────────────────

/// C# `BoundExpr.Constant`; null when `e` is not a compile-time constant.
public Constant? exprConstant(in Ctx c, for BExpr e) => c.constants.tryGet(at: e)

public void setConstant(ref Ctx c, for BExpr e, to Constant k) uses alloc {
    c.constants[e] = k
}

/// `Syntax is LiteralExpr` (BinderExpressions.cs:94, :1496).
const syntaxLiteral: i64        = 1
/// `Syntax is UnaryExpr` (BinderExpressions.cs:1496).
const syntaxUnary: i64          = 2
/// `Syntax is Expr x && IsUntypedLiteral(x)` (BinderExpressions.cs:249).
const syntaxUntypedLiteral: i64 = 4
/// `Syntax is DiscardPattern` (BinderCalls.cs:1590).
const syntaxDiscard: i64        = 8
/// `Syntax is CallExpr` on a builtin method call (RegionAnalysis.cs:451: `sb.finish()`, not `sb.view`).
const syntaxCall: i64           = 16

/// The `syntax…` bits recorded for `n` (0 when none were).
i64 syntaxFlags(in Ctx c, for BNode n) => c.syntaxFlags.tryGet(at: n) ?? 0

/// Records the `syntax…` bits of the node C# would build from the same `Syntax`.
public void setSyntaxFlags(ref Ctx c, for BNode n, to i64 flags) uses alloc {
    c.syntaxFlags[n] = flags
}

public bool hasSyntax(in Ctx c, for BNode n, by i64 flag) => (syntaxFlags(in c, for: n) & flag) != 0

// ── Syntax nodes (T21, Q849, Q850) ───────────────────────────────────────────

/// The case of a recorded `parser.Expr`: the C# record type of `BoundNode.Syntax` when it is an `Expr`.
public enum ExprSyntaxKind {
    literalExpr
    interpolatedExpr
    nameExpr
    thisExpr
    memberExpr
    targetMemberExpr
    callExpr
    indexExpr
    unaryExpr
    binaryExpr
    rangeExpr
    conditionalExpr
    castExpr
    isExpr
    exceptExpr
    inExpr
    switchExpr
    tryExpr
    moveExpr
    catchExpr
    caughtErrorExpr
    jumpExpr
    blockExpr
    structLiteralExpr
    withExpr
    spreadExpr
    mapEntryExpr
    collectionExpr
    tupleExpr
    parenExpr
    lambdaExpr
    stackallocExpr
    patternExpr
    errorExpr
}

/// A recorded `parser.Expr` (a non-owning copy, since `parser.Expr` owns its children): its case and span, and the
/// children `Lowerer.Anchor` and `IsLiteral` walk, as handles into `Ctx.exprSyntaxNodes` (-1 when the case has none).
public struct ExprSyntax {
    public ExprSyntaxKind     kind
    public TextSpan           span
    /// `ParenExpr.Inner`.
    public i64                inner          = -1
    /// `MemberExpr.Member`.
    public TextSpan           member         = TextSpan { start: 0, length: 0 }
    /// `CallExpr.Callee`.
    public i64                callee         = -1
    /// `BinaryExpr.Left`.
    public i64                left           = -1
    /// `IsExpr.Value`.
    public i64                value          = -1
    /// `IndexExpr.Target`.
    public i64                target         = -1
    /// `ConditionalExpr.Condition`.
    public i64                condition      = -1
    /// `UnaryExpr.Operand` and `UnaryExpr.Op`.
    public i64                operand        = -1
    public parser.UnaryOp     op             = .plus
    /// P2: `BinaryExpr.Op` and `BinaryExpr.Right.Span` (Mutator.cs:105, :165).
    public parser.BinaryOp    binaryOp       = .add
    public TextSpan           right          = TextSpan { start: 0, length: 0 }
    /// P2: `LiteralExpr.Kind` and `LiteralExpr.Suffix.Span`, null when it has none (Mutator.cs:173, :205).
    public parser.LiteralKind literalKind    = .integer
    public TextSpan?          suffix         = null
    /// P2: `CallExpr.Because` is not null (Features.cs:46).
    public bool               becauseKeyword = false
}

/// C# `n.Syntax` when it is an `Expr`, else null.
public ExprSyntax? exprSyntax(in Ctx c, for BNode n) {
    let h = c.exprSyntaxOf.tryGet(at: n) ?? -1
    return null if h == -1
    return c.exprSyntaxNodes[h]
}

/// The child `node` of a recorded syntax node (its `inner`, `callee`, … handle).
public ExprSyntax exprSyntaxNode(in Ctx c, at i64 node) => c.exprSyntaxNodes[node]

/// Records `e` (with the children `exprSyntax` gives) and returns its handle; -1 for `.none`.
i64 syntaxNode(ref Ctx c, from in parser.Expr e) uses alloc {
    switch e {
        case .literalExpr(let x):
            return syntaxOfLiteral(ref c, from: in x.value)
        case .interpolatedExpr(let x):
            return syntaxLeaf(ref c, as: .interpolatedExpr, at: x.value.span)
        case .nameExpr(let x):
            return syntaxLeaf(ref c, as: .nameExpr, at: x.value.span)
        case .thisExpr(let x):
            return syntaxLeaf(ref c, as: .thisExpr, at: x.value.span)
        case .memberExpr(let x):
            return syntaxOfMember(ref c, from: in x.value)
        case .targetMemberExpr(let x):
            return syntaxLeaf(ref c, as: .targetMemberExpr, at: x.value.span)
        case .callExpr(let x):
            return syntaxOfCall(ref c, from: in x.value)
        case .indexExpr(let x):
            return syntaxOfIndex(ref c, from: in x.value)
        case .unaryExpr(let x):
            return syntaxOfUnary(ref c, from: in x.value)
        case .binaryExpr(let x):
            return syntaxOfBinary(ref c, from: in x.value)
        case .rangeExpr(let x):
            return syntaxLeaf(ref c, as: .rangeExpr, at: x.value.span)
        case .conditionalExpr(let x):
            return syntaxOfConditional(ref c, from: in x.value)
        case .castExpr(let x):
            return syntaxLeaf(ref c, as: .castExpr, at: x.value.span)
        case .isExpr(let x):
            return syntaxOfIs(ref c, from: in x.value)
        case .exceptExpr(let x):
            return syntaxLeaf(ref c, as: .exceptExpr, at: x.value.span)
        case .inExpr(let x):
            return syntaxLeaf(ref c, as: .inExpr, at: x.value.span)
        case .switchExpr(let x):
            return syntaxLeaf(ref c, as: .switchExpr, at: x.value.span)
        case .tryExpr(let x):
            return syntaxLeaf(ref c, as: .tryExpr, at: x.value.span)
        case .moveExpr(let x):
            return syntaxLeaf(ref c, as: .moveExpr, at: x.value.span)
        case .catchExpr(let x):
            return syntaxLeaf(ref c, as: .catchExpr, at: x.value.span)
        case .caughtErrorExpr(let x):
            return syntaxLeaf(ref c, as: .caughtErrorExpr, at: x.value.span)
        case .jumpExpr(let x):
            return syntaxLeaf(ref c, as: .jumpExpr, at: x.value.span)
        case .blockExpr(let x):
            return syntaxLeaf(ref c, as: .blockExpr, at: x.value.span)
        case .structLiteralExpr(let x):
            return syntaxLeaf(ref c, as: .structLiteralExpr, at: x.value.span)
        case .withExpr(let x):
            return syntaxLeaf(ref c, as: .withExpr, at: x.value.span)
        case .spreadExpr(let x):
            return syntaxLeaf(ref c, as: .spreadExpr, at: x.value.span)
        case .mapEntryExpr(let x):
            // coverage-exempt: Q853
            return syntaxLeaf(ref c, as: .mapEntryExpr, at: x.value.span)
        case .collectionExpr(let x):
            return syntaxLeaf(ref c, as: .collectionExpr, at: x.value.span)
        case .tupleExpr(let x):
            return syntaxLeaf(ref c, as: .tupleExpr, at: x.value.span)
        case .parenExpr(let x):
            return syntaxOfParen(ref c, from: in x.value)
        case .lambdaExpr(let x):
            return syntaxLeaf(ref c, as: .lambdaExpr, at: x.value.span)
        case .stackallocExpr(let x):
            return syntaxLeaf(ref c, as: .stackallocExpr, at: x.value.span)
        case .patternExpr(let x):
            return syntaxLeaf(ref c, as: .patternExpr, at: x.value.span)
        case .errorExpr(let x):
            // coverage-exempt: Q853 through `return -1`
            return syntaxLeaf(ref c, as: .errorExpr, at: x.value.span)
        case .none:
            return -1
    }
}

/// Records a syntax node with no walked children.
i64 syntaxLeaf(ref Ctx c, as ExprSyntaxKind kind, at TextSpan span) uses alloc =>
    syntaxAppend(ref c, from: ExprSyntax { kind: kind, span: span })

i64 syntaxAppend(ref Ctx c, from ExprSyntax node) uses alloc {
    c.exprSyntaxNodes.append(node)
    return c.exprSyntaxNodes.length - 1
}

/// Records a `ParenExpr` and the `Inner` child it walks.
i64 syntaxOfParen(ref Ctx c, from in parser.ParenExpr x) uses alloc {
    let inner = syntaxNode(ref c, from: in x.inner)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .parenExpr, span: x.span, inner: inner })
}

/// Records a `MemberExpr` and its `Member` name.
/// A synthetic `for try` member name (`t28SyntheticName`) is its C# span, `f.Iterable.Span` (Q739).
i64 syntaxOfMember(ref Ctx c, from in parser.MemberExpr x) uses alloc =>
    syntaxAppend(ref c, from: ExprSyntax { kind: .memberExpr, span: x.span, member: t40RealSpan(in c, for: x.member) })

/// Records a `CallExpr` and the `Callee` child it walks.
i64 syntaxOfCall(ref Ctx c, from in parser.CallExpr x) uses alloc {
    let callee = syntaxNode(ref c, from: in x.callee)
    return syntaxAppend(
        ref c,
        from: ExprSyntax {
            kind: .callExpr,
            span: x.span,
            callee: callee,
            becauseKeyword: x.becauseKeyword is not null,
        },
    )
}

/// Records a `LiteralExpr`, its `Kind` and its `Suffix`.
i64 syntaxOfLiteral(ref Ctx c, from in parser.LiteralExpr x) uses alloc =>
    syntaxAppend(ref c, from: ExprSyntax { kind: .literalExpr, span: x.span, literalKind: x.kind, suffix: x.suffix })

/// Records a `BinaryExpr` and the `Left` child it walks.
i64 syntaxOfBinary(ref Ctx c, from in parser.BinaryExpr x) uses alloc {
    let left = syntaxNode(ref c, from: in x.left)
    return syntaxAppend(
        ref c,
        from: ExprSyntax {
            kind: .binaryExpr,
            span: x.span,
            left: left,
            binaryOp: x.op,
            right: parser.exprSpan(in x.right),
        },
    )
}

/// Records an `IsExpr` and the `Value` child it walks.
i64 syntaxOfIs(ref Ctx c, from in parser.IsExpr x) uses alloc {
    let value = syntaxNode(ref c, from: in x.value)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .isExpr, span: x.span, value: value })
}

/// Records an `IndexExpr` and the `Target` child it walks.
i64 syntaxOfIndex(ref Ctx c, from in parser.IndexExpr x) uses alloc {
    let target = syntaxNode(ref c, from: in x.target)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .indexExpr, span: x.span, target: target })
}

/// Records a `ConditionalExpr` and the `Condition` child it walks.
i64 syntaxOfConditional(ref Ctx c, from in parser.ConditionalExpr x) uses alloc {
    let condition = syntaxNode(ref c, from: in x.condition)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .conditionalExpr, span: x.span, condition: condition })
}

/// Records a `UnaryExpr`, its `Op` and the `Operand` child it walks.
i64 syntaxOfUnary(ref Ctx c, from in parser.UnaryExpr x) uses alloc {
    let operand = syntaxNode(ref c, from: in x.operand)
    return syntaxAppend(ref c, from: ExprSyntax { kind: .unaryExpr, span: x.span, operand: operand, op: x.op })
}

/// Records `n`'s syntax as the node `h` (-1 records nothing) and returns `n`.
BNode recordSyntaxNode(ref Ctx c, for BNode n, at i64 h) uses alloc {
    if h != -1 {
        c.exprSyntaxOf[n] = h
    }
    return n
}

/// `n`, built with `Syntax = e`.
BNode recordSyntax(ref Ctx c, for BNode n, from in parser.Expr e) uses alloc =>
    recordSyntaxNode(ref c, for: n, at: syntaxNode(ref c, from: in e))

/// `n`, built with `Syntax = value.Syntax`.
BNode shareSyntax(ref Ctx c, for BNode n, from BNode value) uses alloc {
    let h = c.nodeSyntaxOf.tryGet(at: value) ?? -1
    if h != -1 {
        c.nodeSyntaxOf[n] = h
    }
    return recordSyntaxNode(ref c, for: n, at: c.exprSyntaxOf.tryGet(at: value) ?? -1)
}

// ── Other syntax nodes (P2, Q1076, Q1096) ────────────────────────────────────

/// The C# record type of `BoundNode.Syntax` when it is not an `Expr`: every `Stmt` and `Pattern` case, then the
/// other nodes the binder builds from (a `requires` rule, top-level statements, a struct, a name, a parameter, an argument).
public enum NodeSyntaxKind {
    blockStmt
    localDecl
    exprStmt
    assignStmt
    incDecStmt
    returnStmt
    failStmt
    breakStmt
    continueStmt
    becomeStmt
    ifStmt
    unlessStmt
    guardedStmt
    whileStmt
    doWhileStmt
    whileLetStmt
    forStmt
    labeledStmt
    switchStmt
    deferStmt
    assertStmt
    contextStmt
    emptyStmt
    errorStmt
    constantPattern
    relationalPattern
    varPattern
    discardPattern
    declarationPattern
    notPattern
    binaryPattern
    propertyPattern
    positionalPattern
    variantPattern
    slicePattern
    listPattern
    requiresRule
    globalStatement
    functionDecl
    structDecl
    name
    param
    argument
}

/// A recorded non-`Expr` syntax node: its case and span, and what `Mutator` reads from an `AssignStmt` (`Op`,
/// `Target.Span`, `Value.Span`) or a `ReturnStmt` (`Value.Span`, null when it has none).
public struct NodeSyntax {
    public NodeSyntaxKind  kind
    public TextSpan        span
    public parser.AssignOp assignOp = .assign
    public TextSpan        target   = TextSpan { start: 0, length: 0 }
    public TextSpan?       value    = null
}

/// C# `n.Syntax` when it is not an `Expr`, else null.
public NodeSyntax? nodeSyntax(in Ctx c, for BNode n) {
    let h = c.nodeSyntaxOf.tryGet(at: n) ?? -1
    return null if h == -1
    return c.nodeSyntaxNodes[h]
}

/// `n`, built with `Syntax` a node of `kind` at `span` that is not an `Expr`.
BNode recordNodeSyntax(ref Ctx c, for BNode n, as NodeSyntaxKind kind, at TextSpan span) uses alloc =>
    recordNodeSyntaxOf(ref c, for: n, from: NodeSyntax { kind: kind, span: span })

BNode recordNodeSyntaxOf(ref Ctx c, for BNode n, from NodeSyntax node) uses alloc {
    c.nodeSyntaxNodes.append(node)
    c.nodeSyntaxOf[n] = c.nodeSyntaxNodes.length - 1
    return n
}

/// `n`, built with `Syntax = s`, an `AssignStmt`.
BNode recordAssignSyntax(ref Ctx c, for BNode n, from in parser.AssignStmt s) uses alloc =>
    recordNodeSyntaxOf(
        ref c,
        for: n,
        from: NodeSyntax {
            kind: .assignStmt,
            span: s.span,
            assignOp: s.op,
            target: parser.exprSpan(in s.target),
            value: parser.exprSpan(in s.value),
        },
    )

/// `n`, built with `Syntax = s`, a `ReturnStmt`.
BNode recordReturnSyntax(ref Ctx c, for BNode n, from in parser.ReturnStmt s) uses alloc {
    return recordNodeSyntax(ref c, for: n, as: .returnStmt, at: s.span) if s.value is .none
    return recordNodeSyntaxOf(
        ref c,
        for: n,
        from: NodeSyntax { kind: .returnStmt, span: s.span, value: parser.exprSpan(in s.value) },
    )
}

/// `n`, built with `Syntax = s`; `.none` records nothing.
BNode recordStmtSyntax(ref Ctx c, for BNode n, from in parser.Stmt s) uses alloc {
    let span = parser.stmtSpan(in s)
    switch s {
        case .blockStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .blockStmt, at: span)
        // coverage-exempt: Q1105 through `return n`
        case .localDecl(_):
            return recordNodeSyntax(ref c, for: n, as: .localDecl, at: span)
        case .exprStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .exprStmt, at: span)
        case .assignStmt(let x):
            return recordAssignSyntax(ref c, for: n, from: in x.value)
        case .incDecStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .incDecStmt, at: span)
        case .returnStmt(let x):
            return recordReturnSyntax(ref c, for: n, from: in x.value)
        case .failStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .failStmt, at: span)
        case .breakStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .breakStmt, at: span)
        case .continueStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .continueStmt, at: span)
        case .becomeStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .becomeStmt, at: span)
        case .ifStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .ifStmt, at: span)
        case .unlessStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .unlessStmt, at: span)
        case .guardedStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .guardedStmt, at: span)
        case .whileStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .whileStmt, at: span)
        case .doWhileStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .doWhileStmt, at: span)
        case .whileLetStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .whileLetStmt, at: span)
        case .forStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .forStmt, at: span)
        case .labeledStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .labeledStmt, at: span)
        case .switchStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .switchStmt, at: span)
        case .deferStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .deferStmt, at: span)
        case .assertStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .assertStmt, at: span)
        case .contextStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .contextStmt, at: span)
        case .emptyStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .emptyStmt, at: span)
        case .errorStmt(_):
            return recordNodeSyntax(ref c, for: n, as: .errorStmt, at: span)
        case .none:
            return n
    }
}

/// `n`, built with `Syntax = p`.
BNode recordPatternSyntax(ref Ctx c, for BNode n, from in parser.Pattern p) uses alloc {
    // coverage-exempt: Q1105 through `return n`
    if (patternSyntax(in p) is { } s) {
        return recordNodeSyntaxOf(ref c, for: n, from: s)
    }
    return n
}

/// The `Syntax` a pattern node built from `p` records; null for `.none`.
NodeSyntax? patternSyntax(in parser.Pattern p) {
    let span = parser.patternSpan(in p)
    switch p {
        case .constantPattern(_):
            // coverage-exempt: Q1105
            return NodeSyntax { kind: .constantPattern, span: span }
        case .relationalPattern(_):
            return NodeSyntax { kind: .relationalPattern, span: span }
        case .varPattern(_):
            return NodeSyntax { kind: .varPattern, span: span }
        case .discardPattern(_):
            return NodeSyntax { kind: .discardPattern, span: span }
        case .declarationPattern(_):
            return NodeSyntax { kind: .declarationPattern, span: span }
        case .notPattern(_):
            return NodeSyntax { kind: .notPattern, span: span }
        case .binaryPattern(_):
            return NodeSyntax { kind: .binaryPattern, span: span }
        case .propertyPattern(_):
            // coverage-exempt: Q1105
            return NodeSyntax { kind: .propertyPattern, span: span }
        case .positionalPattern(_):
            return NodeSyntax { kind: .positionalPattern, span: span }
        case .variantPattern(_):
            return NodeSyntax { kind: .variantPattern, span: span }
        case .slicePattern(_):
            // coverage-exempt: Q1105
            return NodeSyntax { kind: .slicePattern, span: span }
        case .listPattern(_):
            return NodeSyntax { kind: .listPattern, span: span }
        case .none:
            // coverage-exempt: Q1105
            return null
    }
}

// ── Records ──────────────────────────────────────────────────────────────────

public struct BLiteral {
    public TextSpan span
    public Type     type
    public Constant value
}

public struct BSymbolLiteral {
    public TextSpan span
    public string   text
}

public struct BHostTarget {
    public TextSpan span
    public bool     isOs
}

public struct BDefault {
    public TextSpan span
    public Type     type
}

public struct BLocal {
    public TextSpan span
    public LocalId  local
    public Type     type = -1
}

public struct BThis {
    public TextSpan span
    public Type     type
}

public struct BField {
    public TextSpan span
    public BExpr    receiver
    public FieldId  field
    public Type     type = -1
}

public struct BTupleElement {
    public TextSpan span
    public BExpr    receiver
    public i64      index
    public Type     type
}

public struct BCall {
    public TextSpan    span
    public FuncId      function
    public BExpr       receiver  = -1
    public List<BExpr> arguments = []
    public Type        type
}

public struct BBuiltinCall {
    public TextSpan      span
    public BuiltinMember member
    public BExpr         receiver
    public List<BExpr>   arguments = []
    public Type          type
}

public struct BUnary {
    public TextSpan       span
    public parser.UnaryOp op
    public BExpr          operand
    public Type           type
}

public struct BBinary {
    public TextSpan        span
    public parser.BinaryOp op
    public BExpr           left
    public BExpr           right
    public Type            type
}

public struct BConversion {
    public TextSpan       span
    public BExpr          operand
    public Type           type
    public ConversionKind kind
}

public struct BTryFrom {
    public TextSpan span
    public BExpr    operand
    public Type     target
    public Type     type
}

public struct BConditional {
    public TextSpan span
    public BExpr    condition
    public BExpr    whenTrue
    public BExpr    whenFalse
    public Type     type
}

public struct BCoalesce {
    public TextSpan span
    public BExpr    left
    public BExpr    right
    public Type     type
}

public struct BStructLiteral {
    public TextSpan    span
    public StructId    structId
    public List<BExpr> fields  = []
    public VariantId   state   = -1
    public List<BExpr> payload = []
    public Type        type    = -1
}

public struct BWith {
    public TextSpan span
    public BExpr    target
    public List<BWithUpdate> updates = []
    public Type     type = -1
}

public struct BTuple {
    public TextSpan    span
    public Type        tupleType
    public List<BExpr> elements = []
}

public struct BCollection {
    public TextSpan    span
    public Type        type
    public List<BExpr> elements = []
}

public struct BSpread {
    public TextSpan span
    public BExpr    operand
    public Type     type
}

public struct BIndex {
    public TextSpan span
    public BExpr    target
    public BExpr    index
    public bool     fromEnd = false
    public Type     type
}

public struct BSlice {
    public TextSpan span
