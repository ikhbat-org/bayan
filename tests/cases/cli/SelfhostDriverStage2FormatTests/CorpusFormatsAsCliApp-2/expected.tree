// T21: BinderCalls.cs ~588-998 (construction, builtins, move, switch subject).

import parser

// The C# `BindSwitchSubject`'s result and its `out bool owns`.
struct SwitchSubjectResult {
    BExpr value
    bool  owns
}

/// Whether argument `a` is named `name` (the C# `{ Name.Text: "…" }`).
bool t21Named(in Ctx c, from FileId f, for in parser.Argument a, by string name) {
    if (a.name is { } n) {
        return t15Text(in c, from: f, at: n) == name
    }
    return false
}

/// A parameter with no symbol of its own (the C# `new ParameterSymbol(name, …, ParamModifier.None, ordinal)`), as T20 does (Q619).
LocalId t21Param(ref Ctx c, by string name, as Type type, at i64 ordinal) =>
    newLocal(
        ref c,
        by: LocalSymbol {
            name: name,
            type: type,
            kind: .parameter,
            isParameter: true,
            modifier: .none,
            ordinal: ordinal,
        },
    )

/// BinderCalls.cs:596 BindConstruction.
BExpr bindConstruction(ref Binder b, through ref Ctx c, for in parser.CallExpr call, as Type type) {
    let calleeSpan = parser.exprSpan(in call.callee)
    switch kindOf(type) {
        case .structType:
            let s = typeIndex(type)
            if c.structs[s].constructors.length > 0 {
                let ctor = c.structs[s].constructors[0]
                checkAccess(
                    ref b,
                    through: ref c,
                    for: c.functions[ctor].access,
                    from: s,
                    by: c.structs[s].module,
                    at: calleeSpan,
                )
                let ps = copyIds(in c.functions[ctor].parameters)
                let args = bindArguments(ref b, through: ref c, for: in call, by: in ps, as: ctor, enforceNames: true)
                let built = recordSyntaxNode(
                    ref c,
                    for: addCall(
                        ref c,
                        from: BCall { span: call.span, function: ctor, receiver: -1, arguments: move args, type: type },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                )
                return t21Checked(
                    ref b,
                    through: ref c,
                    at: call.span,
                    structLiteral: false,
                    by: built,
                    from: syntaxOfCall(ref c, from: in call),
                )
            }
            if c.distinct.contains(s) {
                // `Email(raw)` wraps the value; with `requires`, the wrapper is checked like a literal.
                let value = c.structs[s].fields[0]
                var ps = List<LocalId>()
                ps.append(
                    newLocal(
                        ref c,
                        by: LocalSymbol {
                            name: c.fields[value].name,
                            nameSpan: c.fields[value].nameSpan,
                            span: c.fields[value].nameSpan,
                            type: c.fields[value].type,
                            kind: .parameter,
                            isParameter: true,
                            modifier: .none,
                            ordinal: 0,
                        },
                    ),
                )
                let display = c.structs[s].name
                let args = bindArguments(
                    ref b,
                    through: ref c,
                    for: in call,
                    by: in ps,
                    as: -1,
                    enforceNames: false,
                    displayName: display,
                )
                let built = recordSyntaxNode(
                    ref c,
                    for: addStructLiteral(
                        ref c,
                        from: BStructLiteral { span: call.span, structId: s, fields: move args },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                )
                return t21Checked(
                    ref b,
                    through: ref c,
                    at: call.span,
                    structLiteral: false,
                    by: built,
                    from: syntaxOfCall(ref c, from: in call),
                )
            }
            if c.positional.contains(declKey(c.structs[s].file, at: c.structs[s].declIndex)) {
                // `Point(3, 4)` is `Point { x: 3, y: 4 }`: every field in declaration order, checked like the literal.
                var ps = List<LocalId>()
                let fields = copyIds(in c.structs[s].fields)
                for i in 0..fields.length {
                    let f = fields[i]
                    ps.append(
                        newLocal(
                            ref c,
                            by: LocalSymbol {
                                name: c.fields[f].name,
                                nameSpan: c.fields[f].nameSpan,
                                span: c.fields[f].nameSpan,
                                type: c.fields[f].type,
                                kind: .parameter,
                                isParameter: true,
                                modifier: .none,
                                ordinal: i,
                            },
                        ),
                    )
                }
                let display = c.structs[s].name
                let args = bindArguments(
                    ref b,
                    through: ref c,
                    for: in call,
                    by: in ps,
                    as: -1,
                    enforceNames: false,
                    displayName: display,
                )
                let built = recordSyntaxNode(
                    ref c,
                    for: addStructLiteral(
                        ref c,
                        from: BStructLiteral { span: call.span, structId: s, fields: move args },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                )
                return t21Checked(
                    ref b,
                    through: ref c,
                    at: call.span,
                    structLiteral: false,
                    by: built,
                    from: syntaxOfCall(ref c, from: in call),
                )
            }
            let states = statesOf(ref c, for: s)
            if states != -1 {
                report(
                    ref b,
                    through: ref c,
                    for: .stateLiteralNeedsState,
                    at: calleeSpan,
                    by: (c.structs[s].name, c.unionVariants[c.unions[states].variants[0]].name, "", "", ""),
                    help: "name the state the value starts in",
                )
                bindArgumentsForRecovery(ref b, through: ref c, for: in call)
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
                    at: syntaxOfCall(ref c, from: in call),
                )
            }
            let fields = copyIds(in c.structs[s].fields)
            if call.args.length > 0 {
                var shown = StrBuf()
                for i in 0..(fields.length < 2 ? fields.length : 2) {
                    if i > 0 {
                        shown.append(", ")
                    }
                    shown.append($"{c.fields[fields[i]].name}: …")
                }
                report(
                    ref b,
                    through: ref c,
                    for: .noConstructor,
                    at: calleeSpan,
                    by: (c.structs[s].name, "", "", "", ""),
                    help: $"set the fields with a struct literal: `{c.structs[s].name} {{ {shown.finish()} }}`",
                )
                bindArgumentsForRecovery(ref b, through: ref c, for: in call)
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
                    at: syntaxOfCall(ref c, from: in call),
                )
            }
            var missing = List<string>()
            for f in fields {
                if fieldIsRequired(ref c, by: f) || !c.fields[f].hasDefault {
                    missing.append(c.fields[f].name)
                }
            }
            if missing.length > 0 {
                var sets = StrBuf()
                for i in 0..missing.length {
                    if i > 0 {
                        sets.append(", ")
                    }
                    sets.append($"{missing[i]}: …")
                }
                report(
                    ref b,
                    through: ref c,
                    for: .missingFields,
                    at: call.span,
                    by: (c.structs[s].name, missing.joined(by: "`, `"), "", "", ""),
                    help: $"set {missing.length == 1 ? "it" : "them"}: `{c.structs[s].name} {{ {sets.finish()} }}`",
                )
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
                    at: syntaxOfCall(ref c, from: in call),
                )
            }
            var values = List<BExpr>()
            for f in fields {
                let d = fieldDefault(ref c, for: s, by: f, from: b.file, at: call.span)
                values.append(
                    d != -1
                        ? d
                        : recordSyntaxNode(
                            ref c,
                            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
                            at: syntaxOfCall(ref c, from: in call),
                        ),
                )
            }
            return recordSyntaxNode(
                ref c,
                for: addStructLiteral(
                    ref c,
                    from: BStructLiteral { span: call.span, structId: s, fields: move values },
                ),
                at: syntaxOfCall(ref c, from: in call),
            )
        case .list or .map:
            if call.args.length > 0 {
                report(
                    ref b,
                    through: ref c,
                    for: .tooManyArguments,
                    at: call.args[0].span,
                    by: (typeDisplay(ref c, by: type), "0", "", "", ""),
                )
                bindArgumentsForRecovery(ref b, through: ref c, for: in call)
            }
            return recordSyntaxNode(
                ref c,
                for: addCollection(ref c, from: BCollection { span: call.span, type: type }),
                at: syntaxOfCall(ref c, from: in call),
            )
        case .owned:
            return bindOwned(ref b, through: ref c, for: in call, as: c.ownedTypes[typeIndex(type)])
        case .builtin:
            if type == builtinType(.arena) {
                let fn = t9Function(ref c, for: "Arena")
                let ps = copyIds(in c.functions[fn].parameters)
                let args = bindArguments(
                    ref b,
                    through: ref c,
                    for: in call,
                    by: in ps,
                    as: fn,
                    enforceNames: false,
                    displayName: "Arena",
                )
                return recordSyntaxNode(
                    ref c,
                    for: addCall(
                        ref c,
                        from: BCall { span: call.span, function: fn, receiver: -1, arguments: move args, type: type },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                )
            }
            if type == builtinType(.strBuf) {
                return recordSyntaxNode(
                    ref c,
                    for: addCall(
                        ref c,
                        from: BCall {
                            span: call.span,
                            function: t9Function(ref c, for: "StrBuf"),
                            receiver: -1,
                            type: type,
                        },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                ) if call.args.length == 0
                // `StrBuf(capacity: n)` grows from `context.allocator` like `StrBuf()`, starting with room for n bytes.
                if call.args.length == 1 && t21Named(in c, from: b.file, for: in call.args[0], by: "capacity") {
                    var ps = List<LocalId>()
                    ps.append(t21Param(ref c, by: "capacity", as: prim(.i64), at: 0))
                    let args = bindArguments(
                        ref b,
                        through: ref c,
                        for: in call,
                        by: in ps,
                        as: -1,
                        enforceNames: false,
                        displayName: "StrBuf",
                    )
                    return recordSyntaxNode(
                        ref c,
                        for: addCall(
                            ref c,
                            from: BCall {
                                span: call.span,
                                function: t9Function(ref c, for: "StrBuf"),
                                receiver: -1,
                                arguments: move args,
                                type: type,
                            },
                        ),
                        at: syntaxOfCall(ref c, from: in call),
                    )
                }
                let fn = t9Function(ref c, for: "StrBuf(buffer)")
                let ps = copyIds(in c.functions[fn].parameters)
                let args = bindArguments(
                    ref b,
                    through: ref c,
                    for: in call,
                    by: in ps,
                    as: fn,
                    enforceNames: false,
                    displayName: "StrBuf",
                )
                return recordSyntaxNode(
                    ref c,
                    for: addCall(
                        ref c,
                        from: BCall { span: call.span, function: fn, receiver: -1, arguments: move args, type: type },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                )
            }
            // `Millis(n)`: an `i64` as a duration; `i64(t)` reads it back (`explicit`).
            if type == builtinType(.millis) && call.args.length == 1 && call.args[0].name is null {
                let operand = bindConverted(ref b, through: ref c, for: in call.args[0].value, to: prim(.i64))
                return recordSyntaxNode(
                    ref c,
                    for: addConversion(
                        ref c,
                        from: BConversion { span: call.span, operand: operand, type: type, kind: .widen },
                    ),
                    at: syntaxOfCall(ref c, from: in call),
                )
            }
        case .error:
            bindArgumentsForRecovery(ref b, through: ref c, for: in call)
            return recordSyntaxNode(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
                at: syntaxOfCall(ref c, from: in call),
            )
        case .primitive:
            return t21BindConversion(
                ref b,
                through: ref c,
                at: call.span,
                to: type,
                from: in call.args[0].value,
                as: syntaxOfCall(ref c, from: in call),
            ) if (isNumeric(type) || type == prim(.char)) && call.args.length == 1
                && call.args[0].name is null
            return bindIntegerText(ref b, through: ref c, for: in call) if isString(type)
                && call.args.length > 0
                && call.args[0].name is null
        default: {}
    }
    report(
        ref b,
        through: ref c,
        for: .notCallable,
        at: calleeSpan,
        by: (typeDisplay(ref c, by: type), "", "", "", ""),
        help: isNumeric(type) || type == prim(.char) ? $"convert one value: `{typeDisplay(ref c, by: type)}(x)`" : "",
    )
    bindArgumentsForRecovery(ref b, through: ref c, for: in call)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:689 BindIntegerText: `string(n, as: radix)`, an integer as text in a `Radix`, `.decimal` by default (spec §3.2, §6.2).
BExpr bindIntegerText(ref Binder b, through ref Ctx c, for in parser.CallExpr call) {
    let value = bindExpr(ref b, through: ref c, for: in call.args[0].value)
    let vt = exprType(in c, for: value)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        at: syntaxOfCall(ref c, from: in call),
    ) if isError(vt)
    return recordSyntaxNode(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall { span: call.span, member: .bytesToString, receiver: value, type: prim(.string) },
        ),
        at: syntaxOfCall(ref c, from: in call),
    ) if kindOf(vt) == .span
        && c.spanTypes[typeIndex(vt)].element == prim(.u8)
        && call.args.length == 1
    if !isInteger(vt) {
        // `string(x)` as the `Display` conversion of every type is step 5.4a's later chunk.
        report(
            ref b,
            through: ref c,
            for: .unsupported,
            at: parser.exprSpan(in call.callee),
            by: ($"`string(x)` of a `{typeDisplay(ref c, by: vt)}`", "", "", "", ""),
        )
        bindArgumentsForRecovery(ref b, through: ref c, for: in call)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    let radixType = t9Type(ref c, for: "Radix")
    var ps = List<LocalId>()
    ps.append(t21Param(ref c, by: "value", as: vt, at: 0))
    let asParam = t21Param(ref c, by: "as", as: radixType, at: 1)
    if call.args.length >= 2 {
        ps.append(asParam)
    }
    b.prebound[call.args[0].span.start] = value
    let args = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in ps,
        as: -1,
        enforceNames: false,
        displayName: "string",
    )
    var radix = args.length > 1 ? args[1] : -1
    if args.length <= 1 {
        let decimal = findEnumMember(ref c, by: typeIndex(radixType), for: "decimal")
        radix = recordSyntaxNode(
            ref c,
            for: addEnumMember(ref c, from: BEnumMember { span: call.span, member: decimal }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall {
                span: call.span,
                member: .intToString,
                receiver: args[0],
                arguments: [radix],
                type: prim(.string),
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:714 BindOwned: `Owned(value)` or `Owned<T>(value)`; the value's type comes from `inner`, else from the argument.
BExpr bindOwned(ref Binder b, through ref Ctx c, for in parser.CallExpr call, as Type inner) {
    var t = inner
    var value: BExpr = -1
    if t == -1 && call.args.length == 1 && call.args[0].name is null && call.args[0].modifier == .none {
        value = bindExpr(ref b, through: ref c, for: in call.args[0].value)
        t = defaultType(ref b, through: ref c, for: value, from: in call.args[0].value)
        return value if isError(t) || isNever(t)
        value = convert(
            ref b,
            through: ref c,
            for: value,
            to: t,
            at: parser.exprSpan(in call.args[0].value),
            argument: true,
        )
    } else {
        var ps = List<LocalId>()
        ps.append(t21Param(ref c, by: "value", as: t != -1 ? t : errorType(), at: 0))
        value = bindArguments(
            ref b,
            through: ref c,
            for: in call,
            by: in ps,
            as: -1,
            enforceNames: false,
            displayName: "Owned",
        )[0]
        // coverage-exempt: Q853
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        ) if t == -1
            || isError(t)
    }
    return recordSyntaxNode(
        ref c,
        for: addCall(
            ref c,
            from: BCall {
                span: call.span,
                function: t9Function(ref c, for: "Owned"),
                receiver: -1,
                arguments: [value],
                type: internOwned(ref c, by: t),
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:734 BindUntrusted: `Untrusted(value)`; the value's type comes from the argument, or from the expected `Untrusted<T>`.
BExpr bindUntrusted(ref Binder b, through ref Ctx c, for in parser.CallExpr call, as Type inner) {
    var t = inner
    var value: BExpr = -1
    if t == -1 && call.args.length == 1 && call.args[0].name is null && call.args[0].modifier == .none {
        value = bindExpr(ref b, through: ref c, for: in call.args[0].value)
        t = defaultType(ref b, through: ref c, for: value, from: in call.args[0].value)
        return value if isError(t) || isNever(t)
        value = convert(
            ref b,
            through: ref c,
            for: value,
            to: t,
            at: parser.exprSpan(in call.args[0].value),
            argument: true,
        )
    } else {
        var ps = List<LocalId>()
        ps.append(t21Param(ref c, by: "value", as: t != -1 ? t : errorType(), at: 0))
        value = bindArguments(
            ref b,
            through: ref c,
            for: in call,
            by: in ps,
            as: -1,
            enforceNames: false,
            displayName: "Untrusted",
        )[0]
        // coverage-exempt: Q853
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        ) if t == -1
            || isError(t)
    }
    return recordSyntaxNode(
        ref c,
        for: addCall(
            ref c,
            from: BCall {
                span: call.span,
                function: t9Function(ref c, for: "Untrusted"),
                receiver: -1,
                arguments: [value],
                type: internUntrusted(ref c, by: t),
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:754 BindTrust: `trust(value, reason: "…")`: `Untrusted<T>` to `T`, with a non-empty literal reason.
BExpr bindTrust(ref Binder b, through ref Ctx c, for in parser.CallExpr call) {
    let value: BExpr = call.args.length > 0
        && call.args[0].name is null ? bindExpr(ref b, through: ref c, for: in call.args[0].value) : -1
    if value == -1 || call.args.length != 2 || !t21Named(in c, from: b.file, for: in call.args[1], by: "reason") {
        bindArgumentsForRecovery(ref b, through: ref c, for: in call)
        report(
            ref b,
            through: ref c,
            for: .trustReason,
            at: call.span,
            by: ("", "", "", "", ""),
            help: "write `x.trustUnchecked() because \"why this value is safe\"`",
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    let _ = bindExpr(ref b, through: ref c, for: in call.args[1].value)
    var literal = false
    switch call.args[1].value {
        case .literalExpr(let l): literal = l.value.kind == .string && l.value.text.length > 0
        default: {}
    }
    if !literal {
        report(
            ref b,
            through: ref c,
            for: .trustReason,
            at: parser.exprSpan(in call.args[1].value),
            by: ("", "", "", "", ""),
            help: "explain why the value is safe, in a string literal such as `reason: \"validated upstream\"`",
        )
    }
    let vt = exprType(in c, for: value)
    return value if isError(vt)
    if kindOf(vt) != .untrusted {
        let _ = convert(
            ref b,
            through: ref c,
            for: value,
            to: internUntrusted(ref c, by: vt),
            at: parser.exprSpan(in call.args[0].value),
            argument: true,
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addCall(
            ref c,
            from: BCall {
                span: call.span,
                function: t9Function(ref c, for: "trust"),
                receiver: -1,
                arguments: [value],
                type: c.untrustedTypes[typeIndex(vt)],
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:780 BindTrustUnchecked: `x.trustUnchecked() because "…"`: `Untrusted<T>` to `T`, the canonical form of
/// `trust` (BYN1062); a missing or empty reason is BYN8001 (`bindCall`, the parser).
BExpr bindTrustUnchecked(ref Binder b, through ref Ctx c, for in parser.CallExpr call, by in parser.MemberExpr callee) {
    let value = bindExpr(ref b, through: ref c, for: in callee.target)
    let vt = exprType(in c, for: value)
    return value if isError(vt)
    if kindOf(vt) != .untrusted {
        let _ = convert(
            ref b,
            through: ref c,
            for: value,
            to: internUntrusted(ref c, by: vt),
            at: parser.exprSpan(in callee.target),
            argument: true,
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addCall(
            ref c,
            from: BCall {
                span: call.span,
                function: t9Function(ref c, for: "trust"),
                receiver: -1,
                arguments: [value],
                type: c.untrustedTypes[typeIndex(vt)],
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:792 BindBuiltinMethodCall.
BExpr bindBuiltinMethodCall(
    ref Binder b,
    through ref Ctx c,
    for in parser.CallExpr call,
    from BExpr receiver,
    by string name
) {
    var m = method(ref c, for: exprType(in c, for: receiver), by: name) ?? panic("bindBuiltinMethodCall: no method")
    if m.member == .stringParts && call.args.length > 0 {
        let sep = bindExpr(ref b, through: ref c, for: in call.args[0].value)
        b.prebound[call.args[0].span.start] = sep
        if exprType(in c, for: sep) == prim(.char) {
            let rest = m.parameters[1]
            var ps = List<BuiltinParameter>()
            ps.append(BuiltinParameter { name: "by", type: prim(.char) })
            ps.append(BuiltinParameter { name: rest.name, type: rest.type })
            m.member = .stringPartsRune
            m.parameters = move ps
        }
    }
    // `buf.append(x)` formats any `Display` value straight into the buffer, as the hole `$"{x}"` would.
    if m.member == .strBufAppend && call.args.length == 1 && !t20IsInterpolated(call.args[0].value) {
        var value = bindExpr(ref b, through: ref c, for: in call.args[0].value)
        let vt = exprType(in c, for: value)
        if !isError(vt) && !isString(vt) {
            var seen = List<Type>()
            if (whyNotFormattable(ref c, for: vt, by: ref seen) is { } why) {
                let at = parser.exprSpan(in call.args[0].value)
                report(
                    ref b,
                    through: ref c,
                    for: .notFormattable,
                    at: at,
                    by: (typeDisplay(ref c, by: vt), "", "", "", ""),
                    label: why,
                    help: kindOf(vt) == .structType
                        ? $"add `formatInto(ref StrBuf)` to `{c.structs[typeIndex(vt)].name}`, or use `{{x, as: .debug}}`"
                        : "",
                )
            }
            var parts = List<BInterpolationPart>()
            parts.append(BInterpolationPart { text: null, value: value })
            value = recordSyntax(
                ref c,
                for: addInterpolated(
                    ref c,
                    from: BInterpolated { span: parser.exprSpan(in call.args[0].value), parts: move parts },
                ),
                from: in call.args[0].value,
            )
        }
        b.prebound[call.args[0].span.start] = value
    }
    // `remove(at:)` takes an index or a range; a range literal or a held `Range<i64>` picks the range form.
    var removedAt: BExpr = -1
    var atRange = false
    if m.member == .listRemoveRange
            && call.args.length == 1
            && t21Named(in c, from: b.file, for: in call.args[0], by: "at") {
        switch call.args[0].value {
            case .rangeExpr(_): atRange = true
            default:
                removedAt = bindExpr(ref b, through: ref c, for: in call.args[0].value)
                b.prebound[call.args[0].span.start] = removedAt
        }
    }
    if m.member == .listRemoveRange
            && (atRange || (removedAt != -1 && kindOf(exprType(in c, for: removedAt)) == .range)) {
        var ps = List<BuiltinParameter>()
        ps.append(BuiltinParameter { name: "at", type: internRange(ref c, by: prim(.i64)) })
        m.member = .listRemoveAtRange
        m.parameters = move ps
    } else if m.member == .listRemoveRange
            && call.args.length == 1
            && t21Named(in c, from: b.file, for: in call.args[0], by: "at") {
        var ps = List<BuiltinParameter>()
        ps.append(BuiltinParameter { name: "at", type: prim(.i64) })
        m.member = .listRemoveAt
        m.parameters = move ps
    } else if m.member == .listRemoveRange
            && call.args.length == 2
            && t21Named(in c, from: b.file, for: in call.args[1], by: "through") {
        let first = m.parameters[0]
        var ps = List<BuiltinParameter>()
        ps.append(BuiltinParameter { name: first.name, type: first.type })
        ps.append(BuiltinParameter { name: "through", type: prim(.i64) })
        m.member = .listRemoveThrough
        m.parameters = move ps
    } else if m.member == .stringTrimmed
            && call.args.length == 1
            && t21Named(in c, from: b.file, for: in call.args[0], by: "by") {
        var ps = List<BuiltinParameter>()
        ps.append(BuiltinParameter { name: "by", type: internSpan(ref c, by: prim(.char), readOnly: true) })
        m = BuiltinMethod { member: .stringTrimmedBy, parameters: move ps, returns: prim(.string) }
    } else if m.member == .stringTrimmed {
        var ps = List<BuiltinParameter>()
        ps.append(BuiltinParameter { name: "from", type: t9Type(ref c, for: "Edge") })
        m.parameters = move ps
    } else if m.member == .stringEquals {
        let first = m.parameters[0]
        var ps = List<BuiltinParameter>()
        ps.append(BuiltinParameter { name: first.name, type: first.type })
        ps.append(BuiltinParameter { name: "as", type: t9Type(ref c, for: "Comparison") })
        m.parameters = move ps
    }
    var target = receiver
    if m.member is .listTake or .mapTake or .strBufTake or .optionalTake {
        target = mapWriteTarget(ref c, for: target)
    }
    let want = m.parameters.length - m.optional
    let wanted = call.args.length > want ? call.args.length : want
    let count = wanted < m.parameters.length ? wanted : m.parameters.length
    var ps = List<LocalId>()
    for i in 0..count {
        ps.append(t21Param(ref c, by: m.parameters[i].name, as: m.parameters[i].type, at: i))
    }
    let args = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in ps,
        as: -1,
        enforceNames: false,
        displayName: name,
    )
    if m.mutating {
        let _ = checkWritable(
            ref b,
            through: ref c,
            for: target,
            at: nodeSpan(in c, for: target),
            by: $"`{name}` modifies it",
        )
    }
    if m.member == .mapSlot && !isDefaultable(ref c, for: m.returns) {
        report(
            ref b,
            through: ref c,
            for: .mapSlotNoDefault,
            at: call.span,
            by: (typeDisplay(ref c, by: m.returns), "", "", "", ""),
            help: "read with `map[key]` or `map.tryGet(at: key) ?? fallback`, and write with `map[key] = value`",
        )
    }
    if m.member is .listCopy or .mapCopy {
        let rt = exprType(in c, for: target)
        var held: Type = -1
        if m.member == .listCopy {
            held = uniquePart(ref c, for: c.listTypes[typeIndex(rt)])
        } else {
            held = uniquePart(ref c, for: c.mapTypes[typeIndex(rt)].key)
            if held == -1 {
                held = uniquePart(ref c, for: c.mapTypes[typeIndex(rt)].value)
            }
        }
        if held != -1 {
            report(
                ref b,
                through: ref c,
                for: .copyUniqueElement,
                at: call.span,
                by: (typeDisplay(ref c, by: rt), typeDisplay(ref c, by: held), "", "", ""),
                help: "build the copy with a loop that copies each element, or share the original by `ref`",
            )
        }
    }
    var returns = m.returns
    if kindOf(m.returns) == .span && boundKind(target) == .staticArray {
        returns = internSpan(ref c, by: c.spanTypes[typeIndex(m.returns)].element, readOnly: true)
    } else if m.member == .ioReadAll {
        returns = internResult(ref c, by: m.returns, to: t9Type(ref c, for: "IoError"))
    }
    let n = recordSyntaxNode(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall {
                span: call.span,
                member: m.member,
                receiver: target,
                arguments: move args,
                type: returns,
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
    setSyntaxFlags(ref c, for: n, to: syntaxCall)
    return n
}

/// BinderCalls.cs:858 IsDefaultable: whether `map.slot` can insert a default `t`: numbers, `bool`, `rune`, `string`,
/// `Symbol`, optionals and structs whose fields all have defaults. A private helper of the range (Q621).
bool isDefaultable(ref Ctx c, for Type t) {
    return true if t == prim(.char) || t == builtinType(.symbol)
    return true if kindOf(t) == .optional
    return structIsDefaultable(ref c, by: typeIndex(t)) if kindOf(t) == .structType
    return isNumeric(t) || isBool(t) || isString(t)
}

// ── Ownership ────────────────────────────────────────────────────────────────

/// BinderCalls.cs:869 BindMove: `move x` (or a `move` argument): only a local or a `move` parameter can be moved (spec §9.3).
BExpr bindMove(ref Binder b, through ref Ctx c, at TextSpan span, for BExpr operand) =>
    t21BindMove(ref b, through: ref c, at: span, for: operand, from: -1)

/// A `BMove` built at `span` with `Syntax` the `Expr` node `syntax`, or the `move` `Argument` when `syntax` is -1
/// (BinderCalls.cs:540 passes `arg`).
BExpr recordMoveSyntax(ref Ctx c, for BExpr n, at i64 syntax, by TextSpan span) uses alloc {
    return recordNodeSyntax(ref c, for: n, as: .argument, at: span) if syntax == -1
    return recordSyntaxNode(ref c, for: n, at: syntax)
}

/// `bindMove` that records `syntax` as the C# `Syntax` of the nodes it builds (Q849).
BExpr t21BindMove(ref Binder b, through ref Ctx c, at TextSpan span, for BExpr operand, from i64 syntax) {
    return operand if isError(exprType(in c, for: operand))
    // a narrowed local moves the underlying optional binding, still typed as the narrowed value
    if boundKind(operand) == .conversion {
        let n = c.bConversions[boundIndex(operand)]
        if n.kind == .narrow && boundKind(n.operand) == .local {
            let inner = t21BindMove(ref b, through: ref c, at: span, for: n.operand, from: syntax)
            return shareSyntax(
                ref c,
                for: addConversion(
                    ref c,
                    from: BConversion { span: n.span, operand: inner, type: n.type, kind: .narrow },
                ),
                from: operand,
            )
        }
    }
    return recordMoveSyntax(
        ref c,
        for: addMove(ref c, from: BMove { span: span, operand: operand }),
        at: syntax,
        by: span,
    ) if checkGuardWrite(ref b, through: ref c, for: operand, at: span, by: "it is moved")
    let k = boundKind(operand)
    let i = boundIndex(operand)
    let at = nodeSpan(in c, for: operand)
    if k == .local {
        let l = c.bLocals[i].local
        if c.locals[l].borrowsSubject && isUnique(ref c, for: c.locals[l].type) {
            report(
                ref b,
                through: ref c,
                for: .mutateBorrow,
                at: at,
                by: (c.locals[l].name, "", "", "", ""),
                label: "moving it would take the value out of what it borrows from",
                help: "move or copy the value it was bound to instead",
            )
            return recordMoveSyntax(
                ref c,
                for: addMove(ref c, from: BMove { span: span, operand: operand }),
                at: syntax,
                by: span,
            )
        }
        let lk = c.locals[l].kind
        return recordMoveSyntax(
            ref c,
            for: addMove(ref c, from: BMove { span: span, operand: operand }),
            at: syntax,
            by: span,
        ) if lk == .letKeyword
            || lk == .varKeyword
            || lk == .patternVariable
            || (c.locals[l].isParameter && c.locals[l].modifier == .moveKeyword)
            || c.locals[l].borrowsSubject
    }
    var what = "this expression"
    var help = "move a local variable or a `move` parameter instead"
    if k == .local {
        let l = c.bLocals[i].local
        if c.locals[l].isParameter && paramIsByRef(ref c, by: l) {
            let mod = c.locals[l].modifier == .refKeyword ? "ref" : c.locals[l].modifier == .outKeyword ? "out" : "in"
            what = $"`{mod}` parameter `{c.locals[l].name}`"
            help = "copy it with `.copy(to: alloc)`; the caller still owns it"
        } else if c.locals[l].isParameter {
            what = $"parameter `{c.locals[l].name}`"
            help = $"declare it `move {c.locals[l].name}` to take ownership; a plain parameter is borrowed from the caller"
        } else {
            what = $"`{c.locals[l].name}`"
        }
    } else if k == .field {
        what = $"field `{c.fields[c.bFields[i].field].name}`"
        help = method(
            ref c,
            for: exprType(in c, for: operand),
            by: "take",
        ) is not null ? "take it with `.take()`, or copy it with `.copy(to: alloc)`; its owner keeps it" : "move the whole value, or copy the field with `.copy(to: alloc)`; its owner keeps it"
    } else if k == .index || (k == .builtinCall && c.bBuiltinCalls[i].member == .mapIndex) {
        what = "an element"
        help = method(
            ref c,
            for: exprType(in c, for: operand),
            by: "take",
        ) is not null ? "take it with `.take()`, or copy it with `.copy(to: alloc)`; its owner keeps it" : "copy the element with `.copy(to: alloc)`; the collection keeps it"
    } else if k == .tupleElement {
        what = "a tuple element"
        help = "move the whole tuple instead"
    } else if k == .thisRef {
        what = "`this`"
        help = "move a `.copy(to: alloc)` of it instead; a method borrows `this`"
    } else if k is .call or .builtinCall or .structLiteral or .collection or .literal or .lambda {
        what = "a fresh value"
        help = "remove the `move`; a fresh value needs none"
    }
    report(ref b, through: ref c, for: .cannotMove, at: at, by: (what, "", "", "", ""), help: help)
    return recordMoveSyntax(
        ref c,
        for: addMove(ref c, from: BMove { span: span, operand: operand }),
        at: syntax,
        by: span,
    )
}

/// BinderCalls.cs:912 BindSwitchSubject: `move x` moves a local or `move` parameter into the switch, and `owns` says
/// its bindings own their parts.
SwitchSubjectResult bindSwitchSubject(ref Binder b, through ref Ctx c, for in parser.Expr value) =>
    t21SwitchSubject(ref b, through: ref c, for: in value, from: in value)

/// `bindSwitchSubject` with `inner`, the C# `inner` of `while (inner is ParenExpr p) inner = p.Inner`.
SwitchSubjectResult t21SwitchSubject(
    ref Binder b,
    through ref Ctx c,
    for in parser.Expr value,
    from in parser.Expr inner
) {
    switch inner {
        case .parenExpr(let p): return t21SwitchSubject(ref b, through: ref c, for: in value, from: in p.value.inner)
        case .moveExpr(let m):
            var operand = bindExpr(ref b, through: ref c, for: in m.value.operand)
            return SwitchSubjectResult { value: operand, owns: false } if isError(exprType(in c, for: operand))
            if boundKind(operand) == .conversion {
                let n = c.bConversions[boundIndex(operand)]
                if n.kind == .narrow && boundKind(n.operand) == .local {
                    operand = n.operand
                }
            }
            let k = boundKind(operand)
            let i = boundIndex(operand)
            if k == .local {
                let l = c.bLocals[i].local
                let lk = c.locals[l].kind
                if lk == .letKeyword
                        || lk == .varKeyword
                        || lk == .patternVariable
                        || (c.locals[l].isParameter && c.locals[l].modifier == .moveKeyword) {
                    let owns = !c.locals[l].borrowsSubject
                    return SwitchSubjectResult {
                        value: t21BindMove(
                            ref b,
                            through: ref c,
                            at: m.value.span,
                            for: operand,
                            from: syntaxLeaf(ref c, as: .moveExpr, at: m.value.span),
                        ),
                        owns: owns,
                    }
                }
            }
            var what = "this expression"
            if k == .local {
                let l = c.bLocals[i].local
                what = c.locals[l].isParameter ? $"parameter `{c.locals[l].name}`" : $"`{c.locals[l].name}`"
            } else if k == .field {
                what = $"field `{c.fields[c.bFields[i].field].name}`"
            } else if k == .index || (k == .builtinCall && c.bBuiltinCalls[i].member == .mapIndex) {
                what = "an element"
            } else if k == .tupleElement {
                what = "a tuple element"
            } else if k == .thisRef {
                what = "`this`"
            } else if k is .call or .builtinCall or .structLiteral or .collection or .literal {
                what = "a fresh value"
            }
            report(
                ref b,
                through: ref c,
                for: .switchMoveSubject,
                at: parser.exprSpan(in m.value.operand),
                by: (what, "", "", "", ""),
                help: "drop `move` so the bindings borrow, declare the parameter `move`, or `.take()` a collection field into a local first",
            )
            return SwitchSubjectResult { value: operand, owns: false }
        default: return SwitchSubjectResult { value: bindExpr(ref b, through: ref c, for: in value), owns: false }
    }
}

// ── Failure handling ─────────────────────────────────────────────────────────

/// BinderCalls.cs:944 ReportUnhandled; `structLiteral` is the C# `c is StructLiteralExpr`.
void reportUnhandled(ref Binder b, through ref Ctx c, at TextSpan span, by string name, bool structLiteral) {
    if structLiteral {
        report(
            ref b,
            through: ref c,
            for: .literalNeedsTry,
            at: span,
            by: (name, "", "", "", ""),
            help: $"add `try` before the literal and handle the `ValidationError<{name}>`",
            hasFix: true,
            fixSpan: TextSpan { start: span.start, length: 0 },
            fixReplacement: "try ",
        )
    } else {
        report(
            ref b,
            through: ref c,
            for: .unhandledFailure,
            at: span,
            by: (name, "", "", "", ""),
            help: "propagate the error with `try`, or handle it with `catch`",
            hasFix: true,
            fixSpan: TextSpan { start: span.start, length: 0 },
            fixReplacement: "try ",
        )
    }
}

/// BinderCalls.cs:957 Handles: whether a `try` or `catch` can handle `e` itself: a call, or a construction that may run a check.
bool handles(in parser.Expr e) {
    switch e {
        case .callExpr(_) or .structLiteralExpr(_) or .withExpr(_): return true
        default: return false
    }
}

/// BinderCalls.cs:965 Checked.
BExpr checkedValue(
    ref Binder b,
    through ref Ctx c,
    for in parser.Expr syntax,
    by BExpr value,
    in List<FieldId>? changed = null
) {
    var literal = false
    switch syntax {
        case .structLiteralExpr(_): literal = true
        default: {}
    }
    return t21Checked(
        ref b,
        through: ref c,
        at: parser.exprSpan(in syntax),
        structLiteral: literal,
        by: value,
        from: syntaxNode(ref c, from: in syntax),
        changed: in changed,
    )
}

/// `checkedValue` on the syntax's span, for `bindConstruction`, which holds a `parser.CallExpr` rather than a
/// `parser.Expr` (Q620). A value just built of a struct with `requires` runs the struct's check and can fail with
/// `ValidationError`; `changed` lists the fields a `with` sets (J19); built from constants, the rules are decided here (J38).
BExpr t21Checked(
    ref Binder b,
    through ref Ctx c,
    at TextSpan span,
    bool structLiteral,
    by BExpr value,
    from i64 syntax,
    in List<FieldId>? changed = null
) {
    // A state literal is checked as its struct and keeps its state type.
    let vt = exprType(in c, for: value)
    let st = kindOf(vt) == .state ? structTypeOf(c.stateTypes[typeIndex(vt)].s) : vt
    return value if kindOf(st) != .structType
    let s = typeIndex(st)
    let ci = c.checksOf.tryGet(at: s) ?? -1
    return value if ci == -1
    if (changed is { } ch) {
        var reads = false
        for r in c.checks[ci].rules {
            if r.field != -1 && listContains(in ch, by: r.field) {
                reads = true
            }
            for f in r.reads {
                if listContains(in ch, by: f) {
                    reads = true
                }
            }
        }
        return value if !reads
    }
    if boundKind(value) == .structLiteral {
        let decided = checkConstant(ref b, through: ref c, at: span, by: value, for: ci)
        return value if decided == 1
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: span }),
            at: syntax,
        ) if decided == 0
    }
    var handled = false
    if (b.handled is { } h) {
        handled = h == span
    }
    if !handled {
        if b.covered is not null {
            var covered = b.covered.take() ?? List<CoveredCall>()
            covered.append(CoveredCall { span: span, name: c.structs[s].name, structLiteral: structLiteral })
            b.covered = move covered
        } else {
            let name = c.structs[s].name
            reportUnhandled(ref b, through: ref c, at: span, by: name, structLiteral: structLiteral)
        }
    }
    return recordSyntaxNode(
        ref c,
        for: addCall(ref c, from: BCall { span: span, function: c.checks[ci].check, receiver: value, type: vt }),
        at: syntax,
    )
}

/// BinderCalls.cs:986 CheckConstant (J38): a literal whose fields are all constants is checked now; 1 when every rule
/// holds, 0 after reporting each broken one (BYN2321), -1 when a rule is left to run time. A struct rule reading a field
/// whose own rule failed is skipped (J43). A private helper of the range (Q621).
i64 checkConstant(ref Binder b, through ref Ctx c, at TextSpan span, by BExpr literal, for i64 ci) {
    let li = boundIndex(literal)
    let s = c.bStructLiterals[li].structId
    let values = copyIds(in c.bStructLiterals[li].fields)
    let fieldIds = copyIds(in c.structs[s].fields)
    var fields = Map<FieldId, Constant>()
    for i in 0..values.length {
        let k = exprConstant(in c, for: values[i])
        return -1 if k is null
        fields[fieldIds[i]] = k
    }
    let locals = Map<LocalId, Constant>()
    let rules = c.checks[ci].rules.length
    var results = List<i64>()
    for r in 0..rules {
        let cond = c.checks[ci].rules[r].condition
        var result: i64 = -1
        if (evaluate(ref c, for: cond, from: in locals, by: in fields) is { } v) {
            if v.kind == .flag {
                result = v.flag ? 1 : 0
            }
        }
        return -1 if result == -1
        results.append(result)
    }
    var failed = List<FieldId>()
    var all: i64 = 1
    for r in 0..rules {
        let own = c.checks[ci].rules[r].field
        var skip = results[r] == 1
        for f in c.checks[ci].rules[r].reads {
            if listContains(in failed, by: f) {
                skip = true
            }
        }
        if results[r] != 1 {
            all = 0
        }
        continue if skip
        if own != -1 {
            failed.append(own)
        }
        var at = span
        if own != -1 {
            for i in 0..fieldIds.length {
                if fieldIds[i] == own {
                    let v = nodeSpan(in c, for: values[i])
                    if v.start >= at.start && v.end <= at.end && v != at {
                        at = v
                    }
                }
            }
        }
        let text = t15Text(in c, from: c.structs[s].file, at: c.checks[ci].rules[r].span)
        report(
            ref b,
            through: ref c,
            for: .requiresViolated,
            at: at,
            by: (t15Text(in c, from: b.file, at: at), text, c.structs[s].name, "", ""),
            label: "fails the contract",
            help: $"pass a value that meets `requires {text}`",
        )
    }
    return all
}
== semantics/calls3.byn
// T34: BinderCalls.cs ~999-1577 (try/catch, switch expressions, patterns, guard, resolve).

import parser

/// BinderCalls.cs:1007 BindTry.
BExpr bindTry(ref Binder b, through ref Ctx c, for in parser.TryExpr t, to Type expected) {
    if !inPanicHandler(ref b, through: ref c, at: t.span, for: "try") && b.deferDepth > 0 {
        report(
            ref b,
            through: ref c,
            for: .tryInDefer,
            at: t.span,
            by: ("", "", "", "", ""),
            help: "handle the error here with `catch`; cleanup cannot fail",
        )
    }
    return t34Try(ref b, through: ref c, for: in t, from: in t.operand, to: expected)
}

/// `bindTry` after its defer check, with `inner`, the C# `StripParens(t.Operand)`.
BExpr t34Try(ref Binder b, through ref Ctx c, for in parser.TryExpr t, from in parser.Expr inner, to Type expected) {
    switch inner {
        case .parenExpr(let p): return t34Try(ref b, through: ref c, for: in t, from: in p.value.inner, to: expected)
        default: {}
    }
    let operandSpan = parser.exprSpan(in t.operand)
    let savedCovered = b.covered.take()
    b.covered = List<CoveredCall>()
    var operand: BExpr = -1
    if !handles(in inner) {
        operand = bindExpr(ref b, through: ref c, for: in t.operand, to: expected)
    } else {
        let saved = b.handled
        b.handled = parser.exprSpan(in inner)
        operand = bindExpr(ref b, through: ref c, for: in inner, to: expected)
        b.handled = saved
    }
    let covered = b.covered.take() ?? List<CoveredCall>()
    b.covered = move savedCovered
    // `try string(bytes)` decoded before round 3; `string(x)` only formats now (J82).
    if boundKind(operand) == .builtinCall && c.bBuiltinCalls[boundIndex(operand)].member == .bytesToString {
        switch inner {
            case .callExpr(let call):
                switch call.value.callee {
                    case .nameExpr(let conversion):
                        report(
                            ref b,
                            through: ref c,
                            for: .renamedMember,
                            at: conversion.value.span,
                            by: ("try string(bytes)", "try Utf8.decode(bytes)", "", "", ""),
                            label: "the old name",
                            help: "write `Utf8.decode`",
                            hasFix: true,
                            fixSpan: conversion.value.span,
                            fixReplacement: "Utf8.decode",
                        )
                        return recordSyntaxNode(
                            ref c,
                            for: addErrorExpr(ref c, from: BErrorExpr { span: t.span }),
                            at: syntaxLeaf(ref c, as: .tryExpr, at: t.span),
                        )
                    default: {}
                }
            default: {}
        }
    }
    if handles(in inner)
            && boundKind(operand) == .call
            && c.functions[c.bCalls[boundIndex(operand)].function].hasFails {
        for k in covered {
            reportUnhandled(ref b, through: ref c, at: k.span, by: k.name, structLiteral: k.structLiteral)
        }
        return recordSyntaxNode(
            ref c,
            for: addTry(ref c, from: BTry { span: t.span, operand: operand, type: exprType(in c, for: operand) }),
            at: syntaxLeaf(ref c, as: .tryExpr, at: t.span),
        )
    }
    if covered.length > 0 {
        reportTryCoversMore(ref b, through: ref c, for: in t, at: covered[0].span)
        for i in 1..covered.length {
            reportUnhandled(
                ref b,
                through: ref c,
                at: covered[i].span,
                by: covered[i].name,
                structLiteral: covered[i].structLiteral,
            )
        }
    } else if !isError(exprType(in c, for: operand)) {
        var isCall = false
        switch inner {
            case .callExpr(_): isCall = true
            default: {}
        }
        if isCall {
            report(
                ref b,
                through: ref c,
                for: .nothingToHandle,
                at: operandSpan,
                by: ("try", "", "", "", ""),
                hasFix: true,
                fixSpan: TextSpan.fromBounds(t.span.start, until: operandSpan.start),
                fixReplacement: "",
            )
        } else {
            report(ref b, through: ref c, for: .nothingToHandle, at: operandSpan, by: ("try", "", "", "", ""))
        }
    }
    return operand
}

/// BinderCalls.cs:1054 ReportTryCoversMore: BYN1054, `try` covers an expression that cannot fail; the fix moves it onto
/// the failing call (at `failing`), in parentheses (§18).
void reportTryCoversMore(ref Binder b, through ref Ctx c, for in parser.TryExpr t, at TextSpan failing) {
    let operandSpan = parser.exprSpan(in t.operand)
    let text = t15Text(in c, from: b.file, at: operandSpan)
    let call = t15Text(in c, from: b.file, at: failing)
    let at = failing.start - operandSpan.start
    let fixedText = $"{text[0..at]}(try {call}){text[at + call.length..text.length]}"
    report(
        ref b,
        through: ref c,
        for: .tryCoversMore,
        at: operandSpan,
        by: (text, call, "", "", ""),
        label: "cannot fail",
        help: $"wrap the part that fails in parentheses: `(try {call})`",
        hasFix: true,
        fixSpan: t.span,
        fixReplacement: fixedText,
    )
}

/// BinderCalls.cs:1064 BindCatch; a catch with a variant also records the variant's span in `c.catchVariantSpans` (Q632).
BExpr bindCatch(ref Binder b, through ref Ctx c, for in parser.CatchExpr e, to Type expected) =>
    t34Catch(ref b, through: ref c, for: in e, from: in e.operand, to: expected)

/// `bindCatch` with `inner`, the C# `StripParens(c.Operand)`.
BExpr t34Catch(
    ref Binder b,
    through ref Ctx c,
    for in parser.CatchExpr e,
    from in parser.Expr inner,
    to Type expected
) {
    switch inner {
        case .parenExpr(let p): return t34Catch(ref b, through: ref c, for: in e, from: in p.value.inner, to: expected)
        default: {}
    }
    var operand: BExpr = -1
    if handles(in inner) {
        let saved = b.handled
        b.handled = parser.exprSpan(in inner)
        operand = bindExpr(ref b, through: ref c, for: in inner, to: expected)
        b.handled = saved
    } else {
        operand = bindExpr(ref b, through: ref c, for: in e.operand, to: expected)
    }
    if !(boundKind(operand) == .call && c.functions[c.bCalls[boundIndex(operand)].function].hasFails) {
        if !isError(exprType(in c, for: operand)) {
            report(
                ref b,
                through: ref c,
                for: .nothingToHandle,
                at: parser.exprSpan(in e.operand),
                by: ("catch", "", "", "", ""),
            )
        }
        pushScope(ref b)
        if (e.binding is { } b0) {
            let l = declareLocal(ref b, through: ref c, at: b0, as: errorType(), for: .letKeyword)
            c.locals[l].isCatch = true
        }
        let _ = bindExpr(ref b, through: ref c, for: in e.handler)
        popScope(ref b)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: e.span }),
            at: syntaxLeaf(ref c, as: .catchExpr, at: e.span),
        )
    }
    let fn = c.bCalls[boundIndex(operand)].function
    let sets = errorSetsOf(ref c, for: fn)
    let excluded = sets.length == 0 ? List<VariantId>() : copyIds(in c.functions[fn].excludedErrors)
    let errType = errorUnionOf(ref c, for: in sets, as: in excluded)
    pushScope(ref b)
    var binding: LocalId = -1
    var variant: VariantId = -1
    var caughtSwitch = false
    switch e.handler {
        case .switchExpr(let sw):
            switch sw.value.value {
                case .caughtErrorExpr(_): caughtSwitch = true
                default: {}
            }
        default: {}
    }
    if (e.binding is { } bn) {
        binding = declareLocal(ref b, through: ref c, at: bn, as: errType, for: .letKeyword)
        c.locals[binding].isCatch = true
    } else if caughtSwitch {
        binding = newLocal(
            ref c,
            by: LocalSymbol { name: "t", type: errType, kind: .temp, id: b.nextLocalId, isCatch: true },
        )
        b.nextLocalId += 1
        if b.fn >= 0 {
            c.functions[b.fn].locals.append(binding)
        }
    }
    let savedCaught = b.caught
    b.caught = binding
    var hasVariant = true
    switch e.variant {
        case .none: hasVariant = false
        default: {}
    }
    if hasVariant {
        let vSpan = parser.exprSpan(in e.variant)
        let bound = bindExpr(ref b, through: ref c, for: in e.variant, to: errType)
        if boundKind(bound) == .errorVariant {
            let ev = c.bErrorVariants[boundIndex(bound)].variant
            if sets.length > 0 && !listContains(in sets, by: c.errorVariants[ev].set) {
                var shown = StrBuf()
                for i in 0..sets.length {
                    if i > 0 {
                        shown.append(", ")
                    }
                    shown.append($"`{displayNameAmong(ref c, by: sets[i], for: in sets)}`")
                }
                report(
                    ref b,
                    through: ref c,
                    for: .unknownVariant,
                    at: vSpan,
                    by: (c.errorVariants[ev].name, typeDisplay(ref c, by: errType), "", "", ""),
                    help: $"use a variant of {shown.finish()}, the sets `{c.functions[fn].name}` fails with",
                )
            } else {
                variant = ev
            }
        }
    }
    let resultType = exprType(in c, for: operand)
    var handler: BExpr = -1
    var isBlock = false
    switch e.handler {
        case .blockExpr(_): isBlock = true
        default: {}
    }
    if isVoid(resultType) {
        handler = bindExpr(ref b, through: ref c, for: in e.handler)
        let ht = exprType(in c, for: handler)
        if !isVoid(ht) && !isNever(ht) && !isError(ht) {
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: parser.exprSpan(in e.handler),
                by: (typeDisplay(ref c, by: ht), "void", "", "", ""),
                help: $"drop the handler's value; `{c.functions[fn].name}` returns nothing, so the handler cannot produce one",
            )
        }
    } else if isBlock {
        switch e.handler {
            case .blockExpr(let block):
                switch block.value.block {
                    case .blockStmt(let bs):
                        let stmt = bindBlock(ref b, through: ref c, for: in bs.value)
                        handler = recordSyntaxNode(
                            ref c,
                            for: addBlockExpr(
                                ref c,
                                from: BBlockExpr { span: block.value.span, block: stmt, type: prim(.neverKind) },
                            ),
                            at: syntaxLeaf(ref c, as: .blockExpr, at: block.value.span),
                        )
                    default: {}
                }
            default: {}
        }
    } else {
        handler = bindExpr(ref b, through: ref c, for: in e.handler, to: resultType)
        if !isNever(exprType(in c, for: handler)) {
            handler = convert(ref b, through: ref c, for: handler, to: resultType, at: parser.exprSpan(in e.handler))
        }
    }
    b.caught = savedCaught
    popScope(ref b)
    let result = recordSyntaxNode(
        ref c,
        for: addCatch(
            ref c,
            from: BCatch {
                span: e.span,
                operand: operand,
                binding: binding,
                variant: variant,
                handler: handler,
                type: resultType,
            },
        ),
        at: syntaxLeaf(ref c, as: .catchExpr, at: e.span),
    )
    if hasVariant {
        c.catchVariantSpans[result] = parser.exprSpan(in e.variant)
    }
    return result
}

// ── switch expressions ───────────────────────────────────────────────────────

/// BinderCalls.cs:1141 BindSwitchExpr.
BExpr bindSwitchExpr(ref Binder b, through ref Ctx c, for in parser.SwitchExpr s, to Type expected) {
    let subj = bindSwitchSubject(ref b, through: ref c, for: in s.value)
    let value = subj.value
    let owns = subj.owns
    let valueType = exprType(in c, for: value)
    var caughtValue = false
    switch s.value {
        case .caughtErrorExpr(_): caughtValue = true
        default: {}
    }
    var arms = List<BSwitchArm>()
    for arm in s.arms {
        pushScope(ref b)
        b.patternOwns = owns
        let pattern = bindPattern(ref b, through: ref c, for: in arm.pattern, as: valueType)
        b.patternOwns = false
        if owns {
            checkOwningOverlap(ref b, through: ref c, for: pattern)
        }
        var hasGuard = true
        switch arm.guard {
            case .none: hasGuard = false
            default: {}
        }
        if owns && hasGuard {
            guardBindings(ref c, for: pattern, at: parser.exprSpan(in arm.guard))
        }
        if !hasGuard {
            learnArmState(ref b, through: ref c, for: value, by: pattern)
        }
        var guard: BExpr = -1
        if hasGuard {
            guard = bindCondition(ref b, through: ref c, for: in arm.guard)
        }
        // A block arm of a value-giving `catch switch` has no value to give, so it must leave (J49, BYN2611).
        var result: BExpr = -1
        var blockArm = false
        switch arm.value {
            case .blockExpr(let block):
                if caughtValue && expected != -1 && !isVoid(expected) {
                    switch block.value.block {
                        case .blockStmt(let bs):
                            blockArm = true
                            let stmt = bindBlock(ref b, through: ref c, for: in bs.value)
                            result = recordSyntaxNode(
                                ref c,
                                for: addBlockExpr(
                                    ref c,
                                    from: BBlockExpr { span: block.value.span, block: stmt, type: prim(.neverKind) },
                                ),
                                at: syntaxLeaf(ref c, as: .blockExpr, at: block.value.span),
                            )
                        default: {}
                    }
                }
            default: {}
        }
        if !blockArm {
            result = bindExpr(ref b, through: ref c, for: in arm.value, to: expected)
        }
        popScope(ref b)
        arms.append(BSwitchArm { span: arm.span, pattern: pattern, guard: guard, value: result })
    }
    var type = expected
    var mismatch = false
    if type != -1 {
        for a in arms {
            let at = exprType(in c, for: a.value)
            if !isError(at) && implicit(ref c, from: at, to: type) is null {
                mismatch = true
                break
            }
        }
    }
    if type == -1 || mismatch {
        type = -1
        for a in arms {
            let at = exprType(in c, for: a.value)
            continue if isNever(at) || isError(at)
            type = type == -1 ? at : common(ref c, for: type, as: at)
            if type == -1 {
                report(
                    ref b,
                    through: ref c,
                    for: .branchTypeMismatch,
                    at: nodeSpan(in c, for: a.value),
                    by: (
                        typeDisplay(ref c, by: exprType(in c, for: arms[0].value)),
                        typeDisplay(ref c, by: at),
                        "",
                        "",
                        ""
                    ),
                )
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: s.span }),
                    at: syntaxLeaf(ref c, as: .switchExpr, at: s.span),
                )
            }
        }
        if type == -1 {
            var allNever = true
            for a in arms {
                if !isNever(exprType(in c, for: a.value)) {
                    allNever = false
                }
            }
            type = allNever && arms.length > 0 ? prim(.neverKind) : errorType()
        }
    }
    if kindOf(type) == .nullType {
        report(ref b, through: ref c, for: .cannotInferType, at: s.span, by: ("null", "", "", "", ""))
        type = errorType()
    }
    for i in 0..arms.length {
        arms[i].value = convert(
            ref b,
            through: ref c,
            for: arms[i].value,
            to: type,
            at: parser.exprSpan(in s.arms[i].value),
        )
    }
    var cases = List<(BPattern, BExpr)>()
    for a in arms {
        cases.append((a.pattern, a.guard))
    }
    var states: UnionId = -1
    if kindOf(valueType) != .optional {
        states = statesUnion(ref c, for: valueType)
    }
    if states != -1 {
        let found = subject(ref b, through: ref c, for: value)
        var subjectType = valueType
        if found is not null {
            subjectType = found.type
        }
        let _ = checkStatesExhaustive(
            ref b,
            through: ref c,
            at: s.span,
            as: subjectType,
            from: states,
            by: in cases,
            until: parser.exprSpan(in s.value).end,
            to: null,
        )
    } else {
        let _ = checkExhaustive(
            ref b,
            through: ref c,
            at: parser.exprSpan(in s.value),
            as: valueType,
            by: in cases,
            statement: false,
        )
    }
    return recordSyntaxNode(
        ref c,
        for: addSwitchExpr(ref c, from: BSwitchExpr { span: s.span, value: value, arms: move arms, type: type }),
        at: syntaxLeaf(ref c, as: .switchExpr, at: s.span),
    )
}

// ── Patterns ─────────────────────────────────────────────────────────────────

/// BinderCalls.cs:1193 Unwrap.
Type unwrap(ref Ctx c, for Type t) => kindOf(t) == .optional ? c.optionalTypes[typeIndex(t)] : t

/// BinderCalls.cs:1195 BindPattern. A `_` is marked `syntaxDiscard`, the C# `Syntax is DiscardPattern` that
/// CheckExhaustive reads (BinderCalls.cs:1590).
BPattern bindPattern(ref Binder b, through ref Ctx c, for in parser.Pattern p, as Type input) {
    let span = parser.patternSpan(in p)
    switch p {
        case .discardPattern(_):
            let n = recordPatternSyntax(
                ref c,
                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                from: in p,
            )
            setSyntaxFlags(ref c, for: n, to: syntaxDiscard)
            return n
        case .varPattern(let v):
            let local = declareLocal(
                ref b,
                through: ref c,
                at: v.value.name,
                as: input,
                for: v.value.isLet ? .patternVariable : .varKeyword,
            )
            c.locals[local].borrowsSubject = !b.patternOwns
            if !v.value.isLet {
                c.locals[local].keywordSpan = TextSpan { start: v.value.span.start, length: 3 }
            }
            return recordPatternSyntax(
                ref c,
                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input, local: local }),
                from: in p,
            )
        case .constantPattern(let k):
            return bindConstantPattern(ref b, through: ref c, for: in k.value, as: input)
        case .declarationPattern(let d):
            let declared = resolveType(ref b, through: ref c, for: in d.value.type)
            return bindErrorSetPattern(
                ref b,
                through: ref c,
                at: NodeSyntax { kind: .declarationPattern, span: span },
                as: input,
                from: typeIndex(declared),
                by: d.value.name,
            ) if kindOf(declared) == .errorSet
            if !isError(declared) {
                report(
                    ref b,
                    through: ref c,
                    for: .patternMismatch,
                    at: parser.typeSpan(in d.value.type),
                    by: (
                        $"`{typeDisplay(ref c, by: declared)}`",
                        typeDisplay(ref c, by: unwrap(ref c, for: input)),
                        "",
                        "",
                        ""
                    ),
                    help: "match by type only on an error set, in a `catch switch`",
                )
            }
            let _ = declareLocal(ref b, through: ref c, at: d.value.name, as: errorType(), for: .patternVariable)
            return recordPatternSyntax(
                ref c,
                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                from: in p,
            )
        case .relationalPattern(let r):
            let target = unwrap(ref c, for: input)
            let value = bindConverted(ref b, through: ref c, for: in r.value.value, to: target)
            if !isError(target) && !(isNumeric(target) || target == prim(.char) || isString(target)) {
                report(
                    ref b,
                    through: ref c,
                    for: .badBinaryOperands,
                    at: span,
                    by: (
                        binaryText(r.value.op),
                        typeDisplay(ref c, by: target),
                        typeDisplay(ref c, by: exprType(in c, for: value)),
                        "",
                        ""
                    ),
                )
            } else {
                requireConstant(ref b, through: ref c, for: value, at: parser.exprSpan(in r.value.value))
            }
            return recordPatternSyntax(
                ref c,
                for: addRelationalPattern(
                    ref c,
                    from: BRelationalPattern { span: span, inputType: input, op: r.value.op, value: value },
                ),
                from: in p,
            )
        case .notPattern(let n):
            let operand = bindPattern(ref b, through: ref c, for: in n.value.operand, as: input)
            return recordPatternSyntax(
                ref c,
                for: addNotPattern(ref c, from: BNotPattern { span: span, inputType: input, operand: operand }),
                from: in p,
            )
        case .binaryPattern(let bp):
            let left = bindPattern(ref b, through: ref c, for: in bp.value.left, as: input)
            let right = bindPattern(ref b, through: ref c, for: in bp.value.right, as: input)
            if !bp.value.isAnd && (hasBindings(ref c, for: left) || hasBindings(ref c, for: right)) {
                report(
                    ref b,
                    through: ref c,
                    for: .unsupported,
                    at: span,
                    by: ("variables inside `or` patterns", "", "", "", ""),
                )
            }
            return recordPatternSyntax(
                ref c,
                for: addBinaryPattern(
                    ref c,
                    from: BBinaryPattern {
                        span: span,
                        inputType: input,
                        isAnd: bp.value.isAnd,
                        left: left,
                        right: right,
                    },
                ),
                from: in p,
            )
        case .propertyPattern(let pp):
            return bindPropertyPattern(ref b, through: ref c, for: in pp.value, as: input)
        case .variantPattern(let vp):
            let target = unwrap(ref c, for: input)
            switch vp.value.variant {
                case .targetMemberExpr(let tm):
                    if kindOf(target) == .errorSet || kindOf(target) == .errorUnion {
                        let bound = bindTargetMember(ref b, through: ref c, for: in tm.value, to: target)
                        return bindErrorCasePattern(
                            ref b,
                            through: ref c,
                            for: in p,
                            as: input,
                            by: bound,
                            from: in vp.value.elements,
                            at: vp.value.binding,
                        )
                    }
                    return bindUnionPattern(
                        ref b,
                        through: ref c,
                        at: NodeSyntax { kind: .variantPattern, span: span },
                        as: input,
                        from: -1,
                        by: tm.value.member,
                        for: in vp.value.elements,
                        to: vp.value.binding,
                    )
                default: {}
            }
            report(ref b, through: ref c, for: .unsupported, at: span, by: ("list patterns", "", "", "", ""))
            // coverage-exempt: Q1105
            return recordPatternSyntax(
                ref c,
                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                from: in p,
            )
        case .positionalPattern(let pos):
            let target = unwrap(ref c, for: input)
            var untyped = false
            switch pos.value.type {
                case .none:
                    untyped = true
                    if kindOf(target) == .tuple {
                        let tt = typeIndex(target)
                        let count = c.tupleTypes[tt].length
                        if pos.value.elements.length != count {
                            report(
                                ref b,
                                through: ref c,
                                for: .patternMismatch,
                                at: span,
                                by: (
                                    $"{pos.value.elements.length} elements",
                                    typeDisplay(ref c, by: target),
                                    "",
                                    "",
                                    ""
                                ),
                            )
                            return recordPatternSyntax(
                                ref c,
                                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                                from: in p,
                            )
                        }
                        var subs = List<BSubpattern>()
                        for i in 0..count {
                            let fieldType = c.tupleTypes[tt][i].type
                            var path = List<BMemberStep>()
                            path.append(BMemberStep { tupleIndex: i, type: fieldType })
                            let sub = bindPattern(ref b, through: ref c, for: in pos.value.elements[i], as: fieldType)
                            subs.append(BSubpattern { path: move path, pattern: sub })
                        }
                        return recordPatternSyntax(
                            ref c,
                            for: addPropertyPattern(
                                ref c,
                                from: BPropertyPattern {
                                    span: span,
                                    inputType: input,
                                    valueType: target,
                                    subpatterns: move subs,
                                },
                            ),
                            from: in p,
                        )
                    }
                case .namedType(let nt):
                    let path = nt.value.path.copy()
                    let mod = c.files[b.file].module
                    if path.length == 2
                            && nt.value.args.length == 0
                            && (kindOf(target) == .errorSet || kindOf(target) == .errorUnion) {
                        if (c.modules[mod].types.tryGet(
                            at: t15Text(in c, from: b.file, at: path[0]),
                        ) is { } named) && kindOf(
                            named,
                        ) == .errorSet {
                            let bound = errorCase(ref b, through: ref c, for: in p, from: typeIndex(named), at: path[1])
                            return bindErrorCasePattern(
                                ref b,
                                through: ref c,
                                for: in p,
                                as: input,
                                by: bound,
                                from: in pos.value.elements,
                                at: null,
                            )
                        }
                    }
                    if path.length > 1 && nt.value.args.length == 0 {
                        // `Option2.Some(let v)` on an `Option2<i64>` names the generic union without its type arguments.
                        var owner: Type = -1
                        if path.length == 2 && kindOf(target) == .unionType {
                            if (c.modules[mod].types.tryGet(
                                at: t15Text(in c, from: b.file, at: path[0]),
                            ) is { } named) && kindOf(
                                named,
                            ) == .unionType
                                    && c.unions[typeIndex(named)].typeParams.length > 0 {
                                let template = c.unions[typeIndex(target)].template
                                if target == named || (template != -1 && unionTypeOf(template) == named) {
                                    owner = target
                                }
                            }
                        }
                        if owner == -1 {
                            var prefix = List<TextSpan>()
                            for i in 0..path.length - 1 {
                                prefix.append(path[i])
                            }
                            let at = TextSpan.fromBounds(path[0].start, until: path[path.length - 2].end)
                            owner = resolveType(
                                ref b,
                                through: ref c,
                                for: in parser.TypeSyntax.namedType(
                                    Owned(NamedType { span: at, path: move prefix, args: List<parser.TypeSyntax>() }),
                                ),
                            )
                        }
                        return bindUnionPattern(
                            ref b,
                            through: ref c,
                            at: NodeSyntax { kind: .positionalPattern, span: span },
                            as: input,
                            from: owner,
                            by: path[path.length - 1],
                            for: in pos.value.elements,
                        ) if kindOf(owner) == .unionType
                            || kindOf(owner) == .error
                        report(
                            ref b,
                            through: ref c,
                            for: .unsupported,
                            at: span,
                            by: ("deconstruction patterns", "", "", "", ""),
                        )
                        return recordPatternSyntax(
                            ref c,
                            for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                            from: in p,
                        )
                    }
                default: {}
            }
            let what = untyped ? $"positional patterns on `{typeDisplay(ref c, by: input)}`" : "deconstruction patterns"
            report(ref b, through: ref c, for: .unsupported, at: span, by: (what, "", "", "", ""))
            return recordPatternSyntax(
                ref c,
                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                from: in p,
            )
        default:
            report(ref b, through: ref c, for: .unsupported, at: span, by: ("list patterns", "", "", "", ""))
            return recordPatternSyntax(
                ref c,
                for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
                from: in p,
            )
    }
}

/// BinderCalls.cs:1286 CheckOwningOverlap: in an owning switch, a pattern may not bind a value and a part of it, both
/// sides of an `and`, or the same field twice: each would own the same storage (L006). Only bindings of a unique type own storage.
void checkOwningOverlap(ref Binder b, through ref Ctx c, for BPattern p) {
    let k = boundKind(p)
    let i = boundIndex(p)
    let span = nodeSpan(in c, for: p)
    var overlap = false
    if k == .binaryPattern && c.bBinaryPatterns[i].isAnd {
        let left = c.bBinaryPatterns[i].left
        let right = c.bBinaryPatterns[i].right
        let l = owningPaths(ref c, for: left)
        let r = owningPaths(ref c, for: right)
        overlap = t34Overlap(in l, by: in r)
    }
    if !overlap && k == .propertyPattern {
        let d = c.bPropertyPatterns[i].designation
        if d != -1 && isUnique(ref c, for: c.locals[d].type) {
            for n in 0..c.bPropertyPatterns[i].subpatterns.length {
                let sub = c.bPropertyPatterns[i].subpatterns[n].pattern
                if owningPaths(ref c, for: sub).length > 0 {
                    overlap = true
                    break
                }
            }
        }
    }
    if overlap {
        report(
            ref b,
            through: ref c,
            for: .owningPatternOverlap,
            at: span,
            by: (t15Text(in c, from: b.file, at: span), "", "", "", ""),
            help: "bind the whole value or its parts, not both",
        )
        return
    }
    if k == .propertyPattern && repeatsField(ref c, for: p) {
        report(
            ref b,
            through: ref c,
            for: .owningPatternOverlap,
            at: span,
            by: (t15Text(in c, from: b.file, at: span), "", "", "", ""),
            help: "bind each field once",
        )
        return
    }
    switch k {
        case .binaryPattern:
            let left = c.bBinaryPatterns[i].left
            let right = c.bBinaryPatterns[i].right
            checkOwningOverlap(ref b, through: ref c, for: left)
            checkOwningOverlap(ref b, through: ref c, for: right)
        case .notPattern:
            let operand = c.bNotPatterns[i].operand
            checkOwningOverlap(ref b, through: ref c, for: operand)
        case .propertyPattern:
            for n in 0..c.bPropertyPatterns[i].subpatterns.length {
                let sub = c.bPropertyPatterns[i].subpatterns[n].pattern
                checkOwningOverlap(ref b, through: ref c, for: sub)
            }
        case .unionPattern:
            for n in 0..c.bUnionPatterns[i].subpatterns.length {
                let sub = c.bUnionPatterns[i].subpatterns[n]
                checkOwningOverlap(ref b, through: ref c, for: sub)
            }
        default: {}
    }
}

/// BinderCalls.cs:1316 RepeatsField: whether bindings of two subpatterns of the property pattern `p` reach the same
/// storage (one binding's path is a prefix of the other's).
bool repeatsField(ref Ctx c, for BPattern p) {
    let i = boundIndex(p)
    var paths = List<List<List<string>>>()
    for n in 0..c.bPropertyPatterns[i].subpatterns.length {
        let prefix = t34StepKeys(in c.bPropertyPatterns[i].subpatterns[n].path)
        let sub = c.bPropertyPatterns[i].subpatterns[n].pattern
        let qs = owningPaths(ref c, for: sub)
        var these = List<List<string>>()
        for q in qs {
            these.append(t34Concat(in prefix, by: in q))
        }
        paths.append(move these)
    }
    for x in 0..paths.length {
        for y in x + 1..paths.length {
            return true if t34Overlap(in paths[x], by: in paths[y])
        }
    }
    return false
}

/// BinderCalls.cs:1326 Overlap (renamed: declare.byn has an `overlap`): whether a path of `a` is a prefix of (or equal
/// to) a path of `b`, or the other way round.
bool t34Overlap(in List<List<string>> a, by in List<List<string>> b) {
    for x in a {
        for y in b {
            let n = x.length < y.length ? x.length : y.length
            var same = true
            for k in 0..n {
                if x[k] != y[k] {
                    same = false
                    break
                }
            }
            return true if same
        }
    }
    return false
}

/// The C# `BoundMemberStep` record, as a key that is equal exactly when the records are (OwningPaths' path element).
string t34StepKey(in BMemberStep s) {
    var builtin = "-"
    if (s.builtin is { } m) {
        builtin = $"{m}"
    }
    return $"s{s.field},{s.propertyId},{s.tupleIndex},{builtin},{s.type}"
}

List<string> t34StepKeys(in List<BMemberStep> path) {
    var keys = List<string>()
    for s in path {
        keys.append(t34StepKey(in s))
    }
    return keys
}

/// C# `a.Concat(b).ToArray()` of two paths.
List<string> t34Concat(in List<string> a, by in List<string> b) {
    var joined = List<string>()
    for x in a {
        joined.append(x)
    }
    for x in b {
        joined.append(x)
    }
    return joined
}

/// BinderCalls.cs:1334 OwningPaths: the paths from `p`'s input to each binding of a unique type: member steps
/// (`t34StepKey`), and `v{variant},{index}` for union elements.
List<List<string>> owningPaths(ref Ctx c, for BPattern p) {
    var paths = List<List<string>>()
    let i = boundIndex(p)
    switch boundKind(p) {
        case .bindPattern:
            let l = c.bBindPatterns[i].local
            if l != -1 && isUnique(ref c, for: c.locals[l].type) {
                paths.append(List<string>())
            }
        case .notPattern:
            let operand = c.bNotPatterns[i].operand
            return owningPaths(ref c, for: operand)
        case .binaryPattern:
            let left = c.bBinaryPatterns[i].left
            let right = c.bBinaryPatterns[i].right
            let l = owningPaths(ref c, for: left)
            let r = owningPaths(ref c, for: right)
            for q in l {
                paths.append(t34Concat(in q, by: in List<string>()))
            }
            for q in r {
                paths.append(t34Concat(in q, by: in List<string>()))
            }
        case .propertyPattern:
            let d = c.bPropertyPatterns[i].designation
            if d != -1 && isUnique(ref c, for: c.locals[d].type) {
                paths.append(List<string>())
            }
            for n in 0..c.bPropertyPatterns[i].subpatterns.length {
                let prefix = t34StepKeys(in c.bPropertyPatterns[i].subpatterns[n].path)
                let sub = c.bPropertyPatterns[i].subpatterns[n].pattern
                let qs = owningPaths(ref c, for: sub)
                for q in qs {
                    paths.append(t34Concat(in prefix, by: in q))
                }
            }
        case .unionPattern:
            let d = c.bUnionPatterns[i].designation
            if d != -1 && isUnique(ref c, for: c.locals[d].type) {
                paths.append(List<string>())
            }
            let variant = c.bUnionPatterns[i].variant
            for n in 0..c.bUnionPatterns[i].subpatterns.length {
                let sub = c.bUnionPatterns[i].subpatterns[n]
                let qs = owningPaths(ref c, for: sub)
                var head = List<string>()
                head.append($"v{variant},{n}")
                for q in qs {
                    paths.append(t34Concat(in head, by: in q))
                }
            }
        default: {}
    }
    return paths
}

/// BinderCalls.cs:1347 GuardBindings: marks the bindings of an owning switch arm read-only inside its `when` guard (BYN2791).
void guardBindings(ref Ctx c, for BPattern p, at TextSpan guard) {
    let i = boundIndex(p)
    switch boundKind(p) {
        case .bindPattern:
            let l = c.bBindPatterns[i].local
            if l != -1 {
                c.locals[l].guardSpan = guard
            }
        case .notPattern:
            let operand = c.bNotPatterns[i].operand
            guardBindings(ref c, for: operand, at: guard)
        case .binaryPattern:
            let left = c.bBinaryPatterns[i].left
            let right = c.bBinaryPatterns[i].right
            guardBindings(ref c, for: left, at: guard)
            guardBindings(ref c, for: right, at: guard)
        case .propertyPattern:
            let d = c.bPropertyPatterns[i].designation
            if d != -1 {
                c.locals[d].guardSpan = guard
            }
            for n in 0..c.bPropertyPatterns[i].subpatterns.length {
                let sub = c.bPropertyPatterns[i].subpatterns[n].pattern
                guardBindings(ref c, for: sub, at: guard)
            }
        case .unionPattern:
            let d = c.bUnionPatterns[i].designation
            if d != -1 {
                c.locals[d].guardSpan = guard
            }
            for n in 0..c.bUnionPatterns[i].subpatterns.length {
                let sub = c.bUnionPatterns[i].subpatterns[n]
                guardBindings(ref c, for: sub, at: guard)
            }
        default: {}
    }
}

/// BinderCalls.cs:1373 CheckGuardWrite: reports a write at `span` to an owning switch binding, or a part of it, inside
/// its arm's guard.
bool checkGuardWrite(ref Binder b, through ref Ctx c, for BExpr target, at TextSpan span, by string why) {
    let l = writtenLocal(ref c, for: target)
    return false if l == -1
    if (c.locals[l].guardSpan is { } g) {
        return false if span.start < g.start || span.end > g.end
        report(
            ref b,
            through: ref c,
            for: .owningBindingMutatedInGuard,
            at: span,
            by: (c.locals[l].name, "", "", "", ""),
            label: why,
            help: "read it in the guard and change it in the arm's body",
        )
        return true
    }
    return false
}

/// BinderCalls.cs:1381 HasBindings.
bool hasBindings(ref Ctx c, for BPattern p) {
    let i = boundIndex(p)
    switch boundKind(p) {
        case .bindPattern: return c.bBindPatterns[i].local != -1
        case .notPattern:
            let operand = c.bNotPatterns[i].operand
            return hasBindings(ref c, for: operand)
        case .binaryPattern:
            let left = c.bBinaryPatterns[i].left
            let right = c.bBinaryPatterns[i].right
            return hasBindings(ref c, for: left) || hasBindings(ref c, for: right)
        case .propertyPattern:
            return true if c.bPropertyPatterns[i].designation != -1
            for n in 0..c.bPropertyPatterns[i].subpatterns.length {
                let sub = c.bPropertyPatterns[i].subpatterns[n].pattern
                return true if hasBindings(ref c, for: sub)
            }
            return false
        case .unionPattern:
            return true if c.bUnionPatterns[i].designation != -1
            for n in 0..c.bUnionPatterns[i].subpatterns.length {
                let sub = c.bUnionPatterns[i].subpatterns[n]
                return true if hasBindings(ref c, for: sub)
            }
            return false
        default: return false
    }
}

/// BinderCalls.cs:1396 BindUnionPattern: `.Circle(let r)` or `Shape.Circle(let r)` at `span`; `owner` is the written
/// union, or -1. `binding` is the `c` of `.Circle c`: the whole value, narrowed to the variant.
BPattern bindUnionPattern(
    ref Binder b,
    through ref Ctx c,
    at NodeSyntax syntax,
    as Type input,
    from Type owner,
    by TextSpan name,
    for in List<parser.Pattern> elements,
    to TextSpan? binding = null
) {
    let span = syntax.span
    let text = t15Text(in c, from: b.file, at: name)
    var target = unwrap(ref c, for: input)
    var own = owner
    var variant: VariantId = -1
    let states = statesUnion(ref c, for: input)
    if states != -1 {
        // A struct with states matches like its states union; `Order.paid(…)` names the struct as the owner.
        let of = stateStruct(ref c, for: target)
        if own != -1 && stateStruct(ref c, for: own) != -1 && stateStruct(ref c, for: own) == of {
            own = unionTypeOf(states)
        }
        target = unionTypeOf(states)
        if (own == -1 || own == unionTypeOf(states)) && findUnionVariant(ref c, by: states, for: text) == -1 {
            report(
                ref b,
                through: ref c,
                for: .unknownState,
                at: name,
                by: (c.structs[of].name, text, "", "", ""),
                help: $"check the states declared in `{c.structs[of].name}`",
            )
            own = errorType()
        }
    }
    let shown = own != -1 ? own : target
    if own != -1 && !isError(own) && !isError(target) && own != target {
        report(
            ref b,
            through: ref c,
            for: .patternMismatch,
            at: span,
            by: ($"`{typeDisplay(ref c, by: own)}.{text}`", typeDisplay(ref c, by: target), "", "", ""),
        )
    } else if kindOf(shown) == .unionType {
        let u = typeIndex(shown)
        variant = findUnionVariant(ref c, by: u, for: text)
        if variant == -1 {
            var names = List<string>()
            for v in c.unions[u].variants {
                names.append(c.unionVariants[v].name)
            }
            if (suggest(text, by: in names) is { } close) {
                report(
                    ref b,
                    through: ref c,
                    for: .unknownUnionVariant,
                    at: name,
                    by: (text, c.unions[u].name, "", "", ""),
                    help: $"did you mean `{close}`?",
                )
            } else {
                report(
                    ref b,
                    through: ref c,
                    for: .unknownUnionVariant,
                    at: name,
                    by: (text, c.unions[u].name, "", "", ""),
                )
            }
        } else if binding is not null {
            return bindWholeVariant(
                ref b,
                through: ref c,
                at: syntax,
                as: input,
                from: target,
                by: variant,
                to: binding,
            )
        } else if c.unionVariants[variant].fields.length == 0 {
            let vn = c.unionVariants[variant].name
            report(
                ref b,
                through: ref c,
                for: .variantHasNoPayload,
                at: span,
                by: (vn, "", "", "", ""),
                help: $"match it with `.{vn}`",
            )
        } else if elements.length != c.unionVariants[variant].fields.length {
            let vn = c.unionVariants[variant].name
            var list = StrBuf()
            var first = true
            for f in c.unionVariants[variant].fields {
                if !first {
                    list.append(", ")
                }
                list.append($"let {c.locals[f].name}")
                first = false
            }
            report(
                ref b,
                through: ref c,
                for: .variantPatternArity,
                at: span,
                by: (vn, $"{c.unionVariants[variant].fields.length}", $"{elements.length}", "", ""),
                help: $"list every field: `.{vn}({list.finish()})`, or `_` to skip one",
            )
        }
    } else if !isError(target) && kindOf(shown) != .error {
        report(
            ref b,
            through: ref c,
            for: .patternMismatch,
            at: span,
            by: ($"`.{text}(…)`", typeDisplay(ref c, by: target), "", "", ""),
        )
    }
    if binding is not null {
        let _ = declareLocal(ref b, through: ref c, at: binding, as: errorType(), for: .patternVariable)
    }
    let ok = variant != -1 && c.unionVariants[variant].fields.length == elements.length && elements.length > 0
    var subs = List<BPattern>()
    for i in 0..elements.length {
        let type = ok ? c.locals[c.unionVariants[variant].fields[i]].type : errorType()
        subs.append(bindPattern(ref b, through: ref c, for: in elements[i], as: type))
    }
    return recordNodeSyntaxOf(
        ref c,
        for: addUnionPattern(
            ref c,
            from: BUnionPattern { span: span, inputType: input, variant: variant, subpatterns: move subs },
        ),
        from: syntax,
    ) if ok
    return recordNodeSyntaxOf(
        ref c,
        for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
        from: syntax,
    )
}

/// BinderCalls.cs:1439 BindWholeVariant: `.percentOff p`, a tag test that binds the whole value as `p`, whose payload
/// fields read as `p.rate`.
BPattern bindWholeVariant(
    ref Binder b,
    through ref Ctx c,
    at NodeSyntax syntax,
    as Type input,
    from Type unionType,
    by VariantId variant,
    to TextSpan binding
) {
    let span = syntax.span
    // A state binds as its state type, `Order.paid`, whose payload fields read without a further check.
    let s = stateStruct(ref c, for: unwrap(ref c, for: input))
    let states = kindOf(unionType) == .unionType && s != -1 && statesOf(ref c, for: s) == typeIndex(unionType)
    var type = unionType
    if states {
        var vs = List<VariantId>()
        vs.append(variant)
        type = internState(ref c, by: s, for: in vs)
    }
    let local = declareLocal(ref b, through: ref c, at: binding, as: type, for: .patternVariable)
    c.locals[local].borrowsSubject = !b.patternOwns
    if !states {
        b.narrowed[local] = variant
    }
    return recordNodeSyntaxOf(
        ref c,
        for: addUnionPattern(
            ref c,
            from: BUnionPattern {
                span: span,
                inputType: input,
                variant: variant,
                subpatterns: List<BPattern>(),
                designation: local,
            },
        ),
        from: syntax,
    )
}

/// BinderCalls.cs:1449 RequireConstant.
void requireConstant(ref Binder b, through ref Ctx c, for BExpr value, at TextSpan span) {
    let k = boundKind(value)
    if exprConstant(in c, for: value) is null && !(k is .errorExpr or .errorVariant or .enumMember or .defaultValue) {
        report(
            ref b,
            through: ref c,
            for: .notConstant,
            at: span,
            by: ("a pattern", "", "", "", ""),
            help: "bind it with `var x` and compare in a `when` guard",
        )
    }
}

/// BinderCalls.cs:1455 BindConstantPattern.
BPattern bindConstantPattern(ref Binder b, through ref Ctx c, for in parser.ConstantPattern k, as Type input) {
    let syntax = NodeSyntax { kind: .constantPattern, span: k.span }
    let target = unwrap(ref c, for: input)
    switch k.value {
        case .rangeExpr(let r):
            var bounded = true
            switch r.value.start {
                case .none: bounded = false
                default: {}
            }
            switch r.value.end {
                case .none: bounded = false
                default: {}
            }
            if bounded {
                let start = bindConverted(ref b, through: ref c, for: in r.value.start, to: target)
                let end = bindConverted(ref b, through: ref c, for: in r.value.end, to: target)
                if !isError(target) && !(isInteger(target) || target == prim(.char)) {
                    report(
                        ref b,
                        through: ref c,
                        for: .patternMismatch,
                        at: k.span,
                        by: ("a range", typeDisplay(ref c, by: target), "", "", ""),
                    )
                }
                requireConstant(ref b, through: ref c, for: start, at: parser.exprSpan(in r.value.start))
                requireConstant(ref b, through: ref c, for: end, at: parser.exprSpan(in r.value.end))
                return recordNodeSyntaxOf(
                    ref c,
                    for: addRangePattern(
                        ref c,
                        from: BRangePattern {
                            span: k.span,
                            inputType: input,
                            start: start,
                            end: end,
                            inclusive: r.value.inclusive,
                        },
                    ),
                    from: syntax,
                )
            }
        case .literalExpr(let lit):
            if lit.value.kind == .nullKeyword {
                if kindOf(input) != .optional && !isError(input) {
                    report(
                        ref b,
                        through: ref c,
                        for: .patternMismatch,
                        at: k.span,
                        by: ("`null`", typeDisplay(ref c, by: input), "", "", ""),
                    )
                }
                let value = recordSyntaxNode(
                    ref c,
                    for: addDefault(ref c, from: BDefault { span: lit.value.span, type: input }),
                    at: syntaxOfLiteral(ref c, from: in lit.value),
                )
                return recordNodeSyntaxOf(
                    ref c,
                    for: addConstantPattern(
                        ref c,
                        from: BConstantPattern { span: k.span, inputType: input, value: value },
                    ),
                    from: syntax,
                )
            }
        case .targetMemberExpr(let tm):
            let states = statesUnion(ref c, for: input)
            if states != -1 {
                // `.paid` on a value with states: a tag test, whatever the state's payload.
                let text = t15Text(in c, from: b.file, at: tm.value.member)
                let state = findUnionVariant(ref c, by: states, for: text)
                return recordNodeSyntaxOf(
                    ref c,
                    for: addUnionPattern(
                        ref c,
                        from: BUnionPattern {
                            span: k.span,
                            inputType: input,
                            variant: state,
                            subpatterns: List<BPattern>(),
                        },
                    ),
                    from: syntax,
                ) if state != -1
                let of = stateStruct(ref c, for: target)
                report(
                    ref b,
                    through: ref c,
                    for: .unknownState,
                    at: tm.value.member,
                    by: (c.structs[of].name, text, "", "", ""),
                    help: $"check the states declared in `{c.structs[of].name}`",
                )
                return recordNodeSyntaxOf(
                    ref c,
                    for: addBindPattern(ref c, from: BBindPattern { span: k.span, inputType: input }),
                    from: syntax,
                )
            }
        default: {}
    }
    var isName = false
    switch k.value {
        case .nameExpr(_): isName = true
        default: {}
    }
    let tk = kindOf(target)
    var value: BExpr = -1
    if isName && (tk is .errorSet or .errorUnion) {
        value = bindExprOrType(ref b, through: ref c, for: in k.value)
    } else {
        value = bindExpr(ref b, through: ref c, for: in k.value, to: target)
    }
    return bindErrorSetPattern(
        ref b,
        through: ref c,
        at: syntax,
        as: input,
        from: typeIndex(c.bTypeRefs[boundIndex(value)].referenced),
        by: null,
    ) if boundKind(value) == .typeRef
        && kindOf(c.bTypeRefs[boundIndex(value)].referenced) == .errorSet
    if boundKind(value) == .typeRef {
        value = bindExpr(ref b, through: ref c, for: in k.value, to: target)
    }
    return recordNodeSyntaxOf(
        ref c,
        for: addUnionPattern(
            ref c,
            from: BUnionPattern {
                span: k.span,
                inputType: input,
                variant: c.bUnionNews[boundIndex(value)].variant,
                subpatterns: List<BPattern>(),
            },
        ),
        from: syntax,
    ) if boundKind(value) == .unionNew
        && c.bUnionNews[boundIndex(value)].payload.length == 0
        && (isError(target) || exprType(in c, for: value) == target)
    let isVariant = boundKind(value) == .errorVariant
    var foreign = false
    if isVariant && tk == .errorUnion {
        let ev = c.bErrorVariants[boundIndex(value)].variant
        let u = typeIndex(target)
        foreign = c.errorUnionTypes[u].sets.length > 0
            && (!listContains(in c.errorUnionTypes[u].sets, by: c.errorVariants[ev].set)
                || listContains(in c.errorUnionTypes[u].excluded, by: ev))
    }
    if foreign {
        let ev = c.bErrorVariants[boundIndex(value)].variant
        report(
            ref b,
            through: ref c,
            for: .patternMismatch,
            at: k.span,
            by: (
                $"`{typeDisplay(ref c, by: errorSetTypeOf(c.errorVariants[ev].set))}.{c.errorVariants[ev].name}`",
                typeDisplay(ref c, by: target),
                "",
                "",
                ""
            ),
        )
    } else if !(isVariant && tk == .errorUnion) {
        value = convert(ref b, through: ref c, for: value, to: target, at: parser.exprSpan(in k.value))
    }
    requireConstant(ref b, through: ref c, for: value, at: parser.exprSpan(in k.value))
    return recordNodeSyntaxOf(
        ref c,
        for: addConstantPattern(ref c, from: BConstantPattern { span: k.span, inputType: input, value: value }),
        from: syntax,
    )
}

/// BinderCalls.cs:1499 BindErrorSetPattern: `DbError` or `DbError e` (at `span`) in a `catch switch`: matches every
/// variant of `set` (an `or` of its variants), then binds the error as that set.
BPattern bindErrorSetPattern(
    ref Binder b,
    through ref Ctx c,
    at NodeSyntax syntax,
    as Type input,
    from ErrorSetId set,
    by TextSpan? name
) {
    let span = syntax.span
    let target = unwrap(ref c, for: input)
    let setType = errorSetTypeOf(set)
    var inUnion = false
    if kindOf(target) == .errorUnion {
        let u = typeIndex(target)
        inUnion = c.errorUnionTypes[u].sets.length == 0 || listContains(in c.errorUnionTypes[u].sets, by: set)
    }
    if !isError(target) && target != setType && !inUnion {
        report(
            ref b,
            through: ref c,
            for: .patternMismatch,
            at: span,
            by: ($"`{typeDisplay(ref c, by: setType)}`", typeDisplay(ref c, by: target), "", "", ""),
        )
    }
    var tested: BPattern = -1
    let variants = copyIds(in c.errorSets[set].variants)
    if variants.length == 0 {
        let none = recordNodeSyntaxOf(
            ref c,
            for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
            from: syntax,
        )
        tested = recordNodeSyntaxOf(
            ref c,
            for: addNotPattern(ref c, from: BNotPattern { span: span, inputType: input, operand: none }),
            from: syntax,
        )
    } else {
        for v in variants {
            let ev = recordNodeSyntaxOf(
                ref c,
                for: addErrorVariant(ref c, from: BErrorVariant { span: span, variant: v, type: setType }),
                from: syntax,
            )
            let one = recordNodeSyntaxOf(
                ref c,
                for: addConstantPattern(ref c, from: BConstantPattern { span: span, inputType: input, value: ev }),
                from: syntax,
            )
            tested = tested == -1 ? one : recordNodeSyntaxOf(
                ref c,
                for: addBinaryPattern(
                    ref c,
                    from: BBinaryPattern { span: span, inputType: input, isAnd: false, left: tested, right: one },
                ),
                from: syntax,
            )
        }
    }
    if name is not null {
        let local = declareLocal(ref b, through: ref c, at: name, as: setType, for: .patternVariable)
        let bind = recordNodeSyntaxOf(
            ref c,
            for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input, local: local }),
            from: syntax,
        )
        return recordNodeSyntaxOf(
            ref c,
            for: addBinaryPattern(
                ref c,
                from: BBinaryPattern { span: span, inputType: input, isAnd: true, left: tested, right: bind },
            ),
            from: syntax,
        )
    }
    return tested
}

/// BinderCalls.cs:1513 BindPropertyPattern.
BPattern bindPropertyPattern(ref Binder b, through ref Ctx c, for in parser.PropertyPattern pp, as Type input) {
    let valueType = unwrap(ref c, for: input)
    switch pp.type {
        case .none: {}
        default:
            let declared = resolveType(ref b, through: ref c, for: in pp.type)
            if !isError(declared) && !isError(valueType) && declared != valueType {
                report(
                    ref b,
                    through: ref c,
                    for: .patternMismatch,
                    at: parser.typeSpan(in pp.type),
                    by: ($"`{typeDisplay(ref c, by: declared)}`", typeDisplay(ref c, by: valueType), "", "", ""),
                    help: "remove the type; type patterns apply only to unions and `dyn` values, which arrive in a later version",
                )
            }
    }
    var subs = List<BSubpattern>()
    for sub in pp.properties {
        var steps = List<BMemberStep>()
        var current = valueType
        var ok = true
        for name in sub.path {
            if (resolveStep(ref b, through: ref c, for: current, at: name) is { } step) {
                current = step.type
                steps.append(step)
            } else {
                ok = false
                break
            }
        }
        let pattern = bindPattern(ref b, through: ref c, for: in sub.pattern, as: ok ? current : errorType())
        if ok {
            subs.append(BSubpattern { path: move steps, pattern: pattern })
        }
    }
    var designation: LocalId = -1
    if (pp.designation is { } d) {
        designation = declareLocal(ref b, through: ref c, at: d, as: valueType, for: .patternVariable)
    }
    if designation != -1 {
        c.locals[designation].borrowsSubject = !b.patternOwns
    }
    return recordNodeSyntax(
        ref c,
        for: addPropertyPattern(
            ref c,
            from: BPropertyPattern {
                span: pp.span,
                inputType: input,
                valueType: valueType,
                subpatterns: move subs,
                designation: designation,
            },
        ),
        as: .propertyPattern,
        at: pp.span,
    )
}

/// BinderCalls.cs:1547 ResolveStep.
BMemberStep? resolveStep(ref Binder b, through ref Ctx c, for Type type, at TextSpan name) {
    let text = t15Text(in c, from: b.file, at: name)
    let t = kindOf(type) == .state ? structTypeOf(c.stateTypes[typeIndex(type)].s) : type
    switch kindOf(t) {
        case .error: return null
        case .structType:
            let s = typeIndex(t)
            let f = findField(ref c, by: s, for: text)
            if f != -1 {
                checkAccess(ref b, through: ref c, for: c.fields[f].access, from: s, by: c.structs[s].module, at: name)
                return BMemberStep { field: f, type: c.fields[f].type }
            }
            let p = findProperty(ref c, by: s, for: text)
            if p != -1 {
                checkAccess(
                    ref b,
                    through: ref c,
                    for: c.properties[p].access,
                    from: s,
                    by: c.structs[s].module,
                    at: name,
                )
                return BMemberStep { propertyId: p, type: c.properties[p].type }
            }
        case .tuple:
            let i = tupleIndexOf(ref c, by: t, for: text)
            return BMemberStep { tupleIndex: i, type: c.tupleTypes[typeIndex(t)][i].type } if i >= 0
        case .optional:
            report(
                ref b,
                through: ref c,
                for: .memberOfOptional,
                at: name,
                by: (text, typeDisplay(ref c, by: t), "", "", ""),
                help: "match the value first: `{ } v`",
            )
            return null
        default: {}
    }
    if (builtinProperty(ref c, for: type, by: text) is { } bp) {
        return BMemberStep {
            builtin: bp.member,
            type: propertyType(ref b, through: ref c, for: bp.member, as: bp.type),
        }
    }
    return null if reportRenamed(ref b, through: ref c, for: type, at: name)
    let hint = memberSuggestion(ref c, for: type, by: text)
    report(
        ref b,
        through: ref c,
        for: .unknownMember,
        at: name,
        by: (text, typeDisplay(ref c, by: type), "", "", ""),
        help: hint ?? "",
    )
    return null
}
