// Declarations A. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 347–928 and 1075–1459 by content:
// the compilation unit, `DocOf`, modifiers, `ParseDeclaration`, attributes and `because`, the delegate
// alias, the declaration-start scans, type params, imports, structs with their states and requires
// rules, the struct `ParseBody(string, …)` site, bases, `where`, and functions with their clauses,
// particles, params, receivers and refinements. Owner:
//
// A C# method that returns one node kind returns its struct, so the caller sets `doc` and `attributes`
// (the C# `decl with { … }`) before wrapping it in `Owned`. A C# overload gets the suffix `With`
// (`parseParamsWith`). Helpers owned by sibling files that have no stub yet are called through the
// `T4` stand-ins at the end of this file (Q445).

public CompilationUnit parseCompilationUnit(ref Parser p) uses alloc {
    var members = List<Decl>()
    while !p.atEnd() {
        let start = p.pos
        let errors = p.syntaxErrors
        if p.kind() == .closeBrace {
            let _ = p.report(
                .expected,
                at: spanOf(p.current()),
                arg0: "a declaration or statement",
                arg1: p.describe(p.current()),
                help: "remove this `}`; it has no matching `{`",
            )
            let _ = p.advance()
            continue
        }
        let decl = parseDeclaration(ref p, topLevel: true, for: null)
        unless decl is .none {
            members.append(move decl)
        }
        recoverIfNeeded(ref p, from: errors)
        if p.pos == start {
            let _ = p.advance()
        }
    }
    return CompilationUnit { span: TextSpan { start: 0, length: p.lexed.source.length }, members: move members }
}

string? docOf(ref Parser p, for Token token) {
    unless token.hasDoc {
        return null
    }
    return $"{decodeDoc(p.lexed.source.bytes.span[token.docStart..token.docStart + token.docLength])}"
}

Modifiers parseModifiers(ref Parser p) {
    var modifiers = modifierNone
    while true {
        var flag = p.kind() switch {
            .publicKeyword   => modifierPublic,
            .privateKeyword  => modifierPrivate,
            .staticKeyword   => modifierStatic,
            .readonlyKeyword => modifierReadonly,
            .requiredKeyword => modifierRequired,
            .uniqueKeyword   => modifierUnique,
            .externKeyword   => modifierExtern,
            .unsafeKeyword   => modifierUnsafe,
            _                => modifierNone,
        }
        // `const` starts a statement at module level unless it modifies a declaration.
        if p.kind() == .constKeyword && isTypeThenName(ref p, at: p.pos + 1)
                && p.kindAt(scanType(ref p, at: p.pos + 1) + 1) != .equals
                && !endsBefore(ref p, at: scanType(ref p, at: p.pos + 1) + 1) {
            flag = modifierConst
        }
        return modifiers if flag == modifierNone
        if (modifiers & flag) != 0 {
            let _ = p.report(
                .modifierNotAllowed,
                at: spanOf(p.current()),
                arg0: p.textOf(p.current()),
                help: "remove the repeated modifier",
            )
        }
        modifiers |= flag
        let _ = p.advance()
    }
}

void rejectModifiers(ref Parser p, for Modifiers modifiers, by Modifiers allowed, at i64 start) {
    let bad = modifiers & ~allowed
    return if bad == modifierNone
    // Point at the first offending keyword.
    for i in start..p.pos {
        let token = p.lexed.tokens[i]
        let flag = token.kind switch {
            .publicKeyword   => modifierPublic,
            .privateKeyword  => modifierPrivate,
            .staticKeyword   => modifierStatic,
            .readonlyKeyword => modifierReadonly,
            .requiredKeyword => modifierRequired,
            .constKeyword    => modifierConst,
            .uniqueKeyword   => modifierUnique,
            .externKeyword   => modifierExtern,
            .unsafeKeyword   => modifierUnsafe,
            _                => modifierNone,
        }
        if (bad & flag) != 0 {
            let _ = p.report(.modifierNotAllowed, at: spanOf(token), arg0: p.textOf(token))
            return
        }
    }
}

/// `.none` is the C# `null`; `structName` is the enclosing struct's name, or null (Q448).
Decl parseDeclaration(ref Parser p, bool topLevel, for TextSpan? structName) {
    let first = p.current()
    var doc = docOf(ref p, for: first)
    let startIndex = p.pos
    let start = first.start
    let attributes = parseAttributes(ref p)
    if doc is null {
        doc = docOf(ref p, for: p.current())
    }
    let modifiers = parseModifiers(ref p)
    let outerExtern = p.inExtern
    if (modifiers & modifierExtern) != 0 {
        p.inExtern = true
    }

    let kind = p.kind()
    var decl: Decl = .none
    if kind == .importKeyword && topLevel {
        rejectModifiers(ref p, for: modifiers, by: modifierNone, at: startIndex)
        var d = parseImport(ref p, at: start)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.importDecl(Owned(move d))
    } else if kind == .structKeyword {
        rejectModifiers(
            ref p,
            for: modifiers,
            by: modifierPublic | modifierPrivate | modifierReadonly | modifierUnique,
            at: startIndex,
        )
        for i in startIndex..p.pos {
            if p.lexed.tokens[i].kind == .uniqueKeyword {
                reportKeywordOrder(ref p, from: p.lexed.tokens[i], to: p.current(), as: "struct unique")
            }
        }
        var d = parseStruct(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.structDecl(Owned(move d))
    } else if kind == .unionKeyword && p.peek(1) == .errorKeyword && isName(p.peek(2))
            || kind == .errorKeyword
            && (p.peek(1) == .enumKeyword || p.peek(1) == .unionKeyword || p.peek(1) == .setKeyword) {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        decl = parseErrorUnion(ref p, at: start, by: modifiers, through: move attributes, doc: doc)
    } else if kind == .enumKeyword && topLevel {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        var d = parseEnum(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.enumDecl(Owned(move d))
    } else if kind == .unionKeyword && topLevel {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        var d = parseUnion(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.unionDecl(Owned(move d))
    } else if kind == .interfaceKeyword && topLevel {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        var d = parseInterface(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.interfaceDecl(Owned(move d))
    } else if kind == .extensionKeyword && topLevel {
        rejectModifiers(ref p, for: modifiers, by: modifierNone, at: startIndex)
        var d = parseExtension(ref p, at: start)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.extensionDecl(Owned(move d))
    } else if kind == .typeKeyword && p.peek(1) == .identifier && p.peek(2) == .equals
            || (kind is .typeKeyword or .distinctKeyword)
            && (p.peek(1) == .distinctKeyword || p.peek(1) == .typeKeyword)
            && p.peek(1) != kind && isName(p.peek(2)) && p.peek(3) == .equals {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        var d = parseTypeAlias(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.typeAliasDecl(Owned(move d))
    } else if kind == .effectKeyword && topLevel && isName(p.peek(1)) && p.peek(2) == .equals {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        var d = parseEffect(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.effectDecl(Owned(move d))
    } else if kind == .testKeyword && topLevel && modifiers == modifierNone {
        var d = parseTest(ref p, at: start)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.testDecl(Owned(move d))
    } else if kind == .delegateKeyword {
        let keyword = p.advance()
        let signature = p.pos
        while p.kind() != .semicolon && p.kind() != .openBrace && p.kind() != .closeBrace && p.kind() != .endOfFile
                && !breaksLine(ref p, at: p.pos) {
            let _ = p.advance()
        }
        let _ = p.accept(.semicolon)
        let span = TextSpan.fromBounds(keyword.start, until: p.prevEnd)
        var aliasType = "(Param) -> Result"
        let alias = delegateAlias(ref p, at: signature, to: ref aliasType)
        let aliasName = alias ?? "Name"
        if alias is null {
            let _ = p.report(
                .delegateDecl,
                at: span,
                arg0: aliasName,
                arg1: aliasType,
                label: "a C# delegate",
                help: $"declare it as `type {aliasName} = {aliasType}`",
            )
        } else {
            let _ = p.reportFix(
                .delegateDecl,
                at: span,
                through: span,
                by: $"type {aliasName} = {aliasType}",
                arg0: aliasName,
                arg1: aliasType,
                label: "a C# delegate",
                help: $"declare it as `type {aliasName} = {aliasType}`",
            )
        }
    } else if structName is not null
            && kind == .identifier
            && p.textOf(p.current()) == p.lexed.source.getText(structName)
            && p.peek(1) == .openParen {
        rejectModifiers(ref p, for: modifiers, by: modifierPublic | modifierPrivate, at: startIndex)
        var d = parseConstructor(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.constructorDecl(Owned(move d))
    } else if isFunctionStart(ref p) || isNameFirstFunctionStart(ref p, allowNoBody: false) {
        rejectModifiers(
            ref p,
            for: modifiers,
            by: modifierPublic | modifierPrivate | modifierStatic | modifierUnsafe,
            at: startIndex,
        )
        var d = parseFunction(ref p, at: start, by: modifiers)
        d.doc = doc
        d.attributes = move attributes
        decl = Decl.functionDecl(Owned(move d))
    } else if structName is not null {
        decl = parseFieldOrProperty(ref p, at: start, by: modifiers, through: move attributes, doc: doc)
    } else if modifiers != modifierNone {
        let _ = p.report(
            .expected,
            at: spanOf(p.current()),
            arg0: "a declaration after the modifiers",
            arg1: p.describe(p.current()),
        )
    } else {
        let statement = parseStatement(ref p)
        let span = stmtSpan(in statement)
        decl = Decl.globalStatement(
            Owned(GlobalStatement { span: span, statement: move statement, doc: doc, attributes: move attributes }),
        )
    }
    p.inExtern = outerExtern
    return decl
}

bool isAttributeStart(ref Parser p) =>
    p.kind() == .at && isName(p.peek(1))
    || p.kind() == .openBracket && p.peek(1) == .identifier && (p.peek(2) == .openParen || p.peek(2) == .closeBracket)

/// `@name` or `@name(args)`, each with an optional `because "…"`, repeated; the names are checked by
/// the compiler. `[Name(args)]` is the BYN1045 input form, kept under its source name (Q446).
List<AttributeSyntax> parseAttributes(ref Parser p) {
    var attributes = List<AttributeSyntax>()
    unless isAttributeStart(ref p) {
        return attributes
    }
    while isAttributeStart(ref p) {
        let start = p.current().start
        let bracket = p.advance().kind == .openBracket
        let name = expectName(ref p, what: "an attribute name")
        let argsStart = p.current().start
        var args = List<Argument>()
        if p.kind() == .openParen && (bracket || !breaksLine(ref p, at: p.pos)) {
            args = parseArguments(ref p)
        }
        let argsText = p.prevEnd > argsStart ? p.lexed.source.getText(
            TextSpan.fromBounds(argsStart, until: p.prevEnd),
        ) : ""
        var nameText = p.lexed.source.getText(name)
        if bracket {
            let _ = p.expect(.closeBracket)
            let camel = $"{nameText.runes.take(1).lowercased()}{nameText.runes.skip(1)}"
            let span = p.spanFrom(start)
            let _ = p.reportFix(
                .bracketAttribute,
                at: TextSpan { start: start, length: 1 },
                through: span,
                by: $"@{camel}{argsText}",
                arg0: $"{nameText}{argsText}",
                arg1: $"{camel}{argsText}",
                help: "write the attribute with `@` and a camelCase name",
            )
            nameText = camel
        }
        let span = p.spanFrom(start)
        var becauseClause: BecauseClause? = null
        unless bracket {
            becauseClause = parseBecause(ref p, for: $"@{nameText}", at: span)
        }
        var expose = false
        for i in 0..args.length {
            if args[i].name is null {
                switch args[i].value {
                    case .nameExpr(let n):
                        if p.lexed.source.getText(n.value.name) == "expose" {
                            expose = true
                        }
                    default:
                        continue
                }
            }
        }
        if becauseClause is null && !bracket && (nameText == "allow" || nameText == "json" && expose) {
            reportMissingBecause(ref p, for: nameText == "json" ? $"@{nameText}(expose)" : $"@{nameText}", at: span)
        }
        attributes.append(AttributeSyntax { span: span, name: name, args: move args, becauseKeyword: becauseClause })
    }
    return attributes
}

/// An optional `because "reason"` on the line of an attribute or a call (J6); an empty reason is BYN8001.
BecauseClause? parseBecause(ref Parser p, for string construct, at TextSpan constructSpan) {
    return null if p.kind() != .becauseKeyword || breaksLine(ref p, at: p.pos)
    let start = p.advance().start
    if p.kind() != .stringLiteral {
        let _ = p.report(
            .expected,
            at: spanOf(p.current()),
            arg0: "the reason as a string literal",
            arg1: p.describe(p.current()),
        )
        return null
    }
    let literal = p.advance()
    let reason = $"{decodeString(p.text(literal))}"
    if reason.trimmed().isEmpty {
        reportMissingBecause(ref p, for: construct, at: constructSpan)
    }
    return BecauseClause { span: p.spanFrom(start), reason: reason }
}

/// `@name` or `@name(args)` before a statement (R7), each with its `because "…"`; only `@unobservable`
/// may come there (BYN1069), and it needs a reason (BYN8001). Every attribute is kept.
List<AttributeSyntax> parseStatementAttributes(ref Parser p) {
    var attributes = List<AttributeSyntax>()
    while p.kind() == .at && isName(p.peek(1)) {
        let start = p.advance().start
        let name = expectName(ref p, what: "an attribute name")
        var args = List<Argument>()
        if p.kind() == .openParen && !breaksLine(ref p, at: p.pos) {
            args = parseArguments(ref p)
        }
        let span = p.spanFrom(start)
        let nameText = p.lexed.source.getText(name)
        let becauseClause = parseBecause(ref p, for: $"@{nameText}", at: span)
        if nameText != "unobservable" {
            let _ = p.report(
                .statementAttribute,
                at: span,
                arg0: $"@{nameText}",
                label: "before a statement",
                help: "remove the attribute; only `@unobservable` may come before a statement",
            )
        } else if becauseClause is null {
            reportMissingBecause(ref p, for: $"@{nameText}", at: span)
        }
        attributes.append(AttributeSyntax { span: span, name: name, args: move args, becauseKeyword: becauseClause })
    }
    return attributes
}

void reportMissingBecause(ref Parser p, for string construct, at TextSpan span) {
    let _ = p.report(
        .missingBecause,
        at: span,
        arg0: construct,
        label: "bypasses a safety rule",
        help: "explain the bypass in a `because` clause",
    )
}

/// The alias name of the C# delegate signature `R Name(A a, B b)` from token `index` to the current
/// one, its function type in `type`, or null when the line is not that signature (generic, or with
/// parameter modifiers). The C# returns the pair as a tuple.
string? delegateAlias(ref Parser p, at i64 index, to ref string type) {
    let returnEnd = scanType(ref p, at: index)
    return null if returnEnd < 0 || !isName(p.kindAt(returnEnd)) || p.kindAt(returnEnd + 1) != .openParen
    var types = List<string>()
    var loneFunction = false
    var i = returnEnd + 2
    if p.kindAt(i) != .closeParen {
        while true {
            let scanned = scanTypeNested(ref p, at: i, nested: false)
            let typeEnd = scanned.end
            loneFunction = scanned.function
            return null if typeEnd < 0 || !isName(p.kindAt(typeEnd))
            types.append(tokensText(ref p, from: i, to: typeEnd))
            i = typeEnd + 1
            break if p.kindAt(i) != .comma
            i += 1
        }
    }
    return null if p.kindAt(i) != .closeParen
    i += 1
    return null if i != p.pos && !(p.kindAt(i) == .semicolon && i + 1 == p.pos)
    // A lone tuple type keeps its own parentheses inside the parameter list's, and a lone function type needs them
    // since `->` is right-associative.
    var parameters = StrBuf()
    if types.length == 1 && !types[0].startsWith("(") && !loneFunction {
        parameters.append(types[0])
    } else {
        parameters.append("(")
        for k in 0..types.length {
            if k > 0 {
                parameters.append(", ")
            }
            parameters.append(types[k])
        }
        parameters.append(")")
    }
    type = $"{parameters.finish()} -> {tokensText(ref p, from: index, to: returnEnd)}"
    return p.textOf(p.lexed.tokens[returnEnd])
}

/// The source text of tokens `start` up to, not including, `end`.
string tokensText(ref Parser p, from i64 start, to i64 end) =>
    p.lexed.source.getText(TextSpan.fromBounds(p.lexed.tokens[start].start, until: p.lexed.tokens[end - 1].end))

bool isTypeThenName(ref Parser p, at i64 index) {
    let after = scanType(ref p, at: index)
    return after > 0 && isName(p.kindAt(after))
}

bool isFunctionStart(ref Parser p) {
    let after = skipFailsShorthand(ref p, at: scanType(ref p, at: p.pos))
    return false if after <= 0 || !isName(p.kindAt(after))
    if p.kindAt(after + 1) == .less {
        let close = scanTypeArgs(ref p, at: after + 1)
        return p.kindAt(close) == .openParen if close > 0
    }
    return p.kindAt(after + 1) == .openParen
}

/// The input form `f(…) -> T`, or `f(…)` with no return type before `{` or `fails` on its line
/// (BYN1043); with `allowNoBody` (an interface member) only the `->` form.
bool isNameFirstFunctionStart(ref Parser p, bool allowNoBody) {
    unless isName(p.kind()) {
        return false
    }
    var open = p.pos + 1
    if p.kindAt(open) == .less {
        open = scanTypeArgs(ref p, at: open)
    }
    return false if open <= 0 || p.kindAt(open) != .openParen
    let close = matchingClose(ref p, at: open)
    return false if close < 0
    let next = close + 1
    return true if p.kindAt(next) == .arrow
    return !allowNoBody && !p.lexed.tokens[next < p.count - 1 ? next : p.count - 1].hasNewlineBefore
        && (p.kindAt(next) == .openBrace || p.kindAt(next) == .failsKeyword)
}

/// Whether `name:` starts at `index`: the input form `name: Type` of a declaration (BYN1043).
bool isNameThenType(ref Parser p, at i64 index) => isName(p.kindAt(index)) && p.kindAt(index + 1) == .colon

/// The input form `name: Type` of a parameter, field or payload (BYN1043); the fix writes `Type name`.
/// Returns the name, the type in `type` (the C# tuple).
TextSpan parseNameThenType(ref Parser p, to ref TypeSyntax type) {
    let name = spanOf(p.advance())
    let _ = p.advance()
    type = parseType(ref p)
    let span = TextSpan.fromBounds(name.start, until: p.prevEnd)
    let typeText = p.lexed.source.getText(typeSpan(in type))
    let nameText = p.lexed.source.getText(name)
    let _ = p.reportFix(
        .typeNameOrder,
        at: span,
        through: span,
        by: $"{typeText} {nameText}",
        arg0: $"{nameText}: {typeText}",
        arg1: $"{typeText} {nameText}",
        label: "name before type",
        help: "put the type before the name; declarations are type-first",
    )
    return name
}

/// Past the input form `!E` or `!(A, B)` after a return type at `index`, if any.
i64 skipFailsShorthand(ref Parser p, at i64 index) {
    return index if index <= 0 || p.kindAt(index) != .bang
    var i = index + 1
    return skipErrorType(ref p, at: i) if p.kindAt(i) != .openParen
    i = skipErrorType(ref p, at: i + 1)
    while i > 0 && p.kindAt(i) == .comma {
        i = skipErrorType(ref p, at: i + 1)
    }
    return i > 0 && p.kindAt(i) == .closeParen ? i + 1 : -1
}

/// Past an error type at `index`: a name with optional type arguments and `?` (not valid after `fails`, but still the input form).
i64 skipErrorType(ref Parser p, at i64 index) {
    var i = skipQualifiedName(ref p, at: index)
    if i > 0 && p.kindAt(i) == .less {
        i = scanTypeArgs(ref p, at: i)
    }
    if i > 0 && p.kindAt(i) == .question {
        i += 1
    }
    return i
}

/// Past `a.b.c` at `index`, or -1 if no name starts there.
i64 skipQualifiedName(ref Parser p, at i64 index) {
    unless isName(p.kindAt(index)) {
        return -1
    }
    var i = index
    while p.kindAt(i + 1) == .dot && isName(p.kindAt(i + 2)) {
        i += 2
    }
    return i + 1
}

/// `<T, U>` after a declaration name, or nothing.
List<TextSpan> parseTypeParams(ref Parser p) {
    var names = List<TextSpan>()
    return names if p.kind() != .less
    let _ = p.advance()
    names.append(expectName(ref p, what: "a type parameter name"))
    while p.accept(.comma) {
        names.append(expectName(ref p, what: "a type parameter name"))
    }
    let _ = p.expect(.greater)
    return names
}

ImportDecl parseImport(ref Parser p, at i64 start) {
    let _ = p.advance()
    var path = List<TextSpan>()
    path.append(expectName(ref p, what: "a module name"))
    while p.accept(.dot) {
        path.append(expectName(ref p, what: "a module name"))
    }
    var alias: TextSpan? = null
    if p.accept(.asKeyword) {
        alias = expectName(ref p, what: "an alias")
    }
    expectEnd(ref p)
    return ImportDecl { span: p.spanFrom(start), path: move path, alias: alias }
}

/// The C# `ItName` set.
List<string> itName() {
    var names = List<string>()
    names.append("it")
    return names
}

StructDecl parseStruct(ref Parser p, at i64 start, by Modifiers modifiers) {
    let _ = p.advance()
    var mods = modifiers
    if p.accept(.uniqueKeyword) {
        mods |= modifierUnique
    }
    let name = expectName(ref p, what: "a struct name")
    let typeParams = parseTypeParams(ref p)
    let bases = parseBases(ref p)
    let where = parseWhere(ref p)
    var rules = List<RequiresRule>()
    var states = List<UnionVariant>()
    var hasStates = false
    // The C# `stateLines` pairs, as two lists.
    var stateKeywords = List<Token>()
    var stateLines = List<UnionVariant>()
    // The C# `ParseBody("struct", …)`, with the member callback inline.
    let open = p.expect(.openBrace)
    var members = List<Decl>()
    // The fields `parseFieldOrProperty` left unwrapped (Q819), and the index in `members` each one takes.
    var fieldDecls = List<FieldDecl>()
    var fieldSlots = List<i64>()
    while p.kind() != .closeBrace && !p.atEnd() {
        let before = p.pos
        let errors = p.syntaxErrors
        if atContextual(ref p, as: "states") && p.peek(1) == .openBrace {
            let keyword = p.current()
            let block = parseStatesBlock(ref p, for: p.lexed.source.getText(name))
            if !hasStates {
                states = move block
                hasStates = true
            } else {
                let _ = p.report(
                    .duplicateDeclaration,
                    at: spanOf(keyword),
                    arg0: "states",
                    label: "a second `states` block",
                    help: "declare every state in the first `states` block",
                )
            }
        } else if atContextual(ref p, as: "state")
                && isName(p.peek(1))
                && (p.peek(2) == .openParen || endsBefore(ref p, at: p.pos + 2)) {
            let keyword = p.advance()
            let stateStart = p.current().start
            let stateName = expectName(ref p, what: "a state name")
            let payload = parsePayload(ref p, for: stateName)
            let stateDoc = docOf(ref p, for: keyword)
            stateKeywords.append(keyword)
            stateLines.append(
                UnionVariant { span: p.spanFrom(stateStart), name: stateName, fields: move payload, doc: stateDoc },
            )
            expectEnd(ref p)
        } else if p.kind() != .requiresKeyword {
            p.collectField = true
            let member = parseDeclaration(ref p, topLevel: false, for: name)
            p.collectField = false
            if p.collectedFields.length > 0 {
                fieldDecls.append(p.collectedFields.removeLast())
                fieldSlots.append(members.length)
                members.append(.none)
            } else {
                unless member is .none {
                    members.append(move member)
                }
            }
        } else {
            rules.append(parseRequiresRule(ref p))
            expectEnd(ref p)
        }
        recoverIfNeeded(ref p, from: errors)
        if p.pos == before {
            let _ = p.advance()
        }
    }
    expectClose(ref p, from: open, for: "struct")
    if stateLines.length > 0 {
        reportStateLines(ref p, from: in stateKeywords, for: in stateLines, by: hasStates)
    }
    // O3: a field's rule that names another field, or has `at .f`, belongs to the struct; one that also reads `it` is BYN3218.
    var fields = List<string>()
    for f in fieldDecls {
        fields.append(p.lexed.source.getText(f.name))
    }
    let itName = itName()
    var fieldsLeft = List<FieldDecl>()
    while fieldDecls.length > 0 {
        fieldsLeft.append(fieldDecls.removeLast())
    }
    for slot in fieldSlots {
        var field = fieldsLeft.removeLast()
        var pending = List<RequiresRule>()
        while field.requiresClauses.length > 0 {
            pending.append(field.requiresClauses.removeLast())
        }
        while pending.length > 0 {
            let rule = pending.removeLast()
            let names = namesAny(ref p, for: in rule, from: in fields)
            if names && namesAny(ref p, for: in rule, from: in itName) {
                let _ = p.report(
                    .requiresMixesFields,
                    at: rule.span,
                    help: "split it: an `it` rule under the field, and a struct-level rule with `at .field`",
                )
            } else if rule.at is null && !names {
                field.requiresClauses.append(move rule)
            } else {
                rules.append(move rule)
            }
        }
        members[slot] = Decl.fieldDecl(Owned(move field))
    }
    // The C# `rules.OrderBy(r => r.Span.Start)`: stable, so the earliest of equal starts first.
    var sorted = List<RequiresRule>()
    while rules.length > 0 {
        var best: i64 = 0
        for k in 1..rules.length {
            if rules[k].span.start < rules[best].span.start {
                best = k
            }
        }
        var after = List<RequiresRule>()
        while rules.length > best + 1 {
            after.append(rules.removeLast())
        }
        sorted.append(rules.removeLast())
        while after.length > 0 {
            rules.append(after.removeLast())
        }
    }
    // `states` then the state lines, in order.
    var reversed = List<UnionVariant>()
    while stateLines.length > 0 {
        reversed.append(stateLines.removeLast())
    }
    while reversed.length > 0 {
        states.append(reversed.removeLast())
    }
    return StructDecl {
        span: p.spanFrom(start),
        modifiers: mods,
        name: name,
        members: move members,
        typeParams: move typeParams,
        bases: move bases,
        where : move where,
        rules: move sorted,
        states: move states,
    }
}

/// `states { a  b(T x) }`: one state per line, each with an optional named payload (J58).
List<UnionVariant> parseStatesBlock(ref Parser p, for string structName) {
    let _ = p.advance()
    let open = p.expect(.openBrace)
    var states = List<UnionVariant>()
    var commas = List<Token>()
    while isName(p.kind()) {
        let doc = docOf(ref p, for: p.current())
        let stateStart = p.current().start
        let state = expectName(ref p, what: "a state name")
        let payload = parsePayload(ref p, for: state)
        states.append(UnionVariant { span: p.spanFrom(stateStart), name: state, fields: move payload, doc: doc })
        unless nextCase(ref p, to: ref commas) {
            break
        }
    }
    while p.kind() == .semicolon {
        let semicolon = p.advance()
        reportSemicolon(ref p, for: semicolon)
    }
    var cases = List<TextSpan>()
    for i in 0..states.length {
        cases.append(states[i].span)
    }
    reportCaseCommas(ref p, for: structName, from: open, through: in cases, by: in commas)
    expectClose(ref p, from: open, for: "states block")
    expectEnd(ref p)
    return states
}

/// BYN1059 at each `state x` line (`keywords[i]` with `lines[i]`). Every line shares one fix: the lines
/// leave their places and one `states` block takes the place of the last, after the members between
/// them. No fix when the struct already has a block, or a line shares its line with other code.
void reportStateLines(ref Parser p, from in List<Token> keywords, for in List<UnionVariant> lines, by bool hasBlock) {
    var starts = List<i64>()
    var ends = List<i64>()
    var all = true
    for i in 0..lines.length {
        var end: i64 = -1
        let segmentStart = segment(ref p, from: keywords[i], for: in lines[i], to: ref end)
        if segmentStart < 0 {
            all = false
        }
        starts.append(segmentStart)
        ends.append(end)
    }
    var hasFix = false
    var fixSpan = TextSpan { start: 0, length: 0 }
    var block = StrBuf()
    if !hasBlock && all {
        let indent = indentAt(ref p, at: keywords[0].start)
        for i in 0..starts.length - 1 {
            block.append(p.lexed.source.getText(TextSpan.fromBounds(ends[i], until: starts[i + 1])))
        }
        block.append(indent)
        block.append("states {\n")
        for i in 0..lines.length {
            block.append(indent)
            block.append("    ")
            block.append(p.lexed.source.getText(lines[i].span))
            block.append("\n")
        }
        block.append(indent)
        block.append("}\n")
        fixSpan = TextSpan.fromBounds(starts[0], until: ends[ends.length - 1])
        hasFix = true
    }
    let fix = block.finish()
    for i in 0..lines.length {
        let span = TextSpan.fromBounds(keywords[i].start, until: lines[i].span.end)
        let text = p.lexed.source.getText(lines[i].span)
        if hasFix {
            let _ = p.reportFix(
                .stateLineInput,
                at: span,
                through: fixSpan,
                by: fix,
                arg0: text,
                label: "the input form",
                help: "move each state into the struct's `states` block",
            )
        } else {
            let _ = p.report(
                .stateLineInput,
                at: span,
                arg0: text,
                label: "the input form",
                help: "move each state into the struct's `states` block",
            )
        }
    }
}

/// The C# local `Segment`: the whole line of each `state x`, through its line break, as its start with
/// its end in `end`; -1 when other code or a comment shares the line.
i64 segment(ref Parser p, from Token keyword, for in UnionVariant state, to ref i64 end) {
    end = -1
    let start = p.lexed.source.getLineSpan(p.lexed.source.getLineIndex(keyword.start)).start
    for i in start..keyword.start {
        let b = p.lexed.source.bytes[i]
        return -1 if b != ' ' && b != '\t'
    }
    for i in state.span.end..p.lexed.source.bytes.length {
        let b = p.lexed.source.bytes[i]
        if b == '\n' {
            end = i + 1
            return start
        }
        return -1 if b != ' ' && b != '\t' && b != '\r'
    }
    return -1
}

/// Whether `rule`'s condition names one of `fields` (not after a `.`).
bool namesAny(ref Parser p, for in RequiresRule rule, from in List<string> fields) {
    let span = exprSpan(in rule.condition)
    var i = tokenAt(ref p, at: span.start)
    while i < p.count && p.lexed.tokens[i].start < span.end {
        let token = p.lexed.tokens[i]
        if token.kind == .identifier && p.kindAt(i - 1) != .dot {
            let text = p.textOf(token)
            for k in 0..fields.length {
                return true if fields[k] == text
            }
        }
        i += 1
    }
    return false
}

/// The index of the first token starting at or after `offset`.
i64 tokenAt(ref Parser p, at i64 offset) {
    var lo: i64 = 0
    var hi = p.count
    while lo < hi {
        let mid = (lo + hi) / 2
        if p.lexed.tokens[mid].start < offset {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

/// `requires condition`, or `requires condition at .field`; `it` is the value checked, and a bare
/// `value` is the BYN1050 input form.
RequiresRule parseRequiresRule(ref Parser p) {
    let start = p.advance().start
    let first = p.pos
    let condition = parseExpression(ref p)
    for i in first..p.pos {
        let token = p.lexed.tokens[i]
        if token.kind == .identifier && p.textOf(token) == "value" && p.kindAt(i - 1) != .dot {
            let _ = p.reportFix(
                .requiresValue,
                at: spanOf(token),
                through: spanOf(token),
                by: "it",
                label: "the input form",
                help: "rename `value` to `it`",
            )
        }
    }
    var field: TextSpan? = null
    if atContextual(ref p, as: "at") && !breaksLine(ref p, at: p.pos) && p.peek(1) == .dot {
        let _ = p.advance()
        let _ = p.advance()
        field = expectName(ref p, what: "a field name")
    }
    return RequiresRule { span: p.spanFrom(start), condition: move condition, at: field }
}

/// `: I, J` after a type's name, or nothing.
List<TypeSyntax> parseBases(ref Parser p) {
    var bases = List<TypeSyntax>()
    unless p.accept(.colon) {
        return bases
    }
    bases.append(parseNamedType(ref p))
    while p.accept(.comma) {
        bases.append(parseNamedType(ref p))
    }
    return bases
}

/// `where T : IA, IB`, repeated, or nothing.
List<WhereClause> parseWhere(ref Parser p) {
    var clauses = List<WhereClause>()
    while atContextual(ref p, as: "where") {
        let start = p.advance().start
        let param = expectName(ref p, what: "a type parameter name")
        let _ = p.expect(.colon)
        var bounds = List<TypeSyntax>()
        bounds.append(parseNamedType(ref p))
        while p.accept(.comma) {
            bounds.append(parseNamedType(ref p))
        }
        clauses.append(WhereClause { span: p.spanFrom(start), param: param, bounds: move bounds })
    }
    return clauses
}

/// A signature clause of `parseFunction`: the C# `(int Rank, Token Keyword, int End)`.
struct SignatureClause {
    i64   rank
    Token keyword
    i64   end
}

FunctionDecl parseFunction(ref Parser p, at i64 start, by Modifiers modifiers, bool allowNoBody = false) {
    let nameFirst = !isFunctionStart(ref p)
    var returnType: TypeSyntax = .none
    unless nameFirst {
        returnType = parseType(ref p)
    }
    let typeEnd = p.prevEnd
    var shorthand = List<TypeSyntax>()
    let bang = p.current()
    if !nameFirst && p.accept(.bang) {
        if p.accept(.openParen) {
            shorthand.append(parseType(ref p))
            while p.accept(.comma) {
                shorthand.append(parseType(ref p))
            }
            let _ = p.expect(.closeParen)
        } else {
            shorthand.append(parseType(ref p))
        }
    }
    let shorthandEnd = p.prevEnd
    let name = expectName(ref p)
    let typeParams = parseTypeParams(ref p)
    let paramsStart = p.current().end
    var refThis: TextSpan? = null
    var moveThis: TextSpan? = null
    var receiverStates = List<TextSpan>()
    let parameters = parseParamsWith(ref p, to: ref refThis, through: ref moveThis, for: ref receiverStates)
    let paramsEnd = p.prevEnd
    if nameFirst {
        returnType = parseNameFirstReturn(ref p, for: name, at: paramsEnd)
    }
    var where = List<WhereClause>()
    var requiresList = List<Expr>()
    var becomes: TextSpan? = null
    // The C# `fails` clause as its span and errors, built after the shorthand is merged in.
    var failsSpan: TextSpan? = null
    var failsErrors = List<TypeSyntax>()
    // The errors of the `fails` clauses before the last, in source order (the C# `allFails` less the last clause's).
    var earlierFails = List<TypeSyntax>()
    var usesClause: UsesClause? = null
    var clauses = List<SignatureClause>()
    reportRemovedEffects(ref p)
    while true {
        let keyword = p.current()
        var rank: i64 = 0
        if atContextual(ref p, as: "where") {
            rank = 0
            var more = parseWhere(ref p)
            var back = List<WhereClause>()
            while more.length > 0 {
                back.append(more.removeLast())
            }
            while back.length > 0 {
                where.append(back.removeLast())
            }
        } else if atContextual(ref p, as: "expects") || p.kind() == .requiresKeyword {
            rank = 1
            let _ = p.advance()
            if keyword.kind == .requiresKeyword {
                let _ = p.reportFix(
                    .requiresOnFunction,
                    at: spanOf(keyword),
                    through: spanOf(keyword),
                    by: "expects",
                    label: "the input form",
                    help: "use `expects` for a precondition; `requires` is checked at construction",
                )
            }
            // The C# `WithoutLambdas(ParseBareCondition)`.
            let saved = p.setNoLambda(value: true)
            let condition = parseBareCondition(ref p)
            p.noLambda = saved
            requiresList.append(move condition)
        } else if atContextual(ref p, as: "becomes") && p.peek(1) == .dot {
            rank = 3
            let _ = p.advance()
            let _ = p.advance()
            becomes = expectName(ref p, what: "a state name")
        } else if p.kind() == .failsKeyword {
            rank = 4
            let failsStart = p.advance().start
            var errors = List<TypeSyntax>()
            if p.kind() == .identifier
                    && !breaksLine(ref p, at: p.pos)
                    && !atContextual(ref p, as: "where")
                    && !atContextual(ref p, as: "expects")
                    && !(atContextual(ref p, as: "becomes") && p.peek(1) == .dot) {
                errors.append(parseType(ref p))
                while p.accept(.comma) {
                    errors.append(parseType(ref p))
                }
            }
            failsSpan = p.spanFrom(failsStart)
            var back = List<TypeSyntax>()
            while failsErrors.length > 0 {
                back.append(failsErrors.removeLast())
            }
            while back.length > 0 {
                earlierFails.append(back.removeLast())
            }
            failsErrors = move errors
        } else if p.kind() == .usesKeyword {
            rank = 2
            let usesStart = p.advance().start
            var effects = List<TextSpan>()
            effects.append(expectName(ref p, what: "an effect name"))
            while p.accept(.comma) {
                effects.append(expectName(ref p, what: "an effect name"))
            }
            usesClause = UsesClause { span: p.spanFrom(usesStart), effects: move effects }
        } else {
            break
        }
        clauses.append(SignatureClause { rank: rank, keyword: keyword, end: p.prevEnd })
        reportRemovedEffects(ref p)
    }
    reportClauseOrder(ref p, for: in clauses)
    if shorthand.length > 0 {
        // `T!E f() fails F` keeps both sets; the fix rewrites the header through the explicit clause.
        // The shorthand's types then each clause's, the first of each text kept (the C# `DistinctBy`).
        var queue = List<TypeSyntax>()
        while failsErrors.length > 0 {
            queue.append(failsErrors.removeLast())
        }
        while earlierFails.length > 0 {
            queue.append(earlierFails.removeLast())
        }
        while shorthand.length > 0 {
            queue.append(shorthand.removeLast())
        }
        var all = List<TypeSyntax>()
        var texts = List<string>()
        while queue.length > 0 {
            let t = queue.removeLast()
            let text = p.lexed.source.getText(typeSpan(in t))
            var seen = false
            for k in 0..texts.length {
                if texts[k] == text {
                    seen = true
                }
            }
            unless seen {
                texts.append(text)
                all.append(move t)
            }
        }
        var joined = StrBuf()
        for k in 0..texts.length {
            if k > 0 {
                joined.append(", ")
            }
            joined.append(texts[k])
        }
        let errors = joined.finish()
        // `fails` takes error type names (spec §8): `E?` and `Result<E>` get no fix rather than a wrong one.
        var plain = true
        for k in 0..all.length {
            switch all[k] {
                case .namedType(let n):
                    if n.value.args.length > 0 {
                        plain = false
                    }
                default:
                    plain = false
            }
        }
        let at = TextSpan.fromBounds(bang.start, until: shorthandEnd)
        // The text before each clause (the C# `Lead`).
        var leads = List<string>()
        for k in 0..clauses.length {
            let from = k == 0 ? paramsEnd : clauses[k - 1].end
            leads.append(p.lexed.source.getText(TextSpan.fromBounds(from, until: clauses[k].keyword.start)))
        }
        var firstFails: i64 = -1
        for k in 0..clauses.length {
            if firstFails < 0 && clauses[k].rank == 4 {
                firstFails = k
            }
        }
        // A comment in the shorthand, in a `fails` list or before a later `fails` has no place in the rewrite: no fix rather than a lost comment.
        var kept = !p.lexed.source.getText(TextSpan.fromBounds(typeEnd, until: name.start)).contains("/")
        for k in 0..clauses.length {
            if clauses[k].rank == 4 {
                if p.lexed.source
                        .getText(TextSpan.fromBounds(clauses[k].keyword.start, until: clauses[k].end))
                        .contains("/") {
                    kept = false
                }
                if k != firstFails && leads[k].contains("/") {
                    kept = false
                }
            }
        }
        if plain && kept {
            // `fails` is the last clause (BYN1065): the header keeps the other clauses before it, each with the text before it.
            let end = clauses.length > 0 ? clauses[clauses.length - 1].end : paramsEnd
            var header = StrBuf()
            header.append(p.lexed.source.getText(TextSpan.fromBounds(name.start, until: paramsEnd)))
            for rank in 0..4 {
                for k in 0..clauses.length {
                    if clauses[k].rank == rank {
                        header.append(leads[k])
                        header.append(
                            p.lexed.source.getText(
                                TextSpan.fromBounds(clauses[k].keyword.start, until: clauses[k].end),
                            ),
                        )
                    }
                }
            }
            header.append(firstFails < 0 ? " " : leads[firstFails])
            let headerText = header.finish()
            let _ = p.reportFix(
                .failsShorthand,
                at: at,
                through: TextSpan.fromBounds(typeEnd, until: end),
                by: $" {headerText}fails {errors}",
                label: "the input form",
                help: $"write `fails {errors}` as the last clause of the signature",
            )
        } else if plain {
            let _ = p.report(
                .failsShorthand,
                at: at,
                label: "the input form",
                help: $"write `fails {errors}` as the last clause of the signature",
            )
        } else {
            let _ = p.report(
                .failsShorthand,
                at: at,
                label: "the input form",
                help: "write the error types in a `fails` clause, the last clause of the signature",
            )
        }
        if failsSpan is null {
            failsSpan = at
        }
        failsErrors = move all
    }
    var failsClause: FailsClause? = null
    let clauseSpan = failsSpan
    if clauseSpan is not null {
        failsClause = FailsClause { span: clauseSpan, errors: move failsErrors }
    }
    var body: Stmt = .none
    var expressionBody: Expr = .none
    if p.kind() == .openBrace {
        // Parser.cs: ParseFunction (a body's depth counts from 0)
        let outer = p.blockDepth
        p.blockDepth = -1
        body = parseBlock(ref p)
        p.blockDepth = outer
        lintFunctionLength(ref p, at: stmtSpan(in body))
    } else if p.accept(.fatArrow) {
        expressionBody = parseExpression(ref p)
        expectEnd(ref p)
    } else if allowNoBody && endsBefore(ref p, at: p.pos) {
        expectEnd(ref p)
    } else {
        let _ = p.expect(.openBrace)
    }
    return FunctionDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        returnType: move returnType,
        name: name,
        params: move parameters,
        failsKeyword: move failsClause,
        body: move body,
        expressionBody: move expressionBody,
        typeParams: move typeParams,
        refThis: refThis,
        moveThis: moveThis,
        receiverStates: move receiverStates,
        paramsStart: paramsStart,
        requiresClauses: move requiresList,
        where : move where,
        becomes: becomes,
        usesKeyword: move usesClause,
    }
}

/// BYN1065 at the first signature clause that follows one of a later rank (`where`, `expects`,
/// `uses`, `becomes`, `fails`); the fix sorts the clauses and keeps the gaps between them.
void reportClauseOrder(ref Parser p, for in List<SignatureClause> clauses) {
    for i in 1..clauses.length {
        var before: i64 = -1
        for k in 0..i {
            if before < 0 && clauses[k].rank > clauses[i].rank {
                before = k
            }
        }
        continue if before < 0
        var texts = List<string>()
        for k in 0..clauses.length {
            texts.append(p.lexed.source.getText(TextSpan.fromBounds(clauses[k].keyword.start, until: clauses[k].end)))
        }
        // The texts in rank order, stable (the C# `OrderBy`).
        var sorted = List<string>()
        for rank in 0..5 {
            for k in 0..clauses.length {
                if clauses[k].rank == rank {
                    sorted.append(texts[k])
                }
            }
        }
        var sb = StrBuf()
        sb.append(sorted[0])
        for k in 1..clauses.length {
            sb.append(p.lexed.source.getText(TextSpan.fromBounds(clauses[k - 1].end, until: clauses[k].keyword.start)))
            sb.append(sorted[k])
        }
        let moved = p.textOf(clauses[i].keyword)
        let earlier = p.textOf(clauses[before].keyword)
        let _ = p.reportFix(
            .clauseOrder,
            at: spanOf(clauses[i].keyword),
            through: TextSpan.fromBounds(clauses[0].keyword.start, until: clauses[clauses.length - 1].end),
            by: sb.finish(),
            arg0: moved,
            arg1: earlier,
            label: "out of order",
            help: $"move `{moved}` before `{earlier}`",
        )
        return
    }
}

/// The particle that leads a parameter (`to ref Span<u8> dst`): `for`, `as`, or a word followed by a
/// passing mode or by a type and a name. A word that is not a particle is BYN5008.
/// The C# `Particles` set.
List<string> particles() {
    var words = List<string>()
    words.append("from")
    words.append("to")
    words.append("until")
    words.append("through")
    words.append("at")
    words.append("by")
    words.append("for")
    words.append("as")
    return words
}

TextSpan? parseParticle(ref Parser p) {
    if p.kind() != .forKeyword && p.kind() != .asKeyword {
        return null if p.kind() != .identifier || p.textOf(p.lexed.tokens[p.pos]) == "dyn"
        let next = p.peek(1)
        if next != .refKeyword && next != .moveKeyword && next != .outKeyword && next != .inKeyword
                && !isTypeThenName(ref p, at: p.pos + 1) {
            return null
        }
    }
    let word = spanOf(p.advance())
    let text = p.lexed.source.getText(word)
    let particles = particles()
    for k in 0..particles.length {
        return word if particles[k] == text
    }
    let _ = p.report(
        .unknownParticle,
        at: word,
        arg0: text,
        label: "not a particle",
        help: "choose one of `from`, `to`, `until`, `through`, `at`, `by`, `for`, `as`",
    )
    return null
}

/// The removed effect words `noalloc`, `nosuspend` and `suspends` after a signature (BYN6001); the fix deletes each.
void reportRemovedEffects(ref Parser p) {
    while p.kind() == .noallocKeyword || p.kind() == .nosuspendKeyword || p.kind() == .suspendsKeyword {
        let word = p.advance()
        let text = p.textOf(word)
        let _ = p.reportFix(
            .noallocRemoved,
            at: spanOf(word),
            through: TextSpan.fromBounds(p.lexed.tokens[p.pos - 2].end, until: word.end),
            by: "",
            arg0: text,
            label: "removed",
            help: $"remove `{text}`",
        )
    }
}

/// The return type of the input form `f(…) -> T`, or `void` when none is written (BYN1043); the fix
/// moves it before the name. The `void` is a path of one empty name at the name's start (Q446).
TypeSyntax parseNameFirstReturn(ref Parser p, for TextSpan name, at i64 paramsEnd) {
    let header = p.lexed.source.getText(TextSpan.fromBounds(name.start, until: paramsEnd))
    let nameText = p.lexed.source.getText(name)
    if p.kind() == .arrow {
        let arrow = p.advance()
        let type = parseType(ref p)
        let typeText = p.lexed.source.getText(typeSpan(in type))
        let _ = p.reportFix(
            .typeNameOrder,
            at: spanOf(arrow),
            through: TextSpan.fromBounds(name.start, until: p.prevEnd),
            by: $"{typeText} {header}",
            arg0: $"{nameText}(…) -> {typeText}",
            arg1: $"{typeText} {nameText}(…)",
            label: "return type after the parameters",
            help: "put the return type before the name",
        )
        return type
    }
    let at = TextSpan { start: name.start, length: 0 }
    let _ = p.reportFix(
        .typeNameOrder,
        at: name,
        through: at,
        by: "void ",
        arg0: $"{nameText}(…)",
        arg1: $"void {nameText}(…)",
        label: "no return type",
        help: "put `void` before the name when the function returns nothing",
    )
    var path = List<TextSpan>()
    path.append(at)
    return TypeSyntax.namedType(Owned(NamedType { span: at, path: move path, args: List<TypeSyntax>() }))
}

List<Param> parseParams(ref Parser p) {
    var refThis: TextSpan? = null
    var moveThis: TextSpan? = null
    var receiverStates = List<TextSpan>()
    return parseParamsWith(ref p, to: ref refThis, through: ref moveThis, for: ref receiverStates, allowRefThis: false)
}

/// A member's parameters; `ref this` is accepted only first (BYN2117) and returned in `refThis`, a
/// first `move this` in `moveThis`. A first receiver `this is .s`, `ref this is .s` or `move this is .s`
/// returns its states in `receiverStates`; a bare `this` is BYN1061.
List<Param> parseParamsWith(
    ref Parser p,
    to ref TextSpan? refThis,
    through ref TextSpan? moveThis,
    for ref List<TextSpan> receiverStates,
    bool allowRefThis = true
) {
    refThis = null
    moveThis = null
    receiverStates = List<TextSpan>()
    let _ = p.expect(.openParen)
    var list = List<Param>()
    if p.kind() != .closeParen {
        // The C# `do … while (Accept(Comma))`; each C# `continue` ends its branch.
        while true {
            let start = p.current().start
            let first = list.length == 0 && refThis is null && moveThis is null && receiverStates.length == 0
            if allowRefThis && p.kind() == .refKeyword && p.kindAt(p.pos + 1) == .thisKeyword {
                let _ = p.advance()
                let _ = p.advance()
                let span = p.spanFrom(start)
                if list.length > 0 || refThis is not null || moveThis is not null {
                    let _ = p.report(
                        .refThisNotFirst,
                        at: span,
                        label: "after other parameters",
                        help: "move `ref this` to the start of the parameter list",
                    )
                }
                if refThis is null {
                    refThis = span
                }
                if list.length == 0 && receiverStates.length == 0 {
                    receiverStates = parseReceiverState(ref p)
                }
            } else if allowRefThis && first && p.kind() == .moveKeyword && p.kindAt(p.pos + 1) == .thisKeyword {
                let _ = p.advance()
                let _ = p.advance()
                moveThis = p.spanFrom(start)
                receiverStates = parseReceiverState(ref p)
            } else if allowRefThis && first && p.kind() == .thisKeyword && p.kindAt(p.pos + 1) == .isKeyword {
                let _ = p.advance()
                receiverStates = parseReceiverState(ref p)
            } else if allowRefThis
                    && first
                    && p.kind() == .thisKeyword
                    && (p.kindAt(p.pos + 1) == .comma || p.kindAt(p.pos + 1) == .closeParen) {
                let self = p.advance()
                // `this, a` loses `this, `; `(this)` loses `this`.
                let to = p.kind() == .comma ? p.peekToken(1).start : self.end
                let _ = p.reportFix(
                    .receiverWithoutState,
                    at: spanOf(self),
                    through: TextSpan.fromBounds(self.start, until: to),
                    by: "",
                    label: "the default receiver",
                    help: "remove `this`, or add a state: `this is .s`",
                )
            } else {
                let rest = atContextual(ref p, as: "rest") && isTypeThenName(ref p, at: p.pos + 1)
                if rest {
                    let _ = p.advance()
                }
                if !rest && atContextual(ref p, as: "params") && isVariadicArray(ref p, at: p.pos + 1) {
                    list.append(parseParamsInput(ref p, at: start))
                } else {
                    var particle: TextSpan? = null
                    unless rest {
                        particle = parseParticle(ref p)
                    }
                    let modifier = p.kind() switch {
                        .refKeyword  => ParamModifier.refKeyword,
                        .moveKeyword => ParamModifier.moveKeyword,
                        .outKeyword  => ParamModifier.outKeyword,
                        .inKeyword   => ParamModifier.inKeyword,
                        _            => ParamModifier.none,
                    }
                    if modifier != .none {
                        let _ = p.advance()
                    }
                    var type: TypeSyntax = .none
                    var name = TextSpan { start: 0, length: 0 }
                    var ellipsis = false
                    if isNameThenType(ref p, at: p.pos) {
                        name = parseNameThenType(ref p, to: ref type)
                    } else {
                        type = parseType(ref p, fatArrow: true, lists: true)
                        if p.kind() == .dotDot
                                && p.peek(1) == .dot
                                && !p.peekToken(1).hasTriviaBefore
                                && isName(p.peek(2)) {
                            list.append(parseEllipsisInput(ref p, at: start, from: move type))
                            type = .none
                            ellipsis = true
                        } else {
                            name = expectName(ref p, what: "a parameter name")
                        }
                    }
                    unless ellipsis {
                        let refined = parseRefinement(ref p, from: move type, name: name)
                        var defaultValue: Expr = .none
                        let hasDefault = p.accept(.equals)
                        if hasDefault {
                            defaultValue = parseExpression(ref p)
                        }
                        let span = p.spanFrom(start)
                        // `rest` is the last positional parameter; only named optional parameters may follow it (SPEC §10).
                        var afterRest = false
                        for k in 0..list.length {
                            if list[k].rest {
                                afterRest = true
                            }
                        }
                        if afterRest && (rest || !hasDefault) {
                            let _ = p.report(
                                .expected,
                                at: span,
                                arg0: "a named optional parameter after `rest`",
                                arg1: $"`{p.lexed.source.getText(span)}`",
                                label: rest ? "a second `rest` parameter" : "a positional parameter after `rest`",
                                help: rest
                                    ? "keep one `rest` parameter"
                                    : "give it a default value, or move it before the `rest` parameter",
                            )
                        }
                        list.append(Param {
                            span: span,
                            modifier: modifier,
                            type: move refined,
                            name: name,
                            defaultKeyword: move defaultValue,
                            particle: particle,
                            rest: rest,
                        })
                    }
                }
            }
            unless p.accept(.comma) {
                break
            }
        }
    }
    let _ = p.expect(.closeParen)
    return list
}

/// The `is .a or .b` after a receiver's `this`, if written.
List<TextSpan> parseReceiverState(ref Parser p) {
    return parseStateList(ref p) if p.accept(.isKeyword)
    return List<TextSpan>()
}

/// `.a or .b` after `is`: the states of a receiver or a refinement.
List<TextSpan> parseStateList(ref Parser p) {
    var states = List<TextSpan>()
    while true {
        let _ = p.expect(.dot)
        states.append(expectName(ref p, what: "a state name"))
        unless p.accept(.orKeyword) {
            break
        }
    }
    return states
}

/// `is .a or .b` after a parameter or field `name`, or after the type of a local annotation or alias,
/// where `name` is null (J57), wrapping `type`; one state is BYN7006, fixed to `T.s name` or `T.s`.
TypeSyntax parseRefinement(ref Parser p, from move TypeSyntax type, TextSpan? name = null) {
    return type if p.kind() != .isKeyword || p.peek(1) != .dot
    let keyword = p.advance()
    let states = parseStateList(ref p)
    let typeSpan = typeSpan(in type)
    if states.length == 1 {
        let typeText = p.lexed.source.getText(typeSpan)
        let stateText = nameText(ref p, at: states[0])
        let stateType = $"{typeText}.{stateText}"
        var written = typeText
        var rewrite = stateType
        if name is not null {
            let named = nameText(ref p, at: name)
            written = $"{typeText} {named}"
            rewrite = $"{stateType} {named}"
        }
        let _ = p.reportFix(
            .singleStateInline,
            at: spanOf(keyword),
            through: TextSpan.fromBounds(typeSpan.start, until: p.prevEnd),
            by: rewrite,
            arg0: written,
            arg1: stateText,
            arg2: rewrite,
            label: "one state",
            help: $"write the state type `{stateType}`",
        )
    }
    return TypeSyntax.refinedType(
        Owned(
            RefinedType {
                span: TextSpan.fromBounds(typeSpan.start, until: p.prevEnd),
                inner: move type,
                states: move states,
            },
        ),
    )
}

/// Whether `T[] name` starts at `index`: the C# `params` array.
bool isVariadicArray(ref Parser p, at i64 index) {
    let end = scanType(ref p, at: index)
    return end > 0 && p.kindAt(end) == .openBracket && p.kindAt(end + 1) == .closeBracket && isName(p.kindAt(end + 2))
}

/// `params T[] xs`, the BYN1058 input form for `rest ReadOnlySpan<T> xs`.
Param parseParamsInput(ref Parser p, at i64 start) {
    let keyword = p.advance()
    let element = parseType(ref p)
    let _ = p.advance()
    let _ = p.advance()
    let typeEnd = p.prevEnd
    let name = expectName(ref p, what: "a parameter name")
    return reportRestInput(ref p, at: start, through: spanOf(keyword), from: move element, until: typeEnd, for: name)
}

/// `T... xs`, the BYN1058 input form for `rest ReadOnlySpan<T> xs`; the parser is at the `...`.
Param parseEllipsisInput(ref Parser p, at i64 start, from move TypeSyntax element) {
    let dots = TextSpan.fromBounds(p.current().start, until: p.peekToken(1).end)
    let _ = p.advance()
    let _ = p.advance()
    let typeEnd = p.prevEnd
    let name = expectName(ref p, what: "a parameter name")
    return reportRestInput(ref p, at: start, through: dots, from: move element, until: typeEnd, for: name)
}

/// The rewritten type's name `ReadOnlySpan` is the span of the element and its brackets (Q446).
Param reportRestInput(
    ref Parser p,
    at i64 start,
    through TextSpan span,
    from move TypeSyntax element,
    until i64 typeEnd,
    for TextSpan name
) {
    let elementSpan = typeSpan(in element)
    let elementText = p.lexed.source.getText(elementSpan)
    let _ = p.reportFix(
        .restInput,
        at: span,
        through: TextSpan.fromBounds(start, until: typeEnd),
        by: $"rest ReadOnlySpan<{elementText}>",
        arg0: p.lexed.source.getText(TextSpan.fromBounds(start, until: name.end)),
        arg1: elementText,
        arg2: p.lexed.source.getText(name),
        label: "the input form",
        help: "declare the variadic parameter with `rest`",
    )
    let typeSpan = TextSpan.fromBounds(elementSpan.start, until: typeEnd)
    var path = List<TextSpan>()
    path.append(typeSpan)
    var args = List<TypeSyntax>()
    args.append(move element)
    let type = TypeSyntax.namedType(Owned(NamedType { span: typeSpan, path: move path, args: move args }))
    return Param {
        span: p.spanFrom(start),
        modifier: .none,
        type: move type,
        name: name,
        defaultKeyword: .none,
        rest: true,
    }
}

// ── T4 stand-ins (T15 deletes) ───────────────────────────────────────────────
// Stand-ins for helpers that sibling files own and that had no stub when T4 ran (Q445). Each keeps the
// C# name in camelCase and the C# parameter order; T15 deletes this struct and drops the `` prefix
// at every call, adjusting a call where the owner's signature differs. A short C# body is ported; a
// long one is a conservative stub, just enough for the T4 tests' inputs.
== parser/decls2.byn
// Declarations B. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines about 929–1740 by content:
// interfaces (`ParseInterface`, `ParseInterfaceMember`: associated types, getters), extensions,
// `ExpectClose`, fields and properties, `ParseRequiresLines`, constructors, error enums and sets, enums,
// unions with their payloads and case commas, type aliases, effects and tests. Owner:
//
// A C# method that returns one node kind returns its struct here, so the caller can set `doc` and
// `attributes` (the C# `decl with { … }`) before wrapping it in `Owned`; one that returns a `Decl` of
// several kinds takes them as parameters (Q451). The two `ParseBody(string, …)` sites are inlined.
// Helpers owned by sibling files that have no stub yet are called through the `T5` shims at the end
// of this file (Q450).

InterfaceDecl parseInterface(ref Parser p, at i64 start, by Modifiers modifiers) {
    let _ = p.advance()
    let name = expectName(ref p, what: "an interface name")
    let typeParams = parseTypeParams(ref p)
    let where = parseWhere(ref p)
    let open = p.expect(.openBrace)
    var members = List<Decl>()
    while p.kind() != .closeBrace && !p.atEnd() {
        let before = p.pos
        let errors = p.syntaxErrors
        let member = parseInterfaceMember(ref p)
        unless member is .none {
            members.append(move member)
        }
        recoverIfNeeded(ref p, from: errors)
        if p.pos == before {
            let _ = p.advance()
        }
    }
    expectClose(ref p, from: open, for: "interface")
    return InterfaceDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        members: move members,
        typeParams: move typeParams,
        where : move where,
    }
}

/// A method (abstract when the line ends after its header), `T name`, `T name => e` or `type Name`;
/// `T name { get }` is BYN1060. `.none` is the C# `null`.
Decl parseInterfaceMember(ref Parser p) {
    let first = p.current()
    var doc = docOf(ref p, for: first)
    let startIndex = p.pos
    let start = first.start
    let attributes = parseAttributes(ref p)
    if doc is null {
        doc = docOf(ref p, for: p.current())
    }
    let modifiers = parseModifiers(ref p)
    rejectModifiers(ref p, for: modifiers, by: modifierStatic, at: startIndex)

    let after = scanType(ref p, at: p.pos)
    if p.kind() == .typeKeyword && isName(p.peek(1)) && endsBefore(ref p, at: p.pos + 2) {
        let _ = p.advance()
        let name = expectName(ref p)
        expectEnd(ref p)
        return Decl.associatedTypeDecl(Owned(AssociatedTypeDecl {
            span: p.spanFrom(start),
            name: name,
            doc: doc,
            attributes: move attributes,
        }))
    }
    if isFunctionStart(ref p) || isNameFirstFunctionStart(ref p, allowNoBody: true) {
        var decl = parseFunction(ref p, at: start, by: modifiers, allowNoBody: true)
        decl.doc = doc
        decl.attributes = move attributes
        return Decl.functionDecl(Owned(move decl))
    }
    if after > 0 && isName(p.kindAt(after)) && p.kindAt(after + 1) == .openBrace {
        let type = parseType(ref p)
        let name = expectName(ref p)
        let open = p.expect(.openBrace)
        let get = atContextual(ref p, as: "get")
        if get {
            let _ = p.advance()
        } else {
            let _ = p.report(.expected, at: spanOf(p.current()), arg0: "`get`", arg1: p.describe(p.current()))
        }
        expectEnd(ref p)
        let _ = p.expect(.closeBrace)
        if get {
            let typeText = p.lexed.source.getText(typeSpan(in type))
            let _ = p.reportFix(
                .interfaceGetInput,
                at: TextSpan.fromBounds(open.start, until: p.prevEnd),
                through: TextSpan.fromBounds(name.end, until: p.prevEnd),
                by: "",
                arg0: typeText,
                arg1: p.lexed.source.getText(name),
                label: "the input form",
                help: "remove `{ get }`: a field-shaped interface member is a read-only property",
            )
        }
        return Decl.getterDecl(Owned(GetterDecl {
            span: p.spanFrom(start),
            modifiers: modifiers,
            type: move type,
            name: name,
            doc: doc,
            attributes: move attributes,
        }))
    }
    if after > 0 && isName(p.kindAt(after)) && endsBefore(ref p, at: after + 1) {
        let type = parseType(ref p)
        let name = expectName(ref p)
        expectEnd(ref p)
        return Decl.getterDecl(Owned(GetterDecl {
            span: p.spanFrom(start),
            modifiers: modifiers,
            type: move type,
            name: name,
            doc: doc,
            attributes: move attributes,
        }))
    }
    return parseFieldOrProperty(ref p, at: start, by: modifiers, through: move attributes, doc: doc) if after > 0
        && isName(p.kindAt(after))
        && p.kindAt(after + 1) == .fatArrow
    let _ = p.report(
        .expected,
        at: spanOf(p.current()),
        arg0: "a method, getter or `type Name`",
        arg1: p.describe(p.current()),
    )
    synchronize(ref p)
    return .none
}

/// `extension T : I { … }` or `extension T : I` alone on its line.
ExtensionDecl parseExtension(ref Parser p, at i64 start) {
    let _ = p.advance()
    let name = expectName(ref p, what: "a type name")
    let bases = parseBases(ref p)
    var members = List<Decl>()
    if p.kind() != .openBrace && endsBefore(ref p, at: p.pos) {
        expectEnd(ref p)
    } else {
        let open = p.expect(.openBrace)
        while p.kind() != .closeBrace && !p.atEnd() {
            let before = p.pos
            let errors = p.syntaxErrors
            let member = parseDeclaration(ref p, topLevel: false, for: name)
            unless member is .none {
                members.append(move member)
            }
            recoverIfNeeded(ref p, from: errors)
            if p.pos == before {
                let _ = p.advance()
            }
        }
        expectClose(ref p, from: open, for: "extension")
    }
    return ExtensionDecl { span: p.spanFrom(start), name: name, bases: move bases, members: move members }
}

void expectClose(ref Parser p, from Token open, for string what) {
    return if p.accept(.closeBrace)
    let line = p.lexed.source.getLinePosition(open.start).line
    let _ = p.report(
        .expected,
        at: spanOf(p.current()),
        arg0: "`}`",
        arg1: p.describe(p.current()),
        help: open.length > 0 ? $"close the {what} opened on line {line}" : "",
    )
}

Decl parseFieldOrProperty(
    ref Parser p,
    at i64 start,
    by Modifiers modifiers,
    through move List<AttributeSyntax> attributes,
    string? doc = null
) {
    // `parseStruct` sets it for its own member only; clear it so nothing nested collects.
    let collect = p.collectField
    p.collectField = false
    var type: TypeSyntax = .none
    var name = TextSpan { start: 0, length: 0 }
    if isNameThenType(ref p, at: p.pos) {
        name = parseNameThenType(ref p, to: ref type)
    } else if isTypeThenName(ref p, at: p.pos) {
        let parsed = parseType(ref p)
        name = expectName(ref p)
        type = parseRefinement(ref p, from: move parsed, name: name)
    } else {
        let _ = p.report(.expectedMember, at: spanOf(p.current()), arg0: p.describe(p.current()))
        synchronize(ref p)
        return Decl.globalStatement(Owned(GlobalStatement {
            span: p.spanFrom(start),
            statement: Stmt.errorStmt(Owned(ErrorStmt { span: p.spanFrom(start) })),
            doc: doc,
            attributes: move attributes,
        }))
    }
    if p.accept(.fatArrow) {
        let body = parseExpression(ref p)
        expectEnd(ref p)
        return Decl.propertyDecl(Owned(PropertyDecl {
            span: p.spanFrom(start),
            modifiers: modifiers,
            type: move type,
            name: name,
            body: move body,
            doc: doc,
            attributes: move attributes,
        }))
    }
    if p.kind() == .openBrace {
        // C# takes the span before it parses the block, so it ends at the name (Q511).
        let span = p.spanFrom(start)
        let block = parseBlock(ref p)
        return Decl.propertyDecl(Owned(PropertyDecl {
            span: span,
            modifiers: modifiers,
            type: move type,
            name: name,
            body: .none,
            block: move block,
            doc: doc,
            attributes: move attributes,
        }))
    }
    var init: Expr = .none
    if p.accept(.equals) {
        init = parseExpression(ref p)
    }
    var rules = parseRequiresLines(ref p)
    expectEnd(ref p)
    lintEmptyLiteral(ref p, for: type, by: init)
    var field = FieldDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        type: move type,
        name: name,
        defaultKeyword: move init,
        requiresClauses: move rules,
        doc: doc,
        attributes: move attributes,
    }
    // O3 (Q819): `parseStruct` splits the field's rules once it knows every field, then wraps it.
    if collect {
        p.collectedFields.append(move field)
        return .none
    }
    return Decl.fieldDecl(Owned(move field))
}

/// The `requires` rules of a field or type: on its line, then one per line with no blank line between.
List<RequiresRule> parseRequiresLines(ref Parser p) {
    var rules = List<RequiresRule>()
    while p.kind() == .requiresKeyword && !hasBlankLineBefore(ref p, at: p.pos) {
        rules.append(parseRequiresRule(ref p))
    }
    return rules
}

ConstructorDecl parseConstructor(ref Parser p, at i64 start, by Modifiers modifiers) {
    let name = spanOf(p.advance())
    let parameters = parseParams(ref p)
    let body = parseBlock(ref p)
    return ConstructorDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        params: move parameters,
        body: move body,
    }
}

Decl parseErrorUnion(
    ref Parser p,
    at i64 start,
    by Modifiers modifiers,
    through move List<AttributeSyntax> attributes,
    string? doc = null
) {
    let first = p.advance()
    let second = p.advance()
    if first.kind == .errorKeyword && second.kind != .setKeyword {
        reportKeywordOrder(ref p, from: first, to: second, as: "union error")
    }
    let name = expectName(ref p, what: "an error set name")
    if p.kind() == .equals || second.kind == .setKeyword {
        var set = parseErrorComposition(ref p, at: start, by: modifiers, from: first, through: second, for: name)
        set.doc = doc
        set.attributes = move attributes
        return Decl.errorSetDecl(Owned(move set))
    }
    let open = p.expect(.openBrace)
    var variants = List<ErrorVariant>()
    var cases = List<TextSpan>()
    var commas = List<Token>()
    while isName(p.kind()) || isAttributeStart(ref p) {
        let caseStart = p.current()
        let caseAttributes = parseAttributes(ref p)
        var caseDoc = docOf(ref p, for: caseStart)
        if caseDoc is null {
            caseDoc = docOf(ref p, for: p.current())
        }
        let variant = expectName(ref p, what: "a variant name")
        let fields = parsePayload(ref p, for: variant)
        variants.append(
            ErrorVariant {
                span: variant,
                name: variant,
                doc: caseDoc,
                attributes: move caseAttributes,
                fields: move fields,
            },
        )
        cases.append(TextSpan.fromBounds(caseStart.start, until: p.prevEnd))
        unless nextCase(ref p, to: ref commas) {
            break
        }
    }
    reportCaseCommas(ref p, for: p.lexed.source.getText(name), from: open, through: in cases, by: in commas)
    expectClose(ref p, from: open, for: "union error")
    return Decl.errorEnumDecl(Owned(ErrorEnumDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        variants: move variants,
        doc: doc,
        attributes: move attributes,
    }))
}

/// `union error Name = A, B`, optionally narrowed by `except .a, .b`. The round-2 `error set Name = A | B`
/// is the input form (BYN1029); its fix writes `union error` and `,` between the members.
ErrorSetDecl parseErrorComposition(
    ref Parser p,
    at i64 start,
    by Modifiers modifiers,
    from Token first,
    through Token second,
    for TextSpan name
) {
    let _ = p.expect(.equals)
    var members = List<TypeSyntax>()
    members.append(parseType(ref p))
    var pipes = List<TextSpan>()
    while p.kind() == .comma || p.kind() == .bar {
        let memberEnd = p.prevEnd
        if p.advance().kind == .bar {
            pipes.append(TextSpan.fromBounds(memberEnd, until: p.prevEnd))
        }
        members.append(parseType(ref p))
    }
    var exceptNames = List<TextSpan>()
    if p.kind() == .exceptKeyword {
        let _ = p.advance()
        let _ = p.expect(.dot)
        exceptNames.append(expectName(ref p, what: "a case name"))
        while p.kind() == .comma && p.peek(1) == .dot {
            let _ = p.advance()
            let _ = p.advance()
            exceptNames.append(expectName(ref p, what: "a case name"))
        }
    }
    if second.kind == .setKeyword || pipes.length > 0 {
        var text = StrBuf()
        text.append(
            second.kind == .setKeyword
                ? "union error"
                : p.lexed.source.getText(TextSpan.fromBounds(first.start, until: second.end)),
        )
        var at = second.end
        for pipe in pipes {
            text.append(p.lexed.source.getText(TextSpan.fromBounds(at, until: pipe.start)))
            text.append(",")
            at = pipe.end
        }
        text.append(p.lexed.source.getText(TextSpan.fromBounds(at, until: p.prevEnd)))
        let span = second.kind == .setKeyword ? TextSpan.fromBounds(first.start, until: second.end) : pipes[0]
        let _ = p.reportFix(
            .errorSetPipe,
            at: span,
            through: TextSpan.fromBounds(first.start, until: p.prevEnd),
            by: $"{text.finish()}",
            arg0: p.lexed.source.getText(name),
            label: "the input form",
            help: "write `union error`, with `,` between the members",
        )
    }
    expectEnd(ref p)
    return ErrorSetDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        members: move members,
        head: TextSpan.fromBounds(first.start, until: second.end),
        exceptNames: move exceptNames,
    }
}

/// BYN1044 for a modifier word before the declaration kind (`unique struct`, `distinct type`, `error enum`,
/// `error union`); the fix puts the kind first, keeping any words written between them.
void reportKeywordOrder(ref Parser p, from Token modifier, to Token kind, as string canonical) {
    let span = TextSpan.fromBounds(modifier.start, until: kind.end)
    var from = modifier.end
    while from < kind.start && isWhiteSpace(p.lexed.source.bytes[from]) {
        from += 1
    }
    let between = p.lexed.source.getText(TextSpan.fromBounds(from, until: kind.start))
    let _ = p.reportFix(
        .declarationKeywordOrder,
        at: span,
        through: span,
        by: $"{between}{canonical}",
        arg0: $"{p.textOf(modifier)} {p.textOf(kind)}",
        arg1: canonical,
        label: "the input form",
        help: $"put the kind first: `{canonical}`",
    )
}

/// The ASCII bytes C#'s `string.TrimStart()` removes (it also trims Unicode spaces, which a gap between two
/// keywords holds only inside a comment, where trimming stops anyway).
bool isWhiteSpace(u8 b) => b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == 0x0B || b == 0x0C

/// `enum Name { a b c }`, one member per line, or `enum Name(T x) { a(1) b(2) }`; members separated by
/// `,` are the input form (BYN1053), and a `;` after the last is BYN1040.
EnumDecl parseEnum(ref Parser p, at i64 start, by Modifiers modifiers) {
    let _ = p.advance()
    let name = expectName(ref p, what: "an enum name")
    var parameters: List<Param>? = null
    if p.kind() == .openParen {
        parameters = parseParams(ref p)
    }
    let bases = parseBases(ref p)
    let where = parseWhere(ref p)
    let open = p.expect(.openBrace)
    var members = List<EnumMember>()
    var cases = List<TextSpan>()
    var commas = List<Token>()
    while isName(p.kind()) {
        let doc = docOf(ref p, for: p.current())
        let memberStart = p.current().start
        let member = expectName(ref p, what: "a member name")
        var args: List<Argument>? = null
        if p.kind() == .openParen {
            args = parseArguments(ref p)
        }
        let span = p.spanFrom(memberStart)
        members.append(EnumMember { span: span, name: member, doc: doc, args: move args })
        cases.append(span)
        unless nextCase(ref p, to: ref commas) {
            break
        }
    }
    while p.kind() == .semicolon {
        reportSemicolon(ref p, for: p.advance())
    }
    reportCaseCommas(ref p, for: p.lexed.source.getText(name), from: open, through: in cases, by: in commas)
    expectClose(ref p, from: open, for: "enum")
    return EnumDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        params: move parameters,
        members: move members,
        bases: move bases,
        where : move where,
    }
}

/// `union Name { circle(f32 r) rect(f32 w, f32 h) none }` or `union Mode { read = 1 write = 2 }`, one
/// variant per line; variants separated by `,` are the input form (BYN1053), and a `;` after the last is BYN1040.
UnionDecl parseUnion(ref Parser p, at i64 start, by Modifiers modifiers) {
    let _ = p.advance()
    let name = expectName(ref p, what: "a union name")
    let typeParams = parseTypeParams(ref p)
    let bases = parseBases(ref p)
    let where = parseWhere(ref p)
    let open = p.expect(.openBrace)
    var variants = List<UnionVariant>()
    var cases = List<TextSpan>()
    var commas = List<Token>()
    while isName(p.kind()) {
        let doc = docOf(ref p, for: p.current())
        let variantStart = p.current().start
        let variant = expectName(ref p, what: "a variant name")
        let fields = parsePayload(ref p, for: variant)
        var value: Expr = .none
        if p.accept(.equals) {
            value = parseExpression(ref p)
        }
        let span = p.spanFrom(variantStart)
        variants.append(UnionVariant { span: span, name: variant, fields: move fields, doc: doc, value: move value })
        cases.append(span)
        unless nextCase(ref p, to: ref commas) {
            break
        }
    }
    while p.kind() == .semicolon {
        reportSemicolon(ref p, for: p.advance())
    }
    reportCaseCommas(ref p, for: p.lexed.source.getText(name), from: open, through: in cases, by: in commas)
    expectClose(ref p, from: open, for: "union")
    return UnionDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        variants: move variants,
        typeParams: move typeParams,
        bases: move bases,
        where : move where,
    }
}

/// The `(T name, …)` payload of a union variant or a state, if written; a type without a name is BYN1064.
List<UnionField> parsePayload(ref Parser p, for TextSpan variant) {
    var fields = List<UnionField>()
    return fields if p.kind() != .openParen
    let _ = p.advance()
    while p.kind() != .closeParen && !p.atEnd() {
        let before = p.pos
        let fieldStart = p.current().start
        var type: TypeSyntax = .none
        var field = TextSpan { start: 0, length: 0 }
        if isNameThenType(ref p, at: p.pos) {
            field = parseNameThenType(ref p, to: ref type)
        } else {
            type = parseType(ref p)
            if (p.kind() == .comma || p.kind() == .closeParen) && p.pos != before {
                let typeSpan = typeSpan(in type)
                let typeText = p.lexed.source.getText(typeSpan)
                let variantText = p.lexed.source.getText(variant)
                let _ = p.report(
                    .payloadNeedsName,
                    at: typeSpan,
                    arg0: typeText,
                    arg1: variantText,
                    label: "no name",
                    help: $"name the payload: `.{variantText}({typeText} name)`",
                )
                // The C# `Name` here has the text `<missing>`; a name is its span (Q452).
                field = TextSpan { start: p.prevEnd, length: 0 }
            } else {
                field = expectName(ref p, what: "a payload field name")
            }
        }
        fields.append(UnionField { span: p.spanFrom(fieldStart), type: move type, name: field })
        break if !p.accept(.comma) || p.pos == before
    }
    let _ = p.expect(.closeParen)
    return fields
}

/// After a case of an enum, union or union error: whether another follows, on its own line or after a `,`
/// (kept in `commas`).
bool nextCase(ref Parser p, to ref List<Token> commas) {
    if p.kind() == .comma {
        commas.append(p.advance())
        return true
    }
    return p.current().hasNewlineBefore
}

/// BYN1053 at the first `,` between cases; the fix puts each case on its own line and drops the commas.
void reportCaseCommas(
    ref Parser p,
    for string typeName,
    from Token open,
    through in List<TextSpan> cases,
    by in List<Token> commas
) {
    // A lone case with a trailing comma (`union error E { bad, }`) is still one case on one line.
    return if commas.length == 0 || cases.length < 2
    if p.kind() == .closeBrace && cases.length > 0 {
        let outer = indentAt(ref p, at: open.start)
        let lead = p.lexed.source.getText(TextSpan.fromBounds(open.end, until: cases[0].start))
        let sameLine = !lead.contains("\n")
        let caseIndent = sameLine ? $"{outer}    " : indentAt(ref p, at: cases[0].start)
        var text = StrBuf()
        text.append(sameLine ? $"{keptComment(lead)}\n{caseIndent}" : lead)
        for i in 0..cases.length {
            text.append(p.lexed.source.getText(cases[i]))
            let gapEnd = i + 1 < cases.length ? cases[i + 1].start : p.current().start
            var gap = withoutCommas(ref p, from: cases[i].end, until: gapEnd, by: in commas)
            if !gap.contains("\n") {
                let indent = i + 1 < cases.length ? caseIndent : outer
                gap = $"{keptComment(gap)}\n{indent}"
            }
            text.append(gap)
        }
        let _ = p.reportFix(
            .oneLineDeclarations,
            at: spanOf(commas[0]),
            through: TextSpan.fromBounds(open.end, until: p.current().start),
            by: $"{text.finish()}",
            arg0: typeName,
            label: "the first `,`",
            help: "write each case on its own line",
        )
        return
    }
    let _ = p.report(
        .oneLineDeclarations,
        at: spanOf(commas[0]),
        arg0: typeName,
        label: "the first `,`",
        help: "write each case on its own line",
    )
}

/// A `/* */` comment in a one-line gap between cases, kept at the end of its line; empty when there is none.
string keptComment(string gap) {
    var first: i64 = 0
    var last = gap.length
    while first < last && (gap.bytes[first] == ' ' || gap.bytes[first] == '\t') {
        first += 1
    }
    while last > first && (gap.bytes[last - 1] == ' ' || gap.bytes[last - 1] == '\t') {
        last -= 1
    }
    return first < last ? $" {gap[first..last]}" : ""
}

/// The source from `start` to `end` without its `,` tokens and the spaces before them.
string withoutCommas(ref Parser p, from i64 start, until i64 end, by in List<Token> commas) {
    var text = StrBuf()
    var at = start
    for comma in commas {
        continue if comma.start < start || comma.start >= end
        var cut = comma.start
        while cut > at && (p.lexed.source.bytes[cut - 1] == ' ' || p.lexed.source.bytes[cut - 1] == '\t') {
            cut -= 1
        }
        text.append(p.lexed.source.getText(TextSpan.fromBounds(at, until: cut)))
        at = comma.end
    }
    var restStart = at
    // A comma ends its line: the spaces it left before a line break go too.
    var blank = at
    while blank < end && (p.lexed.source.bytes[blank] == ' ' || p.lexed.source.bytes[blank] == '\t') {
        blank += 1
    }
    if at > start && blank < end && p.lexed.source.bytes[blank] == '\n' {
        restStart = blank
    }
    text.append(p.lexed.source.getText(TextSpan.fromBounds(restStart, until: end)))
    return $"{text.finish()}"
}

/// `type Name = T`, or `type distinct Name = T`; `distinct type` is the input form (BYN1044).
TypeAliasDecl parseTypeAlias(ref Parser p, at i64 start, by Modifiers modifiers) {
    let first = p.advance()
    let isDistinct = first.kind == .distinctKeyword || p.kind() == .distinctKeyword
    if first.kind == .distinctKeyword {
        let kind = p.advance()
        reportKeywordOrder(ref p, from: first, to: kind, as: "type distinct")
    } else if isDistinct {
        let _ = p.advance()
    }
    let name = expectName(ref p)
    let _ = p.expect(.equals)
    let parsed = parseType(ref p, fatArrow: true, lists: true)
    let target = parseRefinement(ref p, from: move parsed)
    let rules = parseRequiresLines(ref p)
    expectEnd(ref p)
    return TypeAliasDecl {
        span: p.spanFrom(start),
        modifiers: modifiers,
        name: name,
        target: move target,
        distinct: isDistinct,
        requiresClauses: move rules,
    }
}

/// `effect name = net, fs`.
EffectDecl parseEffect(ref Parser p, at i64 start, by Modifiers modifiers) {
    let _ = p.advance()
    let name = expectName(ref p)
    let _ = p.expect(.equals)
    var effects = List<TextSpan>()
    effects.append(expectName(ref p, what: "an effect name"))
    while p.accept(.comma) {
        effects.append(expectName(ref p, what: "an effect name"))
    }
    expectEnd(ref p)
    return EffectDecl { span: p.spanFrom(start), modifiers: modifiers, name: name, effects: move effects }
}

TestDecl parseTest(ref Parser p, at i64 start) {
    let _ = p.advance()
    var title = ""
    if p.kind() == .stringLiteral {
        let token = p.advance()
        title = $"{decodeString(p.text(token))}"
    } else {
        let _ = p.report(
            .expected,
            at: spanOf(p.current()),
            arg0: "the test's name as a string literal",
            arg1: p.describe(p.current()),
        )
    }
    var parameters = List<Param>()
    if p.kind() == .openParen {
        parameters = parseParams(ref p)
    }
    let body = parseBlock(ref p)
    return TestDecl { span: p.spanFrom(start), title: title, params: move parameters, body: move body }
}

// ── T5 shims (Q450) ──────────────────────────────────────────────────────────
// Stand-ins for helpers that sibling files own and that had no stub when T5 ran. Each keeps the C#
// name in camelCase; T15 deletes this struct and drops the `` prefix at every call, adjusting a
// call where the owner's signature differs. The bodies are just enough for the T5 tests' inputs.
== parser/dump.byn
// The tree dump, declarations and statements. Ports `csharp/Bayan.Syntax/Ast/AstDump.cs` (`Dump`, the
// `Writer` with `Decl`, `Stmt`, `Mods`, `TypeParams`, `Params`, `Doc`, `Bases`, `Where`,
// `Attribute`, `Rules`), plus tombstone compaction before the lexer's `renderAll`. Owner:
//
// The dump writes `CompilationUnit`, then one two-space-indented line per declaration and statement;
// types, patterns and expressions are written by `dump2.byn` (`dumpType`, `dumpPattern`, `dumpExpr`)
// and turned into strings here by `typeText`, `patternText` and `exprText`. Diagnostics follow a
// blank line once `unreport` tombstones (code `""`) are compacted away.

import lexer

public void dump(in CompilationUnit unit, from ref Parser p, to ref StrBuf sb) uses alloc {
    line("CompilationUnit", at: 0, to: ref sb)
    for member in unit.members {
        decl(in member, at: 1, from: ref p, to: ref sb)
    }
    if p.lexed.diagnostics.length > 0 {
        using var arena = Arena()
        var live = List<Diagnostic>()
        for d in p.lexed.diagnostics {
            unless d.code.isEmpty {
                live.append(d)
            }
        }
        // coverage-exempt: Q1123
        if live.length > 0 {
            sb.append("\n")
            lexer.renderAll(live.span, to: ref sb, from: ref p.lexed.source)
        }
    }
}

// ── Writer plumbing ──────────────────────────────────────────────────────────

/// `Writer.Line`: `depth * 2` spaces, `text`, then a newline.
void indent(i64 depth, to ref StrBuf sb) {
    for i in 0..depth {
        sb.append("  ")
    }
}

void line(string text, at i64 depth, to ref StrBuf sb) {
    indent(depth, to: ref sb)
    sb.append(text)
    sb.append("\n")
}

/// `Writer.Doc`: a `doc `…`` line when a declaration has a doc comment.
void doc(string? text, at i64 depth, to ref StrBuf sb) {
    return if text is null
    indent(depth, to: ref sb)
    sb.append("doc ")
    lexer.escape(text.bytes, to: ref sb)
    sb.append("\n")
}

/// The `@name …` lines a declaration may carry, each on one line.
void attributes(in List<AttributeSyntax> attributes, at i64 depth, from ref Parser p, to ref StrBuf sb) {
    for a in attributes {
        line($"Attribute {attributeText(in a, from: ref p)}", at: depth, to: ref sb)
    }
}

// ── String helpers ───────────────────────────────────────────────────────────

/// `AstDump.Expr` as a string, so a head can embed an expression inline.
string exprText(in Expr e, from ref Parser p) {
    var sb = StrBuf()
    dumpExpr(in e, from: ref p, to: ref sb)
    return $"{sb.finish()}"
}

/// `AstDump.Type` as a string.
string typeText(in TypeSyntax t, from ref Parser p) {
    var sb = StrBuf()
    dumpType(in t, from: ref p, to: ref sb)
    return $"{sb.finish()}"
}

/// `AstDump.Pattern` as a string.
string patternText(in Pattern pattern, from ref Parser p) {
    var sb = StrBuf()
    dumpPattern(in pattern, from: ref p, to: ref sb)
    return $"{sb.finish()}"
}

/// `Writer.Mods`: the set flags in declaration order, lowercased, then a trailing space.
string mods(Modifiers modifiers) {
    return "" if modifiers == modifierNone
    var parts = List<string>()
    if (modifiers & modifierPublic) != 0 {
        parts.append("public")
    }
    if (modifiers & modifierPrivate) != 0 {
        parts.append("private")
    }
    if (modifiers & modifierStatic) != 0 {
        parts.append("static")
    }
    if (modifiers & modifierReadonly) != 0 {
        parts.append("readonly")
    }
    if (modifiers & modifierRequired) != 0 {
        parts.append("required")
    }
    if (modifiers & modifierConst) != 0 {
        parts.append("const")
    }
    if (modifiers & modifierUnique) != 0 {
        parts.append("unique")
    }
    if (modifiers & modifierExtern) != 0 {
        parts.append("extern")
    }
    if (modifiers & modifierUnsafe) != 0 {
        parts.append("unsafe")
    }
    return $"{parts.joined(by: " ")} "
}

/// `Writer.TypeParams`: `<T, U>` or nothing.
string typeParams(in List<TextSpan> names, from ref Parser p) {
    return "" if names.isEmpty
    var parts = List<string>()
    for n in names {
        parts.append(nameText(ref p, at: n))
    }
    return $"<{parts.joined(by: ", ")}>"
}

/// `Writer.Bases`: ` : I, J` or nothing.
string basesText(in List<TypeSyntax> bases, from ref Parser p) {
    return "" if bases.isEmpty
    var parts = List<string>()
    for b in bases {
        parts.append(typeText(in b, from: ref p))
    }
    return $" : {parts.joined(by: ", ")}"
}

/// `Writer.Where`: ` where T : I, J` for each clause.
string whereText(in List<WhereClause> where, from ref Parser p) {
    var sb = StrBuf()
    for w in where {
        var bounds = List<string>()
        for b in w.bounds {
            bounds.append(typeText(in b, from: ref p))
        }
        sb.append($" where {nameText(ref p, at: w.param)} : {bounds.joined(by: ", ")}")
    }
    return $"{sb.finish()}"
}

/// `Writer.Attribute`: `@name arg: value …` with the optional `because` reason.
string attributeText(in AttributeSyntax a, from ref Parser p) {
    var sb = StrBuf()
    let attrName = nameText(ref p, at: a.name)
    let bracket = a.span.length > 0 && p.lexed.source.bytes[a.span.start] == '['
    sb.append(
        $"@{bracket && attrName.length > 0 ? $"{attrName.runes.take(1).lowercased()}{attrName.runes.skip(1)}" : attrName}",
    )
    for arg in a.args {
        sb.append(" ")
        if (arg.name is { } name) {
            sb.append(nameText(ref p, at: name))
            sb.append(": ")
        }
        sb.append(exprText(in arg.value, from: ref p))
    }
    if (a.becauseKeyword is { } clause) {
        sb.append(" because ")
        lexer.escape(clause.reason.bytes, to: ref sb)
    }
    return $"{sb.finish()}"
}

/// `Writer.Rules`: ` requires condition at .field` for each rule.
string rulesText(in List<RequiresRule> rules, from ref Parser p) {
    var sb = StrBuf()
    for r in rules {
        sb.append($" requires {exprText(in r.condition, from: ref p)}")
        if (r.at is { } field) {
            sb.append($" at .{nameText(ref p, at: field)}")
        }
    }
    return $"{sb.finish()}"
}

/// The receiver part of `Writer.Params`: `ref this`, `move this` or `this is .a or .b`, or nothing.
string receiverText(in List<TextSpan> states, from ref Parser p, bool refThis = false, bool moveThis = false) {
    let stated = !states.isEmpty
    var sb = StrBuf()
    if refThis {
        sb.append("ref this")
    } else if moveThis {
        sb.append("move this")
    } else if stated {
        sb.append("this")
    }
    if stated {
        sb.append(" is ")
        var parts = List<string>()
        for s in states {
            parts.append($".{nameText(ref p, at: s)}")
        }
        sb.append(parts.joined(by: " or "))
    }
    return $"{sb.finish()}"
}

/// `Writer.Params`: `(receiver, particle rest mod Type name = default, …)`.
string paramsText(in List<Param> parameters, from ref Parser p, string receiver = "") {
    var sb = StrBuf()
    sb.append($"({receiver}")
    var i = 0
    for param in parameters {
        if i > 0 || !receiver.isEmpty {
            sb.append(", ")
        }
        if (param.particle is { } particle) {
            sb.append(nameText(ref p, at: particle))
            sb.append(" ")
        }
        if param.rest {
            sb.append("rest ")
        }
        if param.modifier != .none {
            sb.append(paramModifierText(param.modifier))
            sb.append(" ")
        }
        dumpType(in param.type, from: ref p, to: ref sb)
        sb.append(" ")
        sb.append(nameText(ref p, at: param.name))
        unless param.defaultKeyword is .none {
            sb.append(" = ")
            dumpExpr(in param.defaultKeyword, from: ref p, to: ref sb)
        }
        i += 1
    }
    sb.append(")")
    return $"{sb.finish()}"
}

/// `ParamModifier.ToString().ToLowerInvariant()`.
string paramModifierText(ParamModifier modifier) => modifier switch {
    .refKeyword  => "ref",
    .moveKeyword => "move",
    .outKeyword  => "out",
    .inKeyword   => "in",
    .none        => "",
}

/// `BindingKind.ToString()`.
string bindingKindText(BindingKind kind) => kind switch {
    .letKeyword   => "Let",
    .varKeyword   => "Var",
    .constKeyword => "Const",
}

/// The word after `if`: `unlikely `, `never `, or nothing.
string likelihoodText(Likelihood likelihood) => likelihood switch {
    .unlikely => "unlikely ",
    .neverKeyword => "never ",
    .none         => "",
}

/// The word after `defer`: ` failing`, ` panicking`, or nothing.
string deferKindText(DeferKind kind) => kind switch {
    .failing   => " failing",
    .panicking => " panicking",
    .always    => "",
}

// ── Declarations ─────────────────────────────────────────────────────────────

void decl(in Decl node, at i64 depth, from ref Parser p, to ref StrBuf sb) {
    switch node {
        case .importDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var parts = List<string>()
            for part in d.value.path {
                parts.append(nameText(ref p, at: part))
            }
            var head = $"Import {parts.joined(by: ".")}"
            if (d.value.alias is { } alias) {
                head = $"{head} as {nameText(ref p, at: alias)}"
            }
            line(head, at: depth, to: ref sb)
        case .globalStatement(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            stmt(in d.value.statement, at: depth, from: ref p, to: ref sb)
        case .functionDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append("Function ")
            head.append(mods(d.value.modifiers))
            head.append(nameText(ref p, at: d.value.name))
            head.append(typeParams(in d.value.typeParams, from: ref p))
            head.append(paramsText(
                in d.value.params,
                from: ref p,
                receiver: receiverText(
                    in d.value.receiverStates,
                    from: ref p,
                    refThis: d.value.refThis is not null,
                    moveThis: d.value.moveThis is not null,
                ),
            ))
            head.append(" -> ")
            if (d.value.returnType is .namedType(let rt)) && rt.value.path.length == 1 && rt.value.path[0].length == 0
                    && rt.value.path[0].start == d.value.name.start {
                head.append("void")
            } else {
                head.append(typeText(in d.value.returnType, from: ref p))
            }
            head.append(whereText(in d.value.where, from : ref p))
            for r in d.value.requiresClauses {
                head.append($" expects {exprText(in r, from: ref p)}")
            }
            if (d.value.usesKeyword is { } usesClause) {
                var effects = List<string>()
                for e in usesClause.effects {
                    effects.append(nameText(ref p, at: e))
                }
                head.append($" uses {effects.joined(by: ", ")}")
            }
            if (d.value.becomes is { } becomes) {
                head.append($" becomes .{nameText(ref p, at: becomes)}")
            }
            if (d.value.failsKeyword is { } failsClause) {
                if failsClause.errors.isEmpty {
                    head.append(" fails")
                } else {
                    var errors = List<string>()
                    for e in failsClause.errors {
                        errors.append(typeText(in e, from: ref p))
                    }
                    head.append($" fails {errors.joined(by: ", ")}")
                }
            }
            unless d.value.expressionBody is .none {
                head.append($" => {exprText(in d.value.expressionBody, from: ref p)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
            unless d.value.body is .none {
                stmt(in d.value.body, at: depth + 1, from: ref p, to: ref sb)
            }
        case .structDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append("Struct ")
            head.append(mods(d.value.modifiers))
            head.append(nameText(ref p, at: d.value.name))
            head.append(typeParams(in d.value.typeParams, from: ref p))
            head.append(basesText(in d.value.bases, from: ref p))
            head.append(whereText(in d.value.where, from : ref p))
            head.append(rulesText(in d.value.rules, from: ref p))
            line($"{head.finish()}", at: depth, to: ref sb)
            for member in d.value.members {
                decl(in member, at: depth + 1, from: ref p, to: ref sb)
            }
            for v in d.value.states {
                var stateHead = StrBuf()
                stateHead.append($"State {nameText(ref p, at: v.name)}")
                unless v.fields.isEmpty {
                    var fieldParts = List<string>()
                    for f in v.fields {
                        fieldParts.append($"{typeText(in f.type, from: ref p)} {nameText(ref p, at: f.name)}")
                    }
                    stateHead.append($"({fieldParts.joined(by: ", ")})")
                }
                line($"{stateHead.finish()}", at: depth + 1, to: ref sb)
            }
        case .interfaceDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append("Interface ")
            head.append(mods(d.value.modifiers))
            head.append(nameText(ref p, at: d.value.name))
            head.append(typeParams(in d.value.typeParams, from: ref p))
            head.append(whereText(in d.value.where, from : ref p))
            line($"{head.finish()}", at: depth, to: ref sb)
            for member in d.value.members {
                decl(in member, at: depth + 1, from: ref p, to: ref sb)
            }
        case .getterDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            line(
                $"Getter {mods(d.value.modifiers)}{typeText(in d.value.type, from: ref p)} {nameText(ref p, at: d.value.name)}",
                at: depth,
                to: ref sb,
            )
        case .associatedTypeDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            line($"AssociatedType {nameText(ref p, at: d.value.name)}", at: depth, to: ref sb)
        case .extensionDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            line(
                $"Extension {nameText(ref p, at: d.value.name)}{basesText(in d.value.bases, from: ref p)}",
                at: depth,
                to: ref sb,
            )
            for member in d.value.members {
                decl(in member, at: depth + 1, from: ref p, to: ref sb)
            }
        case .fieldDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append(
                $"Field {mods(d.value.modifiers)}{typeText(in d.value.type, from: ref p)} {nameText(ref p, at: d.value.name)}",
            )
            unless d.value.defaultKeyword is .none {
                head.append($" = {exprText(in d.value.defaultKeyword, from: ref p)}")
            }
            head.append(rulesText(in d.value.requiresClauses, from: ref p))
            line($"{head.finish()}", at: depth, to: ref sb)
        case .propertyDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append(
                $"Property {mods(d.value.modifiers)}{typeText(in d.value.type, from: ref p)} {nameText(ref p, at: d.value.name)}",
            )
            unless d.value.body is .none {
                head.append($" => {exprText(in d.value.body, from: ref p)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
            unless d.value.block is .none {
                stmt(in d.value.block, at: depth + 1, from: ref p, to: ref sb)
            }
        case .constructorDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            line(
                $"Constructor {mods(d.value.modifiers)}{nameText(ref p, at: d.value.name)}{paramsText(in d.value.params, from: ref p)}",
                at: depth,
                to: ref sb,
            )
            stmt(in d.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .errorEnumDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            line($"ErrorEnum {mods(d.value.modifiers)}{nameText(ref p, at: d.value.name)}", at: depth, to: ref sb)
            for v in d.value.variants {
                var variantHead = StrBuf()
                variantHead.append($"Variant {nameText(ref p, at: v.name)}")
                unless v.fields.isEmpty {
                    var fieldParts = List<string>()
                    for f in v.fields {
                        fieldParts.append($"{typeText(in f.type, from: ref p)} {nameText(ref p, at: f.name)}")
                    }
                    variantHead.append($"({fieldParts.joined(by: ", ")})")
                }
                for a in v.attributes {
                    variantHead.append($" {attributeText(in a, from: ref p)}")
                }
                if (v.doc is { } vdoc) {
                    variantHead.append(" doc ")
                    lexer.escape(vdoc.bytes, to: ref variantHead)
                }
                line($"{variantHead.finish()}", at: depth + 1, to: ref sb)
            }
        case .errorSetDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var members = List<string>()
            for m in d.value.members {
                members.append(typeText(in m, from: ref p))
            }
            var head = $"ErrorSet {mods(d.value.modifiers)}{nameText(ref p, at: d.value.name)} = {members.joined(by: ", ")}"
            unless d.value.exceptNames.isEmpty {
                var exceptParts = List<string>()
                for n in d.value.exceptNames {
                    exceptParts.append($".{nameText(ref p, at: n)}")
                }
                head = $"{head} except {exceptParts.joined(by: ", ")}"
            }
            line(head, at: depth, to: ref sb)
        case .enumDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append("Enum ")
            head.append(mods(d.value.modifiers))
            head.append(nameText(ref p, at: d.value.name))
            if (d.value.params is { } params) {
                head.append(paramsText(in params, from: ref p))
            }
            head.append(basesText(in d.value.bases, from: ref p))
            head.append(whereText(in d.value.where, from : ref p))
            line($"{head.finish()}", at: depth, to: ref sb)
            for m in d.value.members {
                var memberHead = StrBuf()
                memberHead.append($"Member {nameText(ref p, at: m.name)}")
                if (m.args is { } args) {
                    var argParts = List<string>()
                    for a in args {
                        var arg = StrBuf()
                        if (a.name is { } name) {
                            arg.append(nameText(ref p, at: name))
                            arg.append(": ")
                        }
                        arg.append(exprText(in a.value, from: ref p))
                        argParts.append($"{arg.finish()}")
                    }
                    memberHead.append($"({argParts.joined(by: ", ")})")
                }
                if (m.doc is { } mdoc) {
                    memberHead.append(" doc ")
                    lexer.escape(mdoc.bytes, to: ref memberHead)
                }
                line($"{memberHead.finish()}", at: depth + 1, to: ref sb)
            }
        case .unionDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append("Union ")
            head.append(mods(d.value.modifiers))
            head.append(nameText(ref p, at: d.value.name))
            head.append(typeParams(in d.value.typeParams, from: ref p))
            head.append(basesText(in d.value.bases, from: ref p))
            head.append(whereText(in d.value.where, from : ref p))
            line($"{head.finish()}", at: depth, to: ref sb)
            for v in d.value.variants {
                var variantHead = StrBuf()
                variantHead.append($"Variant {nameText(ref p, at: v.name)}")
                unless v.fields.isEmpty {
                    var fieldParts = List<string>()
                    for f in v.fields {
                        fieldParts.append($"{typeText(in f.type, from: ref p)} {nameText(ref p, at: f.name)}")
                    }
                    variantHead.append($"({fieldParts.joined(by: ", ")})")
                }
                unless v.value is .none {
                    variantHead.append($" = {exprText(in v.value, from: ref p)}")
                }
                if (v.doc is { } vdoc) {
                    variantHead.append(" doc ")
                    lexer.escape(vdoc.bytes, to: ref variantHead)
                }
                line($"{variantHead.finish()}", at: depth + 1, to: ref sb)
            }
        case .typeAliasDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append($"TypeAlias {mods(d.value.modifiers)}")
            if d.value.distinct {
                head.append("distinct ")
            }
            head.append($"{nameText(ref p, at: d.value.name)} = {typeText(in d.value.target, from: ref p)}")
            head.append(rulesText(in d.value.requiresClauses, from: ref p))
            line($"{head.finish()}", at: depth, to: ref sb)
        case .effectDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var effects = List<string>()
            for e in d.value.effects {
                effects.append(nameText(ref p, at: e))
            }
            line(
                $"Effect {mods(d.value.modifiers)}{nameText(ref p, at: d.value.name)} = {effects.joined(by: ", ")}",
                at: depth,
                to: ref sb,
            )
        case .testDecl(let d):
            doc(d.value.doc, at: depth, to: ref sb)
            attributes(in d.value.attributes, at: depth, from: ref p, to: ref sb)
            var head = StrBuf()
            head.append("Test ")
            lexer.escape(d.value.title.bytes, to: ref head)
            unless d.value.params.isEmpty {
                head.append($" {paramsText(in d.value.params, from: ref p)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
            stmt(in d.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .none:
            return
    }
}

// ── Statements ───────────────────────────────────────────────────────────────

void stmt(in Stmt node, at i64 depth, from ref Parser p, to ref StrBuf sb) {
    stmtAttributes(in node, at: depth, from: ref p, to: ref sb)
    switch node {
        case .blockStmt(let s):
            line("Block", at: depth, to: ref sb)
            for child in s.value.statements {
                stmt(in child, at: depth + 1, from: ref p, to: ref sb)
            }
        case .localDecl(let s):
            var head = StrBuf()
            if s.value.usingKeyword {
                head.append("Using ")
            }
            head.append($"{bindingKindText(s.value.kind)} {nameText(ref p, at: s.value.name)}")
            unless s.value.type is .none {
                head.append($": {typeText(in s.value.type, from: ref p)}")
            }
            unless s.value.init is .none {
                head.append($" = {exprText(in s.value.init, from: ref p)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
        case .exprStmt(let s):
            line($"Expr {exprText(in s.value.expr, from: ref p)}", at: depth, to: ref sb)
        case .assignStmt(let s):
            line(
                $"Assign {exprText(in s.value.target, from: ref p)} {assignText(s.value.op)} {exprText(in s.value.value, from: ref p)}",
                at: depth,
                to: ref sb,
            )
        case .incDecStmt(let s):
            line(
                $"{(s.value.increment ? "Inc " : "Dec ")}{exprText(in s.value.target, from: ref p)}",
                at: depth,
                to: ref sb,
            )
        case .returnStmt(let s):
            var head = StrBuf()
            head.append("Return")
            unless s.value.value is .none {
                head.append($" {exprText(in s.value.value, from: ref p)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
        case .failStmt(let s):
            line($"Fail {exprText(in s.value.error, from: ref p)}", at: depth, to: ref sb)
        case .breakStmt(let s):
            var head = StrBuf()
            head.append("Break")
            if (s.value.label is { } label) {
                head.append($" {nameText(ref p, at: label)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
        case .continueStmt(let s):
            var head = StrBuf()
            head.append("Continue")
            if (s.value.label is { } label) {
                head.append($" {nameText(ref p, at: label)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
        case .becomeStmt(let s):
            var head = StrBuf()
            head.append($"Become .{nameText(ref p, at: s.value.state)}")
            for a in s.value.args {
                head.append(" ")
                if (a.name is { } name) {
                    head.append(nameText(ref p, at: name))
                    head.append(": ")
                }
                head.append(exprText(in a.value, from: ref p))
            }
            line($"{head.finish()}", at: depth, to: ref sb)
        case .ifStmt(let s):
            line(
                $"If {likelihoodText(s.value.likelihood)}{exprText(in s.value.condition, from: ref p)}",
                at: depth,
                to: ref sb,
            )
            stmt(in s.value.then, at: depth + 1, from: ref p, to: ref sb)
            unless s.value.elseKeyword is .none {
                line("Else", at: depth, to: ref sb)
                stmt(in s.value.elseKeyword, at: depth + 1, from: ref p, to: ref sb)
            }
        case .unlessStmt(let s):
            line($"Unless {exprText(in s.value.condition, from: ref p)}", at: depth, to: ref sb)
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .guardedStmt(let s):
            var prefix = StrBuf()
            if s.value.unlessKeyword {
                prefix.append("Guarded unless ")
            } else if s.value.unlikely {
                prefix.append("Guarded if unlikely ")
            } else {
                prefix.append("Guarded if ")
            }
            prefix.append(exprText(in s.value.condition, from: ref p))
            line($"{prefix.finish()}", at: depth, to: ref sb)
            stmt(in s.value.statement, at: depth + 1, from: ref p, to: ref sb)
        case .whileStmt(let s):
            line($"While {exprText(in s.value.condition, from: ref p)}", at: depth, to: ref sb)
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .whileLetStmt(let s):
            line(
                $"WhileLet {nameText(ref p, at: s.value.variable)} = {exprText(in s.value.value, from: ref p)}",
                at: depth,
                to: ref sb,
            )
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .doWhileStmt(let s):
            line($"DoWhile {exprText(in s.value.condition, from: ref p)}", at: depth, to: ref sb)
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .forStmt(let s):
            var head = StrBuf()
            if s.value.tryKeyword {
                head.append("For try ")
            } else {
                head.append("For ")
            }
            head.append($"{bindingKindText(s.value.kind)} ")
            if !s.value.names.isEmpty {
                var nameParts = List<string>()
                for n in s.value.names {
                    nameParts.append(nameText(ref p, at: n))
                }
                head.append($"({nameParts.joined(by: ", ")})")
            } else {
                head.append(nameText(ref p, at: s.value.variable))
            }
            unless s.value.type is .none {
                head.append($": {typeText(in s.value.type, from: ref p)}")
            }
            head.append($" in {exprText(in s.value.iterable, from: ref p)}")
            line($"{head.finish()}", at: depth, to: ref sb)
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .labeledStmt(let s):
            line($"Label {nameText(ref p, at: s.value.label)}", at: depth, to: ref sb)
            stmt(in s.value.statement, at: depth + 1, from: ref p, to: ref sb)
        case .switchStmt(let s):
            line($"Switch {exprText(in s.value.value, from: ref p)}", at: depth, to: ref sb)
            for section in s.value.sections {
                var label = StrBuf()
                if section.label.pattern is .none {
                    label.append("Default")
                } else {
                    label.append($"Case {patternText(in section.label.pattern, from: ref p)}")
                    unless section.label.guard is .none {
                        label.append($" when {exprText(in section.label.guard, from: ref p)}")
                    }
                }
                line($"{label.finish()}", at: depth + 1, to: ref sb)
                for child in section.statements {
                    stmt(in child, at: depth + 2, from: ref p, to: ref sb)
                }
            }
        case .deferStmt(let s):
            var head = StrBuf()
            head.append("Defer")
            head.append(deferKindText(s.value.kind))
            if (s.value.binding is { } binding) {
                head.append($" ({nameText(ref p, at: binding)})")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .assertStmt(let s):
            var head = StrBuf()
            head.append($"Assert {exprText(in s.value.condition, from: ref p)}")
            unless s.value.failsKeyword is .none {
                head.append($" fails {exprText(in s.value.failsKeyword, from: ref p)}")
            }
            line($"{head.finish()}", at: depth, to: ref sb)
        case .contextStmt(let s):
            var values = List<string>()
            for v in s.value.values {
                values.append($"{nameText(ref p, at: v.name)}: {exprText(in v.value, from: ref p)}")
            }
            line($"Provide {values.joined(by: ", ")}", at: depth, to: ref sb)
            stmt(in s.value.body, at: depth + 1, from: ref p, to: ref sb)
        case .emptyStmt(_):
            line("Empty", at: depth, to: ref sb)
        case .errorStmt(_):
            line("<error>", at: depth, to: ref sb)
        case .none:
            return
    }
}

/// The `Attribute` lines of a statement's attributes, which `AstDump.Stmt` writes before its head.
void stmtAttributes(in Stmt node, at i64 depth, from ref Parser p, to ref StrBuf sb) {
    switch node {
        case .blockStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .localDecl(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .exprStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .assignStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .incDecStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .returnStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .failStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .breakStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .continueStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .becomeStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .ifStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .unlessStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .guardedStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .whileStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .doWhileStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .whileLetStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .forStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .labeledStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .switchStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .deferStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .assertStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .contextStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .emptyStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .errorStmt(let s):
            attributes(in s.value.attributes, at: depth, from: ref p, to: ref sb)
        case .none:
            return
    }
}

// ── T11 stand-ins (T15 deletes) ──────────────────────────────────────────────
// `assignText` is T12's (dump2.byn); T11 needs it for `AssignStmt`. The body is the C# `AssignText`.
== parser/dump2.byn
// The tree dump, S-expressions. Ports `csharp/Bayan.Syntax/Ast/AstDump.cs` `AssignText` (352–367),
// `BinaryText` (369–397), `UnaryText` (399–407), `Type` (409–461), `Pattern` (463–554), `Sexp`
// (556–566), `Expr` (568–818), `FieldInits` (820–828) and `Quote` (830–834). Owner:
//
// `dumpExpr`, `dumpType` and `dumpPattern` write one node as an S-expression on one line; `dump.byn`
// (T11) calls them for the inline parts of declarations and statements, and calls `assignText`,
// `binaryText` and `unaryText` directly. The C# `Sexp` has `params Expr?[]`; Bayan has no `params`
// and the children are move-only unions, so each S-expression is written inline, a `none` child
// printing `_`. The C# `TypeNames`/`CalleeNames` side collections are not part of the dump text; `dumpType`,
// the `memberExpr` and the `callExpr` arms add to `Parser.collectedTypeNames`/`collectedCalleeNames` while `p.collectNames` is set, and
// `typeNames` and `calleeAndReceiverNames` below are `AstDump.TypeNames` and `CalleeAndReceiverNames` (Q1143). `BlockExpr` flattens a statement dump through T11's `stmt` (the `T12` stand-in
// until T11 lands).

import lexer

/// The C# `AssignText`: the source spelling of an assignment operator.
string assignText(AssignOp op) => op switch {
    .assign     => "=",
    .add        => "+=",
    .sub        => "-=",
    .mul        => "*=",
    .div        => "/=",
    .rem        => "%=",
    .andKeyword => "&=",
    .orKeyword  => "|=",
    .xor        => "^=",
    .shl        => "<<=",
    .shr        => ">>=",
    .coalesce   => "??=",
}

/// The C# `BinaryText`: the source spelling of a binary operator.
string binaryText(BinaryOp op) => op switch {
    .add        => "+",
    .sub        => "-",
    .mul        => "*",
    .div        => "/",
    .rem        => "%",
    .addWrap    => "+%",
    .subWrap    => "-%",
    .mulWrap    => "*%",
    .addSat     => "+|",
    .subSat     => "-|",
    .mulSat     => "*|",
    .shl        => "<<",
    .shr        => ">>",
    .lt         => "<",
    .gt         => ">",
    .le         => "<=",
    .ge         => ">=",
    .eq         => "==",
    .ne         => "!=",
    .bitAnd     => "&",
    .bitOr      => "|",
    .bitXor     => "^",
    .logicalAnd => "&&",
    .logicalOr  => "||",
    .coalesce   => "??",
}

/// The C# `UnaryText`: the source spelling of a prefix operator.
string unaryText(UnaryOp op) => op switch {
    .plus       => "+",
    .negate     => "-",
    .notKeyword => "!",
    .complement => "~",
    .fromEnd    => "^",
}

/// The decoded text of an identifier span (the C# `Name.Text`).
string nameText(ref Parser p, at TextSpan span) => span.length == 0 ? "<missing>" : p.lexed.source.getText(span)

/// The C# `Quote`: `text` double-quoted, with `\n` `\r` `\t`, controls and bidi characters as
/// `\u{X}`, and `"` as `\"`. The text is already decoded (valid UTF-8).
string quote(string text) {
    var sb = StrBuf()
    sb.append("\"")
    let bytes = text.bytes
    var pos: i64 = 0
    while pos < bytes.length {
        let b = bytes[pos]
        if b < 0x80 {
            if b == 0x22 {
                sb.append("\\\"")
            } else if b == 0x0A {
                sb.append("\\n")
            } else if b == 0x0D {
                sb.append("\\r")
            } else if b == 0x09 {
                sb.append("\\t")
            } else if b is < 0x20 or 0x7F {
                appendUnicodeEscape(u32(b), to: ref sb)
            } else {
                sb.append(text[pos..pos + 1])
            }
            pos += 1
        } else {
            var value: u32 = 0
            var n: i64 = 0
            if b < 0xE0 {
                value = (u32(b & 0x1F) << 6) | u32(bytes[pos + 1] & 0x3F)
                n = 2
            } else if b < 0xF0 {
                value = (u32(b & 0x0F) << 12) | (u32(bytes[pos + 1] & 0x3F) << 6) | u32(bytes[pos + 2] & 0x3F)
                n = 3
            } else {
                value = (
                    u32(b & 0x07) << 18
                ) | (u32(bytes[pos + 1] & 0x3F) << 12) | (u32(bytes[pos + 2] & 0x3F) << 6) | u32(bytes[pos + 3] & 0x3F)
                n = 4
            }
            if value is 0x202A..=0x202E or 0x2066..=0x2069 or 0xFEFF {
                appendUnicodeEscape(value, to: ref sb)
            } else {
                sb.append(text[pos..pos + n])
            }
            pos += n
        }
    }
    sb.append("\"")
    return $"{sb.finish()}"
}

/// Appends `\u{X}` for `value` (upper-case, no padding), as the C# `Rune.Value.ToString("X")`.
void appendUnicodeEscape(u32 value, to ref StrBuf sb) {
    sb.append("\\u{")
    var n: i64 = 1
    while n < 8 && (value >> u32(4 * n)) != 0 {
        n += 1
    }
    var i = n - 1
    while i >= 0 {
        let d = (value >> u32(4 * i)) & 0xF
        sb.append($"{rune(d < 10 ? 0x30 + d : 0x37 + d)}")
        i -= 1
    }
    sb.append("}")
}

/// Appends `types` joined by `", "` (the C# `string.Join(", ", …)` over types).
void appendTypes(in List<TypeSyntax> types, from ref Parser p, to ref StrBuf sb) {
    var first = true
    for t in types {
        if !first {
            sb.append(", ")
        }
        first = false
        dumpType(in t, from: ref p, to: ref sb)
    }
}

/// The C# `FieldInits`: ` (name value)` per field.
void fieldInits(in List<FieldInit> fields, from ref Parser p, to ref StrBuf sb) {
    for f in fields {
        sb.append(" (")
        sb.append(nameText(ref p, at: f.name))
        sb.append(" ")
        dumpExpr(in f.value, from: ref p, to: ref sb)
        sb.append(")")
    }
}

/// Whether `elements` is a non-empty collection whose elements are all `mapEntryExpr` (the C#
/// `e.Elements.Length > 0 && e.Elements.All(x => x is MapEntryExpr)`).
bool allMapEntries(in List<Expr> elements) {
    var any = false
    for item in elements {
        any = true
        unless item is .mapEntryExpr(_) {
            return false
        }
    }
    return any
}

/// The C# `BlockExpr` dump: `(block {stmt; …})`, each statement flattened to one line.
void dumpBlockExpr(in Stmt block, from ref Parser p, to ref StrBuf sb) {
    sb.append("(block")
    switch block {
        case .blockStmt(let b):
            for s in b.value.statements {
                var w = StrBuf()
                stmt(in s, at: 0, from: ref p, to: ref w)
                sb.append(" {")
                appendFlattened(w.finish(), to: ref sb)
                sb.append("}")
            }
        default:
    }
    sb.append(")")
}

/// Appends a statement's multi-line dump flattened into `{line; line}` form: trailing `\n` dropped,
/// each line trimmed and joined by `"; "` (the C# `string.Join("; ", …)` over trimmed lines).
void appendFlattened(string text, to ref StrBuf sb) {
    let t = text.bytes
    var end = t.length
    while end > 0 && t[end - 1] == 0x0A {
        end -= 1
    }
    var from: i64 = 0
    var first = true
    for i in 0..end + 1 {
        let atEnd = i == end
        continue if !atEnd && t[i] != 0x0A
        var lo = from
        var hi = i
        while lo < hi && (t[lo] is 0x20 or 0x09) {
            lo += 1
        }
        while hi > lo && (t[hi - 1] == 0x20 || t[hi - 1] == 0x09) {
            hi -= 1
        }
        unless first {
            sb.append("; ")
        }
        first = false
        sb.append(text[lo..hi])
        from = i + 1
    }
}

/// The C# `Type(StringBuilder, TypeSyntax)`: a type as an S-expression.
void dumpType(in TypeSyntax t, from ref Parser p, to ref StrBuf sb) {
    switch t {
        case .namedType(let n):
            if p.collectNames && n.value.path.length == 1 {
                p.collectedTypeNames.append(n.value.path[0])
            }
            if n.value.path.length == 1 && n.value.args.length == 0 {
                let text = nameText(ref p, at: n.value.path[0])
                let renamed = cSharpTypeName(text)
                sb.append(renamed.isEmpty ? (text == "char" ? "rune" : text) : renamed)
            } else {
                var readOnlySpan = false
                if n.value.path.length == 1 && n.value.args.length == 1 {
                    let argSpan = typeSpan(in n.value.args[0])
                    // coverage-exempt: Q1145 through `argSpan.end < n.value.path[0].end`
                    readOnlySpan = argSpan.start == n.value.path[0].start && argSpan.end < n.value.path[0].end
                }
                if readOnlySpan {
                    sb.append("ReadOnlySpan<")
                    appendTypes(in n.value.args, from: ref p, to: ref sb)
                    sb.append(">")
                } else {
                    var first = true
                    for path in n.value.path {
                        if !first {
                            sb.append(".")
                        }
                        first = false
                        sb.append(nameText(ref p, at: path))
                    }
                    if n.value.args.length > 0 {
                        sb.append("<")
                        appendTypes(in n.value.args, from: ref p, to: ref sb)
                        sb.append(">")
                    }
                }
            }
        case .optionalType(let n):
            dumpType(in n.value.inner, from: ref p, to: ref sb)
            sb.append("?")
        case .arrayType(let n):
            dumpType(in n.value.element, from: ref p, to: ref sb)
            sb.append("[")
            dumpExpr(in n.value.size, from: ref p, to: ref sb)
            sb.append("]")
        case .tupleType(let n):
            sb.append("(")
            var first = true
            for el in n.value.elements {
                if !first {
                    sb.append(", ")
                }
                first = false
                dumpType(in el.type, from: ref p, to: ref sb)
                if (el.name is { } nm) {
                    sb.append(" ")
                    sb.append(nameText(ref p, at: nm))
                }
            }
            sb.append(")")
        case .functionTypeSyntax(let n):
            var paren = n.value.params.length != 1
            if !paren {
                for tp in n.value.params {
                    if tp is .tupleType(_) || tp is .functionTypeSyntax(_) {
                        paren = true
                    }
                }
            }
            if paren {
                sb.append("(")
            }
            var first = true
            for tp in n.value.params {
                if !first {
                    sb.append(", ")
                }
                first = false
                dumpType(in tp, from: ref p, to: ref sb)
            }
            if paren {
                sb.append(")")
            }
            sb.append(" -> ")
            dumpType(in n.value.returnKeyword, from: ref p, to: ref sb)
            if (n.value.usesKeyword is { } u) {
                sb.append(" uses ")
                var firstU = true
                for eff in u.effects {
                    if !firstU {
                        sb.append(", ")
                    }
                    firstU = false
                    sb.append(nameText(ref p, at: eff))
                }
            }
            if (n.value.failsKeyword is { } f) {
                sb.append(" fails ")
                appendTypes(in f.errors, from: ref p, to: ref sb)
            }
        case .dynType(let n):
            sb.append(n.value.isRef ? (n.value.isReadOnly ? "dyn ref readonly " : "dyn ref ") : "dyn ")
            dumpType(in n.value.inner, from: ref p, to: ref sb)
        case .refinedType(let n):
            dumpType(in n.value.inner, from: ref p, to: ref sb)
            sb.append(" is ")
            var first = true
            for s in n.value.states {
                if !first {
                    sb.append(" or ")
                }
                first = false
                sb.append(".")
                sb.append(nameText(ref p, at: s))
            }
        case .pointerType(let n):
            if n.value.readOnly {
                sb.append("readonly ")
            }
            dumpType(in n.value.pointee, from: ref p, to: ref sb)
            sb.append("*")
        case .none:
    }
}

/// The C# `Expr(StringBuilder, Expr)`: an expression as an S-expression.
void dumpExpr(in Expr e, from ref Parser p, to ref StrBuf sb) {
    switch e {
        case .literalExpr(let n):
            switch n.value.kind {
                case .string or .rawString:
                    sb.append(quote(n.value.text))
                case .cString:
                    sb.append("c")
                    sb.append(quote(n.value.text))
                case .u16String:
                    sb.append("u16")
                    sb.append(quote(n.value.text))
                default:
                    sb.append(n.value.text)
                    if (n.value.suffix is { } s) {
                        sb.append(nameText(ref p, at: s))
                    }
            }
        case .interpolatedExpr(let n):
            sb.append("(interp")
            for part in n.value.parts {
                sb.append(" ")
                switch part {
                    case .interpolationText(let t):
                        sb.append(quote(t.value.text))
                    case .interpolationHole(let h):
                        if h.value.specs.length > 0 {
                            sb.append("(hole ")
                            dumpExpr(in h.value.expr, from: ref p, to: ref sb)
                            for spec in h.value.specs {
                                sb.append(" (")
                                // coverage-exempt: Q1145 through `spec.name is { } sn`
                                if (spec.name is { } sn) {
                                    let text = nameText(ref p, at: sn)
                                    sb.append(
                                        text == ":" ? (spec.value is .targetMemberExpr(_) ? "as" : "digits") : text,
                                    )
                                }
                                sb.append(": ")
                                dumpExpr(in spec.value, from: ref p, to: ref sb)
                                sb.append(")")
                            }
                            sb.append(")")
                        } else {
                            dumpExpr(in h.value.expr, from: ref p, to: ref sb)
                        }
                }
            }
            sb.append(")")
        case .nameExpr(let n):
            sb.append(nameText(ref p, at: n.value.name))
            if n.value.typeArgs.length > 0 {
                sb.append("<")
                appendTypes(in n.value.typeArgs, from: ref p, to: ref sb)
                sb.append(">")
            }
        case .thisExpr(_):
            sb.append("this")
        case .memberExpr(let n):
            if p.collectNames && n.value.target is .nameExpr(let receiver) {
                p.collectedCalleeNames.append(receiver.value.name)
            }
            sb.append(n.value.nullConditional ? "(?. " : "(. ")
            dumpExpr(in n.value.target, from: ref p, to: ref sb)
            sb.append(" ")
            sb.append(nameText(ref p, at: n.value.member))
            if n.value.typeArgs.length > 0 {
                sb.append("<")
                appendTypes(in n.value.typeArgs, from: ref p, to: ref sb)
                sb.append(">")
            }
            sb.append(")")
        case .targetMemberExpr(let n):
            sb.append(".")
            sb.append(nameText(ref p, at: n.value.member))
        case .callExpr(let n):
            if p.collectNames && n.value.callee is .nameExpr(let callee) {
                p.collectedCalleeNames.append(callee.value.name)
            }
            sb.append("(call ")
            dumpExpr(in n.value.callee, from: ref p, to: ref sb)
            for arg in n.value.args {
                sb.append(" ")
                let wrapped = arg.name is not null || arg.modifier != .none
                if wrapped {
                    sb.append("(")
                }
                if (arg.name is { } an) {
                    sb.append(nameText(ref p, at: an))
                    sb.append(": ")
                }
                if arg.modifier != .none {
                    sb.append(arg.modifier switch {
                        .refKeyword  => "ref",
                        .moveKeyword => "move",
                        .outKeyword  => "out",
                        .inKeyword   => "in",
                        _            => "",
                    })
                    sb.append(" ")
                }
                dumpExpr(in arg.value, from: ref p, to: ref sb)
                if wrapped {
                    sb.append(")")
                }
            }
            if (n.value.becauseKeyword is { } bc) {
                sb.append(" because ")
                lexer.escape(bc.reason.bytes, to: ref sb)
            }
            sb.append(")")
        case .indexExpr(let n):
            sb.append("(index ")
            dumpExpr(in n.value.target, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.index, from: ref p, to: ref sb)
            sb.append(")")
        case .unaryExpr(let n):
            sb.append("(")
            sb.append(unaryText(n.value.op))
            sb.append(" ")
            dumpExpr(in n.value.operand, from: ref p, to: ref sb)
            sb.append(")")
        case .binaryExpr(let n):
            sb.append("(")
            sb.append(binaryText(n.value.op))
            sb.append(" ")
            dumpExpr(in n.value.left, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.right, from: ref p, to: ref sb)
            sb.append(")")
        case .rangeExpr(let n):
            sb.append("(")
            sb.append(n.value.inclusive ? "..=" : "..")
            sb.append(" ")
            if n.value.start is .none {
                sb.append("_")
            } else {
                dumpExpr(in n.value.start, from: ref p, to: ref sb)
            }
            sb.append(" ")
            if n.value.end is .none {
                sb.append("_")
            } else {
                dumpExpr(in n.value.end, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .inExpr(let n):
            sb.append("(in ")
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.range, from: ref p, to: ref sb)
            sb.append(")")
        case .conditionalExpr(let n):
            sb.append("(? ")
            dumpExpr(in n.value.condition, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.whenTrue, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.whenFalse, from: ref p, to: ref sb)
            sb.append(")")
        case .castExpr(let n):
            sb.append("(cast ")
            dumpType(in n.value.type, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.operand, from: ref p, to: ref sb)
            sb.append(")")
        case .isExpr(let n):
            sb.append("(is ")
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
            sb.append(" ")
            dumpPattern(in n.value.pattern, from: ref p, to: ref sb)
            sb.append(")")
        case .exceptExpr(let n):
            sb.append("(except ")
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
            sb.append(" ")
            dumpPattern(in n.value.pattern, from: ref p, to: ref sb)
            sb.append(")")
        case .switchExpr(let n):
            sb.append("(switch ")
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
            for arm in n.value.arms {
                sb.append(" (")
                dumpPattern(in arm.pattern, from: ref p, to: ref sb)
                if arm.guard is not .none {
                    sb.append(" when ")
                    dumpExpr(in arm.guard, from: ref p, to: ref sb)
                }
                sb.append(" => ")
                dumpExpr(in arm.value, from: ref p, to: ref sb)
                sb.append(")")
            }
            sb.append(")")
        case .tryExpr(let n):
            sb.append("(try ")
            dumpExpr(in n.value.operand, from: ref p, to: ref sb)
            sb.append(")")
        case .moveExpr(let n):
            sb.append("(move ")
            dumpExpr(in n.value.operand, from: ref p, to: ref sb)
            sb.append(")")
        case .catchExpr(let n):
            sb.append("(catch ")
            dumpExpr(in n.value.operand, from: ref p, to: ref sb)
            if (n.value.binding is { } b) {
                sb.append(" (")
                sb.append(nameText(ref p, at: b))
                sb.append(")")
            }
            if n.value.variant is not .none {
                sb.append(" (variant ")
                dumpExpr(in n.value.variant, from: ref p, to: ref sb)
                sb.append(")")
            }
            sb.append(" ")
            dumpExpr(in n.value.handler, from: ref p, to: ref sb)
            sb.append(")")
        case .blockExpr(let n):
            dumpBlockExpr(in n.value.block, from: ref p, to: ref sb)
        case .jumpExpr(let n):
            switch n.value.jump {
                case .returnStmt(let r):
                    if r.value.value is .none {
                        sb.append("(return)")
                    } else {
                        sb.append("(return ")
                        dumpExpr(in r.value.value, from: ref p, to: ref sb)
                        sb.append(")")
                    }
                case .failStmt(let f):
                    sb.append("(fail ")
                    dumpExpr(in f.value.error, from: ref p, to: ref sb)
                    sb.append(")")
                case .breakStmt(let b):
                    sb.append("(break")
                    if (b.value.label is { } lbl) {
                        sb.append(" ")
                        sb.append(nameText(ref p, at: lbl))
                    }
                    sb.append(")")
                case .continueStmt(let c):
                    sb.append("(continue")
                    if (c.value.label is { } lbl) {
                        sb.append(" ")
                        sb.append(nameText(ref p, at: lbl))
                    }
                    sb.append(")")
                default:
            }
        case .structLiteralExpr(let n):
            sb.append("(struct ")
            if n.value.type is .none {
                sb.append("_")
            } else {
                dumpType(in n.value.type, from: ref p, to: ref sb)
            }
            fieldInits(in n.value.fields, from: ref p, to: ref sb)
            sb.append(")")
        case .withExpr(let n):
            sb.append("(with ")
            dumpExpr(in n.value.target, from: ref p, to: ref sb)
            fieldInits(in n.value.fields, from: ref p, to: ref sb)
            sb.append(")")
        case .spreadExpr(let n):
            sb.append("(spread ")
            dumpExpr(in n.value.operand, from: ref p, to: ref sb)
            sb.append(")")
        case .mapEntryExpr(let n):
            sb.append("(entry ")
            dumpExpr(in n.value.key, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
            sb.append(")")
        case .collectionExpr(let n):
            sb.append("(")
            sb.append(allMapEntries(in n.value.elements) ? "map" : "list")
            for item in n.value.elements {
                sb.append(" ")
                dumpExpr(in item, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .tupleExpr(let n):
            sb.append("(tuple")
            for el in n.value.elements {
                sb.append(" ")
                if (el.name is { } nm) {
                    sb.append("(")
                    sb.append(nameText(ref p, at: nm))
                    sb.append(": ")
                    dumpExpr(in el.value, from: ref p, to: ref sb)
                    sb.append(")")
                } else {
                    dumpExpr(in el.value, from: ref p, to: ref sb)
                }
            }
            sb.append(")")
        case .parenExpr(let n):
            sb.append("(paren ")
            dumpExpr(in n.value.inner, from: ref p, to: ref sb)
            sb.append(")")
        case .lambdaExpr(let n):
            sb.append("(lambda (")
            var first = true
            for pp in n.value.params {
                if !first {
                    sb.append(" ")
                }
                first = false
                sb.append(nameText(ref p, at: pp))
            }
            sb.append(") ")
            if n.value.body is not .none {
                dumpExpr(in n.value.body, from: ref p, to: ref sb)
            } else {
                dumpBlockExpr(in n.value.block, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .stackallocExpr(let n):
            sb.append("(stackalloc ")
            dumpType(in n.value.element, from: ref p, to: ref sb)
            sb.append(" ")
            dumpExpr(in n.value.count, from: ref p, to: ref sb)
            sb.append(")")
        case .caughtErrorExpr(_):
            sb.append("(caught)")
        case .patternExpr(let n):
            sb.append("(pattern ")
            dumpPattern(in n.value.pattern, from: ref p, to: ref sb)
            sb.append(")")
        case .errorExpr(_):
            sb.append("<error>")
        case .none:
    }
}

/// The C# `Pattern(StringBuilder, Pattern)`: a pattern as an S-expression.
void dumpPattern(in Pattern pattern, from ref Parser p, to ref StrBuf sb) {
    switch pattern {
        case .constantPattern(let n):
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
        case .relationalPattern(let n):
            sb.append("(")
            sb.append(binaryText(n.value.op))
            sb.append(" ")
            dumpExpr(in n.value.value, from: ref p, to: ref sb)
            sb.append(")")
        case .varPattern(let n):
            sb.append(n.value.isLet ? "(let " : "(var ")
            sb.append(nameText(ref p, at: n.value.name))
            sb.append(")")
        case .discardPattern(_):
            sb.append("_")
        case .declarationPattern(let n):
            sb.append("(decl ")
            dumpType(in n.value.type, from: ref p, to: ref sb)
            sb.append(" ")
            sb.append(nameText(ref p, at: n.value.name))
            sb.append(")")
        case .notPattern(let n):
            sb.append("(not ")
            dumpPattern(in n.value.operand, from: ref p, to: ref sb)
            sb.append(")")
        case .binaryPattern(let n):
            sb.append(n.value.isAnd ? "(and " : "(or ")
            dumpPattern(in n.value.left, from: ref p, to: ref sb)
            sb.append(" ")
            dumpPattern(in n.value.right, from: ref p, to: ref sb)
            sb.append(")")
        case .propertyPattern(let n):
            sb.append("(props")
            if n.value.type is not .none {
                sb.append(" ")
                dumpType(in n.value.type, from: ref p, to: ref sb)
            }
            for sub in n.value.properties {
                sb.append(" (")
                var first = true
                for path in sub.path {
                    if !first {
                        sb.append(".")
                    }
                    first = false
                    sb.append(nameText(ref p, at: path))
                }
                sb.append(": ")
                dumpPattern(in sub.pattern, from: ref p, to: ref sb)
                sb.append(")")
            }
            sb.append(")")
            if (n.value.designation is { } d) {
                sb.append(" ")
                sb.append(nameText(ref p, at: d))
            }
        case .positionalPattern(let n):
            sb.append("(pos")
            if n.value.type is not .none {
                sb.append(" ")
                dumpType(in n.value.type, from: ref p, to: ref sb)
            }
            for el in n.value.elements {
                sb.append(" ")
                dumpPattern(in el, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .variantPattern(let n):
            sb.append("(variant .")
            if n.value.variant is .targetMemberExpr(let m) {
                sb.append(nameText(ref p, at: m.value.member))
            }
            if (n.value.binding is { } b) {
                sb.append(" ")
                sb.append(nameText(ref p, at: b))
            }
            for el in n.value.elements {
                sb.append(" ")
                dumpPattern(in el, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .slicePattern(let n):
            sb.append("(slice")
            if n.value.inner is not .none {
                sb.append(" ")
                dumpPattern(in n.value.inner, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .listPattern(let n):
            sb.append("(listp")
            for el in n.value.elements {
                sb.append(" ")
                dumpPattern(in el, from: ref p, to: ref sb)
            }
            sb.append(")")
        case .none:
    }
}

// ── T12 stand-ins (T15 deletes) ──────────────────────────────────────────────
// T11's `dump.byn` owns the `Stmt` switch, which `dumpExpr`'s `BlockExpr` flattens; until T11 lands
// this stub lets the module build. T15 deletes this struct and drops the `` prefix.

/// AstDump.cs:29 `TypeNames`: the one-part name of every type the tree spells, in dump order.
public List<TextSpan> typeNames(in CompilationUnit tree, from ref Parser p) uses alloc {
    p.collectedTypeNames = List<TextSpan>()
    p.collectNames = true
    var sb = StrBuf()
    dump(in tree, from: ref p, to: ref sb)
    p.collectNames = false
    return p.collectedTypeNames.copy()
}

/// AstDump.cs:40 `CalleeAndReceiverNames`: the name of every name expression that is a call's callee or a member access's receiver, in dump order.
public List<TextSpan> calleeAndReceiverNames(in CompilationUnit tree, from ref Parser p) uses alloc {
    p.collectedCalleeNames = List<TextSpan>()
    p.collectNames = true
    var sb = StrBuf()
    dump(in tree, from: ref p, to: ref sb)
    p.collectNames = false
    return p.collectedCalleeNames.copy()
}
== parser/exprs.byn
// Expressions A. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 3141–3605: precedence
// climbing, conditional, ranges, `is`/`in`/`except`/casts, unary, postfix, members, calls, index,
// `try`/`move`/`catch`. Owner:
//
// A C# node built as `new X(SpanFrom(start), …, ParseY())` takes its span before the child is
// parsed (C# evaluates arguments left to right), so the span ends before that child; the port
// takes the span at the same point (`move`, `fail`, `break`/`continue` labels, `except`, `?.`).
// The two `WithoutLambdas` sites save `noLambda`, make the call and restore it.

import lexer

// The C# `Prec`, as `i64` so that `prec + 1` past the last level binds nothing, as in C#.
const precNone: i64           = 0
const precCoalesce: i64       = 1
const precLogicalOr: i64      = 2
const precLogicalAnd: i64     = 3
const precBitOr: i64          = 4
const precBitXor: i64         = 5
const precBitAnd: i64         = 6
const precEquality: i64       = 7
const precRelational: i64     = 8
const precRange: i64          = 9
const precShift: i64          = 10
const precAdditive: i64       = 11
const precMultiplicative: i64 = 12

bool canStartExpression(TokenKind kind) => isContextualKeyword(kind) || kind switch {
    .identifier or .integerLiteral or .floatLiteral or .charLiteral or
        .stringLiteral or .rawStringLiteral or .cStringLiteral or .u16StringLiteral or
        .interpolatedStringStart or .openParen or .openBracket or .openBrace or
        .dot or .dotDot or .dotDotEquals or .plus or .minus or .bang or
        .notKeyword or .tilde or .caret or .trueKeyword or .falseKeyword or .nullKeyword or
        .thisKeyword or .tryKeyword or .newKeyword or .moveKeyword or .returnKeyword or
        .failKeyword or .breakKeyword or .continueKeyword => true,
    _ => false,
}

Expr parseExpression(ref Parser p) {
    let start = p.current().start
    let condition = parseBinary(ref p, at: precCoalesce)
    return condition if p.kind() != .question || stopsHere(ref p)
    let _ = p.advance()
    let whenTrue = parseExpression(ref p)
    let _ = p.expect(.colon)
    let whenFalse = parseExpression(ref p)
    return Expr.conditionalExpr(Owned(ConditionalExpr {
        span: p.spanFrom(start),
        condition: move condition,
        whenTrue: move whenTrue,
        whenFalse: move whenFalse,
    }))
}

(BinaryOp op, i64 prec, i64 width) binaryOperator(ref Parser p) {
    let kind = p.kind()
    if kind == .greater {
        return (op: BinaryOp.shr, prec: precShift, width: 2) if p.atShiftRight()
        return (op: BinaryOp.add, prec: precNone, width: 0) if p.peek(1) == .greaterEquals
            && !p.peekToken(1).hasTriviaBefore
        return (op: BinaryOp.gt, prec: precRelational, width: 1)
    }
    return kind switch {
        .questionQuestion      => (op: BinaryOp.coalesce, prec: precCoalesce, width: 1),
        .barBar or .orKeyword  => (op: BinaryOp.logicalOr, prec: precLogicalOr, width: 1),
        .ampAmp or .andKeyword => (op: BinaryOp.logicalAnd, prec: precLogicalAnd, width: 1),
        .bar                   => (op: BinaryOp.bitOr, prec: precBitOr, width: 1),
        .caret                 => (op: BinaryOp.bitXor, prec: precBitXor, width: 1),
        .amp                   => (op: BinaryOp.bitAnd, prec: precBitAnd, width: 1),
        .equalsEquals          => (op: BinaryOp.eq, prec: precEquality, width: 1),
        .bangEquals            => (op: BinaryOp.ne, prec: precEquality, width: 1),
        .less                  => (op: BinaryOp.lt, prec: precRelational, width: 1),
        .lessEquals            => (op: BinaryOp.le, prec: precRelational, width: 1),
        .greaterEquals         => (op: BinaryOp.ge, prec: precRelational, width: 1),
        .lessLess              => (op: BinaryOp.shl, prec: precShift, width: 1),
        .plus                  => (op: BinaryOp.add, prec: precAdditive, width: 1),
        .minus                 => (op: BinaryOp.sub, prec: precAdditive, width: 1),
        .plusPercent           => (op: BinaryOp.addWrap, prec: precAdditive, width: 1),
        .minusPercent          => (op: BinaryOp.subWrap, prec: precAdditive, width: 1),
        .plusBar               => (op: BinaryOp.addSat, prec: precAdditive, width: 1),
        .minusBar              => (op: BinaryOp.subSat, prec: precAdditive, width: 1),
        .star                  => (op: BinaryOp.mul, prec: precMultiplicative, width: 1),
        .slash                 => (op: BinaryOp.div, prec: precMultiplicative, width: 1),
        .percent               => (op: BinaryOp.rem, prec: precMultiplicative, width: 1),
        .starPercent           => (op: BinaryOp.mulWrap, prec: precMultiplicative, width: 1),
        .starBar               => (op: BinaryOp.mulSat, prec: precMultiplicative, width: 1),
        _                      => (op: BinaryOp.add, prec: precNone, width: 0),
    }
}

Expr parseBinary(ref Parser p, at i64 minPrec) {
    let start = p.current().start
    if (p.kind() == .dotDot || p.kind() == .dotDotEquals) && minPrec <= precRange {
        let inclusive = p.advance().kind == .dotDotEquals
        var end: Expr = .none
        if canStartRangeEnd(ref p) {
            end = parseBinary(ref p, at: precShift)
        }
        let left = Expr.rangeExpr(
            Owned(RangeExpr { span: p.spanFrom(start), start: .none, end: move end, inclusive: inclusive }),
        )
        return parseBinaryRest(ref p, from: start, by: move left, at: minPrec)
    }
    let left = parseUnary(ref p)
    return parseBinaryRest(ref p, from: start, by: move left, at: minPrec)
}

/// The operators after `first`, which started at `start`.
Expr parseBinaryRest(ref Parser p, from i64 start, by move Expr first, at i64 minPrec) {
    var left = move first
    while true {
        return left if stopsHere(ref p)
        if p.kind() == .isKeyword && minPrec <= precRelational {
            let _ = p.advance()
            let pattern = parsePattern(ref p)
            left = Expr.isExpr(Owned(IsExpr { span: p.spanFrom(start), value: move left, pattern: move pattern }))
            continue
        }
        if p.kind() == .exceptKeyword && minPrec <= precRelational {
            let _ = p.advance()
            let span = p.spanFrom(start)
            let pattern = parseExceptPattern(ref p)
            left = Expr.exceptExpr(Owned(ExceptExpr { span: span, value: move left, pattern: move pattern }))
            continue
        }
        if p.kind() == .inKeyword && minPrec <= precRelational {
            let _ = p.advance()
            let range = parseBinary(ref p, at: precRange)
            left = Expr.inExpr(Owned(InExpr { span: p.spanFrom(start), value: move left, range: move range }))
            continue
        }
        if (p.kind() == .dotDot || p.kind() == .dotDotEquals) && minPrec <= precRange {
            let inclusive = p.advance().kind == .dotDotEquals
            var end: Expr = .none
            if canStartRangeEnd(ref p) {
                end = parseBinary(ref p, at: precShift)
            }
            left = Expr.rangeExpr(
                Owned(RangeExpr { span: p.spanFrom(start), start: move left, end: move end, inclusive: inclusive }),
            )
            continue
        }
        if p.kind() == .catchKeyword && minPrec <= precCoalesce {
            left = parseCatch(ref p, from: start, by: move left)
            continue
        }
        let operator = binaryOperator(ref p)
        return left if operator.prec == precNone || operator.prec < minPrec
        for _ in 0..operator.width {
            let _ = p.advance()
        }
        // A line ending in an operator continues (lā), but not across a blank line outside brackets.
        if breaksLine(ref p, at: p.pos) && hasBlankLineBefore(ref p, at: p.pos) {
            let _ = p.report(
                .expectedExpression,
                at: TextSpan { start: p.prevEnd, length: 0 },
                arg0: "a blank line",
                label: "the statement ends here",
                help: "remove the blank line, or finish the expression on this line",
            )
        }
        // `??` is right-associative; everything else is left-associative.
        let right = operator.op == .coalesce ? parseBinary(
            ref p,
            at: operator.prec,
        ) : parseBinary(ref p, at: operator.prec + 1)
        left = Expr.binaryExpr(
            Owned(BinaryExpr { span: p.spanFrom(start), op: operator.op, left: move left, right: move right }),
        )
        if operator.op is .logicalAnd or .logicalOr {
            noteLogical(ref p, for: left)
        }
    }
}

/// The pattern after `except`. A constant followed by a comparison or logical operator is a condition (BYN1052);
/// the whole condition is parsed so the statement still ends where it should.
Pattern parseExceptPattern(ref Parser p) {
    let pattern = parsePattern(ref p)
    var constantStart: i64 = -1
    switch pattern {
        case .constantPattern(let constant):
            constantStart = constant.value.span.start
        default:
            return pattern
    }
    return pattern if stopsHere(ref p)
    let prec = binaryOperator(ref p).prec
    return pattern if (prec == precNone || prec == precCoalesce) && p.kind() != .isKeyword && p.kind() != .inKeyword
    let value = reparseConstant(ref p, from: constantStart)
    let condition = parseBinaryRest(ref p, from: constantStart, by: move value, at: precLogicalOr)
    let span = exprSpan(in condition)
    let _ = p.report(.exceptNotPattern, at: span, label: "a condition", help: "use `where` for a condition")
    return Pattern.constantPattern(Owned(ConstantPattern { span: span, value: move condition }))
}

/// The value of the constant pattern that `parsePattern` just read from `start`, which ends at the cursor. The
/// value cannot be moved out of its `Owned` node (BYN2782, Q471), so it is parsed again as the C# `ParsePrimaryPattern`
/// parses a constant, with the diagnostics of the second parse dropped.
Expr reparseConstant(ref Parser p, from i64 start) {
    let after = p.pos
    let afterEnd = p.prevEnd
    let diagnostics = p.lexed.diagnostics.length
    let syntaxErrors = p.syntaxErrors
    let lastErrorAt = p.lastErrorAt
    var index = after
    while index > 0 && p.lexed.tokens[index - 1].start >= start {
        index -= 1
    }
    p.pos = index
    p.prevEnd = index > 0 ? p.lexed.tokens[index - 1].end : 0
    let saved = p.setNoLambda(value: true)
    let value = parseBinary(ref p, at: precRange)
    p.noLambda = saved
    while p.lexed.diagnostics.length > diagnostics {
        let _ = p.lexed.diagnostics.removeLast()
    }
    p.syntaxErrors = syntaxErrors
    p.lastErrorAt = lastErrorAt
    p.pos = after
    p.prevEnd = afterEnd
    return value
}

bool canStartRangeEnd(ref Parser p) {
    let kind = p.kind()
    return canStartExpression(kind) && kind != .openBrace && kind != .dotDot && kind != .dotDotEquals
}

Expr parseCatch(ref Parser p, from i64 start, by move Expr operand) {
    let _ = p.advance()
    var binding: TextSpan? = null
    var variant: Expr = .none
    if p.kind() == .openParen && isName(p.peek(1)) && p.peek(2) == .closeParen {
        let openToken = p.advance()
        let name = spanOf(p.advance())
        binding = name
        let span = TextSpan.fromBounds(openToken.start, until: p.advance().end)
        let text = p.lexed.source.getText(name)
        if p.kind() == .switchKeyword {
            let _ = p.reportFix(
                .catchBinding,
                at: span,
                through: TextSpan.fromBounds(openToken.start, until: p.current().start),
                by: "",
                label: "the input form",
                help: $"remove `({text})` and bind the error in each arm: `E {text} => …`",
            )
        } else {
            let _ = p.report(
                .catchBinding,
                at: span,
                label: "the input form",
                help: $"write `catch switch {{ E {text} => … }}`, binding the error in each arm",
            )
        }
    } else if p.kind() == .openParen {
        let _ = p.advance()
        variant = parseExpression(ref p)
        let _ = p.expect(.closeParen)
    }

    var handler: Expr = .none
    if p.kind() == .switchKeyword {
        let switchStart = p.current().start
        var subject = Expr.caughtErrorExpr(Owned(CaughtErrorExpr { span: spanOf(p.current()) }))
        if binding is not null {
            let name = binding ?? TextSpan { start: 0, length: 0 }
            subject = Expr.nameExpr(Owned(NameExpr { span: name, name: name, typeArgs: List<TypeSyntax>() }))
        }
        let _ = p.advance()
        handler = parseSwitchArms(ref p, from: switchStart, by: move subject)
    } else if p.kind() == .openBrace
            && !(isName(p.peek(1)) && p.peek(2) == .colon && !braceBodyHasStatementBreak(ref p)) {
        // `catch { x: 1 }` stays a target-typed struct literal; `catch {}`, `catch { x = 1 }` and a body of
        // several statements, one per line, are blocks.
        let block = parseBlock(ref p)
        let span = blockSpan(in block)
        handler = Expr.blockExpr(Owned(BlockExpr { span: span, block: move block }))
    } else {
        handler = parseBinary(ref p, at: precLogicalOr)
    }
    return Expr.catchExpr(Owned(CatchExpr {
        span: p.spanFrom(start),
        operand: move operand,
        binding: binding,
        variant: move variant,
        handler: move handler,
    }))
}

Expr parseUnary(ref Parser p) {
    // `with` binds looser than every prefix operator: `move tx with { … }` is `(move tx) with { … }` (revision 0008).
    let start = p.current().start
    var expr = parsePrefixed(ref p)
    while !breaksLine(ref p, at: p.pos) {
        if p.kind() == .switchKeyword && p.peek(1) == .openBrace {
            let _ = p.advance()
            expr = parseSwitchArms(ref p, from: start, by: move expr)
        } else if p.kind() == .withKeyword && p.peek(1) == .openBrace {
            let _ = p.advance()
            let fields = parseFieldInits(ref p)
            expr = Expr.withExpr(Owned(WithExpr { span: p.spanFrom(start), target: move expr, fields: move fields }))
        } else {
            break
        }
    }
    return expr
}

Expr parsePrefixed(ref Parser p) {
    let start = p.current().start
    let kind = p.kind()
    if kind is .plus or .minus or .bang or .notKeyword or .tilde or .caret {
        let op = kind switch {
            .plus  => UnaryOp.plus,
            .minus => UnaryOp.negate,
            .tilde => UnaryOp.complement,
            .caret => UnaryOp.fromEnd,
            _      => UnaryOp.notKeyword,
        }
        let _ = p.advance()
        let operand = parsePrefixed(ref p)
        return Expr.unaryExpr(Owned(UnaryExpr { span: p.spanFrom(start), op: op, operand: move operand }))
    }
    if kind == .tryKeyword {
        // `try` covers the whole expression to its right, down to `??`; `?:` and assignment stay outside (§18, J18).
        let _ = p.advance()
        let covered = parseBinary(ref p, at: precCoalesce)
        return Expr.tryExpr(Owned(TryExpr { span: p.spanFrom(start), operand: move covered }))
    }
    if kind == .moveKeyword {
        let _ = p.advance()
        let span = p.spanFrom(start)
        let operand = parsePrefixed(ref p)
        return Expr.moveExpr(Owned(MoveExpr { span: span, operand: move operand }))
    }
    if kind == .newKeyword {
        // Accepted for C# compatibility; the formatter removes it.
        let _ = p.advance()
        return parseUnary(ref p)
    }
    if kind == .returnKeyword {
        let _ = p.advance()
        let next = p.kind()
        var value: Expr = .none
        if canStartExpression(next) && !breaksLine(ref p, at: p.pos)
                && next != .returnKeyword && next != .breakKeyword && next != .continueKeyword {
            value = parseBinary(ref p, at: precLogicalOr)
        }
        let jump = Stmt.returnStmt(Owned(ReturnStmt { span: p.spanFrom(start), value: move value }))
        return Expr.jumpExpr(Owned(JumpExpr { span: p.spanFrom(start), jump: move jump }))
    }
    if kind == .failKeyword {
        let _ = p.advance()
        let span = p.spanFrom(start)
        let error = parseBinary(ref p, at: precLogicalOr)
        let jump = Stmt.failStmt(Owned(FailStmt { span: span, error: move error }))
        return Expr.jumpExpr(Owned(JumpExpr { span: span, jump: move jump }))
    }
    if kind is .breakKeyword or .continueKeyword {
        let _ = p.advance()
        let span = p.spanFrom(start)
        var label: TextSpan? = null
        if p.kind() == .identifier && !p.current().hasNewlineBefore {
            label = spanOf(p.advance())
        }
        if kind == .breakKeyword {
            let jump = Stmt.breakStmt(Owned(BreakStmt { span: span, label: label }))
            return Expr.jumpExpr(Owned(JumpExpr { span: span, jump: move jump }))
        }
        let jump = Stmt.continueStmt(Owned(ContinueStmt { span: span, label: label }))
        return Expr.jumpExpr(Owned(JumpExpr { span: span, jump: move jump }))
    }
    if kind == .openParen && isCast(ref p) {
        let _ = p.advance()
        let typeStart = p.current().start
        let castType = parseType(ref p)
        // The C# `type.Span`: a type's span runs from its first token to the last one parsed.
        let typeText = p.lexed.source.getText(p.spanFrom(typeStart))
        let _ = p.expect(.closeParen)
        let typeSpan = p.spanFrom(start)
        let operand = parsePrefixed(ref p)
        var inner = exprSpan(in operand)
        switch operand {
            case .parenExpr(let paren):
                inner = exprSpan(in paren.value.inner)
            default:
                inner = exprSpan(in operand)
        }
        let _ = p.reportFix(
            .castInput,
            at: typeSpan,
            through: p.spanFrom(start),
            by: $"{typeText}({p.lexed.source.getText(inner)})",
            arg0: typeText,
            label: "a cast",
            help: $"call the conversion: `{typeText}(x)`",
        )
        return Expr.castExpr(Owned(CastExpr { span: p.spanFrom(start), type: move castType, operand: move operand }))
    }

    // `switch` stays tighter than prefix operators: `move x switch { … }` is `move (x switch { … })` (§9.3).
    let primary = parsePrimary(ref p)
    var expr = parsePostfix(ref p, by: move primary)
    while !breaksLine(ref p, at: p.pos) && p.kind() == .switchKeyword && p.peek(1) == .openBrace {
        let _ = p.advance()
        expr = parseSwitchArms(ref p, from: start, by: move expr)
    }
    return expr
}

bool isCast(ref Parser p) {
    let after = scanType(ref p, at: p.pos + 1)
    return false if after < 0 || p.kindAt(after) != .closeParen
    let next = p.kindAt(after + 1)
    return isContextualKeyword(next) || next switch {
        .identifier or .integerLiteral or .floatLiteral or .charLiteral or
            .stringLiteral or .rawStringLiteral or .interpolatedStringStart or
            .openParen or .bang or .tilde or .thisKeyword or
            .trueKeyword or .falseKeyword or .nullKeyword or .tryKeyword or .newKeyword => true,
        _ => false,
    }
}

Expr parseSwitchArms(ref Parser p, from i64 start, by move Expr value) {
    let subject = move value
    var caught = false
    switch subject {
        case .caughtErrorExpr(_):
            caught = true
        default:
            caught = false
    }
    let openToken = p.expect(.openBrace)
    var arms = List<SwitchArm>()
    while p.kind() != .closeBrace && !p.atEnd() {
        let armStart = p.current().start
        let before = p.pos
        let pattern = parseArmPattern(ref p, for: "")
        var guard: Expr = .none
        if atContextual(ref p, as: "when") {
            let _ = p.advance()
            let saved = p.setNoLambda(value: true)
            guard = parseExpression(ref p)
            p.noLambda = saved
        }
        let _ = p.expect(.fatArrow)
        // A `catch switch` arm may be a block, read as a `catch` block is (J49); elsewhere `{` starts a struct literal.
        var result: Expr = .none
        if caught
                && p.kind() == .openBrace
                && !(isName(p.peek(1)) && p.peek(2) == .colon && !braceBodyHasStatementBreak(ref p)) {
            let block = parseBlock(ref p)
            let span = blockSpan(in block)
            result = Expr.blockExpr(Owned(BlockExpr { span: span, block: move block }))
        } else {
            result = parseExpression(ref p)
        }
        arms.append(
            SwitchArm { span: p.spanFrom(armStart), pattern: move pattern, guard: move guard, value: move result },
        )
        unless p.accept(.comma) {
            break
        }
        break if p.pos == before
    }
    expectClose(ref p, from: openToken, for: "switch")
    return Expr.switchExpr(Owned(SwitchExpr { span: p.spanFrom(start), value: move subject, arms: move arms }))
}

Expr parsePostfix(ref Parser p, by move Expr first) {
    var expr = move first
    let start = exprSpan(in expr).start
    while true {
        return expr if stopsHere(ref p)
        let kind = p.kind()
        if kind == .dot && isName(p.peek(1)) {
            let _ = p.advance()
            let member = spanOf(p.advance())
            var typeArgs = List<TypeSyntax>()
            if p.kind() == .less && isTypeArgsBeforeCall(ref p) {
                typeArgs = parseTypeArgs(ref p)
            }
            expr = Expr.memberExpr(Owned(MemberExpr {
                span: p.spanFrom(start),
                target: move expr,
                member: member,
                nullConditional: false,
                typeArgs: move typeArgs,
            }))
        } else if kind == .questionDot {
            let _ = p.advance()
            let span = p.spanFrom(start)
            let member = expectName(ref p, "a member name")
            expr = Expr.memberExpr(
                Owned(MemberExpr { span: span, target: move expr, member: member, nullConditional: true }),
            )
        } else if kind == .openParen {
            let args = parseArguments(ref p)
            var call = CallExpr { span: p.spanFrom(start), callee: move expr, args: move args }
            reportTrustInput(ref p, for: in call)
            let construct = $"{p.lexed.source.getText(exprSpan(in call.callee))}()"
            call.becauseKeyword = parseBecause(ref p, for: construct, at: call.span)
            expr = Expr.callExpr(Owned(move call))
        } else if kind == .openBracket {
            let _ = p.advance()
            let index = parseExpression(ref p)
            let _ = p.expect(.closeBracket)
            expr = Expr.indexExpr(Owned(IndexExpr { span: p.spanFrom(start), target: move expr, index: move index }))
        } else {
            return expr
        }
    }
}

bool isTypeArgsBeforeCall(ref Parser p) {
    let after = scanExprTypeArgs(ref p, at: p.pos)
    return after > 0 && p.kindAt(after) == .openParen
}

/// BYN1062 at `trust(x, reason: …)`; the fix writes `x.trustUnchecked() because "…"` when the reason is a
/// string literal, with `x` in parentheses unless it is a primary expression, and the whole in parentheses
/// unless the call ends its expression.
void reportTrustInput(ref Parser p, for in CallExpr call) {
    var calleeSpan = TextSpan { start: 0, length: 0 }
    switch call.callee {
        case .nameExpr(let callee):
            let name = callee.value.name
            return if callee.value.typeArgs.length != 0
                || !lexer.sameBytes(p.lexed.source.bytes.span[name.start..name.end], as: "trust".bytes)
            calleeSpan = callee.value.span
        default:
            return
    }
    return if call.args.length != 2
    return if call.args[0].name is not null || call.args[0].modifier != .none || call.args[1].modifier != .none
    let reasonName = call.args[1].name ?? TextSpan { start: 0, length: -1 }
    return if reasonName.length < 0
        || !lexer.sameBytes(p.lexed.source.bytes.span[reasonName.start..reasonName.end], as: "reason".bytes)
    var isString = false
    switch call.args[1].value {
        case .literalExpr(let literal):
            isString = literal.value.kind == .string
        default:
            isString = false
    }
    unless isString {
        let _ = p.report(
            .trustInput,
            at: calleeSpan,
            label: "the input form",
            help: "call `trustUnchecked()` on the value and give the reason in `because`",
        )
        return
    }
    var text = p.lexed.source.getText(exprSpan(in call.args[0].value))
    var primary = false
    switch call.args[0].value {
        case .nameExpr(_) or .memberExpr(_) or .callExpr(_) or .indexExpr(_) or .literalExpr(_) or .parenExpr(_):
            primary = true
        default:
            primary = false
    }
    unless primary {
        text = $"({text})"
    }
    text = $"{text}.trustUnchecked() because {p.lexed.source.getText(exprSpan(in call.args[1].value))}"
    // Anything after the call other than a closer would read as part of the reason.
    let kind = p.kind()
    let ends = p.current().hasNewlineBefore || kind == .closeParen || kind == .comma || kind == .closeBracket
        || kind == .closeBrace || kind == .interpolationEnd || kind == .endOfFile
    let _ = p.reportFix(
        .trustInput,
        at: calleeSpan,
        through: call.span,
        by: ends ? text : $"({text})",
        label: "the input form",
        help: "call `trustUnchecked()` on the value and give the reason in `because`",
    )
}

List<Argument> parseArguments(ref Parser p) {
    let saved = p.setNoLambda(value: false)
    let args = parseArgumentList(ref p)
    p.noLambda = saved
    return args
}

List<Argument> parseArgumentList(ref Parser p) {
    let _ = p.expect(.openParen)
    var args = List<Argument>()
    if p.kind() != .closeParen {
        while true {
            break if p.kind() == .closeParen
            let start = p.current().start
            var name: TextSpan? = null
            // `for` and `as` are keywords, but labels in argument position (`for: user`).
            if (isName(p.kind()) || p.kind() == .forKeyword || p.kind() == .asKeyword) && p.peek(1) == .colon {
                name = spanOf(p.advance())
                let _ = p.advance()
            }
            let modifier = p.kind() switch {
                .refKeyword  => ArgModifier.refKeyword,
                .moveKeyword => ArgModifier.moveKeyword,
                .outKeyword  => ArgModifier.outKeyword,
                .inKeyword   => ArgModifier.inKeyword,
                _            => ArgModifier.none,
            }
            if modifier != .none {
                let _ = p.advance()
            }
            p.argumentStarts[p.pos] = true
            let value = parseExpression(ref p)
            args.append(Argument { span: p.spanFrom(start), name: name, modifier: modifier, value: move value })
            unless p.accept(.comma) {
                break
            }
        }
    }
    let _ = p.expect(.closeParen)
    return args
}

/// The C# `Expr.Span`.
public TextSpan exprSpan(in Expr e) => e switch {
    .literalExpr(let n)       => n.value.span,
    .interpolatedExpr(let n)  => n.value.span,
    .nameExpr(let n)          => n.value.span,
    .thisExpr(let n)          => n.value.span,
    .memberExpr(let n)        => n.value.span,
    .targetMemberExpr(let n)  => n.value.span,
    .callExpr(let n)          => n.value.span,
    .indexExpr(let n)         => n.value.span,
    .unaryExpr(let n)         => n.value.span,
    .binaryExpr(let n)        => n.value.span,
    .rangeExpr(let n)         => n.value.span,
    .conditionalExpr(let n)   => n.value.span,
    .castExpr(let n)          => n.value.span,
    .isExpr(let n)            => n.value.span,
    .exceptExpr(let n)        => n.value.span,
    .inExpr(let n)            => n.value.span,
    .switchExpr(let n)        => n.value.span,
    .tryExpr(let n)           => n.value.span,
    .moveExpr(let n)          => n.value.span,
    .catchExpr(let n)         => n.value.span,
    .caughtErrorExpr(let n)   => n.value.span,
    .jumpExpr(let n)          => n.value.span,
    .blockExpr(let n)         => n.value.span,
    .structLiteralExpr(let n) => n.value.span,
    .withExpr(let n)          => n.value.span,
    .spreadExpr(let n)        => n.value.span,
    .mapEntryExpr(let n)      => n.value.span,
    .collectionExpr(let n)    => n.value.span,
    .tupleExpr(let n)         => n.value.span,
    .parenExpr(let n)         => n.value.span,
    .lambdaExpr(let n)        => n.value.span,
    .stackallocExpr(let n)    => n.value.span,
    .patternExpr(let n)       => n.value.span,
    .errorExpr(let n)         => n.value.span,
    .none                     => TextSpan { start: 0, length: 0 },
}

/// The span of the `BlockStmt` that `parseBlock` returns.
public TextSpan blockSpan(in Stmt block) {
    switch block {
        case .blockStmt(let n):
            return n.value.span
        default:
            return TextSpan { start: 0, length: 0 }
    }
}

// ── T9 stand-ins ─────────────────────────────────────────────────────────────
// Helpers other files own, which their stubs do not declare yet (Q470). Each has the signature this
// file calls; T15 deletes this section once the owners' definitions merge.
== parser/exprs2.byn
// Expressions B. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 3607–4056: primaries, literals and
// interpolation, collections, struct literals, lambdas, block and switch expressions. Owner:
//
// `with`, block and switch expressions are built in T9's range (`ParsePostfix`, `ParseSwitchExpr`);
// `parseFieldInits` and `braceBodyHasStatementBreak` here are what they call. A C# `NameOf(token)` is
// `spanOf(token)`: a name is its span. The C# renames in place (`int` → `i32` in `ParseTypeNameOnly`,
// the `as`/`digits` names of `ParseCompactSpec`) cannot be stored in a span (Q475).

import lexer

Expr parsePrimary(ref Parser p) {
    let start = p.current().start
    let token = p.current()
    let kind = token.kind
    switch kind {
        case .integerLiteral or .floatLiteral:
            let _ = p.advance()
            var suffix: TextSpan? = null
            if p.kind() == .numericSuffix && !p.current().hasTriviaBefore {
                suffix = spanOf(p.advance())
            }
            let literal: LiteralKind = kind == .integerLiteral ? .integer : .floatKeyword
            return Expr.literalExpr(
                Owned(LiteralExpr { span: p.spanFrom(start), kind: literal, text: p.textOf(token), suffix: suffix }),
            )
        case .charLiteral:
            let _ = p.advance()
            return literal(.char, at: spanOf(token), as: p.textOf(token))
        case .stringLiteral:
            let _ = p.advance()
            return literal(.string, at: spanOf(token), as: decodeString(p.text(token)))
        case .cStringLiteral:
            let _ = p.advance()
            return literal(.cString, at: spanOf(token), as: decodeString(p.text(token)))
        case .u16StringLiteral:
            let _ = p.advance()
            return literal(.u16String, at: spanOf(token), as: decodeString(p.text(token)))
        case .rawStringLiteral:
            let _ = p.advance()
            return literal(.rawString, at: spanOf(token), as: decodeRawString(p.text(token)))
        case .trueKeyword:
            let _ = p.advance()
            return literal(.trueKeyword, at: spanOf(token), as: "true")
        case .falseKeyword:
            let _ = p.advance()
            return literal(.falseKeyword, at: spanOf(token), as: "false")
        case .nullKeyword:
            let _ = p.advance()
            return literal(.nullKeyword, at: spanOf(token), as: "null")
        case .thisKeyword:
            let _ = p.advance()
            return Expr.thisExpr(Owned(ThisExpr { span: spanOf(token) }))
        case .interpolatedStringStart:
            return parseInterpolated(ref p)
        default:
            if kind == .dot && isName(p.peek(1)) {
                let _ = p.advance()
                let member = spanOf(p.advance())
                return Expr.targetMemberExpr(Owned(TargetMemberExpr { span: p.spanFrom(start), member: member }))
            }
            return parseLambda(ref p) if kind == .openParen
                && !p.noLambda
                && p.kindAt(matchingClose(ref p, at: p.pos) + 1) == .fatArrow
            return parseParenOrTuple(ref p) if kind == .openParen
            return parseCollection(ref p) if kind == .openBracket
            return parseLambda(ref p) if isName(kind) && p.peek(1) == .fatArrow && !p.noLambda
            if kind == .openBrace && braceLiteralAllowed(ref p) {
                let fields = parseFieldInits(ref p)
                return Expr.structLiteralExpr(
                    Owned(StructLiteralExpr { span: p.spanFrom(start), type: .none, fields: move fields }),
                )
            }
            if kind == .identifier && isPatternExprStart(ref p) {
                let _ = p.report(
                    .patternOutsideConst,
                    at: spanOf(token),
                    label: "`pattern` outside a `const`",
                    help: "declare the pattern as `const name = pattern T { … }`",
                )
                return parsePatternExpr(ref p)
            }
            return parseNameOrStructLiteral(ref p) if kind == .identifier || isContextualKeyword(kind)
            if kind == .neverKeyword {
                let _ = p.advance()
                return Expr.nameExpr(
                    Owned(NameExpr { span: spanOf(token), name: spanOf(token), typeArgs: List<TypeSyntax>() }),
                )
            }
    }
    let _ = p.report(.expectedExpression, at: spanOf(p.current()), arg0: p.describe(p.current()))
    return Expr.errorExpr(Owned(ErrorExpr { span: TextSpan { start: start, length: 0 } }))
}

/// A `LiteralExpr` with no suffix.
Expr literal(LiteralKind kind, at TextSpan span, as string text) =>
    Expr.literalExpr(Owned(LiteralExpr { span: span, kind: kind, text: text, suffix: null }))

/// `x => body`, `(a, b) => body` or `() => body`; the body is a block on `{`, else an expression. A
/// parameter is a name only: a type, a modifier, a particle or a default is an error.
Expr parseLambda(ref Parser p) {
    let start = p.current().start
    var parameters = List<TextSpan>()
    if p.kind() != .openParen {
        parameters.append(spanOf(p.advance()))
    } else {
        let close = matchingClose(ref p, at: p.pos)
        let _ = p.advance()
        while p.pos < close {
            if isName(p.kind()) && (p.peek(1) == .comma || p.peek(1) == .closeParen) {
                parameters.append(spanOf(p.advance()))
                if p.pos < close {
                    let _ = p.advance()
                }
                continue
            }
            if p.kind() == .comma {
                let _ = p.report(
                    .expected,
                    at: spanOf(p.current()),
                    arg0: "a lambda parameter name",
                    arg1: "`,`",
                    label: "an empty parameter",
                    help: "write the parameter's name",
                )
                let _ = p.advance()
                continue
            }
            let from = p.pos
            var depth: i64 = 0
            while p.pos < close && !(depth == 0 && p.kind() == .comma) {
                switch p.kind() {
                    case .openParen or .openBracket or .openBrace:
                        depth += 1
                    case .closeParen or .closeBracket or .closeBrace:
                        depth -= 1
                    default:
                        let _ = 0
                }
                let _ = p.advance()
            }
            let text = tokensText(ref p, from: from, to: p.pos)
            let _ = p.report(
                .expected,
                at: TextSpan.fromBounds(p.lexed.tokens[from].start, until: p.prevEnd),
                arg0: "a lambda parameter name",
                arg1: $"`{text}`",
                label: "not a bare name",
                help: "write the parameter's name only; a lambda takes its parameter types from the function type it is passed to",
            )
            if p.pos < close {
                let _ = p.advance()
            }
        }
        let _ = p.expect(.closeParen)
        // A mismatched closer (`(a] => 1`) was reported by expect; step over it to the `=>`.
        if p.pos == close && p.kind() != .fatArrow {
            let _ = p.advance()
        }
    }
    let _ = p.expect(.fatArrow)
    if p.kind() == .openBrace {
        // The C# takes the span before it parses the block, so it ends at `=>` (work/todo.md).
        let span = p.spanFrom(start)
        let block = parseBlock(ref p)
        return Expr.lambdaExpr(
            Owned(LambdaExpr { span: span, params: move parameters, body: .none, block: move block }),
        )
    }
    let body = parseExpression(ref p)
    let span = p.spanFrom(start)
    lintItLambda(ref p, at: span, for: parameters, by: body, from: tokenAt(ref p, at: start))
    return Expr.lambdaExpr(Owned(LambdaExpr { span: span, params: move parameters, body: move body, block: .none }))
}

/// The contextual `pattern` followed on its line by a type name; `pattern` is a name everywhere else,
/// and a name followed by a name is never an expression.
bool isPatternExprStart(ref Parser p) =>
    atContextual(ref p, as: "pattern") && p.peek(1) == .identifier && !p.peekToken(1).hasNewlineBefore

Expr parsePatternExpr(ref Parser p) {
    let start = p.advance().start
    let pattern = parsePattern(ref p)
    return Expr.patternExpr(Owned(PatternExpr { span: p.spanFrom(start), pattern: move pattern }))
}

Expr parseNameOrStructLiteral(ref Parser p) {
    let start = p.current().start
    let token = p.advance()
    let name = spanOf(token)
    let upper = lexer.firstIsUpper(p.text(token))

    if lexer.sameBytes(p.text(token), as: "stackalloc".bytes) && isTypeNameToken(p.kind()) {
        let element = parseTypeNameOnly(ref p)
        let _ = p.expect(.openBracket)
        let count = parseExpression(ref p)
        let _ = p.expect(.closeBracket)
        return Expr.stackallocExpr(
            Owned(StackallocExpr { span: p.spanFrom(start), element: move element, count: move count }),
        )
    }

    var typeArgs = List<TypeSyntax>()
    if p.kind() == .less {
        let after = scanExprTypeArgs(ref p, at: p.pos)
        if after > 0 && endsExprTypeArgs(p.kindAt(after)) {
            typeArgs = parseTypeArgs(ref p)
        }
    }

    if p.kind() == .openBrace
            && !breaksLine(ref p, at: p.pos)
            && isStructLiteralBody(ref p)
            && upper
            && braceLiteralAllowed(ref p) {
        var path = List<TextSpan>()
        path.append(name)
        let type = TypeSyntax.namedType(
            Owned(NamedType { span: p.spanFrom(start), path: move path, args: move typeArgs }),
        )
        let fields = parseFieldInits(ref p)
        return Expr.structLiteralExpr(
            Owned(StructLiteralExpr { span: p.spanFrom(start), type: move type, fields: move fields }),
        )
    }
    // A state literal `Order.paid { … }` (spec §3.17).
    if p.kind() == .dot
            && p.peek(1) == .identifier
            && lexer.firstIsLower(p.text(p.peekToken(1)))
            && p.peek(2) == .openBrace
            && !breaksLine(ref p, at: p.pos + 2)
            && (p.peek(3) == .closeBrace || (isName(p.peek(3)) && (p.peek(4) == .colon || p.peek(4) == .equals)))
            && upper && braceLiteralAllowed(ref p) {
        let _ = p.advance()
        let state = spanOf(p.advance())
        var path = List<TextSpan>()
        path.append(name)
        path.append(state)
        let type = TypeSyntax.namedType(
            Owned(NamedType { span: p.spanFrom(start), path: move path, args: move typeArgs }),
        )
        let fields = parseFieldInits(ref p)
        return Expr.structLiteralExpr(
            Owned(StructLiteralExpr { span: p.spanFrom(start), type: move type, fields: move fields }),
        )
    }
    return Expr.nameExpr(Owned(NameExpr { span: p.spanFrom(start), name: name, typeArgs: move typeArgs }))
}

/// The kinds after `<…>` that make it a name's type arguments in `parseNameOrStructLiteral`.
bool endsExprTypeArgs(TokenKind kind) => kind switch {
    .openParen or .dot or .closeParen or .comma or .semicolon or .closeBracket or .closeBrace or .openBrace => true,
    _ => false,
}

/// A type written without array or optional suffixes (for `stackalloc T[n]`).
TypeSyntax parseTypeNameOnly(ref Parser p) {
    let start = p.current().start
    let first = p.advance()
    var path = List<TextSpan>()
    path.append(spanOf(first))
    var args = List<TypeSyntax>()
    if p.kind() == .less && scanTypeArgs(ref p, at: p.pos) > 0 {
        args = parseTypeArgs(ref p)
    }
    // The C# first renames a C# type name (`int` → `i32`), which a span cannot hold (Q475); `char` is
    // not one of them, so the `else` is reached for it alone.
    if path.length == 1 && args.length == 0 && lexer.sameBytes(p.text(first), as: "char".bytes) {
        let _ = p.reportFix(
            .charInput,
            at: spanOf(first),
            through: spanOf(first),
            by: "rune",
            label: "the input form",
            help: "rename the type to `rune`",
        )
    }
    return TypeSyntax.namedType(Owned(NamedType { span: p.spanFrom(start), path: move path, args: move args }))
}

/// Whether the brace body opening at the current token separates statements at its own depth: a line
/// break not after `,` or `{` (fields of a struct literal end their lines with `,`), or a `;`.
bool braceBodyHasStatementBreak(ref Parser p) {
    var depth: i64 = 0
    for i in p.pos + 1..p.count {
        if depth == 0 && p.lexed.tokens[i].hasNewlineBefore && p.kindAt(i) != .closeBrace
                && p.kindAt(i - 1) != .comma && p.kindAt(i - 1) != .openBrace {
            return true
        }
        switch p.kindAt(i) {
            case .openBrace or .openParen or .openBracket:
                depth += 1
            case .closeBrace or .closeParen or .closeBracket:
                return false if depth == 0
                depth -= 1
            case .semicolon:
                return true if depth == 0
            case .endOfFile:
                return false
            default:
                continue
        }
    }
    return false
}

/// At `{`: is this `{ }` or `{ name: …` (or the older `{ name = …`), a struct literal rather than a block?
bool isStructLiteralBody(ref Parser p) =>
    p.peek(1) == .closeBrace || (isName(p.peek(1)) && (p.peek(2) == .colon || p.peek(2) == .equals))

List<FieldInit> parseFieldInits(ref Parser p) {
    let open = p.expect(.openBrace)
    var fields = List<FieldInit>()
    while p.kind() != .closeBrace && !p.atEnd() {
        let start = p.current().start
        let before = p.pos
        let name = expectName(ref p, what: "a field name")
        if p.kind() == .equals {
            let nameEnd = p.prevEnd
            let equals = p.advance()
            // A missing name is the C# `<missing>`.
            let nameText = name.length == 0 ? "<missing>" : p.lexed.source.getText(name)
            let _ = p.reportFix(
                .fieldInitEquals,
                at: spanOf(equals),
                through: TextSpan.fromBounds(nameEnd, until: equals.end),
                by: ":",
                arg0: nameText,
                label: "the input form",
                help: "write `:` after the field name",
            )
        } else {
            let _ = p.expect(.colon)
        }
        let value = parseExpression(ref p)
        fields.append(FieldInit { span: p.spanFrom(start), name: name, value: move value })
        unless p.accept(.comma) {
            break
        }
        break if p.pos == before
    }
    expectClose(ref p, from: open, for: "struct literal")
    return fields
}

Expr parseParenOrTuple(ref Parser p) {
    let start = p.current().start
    let _ = p.advance()
    if p.kind() == .closeParen {
        let _ = p.report(
            .expectedExpression,
            at: spanOf(p.current()),
            arg0: p.describe(p.current()),
            help: "write a value; `()` is not one, and a tuple has at least two elements",
        )
        let _ = p.advance()
        return Expr.errorExpr(Owned(ErrorExpr { span: p.spanFrom(start) }))
    }
    var elements = List<TupleElement>()
    // The C# `ParseTupleElement` in two parts, so the value can move into a `ParenExpr` (Q477).
    let firstStart = p.current().start
    let name = parseTupleName(ref p)
    let value = parseExpression(ref p)
    if name is null && p.kind() == .closeParen {
        let _ = p.advance()
        return Expr.parenExpr(Owned(ParenExpr { span: p.spanFrom(start), inner: move value }))
    }
    elements.append(TupleElement { span: p.spanFrom(firstStart), name: name, value: move value })
    while p.accept(.comma) {
        elements.append(parseTupleElement(ref p))
    }
    let _ = p.expect(.closeParen)
    return Expr.tupleExpr(Owned(TupleExpr { span: p.spanFrom(start), elements: move elements }))
}

TupleElement parseTupleElement(ref Parser p) {
    let start = p.current().start
    let name = parseTupleName(ref p)
    let value = parseExpression(ref p)
    return TupleElement { span: p.spanFrom(start), name: name, value: move value }
}

/// The `name:` of a tuple element, or `null`.
TextSpan? parseTupleName(ref Parser p) {
    var name: TextSpan? = null
    if isName(p.kind()) && p.peek(1) == .colon {
        name = spanOf(p.advance())
        let _ = p.advance()
    }
    return name
}

Expr parseCollection(ref Parser p) {
    let start = p.current().start
    let _ = p.advance()
    var elements = List<Expr>()
    while p.kind() != .closeBracket && !p.atEnd() {
        let before = p.pos
        let elementStart = p.current().start
        if p.kind() == .dotDot {
            let _ = p.advance()
            let operand = parseExpression(ref p)
            elements.append(
                Expr.spreadExpr(Owned(SpreadExpr { span: p.spanFrom(elementStart), operand: move operand })),
            )
        } else {
            let element = parseCollectionPart(ref p)
            if p.accept(.colon) {
                // The C# takes the span before it parses the value, so it ends at `:` (work/todo.md).
                let span = p.spanFrom(elementStart)
                let value = parseCollectionPart(ref p)
                elements.append(
                    Expr.mapEntryExpr(Owned(MapEntryExpr { span: span, key: move element, value: move value })),
                )
            } else {
                elements.append(move element)
            }
        }
        unless p.accept(.comma) {
            break
        }
        break if p.pos == before
    }
    let _ = p.expect(.closeBracket)
    return Expr.collectionExpr(Owned(CollectionExpr { span: p.spanFrom(start), elements: move elements }))
}

/// An element, map key or map value; a bare conditional is BYN1013.
Expr parseCollectionPart(ref Parser p) {
    let part = parseExpression(ref p)
    switch part {
        case .conditionalExpr(let n):
            let span = n.value.span
            let _ = p.reportFix(
                .ternaryInCollection,
                at: span,
                through: span,
                by: $"({p.lexed.source.getText(span)})",
                help: "wrap it in parentheses",
            )
        default:
            let _ = 0
    }
    return part
}

Expr parseInterpolated(ref Parser p) {
    let start = p.current().start
    let _ = p.advance()
    var parts = List<InterpolationPart>()
    while true {
        switch p.kind() {
            case .interpolatedStringText:
                let token = p.advance()
                parts.append(InterpolationPart.interpolationText(Owned(InterpolationText {
                    span: spanOf(token),
                    // A decoded text would borrow `p` through `text` (BYN3004); the hole copies it (Q477).
                    text: $"{decodeInterpolatedText(p.text(token))}",
                })))
            case .interpolationStart:
                let holeStart = p.advance().start
                let expr = parseExpression(ref p)
                var specs = List<Argument>()
                if p.kind() == .comma {
                    specs = parseFormatSpecs(ref p)
                } else if p.kind() == .colon {
                    specs = parseCompactSpec(ref p)
                }
                if p.kind() != .interpolationEnd {
                    let _ = p.report(
                        .expected,
                        at: spanOf(p.current()),
                        arg0: "`}` to end the interpolated expression",
                        arg1: p.describe(p.current()),
                    )
                    while p.kind() != .interpolationEnd && p.kind() != .interpolatedStringEnd && p.kind() != .endOfFile
                            && p.kind() != .semicolon {
                        let _ = p.advance()
                    }
                }
                let _ = p.accept(.interpolationEnd)
                parts.append(InterpolationPart.interpolationHole(Owned(InterpolationHole {
                    span: p.spanFrom(holeStart),
                    expr: move expr,
                    specs: move specs,
                })))
            case .interpolatedStringEnd:
                let _ = p.advance()
                return Expr.interpolatedExpr(Owned(InterpolatedExpr { span: p.spanFrom(start), parts: move parts }))
            default:
                // Unterminated: the lexer has reported it.
                return Expr.interpolatedExpr(Owned(InterpolatedExpr { span: p.spanFrom(start), parts: move parts }))
        }
    }
}

/// `, as: .hex, width: 6` after a hole's value: the named format specs (SPEC §6.6).
List<Argument> parseFormatSpecs(ref Parser p) {
    var specs = List<Argument>()
    while p.accept(.comma) {
        let specStart = p.current().start
        // `as` is a keyword, but the name of a spec.
        if !(isName(p.kind()) || p.kind() == .asKeyword) || p.peek(1) != .colon {
            let _ = p.report(
                .expected,
                at: spanOf(p.current()),
                arg0: "a named format spec such as `as: .hex`",
                arg1: p.describe(p.current()),
            )
            break
        }
        let name = spanOf(p.advance())
        let _ = p.advance()
        // The C# takes the span before it parses the value, so it ends at `:` (work/todo.md).
        let span = p.spanFrom(specStart)
        let value = parseExpression(ref p)
        specs.append(Argument { span: span, name: name, modifier: .none, value: move value })
    }
    return specs
}

/// `:hex`, `:binary`, `:octal`, `:iso`, `:debug` or `:.2` after a hole's value: the BYN1068 input
/// forms of `, as: .hex` and `, digits: 2`, parsed as those specs.
List<Argument> parseCompactSpec(ref Parser p) {
    let colon = p.advance()
    let first = p.pos
    while p.kind() != .interpolationEnd && p.kind() != .interpolatedStringEnd && p.kind() != .endOfFile {
        let _ = p.advance()
    }
    if p.pos == first {
        let _ = p.report(.expected, at: spanOf(p.current()), arg0: "a format spec", arg1: p.describe(p.current()))
        return List<Argument>()
    }
    let specSpan = TextSpan.fromBounds(p.lexed.tokens[first].start, until: p.prevEnd)
    let spec = p.lexed.source.getText(specSpan)
    var name = ""
    var value = ""
    switch spec {
        case "hex" or "binary" or "octal" or "iso" or "debug":
            name = "as"
            value = $".{spec}"
        default:
            if spec.length > 1 && spec.bytes[0] == '.' && allAsciiDigits(spec.bytes[1..]) {
                name = "digits"
                value = p.lexed.source.getText(TextSpan.fromBounds(specSpan.start + 1, until: specSpan.end))
            }
    }
    let whole = TextSpan.fromBounds(colon.start, until: p.prevEnd)
    if name.isEmpty {
        let _ = p.report(.expected, at: whole, arg0: "a named format spec such as `, as: .hex`", arg1: $"`:{spec}`")
        return List<Argument>()
    }
    let canonical = $"{name}: {value}"
    let _ = p.reportFix(
        .compactFormatSpec,
        at: whole,
        through: whole,
        by: $", {canonical}",
        arg0: $":{spec}",
        arg1: $", {canonical}",
        label: "the input form",
        help: $"write the spec as named arguments: `, {canonical}`",
    )
    // The C# names the spec `as` or `digits` at the colon's span; a span cannot hold that text (Q475).
    var specValue = literal(.integer, at: specSpan, as: value)
    if name == "as" {
        specValue = Expr.targetMemberExpr(Owned(TargetMemberExpr { span: specSpan, member: specSpan }))
    }
    var specs = List<Argument>()
    specs.append(Argument { span: specSpan, name: spanOf(colon), modifier: .none, value: move specValue })
    return specs
}

/// The C# `All(char.IsAsciiDigit)`.
bool allAsciiDigits(ReadOnlySpan<u8> bytes) {
    for b in bytes {
        return false if b < '0' || b > '9'
    }
    return true
}

// ── Stand-ins (Q476) ─────────────────────────────────────────────────────────
// Helpers this file calls whose C# lives in a sibling's range and which T1 did not stub. Each is the
// C# body or a conservative stub; T15 deletes this section when the owners' ports merge and makes the
// call sites above match their signatures.
== parser/lints.byn
// ── Style lints with one-time fixes (BYN1077–BYN1080) ────────────────────────
// Ports the Parser.cs region of that name. BYN1077 and BYN1079 append to `p.styleLints` as the other style lints do;
// BYN1078 and some BYN1080 sites are typed lints, which the compilation keeps only if their operand binds as `check` asks
// (compile.byn `confirmTypedLints`). The C# parser keeps node references; this one records plain spans and texts when
// a node is built, since a node is read-only once it is in the tree.

// Parser.cs: BannerColumn
const bannerColumn: i64 = 80

/// The C# `TypedLintCheck`: how a typed lint's operand must bind for the compilation to confirm it.
public enum TypedLintCheck {
    patternInteger
    patternRune
    patternString
    patternEnum
    narrowableLocal
}

/// The C# `TypedLint`: a lint the compilation confirms from every binding of the expression at `operand`; if it does not,
/// it adds `otherwise` instead, when set.
public struct TypedLint {
    public Diagnostic     lint
    public TextSpan       operand
    public TypedLintCheck check
    public Diagnostic?    otherwise = null
}

/// The kind of a constant a pattern can hold (the C# `ConstantKind` char): `i`nteger, `c`har (rune), `s`tring or `e`num case.
public enum ConstKind {
    none
    integer
    rune
    string
    enumCase
}

/// One test of a chain (the C# `PatternItem` tuple).
public struct PatternItem {
    public TextSpan  operand
    public string    pattern
    public ConstKind kind
    public bool      range
}

/// An `&&` or `||` (the C# `_logical` entry, with `next`), and what `lintPatterns` reads of it, taken when it is built: for
/// `||`, the items of its flattened terms (`allItems` when every term is one) and the spans of its `&&` terms; for `&&`,
/// its range item, if it is one. `child` is set when it is the left operand of the same operator.
public struct LogicalSite {
    public TextSpan          span
    public BinaryOp          op
    public i64               next
    public bool              child    = false
    public bool              allItems = false
    public List<PatternItem> items    = []
    public List<TextSpan>    ranges   = []
}

/// A `_bindExits` entry: the `if` statement's span, its lint and narrowing lint, the bound name, and whether its hit block
/// has a `defer` or `using` local (`declares`) or any local (`hasLocal`).
public struct BindExit {
    public TextSpan   stmt
    public Diagnostic exit
    public TypedLint? local
    public string     name
    public bool       declares
    public bool       hasLocal
}

/// The operand span and name of `X is { } k`, and whether `X` is a name without type arguments.
public struct OptionalBind {
    public TextSpan value
    public string   name
    public bool     isName
}

bool sameSpan(TextSpan a, as TextSpan b) => a.start == b.start && a.length == b.length

/// A space or tab byte.
bool isIndentByte(u8 b) => b == ' ' || b == '\t'

/// Whether `bytes[at..at+3]` is `─` (U+2500, E2 94 80).
bool isBoxDash(ref Parser p, at i64 at) =>
    at >= 0
    && at + 3 <= p.lexed.source.length
    && p.lexed.source.bytes[at] == 0xE2
    && p.lexed.source.bytes[at + 1] == 0x94
    && p.lexed.source.bytes[at + 2] == 0x80

/// Whether the bytes of `span` hold `\n`.
bool spansLine(ref Parser p, at TextSpan span) {
    for i in span.start..span.end {
        return true if p.lexed.source.bytes[i] == '\n'
    }
    return false
}

/// BYN1077 on a banner comment `// ── Title ──…` whose fill does not end at column 80; the fix refills it.
// Parser.cs: LintBanners
public void lintBanners(ref Parser p) uses alloc {
    let lines = p.lexed.source.getLineIndex(p.lexed.source.length) + 1
    for line in 0..lines {
        let span = p.lexed.source.getLineSpan(line)
        var slash = span.start
        while slash < span.end && isIndentByte(p.lexed.source.bytes[slash]) {
            slash += 1
        }
        // `// ── ` is 10 bytes: `//`, a space, two `─` and a space.
        if slash + 10 > span.end || p.lexed.source.bytes[slash] != '/' || p.lexed.source.bytes[slash + 1] != '/'
                || p.lexed.source.bytes[slash + 2] != ' '
                || !isBoxDash(ref p, at: slash + 3)
                || !isBoxDash(ref p, at: slash + 6)
                || p.lexed.source.bytes[slash + 9] != ' ' {
            continue
        }
        var fill: i64 = 0
        while isBoxDash(ref p, at: span.end - 3 * (fill + 1)) && span.end - 3 * (fill + 1) >= slash + 10 {
            fill += 1
        }
        let titleStart = slash + 10
        let titleEnd = span.end - 3 * fill
        continue if fill == 0 || titleEnd - titleStart < 2 || p.lexed.source.bytes[titleEnd - 1] != ' '
        // The title before its last space has no space of its own at either end, and does not end in `─`.
        continue if isTriviaSpace(p.lexed.source.bytes[titleStart]) || isTriviaSpace(p.lexed.source.bytes[titleEnd - 2])
        continue if isBoxDash(ref p, at: titleEnd - 4)
        // A `//` inside a multi-line string is not a comment.
        let next = tokenAt(ref p, at: slash)
        continue if next > 0 && p.lexed.tokens[next - 1].end > slash
        var columns: i64 = 0
        for i in span.start..span.end {
            if (p.lexed.source.bytes[i] & 0xC0) != 0x80 {
                columns += 1
            }
        }
        let want = bannerColumn - (columns - fill)
        continue if columns == bannerColumn || want < 2
        let fillSpan = TextSpan.fromBounds(titleEnd, until: span.end)
        var dashes = StrBuf()
        for _ in 0..want {
            dashes.append("─")
        }
        reportStyleLint(
            ref p,
            for: "BYN1077",
            at: fillSpan,
            by: $"a banner comment ends at column {columns}; fill it with `─` to column {bannerColumn}",
            label: $"ends at column {columns}",
            help: $"fill it with `─` to column {bannerColumn}",
            fixSpan: fillSpan,
            fixReplacement: $"{dashes.finish()}",
        )
    }
}

// ── BYN1078 conditions.patterns ──────────────────────────────────────────────

/// Records the `&&` or `||` just built, `e`, with the index of the token after it.
// Parser.cs: ParseBinary (its `_logical.Add`)
void noteLogical(ref Parser p, for Expr e) {
    switch e {
        case .binaryExpr(let b):
            noteLogicalBinary(ref p, for: b.value)
        default:
            return
    }
}

void noteLogicalBinary(ref Parser p, for BinaryExpr b) {
    // Parser.cs: LintPatterns (its `children`): the left operand of the same operator is part of this chain.
    if b.left is .binaryExpr(let l) && l.value.op == b.op {
        var i = p.logical.length - 1
        while i >= 0 {
            if p.logical[i].op == b.op && sameSpan(p.logical[i].span, as: l.value.span) {
                p.logical[i].child = true
                break
            }
            i -= 1
        }
    }
    var site = LogicalSite { span: b.span, op: b.op, next: p.pos }
    if b.op == .logicalOr {
        site.allItems = true
        flattenOr(ref p, for: b.left, to: ref site)
        flattenOr(ref p, for: b.right, to: ref site)
    } else {
        let item = binaryPatternItem(ref p, for: b, relational: false)
        if item is not null && item.range {
            site.allItems = true
            site.items.append(item)
        }
    }
    p.logical.append(move site)
}

/// The terms of an `||` chain, as pattern items (Parser.cs: LintPatterns, its `Flatten` and `PatternItem(p, relational: true)`).
void flattenOr(ref Parser p, for Expr x, to ref LogicalSite site) {
    if x is .binaryExpr(let b) && b.value.op == .logicalOr {
        flattenOr(ref p, for: b.value.left, to: ref site)
        flattenOr(ref p, for: b.value.right, to: ref site)
        return
    }
    let item = patternItem(ref p, for: x, relational: true)
    if item is not null {
        site.items.append(item)
    } else {
        site.allItems = false
    }
    let range = andSpan(x)
    if range is not null {
        site.ranges.append(range)
    }
}

/// The span of `x` if it is an `&&`, inside any parentheses.
TextSpan? andSpan(Expr x) {
    switch x {
        case .parenExpr(let paren):
            return andSpan(paren.value.inner)
        case .binaryExpr(let b):
            return b.value.span if b.value.op == .logicalAnd
            return null
        default:
            return null
    }
}

/// BYN1078 on an `||` or `&&` chain that tests one path against constants; the fix writes one `is` pattern.
// Parser.cs: LintPatterns
public void lintPatterns(ref Parser p) uses alloc {
    var consumed = List<TextSpan>()
    for i in 0..p.logical.length {
        continue if p.logical[i].op != .logicalOr || p.logical[i].child || !p.logical[i].allItems
        unless lintPatternChain(ref p, at: i) {
            continue
        }
        for r in p.logical[i].ranges {
            consumed.append(r)
        }
    }
    for i in 0..p.logical.length {
        continue if p.logical[i].op != .logicalAnd || p.logical[i].child || !p.logical[i].allItems
        var taken = false
        for r in consumed {
            if sameSpan(r, as: p.logical[i].span) {
                taken = true
            }
        }
        if !taken {
            let _ = lintPatternChain(ref p, at: i)
        }
    }
}

/// Whether a token of `kind` after a chain ends it, so nothing after it joins the pattern.
bool endsPattern(TokenKind kind) =>
    kind is .closeParen
    or .closeBracket
    or .comma
    or .openBrace
    or .semicolon
    or .closeBrace
    or .endOfFile
    or .ampAmp
    or .barBar

/// Reports BYN1078 on the chain of `p.logical[site]` if its items test one operand with one kind of constant, distinct, and
/// nothing after it joins the pattern.
// Parser.cs: LintPatternChain
bool lintPatternChain(ref Parser p, at i64 site) {
    let next = p.logical[site].next
    let after = p.lexed.tokens[next < p.count - 1 ? next : p.count - 1]
    return false if !after.hasNewlineBefore && !endsPattern(after.kind)
    let count = p.logical[site].items.length
    let operandSpan = p.logical[site].items[0].operand
    let operand = p.lexed.source.getText(operandSpan)
    let kind = p.logical[site].items[0].kind
    var tests: i64 = 0
    var patterns = StrBuf()
    for k in 0..count {
        return false if p.lexed.source.getText(p.logical[site].items[k].operand) != operand
            || p.logical[site].items[k].kind != kind
        for j in 0..k {
            return false if p.logical[site].items[j].pattern == p.logical[site].items[k].pattern
        }
        tests += p.logical[site].items[k].range ? 2 : 1
        if k > 0 {
            patterns.append(" or ")
        }
        patterns.append(p.logical[site].items[k].pattern)
    }
    let check = kind == .integer ? TypedLintCheck.patternInteger : kind == .rune ? TypedLintCheck.patternRune
        : kind == .string ? TypedLintCheck.patternString : TypedLintCheck.patternEnum
    let pattern = $"{operand} is {patterns.finish()}"
    let span = p.logical[site].span
    let lint = styleLintOf(
        "BYN1078",
        at: span,
        by: $"`{operand}` is tested against constants {tests} times; write one pattern",
        label: $"{tests} tests of `{operand}`",
        help: $"write `{pattern}`",
        fixSpan: span,
        fixReplacement: pattern,
    )
    p.typedLints.append(TypedLint { lint: lint, operand: operandSpan, check: check })
    return true
}

/// One test of a chain: `x == C` gives `C`, and `x >= A && x <= B` (A at most B) gives `A..=B`. With `relational` (a term
/// of an `||` chain), `x < C` gives `< C`, and `C > x` gives the same.
// Parser.cs: PatternItem
PatternItem? patternItem(ref Parser p, for Expr e, bool relational = false) {
    switch e {
        case .parenExpr(let paren):
            return patternItem(ref p, for: paren.value.inner, relational: relational)
        case .binaryExpr(let b):
            return binaryPatternItem(ref p, for: b.value, relational: relational)
        default:
            return null
    }
}

PatternItem? binaryPatternItem(ref Parser p, for BinaryExpr b, bool relational) {
    if b.op == .eq && isPathOperand(b.left) {
        let kind = constantKind(ref p, for: b.right)
        return PatternItem {
            operand: exprSpan(in b.left),
            pattern: p.lexed.source.getText(exprSpan(in b.right)),
            kind: kind,
            range: false,
        } if kind != .none
    }
    if relational && (b.op is .lt or .le or .gt or .ge) {
        return relationalItem(ref p, for: b.left, by: b.right, as: b.op) if isPathOperand(b.left)
        let flipped = b.op == .lt ? BinaryOp.gt : b.op == .le ? BinaryOp.ge : b.op == .gt ? BinaryOp.lt : BinaryOp.le
        return relationalItem(ref p, for: b.right, by: b.left, as: flipped)
    }
    if b.op == .logicalAnd
            && b.left is .binaryExpr(let ge)
            && ge.value.op == .ge
            && b.right is .binaryExpr(let le)
            && le.value.op == .le
            && isPathOperand(ge.value.left)
            && p.lexed.source.getText(
                exprSpan(in ge.value.left),
            ) == p.lexed.source.getText(exprSpan(in le.value.left)) {
        let lo = rangeBound(ref p, for: ge.value.right)
        let hi = rangeBound(ref p, for: le.value.right)
        if lo is not null && hi is not null && lo.kind == hi.kind && boundAtMost(lo, to: hi) {
            let text = $"{p.lexed.source.getText(exprSpan(in ge.value.right))}..={p.lexed.source.getText(exprSpan(in le.value.right))}"
            return PatternItem { operand: exprSpan(in ge.value.left), pattern: text, kind: lo.kind, range: true }
        }
    }
    return null
}

/// `operand op bound` as a relational item, if `operand` is a path and `bound` a range bound.
PatternItem? relationalItem(ref Parser p, for Expr operand, by Expr bound, as BinaryOp op) {
    let text = op == .lt ? "<" : op == .le ? "<=" : op == .gt ? ">" : ">="
    unless isPathOperand(operand) {
        return null
    }
    let b = rangeBound(ref p, for: bound)
    return null if b is null
    return PatternItem {
        operand: exprSpan(in operand),
        pattern: $"{text} {p.lexed.source.getText(exprSpan(in bound))}",
        kind: b.kind,
        range: false,
    }
}

/// A name, a field path or an index path whose indexes are names or literals: reading it twice reads the same value.
// Parser.cs: IsPathOperand
bool isPathOperand(Expr e) {
    switch e {
        case .nameExpr(let n):
            return n.value.typeArgs.length == 0
        case .memberExpr(let m):
            return false if m.value.nullConditional || m.value.typeArgs.length != 0
            return true if m.value.target is .thisExpr(_)
            return isPathOperand(m.value.target)
        case .indexExpr(let i):
            switch i.value.index {
                case .nameExpr(let n):
                    return false if n.value.typeArgs.length != 0
                case .literalExpr(_):
                    let _ = 0
                default:
                    return false
            }
            return isPathOperand(i.value.target)
        default:
            return false
    }
}

/// The kind of a constant a pattern can hold; qualified names and floats are left out.
// Parser.cs: ConstantKind
ConstKind constantKind(ref Parser p, for Expr e) {
    switch e {
        case .literalExpr(let l):
            return .none if l.value.suffix is not null
            return .integer if l.value.kind == .integer
            return .rune if l.value.kind == .char
            if l.value.kind == .string {
                let t = p.lexed.source.getText(l.value.span)
                return .string if t.startsWith("\"") && !t.startsWith("\"\"\"")
            }
            return .none
        case .unaryExpr(let u):
            return .integer if u.value.op == .negate && isPlainInteger(u.value.operand)
            return .none
        case .targetMemberExpr(_):
            return .enumCase
        default:
            return .none
    }
}

/// An integer literal without a suffix.
bool isPlainInteger(Expr e) {
    switch e {
        case .literalExpr(let l):
            return l.value.kind == .integer && l.value.suffix is null
        default:
            return false
    }
}

/// The value of a range bound (the C# `(char Kind, Int128 Value)`): the magnitude in four 32-bit limbs, low first.
public struct Bound {
    public ConstKind kind
    public bool      negative
    public u64       l0
    public u64       l1
    public u64       l2
    public u64       l3
}

/// Whether `a` is at most `b`, both of one kind.
bool boundAtMost(Bound a, to Bound b) {
    return a.negative if a.negative != b.negative
    var order: i64 = 0
    if a.l3 != b.l3 {
        order = a.l3 < b.l3 ? -1 : 1
    } else if a.l2 != b.l2 {
        order = a.l2 < b.l2 ? -1 : 1
    } else if a.l1 != b.l1 {
        order = a.l1 < b.l1 ? -1 : 1
    } else if a.l0 != b.l0 {
        order = a.l0 < b.l0 ? -1 : 1
    }
    return a.negative ? order >= 0 : order <= 0
}

/// The value of a range bound: an integer literal (signed, with `0x`, `0o` or `0b`) or a rune literal of one plain character.
// Parser.cs: RangeBound
Bound? rangeBound(ref Parser p, for Expr e) {
    switch e {
        case .unaryExpr(let u):
            return null if u.value.op != .negate
            switch u.value.operand {
                case .literalExpr(let l):
                    return null if l.value.kind != .integer || l.value.suffix is not null
                    let v = integerValue(ref p, at: l.value.span)
                    return null if v is null
                    let zero = v.l0 == 0 && v.l1 == 0 && v.l2 == 0 && v.l3 == 0
                    return Bound { kind: .integer, negative: !zero, l0: v.l0, l1: v.l1, l2: v.l2, l3: v.l3 }
                default:
                    return null
            }
        case .literalExpr(let l):
            return null if l.value.suffix is not null
            return integerValue(ref p, at: l.value.span) if l.value.kind == .integer
            return null if l.value.kind != .char
            let s = l.value.span
            return null if s.length < 2
                || p.lexed.source.bytes[s.start] != '\''
                || p.lexed.source.bytes[s.end - 1] != '\''
            var runes: i64 = 0
            for i in (s.start + 1)..(s.end - 1) {
                return null if p.lexed.source.bytes[i] == '\\'
                if (p.lexed.source.bytes[i] & 0xC0) != 0x80 {
                    runes += 1
                }
            }
            return null if runes != 1
            return Bound { kind: .rune, negative: false, l0: scalarAt(ref p, at: s.start + 1), l1: 0, l2: 0, l3: 0 }
        default:
            return null
    }
}

/// The scalar of the UTF-8 sequence at `at`.
u64 scalarAt(ref Parser p, at i64 at) {
    let b0 = u64(p.lexed.source.bytes[at])
    return b0 if b0 < 0x80
    return ((b0 & 0x1F) << 6) | (u64(p.lexed.source.bytes[at + 1]) & 0x3F) if b0 < 0xE0
    return (
        (b0 & 0x0F) << 12
    ) | ((u64(p.lexed.source.bytes[at + 1]) & 0x3F) << 6) | (u64(p.lexed.source.bytes[at + 2]) & 0x3F) if b0 < 0xF0
    let high = ((b0 & 0x07) << 18) | ((u64(p.lexed.source.bytes[at + 1]) & 0x3F) << 12)
    return high | ((u64(p.lexed.source.bytes[at + 2]) & 0x3F) << 6) | (u64(p.lexed.source.bytes[at + 3]) & 0x3F)
}

/// The value of the integer literal at `span`, without `_`; null past 30 digits or on a digit outside its radix.
// Parser.cs: IntegerValue
Bound? integerValue(ref Parser p, at TextSpan span) {
    var digits = List<u8>()
    for i in span.start..span.end {
        if p.lexed.source.bytes[i] != '_' {
            digits.append(p.lexed.source.bytes[i])
        }
    }
    var radix: u64 = 10
    var from: i64 = 0
    if digits.length >= 2 && digits[0] == '0' {
        let b = digits[1]
        if b == 'x' || b == 'X' {
            radix = 16
        } else if b == 'o' || b == 'O' {
            radix = 8
        } else if b == 'b' || b == 'B' {
            radix = 2
        }
        if radix != 10 {
            from = 2
        }
    }
    let length = digits.length - from
    return null if length is 0 or > 30
    var v = Bound { kind: .integer, negative: false, l0: 0, l1: 0, l2: 0, l3: 0 }
    for k in from..digits.length {
        let c = digits[k]
        var d: u64 = 99
        if c >= '0' && c <= '9' {
            d = u64(c - '0')
        } else if c >= 'a' && c <= 'f' {
            d = u64(c - 'a') + 10
        } else if c >= 'A' && c <= 'F' {
            d = u64(c - 'A') + 10
        }
        return null if d >= radix
        let n0 = v.l0 * radix + d
        v.l0 = n0 & 0xFFFFFFFF
        let n1 = v.l1 * radix + (n0 >> 32)
        v.l1 = n1 & 0xFFFFFFFF
        let n2 = v.l2 * radix + (n1 >> 32)
        v.l2 = n2 & 0xFFFFFFFF
        v.l3 = v.l3 * radix + (n2 >> 32)
    }
    return v
}

// ── BYN1079 literals.empty ───────────────────────────────────────────────────

/// BYN1079 on `= List<T>()`, `= Map<K, V>()` or `= T {}` spelling the declared type; the fix writes `[]` or `{}`.
// Parser.cs: LintEmptyLiteral
void lintEmptyLiteral(ref Parser p, for TypeSyntax type, by Expr init) {
    var spelled = TextSpan { start: 0, length: 0 }
    var empty = ""
    switch init {
        case .callExpr(let call):
            return if call.value.args.length != 0 || call.value.becauseKeyword is not null
            switch call.value.callee {
                case .nameExpr(let callee):
                    let name = p.lexed.source.getText(callee.value.name)
                    return if callee.value.typeArgs.length == 0 || name != "List" && name != "Map"
                    spelled = callee.value.span
                    empty = "[]"
                default:
                    return
            }
        case .structLiteralExpr(let s):
            return if s.value.type is .none || s.value.fields.length != 0
            spelled = typeSpan(in s.value.type)
            empty = "{}"
        default:
            return
    }
    unless sameSqueezed(ref p, from: spelled, as: typeSpan(in type)) {
        return
    }
    let span = exprSpan(in init)
    reportStyleLint(
        ref p,
        for: "BYN1079",
        at: span,
        by: $"the type is known from the target; write `{empty}`",
        label: "spells out the declared type",
        help: $"write `{empty}`",
        fixSpan: span,
        fixReplacement: empty,
    )
}

/// Whether the texts of `a` and `b` are the same without their whitespace.
// Parser.cs: Squeezed
bool sameSqueezed(ref Parser p, from TextSpan a, as TextSpan b) {
    var i = a.start
    var j = b.start
    while true {
        while i < a.end && isTriviaSpace(p.lexed.source.bytes[i]) {
            i += 1
        }
        while j < b.end && isTriviaSpace(p.lexed.source.bytes[j]) {
            j += 1
        }
        return i == a.end && j == b.end if i == a.end || j == b.end
        return false if p.lexed.source.bytes[i] != p.lexed.source.bytes[j]
        i += 1
        j += 1
    }
}

// ── BYN1080 optionals.bind ───────────────────────────────────────────────────

/// The BYN1080 message for `X is { } k`, with `reason`.
string optionalsBindMessage(string x, by string name, for string reason) =>
    $"`{x} is {{ }} {name}` binds an optional with a pattern; {reason}"

/// The operand and name of `X is { } k`.
// Parser.cs: OptionalBinding
OptionalBind? optionalBinding(ref Parser p, for Expr condition) {
    switch condition {
        case .isExpr(let i):
            switch i.value.pattern {
                case .propertyPattern(let pp):
                    return null if !(pp.value.type is .none) || pp.value.properties.length != 0
                    let k = pp.value.designation
                    return null if k is null
                    var isName = false
                    if i.value.value is .nameExpr(let n) && n.value.typeArgs.length == 0 {
                        isName = true
                    }
                    return OptionalBind {
                        value: exprSpan(in i.value.value),
                        name: p.lexed.source.getText(k),
                        isName: isName,
                    }
                default:
                    return null
            }
        default:
            return null
    }
}

/// BYN1080 on `while (X is { } k)`; the fix writes `while let k = X`.
// Parser.cs: LintWhileBind
void lintWhileBind(
    ref Parser p,
    at Token keyword,
    for Expr condition,
    by Stmt body,
    until i64 conditionEnd,
    bool parenthesized
) {
    return if !parenthesized || !isBlockStmt(in body)
    let bind = optionalBinding(ref p, for: condition)
    return if bind is null
    let x = p.lexed.source.getText(bind.value)
    // `while let` takes a bare value, which ends at `{`.
    return if x.contains("{") || x.contains("\n")
    let span = TextSpan.fromBounds(keyword.start, until: conditionEnd)
    let fixedText = $"while let {bind.name} = {x}"
    reportStyleLint(
        ref p,
        for: "BYN1080",
        at: span,
        by: optionalsBindMessage(x, by: bind.name, for: "write `while let`"),
        label: "binds with a pattern",
        help: $"write `{fixedText}`",
        fixSpan: span,
        fixReplacement: fixedText,
    )
}

/// BYN1080 on `if (X is { } k)`: on a `let` local or parameter the fix tests `X is not null` and reads `X` (confirmed by the
/// compilation); where the miss leaves, it binds `let k = X ?? exit` (decided by the block). `span` is the `if` statement's.
// Parser.cs: LintIfBind
/// `conditionSpan` runs from the condition's first token to its end.
void lintIfBind(
    ref Parser p,
    at TextSpan span,
    for Expr condition,
    by Stmt then,
    from Stmt otherwise,
    as Likelihood likelihood,
    through TextSpan conditionSpan,
    bool parenthesized,
    bool elseIf
) {
    return if !parenthesized || likelihood != .none
    switch otherwise {
        case .blockStmt(_) or .ifStmt(_):
            let _ = 0
        default:
            unless otherwise is .none {
                return
            }
    }
    switch then {
        case .blockStmt(let block):
            lintIfBindBlock(
                ref p,
                at: span,
                for: condition,
                by: block.value,
                from: otherwise,
                through: conditionSpan,
                elseIf: elseIf,
            )
        default:
            return
    }
}

void lintIfBindBlock(
    ref Parser p,
    at TextSpan span,
    for Expr condition,
    by BlockStmt then,
    from Stmt otherwise,
    through TextSpan conditionSpan,
    bool elseIf
) {
    let bind = optionalBinding(ref p, for: condition)
    return if bind is null
    let x = p.lexed.source.getText(bind.value)
    return if x.contains("\n")
    let local = narrowLint(ref p, for: then, by: bind, through: conditionSpan)
    let exit = exitBindLint(
        ref p,
        at: span,
        for: then,
        from: otherwise,
        by: bind,
        through: conditionSpan,
        elseIf: elseIf,
    )
    if exit is not null {
        var declares = false
        var hasLocal = false
        for s in then.statements {
            switch s {
                case .deferStmt(_):
                    declares = true
                case .localDecl(let l):
                    hasLocal = true
                    if l.value.usingKeyword {
                        declares = true
                    }
                default:
                    continue
            }
        }
        p.bindExits.append(
            BindExit { stmt: span, exit: exit, local: local, name: bind.name, declares: declares, hasLocal: hasLocal },
        )
    } else if local is not null {
        p.typedLints.append(local)
    }
}

/// The `if X is not null` rewrite: `k` in the hit block becomes `X`, unless a use of it is not a plain read; null unless `X`
/// is a name.
// Parser.cs: NarrowLint
TypedLint? narrowLint(ref Parser p, for BlockStmt then, by OptionalBind bind, through TextSpan conditionSpan) {
    unless bind.isName {
        return null
    }
    let x = p.lexed.source.getText(bind.value)
    let conditionStart = conditionSpan.start
    let conditionEnd = conditionSpan.end
    var body = StrBuf()
    var from = then.span.start
    var i = tokenAt(ref p, at: then.span.start)
    while i < p.count && p.lexed.tokens[i].start < then.span.end {
        let t = p.lexed.tokens[i]
        // A lambda may not see the narrowing.
        return null if t.kind == .fatArrow
        if t.kind == .identifier && p.textOf(t) == bind.name {
            let before = p.kindAt(i - 1)
            return null if before == .dot
                || before == .refKeyword
                || before == .inKeyword
                || before == .outKeyword
                || p.kindAt(i + 1) == .colon
            body.append(p.lexed.source.getText(TextSpan.fromBounds(from, until: t.start)))
            body.append(x)
            from = t.end
        }
        i += 1
    }
    body.append(p.lexed.source.getText(TextSpan.fromBounds(from, until: then.span.end)))
    let open = p.lexed.tokens[tokenAt(ref p, at: conditionStart)]
    let lead = open.hasTriviaBefore ? "" : " "
    let head = $"{lead}{x} is not null{p.lexed.source.getText(TextSpan.fromBounds(conditionEnd, until: then.span.start))}"
    let lint = styleLintOf(
        "BYN1080",
        at: TextSpan.fromBounds(conditionStart, until: conditionEnd),
        by: optionalsBindMessage(x, by: bind.name, for: $"`{x} is not null` narrows `{x}`"),
        label: "binds a second name",
        help: $"write `if {x} is not null` and read `{x}`",
        fixSpan: TextSpan.fromBounds(conditionStart, until: then.span.end),
        fixReplacement: $"{head}{body.finish()}",
    )
    return TypedLint { lint: lint, operand: bind.value, check: .narrowableLocal }
}

/// Whether a `return` of `value` is short enough for `?? return …`: a literal, a name or a `.case`.
bool isSimpleReturn(Expr value) {
    switch value {
        case .literalExpr(_) or .targetMemberExpr(_):
            return true
        case .nameExpr(let n):
            return n.value.typeArgs.length == 0
        default:
            return false
    }
}

/// The `let k = X ?? exit` rewrite of an `if` whose `else` block is one bare exit; the hit block moves up a level. Null for
/// an `else if`.
// Parser.cs: ExitBindLint
Diagnostic? exitBindLint(
    ref Parser p,
    at TextSpan span,
    for BlockStmt then,
    from Stmt otherwise,
    by OptionalBind bind,
    through TextSpan conditionSpan,
    bool elseIf
) {
    return null if elseIf
    switch otherwise {
        case .blockStmt(let block):
            return exitBindBlock(ref p, at: span, for: then, from: block.value, by: bind, through: conditionSpan)
        default:
            return null
    }
}

Diagnostic? exitBindBlock(
    ref Parser p,
    at TextSpan span,
    for BlockStmt then,
    from BlockStmt otherwise,
    by OptionalBind bind,
    through TextSpan conditionSpan
) {
    let x = p.lexed.source.getText(bind.value)
    let name = bind.name
    return null if otherwise.statements.length != 1 || otherwise.span.length < 2
    var jump = ""
    var simple = false
    switch otherwise.statements[0] {
        case .returnStmt(let r):
            simple = isSimpleReturn(r.value.value)
        case .breakStmt(let b):
            return null if b.value.label is not null
            jump = "break"
        case .continueStmt(let c):
            return null if c.value.label is not null
            jump = "continue"
        default:
            return null
    }
    var from = otherwise.span.start + 1
    var to = otherwise.span.end - 1
    while from < to && isTriviaSpace(p.lexed.source.bytes[from]) {
        from += 1
    }
    while to > from && isTriviaSpace(p.lexed.source.bytes[to - 1]) {
        to -= 1
    }
    let exit = p.lexed.source.getText(TextSpan.fromBounds(from, until: to))
    return null if exit.contains("\n") || exit.contains("/") || exit.contains(";")
    return null if jump != "" && exit != jump
    if jump != "" {
        simple = true
    }
    let lineStart = p.lexed.source.getLineSpan(p.lexed.source.getLineIndex(span.start)).start
    for i in lineStart..span.start {
        unless isIndentByte(p.lexed.source.bytes[i]) {
            return null
        }
    }
    let indent = p.lexed.source.getText(TextSpan.fromBounds(lineStart, until: span.start))
    let body = dedentedBody(ref p, for: then, at: indent)
    return null if body is null
    let head = simple ? $"let {name} = {x} ?? {exit}" : $"let {name} = {x}\n{indent}{exit} if {name} is null"
    let help = simple ? $"write `{head}`" : $"write `let {name} = {x}` and `{exit} if {name} is null`"
    return styleLintOf(
        "BYN1080",
        at: conditionSpan,
        by: optionalsBindMessage(x, by: name, for: "the miss leaves, so a `let` can bind it"),
        label: "binds with a pattern",
        help: help,
        fixSpan: span,
        fixReplacement: $"{head}\n{body}",
    )
}

/// Whether the bytes of `from..to` are all spaces, tabs or line breaks.
bool isBlank(ref Parser p, from i64 from, to i64 to) {
    for i in from..to {
        unless isTriviaSpace(p.lexed.source.bytes[i]) {
            return false
        }
    }
    return true
}

/// The statements of `block` one level out at `indent`, or null if a line or token does not allow it.
// Parser.cs: DedentedBody
string? dedentedBody(ref Parser p, for BlockStmt block, at string indent) {
    var t = tokenAt(ref p, at: block.span.start)
    while t < p.count && p.lexed.tokens[t].start < block.span.end {
        return null if spansLine(ref p, at: spanOf(p.lexed.tokens[t]))
        t += 1
    }
    return null if block.span.length < 2
    let start = block.span.start + 1
    let end = block.span.end - 1
    var breaks = List<i64>()
    for i in start..end {
        return null if p.lexed.source.bytes[i] == '\r'
        if p.lexed.source.bytes[i] == '\n' {
            breaks.append(i)
        }
    }
    if breaks.length == 0 {
        var from = start
        var to = end
        while from < to && isTriviaSpace(p.lexed.source.bytes[from]) {
            from += 1
        }
        while to > from && isTriviaSpace(p.lexed.source.bytes[to - 1]) {
            to -= 1
        }
        return null if from == to
        return $"{indent}{p.lexed.source.getText(TextSpan.fromBounds(from, until: to))}"
    }
    unless isBlank(ref p, from: start, to: breaks[0]) {
        return null
    }
    return null if p.lexed.source.getText(TextSpan.fromBounds(breaks[breaks.length - 1] + 1, until: end)) != indent
    let deeper = $"{indent}    "
    var body = StrBuf()
    for k in 0..(breaks.length - 1) {
        let lineStart = breaks[k] + 1
        let lineEnd = breaks[k + 1]
        if k > 0 {
            body.append("\n")
        }
        continue if isBlank(ref p, from: lineStart, to: lineEnd)
        let line = p.lexed.source.getText(TextSpan.fromBounds(lineStart, until: lineEnd))
        unless line.startsWith(deeper) {
            return null
        }
        body.append(indent)
        body.append(p.lexed.source.getText(TextSpan.fromBounds(lineStart + deeper.length, until: lineEnd)))
    }
    return null if breaks.length < 2
    return $"{body.finish()}"
}

/// Decides the `if (X is { } k)` sites among `statements`: the hit block moves up only if it declares nothing that would
/// outlive it (no local, `defer` or `using`, unless it is the last statement) and no later statement names `k`.
// Parser.cs: LintBindExits
void lintBindExits(ref Parser p, for List<Stmt> statements) {
    let last = statements.length - 1
    for i in 0..statements.length {
        var span = TextSpan { start: 0, length: 0 }
        switch statements[i] {
            case .ifStmt(let s):
                span = s.value.span
            default:
                continue
        }
        var found: i64 = -1
        for j in 0..p.bindExits.length {
            if sameSpan(p.bindExits[j].stmt, as: span) {
                found = j
                break
            }
        }
        continue if found == -1
        let site = p.bindExits[found]
        p.bindExits.remove(at: found)
        let outlives = site.declares || i < last && site.hasLocal
        var named = false
        if i < last {
            let end = stmtSpan(in statements[last]).end
            var t = tokenAt(ref p, at: span.end)
            while t < p.count && p.lexed.tokens[t].start < end {
                if p.lexed.tokens[t].kind == .identifier && p.textOf(p.lexed.tokens[t]) == site.name {
                    named = true
                }
                t += 1
            }
        }
        let local = site.local
        if !outlives && !named {
            if local is not null {
                var withExit = local
                withExit.otherwise = site.exit
                p.typedLints.append(withExit)
            } else {
                p.styleLints.append(site.exit)
            }
        } else if local is not null {
            p.typedLints.append(local)
        }
    }
}
== parser/literals.byn
// Literal decoding. Ports `csharp/Bayan.Syntax/Parsing/LiteralDecoder.cs`. Owner:
//
// Each decoder takes the token's (or doc's) source bytes. C# decodes `Text(token)`, the bytes as
// `Encoding.UTF8` reads them, and indexes its chars; here the bytes are decoded the same way (`runesOf`)
// and the runes are indexed: every character a decoder tests is ASCII or in the BMP, so the two agree.
// A decoded string is built with `StrBuf` and copied result of it into the context allocator (the arena):
// `finish()` borrows from the buffer, so it cannot be returned (Q455).
//
// `Unescape`'s fast path (no `\`, `{` or `}`: the text as is) is left result; the loop gives the same text.

/// Contents of a `"…"`, `c"…"` or `u16"…"` literal.
string decodeString(ReadOnlySpan<u8> token) {
    let text = runesOf(token)
    let start = indexOf(text.span, for: '"') + 1
    let end = text.length > start && text[text.length - 1] == '"' ? text.length - 1 : text.length
    var result = List<rune>()
    unescape(text.span[start..end], to: ref result, interpolated: false)
    return stringOf(move result)
}

/// Contents of a raw `"""…"""` literal. When the opening quotes end their line, that line break is dropped,
/// the closing line's indentation is removed from every line, and the line break before the closing quotes
/// is dropped (as in C# raw strings).
string decodeRawString(ReadOnlySpan<u8> token) {
    let text = runesOf(token)
    let n = text.length
    let open: i64 = n < 3 ? n : 3
    let closed = n >= 6 && text[n - 1] == '"' && text[n - 2] == '"' && text[n - 3] == '"'
    var body = List<rune>()
    withoutCarriageReturns(text.span[open..(closed ? n - 3 : n)], to: ref body)
    return stringOf(move body) if body.length == 0 || body[0] != '\n'
    let rest = body.span[1..body.length]
    let lastBreak = lastIndexOf(rest, for: '\n')
    let indent = lastBreak >= 0 ? rest[lastBreak + 1..rest.length] : rest[0..0]
    for c in indent {
        if c != ' ' && c != '\t' {
            var copy = List<rune>()
            withoutCarriageReturns(rest, to: ref copy)
            return stringOf(move copy)
        }
    }
    let lines = lastBreak >= 0 ? rest[0..lastBreak] : rest[0..0]
    var result = List<rune>()
    var lineStart: i64 = 0
    for i in 0..lines.length + 1 {
        continue if i < lines.length && lines[i] != '\n'
        var from = lineStart
        if startsWith(lines[lineStart..i], by: indent) {
            from += indent.length
        }
        if lineStart > 0 {
            result.append('\n')
        }
        for j in from..i {
            result.append(lines[j])
        }
        lineStart = i + 1
    }
    return stringOf(move result)
}

/// A literal text run inside `$"…"`: escapes plus doubled braces.
string decodeInterpolatedText(ReadOnlySpan<u8> text) {
    let runes = runesOf(text)
    var result = List<rune>()
    unescape(runes.span, to: ref result, interpolated: true)
    return stringOf(move result)
}

/// The scalar value of a char literal, or -1 if it does not hold exactly one.
public i64 decodeChar(ReadOnlySpan<u8> tokenText) uses alloc {
    let text = runesOf(tokenText)
    let start: i64 = text.length < 1 ? text.length : 1
    let end = text.length > 1 && text[text.length - 1] == '\'' ? text.length - 1 : text.length
    var result = List<rune>()
    unescape(text.span[start..end], to: ref result, interpolated: false)
    return -1 if result.length != 1
    return i64(result[0])
}

/// Doc comment text without the `///` markers (and one following space).
string decodeDoc(ReadOnlySpan<u8> doc) {
    var text = List<rune>()
    withoutCarriageReturns(runesOf(doc).span, to: ref text)
    var result = List<rune>()
    var lineStart: i64 = 0
    for i in 0..text.length + 1 {
        continue if i < text.length && text[i] != '\n'
        var from = lineStart
        while from < i && isUnicodeWhiteSpace(text[from]) {
            from += 1
        }
        if i - from >= 3 && text[from] == '/' && text[from + 1] == '/' && text[from + 2] == '/' {
            from += 3
        }
        if from < i && text[from] == ' ' {
            from += 1
        }
        if lineStart > 0 {
            result.append('\n')
        }
        for j in from..i {
            result.append(text[j])
        }
        lineStart = i + 1
    }
    return stringOf(move result)
}

void unescape(ReadOnlySpan<rune> text, to ref List<rune> result, bool interpolated) {
    var i: i64 = 0
    while i < text.length {
        let c = text[i]
        if interpolated && (c is '{' or '}') && i + 1 < text.length && text[i + 1] == c {
            result.append(c)
            i += 2
            continue
        }
        if c != '\\' || i + 1 >= text.length {
            result.append(c)
            i += 1
            continue
        }
        let next = text[i + 1]
        if next == 'n' {
            result.append('\n')
            i += 1
        } else if next == 'r' {
            result.append('\r')
            i += 1
        } else if next == 't' {
            result.append('\t')
            i += 1
        } else if next == '0' {
            result.append('\0')
            i += 1
        } else if next is '\\' or '"' or '\'' {
            result.append(next)
            i += 1
        } else if next == 'u' && i + 2 < text.length && text[i + 2] == '{' {
            let close = indexOf(text[i + 3..text.length], for: '}')
            let value = close > 0 ? hexValue(text[i + 3..i + 3 + close]) : -1
            if value >= 0 {
                result.append(rune(u32(value)))
                i += 3 + close
            } else {
                result.append(c)
            }
        } else {
            result.append(c)
        }
        i += 1
    }
}

/// The scalar `int.TryParse(…, AllowHexSpecifier)` reads from `digits` when `Rune.IsValid` accepts it, else -1.
/// Leading zeros do not count against the eight digits an `int` holds, and every value an `int` holds past
/// U+10FFFF (negative ones included) is not a scalar, so the value saturates instead of overflowing.
i64 hexValue(ReadOnlySpan<rune> digits) {
    var value: i64 = 0
    for d in digits {
        var digit: i64 = -1
        if d is '0'..='9' {
            digit = i64(u32(d)) - 0x30
        } else if d is 'a'..='f' {
            digit = i64(u32(d)) - 0x57
        } else if d is 'A'..='F' {
            digit = i64(u32(d)) - 0x37
        }
        return -1 if digit < 0
        value = value > 0x10FFFF ? value : value * 16 + digit
    }
    return -1 if value is > 0x10FFFF or 0xD800..=0xDFFF
    return value
}

/// `char.IsWhiteSpace`, which `TrimStart` trims.
bool isUnicodeWhiteSpace(rune r) {
    let c = u32(r)
    return c is 0x09..=0x0D
        or 0x20
        or 0x85
        or 0xA0
        or 0x1680
        or 0x2000..=0x200A
        or 0x2028
        or 0x2029
        or 0x202F
        or 0x205F
        or 0x3000
}

/// `text` with every `\r\n` made `\n` (C# `Replace("\r\n", "\n")`).
void withoutCarriageReturns(ReadOnlySpan<rune> text, to ref List<rune> result) {
    for i in 0..text.length {
        if !(text[i] == '\r' && i + 1 < text.length && text[i + 1] == '\n') {
            result.append(text[i])
        }
    }
}

i64 indexOf(ReadOnlySpan<rune> text, for rune c) {
    for i in 0..text.length {
        return i if text[i] == c
    }
    return -1
}

i64 lastIndexOf(ReadOnlySpan<rune> text, for rune c) {
    var i = text.length - 1
    while i >= 0 && text[i] != c {
        i -= 1
    }
    return i
}

bool startsWith(ReadOnlySpan<rune> text, by ReadOnlySpan<rune> prefix) {
    return false if text.length < prefix.length
    for i in 0..prefix.length {
        return false if text[i] != prefix[i]
    }
    return true
}

/// The decoded runes as a string in the context allocator.
string stringOf(move List<rune> runes) {
    var sb = StrBuf()
    for c in runes {
        sb.append($"{c}")
    }
    return $"{sb.finish()}"
}

/// `bytes` decoded as `Encoding.UTF8.GetString` does: each invalid maximal subpart is U+FFFD. The lexer's
/// `decodeAt` does this but is not `public`; this is its body (T15 may share it).
List<rune> runesOf(ReadOnlySpan<u8> bytes) {
    var runes = List<rune>()
    var pos: i64 = 0
    while pos < bytes.length {
        let b0 = bytes[pos]
        var value: u32 = 0xFFFD
        var length: i64 = 1
        if b0 < 0x80 {
            value = b0
        } else if b0 is 0xC2..=0xDF {
            if continues(bytes, at: pos + 1, from: 0x80, through: 0xBF) {
                value = (u32(b0 & 0x1F) << 6) | u32(bytes[pos + 1] & 0x3F)
                length = 2
            }
        } else if b0 is 0xE0..=0xEF {
            let lo: u8 = b0 == 0xE0 ? 0xA0 : 0x80
            let hi: u8 = b0 == 0xED ? 0x9F : 0xBF
            if continues(bytes, at: pos + 1, from: lo, through: hi) {
                length = 2
                if continues(bytes, at: pos + 2, from: 0x80, through: 0xBF) {
                    value = (u32(b0 & 0x0F) << 12) | (u32(bytes[pos + 1] & 0x3F) << 6) | u32(bytes[pos + 2] & 0x3F)
                    length = 3
                }
            }
        } else if b0 is 0xF0..=0xF4 {
            let lo: u8 = b0 == 0xF0 ? 0x90 : 0x80
            let hi: u8 = b0 == 0xF4 ? 0x8F : 0xBF
            if continues(bytes, at: pos + 1, from: lo, through: hi) {
                length = 2
                if continues(bytes, at: pos + 2, from: 0x80, through: 0xBF) {
                    length = 3
                    if continues(bytes, at: pos + 3, from: 0x80, through: 0xBF) {
                        value = (u32(b0 & 0x07) << 18) | (u32(bytes[pos + 1] & 0x3F) << 12) |
                            (u32(bytes[pos + 2] & 0x3F) << 6) | u32(bytes[pos + 3] & 0x3F)
                        length = 4
                    }
                }
            }
        }
        runes.append(rune(value))
        pos += length
    }
    return runes
}

bool continues(ReadOnlySpan<u8> bytes, at i64 pos, from u8 lo, through u8 hi) =>
    pos < bytes.length && bytes[pos] >= lo && bytes[pos] <= hi
== parser/main.byn
// bayan-parse: the self-hosted parser. Prints the same text as `bayan parse --ast`. Ports
// `CliApp.Parse` in the shape of the lexer's `main.byn`. Owner:
//
//     bayan-parse [<path>|-]    the tree dump and diagnostics of `<path>`, or of stdin given `-` or no
//                               path; exit 0 if there are no diagnostics, else 1
//     bayan-parse --many <dir>  `== <name>` and the dump of every `*.byn` in `<dir>`, in name order,
//                               followed by a `span out of range` line for any span outside the input
//     bayan-parse --time <path> only the nanoseconds spent lexing, parsing and dumping
//     bayan-parse --codes       `code\tmessage` for every `ParseCode`
//
// Exit 2 on a usage error or an unreadable file under `--many`/`--time`; exit 4 when the input of
// the tree dump cannot be read.

import lexer

const exitOk: i32      = 0
const exitFailure: i32 = 1
const exitUsage: i32   = 2
const exitInput: i32   = 4

i32 usage(string message) {
    Io.stderr.write($"bayan-parse: {message}\nusage: bayan-parse [<path>|-] | --many <dir> | --time <path> | --codes\n")
    return exitUsage
}

i32 fileNotFound(string path) {
    Io.stderr.write($"bayan: file not found: {path}\n")
    return exitUsage
}

i32 unreadable(string path) {
    Io.stderr.write($"bayan-parse: cannot read `{path}`\n")
    return exitInput
}

/// Parses `path`, or stdin when `path` is `-`, and prints its dump.
public i32 parseOne(string path, by Keywords keywords) uses alloc, console, fs {
    var bytes = List<u8>()
    if path == "-" {
        bytes = Io.stdin.readAllBytes() catch {
            Io.stderr.write("bayan-parse: cannot read standard input\n")
            return exitInput
        }
    } else {
        bytes = Io.readFile(path) catch return unreadable(path)
    }
    var p = Parser.create(lexer.lex(SourceText.create(path == "-" ? "<stdin>" : path, from: move bytes), by: keywords))
    var unit = parseCompilationUnit(ref p)
    var sb = StrBuf()
    dump(in unit, from: ref p, to: ref sb)
    Io.stdout.write(sb.finish())
    return p.errorCount() == 0 ? exitOk : exitFailure
}

/// Dumps every `*.byn` in `dir`, each in a fresh arena, with `== <name>` headers and span checks.
i32 parseMany(string dir, by Keywords keywords) {
    let names = Io.listDir(dir) catch return usage($"cannot list `{dir}`")
    for name in names {
        unless name.endsWith(".byn") {
            continue
        }
        using let arena = Arena()
        provide allocator: arena {
            let path = $"{dir}/{name}"
            let bytes = Io.readFile(path) catch return fileNotFound(path)
            var sb = StrBuf()
            sb.append($"== {name}\n")
            var p = Parser.create(lexer.lex(SourceText.create(path, from: move bytes), by: keywords))
            var unit = parseCompilationUnit(ref p)
            dump(in unit, from: ref p, to: ref sb)
            checkSpans(in unit, until: p.lexed.source.bytes.length, to: ref sb)
            Io.stdout.write(sb.finish())
        }
    }
    return exitOk
}

/// Prints the total nanoseconds spent lexing, parsing and dumping `path`, and the per-phase
/// breakdown on stderr (`lex … parse … dump …`) for Q500.
i32 parseTimed(string path, by Keywords keywords) {
    let bytes = Io.readFile(path) catch return fileNotFound(path)
    let lexStart = Io.monotonicNanos()
    let lexed = lexer.lex(SourceText.create(path, from: move bytes), by: keywords)
    let lexNs = Io.monotonicNanos() - lexStart
    let parseStart = Io.monotonicNanos()
    var p = Parser.create(move lexed)
    var unit = parseCompilationUnit(ref p)
    let parseNs = Io.monotonicNanos() - parseStart
    let dumpStart = Io.monotonicNanos()
    var sb = StrBuf()
    dump(in unit, from: ref p, to: ref sb)
    let dumpNs = Io.monotonicNanos() - dumpStart
    print($"{lexNs + parseNs + dumpNs}")
    Io.stderr.write($"lex {lexNs} parse {parseNs} dump {dumpNs}\n")
    return exitOk
}

/// `code\tmessage` for every `ParseCode`, in `DiagnosticCodes.cs` order.
i32 printCodes() {
    for code in ParseCode.values {
        print($"{codeText(code)}\t{messageFormat(code)}")
    }
    return exitOk
}

i32 main(ReadOnlySpan<string> args) {
    let keywords = Keywords.build()
    return parseOne("-", by: keywords) if args.length == 0
    return parseOne(args[0], by: keywords) if args.length == 1 && !args[0].startsWith("--")
    return parseMany(args[1], by: keywords) if args.length == 2 && args[0] == "--many"
    return parseTimed(args[1], by: keywords) if args.length == 2 && args[0] == "--time"
    return printCodes() if args.length == 1 && args[0] == "--codes"
    return usage("expected `[<path>|-]`, `--many <dir>`, `--time <path>` or `--codes`")
}
== parser/nodes.byn
// The syntax tree. Ports `csharp/Bayan.Syntax/Ast/Nodes.cs`. Owner:
//
// Every C# record is a struct of the same name with `TextSpan span` first and the C# properties in
// order, camelCase. A C# `Name` is its `TextSpan` (the dump slices the source), `Name?` is `TextSpan?`
// and `Name[]` is `List<TextSpan>`; decoded texts are `string`, a nullable one `string?`. The abstract
// records `Decl`, `TypeSyntax`, `Stmt`, `Expr`, `Pattern` and `InterpolationPart` are unions with one
// `Owned<…>` variant per record, named after the record with its first letter lowered; the five tree
// unions add `none` for a C# `null` child, so a child is a plain union field and a child list a
// `List<…>` of the union. A child the C# types as one node kind (`BlockStmt`, `NamedType`,
// `TargetMemberExpr`) is its union here (`Stmt`, `TypeSyntax`, `Expr`), as the parsing entry points
// return it. A nullable support record (`FailsClause?`, `UsesClause?`, `BecauseClause?`) is an optional
// struct, a nullable array a `List<…>?`. The base `Decl`'s `Doc` and `Attributes` are the last two
// fields of each declaration struct. Every C# `{ get; init; }` property keeps its default as a field
// default. A C# name that is a Bayan keyword gets the suffix `Keyword` (as `ParseCode.gotoKeyword`):
// fields `defaultKeyword`, `failsKeyword`, `usesKeyword`, `becauseKeyword`, `returnKeyword`,
// `usingKeyword`, `elseKeyword`, `tryKeyword`, `unlessKeyword`, and the enum members so marked below;
// a list keeps a plural instead (BYN5104, Q1190): `Requires` is `requiresClauses`, `Except` `exceptNames`. `Modifiers` is a `u16` with one `modifier…` const per flag.
//
// Checklist, C# record → Bayan (T11 dump, T12 dump and spans walker):
//   Node                   (no node of its own; every struct starts with `span`)
//   Name                   TextSpan
//   CompilationUnit        CompilationUnit
//   AttributeSyntax        AttributeSyntax
//   BecauseClause          BecauseClause
//   RequiresRule           RequiresRule
//   Decl                   union Decl
//   ImportDecl             ImportDecl, Decl.importDecl
//   GlobalStatement        GlobalStatement, Decl.globalStatement
//   Param                  Param
//   FailsClause            FailsClause
//   UsesClause             UsesClause
//   FunctionDecl           FunctionDecl, Decl.functionDecl
//   WhereClause            WhereClause
//   StructDecl             StructDecl, Decl.structDecl
//   InterfaceDecl          InterfaceDecl, Decl.interfaceDecl
//   GetterDecl             GetterDecl, Decl.getterDecl
//   AssociatedTypeDecl     AssociatedTypeDecl, Decl.associatedTypeDecl
//   ExtensionDecl          ExtensionDecl, Decl.extensionDecl
//   FieldDecl              FieldDecl, Decl.fieldDecl
//   PropertyDecl           PropertyDecl, Decl.propertyDecl
//   ConstructorDecl        ConstructorDecl, Decl.constructorDecl
//   ErrorVariant           ErrorVariant
//   ErrorEnumDecl          ErrorEnumDecl, Decl.errorEnumDecl
//   ErrorSetDecl           ErrorSetDecl, Decl.errorSetDecl
//   EnumMember             EnumMember
//   EnumDecl               EnumDecl, Decl.enumDecl
//   UnionField             UnionField
//   UnionVariant           UnionVariant
//   UnionDecl              UnionDecl, Decl.unionDecl
//   TypeAliasDecl          TypeAliasDecl, Decl.typeAliasDecl
//   EffectDecl             EffectDecl, Decl.effectDecl
//   TestDecl               TestDecl, Decl.testDecl
//   TypeSyntax             union TypeSyntax
//   NamedType              NamedType, TypeSyntax.namedType
//   OptionalType           OptionalType, TypeSyntax.optionalType
//   ArrayType              ArrayType, TypeSyntax.arrayType
//   TupleTypeElement       TupleTypeElement
//   TupleType              TupleType, TypeSyntax.tupleType
//   FunctionTypeSyntax     FunctionTypeSyntax, TypeSyntax.functionTypeSyntax
//   DynType                DynType, TypeSyntax.dynType
//   RefinedType            RefinedType, TypeSyntax.refinedType
//   PointerType            PointerType, TypeSyntax.pointerType
//   Stmt                   union Stmt
//   BlockStmt              BlockStmt, Stmt.blockStmt
//   LocalDecl              LocalDecl, Stmt.localDecl
//   ExprStmt               ExprStmt, Stmt.exprStmt
//   AssignStmt             AssignStmt, Stmt.assignStmt
//   IncDecStmt             IncDecStmt, Stmt.incDecStmt
//   ReturnStmt             ReturnStmt, Stmt.returnStmt
//   FailStmt               FailStmt, Stmt.failStmt
//   BreakStmt              BreakStmt, Stmt.breakStmt
//   ContinueStmt           ContinueStmt, Stmt.continueStmt
//   BecomeStmt             BecomeStmt, Stmt.becomeStmt
//   IfStmt                 IfStmt, Stmt.ifStmt
//   UnlessStmt             UnlessStmt, Stmt.unlessStmt
//   GuardedStmt            GuardedStmt, Stmt.guardedStmt
//   WhileStmt              WhileStmt, Stmt.whileStmt
//   DoWhileStmt            DoWhileStmt, Stmt.doWhileStmt
//   WhileLetStmt           WhileLetStmt, Stmt.whileLetStmt
//   ForStmt                ForStmt, Stmt.forStmt
//   LabeledStmt            LabeledStmt, Stmt.labeledStmt
//   SwitchLabel            SwitchLabel
//   SwitchSection          SwitchSection
//   SwitchStmt             SwitchStmt, Stmt.switchStmt
//   DeferStmt              DeferStmt, Stmt.deferStmt
//   AssertStmt             AssertStmt, Stmt.assertStmt
//   NamedArg               NamedArg
//   ContextStmt            ContextStmt, Stmt.contextStmt
//   EmptyStmt              EmptyStmt, Stmt.emptyStmt
//   ErrorStmt              ErrorStmt, Stmt.errorStmt
//   Expr                   union Expr
//   LiteralExpr            LiteralExpr, Expr.literalExpr
//   InterpolationPart      union InterpolationPart
//   InterpolationText      InterpolationText, InterpolationPart.interpolationText
//   InterpolationHole      InterpolationHole, InterpolationPart.interpolationHole
//   InterpolatedExpr       InterpolatedExpr, Expr.interpolatedExpr
//   NameExpr               NameExpr, Expr.nameExpr
//   ThisExpr               ThisExpr, Expr.thisExpr
//   MemberExpr             MemberExpr, Expr.memberExpr
//   TargetMemberExpr       TargetMemberExpr, Expr.targetMemberExpr
//   Argument               Argument
//   CallExpr               CallExpr, Expr.callExpr
//   IndexExpr              IndexExpr, Expr.indexExpr
//   UnaryExpr              UnaryExpr, Expr.unaryExpr
//   BinaryExpr             BinaryExpr, Expr.binaryExpr
//   RangeExpr              RangeExpr, Expr.rangeExpr
//   ConditionalExpr        ConditionalExpr, Expr.conditionalExpr
//   CastExpr               CastExpr, Expr.castExpr
//   IsExpr                 IsExpr, Expr.isExpr
//   ExceptExpr             ExceptExpr, Expr.exceptExpr
//   InExpr                 InExpr, Expr.inExpr
//   SwitchArm              SwitchArm
//   SwitchExpr             SwitchExpr, Expr.switchExpr
//   TryExpr                TryExpr, Expr.tryExpr
//   MoveExpr               MoveExpr, Expr.moveExpr
//   CatchExpr              CatchExpr, Expr.catchExpr
//   CaughtErrorExpr        CaughtErrorExpr, Expr.caughtErrorExpr
//   JumpExpr               JumpExpr, Expr.jumpExpr
//   BlockExpr              BlockExpr, Expr.blockExpr
//   FieldInit              FieldInit
//   StructLiteralExpr      StructLiteralExpr, Expr.structLiteralExpr
//   WithExpr               WithExpr, Expr.withExpr
//   SpreadExpr             SpreadExpr, Expr.spreadExpr
//   MapEntryExpr           MapEntryExpr, Expr.mapEntryExpr
//   CollectionExpr         CollectionExpr, Expr.collectionExpr
//   TupleElement           TupleElement
//   TupleExpr              TupleExpr, Expr.tupleExpr
//   ParenExpr              ParenExpr, Expr.parenExpr
//   LambdaExpr             LambdaExpr, Expr.lambdaExpr
//   StackallocExpr         StackallocExpr, Expr.stackallocExpr
//   PatternExpr            PatternExpr, Expr.patternExpr
//   ErrorExpr              ErrorExpr, Expr.errorExpr
//   Pattern                union Pattern
//   ConstantPattern        ConstantPattern, Pattern.constantPattern
//   RelationalPattern      RelationalPattern, Pattern.relationalPattern
//   VarPattern             VarPattern, Pattern.varPattern
//   DiscardPattern         DiscardPattern, Pattern.discardPattern
//   DeclarationPattern     DeclarationPattern, Pattern.declarationPattern
//   NotPattern             NotPattern, Pattern.notPattern
//   BinaryPattern          BinaryPattern, Pattern.binaryPattern
//   PropertySubpattern     PropertySubpattern
//   PropertyPattern        PropertyPattern, Pattern.propertyPattern
//   PositionalPattern      PositionalPattern, Pattern.positionalPattern
//   VariantPattern         VariantPattern, Pattern.variantPattern
//   SlicePattern           SlicePattern, Pattern.slicePattern
//   ListPattern            ListPattern, Pattern.listPattern

/// The C# `[Flags] enum Modifiers`.
public type Modifiers = u16

const modifierNone: u16     = 0
const modifierPublic: u16   = 1
const modifierPrivate: u16  = 2
const modifierStatic: u16   = 4
const modifierReadonly: u16 = 8
const modifierRequired: u16 = 16
const modifierConst: u16    = 32
const modifierUnique: u16   = 64
const modifierExtern: u16   = 128
const modifierUnsafe: u16   = 256

// ── Compilation unit and declarations ────────────────────────────────────────

public struct CompilationUnit {
    public TextSpan   span
    public List<Decl> members
}

/// An attribute: `@name` or `@name(args)` before a declaration or an error variant.
public struct AttributeSyntax {
    public TextSpan       span
    public TextSpan       name
    public List<Argument> args
    public BecauseClause? becauseKeyword = null
}

/// `because "reason"`: why an attribute or a call bypasses a safety rule (J6).
public struct BecauseClause {
    public TextSpan span
    public string   reason
}

/// `requires condition`, or a struct-level `requires condition at .field`.
public struct RequiresRule {
    public TextSpan  span
    public Expr      condition
    public TextSpan? at
}

public union Decl {
    importDecl(Owned<ImportDecl> node)
    globalStatement(Owned<GlobalStatement> node)
    functionDecl(Owned<FunctionDecl> node)
    structDecl(Owned<StructDecl> node)
    interfaceDecl(Owned<InterfaceDecl> node)
    getterDecl(Owned<GetterDecl> node)
    associatedTypeDecl(Owned<AssociatedTypeDecl> node)
    extensionDecl(Owned<ExtensionDecl> node)
    fieldDecl(Owned<FieldDecl> node)
    propertyDecl(Owned<PropertyDecl> node)
    constructorDecl(Owned<ConstructorDecl> node)
    errorEnumDecl(Owned<ErrorEnumDecl> node)
    errorSetDecl(Owned<ErrorSetDecl> node)
    enumDecl(Owned<EnumDecl> node)
    unionDecl(Owned<UnionDecl> node)
    typeAliasDecl(Owned<TypeAliasDecl> node)
    effectDecl(Owned<EffectDecl> node)
    testDecl(Owned<TestDecl> node)
    none
}

public struct ImportDecl {
    public TextSpan              span
    public List<TextSpan>        path
    public TextSpan?             alias
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

/// A statement written at module level; together they form the implicit `main`.
public struct GlobalStatement {
    public TextSpan span
    public Stmt     statement
    public string?  doc = null
    public List<AttributeSyntax> attributes = []
}

public enum ParamModifier {
    none
    refKeyword
    moveKeyword
    outKeyword
    inKeyword
}

public struct Param {
    public TextSpan      span
    public ParamModifier modifier
    public TypeSyntax    type
    public TextSpan      name
    public Expr          defaultKeyword
    /// The particle before the parameter (`by Carrier carrier`).
    public TextSpan?     particle = null
    /// The variadic tail `rest ReadOnlySpan<T> xs`.
    public bool          rest     = false
}

/// `fails` clause: `errors` empty means the set is inferred.
public struct FailsClause {
    public TextSpan         span
    public List<TypeSyntax> errors
}

/// `uses alloc, net`: the effects a function declares.
public struct UsesClause {
    public TextSpan       span
    public List<TextSpan> effects
}

/// A function or method. Exactly one of `body` and `expressionBody` is set, or neither for a declaration.
public struct FunctionDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TypeSyntax            returnType
    public TextSpan              name
    public List<Param>           params
    public FailsClause?          failsKeyword
    public Stmt                  body
    public Expr                  expressionBody
    public List<TextSpan>        typeParams      = []
    public TextSpan?             refThis         = null
    public TextSpan?             moveThis        = null
    public List<TextSpan>        receiverStates  = []
    /// Where a `ref this` would go: just after the `(`.
    public i64                   paramsStart     = 0
    /// The `expects` clauses after the signature (and the `requires` input form, BYN1063).
    public List<Expr>            requiresClauses = []
    public List<WhereClause>     where           = []
    public TextSpan?             becomes         = null
    public UsesClause?           usesKeyword     = null
    public string?               doc             = null
    public List<AttributeSyntax> attributes      = []
}

/// `where T : IA, IB`: the interfaces a type parameter must conform to.
public struct WhereClause {
    public TextSpan         span
    public TextSpan         param
    public List<TypeSyntax> bounds
}

public struct StructDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<Decl>            members
    public List<TextSpan>        typeParams = []
    public List<TypeSyntax>      bases      = []
    public List<WhereClause>     where      = []
    public List<RequiresRule>    rules      = []
    public List<UnionVariant>    states     = []
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

public struct InterfaceDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<Decl>            members
    public List<TextSpan>        typeParams = []
    public List<WhereClause>     where      = []
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

/// `T name { get; }`: an abstract read-only property of an interface.
public struct GetterDecl {
    public TextSpan   span
    public Modifiers  modifiers
    public TypeSyntax type
    public TextSpan   name
    public string?    doc = null
    public List<AttributeSyntax> attributes = []
}

/// `type Item;`: an interface's associated type.
public struct AssociatedTypeDecl {
    public TextSpan span
    public TextSpan name
    public string?  doc = null
    public List<AttributeSyntax> attributes = []
}

public struct ExtensionDecl {
    public TextSpan              span
    public TextSpan              name
    public List<TypeSyntax>      bases
    public List<Decl>            members
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

public struct FieldDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TypeSyntax            type
    public TextSpan              name
    public Expr                  defaultKeyword
    public List<RequiresRule>    requiresClauses = []
    public string?               doc             = null
    public List<AttributeSyntax> attributes      = []
}

/// `T name => expr`, or `T name { … }` with a `block` body (set exactly when `body` is `none`).
public struct PropertyDecl {
    public TextSpan   span
    public Modifiers  modifiers
    public TypeSyntax type
    public TextSpan   name
    public Expr       body
    public Stmt       block = .none
    public string?    doc   = null
    public List<AttributeSyntax> attributes = []
}

public struct ConstructorDecl {
    public TextSpan    span
    public Modifiers   modifiers
    public TextSpan    name
    public List<Param> params
    public Stmt        body
    public string?     doc = null
    public List<AttributeSyntax> attributes = []
}

public struct ErrorVariant {
    public TextSpan              span
    public TextSpan              name
    public string?               doc
    public List<AttributeSyntax> attributes = []
    public List<UnionField>      fields     = []
}

public struct ErrorEnumDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<ErrorVariant>    variants
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

/// `union error Name = A, B except .c`.
public struct ErrorSetDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<TypeSyntax>      members
    /// The two declaration keywords, as written.
    public TextSpan              head        = TextSpan { start: 0, length: 0 }
    public List<TextSpan>        exceptNames = []
    public string?               doc         = null
    public List<AttributeSyntax> attributes  = []
}

/// A member; `args` is `null` without parentheses.
public struct EnumMember {
    public TextSpan        span
    public TextSpan        name
    public string?         doc
    public List<Argument>? args
}

/// `enum Name { a, b }`, or `enum Name(T x) { a(1), b(2); }` with associated data (`params` non-null).
public struct EnumDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<Param>?          params
    public List<EnumMember>      members
    public List<TypeSyntax>      bases      = []
    public List<WhereClause>     where      = []
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

/// A positional payload field of a union variant: `f32 r`.
public struct UnionField {
    public TextSpan   span
    public TypeSyntax type
    public TextSpan   name
}

/// `circle(f32 r)`, or `none` without a payload; `value` is the `= 1` of `read = 1`.
public struct UnionVariant {
    public TextSpan         span
    public TextSpan         name
    public List<UnionField> fields
    public string?          doc
    public Expr             value = .none
}

public struct UnionDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<UnionVariant>    variants
    public List<TextSpan>        typeParams = []
    public List<TypeSyntax>      bases      = []
    public List<WhereClause>     where      = []
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

/// `type Name = T`, or with `distinct` a `type distinct`.
public struct TypeAliasDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public TypeSyntax            target
    public bool                  distinct        = false
    public List<RequiresRule>    requiresClauses = []
    public string?               doc             = null
    public List<AttributeSyntax> attributes      = []
}

/// `effect name = net, fs` (§14).
public struct EffectDecl {
    public TextSpan              span
    public Modifiers             modifiers
    public TextSpan              name
    public List<TextSpan>        effects
    public string?               doc        = null
    public List<AttributeSyntax> attributes = []
}

/// `test "name" { … }`, or `test "name" (T a, U b) { … }`.
public struct TestDecl {
    public TextSpan    span
    public string      title
    public List<Param> params
    public Stmt        body
    public string?     doc = null
    public List<AttributeSyntax> attributes = []
}

// ── Types ────────────────────────────────────────────────────────────────────

public union TypeSyntax {
    namedType(Owned<NamedType> node)
    optionalType(Owned<OptionalType> node)
    arrayType(Owned<ArrayType> node)
    tupleType(Owned<TupleType> node)
    functionTypeSyntax(Owned<FunctionTypeSyntax> node)
    dynType(Owned<DynType> node)
    refinedType(Owned<RefinedType> node)
    pointerType(Owned<PointerType> node)
    none
}

/// `Name` or `Name<A, B>`, optionally qualified (`m.Name`).
public struct NamedType {
    public TextSpan         span
    public List<TextSpan>   path
    public List<TypeSyntax> args
}

public struct OptionalType {
    public TextSpan   span
    public TypeSyntax inner
}

/// `T[N]`.
public struct ArrayType {
    public TextSpan   span
    public TypeSyntax element
    public Expr       size
}

public struct TupleTypeElement {
    public TextSpan   span
    public TypeSyntax type
    public TextSpan?  name
}

public struct TupleType {
    public TextSpan span
    public List<TupleTypeElement> elements
}

/// `P -> R uses e fails E`: `P` is one type, `(A, B)` or `()`.
public struct FunctionTypeSyntax {
    public TextSpan         span
    public List<TypeSyntax> params
    public TypeSyntax       returnKeyword
    public FailsClause?     failsKeyword
    public UsesClause?      usesKeyword
}

/// `dyn ref I`, `dyn ref readonly I`, or `dyn I`; `inner` is a `namedType`.
public struct DynType {
    public TextSpan   span
    public bool       isRef
    public bool       isReadOnly
    public TypeSyntax inner
}

/// `T is .a or .b`.
public struct RefinedType {
    public TextSpan       span
    public TypeSyntax     inner
    public List<TextSpan> states
}

/// `T*`, or `readonly T*`.
public struct PointerType {
    public TextSpan   span
    public TypeSyntax pointee
    public bool       readOnly
}

// ── Statements ───────────────────────────────────────────────────────────────

public union Stmt {
    blockStmt(Owned<BlockStmt> node)
    localDecl(Owned<LocalDecl> node)
    exprStmt(Owned<ExprStmt> node)
    assignStmt(Owned<AssignStmt> node)
    incDecStmt(Owned<IncDecStmt> node)
    returnStmt(Owned<ReturnStmt> node)
    failStmt(Owned<FailStmt> node)
    breakStmt(Owned<BreakStmt> node)
    continueStmt(Owned<ContinueStmt> node)
    becomeStmt(Owned<BecomeStmt> node)
    ifStmt(Owned<IfStmt> node)
    unlessStmt(Owned<UnlessStmt> node)
    guardedStmt(Owned<GuardedStmt> node)
    whileStmt(Owned<WhileStmt> node)
    doWhileStmt(Owned<DoWhileStmt> node)
    whileLetStmt(Owned<WhileLetStmt> node)
    forStmt(Owned<ForStmt> node)
    labeledStmt(Owned<LabeledStmt> node)
    switchStmt(Owned<SwitchStmt> node)
    deferStmt(Owned<DeferStmt> node)
    assertStmt(Owned<AssertStmt> node)
    contextStmt(Owned<ContextStmt> node)
    emptyStmt(Owned<EmptyStmt> node)
    errorStmt(Owned<ErrorStmt> node)
    none
}

public struct BlockStmt {
    public TextSpan   span
    public List<Stmt> statements
    public List<AttributeSyntax> attributes = []
}

public enum BindingKind {
    letKeyword
    varKeyword
    constKeyword
}

/// `let x = e;`, `var T x = e;`, C#-style `T x = e;` (a `var`), optionally `using`.
public struct LocalDecl {
    public TextSpan    span
    public BindingKind kind
    public bool        usingKeyword
    public TypeSyntax  type
    public TextSpan    name
    public Expr        init
    public List<AttributeSyntax> attributes = []
}

public struct ExprStmt {
    public TextSpan span
    public Expr     expr
    public List<AttributeSyntax> attributes = []
}

public enum AssignOp {
    assign
    add
    sub
    mul
    div
    rem
    andKeyword
    orKeyword
    xor
    shl
    shr
    coalesce
}

public struct AssignStmt {
    public TextSpan span
    public Expr     target
    public AssignOp op
    public Expr     value
    public List<AttributeSyntax> attributes = []
}

public struct IncDecStmt {
    public TextSpan span
    public Expr     target
    public bool     increment
    public List<AttributeSyntax> attributes = []
}

public struct ReturnStmt {
    public TextSpan span
    public Expr     value
    public List<AttributeSyntax> attributes = []
}

/// `fail .x`.
public struct FailStmt {
    public TextSpan span
    public Expr     error
    public List<AttributeSyntax> attributes = []
}

public struct BreakStmt {
    public TextSpan  span
    public TextSpan? label
    public List<AttributeSyntax> attributes = []
}

public struct ContinueStmt {
    public TextSpan  span
    public TextSpan? label
    public List<AttributeSyntax> attributes = []
}

/// `become .s(…)`.
public struct BecomeStmt {
    public TextSpan              span
    public TextSpan              state
    public List<Argument>        args
    public List<AttributeSyntax> attributes = []
}

/// The word after `if`: `if unlikely` or `if never`.
public enum Likelihood {
    none
    unlikely
    neverKeyword
}

public struct IfStmt {
    public TextSpan   span
    public Expr       condition
    public Stmt       then
    public Stmt       elseKeyword
    public Likelihood likelihood = .none
    public List<AttributeSyntax> attributes = []
}

public struct UnlessStmt {
    public TextSpan span
    public Expr     condition
    public Stmt     body
    public List<AttributeSyntax> attributes = []
}

/// A simple statement with a postfix `if`/`unless` (spec §7.3).
public struct GuardedStmt {
    public TextSpan span
    public Stmt     statement
    public bool     unlessKeyword
    public Expr     condition
    public bool unlikely = false
    public List<AttributeSyntax> attributes = []
}

public struct WhileStmt {
    public TextSpan span
    public Expr     condition
    public Stmt     body
    public List<AttributeSyntax> attributes = []
}

public struct DoWhileStmt {
    public TextSpan span
    public Stmt     body
    public Expr     condition
    public List<AttributeSyntax> attributes = []
}

/// `while let x = e { … }`.
public struct WhileLetStmt {
    public TextSpan span
    public TextSpan variable
    public Expr     value
    public Stmt     body
    public List<AttributeSyntax> attributes = []
}

/// `for x in e`, `for (k, v) in e`, `for try x in e`, or the input form `for (let x in e)`.
public struct ForStmt {
    public TextSpan              span
    public BindingKind           kind
    public TypeSyntax            type
    public TextSpan              variable
    public Expr                  iterable
    public Stmt                  body
    public bool                  tryKeyword = false
    public List<TextSpan>        names      = []
    public List<AttributeSyntax> attributes = []
}

public struct LabeledStmt {
    public TextSpan span
    public TextSpan label
    public Stmt     statement
    public List<AttributeSyntax> attributes = []
}

/// One `case` label: a pattern and optional `when` guard. A `none` pattern is `default`.
public struct SwitchLabel {
    public TextSpan span
    public Pattern  pattern
    public Expr     guard
}

public struct SwitchSection {
    public TextSpan    span
    public SwitchLabel label
    public List<Stmt>  statements
}

public struct SwitchStmt {
    public TextSpan              span
    public Expr                  value
    public List<SwitchSection>   sections
    public List<AttributeSyntax> attributes = []
}

public enum DeferKind {
    always
    failing
    panicking
}

/// `defer stmt;`, `defer failing [(e)] stmt` or `defer panicking [(p)] stmt`.
public struct DeferStmt {
    public TextSpan  span
    public DeferKind kind
    public TextSpan? binding
    public Stmt      body
    public List<AttributeSyntax> attributes = []
}

/// `assert expr;`; `failsKeyword` is the error of `assert f() fails E.x`, `none` for a plain assert.
public struct AssertStmt {
    public TextSpan span
    public Expr     condition
    public Expr     failsKeyword = .none
    public List<AttributeSyntax> attributes = []
}

public struct NamedArg {
    public TextSpan span
    public TextSpan name
    public Expr     value
}

/// `provide allocator: a { … }`.
public struct ContextStmt {
    public TextSpan              span
    public List<NamedArg>        values
    public Stmt                  body
    public List<AttributeSyntax> attributes = []
}

public struct EmptyStmt {
    public TextSpan span
    public List<AttributeSyntax> attributes = []
}

/// Placeholder after a parse error.
public struct ErrorStmt {
    public TextSpan span
    public List<AttributeSyntax> attributes = []
}

// ── Expressions ──────────────────────────────────────────────────────────────

public union Expr {
    literalExpr(Owned<LiteralExpr> node)
    interpolatedExpr(Owned<InterpolatedExpr> node)
    nameExpr(Owned<NameExpr> node)
    thisExpr(Owned<ThisExpr> node)
    memberExpr(Owned<MemberExpr> node)
    targetMemberExpr(Owned<TargetMemberExpr> node)
    callExpr(Owned<CallExpr> node)
    indexExpr(Owned<IndexExpr> node)
    unaryExpr(Owned<UnaryExpr> node)
    binaryExpr(Owned<BinaryExpr> node)
    rangeExpr(Owned<RangeExpr> node)
    conditionalExpr(Owned<ConditionalExpr> node)
    castExpr(Owned<CastExpr> node)
    isExpr(Owned<IsExpr> node)
    exceptExpr(Owned<ExceptExpr> node)
    inExpr(Owned<InExpr> node)
    switchExpr(Owned<SwitchExpr> node)
    tryExpr(Owned<TryExpr> node)
    moveExpr(Owned<MoveExpr> node)
    catchExpr(Owned<CatchExpr> node)
    caughtErrorExpr(Owned<CaughtErrorExpr> node)
    jumpExpr(Owned<JumpExpr> node)
    blockExpr(Owned<BlockExpr> node)
    structLiteralExpr(Owned<StructLiteralExpr> node)
    withExpr(Owned<WithExpr> node)
    spreadExpr(Owned<SpreadExpr> node)
    mapEntryExpr(Owned<MapEntryExpr> node)
    collectionExpr(Owned<CollectionExpr> node)
    tupleExpr(Owned<TupleExpr> node)
    parenExpr(Owned<ParenExpr> node)
    lambdaExpr(Owned<LambdaExpr> node)
    stackallocExpr(Owned<StackallocExpr> node)
    patternExpr(Owned<PatternExpr> node)
    errorExpr(Owned<ErrorExpr> node)
    none
}

public enum LiteralKind {
    integer
    floatKeyword
    char
    string
    rawString
    cString
    u16String
    trueKeyword
    falseKeyword
    nullKeyword
}

/// A literal; `suffix` is the unit/width suffix of a number (`dec`, `u`, …).
public struct LiteralExpr {
    public TextSpan    span
    public LiteralKind kind
    public string      text
    public TextSpan?   suffix
}

public union InterpolationPart {
    interpolationText(Owned<InterpolationText> node)
    interpolationHole(Owned<InterpolationHole> node)
}

/// Literal text with escapes and doubled braces decoded.
public struct InterpolationText {
    public TextSpan span
    public string   text
}

public struct InterpolationHole {
    public TextSpan       span
    public Expr           expr
    /// The named format specs after the value (`{n, as: .hex}`).
    public List<Argument> specs = []
}

public struct InterpolatedExpr {
    public TextSpan span
    public List<InterpolationPart> parts
}

public struct NameExpr {
    public TextSpan         span
    public TextSpan         name
    public List<TypeSyntax> typeArgs
}

public struct ThisExpr {
    public TextSpan span
}

public struct MemberExpr {
    public TextSpan         span
    public Expr             target
    public TextSpan         member
    public bool             nullConditional
    /// Explicit type arguments of a generic method call, `x.f<T>()`.
    public List<TypeSyntax> typeArgs = []
}

/// `.member` resolved from the target type.
public struct TargetMemberExpr {
    public TextSpan span
    public TextSpan member
}

public enum ArgModifier {
    none
    refKeyword
    moveKeyword
    outKeyword
    inKeyword
}

public struct Argument {
    public TextSpan    span
    public TextSpan?   name
    public ArgModifier modifier
    public Expr        value
}

public struct CallExpr {
    public TextSpan       span
    public Expr           callee
    public List<Argument> args
    public BecauseClause? becauseKeyword = null
}

public struct IndexExpr {
    public TextSpan span
    public Expr     target
    public Expr     index
}

public enum UnaryOp {
    plus
    negate
    notKeyword
    complement
    fromEnd
}

public struct UnaryExpr {
    public TextSpan span
    public UnaryOp  op
    public Expr     operand
}

public enum BinaryOp {
    add
    sub
    mul
    div
    rem
    addWrap
    subWrap
    mulWrap
    addSat
    subSat
    mulSat
    shl
    shr
    lt
    gt
    le
    ge
    eq
    ne
    bitAnd
    bitOr
    bitXor
    logicalAnd
    logicalOr
    coalesce
}

public struct BinaryExpr {
    public TextSpan span
    public BinaryOp op
    public Expr     left
    public Expr     right
}

/// `a..b` / `a..=b`; either end may be `none` (`..b`, `a..`).
public struct RangeExpr {
    public TextSpan span
    public Expr     start
    public Expr     end
    public bool     inclusive
}

public struct ConditionalExpr {
    public TextSpan span
    public Expr     condition
    public Expr     whenTrue
    public Expr     whenFalse
}

public struct CastExpr {
    public TextSpan   span
    public TypeSyntax type
    public Expr       operand
}

public struct IsExpr {
    public TextSpan span
    public Expr     value
    public Pattern  pattern
}

/// `xs except p`.
public struct ExceptExpr {
    public TextSpan span
    public Expr     value
    public Pattern  pattern
}

/// `x in a..=b`.
public struct InExpr {
    public TextSpan span
    public Expr     value
    public Expr     range
}

public struct SwitchArm {
    public TextSpan span
    public Pattern  pattern
    public Expr     guard
    public Expr     value
}

public struct SwitchExpr {
    public TextSpan        span
    public Expr            value
    public List<SwitchArm> arms
}

public struct TryExpr {
    public TextSpan span
    public Expr     operand
}

/// `move x`.
public struct MoveExpr {
    public TextSpan span
    public Expr     operand
}

/// `e catch h`, `e catch (x) h` or `e catch (Set.variant) h` (`variant` set).
public struct CatchExpr {
    public TextSpan  span
    public Expr      operand
    public TextSpan? binding
    public Expr      variant
    public Expr      handler
}

/// The subject of `catch switch { … }`; `span` is the `switch` keyword.
public struct CaughtErrorExpr {
    public TextSpan span
}

/// `return e`, `break`, `continue` used as a `never` expression after `??` or `catch`.
public struct JumpExpr {
    public TextSpan span
    public Stmt     jump
}

/// `{ … }` as a `catch` handler; `block` is a `blockStmt`.
public struct BlockExpr {
    public TextSpan span
    public Stmt     block
}

public struct FieldInit {
    public TextSpan span
    public TextSpan name
    public Expr     value
}

/// `T { f = v }` or target-typed `{ f = v }` (`type` is `none`).
public struct StructLiteralExpr {
    public TextSpan        span
    public TypeSyntax      type
    public List<FieldInit> fields
}

/// `e with { f = v }`.
public struct WithExpr {
    public TextSpan        span
    public Expr            target
    public List<FieldInit> fields
}

public struct SpreadExpr {
    public TextSpan span
    public Expr     operand
}

/// `key: value` inside a collection literal.
public struct MapEntryExpr {
    public TextSpan span
    public Expr     key
    public Expr     value
}

public struct CollectionExpr {
    public TextSpan   span
    public List<Expr> elements
}

public struct TupleElement {
    public TextSpan  span
    public TextSpan? name
    public Expr      value
}

public struct TupleExpr {
    public TextSpan span
    public List<TupleElement> elements
}

public struct ParenExpr {
    public TextSpan span
    public Expr     inner
}

/// `x => body`, `(a, b) => body` or `() => body`; the body is an expression or a block.
public struct LambdaExpr {
    public TextSpan       span
    public List<TextSpan> params
    public Expr           body
    public Stmt           block
}

/// `stackalloc T[n]`.
public struct StackallocExpr {
    public TextSpan   span
    public TypeSyntax element
    public Expr       count
}

/// `pattern T { … }`, a named pattern's value (BYN1046).
public struct PatternExpr {
    public TextSpan span
    public Pattern  pattern
}

/// Placeholder after a parse error.
public struct ErrorExpr {
    public TextSpan span
}

// ── Patterns ─────────────────────────────────────────────────────────────────

public union Pattern {
    constantPattern(Owned<ConstantPattern> node)
    relationalPattern(Owned<RelationalPattern> node)
    varPattern(Owned<VarPattern> node)
    discardPattern(Owned<DiscardPattern> node)
    declarationPattern(Owned<DeclarationPattern> node)
    notPattern(Owned<NotPattern> node)
    binaryPattern(Owned<BinaryPattern> node)
    propertyPattern(Owned<PropertyPattern> node)
    positionalPattern(Owned<PositionalPattern> node)
    variantPattern(Owned<VariantPattern> node)
    slicePattern(Owned<SlicePattern> node)
    listPattern(Owned<ListPattern> node)
    none
}

/// A constant: literal, `.member`, a qualified name or a range.
public struct ConstantPattern {
    public TextSpan span
    public Expr     value
}

public struct RelationalPattern {
    public TextSpan span
    public BinaryOp op
    public Expr     value
}

/// `var x` or `let x`.
public struct VarPattern {
    public TextSpan span
    public TextSpan name
    public bool     isLet = false
}

public struct DiscardPattern {
    public TextSpan span
}

/// `DbError e`.
public struct DeclarationPattern {
    public TextSpan   span
    public TypeSyntax type
    public TextSpan   name
}

public struct NotPattern {
    public TextSpan span
    public Pattern  operand
}

public struct BinaryPattern {
    public TextSpan span
    public bool     isAnd
    public Pattern  left
    public Pattern  right
}

public struct PropertySubpattern {
    public TextSpan       span
    public List<TextSpan> path
    public Pattern        pattern
}

/// `Type { a: p } name`; `{ } v` matches any non-null value.
public struct PropertyPattern {
    public TextSpan   span
    public TypeSyntax type
    public List<PropertySubpattern> properties
    public TextSpan?  designation
}

/// `Name(p, q)` or `(p, q)`.
public struct PositionalPattern {
    public TextSpan      span
    public TypeSyntax    type
    public List<Pattern> elements
}

/// `.Circle(let r)`; `variant` is a `targetMemberExpr`. `.Circle c` sets `binding` with `elements` empty.
public struct VariantPattern {
    public TextSpan      span
    public Expr          variant
    public List<Pattern> elements
    public TextSpan?     binding = null
}

/// `..` or `.. var rest`.
public struct SlicePattern {
    public TextSpan span
    public Pattern  inner
}

public struct ListPattern {
    public TextSpan      span
    public List<Pattern> elements
}
== parser/parser.byn
// Parser state, token access and diagnostics. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 20–163
// (fields, the constructor's `_inGroup` precompute, the cursor, `Report`, `ErrorCount`, `Describe`,
// `Expect`) and gives the flags C# restores in `finally` a save helper each. Owner:
//
// Parsing is free functions over `ref Parser p`, one file per C# line range; the cursor and diagnostics
// are methods, so a C# `Report(…)` is `p.report(…)` and a C# `Expect(…)` is `p.expect(…)`.

import lexer

// The lexer's types under their own names: a struct literal cannot name its type through a module
// (`lexer.TextSpan { … }` does not parse, Q431).
public type TextSpan   = lexer.TextSpan
public type Token      = lexer.Token
public type TokenKind  = lexer.TokenKind
public type Diagnostic = lexer.Diagnostic
public type LexResult  = lexer.LexResult
public type SourceText = lexer.SourceText
public type Keywords   = lexer.Keywords

/// The parser's state over one lexed source. The lexer's diagnostics come first in `lexed.diagnostics`
/// and the parser appends to them, as C# copies them into its bag.
public struct Parser {
    /// Tokens (the last is `endOfFile`), diagnostics and source.
    public LexResult         lexed
    public i64               count
    public i64               pos
    public i64               prevEnd
    public i64               lastErrorAt
    /// Reports other than input forms (`isInputForm`); only these make `recoverIfNeeded` resynchronize.
    public i64               syntaxErrors
    /// Token index where the bare condition being parsed starts, or -1 (see `braceLiteralAllowed`).
    public i64               conditionStart
    /// Per token: whether its innermost bracket is `(`, `[` or an interpolation hole, where a line break never ends a statement.
    public List<bool>        inGroup
    /// Whether the declaration being parsed carries `extern`, where pointer types are allowed (BYN1067).
    public bool              inExtern
    /// Whether a name or `( … )` before `=>` is not a lambda: in a pattern, an arm's guard or an `expects` condition.
    public bool              noLambda
    /// Set while type arguments are scanned inside an expression, where `=>` is never a type's arrow (`a < b => c > (x)`).
    public bool              exprTypeArgs
    /// Statement attributes not yet on a node, innermost last: a statement node is read-only once built, so
    /// `parseStatement` leaves them here with the statement's first token start and the first attribute's start.
    public List<List<AttributeSyntax>> statementAttributes = []
    public List<i64>         statementAttributeKeys   = []
    public List<i64>         statementAttributeStarts = []
    /// Set by `parseStruct` around each member it parses: a field is read-only once wrapped in `Owned`, and O3 splits its
    /// rules only once every field of the struct is known (Q819), so `parseFieldOrProperty` leaves the field here unwrapped.
    public bool              collectField             = false
    public List<FieldDecl>   collectedFields          = []
    /// Set by `typeNames` and `calleeAndReceiverNames` (dump2.byn) around a dump: the C# `Writer.TypeNames` and `Writer.CalleeNames` side lists (Q1143).
    public bool              collectNames             = false
    public List<TextSpan>    collectedTypeNames       = []
    public List<TextSpan>    collectedCalleeNames     = []
    /// The style lints found while parsing (the C# `_styleLints`); a block's depth (`_blockDepth`) is counted from the enclosing function's body.
    public List<Diagnostic>  styleLints               = []
    public i64               blockDepth               = 0
    /// Per token: whether a call argument's value starts there (the C# `_argumentStarts`); a lambda there is an argument itself.
    public List<bool>        argumentStarts           = []
    /// The style lints the compilation confirms from how their operands bind (the C# `_typedLints`, lints.byn); every `&&` and `||`
    /// as built (`_logical`); the `if (X is { } k)` sites whose miss leaves, until their block decides them (`_bindExits`).
    public List<TypedLint>   typedLints               = []
    public List<LogicalSite> logical                  = []
    public List<BindExit>    bindExits                = []

    public static Parser create(move LexResult lexed) uses alloc {
        let count = lexed.tokens.length
        var inGroup = List<bool>()
        var groups = List<bool>()
        var argumentStarts = List<bool>()
        for i in 0..count {
            argumentStarts.append(false)
            inGroup.append(groups.length > 0 && groups[groups.length - 1])
            switch lexed.tokens[i].kind {
                case .openParen or .openBracket or .interpolationStart:
                    groups.append(true)
                case .openBrace:
                    groups.append(false)
                case .closeParen or .closeBracket or .interpolationEnd or .closeBrace:
                    if groups.length > 0 {
                        let _ = groups.removeLast()
                    }
                default:
                    continue
            }
        }
        return Parser {
            lexed: move lexed,
            count: count,
            pos: 0,
            prevEnd: 0,
            lastErrorAt: -1,
            syntaxErrors: 0,
            conditionStart: -1,
            inGroup: move inGroup,
            inExtern: false,
            noLambda: false,
            exprTypeArgs: false,
            argumentStarts: move argumentStarts,
        }
    }

    // ── Token access ─────────────────────────────────────────────────────────

    Token current(ref this) => lexed.tokens[pos]

    TokenKind kind(ref this) => lexed.tokens[pos].kind

    Token peekToken(ref this, i64 n) => lexed.tokens[pos + n < count - 1 ? pos + n : count - 1]

    TokenKind peek(ref this, i64 n) => peekToken(n).kind

    TokenKind kindAt(ref this, i64 index) => lexed.tokens[index < count - 1 ? index : count - 1].kind

    bool atEnd(ref this) => kind() == .endOfFile

    Token advance(ref this) {
        let token = lexed.tokens[pos]
        if token.kind != .endOfFile {
            pos += 1
            prevEnd = token.end
        }
        return token
    }

    bool accept(ref this, TokenKind kind) {
        return false if this.kind() != kind
        let _ = advance()
        return true
    }

    /// The source bytes of `token`; `textOf` is the C# `Text`, as a string.
    ReadOnlySpan<u8> text(ref this, Token token) => lexed.source.bytes.span[token.start..token.end]

    string textOf(ref this, Token token) => lexed.source.getText(spanOf(token))

    TextSpan spanFrom(ref this, i64 start) => TextSpan.fromBounds(start, until: prevEnd > start ? prevEnd : start)

    /// Whether the current and next token are both `>` with nothing between (a shift).
    bool atShiftRight(ref this, i64 offset = 0) =>
        peek(offset) == .greater && peek(offset + 1) == .greater && !peekToken(offset + 1).hasTriviaBefore

    // ── Flags ────────────────────────────────────────────────────────────────
    // C# restores these in `finally`; Bayan has no exceptions, so a site saves the old value with
    // the setter, makes one call, and assigns the old value back.

    bool setNoLambda(ref this, bool value) {
        let saved = noLambda
        noLambda = value
        return saved
    }

    bool setExprTypeArgs(ref this, bool value) {
        let saved = exprTypeArgs
        exprTypeArgs = value
        return saved
    }

    bool setInExtern(ref this, bool value) {
        let saved = inExtern
        inExtern = value
        return saved
    }

    i64 setConditionStart(ref this, i64 value) {
        let saved = conditionStart
        conditionStart = value
        return saved
    }

    // ── Diagnostics ──────────────────────────────────────────────────────────

    /// Reports `code` at `span` unless an error was already reported at `span.start`; returns the
    /// diagnostic's index in `lexed.diagnostics`, or -1 when suppressed (the C# `null`). An empty
    /// `label` or `help` is the C# `null`.
    i64 report(
        ref this,
        ParseCode code,
        at TextSpan span,
        string arg0 = "",
        string arg1 = "",
        string arg2 = "",
        string label = "",
        string help = ""
    ) =>
        add(code, at: span, by: (a0: arg0, a1: arg1, a2: arg2), label: label, help: help, hasFix: false, for: span)

    /// `report` with the C# `Fix`: replace `fixSpan` with `replacement`.
    i64 reportFix(
        ref this,
        ParseCode code,
        at TextSpan span,
        through TextSpan fixSpan,
        by string replacement,
        string arg0 = "",
        string arg1 = "",
        string arg2 = "",
        string label = "",
        string help = ""
    ) =>
        add(
            code,
            at: span,
            by: (a0: arg0, a1: arg1, a2: arg2),
            label: label,
            help: help,
            hasFix: true,
            for: fixSpan,
            fixReplacement: replacement,
        )

    i64 add(
        ref this,
        ParseCode code,
        at TextSpan span,
        by (string a0, string a1, string a2) args,
        string label = "",
        string help = "",
        bool hasFix,
        for TextSpan fixSpan,
        string fixReplacement = ""
    ) {
        return -1 if span.start == lastErrorAt
        lastErrorAt = span.start
        unless isInputForm(code) {
            syntaxErrors += 1
        }
        lexed.diagnostics.append(Diagnostic {
            code: codeText(code),
            span: span,
            message: format(messageFormat(code), by: args),
            label: label,
            help: help,
            hasFix: hasFix,
            fixSpan: fixSpan,
            fixReplacement: fixReplacement,
        })
        return lexed.diagnostics.length - 1
    }

    /// The C# `ErrorCount`: diagnostics still reported, so a tombstone (code `""`, see `unreport`) does not count.
    i64 errorCount(ref this) {
        var n: i64 = 0
        for d in lexed.diagnostics {
            unless d.code.isEmpty {
                n += 1
            }
        }
        return n
    }

    string describe(ref this, Token token) {
        let kind = token.kind
        return "end of file" if kind == .endOfFile
        return $"`{textOf(token)}`" if kind == .identifier
        return $"`{textOf(token)}`" if kind is .integerLiteral or .floatLiteral
        return $"keyword `{textOf(token)}`" if lexer.isKeyword(kind)
        return "a rune literal" if kind == .charLiteral
        return "a string literal" if kind == .interpolatedStringStart
        return "a string literal" if lexer.isStringLiteral(kind)
        return $"`{lexer.kindText(kind)}`"
    }

    Token expect(ref this, TokenKind kind, string label = "") {
        return advance() if this.kind() == kind
        let _ = report(
            .expected,
            at: spanOf(current()),
            arg0: $"`{lexer.kindText(kind)}`",
            arg1: describe(current()),
            label: label,
        )
        return Token { kind: kind, tokenFlags: 0, start: current().start, length: 0, docStart: 0, docLength: 0 }
    }
}

/// The C# `Token.Span`.
TextSpan spanOf(Token token) => TextSpan { start: token.start, length: token.length }
== parser/patterns.byn
// Patterns. Ports `csharp/Bayan.Syntax/Parsing/Parser.cs` lines 4058–4248 (`ParsePattern` onward):
// `ParsePattern` with `WithoutLambdas` inlined as save/restore, `ParseAndPattern`, `ParseNotPattern`,
// `ParsePrimaryPattern`, `ParsePropertyPattern`, `ParseListPattern`. Owner:

import lexer

Pattern parsePattern(ref Parser p) {
    let saved = p.setNoLambda(value: true)
    let pattern = parseOrPattern(ref p)
    p.noLambda = saved
    return pattern
}

/// The body of `ParsePattern`, run with `noLambda` set.
Pattern parseOrPattern(ref Parser p) {
    let start = p.current().start
    var left = parseAndPattern(ref p)
    while p.kind() == .orKeyword {
        let _ = p.advance()
        let right = parseAndPattern(ref p)
        left = Pattern.binaryPattern(
            Owned(BinaryPattern { span: p.spanFrom(start), isAnd: false, left: move left, right: move right }),
        )
    }
    return left
}

Pattern parseAndPattern(ref Parser p) {
    let start = p.current().start
    var left = parseNotPattern(ref p)
    while p.kind() == .andKeyword {
        let _ = p.advance()
        let right = parseNotPattern(ref p)
        left = Pattern.binaryPattern(
            Owned(BinaryPattern { span: p.spanFrom(start), isAnd: true, left: move left, right: move right }),
        )
    }
    return left
}

Pattern parseNotPattern(ref Parser p) {
    let start = p.current().start
    if p.accept(.notKeyword) {
        // C# takes the span before it parses the operand, so it covers `not` alone (Q511).
        let span = p.spanFrom(start)
        let operand = parseNotPattern(ref p)
        return Pattern.notPattern(Owned(NotPattern { span: span, operand: move operand }))
    }
    return parsePrimaryPattern(ref p)
}

Pattern parsePrimaryPattern(ref Parser p) {
    let start = p.current().start
    let kind = p.kind()
    if kind is .less or .lessEquals or .greater or .greaterEquals {
        let op: BinaryOp = p.advance().kind switch {
            .less       => .lt,
            .lessEquals => .le,
            .greater    => .gt,
            _           => .ge,
        }
        let value = parseBinary(ref p, at: precShift)
        return Pattern.relationalPattern(
            Owned(RelationalPattern { span: p.spanFrom(start), op: op, value: move value }),
        )
    }
    if kind is .varKeyword or .letKeyword {
        let isLet = p.advance().kind == .letKeyword
        // C# takes the span before it reads the name, so it covers the keyword alone (Q511).
        let span = p.spanFrom(start)
        let name = expectName(ref p, "a variable name")
        return Pattern.varPattern(Owned(VarPattern { span: span, name: name, isLet: isLet }))
    }
    if kind == .dot && isName(p.peek(1)) && p.peek(2) == .openParen {
        let _ = p.advance()
        let name = nameOf(p.advance())
        let variant = Expr.targetMemberExpr(Owned(TargetMemberExpr { span: p.spanFrom(start), member: name }))
        let _ = p.advance()
        var elements = List<Pattern>()
        if p.kind() != .closeParen {
            elements.append(parsePattern(ref p))
            while p.accept(.comma) {
                elements.append(parsePattern(ref p))
            }
        }
        let _ = p.expect(.closeParen)
        return Pattern.variantPattern(
            Owned(VariantPattern { span: p.spanFrom(start), variant: move variant, elements: move elements }),
        )
    }
    // `.percentOff p`: binds the whole value, narrowed to the case; `when` starts a guard.
    if kind == .dot && isName(p.peek(1)) && p.peek(2) == .identifier && !p.peekToken(2).hasNewlineBefore
            && !lexer.sameBytes(p.text(p.peekToken(2)), as: "when".bytes) {
        let _ = p.advance()
        let variant = Expr.targetMemberExpr(
            Owned(TargetMemberExpr { span: p.spanFrom(start), member: nameOf(p.advance()) }),
        )
        let binding = nameOf(p.advance())
        return Pattern.variantPattern(Owned(VariantPattern {
            span: p.spanFrom(start), variant: move variant, elements: List<Pattern>(), binding: binding,
        }))
    }
    if kind == .identifier
            && lexer.sameBytes(p.text(p.current()), as: "_".bytes)
            && p.peek(1) != .dot
            && p.peek(1) != .openParen {
        let _ = p.advance()
        return Pattern.discardPattern(Owned(DiscardPattern { span: p.spanFrom(start) }))
    }
    return parsePropertyPattern(ref p, at: start, by: .none) if kind == .openBrace && braceLiteralAllowed(ref p)
    return parseListPattern(ref p, at: start) if kind == .openBracket
    if kind == .openParen {
        let _ = p.advance()
        var elements = List<Pattern>()
        elements.append(parsePattern(ref p))
        return elements.removeLast() if p.accept(.closeParen)
        while p.accept(.comma) {
            elements.append(parsePattern(ref p))
        }
        let _ = p.expect(.closeParen)
        return Pattern.positionalPattern(
            Owned(PositionalPattern { span: p.spanFrom(start), type: .none, elements: move elements }),
        )
    }
    if kind == .identifier && lexer.firstIsUpper(p.text(p.current())) {
        let after = scanType(ref p, at: p.pos)
        if after > 0 && p.kindAt(after) == .openBrace && braceLiteralAllowed(ref p) {
            let type = parseType(ref p)
            return parsePropertyPattern(ref p, at: start, by: move type)
        }
        if after > 0 && p.kindAt(after) == .openParen {
            let type = parseType(ref p)
            let _ = p.advance()
            var elements = List<Pattern>()
            if p.kind() != .closeParen {
                elements.append(parsePattern(ref p))
                while p.accept(.comma) {
                    elements.append(parsePattern(ref p))
                }
            }
            let _ = p.expect(.closeParen)
            return Pattern.positionalPattern(
                Owned(PositionalPattern { span: p.spanFrom(start), type: move type, elements: move elements }),
            )
        }
        if after > 0
                && p.kindAt(after) == .identifier
                && !lexer.sameBytes(p.text(p.lexed.tokens[after]), as: "when".bytes) {
            // `DbError e`: a declaration pattern binding the matched value at the written type.
            let type = parseType(ref p)
            let name = nameOf(p.advance())
            return Pattern.declarationPattern(
                Owned(DeclarationPattern { span: p.spanFrom(start), type: move type, name: name }),
            )
        }
    }
    let constant = parseBinary(ref p, at: precRange)
    return Pattern.constantPattern(Owned(ConstantPattern { span: p.spanFrom(start), value: move constant }))
}

Pattern parsePropertyPattern(ref Parser p, at i64 start, by move TypeSyntax type) {
    let open = p.expect(.openBrace)
    var properties = List<PropertySubpattern>()
    while p.kind() != .closeBrace && !p.atEnd() {
        let before = p.pos
        let subStart = p.current().start
        var path = List<TextSpan>()
        path.append(expectName(ref p, "a property name"))
        while p.accept(.dot) {
            path.append(expectName(ref p, "a property name"))
        }
        let _ = p.expect(.colon)
        let pattern = parsePattern(ref p)
        properties.append(PropertySubpattern { span: p.spanFrom(subStart), path: move path, pattern: move pattern })
        unless p.accept(.comma) {
            break
        }
        break if p.pos == before
    }
    expectClose(ref p, from: open, for: "property pattern")
    var designation: TextSpan? = null
    if isName(p.kind()) && !(p.kind() == .identifier && lexer.sameBytes(p.text(p.current()), as: "when".bytes))
            && !p.current().hasNewlineBefore {
        designation = nameOf(p.advance())
    }
    return Pattern.propertyPattern(Owned(PropertyPattern {
        span: p.spanFrom(start), type: move type, properties: move properties, designation: designation,
    }))
}

Pattern parseListPattern(ref Parser p, at i64 start) {
    let _ = p.advance()
    var elements = List<Pattern>()
    while p.kind() != .closeBracket && !p.atEnd() {
        let before = p.pos
        let elementStart = p.current().start
        if p.accept(.dotDot) {
            let inner = p.kind() == .comma || p.kind() == .closeBracket ? Pattern.none : parsePattern(ref p)
            elements.append(
                Pattern.slicePattern(Owned(SlicePattern { span: p.spanFrom(elementStart), inner: move inner })),
            )
        } else {
            elements.append(parsePattern(ref p))
        }
        unless p.accept(.comma) {
            break
        }
        break if p.pos == before
    }
    let _ = p.expect(.closeBracket)
    return Pattern.listPattern(Owned(ListPattern { span: p.spanFrom(start), elements: move elements }))
}

// ── Cross-file stand-ins (T3) ────────────────────────────────────────────────
// Each stands for a C# helper another task ports in its own file (Q441). T15 replaces each `` call
// with the sibling's function and deletes this struct; until then the two parse stand-ins are placeholders.
== parser/recover.byn
// Recovery and line structure. Ports from `csharp/Bayan.Syntax/Parsing/Parser.cs`: `ExpectEnd`,
// `ReportSemicolon`, `IndentAt`, `BreaksLine`, `HasBlankLineBefore`, `IsWasl`, `LineContinues`,
// `StopsHere`, `EndsBefore`, `ExpectName`, `NameOf`, `IsName`, `IsStatementKeyword`, `Synchronize`,
// `RecoverIfNeeded` (lines 165–343), `LintLineJoins`, the style lints (`LintPostfixGuard`, `LintItLambda`,
// `LintWrappedCondition`, `LintFunctionLength` and `ParseBlock`'s depth check), `InGroup`, `Unreport`, the sets `ItName` and `Particles`, and
// from the lexer `TokenKindFacts.IsContextualKeyword` and `Keywords.IsCSharpPrimitive`. Owner:
//
// A C# `Name` is its `TextSpan` (nodes.byn), so `expectName` and `nameOf` return the span; a missing
// name is the empty span at the current token, which C# spells `<missing>`.

import lexer

/// The end of a statement or declaration: a line break, `}` or the end of the file. Each `;` here is
/// the input form (BYN1040); another statement on the same line is BYN1005.
void expectEnd(ref Parser p) {
    if p.kind() == .semicolon {
        while p.kind() == .semicolon {
            reportSemicolon(ref p, for: p.advance())
        }
        return
    }
    return if p.atEnd() || p.kind() == .closeBrace || p.current().hasNewlineBefore
    // The token after the statement was already reported (e.g. as a bad expression); one error is enough.
    return if p.lastErrorAt == p.current().start
    let _ = p.reportFix(
        .missingLineBreak,
        at: TextSpan { start: p.prevEnd, length: 0 },
        through: TextSpan.fromBounds(p.prevEnd, until: p.current().start),
        by: $"\n{indentAt(ref p, at: p.prevEnd)}",
        label: $"found {p.describe(p.current())}",
        help: "put the next statement on its own line",
    )
}

/// BYN1040 for a `;` just consumed: deleted, or a line break when a statement follows on its line.
void reportSemicolon(ref Parser p, for Token semicolon) {
    var from = semicolon.start
    while from > 0 && (p.lexed.source.bytes[from - 1] == ' ' || p.lexed.source.bytes[from - 1] == '\t') {
        from -= 1
    }
    if p.current().hasNewlineBefore || p.kind() == .semicolon || p.kind() == .closeBrace || p.kind() == .endOfFile {
        let _ = p.reportFix(
            .semicolonInput,
            at: spanOf(semicolon),
            through: TextSpan.fromBounds(from, until: semicolon.end),
            by: "",
            label: "remove `;`",
            help: "remove the `;`",
        )
        return
    }
    var to = semicolon.end
    while to < p.lexed.source.bytes.length && (p.lexed.source.bytes[to] == ' ' || p.lexed.source.bytes[to] == '\t') {
        to += 1
    }
    let _ = p.reportFix(
        .semicolonInput,
        at: spanOf(semicolon),
        through: TextSpan.fromBounds(from, until: to),
        by: $"\n{indentAt(ref p, at: semicolon.start)}",
        label: "remove `;`",
        help: "put the next statement on its own line",
    )
}

/// The spaces and tabs that start the line holding `offset`.
string indentAt(ref Parser p, at i64 offset) {
    let line = p.lexed.source.getLineSpan(p.lexed.source.getLineIndex(offset))
    var end = line.start
    while end < line.end && (p.lexed.source.bytes[end] == ' ' || p.lexed.source.bytes[end] == '\t') {
        end += 1
    }
    return p.lexed.source.getText(TextSpan.fromBounds(line.start, until: end))
}

// ── Line breaks (waqf) ───────────────────────────────────────────────────────

/// Whether a line break before token `index` can end a statement: one outside `()`, `[]` and interpolation holes.
bool breaksLine(ref Parser p, at i64 index) =>
    index < p.count && p.lexed.tokens[index].hasNewlineBefore && !p.inGroup[index]

/// Whether a line of only whitespace lies between token `index` and the one before it; a comment line is not blank.
bool hasBlankLineBefore(ref Parser p, at i64 index) {
    return false if index <= 0 || index >= p.count
    var lineIsBlank = false
    for i in p.lexed.tokens[index - 1].end..p.lexed.tokens[index].start {
        let b = p.lexed.source.bytes[i]
        if b == '\n' {
            return true if lineIsBlank
            lineIsBlank = true
        } else if !(b == ' ' || b == '\t' || b == '\r') {
            lineIsBlank = false
        }
    }
    return false
}

/// A token that joins the line it starts to the line before (waṣl).
bool isWasl(ref Parser p, at i64 index) {
    switch p.kindAt(index) {
        case .dot or .questionDot or .questionQuestion or .ampAmp or .barBar or .andKeyword or .orKeyword or
            .catchKeyword or .exceptKeyword or .requiresKeyword or .failsKeyword or .usesKeyword:
            return true
        case .identifier:
            let token = p.lexed.tokens[index]
            return p.kindAt(index + 1) == .identifier
                && p.kindAt(index + 2) == .colon if lexer.sameBytes(p.text(token), as: "where".bytes)
            return p.kindAt(index + 1) == .dot if lexer.sameBytes(p.text(token), as: "becomes".bytes)
            if lexer.sameBytes(p.text(token), as: "expects".bytes) {
                let next = p.kindAt(index + 1)
                return next is .identifier or .bang or .notKeyword or .thisKeyword
            }
            return false
        default:
            return false
    }
}

/// Whether the line before token `index` ends in an operator, `,`, `=`, `=>` or an opening bracket (lā), or the token is waṣl.
bool lineContinues(ref Parser p, at i64 index) => isWasl(ref p, at: index) || afterLa(ref p, at: index)

/// Whether the line before token `index` ends in an operator, `,`, `=`, `=>` or an opening bracket (lā).
bool afterLa(ref Parser p, at i64 index) {
    return false if index <= 0
    switch p.kindAt(index - 1) {
        case .comma or .fatArrow or .openBrace or .openParen or .openBracket or
            .dot or .dotDot or .dotDotEquals or .question or .questionQuestion or
            .questionDot or .plus or .minus or .star or .slash or .percent or
            .plusPercent or .minusPercent or .starPercent or .plusBar or .minusBar or
            .starBar or .amp or .ampAmp or .bar or .barBar or .caret or
            .equalsEquals or .bangEquals or .less or .lessEquals or .greaterEquals or
            .lessLess or .andKeyword or .orKeyword or .isKeyword or .inKeyword or
            .equals or .plusEquals or .minusEquals or .starEquals or .slashEquals or
            .percentEquals or .ampEquals or .barEquals or .caretEquals or
            .lessLessEquals or .questionQuestionEquals:
            return true
        default:
            return false
    }
}

/// Whether the expression being parsed ends before the current token: it starts a new line, and is not waṣl or follows a blank line.
bool stopsHere(ref Parser p) =>
    breaksLine(ref p, at: p.pos) && (hasBlankLineBefore(ref p, at: p.pos) || !isWasl(ref p, at: p.pos))

/// Whether a statement ends before token `index`, for lookahead: a `;`, `}`, the end, or a line break.
bool endsBefore(ref Parser p, at i64 index) {
    let kind = p.kindAt(index)
    return kind == .semicolon || kind == .closeBrace || kind == .endOfFile || breaksLine(ref p, at: index)
}

// ── Line-join lint (BYN5103) ─────────────────────────────────────────────────

/// BYN5103, a warning: a waṣl line indented no deeper than the line its statement starts on. Reported by a
/// compilation and fixed by `bayan format`, not by `bayan parse`. Ports `LintLineJoins`.
public List<Diagnostic> lintLineJoins(ref Parser p) uses alloc {
    var lints = List<Diagnostic>()
    var opener = List<i64>()
    var open = List<i64>()
    for i in 0..p.count {
        opener.append(-1)
        switch p.kindAt(i) {
            case .openParen or .openBracket or .openBrace or .interpolationStart:
                open.append(i)
            case .closeParen or .closeBracket or .interpolationEnd or .closeBrace:
                if open.length > 0 {
                    opener[i] = open.removeLast()
                }
            default:
                continue
        }
    }
    // Each line's first token, and the first token of the line its statement starts on, filled forward: the statement
    // starts on the first line reached by stepping back over joined lines and bracketed groups, and every step goes back.
    var first = List<i64>()
    var statement = List<i64>()
    for i in 0..p.count {
        first.append(i > 0 && !p.lexed.tokens[i].hasNewlineBefore ? first[i - 1] : i)
        statement.append(i)
        continue if first[i] != i
        if opener[i] >= 0 {
            statement[i] = statement[first[opener[i]]]
        } else if i > 0 && joinsLineBefore(ref p, at: i) {
            statement[i] = statement[first[i - 1]]
        }
    }
    for i in 1..p.count {
        continue if !breaksLine(ref p, at: i) || hasBlankLineBefore(ref p, at: i) || !isWasl(ref p, at: i)
        // After lā the line above already continues; after `{` or `,` the line starts an entry (a statement, an arm).
        continue if afterLa(ref p, at: i)
        continue if p.kindAt(i) == .catchKeyword && p.kindAt(i - 1) == .closeBrace
        // At a field's indentation `requires` is a struct-level rule (O3, spec §2.5), so its indentation is meant.
        continue if p.kindAt(i) == .requiresKeyword
        let start = statement[first[i - 1]]
        let token = p.lexed.tokens[i]
        let indent = indentAt(ref p, at: token.start)
        let statementIndent = indentAt(ref p, at: p.lexed.tokens[start].start)
        continue if indent.length > statementIndent.length
        let line = p.lexed.source.getLineIndex(p.lexed.tokens[start].start) + 1
        let lineStart = p.lexed.source.getLineSpan(p.lexed.source.getLineIndex(token.start)).start
        lints.append(Diagnostic {
            code: "BYN5103",
            span: spanOf(token),
            message: $"a line starting with `{p.textOf(token)}` joins the statement above; indent it deeper",
            label: $"joins the statement on line {line}",
            help: "indent it deeper than the line its statement starts on",
            hasFix: true,
            fixSpan: TextSpan { start: lineStart, length: indent.length },
            fixReplacement: $"{statementIndent}    ",
        })
    }
    return lints
}

// ── Style lints (BYN1072–BYN1076) ────────────────────────────────────────────
// Reported by `bayan check` only, at the severity of the manifest's `lints` (compile.byn `styleLintsAt`). Each lint
// appends to `p.styleLints` through `reportStyleLint`; the parse functions call them where `Parser.cs` does.

// Parser.cs: MaxNesting, MaxFunctionLines
const maxNesting: i64       = 4
const maxFunctionLines: i64 = 60

/// The C# `_styleLints.Report`: a lint has a fix exactly when `fixSpan` is set.
void reportStyleLint(
    ref Parser p,
    for string code,
    at TextSpan span,
    by string message,
    string label = "",
    string help = "",
    TextSpan? fixSpan = null,
    string fixReplacement = ""
) {
    p.styleLints.append(
        styleLintOf(
            code,
            at: span,
            by: message,
            label: label,
            help: help,
            fixSpan: fixSpan,
            fixReplacement: fixReplacement,
        ),
    )
}

/// The diagnostic `reportStyleLint` appends; a typed lint (lints.byn) is made the same way and kept until the compilation confirms it.
Diagnostic styleLintOf(
    string code,
    at TextSpan span,
    by string message,
    string label = "",
    string help = "",
    TextSpan? fixSpan = null,
    string fixReplacement = ""
) {
    return Diagnostic {
        code: code,
        span: span,
        message: message,
        label: label,
        help: help,
        hasFix: fixSpan is not null,
        fixSpan: fixSpan ?? TextSpan { start: 0, length: 0 },
        fixReplacement: fixReplacement,
    }
}

/// BYN1072 on an `if` without `else` whose block holds only a `return`, `fail`, `break` or `continue`; the fix writes it
/// as a postfix guard. `span` is the `if` statement's span.
// Parser.cs: LintPostfixGuard
void lintPostfixGuard(
    ref Parser p,
    at TextSpan span,
    for Expr condition,
    by Stmt then,
    from Stmt otherwise,
    as Likelihood likelihood
) {
    return if !(otherwise is .none && likelihood == .none)
    var block = TextSpan { start: 0, length: 0 }
    switch then {
        case .blockStmt(let b):
            return if b.value.statements.length != 1
            switch b.value.statements[0] {
                case .returnStmt(_) or .failStmt(_) or .breakStmt(_) or .continueStmt(_):
                    block = b.value.span
                default:
                    return
            }
        default:
            return
    }
    return if block.length < 2
    // A break or continue has an empty span (its span is taken before its label is read), so the exit is read off the block's
    // text: inside the braces, trimmed, then without its trailing `;`s. Trivia is only spaces, tabs and line breaks (Lexer.cs).
    var from = block.start + 1
    var to = block.end - 1
    while from < to && isTriviaSpace(p.lexed.source.bytes[from]) {
        from += 1
    }
    while to > from && isTriviaSpace(p.lexed.source.bytes[to - 1]) {
        to -= 1
    }
    while to > from && p.lexed.source.bytes[to - 1] == ';' {
        to -= 1
    }
    while to > from && isTriviaSpace(p.lexed.source.bytes[to - 1]) {
        to -= 1
    }
    let body = p.lexed.source.getText(TextSpan.fromBounds(from, until: to))
    let text = p.lexed.source.getText(exprSpan(in condition))
    // A comment, a second statement or a line break in the block or the condition has no place in the one-line rewrite: no fix.
    let plain = !body.contains("\n") && !body.contains("/") && !body.contains(";") && !text.contains("\n")
    let at = TextSpan.fromBounds(span.start, until: block.start)
    let message = "an early exit in a block can be a postfix guard"
    if plain {
        reportStyleLint(
            ref p,
            for: "BYN1072",
            at: at,
            by: message,
            label: "an early exit in a block",
            help: "write it as a postfix guard",
            fixSpan: span,
            fixReplacement: $"{body} if {text}",
        )
    } else {
        reportStyleLint(
            ref p,
            for: "BYN1072",
            at: at,
            by: message,
            label: "an early exit in a block",
            help: "write it as a postfix guard",
        )
    }
}

/// A space, tab or line-break byte.
bool isTriviaSpace(u8 b) => b == ' ' || b == '\t' || b == '\r' || b == '\n'

/// BYN1073 on a lambda argument `x => x.f`; the fix writes `it.f`. `startIndex` is the lambda's first token.
// Parser.cs: LintItLambda
void lintItLambda(ref Parser p, at TextSpan span, for List<TextSpan> parameters, by Expr body, from i64 startIndex) {
    return if parameters.length != 1 || startIndex >= p.count || !p.argumentStarts[startIndex]
    let param = p.lexed.source.getText(parameters[0])
    return if param == "it"
    switch body {
        case .memberExpr(let m):
            return if m.value.nullConditional || m.value.typeArgs.length != 0
            switch m.value.target {
                case .nameExpr(let n):
                    return if n.value.typeArgs.length != 0 || p.lexed.source.getText(n.value.name) != param
                    let member = p.lexed.source.getText(m.value.member)
                    reportStyleLint(
                        ref p,
                        for: "BYN1073",
                        at: span,
                        by: $"`{param} => {param}.…` reads one member and can use `it`",
                        label: "reads one member of its parameter",
                        help: "write `it` for the parameter",
                        fixSpan: span,
                        fixReplacement: $"it.{member}",
                    )
                default:
                    return
            }
        default:
            return
    }
}

/// BYN1074 on a control head whose condition continues on a later line than the keyword at token `keywordIndex`.
// Parser.cs: LintWrappedCondition
void lintWrappedCondition(ref Parser p, from i64 keywordIndex, for Expr condition) {
    for i in (keywordIndex + 1)..p.pos {
        unless p.lexed.tokens[i].hasNewlineBefore {
            continue
        }
        reportStyleLint(
            ref p,
            for: "BYN1074",
            at: exprSpan(in condition),
            by: "this condition wraps; name it with a `let`",
            label: "the condition wraps",
            help: "name the condition with a `let`",
        )
        return
    }
}

/// BYN1075 at the `{` of a block opened more than 4 levels below its function's body; `parseBlock` counts the depth.
// Parser.cs: ParseBlock (its `_blockDepth` check)
void lintNestingDepth(ref Parser p, at Token open) {
    p.blockDepth += 1
    return if p.blockDepth != maxNesting + 1
    reportStyleLint(
        ref p,
        for: "BYN1075",
        at: spanOf(open),
        by: "blocks nested more than 4 deep; flatten them with early exits",
        label: $"nested more than {maxNesting} deep",
        help: "flatten it with early exits",
    )
}

/// BYN1076 on a function body of more than 60 lines between its braces.
// Parser.cs: LintFunctionLength
void lintFunctionLength(ref Parser p, at TextSpan body) {
    return if body.length == 0
    let lines = p.lexed.source.getLineIndex(body.end - 1) - p.lexed.source.getLineIndex(body.start) - 1
    return if lines <= maxFunctionLines
    reportStyleLint(
        ref p,
        for: "BYN1076",
        at: TextSpan { start: body.start, length: 1 },
        by: $"this function body is {lines} lines; split it into named steps",
        label: $"{lines} lines",
        help: "split it into named steps",
    )
}

/// Drops the fix of each style lint, typed or not, that would delete a comment (`dropsComment`); the lint stays.
// Parser.cs: KeepComments
public void keepComments(ref Parser p) uses alloc {
    for i in 0..p.styleLints.length {
        let lint = p.styleLints[i]
        p.styleLints[i] = keepingComments(ref p, for: lint)
    }
    for i in 0..p.typedLints.length {
        let lint = p.typedLints[i].lint
        p.typedLints[i].lint = keepingComments(ref p, for: lint)
        if (p.typedLints[i].otherwise is { } o) {
            p.typedLints[i].otherwise = keepingComments(ref p, for: o)
        }
    }
}

// Parser.cs: KeepingComments
Diagnostic keepingComments(ref Parser p, for Diagnostic lint) uses alloc {
    return lint if !lint.hasFix || !dropsComment(ref p, at: lint.fixSpan, by: lint.fixReplacement)
    return styleLintOf(lint.code, at: lint.span, by: lint.message, label: lint.label, help: lint.help)
}

/// Whether a comment lies whole inside the span a fix replaces, `span`, and the fix's `replacement` does not hold its text.
// Parser.cs: DropsComment
bool dropsComment(ref Parser p, at TextSpan span, by string replacement) uses alloc {
    var i = tokenAt(ref p, at: span.start)
    while i < p.count && (i == 0 ? 0 : p.lexed.tokens[i - 1].end) < span.end {
        // Between two tokens there is only whitespace and comments.
        let end = p.lexed.tokens[i].start
        var at = i == 0 ? 0 : p.lexed.tokens[i - 1].end
        while at + 1 < end {
            if p.lexed.source.bytes[at] != '/'
                    || (p.lexed.source.bytes[at + 1] != '/' && p.lexed.source.bytes[at + 1] != '*') {
                at += 1
                continue
            }
            var close = at + 2
            if p.lexed.source.bytes[at + 1] == '/' {
                while close < end && p.lexed.source.bytes[close] != '\n' {
                    close += 1
                }
            } else {
                while close + 1 < end
                        && !(p.lexed.source.bytes[close] == '*' && p.lexed.source.bytes[close + 1] == '/') {
                    close += 1
                }
                close = close + 2 < end ? close + 2 : end
            }
            return true if at >= span.start && close <= span.end
                && !replacement.contains(p.lexed.source.getText(TextSpan.fromBounds(at, until: close)))
            at = close
        }
        i += 1
    }
    return false
}

/// Whether token `index` continues the statement on the line before it.
bool joinsLineBefore(ref Parser p, at i64 index) =>
    !breaksLine(ref p, at: index) || !hasBlankLineBefore(ref p, at: index) && p.kindAt(index - 1) != .openBrace
    && lineContinues(ref p, at: index)

/// Whether the group opened at `open` has a `kind` token at its top level.
bool inGroup(ref Parser p, at i64 open, for TokenKind kind) {
    var depth = 0
    for i in open..p.count {
        let k = p.kindAt(i)
        return true if depth == 1 && k == kind
        switch k {
            case .openParen or .openBracket or .openBrace:
                depth += 1
            case .closeParen or .closeBracket or .closeBrace:
                depth -= 1
                return false if depth == 0
            case .endOfFile:
                return false
            default:
                continue
        }
    }
    return false
}

TextSpan expectName(ref Parser p, string what = "a name") {
    if isName(p.kind()) {
        let token = p.advance()
        let text = p.textOf(token)
        // SPEC §2.4: a C# primitive name is a type, never a declared name; a member after `.` only refers to one.
        // Not through `report`: the name parsed in full, so no recovery is needed.
        if isCSharpPrimitive(text) && (p.pos < 2 || p.kindAt(p.pos - 2) != .dot) {
            p.lexed.diagnostics.append(Diagnostic {
                code: codeText(.reservedKeyword),
                span: spanOf(token),
                message: format(messageFormat(.reservedKeyword), by: (a0: text, a1: "", a2: "")),
                label: "a C# primitive type name",
                help: "choose another name",
                hasFix: false,
                fixSpan: spanOf(token),
                fixReplacement: "",
            })
        }
        return spanOf(token)
    }
    let _ = p.report(.expected, at: spanOf(p.current()), arg0: what, arg1: p.describe(p.current()))
    return TextSpan { start: p.current().start, length: 0 }
}

TextSpan nameOf(Token token) => spanOf(token)

/// An identifier, or a declaration keyword used as a name (spec 004 R3).
bool isName(TokenKind kind) => kind == .identifier || isContextualKeyword(kind)

// ── Recovery ─────────────────────────────────────────────────────────────────

bool isStatementKeyword(TokenKind kind) => kind switch {
    .letKeyword or .varKeyword or .constKeyword or .ifKeyword or
        .unlessKeyword or .whileKeyword or .doKeyword or .forKeyword or
        .foreachKeyword or .switchKeyword or .returnKeyword or .failKeyword or .breakKeyword or
        .continueKeyword or .deferKeyword or .errdeferKeyword or .usingKeyword or
        .contextKeyword or .provideKeyword or .becomeKeyword or .structKeyword or .publicKeyword or .privateKeyword or
        .importKeyword or .errorKeyword or .testKeyword or .typeKeyword or
        .staticKeyword or .readonlyKeyword or .requiredKeyword or .uniqueKeyword or
        .externKeyword or .unsafeKeyword or .unionKeyword or .distinctKeyword => true,
    _ => false,
}

/// Skips to a plausible statement start: past a `;`, before a `}`, or at a line starting a statement.
void synchronize(ref Parser p) {
    var depth = 0
    var first = true
    while !p.atEnd() {
        let token = p.current()
        return if !first
            && depth == 0
            && token.hasNewlineBefore
            && (isStatementKeyword(token.kind) || token.kind == .identifier)
        first = false
        if token.kind == .semicolon && depth == 0 {
            let _ = p.advance()
            return
        } else if token.kind == .openBrace {
            depth += 1
        } else if token.kind == .closeBrace {
            return if depth == 0
            depth -= 1
            if depth == 0 {
                let _ = p.advance()
                return
            }
        }
        let _ = p.advance()
    }
}

/// After a syntax error inside a statement, skip only if the parser is not already at a clean restart point.
void recoverIfNeeded(ref Parser p, from i64 syntaxErrorsBefore) {
    return if p.syntaxErrors == syntaxErrorsBefore
    return if p.atEnd() || p.kind() == .closeBrace
    return if p.current().hasNewlineBefore && (isStatementKeyword(p.kind()) || p.kind() == .identifier)
    synchronize(ref p)
}

/// Withdraws the diagnostic at `index` (from `report`; -1 is the C# `null`) when a later fix over the
/// same span replaces it. `List` has no `removeAt`, so the entry becomes a tombstone (code `""`) that
/// `errorCount` skips and the dump drops (Q440). As in C#, neither `syntaxErrors` nor `lastErrorAt` changes.
void unreport(ref Parser p, at i64 index) {
    if index >= 0 {
        p.lexed.diagnostics[index].code = ""
    }
}

// ── Tables ───────────────────────────────────────────────────────────────────

/// `TokenKindFacts.IsContextualKeyword`: declaration-only keywords that are names wherever the grammar
/// does not need them as keywords.
public bool isContextualKeyword(TokenKind kind) => kind switch {
    .errorKeyword or .flagsKeyword or .unitKeyword or .distinctKeyword or
        .openKeyword or .extensibleKeyword or .setKeyword or .typeKeyword or
        .lawKeyword or .derivationKeyword or .attributeKeyword or .embedKeyword or
        .effectKeyword => true,
    _ => false,
}

/// `Keywords.IsCSharpPrimitive` (SPEC §2.4): reserved in every project so C# muscle memory cannot
/// declare a name that shadows a sized type.
bool isCSharpPrimitive(string text) => text switch {
    "sbyte" or "byte" or "short" or "ushort" or "int" or "uint" or "long" or "ulong" or "nint" or "nuint" or
        "float" or "double" => true,
    _ => false,
}

/// `ItName.Contains(text)`.
bool isItName(string text) => text == "it"

/// `Particles.Contains(text)`.
bool isParticle(string text) => text switch {
    "from" or "to" or "until" or "through" or "at" or "by" or "for" or "as" => true,
    _ => false,
}
== parser/spans.byn
// Span checks for L018: every node span lies within `[0, length]` and every child span within its
// parent's, one line per violation in the style of the lexer's `checkSpans`. New code, no C#
// counterpart. Owner:
//
// The walker visits every node kind of `nodes.byn` (a checklist against `Nodes.cs`): each struct's
// `span` is checked against the input and against its parent, then each child node is recursed and
// each child `TextSpan` is checked against its parent. A name, doc or decoded text has no span and
// is not checked. `decl`/`stmt`/`expr`/`type`/`pattern` are the five tree unions plus
// `interpolationPart`.
//
// Checklist, C# record → walker (every `nodes.byn` struct is visited):
//   CompilationUnit        checkSpans                     AttributeSyntax        walkAttribute
//   BecauseClause          enter at the site              RequiresRule           walkRequiresRule
//   Decl union             walkDecl                       ImportDecl/GlobalStatement/FunctionDecl/
//                          StructDecl/InterfaceDecl/GetterDecl/AssociatedTypeDecl/ExtensionDecl/
//                          FieldDecl/PropertyDecl/ConstructorDecl/ErrorEnumDecl/ErrorSetDecl/
//                          EnumDecl/UnionDecl/TypeAliasDecl/EffectDecl/TestDecl   (walkDecl)
//   Param                  walkParam                      FailsClause             walkFailsClause
//   UsesClause             walkUsesClause                 WhereClause             walkWhereClause
//   UnionField             walkUnionField                 UnionVariant            walkUnionVariant
//   ErrorVariant           walkErrorVariant               EnumMember              walkEnumMember
//   Argument               walkArgument                   SwitchLabel             walkSwitchLabel
//   SwitchSection          walkSwitchSection              NamedArg                walkNamedArg
//   FieldInit              walkFieldInit                  SwitchArm               walkSwitchArm
//   TupleTypeElement       walkTupleTypeElement           TupleElement            walkTupleElement
//   PropertySubpattern     walkPropertySubpattern         InterpolationPart       walkPart
//   TypeSyntax union       walkType                       NamedType/OptionalType/ArrayType/TupleType/
//                          FunctionTypeSyntax/DynType/RefinedType/PointerType    (walkType)
//   Stmt union             walkStmt                       all 24 variants        (walkStmt)
//   Expr union             walkExpr                       all 33 variants        (walkExpr)
//   Pattern union          walkPattern                    all 12 variants        (walkPattern)

/// Every node span through `[0, length]`.
void nodeSpan(TextSpan span, for string what, until i64 length, to ref StrBuf sb) {
    if !(span.start >= 0 && span.length >= 0 && span.end <= length) {
        sb.append($"span out of range: {what} {span.start}+{span.length}\n")
    }
}

/// Every child span through its parent span.
void childSpan(TextSpan child, for string what, through TextSpan parent, to ref StrBuf sb) {
    if !(child.start >= parent.start && child.end <= parent.end) {
        sb.append($"span out of range: {what} {child.start}+{child.length} outside {parent.start}+{parent.length}\n")
    }
}

/// A node's own span: through `[0, length]` and through its parent.
void enter(TextSpan span, for string what, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    nodeSpan(span, for: what, until: length, to: ref sb)
    childSpan(span, for: what, through: parent, to: ref sb)
}

/// Each span of `spans` through `parent`.
void childSpans(in List<TextSpan> spans, for string what, through TextSpan parent, to ref StrBuf sb) {
    for sp in spans {
        childSpan(sp, for: what, through: parent, to: ref sb)
    }
}

void checkSpans(in CompilationUnit unit, until i64 length, to ref StrBuf sb) {
    nodeSpan(unit.span, for: "compilationUnit", until: length, to: ref sb)
    for m in unit.members {
        walkDecl(in m, through: unit.span, until: length, to: ref sb)
    }
}

// ── Declarations ─────────────────────────────────────────────────────────────

void walkDecl(in Decl d, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    switch d {
        case .importDecl(let n):
            enter(n.value.span, for: "importDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpans(in n.value.path, for: "importDecl path", through: s, to: ref sb)
            if (n.value.alias is { } al) {
                childSpan(al, for: "importDecl alias", through: s, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .globalStatement(let n):
            enter(n.value.span, for: "globalStatement", through: parent, until: length, to: ref sb)
            walkStmt(in n.value.statement, through: n.value.span, until: length, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: n.value.span, until: length, to: ref sb)
            }
        case .functionDecl(let n):
            enter(n.value.span, for: "functionDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            walkType(in n.value.returnType, through: s, until: length, to: ref sb)
            childSpan(n.value.name, for: "functionDecl name", through: s, to: ref sb)
            for p in n.value.params {
                walkParam(in p, through: s, until: length, to: ref sb)
            }
            if (n.value.failsKeyword is { } f) {
                walkFailsClause(in f, through: s, until: length, to: ref sb)
            }
            walkStmt(in n.value.body, through: s, until: length, to: ref sb)
            walkExpr(in n.value.expressionBody, through: s, until: length, to: ref sb)
            childSpans(in n.value.typeParams, for: "functionDecl typeParams", through: s, to: ref sb)
            if (n.value.refThis is { } r) {
                childSpan(r, for: "functionDecl refThis", through: s, to: ref sb)
            }
            if (n.value.moveThis is { } m) {
                childSpan(m, for: "functionDecl moveThis", through: s, to: ref sb)
            }
            childSpans(in n.value.receiverStates, for: "functionDecl receiverStates", through: s, to: ref sb)
            for e in n.value.requiresClauses {
                walkExpr(in e, through: s, until: length, to: ref sb)
            }
            for w in n.value.where {
                walkWhereClause(in w, through: s, until: length, to: ref sb)
            }
            if (n.value.becomes is { } b) {
                childSpan(b, for: "functionDecl becomes", through: s, to: ref sb)
            }
            if (n.value.usesKeyword is { } u) {
                walkUsesClause(in u, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .structDecl(let n):
            enter(n.value.span, for: "structDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "structDecl name", through: s, to: ref sb)
            for m in n.value.members {
                walkDecl(in m, through: s, until: length, to: ref sb)
            }
            childSpans(in n.value.typeParams, for: "structDecl typeParams", through: s, to: ref sb)
            for b in n.value.bases {
                walkType(in b, through: s, until: length, to: ref sb)
            }
            for w in n.value.where {
                walkWhereClause(in w, through: s, until: length, to: ref sb)
            }
            for r in n.value.rules {
                walkRequiresRule(in r, through: s, until: length, to: ref sb)
            }
            for v in n.value.states {
                walkUnionVariant(in v, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .interfaceDecl(let n):
            enter(n.value.span, for: "interfaceDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "interfaceDecl name", through: s, to: ref sb)
            for m in n.value.members {
                walkDecl(in m, through: s, until: length, to: ref sb)
            }
            childSpans(in n.value.typeParams, for: "interfaceDecl typeParams", through: s, to: ref sb)
            for w in n.value.where {
                walkWhereClause(in w, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .getterDecl(let n):
            enter(n.value.span, for: "getterDecl", through: parent, until: length, to: ref sb)
            walkType(in n.value.type, through: n.value.span, until: length, to: ref sb)
            childSpan(n.value.name, for: "getterDecl name", through: n.value.span, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: n.value.span, until: length, to: ref sb)
            }
        case .associatedTypeDecl(let n):
            enter(n.value.span, for: "associatedTypeDecl", through: parent, until: length, to: ref sb)
            childSpan(n.value.name, for: "associatedTypeDecl name", through: n.value.span, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: n.value.span, until: length, to: ref sb)
            }
        case .extensionDecl(let n):
            enter(n.value.span, for: "extensionDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "extensionDecl name", through: s, to: ref sb)
            for b in n.value.bases {
                walkType(in b, through: s, until: length, to: ref sb)
            }
            for m in n.value.members {
                walkDecl(in m, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .fieldDecl(let n):
            enter(n.value.span, for: "fieldDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            walkType(in n.value.type, through: s, until: length, to: ref sb)
            childSpan(n.value.name, for: "fieldDecl name", through: s, to: ref sb)
            walkExpr(in n.value.defaultKeyword, through: s, until: length, to: ref sb)
            for r in n.value.requiresClauses {
                walkRequiresRule(in r, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .propertyDecl(let n):
            enter(n.value.span, for: "propertyDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            walkType(in n.value.type, through: s, until: length, to: ref sb)
            childSpan(n.value.name, for: "propertyDecl name", through: s, to: ref sb)
            walkExpr(in n.value.body, through: s, until: length, to: ref sb)
            walkStmt(in n.value.block, through: s, until: length, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .constructorDecl(let n):
            enter(n.value.span, for: "constructorDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "constructorDecl name", through: s, to: ref sb)
            for p in n.value.params {
                walkParam(in p, through: s, until: length, to: ref sb)
            }
            walkStmt(in n.value.body, through: s, until: length, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .errorEnumDecl(let n):
            enter(n.value.span, for: "errorEnumDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "errorEnumDecl name", through: s, to: ref sb)
            for v in n.value.variants {
                walkErrorVariant(in v, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .errorSetDecl(let n):
            enter(n.value.span, for: "errorSetDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "errorSetDecl name", through: s, to: ref sb)
            for t in n.value.members {
                walkType(in t, through: s, until: length, to: ref sb)
            }
            childSpan(n.value.head, for: "errorSetDecl head", through: s, to: ref sb)
            childSpans(in n.value.exceptNames, for: "errorSetDecl except", through: s, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .enumDecl(let n):
            enter(n.value.span, for: "enumDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "enumDecl name", through: s, to: ref sb)
            if (n.value.params is { } ps) {
                for p in ps {
                    walkParam(in p, through: s, until: length, to: ref sb)
                }
            }
            for m in n.value.members {
                walkEnumMember(in m, through: s, until: length, to: ref sb)
            }
            for b in n.value.bases {
                walkType(in b, through: s, until: length, to: ref sb)
            }
            for w in n.value.where {
                walkWhereClause(in w, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .unionDecl(let n):
            enter(n.value.span, for: "unionDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "unionDecl name", through: s, to: ref sb)
            for v in n.value.variants {
                walkUnionVariant(in v, through: s, until: length, to: ref sb)
            }
            childSpans(in n.value.typeParams, for: "unionDecl typeParams", through: s, to: ref sb)
            for b in n.value.bases {
                walkType(in b, through: s, until: length, to: ref sb)
            }
            for w in n.value.where {
                walkWhereClause(in w, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .typeAliasDecl(let n):
            enter(n.value.span, for: "typeAliasDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            childSpan(n.value.name, for: "typeAliasDecl name", through: s, to: ref sb)
            walkType(in n.value.target, through: s, until: length, to: ref sb)
            for r in n.value.requiresClauses {
                walkRequiresRule(in r, through: s, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .effectDecl(let n):
            enter(n.value.span, for: "effectDecl", through: parent, until: length, to: ref sb)
            childSpan(n.value.name, for: "effectDecl name", through: n.value.span, to: ref sb)
            childSpans(in n.value.effects, for: "effectDecl effects", through: n.value.span, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: n.value.span, until: length, to: ref sb)
            }
        case .testDecl(let n):
            enter(n.value.span, for: "testDecl", through: parent, until: length, to: ref sb)
            let s = n.value.span
            for p in n.value.params {
                walkParam(in p, through: s, until: length, to: ref sb)
            }
            walkStmt(in n.value.body, through: s, until: length, to: ref sb)
            for a in n.value.attributes {
                walkAttribute(in a, through: s, until: length, to: ref sb)
            }
        case .none:
    }
}

// ── Support records ──────────────────────────────────────────────────────────

void walkAttribute(in AttributeSyntax a, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(a.span, for: "attributeSyntax", through: parent, until: length, to: ref sb)
    childSpan(a.name, for: "attributeSyntax name", through: a.span, to: ref sb)
    for arg in a.args {
        walkArgument(in arg, through: a.span, until: length, to: ref sb)
    }
    if (a.becauseKeyword is { } bc) {
        enter(bc.span, for: "becauseClause", through: a.span, until: length, to: ref sb)
    }
}

void walkRequiresRule(in RequiresRule r, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(r.span, for: "requiresRule", through: parent, until: length, to: ref sb)
    walkExpr(in r.condition, through: r.span, until: length, to: ref sb)
    if (r.at is { } at) {
        childSpan(at, for: "requiresRule at", through: r.span, to: ref sb)
    }
}

void walkParam(in Param p, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(p.span, for: "param", through: parent, until: length, to: ref sb)
    walkType(in p.type, through: p.span, until: length, to: ref sb)
    childSpan(p.name, for: "param name", through: p.span, to: ref sb)
    walkExpr(in p.defaultKeyword, through: p.span, until: length, to: ref sb)
    if (p.particle is { } pa) {
        childSpan(pa, for: "param particle", through: p.span, to: ref sb)
    }
}

void walkFailsClause(in FailsClause f, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(f.span, for: "failsClause", through: parent, until: length, to: ref sb)
    for t in f.errors {
        walkType(in t, through: f.span, until: length, to: ref sb)
    }
}

void walkUsesClause(in UsesClause u, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(u.span, for: "usesClause", through: parent, until: length, to: ref sb)
    childSpans(in u.effects, for: "usesClause effects", through: u.span, to: ref sb)
}

void walkWhereClause(in WhereClause w, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(w.span, for: "whereClause", through: parent, until: length, to: ref sb)
    childSpan(w.param, for: "whereClause param", through: w.span, to: ref sb)
    for b in w.bounds {
        walkType(in b, through: w.span, until: length, to: ref sb)
    }
}

void walkUnionField(in UnionField u, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(u.span, for: "unionField", through: parent, until: length, to: ref sb)
    walkType(in u.type, through: u.span, until: length, to: ref sb)
    childSpan(u.name, for: "unionField name", through: u.span, to: ref sb)
}

void walkUnionVariant(in UnionVariant v, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(v.span, for: "unionVariant", through: parent, until: length, to: ref sb)
    childSpan(v.name, for: "unionVariant name", through: v.span, to: ref sb)
    for f in v.fields {
        walkUnionField(in f, through: v.span, until: length, to: ref sb)
    }
    walkExpr(in v.value, through: v.span, until: length, to: ref sb)
}

void walkErrorVariant(in ErrorVariant v, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(v.span, for: "errorVariant", through: parent, until: length, to: ref sb)
    childSpan(v.name, for: "errorVariant name", through: v.span, to: ref sb)
    for a in v.attributes {
        walkAttribute(in a, through: v.span, until: length, to: ref sb)
    }
    for f in v.fields {
        walkUnionField(in f, through: v.span, until: length, to: ref sb)
    }
}

void walkEnumMember(in EnumMember m, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(m.span, for: "enumMember", through: parent, until: length, to: ref sb)
    childSpan(m.name, for: "enumMember name", through: m.span, to: ref sb)
    if (m.args is { } args) {
        for a in args {
            walkArgument(in a, through: m.span, until: length, to: ref sb)
        }
    }
}

void walkArgument(in Argument a, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(a.span, for: "argument", through: parent, until: length, to: ref sb)
    if (a.name is { } nm) {
        childSpan(nm, for: "argument name", through: a.span, to: ref sb)
    }
    walkExpr(in a.value, through: a.span, until: length, to: ref sb)
}

void walkSwitchLabel(in SwitchLabel l, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(l.span, for: "switchLabel", through: parent, until: length, to: ref sb)
    walkPattern(in l.pattern, through: l.span, until: length, to: ref sb)
    walkExpr(in l.guard, through: l.span, until: length, to: ref sb)
}

void walkSwitchSection(in SwitchSection s, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(s.span, for: "switchSection", through: parent, until: length, to: ref sb)
    walkSwitchLabel(in s.label, through: s.span, until: length, to: ref sb)
    for st in s.statements {
        walkStmt(in st, through: s.span, until: length, to: ref sb)
    }
}

void walkNamedArg(in NamedArg a, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(a.span, for: "namedArg", through: parent, until: length, to: ref sb)
    childSpan(a.name, for: "namedArg name", through: a.span, to: ref sb)
    walkExpr(in a.value, through: a.span, until: length, to: ref sb)
}

void walkFieldInit(in FieldInit f, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(f.span, for: "fieldInit", through: parent, until: length, to: ref sb)
    childSpan(f.name, for: "fieldInit name", through: f.span, to: ref sb)
    walkExpr(in f.value, through: f.span, until: length, to: ref sb)
}

void walkSwitchArm(in SwitchArm a, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(a.span, for: "switchArm", through: parent, until: length, to: ref sb)
    walkPattern(in a.pattern, through: a.span, until: length, to: ref sb)
    walkExpr(in a.guard, through: a.span, until: length, to: ref sb)
    walkExpr(in a.value, through: a.span, until: length, to: ref sb)
}

void walkTupleTypeElement(in TupleTypeElement e, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(e.span, for: "tupleTypeElement", through: parent, until: length, to: ref sb)
    walkType(in e.type, through: e.span, until: length, to: ref sb)
    if (e.name is { } nm) {
        childSpan(nm, for: "tupleTypeElement name", through: e.span, to: ref sb)
    }
}

void walkTupleElement(in TupleElement e, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(e.span, for: "tupleElement", through: parent, until: length, to: ref sb)
    if (e.name is { } nm) {
        childSpan(nm, for: "tupleElement name", through: e.span, to: ref sb)
    }
    walkExpr(in e.value, through: e.span, until: length, to: ref sb)
}

void walkPropertySubpattern(in PropertySubpattern s, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    enter(s.span, for: "propertySubpattern", through: parent, until: length, to: ref sb)
    childSpans(in s.path, for: "propertySubpattern path", through: s.span, to: ref sb)
    walkPattern(in s.pattern, through: s.span, until: length, to: ref sb)
}

// ── Types ────────────────────────────────────────────────────────────────────

void walkType(in TypeSyntax t, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    switch t {
        case .namedType(let n):
            enter(n.value.span, for: "namedType", through: parent, until: length, to: ref sb)
            childSpans(in n.value.path, for: "namedType path", through: n.value.span, to: ref sb)
            for a in n.value.args {
                walkType(in a, through: n.value.span, until: length, to: ref sb)
            }
        case .optionalType(let n):
            enter(n.value.span, for: "optionalType", through: parent, until: length, to: ref sb)
            walkType(in n.value.inner, through: n.value.span, until: length, to: ref sb)
        case .arrayType(let n):
            enter(n.value.span, for: "arrayType", through: parent, until: length, to: ref sb)
            walkType(in n.value.element, through: n.value.span, until: length, to: ref sb)
            walkExpr(in n.value.size, through: n.value.span, until: length, to: ref sb)
        case .tupleType(let n):
            enter(n.value.span, for: "tupleType", through: parent, until: length, to: ref sb)
            for e in n.value.elements {
                walkTupleTypeElement(in e, through: n.value.span, until: length, to: ref sb)
            }
        case .functionTypeSyntax(let n):
            enter(n.value.span, for: "functionTypeSyntax", through: parent, until: length, to: ref sb)
            for tp in n.value.params {
                walkType(in tp, through: n.value.span, until: length, to: ref sb)
            }
            walkType(in n.value.returnKeyword, through: n.value.span, until: length, to: ref sb)
            if (n.value.failsKeyword is { } f) {
                walkFailsClause(in f, through: n.value.span, until: length, to: ref sb)
            }
            if (n.value.usesKeyword is { } u) {
                walkUsesClause(in u, through: n.value.span, until: length, to: ref sb)
            }
        case .dynType(let n):
            enter(n.value.span, for: "dynType", through: parent, until: length, to: ref sb)
            walkType(in n.value.inner, through: n.value.span, until: length, to: ref sb)
        case .refinedType(let n):
            enter(n.value.span, for: "refinedType", through: parent, until: length, to: ref sb)
            walkType(in n.value.inner, through: n.value.span, until: length, to: ref sb)
            childSpans(in n.value.states, for: "refinedType states", through: n.value.span, to: ref sb)
        case .pointerType(let n):
            enter(n.value.span, for: "pointerType", through: parent, until: length, to: ref sb)
            walkType(in n.value.pointee, through: n.value.span, until: length, to: ref sb)
        case .none:
    }
}

// ── Statements ───────────────────────────────────────────────────────────────

void walkStmt(in Stmt s, through TextSpan parent, until i64 length, to ref StrBuf sb) {
    switch s {
        case .blockStmt(let n):
            enter(n.value.span, for: "blockStmt", through: parent, until: length, to: ref sb)
            for st in n.value.statements {
                walkStmt(in st, through: n.value.span, until: length, to: ref sb)
            }
            for a in n.value.attributes {
                walkAttribute(in a, through: n.value.span, until: length, to: ref sb)
            }
        case .localDecl(let n):
            enter(n.value.span, for: "localDecl", through: parent, until: length, to: ref sb)
            walkType(in n.value.type, through: n.value.span, until: length, to: ref sb)
