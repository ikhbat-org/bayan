public BExpr addMethodGroup(ref Ctx c, from move BMethodGroup n) uses alloc {
    c.bMethodGroups.append(move n)
    return makeBound(.methodGroup, at: c.bMethodGroups.length - 1)
}

public BExpr addVariantGroup(ref Ctx c, from move BVariantGroup n) uses alloc {
    c.bVariantGroups.append(move n)
    return makeBound(.variantGroup, at: c.bVariantGroups.length - 1)
}

public BExpr addBuiltinGroup(ref Ctx c, from move BBuiltinGroup n) uses alloc {
    c.bBuiltinGroups.append(move n)
    return makeBound(.builtinGroup, at: c.bBuiltinGroups.length - 1)
}

// ── Base-class members ───────────────────────────────────────────────────────

/// C# `BoundExpr.Type`.
public Type exprType(in Ctx c, for BExpr e) {
    let i = boundIndex(e)
    switch boundKind(e) {
        case .literal: return c.bLiterals[i].type
        case .symbolLiteral: return builtinType(.symbol)
        case .hostTarget: return prim(.string)
        case .defaultValue: return c.bDefaults[i].type
        case .local: return c.bLocals[i].type
        case .thisRef: return c.bThises[i].type
        case .field: return c.bFields[i].type
        case .tupleElement: return c.bTupleElements[i].type
        case .call: return c.bCalls[i].type
        case .builtinCall: return c.bBuiltinCalls[i].type
        case .unary: return c.bUnaries[i].type
        case .binary: return c.bBinaries[i].type
        case .conversion: return c.bConversions[i].type
        case .tryFrom: return c.bTryFroms[i].type
        case .conditional: return c.bConditionals[i].type
        case .coalesce: return c.bCoalesces[i].type
        case .structLiteral: return c.bStructLiterals[i].type
        case .withExpr: return c.bWiths[i].type
        case .tuple: return c.bTuples[i].tupleType
        case .collection: return c.bCollections[i].type
        case .spread: return c.bSpreads[i].type
        case .index: return c.bIndexes[i].type
        case .slice: return c.bSlices[i].type
        case .range: return c.bRanges[i].type
        case .isExpr: return prim(.bool)
        case .switchExpr: return c.bSwitchExprs[i].type
        case .interpolated: return prim(.string)
        case .moveExpr: return c.bMoves[i].type
        case .tryExpr: return c.bTries[i].type
        case .catchExpr: return c.bCatches[i].type
        case .jump: return prim(.neverKind)
        case .blockExpr: return c.bBlockExprs[i].type
        case .errorVariant: return c.bErrorVariants[i].type
        case .enumMember: return c.bEnumMembers[i].type
        case .unionNew: return c.bUnionNews[i].type
        case .enumValues: return c.bEnumValues[i].type
        case .staticArray: return c.bStaticArrays[i].type
        case .stackalloc: return c.bStackallocs[i].type
        case .errorExpr: return errorType()
        case .typeRef: return errorType()
        case .moduleRef: return errorType()
        case .lambda: return c.bLambdas[i].functionType
        case .functionRef: return c.bFunctionRefs[i].functionType
        case .unionField: return c.bUnionFields[i].type
        case .errorField: return c.bErrorFields[i].type
        case .methodGroup: return errorType()
        case .variantGroup: return errorType()
        case .builtinGroup: return errorType()
        default: return errorType()
    }
}

/// C# `BoundNode.Syntax.Span`.
public TextSpan nodeSpan(in Ctx c, for BNode n) {
    let i = boundIndex(n)
    switch boundKind(n) {
        case .literal: return c.bLiterals[i].span
        case .symbolLiteral: return c.bSymbolLiterals[i].span
        case .hostTarget: return c.bHostTargets[i].span
        case .defaultValue: return c.bDefaults[i].span
        case .local: return c.bLocals[i].span
        case .thisRef: return c.bThises[i].span
        case .field: return c.bFields[i].span
        case .tupleElement: return c.bTupleElements[i].span
        case .call: return c.bCalls[i].span
        case .builtinCall: return c.bBuiltinCalls[i].span
        case .unary: return c.bUnaries[i].span
        case .binary: return c.bBinaries[i].span
        case .conversion: return c.bConversions[i].span
        case .tryFrom: return c.bTryFroms[i].span
        case .conditional: return c.bConditionals[i].span
        case .coalesce: return c.bCoalesces[i].span
        case .structLiteral: return c.bStructLiterals[i].span
        case .withExpr: return c.bWiths[i].span
        case .tuple: return c.bTuples[i].span
        case .collection: return c.bCollections[i].span
        case .spread: return c.bSpreads[i].span
        case .index: return c.bIndexes[i].span
        case .slice: return c.bSlices[i].span
        case .range: return c.bRanges[i].span
        case .isExpr: return c.bIses[i].span
        case .switchExpr: return c.bSwitchExprs[i].span
        case .interpolated: return c.bInterpolateds[i].span
        case .moveExpr: return c.bMoves[i].span
        case .tryExpr: return c.bTries[i].span
        case .catchExpr: return c.bCatches[i].span
        case .jump: return c.bJumps[i].span
        case .blockExpr: return c.bBlockExprs[i].span
        case .errorVariant: return c.bErrorVariants[i].span
        case .enumMember: return c.bEnumMembers[i].span
        case .unionNew: return c.bUnionNews[i].span
        case .enumValues: return c.bEnumValues[i].span
        case .staticArray: return c.bStaticArrays[i].span
        case .stackalloc: return c.bStackallocs[i].span
        case .errorExpr: return c.bErrorExprs[i].span
        case .typeRef: return c.bTypeRefs[i].span
        case .moduleRef: return c.bModuleRefs[i].span
        case .lambda: return c.bLambdas[i].span
        case .functionRef: return c.bFunctionRefs[i].span
        case .block: return c.bBlocks[i].span
        case .localDecl: return c.bLocalDecls[i].span
        case .exprStmt: return c.bExprStmts[i].span
        case .assign: return c.bAssigns[i].span
        case .returnStmt: return c.bReturns[i].span
        case .failStmt: return c.bFails[i].span
        case .becomeStmt: return c.bBecomes[i].span
        case .breakStmt: return c.bBreaks[i].span
        case .continueStmt: return c.bContinues[i].span
        case .ifStmt: return c.bIfs[i].span
        case .whileStmt: return c.bWhiles[i].span
        case .doWhile: return c.bDoWhiles[i].span
        case .forStmt: return c.bFors[i].span
        case .switchStmt: return c.bSwitches[i].span
        case .deferStmt: return c.bDefers[i].span
        case .assertStmt: return c.bAsserts[i].span
        case .errdeferStmt: return c.bErrdefers[i].span
        case .panicDefer: return c.bPanicDefers[i].span
        case .setOnPanic: return c.bSetOnPanics[i].span
        case .contextStmt: return c.bContexts[i].span
        case .errorStmt: return c.bErrorStmts[i].span
        case .constantPattern: return c.bConstantPatterns[i].span
        case .relationalPattern: return c.bRelationalPatterns[i].span
        case .rangePattern: return c.bRangePatterns[i].span
        case .bindPattern: return c.bBindPatterns[i].span
        case .notPattern: return c.bNotPatterns[i].span
        case .binaryPattern: return c.bBinaryPatterns[i].span
        case .propertyPattern: return c.bPropertyPatterns[i].span
        case .unionField: return c.bUnionFields[i].span
        case .unionPattern: return c.bUnionPatterns[i].span
        case .errorField: return c.bErrorFields[i].span
        case .errorPattern: return c.bErrorPatterns[i].span
        case .methodGroup: return c.bMethodGroups[i].span
        case .variantGroup: return c.bVariantGroups[i].span
        case .builtinGroup: return c.bBuiltinGroups[i].span
    }
}

/// C# `BoundPattern.InputType`.
public Type patternInput(in Ctx c, for BPattern p) {
    let i = boundIndex(p)
    switch boundKind(p) {
        case .constantPattern: return c.bConstantPatterns[i].inputType
        case .relationalPattern: return c.bRelationalPatterns[i].inputType
        case .rangePattern: return c.bRangePatterns[i].inputType
        case .bindPattern: return c.bBindPatterns[i].inputType
        case .notPattern: return c.bNotPatterns[i].inputType
        case .binaryPattern: return c.bBinaryPatterns[i].inputType
        case .propertyPattern: return c.bPropertyPatterns[i].inputType
        case .unionPattern: return c.bUnionPatterns[i].inputType
        case .errorPattern: return c.bErrorPatterns[i].inputType
        default: return errorType()
    }
}

// ── Walk ─────────────────────────────────────────────────────────────────────

/// C# `BoundTree.Children`: the direct children of a node, in evaluation order.
public List<BNode> children(in Ctx c, for BNode n) uses alloc {
    var result = List<BNode>()
    let i = boundIndex(n)
    switch boundKind(n) {
        case .field:
            result.append(c.bFields[i].receiver)
        case .tupleElement:
            result.append(c.bTupleElements[i].receiver)
        case .unionField:
            result.append(c.bUnionFields[i].receiver)
        case .errorField:
            result.append(c.bErrorFields[i].receiver)
        case .call:
            if c.bCalls[i].receiver != -1 {
                result.append(c.bCalls[i].receiver)
            }
            for x in c.bCalls[i].arguments {
                result.append(x)
            }
        case .builtinCall:
            result.append(c.bBuiltinCalls[i].receiver)
            for x in c.bBuiltinCalls[i].arguments {
                result.append(x)
            }
        case .unary:
            result.append(c.bUnaries[i].operand)
        case .binary:
            result.append(c.bBinaries[i].left)
            result.append(c.bBinaries[i].right)
        case .conversion:
            result.append(c.bConversions[i].operand)
        case .tryFrom:
            result.append(c.bTryFroms[i].operand)
        case .conditional:
            result.append(c.bConditionals[i].condition)
            result.append(c.bConditionals[i].whenTrue)
            result.append(c.bConditionals[i].whenFalse)
        case .coalesce:
            result.append(c.bCoalesces[i].left)
            result.append(c.bCoalesces[i].right)
        case .structLiteral:
            for x in c.bStructLiterals[i].fields {
                result.append(x)
            }
            for x in c.bStructLiterals[i].payload {
                result.append(x)
            }
        case .unionNew:
            for x in c.bUnionNews[i].payload {
                result.append(x)
            }
        case .errorVariant:
            for x in c.bErrorVariants[i].payload {
                result.append(x)
            }
        case .withExpr:
            result.append(c.bWiths[i].target)
            for u in c.bWiths[i].updates {
                result.append(u.value)
            }
        case .tuple:
            for x in c.bTuples[i].elements {
                result.append(x)
            }
        case .collection:
            for x in c.bCollections[i].elements {
                result.append(x)
            }
        case .spread:
            result.append(c.bSpreads[i].operand)
        case .index:
            result.append(c.bIndexes[i].target)
            result.append(c.bIndexes[i].index)
        case .slice:
            result.append(c.bSlices[i].target)
            if c.bSlices[i].start != -1 {
                result.append(c.bSlices[i].start)
            }
            if c.bSlices[i].end != -1 {
                result.append(c.bSlices[i].end)
            }
        case .range:
            result.append(c.bRanges[i].start)
            result.append(c.bRanges[i].end)
        case .isExpr:
            result.append(c.bIses[i].value)
            result.append(c.bIses[i].pattern)
        case .switchExpr:
            result.append(c.bSwitchExprs[i].value)
            for a in c.bSwitchExprs[i].arms {
                result.append(a.pattern)
                if a.guard != -1 {
                    result.append(a.guard)
                }
                result.append(a.value)
            }
        case .interpolated:
            for p in c.bInterpolateds[i].parts {
                if p.value != -1 {
                    result.append(p.value)
                }
            }
        case .tryExpr:
            result.append(c.bTries[i].operand)
        case .moveExpr:
            result.append(c.bMoves[i].operand)
        case .catchExpr:
            result.append(c.bCatches[i].operand)
            result.append(c.bCatches[i].handler)
        case .jump:
            result.append(c.bJumps[i].jump)
        case .blockExpr:
            result.append(c.bBlockExprs[i].block)
        case .lambda:
            for x in c.bLambdas[i].captures {
                result.append(x)
            }
        case .block:
            for x in c.bBlocks[i].statements {
                result.append(x)
            }
        case .localDecl:
            if c.bLocalDecls[i].initializer != -1 {
                result.append(c.bLocalDecls[i].initializer)
            }
        case .exprStmt:
            result.append(c.bExprStmts[i].expr)
        case .assertStmt:
            result.append(c.bAsserts[i].condition)
        case .assign:
            result.append(c.bAssigns[i].target)
            result.append(c.bAssigns[i].value)
        case .returnStmt:
            if c.bReturns[i].value != -1 {
                result.append(c.bReturns[i].value)
            }
        case .failStmt:
            result.append(c.bFails[i].error)
        case .becomeStmt:
            for x in c.bBecomes[i].payload {
                result.append(x)
            }
        case .ifStmt:
            result.append(c.bIfs[i].condition)
            result.append(c.bIfs[i].then)
            if c.bIfs[i].elseBranch != -1 {
                result.append(c.bIfs[i].elseBranch)
            }
        case .whileStmt:
            result.append(c.bWhiles[i].condition)
            result.append(c.bWhiles[i].body)
        case .doWhile:
            result.append(c.bDoWhiles[i].body)
            result.append(c.bDoWhiles[i].condition)
        case .forStmt:
            result.append(c.bFors[i].iterable)
            result.append(c.bFors[i].body)
        case .switchStmt:
            result.append(c.bSwitches[i].value)
            for s in c.bSwitches[i].sections {
                if s.pattern != -1 {
                    result.append(s.pattern)
                }
                if s.guard != -1 {
                    result.append(s.guard)
                }
                for b in s.body {
                    result.append(b)
                }
            }
        case .deferStmt:
            result.append(c.bDefers[i].body)
        case .errdeferStmt:
            result.append(c.bErrdefers[i].body)
        case .panicDefer:
            result.append(c.bPanicDefers[i].body)
        case .contextStmt:
            result.append(c.bContexts[i].allocator)
            result.append(c.bContexts[i].body)
        case .constantPattern:
            result.append(c.bConstantPatterns[i].value)
        case .relationalPattern:
            result.append(c.bRelationalPatterns[i].value)
        case .rangePattern:
            result.append(c.bRangePatterns[i].start)
            result.append(c.bRangePatterns[i].end)
        case .notPattern:
            result.append(c.bNotPatterns[i].operand)
        case .binaryPattern:
            result.append(c.bBinaryPatterns[i].left)
            result.append(c.bBinaryPatterns[i].right)
        case .propertyPattern:
            for s in c.bPropertyPatterns[i].subpatterns {
                result.append(s.pattern)
            }
        case .unionPattern:
            for x in c.bUnionPatterns[i].subpatterns {
                result.append(x)
            }
        case .errorPattern:
            for x in c.bErrorPatterns[i].subpatterns {
                result.append(x)
            }
        default:
            return result
    }
    return result
}

/// C# `BoundTree.Descendants`: the node and everything below it, pre-order.
public List<BNode> descendants(in Ctx c, for BNode n) uses alloc {
    var result = List<BNode>()
    var stack = List<BNode>()
    stack.append(n)
    while stack.length > 0 {
        let m = stack.removeLast()
        result.append(m)
        let ch = children(in c, for: m)
        var j = ch.length - 1
        while j >= 0 {
            stack.append(ch[j])
            j -= 1
        }
    }
    return result
}
== semantics/builtins.byn
// T9: Builtins.cs and Binding/BuiltinMembers.cs.
//
// The C# `Builtins` object is built once per `Compilation`; `Ctx` has no field for it (frozen after
// T4), so the first lookup appends a `"builtin"` module to `c.modules` and builds everything into it
// in the C# constructor's order (Q560). Its types are in the module's `types` map by name, its
// functions in `functions` under a key (`"print"`, `"Io.readFile"`, `"parse.i32"`, …). Each
// `"<builtin>"` source is parsed and kept as a `SourceFile` whose `module` is the builtin module,
// so the declare pass reads its variants and members like any other file's.

import lexer
import parser

// One parameter of a builtin method: the C# `(string Name, TypeSymbol Type)` pair.
struct BuiltinParameter {
    string name
    Type   type
}

// The C# `BuiltinMethod` record.
struct BuiltinMethod {
    BuiltinMember member
    List<BuiltinParameter> parameters
    Type returns
    bool mutating = false
    i64  optional = 0
}

// The C# `(BuiltinMember Member, TypeSymbol Type)` tuple `Property` returns.
struct PropertyResult {
    BuiltinMember member
    Type type
}

// ── Builtins.cs ──────────────────────────────────────────────────────────────

const streamSource: string = "public enum Stream {\n    stdout,\n    stderr,\n}"

const radixSource: string = "public enum Radix {\n    binary,\n    octal,\n    decimal,\n    hex,\n}"

const edgeSource: string = "public enum Edge {\n    start,\n    end,\n}"

const alignSource: string = "public enum Align {\n    start,\n    end,\n    center,\n}"

const comparisonSource: string = "public enum Comparison {\n    ordinal,\n    caseless,\n}"

const logLevelSource: string = "public enum LogLevel {\n    debug,\n    info,\n    warn,\n    error,\n}"

const iterationSource: string = "public interface IEnumerator {\n    type Item;\n    bool moveNext(ref this);\n    Item current { get; }\n}\n\npublic interface IIndexable {\n    type Item;\n    i64 count { get; }\n    Item get(i64 index);\n}"

const utf8ErrorSource: string = "public union error Utf8Error {\n    /// The bytes are not well-formed UTF-8.\n    invalidSequence(i64 at),\n}"

const parseErrorSource: string = "public union error ParseError {\n    /// The text has no digit, or a character that is not a digit, at this byte offset.\n    badDigit(i64 at),\n    /// The number does not fit the type.\n    overflow,\n}"

const utf8InvalidSource: string = "public enum Utf8Invalid {\n    replace,\n}"

const validationErrorSource: string = "public union error ValidationError {\n    /// The value breaks a `requires` rule of its type.\n    invalid,\n}"

const ruleSource: string = "public union Rule {\n    /// `it.runeCount in a..=b`.\n    length(Range<i64> bounds)\n    /// `it in a..=b`.\n    range(Range<i64> bounds)\n    /// Any other rule.\n    custom\n}\n\npublic struct Violation {\n    i64 field\n    i64 rule\n}"

const ioErrorSource: string = "public union error IoError {\n    /// The file does not exist.\n    notFound,\n    /// Permission denied.\n    permissionDenied,\n    /// The input is not valid UTF-8.\n    invalidUtf8,\n    /// The path exists but is not a directory.\n    notADirectory,\n    /// An input or output operation failed.\n    other,\n    /// An argument cannot be passed exactly, so nothing was done.\n    invalidInput,\n    /// The operation is not available on this platform.\n    unsupported,\n    /// The source and the destination are on different devices.\n    crossDevice,\n    /// The path is a directory where a file is needed.\n    isDirectory,\n    /// The child process was ended by this signal; what it wrote to stdout and stderr before then is kept\n    /// (empty if either stream is not UTF-8).\n    signaled(i32 signal, string stdout, string stderr),\n    /// The child process ran longer than this and was stopped; what it wrote to stdout and stderr before then is kept\n    /// (empty if either stream is not UTF-8).\n    timeout(Millis after, string stdout, string stderr),\n}"

/// The builtin module, built on first use (the C# `Builtins.Module`).
ModId t9Module(ref Ctx c) {
    for i in 0..c.modules.length {
        return i if c.modules[i].name == "builtin" && c.modules[i].cName == "builtin" && c.modules[i].directory == ""
    }
    return t9Create(ref c)
}

/// The builtin type named `name` (`Stream`, `IoError`, `Rule`, `IEnumerator`, …), or -1.
Type t9Type(ref Ctx c, for string name) {
    let m = t9Module(ref c)
    return c.modules[m].types.tryGet(at: name) ?? -1
}

/// The C# `Builtins.DetailVariants`: the built-in cases whose one primitive (or `Millis`) payload a failing builtin call fills
/// from the general detail slot (plan 007 §1). Call after the declare pass has numbered the builtin sets.
public List<VariantId> detailVariants(ref Ctx c) uses alloc {
    var all = List<VariantId>()
    all.append(t9Variant(ref c, for: "IoError", by: "signaled"))
    all.append(t9Variant(ref c, for: "IoError", by: "timeout"))
    all.append(t9Variant(ref c, for: "Utf8Error", by: "invalidSequence"))
    all.append(t9Variant(ref c, for: "ParseError", by: "badDigit"))
    return all
}

/// The variant `name` of the builtin error set `set`.
VariantId t9Variant(ref Ctx c, for string set, by string name) {
    let s = typeIndex(t9Type(ref c, for: set))
    for v in c.errorSets[s].variants {
        return v if c.errorVariants[v].name == name
    }
    panic("no such builtin error variant")
}

/// The builtin function stored under `key`, or -1.
FuncId t9Function(ref Ctx c, for string key) {
    let m = t9Module(ref c)
    return c.modules[m].functions[key][0] if c.modules[m].functions.contains(key)
    return -1
}

/// The C# `Builtins` constructor.
ModId t9Create(ref Ctx c) {
    c.modules.append(Mod { name: "builtin", files: List<FileId>(), directory: "", cName: "builtin" })
    let m = c.modules.length - 1
    let stream = t9Enum(ref c, from: streamSource, by: m)
    let _ = t9Enum(ref c, from: radixSource, by: m)
    let _ = t9Enum(ref c, from: edgeSource, by: m)
    let _ = t9Enum(ref c, from: alignSource, by: m)
    let _ = t9Enum(ref c, from: comparisonSource, by: m)
    let _ = t9Make(
        ref c,
        by: m,
        for: "print",
        as: .print,
        to: prim(.void),
        from: t9Two("text", as: prim(.string), for: "to", to: enumTypeOf(stream)),
        at: "print",
    )
    c.builtinPanic = t9Make(
        ref c,
        by: m,
        for: "panic",
        as: .panic,
        to: prim(.neverKind),
        from: t9One("message", as: prim(.string)),
        at: "panic",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "todo",
        as: .todo,
        to: prim(.neverKind),
        from: t9One("message", as: prim(.string)),
        at: "todo",
    )

    let logLevel = t9Enum(ref c, from: logLevelSource, by: m)
    let _ = t9Make(
        ref c,
        by: m,
        for: "log",
        as: .log,
        to: prim(.void),
        from: t9Two("text", as: prim(.string), for: "as", to: enumTypeOf(logLevel)),
        at: "log",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "Arena",
        as: .arenaNew,
        to: builtinType(.arena),
        from: List<BuiltinParameter>(),
        at: "Arena",
    )
    let bufferSpan = internSpan(ref c, by: prim(.u8), readOnly: false)
    let _ = t9Make(
        ref c,
        by: m,
        for: "StrBuf",
        as: .strBufNew,
        to: builtinType(.strBuf),
        from: t9One("buffer", as: bufferSpan),
        at: "StrBuf(buffer)",
    )
    c.builtinStrBufGrow = t9Make(
        ref c,
        by: m,
        for: "StrBuf",
        as: .strBufGrow,
        to: builtinType(.strBuf),
        from: List<BuiltinParameter>(),
        at: "StrBuf",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "StrBuf.over",
        as: .strBufOver,
        to: builtinType(.strBuf),
        from: t9One("buffer", as: bufferSpan),
        at: "StrBuf.over",
    )
    // The value's type varies: the binder types each call (see `BindOwned`).
    let _ = t9Make(
        ref c,
        by: m,
        for: "Owned",
        as: .ownedNew,
        to: errorType(),
        from: List<BuiltinParameter>(),
        at: "Owned",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "Untrusted",
        as: .untrustedNew,
        to: errorType(),
        from: List<BuiltinParameter>(),
        at: "Untrusted",
    )
    let _ = t9Make(ref c, by: m, for: "trust", as: .trust, to: errorType(), from: List<BuiltinParameter>(), at: "trust")

    let ioError = t9ErrorSet(ref c, from: ioErrorSource, by: m)
    let roBytes = internSpan(ref c, by: prim(.u8), readOnly: true)
    let roStrings = internSpan(ref c, by: prim(.string), readOnly: true)
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "readFile",
        as: .ioReadFile,
        to: internList(ref c, by: prim(.u8)),
        from: t9One("path", as: prim(.string)),
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "readText",
        as: .ioReadText,
        to: prim(.string),
        from: t9One("path", as: prim(.string)),
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "writeFile",
        as: .ioWriteFile,
        to: prim(.void),
        from: t9Two("path", as: prim(.string), for: "bytes", to: roBytes),
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "remove",
        as: .ioRemove,
        to: prim(.void),
        from: t9One("path", as: prim(.string)),
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "createDirectory",
        as: .ioCreateDirectory,
        to: prim(.void),
        from: t9One("path", as: prim(.string)),
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "removeDirectory",
        as: .ioRemoveDirectory,
        to: prim(.void),
        from: t9One("path", as: prim(.string)),
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "listDir",
        as: .ioListDir,
        to: internList(ref c, by: prim(.string)),
        from: t9One("path", as: prim(.string)),
        at: ioError,
    )
    // `directory:`, `input:`, `env:` and `timeout:` are named only (015 S6, plan 007).
    var runParameters = t9Two("program", as: prim(.string), for: "args", to: roStrings)
    runParameters.append(BuiltinParameter { name: "directory", type: internOptional(ref c, by: prim(.string)) })
    runParameters.append(BuiltinParameter { name: "input", type: internOptional(ref c, by: roBytes) })
    runParameters.append(
        BuiltinParameter {
            name: "env",
            type: internOptional(
                ref c,
                by: internMap(ref c, by: prim(.string), to: internOptional(ref c, by: prim(.string))),
            ),
        },
    )
    runParameters.append(BuiltinParameter { name: "timeout", type: internOptional(ref c, by: builtinType(.millis)) })
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "run",
        as: .ioRun,
        to: builtinType(.processResult),
        from: move runParameters,
        at: ioError,
    )
    let _ = t9MakeIo(
        ref c,
        by: m,
        for: "runBatch",
        as: .ioRunBatch,
        to: builtinType(.processResult),
        from: t9Two("path", as: prim(.string), for: "args", to: roStrings),
        at: ioError,
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "monotonicNanos",
        as: .ioMonotonicNanos,
        to: prim(.i64),
        from: List<BuiltinParameter>(),
        at: "Io.monotonicNanos",
    )
    // Builtins.cs:87
    let _ = t9Make(
        ref c,
        by: m,
        for: "randomU64",
        as: .ioRandomU64,
        to: prim(.u64),
        from: List<BuiltinParameter>(),
        at: "Io.randomU64",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "stdout",
        as: .ioStdout,
        to: builtinType(.ioStream),
        from: List<BuiltinParameter>(),
        at: "Io.stdout",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "stderr",
        as: .ioStderr,
        to: builtinType(.ioStream),
        from: List<BuiltinParameter>(),
        at: "Io.stderr",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "stdin",
        as: .ioStdin,
        to: builtinType(.ioInput),
        from: List<BuiltinParameter>(),
        at: "Io.stdin",
    )
    // Not a static member of `Io`: the binder calls it for `Io.stdin.readAllBytes()`.
    let stdinBytes = t9Make(
        ref c,
        by: m,
        for: "readAllBytes",
        as: .ioStdinReadAllBytes,
        to: internList(ref c, by: prim(.u8)),
        from: List<BuiltinParameter>(),
        at: "Io.stdin.readAllBytes",
    )
    t9Fails(ref c, for: stdinBytes, by: ioError)

    let utf8Error = t9ErrorSet(ref c, from: utf8ErrorSource, by: m)
    let _ = t9ErrorSet(ref c, from: validationErrorSource, by: m)
    let _ = t9Rule(ref c, by: m)
    let parseError = t9ErrorSet(ref c, from: parseErrorSource, by: m)
    let invalid = t9Enum(ref c, from: utf8InvalidSource, by: m)
    let decode = t9Make(
        ref c,
        by: m,
        for: "decode",
        as: .utf8Decode,
        to: prim(.string),
        from: t9One("bytes", as: roBytes),
        at: "Utf8.decode",
    )
    t9Fails(ref c, for: decode, by: utf8Error)
    let _ = t9Make(
        ref c,
        by: m,
        for: "tryDecode",
        as: .utf8TryDecode,
        to: internOptional(ref c, by: prim(.string)),
        from: t9One("bytes", as: roBytes),
        at: "Utf8.tryDecode",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "decode",
        as: .utf8DecodeReplace,
        to: prim(.string),
        from: t9Two("bytes", as: roBytes, for: "invalid", to: enumTypeOf(invalid)),
        at: "Utf8.decode(invalid)",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "encode",
        as: .hexEncode,
        to: prim(.string),
        from: t9One("bytes", as: roBytes),
        at: "Hex.encode",
    )
    let hexDecode = t9Make(
        ref c,
        by: m,
        for: "decode",
        as: .hexDecode,
        to: internList(ref c, by: prim(.u8)),
        from: t9One("text", as: prim(.string)),
        at: "Hex.decode",
    )
    t9Fails(ref c, for: hexDecode, by: parseError)
    let _ = t9Make(
        ref c,
        by: m,
        for: "intern",
        as: .symbolIntern,
        to: builtinType(.symbol),
        from: t9One("text", as: prim(.string)),
        at: "Symbol.intern",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "invalidUtf8At",
        as: .stringInvalidUtf8At,
        to: internOptional(ref c, by: prim(.i64)),
        from: t9One("bytes", as: roBytes),
        at: "string.invalidUtf8At",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "isRooted",
        as: .pathIsRooted,
        to: prim(.bool),
        from: t9One("path", as: prim(.string)),
        at: "Path.isRooted",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "relative",
        as: .pathRelative,
        to: prim(.string),
        from: t9Two("from", as: prim(.string), for: "to", to: prim(.string)),
        at: "Path.relative",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "fileName",
        as: .pathFileName,
        to: prim(.string),
        from: t9One("path", as: prim(.string)),
        at: "Path.fileName",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "directoryName",
        as: .pathDirectoryName,
        to: internOptional(ref c, by: prim(.string)),
        from: t9One("path", as: prim(.string)),
        at: "Path.directoryName",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "combine",
        as: .pathCombine,
        to: prim(.string),
        from: t9Two("path1", as: prim(.string), for: "path2", to: prim(.string)),
        at: "Path.combine",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "combine",
        as: .pathCombineSpan,
        to: prim(.string),
        from: t9One("paths", as: internSpan(ref c, by: prim(.string), readOnly: true)),
        at: "Path.combine(paths)",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "fullPath",
        as: .pathFullPath,
        to: prim(.string),
        from: t9One("path", as: prim(.string)),
        at: "Path.fullPath",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "get",
        as: .envGet,
        to: internOptional(ref c, by: prim(.string)),
        from: t9One("name", as: prim(.string)),
        at: "Env.get",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "fileExists",
        as: .fsFileExists,
        to: prim(.bool),
        from: t9One("path", as: prim(.string)),
        at: "Fs.fileExists",
    )
    let fsRename = t9Make(
        ref c,
        by: m,
        for: "rename",
        as: .fsRename,
        to: prim(.void),
        from: t9Two("path", as: prim(.string), for: "to", to: prim(.string)),
        at: "Fs.rename",
    )
    t9Fails(ref c, for: fsRename, by: ioError)
    let fsCopy = t9Make(
        ref c,
        by: m,
        for: "copy",
        as: .fsCopy,
        to: prim(.void),
        from: t9Two("path", as: prim(.string), for: "to", to: prim(.string)),
        at: "Fs.copy",
    )
    t9Fails(ref c, for: fsCopy, by: ioError)
    let fsModified = t9Make(
        ref c,
        by: m,
        for: "modified",
        as: .fsModified,
        to: builtinType(.time),
        from: t9One("path", as: prim(.string)),
        at: "Fs.modified",
    )
    t9Fails(ref c, for: fsModified, by: ioError)
    let fsSetModified = t9Make(
        ref c,
        by: m,
        for: "setModified",
        as: .fsSetModified,
        to: prim(.void),
        from: t9Two("path", as: prim(.string), for: "to", to: builtinType(.time)),
        at: "Fs.setModified",
    )
    t9Fails(ref c, for: fsSetModified, by: ioError)
    let fsRealPath = t9Make(
        ref c,
        by: m,
        for: "realPath",
        as: .fsRealPath,
        to: prim(.string),
        from: t9One("path", as: prim(.string)),
        at: "Fs.realPath",
    )
    t9Fails(ref c, for: fsRealPath, by: ioError)
    let _ = t9Make(
        ref c,
        by: m,
        for: "now",
        as: .timeNow,
        to: builtinType(.time),
        from: List<BuiltinParameter>(),
        at: "Time.now",
    )
    let _ = t9Make(
        ref c,
        by: m,
        for: "fromNanos",
        as: .timeFromNanos,
        to: builtinType(.time),
        from: t9One("nanos", as: prim(.i64)),
        at: "Time.fromNanos",
    )

    // The iteration interfaces are declared from source too; the declare pass declares their members like a user interface's.
    let iteration = t9Parse(ref c, for: iterationSource, by: m)
    let _ = t9Interface(ref c, from: iteration, at: 0)
    let _ = t9Interface(ref c, from: iteration, at: 1)
    return m
}

/// Parses `text` as a `"<builtin>"` file of module `m`.
FileId t9Parse(ref Ctx c, for string text, by ModId m) {
    var bytes = List<u8>()
    for b in text.bytes {
        bytes.append(b)
    }
    let source = lexer.SourceText.create("<builtin>", from: move bytes)
    var p = parser.Parser.create(lexer.lex(move source, by: lexer.Keywords.build()))
    let unit = parser.parseCompilationUnit(ref p)
    var textBytes = List<u8>()
    for b in text.bytes {
        textBytes.append(b)
    }
    c.files.append(SourceFile {
        path: "<builtin>",
        displayPath: "<builtin>",
        text: move textBytes,
        unit: move unit,
        module: m,
        imports: Map<string, i64>(),
    })
    return c.files.length - 1
}

/// The name of member `index` of `file`; zero-length for a member that has none.
TextSpan t9DeclName(ref Ctx c, for FileId file, at i64 index) {
    switch c.files[file].unit.members[index] {
        case .enumDecl(let d): return d.value.name
        case .errorEnumDecl(let d): return d.value.name
        case .unionDecl(let d): return d.value.name
        case .structDecl(let d): return d.value.name
        case .interfaceDecl(let d): return d.value.name
        default: return TextSpan { start: 0, length: 0 }
    }
}

string t9Text(ref Ctx c, for FileId file, at TextSpan span) => getText(c.files[file].text.span, at: span)

/// An `enum` declared from source, with its members (the C# `new EnumSymbol` plus its `Members.Add` loop).
EnumId t9Enum(ref Ctx c, from string text, by ModId m) {
    let file = t9Parse(ref c, for: text, by: m)
    let name = t9DeclName(ref c, for: file, at: 0)
    let e = newEnum(
        ref c,
        by: EnumSymbol {
            name: t9Text(ref c, for: file, at: name),
            nameSpan: name,
            span: name,
            module: m,
            file: file,
            declIndex: 0,
            access: .publicKeyword,
        },
    )
    var spans = List<TextSpan>()
    switch c.files[file].unit.members[0] {
        case .enumDecl(let d):
            for member in d.value.members {
                spans.append(member.name)
            }
        default: return e
    }
    for s in spans {
        let id = newEnumMember(
            ref c,
            by: EnumMemberSymbol {
                name: t9Text(ref c, for: file, at: s),
                nameSpan: s,
                span: s,
                owner: e,
                ordinal: c.enums[e].members.length,
            },
        )
        c.enums[e].members.append(id)
    }
    let key = t9Text(ref c, for: file, at: name)
    c.modules[m].types[key] = enumTypeOf(e)
    return e
}

/// A `union error` declared from source; the declare pass declares its variants.
ErrorSetId t9ErrorSet(ref Ctx c, from string text, by ModId m) {
    let file = t9Parse(ref c, for: text, by: m)
    let name = t9DeclName(ref c, for: file, at: 0)
    let e = newErrorSet(
        ref c,
        by: ErrorSetSymbol {
            name: t9Text(ref c, for: file, at: name),
            nameSpan: name,
            span: name,
            module: m,
            file: file,
            declIndex: 0,
            access: .publicKeyword,
        },
    )
    let key = t9Text(ref c, for: file, at: name)
    c.modules[m].types[key] = errorSetTypeOf(e)
    return e
}

/// `union Rule` (member 0 of its file); member 1 is the `Violation` declaration each `Violation<T>` is made from.
UnionId t9Rule(ref Ctx c, by ModId m) {
    let file = t9Parse(ref c, for: ruleSource, by: m)
    let name = t9DeclName(ref c, for: file, at: 0)
    let u = newUnion(
        ref c,
        by: UnionSymbol {
            name: t9Text(ref c, for: file, at: name),
            nameSpan: name,
            span: name,
            module: m,
            file: file,
            declIndex: 0,
            access: .publicKeyword,
        },
    )
    let key = t9Text(ref c, for: file, at: name)
    c.modules[m].types[key] = unionTypeOf(u)
    return u
}

/// The C# local `MakeInterface`: member `index` of the iteration file.
InterfaceId t9Interface(ref Ctx c, from FileId file, at i64 index) {
    let name = t9DeclName(ref c, for: file, at: index)
    let m = c.files[file].module
    let i = newInterface(
        ref c,
        by: InterfaceSymbol {
            name: t9Text(ref c, for: file, at: name),
            nameSpan: name,
            span: name,
            module: m,
            file: file,
            declIndex: index,
            access: .publicKeyword,
        },
    )
    let key = t9Text(ref c, for: file, at: name)
    c.modules[m].types[key] = interfaceTypeOf(i)
    return i
}

List<BuiltinParameter> t9One(string name, as Type type) {
    var ps = List<BuiltinParameter>()
    ps.append(BuiltinParameter { name: name, type: type })
    return ps
}

List<BuiltinParameter> t9Two(string name, as Type type, for string name2, to Type type2) {
    var ps = List<BuiltinParameter>()
    ps.append(BuiltinParameter { name: name, type: type })
    ps.append(BuiltinParameter { name: name2, type: type2 })
    return ps
}

/// The C# `Make`: a public builtin function of the builtin module, stored under `key`.
FuncId t9Make(
    ref Ctx c,
    by ModId m,
    for string name,
    as BuiltinFunction kind,
    to Type returns,
    from move List<BuiltinParameter> parameters,
    at string key
) {
    let f = newFunction(
        ref c,
        by: FunctionSymbol {
            name: name,
            module: m,
            kind: .builtin,
            builtin: kind,
            returnType: returns,
            access: .publicKeyword,
        },
    )
    for p in parameters {
        let ordinal = c.functions[f].parameters.length
        let l = newLocal(
            ref c,
            by: LocalSymbol {
                name: p.name,
                type: p.type,
                kind: .parameter,
                isParameter: true,
                modifier: .none,
                ordinal: ordinal,
            },
        )
        c.functions[f].parameters.append(l)
    }
    var ids = List<FuncId>()
    ids.append(f)
    c.modules[m].functions[key] = move ids
    return f
}

/// The C# `MakeIo`: `Make` plus `fails IoError`, stored under `Io.<name>`.
FuncId t9MakeIo(
    ref Ctx c,
    by ModId m,
    for string name,
    as BuiltinFunction kind,
    to Type returns,
    from move List<BuiltinParameter> parameters,
    at ErrorSetId ioError
) {
    let f = t9Make(ref c, by: m, for: name, as: kind, to: returns, from: move parameters, at: $"Io.{name}")
    t9Fails(ref c, for: f, by: ioError)
    return f
}

/// `fn.Fails = true` and `fn.ErrorSets.Add(set)`.
void t9Fails(ref Ctx c, for FuncId f, by ErrorSetId set) {
    c.functions[f].hasFails = true
    c.functions[f].errorSets.append(set)
}

/// A built-in interface, or -1.
InterfaceId findInterface(ref Ctx c, for string name) {
    switch name {
        case "IEnumerator": return typeIndex(t9Type(ref c, for: "IEnumerator"))
        case "IIndexable": return typeIndex(t9Type(ref c, for: "IIndexable"))
    }
    return -1
}

/// A static member of `Path`, or -1.
FuncId findPath(ref Ctx c, for string name) {
    switch name {
        case "isRooted"
            or "relative"
            or "fileName"
            or "directoryName"
            or "combine"
            or "fullPath": return t9Function(ref c, for: $"Path.{name}")
    }
    return -1
}

/// A static member of `Env`, or -1.
FuncId findEnv(ref Ctx c, for string name) {
    switch name {
        case "get": return t9Function(ref c, for: "Env.get")
    }
    return -1
}

/// A static member of `Fs`, or -1.
FuncId findFs(ref Ctx c, for string name) {
    switch name {
        case "fileExists"
            or "rename"
            or "copy"
            or "modified"
            or "setModified"
            or "realPath": return t9Function(ref c, for: $"Fs.{name}")
    }
    return -1
}

/// A static member of `Time`, or -1.
FuncId findTime(ref Ctx c, for string name) {
    switch name {
        case "now": return t9Function(ref c, for: "Time.now")
        case "fromNanos": return t9Function(ref c, for: "Time.fromNanos")
    }
    return -1
}

/// A static member of `string`, or -1.
FuncId findString(ref Ctx c, for string name) {
    switch name {
        case "invalidUtf8At": return t9Function(ref c, for: "string.invalidUtf8At")
    }
    return -1
}

/// A static member of `Utf8`, or -1; `decode` with `invalid:` is `"Utf8.decode(invalid)"`.
FuncId findUtf8(ref Ctx c, for string name) {
    switch name {
        case "decode": return t9Function(ref c, for: "Utf8.decode")
        case "tryDecode": return t9Function(ref c, for: "Utf8.tryDecode")
    }
    return -1
}

/// `T T.parse(string text, Radix as = .decimal) fails ParseError` on the integer type `t`, made once per type.
FuncId intParse(ref Ctx c, for PrimitiveKind t) {
    let key = $"parse.{primitiveName(t)}"
    let found = t9Function(ref c, for: key)
    return found if found >= 0
    let m = t9Module(ref c)
    let radix = t9Type(ref c, for: "Radix")
    let parseError = typeIndex(t9Type(ref c, for: "ParseError"))
    let f = t9Make(
        ref c,
        by: m,
        for: "parse",
        as: .intParse,
        to: prim(t),
        from: t9Two("text", as: prim(.string), for: "as", to: radix),
        at: key,
    )
    t9Fails(ref c, for: f, by: parseError)
    return f
}

/// A static member of `Io`, or -1.
FuncId findIo(ref Ctx c, for string name) {
    switch name {
        case "readFile"
            or "readText"
            or "writeFile"
            or "remove"
            or "createDirectory"
            or "removeDirectory"
            or "listDir"
            or "run"
            or "runBatch"
            or "monotonicNanos"
            or "randomU64"
            or "stdout"
            or "stderr"
            or "stdin":
            return t9Function(ref c, for: $"Io.{name}")
    }
    return -1
}

FuncId? find(ref Ctx c, for string name) {
    switch name {
        case "print"
            or "log"
            or "panic"
            or "todo"
            or "Owned"
            or "Untrusted"
            or "trust": return t9Function(ref c, for: name)
    }
    return null
}

// ── BuiltinMembers.cs ────────────────────────────────────────────────────────

PropertyResult t9Property(BuiltinMember member, as Type type) => PropertyResult { member: member, type: type }

/// A built-in property (read without parentheses), or null.
PropertyResult? builtinProperty(ref Ctx c, for Type type, by string name) {
    let i = typeIndex(type)
    if isString(type) {
        switch name {
            case "length": return t9Property(.stringLength, as: prim(.i64))
            case "bytes": return t9Property(.stringBytes, as: internSpan(ref c, by: prim(.u8), readOnly: true))
            case "isEmpty": return t9Property(.stringIsEmpty, as: prim(.bool))
            case "runeCount": return t9Property(.stringRuneCount, as: prim(.i64))
            case "isAscii": return t9Property(.stringIsAscii, as: prim(.bool))
            case "runes": return t9Property(.stringRunes, as: textViewType(.runes))
            case "utf16": return t9Property(.stringUtf16, as: textViewType(.utf16))
            case "lines": return t9Property(.stringLines, as: textViewType(.lines))
        }
        return null
    }
    switch kindOf(type) {
        case .span:
            switch name {
                case "length": return t9Property(.spanLength, as: prim(.i64))
                case "isEmpty": return t9Property(.spanIsEmpty, as: prim(.bool))
            }
        case .list:
            switch name {
                case "length": return t9Property(.listLength, as: prim(.i64))
                case "isEmpty": return t9Property(.listIsEmpty, as: prim(.bool))
                // `span` is the read-only view, allowed on a `let`; `mutableSpan()` is the writable one (J80).
                case "span": return t9Property(.listAsSpan, as: internSpan(ref c, by: c.listTypes[i], readOnly: true))
            }
        case .map:
            return t9Property(.mapLength, as: prim(.i64)) if name == "length"
        case .array:
            switch name {
                case "length": return t9Property(.arrayLength, as: prim(.i64))
                case "span": return t9Property(
                    .arrayAsSpan,
                    as: internSpan(ref c, by: c.arrayTypes[i].element, readOnly: true),
                )
            }
        case .builtin:
            switch builtinKindOf(i) {
                case .strBuf:
                    switch name {
                        case "length": return t9Property(.strBufLength, as: prim(.i64))
                        case "view": return t9Property(.strBufAsString, as: prim(.string))
                    }
                case .symbol:
                    return t9Property(.symbolText, as: prim(.string)) if name == "text"
                case .processResult:
                    switch name {
                        case "exitCode": return t9Property(.processExitCode, as: prim(.i32))
                        case "stdout": return t9Property(.processStdout, as: prim(.string))
                        case "stderr": return t9Property(.processStderr, as: prim(.string))
                    }
                case .panic:
                    return t9Property(.panicMessage, as: prim(.string)) if name == "message"
                case .time:
                    return t9Property(.timeNanos, as: prim(.i64)) if name == "nanos"
                // The binder gives `radix` the builtin `Radix` and `align` the builtin `Align`; `digits` is -1 when the hole gives none.
                case .formatSpec:
                    switch name {
                        case "radix": return t9Property(.formatSpecRadix, as: prim(.i32))
                        case "debug": return t9Property(.formatSpecDebug, as: prim(.bool))
                        case "width": return t9Property(.formatSpecWidth, as: prim(.i64))
                        case "fill": return t9Property(.formatSpecFill, as: prim(.char))
                        case "align": return t9Property(.formatSpecAlign, as: prim(.i32))
                        case "digits": return t9Property(.formatSpecDigits, as: prim(.i64))
                    }
                default: return null
            }
        case .primitive:
            return t9Property(.charValue, as: prim(.u32)) if type == prim(.char) && name == "value"
        case .result:
            switch name {
                case "isOk": return t9Property(.resultIsOk, as: prim(.bool))
                case "value": return t9Property(.resultValue, as: c.resultTypes[i].value)
                case "err": return t9Property(.resultError, as: c.resultTypes[i].error)
            }
        case .owned:
            return t9Property(.ownedValue, as: c.ownedTypes[i]) if name == "value"
        case .enumType:
            switch name {
                case "name": return t9Property(.enumName, as: prim(.string))
                case "ordinal": return t9Property(.enumOrdinal, as: prim(.i32))
            }
        default: return null
    }
    return null
}

BuiltinMethod? method(ref Ctx c, for Type type, by string name) {
    let i = typeIndex(type)
    if isString(type) {
        switch name {
            // `s.copy()` copies from `context.allocator`, `s.copy(to: arena)` into the arena.
            case "copy": return BuiltinMethod {
                member: .stringCopy,
                parameters: t9One("to", as: builtinType(.arena)),
                returns: prim(.string),
                optional: 1,
            }
            case "startsWith": return BuiltinMethod {
                member: .stringStartsWith,
                parameters: t9One("prefix", as: prim(.string)),
                returns: prim(.bool),
            }
            case "endsWith": return BuiltinMethod {
                member: .stringEndsWith,
                parameters: t9One("suffix", as: prim(.string)),
                returns: prim(.bool),
            }
            case "contains": return BuiltinMethod {
                member: .stringContains,
                parameters: t9One("text", as: prim(.string)),
                returns: prim(.bool),
            }
            case "position":
                return BuiltinMethod {
                    member: .stringPosition,
                    parameters: t9Two("text", as: prim(.string), for: "from", to: prim(.i64)),
                    returns: internOptional(ref c, by: prim(.i64)),
                    optional: 1,
                }
            case "lastPosition":
                return BuiltinMethod {
                    member: .stringLastPosition,
                    parameters: t9One("text", as: prim(.string)),
                    returns: internOptional(ref c, by: prim(.i64)),
                }
            case "count": return BuiltinMethod {
                member: .stringCount,
                parameters: t9One("text", as: prim(.string)),
                returns: prim(.i64),
            }
            // The binder gives `from:` the builtin `Edge`, picks `trimmed(by:)` by the argument's name, and gives `equals`' `as:` the builtin `Comparison`.
            case "trimmed": return BuiltinMethod {
                member: .stringTrimmed,
                parameters: t9One("from", as: errorType()),
                returns: prim(.string),
                optional: 1,
            }
            case "equals":
                return BuiltinMethod {
                    member: .stringEquals,
                    parameters: t9Two("text", as: prim(.string), for: "as", to: errorType()),
                    returns: prim(.bool),
                    optional: 1,
                }
            case "lowercased": return BuiltinMethod {
                member: .stringLowercased,
                parameters: List<BuiltinParameter>(),
                returns: prim(.string),
            }
            case "uppercased": return BuiltinMethod {
                member: .stringUppercased,
                parameters: List<BuiltinParameter>(),
                returns: prim(.string),
            }
            case "replaced":
                return BuiltinMethod {
                    member: .stringReplaced,
                    parameters: t9Two("text", as: prim(.string), for: "by", to: prim(.string)),
                    returns: prim(.string),
                }
            case "repeated": return BuiltinMethod {
                member: .stringRepeated,
                parameters: t9One("count", as: prim(.i64)),
                returns: prim(.string),
            }
            case "padded":
                return BuiltinMethod {
                    member: .stringPadded,
                    parameters: t9Two("to", as: prim(.i64), for: "by", to: prim(.char)),
                    returns: prim(.string),
                }
            // A limit of 0 means no limit. The binder picks `StringPartsRune` for a `rune` separator.
            case "parts":
                return BuiltinMethod {
                    member: .stringParts,
                    parameters: t9Two("by", as: prim(.string), for: "limit", to: prim(.i64)),
                    returns: textViewType(.parts),
                    optional: 1,
                }
        }
        return null
    }
    switch kindOf(type) {
        case .textView:
            switch textViewKindOf(i) {
                case .runes:
                    switch name {
                        case "take": return BuiltinMethod {
                            member: .runesTake,
                            parameters: t9One("count", as: prim(.i64)),
                            returns: prim(.string),
                        }
                        case "skip": return BuiltinMethod {
                            member: .runesSkip,
                            parameters: t9One("count", as: prim(.i64)),
                            returns: prim(.string),
                        }
                        case "takeLast": return BuiltinMethod {
                            member: .runesTakeLast,
                            parameters: t9One("count", as: prim(.i64)),
                            returns: prim(.string),
                        }
                    }
                case .utf16:
                    return BuiltinMethod {
                        member: .utf16Copy,
                        parameters: List<BuiltinParameter>(),
                        returns: internList(ref c, by: prim(.u16)),
                    } if name == "copy"
                default: return null
            }
        case .span:
            let e = c.spanTypes[i].element
            switch name {
                case "joined":
                    return BuiltinMethod {
                        member: .stringJoined,
                        parameters: t9One("by", as: prim(.string)),
                        returns: prim(.string),
                    } if isString(e)
                // `copy()` copies from `context.allocator`, `copy(to: arena)` into the arena, as on strings.
                case "copy":
                    return BuiltinMethod {
                        member: .spanCopy,
                        parameters: t9One("to", as: builtinType(.arena)),
                        returns: internList(ref c, by: e),
                        optional: 1,
                    }
            }
        case .list:
            let e = c.listTypes[i]
            switch name {
                case "joined":
                    return BuiltinMethod {
                        member: .stringJoined,
                        parameters: t9One("by", as: prim(.string)),
                        returns: prim(.string),
                    } if isString(e)
                case "mutableSpan":
                    return BuiltinMethod {
                        member: .listMutableSpan,
                        parameters: List<BuiltinParameter>(),
                        returns: internSpan(ref c, by: e, readOnly: false),
                        mutating: true,
                    }
                case "copy": return BuiltinMethod {
                    member: .listCopy,
                    parameters: t9One("to", as: builtinType(.arena)),
                    returns: type,
                    optional: 1,
                }
                case "append": return BuiltinMethod {
                    member: .listAdd,
                    parameters: t9One("item", as: e),
                    returns: prim(.void),
                    mutating: true,
                }
                case "clear": return BuiltinMethod {
                    member: .listClear,
                    parameters: List<BuiltinParameter>(),
                    returns: prim(.void),
                    mutating: true,
                }
                case "removeLast": return BuiltinMethod {
                    member: .listRemoveLast,
                    parameters: List<BuiltinParameter>(),
                    returns: e,
                    mutating: true,
                }
                // The binder picks `remove(at:)` (an index or a range) and `remove(from:through:)` by the arguments' names.
                case "remove":
                    return BuiltinMethod {
                        member: .listRemoveRange,
                        parameters: t9Two("from", as: prim(.i64), for: "until", to: prim(.i64)),
                        returns: prim(.void),
                        mutating: true,
                    }
                // The items are copied in, so elements that own memory are left out.
                case "replace":
                    unless t9IsUnique(ref c, for: e) {
                        let at = internRange(ref c, by: prim(.i64))
                        let items = internSpan(ref c, by: e, readOnly: true)
                        return BuiltinMethod {
                            member: .listReplace,
                            parameters: t9Two("at", as: at, for: "by", to: items),
                            returns: prim(.void),
                            mutating: true,
                        }
                    }
                case "tryGet": return BuiltinMethod {
                    member: .listTryGet,
                    parameters: t9One("at", as: prim(.i64)),
                    returns: internOptional(ref c, by: e),
                }
                // Stable (J47); elements ordered by `<`: numbers, `rune` and `string`.
                case "sort":
                    return BuiltinMethod {
                        member: .listSort,
                        parameters: List<BuiltinParameter>(),
                        returns: prim(.void),
                        mutating: true,
                    } if isNumeric(e)
                        || isString(e)
                        || e == prim(.char)
                case "take": return BuiltinMethod {
                    member: .listTake,
                    parameters: List<BuiltinParameter>(),
                    returns: type,
                    mutating: true,
                }
            }
        case .array:
            if name == "mutableSpan" {
                return BuiltinMethod {
                    member: .arrayMutableSpan,
                    parameters: List<BuiltinParameter>(),
                    returns: internSpan(ref c, by: c.arrayTypes[i].element, readOnly: false),
                    mutating: true,
                }
            }
        case .map:
            let k = c.mapTypes[i].key
            let v = c.mapTypes[i].value
            switch name {
                case "tryGet": return BuiltinMethod {
                    member: .mapTryGet,
                    parameters: t9One("at", as: k),
                    returns: internOptional(ref c, by: v),
                }
                case "slot": return BuiltinMethod {
                    member: .mapSlot,
                    parameters: t9One("key", as: k),
                    returns: v,
                    mutating: true,
                }
                case "contains": return BuiltinMethod {
                    member: .mapContains,
                    parameters: t9One("key", as: k),
                    returns: prim(.bool),
                }
                case "remove": return BuiltinMethod {
                    member: .mapRemove,
                    parameters: t9One("key", as: k),
                    returns: prim(.bool),
                    mutating: true,
                }
                case "copy": return BuiltinMethod {
                    member: .mapCopy,
                    parameters: t9One("to", as: builtinType(.arena)),
                    returns: type,
                }
                case "clear": return BuiltinMethod {
                    member: .mapClear,
                    parameters: List<BuiltinParameter>(),
                    returns: prim(.void),
                    mutating: true,
                }
                case "take": return BuiltinMethod {
                    member: .mapTake,
                    parameters: List<BuiltinParameter>(),
                    returns: type,
                    mutating: true,
                }
            }
        case .builtin:
            switch builtinKindOf(i) {
                case .arena:
                    return BuiltinMethod {
                        member: .arenaReset,
                        parameters: List<BuiltinParameter>(),
                        returns: prim(.void),
                        mutating: true,
                    } if name == "reset"
                case .strBuf:
                    switch name {
                        case "append": return BuiltinMethod {
                            member: .strBufAppend,
                            parameters: t9One("text", as: prim(.string)),
                            returns: prim(.void),
                            mutating: true,
                        }
                        // `at:` is a byte offset on a rune boundary, like a string slice's bounds.
                        case "appendRepeated":
                            return BuiltinMethod {
                                member: .strBufAppendRepeated,
                                parameters: t9Two("rune", as: prim(.char), for: "by", to: prim(.i64)),
                                returns: prim(.void),
                                mutating: true,
                            }
                        case "insert":
                            return BuiltinMethod {
                                member: .strBufInsert,
                                parameters: t9Two("text", as: prim(.string), for: "at", to: prim(.i64)),
                                returns: prim(.void),
                                mutating: true,
                            }
                        case "copy": return BuiltinMethod {
                            member: .strBufCopy,
                            parameters: t9One("to", as: builtinType(.arena)),
                            returns: type,
                        }
                        // `finish()` returns the text borrowed from the buffer, like `view`; it does not consume the buffer yet.
                        case "finish": return BuiltinMethod {
                            member: .strBufAsString,
                            parameters: List<BuiltinParameter>(),
                            returns: prim(.string),
                        }
                        case "clear": return BuiltinMethod {
                            member: .strBufClear,
                            parameters: List<BuiltinParameter>(),
                            returns: prim(.void),
                            mutating: true,
                        }
                        case "take": return BuiltinMethod {
                            member: .strBufTake,
                            parameters: List<BuiltinParameter>(),
                            returns: type,
                            mutating: true,
                        }
                    }
                case .ioStream:
                    return BuiltinMethod {
                        member: .ioWrite,
                        parameters: t9One("text", as: prim(.string)),
                        returns: prim(.void),
                    } if name == "write"
                // The binder wraps the result in `Result<string, IoError>`; it binds `readAllBytes()` as the builtin `Io.stdin.readAllBytes`, which fails.
                case .ioInput:
                    return BuiltinMethod {
                        member: .ioReadAll,
                        parameters: List<BuiltinParameter>(),
                        returns: prim(.string),
                    } if name == "readAll"
                default: return null
            }
        case .optional:
            return BuiltinMethod {
                member: .optionalTake,
                parameters: List<BuiltinParameter>(),
                returns: type,
                mutating: true,
            } if name == "take"
                && t9IsUnique(ref c, for: c.optionalTypes[i])
        default: return null
    }
    return null
}

// `Io.stdin.readAllBytes` is bound as a failing builtin function, so `method` has no entry for it.
bool hasMethod(ref Ctx c, for Type type, by string name) =>
    method(ref c, for: type, by: name) is not null || (type == builtinType(.ioInput) && name == "readAllBytes")

/// The C# `Candidates`.
List<string> t9Candidates() => [
    "length", "bytes", "isEmpty", "runeCount", "isAscii", "runes", "utf16", "lines", "value",
    "copy", "startsWith", "endsWith", "contains", "position", "lastPosition", "count", "trimmed", "equals",
    "lowercased", "uppercased", "replaced", "repeated", "padded", "parts", "skip", "takeLast", "joined",
    "span", "mutableSpan", "clear", "removeLast", "replace", "sort", "tryGet", "slot", "remove",
    "reset", "append", "appendRepeated", "insert", "finish", "view", "take", "write", "readAll",
    "readAllBytes", "name", "ordinal", "exitCode", "stdout", "stderr", "message", "radix", "debug",
    "width", "fill", "align", "digits",
]

/// Every member name of `t`, for suggestions.
List<string> names(ref Ctx c, for Type t) {
    var result = List<string>()
    for n in t9Candidates() {
        if builtinProperty(ref c, for: t, by: n) is not null || method(ref c, for: t, by: n) is not null {
            result.append(n)
        }
    }
    return result
}

/// `TypeFacts.IsUnique` for the types the builtin tables meet; T6's `isUnique` is a stub on this branch (Q561).
/// Structs, unions, tuples, states and type parameters are not unique here.
bool t9IsUnique(ref Ctx c, for Type t) {
    let i = typeIndex(t)
    switch kindOf(t) {
        case .list or .map or .owned: return true
        case .builtin: return builtinKindOf(i) == .strBuf
        case .untrusted: return t9IsUnique(ref c, for: c.untrustedTypes[i])
        case .optional: return t9IsUnique(ref c, for: c.optionalTypes[i])
        case .result: return t9IsUnique(ref c, for: c.resultTypes[i].value)
        case .array: return t9IsUnique(ref c, for: c.arrayTypes[i].element)
        default: return false
    }
}
== semantics/calls.byn
// T20: BinderCalls.cs 1-595 (calls, overloads, arguments).

import parser

/// BinderCalls.cs:19 StripParens: the span of `e` inside any parentheses.
TextSpan stripParens(in parser.Expr e) {
    switch e {
        case .parenExpr(let p): return stripParens(in p.value.inner)
        default: return parser.exprSpan(in e)
    }
}

// ── Calls ────────────────────────────────────────────────────────────────────

BExpr bindCall(
    ref Binder b,
    through ref Ctx c,
    for in parser.CallExpr call,
    from parser.Expr syntax,
    to Type expected
) {
    // A call to a member ending in `Unchecked` bypasses a safety rule and says why (J6); an empty reason is the parser's.
    var calleeName: string? = null
    switch call.callee {
        case .memberExpr(let me): calleeName = t15Text(in c, from: b.file, at: me.value.member)
        case .nameExpr(let ne): calleeName = t15Text(in c, from: b.file, at: ne.value.name)
        default: break
    }
    if call.becauseKeyword is null && (calleeName is { } m) && m.endsWith("Unchecked") {
        report(
            ref b,
            through: ref c,
            for: .missingBecause,
            at: call.span,
            by: ($"{m}()", "", "", "", ""),
            label: "bypasses a safety rule",
            help: "explain the bypass in a `because` clause",
        )
    }
    switch call.callee {
        case .memberExpr(let me):
            if !me.value.nullConditional {
                let member = t15Text(in c, from: b.file, at: me.value.member)
                return bindTrustUnchecked(
                    ref b,
                    through: ref c,
                    for: in call,
                    by: in me.value,
                ) because "the C# `BindTrustUnchecked` is the binder of the call itself" if member == "trustUnchecked"
                    && call.args.length == 0
                switch me.value.target {
                    case .nameExpr(let into):
                        let target = t15Text(in c, from: b.file, at: into.value.name)
                        return bindTryFrom(
                            ref b,
                            through: ref c,
                            for: in call,
                            to: primKindOf(typeIndex(tf)),
                        ) if member == "tryFrom"
                            && (primitiveByName(target) is { } tf)
                            && isNumeric(tf)
                        if member == "tryParse"
                                && (primitiveByName(target) is { } tt)
                                && (isInteger(tt) || isFloat(tt)) {
                            return bindFloatTryParse(
                                ref b,
                                through: ref c,
                                for: in call,
                                to: primKindOf(typeIndex(tt)),
                            ) if isFloat(tt)
                            return bindTryParse(ref b, through: ref c, for: in call, to: primKindOf(typeIndex(tt)))
                        }
                        return bindParse(
                            ref b,
                            through: ref c,
                            for: in call,
                            from: syntax,
                            to: primKindOf(typeIndex(tp)),
                        ) if member == "parse"
                            && (primitiveByName(target) is { } tp)
                            && isInteger(tp)
                        let mod = c.files[b.file].module
                        // `StrBuf.over(span)`: the span first, then `context.allocator` (spec §16.4).
                        if member == "over" && target == "StrBuf" && into.value.typeArgs.length == 0
                                && t15Lookup(ref b, for: "StrBuf") == -1 && !c.modules[mod].types.contains("StrBuf") {
                            let over = t9Function(ref c, for: "StrBuf.over")
                            let ps = copyIds(in c.functions[over].parameters)
                            let args = bindArguments(
                                ref b,
                                through: ref c,
                                for: in call,
                                by: in ps,
                                as: over,
                                enforceNames: false,
                                displayName: "StrBuf.over",
                            )
                            return recordSyntax(
                                ref c,
                                for: addCall(
                                    ref c,
                                    from: BCall {
                                        span: call.span,
                                        function: over,
                                        receiver: -1,
                                        arguments: move args,
                                        type: builtinType(.strBuf),
                                    },
                                ),
                                from: in syntax,
                            )
                        }
                        // `Log.debug(…)` on an undeclared `Log` names the level where the act should be (BYN5007, Question 271).
                        let logLevel = typeIndex(t9Type(ref c, for: "LogLevel"))
                        if target == "Log" && into.value.typeArgs.length == 0
                                && findEnumMember(ref c, by: logLevel, for: member) != -1
                                && t15Lookup(ref b, for: "Log") == -1
                                && !c.modules[mod].types.contains("Log")
                                && !c.modules[mod].functions.contains("Log")
                                && !c.modules[mod].constants.contains("Log")
                                && !c.files[b.file].imports.contains("Log") {
                            let plain = call.args.length == 1
                                && call.args[0].name is null
                                && call.args[0].modifier == .none
                            let text = plain ? t15Text(
                                in c,
                                from: b.file,
                                at: parser.exprSpan(in call.args[0].value),
                            ) : ""
                            report(
                                ref b,
                                through: ref c,
                                for: .logLevelAsVerb,
                                at: me.value.span,
                                by: (member, "", "", "", ""),
                                help: $"call `log` and pass the level `as: .{member}`",
                                hasFix: plain,
                                fixSpan: plain ? call.span : null,
                                fixReplacement: plain ? $"log({text}, as: .{member})" : "",
                            )
                            bindArgumentsForRecovery(ref b, through: ref c, for: in call)
                            return recordSyntax(
                                ref c,
                                for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
                                from: in syntax,
                            )
                        }
                    default:
                        break
                }
            }
        default:
            break
    }
    let outer = b.calleeOf
    b.calleeOf = calleeOfCall(call)
    var callee: BExpr = -1
    switch call.callee {
        case .targetMemberExpr(let tm): callee = bindTargetMember(ref b, through: ref c, for: in tm.value, to: expected)
        default: callee = bindExprOrType(ref b, through: ref c, for: in call.callee)
    }
    b.calleeOf = outer
    let kind = boundKind(callee)
    let i = boundIndex(callee)
    if kind == .methodGroup {
        let fn = c.bMethodGroups[i].function
        let receiver = c.bMethodGroups[i].receiver
        let explicit = c.bMethodGroups[i].typeArgs.length > 0
        switch c.functions[fn].builtin {
            case .ownedNew:
                @unobservable because "Q616: bindOwned and bindUntrusted are stubs; add Owned and Untrusted constructor cases when T21 lands"
                return bindOwned(
                    ref b,
                    through: ref c,
                    for: in call,
                    as: expected != -1 && kindOf(expected) == .owned ? c.ownedTypes[typeIndex(expected)] : -1,
                )
            case .untrustedNew:
                @unobservable because "Q616: bindOwned and bindUntrusted are stubs; add Owned and Untrusted constructor cases when T21 lands"
                return bindUntrusted(
                    ref b,
                    through: ref c,
                    for: in call,
                    as: expected != -1 && kindOf(expected) == .untrusted ? c.untrustedTypes[typeIndex(expected)] : -1,
                )
            case .trust:
                return bindTrust(ref b, through: ref c, for: in call)
            default:
                break
        }
        // `Utf8.decode(bytes, invalid: .replace)` is the lossy form, which never fails.
        return t20BindGroupCall(
            ref b,
            through: ref c,
            for: call,
            from: call.callee,
            at: syntax,
            by: t9Function(ref c, for: "Utf8.decode(invalid)"),
            as: -1,
            explicit: explicit,
        ) if fn == t9Function(ref c, for: "Utf8.decode")
            && t20HasArgument(c, from: b.file, for: call, by: "invalid")
        // `Path.combine(paths)`, one argument, is the span form; `t20Overload` does not see builtins.
        return t20BindGroupCall(
            ref b,
            through: ref c,
            for: call,
            from: call.callee,
            at: syntax,
            by: t9Function(ref c, for: "Path.combine(paths)"),
            as: -1,
            explicit: explicit,
        ) if fn == t9Function(ref c, for: "Path.combine")
            && call.args.length == 1
        return t20BindGroupCall(
            ref b,
            through: ref c,
            for: call,
            from: call.callee,
            at: syntax,
            by: t20Overload(ref c, for: fn, from: b.file, by: call),
            as: receiver,
            explicit: explicit,
        )
    }
    if kind == .builtinGroup {
        let name = c.bBuiltinGroups[i].name
        // `Io.stdin.readAllBytes()` fails like `Io.readFile`: a call of a failing builtin function, not a builtin member.
        return bindFunctionCall(
            ref b,
            through: ref c,
            for: in call,
            by: t9Function(ref c, for: "Io.stdin.readAllBytes"),
            from: -1,
            at: syntax,
        ) if name == "readAllBytes"
            && exprType(in c, for: c.bBuiltinGroups[i].receiver) == builtinType(.ioInput)
        return bindBuiltinMethodCall(ref b, through: ref c, for: in call, from: c.bBuiltinGroups[i].receiver, by: name)
    }
    return bindConstruction(ref b, through: ref c, for: in call, as: c.bTypeRefs[i].referenced) if kind == .typeRef
    if kind == .variantGroup {
        let v = c.bVariantGroups[i].variant
        let fields = copyIds(in c.unionVariants[v].fields)
        let variantName = c.unionVariants[v].name
        let payload = bindArguments(
            ref b,
            through: ref c,
            for: in call,
            by: in fields,
            as: -1,
            enforceNames: false,
            displayName: variantName,
        )
        return recordSyntax(
            ref c,
            for: addUnionNew(ref c, from: BUnionNew { span: call.span, variant: v, payload: move payload }),
            from: in syntax,
        )
    }
    if kind == .unionNew && c.bUnionNews[i].payload.length == 0 {
        let v = c.bUnionNews[i].variant
        report(
            ref b,
            through: ref c,
            for: .variantHasNoPayload,
            at: call.span,
            by: (c.unionVariants[v].name, "", "", "", ""),
            help: $"write `{c.unions[c.unionVariants[v].owner].name}.{c.unionVariants[v].name}` without parentheses",
        )
        bindArgumentsForRecovery(ref b, through: ref c, for: in call)
        return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }), from: in syntax)
    }
    if kind == .errorExpr {
        bindArgumentsForRecovery(ref b, through: ref c, for: in call)
        return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }), from: in syntax)
    }
    // A call through a function value: the value is the receiver of its type's invoke symbol (R9).
    let type = exprType(in c, for: callee)
    return bindFunctionCall(
        ref b,
        through: ref c,
        for: in call,
        by: invokeSymbol(ref c, for: type),
        from: callee,
        at: syntax,
    ) if kindOf(type) == .function
    report(
        ref b,
        through: ref c,
        for: .notCallable,
        at: parser.exprSpan(in call.callee),
        by: (typeDisplay(ref c, by: type), "", "", "", ""),
    )
    bindArgumentsForRecovery(ref b, through: ref c, for: in call)
    return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }), from: in syntax)
}

/// `c.Args.Any(a => a.Name?.Text == name)`.
bool t20HasArgument(Ctx c, from FileId f, for parser.CallExpr call, by string name) {
    for a in call.args {
        return true if (a.name is { } n) && t15Text(in c, from: f, at: n) == name
    }
    return false
}

/// `BindFunctionCall(c, fn, receiver, g.TypeArgs)`: a method group's explicit type arguments are those of the `NameExpr`
/// it was bound from (BinderExpressions.cs:511), found again through any parentheses (Q618).
BExpr t20BindGroupCall(
    ref Binder b,
    through ref Ctx c,
    for parser.CallExpr call,
    from parser.Expr e,
    at parser.Expr syntax,
    by FuncId fn,
    as BExpr receiver,
    bool explicit
) {
    switch e {
        case .parenExpr(let p):
            return t20BindGroupCall(
                ref b,
                through: ref c,
                for: call,
                from: p.value.inner,
                at: syntax,
                by: fn,
                as: receiver,
                explicit: explicit,
            )
        case .nameExpr(let n):
            return bindFunctionCall(
                ref b,
                through: ref c,
                for: in call,
                by: fn,
                from: receiver,
                at: syntax,
                typeArgs: in n.value.typeArgs,
            ) if explicit
            return bindFunctionCall(ref b, through: ref c, for: in call, by: fn, from: receiver, at: syntax)
        default:
            return bindFunctionCall(ref b, through: ref c, for: in call, by: fn, from: receiver, at: syntax)
    }
}

/// BinderCalls.cs:106 Overload: the overload of `fn` the call's labels select (J65): the first whose labels fit the named
/// arguments and whose unlabeled parameters fit the positional ones. Overloads cannot overlap, so at most one fits; with
/// none, `fn` reports why.
FuncId t20Overload(ref Ctx c, for FuncId fn, from FileId f, by parser.CallExpr call) {
    var overloads = List<FuncId>()
    let name = c.functions[fn].name
    if c.functions[fn].owner != -1 {
        overloads = findMethods(ref c, by: c.functions[fn].owner, for: name)
    } else if (c.modules[c.functions[fn].module].functions.tryGet(at: name) is { } fs) && t15ContainsLocal(
        in fs,
        for: fn
    ) {
        overloads = copyIds(in fs)
    }
    return fn if overloads.length < 2
    var named = Map<string, bool>()
    var positional: i64 = 0
    for a in call.args {
        if (a.name is { } n) {
            named[t15Text(in c, from: f, at: n)] = true
        } else {
            positional += 1
        }
    }
    for o in overloads {
        return o if t20Accepts(c, for: o, by: named, as: positional)
    }
    return fn
}

/// BinderCalls.cs:116 Accepts.
bool t20Accepts(Ctx c, for FuncId f, by Map<string, bool> named, as i64 positional) {
    let ps = t12Params(in c, for: f)
    for (n, _) in named {
        var any = false
        for p in ps {
            if p.label == n {
                any = true
            }
        }
        return false if !any
    }
    for p in ps {
        return false if (p.syntax is { } x) && x.hasParticle && !x.hasDefault && !named.contains(p.label)
    }
    var open: i64 = 0
    var needed: i64 = 0
    var rest = false
    for i in 0..ps.length {
        if (ps[i].syntax is { } x) && !x.hasParticle && !named.contains(c.locals[c.functions[f].parameters[i]].name) {
            open += 1
            if !x.hasDefault && !x.isRest {
                needed += 1
            }
            if x.isRest {
                rest = true
            }
        }
    }
    return positional >= needed && (positional <= open || rest)
}

/// BinderCalls.cs:127 BindTryFrom: `u8.tryFrom(x)`, a numeric conversion that gives `null` instead of trapping when the
/// value does not fit.
BExpr bindTryFrom(ref Binder b, through ref Ctx c, for in parser.CallExpr call, to PrimitiveKind target) {
    if call.args.length != 1 || call.args[0].name is not null {
        report(
            ref b,
            through: ref c,
            for: .tooManyArguments,
            at: parser.exprSpan(in call.callee),
            by: ($"{typeDisplay(ref c, by: prim(target))}.tryFrom", "1", "", "", ""),
        )
        bindArgumentsForRecovery(ref b, through: ref c, for: in call)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    let operand = bindExpr(ref b, through: ref c, for: in call.args[0].value)
    let type = exprType(in c, for: operand)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        at: syntaxOfCall(ref c, from: in call),
    ) if isError(type)
    if !isNumeric(type) {
        report(
            ref b,
            through: ref c,
            for: .invalidCast,
            at: parser.exprSpan(in call.args[0].value),
            by: (typeDisplay(ref c, by: type), typeDisplay(ref c, by: prim(target)), "", "", ""),
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    let optional = internOptional(ref c, by: prim(target))
    return recordSyntaxNode(
        ref c,
        for: addTryFrom(
            ref c,
            from: BTryFrom { span: call.span, operand: operand, target: prim(target), type: optional },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:146 BindTryParse: `i64.tryParse(text, as: radix)`, an integer read from text in a `Radix`, `.decimal` by
/// default, or `null` (spec §6.2). The C# parameters have no symbol of their own, so they are new locals (Q619).
BExpr bindTryParse(ref Binder b, through ref Ctx c, for in parser.CallExpr call, to PrimitiveKind target) {
    let radixType = t9Type(ref c, for: "Radix")
    var ps = List<LocalId>()
    ps.append(
        newLocal(
            ref c,
            by: LocalSymbol {
                name: "text",
                type: prim(.string),
                kind: .parameter,
                isParameter: true,
                modifier: .none,
                ordinal: 0,
            },
        ),
    )
    let asParam = newLocal(
        ref c,
        by: LocalSymbol {
            name: "as",
            type: radixType,
            kind: .parameter,
            isParameter: true,
            modifier: .none,
            ordinal: 1,
        },
    )
    if call.args.length >= 2 {
        ps.append(asParam)
    }
    @unobservable because "Q619: enforceNames reads only a parameter's Param syntax or a bool type, which these parameters lack; the mutant is equivalent"
    let args = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in ps,
        as: -1,
        enforceNames: false,
        displayName: $"{typeDisplay(ref c, by: prim(target))}.tryParse",
    )
    // coverage-exempt: Q853
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        at: syntaxOfCall(ref c, from: in call),
    ) if args.length == 0
    for a in args {
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        ) if isError(exprType(in c, for: a))
    }
    var radix = args.length > 1 ? args[1] : -1
    if args.length <= 1 {
        let decimal = findEnumMember(ref c, by: typeIndex(radixType), for: "decimal")
        radix = recordSyntaxNode(
            ref c,
            for: addEnumMember(ref c, from: BEnumMember { span: call.span, member: decimal }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    let optional = internOptional(ref c, by: prim(target))
    return recordSyntaxNode(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall {
                span: call.span,
                member: .intTryParse,
                receiver: args[0],
                arguments: [radix],
                type: optional,
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:160 BindFloatTryParse: `f64.tryParse(text)`, a float read from text in the literal form without `_`, or
/// `null` (revision 0015). The parameter is a new local, as in `bindTryParse` (Q619).
BExpr bindFloatTryParse(ref Binder b, through ref Ctx c, for in parser.CallExpr call, to PrimitiveKind target) {
    var ps = List<LocalId>()
    ps.append(
        newLocal(
            ref c,
            by: LocalSymbol {
                name: "text",
                type: prim(.string),
                kind: .parameter,
                isParameter: true,
                modifier: .none,
                ordinal: 0,
            },
        ),
    )
    @unobservable because "Q619: enforceNames reads only a parameter's Param syntax or a bool type, which these parameters lack; the mutant is equivalent"
    let args = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in ps,
        as: -1,
        enforceNames: false,
        displayName: $"{typeDisplay(ref c, by: prim(target))}.tryParse",
    )
    // coverage-exempt: Q853
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        at: syntaxOfCall(ref c, from: in call),
    ) if args.length == 0
    for a in args {
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        ) if isError(exprType(in c, for: a))
    }
    let optional = internOptional(ref c, by: prim(target))
    return recordSyntaxNode(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall {
                span: call.span,
                member: .floatTryParse,
                receiver: args[0],
                arguments: [],
                type: optional,
            },
        ),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// BinderCalls.cs:168 BindParse: `i64.parse(text, as: radix)`, as `tryParse`, but fails `ParseError` with the offset of the
/// bad digit, or `overflow`.
BExpr bindParse(
    ref Binder b,
    through ref Ctx c,
    for in parser.CallExpr call,
    from parser.Expr syntax,
    to PrimitiveKind target
) {
    let fn = intParse(ref c, for: target)
    let all = copyIds(in c.functions[fn].parameters)
    let take = call.args.length < 1 ? 1 : call.args.length > 2 ? 2 : call.args.length
    var ps = List<LocalId>()
    for i in 0..take {
        ps.append(all[i])
    }
    let name = $"{typeDisplay(ref c, by: prim(target))}.parse"
    let args = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in ps,
        as: -1,
        enforceNames: false,
        displayName: name,
    )
    // coverage-exempt: Q853
    return recordSyntax(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        from: in syntax,
    ) if args.length == 0
    for a in args {
        return recordSyntax(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            from: in syntax,
        ) if isError(exprType(in c, for: a))
    }
    var radix = args.length > 1 ? args[1] : -1
    if args.length <= 1 {
        let decimal = findEnumMember(ref c, by: typeIndex(t9Type(ref c, for: "Radix")), for: "decimal")
        radix = recordSyntax(
            ref c,
            for: addEnumMember(ref c, from: BEnumMember { span: call.span, member: decimal }),
            from: in syntax,
        )
    }
    if !((b.handled is { } h) && h == call.span) {
        t20Unhandled(ref b, through: ref c, at: call.span, by: name)
    }
    return recordSyntax(
        ref c,
        for: addCall(
            ref c,
            from: BCall {
                span: call.span,
                function: fn,
                receiver: -1,
                arguments: [args[0], radix],
                type: c.functions[fn].returnType,
            },
        ),
        from: in syntax,
    )
}

/// BinderCalls.cs:174-178, :239-243: inside a `try` operand an unhandled failing call is collected in `covered` (Q731),
/// elsewhere reported. The C# passes the `CallExpr`, so `structLiteral` (`c is StructLiteralExpr`) is false.
void t20Unhandled(ref Binder b, through ref Ctx c, at TextSpan span, by string name) {
    if b.covered is not null {
        var covered = b.covered.take() ?? List<CoveredCall>()
        covered.append(CoveredCall { span: span, name: name, structLiteral: false })
        b.covered = move covered
    } else {
        reportUnhandled(ref b, through: ref c, at: span, by: name, structLiteral: false)
    }
}

/// BinderCalls.cs:182 BindArgumentsForRecovery.
void bindArgumentsForRecovery(ref Binder b, through ref Ctx c, for in parser.CallExpr call) =>
    bindArgumentListForRecovery(ref b, through: ref c, for: in call.args)

/// C# `BindArgumentsForRecovery` on the arguments `args` alone (Q656).
void bindArgumentListForRecovery(ref Binder b, through ref Ctx c, for in List<parser.Argument> args) {
    for a in args {
        // A lambda or `it` argument has no type to bind with once the call failed.
        continue if t20IsLambda(a.value)
            || t20IsInterpolated(a.value)
            || t20MentionedIt(c, from: b.file, for: a.value) is not null
        continue if b.prebound.remove(a.span.start)
        let _ = bindExprOrType(ref b, through: ref c, for: in a.value)
    }
}

bool t20IsLambda(parser.Expr e) {
    switch e {
        case .lambdaExpr(_): return true
        default: return false
    }
}

bool t20IsInterpolated(parser.Expr e) {
    switch e {
        case .interpolatedExpr(_): return true
        default: return false
    }
}

/// BinderCalls.cs:198 BindFunctionCall.
BExpr bindFunctionCall(
    ref Binder b,
    through ref Ctx c,
    for in parser.CallExpr call,
    by FuncId fn,
    from BExpr receiver,
    at parser.Expr syntax,
    in List<parser.TypeSyntax>? typeArgs = null
) {
    var target = fn
    let explicit = (typeArgs is { } ta) && ta.length > 0
    if c.functions[fn].typeParams.length > 0 || explicit {
        var instance: FuncId = -1
        if typeArgs is not null {
            instance = t20Instantiate(ref b, through: ref c, for: call, by: fn, from: typeArgs)
        } else {
            let none = List<parser.TypeSyntax>()
            instance = t20Instantiate(ref b, through: ref c, for: call, by: fn, from: none)
        }
        if instance == -1 {
            bindArgumentsForRecovery(ref b, through: ref c, for: in call)
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }), from: in syntax)
        }
        target = instance
    }
    let outer = b.printArgument
    let outerSink = b.sinkArgument
    let builtin = c.functions[target].builtin
    b.printArgument = builtin is .print or .log
    b.sinkArgument = builtin == .ioRun ? "Io.run" : builtin == .ioRunBatch ? "Io.runBatch" : null
    // An invoke symbol's parameters have no names or particles, so a call through a value is positional (R9).
    let kind = c.functions[target].kind
    let name = kind == .invoke ? t15Text(
        in c,
        from: b.file,
        at: parser.exprSpan(in call.callee),
    ) : c.functions[target].name
    let ps = copyIds(in c.functions[target].parameters)
    let args = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in ps,
        as: target,
        enforceNames: kind != .builtin && kind != .invoke,
        displayName: name,
    )
    b.printArgument = outer
    b.sinkArgument = outerSink
    var recv = receiver
    if recv != -1 {
        let wanted = receiverStates(ref b, through: ref c, for: target)
        if wanted != -1 {
            let fnName = c.functions[target].name
            let _ = reportWrongState(
                ref b,
                through: ref c,
                for: fnName,
                by: recv,
                as: wanted,
                at: nodeSpan(in c, for: recv),
            )
        }
    }
    // A call that `becomes` changes the receiver's state; a statement learns the new state after it (`LearnBecomes`). A call
    // without `becomes` leaves it as it was (revision 0010).
    let facts = t20DeclFacts(c, for: target)
    if recv != -1 && (facts.becomes is { } to) {
        @unobservable because "Q616: knownState and forgetState are stubs; add a ref and out argument of a known state when T22 lands"
        if (subject(ref b, through: ref c, for: recv) is { } changed) {
            forgetState(ref b, for: changed.key)
        }
        if boundKind(recv) == .thisRef && b.fn != -1 {
            @unobservable because "Q616: checkBecomesCall and declareSignature are stubs; add a becomes call case when T22 and T38 land"
            checkBecomesCall(ref b, through: ref c, for: in call, from: b.fn, by: target, to: to)
        } else if boundKind(recv) == .local
                && c.locals[c.bLocals[boundIndex(recv)].local].isParameter
                && c.locals[c.bLocals[boundIndex(recv)].local].modifier == .refKeyword {
            @unobservable because "Q616: checkBecomesCall and declareSignature are stubs; add a becomes call case when T22 and T38 land"
            let param = c.locals[c.bLocals[boundIndex(recv)].local].name
            report(
                ref b,
                through: ref c,
                for: .becomesOnRefParameter,
                at: call.span,
                by: (c.functions[target].name, param, "", "", ""),
                help: $"take `{param}` by `move` and return the new state as a value",
            )
        }
    }
    // A `ref this` call on `map[key]` changes the stored value in place.
    if recv != -1 && c.functions[target].isMutating {
        recv = mapWriteTarget(ref c, for: recv)
    }
    // A `dyn ref` writes through the borrow, not into the local holding it; `dyn ref readonly` is BYN2813.
    if recv != -1 && functionHasThis(ref c, by: target) && kindOf(exprType(in c, for: recv)) != .dynRef {
        c.mutationChecks.append(
            MutationCheck { source: b.file, function: host(b, through: c), callee: target, receiver: recv },
        )
    }
    var anyConstant = false
    for a in args {
        if exprConstant(in c, for: a) is not null {
            anyConstant = true
        }
    }
    if facts.expects && anyConstant {
        var written = List<Location>()
        for a in call.args {
            written.append(Location { file: b.file, span: parser.exprSpan(in a.value) })
        }
        // A default is bound in the callee's file (`parameterDefault`), a written argument in the caller's (Q582).
        var files = List<FileId>()
        for i in 0..args.length {
            let isDefault = args[i] != -1 && args[i] == c.locals[ps[i]].defaultValue
            files.append(isDefault ? c.functions[target].file : b.file)
        }
        c.requiresChecks.append(
            RequiresCheck {
                source: b.file,
                callSpan: call.span,
                callArgs: move written,
                callee: target,
                arguments: copyIds(in args),
                argumentFiles: move files,
            },
        )
    }
    if c.functions[target].hasFails && !((b.handled is { } h) && h == call.span) {
        t20Unhandled(ref b, through: ref c, at: call.span, by: name)
    }
    let type = recv == -1 ? c.functions[target].returnType : returnTypeThrough(
        ref b,
        through: ref c,
        for: exprType(in c, for: recv),
        by: target,
    )
    return recordSyntax(
        ref c,
        for: addCall(
            ref c,
            from: BCall { span: call.span, function: target, receiver: recv, arguments: move args, type: type },
        ),
        from: in syntax,
    )
}

/// C# `fn.Decl`'s `Requires.Length > 0` (`expects`) and `Becomes`, read from the function's declaration where `t12Params` finds it.
struct T20DeclFacts {
    bool      expects = false
    TextSpan? becomes = null
}

T20DeclFacts t20DeclFacts(Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    return T20DeclFacts {} if d < 0
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n): return T20DeclFacts {
            expects: n.value.requiresClauses.length > 0,
            becomes: n.value.becomes,
        }
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return T20DeclFacts {
                    expects: x.value.requiresClauses.length > 0,
                    becomes: x.value.becomes,
                }
                default: break
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return T20DeclFacts {
                    expects: x.value.requiresClauses.length > 0,
                    becomes: x.value.becomes,
                }
                default: break
            }
        case .extensionDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return T20DeclFacts {
                    expects: x.value.requiresClauses.length > 0,
                    becomes: x.value.becomes,
                }
                default: break
            }
        default:
            break
    }
    return T20DeclFacts {}
}

/// BinderCalls.cs:254 Instantiate: the instantiation a call of a generic function means: its type arguments are explicit
/// (`pick<i64>(…)`) or inferred by unifying parameter types with argument types; -1 for none.
FuncId t20Instantiate(
    ref Binder b,
    through ref Ctx c,
    for parser.CallExpr call,
    by FuncId fn,
    from List<parser.TypeSyntax> typeArgs
) {
    let parameters = copyIds(in c.functions[fn].typeParams)
    let name = c.functions[fn].name
    if typeArgs.length > 0 {
        if typeArgs.length != parameters.length {
            report(
                ref b,
                through: ref c,
                for: .genericArgumentCount,
                at: parser.exprSpan(in call.callee),
                by: (name, $"{parameters.length}", $"{typeArgs.length}", "", ""),
                help: parameters.length == 0 ? $"remove the type arguments; `{name}` is not generic" : "",
            )
            return -1
        }
        var explicitArgs = List<Type>()
        for t in typeArgs {
            explicitArgs.append(resolveType(ref b, through: ref c, for: in t))
        }
        for a in explicitArgs {
            return -1 if isError(a)
        }
        return instantiateFunction(ref c, for: fn, by: in explicitArgs, from: b.file, at: call.span)
    }
    let fps = copyIds(in c.functions[fn].parameters)
    var found = Map<Type, Type>()
    var conflict = false
    var positional: i64 = 0
    var sawNamed = false
    for arg in call.args {
        var p: LocalId = -1
        if (arg.name is { } n) {
            sawNamed = true
            let text = t15Text(in c, from: b.file, at: n)
            for x in fps {
                if p == -1 && label(ref c, for: x) == text {
                    p = x
                }
            }
        } else if !sawNamed && positional < fps.length {
            p = fps[positional]
            positional += 1
        }
        continue if p == -1 || !occurs(ref c, by: c.locals[p].type) || b.prebound.contains(arg.span.start)
        let pt = c.locals[p].type
        // A lambda or `it` argument never contributes to inference (R12).
        continue if t20IsLambda(arg.value)
        continue if kindOf(pt) == .function
            && c.functionTypes[typeIndex(pt)].parameters.length == 1
            && t20MentionedIt(c, from: b.file, for: arg.value) is not null
        let value = kindOf(
            pt,
        ) == .function ? bindExprFor(
            ref b,
            through: ref c,
            for: in arg.value,
            to: pt,
        ) : bindExpr(ref b, through: ref c, for: in arg.value)
        b.prebound[arg.span.start] = value
        // A known-state local passed `ref` or `out` is inferred from its declared type, as `BindArgument` passes it (Q295).
        // A module function named for a function-typed parameter is inferred from its signature (R12).
        var type = exprType(in c, for: value)
        let modifier = c.locals[p].modifier
        if (modifier is .refKeyword or .outKeyword) && boundKind(value) == .local
                && knownState(ref b, for: c.bLocals[boundIndex(value)].local) != -1 {
            type = c.locals[c.bLocals[boundIndex(value)].local].type
        } else if boundKind(value) == .methodGroup && c.bMethodGroups[boundIndex(value)].receiver == -1 {
            let named = c.bMethodGroups[boundIndex(value)].function
            if c.functions[named].kind == .function
                    && c.functions[named].owner == -1
                    && !functionIsGeneric(ref c, by: named) {
                var types = List<Type>()
                for x in c.functions[named].parameters {
                    types.append(c.locals[x].type)
                }
                let sets = copyIds(in c.functions[named].errorSets)
                type = internFunction(
                    ref c,
                    for: in types,
                    to: c.functions[named].returnType,
                    by: in sets,
                    as: in List<string>(),
                )
            }
        }
        if !t20Unify(
            ref b,
            through: ref c,
            for: pt,
            as: type,
            by: ref found,
            from: fn,
            at: parser.exprSpan(in arg.value)
        ) {
            conflict = true
        }
    }
    return -1 if conflict
    var args = List<Type>()
    for tp in parameters {
        if (found.tryGet(at: typeParamTypeOf(tp)) is { } t) {
            args.append(t)
        } else {
            var names = List<string>()
            for x in parameters {
                names.append(c.typeParams[x].name)
            }
            report(
                ref b,
                through: ref c,
                for: .cannotInferTypeArgument,
                at: parser.exprSpan(in call.callee),
                by: (c.typeParams[tp].name, name, "", "", ""),
                help: $"pass an argument it can be read from, or write it out: `{name}<{names.joined(by: ", ")}>(…)`",
            )
            return -1
        }
    }
    return instantiateFunction(ref c, for: fn, by: in args, from: b.file, at: call.span)
}

/// BinderCalls.cs:312 Unify: matches a parameter type against an argument type, binding the type parameters of `fn`;
/// false on a conflict (reported).
bool t20Unify(
    ref Binder b,
    through ref Ctx c,
    for Type p,
    as Type a,
    by ref Map<Type,
    Type> found,
    from FuncId fn,
    at TextSpan span
) {
    return true if isError(a) || isNever(a) || kindOf(a) == .nullType
    let i = typeIndex(p)
    let ak = kindOf(a)
    let ai = typeIndex(a)
    switch kindOf(p) {
        case .typeParam:
            return true if !t15ContainsLocal(in c.functions[fn].typeParams, for: i)
            if (found.tryGet(at: p) is { } previous) {
                let shared = common(ref c, for: previous, as: a)
                if shared != -1 {
                    found[p] = shared
                    return true
                }
                let name = c.functions[fn].name
                report(
                    ref b,
                    through: ref c,
                    for: .conflictingTypeArgument,
                    at: span,
                    by: (c.typeParams[i].name, name, typeDisplay(ref c, by: previous), typeDisplay(ref c, by: a), ""),
                    help: $"make the arguments agree, or write it out: `{name}<…>(…)`",
                )
                return false
            }
            found[p] = a
            return true
        case .optional:
            return t20Unify(
                ref b,
                through: ref c,
                for: c.optionalTypes[i],
                as: ak == .optional ? c.optionalTypes[ai] : a,
                by: ref found,
                from: fn,
                at: span,
            )
        case .span:
            let element = c.spanTypes[i].element
            switch ak {
                case .span: return t20Unify(
                    ref b,
                    through: ref c,
                    for: element,
                    as: c.spanTypes[ai].element,
                    by: ref found,
                    from: fn,
                    at: span,
                )
                case .list: return t20Unify(
                    ref b,
                    through: ref c,
                    for: element,
                    as: c.listTypes[ai],
                    by: ref found,
                    from: fn,
                    at: span,
                )
                case .array: return t20Unify(
                    ref b,
                    through: ref c,
                    for: element,
                    as: c.arrayTypes[ai].element,
                    by: ref found,
                    from: fn,
                    at: span,
                )
                default: return true
            }
        case .list:
            return ak != .list
                || t20Unify(
                    ref b,
                    through: ref c,
                    for: c.listTypes[i],
                    as: c.listTypes[ai],
                    by: ref found,
                    from: fn,
                    at: span,
                )
        case .map:
            return ak != .map
                || t20Unify(
                    ref b,
                    through: ref c,
                    for: c.mapTypes[i].key,
                    as: c.mapTypes[ai].key,
                    by: ref found,
                    from: fn,
                    at: span,
                )
                && t20Unify(
                    ref b,
                    through: ref c,
                    for: c.mapTypes[i].value,
                    as: c.mapTypes[ai].value,
                    by: ref found,
                    from: fn,
                    at: span,
                )
        case .array:
            return ak != .array
                || t20Unify(
                    ref b,
                    through: ref c,
                    for: c.arrayTypes[i].element,
                    as: c.arrayTypes[ai].element,
                    by: ref found,
                    from: fn,
                    at: span,
                )
        case .tuple:
            return true if ak != .tuple || c.tupleTypes[ai].length != c.tupleTypes[i].length
            for k in 0..c.tupleTypes[i].length {
                return false if !t20Unify(
                    ref b,
                    through: ref c,
                    for: c.tupleTypes[i][k].type,
                    as: c.tupleTypes[ai][k].type,
                    by: ref found,
                    from: fn,
                    at: span,
                )
            }
            return true
        case .result:
            return ak != .result
                || t20Unify(
                    ref b,
                    through: ref c,
                    for: c.resultTypes[i].value,
                    as: c.resultTypes[ai].value,
                    by: ref found,
                    from: fn,
                    at: span,
                )
        case .function:
            return true if ak != .function
                || c.functionTypes[ai].parameters.length != c.functionTypes[i].parameters.length
            for k in 0..c.functionTypes[i].parameters.length {
                return false if !t20Unify(
                    ref b,
                    through: ref c,
                    for: c.functionTypes[i].parameters[k],
                    as: c.functionTypes[ai].parameters[k],
                    by: ref found,
                    from: fn,
                    at: span,
                )
            }
            return t20Unify(
                ref b,
                through: ref c,
                for: c.functionTypes[i].ret,
                as: c.functionTypes[ai].ret,
                by: ref found,
                from: fn,
                at: span,
            )
        case .structType:
            let template = c.structs[i].template
            return true if template == -1
            return true if ak != .structType || c.structs[ai].template != template
            let n = c.structs[i].typeArgs.length < c.structs[ai].typeArgs.length ? c.structs[i].typeArgs.length : c.structs[ai].typeArgs.length
            for k in 0..n {
                return false if !t20Unify(
                    ref b,
                    through: ref c,
                    for: c.structs[i].typeArgs[k],
                    as: c.structs[ai].typeArgs[k],
                    by: ref found,
                    from: fn,
                    at: span,
                )
            }
            return true
        case .unionType:
            let template = c.unions[i].template
            return true if template == -1
            return true if ak != .unionType || c.unions[ai].template != template
            let n = c.unions[i].typeArgs.length < c.unions[ai].typeArgs.length ? c.unions[i].typeArgs.length : c.unions[ai].typeArgs.length
            for k in 0..n {
                return false if !t20Unify(
                    ref b,
                    through: ref c,
                    for: c.unions[i].typeArgs[k],
                    as: c.unions[ai].typeArgs[k],
                    by: ref found,
                    from: fn,
                    at: span,
                )
            }
            return true
        default:
            return true
    }
}

/// BinderCalls.cs:366 BindArguments.
List<BExpr> bindArguments(
    ref Binder b,
    through ref Ctx c,
    for in parser.CallExpr call,
    by in List<LocalId> ps,
    as FuncId fn,
    bool enforceNames,
    string displayName = ""
) =>
    t21BindArgumentList(
        ref b,
        through: ref c,
        for: in call.args,
        at: call.span,
        by: in ps,
        as: fn,
        enforceNames: enforceNames,
        displayName: displayName,
        syntax: syntaxOfCall(ref c, from: in call),
    )

/// C# `BindArguments` on the arguments `args` of a call spanning `span`: `bindArguments` reads nothing else of its `CallExpr`, and
/// `bindBecome` has no `CallExpr` to pass (C# builds one around `b.Args`, BinderStates.cs:14; Q656).
List<BExpr> bindArgumentList(
    ref Binder b,
    through ref Ctx c,
    for in List<parser.Argument> args,
    at TextSpan span,
    by in List<LocalId> ps,
    as FuncId fn,
    bool enforceNames,
    string displayName = ""
) =>
    t21BindArgumentList(
        ref b,
        through: ref c,
        for: in args,
        at: span,
        by: in ps,
        as: fn,
        enforceNames: enforceNames,
        displayName: displayName,
        syntax: -1,
    )

/// `bindArgumentList` where `syntax` is the recorded `CallExpr` (`syntaxNode`) the nodes it builds take as their C# `Syntax` (Q849).
List<BExpr> t21BindArgumentList(
    ref Binder b,
    through ref Ctx c,
    for in List<parser.Argument> args,
    at TextSpan span,
    by in List<LocalId> ps,
    as FuncId fn,
    bool enforceNames,
    string displayName = "",
    i64 syntax = -1
) {
    let name = displayName != "" ? displayName : fn != -1 ? c.functions[fn].name : "?"
    // An instantiation follows its template's rule, so a `T` parameter is not a `bool` one at `T = bool`.
    let template = fn != -1 ? c.functions[fn].template : -1
    let rule = template != -1 ? copyIds(in c.functions[template].parameters) : copyIds(in ps)
    var result = List<BExpr>()
    var given = List<bool>()
    for _ in ps {
        result.append(-1)
        given.append(false)
    }
    var sawNamed = false
    var positional: i64 = 0
    var mismatched = false
    // A `rest` tail takes every positional argument from its place on; parameters after it are named only (J64).
    var rest: LocalId = -1
    for x in ps {
        if rest == -1 && (t20Param(c, for: x).syntax is { } s) && s.isRest && kindOf(c.locals[x].type) == .span {
            rest = x
        }
    }
    var tail = List<i64>()
    for ai in 0..args.length {
        let argSpan = args[ai].span
        var p: LocalId = -1
        if args[ai].name is null && rest != -1 && positional >= c.locals[rest].ordinal {
            tail.append(ai)
            continue
        }
        if (args[ai].name is { } n) {
            sawNamed = true
            let text = t15Text(in c, from: b.file, at: n)
            for x in ps {
                if p == -1 && label(ref c, for: x) == text {
                    p = x
                }
            }
            if p == -1 {
                var labels = List<string>()
                for x in ps {
                    labels.append(label(ref c, for: x))
                }
                let s = suggest(text, by: in labels)
                report(
                    ref b,
                    through: ref c,
                    for: .unknownParameter,
                    at: n,
                    by: (name, text, "", "", ""),
                    help: (s is { } h) ? $"did you mean `{h}`?" : "",
                    hasFix: s is not null,
                    fixSpan: s is not null ? n : null,
                    fixReplacement: s ?? "",
                )
                let _ = t20BindArgumentValue(ref b, through: ref c, for: args[ai], as: -1)
                mismatched = true
                continue
            }
        } else {
            if sawNamed {
                report(ref b, through: ref c, for: .positionalAfterNamed, at: argSpan, by: ("", "", "", "", ""))
                let _ = t20BindArgumentValue(ref b, through: ref c, for: args[ai], as: -1)
                mismatched = true
                continue
            }
            if positional >= ps.length {
                report(
                    ref b,
                    through: ref c,
                    for: .tooManyArguments,
                    at: argSpan,
                    by: (name, $"{ps.length}", "", "", ""),
                )
                let _ = t20BindArgumentValue(ref b, through: ref c, for: args[ai], as: -1)
                positional += 1
                continue
            }
            p = ps[positional]
            positional += 1
            // A particle is part of the function's name, so the call writes it (BYN5005).
            let pname = c.locals[p].name
            let param = t20Param(c, for: p)
            if enforceNames && (param.syntax is { } x) && x.hasParticle {
                let particle = param.label
                report(
                    ref b,
                    through: ref c,
                    for: .argumentNeedsParticle,
                    at: argSpan,
                    by: (pname, particle, "", "", ""),
                    label: $"needs `{particle}:`",
                    help: $"add `{particle}:` before the argument",
                    hasFix: true,
                    fixSpan: TextSpan { start: argSpan.start, length: 0 },
                    fixReplacement: $"{particle}: ",
                )
            } else if enforceNames
                    && isBool(c.locals[rule[c.locals[p].ordinal]].type)
                    && t20ImpliedName(c, from: b.file, for: args[ai].value) != pname {
                report(
                    ref b,
                    through: ref c,
                    for: .argumentMustBeNamed,
                    at: parser.exprSpan(in args[ai].value),
                    by: (pname, "", "", "", ""),
                    help: $"write `{pname}: …`; a `bool` argument says nothing at the call site",
                    hasFix: true,
                    fixSpan: TextSpan { start: argSpan.start, length: 0 },
                    fixReplacement: $"{pname}: ",
                )
            } else if fn != -1 && c.functions[fn].builtin == .ioRun && c.locals[p].ordinal >= 2 {
                // `Io.run`'s options after `args` are named only (015 S6).
                report(
                    ref b,
                    through: ref c,
                    for: .argumentMustBeNamed,
                    at: parser.exprSpan(in args[ai].value),
                    by: (pname, "", "", "", ""),
                    help: $"write `{pname}: …`; `Io.run`'s options are named",
                    hasFix: true,
                    fixSpan: TextSpan { start: argSpan.start, length: 0 },
                    fixReplacement: $"{pname}: ",
                )
            }
        }
        let o = c.locals[p].ordinal
        if given[o] {
            report(
                ref b,
                through: ref c,
                for: .duplicateArgument,
                at: argSpan,
                by: (label(ref c, for: p), "", "", "", ""),
            )
            let _ = b.prebound.remove(argSpan.start)
            continue
        }
        result[o] = t20BindArgument(ref b, through: ref c, for: args[ai], by: p, as: name)
        given[o] = true
    }
    if rest != -1 && !given[c.locals[rest].ordinal] {
        result[c.locals[rest].ordinal] = t20BindRestTail(
            ref b,
            through: ref c,
            for: in args,
            at: span,
            by: rest,
            from: tail,
            to: syntax,
        )
        given[c.locals[rest].ordinal] = true
    }
    var missing = List<string>()
    for i in 0..ps.length {
        continue if given[i]
        let p = ps[i]
        if (t20Param(c, for: p).syntax is { } x) && x.hasDefault && fn != -1 {
            result[i] = parameterDefault(ref c, for: fn, by: p)
                ?? recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
            continue
        }
        if fn != -1 && c.functions[fn].builtin == .log && c.locals[p].ordinal == 1 {
            let info = findEnumMember(ref c, by: typeIndex(t9Type(ref c, for: "LogLevel")), for: "info")
            result[i] = recordSyntaxNode(
                ref c,
                for: addEnumMember(ref c, from: BEnumMember { span: span, member: info }),
                at: syntax,
            )
            continue
        }
        if fn != -1 && c.functions[fn].builtin == .print && c.locals[p].ordinal == 1 {
            let stdout = findEnumMember(ref c, by: typeIndex(t9Type(ref c, for: "Stream")), for: "stdout")
            result[i] = recordSyntaxNode(
                ref c,
                for: addEnumMember(ref c, from: BEnumMember { span: span, member: stdout }),
                at: syntax,
            )
            continue
        }
        if fn != -1 && c.functions[fn].builtin == .ioRun && c.locals[p].ordinal >= 2 {
            result[i] = recordSyntaxNode(
                ref c,
                for: addDefault(ref c, from: BDefault { span: span, type: c.locals[p].type }),
                at: syntax,
            )
            continue
        }
        missing.append(label(ref c, for: p))
        result[i] = recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), at: syntax)
    }
    if missing.length > 0 && !mismatched {
        report(
            ref b,
            through: ref c,
            for: .missingArgument,
            at: span,
            by: (missing.joined(by: "`, `"), name, "", "", ""),
        )
    }
    return result
}

/// BinderCalls.cs:467 BindRestTail: the arguments of a `rest` tail (indexes into `call.args`) as a span literal, which
/// lowers to stack slots in the caller (J62). A lone `..x` passes the span of collection `x`; on anything else it stays a
/// range (J63).
BExpr t20BindRestTail(
    ref Binder b,
    through ref Ctx c,
    for in List<parser.Argument> args,
    at TextSpan span,
    by LocalId p,
    from List<i64> tail,
    to i64 syntax
) {
    let type = c.locals[p].type
    if tail.length == 1 && args[tail[0]].name is null && args[tail[0]].modifier == .none {
        switch args[tail[0]].value {
            case .rangeExpr(let range):
                if range.value.start is .none && range.value.end is not .none && !range.value.inclusive {
                    let collection = bindExpr(ref b, through: ref c, for: in range.value.end)
                    let ct = exprType(in c, for: collection)
                    return collection if isError(ct)
                    let k = kindOf(ct)
                    return convert(
                        ref b,
                        through: ref c,
                        for: collection,
                        to: type,
                        at: parser.exprSpan(in range.value.end),
                        argument: true,
                    ) if k is .list
                        or .span
                        or .array
                    return bindRange(ref b, through: ref c, for: in range.value, to: -1)
                }
            default:
                break
        }
    }
    let element = c.spanTypes[typeIndex(type)].element
    var elements = List<BExpr>()
    for i in tail {
        elements.append(t20BindArgumentValue(ref b, through: ref c, for: args[i], as: element))
    }
    return recordSyntaxNode(
        ref c,
        for: addCollection(ref c, from: BCollection { span: span, type: type, elements: move elements }),
        at: syntax,
    )
}

/// C# `p.Syntax` with `Label(p)`: read from the declaration of the function whose parameter `p` is (Q713); a parameter
/// with no declaration (a builtin's, a variant field, `tryParse`'s) has no syntax and its name for a label.
T12Param t20Param(Ctx c, for LocalId p) {
    let f = t15ParameterOwner(in c, for: p)
    if f != -1 {
        let ps = t12Params(in c, for: f)
        for i in 0..c.functions[f].parameters.length {
            return ps[i] if c.functions[f].parameters[i] == p
        }
    }
    return T12Param { label: c.locals[p].name }
}

/// BinderCalls.cs:481 Label: the label a call writes for `p`: its particle (`to:`), else its name.
string label(ref Ctx c, for LocalId p) => t20Param(c, for: p).label

/// BinderCalls.cs:484 ImpliedName: `verbose` and `opts.verbose` name the argument for a `bool` parameter `verbose`.
string? t20ImpliedName(Ctx c, from FileId f, for parser.Expr e) {
    switch e {
        case .nameExpr(let n):
            return t15Text(in c, from: f, at: n.value.name) if n.value.typeArgs.length == 0
            return null
        case .memberExpr(let m):
            return t15Text(in c, from: f, at: m.value.member) if !m.value.nullConditional
            return null
        default:
            return null
    }
}

/// BinderCalls.cs:491 BindArgument.
BExpr t20BindArgument(ref Binder b, through ref Ctx c, for parser.Argument arg, by LocalId p, as string callee) {
    let pm = c.locals[p].modifier
    let pname = c.locals[p].name
    let ptype = c.locals[p].type
    let wanted: parser.ArgModifier = pm == .refKeyword ? .refKeyword : pm == .outKeyword ? .outKeyword : .none
    // `move x` hands a value to a plain or `move` parameter.
    let given: parser.ArgModifier = arg.modifier == .inKeyword
        || (arg.modifier == .moveKeyword && wanted == .none) ? .none : arg.modifier
    let valueSpan = parser.exprSpan(in arg.value)
    if given != wanted {
        let keyword = wanted == .refKeyword ? "ref" : wanted == .outKeyword ? "out" : ""
        report(
            ref b,
            through: ref c,
            for: .argumentModifierMismatch,
            at: arg.span,
            by: (pname, keyword == "" ? "a plain value" : $"`{keyword}`", "", "", ""),
            hasFix: keyword != "",
            fixSpan: keyword == "" ? null : TextSpan { start: valueSpan.start, length: 0 },
            fixReplacement: keyword == "" ? "" : $"{keyword} ",
        )
    }
    if wanted is .refKeyword or .outKeyword {
        let early = b.prebound.tryGet(at: arg.span.start)
        var place: BExpr = -1
        if early is not null {
            let _ = b.prebound.remove(arg.span.start)
            place = early
        } else {
            place = bindExpr(ref b, through: ref c, for: in arg.value, to: ptype)
        }
        return place if isError(exprType(in c, for: place))
        // A local whose state is known is passed as its declared type. A `ref` callee keeps the state (revision 0010); an `out`
        // callee supplies a new value, so its state is no longer known.
        if boundKind(place) == .local && knownState(ref b, for: c.bLocals[boundIndex(place)].local) != -1 {
            let local = c.bLocals[boundIndex(place)].local
            place = shareSyntax(
                ref c,
                for: addLocal(ref c, from: BLocal { span: c.bLocals[boundIndex(place)].span, local: local }),
                from: place,
            )
            if wanted == .outKeyword {
                forgetState(ref b, for: local)
            }
        } else if boundKind(place) == .thisRef && wanted == .outKeyword {
            forgetState(ref b, for: t15ThisFacts(ref b, through: ref c))
        }
        if early is null {
            constrain(ref b, through: ref c, for: place, to: ptype)
        }
        let placeType = exprType(in c, for: place)
        if placeType != ptype {
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: valueSpan,
                by: (typeDisplay(ref c, by: placeType), typeDisplay(ref c, by: ptype), "", "", ""),
                help: "give a `ref` or `out` argument exactly the parameter's type",
            )
            return recordSyntax(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: valueSpan }),
                from: in arg.value,
            )
        }
        // An `out` argument writes a whole value: a `ref` parameter or `this` keeps its state only when its type names one (BYN7012).
        let isLocal = boundKind(place) == .local
        let refParam = isLocal
            && c.locals[c.bLocals[boundIndex(place)].local].isParameter
            && c.locals[c.bLocals[boundIndex(place)].local].modifier == .refKeyword
        let mutatingThis = boundKind(place) == .thisRef && b.fn != -1 && c.functions[b.fn].isMutating
        let named = (kindOf(placeType) == .state && c.stateTypes[typeIndex(placeType)].states.length > 1)
            || (kindOf(placeType) == .structType && statesOf(ref c, for: typeIndex(placeType)) != -1)
        if wanted == .outKeyword && (refParam || mutatingThis) && named {
            report(
                ref b,
                through: ref c,
                for: .assignmentChangesState,
                at: arg.span,
                by: (isLocal ? c.locals[c.bLocals[boundIndex(place)].local].name : "this", "", "", "", ""),
                help: "assign a value in the same state, or move the transition into a `becomes` method",
            )
        }
        let _ = checkWritable(
            ref b,
            through: ref c,
            for: place,
            at: valueSpan,
            by: $"it is passed as `{wanted == .refKeyword ? "ref" : "out"}`",
        )
        return place
    }
    return t20BindArgumentValue(ref b, through: ref c, for: arg, as: ptype, by: callee)
}

/// BinderCalls.cs:532 BindArgumentValue; `type` -1 and `callee` null where the C# ones are.
BExpr t20BindArgumentValue(
    ref Binder b,
    through ref Ctx c,
    for parser.Argument arg,
    as Type type,
    by string? callee = null
) {
    let valueSpan = parser.exprSpan(in arg.value)
    let early = b.prebound.tryGet(at: arg.span.start)
    var value: BExpr = -1
    if early is not null {
        let _ = b.prebound.remove(arg.span.start)
        value = early
    } else if type != -1
            && kindOf(type) == .function
            && c.functionTypes[typeIndex(type)].parameters.length == 1
            && !t20IsLambda(arg.value)
            && (t20MentionedIt(c, from: b.file, for: arg.value) is { } it) {
        value = t20BindIt(ref b, through: ref c, for: arg.value, by: it, as: type)
    } else {
        let bound = bindExprFor(ref b, through: ref c, for: in arg.value, to: type)
        value = built(ref b, through: ref c, for: bound, from: in arg.value)
    }
    if arg.modifier == .moveKeyword {
        value = bindMove(ref b, through: ref c, at: arg.span, for: value)
    }
    return recordSyntax(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: valueSpan }),
        from: in arg.value,
    ) if (callee is { } who) && type != -1
        && kindOf(type) == .state
        && reportWrongState(ref b, through: ref c, for: who, by: value, as: type, at: valueSpan)
    // A type argument inferred from the value is not a typed use of it.
    return value if type == -1
    return convert(
        ref b,
        through: ref c,
        for: value,
        to: type,
        at: valueSpan,
        argument: true,
        constrains: early is null,
    )
}

/// BinderCalls.cs:547 BindIt: an argument that mentions `it` where a one-parameter function type is expected: a lambda
/// whose parameter is `it`. Inside another, or inside a `requires` rule where `it` is the checked value, it is BYN2029 (R7, Q361).
BExpr t20BindIt(ref Binder b, through ref Ctx c, for parser.Expr e, by TextSpan it, as Type type) {
    if b.itDepth > 0 {
        // Outside any lambda, the `it` in scope is a `requires` rule's checked value.
        report(
            ref b,
            through: ref c,
            for: .nestedIt,
            at: it,
            by: ("", "", "", "", ""),
            help: b.lambdas.length == 0
                ? "name the lambda's parameter: `x => …`"
                : "name the inner lambda's parameter: `x => …`",
        )
        return recordSyntax(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: parser.exprSpan(in e) }),
            from: in e,
        )
    }
    b.itDepth += 1
    var ps = List<TextSpan>()
    ps.append(it)
    let noBlock: parser.BlockStmt? = null
    let lambda = recordSyntaxNode(
        ref c,
        for: bindLambda(
            ref b,
            through: ref c,
            at: parser.exprSpan(in e),
            for: in ps,
            from: in e,
            by: in noBlock,
            to: type,
        ),
        at: syntaxNode(ref c, from: in e),
    )
    b.itDepth -= 1
    return lambda
}

/// BinderCalls.cs:562 MentionedIt: the first `it` the syntax of `e` mentions outside a lambda nested in it.
TextSpan? t20MentionedIt(Ctx c, from FileId f, for parser.Expr e) {
    switch e {
        case .nameExpr(let n):
            return n.value.name if n.value.typeArgs.length == 0 && t15Text(in c, from: f, at: n.value.name) == "it"
            return null
        case .parenExpr(let p): return t20MentionedIt(c, from: f, for: p.value.inner)
        case .memberExpr(let m): return t20MentionedIt(c, from: f, for: m.value.target)
        case .callExpr(let x):
            if (t20MentionedIt(c, from: f, for: x.value.callee) is { } s1) {
                return s1
            }
            for a in x.value.args {
                if (t20MentionedIt(c, from: f, for: a.value) is { } s2) {
                    return s2
                }
            }
            return null
        case .indexExpr(let i): return t20MentionedIt(c, from: f, for: i.value.target)
            ?? t20MentionedIt(c, from: f, for: i.value.index)
        case .unaryExpr(let u): return t20MentionedIt(c, from: f, for: u.value.operand)
        case .binaryExpr(let x): return t20MentionedIt(c, from: f, for: x.value.left)
            ?? t20MentionedIt(c, from: f, for: x.value.right)
        case .rangeExpr(let r): return t20MentionedIt(c, from: f, for: r.value.start)
            ?? t20MentionedIt(c, from: f, for: r.value.end)
        case .conditionalExpr(let x):
            return t20MentionedIt(c, from: f, for: x.value.condition)
                ?? t20MentionedIt(c, from: f, for: x.value.whenTrue)
                ?? t20MentionedIt(c, from: f, for: x.value.whenFalse)
        case .castExpr(let x): return t20MentionedIt(c, from: f, for: x.value.operand)
        case .isExpr(let i): return t20MentionedIt(c, from: f, for: i.value.value)
        case .exceptExpr(let x): return t20MentionedIt(c, from: f, for: x.value.value)
        case .inExpr(let i): return t20MentionedIt(c, from: f, for: i.value.value)
            ?? t20MentionedIt(c, from: f, for: i.value.range)
        case .switchExpr(let s):
            if (t20MentionedIt(c, from: f, for: s.value.value) is { } v3) {
                return v3
            }
            for a in s.value.arms {
                if (t20MentionedIt(c, from: f, for: a.guard) is { } g4) {
                    return g4
                }
                if (t20MentionedIt(c, from: f, for: a.value) is { } v5) {
                    return v5
                }
            }
            return null
        case .tryExpr(let t): return t20MentionedIt(c, from: f, for: t.value.operand)
        case .moveExpr(let m): return t20MentionedIt(c, from: f, for: m.value.operand)
        case .catchExpr(let x):
            return t20MentionedIt(c, from: f, for: x.value.operand) ?? t20MentionedIt(c, from: f, for: x.value.variant)
                ?? t20MentionedIt(c, from: f, for: x.value.handler)
        case .structLiteralExpr(let s):
            for x in s.value.fields {
                if (t20MentionedIt(c, from: f, for: x.value) is { } v6) {
                    return v6
                }
            }
            return null
        case .withExpr(let w):
            if (t20MentionedIt(c, from: f, for: w.value.target) is { } v7) {
                return v7
            }
            for x in w.value.fields {
                if (t20MentionedIt(c, from: f, for: x.value) is { } v8) {
                    return v8
                }
            }
            return null
        case .spreadExpr(let s): return t20MentionedIt(c, from: f, for: s.value.operand)
        case .mapEntryExpr(let m): return t20MentionedIt(c, from: f, for: m.value.key)
            ?? t20MentionedIt(c, from: f, for: m.value.value)
        case .collectionExpr(let x):
            for v in x.value.elements {
                if (t20MentionedIt(c, from: f, for: v) is { } s9) {
                    return s9
                }
            }
            return null
        case .tupleExpr(let t):
            for x in t.value.elements {
                if (t20MentionedIt(c, from: f, for: x.value) is { } s10) {
                    return s10
                }
            }
            return null
        case .interpolatedExpr(let x):
            for part in x.value.parts {
                switch part {
                    case .interpolationHole(let h):
                        if (t20MentionedIt(c, from: f, for: h.value.expr) is { } s11) {
                            return s11
                        }
                    default:
                        break
                }
            }
            return null
        default:
            return null
    }
}
