    public Map<FuncId, List<StorePair>> storeSummaries  = []
    /// C# `Compilation.ReturnSummaries`: for each template with a body, the parameters (or `this`, -1) its result may borrow.
    public Map<FuncId, List<i64>>       returnSummaries = []
    // ── T4 state (spec 018, revision 0021 word classes)
    /// C# `Lexicon.Collectives` and `Lexicon.IrregularPlurals`, filled by `buildLexicon`.
    public List<string> lexiconCollectives      = []
    public List<string> lexiconIrregularPlurals = []
    // ── T10 state (spec 018, branch-review fixes)
    /// C# `Lexicon.IrregularSingulars`: the singular of `lexiconIrregularPlurals[k]` at `k` (Q1208).
    public List<string> lexiconIrregularSingulars = []
    // ── 018 Part 4 follow-up state
    /// The C# `Naming.Grammars` cache (one `Grammar` per `Compilation`): the project dictionary `grammarOf` read, once `grammarKnown`. `Grammar` is unique, so `grammarOf` hands out copies.
    public Grammar grammarRead  = {}
    public bool    grammarKnown = false
}

// ── The binder's cursors ─────────────────────────────────────────────────────

/// C# `_calleeOf` (BinderExpressions.cs:920), as what T18's renamed-call readers use (Q731): a parser node is
/// unique, so the binder keeps the call's spans and argument shape instead. Spans are zero-length where absent.
public struct CalleeOf {
    public TextSpan span
    /// The callee is a `.memberExpr`; `member` and `target` are its member and target spans.
    public bool     isMember      = false
    public TextSpan member        = TextSpan { start: 0, length: 0 }
    public TextSpan target        = TextSpan { start: 0, length: 0 }
    public i64      argCount      = 0
    /// The first two arguments are both unnamed with modifier `.none`.
    public bool     firstTwoPlain = false
    public TextSpan arg0          = TextSpan { start: 0, length: 0 }
    public TextSpan arg1          = TextSpan { start: 0, length: 0 }
}

CalleeOf calleeOfCall(parser.CallExpr call) {
    var r = CalleeOf { span: call.span, argCount: call.args.length }
    switch call.callee {
        case .memberExpr(let me):
            r.isMember = true
            r.member = me.value.member
            r.target = parser.exprSpan(in me.value.target)
        default: {}
    }
    if call.args.length > 0 {
        r.arg0 = parser.exprSpan(in call.args[0].value)
    }
    if call.args.length > 1 {
        r.arg1 = parser.exprSpan(in call.args[1].value)
        r.firstTwoPlain = call.args[0].name is null
            && call.args[0].modifier == .none
            && call.args[1].name is null
            && call.args[1].modifier == .none
    }
    return r
}

/// C# `_covered` entry (BinderCalls.cs:14), as what ReportUnhandled (BinderCalls.cs:944) reads (Q731).
public struct CoveredCall {
    public TextSpan span
    public string   name
    public bool     structLiteral
}

/// The C# `Binder`'s per-body state: the file and function being bound, the scopes, the jump targets
/// and the narrowing facts. Every field is a T1 handle or a parser type.
public struct Binder {
    public FileId                      file           = -1
    public FuncId                      fn             = -1
    public StructId                    owner          = -1
    /// The receiver's type for `this`, or -1.
    public Type                        thisType       = -1
    public i64                         nextLocalId    = 0
    /// The open scopes, innermost last.
    public List<Map<string, LocalId>>  scopes
    /// The enclosing loops and labeled statements.
    public List<JumpTarget>            targets
    public i64                         deferDepth     = 0
    public bool                        inPanicHandler = false
    /// The first statement of the body being bound, or -1.
    public i64                         firstStatement = -1
    public bool                        onPanicSet     = false
    /// A lambda's captured parameters, by the function it belongs to.
    public List<(FuncId, List<BExpr>)> lambdas
    public Map<FuncId, i64>            lambdaCount
    public i64                         itDepth        = 0
    public i64                         held           = 0
    /// C# `_seeds`: the locals a re-bind starts from (`bindFunction`'s second pass), and their types.
    public List<(i64, Type)>           seeds
    /// Flow facts keyed by the `LocalDecl` span start.
    public Map<i64, i64>               pending
    public Map<i64, i64>               constraints
    public Map<i64, i64>               peers
    /// Locals known to be non-null, and their span start.
    public List<(i64, LocalId)>        nonNullLocals
    public List<(i64, LocalId, Type)>  stateFacts
    /// The variant a local's error value was narrowed to.
    public Map<LocalId, VariantId>     errorNarrowed

    // ── Per-task binder state (Q710), as in `Ctx`.
    // ── T15 state
    /// The C# constructor's `typeArgs`, which `_types` resolves with before the function's or struct's map; null for none.
    public Map<string, Type>? typeArgs           = null
    /// The C# `_it`: the field whose own rule is being bound, or -1.
    public FieldId            itField            = -1
    /// The C# `_thisFacts`: the fact key for `this`, made on first use; null until then.
    public LocalId?           thisFacts          = null
    /// The C# `_types` map (see `typeArgs`), taken once by T15's `t15CaptureTypes`; `typesCaptured` says whether it was.
    public Map<string, Type>  types              = []
    public bool               typesCaptured      = false
    /// The C# `Scope` identities, parallel to `scopes` (innermost last); facts keyed by a scope compare these (Q715).
    public List<i64>          scopeIds           = []
    /// The identity the next opened scope takes.
    public i64                nextScopeId        = 0
    /// The C# `_firstStatement`, by its file and full span (Q719); `firstStatementFile` is -1 for none.
    public FileId             firstStatementFile = -1
    public TextSpan           firstStatementSpan = TextSpan { start: 0, length: 0 }
    // ── T16 state
    /// The C# `_handled` (BinderCalls.cs:11): the span (in `file`) of the call a `try`, `catch` or `assert … fails` handles; null for none.
    public TextSpan? handled = null
    // ── T17 state
    /// The C# `_caught` (BinderCalls.cs:17): the local `caught` reads in a `catch` handler, or -1.
    public LocalId caught        = -1
    /// The C# `_printArgument` (BinderCalls.cs:193): an argument of `print` is being converted.
    public bool    printArgument = false
    /// The C# `_sinkArgument` (BinderCalls.cs:196): the sink parameter an argument is converted to, or null.
    public string? sinkArgument  = null
    // ── T18 state
    public CalleeOf? calleeOf = null
    public Map<LocalId, VariantId> narrowed = []
    // ── T19 state
    // ── T20 state
    /// The C# `_prebound` (BinderCalls.cs:248), keyed by the argument's span start in `file` for its identity (Q617).
    public Map<i64, BExpr>    prebound = []
    /// The C# `_covered` (BinderCalls.cs:14): while a `try` operand is bound, the failing calls it does not handle; null outside one.
    public List<CoveredCall>? covered  = null
    // ── T21 state
    /// The C# `_patternOwns` (BinderCalls.cs:906): the patterns being bound are on a `switch move x` subject, so their bindings own their parts.
    public bool patternOwns = false
    // ── T22 state
    // ── T23 state
    // ── T24 state
    // ── T25 state
    // ── T34 state
    // ── T35 state
    // ── T36 state
    // ── T37 state
    // ── T38 state
    // ── T39 state
    // ── T40 state
    // ── T2 state (spec 018, revision 0021 help)
    /// The C# `_thenOf` (BinderStates.cs:97): the `if` statements whose then-branch is being bound, innermost last; `stateTestHelp` reads them.
    /// A parser node is unique, so each entry is (the condition is a member access, its target span, its member span); spans are zero-length otherwise.
    public List<(bool, TextSpan, TextSpan)> thenOf = []
}
== semantics/declare.byn
// T12: Compilation.cs ~655-1037 (variants, payloads, enums, unions, struct members, overloads).

import parser

// The C# `Location`: a file and a span in it.
struct Location {
    FileId   file
    TextSpan span
}

// ── Compilation.cs:922 DeclareMembers ────────────────────────────────────────

void declareMembers(ref Ctx c, for StructId s) {
    let file = c.structs[s].file
    let dIdx = c.structs[s].declIndex
    let module = c.structs[s].module
    switch c.files[file].unit.members[dIdx] {
        case .structDecl(let node):
            let types = TypeResolver { file: file, container: s, typeArgs: t11CopyMap(in c.structs[s].typeMap) }
            var names = Map<string, Location>()
            for b in node.value.bases {
                switch b {
                    case .namedType(let n):
                        let i = resolveInterface(ref c, through: in types, from: file, for: in n.value)
                        continue if i < 0
                        if t12Has(in c.structs[s].bases, for: i) {
                            let iDisp = interfaceDisplayName(ref c, by: i)
                            report(
                                ref c,
                                for: .duplicateConformance,
                                from: file,
                                at: n.value.span,
                                by: (c.structs[s].name, iDisp, "", "", ""),
                                label: "already listed",
                                help: $"remove the second `{iDisp}`",
                            )
                        } else {
                            c.structs[s].bases.append(i)
                            c.baseSpans[$"{s} {i}"] = n.value.span
                        }
                    default:
                        panic("a struct's base is a named type")
                }
            }
            for mIdx in 0..node.value.members.length {
                switch node.value.members[mIdx] {
                    case .fieldDecl(let f):
                        let fName = f.value.name
                        let fMods = f.value.modifiers
                        let fText = t12Text(in c, from: file, at: fName)
                        checkValue(ref c, from: file, at: fName)
                        rejectModifiers(ref c, from: file, at: f.value.span, by: fMods, for: 4 | 32, as: "fields")
                        let hasDefault = f.value.defaultKeyword is not .none
                        let field = newField(ref c, by: FieldSymbol {
                            name: fText,
                            nameSpan: fName,
                            span: fName,
                            owner: s,
                            file: file,
                            declIndex: dIdx,
                            memberIndex: mIdx,
                            access: accessOf(fMods),
                            modifiers: i64(fMods),
                            type: resolve(ref c, through: in types, for: in f.value.type),
                            hasDefault: hasDefault,
                        })
                        if t12Unique(ref c, from: file, at: fName, to: ref names) {
                            c.structs[s].fields.append(field)
                        }
                        if (fMods & 16) != 0 && hasDefault {
                            report(ref c, for: .requiredWithDefault, from: file, at: fName, by: (fText, "", "", "", ""))
                        }
                    case .propertyDecl(let p):
                        let pName = p.value.name
                        let pMods = p.value.modifiers
                        let pText = t12Text(in c, from: file, at: pName)
                        checkValue(ref c, from: file, at: pName)
                        var pType = resolve(ref c, through: in types, for: in p.value.type)
                        if functionTypeNotHere(
                            ref c,
                            for: pType,
                            from: file,
                            at: t8TypeSpan(in p.value.type),
                            as: "a property"
                        ) {
                            pType = errorType()
                        }
                        // C# `Decl` is null for a getter: it is found through its property.
                        let getter = newFunction(ref c, by: FunctionSymbol {
                            name: pText,
                            nameSpan: pName,
                            span: pName,
                            module: module,
                            kind: .getter,
                            access: accessOf(pMods),
                            owner: s,
                            file: file,
                            returnType: pType,
                            typeMap: t11CopyMap(in c.structs[s].typeMap),
                        })
                        let prop = newProperty(ref c, by: PropertySymbol {
                            name: pText,
                            nameSpan: pName,
                            span: pName,
                            owner: s,
                            file: file,
                            declIndex: dIdx,
                            memberIndex: mIdx,
                            access: accessOf(pMods),
                            modifiers: i64(pMods),
                            type: pType,
                            getter: getter,
                        })
                        c.modules[module].allFunctions.append(getter)
                        if t12Unique(ref c, from: file, at: pName, to: ref names) {
                            c.structs[s].properties.append(prop)
                        }
                    case .functionDecl(let m):
                        let mName = m.value.name
                        let mText = t12Text(in c, from: file, at: mName)
                        checkValue(ref c, from: file, at: mName)
                        var typeMap = t11CopyMap(in c.structs[s].typeMap)
                        var ownParameters = List<TypeParamId>()
                        if m.value.typeParams.length > 0 {
                            report(
                                ref c,
                                for: .unsupported,
                                from: file,
                                at: m.value.typeParams[0],
                                by: ("generic methods", "", "", "", ""),
                                help: "declare a generic free function, or make the struct generic",
                            )
                            // Declared anyway, so the signature reports nothing more.
                            let own = declareTypeParameters(
                                ref c,
                                from: file,
                                for: in m.value.typeParams,
                                to: ref ownParameters,
                            )
                                ?? panic("a method with type parameters has a map")
                            for (k, v) in own {
                                if !typeMap.contains(k) {
                                    typeMap[k] = v
                                }
                            }
                        }
                        // C# `Decl = m`: the symbol keeps its `becomes`, `ref this` and `move this` scalars (Q656 (e)).
                        var becomes: string? = null
                        if (m.value.becomes is { } becomesAt) {
                            becomes = t12Text(in c, from: file, at: becomesAt)
                        }
                        let fn = newFunction(ref c, by: FunctionSymbol {
                            name: mText,
                            nameSpan: mName,
                            span: mName,
                            module: module,
                            kind: .method,
                            access: accessOf(m.value.modifiers),
                            isStatic: (m.value.modifiers & 4) != 0,
                            owner: s,
                            file: file,
                            declIndex: dIdx,
                            memberIndex: mIdx,
                            typeMap: t11CopyMap(in typeMap),
                            becomes: becomes,
                            refThis: m.value.refThis,
                            moveThis: m.value.moveThis,
                        })
                        if c.structs[s].template < 0 {
                            // C#'s `typeMap` is null when the struct and the method have no type parameters.
                            if typeMap.length == 0 {
                                declareWhere(
                                    ref c,
                                    from: file,
                                    for: in m.value.where,
                                    to: in ownParameters,
                                    by: null,
                                    as: mText,
                                )
                            } else {
                                declareWhere(
                                    ref c,
                                    from: file,
                                    for: in m.value.where,
                                    to: in ownParameters,
                                    by: t11CopyMap(in typeMap),
                                    as: mText,
                                )
                            }
                        }
                        declareSignature(ref c, for: fn, from: in m.value, by: file, owner: s)
                        let same = findMethods(ref c, by: s, for: mText)
                        var earlier: FuncId = -1
                        for o in same {
                            if earlier < 0 && overlap(ref c, for: o, as: fn) {
                                earlier = o
                            }
                        }
                        if earlier >= 0 {
                            reportDuplicate(
                                ref c,
                                from: file,
                                at: mName,
                                as: loc(c.functions[earlier].file, at: c.functions[earlier].nameSpan),
                            )
                        } else if same.length > 0 || t12Unique(ref c, from: file, at: mName, to: ref names) {
                            c.structs[s].methods.append(fn)
                        }
                        c.modules[module].allFunctions.append(fn)
                    case .typeAliasDecl(let a):
                        let aName = a.value.name
                        let aText = t12Text(in c, from: file, at: aName)
                        if t12IsAssociated(ref c, for: s, as: aText) {
                            checkType(ref c, from: file, at: aName)
                            // Resolved again if an earlier use did so quietly (AssociatedBinding), now reporting.
                            if t12Unique(ref c, from: file, at: aName, to: ref names) {
                                c.associatedBindings[$"{s} {aText}"] = resolve(
                                    ref c,
                                    through: in types,
                                    for: in a.value.target,
                                )
                            }
                        } else {
                            report(
                                ref c,
                                for: .unsupported,
                                from: file,
                                at: a.value.span,
                                by: ("this kind of struct member", "", "", "", ""),
                            )
                        }
                    case .constructorDecl(let k):
                        // `_constructorBodies[fn]` is the constructor's own member (declIndex, memberIndex).
                        let fn = newFunction(ref c, by: FunctionSymbol {
                            name: c.structs[s].name,
                            nameSpan: k.value.name,
                            span: k.value.name,
                            module: module,
                            kind: .constructor,
                            access: accessOf(k.value.modifiers),
                            owner: s,
                            file: file,
                            declIndex: dIdx,
                            memberIndex: mIdx,
                            returnType: structTypeOf(s),
                            typeMap: t11CopyMap(in c.structs[s].typeMap),
                        })
                        declareParameters(ref c, for: fn, from: in k.value.params, by: file, through: in types)
                        if c.structs[s].constructors.length > 0 {
                            report(
                                ref c,
                                for: .unsupported,
                                from: file,
                                at: k.value.name,
                                by: ("overloaded constructors", "", "", "", ""),
                            )
                        } else {
                            c.structs[s].constructors.append(fn)
                        }
                        c.modules[module].allFunctions.append(fn)
                    default:
                        report(
                            ref c,
                            for: .unsupported,
                            from: file,
                            at: t11DeclSpan(in node.value.members[mIdx]),
                            by: ("this kind of struct member", "", "", "", ""),
                        )
                }
            }
            declareCheck(ref c, for: s)
        case .typeAliasDecl(let a):
            // `type distinct` (Compilation.cs:455): a struct with no bases and one public field `value` at the target,
            // carrying the alias's `requires`. `CheckValue("value")`, `Unique` on an empty map and the modifier checks
            // on `Public` report nothing, so only the field is built; its `modifiers` stay 0, as only the `required`
            // and `readonly` bits are read, and its syntax is the alias (`declIndex`), so it has no `memberIndex`.
            let types = TypeResolver { file: file, container: s, typeArgs: t11CopyMap(in c.structs[s].typeMap) }
            let target = t8TypeSpan(in a.value.target)
            let field = newField(ref c, by: FieldSymbol {
                name: "value",
                nameSpan: target,
                span: target,
                owner: s,
                file: file,
                declIndex: dIdx,
                access: .publicKeyword,
                type: resolve(ref c, through: in types, for: in a.value.target),
            })
            c.structs[s].fields.append(field)
            declareCheck(ref c, for: s)
        default:
            panic("a struct is declared by a `StructDecl` or a `type distinct`")
    }
}

// ── Compilation.cs:718 DeclareVariants ───────────────────────────────────────

void declareVariants(ref Ctx c, for ErrorSetId set) {
    let file = c.errorSets[set].file
    let dIdx = c.errorSets[set].declIndex
    switch c.files[file].unit.members[dIdx] {
        case .errorEnumDecl(let node):
            for vIdx in 0..node.value.variants.length {
                let vName = node.value.variants[vIdx].name
                let vText = t12Text(in c, from: file, at: vName)
                checkValue(ref c, from: file, at: vName)
                let existing = findErrorVariant(ref c, by: set, for: vText)
                if existing >= 0 {
                    reportDuplicate(
                        ref c,
                        from: file,
                        at: vName,
                        as: loc(c.errorVariants[existing].file, at: c.errorVariants[existing].nameSpan),
                    )
                    continue
                }
                let sym = newErrorVariant(ref c, by: ErrorVariantSymbol {
                    name: vText,
                    nameSpan: vName,
                    span: vName,
                    set: set,
                    file: file,
                    declIndex: dIdx,
                    memberIndex: vIdx,
                    code: c.errorVariants.length + 1,
                    doc: node.value.variants[vIdx].doc,
                })
                c.errorSets[set].variants.append(sym)
                var seen = false
                for aIdx in 0..node.value.variants[vIdx].attributes.length {
                    let aSpan = node.value.variants[vIdx].attributes[aIdx].span
                    let aName = node.value.variants[vIdx].attributes[aIdx].name
                    let aText = t12Text(in c, from: file, at: aName)
                    if aText == "cases" {
                        report(
                            ref c,
                            for: .modifierNotAllowed,
                            from: file,
                            at: aSpan,
                            by: ("@cases", "", "", "", ""),
                            help: "put `@cases(...)` on a test that takes parameters",
                        )
                    } else if aText != "exitCode" {
                        report(
                            ref c,
                            for: .unknownAttribute,
                            from: file,
                            at: aName,
                            by: (aText, "", "", "", ""),
                            help: "use `@exitCode(n)`; it is the only attribute an error variant takes",
                        )
                    } else if seen {
                        report(
                            ref c,
                            for: .modifierNotAllowed,
                            from: file,
                            at: aSpan,
                            by: ("@exitCode", "", "", "", ""),
                            help: "remove the repeated attribute",
                        )
                    } else {
                        seen = true
                        c.exitCodes.append(
                            ExitCodeRef {
                                variant: sym,
                                attribute: SyntaxRef {
                                    file: file,
                                    declIndex: dIdx,
                                    memberIndex: vIdx,
                                    itemIndex: aIdx,
                                },
                            },
                        )
                    }
                }
            }
            if c.errorSets[set].variants.length == 0 {
                report(
                    ref c,
                    for: .emptyErrorSet,
                    from: file,
                    at: node.value.name,
                    by: (c.errorSets[set].name, "", "", "", ""),
                )
            }
        default:
            panic("an error set is declared by an `ErrorEnumDecl`")
    }
}

// ── Compilation.cs:753 DeclarePayloads ───────────────────────────────────────

void declarePayloads(ref Ctx c, for ErrorSetId set) {
    let file = c.errorSets[set].file
    let dIdx = c.errorSets[set].declIndex
    switch c.files[file].unit.members[dIdx] {
        case .errorEnumDecl(let node):
            let types = TypeResolver { file: file }
            for v in node.value.variants {
                let sym = findErrorVariant(ref c, by: set, for: t12Text(in c, from: file, at: v.name))
                continue if sym < 0 || c.errorVariants[sym].nameSpan != v.name
                var names = Map<string, Location>()
                for f in v.fields {
                    let fText = t12Text(in c, from: file, at: f.name)
                    checkValue(ref c, from: file, at: f.name)
                    if (names.tryGet(at: fText) is { } prev) {
                        reportDuplicate(ref c, from: file, at: f.name, as: prev)
                        continue
                    }
                    names[fText] = loc(file, at: f.name)
                    var type = resolve(ref c, through: in types, for: in f.type)
                    if functionTypeNotHere(
                        ref c,
                        for: type,
                        from: file,
                        at: t8TypeSpan(in f.type),
                        as: "an error payload"
                    ) {
                        type = errorType()
                    }
                    let p = newLocal(ref c, by: LocalSymbol {
                        name: fText,
                        nameSpan: f.name,
                        span: f.name,
                        type: type,
                        kind: .parameter,
                        isParameter: true,
                        modifier: .none,
                        ordinal: c.errorVariants[sym].fields.length,
                    })
                    c.errorVariants[sym].fields.append(p)
                }
            }
        default:
            panic("an error set is declared by an `ErrorEnumDecl`")
    }
}

// ── Compilation.cs:778 CheckComposition ──────────────────────────────────────

void checkComposition(ref Ctx c, for AliasId alias, from in parser.ErrorSetDecl decl) {
    let file = c.aliases[alias].file
    let expanded = expandAlias(ref c, through: in TypeResolver { file: file }, for: alias)
    var sets = List<ErrorSetId>()
    if kindOf(expanded) == .errorUnion {
        sets = copyIds(in c.errorUnionTypes[typeIndex(expanded)].sets)
    } else if kindOf(expanded) == .errorSet {
        sets.append(typeIndex(expanded))
    }
    var owners = Map<string, ErrorSetId>()
    for set in sets {
        for v in copyIds(in c.errorSets[set].variants) {
            let name = c.errorVariants[v].name
            // Instantiations of one generic set are distinct components, matched by type (revision 0011).
            if (owners.tryGet(at: name) is { } owner) {
                if c.errorSets[owner].file != c.errorSets[set].file
                        || c.errorSets[owner].declIndex != c.errorSets[set].declIndex {
                    let first = errorSetDisplayName(ref c, by: owner)
                    let second = errorSetDisplayName(ref c, by: set)
                    report(
                        ref c,
                        for: .duplicateErrorCase,
                        from: file,
                        at: decl.head,
                        by: (first, second, name, "", ""),
                        label: $"two cases `{name}`",
                        help: "rename one case, or compose fewer sets",
                    )
                }
            } else {
                owners[name] = set
            }
        }
    }
}

// ── Compilation.cs:793 DeclareEnumMembers ────────────────────────────────────

/// One `EnumMember` of the C# declaration: its name and doc.
struct T12Member {
    TextSpan name
    string?  doc = null
}

void declareEnumMembers(ref Ctx c, for EnumId e) {
    let file = c.enums[e].file
    declareEnumFields(ref c, for: e)
    // `T.Field`'s declaration (Compilation.cs:393) has the struct's fields as members, with no doc.
    var members = List<T12Member>()
    switch c.files[file].unit.members[c.enums[e].declIndex] {
        case .enumDecl(let node):
            for m in node.value.members {
                members.append(T12Member { name: m.name, doc: m.doc })
            }
        case .structDecl(let node):
            for m in node.value.members {
                switch m {
                    case .fieldDecl(let f): members.append(T12Member { name: f.value.name })
                    default: continue
                }
            }
        default:
            panic("an enum is declared by an `EnumDecl` or its struct")
    }
    for m in members {
        let text = t12Text(in c, from: file, at: m.name)
        // The fields of `T.Field` were checked on the struct.
        if c.enums[e].fieldsOf < 0 {
            checkValue(ref c, from: file, at: m.name)
        }
        let existing = findEnumMember(ref c, by: e, for: text)
        if existing >= 0 {
            if c.enums[e].fieldsOf < 0 {
                report(
                    ref c,
                    for: .duplicateEnumMember,
                    from: file,
                    at: m.name,
                    by: (c.enums[e].name, text, "", "", ""),
                    label: $"already declared on line {t12Line(in c, by: loc(file, at: c.enumMembers[existing].nameSpan))}",
                )
            }
            continue
        }
        let sym = newEnumMember(ref c, by: EnumMemberSymbol {
            name: text,
            nameSpan: m.name,
            span: m.name,
            owner: e,
            ordinal: c.enums[e].members.length,
            doc: m.doc,
        })
        c.enums[e].members.append(sym)
    }
    if c.enums[e].members.length == 0 {
        report(
            ref c,
            for: .emptyEnum,
            from: file,
            at: c.enums[e].nameSpan,
            by: (c.enums[e].name, "", "", "", ""),
            help: "add the members, or remove the enum",
        )
    }
    let optional = internOptional(ref c, by: enumTypeOf(e))
    // C# `File` is null; `file` is where the `Location` (the enum's) lives (Q578).
    let fromOrdinal = newFunction(ref c, by: FunctionSymbol {
        name: "fromOrdinal",
        nameSpan: c.enums[e].nameSpan,
        span: c.enums[e].nameSpan,
        module: c.enums[e].module,
        kind: .builtin,
        file: file,
        builtin: .enumFromOrdinal,
        returnType: optional,
        access: .publicKeyword,
        isStatic: true,
    })
    c.functions[fromOrdinal].parameters.append(
        newLocal(
            ref c,
            by: LocalSymbol {
                name: "ordinal",
                type: prim(.i64),
                kind: .parameter,
                isParameter: true,
                modifier: .none,
                ordinal: 0,
            },
        ),
    )
    c.enums[e].fromOrdinal = fromOrdinal
    let parse = newFunction(ref c, by: FunctionSymbol {
        name: "parse",
        nameSpan: c.enums[e].nameSpan,
        span: c.enums[e].nameSpan,
        module: c.enums[e].module,
        kind: .builtin,
        file: file,
        builtin: .enumParse,
        returnType: optional,
        access: .publicKeyword,
        isStatic: true,
    })
    c.functions[parse].parameters.append(
        newLocal(
            ref c,
            by: LocalSymbol {
                name: "name",
                type: prim(.string),
                kind: .parameter,
                isParameter: true,
                modifier: .none,
                ordinal: 0,
            },
        ),
    )
    c.enums[e].parse = parse
}

// ── Compilation.cs:826 DeclareEnumFields ─────────────────────────────────────

void declareEnumFields(ref Ctx c, for EnumId e) {
    let file = c.enums[e].file
    switch c.files[file].unit.members[c.enums[e].declIndex] {
        case .enumDecl(let node):
            let types = TypeResolver { file: file }
            if (node.value.params is { } ps) {
                for pIdx in 0..ps.length {
                    let pName = ps[pIdx].name
                    let text = t12Text(in c, from: file, at: pName)
                    checkValue(ref c, from: file, at: pName)
                    let type = resolve(ref c, through: in types, for: in ps[pIdx].type)
                    let help = "use a number type, `bool`, `rune`, `string` or a plain enum; enum data is stored in static tables"
                    if ps[pIdx].modifier != .none {
                        report(
                            ref c,
                            for: .invalidEnumParameter,
                            from: file,
                            at: ps[pIdx].span,
                            by: (text, "", "", "", ""),
                            label: $"`{t12ModifierName(ps[pIdx].modifier)}` is not allowed here",
                            help: help,
                        )
                    } else if ps[pIdx].defaultKeyword is not .none {
                        report(
                            ref c,
                            for: .invalidEnumParameter,
                            from: file,
                            at: parser.exprSpan(in ps[pIdx].defaultKeyword),
                            by: (text, "", "", "", ""),
                            label: "a default value is not allowed here",
                            help: help,
                        )
                    } else if !isError(type)
                            && !isNumeric(type)
                            && !isBool(type)
                            && type != prim(.char)
                            && !isString(type)
                            && !(kindOf(type) == .enumType && t12PlainEnum(in c, for: typeIndex(type))) {
                        report(
                            ref c,
                            for: .invalidEnumParameter,
                            from: file,
                            at: t8TypeSpan(in ps[pIdx].type),
                            by: (text, "", "", "", ""),
                            label: $"`{typeDisplay(ref c, by: type)}` has no static form",
                            help: help,
                        )
                    } else if findEnumField(ref c, by: e, for: text) >= 0 {
                        let existing = findEnumField(ref c, by: e, for: text)
                        report(
                            ref c,
                            for: .duplicateEnumMember,
                            from: file,
                            at: pName,
                            by: (c.enums[e].name, text, "", "", ""),
                            label: $"already declared on line {t12Line(in c, by: loc(file, at: c.enumFields[existing].nameSpan))}",
                        )
                    } else if text is "name" or "ordinal" {
                        report(
                            ref c,
                            for: .duplicateEnumMember,
                            from: file,
                            at: pName,
                            by: (c.enums[e].name, text, "", "", ""),
                            label: "every enum has it",
                            help: "rename the parameter",
                        )
                    } else {
                        c.enums[e].fields.append(
                            newEnumField(
                                ref c,
                                by: EnumFieldSymbol {
                                    name: text,
                                    nameSpan: pName,
                                    span: pName,
                                    owner: e,
                                    type: type,
                                    index: c.enums[e].fields.length,
                                },
                            ),
                        )
                        continue
                    }
                    // Kept with an error type so the arguments still line up and report nothing more.
                    c.enums[e].fields.append(
                        newEnumField(
                            ref c,
                            by: EnumFieldSymbol {
                                name: text,
                                nameSpan: pName,
                                span: pName,
                                owner: e,
                                type: errorType(),
                                index: c.enums[e].fields.length,
                            },
                        ),
                    )
                }
            }
        case .structDecl(_):
            // `T.Field`: its declaration has no parameters.
            return
        default:
            panic("an enum is declared by an `EnumDecl` or its struct")
    }
}

// ── Compilation.cs:858 DeclareUnionVariants ──────────────────────────────────

void declareUnionVariants(ref Ctx c, for UnionId u) {
    let file = c.unions[u].file
    switch c.files[file].unit.members[c.unions[u].declIndex] {
        case .unionDecl(let node):
            declareVariantList(ref c, for: u, from: node.value.variants, at: node.value.name)
        // A states union (T38 `statesOf`, C# `StatesOf` Compilation.cs:1086) points at its struct.
        case .structDecl(let node):
            declareVariantList(ref c, for: u, from: node.value.states, at: node.value.name)
        default:
            panic("a union is declared by a `UnionDecl` or its struct")
    }
}

void declareVariantList(ref Ctx c, for UnionId u, from List<parser.UnionVariant> variants, at TextSpan nameSpan) {
    let file = c.unions[u].file
    let dIdx = c.unions[u].declIndex
    let types = TypeResolver { file: file, typeArgs: t11CopyMap(in c.unions[u].typeMap) }
    var values = Map<i64, VariantId>()
    var tag: i64 = 0
    for vIdx in 0..variants.length {
        let vName = variants[vIdx].name
        let vText = t12Text(in c, from: file, at: vName)
        checkValue(ref c, from: file, at: vName)
        let existing = findUnionVariant(ref c, by: u, for: vText)
        if existing >= 0 {
            report(
                ref c,
                for: .duplicateUnionVariant,
                from: file,
                at: vName,
                by: (c.unions[u].name, vText, "", "", ""),
                label: $"already declared on line {t12Line(in c, by: loc(file, at: c.unionVariants[existing].nameSpan))}",
            )
            continue
        }
        let hasValue = variants[vIdx].value is not .none
        if hasValue {
            let valueSpan = parser.exprSpan(in variants[vIdx].value)
            if variants[vIdx].fields.length > 0 {
                report(
                    ref c,
                    for: .unionValueOnPayload,
                    from: file,
                    at: valueSpan,
                    by: (vText, "", "", "", ""),
                    label: "only a case without data can have a value",
                    help: "remove the value",
                )
            } else if (t12UnionValue(in variants[vIdx].value) is { } value) {
                tag = value
            } else {
                report(
                    ref c,
                    for: .unionValueNotInteger,
                    from: file,
                    at: valueSpan,
                    by: ("", "", "", "", ""),
                    label: "not an `i32` integer literal",
                    help: "write the value as an integer literal, or remove it",
                )
            }
        }
        let sym = newUnionVariant(ref c, by: UnionVariantSymbol {
            name: vText,
            nameSpan: vName,
            span: vName,
            owner: u,
            file: file,
            declIndex: dIdx,
            memberIndex: vIdx,
            tag: tag,
            doc: variants[vIdx].doc,
        })
        if (values.tryGet(at: tag) is { } same) {
            let at = hasValue ? parser.exprSpan(in variants[vIdx].value) : vName
            let last = c.unions[u].variants[c.unions[u].variants.length - 1]
            let label = hasValue ? "already used" : $"follows `{c.unionVariants[last].name}`, so it is {tag}"
            report(
                ref c,
                for: .duplicateUnionValue,
                from: file,
                at: at,
                by: (c.unionVariants[same].name, vText, $"{tag}", "", ""),
                label: label,
                help: "give each case its own value",
            )
        } else {
            values[tag] = sym
        }
        // C# `tag++` on an `int`, unchecked: it wraps where Bayan's `+` traps.
        if tag == 2147483647 {
            tag = -2147483648
        } else {
            tag += 1
        }
        var names = Map<string, Location>()
        for f in variants[vIdx].fields {
            let fText = t12Text(in c, from: file, at: f.name)
            checkValue(ref c, from: file, at: f.name)
            if (names.tryGet(at: fText) is { } prev) {
                reportDuplicate(ref c, from: file, at: f.name, as: prev)
                continue
            }
            names[fText] = loc(file, at: f.name)
            var type = resolve(ref c, through: in types, for: in f.type)
            if functionTypeNotHere(ref c, for: type, from: file, at: t8TypeSpan(in f.type), as: "a union payload") {
                type = errorType()
            }
            let p = newLocal(ref c, by: LocalSymbol {
                name: fText,
                nameSpan: f.name,
                span: f.name,
                type: type,
                kind: .parameter,
                isParameter: true,
                modifier: .none,
                ordinal: c.unionVariants[sym].fields.length,
            })
            c.unionVariants[sym].fields.append(p)
        }
        c.unions[u].variants.append(sym)
    }
    if c.unions[u].variants.length == 0 {
        report(
            ref c,
            for: .emptyUnion,
            from: file,
            at: nameSpan,
            by: (c.unions[u].name, "", "", "", ""),
            help: "add the variants, or remove the union",
        )
    }
}

// ── Compilation.cs:913 UnionValue ────────────────────────────────────────────

/// An integer literal, optionally negated, that fits the `i32` tag; else null.
i64? t12UnionValue(in parser.Expr e) {
    switch e {
        case .unaryExpr(let u):
            return null if u.value.op != .negate
            return t12UnionLiteral(in u.value.operand, negate: true)
        default:
            return t12UnionLiteral(in e, negate: false)
    }
}

i64? t12UnionLiteral(in parser.Expr e, bool negate) {
    switch e {
        case .literalExpr(let l):
            return null if l.value.kind != .integer || l.value.suffix is not null
            var n = parseInteger(l.value.text)
            if negate {
                n = bigNeg(n)
            }
            return null if bigCmp(n, as: bigFromI64(-2147483648)) < 0 || bigCmp(n, as: bigFromI64(2147483647)) > 0
            return bigToI64(n)
        default:
            return null
    }
}

// ── Compilation.cs:655 CheckOverloads ────────────────────────────────────────

void checkOverloads(ref Ctx c, for ModId module) {
    // `functions` keys in insertion order: every key enters `allFunctions` with it (Compilation.cs:649-651; a `for` over the map copies its lists).
    var keys = List<string>()
    for f in copyIds(in c.modules[module].allFunctions) {
        let n = c.functions[f].name
        if c.functions[f].kind == .function && !listContainsString(in keys, by: n) {
            keys.append(n)
        }
    }
    for key in keys {
        var overloads = copyIds(in c.modules[module].functions[key])
        var i: i64 = 1
        while i < overloads.length {
            var earlier: FuncId = -1
            for j in 0..i {
                if earlier < 0 && overlap(ref c, for: overloads[j], as: overloads[i]) {
                    earlier = overloads[j]
                }
            }
            if earlier < 0 {
                i += 1
                continue
            }
            let fn = overloads[i]
            reportDuplicate(
                ref c,
                from: c.functions[fn].file,
                at: c.functions[fn].nameSpan,
                as: loc(c.functions[earlier].file, at: c.functions[earlier].nameSpan),
            )
            var a: i64 = 0
            while a < c.modules[module].allFunctions.length {
                if c.modules[module].allFunctions[a] == fn {
                    c.modules[module].allFunctions.remove(at: a)
                    break
                }
                a += 1
            }
            overloads.remove(at: i)
        }
        c.modules[module].functions[key] = move overloads
    }
}

// ── Compilation.cs:671 Overlap ───────────────────────────────────────────────

/// What `Overlap` reads of one parameter: C# `Label(p)` and its `Syntax`, `null` where the C# one is (Q713).
struct T12Param {
    string     label
    T12Syntax? syntax = null
}

/// What `Overlap` reads of a parameter's C# `Syntax`: its particle, default and `...`.
struct T12Syntax {
    bool hasParticle
    bool hasDefault
    bool isRest
}

bool overlap(ref Ctx c, for FuncId a, as FuncId b) {
    let pa = t12Params(in c, for: a)
    let pb = t12Params(in c, for: b)
    var labels = Map<string, bool>()
    for p in pb {
        labels[p.label] = true
    }
    var shared = Map<string, bool>()
    for p in pa {
        if labels.contains(p.label) {
            shared[p.label] = true
        }
    }
    for p in pa {
        return false if (p.syntax is { } x) && x.hasParticle && !x.hasDefault && !shared.contains(p.label)
    }
    for p in pb {
        return false if (p.syntax is { } x) && x.hasParticle && !x.hasDefault && !shared.contains(p.label)
    }
    return t12MinPositional(in pa) <= t12MaxPositional(in pb) && t12MinPositional(in pb) <= t12MaxPositional(in pa)
}

i64 t12MinPositional(in List<T12Param> ps) {
    var n: i64 = 0
    for p in ps {
        if (p.syntax is { } x) && !x.hasParticle && !x.hasDefault && !x.isRest {
            n += 1
        }
    }
    return n
}

i64 t12MaxPositional(in List<T12Param> ps) {
    var n: i64 = 0
    for p in ps {
        if (p.syntax is { } x) {
            return 2147483647 if x.isRest
            if !x.hasParticle {
                n += 1
            }
        }
    }
    return n
}

/// `fn`'s parameters, each with its syntax `decl.params[ordinal]` where its declaration has one (the shapes of T15's
/// `bindParameterDefault`, Q713); a function with no such declaration (a builtin, `fromOrdinal`, `parse`, a getter)
/// has parameters with no syntax.
List<T12Param> t12Params(in Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    if d >= 0 {
        switch c.files[f].unit.members[d] {
            case .functionDecl(let n):
                return t12FromSyntax(in c, for: fn, from: in n.value.params)
            case .structDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let x): return t12FromSyntax(in c, for: fn, from: in x.value.params)
                    case .constructorDecl(let x): return t12FromSyntax(in c, for: fn, from: in x.value.params)
                    default: break
                }
            case .interfaceDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let x): return t12FromSyntax(in c, for: fn, from: in x.value.params)
                    default: break
                }
            case .extensionDecl(let n):
                switch n.value.members[m] {
                    case .functionDecl(let x): return t12FromSyntax(in c, for: fn, from: in x.value.params)
                    default: break
                }
            default:
                break
        }
    }
    var result = List<T12Param>()
    for p in c.functions[fn].parameters {
        result.append(T12Param { label: c.locals[p].name })
    }
    return result
}

List<T12Param> t12FromSyntax(in Ctx c, for FuncId fn, from in List<parser.Param> ps) {
    let f = c.functions[fn].file
    var result = List<T12Param>()
    for p in c.functions[fn].parameters {
        let o = c.locals[p].ordinal
        var label = c.locals[p].name
        if (ps[o].particle is { } part) {
            label = t12Text(in c, from: f, at: part)
        }
        result.append(T12Param {
            label: label,
            syntax: T12Syntax {
                hasParticle: ps[o].particle is not null,
                hasDefault: ps[o].defaultKeyword is not .none,
                isRest: ps[o].rest,
            },
        })
    }
    return result
}

// ── Compilation.cs:683 CheckUnique, :695 ReportDuplicate, :701 LocationOf ────

bool checkUnique(ref Ctx c, from FileId file, at TextSpan name) {
    let m = c.files[file].module
    let text = t12Text(in c, from: file, at: name)
    var previous: Location? = null
    if (c.modules[m].types.tryGet(at: text) is { } t) {
        previous = t12LocationOf(in c, for: t)
    } else if (c.modules[m].functions.tryGet(at: text) is { } fs) {
        previous = loc(c.functions[fs[0]].file, at: c.functions[fs[0]].nameSpan)
    } else if (c.modules[m].constants.tryGet(at: text) is { } k) {
        previous = loc(c.consts[k].file, at: c.consts[k].nameSpan)
    }
    if (previous is { } prev) {
        reportDuplicate(ref c, from: file, at: name, as: prev)
        return false
    }
    return true
}

void reportDuplicate(ref Ctx c, from FileId f, at TextSpan name, as Location previous) {
    let where = previous.file == f ? $"line {t12Line(in c, by: previous)}" : $"{c.files[previous.file].displayPath}:{t12Line(in c, by: previous)}"
    report(
        ref c,
        for: .duplicateDeclaration,
        from: f,
        at: name,
        by: (t12Text(in c, from: f, at: name), "", "", "", ""),
        label: $"already declared on {where}",
    )
}

Location? t12LocationOf(in Ctx c, for Type t) {
    let i = typeIndex(t)
    return loc(c.aliases[i].file, at: c.aliases[i].nameSpan) if t8IsAlias(t)
    let k = kindOf(t)
    return loc(c.structs[i].file, at: c.structs[i].nameSpan) if k == .structType
    return loc(c.errorSets[i].file, at: c.errorSets[i].nameSpan) if k == .errorSet
    return loc(c.enums[i].file, at: c.enums[i].nameSpan) if k == .enumType
    return loc(c.unions[i].file, at: c.unions[i].nameSpan) if k == .unionType
    return loc(c.interfaces[i].file, at: c.interfaces[i].nameSpan) if k == .interfaceType
    return null
}

// ── Compilation.cs:712 Loc, :714 AccessOf ────────────────────────────────────

Location loc(FileId file, at TextSpan span) => Location { file: file, span: span }

Accessibility accessOf(parser.Modifiers m) {
    return .publicKeyword if (m & 1) != 0
    return .privateKeyword if (m & 2) != 0
    return .module
}

// ── Helpers ──────────────────────────────────────────────────────────────────

/// The `Unique` local function of `DeclareMembers`.
bool t12Unique(ref Ctx c, from FileId file, at TextSpan name, to ref Map<string, Location> names) {
    let text = t12Text(in c, from: file, at: name)
    if (names.tryGet(at: text) is { } prev) {
        reportDuplicate(ref c, from: file, at: name, as: prev)
        return false
    }
    names[text] = loc(file, at: name)
    return true
}

bool t12Has(in List<InterfaceId> ids, for InterfaceId i) {
    for x in ids {
        return true if x == i
    }
    return false
}

/// `s.Bases.Any(i => i.AssociatedTypes.Any(t => t.Name == name))`.
bool t12IsAssociated(ref Ctx c, for StructId s, as string name) {
    for i in copyIds(in c.structs[s].bases) {
        for t in copyIds(in c.interfaces[i].associatedTypes) {
            return true if c.typeParams[t].name == name
        }
    }
    return false
}

/// `EnumSymbol { Decl.Params: null }`; `T.Field`'s declaration has none.
bool t12PlainEnum(in Ctx c, for EnumId e) {
    switch c.files[c.enums[e].file].unit.members[c.enums[e].declIndex] {
        case .enumDecl(let n): return n.value.params is null
        case .structDecl(_): return true
        default: panic("an enum is declared by an `EnumDecl` or its struct")
    }
}

/// `ParamModifier.ToString().ToLowerInvariant()`.
string t12ModifierName(parser.ParamModifier m) {
    switch m {
        case .none: return "none"
        case .refKeyword: return "ref"
        case .moveKeyword: return "move"
        case .outKeyword: return "out"
        case .inKeyword: return "in"
    }
}

/// C# `Location.Line`.
i64 t12Line(in Ctx c, by Location l) => lineIndex(c.files[l.file].text.span, at: l.span.start) + 1

string t12Text(in Ctx c, from FileId f, at TextSpan span) => $"{getText(c.files[f].text.span, at: span)}"
== semantics/declare2.byn
// T38: Compilation.cs ~1038-1362 (interface members, signatures, parameters, shapes, states, recursion).
//
// C# `_interfaceGetters[getter]` is the getter's own member of the interface: its `declIndex` and
// `memberIndex`, as conformance.byn reads it. `ParameterSymbol.Syntax` is the parameter at the same
// position in its function's declaration, as `t20Param` reads it. `_inReportedCycle` is T38 state.

import parser

// The C# `Fix` `refReceiverFix` returns: the span to replace and its replacement.
struct Fix {
    TextSpan span
    string   replacement
}

// ── Compilation.cs:1038 ValidationErrorOf ────────────────────────────────────

ErrorSetId validationErrorOf(ref Ctx c, for Type t) {
    if (c.validationErrors.tryGet(at: t) is { } found) {
        return found
    }
    let template = typeIndex(t9Type(ref c, for: "ValidationError"))
    let source = c.errorSets[template].file
    let dIdx = c.errorSets[template].declIndex
    let set = newErrorSet(ref c, by: ErrorSetSymbol {
        name: c.errorSets[template].name,
        nameSpan: c.errorSets[template].nameSpan,
        span: c.errorSets[template].span,
        module: c.errorSets[template].module,
        file: source,
        declIndex: dIdx,
        memberIndex: c.errorSets[template].memberIndex,
        access: c.errorSets[template].access,
        of: t,
    })
    var vName = TextSpan { start: 0, length: 0 }
    var vDoc: string? = null
    switch c.files[source].unit.members[dIdx] {
        case .errorEnumDecl(let d):
            vName = d.value.variants[0].name
            vDoc = d.value.variants[0].doc
        default:
            panic("`ValidationError` is declared by a `union error`")
    }
    let invalid = newErrorVariant(ref c, by: ErrorVariantSymbol {
        name: t12Text(in c, from: source, at: vName),
        nameSpan: vName,
        span: vName,
        set: set,
        file: source,
        declIndex: dIdx,
        memberIndex: 0,
        code: c.errorVariants.length + 1,
        doc: vDoc,
    })
    if kindOf(t) == .structType && c.structs[typeIndex(t)].fieldEnum >= 0 {
        let s = typeIndex(t)
        let rule = t9Type(ref c, for: "Rule")
        let ruleFile = c.unions[typeIndex(rule)].file
        let module = t9Module(ref c)
        switch c.files[ruleFile].unit.members[1] {
            case .structDecl(let decl):
                var typeArgs = List<Type>()
                typeArgs.append(t)
                let violation = newStruct(ref c, by: StructSymbol {
                    name: "Violation",
                    nameSpan: decl.value.name,
                    span: decl.value.name,
                    module: module,
                    file: ruleFile,
                    declIndex: 1,
                    access: .publicKeyword,
                    typeArgs: move typeArgs,
                })
                var types = List<Type>()
                types.append(enumTypeOf(c.structs[s].fieldEnum))
                types.append(rule)
                var k: i64 = 0
                for mIdx in 0..decl.value.members.length {
                    switch decl.value.members[mIdx] {
                        case .fieldDecl(let f):
                            if k < types.length {
                                let field = newField(ref c, by: FieldSymbol {
                                    name: t12Text(in c, from: ruleFile, at: f.value.name),
                                    nameSpan: f.value.name,
                                    span: f.value.name,
                                    owner: violation,
                                    file: ruleFile,
                                    declIndex: 1,
                                    memberIndex: mIdx,
                                    access: .publicKeyword,
                                    type: types[k],
                                })
                                c.structs[violation].fields.append(field)
                                k += 1
                            }
                        default:
                            continue
                    }
                }
                let p = newLocal(ref c, by: LocalSymbol {
                    name: "violations",
                    nameSpan: vName,
                    span: vName,
                    type: internList(ref c, by: structTypeOf(violation)),
                    kind: .parameter,
                    isParameter: true,
                    modifier: .none,
                    ordinal: 0,
                })
                c.errorVariants[invalid].fields.append(p)
            default:
                panic("member 1 of the `Rule` file is `struct Violation`")
        }
    }
    c.errorSets[set].variants.append(invalid)
    c.validationErrors[t] = set
    return set
}

// ── Compilation.cs:1060 DeclareCheck ─────────────────────────────────────────

void declareCheck(ref Ctx c, for StructId s) {
    let file = c.structs[s].file
    // `MinBy(r => r.Span.Start)` over the fields' rules, then the struct's: the first of the smallest.
    var hasFirst = false
    var first = TextSpan { start: 0, length: 0 }
    switch c.files[file].unit.members[c.structs[s].declIndex] {
        case .structDecl(let node):
            for m in node.value.members {
                switch m {
                    case .fieldDecl(let f):
                        for r in f.value.requiresClauses {
                            if !hasFirst || r.span.start < first.start {
                                first = r.span
                                hasFirst = true
                            }
                        }
                    default:
                        continue
                }
            }
            for r in node.value.rules {
                if !hasFirst || r.span.start < first.start {
                    first = r.span
                    hasFirst = true
                }
            }
        case .typeAliasDecl(let a):
            for r in a.value.requiresClauses {
                if !hasFirst || r.span.start < first.start {
                    first = r.span
                    hasFirst = true
                }
            }
        default:
            panic("a struct is declared by a `StructDecl` or a `type distinct`")
    }
    return if !hasFirst || c.structs[s].template >= 0
    if structIsGeneric(ref c, by: s) {
        report(ref c, for: .unsupported, from: file, at: first, by: ("`requires` on a generic struct", "", "", "", ""))
        return
    }
    let module = c.structs[s].module
    let check = newFunction(ref c, by: FunctionSymbol {
        name: "requires",
        nameSpan: c.structs[s].nameSpan,
        span: c.structs[s].span,
        module: module,
        kind: .method,
        owner: s,
        file: file,
        access: c.structs[s].access,
        // C# `FunctionSymbol.ReturnType` starts as `void`; Bayan's `returnType` starts as -1.
        returnType: prim(.void),
        hasFails: true,
    })
    let validation = validationErrorOf(ref c, for: structTypeOf(s))
    c.functions[check].errorSets.append(validation)
    c.modules[module].allFunctions.append(check)
    c.checks.append(StructChecks { check: check })
    c.checksOf[s] = c.checks.length - 1
}

// ── Compilation.cs:1082 StatesOf ─────────────────────────────────────────────

UnionId statesOf(ref Ctx c, for StructId s) {
    let file = c.structs[s].file
    let dIdx = c.structs[s].declIndex
    // `s.Decl.States`: a `type distinct` has none.
    var count: i64 = 0
    switch c.files[file].unit.members[dIdx] {
        case .structDecl(let node):
            count = node.value.states.length
        default:
            count = 0
    }
    return -1 if count == 0
    if (c.states.tryGet(at: s) is { } existing) {
        return existing
    }
    // The synthesized `UnionDecl` is the struct's own declaration, its `states` the cases (Q689).
    let u = newUnion(ref c, by: UnionSymbol {
        name: c.structs[s].name,
        nameSpan: c.structs[s].nameSpan,
        span: c.structs[s].span,
        module: c.structs[s].module,
        file: file,
        declIndex: dIdx,
        memberIndex: c.structs[s].memberIndex,
        access: c.structs[s].access,
        typeMap: t11CopyMap(in c.structs[s].typeMap),
    })
    c.states[s] = u
    // An instance's states were checked on the template.
    if c.structs[s].template >= 0 {
        let outer = pushBag(ref c)
        declareUnionVariants(ref c, for: u)
        popBag(ref c, to: outer)
        return u
    }
    declareUnionVariants(ref c, for: u)
    switch c.files[file].unit.members[dIdx] {
        case .structDecl(let node):
            for member in node.value.members {
                var name: string? = null
                switch member {
                    case .functionDecl(let f):
                        if (f.value.modifiers & 4) != 0 {
                            name = t12Text(in c, from: file, at: f.value.name)
                        }
                    case .propertyDecl(let p):
                        if (p.value.modifiers & 4) != 0 {
                            name = t12Text(in c, from: file, at: p.value.name)
                        }
                    default:
                        name = null
                }
                if (name is { } n) {
                    for state in node.value.states {
                        if t12Text(in c, from: file, at: state.name) == n {
                            report(
                                ref c,
                                for: .stateShadowsStatic,
                                from: file,
                                at: state.name,
                                by: (n, c.structs[s].name, "", "", ""),
                                help: "rename the state or the static member",
                            )
                            break
                        }
                    }
                }
            }
        default:
            panic("a struct with states is declared by a `StructDecl`")
    }
    return u
}

// ── Compilation.cs:1110 CheckStateNames ──────────────────────────────────────

void checkStateNames(ref Ctx c, for StructId s) {
    let states = statesOf(ref c, for: s)
    let file = c.structs[s].file
    switch c.files[file].unit.members[c.structs[s].declIndex] {
        case .structDecl(let node):
            for m in node.value.members {
                switch m {
                    case .functionDecl(let f):
                        var names = List<TextSpan>()
                        for n in f.value.receiverStates {
                            names.append(n)
                        }
                        if (f.value.becomes is { } b) {
                            names.append(b)
                        }
                        for n in names {
                            let text = t12Text(in c, from: file, at: n)
                            if states < 0 || findUnionVariant(ref c, by: states, for: text) < 0 {
                                report(
                                    ref c,
                                    for: .unknownState,
                                    from: file,
                                    at: n,
                                    by: (c.structs[s].name, text, "", "", ""),
                                    help: $"check the states declared in `{c.structs[s].name}`",
                                )
                            }
                        }
                    default:
                        continue
                }
            }
        default:
            return
    }
}

// ── Compilation.cs:1131 DeclareInterfaceMembers ──────────────────────────────

void declareInterfaceMembers(ref Ctx c, for InterfaceId i) {
    let file = c.interfaces[i].file
    let dIdx = c.interfaces[i].declIndex
    let module = c.interfaces[i].module
    // The `Unique` local is T12's `t12Unique`, the same function.
    var names = Map<string, Location>()
    var typeMap = t11CopyMap(in c.interfaces[i].typeMap)
    switch c.files[file].unit.members[dIdx] {
        case .interfaceDecl(let node):
            for member in node.value.members {
                switch member {
                    case .associatedTypeDecl(let a):
                        checkType(ref c, from: file, at: a.value.name)
                        continue if !t12Unique(ref c, from: file, at: a.value.name, to: ref names)
                        let text = t12Text(in c, from: file, at: a.value.name)
                        let t = newTypeParam(ref c, by: TypeParam { name: text })
                        c.interfaces[i].associatedTypes.append(t)
                        typeMap[text] = typeParamTypeOf(t)
                    default:
                        continue
                }
            }
            // C#'s `map` is null when `typeMap` is empty; an empty map stands for it.
            let types = TypeResolver { file: file, typeArgs: t11CopyMap(in typeMap) }
            for mIdx in 0..node.value.members.length {
                switch node.value.members[mIdx] {
                    case .associatedTypeDecl(let _):
                        continue
                    case .functionDecl(let m):
                        checkValue(ref c, from: file, at: m.value.name)
                        rejectStatic(ref c, from: file, by: m.value.modifiers, at: m.value.name)
                        // C# `Decl = m`: the symbol keeps its `becomes`, `ref this` and `move this` scalars (Q656 (e)).
                        var becomes: string? = null
                        if (m.value.becomes is { } becomesAt) {
                            becomes = t12Text(in c, from: file, at: becomesAt)
                        }
                        let fn = newFunction(ref c, by: FunctionSymbol {
                            name: t12Text(in c, from: file, at: m.value.name),
                            nameSpan: m.value.name,
                            span: m.value.name,
                            module: module,
                            kind: .method,
                            access: c.interfaces[i].access,
                            modifiers: i64(m.value.modifiers),
                            file: file,
                            declIndex: dIdx,
                            memberIndex: mIdx,
                            iface: i,
                            isAbstract: m.value.body is .none && m.value.expressionBody is .none,
                            isStatic: (m.value.modifiers & 4) != 0,
                            typeMap: t11CopyMap(in typeMap),
                            becomes: becomes,
                            refThis: m.value.refThis,
                            moveThis: m.value.moveThis,
                        })
                        var ownParameters = List<TypeParamId>()
                        if (declareTypeParameters(
                            ref c,
                            from: file,
                            for: in m.value.typeParams,
                            to: ref ownParameters,
                        ) is { } own) {
                            var merged = t11CopyMap(in typeMap)
                            for (k, v) in own {
                                if !typeMap.contains(k) {
                                    merged[k] = v
                                }
                            }
                            c.functions[fn].typeMap = move merged
                        }
                        c.functions[fn].typeParams = copyIds(in ownParameters)
                        let fnName = t12Text(in c, from: file, at: m.value.name)
                        if c.functions[fn].typeMap.length == 0 {
                            declareWhere(
                                ref c,
                                from: file,
                                for: in m.value.where,
                                to: in ownParameters,
                                by: null,
                                as: fnName,
                            )
                        } else {
                            declareWhere(
                                ref c,
                                from: file,
                                for: in m.value.where,
                                to: in ownParameters,
                                by: t11CopyMap(in c.functions[fn].typeMap),
                                as: fnName,
                            )
                        }
                        declareSignature(ref c, for: fn, from: in m.value, by: file)
                        if t12Unique(ref c, from: file, at: m.value.name, to: ref names) {
                            c.interfaces[i].methods.append(fn)
                        }
                    case .getterDecl(let g):
                        t38DeclareGetter(
                            ref c,
                            for: i,
                            at: mIdx,
                            by: g.value.modifiers,
                            from: in g.value.type,
                            as: g.value.name,
                            isAbstract: true,
                            through: in types,
                            to: ref names,
                        )
                    case .propertyDecl(let p):
                        t38DeclareGetter(
                            ref c,
                            for: i,
                            at: mIdx,
                            by: p.value.modifiers,
                            from: in p.value.type,
                            as: p.value.name,
                            isAbstract: false,
                            through: in types,
                            to: ref names,
                        )
                    default:
                        report(
                            ref c,
                            for: .unsupported,
                            from: file,
                            at: t11DeclSpan(in node.value.members[mIdx]),
                            by: ("this kind of interface member", "", "", "", ""),
                        )
                }
            }
        default:
            panic("an interface is declared by an `InterfaceDecl`")
    }
}

/// The `DeclareGetter` local of `DeclareInterfaceMembers`; member `mIdx` of the interface is its `decl`.
void t38DeclareGetter(
    ref Ctx c,
    for InterfaceId i,
    at i64 mIdx,
    by parser.Modifiers modifiers,
    from in parser.TypeSyntax type,
    as TextSpan name,
    bool isAbstract,
    through in TypeResolver types,
    to ref Map<string,
    Location> names
) {
    let file = c.interfaces[i].file
    checkValue(ref c, from: file, at: name)
    rejectStatic(ref c, from: file, by: modifiers, at: name)
    let returnType = resolve(ref c, through: in types, for: in type)
    let getter = newFunction(ref c, by: FunctionSymbol {
        name: t12Text(in c, from: file, at: name),
        nameSpan: name,
        span: name,
        module: c.interfaces[i].module,
        kind: .getter,
        access: c.interfaces[i].access,
        file: file,
        declIndex: c.interfaces[i].declIndex,
        memberIndex: mIdx,
        iface: i,
        isAbstract: isAbstract,
        returnType: returnType,
        typeMap: t11CopyMap(in types.typeArgs),
    })
    if t12Unique(ref c, from: file, at: name, to: ref names) {
        c.interfaces[i].properties.append(getter)
    }
}

// ── Compilation.cs:1203 RejectStatic ─────────────────────────────────────────

void rejectStatic(ref Ctx c, from FileId file, by parser.Modifiers modifiers, at TextSpan name) {
    if (modifiers & 4) != 0 {
        report(
            ref c,
            for: .staticAbstract,
            from: file,
            at: name,
            by: ("", "", "", "", ""),
            label: "declared `static`",
            help: "remove `static` or make it a free function",
        )
    }
}

// ── Compilation.cs:1210 RejectModifiers ──────────────────────────────────────

void rejectModifiers(
    ref Ctx c,
    from FileId file,
    at TextSpan span,
    by parser.Modifiers actual,
    for parser.Modifiers rejected,
    as string what
) {
    if (actual & rejected) != 0 {
        report(
            ref c,
            for: .unsupported,
            from: file,
            at: span,
            by: ($"`{t38ModifierText(actual & rejected)}` on {what}", "", "", "", ""),
        )
    }
}

/// C#'s `Modifiers.ToString().ToLowerInvariant()`: each set flag's name, lowest first, joined by ", ".
string t38ModifierText(parser.Modifiers m) {
    let flagNames = ["public", "private", "static", "readonly", "required", "const", "unique", "extern", "unsafe"]
    var sb = StrBuf()
    var any = false
    for k in 0..flagNames.length {
        if (i64(m) & (1 << k)) != 0 {
            if any {
                sb.append(", ")
            }
            sb.append(flagNames[k])
            any = true
        }
    }
    return $"{sb.finish()}"
}

// ── Compilation.cs:1217 RefReceiverFix ───────────────────────────────────────

Fix refReceiverFix(in parser.FunctionDecl decl) {
    if (decl.moveThis is { } moveSpan) {
        return Fix { span: TextSpan { start: moveSpan.start, length: 4 }, replacement: "ref" }
    }
    let text = decl.receiverStates.length > 0 ? "ref " : decl.params.length > 0 ? "ref this, " : "ref this"
    return Fix { span: TextSpan { start: decl.paramsStart, length: 0 }, replacement: text }
}

// ── Compilation.cs:1221 DeclareSignature ─────────────────────────────────────

void declareSignature(ref Ctx c, for FuncId fn, from in parser.FunctionDecl decl, by FileId file, StructId owner = -1) {
    let types = TypeResolver { file: file, container: owner, typeArgs: t11CopyMap(in c.functions[fn].typeMap) }
    c.functions[fn].returnType = resolve(ref c, through: in types, for: in decl.returnType, allowVoid: true)
    if functionTypeNotHere(
        ref c,
        for: c.functions[fn].returnType,
        from: file,
        at: t8TypeSpan(in decl.returnType),
        as: "a return type"
    ) {
        c.functions[fn].returnType = errorType()
    }
    c.functions[fn].isMutating = decl.refThis is not null
    let instanceMethod = c.functions[fn].kind == .method && !c.functions[fn].isStatic
    if (decl.refThis is { } refThis) && !instanceMethod {
        report(
            ref c,
            for: .unsupported,
            from: file,
            at: refThis,
            by: (
                c.functions[fn].isStatic
                    ? "`ref this` on a static method"
                    : "`ref this` outside a struct",
                "",
                "",
                "",
                ""
            ),
            help: "remove `ref this`; only an instance method has a `this` to change",
        )
    }
    // Only a `ref this` caller still holds the value whose state changed (revision 0010); a static `becomes` is BYN2022 at its `become`.
    if (decl.becomes is { } becomes) && decl.refThis is null && instanceMethod {
        // `move this is .s` and `this is .s` are written; a method with neither takes `this` unwritten.
        var start = decl.paramsStart
        if (decl.moveThis is { } mt) {
            start = mt.start
        }
        var receiver: TextSpan? = decl.moveThis
        if decl.receiverStates.length > 0 {
            receiver = TextSpan.fromBounds(start, until: decl.receiverStates[decl.receiverStates.length - 1].end)
        }
        var at = decl.name
        var receiverText = "this"
        if (receiver is { } r) {
            at = r
            receiverText = t12Text(in c, from: file, at: r)
        }
        let fix = refReceiverFix(in decl)
        let fnName = c.functions[fn].name
        report(
            ref c,
            for: .becomesNeedsRef,
            from: file,
            at: at,
            by: (fnName, t12Text(in c, from: file, at: becomes), receiverText, "", ""),
            help: $"change the receiver of `{fnName}` to `ref this`, or return the new state as a value",
            hasFix: true,
            fixSpan: fix.span,
            fixReplacement: fix.replacement,
        )
    }
    declareParameters(ref c, for: fn, from: in decl.params, by: file, through: in types)
    if (decl.failsKeyword is { } clause) {
        c.functions[fn].hasFails = true
        if clause.errors.length == 0 {
            c.functions[fn].infersErrors = true
            if c.functions[fn].access == .publicKeyword {
                report(
                    ref c,
                    for: .publicInferredFails,
                    from: file,
                    at: clause.span,
                    by: (c.functions[fn].name, "", "", "", ""),
                )
            }
        }
        for e in clause.errors {
            let t = resolve(ref c, through: in types, for: in e)
            if kindOf(t) == .errorSet || kindOf(t) == .errorUnion {
                // A case stays excluded only while every name that brings in its set excludes it.
                var excluded = List<VariantId>()
                var sets = List<ErrorSetId>()
                if kindOf(t) == .errorUnion {
                    excluded = copyIds(in c.errorUnionTypes[typeIndex(t)].excluded)
                    sets = copyIds(in c.errorUnionTypes[typeIndex(t)].sets)
                } else {
                    sets.append(typeIndex(t))
                }
                for set in sets {
                    if listContains(in c.functions[fn].errorSets, by: set) {
                        var kept = List<VariantId>()
                        for v in c.functions[fn].excludedErrors {
                            if !(c.errorVariants[v].set == set && !listContains(in excluded, by: v)) {
                                kept.append(v)
                            }
                        }
                        c.functions[fn].excludedErrors = move kept
                        continue
                    }
                    c.functions[fn].errorSets.append(set)
                    for v in excluded {
                        if c.errorVariants[v].set == set {
                            c.functions[fn].excludedErrors.append(v)
                        }
                    }
                }
            } else if !isError(t) {
                report(
                    ref c,
                    for: .notAnErrorSet,
                    from: file,
                    at: t8TypeSpan(in e),
                    by: (typeDisplay(ref c, by: t), "", "", "", ""),
                )
            }
        }
    }
}

// ── Compilation.cs:1276 DeclareParameters ────────────────────────────────────

void declareParameters(
    ref Ctx c,
    for FuncId fn,
    from in List<parser.Param> parameters,
    by FileId file,
    through in TypeResolver types
) {
    for p in parameters {
        checkValue(ref c, from: file, at: p.name)
        let name = t12Text(in c, from: file, at: p.name)
        let sym = newLocal(ref c, by: LocalSymbol {
            name: name,
            nameSpan: p.name,
            span: p.name,
            type: resolve(ref c, through: in types, for: in p.type),
            kind: .parameter,
            isParameter: true,
            modifier: p.modifier,
            ordinal: c.functions[fn].parameters.length,
        })
        for q in copyIds(in c.functions[fn].parameters) {
            if c.locals[q].name == name {
                reportDuplicate(ref c, from: file, at: p.name, as: loc(file, at: c.locals[q].span))
                break
            }
        }
        c.functions[fn].parameters.append(sym)
    }
    checkParticles(ref c, from: file, for: fn)
}

// ── Compilation.cs:1290 CheckStructShape ─────────────────────────────────────

void checkStructShape(ref Ctx c, for StructId s) {
    let file = c.structs[s].file
    for f in copyIds(in c.structs[s].fields) {
        // `f.Decl.Type.Span`: a `type distinct`'s field `value` is the alias's target.
        var span = TextSpan { start: 0, length: 0 }
        switch c.files[c.fields[f].file].unit.members[c.fields[f].declIndex] {
            case .structDecl(let node):
                switch node.value.members[c.fields[f].memberIndex] {
                    case .fieldDecl(let d):
                        span = t8TypeSpan(in d.value.type)
                    default:
                        panic("a field is declared by a `FieldDecl`")
                }
            case .typeAliasDecl(let a):
                span = t8TypeSpan(in a.value.target)
            default:
                panic("a field is declared by a `StructDecl` or a `type distinct`")
        }
        let type = c.fields[f].type
        continue if functionTypeNotHere(ref c, for: type, from: file, at: span, as: "a field")
        if isBorrow(ref c, by: type) {
            let help = isString(
                type,
            ) ? "store an index or an owned copy instead; storing borrows in structs arrives in a later version" : "store a `List` copied with `.copy(to: alloc)` instead; storing borrows in structs arrives in a later version"
            report(
                ref c,
                for: .borrowField,
                from: file,
                at: span,
                by: (typeDisplay(ref c, by: type), "", "", "", ""),
                help: help,
            )
        }
    }
    let name = $"{c.structs[s].name}"
    checkRecursion(ref c, for: structTypeOf(s), by: name, from: file, at: c.structs[s].nameSpan)
}

// ── Compilation.cs:1307 FunctionTypeNotHere ──────────────────────────────────

bool functionTypeNotHere(ref Ctx c, for Type t, from FileId source, at TextSpan span, as string position) {
    return false if kindOf(t) != .function
    report(
        ref c,
        for: .functionTypeNotHere,
        from: source,
        at: span,
        by: (position, "", "", "", ""),
        help: "take the function as a parameter instead",
    )
    return true
}

// ── Compilation.cs:1314 CheckUnionShape ──────────────────────────────────────

void checkUnionShape(ref Ctx c, for UnionId u) {
    let file = c.unions[u].file
    for v in copyIds(in c.unions[u].variants) {
        for f in copyIds(in c.unionVariants[v].fields) {
            let type = c.locals[f].type
            if isBorrow(ref c, by: type) {
                report(
                    ref c,
                    for: .borrowPayload,
                    from: file,
                    at: c.locals[f].span,
                    by: (typeDisplay(ref c, by: type), "", "", "", ""),
                    help: "store a `List` copied with `.copy(to: alloc)` instead",
                )
            }
        }
    }
    let name = $"{c.unions[u].name}"
    checkRecursion(ref c, for: unionTypeOf(u), by: name, from: file, at: c.unions[u].nameSpan)
}

// ── Compilation.cs:1332 CheckRecursion ───────────────────────────────────────

void checkRecursion(ref Ctx c, for Type t, by string name, from FileId source, at TextSpan span) {
    return if listContains(in c.inReportedCycle, by: t)
    var seen = List<Type>()
    if (cycle(ref c, for: t, as: t, to: ref seen) is { } path) {
        for p in path {
            if !listContains(in c.inReportedCycle, by: p) {
                c.inReportedCycle.append(p)
            }
        }
        var sb = StrBuf()
        sb.append(typeDisplay(ref c, by: t))
        for p in path {
            sb.append(" → ")
            sb.append(typeDisplay(ref c, by: p))
        }
        let chain = sb.finish()
        report(
            ref c,
            for: .recursiveByValue,
            from: source,
            at: span,
            by: (name, chain, "", "", ""),
            help: $"store the inner one as `Owned<{name}>` (or in a `List<{name}>`); a value cannot contain itself",
        )
    }
}

// ── Compilation.cs:1341 Cycle ────────────────────────────────────────────────

/// The structs and unions on a by-value path from `t` back to `target`, ending with it; null if there is none.
List<Type>? cycle(ref Ctx c, for Type t, as Type target, to ref List<Type> seen) {
    var parts = List<Type>()
    let idx = typeIndex(t)
    switch kindOf(t) {
        case .structType:
            for f in c.structs[idx].fields {
                parts.append(c.fields[f].type)
            }
        case .unionType:
            for v in c.unions[idx].variants {
                for f in c.unionVariants[v].fields {
                    parts.append(c.locals[f].type)
                }
            }
        case .optional:
            parts.append(c.optionalTypes[idx])
        case .array:
            parts.append(c.arrayTypes[idx].element)
        case .tuple:
            for f in c.tupleTypes[idx] {
                parts.append(f.type)
            }
        default:
            parts = List<Type>()
    }
    for p in parts {
        if p == target {
            var one = List<Type>()
            one.append(p)
            return one
        }
        continue if listContains(in seen, by: p)
        seen.append(p)
        if (cycle(ref c, for: p, as: target, to: ref seen) is { } rest) {
            var path = List<Type>()
            if kindOf(p) == .structType || kindOf(p) == .unionType {
                path.append(p)
            }
            for x in rest {
                path.append(x)
            }
            return path
        }
    }
    return null
}
== semantics/diag.byn
// T2: Bayan.Syntax/Diagnostics/Diagnostic.cs and DiagnosticRenderer.cs, over ctx.byn's Diag, Related and DiagBag.
//
// The C# keeps the diagnostics in a `DiagnosticBag` (`Add`, `RemoveRepeats`) and the sink in
// `Compilation` (`Report`, `ReportInto`); here both hang off `Ctx`. The renderer is the plain style
// only; T19 gives it the driver's `Style` (`T26Symbols`: bar, width and the SGR prefixes of the roles). The line and UTF-8 helpers are private
// copies of `src/lexer/source.byn` and `src/lexer/diagnostics.byn` (those are not `public`).

// ── Reporting ────────────────────────────────────────────────────────────────

/// Reports `code` at `span` in file `f`, formatting its template with `args` (the C#
/// `Compilation.Report`). An empty `label`/`help` is C#'s `null`; `hasFix` carries the edit
/// `fixSpan` → `fixReplacement`.
void report(
    ref Ctx c,
    for SemaCode code,
    from FileId f,
    at TextSpan span,
    by (string a0, string a1, string a2, string a3, string a4) args,
    string label = "",
    string help = "",
    bool hasFix = false,
    TextSpan? fixSpan = null,
    string fixReplacement = ""
) {
    addDiag(ref c, by: Diag {
        code: codeText(code),
        file: f,
        span: span,
        message: format(messageFormat(code), by: args),
        label: label,
        help: help,
        isWarning: isWarning(code),
        hasFix: hasFix,
        fixSpan: fixSpan ?? TextSpan { start: 0, length: 0 },
        fixReplacement: fixReplacement,
        related: List<Related>(),
    })
}

/// Appends an already-built diagnostic to the innermost sink (the C# `ReportHeld`/`Add`), or drops
/// it while `c.quiet`. A `for try` synthetic name's span becomes the C# span it stands for (Q739).
void addDiag(ref Ctx c, by move Diag d) {
    return if c.quiet
    var m = move d
    m.span = t40RealSpan(in c, for: m.span)
    m.fixSpan = t40RealSpan(in c, for: m.fixSpan)
    for i in 0..m.related.length {
        m.related[i].span = t40RealSpan(in c, for: m.related[i].span)
    }
    if c.sink >= 0 {
        c.bags[c.sink].items.append(move m)
    } else {
        c.diagnostics.append(move m)
    }
}

/// Opens a nested bag and makes it the sink; returns the sink to restore (the C# `ReportInto`).
i64 pushBag(ref Ctx c) {
    let previous = c.sink
    c.bags.append(DiagBag { items: List<Diag>(), previous: previous })
    c.sink = c.bags.length - 1
    return previous
}

/// Restores the sink (the C# `ReportInto` returning the outer bag); the bag's items stay in
/// `c.bags` for the caller to read.
void popBag(ref Ctx c, to i64 previous) {
    c.sink = previous
}

/// The span `span` stands for: a `for try` synthetic name's (negative start, `t28SyntheticName`) is the iterable's
/// (Binder.cs:1110-1115); any other span is itself (Q739).
TextSpan t40RealSpan(in Ctx c, for TextSpan span) => span.start < 0 ? c.syntheticSpans[-1 - span.start] : span

/// Drops each diagnostic that repeats an earlier one's code, file, span and message, keeping the
/// first (the C# `DiagnosticBag.RemoveRepeats`).
void removeRepeats(ref Ctx c) {
    var seen = List<(string, i64, i64, i64, string)>()
    var repeat = List<bool>()
    for d in c.diagnostics {
        let key = (d.code, d.file, d.span.start, d.span.length, d.message)
        var found = false
        for k in seen {
            if k == key {
                found = true
            }
        }
        if !found {
            seen.append(key)
        }
        repeat.append(found)
    }
    var i = repeat.length - 1
    while i >= 0 {
        if repeat[i] {
            c.diagnostics.remove(at: i)
        }
        i -= 1
    }
}

// ── Rendering ────────────────────────────────────────────────────────────────

/// A span to underline: its line, the span, its label and whether carets or dashes mark it.
struct Mark {
    i64      line
    TextSpan span
    string   label
    bool     primary
}

/// Renders a diagnostic as plain text (the format `DiagnosticRenderer` fixes):
///
///     error BYN2104: `total` is immutable
///
///       12 │     total += line.price;
///          │     ^^^^^ declared with `let` on line 9
///          │
///       help: declare it with `var` if it should change
///          │  9 │     var total = 0;
///          │    │     +++
string render(in Ctx c, for in Diag d, by bool includePath, through in T26Symbols style) {
    var sb = StrBuf()
    let accent = d.isNote ? style.note : d.isWarning ? style.warning : style.error
    // coverage-exempt: Q1127 `Style.Width` is 100 or a terminal width above 0 (main.byn `decideStyle`), so the 100 arm is the C# `style.Width > 0 ? style.Width : 100` default no driver style reaches
    let wrapWidth = style.width > 0 ? style.width : 100
    let bar = paint(in style, by: style.note, for: style.bar)
    let head = $"{severityName(d.isWarning, isNote: d.isNote)} {d.code}"
    var message = List<string>()
    wrap(d.message, to: ref message, by: Widths { first: wrapWidth - head.length - 2, rest: wrapWidth })
    sb.append(paint(in style, by: accent, for: head, bold: true))
    sb.append(": ")
    appendLines(ref message, to: ref sb, by: "\n")
    sb.append("\n")
    let f = d.file
    return $"{sb.finish()}" if f < 0
    if includePath {
        let position = linePosition(c.files[f].text.span, at: d.span.start)
        sb.append(
            $"{paint(in style, by: style.note, for: "  -->")} {c.files[f].displayPath}:{position.line}:{position.column}\n",
        )
    }
    sb.append("\n")

    var spans = List<Mark>()
    spans.append(
        Mark { line: lineIndex(c.files[f].text.span, at: d.span.start), span: d.span, label: d.label, primary: true },
    )
    for r in d.related {
        spans.append(
            Mark {
                line: lineIndex(c.files[f].text.span, at: r.span.start),
                span: r.span,
                label: r.label,
                primary: false,
            },
        )
    }
    sortMarks(ref spans)

    var fixLines = List<string>()
    var fix = FixView { firstLine: 0, markStart: 0, markEnd: 0, marker: "+" }
    if d.hasFix {
        fix = applyFix(c.files[f].text.span, from: d.fixSpan, by: d.fixReplacement, to: ref fixLines)
    }

    var widestLine = spans[spans.length - 1].line + 1
    if d.hasFix && fix.firstLine + fixLines.length > widestLine {
        widestLine = fix.firstLine + fixLines.length
    }
    let width = $"{widestLine}".length
    var blankBuf = StrBuf()
    blankBuf.append("  ")
    for i in 0..width {
        blankBuf.append(" ")
    }
    blankBuf.append($" {bar}")
    let blank = $"{blankBuf.finish()}"

    var previous: i64 = -1
    for k in 0..spans.length {
        let s = spans[k]
        let thisLine = lineSpanOf(c.files[f].text.span, at: s.line)
        if previous != s.line {
            if previous >= 0 {
                sb.append($"{blank}\n")
            }
            sb.append($"  {paint(in style, by: style.note, for: lineNumber(s.line + 1, to: width))} {bar} ")
            display(c.files[f].text.span[thisLine.start..thisLine.end], to: ref sb)
            sb.append("\n")
        }
        previous = s.line

        var underlineEnd = s.span.end < thisLine.end ? s.span.end : thisLine.end
        if underlineEnd < s.span.start {
            underlineEnd = s.span.start
        }
        let prefix = c.files[f].text.span[thisLine.start..s.span.start]
        var carets = runeCount(c.files[f].text.span[s.span.start..underlineEnd])
        if carets < 1 {
            carets = 1
        }
        // coverage-exempt: Q1127 a related span (`-` mark) needs a diagnostic with `Related`, which no binder site produces (Q81)
        let role = s.primary ? accent : style.note
        var marks = StrBuf()
        // coverage-exempt: Q1127 the `-` arm of a related span, as above
        for i in 0..carets {
            marks.append(s.primary ? "^" : "-")
        }
        let markText = $"{marks.finish()}"
        sb.append($"{blank} ")
        indent(prefix, to: ref sb)
        if s.label.isEmpty {
            sb.append(paint(in style, by: role, for: markText, bold: s.primary))
            sb.append("\n")
            continue
        }
        let room = wrapWidth - (2 + width + 3 + runeCount(prefix) + carets + 1)
        var label = List<string>()
        wrap(s.label, to: ref label, by: Widths { first: room, rest: room })
        sb.append(paint(in style, by: role, for: $"{markText} {label[0]}", bold: s.primary))
        for i in 1..label.length {
            // coverage-exempt: Q1127 a label wrapped past `room` columns; no binder label is that long
            sb.append($"\n{blank} ")
            indent(prefix, to: ref sb)
            for j in 0..carets + 1 {
                sb.append(" ")
            }
            // coverage-exempt: Q1127 as above
            sb.append(paint(in style, by: role, for: label[i], bold: s.primary))
        }
        sb.append("\n")
    }

    return $"{sb.finish()}" if d.help.isEmpty && !d.hasFix

    sb.append($"{blank}\n")
    if !d.help.isEmpty {
        var help = List<string>()
        wrap(d.help, to: ref help, by: Widths { first: wrapWidth - 8, rest: wrapWidth - 8 })
        sb.append("  ")
        sb.append(paint(in style, by: style.help, for: "help:", bold: true))
        sb.append(" ")
        appendLines(ref help, to: ref sb, by: "\n        ")
        sb.append("\n")
    }
    if d.hasFix {
        var offset: i64 = 0
        for i in 0..fixLines.length {
            let line = fixLines[i]
            sb.append(
                $"{blank} {paint(in style, by: style.note, for: lineNumber(fix.firstLine + i + 1, to: width))} {bar} ",
            )
            display(line.bytes, to: ref sb)
            sb.append("\n")
            let from = fix.markStart - offset > 0 ? fix.markStart - offset : 0
            let to = fix.markEnd - offset < line.length ? fix.markEnd - offset : line.length
            if to > from {
                sb.append($"{blank} ")
                for j in 0..width {
                    sb.append(" ")
                }
                sb.append($" {bar} ")
                indent(line[0..from].bytes, to: ref sb)
                var run = StrBuf()
                for j in 0..runeCount(line[from..to].bytes) {
                    run.append(fix.marker)
                }
                sb.append(paint(in style, by: style.help, for: $"{run.finish()}"))
                sb.append("\n")
            }
            offset += line.length + 1
        }
    }
    return $"{sb.finish()}"
}

/// Renders `diags` in source order (a stable sort by display path, then span start), separated by
/// blank lines. Errors past `errorLimit` are skipped and counted in `omitted`; warnings never are
/// (the C# `DiagnosticRenderer.RenderAll`).
public string renderAll(
    in Ctx c,
    from in List<Diag> diags,
    by bool includePath,
    until i64 errorLimit,
    to ref i64 omitted
) uses alloc {
    let plain = T26Symbols { dot: "◆", cross: "✗", ellipsis: "…" }
    return renderAllBy(in c, from: in diags, by: includePath, until: errorLimit, to: ref omitted, through: in plain)
}

/// `renderAll` in `style`: the C# `RenderAll(diagnostics, includePath, style, errorLimit, out omitted)`.
public string renderAllBy(
    in Ctx c,
    from in List<Diag> diags,
    by bool includePath,
    until i64 errorLimit,
    to ref i64 omitted,
    through in T26Symbols style
) uses alloc {
    omitted = 0
    let order = sortOrder(in c, from: in diags)
    var sb = StrBuf()
    var errors: i64 = 0
    var first = true
    for k in 0..order.length {
        let i = order[k]
        if !diags[i].isWarning && !diags[i].isNote {
            errors += 1
            if errors > errorLimit {
                omitted += 1
                continue
            }
        }
        if !first {
            sb.append("\n")
        }
        first = false
        sb.append(render(in c, for: in diags[i], by: includePath, through: in style))
    }
    return $"{sb.finish()}"
}

/// Indices of `diags` in the C# `Sort` order: `displayPath` (ordinal, "" for no file), then span
/// start. Insertion sort, so equal keys keep their order.
List<i64> sortOrder(in Ctx c, from in List<Diag> diags) {
    var order = List<i64>()
    for i in 0..diags.length {
        order.append(i)
        var j = order.length - 1
        while j > 0 && before(in c, from: in diags[i], to: in diags[order[j - 1]]) {
            order[j] = order[j - 1]
            j -= 1
        }
        order[j] = i
    }
    return order
}

/// Whether `a` sorts before `b`: its display path is ordinally smaller, or equal and its span starts
/// earlier.
bool before(in Ctx c, from in Diag a, to in Diag b) {
    let pa = pathOf(in c, for: in a)
    let pb = pathOf(in c, for: in b)
    return pathLess(pa, by: pb) if pa != pb
    return a.span.start < b.span.start
}

/// The path a diagnostic's file renders as, or "" when it has no file.
string pathOf(in Ctx c, for in Diag d) => d.file < 0 ? "" : c.files[d.file].displayPath

/// Ordinal (byte) string comparison: the C# `StringComparer.Ordinal` for the ASCII paths in use.
bool pathLess(string a, by string b) {
    let x = a.bytes
    let y = b.bytes
    let n = x.length < y.length ? x.length : y.length
    for i in 0..n {
        return true if x[i] < y[i]
        return false if x[i] > y[i]
    }
    return x.length < y.length
}

/// "error", "warning", or "note" for a style lint at `.suggestion`.
string severityName(bool isWarning, bool isNote = false) => isNote ? "note" : isWarning ? "warning" : "error"

/// Sorts marks by line, keeping the order of marks on the same line (the C# `OrderBy`).
void sortMarks(ref List<Mark> marks) {
    for i in 1..marks.length {
        var j = i
        while j > 0 && marks[j - 1].line > marks[j].line {
            let m = marks[j]
            marks[j] = marks[j - 1]
            marks[j - 1] = m
            j -= 1
        }
    }
}

/// Appends `lines` to `sb`, joined by `separator`.
void appendLines(ref List<string> lines, to ref StrBuf sb, by string separator) {
    for i in 0..lines.length {
        if i > 0 {
            sb.append(separator)
        }
        sb.append(lines[i])
    }
}

/// `number` right-aligned in `width` columns.
string lineNumber(i64 number, to i64 width) {
    let digits = $"{number}"
    var sb = StrBuf()
    for i in digits.length..width {
        sb.append(" ")
    }
    sb.append(digits)
    return $"{sb.finish()}"
}

/// The fix as shown: its first line, and the byte range in the shown lines to mark with `marker`.
struct FixView {
    i64    firstLine
    i64    markStart
    i64    markEnd
    string marker
}

/// Fills `lines` with the lines touched by the fix, replacement applied, and marks the inserted
/// text with `+`. A pure removal shows the original lines and marks the removed text with `-`.
FixView applyFix(ReadOnlySpan<u8> text, from TextSpan fix, by string replacement, to ref List<string> lines) {
    let firstLine = lineIndex(text, at: fix.start)
    let lastLine = lineIndex(text, at: fix.end)
    let before = getText(text, at: TextSpan.fromBounds(lineSpanOf(text, at: firstLine).start, until: fix.start))
    let after = getText(text, at: TextSpan.fromBounds(fix.end, until: lineSpanOf(text, at: lastLine).end))
    let original = getText(text, at: fix)
    let o = original.bytes
    let r = replacement.bytes

    let common = o.length < r.length ? o.length : r.length
    var head: i64 = 0
    while head < common && o[head] == r[head] {
        head += 1
    }
    while head > 0 && ((head < o.length && (o[head] & 0xC0) == 0x80) || (head < r.length && (r[head] & 0xC0) == 0x80)) {
        head -= 1
    }
    var tail: i64 = 0
    while tail < common - head && o[o.length - 1 - tail] == r[r.length - 1 - tail] {
        tail += 1
    }
    while tail > 0 && (o[o.length - tail] & 0xC0) == 0x80 {
        tail -= 1
    }

    let inserted = r.length - head - tail > 0
    let shown = inserted ? replacement : original
    let whole = $"{before}{shown}{after}"
    var from: i64 = 0
    for i in 0..whole.length {
        if whole.bytes[i] == 0x0A {
            lines.append(whole[from..i])
            from = i + 1
        }
    }
    lines.append(whole[from..])
    return FixView {
        firstLine: firstLine,
        markStart: before.length + head,
        markEnd: before.length + shown.length - tail,
        marker: inserted ? "+" : "-",
    }
}

/// Line widths for `wrap`: the first line gets `first` columns, the rest `rest`.
struct Widths {
    i64 first
    i64 rest
}

/// Fills `lines` with `text` split into lines that fit `widths`. Words are never broken, and a
/// backticked run counts as one word (the C# `Wrap`/`Words`).
void wrap(string text, to ref List<string> lines, by Widths widths) {
    let t = text.bytes
    var paraFrom: i64 = 0
    for i in 0..t.length + 1 {
        continue if i != t.length && t[i] != 0x0A
        let words = splitWords(text[paraFrom..i])
        var line = ""
        var lineRunes: i64 = 0
        var started = false
        for w in words {
            let room = lines.length == 0 ? widths.first : widths.rest
            if started && lineRunes + 1 + runeCount(w.bytes) > room {
                lines.append(line)
                line = ""
                lineRunes = 0
                started = false
            }
            if started {
                line = $"{line} "
                lineRunes += 1
            }
            line = $"{line}{w}"
            lineRunes += runeCount(w.bytes)
            started = true
        }
        lines.append(line)
        paraFrom = i + 1
    }
}

/// The space-separated words of `paragraph`, where spaces inside backticks do not separate. An
/// unpaired backtick is not code, and the paragraph splits on every space (the C# `Words`).
List<string> splitWords(string paragraph) {
    let t = paragraph.bytes
    var code = false
    var words = List<string>()
    var start: i64 = 0
    for i in 0..t.length {
        if t[i] == 0x60 {
            code = !code
        } else if t[i] == 0x20 && !code {
            words.append(paragraph[start..i])
            start = i + 1
        }
    }
    words.append(paragraph[start..t.length])
    return words if !code
    var simple = List<string>()
    var from: i64 = 0
    for i in 0..t.length {
        if t[i] == 0x20 {
            simple.append(paragraph[from..i])
            from = i + 1
        }
    }
    simple.append(paragraph[from..t.length])
    return simple
}

/// Source text as shown in a diagnostic: control and bidi characters become U+FFFD, one scalar for
/// one, so carets still line up and the terminal cannot be made to reorder text.
void display(ReadOnlySpan<u8> text, to ref StrBuf sb) {
    var pos: i64 = 0
    while pos < text.length {
        let d = decodeAt(text, at: pos)
        let v = d.value
        let hidden = (v < 0x20 && v != 0x09) || v == 0x7F || (v is 0x202A..=0x202E) || (v is 0x2066..=0x2069)
        sb.append($"{rune(hidden ? replacementCharacter : v)}")
        pos += d.length
    }
}

/// Whitespace that lines up with `prefix`, keeping its tabs.
void indent(ReadOnlySpan<u8> prefix, to ref StrBuf sb) {
    var pos: i64 = 0
    while pos < prefix.length {
        let d = decodeAt(prefix, at: pos)
        sb.append(d.value == 0x09 ? "\t" : " ")
        pos += d.length
    }
}

/// The text of `span`, with invalid UTF-8 replaced as `Encoding.UTF8.GetString` does.
string getText(ReadOnlySpan<u8> text, at TextSpan span) => utf8(text[span.start..span.end])

/// Number of scalars `bytes` decodes to, counting each replacement as one.
i64 runeCount(ReadOnlySpan<u8> bytes) {
    var count: i64 = 0
    var pos: i64 = 0
    while pos < bytes.length {
        pos += decodeAt(bytes, at: pos).length
        count += 1
    }
    return count
}

// ── Lines ────────────────────────────────────────────────────────────────────

/// Zero-based index of the line containing `offset` (the C# `SourceText.GetLineIndex`).
i64 lineIndex(ReadOnlySpan<u8> text, at i64 offset) {
    if offset < 0 || offset > text.length {
        panic("offset out of range")
    }
    var line: i64 = 0
    for i in 0..offset {
        if text[i] == 0x0A {
            line += 1
        }
    }
    return line
}

/// The byte offset where line `line` starts.
i64 lineStart(ReadOnlySpan<u8> text, at i64 line) {
    return 0 if line <= 0
    var seen: i64 = 0
    for i in 0..text.length {
        if text[i] == 0x0A {
            seen += 1
            return i + 1 if seen == line
        }
    }
    return text.length
}

/// The span of line `line`, excluding its terminator (the C# `SourceText.GetLineSpan`).
TextSpan lineSpanOf(ReadOnlySpan<u8> text, at i64 line) {
    let start = lineStart(text, at: line)
    var end = text.length
    for i in start..text.length {
        if text[i] == 0x0A {
            end = i
            break
        }
    }
    if end > start && text[end - 1] == 0x0D {
        end -= 1
    }
    return TextSpan.fromBounds(start, until: end)
}

/// One-based line and column; the column counts Unicode scalars, not bytes (the C#
/// `SourceText.GetLinePosition`).
(i64 line, i64 column) linePosition(ReadOnlySpan<u8> text, at i64 offset) {
    let line = lineIndex(text, at: offset)
    let start = lineStart(text, at: line)
    var column: i64 = 1
    for i in start..offset {
        if (text[i] & 0xC0) != 0x80 {
            column += 1
        }
    }
    return (line: line + 1, column: column)
}

// ── UTF-8 ────────────────────────────────────────────────────────────────────

const replacementCharacter: u32 = 0xFFFD

/// One decoding step: a scalar and its length, or an invalid maximal subpart of `length` bytes.
struct Decoded {
    u32  value
    i64  length
    bool valid
}

bool isContinuation(ReadOnlySpan<u8> bytes, at i64 pos, from u8 lo, through u8 hi) =>
    pos < bytes.length && bytes[pos] >= lo && bytes[pos] <= hi

/// Decodes the scalar at `pos` like `Rune.DecodeFromUtf8`; an invalid or truncated sequence is
/// reported with the length of its maximal subpart (at least 1), as `Encoding.UTF8` replaces it.
Decoded decodeAt(ReadOnlySpan<u8> bytes, at i64 pos) {
    let b0 = bytes[pos]
    return Decoded { value: b0, length: 1, valid: true } if b0 < 0x80
    if b0 is 0xC2..=0xDF {
        unless isContinuation(bytes, at: pos + 1, from: 0x80, through: 0xBF) {
            return invalid(1)
        }
        return Decoded { value: (u32(b0 & 0x1F) << 6) | u32(bytes[pos + 1] & 0x3F), length: 2, valid: true }
    }
    if b0 is 0xE0..=0xEF {
        let lo: u8 = b0 == 0xE0 ? 0xA0 : 0x80
        let hi: u8 = b0 == 0xED ? 0x9F : 0xBF
        unless isContinuation(bytes, at: pos + 1, from: lo, through: hi) {
            return invalid(1)
        }
        unless isContinuation(bytes, at: pos + 2, from: 0x80, through: 0xBF) {
            return invalid(2)
        }
        let value = (u32(b0 & 0x0F) << 12) | (u32(bytes[pos + 1] & 0x3F) << 6) | u32(bytes[pos + 2] & 0x3F)
        return Decoded { value: value, length: 3, valid: true }
    }
    if b0 is 0xF0..=0xF4 {
        let lo: u8 = b0 == 0xF0 ? 0x90 : 0x80
        let hi: u8 = b0 == 0xF4 ? 0x8F : 0xBF
        unless isContinuation(bytes, at: pos + 1, from: lo, through: hi) {
            return invalid(1)
        }
        unless isContinuation(bytes, at: pos + 2, from: 0x80, through: 0xBF) {
            return invalid(2)
        }
        unless isContinuation(bytes, at: pos + 3, from: 0x80, through: 0xBF) {
            return invalid(3)
        }
        let value = (u32(b0 & 0x07) << 18) | (u32(bytes[pos + 1] & 0x3F) << 12) |
            (u32(bytes[pos + 2] & 0x3F) << 6) | u32(bytes[pos + 3] & 0x3F)
        return Decoded { value: value, length: 4, valid: true }
    }
    return invalid(1)
}

Decoded invalid(i64 length) => Decoded { value: replacementCharacter, length: length, valid: false }

/// Appends `bytes` decoded as `Encoding.UTF8.GetString` does: each invalid maximal subpart becomes U+FFFD.
void appendUtf8(ReadOnlySpan<u8> bytes, to ref StrBuf sb) {
    var pos: i64 = 0
    while pos < bytes.length {
        let d = decodeAt(bytes, at: pos)
        sb.append($"{rune(d.value)}")
        pos += d.length
    }
}

/// `bytes` as a string, with invalid UTF-8 replaced.
string utf8(ReadOnlySpan<u8> bytes) {
    var sb = StrBuf()
    appendUtf8(bytes, to: ref sb)
    return $"{sb.finish()}"
}

/// `Style.Paint` / the renderer's `Paint` (DiagnosticRenderer.cs:41): `prefix` (a role's SGR) around `text`, `Palette.Bold` first when `bold`; `text` as it is without colour.
string paint(in T26Symbols style, by string prefix, for string text, bool bold = false) uses alloc {
    unless style.color {
        return $"{text}"
    }
    return bold ? $"\u{1b}[1m{prefix}{text}\u{1b}[0m" : $"{prefix}{text}\u{1b}[0m"
}
== semantics/effects.byn
// T23: EffectAnalysis.cs and ErrorFlow.cs.
//
// Effects (spec §14). A function with `uses` declares its set, a public function without one is pure, and every
// other function infers its set from its body by fixed point, as error sets do. A body that uses an effect its
// declaration lacks is BYN6002 (the entry function is exempt), an unknown name in `uses` or `effect` is BYN6003, an
// effect the package `capabilities` lack is BYN6004, and a witness beyond its interface method's bound is BYN6005.
// An instance has its template's effects. The C# dictionaries keyed by symbols are `Map`s keyed by ids, and its
// hash sets are lists searched in order (Q630); `fn.Decl` is the declaration `t23DeclOf` finds (Q633).

import parser

/// One effect a body uses, at the first place that uses it; `direct` marks a built-in source, not a call of a user function.
struct T23Use {
    string   effect
    TextSpan span
    bool     direct = false
}

/// A C# `HashSet<string>?`: `has` is false for null.
struct T23Set {
    bool         has     = false
    List<string> effects = []
}

/// The C# `Analyze` locals `declared`, `used` and `aliases`; `used` is indexed by the function's place in `functions`.
struct T23Effects {
    List<FuncId>                    functions
    Map<FuncId, List<string>>       declared = []
    Map<FuncId, i64>                index    = []
    List<List<T23Use>>              used     = []
    List<Map<string, List<string>>> aliases
}

/// C# `fn.Decl`'s parts the effect analysis reads; `found` is false where C# `Decl` is null.
struct T23Decl {
    bool           found       = false
    FileId         file        = -1
    TextSpan       name        = TextSpan { start: 0, length: 0 }
    bool           hasUses     = false
    TextSpan       usesSpan    = TextSpan { start: 0, length: 0 }
    List<TextSpan> usesEffects = []
    /// `decl.Params[^1].Span.End`, or `decl.ParamsStart` without parameters.
    i64            closeFrom   = 0
    /// `decl.Where[^1].Span.End` or 0, `decl.Requires[^1].Span.End` or 0.
    i64            whereEnd    = 0
    i64            requiresEnd = 0
}

/// A C# `Fix?`: `has` is false for null.
struct T23Fix {
    bool     has  = false
    TextSpan span = TextSpan { start: 0, length: 0 }
    string   text = ""
}

/// One `effect name = a, b` declaration.
struct T23Alias {
    FileId         file
    List<TextSpan> effects
}

/// The C# `ResolveAliases` locals: `decls` (with its insertion order), `resolved`, and the `visiting` set of one expansion.
struct T23Aliases {
    Map<string, T23Alias>     decls    = []
    List<string>              order    = []
    Map<string, List<string>> resolved = []
    List<string>              visiting = []
}

/// C# `(BoundExpr Value, FunctionSymbol Function)` from `Passed`.
struct T23Passed {
    BExpr  value
    FuncId function
}

/// The closed effect list, in spec order.
List<string> t23Primitives() => ["alloc", "suspend", "net", "fs", "clock", "random", "env", "process", "console"]

/// The effects that need a package capability; the others are always allowed.
List<string> t23Capabilities() => ["net", "fs", "process", "env"]

/// Q31 (plan 015): `analyzeEffects` with its working memory freed. It writes nothing into `Ctx` but diagnostics, so the
/// run is made in an arena and, when it reported any (arena memory), undone (`t42Undo`) and made again in `General`.
/// A run with a bag as the sink stays in `General`: `t42Undo` does not cover bags.
void t42AnalyzeEffects(ref Ctx c) {
    if c.sink >= 0 {
        analyzeEffects(ref c)
        return
    }
    var undone = false
    let mark = t42Mark(c)
    using let arena = Arena()
    provide allocator: arena {
        analyzeEffects(ref c)
        undone = t42Undo(ref c, to: mark)
    }
    if undone {
        analyzeEffects(ref c)
    }
}

void analyzeEffects(ref Ctx c) {
    var aliases = List<Map<string, List<string>>>()
    for m in 0..c.modules.length {
        aliases.append(t23ResolveAliases(ref c, for: m))
    }

    var functions = List<FuncId>()
    for m in 0..c.modules.length {
        for f in c.modules[m].allFunctions {
            functions.append(f)
        }
    }
    var e = T23Effects { functions: copyIds(in functions), aliases: move aliases }
    var reported = List<string>()
    for fn in functions {
        let set = t23Declared(ref c, for: fn, from: in e.aliases, to: ref reported)
        if set.has {
            e.declared[fn] = copyStrings(in set.effects)
        }
    }

    for k in 0..functions.length {
        e.index[functions[k]] = k
        e.used.append(List<T23Use>())
    }
    var changed = true
    while changed {
        changed = false
        for k in 0..functions.length {
            let fn = functions[k]
            continue if functionIsInstance(ref c, by: fn) || c.functions[fn].body == -1
            var sinks = List<BNode>()
            let nodes = descendants(in c, for: c.functions[fn].body)
            for node in nodes {
                let kind = boundKind(node)
                let i = boundIndex(node)
                // Interpolation written straight into an output is formatted on the stack; anywhere else it grows a `StrBuf`.
                if kind == .call {
                    let b = c.functions[c.bCalls[i].function].builtin
                    if (b is .print or .log or .panic) && c.bCalls[i].arguments.length > 0
                            && boundKind(c.bCalls[i].arguments[0]) == .interpolated {
                        sinks.append(c.bCalls[i].arguments[0])
                    }
                }
                if kind == .builtinCall
                        && c.bBuiltinCalls[i].member == .strBufAppend
                        && c.bBuiltinCalls[i].arguments.length == 1
                        && boundKind(c.bBuiltinCalls[i].arguments[0]) == .interpolated {
                    sinks.append(c.bBuiltinCalls[i].arguments[0])
                }
                var sources = List<string>()
                var direct = false
                if kind == .interpolated {
                    if !listContains(in sinks, by: node) {
                        sources.append("alloc")
                        direct = true
                    }
                } else if kind == .call {
                    let callee = c.bCalls[i].function
                    let receiver = c.bCalls[i].receiver
                    let calleeKind = c.functions[callee].kind
                    if calleeKind == .builtin {
                        sources = t23Builtin(c.functions[callee].builtin)
                        direct = true
                    } else if calleeKind == .invoke
                            && receiver != -1
                            && boundKind(receiver) == .local
                            && c.locals[c.bLocals[boundIndex(receiver)].local].isParameter {
                        // A call through a function-typed parameter adds nothing: whoever passed the value is charged (R16).
                        // Its arguments are still charged here like any call's.
                        sources = t23PassedEffects(ref c, by: in e, for: i)
                    } else if calleeKind == .invoke
                            && receiver != -1
                            && kindOf(exprType(in c, for: receiver)) == .function {
                        sources = copyStrings(in c.functionTypes[typeIndex(exprType(in c, for: receiver))].effects)
                        for x in t23PassedEffects(ref c, by: in e, for: i) {
                            sources.append(x)
                        }
                    } else {
                        sources = t23Visible(ref c, by: in e, for: callee)
                        for x in t23PassedEffects(ref c, by: in e, for: i) {
                            sources.append(x)
                        }
                    }
                } else if kind == .builtinCall {
                    sources = t23Member(c.bBuiltinCalls[i].member)
                    direct = true
                } else if kind == .collection {
                    let t = c.bCollections[i].type
                    if kindOf(t) == .list || kindOf(t) == .map {
                        sources.append("alloc")
                        direct = true
                    }
                }
                for effect in sources {
                    continue if t23HasUse(in e.used[k], by: effect)
                    e.used[k].append(T23Use { effect: effect, span: nodeSpan(in c, for: node), direct: direct })
                    changed = true
                }
            }
        }
    }

    for k in 0..functions.length {
        let fn = functions[k]
        continue if functionIsInstance(ref c, by: fn) || c.functions[fn].body == -1 || c.functions[fn].file == -1
        let decl = t23DeclOf(ref c, for: fn)
        continue if t23IsCheck(ref c, for: fn, by: in decl)
        let file = c.functions[fn].file
        let name = c.functions[fn].name
        if e.declared.contains(fn) {
            let set = copyStrings(in e.declared[fn])
            var missing = List<T23Use>()
            for u in e.used[k] {
                if !listContainsString(in set, by: u.effect) {
                    missing.append(T23Use { effect: u.effect, span: u.span, direct: u.direct })
                }
            }
            t23SortBySpan(ref missing)
            // One fix declares every missing effect, so the fixes of one function's reports are the same edit.
            var fix = T23Fix {}
            if missing.length > 0 && decl.found {
                var names = List<string>()
                for p in t23Primitives() {
                    if t23HasUse(in missing, by: p) {
                        names.append(p)
                    }
                }
                fix = t23DeclareFix(ref c, from: file, for: in decl, by: in names)
            }
            for u in missing {
                report(
                    ref c,
                    for: .effectNotDeclared,
                    from: file,
                    at: u.span,
                    by: (name, u.effect, "", "", ""),
                    label: $"uses `{u.effect}`",
                    help: $"add `{u.effect}` to the `uses` clause, or remove the call",
                    hasFix: fix.has,
                    fixSpan: fix.span,
                    fixReplacement: fix.text,
                )
            }
        }
        var bounded = false
        var allowed = List<string>()
        if (c.capabilities is { } caps) {
            bounded = true
            allowed = copyStrings(in caps)
        }
        if bounded {
            // At the `uses` clause; a function that infers its effects has none, so its name stands in.
            var hasAt = false
            var at = TextSpan { start: 0, length: 0 }
            if decl.found {
                hasAt = true
                at = decl.hasUses ? decl.usesSpan : decl.name
            }
            var over = List<T23Use>()
            for u in e.used[k] {
                if u.direct
                        && listContainsString(in t23Capabilities(), by: u.effect)
                        && !listContainsString(in allowed, by: u.effect) {
                    over.append(T23Use { effect: u.effect, span: u.span, direct: u.direct })
                }
            }
            t23SortBySpan(ref over)
            let package = c.packageName == "" ? "main" : c.packageName
            for u in over {
                report(
                    ref c,
                    for: .capabilityExceeded,
                    from: file,
                    at: hasAt ? at : u.span,
                    by: (name, u.effect, package, "", ""),
                    label: $"uses `{u.effect}`",
                    help: $"add `.{u.effect}` to `capabilities`, or remove the use",
                )
            }
        }
    }

    // Outside a parameter, a function type's `uses` bounds what converts to it (R16, Q359).
    for k in 0..functions.length {
        let fn = functions[k]
        continue if functionIsInstance(ref c, by: fn) || c.functions[fn].body == -1 || c.functions[fn].file == -1
        let file = c.functions[fn].file
        var passed = List<BNode>()
        let nodes = descendants(in c, for: c.functions[fn].body)
        for node in nodes {
            let kind = boundKind(node)
            let i = boundIndex(node)
            if kind == .call {
                for p in t23Passed(ref c, for: i) {
                    passed.append(p.value)
                }
            }
            var function: FuncId = -1
            var type: Type = -1
            if kind == .lambda {
                function = c.bLambdas[i].lambda
                type = c.bLambdas[i].functionType
            } else if kind == .functionRef {
                function = c.bFunctionRefs[i].function
                type = c.bFunctionRefs[i].functionType
            }
            continue if function == -1 || type == -1 || listContains(in passed, by: node)
            let effects = t23Visible(ref c, by: in e, for: function)
            let bound = copyStrings(in c.functionTypes[typeIndex(type)].effects)
            for effect in t23Primitives() {
                continue if !listContainsString(in effects, by: effect) || listContainsString(in bound, by: effect)
                let limit = bound.length == 0 ? "pure" : $"uses {t23JoinText(in bound, by: ", ")}"
                report(
                    ref c,
                    for: .effectBoundExceeded,
                    from: file,
                    at: nodeSpan(in c, for: node),
                    by: (c.functions[function].name, effect, limit, typeDisplay(ref c, by: type), ""),
                    label: $"uses `{effect}`",
                    help: $"add `{effect}` to the function type's `uses`, or pass a function without it",
                )
            }
        }
    }

    for m in 0..c.modules.length {
        for s in copyIds(in c.modules[m].structs) {
            continue if c.structs[s].template != -1
            for conformance in copyIds(in c.structs[s].conformances) {
                var members = List<FuncId>()
                var witnesses = List<FuncId>()
                for w in c.conformances[conformance].witnesses {
                    members.append(w.key)
                    witnesses.append(w.value)
                }
                let iface = c.interfaces[c.conformances[conformance].iface].name
                for j in 0..members.length {
                    let member = members[j]
                    let witness = witnesses[j]
                    // A cloned default is checked against its own interface's declaration, not here.
                    continue if c.functions[witness].owner != s
                        || c.functions[witness].file == -1
                        || c.functions[member].kind == .getter
                    let bound = t23Visible(ref c, by: in e, for: member)
                    var shown = List<string>()
                    for p in t23Primitives() {
                        if listContainsString(in bound, by: p) {
                            shown.append(p)
                        }
                    }
                    let memberName = c.functions[member].name
                    for effect in t23Visible(ref c, by: in e, for: witness) {
                        continue if listContainsString(in bound, by: effect)
                        let limit = bound.length == 0 ? "pure" : $"uses {t23JoinText(in shown, by: ", ")}"
                        report(
                            ref c,
                            for: .effectBoundExceeded,
                            from: c.functions[witness].file,
                            at: c.functions[witness].nameSpan,
                            by: (c.functions[witness].name, effect, limit, $"{iface}.{memberName}", ""),
                            label: $"uses `{effect}`",
                            help: $"declare `{effect}` on `{iface}.{memberName}`, or pass a function without it",
                        )
                    }
                }
            }
        }
    }
}

/// C# `Visible`: an instance's template's effects, the declared set, the inferred set, or the `uses` clause.
List<string> t23Visible(ref Ctx c, by in T23Effects e, for FuncId f) {
    var callee = f
    if functionIsInstance(ref c, by: callee) {
        if (templateOf(ref c, for: callee) is { } template) {
            callee = template
        }
    }
    return copyStrings(in e.declared[callee]) if e.declared.contains(callee)
    if e.index.contains(callee) {
        var inferred = List<string>()
        for u in e.used[e.index[callee]] {
            inferred.append(u.effect)
        }
        return inferred
    }
    // Interface members of a built-in interface, and clones of a default member, are bounded like a declaration.
    let decl = t23DeclOf(ref c, for: callee)
    return [] if !decl.found || !decl.hasUses
    var none = List<string>()
    return t23Resolve(ref c, for: callee, by: in decl, from: in e.aliases, to: ref none, as: false)
}

bool t23HasUse(in List<T23Use> list, by string effect) {
    for u in list {
        return true if u.effect == effect
    }
    return false
}

/// C# `OrderBy(e => e.Value.Span.Start)`, which is stable.
void t23SortBySpan(ref List<T23Use> list) {
    for k in 1..list.length {
        var j = k
        while j > 0 && list[j - 1].span.start > list[j].span.start {
            let a = T23Use { effect: list[j - 1].effect, span: list[j - 1].span, direct: list[j - 1].direct }
            list[j - 1] = T23Use { effect: list[j].effect, span: list[j].span, direct: list[j].direct }
            list[j] = a
            j -= 1
        }
    }
}

/// C# `Passed`: the functions and lambdas a call passes to function-typed parameters, which charge their effects to the caller (R16).
List<T23Passed> t23Passed(ref Ctx c, for i64 call) {
    var result = List<T23Passed>()
    let arguments = copyIds(in c.bCalls[call].arguments)
    let parameters = copyIds(in c.functions[c.bCalls[call].function].parameters)
    var k: i64 = 0
    while k < arguments.length && k < parameters.length {
        if kindOf(c.locals[parameters[k]].type) == .function {
            var value = arguments[k]
            while boundKind(value) == .conversion {
                value = c.bConversions[boundIndex(value)].operand
            }
            if boundKind(value) == .lambda {
                result.append(T23Passed { value: value, function: c.bLambdas[boundIndex(value)].lambda })
            } else if boundKind(value) == .functionRef {
                result.append(T23Passed { value: value, function: c.bFunctionRefs[boundIndex(value)].function })
            }
        }
        k += 1
    }
    return result
}

/// C# `PassedValues`: the declared effects of function-typed values other than lambdas, functions and forwarded
/// parameters that a call passes to function-typed parameters, such as a local holding a lambda (R16).
List<string> t23PassedValues(ref Ctx c, for i64 call) {
    var result = List<string>()
    let arguments = copyIds(in c.bCalls[call].arguments)
    let parameters = copyIds(in c.functions[c.bCalls[call].function].parameters)
    var k: i64 = 0
    while k < arguments.length && k < parameters.length {
        if kindOf(c.locals[parameters[k]].type) == .function {
            var value = arguments[k]
            while boundKind(value) == .conversion {
                value = c.bConversions[boundIndex(value)].operand
            }
            let vk = boundKind(value)
            let forwarded = vk == .local && c.locals[c.bLocals[boundIndex(value)].local].isParameter
            if vk != .lambda && vk != .functionRef && !forwarded {
                let t = exprType(in c, for: value)
                if kindOf(t) == .function {
                    for effect in c.functionTypes[typeIndex(t)].effects {
                        result.append(effect)
                    }
                }
            }
        }
        k += 1
    }
    return result
}

/// C# `Passed(call).SelectMany(p => Visible(p.Function)).Concat(PassedValues(call))`.
List<string> t23PassedEffects(ref Ctx c, by in T23Effects e, for i64 call) {
    var result = List<string>()
    for p in t23Passed(ref c, for: call) {
        for x in t23Visible(ref c, by: in e, for: p.function) {
            result.append(x)
        }
    }
    for x in t23PassedValues(ref c, for: call) {
        result.append(x)
    }
    return result
}

/// A struct's `requires` check is pure to its callers: the violations it collects on failure come from
/// `context.allocator` like any error payload (Question 338).
bool t23IsCheck(ref Ctx c, for FuncId fn, by in T23Decl decl) =>
    c.functions[fn].name == "requires" && c.functions[fn].owner != -1 && !decl.found

/// C# `Declared`: the `uses` clause, or pure for a public function or an abstract method; `has` false when inferred.
T23Set t23Declared(
    ref Ctx c,
    for FuncId fn,
    from in List<Map<string,
    List<string>>> aliases,
    to ref List<string> reported
) {
    return T23Set {} if functionIsInstance(ref c, by: fn)
    let decl = t23DeclOf(ref c, for: fn)
    return T23Set { has: true } if t23IsCheck(ref c, for: fn, by: in decl)
    var set = T23Set {}
    if decl.found && decl.hasUses {
        set.has = true
        for x in t23Resolve(ref c, for: fn, by: in decl, from: in aliases, to: ref reported, as: true) {
            if !listContainsString(in set.effects, by: x) {
                set.effects.append(x)
            }
        }
    }
    // A getter or constructor has no `uses` clause to write (§14 bounds interface methods, not properties), so it infers.
    let kind = c.functions[fn].kind
    let entryMain = c.entryModule >= 0 && fn == c.modules[c.entryModule].main
    return T23Set {} if entryMain || kind == .main || kind == .testKeyword || kind == .getter || kind == .constructor
    return move set if set.has
    return T23Set { has: true } if c.functions[fn].access == .publicKeyword || c.functions[fn].isAbstract
    return T23Set {}
}

/// C# `Resolve`: the primitives a `uses` clause names, aliases expanded; BYN6003 for an unknown name, reported once
/// per clause. `track` false is the C# `reported: null`; a clause is keyed by its file and start.
List<string> t23Resolve(
    ref Ctx c,
    for FuncId fn,
    by in T23Decl decl,
    from in List<Map<string,
    List<string>>> aliases,
    to ref List<string> reported,
    as bool track
) {
    var doReport = false
    if track && c.functions[fn].file != -1 {
        let key = $"{decl.file}:{decl.usesSpan.start}"
        if !listContainsString(in reported, by: key) {
            reported.append(key)
            doReport = true
        }
    }
    let module = c.functions[fn].module
    let primitives = t23Primitives()
    var result = List<string>()
    for name in decl.usesEffects {
        let text = t15Text(in c, from: decl.file, at: name)
        if listContainsString(in primitives, by: text) {
            result.append(text)
        } else if module >= 0 && module < aliases.length && aliases[module].contains(text) {
            for x in aliases[module][text] {
                result.append(x)
            }
        } else if doReport {
            reportUnknown(ref c, from: c.functions[fn].file, at: name)
        }
    }
    return result
}

/// C# `ResolveAliases`: each `effect name = a, b` of the module, expanded to primitives.
Map<string, List<string>> t23ResolveAliases(ref Ctx c, for ModId module) {
    var a = T23Aliases {}
    let primitives = t23Primitives()
    for f in copyIds(in c.modules[module].files) {
        let count = c.files[f].unit.members.length
        for k in 0..count {
            var found = false
            var name = TextSpan { start: 0, length: 0 }
            var effects = List<TextSpan>()
            switch c.files[f].unit.members[k] {
                case .effectDecl(let d):
                    found = true
                    name = d.value.name
                    for x in d.value.effects {
                        effects.append(x)
                    }
                default: {}
            }
            continue if !found
            let text = t15Text(in c, from: f, at: name)
            let primitive = listContainsString(in primitives, by: text)
            if primitive || a.decls.contains(text) {
                report(
                    ref c,
                    for: .duplicateDeclaration,
                    from: f,
                    at: name,
                    by: (text, "", "", "", ""),
                    label: primitive ? "already an effect" : "",
                )
            } else {
                a.decls[text] = T23Alias { file: f, effects: move effects }
                a.order.append(text)
            }
            checkValue(ref c, from: f, at: name)
        }
    }
    for name in copyStrings(in a.order) {
        a.visiting = List<string>()
        let _ = t23Expand(ref a, through: ref c, for: name)
    }
    var resolved: Map<string, List<string>> = []
    for name in copyStrings(in a.order) {
        resolved[name] = copyStrings(in a.resolved[name])
    }
    return resolved
}

/// C# `Expand` inside `ResolveAliases`.
List<string> t23Expand(ref T23Aliases a, through ref Ctx c, for string name) {
    return copyStrings(in a.resolved[name]) if a.resolved.contains(name)
    let file = a.decls[name].file
    var effects = List<TextSpan>()
    for x in a.decls[name].effects {
        effects.append(x)
    }
    a.visiting.append(name)
    let primitives = t23Primitives()
    var result = List<string>()
    for e in effects {
        let text = t15Text(in c, from: file, at: e)
        if listContainsString(in primitives, by: text) {
            result.append(text)
        } else if listContainsString(in a.visiting, by: text) {
            report(
                ref c,
                for: .unknownEffect,
                from: file,
                at: e,
                by: (text, "", "", "", ""),
                label: "the alias refers to itself",
                help: t23UnknownEffectHelp,
            )
        } else if a.decls.contains(text) {
            for x in t23Expand(ref a, through: ref c, for: text) {
                result.append(x)
            }
        } else {
            reportUnknown(ref c, from: file, at: e)
        }
    }
    var still = List<string>()
    for v in a.visiting {
        if v != name {
            still.append(v)
        }
    }
    a.visiting = move still
    var distinct = List<string>()
    for x in result {
        if !listContainsString(in distinct, by: x) {
            distinct.append(x)
        }
    }
    a.resolved[name] = copyStrings(in distinct)
    return distinct
}

const t23UnknownEffectHelp: string = "choose one of `alloc`, `suspend`, `net`, `fs`, `clock`, `random`, `env`, `process`, `console`, or a declared effect alias"

void reportUnknown(ref Ctx c, from FileId f, at TextSpan name) {
    report(
        ref c,
        for: .unknownEffect,
        from: f,
        at: name,
        by: (t15Text(in c, from: f, at: name), "", "", "", ""),
        label: "not an effect or an `effect` alias of this module",
        help: t23UnknownEffectHelp,
    )
}

/// C# `DeclareFix`: adds the effects to the `uses` clause, or writes one after `where` and `expects`, before `becomes` and `fails` (BYN1065's order).
T23Fix t23DeclareFix(ref Ctx c, from FileId f, for in T23Decl decl, by in List<string> effects) {
    let list = t23JoinText(in effects, by: ", ")
    return T23Fix {
        has: true,
        span: TextSpan { start: decl.usesSpan.end, length: 0 },
        text: $", {list}",
    } if decl.hasUses
    let length = c.files[f].text.length
    var close = decl.closeFrom
    while close < length && c.files[f].text[close] != 41 {
        close += 1
    }
    var end = close + 1
    if decl.whereEnd > end {
        end = decl.whereEnd
    }
    if decl.requiresEnd > end {
        end = decl.requiresEnd
    }
    return T23Fix { has: true, span: TextSpan { start: end, length: 0 }, text: $" uses {list}" }
}

List<string> t23Builtin(BuiltinFunction f) {
    return ["console"] if f is .print or .ioStdout or .ioStderr or .ioStdin
    return ["fs", "alloc"] if f is .ioReadFile or .ioReadText or .ioListDir or .fsRealPath
    return ["fs"] if f is .ioWriteFile
        or .ioRemove
        or .ioCreateDirectory
        or .ioRemoveDirectory
        or .fsFileExists
        or .fsRename
        or .fsCopy
        or .fsModified
        or .fsSetModified
    return ["process", "alloc"] if f is .ioRun or .ioRunBatch
    return ["console", "alloc"] if f == .ioStdinReadAllBytes
    return ["clock"] if f is .ioMonotonicNanos or .timeNow
    // EffectAnalysis.cs:267
    return ["random"] if f == .ioRandomU64
    return ["env", "alloc"] if f == .envGet
    return ["alloc"] if f is .listNew
        or .ownedNew
        or .strBufGrow
        or .strBufOver
        or .arenaNew
        or .utf8Decode
        or .utf8TryDecode
        or .utf8DecodeReplace
        or .hexEncode
        or .hexDecode
        or .symbolIntern
        or .pathRelative
        or .pathFileName
        or .pathDirectoryName
        or .pathCombine
        or .pathCombineSpan
        or .pathFullPath
    return []
}

List<string> t23Member(BuiltinMember m) {
    return ["console"] if m == .ioWrite
    return ["console", "alloc"] if m == .ioReadAll
    return ["alloc"] if m is .spanCopy
        or .stringCopy
        or .listCopy
        or .mapCopy
        or .strBufCopy
        or .intToString
        or .listAdd
        or .listReplace
        or .mapSlot
        or .mapIndexSet
        or .stringLowercased
        or .stringUppercased
        or .stringReplaced
        or .stringRepeated
        or .stringPadded
        or .bytesToString
        or .stringJoined
        or .utf16Copy
    return []
}

/// Which error sets a body can fail with: `try`, partial `catch`, and `return .variant`.
List<ErrorSetId> propagated(ref Ctx c, for BStmt body) {
    var sets = List<ErrorSetId>()
    let nodes = descendants(in c, for: body)
    for node in nodes {
        let i = boundIndex(node)
        switch boundKind(node) {
            case .tryExpr:
                let operand = c.bTries[i].operand
                if boundKind(operand) == .call {
                    for s in copyIds(in c.functions[c.bCalls[boundIndex(operand)].function].errorSets) {
                        sets.append(s)
                    }
                }
            case .catchExpr:
                let operand = c.bCatches[i].operand
                let variant = c.bCatches[i].variant
                if boundKind(operand) == .call && variant != -1 {
                    for s in uncaught(ref c, for: c.bCalls[boundIndex(operand)].function, by: variant) {
                        sets.append(s)
                    }
                }
            case .failStmt:
                let t = exprType(in c, for: c.bFails[i].error)
                if kindOf(t) == .errorSet {
                    sets.append(typeIndex(t))
                } else if kindOf(t) == .errorUnion {
                    for s in copyIds(in c.errorUnionTypes[typeIndex(t)].sets) {
                        sets.append(s)
                    }
                }
            default: {}
        }
    }
    var distinct = List<ErrorSetId>()
    for s in sets {
        if !listContains(in distinct, by: s) {
            distinct.append(s)
        }
    }
    return distinct
}

/// The sets still propagated after `catch (Set.variant)` handles one variant.
List<ErrorSetId> uncaught(ref Ctx c, for FuncId callee, by VariantId caught) {
    var result = List<ErrorSetId>()
    let caughtSet = c.errorVariants[caught].set
    for s in c.functions[callee].errorSets {
        if !(s == caughtSet && c.errorSets[s].variants.length == 1) {
            result.append(s)
        }
    }
    return result
}

/// `fn.Decl`'s effect parts from the function's declaration, found by `declIndex`/`memberIndex` as `t22DeclFacts` does.
T23Decl t23DeclOf(ref Ctx c, for FuncId fn) {
    let f = c.functions[fn].file
    let d = c.functions[fn].declIndex
    let m = c.functions[fn].memberIndex
    return T23Decl {} if d < 0 || f == -1
    switch c.files[f].unit.members[d] {
        case .functionDecl(let n): return t23FactsOf(in n.value, from: f)
        default: break
    }
    return T23Decl {} if m < 0
    switch c.files[f].unit.members[d] {
        case .structDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return t23FactsOf(in x.value, from: f)
                default: break
            }
        case .interfaceDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return t23FactsOf(in x.value, from: f)
                default: break
            }
        case .extensionDecl(let n):
            switch n.value.members[m] {
                case .functionDecl(let x): return t23FactsOf(in x.value, from: f)
                default: break
            }
        default:
            break
    }
    return T23Decl {}
}

T23Decl t23FactsOf(in parser.FunctionDecl d, from FileId f) {
    var r = T23Decl { found: true, file: f, name: d.name }
    if (d.usesKeyword is { } u) {
        r.hasUses = true
        r.usesSpan = u.span
        for x in u.effects {
            r.usesEffects.append(x)
        }
    }
    r.closeFrom = d.params.length > 0 ? d.params[d.params.length - 1].span.end : d.paramsStart
    if d.where.length > 0 {
        r.whereEnd = d.where[d.where.length - 1].span.end
    }
    if d.requiresClauses.length > 0 {
        r.requiresEnd = parser.exprSpan(in d.requiresClauses[d.requiresClauses.length - 1]).end
    }
    return move r
}
== semantics/errorcases.byn
// T22: BinderErrors.cs.

import parser

// ── Error-case payloads ──────────────────────────────────────────────────────

BExpr bindErrorNew(ref Binder b, through ref Ctx c, for in parser.CallExpr call, to Type expected) {
    var callee: BExpr = -1
    switch call.callee {
        case .targetMemberExpr(let t):
            var inner = expected
            if expected != -1 && kindOf(expected) == .optional {
                inner = c.optionalTypes[typeIndex(expected)]
            } else if expected != -1 && kindOf(expected) == .result {
                inner = c.resultTypes[typeIndex(expected)].error
            }
            return -1 if inner == -1 || !(kindOf(inner) == .errorSet || kindOf(inner) == .errorUnion)
            callee = bindTargetMember(ref b, through: ref c, for: in t.value, to: expected)
        case .memberExpr(let m):
            return -1 if m.value.nullConditional
            switch m.value.target {
                case .nameExpr(let n):
                    return -1 if n.value.typeArgs.length > 0
                    let text = t15Text(in c, from: b.file, at: n.value.name)
                    return -1 if t15Lookup(ref b, for: text) != -1
                    let type = c.modules[c.files[b.file].module].types.tryGet(at: text) ?? -1
                    return -1 if type == -1 || kindOf(type) != .errorSet
                default: return -1
            }
            callee = bindMember(ref b, through: ref c, for: in m.value)
        default: return -1
    }
    return bindPayload(ref b, through: ref c, for: in call, by: callee) if boundKind(callee) == .errorVariant
    bindArgumentsForRecovery(ref b, through: ref c, for: in call)
    return recordSyntaxNode(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
        at: syntaxOfCall(ref c, from: in call),
    )
}

BExpr bindPayload(ref Binder b, through ref Ctx c, for in parser.CallExpr call, by BExpr variant) {
    let v = c.bErrorVariants[boundIndex(variant)].variant
    let vName = c.errorVariants[v].name
    if c.errorVariants[v].fields.length == 0 {
        report(
            ref b,
            through: ref c,
            for: .variantHasNoPayload,
            at: call.span,
            by: (vName, "", "", "", ""),
            help: $"write `.{vName}` without parentheses",
        )
        bindArgumentsForRecovery(ref b, through: ref c, for: in call)
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: call.span }),
            at: syntaxOfCall(ref c, from: in call),
        )
    }
    let fields = copyIds(in c.errorVariants[v].fields)
    let payload = bindArguments(
        ref b,
        through: ref c,
        for: in call,
        by: in fields,
        as: -1,
        enforceNames: false,
        displayName: vName,
    )
    return recordSyntaxNode(
        ref c,
        for: addErrorVariant(ref c, from: BErrorVariant { span: call.span, variant: v, payload: move payload }),
        at: syntaxOfCall(ref c, from: in call),
    )
}

/// C# `Built` (BinderErrors.cs:59-63). Pre-ported for T17 (callers use its result directly); T22 must not rewrite it.
BExpr built(ref Binder b, through ref Ctx c, for BExpr value, from in parser.Expr syntax) {
    let _ = checkPayloadGiven(ref b, through: ref c, for: value, from: in syntax)
    return value
}

bool checkPayloadGiven(ref Binder b, through ref Ctx c, for BExpr error, from in parser.Expr syntax) {
    return true if boundKind(error) != .errorVariant
    let v = c.bErrorVariants[boundIndex(error)].variant
    return true if c.bErrorVariants[boundIndex(error)].payload.length != 0 || c.errorVariants[v].fields.length == 0
    let vName = c.errorVariants[v].name
    var names = StrBuf()
    for i in 0..c.errorVariants[v].fields.length {
        if i > 0 {
            names.append(", ")
        }
        names.append(c.locals[c.errorVariants[v].fields[i]].name)
    }
    report(
        ref b,
        through: ref c,
        for: .variantNeedsPayload,
        at: parser.exprSpan(in syntax),
        by: (vName, "", "", "", ""),
        help: $"pass it: `.{vName}({names.finish()})`",
    )
    return false
}

// ── Error-case patterns ──────────────────────────────────────────────────────

BExpr errorCase(ref Binder b, through ref Ctx c, for in parser.Pattern p, from ErrorSetId set, at TextSpan name) {
    let text = t15Text(in c, from: b.file, at: name)
    let variant = findErrorVariant(ref c, by: set, for: text)
    return recordPatternSyntax(
        ref c,
        for: addErrorVariant(ref c, from: BErrorVariant { span: parser.patternSpan(in p), variant: variant }),
        from: in p,
    ) if variant != -1
    var names = List<string>()
    for v in c.errorSets[set].variants {
        names.append(c.errorVariants[v].name)
    }
    let close = suggest(text, by: in names)
    let display = errorSetDisplayName(ref c, by: set)
    if close is not null {
        report(
            ref b,
            through: ref c,
            for: .unknownVariant,
            at: name,
            by: (text, display, "", "", ""),
            help: $"did you mean `{close}`?",
        )
    } else {
        report(ref b, through: ref c, for: .unknownVariant, at: name, by: (text, display, "", "", ""))
    }
    return recordPatternSyntax(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: parser.patternSpan(in p) }),
        from: in p,
    )
}

BPattern bindErrorCasePattern(
    ref Binder b,
    through ref Ctx c,
    for in parser.Pattern p,
    as Type input,
    by BExpr bound,
    from in List<parser.Pattern> elements,
    at TextSpan? binding
) {
    let span = parser.patternSpan(in p)
    let target = unwrap(ref c, for: input)
    var variant: VariantId = -1
    if boundKind(bound) == .errorVariant {
        let ev = c.bErrorVariants[boundIndex(bound)].variant
        let set = c.errorVariants[ev].set
        var mismatch = false
        if kindOf(target) == .errorUnion {
            let u = typeIndex(target)
            mismatch = c.errorUnionTypes[u].sets.length > 0
                && (!listContains(in c.errorUnionTypes[u].sets, by: set)
                    || listContains(in c.errorUnionTypes[u].excluded, by: ev))
        }
        if !mismatch && kindOf(target) == .errorSet {
            mismatch = typeIndex(target) != set
        }
        if mismatch {
            report(
                ref b,
                through: ref c,
                for: .patternMismatch,
                at: span,
                by: (
                    $"`{errorSetDisplayName(ref c, by: set)}.{c.errorVariants[ev].name}`",
                    typeDisplay(ref c, by: target),
                    "",
                    "",
                    ""
                ),
            )
        } else {
            variant = ev
        }
    }
    if binding is not null {
        let local = declareLocal(
            ref b,
            through: ref c,
            at: binding,
            as: variant == -1 ? errorType() : target,
            for: .patternVariable,
        )
        return recordPatternSyntax(
            ref c,
            for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
            from: in p,
        ) if variant == -1
        b.errorNarrowed[local] = variant
        let left = recordPatternSyntax(
            ref c,
            for: addErrorPattern(ref c, from: BErrorPattern { span: span, inputType: input, variant: variant }),
            from: in p,
        )
        let right = recordPatternSyntax(
            ref c,
            for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input, local: local }),
            from: in p,
        )
        return recordPatternSyntax(
            ref c,
            for: addBinaryPattern(
                ref c,
                from: BBinaryPattern { span: span, inputType: input, isAnd: true, left: left, right: right },
            ),
            from: in p,
        )
    }
    let fieldCount = variant == -1 ? 0 : c.errorVariants[variant].fields.length
    if variant != -1 && fieldCount == 0 {
        let vName = c.errorVariants[variant].name
        report(
            ref b,
            through: ref c,
            for: .variantHasNoPayload,
            at: span,
            by: (vName, "", "", "", ""),
            help: $"match it with `.{vName}`",
        )
    } else if variant != -1 && elements.length != fieldCount {
        let vName = c.errorVariants[variant].name
        var lets = StrBuf()
        for i in 0..fieldCount {
            if i > 0 {
                lets.append(", ")
            }
            lets.append($"let {c.locals[c.errorVariants[variant].fields[i]].name}")
        }
        report(
            ref b,
            through: ref c,
            for: .variantPatternArity,
            at: span,
            by: (vName, $"{fieldCount}", $"{elements.length}", "", ""),
            help: $"list every field: `.{vName}({lets.finish()})`, or `_` to skip one",
        )
    }
    let ok = variant != -1 && fieldCount == elements.length && elements.length > 0
    var subs = List<BPattern>()
    for i in 0..elements.length {
        let type = ok ? c.locals[c.errorVariants[variant].fields[i]].type : errorType()
        subs.append(bindPattern(ref b, through: ref c, for: in elements[i], as: type))
    }
    return recordPatternSyntax(
        ref c,
        for: addErrorPattern(
            ref c,
            from: BErrorPattern { span: span, inputType: input, variant: variant, subpatterns: move subs },
        ),
        from: in p,
    ) if ok
    return recordPatternSyntax(
        ref c,
        for: addBindPattern(ref c, from: BBindPattern { span: span, inputType: input }),
        from: in p,
    )
}
== semantics/express.byn
// T17: BinderExpressions.cs 1-~599 (conversions, literals, names).

import parser

type NamedType          = parser.NamedType
type OptionalType       = parser.OptionalType
type PointerType        = parser.PointerType
type TupleTypeElement   = parser.TupleTypeElement
type TupleType          = parser.TupleType
type FailsClause        = parser.FailsClause
type UsesClause         = parser.UsesClause
type FunctionTypeSyntax = parser.FunctionTypeSyntax
type DynType            = parser.DynType
type RefinedType        = parser.RefinedType
type ArrayType          = parser.ArrayType
type LiteralExpr        = parser.LiteralExpr
type NameExpr           = parser.NameExpr

BExpr bindExpr(ref Binder b, through ref Ctx c, for in parser.Expr e, to Type expected = -1) =>
    asValue(ref b, through: ref c, for: bindExprOrType(ref b, through: ref c, for: in e, to: expected), from: in e)

BExpr asValue(ref Binder b, through ref Ctx c, for BExpr bound, from in parser.Expr e) {
    let span = parser.exprSpan(in e)
    switch boundKind(bound) {
        case .typeRef:
            let t = c.bTypeRefs[boundIndex(bound)].referenced
            let disp = typeDisplay(ref c, by: t)
            report(ref b, through: ref c, for: .notAValue, at: span, by: (disp, "type", "", "", ""))
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: in e)
        case .moduleRef:
            let m = c.bModuleRefs[boundIndex(bound)].module
            let modName = c.modules[m].name
            report(ref b, through: ref c, for: .notAValue, at: span, by: (modName, "module", "", "", ""))
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: in e)
        case .variantGroup:
            let vId = c.bVariantGroups[boundIndex(bound)].variant
            let vName = c.unionVariants[vId].name
            let uOwner = c.unionVariants[vId].owner
            let uName = c.unions[uOwner].name
            var fNames = StrBuf()
            for fi in 0..c.unionVariants[vId].fields.length {
                if fi > 0 {
                    fNames.append(", ")
                }
                let fId = c.unionVariants[vId].fields[fi]
                fNames.append(c.locals[fId].name)
            }
            let help = $"pass it: `{uName}.{vName}({fNames.finish()})`"
            report(ref b, through: ref c, for: .variantNeedsPayload, at: span, by: (vName, "", "", "", ""), help: help)
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: in e)
        case .methodGroup:
            let fn = c.bMethodGroups[boundIndex(bound)].function
            let fnName = c.functions[fn].name
            let kindStr = c.functions[fn].kind == .function ? "function" : "method"
            let dotDot = c.functions[fn].parameters.length == 0 ? "" : "…"
            let help = $"call it: `{fnName}({dotDot})`"
            report(ref b, through: ref c, for: .notAValue, at: span, by: (fnName, kindStr, "", "", ""), help: help)
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: in e)
        case .builtinGroup:
            let bg = c.bBuiltinGroups[boundIndex(bound)]
            report(
                ref b,
                through: ref c,
                for: .notAValue,
                at: span,
                by: (bg.name, "method", "", "", ""),
                help: $"call it: `{bg.name}()`",
            )
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: in e)
        default:
            return bound
    }
}

BExpr bindConverted(ref Binder b, through ref Ctx c, for in parser.Expr e, to Type target, bool argument = false) {
    let bound = built(ref b, through: ref c, for: bindExprFor(ref b, through: ref c, for: in e, to: target), from: in e)
    return convert(ref b, through: ref c, for: bound, to: target, at: parser.exprSpan(in e), argument: argument)
}

BExpr bindExprFor(ref Binder b, through ref Ctx c, for in parser.Expr e, to Type expected) {
    let bound = bindExprOrType(ref b, through: ref c, for: in e, to: expected)
    if expected != -1 && kindOf(expected) == .function {
        let bk = boundKind(bound)
        return bound if bk is .methodGroup or .variantGroup
        if bk == .typeRef {
            let t = c.bTypeRefs[boundIndex(bound)].referenced
            if kindOf(t) == .structType {
                let s = typeIndex(t)
                return bound if t17Constructible(in c, for: s)
            }
        }
    }
    return asValue(ref b, through: ref c, for: bound, from: in e)
}

bool t17Constructible(in Ctx c, for StructId s) =>
    c.structs[s].constructors.length > 0
    || c.distinct.contains(s)
    || c.positional.contains(declKey(c.structs[s].file, at: c.structs[s].declIndex))

BExpr bindStatementExpression(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    let bound = bindExpr(ref b, through: ref c, for: in e)
    let t = exprType(in c, for: bound)
    if !isVoid(t) && !isNever(t) && !isError(t) {
        let span = parser.exprSpan(in e)
        let text = t15Text(in c, from: b.file, at: span)
        report(
            ref b,
            through: ref c,
            for: .unusedValue,
            at: span,
            by: (text, "", "", "", ""),
            label: "value dropped",
            help: "assign it with `let _ = …`, or remove the expression",
        )
    }
    return bound
}

BExpr convert(
    ref Binder b,
    through ref Ctx c,
    for BExpr value,
    to Type target,
    at TextSpan span,
    bool argument = false,
    bool constrains = true
) {
    if constrains {
        constrain(ref b, through: ref c, for: value, to: target)
    }
    if target != -1 && kindOf(target) == .function {
        let bk = boundKind(value)
        return t17ConvertToFunction(ref b, through: ref c, for: value, to: target, at: span) if bk is .methodGroup
            or .variantGroup
            or .typeRef
    }
    let vt = exprType(in c, for: value)
    return value if vt == target || isError(target) || isError(vt)
    // Every node below is built on `value.Syntax`: its span and syntax facts.
    let at = nodeSpan(in c, for: value)
    return fact(ref c, for: value) if kindOf(vt) == .untrusted
        && isBool(c.untrustedTypes[typeIndex(vt)])
        && isBool(target)

    if (exprConstant(in c, for: value) is { } k) && k.kind == .integer && isInteger(vt)
            && (isInteger(target)
            || isFloat(target)
            || (kindOf(target) == .optional && isNumeric(c.optionalTypes[typeIndex(target)]))) {
        let inner = kindOf(target) == .optional ? c.optionalTypes[typeIndex(target)] : target
        if isInteger(inner) && !fits(k.integer, for: primKindOf(typeIndex(inner))) {
            let innerDisp = typeDisplay(ref c, by: inner)
            report(
                ref b,
                through: ref c,
                for: .literalOutOfRange,
                at: span,
                by: (bigText(k.integer), $"`{innerDisp}`", "", "", ""),
                help: t17RangeHelp(primKindOf(typeIndex(inner))),
            )
            return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: at }), from: value)
        }
        let litVal = isFloat(inner) ? Constant { kind: .real, real: bigToF64(k.integer) } : k
        let lit = t17SameSyntax(ref c, for: literal(ref c, at: at, as: inner, by: litVal), from: value)
        return lit if inner == target
        return t17SameSyntax(
            ref c,
            for: addConversion(ref c, from: BConversion { span: at, operand: lit, type: target, kind: .toOptional }),
            from: value,
        )
    }

    return t17SameSyntax(
        ref c,
        for: literal(ref c, at: at, as: target, by: Constant { kind: .real, real: f64(f32(kReal.real)) }),
        from: value,
    ) if (exprConstant(in c, for: value) is { } kReal) && kReal.kind == .real
        && target == prim(.f32)
        && hasSyntax(in c, for: value, by: syntaxLiteral)

    return t17SameSyntax(
        ref c,
        for: addBuiltinCall(
            ref c,
            from: BBuiltinCall { span: at, member: .enumName, receiver: value, type: prim(.string) },
        ),
        from: value,
    ) if b.printArgument
        && argument
        && kindOf(vt) == .enumType
        && isString(target)

    if boundKind(value) == .staticArray && kindOf(target) == .span && !c.spanTypes[typeIndex(target)].readOnly {
        let elemDisp = typeDisplay(ref c, by: c.spanTypes[typeIndex(target)].element)
        report(
            ref b,
            through: ref c,
            for: .typeMismatch,
            at: span,
            by: (typeDisplay(ref c, by: vt), typeDisplay(ref c, by: target), "", "", ""),
            label: "a `const` array cannot be written through",
            help: $"take a `ReadOnlySpan<{elemDisp}>`",
        )
        return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: at }), from: value)
    }

    if (implicit(ref c, from: vt, to: target, argument: argument) is { } kind) {
        return value if kind == .identity
        return t17SameSyntax(
            ref c,
            for: addDefault(ref c, from: BDefault { span: at, type: target }),
            from: value,
        ) if kind == .nullToOptional
        if kind == .toDynRef && kindOf(target) == .dynRef && !c.dynRefTypes[typeIndex(target)].readOnly {
            let _ = checkWritable(
                ref b,
                through: ref c,
                for: value,
                at: span,
                by: $"it is borrowed as `{typeDisplay(ref c, by: target)}`",
            )
        }
        let converted = t17SameSyntax(
            ref c,
            for: addConversion(ref c, from: BConversion { span: at, operand: value, type: target, kind: kind }),
            from: value,
        )
        if (exprConstant(in c, for: value) is { } cConst) && kind == .widen {
            setConstant(ref c, for: converted, to: t17WidenConstant(in cConst, to: target))
        }
        return converted
    }

    if (b.sinkArgument is { } sink) && t17ContainsUntrusted(in c, for: vt) {
        report(
            ref b,
            through: ref c,
            for: .untrustedSink,
            at: span,
            by: (typeDisplay(ref c, by: vt), sink, "", "", ""),
            help: "check the value, then clear the mark with `x.trustUnchecked() because \"…\"`",
        )
        return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: at }), from: value)
    }

    let isTargetSymbol = target == builtinType(.symbol)
        || (kindOf(target) == .optional && c.optionalTypes[typeIndex(target)] == builtinType(.symbol))
    if isString(vt) && isTargetSymbol {
        let text = t15Text(in c, from: b.file, at: span)
        report(
            ref b,
            through: ref c,
            for: .stringNotSymbol,
            at: span,
            by: ("", "", "", "", ""),
            help: $"convert it with `Symbol.intern({text})`",
            hasFix: true,
            fixSpan: span,
            fixReplacement: $"Symbol.intern({text})",
        )
        return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: at }), from: value)
    }

    if kindOf(target) == .structType
            && c.distinct.contains(typeIndex(target))
            && exprConstant(in c, for: value) is not null {
        let s = typeIndex(target)
        let sName = c.structs[s].name
        let text = t15Text(in c, from: b.file, at: span)
        report(
            ref b,
            through: ref c,
            for: .bareLiteralForDistinct,
            at: span,
            by: (text, sName, "", "", ""),
            help: $"wrap it: `{sName}({text})`",
            hasFix: true,
            fixSpan: span,
            fixReplacement: $"{sName}({text})",
        )
        return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: at }), from: value)
    }

    t17ReportMismatch(ref b, through: ref c, for: value, to: target, at: span)
    return t17SameSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: at }), from: value)
}

/// `n`, built on the same C# `Syntax` as `value`: it carries `value`'s syntax facts and node.
BExpr t17SameSyntax(ref Ctx c, for BExpr n, from BExpr value) {
    let flags = syntaxFlags(in c, for: value)
    if flags != 0 {
        setSyntaxFlags(ref c, for: n, to: flags)
    }
    return shareSyntax(ref c, for: n, from: value)
}

BExpr t17ConvertToFunction(ref Binder b, through ref Ctx c, for BExpr value, to Type target, at TextSpan span) {
    let text = t15Text(in c, from: b.file, at: span)
    let ft = typeIndex(target)
    let bk = boundKind(value)
    if bk == .methodGroup {
        let bi = boundIndex(value)
        let fn = c.bMethodGroups[bi].function
        let recv = c.bMethodGroups[bi].receiver
        if recv == -1
                && c.functions[fn].kind == .function
                && c.functions[fn].owner == -1
                && !functionIsGeneric(ref c, by: fn)
                && c.bMethodGroups[bi].typeArgs.length == 0 {
            var overloads = List<FuncId>()
            overloads.append(fn)
            if (c.modules[c.functions[fn].module].functions.tryGet(at: c.functions[fn].name) is { } fs) {
                var has = false
                for f in fs {
                    if f == fn {
                        has = true
                    }
                }
                if has {
                    overloads = copyIds(in fs)
                }
            }
            for f in overloads {
                return shareSyntax(
                    ref c,
                    for: addFunctionRef(
                        ref c,
                        from: BFunctionRef { span: nodeSpan(in c, for: value), function: f, functionType: target },
                    ),
                    from: value,
                ) if implicitFunction(ref c, from: f, to: target) is not null
            }
            // Mismatch: build signature and report
            var sig = StrBuf()
            sig.append(typeDisplay(ref c, by: c.functions[fn].returnType))
            sig.append(" ")
            sig.append(c.functions[fn].name)
            sig.append("(")
            let pIds = copyIds(in c.functions[fn].parameters)
            for pi in 0..pIds.length {
                if pi > 0 {
                    sig.append(", ")
                }
                let pId = pIds[pi]
                switch c.locals[pId].modifier {
                    case .none: break
                    case .refKeyword: sig.append("ref ")
                    case .moveKeyword: sig.append("move ")
                    case .outKeyword: sig.append("out ")
                    case .inKeyword: sig.append("in ")
                }
                sig.append(typeDisplay(ref c, by: c.locals[pId].type))
            }
            sig.append(")")
            if c.functions[fn].hasFails {
                sig.append(" fails")
                let eSets = copyIds(in c.functions[fn].errorSets)
                if eSets.length > 0 {
                    sig.append(" ")
                    for ei in 0..eSets.length {
                        if ei > 0 {
                            sig.append(", ")
                        }
                        sig.append(errorSetDisplayName(ref c, by: eSets[ei]))
                    }
                }
            }
            var help = ""
            if c.functions[fn].hasFails
                    && c.functions[fn].errorSets.length == 0
                    && c.functionTypes[ft].errorSets.length > 0 {
                var setNames = StrBuf()
                let tSets = copyIds(in c.functionTypes[ft].errorSets)
                for si in 0..tSets.length {
                    if si > 0 {
                        setNames.append(", ")
                    }
                    setNames.append(errorSetDisplayName(ref c, by: tSets[si]))
                }
                help = $"declare the error sets of `{c.functions[fn].name}`: `fails {setNames.finish()}`"
            } else {
                help = $"pass a function of type `{typeDisplay(ref c, by: target)}`"
            }
            report(
                ref b,
                through: ref c,
                for: .typeMismatch,
                at: span,
                by: (sig.finish(), typeDisplay(ref c, by: target), "", "", ""),
                help: help,
            )
            return shareSyntax(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: nodeSpan(in c, for: value) }),
                from: value,
            )
        }
    }

    var reason = ""
    var pNames = List<string>()
    // The particle of each parameter's C# `Syntax`, or null (a variant field or a struct field has none).
    var pParticles = List<string?>()
    if bk == .methodGroup {
        let bi = boundIndex(value)
        let fn = c.bMethodGroups[bi].function
        let recv = c.bMethodGroups[bi].receiver
        if c.functions[fn].kind == .builtin {
            reason = "it is built in"
        } else if c.functions[fn].kind == .constructor {
            reason = "it is a constructor"
        } else if recv != -1 || c.functions[fn].owner != -1 || c.functions[fn].iface != -1 {
            reason = "it is a method"
        } else if functionIsGeneric(ref c, by: fn) || c.bMethodGroups[bi].typeArgs.length > 0 {
            reason = "it is generic"
        } else {
            reason = "it is not a module function"
        }
        t17ParameterNames(in c, for: fn, to: ref pNames, by: ref pParticles)
    } else if bk == .variantGroup {
        let vId = c.bVariantGroups[boundIndex(value)].variant
        reason = "it is a union variant"
        for fId in c.unionVariants[vId].fields {
            pNames.append(c.locals[fId].name)
            pParticles.append(null)
        }
    } else if bk == .typeRef {
        let t = c.bTypeRefs[boundIndex(value)].referenced
        if kindOf(t) == .structType && t17Constructible(in c, for: typeIndex(t)) {
            let s = typeIndex(t)
            reason = "it is a constructor"
            if c.structs[s].constructors.length > 0 {
                t17ParameterNames(in c, for: c.structs[s].constructors[0], to: ref pNames, by: ref pParticles)
            } else {
                for fId in c.structs[s].fields {
                    pNames.append(c.fields[fId].name)
                    pParticles.append(null)
                }
            }
        } else {
            return value
        }
    } else {
        return value
    }

    let targetCount = c.functionTypes[ft].parameters.length
    var names = List<string>()
    var count = 0
    while count < pNames.length && count < targetCount {
        names.append(pNames[count])
        count += 1
    }

    var lambdaBuf = StrBuf()
    if names.length == 1 {
        lambdaBuf.append(names[0])
    } else {
        lambdaBuf.append("(")
        for ni in 0..names.length {
            if ni > 0 {
                lambdaBuf.append(", ")
            }
            lambdaBuf.append(names[ni])
        }
        lambdaBuf.append(")")
    }
    var argsBuf = StrBuf()
    for ai in 0..names.length {
        if ai > 0 {
            argsBuf.append(", ")
        }
        if (pParticles[ai] is { } particle) {
            argsBuf.append(particle)
            argsBuf.append(": ")
        }
        argsBuf.append(names[ai])
    }
    let help = $"wrap it in a lambda: `{lambdaBuf.finish()} => {text}({argsBuf.finish()})`"
    report(ref b, through: ref c, for: .notAFunctionValue, at: span, by: (text, reason, "", "", ""), help: help)
    return shareSyntax(
        ref c,
        for: addErrorExpr(ref c, from: BErrorExpr { span: nodeSpan(in c, for: value) }),
        from: value,
    )
}

/// `fn`'s parameter names, each with the particle of its C# `Syntax` (`t12Params`, Q713), or null.
void t17ParameterNames(in Ctx c, for FuncId fn, to ref List<string> names, by ref List<string?> particles) {
    let ps = t12Params(in c, for: fn)
    for i in 0..ps.length {
        names.append(c.locals[c.functions[fn].parameters[i]].name)
        var particle: string? = null
        if (ps[i].syntax is { } x) && x.hasParticle {
            particle = ps[i].label
        }
        particles.append(particle)
    }
}

void constrain(ref Binder b, through ref Ctx c, for BExpr value, to Type target) {
    return if !isInteger(target) && !isFloat(target) && !isString(target)
    let vk = boundKind(value)
    if vk == .local {
        let l = c.bLocals[boundIndex(value)].local
        if b.pending.contains(l) {
            let decl = b.pending[l]
            if !b.constraints.contains(decl) {
                b.constraints[decl] = target
            }
        }
    } else if vk == .binary && isPending(ref b, through: ref c, for: value) {
        let bin = c.bBinaries[boundIndex(value)]
        constrain(ref b, through: ref c, for: bin.left, to: target)
        constrain(ref b, through: ref c, for: bin.right, to: target)
    } else if vk == .unary && isPending(ref b, through: ref c, for: value) {
        let u = c.bUnaries[boundIndex(value)]
        constrain(ref b, through: ref c, for: u.operand, to: target)
    }
}

void constrain(ref Binder b, through ref Ctx c, for BExpr value, as BExpr other, from in parser.Expr otherSyntax) {
    if isPending(ref b, through: ref c, for: other) {
        return if !isPending(ref b, through: ref c, for: value)
        var decls = List<i64>()
        t17PendingDecls(ref b, through: ref c, for: value, to: ref decls)
        t17PendingDecls(ref b, through: ref c, for: other, to: ref decls)
        var root = List<i64>()
        for d in decls {
            root.append(findPeer(ref b, for: d))
        }
        if root.length > 1 {
            let root0 = root[0]
            for i in 1..root.length {
                let r = root[i]
                if r != root0 {
                    b.peers[r] = root0
                }
            }
        }
    } else if !isUntypedLiteral(in otherSyntax) {
        let otherType = exprType(in c, for: other)
        constrain(ref b, through: ref c, for: value, to: otherType)
    }
}

void t17PendingDecls(ref Binder b, through ref Ctx c, for BExpr e, to ref List<i64> outDecls) {
    switch boundKind(e) {
        case .local:
            let l = c.bLocals[boundIndex(e)].local
            if b.pending.contains(l) {
                outDecls.append(b.pending[l])
            }
        case .binary:
            let bin = c.bBinaries[boundIndex(e)]
            t17PendingDecls(ref b, through: ref c, for: bin.left, to: ref outDecls)
            t17PendingDecls(ref b, through: ref c, for: bin.right, to: ref outDecls)
        case .unary:
            let u = c.bUnaries[boundIndex(e)]
            t17PendingDecls(ref b, through: ref c, for: u.operand, to: ref outDecls)
        default:
            return
    }
}

i64 findPeer(ref Binder b, for i64 key) {
    var d = key
    while b.peers.contains(d) {
        d = b.peers[d]
    }
    return d
}

bool isPending(ref Binder b, through ref Ctx c, for BExpr e) {
    switch boundKind(e) {
        case .local:
            let l = c.bLocals[boundIndex(e)].local
            return b.pending.contains(l)
        case .binary:
            let bin = c.bBinaries[boundIndex(e)]
            return false if !isInteger(bin.type)
            return (isPending(ref b, through: ref c, for: bin.left) || isPending(ref b, through: ref c, for: bin.right))
                && t17Untyped(ref b, through: ref c, for: bin.left)
                && t17Untyped(ref b, through: ref c, for: bin.right)
        case .unary:
            let u = c.bUnaries[boundIndex(e)]
            return false if !isInteger(u.type)
            return false if u.op != .negate && u.op != .plus && u.op != .complement
            return isPending(ref b, through: ref c, for: u.operand)
        default:
            return false
    }
}

bool t17Untyped(ref Binder b, through ref Ctx c, for BExpr e) =>
    isPending(ref b, through: ref c, for: e) || hasSyntax(in c, for: e, by: syntaxUntypedLiteral)

bool t17ContainsUntrusted(in Ctx c, for Type t) {
    switch kindOf(t) {
        case .untrusted: return true
        case .list: return t17ContainsUntrusted(in c, for: c.listTypes[typeIndex(t)])
        case .span: return t17ContainsUntrusted(in c, for: c.spanTypes[typeIndex(t)].element)
        case .array: return t17ContainsUntrusted(in c, for: c.arrayTypes[typeIndex(t)].element)
        case .optional: return t17ContainsUntrusted(in c, for: c.optionalTypes[typeIndex(t)])
        default: return false
    }
}

Constant t17WidenConstant(in Constant k, to Type target) {
    return Constant { kind: .real, real: bigToF64(k.integer) } if isFloat(target) && k.kind == .integer
    return k
}

void t17ReportMismatch(ref Binder b, through ref Ctx c, for BExpr value, to Type target, at TextSpan span) {
    let vt = exprType(in c, for: value)
    var help = ""
    var hasFix = false
    var fixReplacement = ""
    let expKind = explicit(ref c, from: vt, to: target)
    if expKind == .numericCast || expKind == .charToInteger || expKind == .integerToChar {
        let text = t15Text(in c, from: b.file, at: span)
        let targetDisp = typeDisplay(ref c, by: target)
        if isNumeric(vt) && isNumeric(target) {
            help = $"convert it if the value always fits; `{typeDisplay(ref c, by: vt)}` does not convert to `{targetDisp}` without loss"
        } else {
            help = "convert it explicitly"
        }
        hasFix = true
        fixReplacement = $"{targetDisp}({text})"
    } else if kindOf(vt) == .optional && c.optionalTypes[typeIndex(vt)] == target {
        help = "unwrap it with `??`, `is { } v`, or `?? return`; the value may be absent"
    } else if kindOf(vt) == .list && kindOf(target) == .span {
        help = "use `.span` here; a `List` becomes a `Span` implicitly only as a call argument"
    }
    report(
        ref b,
        through: ref c,
        for: .typeMismatch,
        at: span,
        by: (typeDisplay(ref c, by: vt), typeDisplay(ref c, by: target), "", "", ""),
        help: help,
        hasFix: hasFix,
        fixSpan: span,
        fixReplacement: fixReplacement,
    )
}

string t17RangeHelp(PrimitiveKind k) {
    let r = range(k)
    return $"use a value from {bigText(r.min)} to {bigText(r.max)}, the range of `{primitiveName(k)}`"
}

bool fits(Big n, for PrimitiveKind t) {
    let r = range(t)
    return bigCmp(n, as: r.min) >= 0 && bigCmp(n, as: r.max) <= 0
}

BExpr literal(ref Ctx c, at TextSpan span, as Type type, by in Constant value) {
    let lit = addLiteral(ref c, from: BLiteral { span: span, type: type, value: value })
    setConstant(ref c, for: lit, to: value)
    return lit
}

BExpr bindExprOrType(ref Binder b, through ref Ctx c, for in parser.Expr e, to Type expected = -1) {
    switch e {
        case .literalExpr(let l):
            return bindLiteral(ref b, through: ref c, for: in l.value, to: expected)
        case .parenExpr(let p):
            return bindExprOrType(ref b, through: ref c, for: in p.value.inner, to: expected)
        case .nameExpr(let n):
            return bindName(ref b, through: ref c, for: in n.value)
        case .thisExpr(let t):
            let host = host(b, through: c)
            let isHostValid = host != -1
                && !c.functions[host].isStatic
                && (c.functions[host].kind is .method or .getter or .constructor)
            if b.thisType == -1 || !isHostValid {
                report(ref b, through: ref c, for: .thisOutsideMethod, at: t.value.span, by: ("", "", "", "", ""))
                return recordSyntax(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: t.value.span }),
                    from: in e,
                )
            }
            return recordSyntax(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: t.value.span }),
                from: in e,
            ) if inLambda(ref b, through: ref c, at: t.value.span, for: "this", by: "a lambda does not capture `this`")
            return recordSyntax(
                ref c,
                for: addThis(ref c, from: BThis { span: t.value.span, type: b.thisType }),
                from: in e,
            )
        case .memberExpr(let m):
            return bindMember(ref b, through: ref c, for: in m.value)
        case .targetMemberExpr(let t):
            return bindTargetMember(ref b, through: ref c, for: in t.value, to: expected)
        case .callExpr(let call):
            let errNew = bindErrorNew(ref b, through: ref c, for: in call.value, to: expected)
            @unobservable because "Q600: bindErrorNew and bindCall are stubs; add an error-constructor call case when they land"
            return errNew if errNew != -1
            return bindCall(ref b, through: ref c, for: in call.value, from: e, to: expected)
        case .indexExpr(let i):
            return bindIndex(ref b, through: ref c, for: in i.value)
        case .unaryExpr(let u):
            return bindUnary(ref b, through: ref c, for: in u.value, to: expected)
        case .binaryExpr(let bin):
            return bindBinary(ref b, through: ref c, for: in bin.value, to: expected)
        case .rangeExpr(let r):
            return bindRange(ref b, through: ref c, for: in r.value, to: expected)
        case .conditionalExpr(let cond):
            return bindConditional(ref b, through: ref c, for: in cond.value, to: expected)
        case .castExpr(let cast):
            return bindCast(ref b, through: ref c, for: in cast.value, from: e)
        case .isExpr(let isE):
            let val = bindExpr(ref b, through: ref c, for: in isE.value.value)
            if c.typedLints.length > 0 {
                noteLintOperand(ref c, for: b.file, at: parser.exprSpan(in isE.value.value), by: val)
            }
            let pat = bindPattern(ref b, through: ref c, for: in isE.value.pattern, as: exprType(in c, for: val))
            return recordSyntax(
                ref c,
                for: addIs(ref c, from: BIs { span: isE.value.span, value: val, pattern: pat }),
                from: in e,
            )
        case .inExpr(let inE):
            return bindIn(ref b, through: ref c, for: in inE.value)
        case .switchExpr(let sw):
            return bindSwitchExpr(ref b, through: ref c, for: in sw.value, to: expected)
        case .tryExpr(let tr):
            return bindTry(ref b, through: ref c, for: in tr.value, to: expected)
        case .moveExpr(let mv):
            let operand = bindExpr(ref b, through: ref c, for: in mv.value.operand, to: expected)
            return t21BindMove(
                ref b,
                through: ref c,
                at: mv.value.span,
                for: operand,
                from: syntaxLeaf(ref c, as: .moveExpr, at: mv.value.span),
            )
        case .catchExpr(let ct):
            return bindCatch(ref b, through: ref c, for: in ct.value, to: expected)
        case .caughtErrorExpr(let ce):
            return recordSyntax(
                ref c,
                for: addLocalNode(ref c, at: ce.value.span, for: b.caught),
                from: in e,
            ) if b.caught != -1
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: ce.value.span }), from: in e)
        case .jumpExpr(let j):
            let stmt = bindStatement(ref b, through: ref c, for: in j.value.jump)
            return recordSyntax(ref c, for: addJump(ref c, from: BJump { span: j.value.span, jump: stmt }), from: in e)
        case .blockExpr(let bNode):
            switch bNode.value.block {
                case .blockStmt(let bs):
                    let blk = bindBlock(ref b, through: ref c, for: in bs.value)
                    return recordSyntax(
                        ref c,
                        for: addBlockExpr(
                            ref c,
                            from: BBlockExpr { span: bNode.value.span, block: blk, type: prim(.void) },
                        ),
                        from: in e,
                    )
                default:
                    panic("internal error: a block expression's block is a `BlockStmt`")
            }
        case .structLiteralExpr(let s):
            return bindStructLiteral(ref b, through: ref c, for: in s.value, from: e, to: expected)
        case .withExpr(let w):
            return bindWith(ref b, through: ref c, for: in w.value, from: e)
        case .collectionExpr(let col):
            return bindCollection(ref b, through: ref c, for: in col.value, to: expected)
        case .tupleExpr(let tup):
            return bindTuple(ref b, through: ref c, for: in tup.value, to: expected)
        case .interpolatedExpr(let ip):
            return bindInterpolated(ref b, through: ref c, for: in ip.value)
        case .stackallocExpr(let st):
            return bindStackalloc(ref b, through: ref c, for: in st.value)
        case .spreadExpr(let sp):
            report(
                ref b,
                through: ref c,
                for: .unsupported,
                at: sp.value.span,
                by: ("spreads (`..xs`) outside a collection literal", "", "", "", ""),
            )
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: sp.value.span }), from: in e)
        case .patternExpr(let pat):
            report(
                ref b,
                through: ref c,
                for: .unsupported,
                at: pat.value.span,
                by: ("a named pattern", "", "", "", ""),
            )
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: pat.value.span }), from: in e)
        case .lambdaExpr(let l):
            var fExpected = expected
            @unobservable because "Q600: bindLambda is a stub; add a lambda expected-type case when T35 lands"
            if fExpected != -1 && kindOf(fExpected) == .optional {
                fExpected = c.optionalTypes[typeIndex(fExpected)]
            }
            @unobservable because "Q600: bindLambda is a stub; add a lambda expected-type case when T35 lands"
            if fExpected != -1 && kindOf(fExpected) != .function {
                fExpected = -1
            }
            switch l.value.block {
                case .blockStmt(let bs):
                    let noBody: parser.Expr? = null
                    return recordSyntaxNode(
                        ref c,
                        for: bindLambda(
                            ref b,
                            through: ref c,
                            at: l.value.span,
                            for: in l.value.params,
                            from: in noBody,
                            by: in bs.value,
                            to: fExpected,
                        ),
                        at: syntaxLeaf(ref c, as: .lambdaExpr, at: l.value.span),
                    )
                default:
                    let noBlock: parser.BlockStmt? = null
                    return recordSyntaxNode(
                        ref c,
                        for: bindLambda(
                            ref b,
                            through: ref c,
                            at: l.value.span,
                            for: in l.value.params,
                            from: in l.value.body,
                            by: in noBlock,
                            to: fExpected,
                        ),
                        at: syntaxLeaf(ref c, as: .lambdaExpr, at: l.value.span),
                    )
            }
        case .errorExpr(let eNode):
            // coverage-exempt: Q853
            return recordSyntax(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: eNode.value.span }),
                from: in e,
            )
        default:
            let span = parser.exprSpan(in e)
            report(ref b, through: ref c, for: .unsupported, at: span, by: ("this expression", "", "", "", ""))
            return recordSyntax(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: span }), from: in e)
    }
}

BExpr bindLiteral(
    ref Binder b,
    through ref Ctx c,
    for in parser.LiteralExpr l,
    to Type expected,
    bool negate = false,
    TextSpan? whole = null
) {
    let wholeSpan = whole ?? l.span
    var target = expected
    if target != -1 && kindOf(target) == .optional {
        target = c.optionalTypes[typeIndex(target)]
    }
    switch l.kind {
        case .integer:
            var parsed = parseInteger(l.text)
            if negate {
                parsed = bigNeg(parsed)
            }
            if (l.suffix is { } suffix) {
                let sText = t15Text(in c, from: b.file, at: suffix)
                var suffixed: PrimitiveKind? = null
                if sText == "u" {
                    suffixed = bigCmp(
                        parsed,
                        as: bigMax(32, signed: false),
                    ) <= 0 ? PrimitiveKind.u32 : PrimitiveKind.u64
                } else if sText == "l" {
                    suffixed = PrimitiveKind.i64
                } else if sText == "ul" {
                    suffixed = PrimitiveKind.u64
                } else if sText == "f" {
                    suffixed = PrimitiveKind.f32
                }
                if (suffixed is not { } sk) {
                    report(
                        ref b,
                        through: ref c,
                        for: .unsupported,
                        at: suffix,
                        by: ($"the unit suffix `{sText}`", "", "", "", ""),
                    )
                    return t17FromLiteral(
                        ref c,
                        for: addErrorExpr(ref c, from: BErrorExpr { span: l.span }),
                        from: in l,
                    )
                }
                return t17FromLiteral(
                    ref c,
                    for: literal(
                        ref c,
                        at: l.span,
                        as: prim(.f32),
                        by: Constant { kind: .real, real: t17LiteralToF64(l.text, negate: negate) },
                    ),
                    from: in l,
                ) if sk == .f32
                return t17CheckedIntegerLiteral(ref b, through: ref c, for: in l, at: wholeSpan, by: parsed, as: sk)
            }
            return t17FromLiteral(
                ref c,
                for: literal(
                    ref c,
                    at: l.span,
                    as: target,
                    by: Constant { kind: .real, real: t17LiteralToF64(l.text, negate: negate) },
                ),
                from: in l,
            ) if target != -1
                && isFloat(target)
            return t17CheckedIntegerLiteral(
                ref b,
                through: ref c,
                for: in l,
                at: wholeSpan,
                by: parsed,
                as: primKindOf(typeIndex(target)),
            ) if target != -1
                && isInteger(target)
            var natural = PrimitiveKind.u64
            let i32R = range(.i32)
            let i64R = range(.i64)
            if bigCmp(parsed, as: i32R.min) >= 0 && bigCmp(parsed, as: i32R.max) <= 0 {
                natural = .i32
            } else if bigCmp(parsed, as: i64R.min) >= 0 && bigCmp(parsed, as: i64R.max) <= 0 {
                natural = .i64
            }
            return t17CheckedIntegerLiteral(ref b, through: ref c, for: in l, at: wholeSpan, by: parsed, as: natural)
        case .floatKeyword:
            var value = f64.tryParse(l.text.replaced("_", by: ""))
                ?? panic("internal error: a float literal's text parses")
            if negate {
                value = -value
            }
            let suffixText = l.suffix is { } fs ? t15Text(in c, from: b.file, at: fs) : ""
            return t17FromLiteral(
                ref c,
                for: literal(ref c, at: l.span, as: prim(.f32), by: Constant { kind: .real, real: f64(f32(value)) }),
                from: in l,
            ) if suffixText == "f"
                || (target != -1 && target == prim(.f32))
            if (l.suffix is { } s) {
                report(
                    ref b,
                    through: ref c,
                    for: .unsupported,
                    at: s,
                    by: ($"the suffix `{suffixText}`", "", "", "", ""),
                )
                return t17FromLiteral(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: l.span }), from: in l)
            }
            return t17FromLiteral(
                ref c,
                for: literal(ref c, at: l.span, as: prim(.f64), by: Constant { kind: .real, real: value }),
                from: in l,
            )
        case .char:
            let value = parser.decodeChar(l.text.bytes)
            return t17FromLiteral(
                ref c,
                for: addErrorExpr(ref c, from: BErrorExpr { span: l.span }),
                from: in l,
            ) if value < 0
            return t17FromLiteral(
                ref c,
                for: literal(
                    ref c,
                    at: l.span,
                    as: prim(.u8),
                    by: Constant { kind: .integer, integer: bigFromI64(value) },
                ),
                from: in l,
            ) if target != -1
                && target == prim(.u8)
                && value < 0x80
            return t17FromLiteral(
                ref c,
                for: literal(ref c, at: l.span, as: prim(.char), by: Constant { kind: .rune, rune: u32(value) }),
                from: in l,
            )
        case .string or .rawString:
            if target != -1 && target == builtinType(.symbol) {
                let sym = addSymbolLiteral(ref c, from: BSymbolLiteral { span: l.span, text: l.text })
                setConstant(ref c, for: sym, to: Constant { kind: .text, text: l.text })
                return t17FromLiteral(ref c, for: sym, from: in l)
            }
            return t17FromLiteral(
                ref c,
                for: literal(ref c, at: l.span, as: prim(.string), by: Constant { kind: .text, text: l.text }),
                from: in l,
            )
        case .trueKeyword:
            return t17FromLiteral(
                ref c,
                for: literal(ref c, at: l.span, as: prim(.bool), by: Constant { kind: .flag, flag: true }),
                from: in l,
            )
        case .falseKeyword:
            return t17FromLiteral(
                ref c,
                for: literal(ref c, at: l.span, as: prim(.bool), by: Constant { kind: .flag, flag: false }),
                from: in l,
            )
        case .nullKeyword:
            return t17FromLiteral(
                ref c,
                for: addDefault(ref c, from: BDefault { span: l.span, type: expected }),
                from: in l,
            ) if expected != -1
                && kindOf(expected) == .optional
            return t17FromLiteral(
                ref c,
                for: addLiteral(
                    ref c,
                    from: BLiteral { span: l.span, type: nullType(), value: Constant { kind: .text, text: "null" } },
                ),
                from: in l,
            )
        default:
            let name = l.kind == .cString ? "C string literals" : "UTF-16 string literals"
            report(ref b, through: ref c, for: .unsupported, at: l.span, by: (name, "", "", "", ""))
            return t17FromLiteral(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: l.span }), from: in l)
    }
}

/// `n`, built on literal `l`: C# `Syntax is LiteralExpr`, and `IsUntypedLiteral(Syntax)` for an unsuffixed number, char or `null`.
BExpr t17FromLiteral(ref Ctx c, for BExpr n, from in parser.LiteralExpr l) {
    let untyped = l.suffix is null && (l.kind is .integer or .floatKeyword or .char or .nullKeyword)
    setSyntaxFlags(ref c, for: n, to: untyped ? syntaxLiteral | syntaxUntypedLiteral : syntaxLiteral)
    return recordSyntaxNode(ref c, for: n, at: syntaxOfLiteral(ref c, from: in l))
}

BExpr t17CheckedIntegerLiteral(
    ref Binder b,
    through ref Ctx c,
    for in parser.LiteralExpr l,
    at TextSpan span,
    by Big value,
    as PrimitiveKind typeKind
) {
    let r = range(typeKind)
    if bigCmp(value, as: r.min) < 0 || bigCmp(value, as: r.max) > 0 {
        // Above 2^127-1 `value` is a truncated prefix; the text gives the exact digits (C# BigInteger).
        let text = bigParse(
            l.text,
        ).overflow ? $"{bigIsNeg(value) ? "-" : ""}{literalDecimalText(l.text)}" : bigText(value)
        report(
            ref b,
            through: ref c,
            for: .literalOutOfRange,
            at: span,
            by: (text, $"`{primitiveName(typeKind)}`", "", "", ""),
            help: t17RangeHelp(typeKind),
        )
        return t17FromLiteral(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: l.span }), from: in l)
    }
    return t17FromLiteral(
        ref c,
        for: literal(ref c, at: l.span, as: prim(typeKind), by: Constant { kind: .integer, integer: value }),
        from: in l,
    )
}

Big parseInteger(string text) => bigParse(text).value

bool isUntypedLiteral(in parser.Expr e) {
    switch e {
        case .literalExpr(let l):
            return false if l.value.suffix is not null
            return l.value.kind is .integer or .floatKeyword or .char or .nullKeyword
        case .unaryExpr(let u):
            return false if u.value.op != .negate && u.value.op != .plus
            return isUntypedLiteral(in u.value.operand)
        case .parenExpr(let p):
            return isUntypedLiteral(in p.value.inner)
        case .binaryExpr(let b):
            return false if b.value.op is .lt
                or .gt
                or .le
                or .ge
                or .eq
                or .ne
                or .logicalAnd
                or .logicalOr
                or .coalesce
            return isUntypedLiteral(in b.value.left) && isUntypedLiteral(in b.value.right)
        default:
            return false
    }
}

BExpr bindName(ref Binder b, through ref Ctx c, for in parser.NameExpr n) {
    let syntax = syntaxLeaf(ref c, as: .nameExpr, at: n.span)
    let name = t15Text(in c, from: b.file, at: n.name)
    let m = c.files[b.file].module
    if n.typeArgs.length > 0 {
        if t15Lookup(ref b, for: name) == -1 && (c.modules[m].functions.tryGet(at: name) is { } generic) {
            var tArgsSpans = List<TextSpan>()
            for ta in n.typeArgs {
                tArgsSpans.append(typeSyntaxSpan(in ta))
            }
            return recordSyntaxNode(
                ref c,
                for: addMethodGroup(
                    ref c,
                    from: BMethodGroup { span: n.span, receiver: -1, function: generic[0], typeArgs: move tArgsSpans },
                ),
                at: syntax,
            )
        }
        var path = List<TextSpan>()
        path.append(n.name)
        var args = List<parser.TypeSyntax>()
        for ta in n.typeArgs {
            args.append(t17CloneTypeSyntax(in ta))
        }
        let t = resolveType(
            ref b,
            through: ref c,
            for: parser.TypeSyntax.namedType(Owned(NamedType { span: n.span, path: move path, args: move args })),
        )
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }),
            at: syntax,
        ) if isError(t)
        return recordSyntaxNode(
            ref c,
            for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: t }),
            at: syntax,
        )
    }

    if name == "it" && b.itField != -1 {
        return recordSyntaxNode(
            ref c,
            for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }),
            at: syntax,
        ) if inLambda(
            ref b,
            through: ref c,
            at: n.span,
            for: "it",
            by: "the checked value is read through `this`, which a lambda does not capture",
        )
        let thisExpr = recordSyntaxNode(
            ref c,
            for: addThis(ref c, from: BThis { span: n.span, type: b.thisType }),
            at: syntax,
        )
        return recordSyntaxNode(
            ref c,
            for: addField(
                ref c,
                from: BField { span: n.span, receiver: thisExpr, field: b.itField, type: c.fields[b.itField].type },
            ),
            at: syntax,
        )
    }

    let local = t15Lookup(ref b, for: name)
    if local != -1 {
        if c.locals[local].kind == .constKeyword && (c.locals[local].constant is { } cVal) {
            let t = c.locals[local].type
            return t21ConstantLiteral(ref c, at: n.span, as: t, by: in cVal, from: syntax)
        }
        var read: BExpr = -1
        if isNonNull(ref b, for: local) {
            let locNode = recordSyntaxNode(ref c, for: addLocalNode(ref c, at: n.span, for: local), at: syntax)
            let optInner = c.optionalTypes[typeIndex(c.locals[local].type)]
            read = recordSyntaxNode(
                ref c,
                for: addConversion(
                    ref c,
                    from: BConversion { span: n.span, operand: locNode, type: optInner, kind: .narrow },
                ),
                at: syntax,
            )
        } else {
            let known = knownState(ref b, for: local)
            let locType = known != -1 ? known : c.locals[local].type
            read = recordSyntaxNode(
                ref c,
                for: addLocal(ref c, from: BLocal { span: n.span, local: local, type: locType }),
                at: syntax,
            )
        }
        let readType = exprType(in c, for: read)
        return capture(
            ref b,
            through: ref c,
            for: in n,
            by: local,
            as: readType,
        ) ? read : recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
    }

    let host = host(b, through: c)
    if b.thisType != -1 {
        // A default cloned onto a struct sees only the interface's members through `this`.
        var visible = true
        // coverage-exempt: Q746
        if host != -1 && c.functions[host].template != -1 && c.functions[c.functions[host].template].iface != -1 {
            @unobservable because "Q600: declare2.byn is a stub; add a function cloned from an interface default when T38 lands"
            let cloneOf = c.functions[c.functions[host].template].iface
            @unobservable because "Q600: declare2.byn is a stub; add a function cloned from an interface default when T38 lands"
            visible = lookupMember(ref c, for: t15InterfaceSelf(ref c, for: cloneOf), by: name).kind != .none
        }
        if visible {
            let member = lookupMember(ref c, for: b.thisType, by: name)
            return bindImplicitThisMember(ref b, through: ref c, for: in n, by: member) if member.kind != .none
        }
    }

    if b.thisType != -1 && kindOf(b.thisType) == .structType && host != -1 && !c.functions[host].isStatic {
        @unobservable because "Q600: statesOf is a stub; add a state-union variant field read through this when T38 lands"
        let st = statesOf(ref c, for: typeIndex(b.thisType))
        if st != -1 {
            @unobservable because "Q600: statesOf is a stub; add a state-union variant field read through this when T38 lands"
            var foundVariantField = false
            @unobservable because "Q600: statesOf is a stub; add a state-union variant field read through this when T38 lands"
            for vId in c.unions[st].variants {
                for fId in c.unionVariants[vId].fields {
                    if c.locals[fId].name == name {
                        foundVariantField = true
                        break
                    }
                }
                break if foundVariantField
            }
            @unobservable because "Q600: statesOf is a stub; add a state-union variant field read through this when T38 lands"
            if foundVariantField {
                return recordSyntaxNode(
                    ref c,
                    for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }),
                    at: syntax,
                ) if inLambda(
                    ref b,
                    through: ref c,
                    at: n.span,
                    for: name,
                    by: "it is read through `this`, which a lambda does not capture",
                )
                let thisExpr = recordSyntaxNode(
                    ref c,
                    for: addThis(ref c, from: BThis { span: n.span, type: b.thisType }),
                    at: syntax,
                )
                return t21BindValueMember(ref b, through: ref c, at: n.span, for: thisExpr, by: n.name, from: syntax)
            }
        }
    }

    if (c.modules[m].constants.tryGet(at: name) is { } kId) {
        return t21ConstantRef(ref b, through: ref c, at: n.span, for: kId, from: syntax)
    }
    if (c.modules[m].functions.tryGet(at: name) is { } fns) {
        return recordSyntaxNode(
            ref c,
            for: addMethodGroup(ref c, from: BMethodGroup { span: n.span, receiver: -1, function: fns[0] }),
            at: syntax,
        )
    }
    if c.modules[m].types.contains(name) {
        var path = List<TextSpan>()
        path.append(n.name)
        let t = resolveType(
            ref b,
            through: ref c,
            for: parser.TypeSyntax.namedType(
                Owned(NamedType { span: n.span, path: move path, args: List<parser.TypeSyntax>() }),
            ),
        )
        return recordSyntaxNode(
            ref c,
            for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: t }),
            at: syntax,
        )
    }
    if (c.files[b.file].imports.tryGet(at: name) is { } impMod) {
        return recordSyntaxNode(
            ref c,
            for: addModuleRef(ref c, from: BModuleRef { span: n.span, module: impMod }),
            at: syntax,
        )
    }

    if (find(ref c, for: name) is { } builtin) {
        return recordSyntaxNode(
            ref c,
            for: addMethodGroup(ref c, from: BMethodGroup { span: n.span, receiver: -1, function: builtin }),
            at: syntax,
        )
    }

    if (primitiveByName(name) is { } primitive) {
        return recordSyntaxNode(
            ref c,
            for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: primitive }),
            at: syntax,
        )
    }

    if name is "List"
            or "Map"
            or "Span"
            or "ReadOnlySpan"
            or "Arena"
            or "StrBuf"
            or "IoError"
            or "Utf8Error"
            or "ParseError"
            or "ValidationError"
            or "ProcessResult"
            or "Panic" {
        var path = List<TextSpan>()
        path.append(n.name)
        let t = resolveType(
            ref b,
            through: ref c,
            for: parser.TypeSyntax.namedType(
                Owned(NamedType { span: n.span, path: move path, args: List<parser.TypeSyntax>() }),
            ),
        )
        return recordSyntaxNode(
            ref c,
            for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: t }),
            at: syntax,
        )
    }

    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.io) }),
        at: syntax,
    ) if name == "Io"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.hex) }),
        at: syntax,
    ) if name == "Hex"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.symbol) }),
        at: syntax,
    ) if name == "Symbol"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.utf8) }),
        at: syntax,
    ) if name == "Utf8"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.path) }),
        at: syntax,
    ) if name == "Path"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.target) }),
        at: syntax,
    ) if name == "Target"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.env) }),
        at: syntax,
    ) if name == "Env"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.fs) }),
        at: syntax,
    ) if name == "Fs"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.time) }),
        at: syntax,
    ) if name == "Time"
    return recordSyntaxNode(
        ref c,
        for: addTypeRef(ref c, from: BTypeRef { span: n.span, referenced: builtinType(.millis) }),
        at: syntax,
    ) if name == "Millis"

    t17ReportUndefined(ref b, through: ref c, for: n.name)
    return recordSyntaxNode(ref c, for: addErrorExpr(ref c, from: BErrorExpr { span: n.span }), at: syntax)
}

parser.TypeSyntax t17CloneTypeSyntax(in parser.TypeSyntax t) {
    switch t {
        case .namedType(let n):
            var path = List<TextSpan>()
            for p in n.value.path {
                path.append(p)
            }
            var args = List<parser.TypeSyntax>()
            for a in n.value.args {
                args.append(t17CloneTypeSyntax(in a))
            }
            return parser.TypeSyntax.namedType(
                Owned(NamedType { span: n.value.span, path: move path, args: move args }),
            )
        case .optionalType(let o):
            return parser.TypeSyntax.optionalType(
                Owned(OptionalType { span: o.value.span, inner: t17CloneTypeSyntax(in o.value.inner) }),
            )
        case .pointerType(let p):
            return parser.TypeSyntax.pointerType(
                Owned(
                    PointerType {
                        span: p.value.span,
                        pointee: t17CloneTypeSyntax(in p.value.pointee),
                        readOnly: p.value.readOnly,
                    },
                ),
            )
        case .tupleType(let tt):
            var elements = List<TupleTypeElement>()
            for x in tt.value.elements {
                elements.append(TupleTypeElement { span: x.span, type: t17CloneTypeSyntax(in x.type), name: x.name })
            }
            return parser.TypeSyntax.tupleType(Owned(TupleType { span: tt.value.span, elements: move elements }))
        case .functionTypeSyntax(let f):
            var params = List<parser.TypeSyntax>()
            for x in f.value.params {
                params.append(t17CloneTypeSyntax(in x))
            }
            var failsClause: FailsClause? = null
            if (f.value.failsKeyword is { } fc) {
                var errors = List<parser.TypeSyntax>()
                for x in fc.errors {
                    errors.append(t17CloneTypeSyntax(in x))
                }
                failsClause = FailsClause { span: fc.span, errors: move errors }
            }
            var usesClause: UsesClause? = null
            if (f.value.usesKeyword is { } uc) {
                var effects = List<TextSpan>()
                for x in uc.effects {
                    effects.append(x)
                }
                usesClause = UsesClause { span: uc.span, effects: move effects }
            }
            return parser.TypeSyntax.functionTypeSyntax(Owned(FunctionTypeSyntax {
                span: f.value.span, params: move params, returnKeyword: t17CloneTypeSyntax(in f.value.returnKeyword),
                failsKeyword: move failsClause, usesKeyword: move usesClause,
            }))
        case .dynType(let d):
            return parser.TypeSyntax.dynType(
                Owned(
                    DynType {
                        span: d.value.span,
                        isRef: d.value.isRef,
                        isReadOnly: d.value.isReadOnly,
                        inner: t17CloneTypeSyntax(in d.value.inner),
                    },
                ),
            )
        case .refinedType(let r):
            var states = List<TextSpan>()
            for x in r.value.states {
                states.append(x)
            }
            return parser.TypeSyntax.refinedType(
                Owned(
                    RefinedType {
                        span: r.value.span,
                        inner: t17CloneTypeSyntax(in r.value.inner),
                        states: move states,
                    },
                ),
            )
        case .arrayType(let a):
            return parser.TypeSyntax.arrayType(
                Owned(
                    ArrayType {
                        span: a.value.span,
                        element: t17CloneTypeSyntax(in a.value.element),
                        size: t17CloneSizeExpr(in a.value.size),
                    },
                ),
            )
        case .none:
            return parser.TypeSyntax.none
    }
}

/// An array type's size: the parser takes an integer literal or a name there (`T[4]`, `T[N]`).
parser.Expr t17CloneSizeExpr(in parser.Expr e) {
    switch e {
        case .literalExpr(let l):
            return parser.Expr.literalExpr(
                Owned(
                    LiteralExpr { span: l.value.span, kind: l.value.kind, text: l.value.text, suffix: l.value.suffix },
                ),
            )
        case .nameExpr(let n):
            return parser.Expr.nameExpr(
                Owned(NameExpr { span: n.value.span, name: n.value.name, typeArgs: List<parser.TypeSyntax>() }),
            )
        default:
            panic("internal error: an array size is a literal or a name")
    }
}

void t17ReportUndefined(ref Binder b, through ref Ctx c, for TextSpan nameSpan) {
    let nameText = t15Text(in c, from: b.file, at: nameSpan)
    var candidates = List<string>()
    var i = t15Scope(ref b)
    while i >= 0 {
        for (k, _) in b.scopes[i] {
            candidates.append(k)
        }
        i -= 1
    }
    if b.owner != -1 {
        let s = b.owner
        for fId in c.structs[s].fields {
            candidates.append(c.fields[fId].name)
        }
        for pId in c.structs[s].properties {
            candidates.append(c.properties[pId].name)
        }
        for mId in c.structs[s].methods {
            candidates.append(c.functions[mId].name)
        }
    }
    let m = c.files[b.file].module
    for e in c.modules[m].functions {
        candidates.append(e.key)
    }
    for (k, _) in c.modules[m].constants {
        candidates.append(k)
    }
    for (k, _) in c.modules[m].types {
        candidates.append(k)
    }
    for (k, _) in c.files[b.file].imports {
        candidates.append(k)
    }
    candidates.append("print")
    candidates.append("panic")
    candidates.append("todo")
    candidates.append("Io")
    let s = suggest(nameText, by: in candidates)
    if s is not null {
        report(
            ref b,
            through: ref c,
            for: .undefinedName,
            at: nameSpan,
            by: (nameText, "", "", "", ""),
            help: $"did you mean `{s}`?",
            hasFix: true,
            fixSpan: nameSpan,
            fixReplacement: s,
        )
    } else {
        report(ref b, through: ref c, for: .undefinedName, at: nameSpan, by: (nameText, "", "", "", ""))
    }
}

string? suggest(string name, by in List<string> candidates) {
    var best: string? = null
    var bestDistance = 2147483647
    var seen = List<string>()
    for c in candidates {
        continue if listContainsString(in seen, by: c)
        seen.append(c)
        continue if c == name
        let d = t17Distance(name.lowercased(), as: c.lowercased())
        if d < bestDistance {
            best = c
            bestDistance = d
        }
    }
    var nameLength = 0
    for _ in name.utf16 {
        nameLength += 1
    }
    let limit = nameLength / 3 > 1 ? nameLength / 3 : 1
    return best if best is not null && bestDistance <= limit
    return null
}

i64 t17Distance(string a, as string b) {
    var aBytes = List<u16>()
    for u in a.utf16 {
        aBytes.append(u)
    }
    var bBytes = List<u16>()
    for u in b.utf16 {
        bBytes.append(u)
    }
    let aLen = aBytes.length
    let bLen = bBytes.length

    var prev = List<i64>()
    for j in 0..bLen + 1 {
        prev.append(j)
    }

    for i in 1..aLen + 1 {
        var curr = List<i64>()
        curr.append(i)
        for j in 1..bLen + 1 {
            let cost = aBytes[i - 1] == bBytes[j - 1] ? 0 : 1
            let del = prev[j] + 1
            let ins = curr[j - 1] + 1
            let sub = prev[j - 1] + cost
            var minVal = del
            if ins < minVal {
                minVal = ins
            }
            if sub < minVal {
                minVal = sub
            }
            curr.append(minVal)
        }
        prev = move curr
    }
    return prev[bLen]
}

/// C# `(double)BigInteger` of literal `text` (negated if `negate`), at any size: the top 53 bits, truncated, not
/// rounded; 2^1024 and above is infinity. `bigToF64` rounds and stops at 2^127-1, so it does not fit here.
f64 t17LiteralToF64(string text, bool negate) {
    let b = text.bytes
    var base: u64 = 10
    var i: i64 = 0
    if b.length >= 2 && b[0] == 48 {
        if b[1] is 120 or 88 {
            base = 16
            i = 2
        } else if b[1] is 98 or 66 {
            base = 2
            i = 2
        }
    }
    var limbs = List<u64>()
    while i < b.length {
        let ch = b[i]
        i += 1
        continue if ch == 95
        var dv: u64 = 0
        if ch is 48..=57 {
            dv = u64(ch - 48)
        } else if ch is 97..=102 {
            dv = u64(ch - 87)
        } else if ch is 65..=70 {
            dv = u64(ch - 55)
        }
        var carry: u64 = dv
        for j in 0..limbs.length {
            let v = limbs[j] * base + carry
            limbs[j] = v & 0xFFFFFFFF
            carry = v >> 32
        }
        if carry > 0 {
            limbs.append(carry)
        }
    }
    return 0.0 if limbs.length == 0
    var k = (limbs.length - 1) * 32
    var top = limbs[limbs.length - 1]
    while top > 0 {
        k += 1
        top = top >> 1
    }
    let n = k < 53 ? k : 53
    var m: u64 = 0
    for p in 0..n {
        let idx = k - 1 - p
        m = (m << 1) | ((limbs[idx / 32] >> u64(idx % 32)) & 1)
    }
    var d = f64(m)
    for p in 0..(k - n) {
        d = d * 2.0
    }
    return negate ? -d : d
}
