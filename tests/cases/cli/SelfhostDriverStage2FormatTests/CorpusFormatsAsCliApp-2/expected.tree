/* `Path.combine(a, b)`: .NET `Path.Combine(a, b)` on this OS, copied into `to`: `b` when `a` is empty or `b` rooted, else `a`
   and `b` joined by the OS separator unless `a` ends in a separator (any of them, on Windows) or `b` is empty. */
byn_str byn_path_combine(byn_str a, byn_str b, byn_alloc* to);
/* `Path.combine(paths)`: .NET `Path.Combine(params string[])` on this OS, copied into `to`: empty parts are skipped and the
   last rooted part restarts the result. */
byn_str byn_path_combine_span(const byn_str* p, int64_t n, byn_alloc* to);
/* `Path.fullPath(p)`: .NET `Path.GetFullPath(p)` on this OS, copied into `to`; a relative path is made full against the working
   directory. Panics on an empty path or one with a NUL byte, where .NET throws `ArgumentException`. */
byn_str byn_path_full_path(byn_str p, byn_alloc* to, const char* file, int line);
/* `Path.relative(from, to)`: .NET `Path.GetRelativePath(from, to)` on this OS, copied into `to`; both paths are made full against
   the working directory first. Panics on an empty path or one with a NUL byte, where .NET throws `ArgumentException`. */
byn_str byn_path_relative(byn_str from, byn_str path, byn_alloc* to, const char* file, int line);

/* Makes room for `need` elements: grows *ptr (capacity *cap) through alloc. */
void byn_list_reserve(void** ptr, int64_t* cap, int64_t need, int64_t elem_size, byn_alloc* alloc);

/* ── Maps ────────────────────────────────────────────────────────────────── */

/* The 128-bit key of every key hash (low and high halves); `main` sets it (0 under `--test`, else from the OS CSPRNG). */
extern uint64_t byn_hash_seed;
extern uint64_t byn_hash_seed_hi;
void byn_hash_seed_init(bool fixed);
/* SipHash-1-3 over n bytes, keyed by the seed. */
uint64_t byn_hash_bytes(const void* p, int64_t n);

/* The untyped part of `Map<K, V>`: entries are dense arrays in insertion order (keys and values live in the
 * typed struct), removed entries are tombstones until a rehash compacts them, and `index` is an open-addressed
 * table of entry numbers (-1 empty) with `icap` slots, a power of two at least twice `cap`. */
typedef struct byn_map_hdr {
    int32_t* index;
    uint64_t* hashes;
    bool* dead;
    int64_t icap;
    int64_t cap;
    int64_t len;
    int64_t live;
    byn_alloc* alloc;
} byn_map_hdr;

/* Compares a stored key with a probe key (both point at a K). */
typedef bool (*byn_key_eq)(const void* a, const void* b);

/* The entry holding `key`, or -1. */
int64_t byn_map_find(const byn_map_hdr* h, const void* keys, int64_t ksize, const void* key, uint64_t hash, byn_key_eq eq);
/* The entry for `key`; a new one is appended (*added set) and the caller stores the key. */
int64_t byn_map_insert(byn_map_hdr* h, void** keys, int64_t ksize, void** vals, int64_t vsize, const void* key,
                       uint64_t hash, byn_key_eq eq, bool* added);
bool byn_map_remove(byn_map_hdr* h, const void* keys, int64_t ksize, const void* key, uint64_t hash, byn_key_eq eq);
void byn_map_clear(byn_map_hdr* h);
/* Copies the live entries of `src` in insertion order into fresh storage from `to`; `dst` gets the new header. */
void byn_map_copy(const byn_map_hdr* src, const void* keys, int64_t ksize, void** dkeys, const void* vals, int64_t vsize,
                  void** dvals, byn_map_hdr* dst, byn_alloc* to);

/* Folds `part` into the hash `h` (keyed SipHash-1-3 over both, 16 bytes), for keys hashed part by part. */
uint64_t byn_hash_mix(uint64_t h, uint64_t part);

/* ── Symbols ─────────────────────────────────────────────────────────────── */

/* `Symbol`: an index into the program's one symbol table. */
typedef struct byn_sym {
    uint32_t id;
} byn_sym;

/* Starts the table with the program's literal texts (sorted, `""` first), so literal i is ID i; `main` calls it once. */
void byn_sym_init(const byn_str* lits, uint32_t n);
/* `Symbol.intern`: the ID of `s`, adding a copy of a new text; the table and its text come from the general allocator and
 * are never freed. */
byn_sym byn_sym_intern(byn_str s);
/* `sym.text`: valid until the program exits. */
byn_str byn_sym_text(byn_sym s);

/* ── Program entry and Io ────────────────────────────────────────────────── */

/* True if the bytes are well-formed UTF-8 (no overlongs, surrogates or values above U+10FFFF). */
bool byn_utf8_valid(const uint8_t* p, int64_t n);
/* Byte offset of the first invalid sequence (its first byte), or -1 when the bytes are well-formed UTF-8. */
int64_t byn_utf8_invalid_at(const uint8_t* p, int64_t n);
/* `Utf8.decode(bytes, invalid: .replace)`: a copy with each invalid sequence as U+FFFD. */
byn_str byn_utf8_decode_replace(const uint8_t* p, int64_t n, byn_alloc* to);

/* argv[1..argc-1] as strings. Writes `error: argument N is not valid UTF-8` (N from 1) and exits 1 on bad input.
 * On Windows they come from the UTF-16 command line instead of `argv`, and `*argc` is set to their count. */
byn_str* byn_args(int* argc, char** argv);

/* `IoError` codes 1 to 11: the compiler numbers its variants first, then `Utf8Error` (12); user error variants start at 13. */
#define BYN_IO_NOT_FOUND 1u
#define BYN_IO_PERMISSION_DENIED 2u
#define BYN_IO_INVALID_UTF8 3u
#define BYN_IO_NOT_A_DIRECTORY 4u
#define BYN_IO_OTHER 5u
#define BYN_IO_INVALID_INPUT 6u
#define BYN_IO_UNSUPPORTED 7u
#define BYN_IO_CROSS_DEVICE 8u
#define BYN_IO_IS_DIRECTORY 9u
/* detail-carrying: writes *detail (the signal number), field 0 of `IoError.signaled(i32 signal, string stdout, string stderr)`. */
#define BYN_IO_SIGNALED 10u
/* `IoError.timeout(Millis after, string stdout, string stderr)`: no runtime detail (the caller knows the timeout); the
 * captured streams are in `*out`, as for `BYN_IO_SIGNALED`. */
#define BYN_IO_TIMEOUT 11u
/* `Utf8Error.invalidSequence(i64 at)`: no runtime detail; `bynh_utf8_decode` writes it. */
#define BYN_UTF8_INVALID_SEQUENCE 12u

/* Reads a whole file into memory from `alloc`. Returns 0 or an `IoError` code. */
uint32_t byn_io_read(byn_str path, uint8_t** ptr, int64_t* len, byn_alloc* alloc);
/* As byn_io_read, and the bytes must be UTF-8. `out` may be NULL. */
uint32_t byn_io_read_text(byn_str path, byn_str* out, byn_alloc* alloc);
/* `Io.stdin.readAllBytes`: the rest of standard input, bytes as-is (not checked for UTF-8), from `alloc`. */
uint32_t byn_io_read_stdin_bytes(uint8_t** ptr, int64_t* len, byn_alloc* alloc);
/* `Io.stdin.readAll`: the same bytes as text; `BYN_IO_INVALID_UTF8` if they are not UTF-8. */
uint32_t byn_io_read_stdin(byn_str* out, byn_alloc* alloc);
uint32_t byn_io_write_file(byn_str path, const uint8_t* ptr, int64_t len);
/* `Io.listDir`: entry names without `.` and `..`, sorted by byte order, allocated from `alloc`. */
uint32_t byn_io_list_dir(byn_str path, byn_str** ptr, int64_t* len, byn_alloc* alloc);

/* `ProcessResult`: a child that exited; a signal-killed child is `BYN_IO_SIGNALED` instead. */
typedef struct byn_process {
    int32_t exit_code;
    byn_str out;
    byn_str err;
} byn_process;

/* How the wait for a child ended, for byn_wait_status. */
#define BYN_WAIT_DONE 0
#define BYN_WAIT_FAILED 1       /* waitpid failed (not EINTR), or WaitForSingleObject did */
#define BYN_WAIT_QUERY_FAILED 2 /* GetExitCodeProcess failed */
#define BYN_WAIT_TIMED_OUT 3
/* Maps a wait to 0 (with `*code`, the exit code) or an `IoError` code. A failed wait or query is `BYN_IO_OTHER`
 * and `raw` is ignored, so no exit code is made up; a timeout is `BYN_IO_TIMEOUT` (`*detail` untouched); off Windows
 * a signal-killed child (`raw` is the waitpid status) is `BYN_IO_SIGNALED` with `*detail` = the signal; on Windows
 * `raw` is the exit code. `detail` may be NULL. Compiled on every host. */
uint32_t byn_wait_status(int outcome, uint32_t raw, int32_t* code, int64_t* detail);
/* `Io.run`: spawns `program` (looked up on PATH when it has no path separator) with `args`,
 * never through a shell, and waits for it. Both streams are captured into `alloc`. `out` may be NULL.
 * A failed wait is `other`, a signal-killed child `signaled` with the signal in `*detail` (`detail` may be NULL)
 * and its captured streams still in `*out` (the payload of `.signaled`); if they are not UTF-8 it stays `signaled`
 * with `*out` untouched (empty streams).
 * On Windows a batch file (`.bat`, `.cmd`) is refused with `permissionDenied`, since cmd.exe would re-parse the arguments. */
uint32_t byn_io_run(byn_str program, const byn_str* args, int64_t nargs, byn_process* out, int64_t* detail, byn_alloc* alloc);
/* `Io.run` with its named arguments (015 S6). `directory` (NULL: ours) is where the child runs; one that does not exist
 * or is not a directory fails before anything starts. `input` (`ninput` < 0: the child shares our stdin) is written to
 * the child's stdin, which is then closed. Each of the `nenv` entries of `env_keys` replaces the inherited variable of
 * its name: with `env_vals[i]` as the value, or removed when `env_unset[i]` is set (`env_vals[i]` then unread). A NUL
 * in the directory, an empty name, `=` in a name or NUL in a name or set value is `invalidInput`. With `timeout_ms` >= 0
 * the child runs in its own process group (a Job object on Windows); once `timeout_ms` passes the group gets SIGTERM,
 * then SIGKILL after a grace period (the job is terminated), and the call is `timeout` with `*detail` untouched (the
 * caller knows the timeout) and what was captured before then in `*out` (empty streams if either is not UTF-8). With
 * `timeout_ms` >= 0 each stream also keeps only its first and its last BYN_RUN_KEEP bytes: when more was written, the
 * stream is its head and its tail, each decoded with U+FFFD for a cut or invalid sequence, around one
 * `\n… N bytes omitted …\n` line (N the bytes dropped), as the C# test runner's `BoundedCapture` keeps a test's output.
 * `timeout_ms` < 0 waits as long as the child runs and keeps every byte. */
uint32_t byn_io_run_with(byn_str program, const byn_str* args, int64_t nargs, const byn_str* directory, const uint8_t* input,
                         int64_t ninput, const byn_str* env_keys, const byn_str* env_vals, const bool* env_unset, int64_t nenv,
                         int64_t timeout_ms, byn_process* out, int64_t* detail, byn_alloc* alloc);
/* `Io.runBatch`'s command line: `cmd.exe /d /e:ON /v:OFF /s /c ""<path>" "<a1>" … "<an>""`, each argument
 * in double quotes as-is. False, with nothing built, when the path or an argument holds NUL, CR, LF, `"` or `%`,
 * or the path does not end in `.bat` or `.cmd` (any case). Otherwise `out` is from malloc. Compiled on every host. */
bool byn_batch_cmdline(byn_str path, const byn_str* args, int64_t nargs, byn_str* out);
/* `Io.runBatch`: runs the batch file through the system directory's cmd.exe with that command line and
 * captures it like byn_io_run. A refused argument is `invalidInput` (nothing starts); off Windows, `unsupported`. */
uint32_t byn_io_run_batch(byn_str path, const byn_str* args, int64_t nargs, byn_process* out, byn_alloc* alloc);
/* `Io.stdout.write` (fd 1, buffered with print) and `Io.stderr.write` (fd 2). No newline. */
void byn_io_write(int32_t fd, byn_str s);
int64_t byn_io_monotonic_nanos(void);
/* `Io.randomU64`: 8 bytes from the operating system's CSPRNG (the hash seed's source); panics if it cannot be read. */
uint64_t byn_io_random_u64(void);

/* ── StrBuf ──────────────────────────────────────────────────────────────── */

/* `StrBuf(buf)` is a strict writer over caller-provided bytes; `StrBuf()` grows from `alloc`. */
static inline byn_str byn_strbuf_str(byn_writer w) { return (byn_str){w.buf, w.len}; }
/* A growable StrBuf holding the same text in fresh storage from `to`. */
byn_writer byn_strbuf_copy(byn_writer w, byn_alloc* to);
static inline byn_writer byn_strbuf_grow(byn_alloc* alloc) {
    return (byn_writer){NULL, 0, 0, BYN_WRITE_GROW, NULL, 0, alloc};
}

/* ── Chars ───────────────────────────────────────────────────────────────── */

static inline uint32_t byn_to_char(int64_t v, const char* file, int line) {
    if (BYN_UNLIKELY(v < 0 || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF)))
        bayan_trap_scalar(file, line);
    return (uint32_t)v;
}

static inline uint32_t byn_to_char_u(uint64_t v, const char* file, int line) {
    return byn_to_char(v > 0x10FFFF ? -1 : (int64_t)v, file, line);
}

/* ── Checked arithmetic ──────────────────────────────────────────────────── */

#define BYN_INT_TYPES(X) \
    X(i8, int8_t, 1) X(i16, int16_t, 1) X(i32, int32_t, 1) X(i64, int64_t, 1) \
    X(u8, uint8_t, 0) X(u16, uint16_t, 0) X(u32, uint32_t, 0) X(u64, uint64_t, 0)

#define BYN_BITS(T) ((int)(sizeof(T) * 8))
#define BYN_MIN(T, S) ((S) ? (T)((uint64_t)1 << (BYN_BITS(T) - 1)) : (T)0)
#define BYN_MAX(T, S) ((S) ? (T)(((uint64_t)1 << (BYN_BITS(T) - 1)) - 1) : (T)~(T)0)

#define BYN_DEF_TRAPPING(N, T, S) \
    static inline T byn_add_##N(T a, T b, const char* f, int l) { \
        T r; if (BYN_UNLIKELY(__builtin_add_overflow(a, b, &r))) bayan_trap_overflow(f, l); return r; } \
    static inline T byn_sub_##N(T a, T b, const char* f, int l) { \
        T r; if (BYN_UNLIKELY(__builtin_sub_overflow(a, b, &r))) bayan_trap_overflow(f, l); return r; } \
    static inline T byn_mul_##N(T a, T b, const char* f, int l) { \
        T r; if (BYN_UNLIKELY(__builtin_mul_overflow(a, b, &r))) bayan_trap_overflow(f, l); return r; } \
    static inline T byn_neg_##N(T a, const char* f, int l) { \
        T r; if (BYN_UNLIKELY(__builtin_sub_overflow((T)0, a, &r))) bayan_trap_overflow(f, l); return r; } \
    static inline T byn_inc_##N(T a, const char* f, int l) { return byn_add_##N(a, (T)1, f, l); } \
    static inline T byn_dec_##N(T a, const char* f, int l) { return byn_sub_##N(a, (T)1, f, l); } \
    static inline T byn_cast_##N##_i(int64_t v, const char* f, int l) { \
        T r = (T)v; if (BYN_UNLIKELY((int64_t)r != v || (r < (T)1) != (v < 1))) bayan_trap_range(f, l); return r; } \
    static inline T byn_cast_##N##_u(uint64_t v, const char* f, int l) { \
        T r = (T)v; if (BYN_UNLIKELY((uint64_t)r != v || r < (T)0)) bayan_trap_range(f, l); return r; }

#define BYN_DEF_ARITH(N, T, S) \
    BYN_DEF_TRAPPING(N, T, S) \
    static inline T byn_div_##N(T a, T b, const char* f, int l) { \
        if (BYN_UNLIKELY(b == 0)) bayan_trap_divide(f, l); \
        if ((S) && BYN_UNLIKELY(a == BYN_MIN(T, S) && b == (T)-1)) return byn_neg_##N(a, f, l); \
        return (T)(a / b); } \
    static inline T byn_rem_##N(T a, T b, const char* f, int l) { \
        if (BYN_UNLIKELY(b == 0)) bayan_trap_divide(f, l); \
        if ((S) && b == (T)-1) return 0; \
        return (T)(a % b); } \
    static inline T byn_addw_##N(T a, T b) { return (T)((uint64_t)a + (uint64_t)b); } \
    static inline T byn_subw_##N(T a, T b) { return (T)((uint64_t)a - (uint64_t)b); } \
    static inline T byn_mulw_##N(T a, T b) { return (T)((uint64_t)a * (uint64_t)b); } \
    static inline T byn_adds_##N(T a, T b) { \
        T r; if (!__builtin_add_overflow(a, b, &r)) return r; return (S) && b < (T)1 ? BYN_MIN(T, S) : BYN_MAX(T, S); } \
    static inline T byn_subs_##N(T a, T b) { \
        T r; if (!__builtin_sub_overflow(a, b, &r)) return r; return (S) ? (b < (T)1 ? BYN_MAX(T, S) : BYN_MIN(T, S)) : (T)0; } \
    static inline T byn_muls_##N(T a, T b) { \
        T r; if (!__builtin_mul_overflow(a, b, &r)) return r; return (S) && ((a < (T)1) != (b < (T)1)) ? BYN_MIN(T, S) : BYN_MAX(T, S); } \
    static inline T byn_shl_##N(T a, int64_t b) { return (T)((uint64_t)a << (b & (BYN_BITS(T) - 1))); } \
    static inline T byn_shr_##N(T a, int64_t b) { return (T)(a >> (b & (BYN_BITS(T) - 1))); } \
    static inline T byn_f2i_##N(double v) { \
        if (v != v) return 0; \
        if (v <= (double)BYN_MIN(T, S)) return BYN_MIN(T, S); \
        if (v >= (double)BYN_MAX(T, S)) return BYN_MAX(T, S); \
        return (T)v; }

BYN_INT_TYPES(BYN_DEF_ARITH)

/* `Env.get`: .NET `Environment.GetEnvironmentVariable`, the value copied into `*out` as .NET decodes it: each lone invalid byte, and each well-formed sequence cut short, as one U+FFFD.
   False, where .NET returns null, when the variable is not set. */
bool byn_env_get(byn_str name, byn_str* out, byn_alloc* to);

/* `Fs.fileExists`: .NET `File.Exists`; false for a directory, a missing entry, an empty path, a path with a NUL, and a path ending in a separator. */
bool byn_fs_file_exists(byn_str path);

/* `Io.remove`: as .NET `File.Delete`: a missing file is not an error, a directory is `permissionDenied`; a missing directory is `notFound`. */
uint32_t byn_io_remove(byn_str path);

/* `Io.createDirectory`: as .NET `Directory.CreateDirectory`: missing parents are made, an existing directory is not an error, an existing file (or a file as a parent) is. */
uint32_t byn_io_create_directory(byn_str path);

/* `Io.removeDirectory`: as .NET `Directory.Delete(path)`: an empty directory only; a missing path, a file and a non-empty directory fail. */
uint32_t byn_io_remove_directory(byn_str path);

/* `Time`: nanoseconds since the Unix epoch, UTC. */
typedef struct byn_time { int64_t nanos; } byn_time;

/* `Time.now`: the wall clock. */
byn_time byn_time_now(void);

/* `Fs.rename`: POSIX `rename`, Windows `MoveFileExW` replacing an existing file. Across devices it fails `crossDevice`; nothing is copied. */
uint32_t byn_fs_rename(byn_str path, byn_str dest);

/* `Fs.copy`: a file's bytes and permission bits, not its times; an existing `dest` is replaced, a directory source fails `isDirectory`, and `dest` that is the source (by file identity) fails `invalidInput`. */
uint32_t byn_fs_copy(byn_str path, byn_str dest);

/* `Fs.modified`: the last write time. `out` may be NULL. */
uint32_t byn_fs_modified(byn_str path, byn_time* out);

/* `Fs.setModified`: sets the last write time (and leaves the access time). */
uint32_t byn_fs_set_modified(byn_str path, byn_time t);

/* `Fs.realPath`: the absolute path with every link resolved, copied into `*out` from `alloc`; a missing path is `notFound`. `out` may be NULL. */
uint32_t byn_fs_real_path(byn_str path, byn_str* out, byn_alloc* alloc);

#endif
"""

const runtimeSource: string = """/* Bayan runtime implementation. See bayan-rt.h. */
#if defined(__linux__) && !defined(_GNU_SOURCE)
#define _GNU_SOURCE /* strtod_l, strtof_l */
#endif
#if !defined(_WIN32) && !defined(_POSIX_C_SOURCE)
#define _POSIX_C_SOURCE 200809L /* clock_gettime under -std=c11 */
#endif
/* The ownership checker is compiled unless the build says otherwise: the toolchain passes -DBYN_NDEBUG for safe and
 * fast builds, so they carry no checker, while a debug program's C still links against a runtime compiled by hand
 * without flags. */
#if !defined(BYN_DEBUG) && !defined(BYN_NDEBUG)
#define BYN_DEBUG
#endif
#include "bayan-rt.h"

#include <errno.h>
#include <limits.h>
#include <locale.h>
#include <stdio.h>
#include <stdlib.h>
#ifdef __APPLE__
#include <xlocale.h>
#endif
#ifdef _WIN32
#include <windows.h>
#include <bcrypt.h>
#include <shellapi.h>
#include <fcntl.h>
#include <io.h>
#else
#include <dirent.h>
#include <fcntl.h>
#include <poll.h>
#include <signal.h>
#include <spawn.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>
#ifdef __linux__
#include <sys/random.h>
#else
/* In <stdlib.h>, but hidden by _POSIX_C_SOURCE on macOS. */
void arc4random_buf(void* buf, size_t n);
#endif
extern char** environ;
#endif

/* Windows text mode would turn each \n written to stdout or stderr into \r\n. Every path that writes either stream
 * calls this first (byn_stdout_flush precedes all the others), so the switch happens once, before the first byte. */
static void byn_stdio_binary(void) {
#ifdef _WIN32
    static bool done;
    if (done) return;
    done = true;
    _setmode(_fileno(stdout), _O_BINARY);
    _setmode(_fileno(stderr), _O_BINARY);
#endif
}

/* ── Panics ──────────────────────────────────────────────────────────────── */

/* The panic in progress: its message (copied, since it may live in the panicking frame the handlers jump over) and
 * location. A second panic while it is set comes from a handler or `Panic.onPanic`, and aborts at once with both. */
static _Thread_local bool byn_panicking;
static _Thread_local char byn_panic_text[1024];
static _Thread_local byn_panic_info byn_panic_now;
static _Thread_local const char* byn_panic_file;
static _Thread_local int byn_panic_line;
_Thread_local byn_panic_handler* byn_panic_handlers;
void (*byn_on_panic)(byn_panic_info);
void (*byn_cov_flush)(void);

static void byn_cov_flush_once(void) {
    void (*flush)(void) = byn_cov_flush;
    byn_cov_flush = NULL;
    if (flush) flush();
}

static void byn_panic_print(const char* prefix, const uint8_t* msg, size_t len, const char* file, int line) {
    byn_stdio_binary();
    fputs(prefix, stderr);
    fwrite(msg, 1, len, stderr);
    if (file) fprintf(stderr, "\n  at %s:%d\n", file, line);
    else fputc('\n', stderr);
}

static BYN_NORETURN void byn_panic_raise(const uint8_t* msg, size_t len, const char* file, int line) {
    byn_stdout_flush();
    if (byn_panicking) {
        byn_panic_print("panic: ", byn_panic_now.message.ptr, (size_t)byn_panic_now.message.len, byn_panic_file, byn_panic_line);
        byn_panic_print("panic in a panic handler: ", msg, len, file, line);
        fflush(stderr);
        byn_cov_flush_once();
        abort();
    }
    byn_panicking = true;
    if (len > sizeof byn_panic_text) {
        // Cut at a code-point boundary: while the first byte dropped is a continuation byte, drop one more.
        len = sizeof byn_panic_text;
        while (len > 0 && (msg[len] & 0xC0) == 0x80) len--;
    }
    memcpy(byn_panic_text, msg, len);
    byn_panic_now.message = (byn_str){(const uint8_t*)byn_panic_text, (int64_t)len};
    byn_panic_file = file;
    byn_panic_line = line;
    byn_panic_resume();
}

byn_panic_info byn_panic_current(void) { return byn_panic_now; }

void byn_panic_resume(void) {
#ifndef __wasi__
    byn_panic_handler* h = byn_panic_handlers;
    if (h) {
        byn_panic_handlers = h->prev;
        longjmp(h->jump, 1);
    }
#endif
    void (*hook)(byn_panic_info) = byn_on_panic;
    byn_on_panic = NULL;
    if (hook) hook(byn_panic_now);
    byn_stdout_flush();
    byn_panic_print("panic: ", byn_panic_now.message.ptr, (size_t)byn_panic_now.message.len, byn_panic_file, byn_panic_line);
    fflush(stderr);
    byn_cov_flush_once();
    abort();
}

void byn_panic(const char* msg, const char* file, int line) {
    byn_panic_raise((const uint8_t*)msg, strlen(msg), file, line);
}

void byn_panic_str(byn_str msg, const char* file, int line) {
    byn_panic_raise(msg.ptr, (size_t)msg.len, file, line);
}

void byn_todo_str(byn_str msg, const char* file, int line) {
    byn_stdout_flush();
    fputs("pending: ", stderr);
    fwrite(msg.ptr, 1, (size_t)msg.len, stderr);
    if (file) fprintf(stderr, "\n  at %s:%d\n", file, line);
    else fputc('\n', stderr);
    fflush(stderr);
    exit(4);
}

void byn_unreachable(const char* file, int line) {
    byn_panic("reached code the compiler proved unreachable", file, line);
}

/* ── Ownership checker ───────────────────────────────────────────────────── */

#ifdef BYN_DEBUG
/* Owned storage by address: an open-addressed table with linear probing; a free slot has NULL storage. */
typedef struct byn_own_rec {
    const void* storage;
    const void* place;
    const char* type;
    const char* file;
    int line;
} byn_own_rec;

static byn_own_rec* byn_own_table;
static size_t byn_own_cap;
static size_t byn_own_count;

static size_t byn_own_home(const void* storage) {
    return (size_t)(((uint64_t)(uintptr_t)storage * UINT64_C(0x9E3779B97F4A7C15)) >> 20) & (byn_own_cap - 1);
}

static byn_own_rec* byn_own_find(const void* storage) {
    if (byn_own_cap == 0) return NULL;
    for (size_t s = byn_own_home(storage);; s = (s + 1) & (byn_own_cap - 1)) {
        if (byn_own_table[s].storage == storage) return &byn_own_table[s];
        if (!byn_own_table[s].storage) return NULL;
    }
}

static byn_own_rec* byn_own_insert(const void* storage) {
    byn_own_rec* r = byn_own_find(storage);
    if (r) return r;
    if ((byn_own_count + 1) * 2 > byn_own_cap) {
        byn_own_rec* old = byn_own_table;
        size_t n = byn_own_cap;
        byn_own_cap = n ? n * 2 : 1024;
        byn_own_table = (byn_own_rec*)calloc(byn_own_cap, sizeof *byn_own_table);
        if (!byn_own_table) byn_panic("out of memory", NULL, 0);
        for (size_t i = 0; i < n; i++) {
            if (!old[i].storage) continue;
            size_t s = byn_own_home(old[i].storage);
            while (byn_own_table[s].storage) s = (s + 1) & (byn_own_cap - 1);
            byn_own_table[s] = old[i];
        }
        free(old);
    }
    size_t s = byn_own_home(storage);
    while (byn_own_table[s].storage) s = (s + 1) & (byn_own_cap - 1);
    byn_own_table[s].storage = storage;
    byn_own_table[s].place = NULL;
    byn_own_count++;
    return &byn_own_table[s];
}

/* Backward-shift deletion: later entries of the probe run move into the hole. */
static void byn_own_remove(byn_own_rec* r) {
    size_t mask = byn_own_cap - 1;
    size_t i = (size_t)(r - byn_own_table);
    for (size_t j = (i + 1) & mask; byn_own_table[j].storage; j = (j + 1) & mask) {
        size_t home = byn_own_home(byn_own_table[j].storage);
        if (((j - home) & mask) >= ((j - i) & mask)) {
            byn_own_table[i] = byn_own_table[j];
            i = j;
        }
    }
    memset(&byn_own_table[i], 0, sizeof byn_own_table[i]);
    byn_own_count--;
}

void byn_own_claim(const void* storage, const void* place, const char* type, const char* file, int line) {
    if (!storage) return;
    byn_own_rec* r = byn_own_insert(storage);
    if (r->place == place) return;
    if (r->place) {
        char msg[512];
        int n = snprintf(msg, sizeof msg, "second owner of %s: owned since %s:%d", type, r->file, r->line);
        byn_panic_raise((const uint8_t*)msg, n < 0 ? 0 : (size_t)n < sizeof msg ? (size_t)n : sizeof msg - 1, file, line);
    }
    r->place = place;
    r->type = type;
    r->file = file;
    r->line = line;
}

void byn_own_release(const void* storage) {
    byn_own_rec* r = storage ? byn_own_find(storage) : NULL;
    if (r) byn_own_remove(r);
}

void byn_own_drop(const void* storage, const void* place) {
    byn_own_rec* r = storage ? byn_own_find(storage) : NULL;
    if (r && r->place == place) byn_own_remove(r);
}

void byn_own_read(const byn_own_slot* slot, const char* type, const char* file, int line) {
    if (BYN_UNLIKELY(slot->line != 0)) {
        char msg[512];
        int n = snprintf(msg, sizeof msg, "use of moved %s: moved at %s:%d", type, slot->file, slot->line);
        byn_panic_raise((const uint8_t*)msg, n < 0 ? 0 : (size_t)n < sizeof msg ? (size_t)n : sizeof msg - 1, file, line);
    }
}

void byn_own_rekey(const void* from, const void* to) {
    if (from == to) return;
    /* Nothing stale may stay at the new address; released first, as its backward shift can move `from`. */
    byn_own_release(to);
    byn_own_rec* r = from ? byn_own_find(from) : NULL;
    if (!r) return;
    byn_own_rec moved = *r;
    byn_own_remove(r);
    moved.storage = to;
    *byn_own_insert(to) = moved;
}

void byn_own_forget(const void* lo, const void* hi) {
    for (size_t i = 0; i < byn_own_cap; i++)
        while (byn_own_table[i].storage && (const uint8_t*)byn_own_table[i].storage >= (const uint8_t*)lo
               && (const uint8_t*)byn_own_table[i].storage < (const uint8_t*)hi)
            byn_own_remove(&byn_own_table[i]);
}
#endif

/* ── Output ──────────────────────────────────────────────────────────────── */

static uint8_t byn_out_buf[1 << 14];
static int64_t byn_out_len;

static void byn_out(const uint8_t* p, int64_t n) {
    if (n <= 0) return; /* an empty string has a null pointer; memcpy(NULL, 0) is undefined */
    if (byn_out_len + n > (int64_t)sizeof byn_out_buf) {
        byn_stdout_flush();
        if (n > (int64_t)sizeof byn_out_buf) {
            fwrite(p, 1, (size_t)n, stdout);
            return;
        }
    }
    memcpy(byn_out_buf + byn_out_len, p, (size_t)n);
    byn_out_len += n;
}

void byn_stdout_flush(void) {
    byn_stdio_binary();
    if (byn_out_len > 0) fwrite(byn_out_buf, 1, (size_t)byn_out_len, stdout);
    byn_out_len = 0;
    fflush(stdout);
}

static void byn_err(const uint8_t* p, int64_t n) {
    byn_stdout_flush();
    fwrite(p, 1, (size_t)n, stderr);
}

void byn_print(byn_builtin_Stream stream, byn_str s) {
    if (stream == 1) {
        byn_err(s.ptr, s.len);
        byn_err((const uint8_t*)"\n", 1);
        fflush(stderr);
        return;
    }
    byn_out(s.ptr, s.len);
    byn_out((const uint8_t*)"\n", 1);
}

void byn_report_error(byn_str summary) {
    byn_stdout_flush();
    fputs("error: ", stderr);
    fwrite(summary.ptr, 1, (size_t)summary.len, stderr);
    fputc('\n', stderr);
    fflush(stderr);
}

void byn_log(byn_builtin_LogLevel level, byn_str text) {
    static const char* const names[] = {"debug: ", "info: ", "warn: ", "error: "};
    byn_stdout_flush();
    fputs(names[level & 3], stderr);
    for (int64_t i = 0; i < text.len; i++) {
        uint8_t b = text.ptr[i];
        if (b == '\n') fputs("\\n", stderr);
        else if (b == '\\') fputs("\\\\", stderr);
        else if (b == '\r') fputs("\\r", stderr);
        else if (b == '\t') fputs("\\t", stderr);
        else if (b < 0x20 || b == 0x7F) fprintf(stderr, "\\u{%X}", b);
        else fputc(b, stderr);
    }
    fputc('\n', stderr);
    fflush(stderr);
}

void byn_w_bytes(byn_writer* w, const uint8_t* p, int64_t n) {
    while (n > 0) {
        int64_t room = w->cap - w->len;
        if (room >= n) {
            memcpy(w->buf + w->len, p, (size_t)n);
            w->len += n;
            return;
        }
        switch (w->mode) {
        case BYN_WRITE_STDOUT:
            byn_out(w->buf, w->len);
            w->len = 0;
            if (n > w->cap) {
                byn_out(p, n);
                return;
            }
            break;
        case BYN_WRITE_STDERR:
            byn_err(w->buf, w->len);
            w->len = 0;
            if (n > w->cap) {
                byn_err(p, n);
                return;
            }
            break;
        case BYN_WRITE_TRUNCATE:
            memcpy(w->buf + w->len, p, (size_t)room);
            w->len = w->cap;
            return;
        case BYN_WRITE_STRICT:
            byn_panic("StrBuf is full", w->file, w->line);
        case BYN_WRITE_GROW: {
            int64_t grown = w->cap < 16 ? 16 : w->cap * 2;
            if (grown < w->len + n) grown = w->len + n;
            /* A fresh block, not a resize: text already taken with asString() keeps pointing at the old one.
             * The checker relies on this (Q745): append after finish() or view is allowed (runtime/tests/strbuf-grow.c). */
            uint8_t* p = (uint8_t*)w->alloc->resize(w->alloc, NULL, 0, grown);
            if (w->len > 0) memcpy(p, w->buf, (size_t)w->len);
#ifdef BYN_DEBUG
            byn_own_rekey(w->buf, p);
#endif
            w->buf = p;
            w->cap = grown;
            break;
        }
        }
    }
}

void byn_w_println(byn_writer* w) {
    if (w->mode == BYN_WRITE_STDERR) {
        byn_err(w->buf, w->len);
        byn_err((const uint8_t*)"\n", 1);
        fflush(stderr);
    } else {
        byn_out(w->buf, w->len);
        byn_out((const uint8_t*)"\n", 1);
    }
    w->len = 0;
}

void byn_w_str(byn_writer* w, byn_str s) { byn_w_bytes(w, s.ptr, s.len); }

void byn_w_u64(byn_writer* w, uint64_t v) {
    uint8_t digits[20];
    int n = 0;
    do {
        digits[19 - n++] = (uint8_t)('0' + v % 10);
        v /= 10;
    } while (v != 0);
    byn_w_bytes(w, digits + 20 - n, n);
}

void byn_w_i64(byn_writer* w, int64_t v) {
    if (v < 0) {
        byn_w_bytes(w, (const uint8_t*)"-", 1);
        byn_w_u64(w, (uint64_t)0 - (uint64_t)v);
    } else {
        byn_w_u64(w, (uint64_t)v);
    }
}

/* Shortest text that reads back as the same value: fixed notation for 1e-5 <= |v| < 1e15
 * (.NET's thresholds), otherwise d.ddde<exp> with a lowercase `e`, no `+` and no leading
 * zeros, so the text is a valid Bayan literal and valid JSON. nan, inf, -inf, -0. */
static void byn_w_float(byn_writer* w, double v, int max_digits, bool single) {
    char sci[40], out[64];
    if (v != v) {
        byn_w_bytes(w, (const uint8_t*)"nan", 3);
        return;
    }
    if (v == 1.0 / 0.0 || v == -1.0 / 0.0) {
        if (v < 0) byn_w_bytes(w, (const uint8_t*)"-", 1);
        byn_w_bytes(w, (const uint8_t*)"inf", 3);
        return;
    }
    if (v == 0) {
        if (1.0 / v < 0) byn_w_bytes(w, (const uint8_t*)"-", 1);
        byn_w_bytes(w, (const uint8_t*)"0", 1);
        return;
    }
    for (int p = 1; p <= max_digits; p++) {
        snprintf(sci, sizeof sci, "%.*e", p - 1, v);
        double back = strtod(sci, NULL);
        if (single ? (float)back == (float)v : back == v) break;
    }
    /* sci is [-]d[.ddd]e[+-]xx: collect the digits and the exponent. */
    char digits[24];
    int n = 0, i = 0, len = 0;
    bool negative = sci[0] == '-';
    if (negative) i++;
    for (; sci[i] && sci[i] != 'e'; i++)
        if (sci[i] != '.') digits[n++] = sci[i];
    int exp = atoi(sci + i + 1);
    while (n > 1 && digits[n - 1] == '0') n--;
    if (negative) out[len++] = '-';
    if (exp >= 15 || exp < -5) {
        out[len++] = digits[0];
        if (n > 1) {
            out[len++] = '.';
            for (int k = 1; k < n; k++) out[len++] = digits[k];
        }
        len += snprintf(out + len, sizeof out - (size_t)len, "e%d", exp);
    } else if (exp < 0) {
        out[len++] = '0';
        out[len++] = '.';
        for (int k = 0; k < -exp - 1; k++) out[len++] = '0';
        for (int k = 0; k < n; k++) out[len++] = digits[k];
    } else {
        for (int k = 0; k <= exp || k < n; k++) {
            if (k == exp + 1) out[len++] = '.';
            out[len++] = k < n ? digits[k] : '0';
        }
    }
    byn_w_bytes(w, (const uint8_t*)out, len);
}

void byn_w_f64(byn_writer* w, double v) { byn_w_float(w, v, 17, false); }
void byn_w_f32(byn_writer* w, float v) { byn_w_float(w, v, 9, true); }

void byn_w_bool(byn_writer* w, bool v) {
    if (v) byn_w_bytes(w, (const uint8_t*)"true", 4);
    else byn_w_bytes(w, (const uint8_t*)"false", 5);
}

void byn_w_char(byn_writer* w, uint32_t c) {
    uint8_t b[4];
    int n;
    if (c < 0x80) { b[0] = (uint8_t)c; n = 1; }
    else if (c < 0x800) { b[0] = (uint8_t)(0xC0 | c >> 6); b[1] = (uint8_t)(0x80 | (c & 0x3F)); n = 2; }
    else if (c < 0x10000) {
        b[0] = (uint8_t)(0xE0 | c >> 12); b[1] = (uint8_t)(0x80 | (c >> 6 & 0x3F)); b[2] = (uint8_t)(0x80 | (c & 0x3F)); n = 3;
    } else {
        b[0] = (uint8_t)(0xF0 | c >> 18); b[1] = (uint8_t)(0x80 | (c >> 12 & 0x3F));
        b[2] = (uint8_t)(0x80 | (c >> 6 & 0x3F)); b[3] = (uint8_t)(0x80 | (c & 0x3F)); n = 4;
    }
    byn_w_bytes(w, b, n);
}

/* ── Strings ─────────────────────────────────────────────────────────────── */

bool byn_str_eq(byn_str a, byn_str b) {
    return a.len == b.len && (a.len == 0 || memcmp(a.ptr, b.ptr, (size_t)a.len) == 0);
}

int byn_str_cmp(byn_str a, byn_str b) {
    int64_t n = a.len < b.len ? a.len : b.len;
    int c = n == 0 ? 0 : memcmp(a.ptr, b.ptr, (size_t)n);
    if (c != 0) return c < 0 ? -1 : 1;
    return a.len < b.len ? -1 : a.len > b.len ? 1 : 0;
}

bool byn_str_starts_with(byn_str s, byn_str prefix) {
    return prefix.len <= s.len && (prefix.len == 0 || memcmp(s.ptr, prefix.ptr, (size_t)prefix.len) == 0);
}

bool byn_str_ends_with(byn_str s, byn_str suffix) {
    return suffix.len <= s.len && (suffix.len == 0 || memcmp(s.ptr + s.len - suffix.len, suffix.ptr, (size_t)suffix.len) == 0);
}

bool byn_str_contains(byn_str s, byn_str text) {
    if (text.len == 0) return true;
    for (int64_t i = 0; i + text.len <= s.len; i++)
        if (memcmp(s.ptr + i, text.ptr, (size_t)text.len) == 0) return true;
    return false;
}

int64_t byn_str_rune_count(byn_str s) {
    int64_t n = 0;
    for (int64_t i = 0; i < s.len; i++)
        if ((s.ptr[i] & 0xC0) != 0x80) n++;
    return n;
}

bool byn_str_is_ascii(byn_str s) {
    for (int64_t i = 0; i < s.len; i++)
        if (s.ptr[i] >= 0x80) return false;
    return true;
}

uint32_t byn_str_next(byn_str s, int64_t* pos) {
    const uint8_t* p = s.ptr + *pos;
    uint32_t c = p[0];
    int n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
    if (n == 2) c = (c & 0x1F) << 6 | (p[1] & 0x3F);
    else if (n == 3) c = (c & 0x0F) << 12 | (uint32_t)(p[1] & 0x3F) << 6 | (p[2] & 0x3F);
    else if (n == 4) c = (c & 0x07) << 18 | (uint32_t)(p[1] & 0x3F) << 12 | (uint32_t)(p[2] & 0x3F) << 6 | (p[3] & 0x3F);
    *pos += n;
    return c;
}

static bool byn_is_boundary(byn_str s, int64_t i) {
    return i == 0 || i == s.len || (s.ptr[i] & 0xC0) != 0x80;
}

byn_str byn_str_slice(byn_str s, int64_t start, int64_t end, const char* file, int line) {
    byn_slice_check(start, end, s.len, file, line);
    if (!byn_is_boundary(s, start) || !byn_is_boundary(s, end)) byn_panic("string slice splits a code point", file, line);
    return (byn_str){s.ptr + start, end - start};
}

static int64_t byn_find(byn_str s, byn_str x, int64_t from) {
    for (int64_t i = from; i + x.len <= s.len; i++)
        if (x.len == 0 || memcmp(s.ptr + i, x.ptr, (size_t)x.len) == 0) return i;
    return -1;
}

int64_t byn_str_position(byn_str s, byn_str x, int64_t from, const char* file, int line) {
    byn_slice_check(from, s.len, s.len, file, line);
    return byn_find(s, x, from);
}

int64_t byn_str_last_position(byn_str s, byn_str x) {
    for (int64_t i = s.len - x.len; i >= 0; i--)
        if (x.len == 0 || memcmp(s.ptr + i, x.ptr, (size_t)x.len) == 0) return i;
    return -1;
}

int64_t byn_str_count(byn_str s, byn_str x) {
    if (x.len == 0) return 0;
    int64_t n = 0;
    for (int64_t i = byn_find(s, x, 0); i >= 0; i = byn_find(s, x, i + x.len)) n++;
    return n;
}

static bool byn_is_space(uint8_t c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f';
}

byn_str byn_str_trimmed(byn_str s, int32_t edge) {
    int64_t a = 0, b = s.len;
    if (edge != 1) while (a < b && byn_is_space(s.ptr[a])) a++;
    if (edge != 0) while (b > a && byn_is_space(s.ptr[b - 1])) b--;
    return (byn_str){s.ptr + a, b - a};
}

static bool byn_rune_in(uint32_t c, const uint32_t* runes, int64_t n) {
    for (int64_t i = 0; i < n; i++)
        if (runes[i] == c) return true;
    return false;
}

byn_str byn_str_trimmed_by(byn_str s, const uint32_t* runes, int64_t n) {
    int64_t a = 0, b = s.len;
    while (a < b) {
        int64_t next = a;
        if (!byn_rune_in(byn_str_next(s, &next), runes, n)) break;
        a = next;
    }
    while (b > a) {
        int64_t start = b - 1;
        while (start > a && (s.ptr[start] & 0xC0) == 0x80) start--;
        int64_t p = start;
        if (!byn_rune_in(byn_str_next(s, &p), runes, n)) break;
        b = start;
    }
    return (byn_str){s.ptr + a, b - a};
}

bool byn_str_eq_caseless(byn_str a, byn_str b) {
    if (a.len != b.len) return false;
    for (int64_t i = 0; i < a.len; i++) {
        uint8_t x = a.ptr[i], y = b.ptr[i];
        if (x >= 'A' && x <= 'Z') x += 32;
        if (y >= 'A' && y <= 'Z') y += 32;
        if (x != y) return false;
    }
    return true;
}

byn_str byn_str_replaced(byn_str s, byn_str x, byn_str y, byn_alloc* to, const char* file, int line) {
    if (x.len == 0) byn_panic("replaced with an empty string to find", file, line);
    int64_t len;
    if (__builtin_mul_overflow(byn_str_count(s, x), y.len - x.len, &len) || __builtin_add_overflow(s.len, len, &len))
        byn_panic("replaced text is too long", file, line);
    if (len == 0) return (byn_str){NULL, 0};
    uint8_t* out = to->resize(to, NULL, 0, len);
    int64_t o = 0, i = 0;
    for (int64_t at = byn_find(s, x, 0); at >= 0; i = at + x.len, at = byn_find(s, x, i)) {
        memcpy(out + o, s.ptr + i, (size_t)(at - i));
        o += at - i;
        if (y.len > 0) memcpy(out + o, y.ptr, (size_t)y.len);
        o += y.len;
    }
    if (s.len > i) memcpy(out + o, s.ptr + i, (size_t)(s.len - i));
    return (byn_str){out, len};
}

byn_str byn_str_repeated(byn_str s, int64_t n, byn_alloc* to, const char* file, int line) {
    if (n < 0) byn_panic("repeated a negative number of times", file, line);
    if (n == 0 || s.len == 0) return (byn_str){NULL, 0};
    if (s.len > INT64_MAX / n) byn_panic("repeated text is too long", file, line);
    uint8_t* out = to->resize(to, NULL, 0, s.len * n);
    for (int64_t i = 0; i < n; i++) memcpy(out + i * s.len, s.ptr, (size_t)s.len);
    return (byn_str){out, s.len * n};
}

byn_str byn_str_joined(const byn_str* xs, int64_t n, byn_str sep, byn_alloc* to) {
    int64_t len = 0;
    if (n > 0 && __builtin_mul_overflow(n - 1, sep.len, &len)) byn_panic("joined text is too long", NULL, 0);
    for (int64_t i = 0; i < n; i++)
        if (__builtin_add_overflow(len, xs[i].len, &len)) byn_panic("joined text is too long", NULL, 0);
    if (len == 0) return (byn_str){NULL, 0};
    uint8_t* out = to->resize(to, NULL, 0, len);
    int64_t o = 0;
    for (int64_t i = 0; i < n; i++) {
        if (i > 0 && sep.len > 0) memcpy(out + o, sep.ptr, (size_t)sep.len), o += sep.len;
        if (xs[i].len > 0) memcpy(out + o, xs[i].ptr, (size_t)xs[i].len), o += xs[i].len;
    }
    return (byn_str){out, len};
}

byn_str byn_str_take_runes(byn_str s, int64_t n, const char* file, int line) {
    if (n < 0) byn_panic("take with a negative count", file, line);
    int64_t pos = 0;
    while (n-- > 0 && pos < s.len) byn_str_next(s, &pos);
    return (byn_str){s.ptr, pos};
}

byn_str byn_str_skip_runes(byn_str s, int64_t n, const char* file, int line) {
    byn_str head = byn_str_take_runes(s, n, file, line);
    return (byn_str){s.ptr + head.len, s.len - head.len};
}

byn_str byn_str_take_last_runes(byn_str s, int64_t n, const char* file, int line) {
    if (n < 0) byn_panic("takeLast with a negative count", file, line);
    int64_t pos = s.len;
    while (n-- > 0 && pos > 0) {
        pos--;
        while (pos > 0 && (s.ptr[pos] & 0xC0) == 0x80) pos--;
    }
    return (byn_str){s.ptr + pos, s.len - pos};
}

/* c as UTF-8 into b; the byte count. */
static int byn_utf8_put(uint8_t b[4], uint32_t c) {
    if (c < 0x80) { b[0] = (uint8_t)c; return 1; }
    if (c < 0x800) { b[0] = (uint8_t)(0xC0 | c >> 6); b[1] = (uint8_t)(0x80 | (c & 0x3F)); return 2; }
    if (c < 0x10000) {
        b[0] = (uint8_t)(0xE0 | c >> 12); b[1] = (uint8_t)(0x80 | (c >> 6 & 0x3F)); b[2] = (uint8_t)(0x80 | (c & 0x3F));
        return 3;
    }
    b[0] = (uint8_t)(0xF0 | c >> 18); b[1] = (uint8_t)(0x80 | (c >> 12 & 0x3F));
    b[2] = (uint8_t)(0x80 | (c >> 6 & 0x3F)); b[3] = (uint8_t)(0x80 | (c & 0x3F));
    return 4;
}

