/* A `{first, last, step, delta}` run table: `c + delta` when `c` is in a run, else `c`. */
static uint32_t byn_path_runs(const int32_t (*t)[4], size_t n, uint32_t c) {
    size_t lo = 0, hi = n;
    while (lo < hi) {
        size_t mid = (lo + hi) / 2;
        if ((int64_t)t[mid][0] <= (int64_t)c) lo = mid + 1;
        else hi = mid;
    }
    if (lo == 0) return c;
    const int32_t* r = t[lo - 1];
    return (int64_t)c <= r[1] && (c - (uint32_t)r[0]) % (uint32_t)r[2] == 0 ? (uint32_t)((int64_t)c + r[3]) : c;
}

/* `char.ToUpperInvariant`, which `PathInternal.EqualStartingCharacterCount` applies to each UTF-16 unit. */
static uint16_t byn_path_upper(uint16_t c) {
    return (uint16_t)byn_path_runs(byn_path_upper_invariant, sizeof byn_path_upper_invariant / sizeof byn_path_upper_invariant[0], c);
}

/* `OrdinalCasing.ToUpper`, which `OrdinalIgnoreCase` applies to a unit outside a surrogate pair. */
static uint16_t byn_path_upper_ordinal_unit(uint16_t c) {
    for (size_t i = 0; i < sizeof byn_path_upper_ordinal / sizeof byn_path_upper_ordinal[0]; i++)
        if (byn_path_upper_ordinal[i][0] == c) return (uint16_t)byn_path_upper_ordinal[i][1];
    return byn_path_upper(c);
}

/* `CharUnicodeInfo.ToUpper`, which `OrdinalIgnoreCase` applies to the scalar of a surrogate pair. */
static uint32_t byn_path_upper_scalar_of(uint32_t c) {
    return byn_path_runs(byn_path_upper_scalar, sizeof byn_path_upper_scalar / sizeof byn_path_upper_scalar[0], c);
}

/* `PathInternal.IsCaseSensitive` is false on Windows and Apple platforms (measured on macOS). */
#if defined(_WIN32) || defined(__APPLE__)
#define BYN_PATH_IGNORE_CASE 1
#else
#define BYN_PATH_IGNORE_CASE 0
#endif

#ifdef _WIN32
static bool byn_path_drive(uint8_t c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); }

/* `PathInternal.IsExtended`: `\\?\` or `\??\`. */
static bool byn_path_extended(const uint8_t* p, int64_t n) {
    return n >= 4 && p[0] == '\\' && (p[1] == '\\' || p[1] == '?') && p[2] == '?' && p[3] == '\\';
}

/* `PathInternal.IsDevice`: extended, or `\\.\` / `\\?\` with either separator. */
static bool byn_path_device(const uint8_t* p, int64_t n) {
    return byn_path_extended(p, n) || (n >= 4 && byn_path_sep(p[0]) && byn_path_sep(p[1]) && (p[2] == '.' || p[2] == '?') && byn_path_sep(p[3]));
}

/* `PathInternal.GetRootLength` (Windows): device, UNC (`\\server\share`), `\`, or a drive (`C:`, `C:\`). */
static int64_t byn_path_root_length(const uint8_t* p, int64_t n) {
    int64_t i = 0;
    bool device = byn_path_device(p, n);
    bool unc = device && n >= 8 && byn_path_sep(p[7]) && p[4] == 'U' && p[5] == 'N' && p[6] == 'C';
    if ((!device || unc) && n > 0 && byn_path_sep(p[0])) {
        if (unc || (n > 1 && byn_path_sep(p[1]))) {
            i = unc ? 8 : 2;
            int skip = 2;
            while (i < n && (!byn_path_sep(p[i]) || --skip > 0)) i++;
        } else {
            i = 1;
        }
    } else if (device) {
        i = 4;
        while (i < n && !byn_path_sep(p[i])) i++;
        if (i < n && i > 4 && byn_path_sep(p[i])) i++;
    } else if (n >= 2 && p[1] == ':' && byn_path_drive(p[0])) {
        i = 2;
        if (n > 2 && byn_path_sep(p[2])) i++;
    }
    return i;
}
#else
static int64_t byn_path_root_length(const uint8_t* p, int64_t n) { return n > 0 && p[0] == '/' ? 1 : 0; }
#endif

bool byn_path_is_rooted(byn_str s) {
#ifdef _WIN32
    return (s.len >= 1 && byn_path_sep(s.ptr[0])) || (s.len >= 2 && byn_path_drive(s.ptr[0]) && s.ptr[1] == ':');
#else
    return s.len >= 1 && s.ptr[0] == '/';
#endif
}

byn_str byn_path_file_name(byn_str s, byn_alloc* to) {
    if (s.len == 0) return (byn_str){NULL, 0};
    int64_t root = byn_path_root_length(s.ptr, s.len);
    int64_t i = s.len - 1;
    while (i >= 0 && !byn_path_sep(s.ptr[i])) i--;
    int64_t start = i < root ? root : i + 1;
    return byn_str_copy((byn_str){s.ptr + start, s.len - start}, to);
}

typedef struct {
    uint8_t* p;
    int64_t n, cap;
} byn_path_buf;

static void byn_path_put(byn_path_buf* b, const void* s, int64_t n) {
    if (b->n + n > b->cap) {
        int64_t cap = b->cap < 64 ? 64 : b->cap * 2;
        while (cap < b->n + n) cap *= 2;
        uint8_t* q = (uint8_t*)realloc(b->p, (size_t)cap);
        if (!q) byn_panic("out of memory", NULL, 0);
        b->p = q;
        b->cap = cap;
    }
    if (n > 0) memcpy(b->p + b->n, s, (size_t)n);
    b->n += n;
}

/* A full path as the UTF-16 units .NET holds, with each unit's byte offset in the UTF-8 text (`at[n]` is its length; both units of a
 * surrogate pair have the sequence's offset). Bayan text is valid UTF-8; an invalid sequence would still become one U+FFFD per
 * maximal subpart, as .NET's decoder makes it. */
typedef struct {
    uint16_t* u;
    int64_t* at;
    int64_t n;
} byn_path_units;

static byn_path_units byn_path_units_of(const uint8_t* s, int64_t n) {
    byn_path_units r = {(uint16_t*)malloc(sizeof(uint16_t) * (size_t)(n + 1)), (int64_t*)malloc(sizeof(int64_t) * (size_t)(n + 1)), 0};
    if (!r.u || !r.at) byn_panic("out of memory", NULL, 0);
    for (int64_t i = 0; i < n;) {
        uint8_t b = s[i];
        int len = b < 0x80 ? 1 : b >= 0xC2 && b <= 0xDF ? 2 : b >= 0xE0 && b <= 0xEF ? 3 : b >= 0xF0 && b <= 0xF4 ? 4 : 0;
        uint8_t lo = b == 0xE0 ? 0xA0 : b == 0xF0 ? 0x90 : 0x80, hi = b == 0xED ? 0x9F : b == 0xF4 ? 0x8F : 0xBF;
        uint32_t c = len == 1 ? b : len == 2 ? b & 0x1Fu : len == 3 ? b & 0x0Fu : b & 0x07u;
        int k = 1;
        for (; k < len && i + k < n; k++) {
            uint8_t t = s[i + k];
            if (t < (k == 1 ? lo : 0x80) || t > (k == 1 ? hi : 0xBF)) break;
            c = c << 6 | (t & 0x3Fu);
        }
        if (k < len || len == 0) c = 0xFFFD;
        if (c >= 0x10000) {
            r.at[r.n] = i;
            r.u[r.n++] = (uint16_t)(0xD800 + ((c - 0x10000) >> 10));
            r.at[r.n] = i;
            r.u[r.n++] = (uint16_t)(0xDC00 + ((c - 0x10000) & 0x3FF));
        } else {
            r.at[r.n] = i;
            r.u[r.n++] = (uint16_t)c;
        }
        i += k;
    }
    r.at[r.n] = n;
    return r;
}

#ifdef _WIN32
static wchar_t* byn_path_wide(int64_t n) {
    wchar_t* w = (wchar_t*)malloc(sizeof(wchar_t) * (size_t)(n > 0 ? n : 1));
    if (!w) byn_panic("out of memory", NULL, 0);
    return w;
}

/* The capacity .NET's `ValueStringBuilder` has after growing from `have` units to hold `want`: `ArrayPool<char>.Shared.Rent` of
 * the larger of `want` and twice `have`, which is a power of two from 16. */
static int64_t byn_path_grown(int64_t have, int64_t want) {
    int64_t n = want > have * 2 ? want : have * 2, cap = 16;
    while (cap < n) cap *= 2;
    return cap;
}

/* UTF-8 bytes to NUL-terminated UTF-16 as `Encoding.UTF8.GetString` decodes them (one U+FFFD per maximal invalid subpart). */
static wchar_t* byn_path_wide_of(const uint8_t* s, int64_t n) {
    byn_path_units u = byn_path_units_of(s, n);
    wchar_t* w = byn_path_wide(u.n + 1);
    for (int64_t i = 0; i < u.n; i++) w[i] = (wchar_t)u.u[i];
    w[u.n] = 0;
    free(u.u);
    free(u.at);
    return w;
}

/* UTF-16 to UTF-8 as `Encoding.UTF8.GetBytes` encodes it: a surrogate outside a pair becomes U+FFFD. */
static void byn_path_utf8_of(byn_path_buf* out, const wchar_t* w, int64_t n) {
    for (int64_t i = 0; i < n; i++) {
        uint32_t c = w[i];
        if (c >= 0xD800 && c <= 0xDBFF && i + 1 < n && w[i + 1] >= 0xDC00 && w[i + 1] <= 0xDFFF)
            c = 0x10000 + ((c - 0xD800) << 10) + ((uint32_t)w[++i] - 0xDC00);
        else if (c >= 0xD800 && c <= 0xDFFF)
            c = 0xFFFD;
        uint8_t b[4];
        int k;
        if (c < 0x80) b[0] = (uint8_t)c, k = 1;
        else if (c < 0x800) b[0] = (uint8_t)(0xC0 | c >> 6), b[1] = (uint8_t)(0x80 | (c & 0x3F)), k = 2;
        else if (c < 0x10000) b[0] = (uint8_t)(0xE0 | c >> 12), b[1] = (uint8_t)(0x80 | (c >> 6 & 0x3F)), b[2] = (uint8_t)(0x80 | (c & 0x3F)), k = 3;
        else b[0] = (uint8_t)(0xF0 | c >> 18), b[1] = (uint8_t)(0x80 | (c >> 12 & 0x3F)), b[2] = (uint8_t)(0x80 | (c >> 6 & 0x3F)), b[3] = (uint8_t)(0x80 | (c & 0x3F)), k = 4;
        byn_path_put(out, b, k);
    }
}

/* `PathHelper.TryExpandShortFileName` (dotnet/runtime `PathHelper.Windows.cs`): `GetLongPathNameW` on a `\\?\` form of the full
 * path, trimming a segment at a time from the end until the rest exists, then the trimmed part put back; the full path itself
 * when nothing can be expanded. Takes `full` (`*n` units, freed) and `cap`, the capacity .NET's builder holding it has, and
 * returns the result, its length in `*n`. `GetLongPathNameW` writes into a buffer of that capacity; when the long name does not
 * fit, .NET grows it and retries with the temporary NUL already put back, so the capacity decides which segment is found. */
static wchar_t* byn_path_expand_short(wchar_t* full, int64_t* n, int64_t cap) {
    /* Root and device tests look only at ASCII, so the UTF-16 units' ASCII shape answers them. */
    uint8_t* shape = (uint8_t*)malloc((size_t)(*n > 0 ? *n : 1));
    if (!shape) byn_panic("out of memory", NULL, 0);
    for (int64_t i = 0; i < *n; i++) shape[i] = full[i] < 0x80 ? (uint8_t)full[i] : 0x80;
    int64_t root = byn_path_root_length(shape, *n);
    bool device = byn_path_device(shape, *n);
    free(shape);
    bool dos_unc = false, dot_device = false;
    int64_t diff = 0, in_n;
    wchar_t* in = byn_path_wide(*n + 9);
    if (device) {
        memcpy(in, full, sizeof(wchar_t) * (size_t)*n);
        in_n = *n;
        if (full[2] == L'.') {
            dot_device = true;
            in[2] = L'?';
        }
    } else {
        /* `PrependDevicePathChars`: `\\server\share` becomes `\\?\UNC\server\share`, anything else `\\?\` plus the path. */
        dos_unc = *n > 1 && full[0] == L'\\' && full[1] == L'\\';
        if (dos_unc) {
            memcpy(in, L"\\\\?\\UNC\\", sizeof(wchar_t) * 8);
            memcpy(in + 8, full + 2, sizeof(wchar_t) * (size_t)(*n - 2));
            diff = 6;
        } else {
            memcpy(in, L"\\\\?\\", sizeof(wchar_t) * 4);
            memcpy(in + 4, full, sizeof(wchar_t) * (size_t)*n);
            diff = 4;
        }
        in_n = *n + diff;
    }
    in[in_n] = 0;
    root += diff;
    wchar_t* out = byn_path_wide(cap);
    int64_t out_n = 0, found = in_n - 1;
    bool ok = false;
    while (!ok) {
        DWORD r = GetLongPathNameW(in, out, (DWORD)cap);
        /* Put back any temporary NUL. */
        if (in[found] == 0) in[found] = L'\\';
        if (r == 0) {
            DWORD e = GetLastError();
            if (e != ERROR_FILE_NOT_FOUND && e != ERROR_PATH_NOT_FOUND) break;
            /* Not found at this index: look further back, ending the string there for now. */
            found--;
            for (; found > root && in[found] != L'\\'; found--) {}
            if (found == root) break;
            in[found] = 0;
        } else if (r > cap) {
            cap = byn_path_grown(cap, r);
            free(out);
            out = byn_path_wide(cap);
        } else {
            ok = true;
            out_n = r;
            if (found < in_n - 1) {
                /* A partial find: put back the part that does not exist. */
                wchar_t* longer = byn_path_wide(out_n + in_n - found);
                memcpy(longer, out, sizeof(wchar_t) * (size_t)out_n);
                memcpy(longer + out_n, in + found, sizeof(wchar_t) * (size_t)(in_n - found));
                free(out);
                out = longer;
                out_n += in_n - found;
            }
        }
    }
    wchar_t* use = ok ? out : in;
    int64_t use_n = ok ? out_n : in_n;
    if (dot_device) use[2] = L'.';
    /* `\\?\UNC\` back to `\\` once the prefix difference is cut. */
    if (dos_unc) use[6] = L'\\';
    wchar_t* result = byn_path_wide(use_n - diff);
    memcpy(result, use + diff, sizeof(wchar_t) * (size_t)(use_n - diff));
    *n = use_n - diff;
    free(in);
    free(out);
    free(full);
    return result;
}
#endif

/* Panics with `name: what`, `name` being the `Path` function that was called. */
static BYN_NORETURN void byn_path_fail(const char* name, const char* what, const char* file, int line) {
    char msg[96];
    snprintf(msg, sizeof msg, "%s: %s", name, what);
    byn_panic(msg, file, line);
}

/* `Path.GetFullPath`: on Windows `GetFullPathNameW` and, when the result has a `~`, short-name expansion, as .NET's
 * `PathHelper.Normalize` does (an extended `\\?\` path is already full); elsewhere the working directory joined to a relative
 * path, then `PathInternal.RemoveRelativeSegments`, and `/` for an empty result. `name` names the caller in
 * the panic text. */
static byn_path_buf byn_path_full(byn_str s, const char* name, const char* file, int line) {
    byn_path_buf out = {0};
#ifdef _WIN32
    if (byn_path_extended(s.ptr, s.len)) {
        byn_path_put(&out, s.ptr, s.len);
        return out;
    }
    wchar_t* w = byn_path_wide_of(s.ptr, s.len);
    /* .NET's builder starts as `stackalloc char[MaxShortPath]` (260) and grows when the full path does not fit. */
    int64_t cap = 260;
    DWORD need = GetFullPathNameW(w, 0, NULL, NULL);
    if (need == 0) byn_path_fail(name, "the path cannot be made full", file, line);
    if (need > cap) cap = byn_path_grown(cap, need);
    wchar_t* full = byn_path_wide(cap);
    DWORD got = GetFullPathNameW(w, (DWORD)cap, full, NULL);
    if (got == 0 || got >= cap) byn_path_fail(name, "the path cannot be made full", file, line);
    int64_t fulln = got;
    for (int64_t i = 0; i < fulln; i++)
        if (full[i] == L'~') {
            full = byn_path_expand_short(full, &fulln, cap);
            break;
        }
    byn_path_utf8_of(&out, full, fulln);
    free(full);
    free(w);
    return out;
#else
    byn_path_buf in = {0};
    if (s.ptr[0] != '/') {
        char* cwd = getcwd(NULL, 0);
        if (!cwd) byn_path_fail(name, "the working directory cannot be read", file, line);
        int64_t cn = (int64_t)strlen(cwd);
        byn_path_put(&in, cwd, cn);
        if (cn == 0 || cwd[cn - 1] != '/') byn_path_put(&in, "/", 1);
        free(cwd);
    }
    byn_path_put(&in, s.ptr, s.len);
    const uint8_t* p = in.p;
    int64_t n = in.n;
    int64_t skip = byn_path_root_length(p, n);
    if (skip > 0 && byn_path_sep(p[skip - 1])) skip--;
    if (skip > 0) byn_path_put(&out, p, skip);
    for (int64_t i = skip; i < n; i++) {
        uint8_t c = p[i];
        if (byn_path_sep(c) && i + 1 < n) {
            if (byn_path_sep(p[i + 1])) continue;
            if ((i + 2 == n || byn_path_sep(p[i + 2])) && p[i + 1] == '.') {
                i++;
                continue;
            }
            if (i + 2 < n && (i + 3 == n || byn_path_sep(p[i + 3])) && p[i + 1] == '.' && p[i + 2] == '.') {
                int64_t k;
                for (k = out.n - 1; k >= skip; k--) {
                    if (byn_path_sep(out.p[k])) {
                        out.n = (i + 3 >= n && k == skip) ? k + 1 : k;
                        break;
                    }
                }
                if (k < skip) out.n = skip;
                i += 2;
                continue;
            }
        }
        byn_path_put(&out, &c, 1);
    }
    free(in.p);
    if (out.n == 0) byn_path_put(&out, "/", 1);
    (void)name;
    (void)file;
    (void)line;
    return out;
#endif
}

/* `PathInternal.IsEffectivelyEmpty`: empty, or on Windows only spaces. */
static bool byn_path_effectively_empty(byn_str s) {
#ifdef _WIN32
    for (int64_t i = 0; i < s.len; i++)
        if (s.ptr[i] != ' ') return false;
    return true;
#else
    return s.len == 0;
#endif
}

/* `Path.GetDirectoryName`: `GetDirectoryNameOffset`, then `PathInternal.NormalizeDirectorySeparators` on the prefix. */
bool byn_path_directory_name(byn_str s, byn_str* out, byn_alloc* to) {
    if (byn_path_effectively_empty(s)) return false;
    int64_t root = byn_path_root_length(s.ptr, s.len), end = s.len;
    if (end <= root) return false;
    while (end > root && !byn_path_sep(s.ptr[--end])) {}
    while (end > root && byn_path_sep(s.ptr[end - 1])) end--;
    uint8_t* d = end > 0 ? to->resize(to, NULL, 0, end) : NULL;
    int64_t n = 0, i = 0;
#ifdef _WIN32
    /* Windows keeps a leading separator before a second one (UNC, device), as `\`. */
    if (end > 0 && byn_path_sep(s.ptr[0])) {
        d[n++] = '\\';
        i = 1;
    }
#endif
    for (; i < end; i++) {
        if (byn_path_sep(s.ptr[i]) && i + 1 < end && byn_path_sep(s.ptr[i + 1])) continue;
        d[n++] = byn_path_sep(s.ptr[i]) ? BYN_PATH_SEP : s.ptr[i];
    }
    *out = (byn_str){d, n};
    return true;
}

/* `Path.Combine(params string[])`: from the last rooted part on, each non-empty part, with the OS separator before it unless the
   text so far ends in a separator. The two-argument `CombineInternal` gives the same bytes: a `b` that starts with a separator is rooted. */
byn_str byn_path_combine_span(const byn_str* p, int64_t n, byn_alloc* to) {
    int64_t first = 0, size = 0;
    for (int64_t i = 0; i < n; i++)
        if (p[i].len > 0 && byn_path_is_rooted(p[i])) first = i;
    for (int64_t i = first; i < n; i++) size += p[i].len + 1;
    uint8_t* d = size > 0 ? to->resize(to, NULL, 0, size) : NULL;
    int64_t len = 0;
    for (int64_t i = first; i < n; i++) {
        if (p[i].len == 0) continue;
        if (len > 0 && !byn_path_sep(d[len - 1])) d[len++] = BYN_PATH_SEP;
        memcpy(d + len, p[i].ptr, (size_t)p[i].len);
        len += p[i].len;
    }
    return (byn_str){d, len};
}

byn_str byn_path_combine(byn_str a, byn_str b, byn_alloc* to) {
    byn_str parts[2] = {a, b};
    return byn_path_combine_span(parts, 2, to);
}

static bool byn_path_usep(uint16_t c) { return c < 0x80 && byn_path_sep((uint8_t)c); }

static bool byn_path_high(const uint16_t* u, int64_t i, int64_t n) {
    return u[i] >= 0xD800 && u[i] <= 0xDBFF && i < n - 1 && u[i + 1] >= 0xDC00 && u[i + 1] <= 0xDFFF;
}

/* `PathInternal.AreRootsEqual`'s `string.Compare` over the first `n` units: `Ordinal`, or where case is ignored `OrdinalIgnoreCase`
 * as `OrdinalCasing.CompareStringIgnoreCase` does it (a surrogate pair by its scalar, never equal to a lone unit). */
static bool byn_path_roots_equal(const uint16_t* a, const uint16_t* b, int64_t n) {
#if BYN_PATH_IGNORE_CASE
    for (int64_t i = 0; i < n;) {
        bool pa = byn_path_high(a, i, n), pb = byn_path_high(b, i, n);
        if (pa != pb) return false;
        if (!pa) {
            if (a[i] != b[i] && byn_path_upper_ordinal_unit(a[i]) != byn_path_upper_ordinal_unit(b[i])) return false;
            i++;
            continue;
        }
        uint32_t sa = 0x10000 + ((uint32_t)(a[i] - 0xD800) << 10) + (uint32_t)(a[i + 1] - 0xDC00);
        uint32_t sb = 0x10000 + ((uint32_t)(b[i] - 0xD800) << 10) + (uint32_t)(b[i + 1] - 0xDC00);
        if (sa != sb && byn_path_upper_scalar_of(sa) != byn_path_upper_scalar_of(sb)) return false;
        i += 2;
    }
    return true;
#else
    return memcmp(a, b, sizeof(uint16_t) * (size_t)n) == 0;
#endif
}

/* `PathInternal.EqualStartingCharacterCount`'s test: equal units, or where case is ignored equal `char.ToUpperInvariant`. */
static bool byn_path_unit_eq(uint16_t a, uint16_t b) {
#if BYN_PATH_IGNORE_CASE
    return a == b || byn_path_upper(a) == byn_path_upper(b);
#else
    return a == b;
#endif
}

/* The unit index whose byte offset is `at` (a root ends at a separator or the end, so at a unit's start). */
static int64_t byn_path_unit_index(const byn_path_units* x, int64_t at) {
    int64_t i = 0;
    while (i < x->n && x->at[i] < at) i++;
    return i;
}

/* `Path.GetRelativePath` after both paths are full, over their UTF-16 units: the target when the roots differ or nothing is shared,
 * `.` for the same path, otherwise a `..` per segment of `f` past the common part, then the rest of `p` (its trailing separator
 * kept), copied from `p`'s bytes. */
static void byn_path_relative_into(byn_path_buf* sb, const uint8_t* fb, int64_t fbn, const uint8_t* pb, int64_t pbn) {
    static const uint8_t sep = BYN_PATH_SEP;
    byn_path_units fx = byn_path_units_of(fb, fbn), px = byn_path_units_of(pb, pbn);
    const uint16_t *f = fx.u, *p = px.u;
    int64_t fn = fx.n, pn = px.n;
    int64_t root = byn_path_unit_index(&fx, byn_path_root_length(fb, fbn));
    bool same_root = root == byn_path_unit_index(&px, byn_path_root_length(pb, pbn)) && byn_path_roots_equal(f, p, root);
    /* `GetCommonPathLength`. */
    int64_t common = 0;
    while (common < fn && common < pn && byn_path_unit_eq(f[common], p[common])) common++;
    if (common != 0 && !(common == fn && (common == pn || byn_path_usep(p[common]))) && !(common == pn && byn_path_usep(f[common])))
        while (common > 0 && !byn_path_usep(f[common - 1])) common--;
    if (!same_root || common == 0) {
        byn_path_put(sb, pb, pbn);
    } else {
        int64_t from_len = byn_path_usep(f[fn - 1]) ? fn - 1 : fn;
        bool trailing = byn_path_usep(p[pn - 1]);
        int64_t path_len = trailing ? pn - 1 : pn;
        if (from_len == path_len && common >= from_len) {
            byn_path_put(sb, ".", 1);
        } else {
            if (common < from_len) {
                byn_path_put(sb, "..", 2);
                for (int64_t i = common + 1; i < from_len; i++)
                    if (byn_path_usep(f[i])) {
                        byn_path_put(sb, &sep, 1);
                        byn_path_put(sb, "..", 2);
                    }
            } else if (byn_path_usep(p[common])) {
                common++;
            }
            int64_t diff = path_len - common + (trailing ? 1 : 0);
            if (diff > 0) {
                if (sb->n > 0) byn_path_put(sb, &sep, 1);
                byn_path_put(sb, pb + px.at[common], px.at[common + diff] - px.at[common]);
            }
        }
    }
    free(fx.u);
    free(fx.at);
    free(px.u);
    free(px.at);
}

byn_str byn_path_relative(byn_str from, byn_str path, byn_alloc* to, const char* file, int line) {
    if (byn_path_effectively_empty(from) || byn_path_effectively_empty(path)) byn_panic("Path.relative: the path is empty", file, line);
    if (memchr(from.ptr, 0, (size_t)from.len) || memchr(path.ptr, 0, (size_t)path.len)) byn_panic("Path.relative: the path has a NUL byte", file, line);
    byn_path_buf f = byn_path_full(from, "Path.relative", file, line), p = byn_path_full(path, "Path.relative", file, line), sb = {0};
    byn_path_relative_into(&sb, f.p, f.n, p.p, p.n);
    byn_str result = byn_str_copy((byn_str){sb.p, sb.n}, to);
    free(sb.p);
    free(f.p);
    free(p.p);
    return result;
}

byn_str byn_path_full_path(byn_str s, byn_alloc* to, const char* file, int line) {
    if (byn_path_effectively_empty(s)) byn_panic("Path.fullPath: the path is empty", file, line);
    if (memchr(s.ptr, 0, (size_t)s.len)) byn_panic("Path.fullPath: the path has a NUL byte", file, line);
    byn_path_buf f = byn_path_full(s, "Path.fullPath", file, line);
    byn_str result = byn_str_copy((byn_str){f.p, f.n}, to);
    free(f.p);
    return result;
}

void byn_list_reserve(void** ptr, int64_t* cap, int64_t need, int64_t elem_size, byn_alloc* alloc) {
    if (need <= *cap) return;
    int64_t grown = *cap < 4 ? 4 : *cap > INT64_MAX / 2 ? INT64_MAX : *cap * 2;
    if (grown < need) grown = need;
    int64_t bytes;
    if (__builtin_mul_overflow(grown, elem_size, &bytes)) byn_panic("list is too long", NULL, 0);
#ifdef BYN_DEBUG
    void* old = *ptr;
#endif
    *ptr = alloc->resize(alloc, *ptr, *cap * elem_size, bytes);
#ifdef BYN_DEBUG
    byn_own_rekey(old, *ptr);
#endif
    *cap = grown;
}

/* ── Maps ────────────────────────────────────────────────────────────────── */

uint64_t byn_hash_seed;
uint64_t byn_hash_seed_hi;

/* Fills p with n bytes from the operating system's CSPRNG. */
static void byn_os_random(void* p, size_t n) {
#ifdef _WIN32
    /* Looked up at run time from System32, so programs link without -lbcrypt. */
    typedef NTSTATUS WINAPI byn_gen_random_fn(BCRYPT_ALG_HANDLE alg, PUCHAR buf, ULONG len, ULONG flags);
    HMODULE bcrypt = LoadLibraryExW(L"bcrypt.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
    byn_gen_random_fn* byn_gen_random = bcrypt ? (byn_gen_random_fn*)(void (*)(void))GetProcAddress(bcrypt, "BCryptGenRandom") : NULL;
    if (!byn_gen_random || byn_gen_random(NULL, (PUCHAR)p, (ULONG)n, BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0)
        byn_panic("cannot read the system random source", NULL, 0);
#elif defined(__linux__)
    uint8_t* b = (uint8_t*)p;
    while (n > 0) {
        ssize_t got = getrandom(b, n, 0);
        if (got < 0) {
            if (errno == EINTR) continue;
            byn_panic("cannot read the system random source", NULL, 0);
        }
        b += got;
        n -= (size_t)got;
    }
#else
    arc4random_buf(p, n);
#endif
}

uint64_t byn_io_random_u64(void) {
    uint64_t r;
    byn_os_random(&r, sizeof r);
    return r;
}

void byn_hash_seed_init(bool fixed) {
    uint64_t key[2] = {0, 0};
    if (!fixed) byn_os_random(key, sizeof key);
    byn_hash_seed = key[0];
    byn_hash_seed_hi = key[1];
}

static inline uint64_t byn_rotl(uint64_t x, int b) {
    return (x << b) | (x >> (64 - b));
}

static inline void byn_sip_round(uint64_t* v) {
    v[0] += v[1], v[1] = byn_rotl(v[1], 13), v[1] ^= v[0], v[0] = byn_rotl(v[0], 32);
    v[2] += v[3], v[3] = byn_rotl(v[3], 16), v[3] ^= v[2];
    v[0] += v[3], v[3] = byn_rotl(v[3], 21), v[3] ^= v[0];
    v[2] += v[1], v[1] = byn_rotl(v[1], 17), v[1] ^= v[2], v[2] = byn_rotl(v[2], 32);
}

/* SipHash-1-3 (one compression round, three finalization rounds) of n bytes under the key (k0, k1). */
static uint64_t byn_siphash13(uint64_t k0, uint64_t k1, const uint8_t* b, int64_t n) {
    uint64_t v[4] = {k0 ^ UINT64_C(0x736f6d6570736575), k1 ^ UINT64_C(0x646f72616e646f6d),
                     k0 ^ UINT64_C(0x6c7967656e657261), k1 ^ UINT64_C(0x7465646279746573)};
    int64_t end = n - n % 8;
    for (int64_t i = 0; i < end; i += 8) {
        uint64_t m = 0;
        for (int j = 7; j >= 0; j--) m = m << 8 | b[i + j];
        v[3] ^= m;
        byn_sip_round(v);
        v[0] ^= m;
    }
    uint64_t last = (uint64_t)n << 56;
    for (int64_t j = n % 8 - 1; j >= 0; j--) last |= (uint64_t)b[end + j] << (8 * j);
    v[3] ^= last;
    byn_sip_round(v);
    v[0] ^= last;
    v[2] ^= 0xff;
    for (int i = 0; i < 3; i++) byn_sip_round(v);
    return v[0] ^ v[1] ^ v[2] ^ v[3];
}

uint64_t byn_hash_bytes(const void* p, int64_t n) {
    return byn_siphash13(byn_hash_seed, byn_hash_seed_hi, (const uint8_t*)p, n);
}

uint64_t byn_hash_mix(uint64_t h, uint64_t part) {
    uint8_t b[16];
    for (int i = 0; i < 8; i++) {
        b[i] = (uint8_t)(h >> (i * 8));
        b[8 + i] = (uint8_t)(part >> (i * 8));
    }
    return byn_siphash13(byn_hash_seed, byn_hash_seed_hi, b, 16);
}

int64_t byn_map_find(const byn_map_hdr* h, const void* keys, int64_t ksize, const void* key, uint64_t hash, byn_key_eq eq) {
    if (h->icap == 0) return -1;
    uint64_t mask = (uint64_t)h->icap - 1;
    for (uint64_t s = hash & mask;; s = (s + 1) & mask) {
        int32_t e = h->index[s];
        if (e < 0) return -1;
        if (!h->dead[e] && h->hashes[e] == hash && eq((const uint8_t*)keys + e * ksize, key)) return e;
    }
}

static void byn_map_place(byn_map_hdr* h, int64_t e) {
    uint64_t mask = (uint64_t)h->icap - 1;
    uint64_t s = h->hashes[e] & mask;
    while (h->index[s] >= 0) s = (s + 1) & mask;
    h->index[s] = (int32_t)e;
}

/* Compacts away tombstones, grows the entries to `cap` and rebuilds the index. */
static void byn_map_rehash(byn_map_hdr* h, uint8_t** keys, int64_t ksize, uint8_t** vals, int64_t vsize, int64_t cap) {
    int64_t j = 0;
    for (int64_t i = 0; i < h->len; i++) {
        if (h->dead[i]) continue;
        if (i != j) {
            memcpy(*keys + j * ksize, *keys + i * ksize, (size_t)ksize);
            memcpy(*vals + j * vsize, *vals + i * vsize, (size_t)vsize);
            h->hashes[j] = h->hashes[i];
        }
        h->dead[j++] = false;
    }
    h->len = h->live = j;
    if (cap > h->cap) {
        byn_alloc* a = h->alloc;
#ifdef BYN_DEBUG
        uint8_t* old = *keys;
#endif
        *keys = a->resize(a, *keys, h->cap * ksize, cap * ksize);
#ifdef BYN_DEBUG
        byn_own_rekey(old, *keys);
#endif
        *vals = a->resize(a, *vals, h->cap * vsize, cap * vsize);
        h->hashes = a->resize(a, h->hashes, h->cap * (int64_t)sizeof(uint64_t), cap * (int64_t)sizeof(uint64_t));
        h->dead = a->resize(a, h->dead, h->cap * (int64_t)sizeof(bool), cap * (int64_t)sizeof(bool));
        h->index = a->resize(a, h->index, h->icap * (int64_t)sizeof(int32_t), cap * 2 * (int64_t)sizeof(int32_t));
        h->cap = cap;
        h->icap = cap * 2;
    }
    memset(h->index, 0xFF, (size_t)h->icap * sizeof(int32_t));
    for (int64_t i = 0; i < h->len; i++) byn_map_place(h, i);
}

int64_t byn_map_insert(byn_map_hdr* h, void** keys, int64_t ksize, void** vals, int64_t vsize, const void* key,
                       uint64_t hash, byn_key_eq eq, bool* added) {
    int64_t e = byn_map_find(h, *keys, ksize, key, hash, eq);
    *added = e < 0;
    if (e >= 0) return e;
    if (h->len == h->cap) {
        int64_t cap = h->cap < 8 ? 8 : h->cap;
        if ((h->live + 1) * 2 > cap) cap *= 2;
        if (cap > INT32_MAX / 2) byn_panic("map too large", __FILE__, __LINE__);
        byn_map_rehash(h, (uint8_t**)keys, ksize, (uint8_t**)vals, vsize, cap);
    }
    e = h->len++;
    h->live++;
    h->hashes[e] = hash;
    h->dead[e] = false;
    byn_map_place(h, e);
    return e;
}

bool byn_map_remove(byn_map_hdr* h, const void* keys, int64_t ksize, const void* key, uint64_t hash, byn_key_eq eq) {
    int64_t e = byn_map_find(h, keys, ksize, key, hash, eq);
    if (e < 0) return false;
    h->dead[e] = true;
    h->live--;
    return true;
}

void byn_map_clear(byn_map_hdr* h) {
    h->len = h->live = 0;
    if (h->icap > 0) memset(h->index, 0xFF, (size_t)h->icap * sizeof(int32_t));
}

void byn_map_copy(const byn_map_hdr* src, const void* keys, int64_t ksize, void** dkeys, const void* vals, int64_t vsize,
                  void** dvals, byn_map_hdr* dst, byn_alloc* to) {
    *dst = (byn_map_hdr){0};
    dst->alloc = to;
    *dkeys = NULL;
    *dvals = NULL;
    if (src->live == 0) return;
    int64_t cap = 8;
    while (cap < src->live) cap *= 2;
    dst->cap = cap;
    dst->icap = cap * 2;
    *dkeys = to->resize(to, NULL, 0, cap * ksize);
    *dvals = to->resize(to, NULL, 0, cap * vsize);
    dst->hashes = to->resize(to, NULL, 0, cap * (int64_t)sizeof(uint64_t));
    dst->dead = to->resize(to, NULL, 0, cap * (int64_t)sizeof(bool));
    dst->index = to->resize(to, NULL, 0, dst->icap * (int64_t)sizeof(int32_t));
    int64_t j = 0;
    for (int64_t i = 0; i < src->len; i++) {
        if (src->dead[i]) continue;
        memcpy((uint8_t*)*dkeys + j * ksize, (const uint8_t*)keys + i * ksize, (size_t)ksize);
        memcpy((uint8_t*)*dvals + j * vsize, (const uint8_t*)vals + i * vsize, (size_t)vsize);
        dst->hashes[j] = src->hashes[i];
        dst->dead[j++] = false;
    }
    dst->len = dst->live = j;
    memset(dst->index, 0xFF, (size_t)dst->icap * sizeof(int32_t));
    for (int64_t i = 0; i < j; i++) byn_map_place(dst, i);
}

byn_writer byn_strbuf_copy(byn_writer w, byn_alloc* to) {
    byn_writer r = byn_strbuf_grow(to);
    r.buf = (uint8_t*)byn_copy_bytes(w.buf, w.len, to);
    r.cap = r.len = w.len;
    return r;
}

/* ── Symbols ─────────────────────────────────────────────────────────────── */

/* Texts and their hashes by ID, an open-addressed index of IDs (UINT32_MAX empty, twice the capacity), and the chunk new
 * texts are copied into. All from the general allocator, never freed. */
static byn_str* byn_sym_texts;
static uint64_t* byn_sym_hashes;
static uint32_t* byn_sym_index;
static uint32_t byn_sym_len, byn_sym_cap;
static uint8_t* byn_sym_chunk;
static int64_t byn_sym_room;

static void byn_sym_place(uint32_t id) {
    uint64_t mask = (uint64_t)byn_sym_cap * 2 - 1;
    uint64_t s = byn_sym_hashes[id] & mask;
    while (byn_sym_index[s] != UINT32_MAX) s = (s + 1) & mask;
    byn_sym_index[s] = id;
}

static uint32_t byn_sym_add(byn_str s, uint64_t hash) {
    if (byn_sym_len == byn_sym_cap) {
        uint32_t cap = byn_sym_cap < 64 ? 64 : byn_sym_cap * 2;
        if (cap > UINT32_MAX / 4) byn_panic("symbol table too large", __FILE__, __LINE__);
        byn_alloc* a = &byn_general;
        byn_sym_texts = a->resize(a, byn_sym_texts, byn_sym_cap * (int64_t)sizeof(byn_str), cap * (int64_t)sizeof(byn_str));
        byn_sym_hashes = a->resize(a, byn_sym_hashes, byn_sym_cap * (int64_t)sizeof(uint64_t), cap * (int64_t)sizeof(uint64_t));
        byn_sym_index = a->resize(a, byn_sym_index, byn_sym_cap * 2 * (int64_t)sizeof(uint32_t), cap * 2 * (int64_t)sizeof(uint32_t));
        byn_sym_cap = cap;
        memset(byn_sym_index, 0xFF, (size_t)cap * 2 * sizeof(uint32_t));
        for (uint32_t i = 0; i < byn_sym_len; i++) byn_sym_place(i);
    }
    uint32_t id = byn_sym_len++;
    byn_sym_texts[id] = s;
    byn_sym_hashes[id] = hash;
    byn_sym_place(id);
    return id;
}

void byn_sym_init(const byn_str* lits, uint32_t n) {
    for (uint32_t i = 0; i < n; i++) byn_sym_add(lits[i], byn_hash_bytes(lits[i].ptr, lits[i].len));
}

byn_sym byn_sym_intern(byn_str s) {
    uint64_t hash = byn_hash_bytes(s.ptr, s.len);
    if (byn_sym_cap > 0) {
        uint64_t mask = (uint64_t)byn_sym_cap * 2 - 1;
        for (uint64_t i = hash & mask; byn_sym_index[i] != UINT32_MAX; i = (i + 1) & mask) {
            uint32_t id = byn_sym_index[i];
            if (byn_sym_hashes[id] == hash && byn_str_eq(byn_sym_texts[id], s)) return (byn_sym){id};
        }
    }
    if (s.len > byn_sym_room) {
        int64_t size = s.len > 4096 ? s.len : 4096;
        byn_sym_chunk = byn_general.resize(&byn_general, NULL, 0, size);
        byn_sym_room = size;
    }
    if (s.len > 0) memcpy(byn_sym_chunk, s.ptr, (size_t)s.len);
    byn_str text = {byn_sym_chunk, s.len};
    byn_sym_chunk += s.len;
    byn_sym_room -= s.len;
    return (byn_sym){byn_sym_add(text, hash)};
}

byn_str byn_sym_text(byn_sym s) {
    return byn_sym_texts[s.id];
}

/* ── Program entry ───────────────────────────────────────────────────────── */

int64_t byn_utf8_invalid_at(const uint8_t* p, int64_t n) {
    int64_t i = 0;
    while (i < n) {
        uint8_t c = p[i];
        if (c < 0x80) {
            i++;
            continue;
        }
        int len;
        uint32_t min;
        uint32_t v;
        if ((c & 0xE0) == 0xC0) len = 2, min = 0x80, v = c & 0x1F;
        else if ((c & 0xF0) == 0xE0) len = 3, min = 0x800, v = c & 0x0F;
        else if ((c & 0xF8) == 0xF0) len = 4, min = 0x10000, v = c & 0x07;
        else return i;
        if (n - i < len) return i;
        for (int k = 1; k < len; k++) {
            if ((p[i + k] & 0xC0) != 0x80) return i;
            v = v << 6 | (p[i + k] & 0x3F);
        }
        if (v < min || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF)) return i;
        i += len;
    }
    return -1;
}

byn_str byn_utf8_decode_replace(const uint8_t* p, int64_t n, byn_alloc* to) {
    /* At most three bytes per input byte: a lone invalid byte becomes U+FFFD. */
    uint8_t* out = n == 0 ? NULL : to->resize(to, NULL, 0, n * 3);
    int64_t len = 0;
    int64_t i = 0;
    while (i < n) {
        int64_t bad = byn_utf8_invalid_at(p + i, n - i);
        int64_t valid = bad < 0 ? n - i : bad;
        memcpy(out + len, p + i, (size_t)valid);
        len += valid;
        i += valid;
        if (bad < 0) break;
        out[len++] = 0xEF, out[len++] = 0xBF, out[len++] = 0xBD;
        /* One U+FFFD per invalid sequence: a lead byte takes the continuation bytes it expects. */
        uint8_t c = p[i++];
        int expect = (c & 0xE0) == 0xC0 ? 1 : (c & 0xF0) == 0xE0 ? 2 : (c & 0xF8) == 0xF0 ? 3 : 0;
        while (expect-- > 0 && i < n && (p[i] & 0xC0) == 0x80) i++;
    }
    if (out) out = to->resize(to, out, n * 3, len);
    return (byn_str){out, len};
}

bool byn_utf8_valid(const uint8_t* p, int64_t n) {
    return byn_utf8_invalid_at(p, n) < 0;
}

static BYN_NORETURN void byn_bad_arg(int i) {
    byn_stdio_binary();
    fprintf(stderr, "error: argument %d is not valid UTF-8\n", i);
    fflush(stderr);
    exit(1);
}

byn_str* byn_args(int* argc, char** argv) {
#ifdef _WIN32
    /* The CRT's argv is in the ANSI code page; the UTF-16 command line is what the caller passed. */
    (void)argv;
    int wargc = 0;
    wchar_t** wargv = CommandLineToArgvW(GetCommandLineW(), &wargc);
    if (!wargv) byn_panic("out of memory", NULL, 0);
    *argc = wargc;
    int n = wargc > 1 ? wargc - 1 : 0;
    byn_str* args = (byn_str*)malloc(sizeof(byn_str) * (size_t)(n > 0 ? n : 1));
    if (!args) byn_panic("out of memory", NULL, 0);
    for (int i = 0; i < n; i++) {
        const wchar_t* w = wargv[i + 1];
        int un = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, w, -1, NULL, 0, NULL, NULL);
        if (un <= 0) byn_bad_arg(i + 1);
        char* p = (char*)malloc((size_t)un);
        if (!p) byn_panic("out of memory", NULL, 0);
        WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, w, -1, p, un, NULL, NULL);
        args[i] = (byn_str){(const uint8_t*)p, un - 1};
    }
    LocalFree(wargv);
    return args;
#else
    int n = *argc > 1 ? *argc - 1 : 0;
    byn_str* args = (byn_str*)malloc(sizeof(byn_str) * (size_t)(n > 0 ? n : 1));
    if (!args) byn_panic("out of memory", NULL, 0);
    for (int i = 0; i < n; i++) {
        const uint8_t* p = (const uint8_t*)argv[i + 1];
        int64_t len = (int64_t)strlen(argv[i + 1]);
        if (!byn_utf8_valid(p, len)) byn_bad_arg(i + 1);
        args[i] = (byn_str){p, len};
    }
    return args;
#endif
}

/* ── Io ──────────────────────────────────────────────────────────────────── */

static uint32_t byn_io_error(int e) {
    switch (e) {
    case ENOENT: return BYN_IO_NOT_FOUND;
    case EACCES:
    case EPERM: return BYN_IO_PERMISSION_DENIED;
    case ENOTDIR: return BYN_IO_NOT_A_DIRECTORY;
    default: return BYN_IO_OTHER;
    }
}

/* Opens a UTF-8 path; NULL with errno set on failure. */
static FILE* byn_io_open(byn_str path, const char* mode) {
    if (memchr(path.ptr, 0, (size_t)path.len)) {
        errno = ENOENT;
        return NULL;
    }
#ifdef _WIN32
    int wn = MultiByteToWideChar(CP_UTF8, 0, (const char*)path.ptr, (int)path.len, NULL, 0);
    wchar_t* wpath = (wchar_t*)malloc(sizeof(wchar_t) * (size_t)(wn + 1));
    if (!wpath) byn_panic("out of memory", NULL, 0);
    MultiByteToWideChar(CP_UTF8, 0, (const char*)path.ptr, (int)path.len, wpath, wn);
    wpath[wn] = 0;
    wchar_t wmode[4] = {0};
    for (int i = 0; mode[i] && i < 3; i++) wmode[i] = (wchar_t)mode[i];
    FILE* f = _wfopen(wpath, wmode);
    free(wpath);
    return f;
#else
    char* cpath = (char*)malloc((size_t)path.len + 1);
    if (!cpath) byn_panic("out of memory", NULL, 0);
    memcpy(cpath, path.ptr, (size_t)path.len);
    cpath[path.len] = 0;
    FILE* f = fopen(cpath, mode);
    free(cpath);
    return f;
#endif
}

uint32_t byn_io_read(byn_str path, uint8_t** ptr, int64_t* len, byn_alloc* alloc) {
    FILE* f = byn_io_open(path, "rb");
    if (!f) return byn_io_error(errno);
    uint8_t* buf = NULL;
    int64_t cap = 0;
    int64_t n = 0;
    for (;;) {
        if (n == cap) {
            int64_t grown = cap < 4096 ? 4096 : cap * 2;
            buf = (uint8_t*)alloc->resize(alloc, buf, cap, grown);
            cap = grown;
        }
        size_t got = fread(buf + n, 1, (size_t)(cap - n), f);
        n += (int64_t)got;
        if (got == 0) break;
    }
    bool failed = ferror(f) != 0;
    int e = errno;
    if (fclose(f) != 0 && !failed) failed = true, e = errno;
    if (failed) {
        byn_release(alloc, buf);
        return byn_io_error(e);
    }
    *ptr = buf;
    *len = n;
    return 0;
}

uint32_t byn_io_read_text(byn_str path, byn_str* out, byn_alloc* alloc) {
    uint8_t* p;
    int64_t n;
    uint32_t err = byn_io_read(path, &p, &n, alloc);
    if (err != 0) return err;
    if (!byn_utf8_valid(p, n)) {
        byn_release(alloc, p);
        return BYN_IO_INVALID_UTF8;
    }
    if (out) *out = (byn_str){p, n};
    return 0;
}

uint32_t byn_io_read_stdin_bytes(uint8_t** ptr, int64_t* len, byn_alloc* alloc) {
#ifdef _WIN32
    /* Text mode would turn CRLF into LF and stop at Ctrl-Z. */
    _setmode(_fileno(stdin), _O_BINARY);
#endif
    uint8_t* buf = NULL;
    int64_t cap = 0;
    int64_t n = 0;
    for (;;) {
        if (n == cap) {
            int64_t grown = cap < 4096 ? 4096 : cap * 2;
            buf = (uint8_t*)alloc->resize(alloc, buf, cap, grown);
            cap = grown;
        }
        size_t got = fread(buf + n, 1, (size_t)(cap - n), stdin);
        n += (int64_t)got;
        if (got == 0) break;
    }
    if (ferror(stdin)) {
        int e = errno;
        byn_release(alloc, buf);
        return byn_io_error(e);
    }
    *ptr = buf;
    *len = n;
    return 0;
}

uint32_t byn_io_read_stdin(byn_str* out, byn_alloc* alloc) {
    uint8_t* p;
    int64_t n;
    uint32_t err = byn_io_read_stdin_bytes(&p, &n, alloc);
    if (err != 0) return err;
    if (!byn_utf8_valid(p, n)) {
        byn_release(alloc, p);
        return BYN_IO_INVALID_UTF8;
    }
    if (out) *out = (byn_str){p, n};
    return 0;
}

uint32_t byn_io_write_file(byn_str path, const uint8_t* ptr, int64_t len) {
    FILE* f = byn_io_open(path, "wb");
    if (!f) return byn_io_error(errno);
    size_t put = len > 0 ? fwrite(ptr, 1, (size_t)len, f) : 0;
    bool failed = (int64_t)put != len;
    int e = errno;
    if (fclose(f) != 0 && !failed) failed = true, e = errno;
    if (failed) return byn_io_error(e);
    return 0;
}

/* Growable bytes from malloc: process output is drained before `alloc` sees it. */
typedef struct byn_bytes {
    uint8_t* ptr;
    int64_t len;
    int64_t cap;
} byn_bytes;

static void byn_bytes_reserve(byn_bytes* b, int64_t more) {
    if (b->len + more <= b->cap) return;
    int64_t grown = b->cap < 4096 ? 4096 : b->cap * 2;
    while (grown < b->len + more) grown *= 2;
    uint8_t* p = (uint8_t*)realloc(b->ptr, (size_t)grown);
    if (!p) byn_panic("out of memory", NULL, 0);
    b->ptr = p;
    b->cap = grown;
}

static int byn_str_order(const void* a, const void* b) {
    const byn_str* x = (const byn_str*)a;
    const byn_str* y = (const byn_str*)b;
    int64_t n = x->len < y->len ? x->len : y->len;
    int c = n > 0 ? memcmp(x->ptr, y->ptr, (size_t)n) : 0;
    if (c != 0) return c;
    return x->len < y->len ? -1 : x->len > y->len;
}

/* Copies an entry name into `alloc` and appends it to the list; false if it is not UTF-8. */
static bool byn_list_dir_add(byn_str** ptr, int64_t* len, int64_t* cap, const char* name, int64_t n, byn_alloc* alloc) {
    if (!byn_utf8_valid((const uint8_t*)name, n)) return false;
    byn_list_reserve((void**)ptr, cap, *len + 1, (int64_t)sizeof(byn_str), alloc);
    (*ptr)[(*len)++] = byn_str_copy((byn_str){(const uint8_t*)name, n}, alloc);
    return true;
}

#ifdef _WIN32
/* A UTF-8 string as a NUL-terminated wide string from malloc. */
static wchar_t* byn_wide(const uint8_t* p, int64_t n) {
    int wn = n > 0 ? MultiByteToWideChar(CP_UTF8, 0, (const char*)p, (int)n, NULL, 0) : 0;
    wchar_t* w = (wchar_t*)malloc(sizeof(wchar_t) * (size_t)(wn + 1));
    if (!w) byn_panic("out of memory", NULL, 0);
    if (wn > 0) MultiByteToWideChar(CP_UTF8, 0, (const char*)p, (int)n, w, wn);
    w[wn] = 0;
    return w;
}

static uint32_t byn_win_error(DWORD e) {
    switch (e) {
    case ERROR_FILE_NOT_FOUND:
    case ERROR_PATH_NOT_FOUND:
    case ERROR_INVALID_NAME:
    case ERROR_BAD_PATHNAME: return BYN_IO_NOT_FOUND;
    case ERROR_ACCESS_DENIED: return BYN_IO_PERMISSION_DENIED;
    case ERROR_DIRECTORY: return BYN_IO_NOT_A_DIRECTORY;
    default: return BYN_IO_OTHER;
    }
}
#else
/* A path as a NUL-terminated string from malloc, or NULL if it holds a NUL byte. */
static char* byn_cstr(byn_str s) {
    if (memchr(s.ptr, 0, (size_t)s.len)) return NULL;
    char* c = (char*)malloc((size_t)s.len + 1);
    if (!c) byn_panic("out of memory", NULL, 0);
    memcpy(c, s.ptr, (size_t)s.len);
    c[s.len] = 0;
    return c;
}
#endif

#ifndef _WIN32
/* The bytes of an environment value as .NET decodes them: each well-formed sequence cut short, each lone invalid byte, and each lead
   with an out-of-range second byte, is one U+FFFD (measured against live .NET in StdEnvTests; `byn_utf8_decode_replace` skips the continuation bytes
   a lead byte expects instead). */
static byn_str byn_env_decode(const uint8_t* p, int64_t n, byn_alloc* to) {
    uint8_t* out = n == 0 ? NULL : to->resize(to, NULL, 0, n * 3);
    int64_t len = 0, i = 0;
    while (i < n) {
        uint8_t c = p[i];
        int need = c >= 0xC2 && c <= 0xDF ? 1 : c >= 0xE0 && c <= 0xEF ? 2 : c >= 0xF0 && c <= 0xF4 ? 3 : 0;
        uint8_t lo = 0x80, hi = 0xBF;
        if (c == 0xE0) lo = 0xA0;
        else if (c == 0xED) hi = 0x9F;
        else if (c == 0xF0) lo = 0x90;
        else if (c == 0xF4) hi = 0x8F;
        int64_t j = i + 1;
        int k = 0;
        for (; k < need && j < n && p[j] >= lo && p[j] <= hi; k++, j++) lo = 0x80, hi = 0xBF;
        /* A second byte that is a continuation but out of range (overlong, surrogate, past U+10FFFF) goes with its lead, as in .NET. */
        int skip = need > 0 && k == 0 && j < n && (p[j] & 0xC0) == 0x80;
        if (skip) j++;
        if (!skip && (c < 0x80 || (need > 0 && k == need))) {
            memcpy(out + len, p + i, (size_t)(j - i));
            len += j - i;
        } else {
            out[len++] = 0xEF, out[len++] = 0xBF, out[len++] = 0xBD;
        }
        i = j;
    }
    if (out) out = to->resize(to, out, n * 3, len);
    return (byn_str){out, len};
}
#endif

bool byn_env_get(byn_str name, byn_str* out, byn_alloc* to) {
#ifdef _WIN32
    wchar_t* w = byn_wide(name.ptr, name.len);
    DWORD n = 128;
    wchar_t* v = NULL;
    DWORD got = 0;
    /* As .NET: grow the buffer while the value does not fit. */
    for (;;) {
        v = (wchar_t*)malloc(sizeof(wchar_t) * (size_t)n);
        if (!v) byn_panic("out of memory", NULL, 0);
        SetLastError(ERROR_SUCCESS);
        got = GetEnvironmentVariableW(w, v, n);
        if (got == 0 && GetLastError() == ERROR_ENVVAR_NOT_FOUND) {
            free(v);
            free(w);
            return false;
        }
        if (got < n) break;
        free(v);
        n = got;
    }
    free(w);
    int un = got > 0 ? WideCharToMultiByte(CP_UTF8, 0, v, (int)got, NULL, 0, NULL, NULL) : 0;
    char* u = (char*)malloc((size_t)un + 1);
    if (!u) byn_panic("out of memory", NULL, 0);
    if (un > 0) WideCharToMultiByte(CP_UTF8, 0, v, (int)got, u, un, NULL, NULL);
    free(v);
    *out = byn_utf8_decode_replace((const uint8_t*)u, un, to);
    free(u);
    return true;
#else
    /* .NET passes the name as a C string, so a NUL ends it; a name with `=` is never found. */
    const uint8_t* nul = name.len > 0 ? memchr(name.ptr, 0, (size_t)name.len) : NULL;
    if (nul) name.len = nul - name.ptr;
    if (name.len > 0 && memchr(name.ptr, '=', (size_t)name.len)) return false;
    char* c = byn_cstr(name);
    const char* v = getenv(c);
    free(c);
    if (!v) return false;
    *out = byn_env_decode((const uint8_t*)v, (int64_t)strlen(v), to);
    return true;
#endif
}

/* As .NET `File.Exists`: an empty path, a NUL, a path (made full as `Path.GetFullPath`) ending in a separator, a missing entry and a directory give false; a dangling symlink gives true on POSIX. */
bool byn_fs_file_exists(byn_str path) {
    if (byn_path_effectively_empty(path) || (path.len > 0 && memchr(path.ptr, 0, (size_t)path.len))) return false;
    byn_path_buf f = byn_path_full(path, "Fs.fileExists", NULL, 0);
    bool found = false;
    if (f.n > 0 && !byn_path_sep(f.p[f.n - 1])) {
#ifdef _WIN32
        wchar_t* w = byn_path_wide_of(f.p, f.n);
        size_t wn = wcslen(w);
        /* As .NET `EnsureExtendedPrefixIfNeeded`: a full path of 260 or more chars gets `\\?\` (`\\?\UNC\` for `\\server\share`). */
        if (wn >= 260 && !byn_path_extended((const uint8_t*)f.p, f.n) && !(wn >= 4 && w[0] == L'\\' && w[1] == L'\\' && w[2] == L'.' && w[3] == L'\\')) {
            bool unc = wn >= 2 && w[0] == L'\\' && w[1] == L'\\';
            const wchar_t* prefix = unc ? L"\\\\?\\UNC\\" : L"\\\\?\\";
            size_t pn = wcslen(prefix);
            wchar_t* x = (wchar_t*)malloc(sizeof(wchar_t) * (wn + pn + 1));
            if (!x) byn_panic("out of memory", NULL, 0);
            wcscpy(x, prefix);
            wcscpy(x + pn, unc ? w + 2 : w);
            free(w);
            w = x;
        }
        DWORD attrs = GetFileAttributesW(w);
        /* As .NET `FillAttributeInfo`: a sharing violation falls back to the directory listing's attributes. */
        if (attrs == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_SHARING_VIOLATION) {
            WIN32_FIND_DATAW fd;
            HANDLE h = FindFirstFileW(w, &fd);
            if (h != INVALID_HANDLE_VALUE) {
                attrs = fd.dwFileAttributes;
                FindClose(h);
            }
        }
        found = attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
        free(w);
#else
        char* c = byn_cstr((byn_str){f.p, f.n});
        struct stat st;
        /* As .NET: a link whose target is missing is still an entry, and not a directory. */
        found = (stat(c, &st) == 0 || lstat(c, &st) == 0) && (st.st_mode & S_IFMT) != S_IFDIR;
        free(c);
#endif
    }
    free(f.p);
    return found;
}

uint32_t byn_io_list_dir(byn_str path, byn_str** ptr, int64_t* len, byn_alloc* alloc) {
    byn_str* names = NULL;
    int64_t n = 0;
    int64_t cap = 0;
    if (memchr(path.ptr, 0, (size_t)path.len)) return BYN_IO_NOT_FOUND;
#ifdef _WIN32
    wchar_t* wpath = byn_wide(path.ptr, path.len);
    DWORD attrs = GetFileAttributesW(wpath);
    if (attrs == INVALID_FILE_ATTRIBUTES) {
        free(wpath);
        return byn_win_error(GetLastError());
    }
    if (!(attrs & FILE_ATTRIBUTE_DIRECTORY)) {
        free(wpath);
        return BYN_IO_NOT_A_DIRECTORY;
    }
    size_t wn = wcslen(wpath);
    wchar_t* pattern = (wchar_t*)malloc(sizeof(wchar_t) * (wn + 3));
    if (!pattern) byn_panic("out of memory", NULL, 0);
    memcpy(pattern, wpath, sizeof(wchar_t) * wn);
    if (wn > 0 && wpath[wn - 1] != L'\\' && wpath[wn - 1] != L'/') pattern[wn++] = L'\\';
    pattern[wn++] = L'*';
    pattern[wn] = 0;
    free(wpath);
    WIN32_FIND_DATAW fd;
    HANDLE h = FindFirstFileW(pattern, &fd);
    free(pattern);
    if (h == INVALID_HANDLE_VALUE) {
        DWORD e = GetLastError();
        if (e != ERROR_FILE_NOT_FOUND) return byn_win_error(e);
    } else {
        uint32_t err = 0;
        do {
            const wchar_t* w = fd.cFileName;
            if (wcscmp(w, L".") == 0 || wcscmp(w, L"..") == 0) continue;
            char name[MAX_PATH * 4];
            int un = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, w, -1, name, (int)sizeof name, NULL, NULL);
            if (un <= 0 || !byn_list_dir_add(&names, &n, &cap, name, un - 1, alloc)) {
                err = BYN_IO_INVALID_UTF8;
                break;
            }
        } while (FindNextFileW(h, &fd));
        DWORD e = GetLastError();
        FindClose(h);
        if (err != 0) return err;
        if (e != ERROR_NO_MORE_FILES) return byn_win_error(e);
    }
#else
    char* cpath = byn_cstr(path);
    DIR* d = opendir(cpath);
    int e = errno;
    free(cpath);
    if (!d) return byn_io_error(e);
    for (;;) {
        errno = 0;
        struct dirent* ent = readdir(d);
        if (!ent) {
            e = errno;
            break;
        }
        const char* name = ent->d_name;
        if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) continue;
        if (!byn_list_dir_add(&names, &n, &cap, name, (int64_t)strlen(name), alloc)) {
            closedir(d);
            return BYN_IO_INVALID_UTF8;
        }
    }
    closedir(d);
    if (e != 0) return byn_io_error(e);
#endif
    if (n > 1) qsort(names, (size_t)n, sizeof(byn_str), byn_str_order);
    *ptr = names;
    *len = n;
    return 0;
}

uint32_t byn_io_remove(byn_str path) {
    if (byn_path_effectively_empty(path) || memchr(path.ptr, 0, (size_t)path.len)) return BYN_IO_NOT_FOUND;
#ifdef _WIN32
    wchar_t* wpath = byn_wide(path.ptr, path.len);
    BOOL ok = DeleteFileW(wpath);
    DWORD e = ok ? 0 : GetLastError();
    free(wpath);
    if (ok || e == ERROR_FILE_NOT_FOUND) return 0;
    return byn_win_error(e);
#else
    /* As .NET: the path is made full (`.` and `..` resolved) before it is deleted. */
    byn_path_buf f = byn_path_full(path, "Io.remove", NULL, 0);
    char* cpath = byn_cstr((byn_str){f.p, f.n});
    int rc = unlink(cpath);
    int e = errno;
    free(cpath);
    if (rc == 0) {
        free(f.p);
        return 0;
    }
    if (e == ENOENT) {
        /* A missing file is not an error, but a missing directory is. */
        int64_t i = f.n;
        while (i > 0 && !byn_path_sep(f.p[i - 1])) i--;
        bool missing = false;
        if (i > 0) {
            char* d = byn_cstr((byn_str){f.p, i > 1 ? i - 1 : i});
            struct stat st;
            missing = stat(d, &st) != 0 || (st.st_mode & S_IFMT) != S_IFDIR;
            free(d);
        }
        free(f.p);
        return missing ? BYN_IO_NOT_FOUND : 0;
    }
    free(f.p);
    if (e == EISDIR) return BYN_IO_PERMISSION_DENIED;
    return byn_io_error(e);
#endif
}

#ifndef _WIN32
/* `mkdir` with the missing parents made first; 0 or the errno. An existing directory is not an error, an existing file is. */
static int byn_mkdir_all(char* p, int64_t n) {
    if (mkdir(p, 0777) == 0) return 0;
    int e = errno;
    struct stat st;
    if (e == EEXIST) return stat(p, &st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR ? 0 : EEXIST;
    if (e != ENOENT) return e;
    int64_t i = n;
    while (i > 0 && p[i - 1] != '/') i--;
    if (i <= 1) return e;
    p[i - 1] = 0;
    int r = byn_mkdir_all(p, i - 1);
    p[i - 1] = '/';
    if (r != 0) return r;
    if (mkdir(p, 0777) == 0) return 0;
    e = errno;
    return e == EEXIST && stat(p, &st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR ? 0 : e;
}
#endif

uint32_t byn_io_create_directory(byn_str path) {
    if (byn_path_effectively_empty(path) || memchr(path.ptr, 0, (size_t)path.len)) return BYN_IO_NOT_FOUND;
    /* As .NET: the full path without its trailing separators. */
    byn_path_buf f = byn_path_full(path, "Io.createDirectory", NULL, 0);
    while (f.n > 1 && byn_path_sep(f.p[f.n - 1])) f.n--;
#ifdef _WIN32
    /* .NET starts after `Path.GetPathRoot`: `C:\`, `\\?\C:\` or `\\server\share\`, so the walk never creates a root. */
    wchar_t* wroot = byn_wide(f.p, byn_path_root_length(f.p, f.n));
    size_t root = wcslen(wroot);
    free(wroot);
    wchar_t* w = byn_wide(f.p, f.n);
    free(f.p);
    size_t wn = wcslen(w);
    uint32_t result = 0;
    for (size_t i = root; i <= wn && result == 0; i++) {
        if (i < wn && w[i] != L'\\' && w[i] != L'/') continue;
        wchar_t keep = w[i];
        w[i] = 0;
        if (!CreateDirectoryW(w, NULL)) {
            DWORD e = GetLastError();
            DWORD attrs = e == ERROR_ALREADY_EXISTS ? GetFileAttributesW(w) : INVALID_FILE_ATTRIBUTES;
            if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY)) result = e == ERROR_ALREADY_EXISTS ? BYN_IO_OTHER : byn_win_error(e);
        }
        w[i] = keep;
    }
    free(w);
    return result;
#else
    char* cpath = byn_cstr((byn_str){f.p, f.n});
    free(f.p);
    int e = byn_mkdir_all(cpath, (int64_t)strlen(cpath));
    free(cpath);
    return e == 0 ? 0 : byn_io_error(e);
#endif
}

uint32_t byn_io_remove_directory(byn_str path) {
    if (byn_path_effectively_empty(path) || memchr(path.ptr, 0, (size_t)path.len)) return BYN_IO_NOT_FOUND;
#ifdef _WIN32
    wchar_t* wpath = byn_wide(path.ptr, path.len);
    BOOL ok = RemoveDirectoryW(wpath);
    DWORD e = ok ? 0 : GetLastError();
    free(wpath);
    return ok ? 0 : byn_win_error(e);
#else
    /* As .NET: the path is made full first, and a symlink to a directory is unlinked. */
    byn_path_buf f = byn_path_full(path, "Io.removeDirectory", NULL, 0);
    char* cpath = byn_cstr((byn_str){f.p, f.n});
    free(f.p);
    int rc = rmdir(cpath);
    int e = errno;
    struct stat st;
    if (rc != 0 && e == ENOTDIR && lstat(cpath, &st) == 0 && (st.st_mode & S_IFMT) == S_IFLNK && stat(cpath, &st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR) {
        rc = unlink(cpath);
        e = errno;
    }
    free(cpath);
    return rc == 0 ? 0 : byn_io_error(e);
#endif
}

/* ── Fs: rename, copy, write times, realPath ─────────────────────────────── */

/* Whether a path holds a NUL byte: such a path fails `invalidInput` before any call is made. */
static bool byn_has_nul(byn_str s) {
    return s.len > 0 && memchr(s.ptr, 0, (size_t)s.len) != NULL;
}

#ifdef _WIN32
/* 100 ns ticks from 1601-01-01 to 1970-01-01. */
#define BYN_FILETIME_EPOCH ((int64_t)116444736000000000)

/* A handle to `path`, a file or a directory, opened for `access`; INVALID_HANDLE_VALUE, with the error kept for GetLastError, on failure. */
static HANDLE byn_fs_handle(byn_str path, DWORD access) {
    wchar_t* w = byn_wide(path.ptr, path.len);
    HANDLE h = CreateFileW(w, access, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
    DWORD e = h == INVALID_HANDLE_VALUE ? GetLastError() : 0;
    free(w);
    if (h == INVALID_HANDLE_VALUE) SetLastError(e);
    return h;
}

/* Closes `h`: `r`, or the close's error when `r` is 0 and the close fails. */
static uint32_t byn_fs_close(HANDLE h, uint32_t r) {
    if (!CloseHandle(h) && r == 0) return byn_win_error(GetLastError());
    return r;
}
#endif

uint32_t byn_fs_rename(byn_str path, byn_str dest) {
    if (byn_has_nul(path) || byn_has_nul(dest)) return BYN_IO_INVALID_INPUT;
#ifdef _WIN32
    wchar_t* wfrom = byn_wide(path.ptr, path.len);
    wchar_t* wto = byn_wide(dest.ptr, dest.len);
    BOOL ok = MoveFileExW(wfrom, wto, MOVEFILE_REPLACE_EXISTING);
    DWORD e = ok ? 0 : GetLastError();
    free(wfrom);
    free(wto);
    if (ok) return 0;
    return e == ERROR_NOT_SAME_DEVICE ? BYN_IO_CROSS_DEVICE : byn_win_error(e);
#else
    char* from = byn_cstr(path);
    char* to = byn_cstr(dest);
    int rc = rename(from, to);
    int e = rc == 0 ? 0 : errno;
    free(from);
    free(to);
    if (rc == 0) return 0;
    return e == EXDEV ? BYN_IO_CROSS_DEVICE : byn_io_error(e);
#endif
}

#ifndef _WIN32
/* Copies the open file `in` (`st` its stat) to `to`, then gives `to` the permission bits of `st`: 0 or an `IoError` code. */
static uint32_t byn_fs_copy_to(int in, const struct stat* st, const char* to) {
    int out = open(to, O_WRONLY | O_CREAT | O_CLOEXEC, 0600);
    if (out < 0) return byn_io_error(errno);
    struct stat dst;
    int e = 0;
    if (fstat(out, &dst) != 0) {
        e = errno;
    } else if (dst.st_dev == st->st_dev && dst.st_ino == st->st_ino) {
        /* The same file by identity, whatever the spelling: truncating it would empty the source. */
        if (close(out) != 0) return byn_io_error(errno);
        return BYN_IO_INVALID_INPUT;
    } else if (ftruncate(out, 0) != 0) {
        e = errno;
    }
    uint8_t buf[65536];
    while (e == 0) {
        ssize_t n = read(in, buf, sizeof buf);
        if (n < 0) {
            if (errno != EINTR) e = errno;
            continue;
        }
        if (n == 0) break;
        for (ssize_t done = 0; done < n && e == 0;) {
            ssize_t w = write(out, buf + done, (size_t)(n - done));
            if (w >= 0) done += w;
            else if (errno != EINTR) e = errno;
        }
    }
    if (e == 0 && fchmod(out, st->st_mode & 07777) != 0) e = errno;
    if (close(out) != 0 && e == 0) e = errno;
    return e == 0 ? 0 : byn_io_error(e);
}
#endif

uint32_t byn_fs_copy(byn_str path, byn_str dest) {
    if (byn_has_nul(path) || byn_has_nul(dest)) return BYN_IO_INVALID_INPUT;
#ifdef _WIN32
    HANDLE in = byn_fs_handle(path, FILE_READ_ATTRIBUTES);
    if (in == INVALID_HANDLE_VALUE) return byn_win_error(GetLastError());
    BY_HANDLE_FILE_INFORMATION src;
    if (!GetFileInformationByHandle(in, &src)) return byn_fs_close(in, byn_win_error(GetLastError()));
    uint32_t r = (src.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? BYN_IO_IS_DIRECTORY : 0;
    if (r == 0) {
        HANDLE out = byn_fs_handle(dest, FILE_READ_ATTRIBUTES);
        if (out != INVALID_HANDLE_VALUE) {
            BY_HANDLE_FILE_INFORMATION dst;
            if (!GetFileInformationByHandle(out, &dst)) r = byn_win_error(GetLastError());
            /* The same file by identity, whatever the spelling. */
            else if (dst.dwVolumeSerialNumber == src.dwVolumeSerialNumber && dst.nFileIndexHigh == src.nFileIndexHigh && dst.nFileIndexLow == src.nFileIndexLow) r = BYN_IO_INVALID_INPUT;
            r = byn_fs_close(out, r);
        } else {
            DWORD e = GetLastError();
            /* A missing destination is created by the copy, which reports a missing directory itself. */
            if (e != ERROR_FILE_NOT_FOUND && e != ERROR_PATH_NOT_FOUND) r = byn_win_error(e);
        }
    }
    r = byn_fs_close(in, r);
    if (r != 0) return r;
    wchar_t* wfrom = byn_wide(path.ptr, path.len);
    wchar_t* wto = byn_wide(dest.ptr, dest.len);
    BOOL ok = CopyFileW(wfrom, wto, FALSE);
    DWORD e = ok ? 0 : GetLastError();
    free(wfrom);
    free(wto);
    if (!ok) return byn_win_error(e);
    /* `CopyFileW` keeps the source's write time; a copy is new, as on POSIX. */
    HANDLE h = byn_fs_handle(dest, FILE_WRITE_ATTRIBUTES);
    if (h == INVALID_HANDLE_VALUE) return byn_win_error(GetLastError());
    FILETIME now;
    GetSystemTimeAsFileTime(&now);
    if (!SetFileTime(h, NULL, NULL, &now)) return byn_fs_close(h, byn_win_error(GetLastError()));
    return byn_fs_close(h, 0);
#else
    char* from = byn_cstr(path);
    char* to = byn_cstr(dest);
    uint32_t r;
    int in = open(from, O_RDONLY | O_CLOEXEC);
    if (in < 0) {
        r = byn_io_error(errno);
    } else {
        struct stat st;
        if (fstat(in, &st) != 0) r = byn_io_error(errno);
        /* Files only. */
        else if ((st.st_mode & S_IFMT) == S_IFDIR) r = BYN_IO_IS_DIRECTORY;
        else r = byn_fs_copy_to(in, &st, to);
        if (close(in) != 0 && r == 0) r = byn_io_error(errno);
    }
    free(from);
    free(to);
    return r;
#endif
}

uint32_t byn_fs_modified(byn_str path, byn_time* out) {
    if (byn_has_nul(path)) return BYN_IO_INVALID_INPUT;
#ifdef _WIN32
    HANDLE h = byn_fs_handle(path, FILE_READ_ATTRIBUTES);
    if (h == INVALID_HANDLE_VALUE) return byn_win_error(GetLastError());
    FILETIME ft;
    if (!GetFileTime(h, NULL, NULL, &ft)) return byn_fs_close(h, byn_win_error(GetLastError()));
    uint32_t r = byn_fs_close(h, 0);
    int64_t ticks = (int64_t)(((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime);
    if (r == 0 && out) out->nanos = (ticks - BYN_FILETIME_EPOCH) * 100;
    return r;
#else
    char* c = byn_cstr(path);
    struct stat st;
    int rc = stat(c, &st);
    int e = rc == 0 ? 0 : errno;
    free(c);
    if (rc != 0) return byn_io_error(e);
#ifdef __APPLE__
    /* Under _POSIX_C_SOURCE Darwin names the parts `st_mtime` and `st_mtimensec`, not `st_mtimespec`. */
    int64_t sec = st.st_mtime, nsec = st.st_mtimensec;
#else
    int64_t sec = st.st_mtim.tv_sec, nsec = st.st_mtim.tv_nsec;
#endif
    if (out) out->nanos = sec * 1000000000 + nsec;
    return 0;
#endif
}

uint32_t byn_fs_set_modified(byn_str path, byn_time t) {
    if (byn_has_nul(path)) return BYN_IO_INVALID_INPUT;
    /* Floored, so a time before 1970 keeps a non-negative part below the second. */
    int64_t sec = t.nanos / 1000000000;
    int64_t nsec = t.nanos % 1000000000;
    if (nsec < 0) {
        sec--;
        nsec += 1000000000;
    }
#ifdef _WIN32
    /* FILETIME counts 100 ns ticks from 1601; an earlier time has no FILETIME. */
    if (sec < -BYN_FILETIME_EPOCH / 10000000) return BYN_IO_INVALID_INPUT;
    int64_t ticks = sec * 10000000 + nsec / 100 + BYN_FILETIME_EPOCH;
    FILETIME ft = {(DWORD)((uint64_t)ticks & 0xFFFFFFFFu), (DWORD)((uint64_t)ticks >> 32)};
    HANDLE h = byn_fs_handle(path, FILE_WRITE_ATTRIBUTES);
    if (h == INVALID_HANDLE_VALUE) return byn_win_error(GetLastError());
    if (!SetFileTime(h, NULL, NULL, &ft)) return byn_fs_close(h, byn_win_error(GetLastError()));
    return byn_fs_close(h, 0);
#else
    char* c = byn_cstr(path);
    struct timespec ts[2] = {{0, UTIME_OMIT}, {(time_t)sec, (long)nsec}};
    int rc = utimensat(AT_FDCWD, c, ts, 0);
    int e = rc == 0 ? 0 : errno;
    free(c);
    return rc == 0 ? 0 : byn_io_error(e);
#endif
}

uint32_t byn_fs_real_path(byn_str path, byn_str* out, byn_alloc* alloc) {
    if (byn_has_nul(path)) return BYN_IO_INVALID_INPUT;
#ifdef _WIN32
    HANDLE h = byn_fs_handle(path, 0);
    if (h == INVALID_HANDLE_VALUE) return byn_win_error(GetLastError());
    DWORD n = GetFinalPathNameByHandleW(h, NULL, 0, FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
    if (n == 0) return byn_fs_close(h, byn_win_error(GetLastError()));
    wchar_t* w = (wchar_t*)malloc(sizeof(wchar_t) * n);
    if (!w) byn_panic("out of memory", NULL, 0);
    DWORD got = GetFinalPathNameByHandleW(h, w, n, FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
    uint32_t r = byn_fs_close(h, got == 0 ? byn_win_error(GetLastError()) : got >= n ? BYN_IO_OTHER : 0);
    /* `\\?\C:\x` is `C:\x`, and `\\?\UNC\server\share` is `\\server\share`. */
    const wchar_t* p = w;
    if (r == 0 && got >= 4 && w[0] == L'\\' && w[1] == L'\\' && w[2] == L'?' && w[3] == L'\\') {
        if (got >= 8 && w[4] == L'U' && w[5] == L'N' && w[6] == L'C' && w[7] == L'\\') {
            w[6] = L'\\';
            p = w + 6;
        } else {
            p = w + 4;
        }
    }
    int len = r == 0 ? WideCharToMultiByte(CP_UTF8, 0, p, -1, NULL, 0, NULL, NULL) : 0;
    if (r == 0 && len <= 0) r = byn_win_error(GetLastError());
    char* s = r == 0 ? (char*)malloc((size_t)len) : NULL;
    if (r == 0 && !s) byn_panic("out of memory", NULL, 0);
    if (r == 0 && WideCharToMultiByte(CP_UTF8, 0, p, -1, s, len, NULL, NULL) != len) r = byn_win_error(GetLastError());
    free(w);
    if (r == 0 && out) *out = byn_str_copy((byn_str){(const uint8_t*)s, len - 1}, alloc);
    free(s);
    return r;
#else
    char* c = byn_cstr(path);
    char* resolved = realpath(c, NULL);
    int e = resolved ? 0 : errno;
    free(c);
    if (!resolved) return byn_io_error(e);
    if (out) *out = byn_str_copy((byn_str){(const uint8_t*)resolved, (int64_t)strlen(resolved)}, alloc);
    free(resolved);
    return 0;
#endif
}

static void byn_bytes_add(byn_bytes* b, const void* p, int64_t n) {
    byn_bytes_reserve(b, n);
    memcpy(b->ptr + b->len, p, (size_t)n);
    b->len += n;
}

/* Whether `s` can be quoted for cmd.exe exactly: no NUL, CR or LF (they end the command), no `"`
 * (it would close the quotes) and no `%` (expanded even inside quotes). */
static bool byn_batch_safe(byn_str s) {
    for (int64_t i = 0; i < s.len; i++) {
        uint8_t c = s.ptr[i];
        if (c == 0 || c == '\r' || c == '\n' || c == '"' || c == '%') return false;
    }
    return true;
}

bool byn_batch_cmdline(byn_str path, const byn_str* args, int64_t nargs, byn_str* out) {
    if (path.len < 4 || !byn_batch_safe(path)) return false;
    char ext[4];
    for (int i = 0; i < 4; i++) {
        uint8_t c = path.ptr[path.len - 4 + i];
        ext[i] = (char)(c >= 'A' && c <= 'Z' ? c + 32 : c);
    }
    if (memcmp(ext, ".bat", 4) != 0 && memcmp(ext, ".cmd", 4) != 0) return false;
    /* A bare name would make cmd.exe search the current directory and PATH. */
    if (!memchr(path.ptr, '/', (size_t)path.len) && !memchr(path.ptr, '\\', (size_t)path.len)) return false;
    for (int64_t i = 0; i < nargs; i++)
        if (!byn_batch_safe(args[i])) return false;
    byn_bytes b = {NULL, 0, 0};
    const char* head = "cmd.exe /d /e:ON /v:OFF /s /c \"\"";
    byn_bytes_add(&b, head, (int64_t)strlen(head));
    byn_bytes_add(&b, path.ptr, path.len);
    byn_bytes_add(&b, "\"", 1);
    for (int64_t i = 0; i < nargs; i++) {
        byn_bytes_add(&b, " \"", 2);
        byn_bytes_add(&b, args[i].ptr, args[i].len);
        byn_bytes_add(&b, "\"", 1);
    }
    byn_bytes_add(&b, "\"", 1);
    *out = (byn_str){b.ptr, b.len};
    return true;
}

uint32_t byn_wait_status(int outcome, uint32_t raw, int32_t* code, int64_t* detail) {
    if (outcome == BYN_WAIT_FAILED || outcome == BYN_WAIT_QUERY_FAILED) return BYN_IO_OTHER;
    if (outcome == BYN_WAIT_TIMED_OUT) return BYN_IO_TIMEOUT;
#ifdef _WIN32
    (void)detail;
    *code = (int32_t)raw;
#else
    int status = (int)raw;
    if (WIFSIGNALED(status)) {
        if (detail) *detail = WTERMSIG(status);
        return BYN_IO_SIGNALED;
    }
    *code = WEXITSTATUS(status);
#endif
    return 0;
}

/* `Io.run(…, timeout:)`: how long a child has after SIGTERM before SIGKILL (Q-b), and how long its streams are still
 * drained after the kill (a Job object's drain threads are joined) before they are given up, as the C# test runner does. */
#define BYN_RUN_GRACE_MS 2000
#define BYN_RUN_DRAIN_MS 5000
/* `Io.run(…, timeout:)` keeps each stream's first and last BYN_RUN_KEEP bytes (BoundedCapture.cs `Keep`, Q1227). */
#define BYN_RUN_KEEP 65536

/* One captured stream, from malloc. With `keep` >= 0 only the first `keep` bytes (`head`) and the last `keep` (`tail`, a
 * ring once the head is full) are stored; `total` counts every byte. With `keep` < 0 every byte goes to `head`. */
typedef struct byn_capture {
    byn_bytes head;
    uint8_t* tail;
    int64_t tail_start, tail_len, total, keep;
} byn_capture;

/* BoundedCapture.cs `Append`. */
static void byn_capture_add(byn_capture* c, const uint8_t* p, int64_t n) {
    c->total += n;
    int64_t take = c->keep < 0 || n <= c->keep - c->head.len ? n : c->keep - c->head.len;
    if (take > 0) byn_bytes_add(&c->head, p, take);
    p += take;
    n -= take;
    if (n == 0) return;
    if (!c->tail) {
        c->tail = (uint8_t*)malloc((size_t)c->keep);
        if (!c->tail) byn_panic("out of memory", NULL, 0);
    }
    if (n >= c->keep) {
        memcpy(c->tail, p + n - c->keep, (size_t)c->keep);
        c->tail_start = 0;
        c->tail_len = c->keep;
        return;
    }
    while (n > 0) {
        int64_t end = (c->tail_start + c->tail_len) % c->keep;
        int64_t k = n < c->keep - end ? n : c->keep - end;
        memcpy(c->tail + end, p, (size_t)k);
        p += k;
        n -= k;
        int64_t overflow = c->tail_len + k - c->keep;
        if (overflow > 0) {
            c->tail_start = (c->tail_start + overflow) % c->keep;
            c->tail_len = c->keep;
        } else c->tail_len += k;
    }
}

/* Appends `n` bytes decoded with U+FFFD for each invalid sequence (`Encoding.UTF8.GetString`). */
static void byn_bytes_add_replaced(byn_bytes* b, const uint8_t* p, int64_t n) {
    if (n == 0) return;
    byn_str s = byn_utf8_decode_replace(p, n, &byn_general);
    byn_bytes_add(b, s.ptr, s.len);
    free((void*)s.ptr);
}

/* BoundedCapture.cs `Snapshot` as bytes from malloc, freeing the capture: the stream as read when nothing was dropped,
 * else its head and its tail, each decoded with U+FFFD, around one `\n… N bytes omitted …\n` line. */
static byn_bytes byn_capture_take(byn_capture* c) {
    int64_t omitted = c->total - c->head.len - c->tail_len;
    byn_bytes last = {NULL, 0, 0};
    if (c->tail_len > 0) {
        int64_t first = c->keep - c->tail_start < c->tail_len ? c->keep - c->tail_start : c->tail_len;
        byn_bytes_add(&last, c->tail + c->tail_start, first);
        if (c->tail_len > first) byn_bytes_add(&last, c->tail, c->tail_len - first);
    }
    free(c->tail);
    if (omitted == 0) {
        byn_bytes whole = c->head;
        if (last.len > 0) byn_bytes_add(&whole, last.ptr, last.len);
        free(last.ptr);
        return whole;
    }
    byn_bytes b = {NULL, 0, 0};
    byn_bytes_add_replaced(&b, c->head.ptr, c->head.len);
    char marker[64];
    int m = snprintf(marker, sizeof marker, "\n\xE2\x80\xA6 %lld bytes omitted \xE2\x80\xA6\n", (long long)omitted);
    byn_bytes_add(&b, marker, m);
    byn_bytes_add_replaced(&b, last.ptr, last.len);
    free(c->head.ptr);
    free(last.ptr);
    return b;
}

/* Maps the wait first (byn_wait_status), then takes both captures (byn_capture_take), checks they are UTF-8 and copies
 * them into `alloc`, for an exited child and for a signal-killed or timed-out one (which keeps its streams; non-UTF-8
 * ones are dropped, not `invalidUtf8`); frees them on every path. */
static uint32_t byn_process_finish(byn_capture* captures, int outcome, uint32_t raw, byn_process* out, int64_t* detail, byn_alloc* alloc) {
    int32_t code = 0;
    uint32_t result = byn_wait_status(outcome, raw, &code, detail);
    byn_bytes streams[2] = {byn_capture_take(&captures[0]), byn_capture_take(&captures[1])};
    bool valid = byn_utf8_valid(streams[0].ptr, streams[0].len) && byn_utf8_valid(streams[1].ptr, streams[1].len);
    if (result == 0 && !valid)
        result = BYN_IO_INVALID_UTF8;
    else if ((result == 0 || result == BYN_IO_SIGNALED || result == BYN_IO_TIMEOUT) && valid && out)
        *out = (byn_process){code, byn_str_copy((byn_str){streams[0].ptr, streams[0].len}, alloc),
                             byn_str_copy((byn_str){streams[1].ptr, streams[1].len}, alloc)};
    free(streams[0].ptr);
    free(streams[1].ptr);
    return result;
}

#ifndef _WIN32
/* One expiry of a POSIX run's deadline moves `*stage` on: SIGTERM to the child's group and to the child itself (it may have
 * left the group, which a helper keeps alive), delivered when either succeeds, then SIGKILL after the grace period, then BYN_RUN_DRAIN_MS more to
 * drain and reap; a SIGTERM that fails moves on at once, and a SIGKILL that fails ends the drain and the reap at once
 * (nothing was killed, so waiting longer would not help). Returns the new deadline. */
static int64_t byn_run_expire(pid_t pid, int* stage, int64_t now) {
    if (*stage == 0) {
        *stage = 1;
        int group = kill(-pid, SIGTERM), self = kill(pid, SIGTERM);
        if (group == 0 || self == 0) return now + (int64_t)BYN_RUN_GRACE_MS * 1000000;
    }
    *stage = 2;
    int group = kill(-pid, SIGKILL), self = kill(pid, SIGKILL);
    if (group != 0 && self != 0) return now;
    return now + (int64_t)BYN_RUN_DRAIN_MS * 1000000;
}
#endif

#ifdef _WIN32

/* Appends one argument quoted so that CommandLineToArgvW and the MSVC runtime read it back unchanged. */
static void byn_quote_arg(byn_bytes* b, byn_str s) {
    if (b->len > 0) byn_bytes_add(b, " ", 1);
    bool plain = s.len > 0;
    for (int64_t i = 0; i < s.len && plain; i++)
        if (s.ptr[i] == ' ' || s.ptr[i] == '\t' || s.ptr[i] == '\n' || s.ptr[i] == '\v' || s.ptr[i] == '"') plain = false;
    if (plain) {
        byn_bytes_add(b, s.ptr, s.len);
        return;
    }
    byn_bytes_add(b, "\"", 1);
    for (int64_t i = 0;; i++) {
        int64_t slashes = 0;
        while (i < s.len && s.ptr[i] == '\\') i++, slashes++;
        if (i == s.len) {
            for (int64_t k = 0; k < slashes * 2; k++) byn_bytes_add(b, "\\", 1);
            break;
        }
        int64_t count = s.ptr[i] == '"' ? slashes * 2 + 1 : slashes;
        for (int64_t k = 0; k < count; k++) byn_bytes_add(b, "\\", 1);
        byn_bytes_add(b, &s.ptr[i], 1);
    }
    byn_bytes_add(b, "\"", 1);
}

/* Whether a program name ends in `.bat` or `.cmd`; Windows ignores trailing dots and spaces. */
static bool byn_is_batch(const wchar_t* s, size_t n) {
    while (n > 0 && (s[n - 1] == L'.' || s[n - 1] == L' ')) n--;
    return n >= 4 && (_wcsnicmp(s + n - 4, L".bat", 4) == 0 || _wcsnicmp(s + n - 4, L".cmd", 4) == 0);
}

/* `dir` (`dn` units), a separator, `name` and `ext` as a file path from malloc if it is a file, else NULL. */
static wchar_t* byn_program_in(const wchar_t* dir, size_t dn, const wchar_t* name, size_t nn, const wchar_t* ext, size_t xn) {
    wchar_t* c = (wchar_t*)malloc(sizeof(wchar_t) * (dn + nn + xn + 2));
    if (!c) byn_panic("out of memory", NULL, 0);
    memcpy(c, dir, sizeof(wchar_t) * dn);
    size_t at = dn;
    if (c[at - 1] != L'\\' && c[at - 1] != L'/') c[at++] = L'\\';
    memcpy(c + at, name, sizeof(wchar_t) * nn);
    memcpy(c + at + nn, ext, sizeof(wchar_t) * xn);
    c[at + nn + xn] = 0;
    DWORD attrs = GetFileAttributesW(c);
    if (attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY)) return c;
    free(c);
    return NULL;
}

/* `program` itself if it names a path, else the first PATH entry holding it as given or with a
 * PATHEXT extension; `.BAT` and `.CMD` are never appended. */
static wchar_t* byn_find_program(byn_str program) {
    wchar_t* name = byn_wide(program.ptr, program.len);
    if (memchr(program.ptr, '/', (size_t)program.len) || memchr(program.ptr, '\\', (size_t)program.len)) return name;
    wchar_t path[32767];
    wchar_t exts[1024];
    DWORD pn = GetEnvironmentVariableW(L"PATH", path, 32767);
    if (pn == 0 || pn >= 32767) path[0] = 0;
    DWORD en = GetEnvironmentVariableW(L"PATHEXT", exts, 1024);
    if (en == 0 || en >= 1024) wcscpy(exts, L".COM;.EXE;.BAT;.CMD");
    size_t nn = wcslen(name);
    /* Like CreateProcess, the bare name is tried only when its final component already has an extension. */
    wchar_t* base = wcsrchr(name, L'.');
    int bare = base != NULL;
    wchar_t* found = NULL;
    for (wchar_t* dir = path; *dir && !found;) {
        wchar_t* dend = wcschr(dir, L';');
        size_t dn = dend ? (size_t)(dend - dir) : wcslen(dir);
        if (dn > 0 && bare) found = byn_program_in(dir, dn, name, nn, L"", 0);
        for (wchar_t* ext = exts; *ext && dn > 0 && !found;) {
            wchar_t* eend = wcschr(ext, L';');
            size_t xn = eend ? (size_t)(eend - ext) : wcslen(ext);
            if (xn > 0 && !byn_is_batch(ext, xn)) found = byn_program_in(dir, dn, name, nn, ext, xn);
            ext = eend ? eend + 1 : ext + xn;
        }
        dir = dend ? dend + 1 : dir + dn;
    }
    free(name);
    return found;
}

typedef struct byn_drain {
    HANDLE h;
    byn_capture capture;
} byn_drain;

static DWORD WINAPI byn_drain_pipe(LPVOID arg) {
    byn_drain* d = (byn_drain*)arg;
    uint8_t buffer[4096];
    for (;;) {
        DWORD got = 0;
        if (!ReadFile(d->h, buffer, sizeof buffer, &got, NULL) || got == 0) break;
        byn_capture_add(&d->capture, buffer, got);
    }
    return 0;
}

typedef struct byn_feed {
    HANDLE h;
    const uint8_t* ptr;
    int64_t len;
} byn_feed;

/* Writes the input to the child's stdin, then closes it; stops early when the child closes its end. */
static DWORD WINAPI byn_feed_pipe(LPVOID arg) {
    byn_feed* f = (byn_feed*)arg;
    while (f->len > 0) {
        DWORD put = 0;
        if (!WriteFile(f->h, f->ptr, f->len > 65536 ? 65536 : (DWORD)f->len, &put, NULL)) break;
        f->ptr += put;
        f->len -= put;
    }
    CloseHandle(f->h);
    return 0;
}

/* Orders `NAME=value` entries by name, case-insensitively, as an environment block wants; a leading `=` is part of the name. */
static int byn_env_order(const void* a, const void* b) {
    const wchar_t* x = *(const wchar_t* const*)a;
    const wchar_t* y = *(const wchar_t* const*)b;
    const wchar_t* xe = wcschr(x + 1, L'=');
    const wchar_t* ye = wcschr(y + 1, L'=');
    int xn = xe ? (int)(xe - x) : (int)wcslen(x);
    int yn = ye ? (int)(ye - y) : (int)wcslen(y);
    return CompareStringOrdinal(x, xn, y, yn, TRUE) - CSTR_EQUAL;
}

/* The inherited environment with each `keys[i]` replacing the variable of its name: set to `vals[i]`, or dropped when
 * `unset[i]` is set, as a sorted CREATE_UNICODE_ENVIRONMENT block from malloc. */
static wchar_t* byn_env_block(const byn_str* keys, const byn_str* vals, const bool* unset, int64_t n) {
    wchar_t* inherited = GetEnvironmentStringsW();
    size_t count = 0;
    for (wchar_t* p = inherited; p && *p; p += wcslen(p) + 1) count++;
    wchar_t** made = (wchar_t**)malloc(sizeof(wchar_t*) * (size_t)(n + 1));
    wchar_t** list = (wchar_t**)malloc(sizeof(wchar_t*) * (count + (size_t)n + 1));
    if (!made || !list) byn_panic("out of memory", NULL, 0);
    /* An unset entry is `NAME=`: it matches its name but is not added. */
    size_t nmade = 0;
    for (int64_t i = 0; i < n; i++) {
        byn_bytes kv = {NULL, 0, 0};
        byn_bytes_add(&kv, keys[i].ptr, keys[i].len);
        byn_bytes_add(&kv, "=", 1);
        if (!(unset && unset[i])) byn_bytes_add(&kv, vals[i].ptr, vals[i].len);
        made[nmade++] = byn_wide(kv.ptr, kv.len);
        free(kv.ptr);
    }
    size_t len = 0;
    for (wchar_t* p = inherited; p && *p; p += wcslen(p) + 1) {
        bool replaced = false;
        for (size_t k = 0; k < nmade && !replaced; k++) replaced = byn_env_order(&p, &made[k]) == 0;
        if (!replaced) list[len++] = p;
    }
    for (size_t k = 0; k < nmade; k++)
        if (!(unset && unset[k])) list[len++] = made[k];
    qsort(list, len, sizeof *list, byn_env_order);
    size_t total = 1;
    for (size_t i = 0; i < len; i++) total += wcslen(list[i]) + 1;
    wchar_t* block = (wchar_t*)malloc(sizeof(wchar_t) * (total + 1));
    if (!block) byn_panic("out of memory", NULL, 0);
    size_t at = 0;
    for (size_t i = 0; i < len; i++) {
        size_t k = wcslen(list[i]) + 1;
        memcpy(block + at, list[i], sizeof(wchar_t) * k);
        at += k;
    }
    block[at++] = 0;
    if (len == 0) block[at] = 0;
    for (size_t k = 0; k < nmade; k++) free(made[k]);
    free(made);
    free(list);
    if (inherited) FreeEnvironmentStringsW(inherited);
    return block;
}

/* Runs `app` with the command line `wline` (both freed here), capturing both streams into `streams` (their `keep` set by
 * the caller). `dir` (NULL: ours)
 * is its working directory, `env` (NULL: ours) its environment block, and `input` (`ninput` < 0: our stdin) its stdin.
 * With `timeout_ms` >= 0 the child starts suspended inside a Job object, which is terminated once the timeout passes
 * with the process or a drain still running; the process is waited for before the drain threads are joined, and after
 * the timeout the joins wait BYN_RUN_DRAIN_MS at most (a thread still running then keeps its block, which is leaked). `*outcome` and `*raw` (the exit code) are
 * for byn_process_finish. */
static uint32_t byn_win_spawn(wchar_t* app, wchar_t* wline, const wchar_t* dir, wchar_t* env, const uint8_t* input, int64_t ninput,
                              int64_t timeout_ms, byn_capture* streams, int* outcome, uint32_t* raw) {
    SECURITY_ATTRIBUTES sa = {sizeof sa, NULL, TRUE};
    HANDLE reads[3] = {NULL, NULL, NULL};
    HANDLE writes[3] = {NULL, NULL, NULL};
    int npipes = ninput >= 0 ? 3 : 2;
    HANDLE job = NULL;
    if (timeout_ms >= 0) {
        JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits;
        memset(&limits, 0, sizeof limits);
        limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
        job = CreateJobObjectW(NULL, NULL);
        if (!job || !SetInformationJobObject(job, JobObjectExtendedLimitInformation, &limits, sizeof limits)) {
            DWORD e = GetLastError();
            if (job) CloseHandle(job);
            free(app);
            free(wline);
            return byn_win_error(e);
        }
    }
    for (int i = 0; i < npipes; i++) {
        if (!CreatePipe(&reads[i], &writes[i], &sa, 0)) {
            DWORD e = GetLastError();
            for (int k = 0; k < i; k++) {
                CloseHandle(reads[k]);
                CloseHandle(writes[k]);
            }
            if (job) CloseHandle(job);
            free(app);
            free(wline);
            return byn_win_error(e);
        }
    }
    /* Our ends are not inherited: the read ends of stdout and stderr, the write end of stdin. */
    SetHandleInformation(reads[0], HANDLE_FLAG_INHERIT, 0);
    SetHandleInformation(reads[1], HANDLE_FLAG_INHERIT, 0);
    if (npipes == 3) SetHandleInformation(writes[2], HANDLE_FLAG_INHERIT, 0);
    STARTUPINFOW si;
    memset(&si, 0, sizeof si);
    si.cb = sizeof si;
    si.dwFlags = STARTF_USESTDHANDLES;
    si.hStdInput = npipes == 3 ? reads[2] : GetStdHandle(STD_INPUT_HANDLE);
    si.hStdOutput = writes[0];
    si.hStdError = writes[1];
    PROCESS_INFORMATION pi;
    DWORD flags = (env ? CREATE_UNICODE_ENVIRONMENT : 0) | (job ? CREATE_SUSPENDED : 0);
    BOOL started = CreateProcessW(app, wline, NULL, NULL, TRUE, flags, env, dir, &si, &pi);
    DWORD e = GetLastError();
    free(app);
    free(wline);
    CloseHandle(writes[0]);
    CloseHandle(writes[1]);
    if (npipes == 3) CloseHandle(reads[2]);
    /* A suspended child is in the job before it runs, so everything it starts is in the job too. */
    if (started && job) {
        BOOL assigned = AssignProcessToJobObject(job, pi.hProcess);
        if (!assigned || ResumeThread(pi.hThread) == (DWORD)-1) {
            e = GetLastError();
            /* Still suspended: killed through the job once it is in it, else directly; if that fails too, closing the
             * job below is all that is left. */
            if (assigned ? TerminateJobObject(job, 1) : TerminateProcess(pi.hProcess, 1))
                if (WaitForSingleObject(pi.hProcess, INFINITE) != WAIT_OBJECT_0) e = GetLastError();
            CloseHandle(pi.hThread);
            CloseHandle(pi.hProcess);
            started = FALSE;
        }
    }
    if (!started) {
        CloseHandle(reads[0]);
        CloseHandle(reads[1]);
        if (npipes == 3) CloseHandle(writes[2]);
        if (job) CloseHandle(job);
        return byn_win_error(e);
    }
    CloseHandle(pi.hThread);
    /* From malloc: after a timeout a thread that outlives its bounded join keeps using it. */
    struct {
        byn_feed feed;
        byn_drain drains[2];
    }* io = malloc(sizeof *io);
    if (!io) byn_panic("out of memory", NULL, 0);
    io->feed = (byn_feed){writes[2], input, ninput};
    io->drains[0] = (byn_drain){reads[0], streams[0]};
    io->drains[1] = (byn_drain){reads[1], streams[1]};
    HANDLE ft = NULL;
    if (npipes == 3) {
        ft = CreateThread(NULL, 0, byn_feed_pipe, &io->feed, 0, NULL);
        if (!ft) byn_feed_pipe(&io->feed);
    }
    HANDLE threads[2] = {NULL, NULL};
    threads[1] = CreateThread(NULL, 0, byn_drain_pipe, &io->drains[1], 0, NULL);
    if (!threads[1]) byn_drain_pipe(&io->drains[1]);
    /* Without a timeout we drain stdout ourselves; with one a thread does, so that we can wait on the process. */
    if (job) threads[0] = CreateThread(NULL, 0, byn_drain_pipe, &io->drains[0], 0, NULL);
    if (!threads[0]) byn_drain_pipe(&io->drains[0]);
    DWORD status = 0;
    *outcome = BYN_WAIT_DONE;
    DWORD limit = job ? (timeout_ms >= (int64_t)INFINITE ? INFINITE - 1 : (DWORD)timeout_ms) : INFINITE;
    int64_t start = byn_io_monotonic_nanos();
    DWORD waited = WaitForSingleObject(pi.hProcess, limit);
    bool expired = waited == WAIT_TIMEOUT;
    if (!expired && waited != WAIT_OBJECT_0) *outcome = BYN_WAIT_FAILED;
    else if (!expired && !GetExitCodeProcess(pi.hProcess, &status)) *outcome = BYN_WAIT_QUERY_FAILED;
    HANDLE joins[3] = {threads[0], threads[1], ft};
    /* A descendant in the job can hold the pipes after the child ended in time, so the joins get what is left of the
     * timeout; once it passes the job is terminated as if the child had run on. */
    for (int i = 0; i < 3 && job && waited == WAIT_OBJECT_0 && !expired; i++) {
        if (!joins[i]) continue;
        int64_t spent = (byn_io_monotonic_nanos() - start) / 1000000;
        expired = WaitForSingleObject(joins[i], spent >= (int64_t)limit ? 0 : (DWORD)(limit - spent)) == WAIT_TIMEOUT;
    }
    if (expired) {
        *outcome = BYN_WAIT_TIMED_OUT;
        if (!TerminateJobObject(job, 1) || WaitForSingleObject(pi.hProcess, INFINITE) != WAIT_OBJECT_0) *outcome = BYN_WAIT_FAILED;
    }
    CloseHandle(pi.hProcess);
    /* After the deadline the job's kill closed every holder of the pipes, so the joins end; the bound is for one that
     * did not, and for a terminate that failed. */
    DWORD bound = expired ? BYN_RUN_DRAIN_MS : INFINITE;
    bool abandoned = false;
    for (int i = 0; i < 3; i++) {
        if (!joins[i]) continue;
        if (WaitForSingleObject(joins[i], bound) != WAIT_OBJECT_0) abandoned = true;
        CloseHandle(joins[i]);
    }
    *raw = (uint32_t)status;
    if (abandoned) {
        if (*outcome != BYN_WAIT_TIMED_OUT) *outcome = BYN_WAIT_FAILED;
    } else {
        CloseHandle(reads[0]);
        CloseHandle(reads[1]);
        streams[0] = io->drains[0].capture;
        streams[1] = io->drains[1].capture;
        free(io);
    }
    if (job) CloseHandle(job);
    return 0;
}
#endif

#ifndef _WIN32
/* `environ` with each `keys[i]` replacing the variable of that name: set to `vals[i]`, or dropped when `unset[i]` is set,
 * as a NULL-terminated array from malloc; the strings from index `*kept` on are from malloc too. */
static char** byn_env_with(const byn_str* keys, const byn_str* vals, const bool* unset, int64_t n, int64_t* kept) {
    int64_t count = 0;
    while (environ[count]) count++;
    char** envp = (char**)malloc(sizeof(char*) * (size_t)(count + n + 1));
    if (!envp) byn_panic("out of memory", NULL, 0);
    int64_t len = 0;
    for (int64_t e = 0; e < count; e++) {
        const char* eq = strchr(environ[e], '=');
        int64_t nn = eq ? (int64_t)(eq - environ[e]) : (int64_t)strlen(environ[e]);
        bool replaced = false;
        for (int64_t i = 0; i < n && !replaced; i++)
            replaced = keys[i].len == nn && memcmp(keys[i].ptr, environ[e], (size_t)nn) == 0;
        if (!replaced) envp[len++] = environ[e];
    }
    *kept = len;
    for (int64_t i = 0; i < n; i++) {
        if (unset && unset[i]) continue;
        char* kv = (char*)malloc((size_t)(keys[i].len + vals[i].len + 2));
        if (!kv) byn_panic("out of memory", NULL, 0);
        memcpy(kv, keys[i].ptr, (size_t)keys[i].len);
        kv[keys[i].len] = '=';
        memcpy(kv + keys[i].len + 1, vals[i].ptr, (size_t)vals[i].len);
        kv[keys[i].len + vals[i].len + 1] = 0;
        envp[len++] = kv;
    }
    envp[len] = NULL;
    return envp;
}

/* The file `name` runs, found the way `posix_spawnp` finds it from here, so a child that changes directory or gets its own
 * PATH runs the same program: a name with a `/` against our directory, a bare name in our PATH (an empty entry is our
 * directory; without PATH, /usr/bin:/bin). Returns 0 (`*path` set, from malloc) or an errno value. */
static int byn_resolve_program(const char* name, char** path) {
    size_t nlen = strlen(name);
    if (name[0] == '/') {
        char* full = (char*)malloc(nlen + 1);
        if (!full) byn_panic("out of memory", NULL, 0);
        memcpy(full, name, nlen + 1);
        *path = full;
        return 0;
    }
    /* Our directory only when a relative name or PATH entry needs it, so a deleted one fails only those. */
    char* cwd = NULL;
    size_t clen = 0;
    if (strchr(name, '/')) {
        cwd = getcwd(NULL, 0);
        if (!cwd) return errno;
        clen = strlen(cwd);
        char* full = (char*)malloc(clen + nlen + 2);
        if (!full) byn_panic("out of memory", NULL, 0);
        memcpy(full, cwd, clen);
        full[clen] = '/';
        memcpy(full + clen + 1, name, nlen + 1);
        free(cwd);
        *path = full;
        return 0;
    }
    const char* search = getenv("PATH");
    if (!search) search = "/usr/bin:/bin";
    int found = ENOENT;
    for (const char* entry = search;; entry++) {
        const char* end = strchr(entry, ':');
        size_t elen = end ? (size_t)(end - entry) : strlen(entry);
        bool relative = elen == 0 || entry[0] != '/';
        if (relative && !cwd) {
            cwd = getcwd(NULL, 0);
            if (cwd) clen = strlen(cwd);
        }
        if (relative && !cwd) {
            /* execvp skips an entry it cannot resolve; the errno is the result only when no entry finds the program. */
            if (found == ENOENT) found = errno;
            if (!end) break;
            entry = end;
            continue;
        }
        char* full = (char*)malloc(clen + elen + nlen + 3);
        if (!full) byn_panic("out of memory", NULL, 0);
        size_t at = 0;
        if (relative) {
            memcpy(full, cwd, clen);
            full[clen] = '/';
            at = clen + 1;
        }
        memcpy(full + at, entry, elen);
        at += elen;
        full[at++] = '/';
        memcpy(full + at, name, nlen + 1);
        struct stat st;
        if (stat(full, &st) == 0 && !S_ISDIR(st.st_mode)) {
            if (access(full, X_OK) == 0) {
                free(cwd);
                *path = full;
                return 0;
            }
            found = EACCES;
        }
        free(full);
        if (!end) break;
        entry = end;
    }
    free(cwd);
    return found;
}

/* posix_spawn has no portable working-directory action (`addchdir_np` is missing under -std=c11 on macOS and before
 * glibc 2.29), so a child with a directory is forked: the program is resolved here first (byn_resolve_program), then
 * the child moves its streams into place, changes directory and execs the resolved path,
 * reporting a failure before exec through a close-on-exec pipe; with `group` it first starts its own process group.
 * Returns 0 (`*pid` set) or an errno value. */
static int byn_fork_exec(char** argv, char** envp, const char* dir, bool group, int in, int out, int err, pid_t* pid) {
    char* file = NULL;
    int resolved = byn_resolve_program(argv[0], &file);
    if (resolved != 0) return resolved;
    int report[2];
    if (pipe(report) != 0) {
        int e = errno;
        free(file);
        return e;
    }
    fcntl(report[0], F_SETFD, FD_CLOEXEC);
    fcntl(report[1], F_SETFD, FD_CLOEXEC);
    pid_t p = fork();
    if (p < 0) {
        int e = errno;
        close(report[0]);
        close(report[1]);
        free(file);
        return e;
    }
    if (p == 0) {
        if ((!group || setpgid(0, 0) == 0) && (in < 0 || dup2(in, 0) >= 0) && dup2(out, 1) >= 0 && dup2(err, 2) >= 0 && chdir(dir) == 0) {
            environ = envp;
            /* `file` has a `/`, so execvp searches nothing; it still runs a script without `#!` through sh. */
            execvp(file, argv);
        }
        int e = errno;
        ssize_t put = write(report[1], &e, sizeof e);
        (void)put;
        _exit(127);
    }
    close(report[1]);
    free(file);
    int e = 0;
    ssize_t got;
    while ((got = read(report[0], &e, sizeof e)) < 0 && errno == EINTR) {}
    close(report[0]);
    if (got == (ssize_t)sizeof e) {
        int status;
        while (waitpid(p, &status, 0) < 0 && errno == EINTR) {}
        return e;
    }
    *pid = p;
    return 0;
}
#endif

uint32_t byn_io_run(byn_str program, const byn_str* args, int64_t nargs, byn_process* out, int64_t* detail, byn_alloc* alloc) {
    return byn_io_run_with(program, args, nargs, NULL, NULL, -1, NULL, NULL, NULL, 0, -1, out, detail, alloc);
}

uint32_t byn_io_run_with(byn_str program, const byn_str* args, int64_t nargs, const byn_str* directory, const uint8_t* input,
                         int64_t ninput, const byn_str* env_keys, const byn_str* env_vals, const bool* env_unset, int64_t nenv,
                         int64_t timeout_ms, byn_process* out, int64_t* detail, byn_alloc* alloc) {
    if (program.len == 0 || memchr(program.ptr, 0, (size_t)program.len)) return BYN_IO_NOT_FOUND;
    for (int64_t i = 0; i < nargs; i++)
        if (memchr(args[i].ptr, 0, (size_t)args[i].len)) return BYN_IO_OTHER;
    /* A directory or variable that cannot be passed exactly starts nothing. */
    if (directory && memchr(directory->ptr, 0, (size_t)directory->len)) return BYN_IO_INVALID_INPUT;
    for (int64_t i = 0; env_keys && i < nenv; i++) {
        bool set = !(env_unset && env_unset[i]);
        if (env_keys[i].len == 0 || memchr(env_keys[i].ptr, '=', (size_t)env_keys[i].len) || memchr(env_keys[i].ptr, 0, (size_t)env_keys[i].len)
            || (set && memchr(env_vals[i].ptr, 0, (size_t)env_vals[i].len)))
            return BYN_IO_INVALID_INPUT;
    }
    int64_t keep = timeout_ms >= 0 ? BYN_RUN_KEEP : -1;
    byn_capture streams[2] = {{{NULL, 0, 0}, NULL, 0, 0, 0, keep}, {{NULL, 0, 0}, NULL, 0, 0, 0, keep}};
    int outcome = BYN_WAIT_DONE;
    uint32_t raw = 0;
#ifdef _WIN32
    wchar_t* wdir = NULL;
    if (directory) {
        wdir = byn_wide(directory->ptr, directory->len);
        DWORD attrs = GetFileAttributesW(wdir);
        uint32_t bad = attrs == INVALID_FILE_ATTRIBUTES ? byn_win_error(GetLastError())
            : !(attrs & FILE_ATTRIBUTE_DIRECTORY) ? BYN_IO_NOT_A_DIRECTORY : 0;
        if (bad != 0) {
            free(wdir);
            return bad;
        }
    }
    wchar_t* app = byn_find_program(program);
    /* CreateProcessW runs a batch file through cmd.exe, which re-parses the arguments (BatBadBut). */
    if (!app || byn_is_batch(app, wcslen(app))) {
        free(wdir);
        free(app);
        return app ? BYN_IO_PERMISSION_DENIED : BYN_IO_NOT_FOUND;
    }
    byn_bytes line = {NULL, 0, 0};
    byn_quote_arg(&line, program);
    for (int64_t i = 0; i < nargs; i++) byn_quote_arg(&line, args[i]);
    wchar_t* wline = byn_wide(line.ptr, line.len);
    free(line.ptr);
    wchar_t* env = env_keys ? byn_env_block(env_keys, env_vals, env_unset, nenv) : NULL;
    uint32_t err = byn_win_spawn(app, wline, wdir, env, input, ninput, timeout_ms, streams, &outcome, &raw);
    free(wdir);
    free(env);
    if (err != 0) return err;
#else
    char* dir = NULL;
    if (directory) {
        dir = byn_cstr(*directory);
        struct stat st;
        uint32_t bad = stat(dir, &st) != 0 ? byn_io_error(errno) : !S_ISDIR(st.st_mode) ? BYN_IO_NOT_A_DIRECTORY : 0;
        if (bad != 0) {
            free(dir);
            return bad;
        }
    }
    char** argv = (char**)malloc(sizeof(char*) * (size_t)(nargs + 2));
    if (!argv) byn_panic("out of memory", NULL, 0);
    argv[0] = byn_cstr(program);
    for (int64_t i = 0; i < nargs; i++) argv[i + 1] = byn_cstr(args[i]);
    argv[nargs + 1] = NULL;
    int64_t kept = 0;
    char** envp = env_keys ? byn_env_with(env_keys, env_vals, env_unset, nenv, &kept) : environ;
    /* stdout, stderr, and with `input` stdin; [i][0] reads, [i][1] writes. */
    int npipes = ninput >= 0 ? 3 : 2;
    int pipes[3][2];
    uint32_t err = 0;
    int made = 0;
    for (; made < npipes; made++)
        if (pipe(pipes[made]) != 0) {
            err = byn_io_error(errno);
            break;
        }
    if (err != 0)
        for (int i = 0; i < made; i++) {
            close(pipes[i][0]);
            close(pipes[i][1]);
        }
    pid_t pid = 0;
    if (err == 0) {
        for (int i = 0; i < npipes; i++) {
            fcntl(pipes[i][0], F_SETFD, FD_CLOEXEC);
            fcntl(pipes[i][1], F_SETFD, FD_CLOEXEC);
        }
        int in = npipes == 3 ? pipes[2][0] : -1;
        /* With a timeout the child leads its own process group, so the kill reaches its children too; without one it
         * stays in ours, where it keeps terminal job control (a new group reading a shared terminal would get SIGTTIN). */
        bool group = timeout_ms >= 0;
        int rc;
        if (dir) rc = byn_fork_exec(argv, envp, dir, group, in, pipes[0][1], pipes[1][1], &pid);
        else {
            posix_spawn_file_actions_t actions;
            posix_spawn_file_actions_init(&actions);
            if (in >= 0) posix_spawn_file_actions_adddup2(&actions, in, 0);
            posix_spawn_file_actions_adddup2(&actions, pipes[0][1], 1);
            posix_spawn_file_actions_adddup2(&actions, pipes[1][1], 2);
            posix_spawnattr_t attr;
            rc = group ? posix_spawnattr_init(&attr) : 0;
            if (group && rc == 0) {
                rc = posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETPGROUP);
                if (rc == 0) rc = posix_spawnattr_setpgroup(&attr, 0);
                if (rc == 0) rc = posix_spawnp(&pid, argv[0], &actions, &attr, argv, envp);
                int destroyed = posix_spawnattr_destroy(&attr);
                /* A started child must still be waited for, so a failed destroy is an error only when nothing started. */
                if (destroyed != 0 && rc == 0 && pid == 0) rc = destroyed;
            } else if (rc == 0) rc = posix_spawnp(&pid, argv[0], &actions, NULL, argv, envp);
            posix_spawn_file_actions_destroy(&actions);
        }
        close(pipes[0][1]);
        close(pipes[1][1]);
        if (in >= 0) close(in);
        if (rc != 0) {
            err = byn_io_error(rc);
            close(pipes[0][0]);
            close(pipes[1][0]);
            if (npipes == 3) close(pipes[2][1]);
        }
    }
    for (int64_t i = 0; i <= nargs; i++) free(argv[i]);
    free(argv);
    if (envp != environ) {
        for (int64_t i = kept; envp[i]; i++) free(envp[i]);
        free(envp);
    }
    free(dir);
    if (err != 0) return err;
    /* Drain both pipes and feed stdin together, so a child that fills one while we block on another cannot deadlock.
     * A child that exits without reading all its input must not kill us with SIGPIPE: the write fails instead. */
    struct pollfd fds[3] = {{pipes[0][0], POLLIN, 0}, {pipes[1][0], POLLIN, 0}, {-1, POLLOUT, 0}};
    struct sigaction ignore;
    struct sigaction previous;
    int64_t sent = 0;
    if (npipes == 3) {
        if (ninput == 0) close(pipes[2][1]);
        else {
            fds[2].fd = pipes[2][1];
            fcntl(fds[2].fd, F_SETFL, fcntl(fds[2].fd, F_GETFL) | O_NONBLOCK);
            memset(&ignore, 0, sizeof ignore);
            ignore.sa_handler = SIG_IGN;
            sigemptyset(&ignore.sa_mask);
            sigaction(SIGPIPE, &ignore, &previous);
        }
    }
    /* With a timeout, each expiry of the deadline moves one stage on (byn_run_expire); after the last we stop draining,
     * so a process that escaped the group cannot hold us. */
    int stage = 0;
    int64_t deadline = 0;
    if (timeout_ms >= 0) {
        /* Saturated: a timeout too long to count in nanoseconds never passes. */
        int64_t now = byn_io_monotonic_nanos();
        deadline = timeout_ms > (INT64_MAX - now) / 1000000 ? INT64_MAX : now + timeout_ms * 1000000;
    }
    int open = 2;
    while (open > 0 || fds[2].fd >= 0) {
        int wait = -1;
        if (timeout_ms >= 0) {
            int64_t left = deadline - byn_io_monotonic_nanos();
            int64_t ms = left <= 0 ? 0 : (left - 1) / 1000000 + 1;
            wait = ms > INT_MAX ? INT_MAX : (int)ms;
        }
        int ready = wait == 0 ? 0 : poll(fds, 3, wait);
        if (ready < 0) {
            if (errno == EINTR) continue;
            break;
        }
        if (ready == 0) {
            if (stage == 2) break;
            deadline = byn_run_expire(pid, &stage, byn_io_monotonic_nanos());
            continue;
        }
        for (int i = 0; i < 2; i++) {
            if (fds[i].fd < 0 || !(fds[i].revents & (POLLIN | POLLHUP | POLLERR))) continue;
            uint8_t buffer[4096];
            ssize_t got = read(fds[i].fd, buffer, sizeof buffer);
            if (got > 0) byn_capture_add(&streams[i], buffer, got);
            else if (got == 0 || errno != EINTR) {
                close(fds[i].fd);
                fds[i].fd = -1;
                open--;
            }
        }
        if (fds[2].fd >= 0 && (fds[2].revents & (POLLOUT | POLLHUP | POLLERR))) {
            int64_t want = ninput - sent > 65536 ? 65536 : ninput - sent;
            ssize_t put = write(fds[2].fd, input + sent, (size_t)want);
            if (put > 0) sent += put;
            if (sent == ninput || (put < 0 && errno != EINTR && errno != EAGAIN)) {
                close(fds[2].fd);
                fds[2].fd = -1;
            }
        }
    }
    for (int i = 0; i < 3; i++)
        if (fds[i].fd >= 0) close(fds[i].fd);
    if (npipes == 3 && ninput > 0) sigaction(SIGPIPE, &previous, NULL);
    /* A child can close both streams and run on, so with a timeout the reap keeps the same deadline: poll for its exit
     * every few milliseconds, expiring as above; once the last deadline passes the child is left unreaped (it could not
     * be killed) and the call is still `timeout`. Without a timeout a blocking wait reaps it. */
    int status = 0;
    while (timeout_ms >= 0) {
        pid_t done = waitpid(pid, &status, WNOHANG);
        if (done == pid) break;
        if (done < 0 && errno != EINTR) {
            outcome = BYN_WAIT_FAILED;
            break;
        }
        int64_t now = byn_io_monotonic_nanos();
        if (now >= deadline) {
            if (stage == 2) break;
            deadline = byn_run_expire(pid, &stage, now);
            continue;
        }
        int64_t ms = (deadline - now - 1) / 1000000 + 1;
        /* A sleep: no descriptors, so it returns 0 when the time is up or -1 (EINTR) earlier, and either way we look again. */
        (void)poll(NULL, 0, ms > 10 ? 10 : (int)ms);
    }
    if (stage > 0 && outcome != BYN_WAIT_FAILED) outcome = BYN_WAIT_TIMED_OUT;
    while (timeout_ms < 0 && waitpid(pid, &status, 0) < 0) {
        if (errno != EINTR) {
            outcome = BYN_WAIT_FAILED;
            break;
        }
    }
    raw = (uint32_t)status;
#endif
    return byn_process_finish(streams, outcome, raw, out, detail, alloc);
}

uint32_t byn_io_run_batch(byn_str path, const byn_str* args, int64_t nargs, byn_process* out, byn_alloc* alloc) {
#ifdef _WIN32
    byn_str line;
    if (!byn_batch_cmdline(path, args, nargs, &line)) return BYN_IO_INVALID_INPUT;
    /* cmd.exe from the system directory: neither PATH nor %ComSpec% can redirect it. */
    wchar_t sys[MAX_PATH];
    UINT sn = GetSystemDirectoryW(sys, MAX_PATH);
    if (sn == 0 || sn >= MAX_PATH - 9) {
        free((void*)line.ptr);
        return byn_win_error(GetLastError());
    }
    wchar_t* app = (wchar_t*)malloc(sizeof(wchar_t) * (sn + 9));
    if (!app) byn_panic("out of memory", NULL, 0);
    memcpy(app, sys, sizeof(wchar_t) * sn);
    wcscpy(app + sn, L"\\cmd.exe");
    wchar_t* wline = byn_wide(line.ptr, line.len);
    free((void*)line.ptr);
    byn_capture streams[2] = {{{NULL, 0, 0}, NULL, 0, 0, 0, -1}, {{NULL, 0, 0}, NULL, 0, 0, 0, -1}};
    int outcome;
    uint32_t raw;
    uint32_t err = byn_win_spawn(app, wline, NULL, NULL, NULL, -1, -1, streams, &outcome, &raw);
    if (err != 0) return err;
    return byn_process_finish(streams, outcome, raw, out, NULL, alloc);
#else
    (void)path, (void)args, (void)nargs, (void)out, (void)alloc;
    return BYN_IO_UNSUPPORTED;
#endif
}

void byn_io_write(int32_t fd, byn_str s) {
    if (fd == 1) {
        byn_out(s.ptr, s.len);
        return;
    }
    byn_stdout_flush();
    fwrite(s.ptr, 1, (size_t)s.len, stderr);
    fflush(stderr);
}

int64_t byn_io_monotonic_nanos(void) {
#ifdef _WIN32
    LARGE_INTEGER count;
    LARGE_INTEGER freq;
    QueryPerformanceCounter(&count);
    QueryPerformanceFrequency(&freq);
    int64_t c = count.QuadPart;
    int64_t f = freq.QuadPart;
    return c / f * 1000000000 + c % f * 1000000000 / f;
#else
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
#endif
}

byn_time byn_time_now(void) {
#ifdef _WIN32
    FILETIME ft;
    GetSystemTimePreciseAsFileTime(&ft);
    int64_t ticks = (int64_t)(((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime);
    return (byn_time){(ticks - BYN_FILETIME_EPOCH) * 100};
#else
    struct timespec ts;
    if (clock_gettime(CLOCK_REALTIME, &ts) != 0) byn_panic("the wall clock cannot be read", NULL, 0);
    return (byn_time){(int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec};
#endif
}
"""
== driver/scaffold.byn
// bayan: `bayan new` and `bayan init` (Scaffold.cs:18-322, spec 017 T4): an app, library or script that builds and passes its tests with
// no edits. Git use is `git init` only, and only outside an existing work tree.
//
// The C# `Files` table interpolates raw strings; Bayan raw strings do not interpolate, so each template is a constant with `{kebab}`,
// `{module}`, `{kind}` or `{command}` placeholders that `scaffoldFiles` replaces.

import lexer
import semantics

enum ScaffoldLayout {
    app
    lib
    script
}

/// Scaffold.cs:16 `Options`.
struct ScaffoldOptions {
    string?        target
    ScaffoldLayout layout
    bool           git
    bool           ciGithub
}

/// Scaffold.cs:109 `ProjectNames`: the package name in kebab-case and the library's module name in camelCase.
struct ScaffoldNames {
    string kebab
    string module
}

const scaffoldScript: string = """
    #!/usr/bin/env bayan
    #:io threaded

    print("Salam, world!")

    """

const scaffoldPackage: string = """
    Package {
        name: "local/{kebab}",      // `local/` until published under a verified namespace
        version: "0.1.0",
        edition: 2027,
        kind: .{kind},
        capabilities: [],
        deps: [],
        dist: Dist {
            targets: [.host],        // the machine that builds it
            mode: .safe,
        },
    }

    """

const scaffoldReadmeLib: string = """
    # {kebab}

    A Bayan library. Its code is in `src/{module}/`; other packages use it with `import {module}`.

    ## Test

    ```
    bayan test
    ```

    """

const scaffoldReadmeApp: string = """
    # {kebab}

    A Bayan app. Its code is in `src/app/`.

    ## Run

    ```
    bayan run
    ```

    ## Test

    ```
    bayan test
    ```

    """

const scaffoldEditorconfig: string = """
    root = true

    [*]
    charset = utf-8
    end_of_line = lf
    indent_style = space
    indent_size = 4
    insert_final_newline = true
    trim_trailing_whitespace = true

    """

const scaffoldLibSource: string = """
    /// Returns twice `x`.
    public i64 twice(i64 x) {
        return x * 2
    }

    """

const scaffoldLibTest: string = """
    test "twice doubles" {
        assert(twice(21) == 42)
    }

    """

const scaffoldAppSource: string = """
    /// The line this app prints.
    string greeting() {
        return "Salam, world!"
    }

    print(greeting())

    """

const scaffoldAppTest: string = """
    test "greets the world" {
        assert(greeting() == "Salam, world!")
    }

    """

const scaffoldCi: string = """
    name: bayan

    on: [push, pull_request]

    jobs:
      build:
        runs-on: ubuntu-latest
        steps:
          - uses: actions/checkout@v5
          # Install zig and bayan here; neither has an official setup action yet.
          - run: bayan {command}
          - run: bayan test

    """

/// Scaffold.cs:18 `New`.
i32 scaffoldNew(ReadOnlySpan<string> args) uses alloc, console, env, fs, process {
    let o = scaffoldParseOptions(args, for: "new") ?? return exitUsage
    if o.target is null {
        Io.stderr.write("bayan: expected a name, e.g. `bayan new tally`\n")
        return exitUsage
    }
    let target = o.target ?? ""
    let full = scaffoldTrimEnd(Path.fullPath(target))
    let dirName = Path.fileName(full)
    let names = scaffoldNames(dirName, for: o.layout) ?? return exitUsage
    if o.layout == .script {
        let file = Path.combine(Path.directoryName(full) ?? "", $"{names.kebab}.byn")
        let shown = Path.isRooted(target) ? file : Path.relative(Path.fullPath("."), to: file)
        if Fs.fileExists(file) {
            Io.stderr.write($"bayan: `{shown}` already exists\n")
            return exitUsage
        }
        scaffoldWrite(scaffoldFiles(names, for: o), to: Path.directoryName(file) ?? "", for: false)
        Io.stdout.write($"created script `{shown}`; run it with `bayan {shown}`\n")
        return exitOk
    }
    if t5DirectoryExists(full) && scaffoldEntryCount(full) > 0 {
        Io.stderr.write($"bayan: `{target}` already exists and isn't empty\n")
        Io.stderr.write("  help: run `bayan init` inside it to add only the missing files\n")
        return exitUsage
    }
    // coverage-exempt: Q1086 the catch is reached only if `full` cannot be made after the checks above; the C# `Directory.CreateDirectory` throws there
    Io.createDirectory(full) catch { panic($"cannot create the directory {full}") }
    scaffoldWrite(scaffoldFiles(names, for: o), to: full, for: false)
    Io.stdout.write($"created {o.layout == .lib ? "library" : "app"} `local/{names.kebab}` in `{target}`\n")
    scaffoldInitGit(full, for: o)
    Io.stdout.write("\n")
    Io.stdout.write($"  cd {target}\n")
    if o.layout == .app {
        Io.stdout.write("  bayan run\n")
    }
    Io.stdout.write("  bayan test\n")
    return exitOk
}

/// Scaffold.cs:59 `Init`.
i32 scaffoldInit(ReadOnlySpan<string> args) uses alloc, console, env, fs, process {
    let o = scaffoldParseOptions(args, for: "init") ?? return exitUsage
    let dir = scaffoldTrimEnd(Path.fullPath(o.target ?? "."))
    unless t5DirectoryExists(dir) {
        Io.stderr.write($"bayan: `{o.target ?? ""}` doesn't exist; `bayan new {o.target ?? ""}` creates it\n")
        return exitUsage
    }
    if Fs.fileExists(Path.combine(dir, "package.byn")) {
        Io.stderr.write("bayan: this directory already has a `package.byn`\n")
        return exitUsage
    }
    let names = scaffoldNames(Path.fileName(dir), for: o.layout) ?? return exitUsage
    scaffoldWrite(scaffoldFiles(names, for: o), to: dir, for: true)
    if o.layout != .script {
        scaffoldInitGit(dir, for: o)
    }
    return exitOk
}

/// `TrimEnd(Path.DirectorySeparatorChar)`: `\` on Windows, `/` elsewhere.
string scaffoldTrimEnd(string path) {
    // coverage-exempt: Q1086 the Windows branch runs only on a Windows host
    let separator = Target.os == "windows" ? "\\" : "/"
    var end = path.length
    while end > 0 && path[end - 1..end] == separator {
        end -= 1
    }
    return path[0..end]
}

/// `Directory.EnumerateFileSystemEntries(full).Any()` counts the entries of `full`, a directory (`t5DirectoryExists`), so the listing succeeds.
i64 scaffoldEntryCount(string full) uses alloc, fs {
    // coverage-exempt: Q1086 the catch is reached only if the directory vanishes after `t5DirectoryExists`; the C# would throw
    let names = Io.listDir(full) catch { panic($"cannot list {full}") }
    return names.length
}

/// Scaffold.cs:79 `ParseOptions`: null after reporting.
ScaffoldOptions? scaffoldParseOptions(ReadOnlySpan<string> args, for string command) uses alloc, console {
    var target: string? = null
    var layout = ScaffoldLayout.app
    var git = true
    var ci = false
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--lib" {
            layout = .lib
        } else if a == "--script" {
            layout = .script
        } else if a == "--vcs" && i + 1 < args.length && (args[i + 1] == "git" || args[i + 1] == "none") {
            i += 1
            git = args[i] == "git"
        } else if a == "--ci" && i + 1 < args.length && (args[i + 1] == "github" || args[i + 1] == "none") {
            i += 1
            ci = args[i] == "github"
        } else if a.startsWith("-") || target is not null {
            Io.stderr.write($"bayan: unexpected argument `{a}`\n")
            Io.stderr.write(
                $"usage: bayan {command} {command == "new" ? "<name>" : "[<dir>]"} [--lib|--script] [--vcs git|none] [--ci github|none]\n",
            )
            return null
        } else {
            target = a
        }
        i += 1
    }
    return ScaffoldOptions { target: target, layout: layout, git: git, ciGithub: ci }
}

/// Scaffold.cs:115 `Names`: a directory name may be kebab-case (`my-app`) or camelCase (`myApp`); the package name is its kebab-case
/// form and a library's module its camelCase form. Null after reporting.
ScaffoldNames? scaffoldNames(string dirName, for ScaffoldLayout layout) uses alloc, console {
    let t = dirName.bytes
    var camel = t.length > 0 && t[0] >= 0x61 && t[0] <= 0x7A
    for b in t {
        if !(b is 0x61..=0x7A or 0x41..=0x5A or 0x30..=0x39) {
            camel = false
        }
    }
    let kebab = camel ? semantics.kebabOf(dirName) : dirName
    unless semantics.t10IsKebabName(kebab.bytes) {
        Io.stderr.write($"bayan: `{dirName}` can't be a package name\n")
        Io.stderr.write(
            "  help: use lowercase words joined by `-` (`my-app`) or camelCase (`myApp`); start with a letter\n",
        )
        return null
    }
    let module = semantics.camelOf(kebab)
    if layout == .lib && lexer.Keywords.build().lookup(module.bytes) != lexer.TokenKind.identifier {
        Io.stderr.write($"bayan: `{module}` is a keyword, so `import {module}` couldn't name the library\n")
        Io.stderr.write($"  help: pick another name, e.g. `{kebab}-lib`\n")
        return null
    }
    return ScaffoldNames { kebab: kebab, module: module }
}

/// Scaffold.cs:136 `Write`: writes every file that doesn't exist yet, in ordinal path order; with `listing`, says what it did.
void scaffoldWrite(Map<string, string> files, to string root, for bool listing) uses alloc, console, fs, process {
    var paths = List<string>()
    for (relative, contents) in files {
        paths.append(relative)
    }
    paths.sort()
    for relative in paths {
        let contents = files[relative]
        let path = Path.combine(root, relative)
        if Fs.fileExists(path) {
            // coverage-exempt: Q1086 `Write` skips an existing file without listing only when `stdout` is null, and `New` writes into an empty directory or a new script path
            if listing {
                Io.stdout.write($"skipped {relative} (already exists)\n")
            }
            continue
        }
        // coverage-exempt: Q1086 the catch is reached only if a parent directory cannot be made; the C# `Directory.CreateDirectory` throws there
        Io.createDirectory(Path.directoryName(path) ?? "") catch { panic($"cannot create the directory of {path}") }
        // coverage-exempt: Q1086 the catch is reached only if the file cannot be written; the C# `File.WriteAllText` throws there
        Io.writeFile(path, contents.bytes) catch { panic($"cannot write {path}") }
        // `Io.writeFile` has no executable bit and no chmod builtin: `chmod a+x` adds it as `File.SetUnixFileMode` does; with no `chmod` on `PATH` it panics (Q1089).
        // coverage-exempt: Q1086 the Windows branch runs only on a Windows host (`OperatingSystem.IsWindows()`)
        if contents.startsWith("#!") && Target.os != "windows" {
            var chmod = List<string>()
            chmod.append("a+x")
            chmod.append(path)
            let _ = Io.run("chmod", chmod.span) catch { panic($"cannot make {path} executable") }
        }
        if listing {
            Io.stdout.write($"created {relative}\n")
        }
    }
}

/// Scaffold.cs:154 `InitGit`.
void scaffoldInitGit(string dir, for ScaffoldOptions o) uses alloc, console, env, fs, process {
    unless o.git {
        return
    }
    let found = ccFindOnPath("git", for: Target.os)
    if found is null {
        Io.stdout.write("note: git isn't installed, so no repository was created\n")
        return
    }
    let git = found
    let inside = scaffoldGit(git, at: dir, for: "rev-parse", through: "--is-inside-work-tree")
    if inside.code == 0 && inside.stdout == "true" {
        Io.stdout.write("note: already inside a git repository, so no new one was created\n")
        return
    }
    let init = scaffoldGit(git, at: dir, for: "init", through: "--quiet")
    if init.code == 0 {
        Io.stdout.write("initialized a git repository (nothing committed)\n")
    } else {
        Io.stdout.write("note: `git init` failed, so no repository was created\n")
    }
}

struct ScaffoldGitResult {
    i32    code
    string stdout
}

/// Scaffold.cs:171 `Git`: `Io.run` has no working directory (Q1009), so `git -C <dir>` stands for `WorkingDirectory = dir`; stdout trimmed.
ScaffoldGitResult scaffoldGit(string git, at string dir, for string first, through string second) uses alloc, process {
    var args = List<string>()
    args.append("-C")
    args.append(dir)
    args.append(first)
    args.append(second)
    // A git killed by signal n is exit 128+n to the C# `Process.ExitCode` (Scaffold.cs:186), its stdout trimmed.
    let r = Io.run(git, args.span) catch switch {
        .signaled(let s, let output, let errors) => return ScaffoldGitResult {
            code: 128 + s,
            stdout: output.trimmed(),
        },
        // coverage-exempt: Q1086 reached only if the `git` that was just found cannot start; the C# `Process.Start` throws there
        IoError e => panic($"cannot run {git}"),
    }
    return ScaffoldGitResult { code: r.exitCode, stdout: r.stdout.trimmed() }
}

/// Scaffold.cs:191 `Files`: path to contents; `scaffoldWrite` sorts the paths.
Map<string, string> scaffoldFiles(ScaffoldNames n, for ScaffoldOptions o) uses alloc {
    var files: Map<string, string> = []
    if o.layout == .script {
        files[$"{n.kebab}.byn"] = scaffoldScript
        return files
    }
    let lib = o.layout == .lib
    files["package.byn"] = scaffoldPackage.replaced("{kebab}", by: n.kebab).replaced("{kind}", by: lib ? "lib" : "app")
    files["README.md"] = (lib
        ? scaffoldReadmeLib
        : scaffoldReadmeApp).replaced("{kebab}", by: n.kebab).replaced("{module}", by: n.module)
    files[".gitignore"] = "/out/\n/dist/\n/gen/\n"
    files[".gitattributes"] = "* text=auto eol=lf\n*.byn linguist-language=C#\n"
    files[".editorconfig"] = scaffoldEditorconfig
    if lib {
        files[$"src/{n.module}/{n.module}.byn"] = scaffoldLibSource
        files[$"tests/{n.module}.test.byn"] = scaffoldLibTest
    } else {
        files["src/app/main.byn"] = scaffoldAppSource
        files["tests/app.test.byn"] = scaffoldAppTest
    }
    files["testdata/.gitkeep"] = ""
    files["docs/.gitkeep"] = ""
    if o.ciGithub {
        files[".github/workflows/bayan.yml"] = scaffoldCi.replaced("{command}", by: lib ? "check" : "build")
    }
    return files
}
== driver/sha256.byn
// SHA-256 (FIPS 180-4) over bytes for the self-hosted driver (spec 017 T9, plan D5): what `SHA256.HashData` returns, for the
// cache keys of `Toolchain.cs` :296, :624, :681-687 and `dist`'s inputs hash. Words are kept in `u64` below 2^32, so the
// additions mod 2^32 are a mask, not a wrap a `safe` build would trap on.

/// The round constants of FIPS 180-4 §4.2.2.
List<u64> t9RoundConstants() uses alloc {
    let k: List<u64> = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
    return k
}

/// A 32-bit word rotated right by `n`.
u64 t9Rotr(u64 x, by u64 n) => ((x >> n) | (x << (32 - n))) & 0xffffffff

/// One 64-byte block of `data` from `at` into the state `h` (FIPS 180-4 §6.2.2).
void t9Block(ref List<u64> h, from ReadOnlySpan<u8> data, at i64 start, by in List<u64> k, through ref List<u64> w) {
    for t in 0..16 {
        let i = start + t * 4
        w[t] = (u64(data[i]) << 24) | (u64(data[i + 1]) << 16) | (u64(data[i + 2]) << 8) | u64(data[i + 3])
    }
    for t in 16..64 {
        let s0 = t9Rotr(w[t - 15], by: 7) ^ t9Rotr(w[t - 15], by: 18) ^ (w[t - 15] >> 3)
        let s1 = t9Rotr(w[t - 2], by: 17) ^ t9Rotr(w[t - 2], by: 19) ^ (w[t - 2] >> 10)
        w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xffffffff
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..64 {
        let s1 = t9Rotr(e, by: 6) ^ t9Rotr(e, by: 11) ^ t9Rotr(e, by: 25)
        let ch = (e & f) ^ (~e & 0xffffffff & g)
        let t1 = (hh + s1 + ch + k[t] + w[t]) & 0xffffffff
        let s0 = t9Rotr(a, by: 2) ^ t9Rotr(a, by: 13) ^ t9Rotr(a, by: 22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = (s0 + maj) & 0xffffffff
        hh = g
        g = f
        f = e
        e = (d + t1) & 0xffffffff
        d = c
        c = b
        b = a
        a = (t1 + t2) & 0xffffffff
    }
    h[0] = (h[0] + a) & 0xffffffff
    h[1] = (h[1] + b) & 0xffffffff
    h[2] = (h[2] + c) & 0xffffffff
    h[3] = (h[3] + d) & 0xffffffff
    h[4] = (h[4] + e) & 0xffffffff
    h[5] = (h[5] + f) & 0xffffffff
    h[6] = (h[6] + g) & 0xffffffff
    h[7] = (h[7] + hh) & 0xffffffff
}

/// `SHA256.HashData(data)`: the 32-byte digest.
List<u8> sha256(ReadOnlySpan<u8> data) uses alloc {
    let k = t9RoundConstants()
    var h: List<u64> = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    var w = List<u64>()
    for _ in 0..64 {
        w.append(0)
    }
    let whole = data.length / 64 * 64
    var start: i64 = 0
    while start < whole {
        t9Block(ref h, from: data, at: start, by: in k, through: ref w)
        start += 64
    }
    // The tail, the `0x80` byte, zeros to 56 mod 64, then the bit length big-endian (§5.1.1).
    var tail = List<u8>()
    for i in whole..data.length {
        tail.append(data[i])
    }
    tail.append(0x80)
    while tail.length % 64 != 56 {
        tail.append(0)
    }
    let bits = u64(data.length) * 8
    for i in 0..8 {
        tail.append(u8((bits >> u64(56 - i * 8)) & 0xff))
    }
    start = 0
    while start < tail.length {
        t9Block(ref h, from: tail.span, at: start, by: in k, through: ref w)
        start += 64
    }
    var digest = List<u8>()
    for v in h {
        digest.append(u8((v >> 24) & 0xff))
        digest.append(u8((v >> 16) & 0xff))
        digest.append(u8((v >> 8) & 0xff))
        digest.append(u8(v & 0xff))
    }
    return digest
}
== driver/test.byn
// The command `test` of the self-hosted driver (spec 017 T11). Ports `CliApp.cs` :168 `ParseBuildOptions` (all its arms), :627
// `DeleteWorkDir`, :634 `TestTimeout`, :639 `Test`, :790 `MergeCounters`, :812 `WriteCoverage`, :846 `ListingName`, :994
// `FailureDetail`, :1029 `ChangedModules`, :1061 `ModuleOf`, :1069 `ModuleDirectory` and
// :1077 `RunTest` (`Io.run` with `timeout:` keeps a stream as `BoundedCapture.cs` does) and `CoverageInstrumenter.cs` :60 `DeleteStale` and
// :72 `Read`. The report and its JSON are testreport.byn; the coverage report and gates are quality.byn.

import semantics
import emitter
import emitter.cprint

type T11CoverageMap = emitter.CoverageMap
type T11LCtx        = emitter.LCtx

/// `BuildOptions` (CliApp.cs:166) with every field `test` reads; `only` is null when no `--only` was given.
struct T11Options {
    string        path
    string        mode        = "safe"
    string?       output      = null
    bool          emitC       = false
    bool          json        = false
    List<string>  programArgs = []
    string?       target      = null
    bool          testJson    = false
    bool          changed     = false
    string?       baseRef     = null
    bool          verbose     = false
    bool          all         = false
    List<string>? only        = null
    bool          mutate      = false
    bool          coverage    = false
    string?       run         = null
    string?       package     = null
}

/// CliApp.cs:168 `ParseBuildOptions` as `Test` calls it (CliApp.cs:641: `allowOutput: false, allowTestJson: true, allowVerbose:
/// true`), so `-o`, `--emit-c` and `--target` are unexpected arguments here. Null after reporting.
T11Options? t11ParseBuildOptions(in List<string> args) uses alloc, console, fs {
    var path: string? = null
    var mode = "safe"
    var json = false
    var testJson = false
    var changed = false
    var all = false
    var verbose = false
    var mutate = false
    var coverage = false
    var baseRef: string? = null
    var run: string? = null
    var package: string? = null
    var only = List<string>()
    var programArgs = List<string>()
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--" {
            for k in (i + 1)..args.length {
                programArgs.append(args[k])
            }
            i = args.length
        } else if a == "--mode" && i + 1 < args.length {
            i += 1
            mode = args[i]
            if mode != "debug" && mode != "safe" && mode != "fast" {
                Io.stderr.write($"bayan: unknown mode `{args[i]}` (expected debug, safe or fast)\n")
                return null
            }
        } else if a == "--diagnostics" && i + 1 < args.length {
            i += 1
            if args[i] == "json" {
                json = true
            } else if args[i] == "text" {
                json = false
            } else {
                Io.stderr.write($"bayan: unknown diagnostics format `{args[i]}` (expected json or text)\n")
                return null
            }
        } else if a == "--all" {
            all = true
        } else if a == "--changed" {
            changed = true
        } else if a == "--base" && i + 1 < args.length {
            i += 1
            baseRef = args[i]
            changed = true
        } else if a == "--json" {
            testJson = true
        } else if a == "--mutate" {
            mutate = true
        } else if a == "--run" && i + 1 < args.length {
            i += 1
            run = args[i]
        } else if a == "--coverage" {
            coverage = true
        } else if a == "--only" && i + 1 < args.length {
            i += 1
            only.append(args[i])
        } else if a is "-v" or "--verbose" {
            verbose = true
        } else if a == "--package" && i + 1 < args.length {
            i += 1
            package = args[i]
        } else {
            if path is not null || a.startsWith("-") {
                Io.stderr.write($"bayan: unexpected argument `{a}`\n")
                return null
            }
            path = a
        }
        i += 1
    }
    if path is null && t1FileExists("package.byn") {
        path = "."
    }
    if (path is not { } p) {
        Io.stderr.write("bayan: expected a file or directory (or run inside a project with a `package.byn`)\n")
        return null
    }
    if !t1FileExists(p) && !t5DirectoryExists(p) {
        Io.stderr.write($"bayan: not found: {p}\n")
        return null
    }
    var wanted: List<string>? = null
    if only.length > 0 {
        wanted = move only
    }
    return T11Options {
        path: p,
        mode: mode,
        json: json,
        programArgs: move programArgs,
        testJson: testJson,
        changed: changed,
        baseRef: baseRef,
        verbose: verbose,
        all: all,
        only: move wanted,
        mutate: mutate,
        coverage: coverage,
        run: run,
        package: package,
    }
}

/// The `BuildOptions` build.byn `t5Compile` reads.
T5Options t11T5(in T11Options o) uses alloc =>
    T5Options {
        path: o.path,
        mode: o.mode,
        output: o.output,
        emitC: o.emitC,
        json: o.json,
        target: o.target,
        verbose: o.verbose,
        all: o.all,
        package: o.package,
    }

/// CliApp.cs:627 `DeleteWorkDir`: errors are ignored.
void deleteWorkDir(string dir) uses alloc, fs {
    // coverage-exempt: Q1219 an IO failure the C# ignores
    t9DeleteTree(dir) catch return
}

/// CliApp.cs:634 `TestTimeout`: `$BAYAN_TEST_TIMEOUT_MS` when it is a positive `int`, else 60 s; milliseconds.
i64 testTimeout() uses alloc, env {
    let ms = t9Digits(Env.get("BAYAN_TEST_TIMEOUT_MS") ?? "", until: 2147483647) ?? 0
    return ms > 0 ? ms : 60000
}

/// `Paint` (CliApp.cs:385) with the stdout style: `role` is a `t7Prefix` role, `bold` puts `Palette.Bold` before it. build.byn
/// `t5Paint` has neither the warning role nor bold (Q1217).
string t11Paint(i64 role, by in DStyle style, for string text, bool bold = false) uses alloc {
    unless style.color {
        return $"{text}"
    }
    return $"{bold ? "\u{1b}[1m" : ""}{t7Prefix(by: style.palette, for: role)}{text}\u{1b}[0m"
}

/// `Messages.TestSeconds` of `TimeSpan.TotalSeconds.ToString("0.00")`: hundredths, half away from zero.
string t11Seconds(i64 nanos) uses alloc {
    let hundredths = (nanos + 5000000) / 10000000
    let rest = hundredths % 100
    return rest < 10 ? $"{hundredths / 100}.0{rest}s" : $"{hundredths / 100}.{rest}s"
}

/// `TestSymbol.Name` contains one of `wanted` (`string.Contains`, ordinal).
bool t11Matches(string name, by in List<string> wanted) {
    for s in wanted {
        return true if name.contains(s)
    }
    return false
}

/// `GetLinePosition(span.Start).Line` (SourceText.cs:54): one plus the `\n` bytes before `offset`.
i64 t11Line(in List<u8> text, at i64 offset) {
    var line: i64 = 1
    for k in 0..offset {
        if text[k] == 10 {
            line += 1
        }
    }
    return line
}

/// CliApp.cs:639 `Test`. `kept` is the command and its arguments.
i32 testCommand(in List<string> kept, by ref DCtx d) uses alloc, clock, console, env, fs, process, random {
    let args = t2Rest(kept)
    let o = t11ParseBuildOptions(in args) ?? return exitUsage
    let symbolsErr = t19Symbols(in d.styleErr)
    var reported = List<semantics.T26Reported>()
    var ok = false
    var compiled = t5Compile(
        in t11T5(in o),
        by: in symbolsErr,
        to: ref reported,
        through: ref ok,
        includeTests: true,
        ascii: d.styleErr.ascii,
        width: d.styleErr.width,
        isTty: d.stderrTty,
    )
    unless ok {
        return exitFailure
    }
    if o.run is not null && !o.mutate {
        Io.stderr.write("bayan: unexpected argument `--run`\n")
        return exitUsage
    }
    if o.mutate && (o.coverage || o.testJson) {
        Io.stderr.write($"bayan: unexpected argument `{o.coverage ? "--coverage" : "--json"}`\n")
        return exitUsage
    }
    return mutateTests(in o, through: ref compiled, by: ref d) if o.mutate
    var summary = true
    if (compiled.manifest is { } manifest) {
        summary = manifest.summary
    }
    let probes = o.coverage || o.mode == "debug" && summary
    let host = t5HostTarget()
    var map = T11CoverageMap {}
    var l = T11LCtx {}
    if probes {
        let none = List<string>()
        map = emitter.instrument(ref compiled, for: in none)
        l.covering = true
        l.coverage.count = map.probes.count
        l.coverage.statements = map.probes.statements.take()
        l.coverage.branches = map.probes.branches.take()
        l.coverage.errors = map.probes.errors.take()
    }
    let program = emitter.lower(ref compiled, to: ref l)
    let source = cprint.emit(ref compiled, from: in l.tree, through: in program, by: o.mode == "debug")
    var output: string? = null
    if (t5PrepareOut(in compiled, by: o.mode, for: host, from: source) is { } dir) {
        output = Path.combine(
            dir,
            targetExecutableName($"{semantics.programName(ref compiled, for: o.path)}-test", for: host),
        )
    }
    let entry = t11EntryModule(ref compiled, for: o.path)
    var selected = List<i64>()
    for i in 0..program.tests.length {
        selected.append(i)
    }
    if (o.only is { } wanted) {
        var any = false
        for t in program.tests {
            if t11Matches(compiled.tests[t].title, by: in wanted) {
                any = true
            }
        }
        unless any {
            var quoted = List<string>()
            for s in wanted {
                quoted.append($"`{s}`")
            }
            Io.stderr.write($"bayan: no test name contains {t5Join(in quoted)}\n")
            return exitUsage
        }
    }
    if o.changed {
        let changed = changedModules(in compiled, by: in o, for: entry) ?? return exitUsage
        var kept2 = List<i64>()
        for i in selected {
            if changed.all || changed.directories.contains(moduleOf(in compiled, for: program.tests[i], by: entry)) {
                kept2.append(i)
            }
        }
        selected = move kept2
    }
    let unchanged = program.tests.length - selected.length
    if (o.only is { } only) {
        var kept3 = List<i64>()
        for i in selected {
            if t11Matches(compiled.tests[program.tests[i]].title, by: in only) {
                kept3.append(i)
            }
        }
        selected = move kept3
    }
    let built = Io.monotonicNanos()
    var building = start(in d.styleErr, by: d.stderrTty, through: o.json || o.testJson, for: "building")
    let native = t9Build(source, by: o.mode, to: output, for: null, through: ref d)
    done(ref building)
    unless native.result.succeeded {
        t5ReportToolchain(native.result, by: o.json || o.testJson, for: symbolsErr)
        return exitToolchain
    }
    let executable = native.exe
    let buildNanos = Io.monotonicNanos() - built
    var coverageDir: string? = null
    var coveragePrefix: string? = null
    var hits: Map<i64, u64> = []
    let partial = selected.length < program.tests.length
    var unknown = partial
    if probes {
        let temp = Path.combine(t9TempPath(), $"bayan-coverage-{t9Unique(ref d)}")
        // `Directory.CreateTempSubdirectory` throws, uncaught, when the temporary directory cannot be written.
        // coverage-exempt: Q1219 an IO failure the C# lets escape
        Io.createDirectory(temp) catch { panic($"cannot create the directory {temp}") }
        coverageDir = temp
        let prefix = Path.combine(temp, "BAYAN_COVERAGE")
        coveragePrefix = prefix
        deleteStale(prefix)
    }
    let count = selected.length
    let human = !o.testJson
    let symbols = semantics.t26Symbols(d.styleOut.ascii)
    let separator = d.styleOut.ascii ? "-" : "·"
    var moduleSet: Map<string, bool> = []
    for i in selected {
        moduleSet[moduleOf(in compiled, for: program.tests[i], by: entry)] = true
    }
    var modules: i64 = 0
    for (_, _) in moduleSet {
        modules += 1
    }
    if human {
        let tests = count == 1 ? $"{count} test" : $"{count} tests"
        let mods = modules == 1 ? $"{modules} module" : $"{modules} modules"
        print($"running {tests} in {mods}{o.changed ? $" ({unchanged} in unchanged modules skipped)" : ""}")
    }
    let timeout = testTimeout()
    var results = List<TestResult>()
    var failureNames = List<string>()
    var failureSelectable = List<bool>()
    let total = Io.monotonicNanos()
    for i in selected {
        let t = program.tests[i]
        let title = compiled.tests[t].title
        var progress = start(in d.styleErr, by: d.stderrTty, through: o.json || o.testJson, for: $"testing {title}")
        let outcome = runTest(executable, at: i, by: coveragePrefix, for: timeout)
        done(ref progress)
        if (coveragePrefix is { } prefix) {
            // coverage-exempt: Q1219 an unreadable counter file
            if outcome.timedOut || !mergeCounters($"{prefix}.{i}", to: ref hits) {
                unknown = true
            }
        }
        var status = TestStatus.panicked
        if outcome.timedOut {
            status = .timedOut
        } else if outcome.exitCode == 0 {
            status = .passed
        } else if outcome.exitCode == 1 {
            status = .failed
        } else if outcome.exitCode == 4 {
            status = .pending
        }
        let captured = $"{outcome.stdout}{outcome.stderr}".trimmed(from: .end)
        var details = captured
        if outcome.timedOut {
            details = $"timed out after {(timeout + 500) / 1000} s{captured.length > 0 ? $"\n{captured}" : ""}"
        }
        var file = ""
        var line: i64 = 0
        let f = compiled.tests[t].file
        // coverage-exempt: Q1219 every test has a location
        if f != -1 {
            file = compiled.files[f].path
            line = t11Line(in compiled.files[f].text, at: compiled.tests[t].span.start)
        }
        results.append(
            TestResult {
                name: title,
                file: file,
                line: line,
                status: status,
                elapsedNanos: outcome.elapsedNanos,
                output: status == .passed ? "" : details,
            },
        )
        let module = Path.fileName(moduleOf(in compiled, for: t, by: entry))
        let name = visible(title)
        if status == .passed {
            unless o.verbose {
                continue
            }
            if human {
                print($"  {t11Paint(3, by: d.styleOut, for: symbols.dot)} {module}: {name}")
            }
            if details.length > 0 {
                for detail in details.parts(by: "\n") {
                    var trimmed = detail
                    while trimmed.endsWith("\r") {
                        trimmed = trimmed[0..trimmed.length - 1]
                    }
                    if human {
                        print($"      {visible(trimmed)}")
                    }
                }
            }
            continue
        }
        if status == .pending {
            if o.verbose && human {
                print($"  {t11Paint(1, by: d.styleOut, for: symbols.dot)} {module}: {name} (pending)")
            }
            continue
        }
        failureNames.append(name)
        failureSelectable.append(name == title)
        if human {
            print("")
            print($"  {t11Paint(0, by: d.styleOut, for: symbols.cross, bold: true)} {module}: {name}")
            for detail in failureDetail(details, by: o.verbose, for: in symbols, through: d.styleOut.width - 6) {
                print($"      {visible(detail)}")
            }
        }
    }
    let totalNanos = Io.monotonicNanos() - total
    var report = TestReport {
        package: compiled.manifest is not null ? compiled.packageName : null,
        mode: o.mode,
        target: host,
        elapsedNanos: totalNanos,
        skipped: unchanged,
    }
    report.tests = move results
    let passed = testReportCount(in report, for: .passed)
    let pending = testReportCount(in report, for: .pending)
    let failed = count - passed - pending
    let seconds = t11Seconds(totalNanos)
    let dot = t11Paint(3, by: d.styleOut, for: symbols.dot)
    if human {
        print("")
        if failed > 0 {
            print(
                $"{dot} {passed} passed {separator} {t11Paint(0, by: d.styleOut, for: symbols.cross)} {failed} failed {separator} {pending} pending {separator} {seconds}",
            )
        } else if pending > 0 {
            print($"{dot} {passed} passed {separator} {pending} pending {separator} {seconds}")
        } else {
            print($"{dot} {passed} passed {separator} {seconds}")
        }
        if failureNames.length > 0 && failureNames.length <= 3 {
            var command = StrBuf()
            command.append("bayan test")
            var selectable: i64 = 0
            for k in 0..failureNames.length {
                if failureSelectable[k] {
                    command.append($" --only {shellQuote(failureNames[k])}")
                    selectable += 1
                }
            }
            let rerun = command.finish()
            if selectable > 0 {
                print(selectable == 1 ? $"  rerun the failure: {rerun}" : $"  rerun the failures: {rerun}")
            }
            if selectable < failureNames.length {
                print("  a failing test's name contains control characters and cannot be selected from a shell")
            }
        }
    }
    let json = testReportJson(in report)
    if o.testJson {
        Io.stdout.write(json)
    }
    if compiled.manifest is not null {
        let testDir = Path.combine(Path.combine(compiled.displayRoot, "out"), "test")
        // `Directory.CreateDirectory` and `Toolchain.ReplaceFile` throw, uncaught, on an IO error.
        // coverage-exempt: Q1219 through `t11ReplaceText(resultsPath` IO failures the C# lets escape
        Io.createDirectory(testDir) catch { panic($"cannot create the directory {testDir}") }
        let resultsPath = Path.combine(testDir, "results.json")
        t11ReplaceText(resultsPath, from: json, through: ref d) catch { panic($"cannot write {resultsPath}") }
    }
    let gated = probes
        && writeCoverage(
            in o,
            by: in compiled,
            from: in map,
            through: in hits,
            for: unknown,
            as: partial,
            to: buildNanos,
            at: totalNanos,
            quiet: !human,
        )
    if (coverageDir is { } cd) {
        deleteWorkDir(cd)
    }
    return failed > 0 || gated ? exitTestFailure : exitOk
}

/// Toolchain.cs:262 `ReplaceFile(path, temp => File.WriteAllText(temp, json))` (CliApp.cs:775): cache.byn's `replaceFile` with the text
/// written instead of a file copied (Q1217).
void t11ReplaceText(string path, from string text, through ref DCtx d) uses alloc, clock, fs, random fails IoError {
    let temp = $"{path}.{t9Unique(ref d)}.tmp"
    defer t9DeleteFile(temp)
    try Io.writeFile(temp, text.bytes)
    for _ in 1..50 {
        // coverage-exempt: Q1217 a rename that fails and then succeeds (another process holds `path`, Windows)
        Fs.rename(temp, to: path) catch continue
        return
    }
    // coverage-exempt: Q1217 the 50th try, after 49 failed renames
    try Fs.rename(temp, to: path)
}

/// CliApp.cs:790 `MergeCounters`: a test's counter file added to `hits`; false when it is unreadable. A missing file adds nothing.
bool mergeCounters(string counterFile, to ref Map<i64, u64> hits) uses alloc, fs {
    // coverage-exempt: Q1219 through `?? return false` a missing or unreadable counter file
    unless t1FileExists(counterFile) {
        return true
    }
    let counts = readCounters(counterFile) ?? return false
    for (id, n) in counts {
        hits[id] = (hits.tryGet(at: id) ?? 0) + n
    }
    return true
}

/// CliApp.cs:812 `WriteCoverage`: the one-line summary, or with `--coverage` the summary, `out/test/bayan-quality.json` and a
/// `<file>.cov.txt` per file; whether a gate failed. `quiet` is `--json`'s `TextWriter.Null` for `human`.
bool writeCoverage(
    in T11Options o,
    by in semantics.Ctx compiled,
    from in emitter.CoverageMap map,
    through in Map<i64,
    u64> hits,
    for bool unknown,
    as bool partial,
    to i64 buildNanos,
    at i64 totalNanos,
    bool quiet = false
) uses alloc, console, fs {
    let report = qualityCoverage(
        "bayan test --coverage",
        by: in map,
        from: in hits,
        for: unknown,
        through: buildNanos,
        as: totalNanos,
    )
    if !o.coverage {
        return false if partial
        unless quiet {
            print(
                $"coverage: lines {t11Part(in report.lines)}, branches {t11Part(in report.branches)}, error paths {t11Part(in report.errorPaths)}",
            )
        }
        return false
    }
    if !partial && !quiet {
        Io.stdout.write(qualityCoverageSummary(in report))
    }
    let full = Path.fullPath(o.path)
    let root = compiled.manifest is not null ? compiled.displayRoot : Path.directoryName(full) ?? ""
    let dir = Path.combine(Path.combine(root, "out"), "test")
    // `Directory.CreateDirectory` and `File.WriteAllText` throw, uncaught, on an IO error.
    // coverage-exempt: Q1219 through `qualityJson(in report)` IO failures the C# lets escape
    Io.createDirectory(dir) catch { panic($"cannot create the directory {dir}") }
    let quality = Path.combine(dir, "bayan-quality.json")
    Io.writeFile(quality, qualityJson(in report).bytes) catch { panic($"cannot write {quality}") }
    for f in report.files {
        let path = Path.isRooted(f.path) ? f.path : Path.fullPath(Path.combine(root, f.path))
        // coverage-exempt: Q1219 through `qualityListing(in f` a listed file deleted during the run, and IO failures the C# lets escape
        unless t1FileExists(path) {
            continue
        }
        let listing = Path.combine(dir, $"{listingName(Path.relative(root, to: path))}.cov.txt")
        let parent = Path.directoryName(listing) ?? dir
        Io.createDirectory(parent) catch { panic($"cannot create the directory {parent}") }
        let text = Io.readText(path) catch { panic($"cannot read {path}") }
        let lines = t11ReadAllLines(text)
        Io.writeFile(listing, qualityListing(in f, from: in lines).bytes) catch { panic($"cannot write {listing}") }
    }
    return false if partial
    if (compiled.manifest is { } m) {
        return reportGates(in gatesCoverage(in report, by: m.minLines, for: m.minBranches, through: m.minErrorPaths))
    }
    return false
}

/// `Part` of CliApp.cs:821.
string t11Part(in QualityTally x) uses alloc =>
    $"{x.covered}/{x.total} ({x.total == 0 ? "100" : gatesFmt(x.covered, by: x.total)}%)"

/// `File.ReadAllLines`: lines ended by `\r\n`, `\n` or `\r`, no empty last line after a final ending.
List<string> t11ReadAllLines(string text) uses alloc {
    var lines = List<string>()
    for line in text.replaced("\r\n", by: "\n").replaced("\r", by: "\n").parts(by: "\n") {
        lines.append(line)
    }
    if lines[lines.length - 1].length == 0 {
        let _ = lines.removeLast()
    }
    return lines
}

/// CliApp.cs:846 `ListingName`: each `..` segment becomes `_`; a rooted path keeps only its file name.
string listingName(string relative) uses alloc {
    // coverage-exempt: Q1219 through `s == ".."` a rooted, Windows or `..` path
    return Path.fileName(relative) if Path.isRooted(relative)
    let windows = Target.os == "windows"
    let separator = windows ? "\\" : "/"
    let normal = windows ? relative.replaced("/", by: "\\") : relative
    var sb = StrBuf()
    var first = true
    for s in normal.parts(by: separator) {
        unless first {
            sb.append(separator)
        }
        first = false
        sb.append(s == ".." ? "_" : s)
    }
    return $"{sb.finish()}"
}

/// CliApp.cs:994 `FailureDetail`: `panic: ` dropped, the diagram under a failed `assert` moved left, drawn with `symbols` and cut
/// to `width` columns, and `at file:line` frames as `file:line`, the top three unless `verbose`.
List<string> failureDetail(string details, by bool verbose, for in semantics.T26Symbols symbols, through i64 width)
        uses alloc {
    // `PowerAssert.Indent` and `PowerAssert.Bar` (PowerAssert.cs:10-13).
    let indent = "       "
    var lines = List<string>()
    var frames: i64 = 0
    var diagram = false
    for raw in details.parts(by: "\n") {
        var l = raw
        while l.endsWith("\r") {
            l = l[0..l.length - 1]
        }
        if l.startsWith("  at ") {
            if verbose || frames < 3 {
                lines.append(l[5..l.length])
            }
            frames += 1
            diagram = false
            continue
        }
        if l.startsWith("panic: ") {
            l = l[7..l.length]
            diagram = l.startsWith("assert ") || l.startsWith("assert(")
        } else if diagram && l.startsWith(indent) {
            l = fit(
                l[indent.length..l.length].replaced("│", by: symbols.bar),
                to: width,
                by: symbols.ellipsis,
                for: symbols.ellipsis == "…" ? 1 : symbols.ellipsis.length,
            )
        }
        lines.append(l)
    }
    return lines
}

/// `ChangedSet` (CliApp.cs:1022): `directories` as a set.
struct T11ChangedSet {
    bool all = false
    Map<string, bool> directories = []
}

/// CliApp.cs:1029 `ChangedModules`: the module directories with files that differ from `HEAD` (or `--base`), untracked files
/// included; a changed `package.byn` selects everything. Null after reporting why git could not answer.
T11ChangedSet? changedModules(in semantics.Ctx compiled, by in T11Options o, for string entry)
        uses alloc, console, env, fs, process {
    var dir = compiled.displayRoot
    if compiled.manifest is null {
        let full = Path.fullPath(o.path)
        dir = t5DirectoryExists(o.path) ? full : Path.directoryName(full) ?? ""
    }
    if (ccFindOnPath("git", for: Target.os) is not { } git) {
        Io.stderr.write("bayan: `--changed` needs git, which isn't installed\n")
        return null
    }
    var top = List<string>()
    top.append("rev-parse")
    top.append("--show-toplevel")
    if distGit(git, at: dir, by: in top).code != 0 {
        Io.stderr.write($"bayan: `--changed` needs a git repository, and `{o.path}` isn't in one\n")
        return null
    }
    let baseRef = o.baseRef ?? "HEAD"
    var diffArgs = List<string>()
    for a in ["diff", "--name-only", "-z", "--relative", baseRef, "--", "."] {
        diffArgs.append(a)
    }
    let diff = distGit(git, at: dir, by: in diffArgs)
    if diff.code != 0 {
        Io.stderr.write($"bayan: git can't compare the working tree with `{baseRef}`\n")
        return null
    }
    var lsArgs = List<string>()
    for a in ["ls-files", "-z", "--others", "--exclude-standard", "--", "."] {
        lsArgs.append(a)
    }
    let ls = distGit(git, at: dir, by: in lsArgs)
    // coverage-exempt: Q1219 `git ls-files` failing after `git diff` succeeded
    let untracked = ls.code == 0 ? ls.stdout : ""
    var set = T11ChangedSet {}
    for relative in $"{diff.stdout}\u{0}{untracked}".parts(by: "\u{0}") {
        continue if relative.length == 0
        let full = Path.fullPath(Path.combine(dir, relative))
        if compiled.manifest is not null && full == Path.combine(compiled.displayRoot, "package.byn") {
            set.all = true
            return set
        }
        if full.endsWith(".byn") {
            set.directories[moduleDirectory(in compiled, for: full, by: entry)] = true
        }
    }
    return set
}

/// CliApp.cs:1061 `ModuleOf`: the module directory of test `testIndex`; empty without a location.
string moduleOf(in semantics.Ctx compiled, for i64 testIndex, by string entry) uses alloc, fs {
    let f = compiled.tests[testIndex].file
    // coverage-exempt: Q1219 every test has a location
    return "" if f == -1
    let path = compiled.files[f].path
    return moduleDirectory(
        in compiled,
        for: Path.isRooted(path) ? path : Path.fullPath(Path.combine(compiled.displayRoot, path)),
        by: entry,
    )
}

/// CliApp.cs:1069 `ModuleDirectory`: a project's `tests/` files belong to the entry module `entry`.
string moduleDirectory(in semantics.Ctx compiled, for string file, by string entry) uses alloc {
    let dir = Path.directoryName(file) ?? ""
    return Path.combine(Path.combine(compiled.displayRoot, "src"), entry) if compiled.manifest is not null
        && dir == Path.combine(compiled.displayRoot, "tests")
    return dir
}

/// CliApp.cs:389 `EntryModule` (private in semantics, Q1217): `app`, or a library's short name in camelCase.
string t11EntryModule(ref semantics.Ctx compiled, for string path) uses alloc, fs {
    return compiled.library ? semantics.camelOf(semantics.programName(ref compiled, for: path)) : "app"
}

/// `TestOutcome` (CliApp.cs:1020): `elapsedNanos` is `Elapsed`.
struct T11Outcome {
    i32    exitCode     = 0
    bool   timedOut     = false
    string stdout       = ""
    string stderr       = ""
    i64    elapsedNanos = 0
}

/// CliApp.cs:1077 `RunTest`: `executable --test <index>` with `$BAYAN_COVERAGE` set to `coveragePrefix`, killed after `timeoutMs`.
/// `Io.run` with `timeout:` keeps each stream's first and last 64 KiB, as `BoundedCapture.cs`, and a timed-out test keeps what it
/// printed before the kill (Q1216). A signal-killed test is exit 128 + the signal, as `Process.ExitCode` reports it.
T11Outcome runTest(string executable, at i64 index, by string? coveragePrefix, for i64 timeoutMs)
        uses alloc, clock, process {
    var args = List<string>()
    args.append("--test")
    args.append($"{index}")
    var env: Map<string, string?> = []
    if coveragePrefix is not null {
        env["BAYAN_COVERAGE"] = coveragePrefix
    }
    let clock = Io.monotonicNanos()
    let r = Io.run(executable, args.span, env: env, timeout: Millis(timeoutMs)) catch switch {
        .timeout(_, let streamOut, let streamErr) => return T11Outcome {
            exitCode: -1,
            timedOut: true,
            stdout: streamOut,
            stderr: streamErr,
            elapsedNanos: Io.monotonicNanos() - clock,
        },
        .signaled(let s, let streamOut, let streamErr) => return T11Outcome {
            exitCode: 128 + s,
            stdout: streamOut,
            stderr: streamErr,
            elapsedNanos: Io.monotonicNanos() - clock,
        },
        // `Process.Start` of the just-built executable throws, uncaught, when it cannot start.
        // coverage-exempt: Q1219 the executable just built cannot start
        IoError e => { panic($"cannot run {executable}") },
    }
    return T11Outcome {
        exitCode: r.exitCode,
        stdout: r.stdout,
        stderr: r.stderr,
        elapsedNanos: Io.monotonicNanos() - clock,
    }
}

/// CoverageInstrumenter.cs:60 `DeleteStale`: every `<prefix>.*` file is deleted.
void deleteStale(string prefix) uses alloc, fs {
    let dir = Path.directoryName(Path.fullPath(prefix)) ?? ""
    // coverage-exempt: Q1219 through `if name.startsWith(start)` the coverage directory is fresh, so it holds no stale file
    unless t5DirectoryExists(dir) {
        return
    }
    let start = $"{Path.fileName(prefix)}."
    let names = Io.listDir(dir) catch return
    for name in names {
        let path = Path.combine(dir, name)
        if name.startsWith(start) && t1FileExists(path) {
            Io.remove(path) catch { panic($"cannot delete {path}") }
        }
    }
}

/// CoverageInstrumenter.cs:72 `Read`: `bayan-coverage 1`, then `<counter id> <hits>` per line; null where the C# throws
/// `InvalidDataException`, `IndexOutOfRangeException`, `FormatException` or `OverflowException`.
Map<i64, u64>? readCounters(string path) uses alloc, fs {
    // coverage-exempt: Q1219 through `counts[id] = u64(n)` an unreadable or malformed counter file
    // no-oracle: Q1219 `File.ReadAllLines` throws an `IOException` MergeCounters does not catch; an unreadable file is unknown here
    let text = Io.readText(path) catch return null
    let lines = t11ReadAllLines(text)
    return null if lines.length == 0 || lines[0] != "bayan-coverage 1"
    var counts: Map<i64, u64> = []
    for k in 1..lines.length {
        var parts = List<string>()
        for part in lines[k].parts(by: " ") {
            parts.append(part)
        }
        return null if parts.length < 2
        let id = t9Digits(parts[0], until: 2147483647) ?? return null
        let n = t9Digits(parts[1], until: 9223372036854775807) ?? return null
        counts[id] = u64(n)
    }
    return counts
}
== driver/testreport.byn
// `out/test/results.json` and `bayan test --json` of the self-hosted driver (spec 017 T11): `TestReport.cs` :7 `TestStatus`,
// :9 `TestResult`, :17 `TestReport` with :19 `Count` and :21 `ToJson`, and the `Utf8JsonWriter` (indented, `NewLine = "\n"`,
// `UnsafeRelaxedJsonEscaping`) it and `QualityReport.Json` write through, as `T11Json`.

/// `TestStatus` (TestReport.cs:7), each case its past participle (`fail` and `panic` are keywords).
enum TestStatus {
    passed
    failed
    panicked
    timedOut
    pending
}

/// `TestResult` (TestReport.cs:9): `elapsedNanos` is `Elapsed`.
struct TestResult {
    string     name
    string     file
    i64        line
    TestStatus status
    i64        elapsedNanos
    string     output
}

/// `TestReport` (TestReport.cs:17): `package` null outside a project, `elapsedNanos` is `Elapsed`, `skipped` the tests `--changed` left out.
struct TestReport {
    string? package
    string  mode
    string  target
    List<TestResult> tests = []
    i64     elapsedNanos = 0
    i64     skipped      = 0
}

/// TestReport.cs:19 `Count`.
i64 testReportCount(in TestReport r, for TestStatus status) {
    var n: i64 = 0
    for t in r.tests {
        if t.status == status {
            n += 1
        }
    }
    return n
}

/// `t.Status.ToString().ToLowerInvariant()` (TestReport.cs:38).
string testStatusName(TestStatus status) {
    switch status {
        case .passed: return "pass"
        case .failed: return "fail"
        case .panicked: return "panic"
        case .timedOut: return "timeout"
        case .pending: return "pending"
    }
}

/// TestReport.cs:21 `ToJson`.
string testReportJson(in TestReport r) uses alloc {
    var w = T11Json {}
    t11JsonOpen(ref w, for: null, by: "{")
    if (r.package is { } package) {
        t11JsonValue(ref w, for: "package", by: t11JsonString(package))
    } else {
        t11JsonValue(ref w, for: "package", by: "null")
    }
    t11JsonValue(ref w, for: "mode", by: t11JsonString(r.mode))
    t11JsonValue(ref w, for: "target", by: t11JsonString(r.target))
    t11JsonOpen(ref w, for: "tests", by: "[")
    for t in r.tests {
        t11JsonOpen(ref w, for: null, by: "{")
        t11JsonValue(ref w, for: "name", by: t11JsonString(t.name))
        t11JsonValue(ref w, for: "file", by: t11JsonString(t.file))
        t11JsonValue(ref w, for: "line", by: $"{t.line}")
        t11JsonValue(ref w, for: "status", by: t11JsonString(testStatusName(t.status)))
        t11JsonValue(ref w, for: "durationMs", by: t11JsonMilliseconds(t.elapsedNanos))
        t11JsonValue(ref w, for: "output", by: t11JsonString(t.output))
        t11JsonClose(ref w, by: "}")
    }
    t11JsonClose(ref w, by: "]")
    t11JsonOpen(ref w, for: "summary", by: "{")
    t11JsonValue(ref w, for: "total", by: $"{r.tests.length}")
    t11JsonValue(ref w, for: "passed", by: $"{testReportCount(in r, for: .passed)}")
    t11JsonValue(ref w, for: "failed", by: $"{testReportCount(in r, for: .failed)}")
    t11JsonValue(ref w, for: "panicked", by: $"{testReportCount(in r, for: .panicked)}")
    t11JsonValue(ref w, for: "timedOut", by: $"{testReportCount(in r, for: .timedOut)}")
    t11JsonValue(ref w, for: "pending", by: $"{testReportCount(in r, for: .pending)}")
    t11JsonValue(ref w, for: "skipped", by: $"{r.skipped}")
    t11JsonValue(ref w, for: "durationMs", by: t11JsonMilliseconds(r.elapsedNanos))
    t11JsonClose(ref w, by: "}")
    t11JsonClose(ref w, by: "}")
    return $"{t11JsonText(in w)}\n"
}

/// `Math.Round(elapsed.TotalMilliseconds, 1)` as `Utf8JsonWriter` writes the double: tenths of the whole 100 ns ticks, half to even
/// (`MidpointRounding.ToEven`), no `.0`. A tie is any tick count ending in 500; .NET rounds `TotalMilliseconds * 10` as a double,
/// which this does not model when that product is an ulp off the tie.
string t11JsonMilliseconds(i64 nanos) uses alloc {
    let ticks = nanos / 100
    var tenths = ticks / 1000
    let rest = ticks % 1000
    // coverage-exempt: Q1218 a test that takes a tick count ending in 500 (a tie)
    if rest > 500 || rest == 500 && tenths % 2 == 1 {
        tenths += 1
    }
    return tenths % 10 == 0 ? $"{tenths / 10}" : $"{tenths / 10}.{tenths % 10}"
}

/// `TimeSpan.TotalSeconds` (whole ticks of 100 ns) as `Utf8JsonWriter` writes the double: trailing zeros dropped.
string t11JsonSeconds(i64 nanos) uses alloc {
    let ticks = nanos / 100
    let whole = ticks / 10000000
    let rest = ticks % 10000000
    // coverage-exempt: Q1218 a run that takes a whole number of seconds to the 100 ns tick
    return $"{whole}" if rest == 0
    var digits = $"{rest}"
    while digits.length < 7 {
        digits = $"0{digits}"
    }
    while digits.endsWith("0") {
        digits = digits[0..digits.length - 1]
    }
    return $"{whole}.{digits}"
}

/// The `Utf8JsonWriter` of TestReport.cs:24 and QualityReport.cs:153 with `Indented = true` and `NewLine = "\n"`: two spaces a
/// level, `"name": value`, and an empty container closed on its own line (`[]`, `{}`). `first` is no item yet in the open container.
struct T11Json {
    List<string> parts = []
    i64          depth = 0
    bool         first = true
}

/// The separator, new line and indent before an item, then its property name.
void t11JsonItem(ref T11Json w, for string? name) uses alloc {
    if w.depth > 0 {
        unless w.first {
            w.parts.append(",")
        }
        w.parts.append("\n")
        for _ in 0..w.depth {
            w.parts.append("  ")
        }
    }
    if name is not null {
        w.parts.append($"{t11JsonString(name)}: ")
    }
}

/// `WriteStartObject`/`WriteStartArray`: `bracket` is `{` or `[`.
void t11JsonOpen(ref T11Json w, for string? name, by string bracket) uses alloc {
    t11JsonItem(ref w, for: name)
    w.parts.append(bracket)
    w.depth += 1
    w.first = true
}

/// `WriteEndObject`/`WriteEndArray`: `bracket` is `}` or `]`.
void t11JsonClose(ref T11Json w, by string bracket) uses alloc {
    w.depth -= 1
    unless w.first {
        w.parts.append("\n")
        for _ in 0..w.depth {
            w.parts.append("  ")
        }
    }
    w.parts.append(bracket)
    w.first = false
}

/// A property or array value already in JSON form.
void t11JsonValue(ref T11Json w, for string? name, by string value) uses alloc {
    t11JsonItem(ref w, for: name)
    w.parts.append(value)
    w.first = false
}

/// A JSON string as `JavaScriptEncoder.UnsafeRelaxedJsonEscaping` writes it; semantics/typed.byn `t26JsonString` (private there, Q1218).
string t11JsonString(string s) uses alloc {
    var sb = StrBuf()
    sb.append("\"")
    var from: i64 = 0
    var at: i64 = 0
    for r in s.runes {
        let v = i64(u32(r))
        let next = at + t7Utf8Length(v)
        var escaped = ""
        if v == 0x22 {
            escaped = "\\\""
        } else if v == 0x5C {
            escaped = "\\\\"
        } else if v == 0x08 {
            escaped = "\\b"
        } else if v == 0x09 {
            escaped = "\\t"
        } else if v == 0x0A {
            escaped = "\\n"
        } else if v == 0x0C {
            escaped = "\\f"
        } else if v == 0x0D {
            escaped = "\\r"
        } else if v is < 0x20 or 0x7F..=0x9F or 0x2028 or 0x2029 {
            escaped = $"\\u{t11Hex4(v)}"
        } else if v > 0xFFFF {
            let u = v - 0x10000
            escaped = $"\\u{t11Hex4(0xD800 + (u >> 10))}\\u{t11Hex4(0xDC00 + (u & 0x3FF))}"
        }
        if escaped.length > 0 {
            sb.append(s[from..at])
            sb.append(escaped)
            from = next
        }
        at = next
    }
    sb.append(s[from..s.length])
    sb.append("\"")
    return $"{sb.finish()}"
}

/// semantics/typed.byn `t26Hex4`: `v` (below 0x10000) as four upper-case hex digits.
string t11Hex4(i64 v) uses alloc {
    let digits = "0123456789ABCDEF"
    var sb = StrBuf()
    var shift: i64 = 12
    while shift >= 0 {
        let d = (v >> shift) & 0xF
        sb.append(digits[d..d + 1])
        shift -= 4
    }
    return $"{sb.finish()}"
}

/// The text written so far (`Encoding.UTF8.GetString(buffer.WrittenSpan)`).
string t11JsonText(in T11Json w) uses alloc {
    var sb = StrBuf()
    for p in w.parts {
        sb.append(p)
    }
    return $"{sb.finish()}"
}
== driver/walk.byn
// The shared `.byn` walk of the driver (spec 017 T6), used by `audit` and `format`. Ports `Format.cs` :119 `BynFiles`, :183
// `IsSkippedDirectory`, :193 `RealPath`, :230 `ManifestFor` and :255 `PackageNames`.

import lexer
import parser
import semantics

/// A directory still to walk: the path as written and its canonical path (`Format.cs:133` `(string Path, string? Canonical)`).
struct T6Pending {
    string path
    string canonical
}

/// Format.cs:183 `IsSkippedDirectory`: dot-directories and `node_modules` or `obj` anywhere, `bin`, `dist` and `tmp` only directly under the walk root.
bool t6IsSkippedDirectory(string name, bool atRoot) =>
    name.startsWith(".") || name.equals("node_modules", as: .caseless) || name.equals("obj", as: .caseless)
    || (atRoot
        && (name.equals("bin", as: .caseless)
            || name.equals("dist", as: .caseless)
            || name.equals("tmp", as: .caseless)))

/// Format.cs:121-122 `Inside`: `real` is `within` or lies under it; every path is inside without a bound. The separator is
/// `Path.DirectorySeparatorChar`, and `Path.EndsInDirectorySeparator` takes `/` or `\` on Windows and `/` elsewhere.
bool t6Inside(string real, by string? within) {
    if (within is { } bound) {
        let windows = Target.os == "windows" // coverage-exempt: Q1106
        let prefix = bound.endsWith("/") || (windows && bound.endsWith("\\")) ? bound : $"{bound}{windows ? "\\" : "/"}"
        return real == bound || real.startsWith(prefix)
    }
    return true
}

/// `Directory.GetFiles(canonical, "*.byn")`: .NET matches the pattern case-insensitively on macOS and Windows and case-sensitively elsewhere
/// (ASCII letters only here, Q1106).
bool t6IsByn(string name) {
    // coverage-exempt: Q1106 through `return name.endsWith(".byn")`
    return name.endsWith(".byn") if Target.os == "linux"
    let n = name.length
    return false if n < 4
    let b = name.bytes
    return b[n - 4] == 0x2e && (b[n - 3] | 0x20) == 0x62 && (b[n - 2] | 0x20) == 0x79 && (b[n - 1] | 0x20) == 0x6e
}

/// Format.cs:193 `RealPath`: the absolute path with every symlink in it resolved (`Fs.realPath`). Where the C# throws "Too many levels of symbolic
/// links" this fails with the `IoError` of the kernel's ELOOP; it also fails on a missing path, which the C# returns unresolved (Q1106).
string realPath(string path) uses alloc, fs fails IoError => try Fs.realPath(path)

/// Format.cs:119 `BynFiles`: every `.byn` file under `dir`. A directory that cannot be listed is reported to stderr (not when `silent`, the
/// `TextWriter.Null` of `PackageNames`), sets `exit` to 1, and is skipped. With `within`, a file or directory whose real path lies outside it is
/// neither listed nor entered.
List<string> bynFiles(string dir, through ref i32 exit, by string? within = null, for bool silent = false)
        uses alloc, console, fs {
    var files = List<string>()
    var seenFiles: Map<string, bool> = []
    var seenDirs: Map<string, bool> = []
    var failed = false
    var pending = List<T6Pending>()
    let root = realPath(dir) catch switch {
        // coverage-exempt: Q1106 through `return files`
        IoError e => {
            unless silent { Io.stderr.write($"bayan: {dir}: {e}\n") }
            exit = 1
            return files
        }
    }
    pending.append(T6Pending { path: dir, canonical: root })
    while pending.length > 0 {
        let at = pending[pending.length - 1]
        pending.remove(at: pending.length - 1)
        let canonical = at.canonical
        continue if seenDirs.contains(canonical)
        seenDirs[canonical] = true
        let names = Io.listDir(canonical) catch switch {
            IoError e => {
                unless silent { Io.stderr.write($"bayan: {at.path}: {e}\n") }
                failed = true
                continue
            }
        }
        // `Directory.GetFiles(canonical, "*.byn")` and `Directory.GetDirectories(canonical)`: an entry that is not a file is a directory.
        for name in names {
            continue if !t6IsByn(name) || !Fs.fileExists(Path.combine(canonical, name))
            let file = Path.combine(at.path, name)
            let real = realPath(Path.combine(canonical, name)) catch switch {
                IoError e => {
                    unless silent { Io.stderr.write($"bayan: {file}: {e}\n") }
                    failed = true
                    continue
                }
            }
            if t6Inside(real, by: within) && !seenFiles.contains(real) {
                seenFiles[real] = true
                files.append(file)
            }
        }
        for name in names {
            continue if Fs.fileExists(Path.combine(canonical, name))
            continue if t6IsSkippedDirectory(name, atRoot: at.path == dir)
            let sub = Path.combine(at.path, name)
            let entry = Path.combine(canonical, name)
            let real = realPath(entry) catch switch {
                IoError e => {
                    unless silent { Io.stderr.write($"bayan: {sub}: {e}\n") }
                    failed = true
                    continue
                }
            }
            // With a bound, a directory link is never followed, inside it or out: `canonical` holds no link, so `entry` is a link
            // (`DirectoryInfo.LinkTarget is not null`) exactly when its real path differs from it.
            continue if within is not null && real != entry
            if t6Inside(real, by: within) {
                pending.append(T6Pending { path: sub, canonical: real })
            }
        }
    }
    if failed {
        exit = 1
    }
    return files
}

/// The C# `(Manifest Manifest, string Dir)`: the directory of a `package.byn` and what `Format.Run` reads of its manifest. A `Manifest` holds
/// lists and so cannot be copied into the cache for each directory below the one found (BYN2780): `booleans` and `primitives` are its styles,
/// `hasErrors` is `Manifest.HasErrors`, `report` is `DiagnosticRenderer.RenderAll(manifest.Diagnostics, includePath: true)` when it is set,
/// and `indent`, `width`, `align` and `trailingCommas` are its layout knobs.
struct T6Found {
    string                       dir
    semantics.BooleanStyle       booleans
    semantics.PrimitiveStyle     primitives
    bool                         hasErrors
    string                       report
    i64                          indent
    i64                          width
    semantics.AlignStyle         align
    semantics.TrailingCommaStyle trailingCommas
}

/// Format.cs:407 `OtherUses`, ported by T8 in format.byn.
Map<string, bool> t6OtherUses(
    string file,
    from in List<u8> bytes,
    by in parser.CompilationUnit tree,
    through ref parser.Parser p
) uses alloc {
    return otherUses(file, from: in bytes, by: in tree, through: ref p)
}

/// Format.cs:230 `ManifestFor`: the `package.byn` in the file's directory or the nearest one above it, with its directory; null when there is none.
/// `cache` is the dictionary the C# caller (`Format.Run`) owns: each directory walked maps to what was found.
T6Found? manifestFor(string file, through ref Map<string, T6Found?> cache) uses alloc, fs fails IoError {
    var dir = Path.directoryName(Path.fullPath(file))
    var seen = List<string>()
    var found: T6Found? = null
    while let current = dir {
        if cache.contains(current) {
            found = cache[current]
            break
        }
        seen.append(current)
        let candidate = Path.combine(current, "package.byn")
        if Fs.fileExists(candidate) {
            let manifest = try semantics.manifestRead(candidate)
            let hasErrors = semantics.manifestErrorCount(in manifest) > 0
            var report = ""
            if hasErrors {
                report = t8RenderManifest(candidate, from: in manifest.diagnostics)
            }
            found = T6Found { dir: current, booleans: manifest.booleans, primitives: manifest.primitives, hasErrors: hasErrors, report: report,
                indent: manifest.indent, width: manifest.width, align: manifest.align, trailingCommas: manifest.trailingCommas }
            break
        }
        dir = Path.directoryName(current)
    }
    for d in seen {
        cache[d] = found
    }
    return found
}

/// Format.cs:255 `PackageNames`: every name the package's `.byn` files under `dir` use other than as a type, callee or receiver (the C#
/// `HashSet<string>`, as the keys of a map).
Map<string, bool> packageNames(string dir) uses alloc, console, fs {
    var names: Map<string, bool> = []
    var ignored = exitOk
    // coverage-exempt: Q1106
    let root = realPath(dir) catch return names
    for file in bynFiles(dir, through: ref ignored, by: root, for: true) {
        continue if Path.fileName(file) == "package.byn"
        let bytes = Io.readFile(file) catch continue
        var copy = List<u8>()
        for b in bytes {
            copy.append(b)
        }
        var p = parser.Parser.create(
            lexer.lex(lexer.SourceText.create(file, from: move copy), by: lexer.Keywords.build()),
        )
        let tree = parser.parseCompilationUnit(ref p)
        for (name, _) in t6OtherUses(file, from: in bytes, by: in tree, through: ref p) {
            names[name] = true
        }
    }
    return names
}
== emitter/coverage.byn
// T10: CoverageInstrumenter.cs 33-200 (`Instrument`, `InTest`, the `Walker`; spec 013 R9) and the probe records of
// CoverageProbes.cs. `DeleteStale` and `Read` (60-83) are the driver's (T11). C# keys the probes by `BoundNode`
// reference, a `BNode` handle here, and the counters the instances of a generic share by `Node` reference, which is
// `t10SyntaxKey` here (Q1098).

import lexer
import semantics
import emitter.ltree

type BNode  = semantics.BNode
type FileId = semantics.FileId

const coverageLine: string      = "line"
const coverageBranch: string    = "branch"
const coverageErrorPath: string = "error"

/// C# `CoverageCounter`: `kind` `line` (a statement started), `branch` (a condition had `outcome`) or `error`
/// (`function` returned `variant` from the `origin` at the location).
public struct CoverageCounter {
    public i64     id
    public string  kind
    public string  file
    public i64     line
    public i64     column
    public string? function = null
    public string? variant  = null
    public string? origin   = null
    public bool?   outcome  = null
}

/// The probe records live in `ltree`, since `LoweredProgram` holds them (CoverageProbes.cs).
public type BoundProbe        = ltree.BoundProbe
public type BoundBranchProbe  = ltree.BoundBranchProbe
public type ErrorProbeVariant = ltree.ErrorProbeVariant
public type BoundErrorProbe   = ltree.BoundErrorProbe
public type CoverageProbes    = ltree.CoverageProbes

/// C# `CoverageMap`.
public struct CoverageMap {
    public List<CoverageCounter> counters = []
    public CoverageProbes        probes   = {}
}

/// CoverageInstrumenter.cs:33 `Instrument`; an empty `skipFiles` is C#'s null.
public CoverageMap instrument(ref Ctx c, for in List<string> skipFiles) uses alloc {
    var w = CoverageWalker { source: lexer.SourceText.create("", from: List<u8>()) }
    for k in 0..c.moduleOrder.length {
        let m = c.moduleOrder[k]
        for i in 0..c.modules[m].allFunctions.length {
            let fn = c.modules[m].allFunctions[i]
            continue if c.functions[fn].body == -1
                || semantics.functionIsGeneric(ref c, by: fn)
                || coverageInTest(in c, for: fn)
            let kind = c.functions[fn].kind
            // coverage-exempt: Q1099
            continue if !(kind is .function or .method or .constructor or .getter or .main or .lambda)
            let file = c.functions[fn].file
            continue if file == -1 || t10Contains(in skipFiles, for: c.files[file].path)
            coverageFunction(in c, through: ref w, for: fn, at: file)
        }
    }
    let count = w.counters.length
    return CoverageMap {
        counters: w.counters.take(),
        probes: CoverageProbes {
            count: count,
            statements: w.statements.take(),
            branches: w.branches.take(),
            errors: w.errors.take(),
        },
    }
}

/// CoverageInstrumenter.cs:49 `InTest`.
bool coverageInTest(in Ctx c, for FuncId fn) {
    var f = fn
    while f != -1 {
        return true if c.functions[f].kind == .testKeyword
        f = c.functions[f].enclosing
    }
    return false
}

/// C# `HashSet<string>.Contains`, on the list that stands for it.
bool t10Contains(in List<string> xs, for string x) {
    for y in xs {
        return true if y == x
    }
    return false
}

/// C# `BoundNode.Syntax` as an identity: the file, the record type and the span of the syntax node `n` was bound
/// from, so the instances of a generic, bound again from the same syntax, share it (Q1098).
string t10SyntaxKey(in Ctx c, for BNode n, at FileId file) uses alloc {
    if (semantics.exprSyntax(in c, for: n) is { } e) {
        return $"{file} e{e.kind.ordinal} {e.span.start} {e.span.length}"
    }
    // coverage-exempt: Q1099 through `return $"{file} - {span.start} {span.length}"`
    if (semantics.nodeSyntax(in c, for: n) is { } s) {
        return $"{file} n{s.kind.ordinal} {s.span.start} {s.span.length}"
    }
    let span = semantics.nodeSpan(in c, for: n)
    return $"{file} - {span.start} {span.length}"
}

/// C# `n.Syntax.Span`.
TextSpan t10SyntaxSpan(in Ctx c, for BNode n) {
    if (semantics.exprSyntax(in c, for: n) is { } e) {
        return e.span
    }
    // coverage-exempt: Q1099 through `return semantics.nodeSpan(in c, for: n)`
    if (semantics.nodeSyntax(in c, for: n) is { } s) {
        return s.span
    }
    return semantics.nodeSpan(in c, for: n)
}

/// C# `n.Syntax is Stmt`: one of the 24 `Stmt` records, `blockStmt` to `errorStmt`.
bool t10SyntaxIsStmt(in Ctx c, for BNode n) {
    if (semantics.nodeSyntax(in c, for: n) is { } s) {
        return s.kind.ordinal <= semantics.NodeSyntaxKind.errorStmt.ordinal
    }
    return false
}

/// C# `Syntax is <kind>` for a syntax node that is not an `Expr`.
bool t10SyntaxIs(in Ctx c, for BNode n, as semantics.NodeSyntaxKind kind) {
    if (semantics.nodeSyntax(in c, for: n) is { } s) {
        return s.kind == kind
    }
    return false
}

// ── Walker (CoverageInstrumenter.cs:85-200) ──────────────────────────────────

/// C# `Walker`: the public dictionaries by bound node, the private ones by syntax (`t10SyntaxKey`).
struct CoverageWalker {
    List<CoverageCounter>         counters         = []
    Map<BNode, BoundProbe>        statements       = []
    Map<BNode, BoundBranchProbe>  branches         = []
    Map<BNode, BoundErrorProbe>   errors           = []
    Map<string, BoundProbe>       syntaxStatements = []
    Map<string, BoundBranchProbe> syntaxBranches   = []
    /// `_errors`, keyed by the syntax and the variant's `Code`.
    Map<string, i64>              syntaxErrors     = []
    FuncId                        fn               = -1
    FileId                        file             = -1
    lexer.SourceText              source
    BNode                         root             = -1
    /// `_guarded`, as its `t10SyntaxKey`.
    string?                       guarded          = null
}

/// CoverageInstrumenter.cs:105 `Function`.
void coverageFunction(in Ctx c, through ref CoverageWalker w, for FuncId fn, at FileId file) uses alloc {
    w.fn = fn
    if w.file != file {
        var bytes = List<u8>()
        for b in c.files[file].text {
            bytes.append(b)
        }
        w.source = lexer.SourceText.create(c.files[file].path, from: move bytes)
        w.file = file
    }
    w.root = c.functions[fn].body
    coverageVisit(in c, through: ref w, for: c.functions[fn].body)
}

/// CoverageInstrumenter.cs:111 `Visit`.
void coverageVisit(in Ctx c, through ref CoverageWalker w, for BNode node) uses alloc {
    let kind = semantics.boundKind(node)
    let i = node & 0xFFFFFFFF
    // `s if c` counts as one statement, the condition's outcomes saying whether `s` ran.
    if kind != .block && semantics.isStmtKind(kind) && t10SyntaxIsStmt(in c, for: node) {
        let key = t10SyntaxKey(in c, for: node, at: w.file)
        let guarded = w.guarded ?? ""
        if w.guarded is null || guarded != key {
            coverageStatement(in c, through: ref w, for: node)
        }
    }
    if kind == .ifStmt && t10SyntaxIs(in c, for: node, as: .guardedStmt) {
        w.guarded = t10SyntaxKey(in c, for: c.bIfs[i].then, at: w.file)
    }
    switch kind {
        case .ifStmt:
            coverageCondition(in c, through: ref w, for: c.bIfs[i].condition)
        case .whileStmt:
            coverageCondition(in c, through: ref w, for: c.bWhiles[i].condition)
        case .doWhile:
            coverageCondition(in c, through: ref w, for: c.bDoWhiles[i].condition)
        case .conditional:
            coverageCondition(in c, through: ref w, for: c.bConditionals[i].condition)
        case .binary:
            let op = c.bBinaries[i].op
            // coverage-exempt: Q1099
            let isBinaryExpr = (semantics.exprSyntax(in c, for: node) is { } e) && e.kind == .binaryExpr
            if (op is .logicalAnd or .logicalOr) && isBinaryExpr {
                // An operand that is itself `&&` or `||` gets its own operands' counters instead.
                unless t10IsLogical(in c, for: c.bBinaries[i].left) {
                    coverageCondition(in c, through: ref w, for: c.bBinaries[i].left)
                }
                unless t10IsLogical(in c, for: c.bBinaries[i].right) {
                    coverageCondition(in c, through: ref w, for: c.bBinaries[i].right)
                }
            }
        case .switchStmt:
            for section in c.bSwitches[i].sections {
                if section.guard != -1 {
                    coverageCondition(in c, through: ref w, for: section.guard)
                }
            }
        case .switchExpr:
            for arm in c.bSwitchExprs[i].arms {
                if arm.guard != -1 {
                    coverageCondition(in c, through: ref w, for: arm.guard)
                }
            }
        case .failStmt:
            // coverage-exempt: Q1099
            if c.functions[w.fn].hasFails {
                let error = c.bFails[i].error
                var variants = List<VariantId>()
                if semantics.boundKind(error) == .errorVariant {
                    variants.append(c.bErrorVariants[error & 0xFFFFFFFF].variant)
                } else {
                    variants = coverageVariants(
                        in c,
                        from: in c.functions[w.fn].errorSets,
                        through: in c.functions[w.fn].excludedErrors,
                        at: -1,
                    )
                }
                coverageErrorOrigin(in c, through: ref w, for: node, as: "fail", from: in variants)
            }
        case .tryExpr:
            let operand = c.bTries[i].operand
            // coverage-exempt: Q1099
            if semantics.boundKind(operand) == .call && c.functions[w.fn].hasFails {
                let callee = c.bCalls[operand & 0xFFFFFFFF].function
                let variants = coverageVariants(
                    in c,
                    from: in c.functions[callee].errorSets,
                    through: in c.functions[callee].excludedErrors,
                    at: -1,
                )
                coverageErrorOrigin(in c, through: ref w, for: node, as: "try", from: in variants)
            }
        case .catchExpr:
            let operand = c.bCatches[i].operand
            let caught = c.bCatches[i].variant
            if semantics.boundKind(operand) == .call && caught != -1 && c.functions[w.fn].hasFails {
                let callee = c.bCalls[operand & 0xFFFFFFFF].function
                let variants = coverageVariants(
                    in c,
                    from: in c.functions[callee].errorSets,
                    through: in c.functions[callee].excludedErrors,
                    at: caught,
                )
                coverageErrorOrigin(in c, through: ref w, for: node, as: "catch", from: in variants)
            }
        default: {}
    }
    let span = t10SyntaxSpan(in c, for: node)
    for child in semantics.children(in c, for: node) {
        // A child outside its parent's span was made by the binder (a default argument, an inlined constant).
        // The main program's body has the span of its first statement.
        let childSpan = t10SyntaxSpan(in c, for: child)
        continue if node != w.root && (childSpan.start < span.start || childSpan.end > span.end)
        coverageVisit(in c, through: ref w, for: child)
    }
}

/// C# `is BoundBinary { Op: BinaryOp.LogicalAnd or BinaryOp.LogicalOr }`.
bool t10IsLogical(in Ctx c, for BExpr e) {
    return false if semantics.boundKind(e) != .binary
    let op = c.bBinaries[e & 0xFFFFFFFF].op
    return op is .logicalAnd or .logicalOr
}

/// CoverageInstrumenter.cs:158 `Variants`: the variants of `sets` not in `excluded` (nor `extra`, -1 for none), each once.
List<VariantId> coverageVariants(
    in Ctx c,
    from in List<semantics.ErrorSetId> sets,
    through in List<VariantId> excluded,
    at VariantId extra
) uses alloc {
    var result = List<VariantId>()
    for s in sets {
        for v in c.errorSets[s].variants {
            var skip = v == extra
            for x in excluded {
                if x == v {
                    skip = true
                }
            }
            for x in result {
                // coverage-exempt: Q1099
                if x == v {
                    skip = true
                }
            }
            unless skip {
                result.append(v)
            }
        }
    }
    return result
}

/// CoverageInstrumenter.cs:161 `Statement`.
void coverageStatement(in Ctx c, through ref CoverageWalker w, for BNode s) uses alloc {
    let key = t10SyntaxKey(in c, for: s, at: w.file)
    unless w.syntaxStatements.contains(key) {
        let span = t10SyntaxSpan(in c, for: s)
        let id = coverageAdd(ref w, as: coverageLine, at: span)
        w.syntaxStatements[key] = BoundProbe { span: span, id: id }
    }
    w.statements[s] = w.syntaxStatements[key]
}

/// CoverageInstrumenter.cs:168 `Condition`.
void coverageCondition(in Ctx c, through ref CoverageWalker w, for BExpr cond) uses alloc {
    // A constant condition (`while true`) has one outcome, and code the binder made has no source.
    return if semantics.exprConstant(in c, for: cond) is not null || semantics.exprSyntax(in c, for: cond) is null
    let key = t10SyntaxKey(in c, for: cond, at: w.file)
    unless w.syntaxBranches.contains(key) {
        let span = t10SyntaxSpan(in c, for: cond)
        let whenTrue = coverageAdd(ref w, as: coverageBranch, at: span, outcome: true)
        let whenFalse = coverageAdd(ref w, as: coverageBranch, at: span, outcome: false)
        w.syntaxBranches[key] = BoundBranchProbe { span: span, whenTrue: whenTrue, whenFalse: whenFalse }
    }
    w.branches[cond] = w.syntaxBranches[key]
}

/// CoverageInstrumenter.cs:180 `ErrorOrigin`.
void coverageErrorOrigin(
    in Ctx c,
    through ref CoverageWalker w,
    for BNode origin,
    as string kind,
    from in List<VariantId> variants
) uses alloc {
    let template = c.functions[w.fn].template
    var name = c.functions[template != -1 ? template : w.fn].name
    let owner = c.functions[w.fn].owner
    if owner != -1 {
        let ownerTemplate = c.structs[owner].template
        name = $"{c.structs[ownerTemplate != -1 ? ownerTemplate : owner].name}.{name}"
    }
    let key = t10SyntaxKey(in c, for: origin, at: w.file)
    let span = t10SyntaxSpan(in c, for: origin)
    var ids = List<ErrorProbeVariant>()
    for v in variants {
        let errorKey = $"{key} {c.errorVariants[v].code}"
        unless w.syntaxErrors.contains(errorKey) {
            let variant = $"{c.errorSets[c.errorVariants[v].set].name}.{c.errorVariants[v].name}"
            w.syntaxErrors[errorKey] = coverageAdd(
                ref w,
                as: coverageErrorPath,
                at: span,
                function: name,
                variant: variant,
                origin: kind,
            )
        }
        ids.append(ErrorProbeVariant { variant: v, id: w.syntaxErrors[errorKey] })
    }
    if ids.length > 0 {
        w.errors[origin] = BoundErrorProbe { span: span, variants: move ids }
    }
}

/// CoverageInstrumenter.cs:194 `Add`.
i64 coverageAdd(
    ref CoverageWalker w,
    as string kind,
    at TextSpan span,
    string? function = null,
    string? variant = null,
    string? origin = null,
    bool? outcome = null
) uses alloc {
    let pos = w.source.getLinePosition(span.start)
    w.counters.append(CoverageCounter {
        id: w.counters.length, kind: kind, file: w.source.path, line: pos.line, column: pos.column,
        function: function, variant: variant, origin: origin, outcome: outcome,
    })
    return w.counters.length - 1
}
== emitter/cprint/builtin.byn
// T11: CEmitter.cs 1946-2454 (`Builtin`, `Unary`, `BareCase`, `Binary`, `Op`, `Conversion`, `Index`, `Slice`).
// A C# `_c.Helper(name, proto, () => body)` whose body reads only text built before it is `helper` with the body
// built first (common.byn:170). A C# `throw new InvalidOperationException(m)` is `panic(m)`.

import semantics
import parser
import emitter.ltree

/// CEmitter.cs:1617 `Expr`, as `Builtin` and the operators call it.
string t11Expr(ref CCtx cc, for ref CFunc f, from ref Ctx c, through in ltree.LTree t, at BExpr e) uses alloc {
    return emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: e)
}

/// CEmitter.cs:1946 `FunctionEmitter.Builtin` (Q846): the C text of builtin call `call`.
public string emitBuiltin(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr call)
        uses alloc {
    let bi = i64(call & 0xFFFFFFFF)
    let r = c.bBuiltinCalls[bi].receiver
    let member = c.bBuiltinCalls[bi].member
    let bType = c.bBuiltinCalls[bi].type
    let syntax = c.bBuiltinCalls[bi].span
    var args = List<BExpr>()
    for a in c.bBuiltinCalls[bi].arguments {
        args.append(a)
    }
    let rt = ltree.typeOf(in c, through: in t, for: r)
    let ri = i64(rt & 0xFFFFFFFF)
    let arg = args.length > 0 ? t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[0]) : ""
    switch member {
        case .stringLength or .spanLength or .listLength or .strBufLength:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.len"
        case .stringIsEmpty or .spanIsEmpty or .listIsEmpty:
            return $"({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.len == 0)"
        case .stringRuneCount:
            return $"byn_str_rune_count({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .stringIsAscii:
            return $"byn_str_is_ascii({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .stringBytes:
            let span = cType(ref cc, from: ref c, for: bType)
            let name = helper(
                ref cc,
                for: "bynh_str_bytes",
                from: $"static {span} bynh_str_bytes(byn_str s)",
                as: $"{{\n    return ({span}){{(uint8_t*)s.ptr, s.len}};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .stringCopy:
            return $"byn_str_copy({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {args.length > 0 ? $"byn_arena_alloc({arg})" : "byn_context"})"
        case .stringStartsWith:
            return $"byn_str_starts_with({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringEndsWith:
            return $"byn_str_ends_with({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringContains:
            return $"byn_str_contains({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringPosition or .stringLastPosition:
            let opt = cType(ref cc, from: ref c, for: bType)
            let name = helper(
                ref cc,
                for: "bynh_position",
                from: $"static {opt} bynh_position(int64_t p)",
                as: $"{{\n    return p < 0 ? ({opt}){{0}} : ({opt}){{true, p}};\n}}\n",
            )
            return $"{name}(byn_str_last_position({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg}))" if member == .stringLastPosition
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            let from = args.length > 1 ? t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1]) : "0"
            return $"{name}(byn_str_position({rv}, {arg}, {from}, {loc(in c, by: in f, at: syntax)}))"
        case .stringCount:
            return $"byn_str_count({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringTrimmed:
            return $"byn_str_trimmed({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {args.length > 0 ? arg : "2"})"
        case .stringTrimmedBy:
            let st = cType(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: args[0]))
            let name = helper(
                ref cc,
                for: "bynh_trimmed_by",
                from: $"static byn_str bynh_trimmed_by(byn_str s, {st} by)",
                as: "{\n    return byn_str_trimmed_by(s, by.ptr, by.len);\n}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringLowercased or .stringUppercased:
            return $"byn_str_case({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {member == .stringUppercased ? "true" : "false"}, byn_context)"
        case .stringEquals:
            if args.length > 1 {
                let caseless = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])
                let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
                let rv2 = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
                return $"({caseless} == 1 ? byn_str_eq_caseless({rv}, {arg}) : byn_str_eq({rv2}, {arg}))"
            }
            return $"byn_str_eq({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringReplaced:
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            return $"byn_str_replaced({rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, byn_context, {loc(in c, by: in f, at: syntax)})"
        case .stringRepeated:
            return $"byn_str_repeated({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg}, byn_context, {loc(in c, by: in f, at: syntax)})"
        case .stringPadded:
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            return $"byn_str_padded({rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, byn_context, {loc(in c, by: in f, at: syntax)})"
        case .bytesToString:
            let st = cType(ref cc, from: ref c, for: rt)
            let name = $"bynh_bytes_string_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static byn_str {name}({st} b)",
                as: "{\n    return byn_bytes_string(b.ptr, b.len, byn_context);\n}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .intTryParse:
            let opt = cType(ref cc, from: ref c, for: bType)
            let inner = c.optionalTypes[i64(bType & 0xFFFFFFFF)]
            let p = semantics.primKindOf(i64(inner & 0xFFFFFFFF))
            let name = $"bynh_try_parse_{key(ref c, for: bType)}"
            let signed = semantics.isSignedInteger(inner) ? "true" : "false"
            let it = cType(ref cc, from: ref c, for: inner)
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {opt} {name}(byn_str s, byn_builtin_Radix radix)",
                as: $"{{\n    int64_t v;\n    if (!byn_int_parse(s, {semantics.primitiveBits(p)}, {signed}, radix, &v)) return ({opt}){{0}};\n    return ({opt}){{true, ({it})v}};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .floatTryParse:
            let opt = cType(ref cc, from: ref c, for: bType)
            let inner = c.optionalTypes[i64(bType & 0xFFFFFFFF)]
            let name = $"bynh_try_parse_{key(ref c, for: bType)}"
            let f32 = inner == semantics.prim(.f32) ? "true" : "false"
            let it = cType(ref cc, from: ref c, for: inner)
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {opt} {name}(byn_str s)",
                as: $"{{\n    double v;\n    if (!byn_float_parse(s, {f32}, &v)) return ({opt}){{0}};\n    return ({opt}){{true, ({it})v}};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .stringJoined:
            let xt = cType(ref cc, from: ref c, for: rt)
            let name = $"bynh_joined_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static byn_str {name}({xt} xs, byn_str sep)",
                as: "{\n    return byn_str_joined(xs.ptr, xs.len, sep, byn_context);\n}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .stringRunes or .stringUtf16 or .stringLines:
            return $"((byn_text_view){{{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {{NULL, 0}}, 0, 0}})"
        case .stringParts:
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            let limit = args.length > 1 ? t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1]) : "0"
            return $"byn_parts({rv}, {arg}, {limit}, {loc(in c, by: in f, at: syntax)})"
        case .stringPartsRune:
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            let limit = args.length > 1 ? t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1]) : "0"
            return $"byn_parts_rune({rv}, {arg}, {limit}, {loc(in c, by: in f, at: syntax)})"
        case .runesTake:
            return $"byn_str_take_runes({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.s, {arg}, {loc(in c, by: in f, at: syntax)})"
        case .runesSkip:
            return $"byn_str_skip_runes({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.s, {arg}, {loc(in c, by: in f, at: syntax)})"
        case .runesTakeLast:
            return $"byn_str_take_last_runes({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.s, {arg}, {loc(in c, by: in f, at: syntax)})"
        case .utf16Copy:
            let list = cType(ref cc, from: ref c, for: bType)
            let name = helper(
                ref cc,
                for: "bynh_utf16_copy",
                from: $"static {list} bynh_utf16_copy(byn_text_view v)",
                as: $"{{\n    {list} r = {{NULL, 0, 0, byn_context}};\n    r.ptr = byn_utf16_copy(v.s, &r.len, byn_context);\n    r.cap = r.len;\n    return r;\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .textViewMore:
            return $"byn_view_more({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg}, {ri})"
        case .textViewNext:
            switch semantics.textViewKindOf(ri) {
                case .runes: return $"byn_str_next({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.s, &{arg})"
                case .utf16: return $"byn_utf16_next(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, &{arg})"
                case .lines: return $"byn_lines_next(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, &{arg})"
                default: return $"byn_parts_next(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, &{arg})"
            }
        case .spanCopy:
            let list = cType(ref cc, from: ref c, for: bType)
            let st = cType(ref cc, from: ref c, for: rt)
            let et = cType(ref cc, from: ref c, for: c.spanTypes[ri].element)
            let name = $"bynh_copy_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {list} {name}({st} s, byn_alloc* a)",
                as: $"{{\n    {list} r = {{NULL, 0, 0, a}};\n    if (s.len > 0) {{\n        r.ptr = ({et}*)byn_copy_bytes(s.ptr, s.len * (int64_t)sizeof({et}), a);\n        r.len = r.cap = s.len;\n    }}\n    return r;\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {args.length > 0 ? $"byn_arena_alloc({arg})" : "byn_context"})"
        case .listCopy:
            let lt = cType(ref cc, from: ref c, for: rt)
            let et = cType(ref cc, from: ref c, for: c.listTypes[ri])
            let name = $"bynh_copy_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {lt} {name}({lt} l, byn_alloc* a)",
                as: $"{{\n    {lt} r = {{NULL, 0, 0, a}};\n    if (l.len > 0) {{\n        r.ptr = ({et}*)byn_copy_bytes(l.ptr, l.len * (int64_t)sizeof({et}), a);\n        r.len = r.cap = l.len;\n    }}\n    return r;\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {args.length > 0 ? $"byn_arena_alloc({arg})" : "byn_context"})"
        case .strBufCopy:
            return $"byn_strbuf_copy({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, byn_arena_alloc({arg}))"
        case .listAdd:
            let lt = cType(ref cc, from: ref c, for: rt)
            let et = cType(ref cc, from: ref c, for: c.listTypes[ri])
            let name = $"bynh_add_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static void {name}({lt}* l, {et} v)",
                as: $"{{\n    if (!l->alloc) l->alloc = byn_context;\n    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof({et}), l->alloc);\n    l->ptr[l->len++] = v;\n}}\n",
            )
            let text = $"{name}(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
            return claimed(ref cc, for: ref f, from: ref c, through: t, at: text, by: r, to: syntax)
        case .listAsSpan:
            let lt = cType(ref cc, from: ref c, for: rt)
            let st = cType(ref cc, from: ref c, for: bType)
            let name = $"bynh_span_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {st} {name}({lt} l)",
                as: $"{{\n    return ({st}){{l.ptr, l.len}};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .listMutableSpan:
            let lt = cType(ref cc, from: ref c, for: rt)
            let st = cType(ref cc, from: ref c, for: bType)
            let name = $"bynh_mutable_span_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {st} {name}({lt} l)",
                as: $"{{\n    return ({st}){{l.ptr, l.len}};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .listClear or .strBufClear:
            return $"({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.len = 0)"
        case .listRemoveLast:
            let lt = cType(ref cc, from: ref c, for: rt)
            let et = cType(ref cc, from: ref c, for: bType)
            let name = $"bynh_pop_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {et} {name}({lt}* l, const char* file, int line)",
                as: "{\n    if (l->len == 0) byn_panic(\"removeLast on an empty list\", file, line);\n    return l->ptr[--l->len];\n}\n",
            )
            return $"{name}(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {loc(in c, by: in f, at: syntax)})"
        case .listTryGet:
            let lt = cType(ref cc, from: ref c, for: rt)
            let opt = cType(ref cc, from: ref c, for: bType)
            let name = $"bynh_try_get_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {opt} {name}({lt} l, int64_t i)",
                as: $"{{\n    return i < 0 || i >= l.len ? ({opt}){{0}} : ({opt}){{true, l.ptr[i]}};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .listRemoveRange:
            let lt = cType(ref cc, from: ref c, for: rt)
            let name = $"bynh_remove_range_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static void {name}({lt}* l, int64_t start, int64_t end, const char* file, int line)",
                as: "{\n    byn_slice_check(start, end, l->len, file, line);\n    if (end > start) memmove(l->ptr + start, l->ptr + end, (size_t)(l->len - end) * sizeof(*l->ptr));\n    l->len -= end - start;\n}\n",
            )
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            return $"{name}(&{rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, {loc(in c, by: in f, at: syntax)})"
        case .listRemoveThrough or .listRemoveAt or .listRemoveAtRange:
            // `through:` is an inclusive end and `at: i` removes one element (mode 1 and 2; mode 0 is `until`).
            let lt = cType(ref cc, from: ref c, for: rt)
            let name = $"bynh_remove_through_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static void {name}({lt}* l, int64_t start, int64_t end, int mode, const char* file, int line)",
                as: "{\n    if (mode == 2) {\n        if (start < 0 || start >= l->len) bayan_trap_bounds(file, line);\n        end = start;\n    }\n    if (mode != 0) {\n        byn_slice_check(start, end, l->len - 1, file, line);\n        end++;\n    }\n    byn_slice_check(start, end, l->len, file, line);\n    if (end > start) memmove(l->ptr + start, l->ptr + end, (size_t)(l->len - end) * sizeof(*l->ptr));\n    l->len -= end - start;\n}\n",
            )
            if member == .listRemoveThrough {
                let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
                return $"{name}(&{rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, 1, {loc(in c, by: in f, at: syntax)})"
            }
            return $"{name}(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg}, 0, 2, {loc(in c, by: in f, at: syntax)})" if member == .listRemoveAt
            // `at: a..b` or `at: a..=b` reads the range's layout tuple (start, end, inclusive).
            let range = $"bynh_remove_at_range_{key(ref c, for: rt)}"
            let at = cType(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: args[0]))
            let _ = helper(
                ref cc,
                for: range,
                from: $"static void {range}({lt}* l, {at} at, const char* file, int line)",
                as: $"{{\n    {name}(l, at.item1, at.item2, at.item3 ? 1 : 0, file, line);\n}}\n",
            )
            return $"{range}(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg}, {loc(in c, by: in f, at: syntax)})"
        case .listReplace:
            let lt = cType(ref cc, from: ref c, for: rt)
            let name = $"bynh_replace_{key(ref c, for: rt)}"
            let at = cType(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: args[0]))
            let items = cType(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: args[1]))
            let _ = helper(
                ref cc,
                for: name,
                from: $"static void {name}({lt}* l, {at} at, {items} items, const char* file, int line)",
                as: "{\n    int64_t start = at.item1, end = at.item3 ? at.item2 + 1 : at.item2;\n    byn_slice_check(start, end, l->len, file, line);\n    int64_t len = l->len - (end - start) + items.len;\n    if (!l->alloc) l->alloc = byn_context;\n    void* copy = NULL;\n    if (items.len > 0 && items.ptr >= l->ptr && items.ptr < l->ptr + l->cap)\n        items.ptr = copy = byn_copy_bytes(items.ptr, items.len * (int64_t)sizeof(*l->ptr), l->alloc);\n    byn_list_reserve((void**)&l->ptr, &l->cap, len, (int64_t)sizeof(*l->ptr), l->alloc);\n    memmove(l->ptr + start + items.len, l->ptr + end, (size_t)(l->len - end) * sizeof(*l->ptr));\n    if (items.len > 0) memcpy(l->ptr + start, items.ptr, (size_t)items.len * sizeof(*l->ptr));\n    l->len = len;\n    if (copy) byn_release(l->alloc, copy);\n}\n",
            )
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            return $"{name}(&{rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, {loc(in c, by: in f, at: syntax)})"
        case .listSort:
            let element = c.listTypes[ri]
            let et = cType(ref cc, from: ref c, for: element)
            let ek = key(ref c, for: element)
            let lessBody = semantics.isString(
                element,
            ) ? "{\n    return byn_str_cmp(*(const byn_str*)a, *(const byn_str*)b) < 0;\n}\n" : $"{{\n    return *(const {et}*)a < *(const {et}*)b;\n}}\n"
            let less = helper(
                ref cc,
                for: $"bynh_less_{ek}",
                from: $"static bool bynh_less_{ek}(const void* a, const void* b)",
                as: lessBody,
            )
            // The list is read once, through a pointer, so a receiver with side effects runs once.
            let lt = cType(ref cc, from: ref c, for: rt)
            let rk = key(ref c, for: rt)
            let name = helper(
                ref cc,
                for: $"bynh_sort_{rk}",
                from: $"static void bynh_sort_{rk}({lt}* l)",
                as: $"{{\n    byn_sort(l->ptr, l->len, sizeof(*l->ptr), {less});\n}}\n",
            )
            return $"{name}(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .mapLength:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.h.live"
        case .symbolText:
            return symbolText(ref cc, for: t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r))
        case .mapClear:
            return $"byn_map_clear(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.h)"
        case .mapSlotCount:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.h.len"
        case .mapSlotLive:
            return $"(!{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.h.dead[{arg}])"
        case .mapSlotEntry:
            let m = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            return $"(({cType(ref cc, from: ref c, for: bType)}){{{m}.keys[{arg}], {m}.vals[{arg}]}})"
        case .mapCopy:
            let mt = cType(ref cc, from: ref c, for: rt)
            let kt = cType(ref cc, from: ref c, for: c.mapTypes[ri].key)
            let vt = cType(ref cc, from: ref c, for: c.mapTypes[ri].value)
            let name = $"bynh_copy_{key(ref c, for: rt)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {mt} {name}({mt} m, byn_alloc* a)",
                as: $"{{\n    {mt} r;\n    byn_map_copy(&m.h, m.keys, (int64_t)sizeof({kt}), (void**)&r.keys, m.vals, (int64_t)sizeof({vt}), (void**)&r.vals, &r.h, a);\n    return r;\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, byn_arena_alloc({arg}))"
        case .mapIndex or .mapIndexSet or .mapSlot or .mapTryGet or .mapContains or .mapRemove:
            let m = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            var cargs = List<string>()
            for a in args {
                cargs.append(t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: a))
            }
            return mapMethod(
                ref cc,
                from: ref c,
                for: member,
                as: rt,
                at: m,
                by: cargs,
                to: loc(in c, by: in f, at: syntax),
            )
        case .arrayLength:
            return $"((void){t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, INT64_C({c.arrayTypes[ri].length}))"
        case .arrayAsSpan or .arrayMutableSpan:
            let st = cType(ref cc, from: ref c, for: bType)
            return $"(({st}){{{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.v, {c.arrayTypes[ri].length}}})"
        case .arenaReset:
            return $"byn_arena_reset({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .strBufAppend:
            let text = $"byn_w_str(&{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
            return claimed(ref cc, for: ref f, from: ref c, through: t, at: text, by: r, to: syntax)
        case .strBufAppendRepeated:
            let name = helper(
                ref cc,
                for: "bynh_strbuf_repeat",
                from: "static void bynh_strbuf_repeat(byn_writer* w, uint32_t c, int64_t n, const char* file, int line)",
                as: "{\n    if (n < 0) byn_panic(\"repeated a negative number of times\", file, line);\n    for (int64_t i = 0; i < n; i++) byn_w_char(w, c);\n}\n",
            )
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            let text = $"{name}(&{rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, {loc(in c, by: in f, at: syntax)})"
            return claimed(ref cc, for: ref f, from: ref c, through: t, at: text, by: r, to: syntax)
        case .strBufInsert:
            // Appends the text, then rotates it into place by three reversals; text the buffer grew away from stays valid.
            let _ = helper(
                ref cc,
                for: "bynh_reverse",
                from: "static void bynh_reverse(uint8_t* p, int64_t n)",
                as: "{\n    for (int64_t i = 0, j = n - 1; i < j; i++, j--) {\n        uint8_t t = p[i];\n        p[i] = p[j];\n        p[j] = t;\n    }\n}\n",
            )
            let name = helper(
                ref cc,
                for: "bynh_strbuf_insert",
                from: "static void bynh_strbuf_insert(byn_writer* w, byn_str s, int64_t at, const char* file, int line)",
                as: "{\n    byn_slice_check(at, w->len, w->len, file, line);\n    if (at < w->len && (w->buf[at] & 0xC0) == 0x80) byn_panic(\"string slice splits a code point\", file, line);\n    int64_t end = w->len;\n    byn_w_bytes(w, s.ptr, s.len);\n    bynh_reverse(w->buf + at, end - at);\n    bynh_reverse(w->buf + end, s.len);\n    bynh_reverse(w->buf + at, end - at + s.len);\n}\n",
            )
            let rv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)
            let text = $"{name}(&{rv}, {arg}, {t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: args[1])}, {loc(in c, by: in f, at: syntax)})"
            return claimed(ref cc, for: ref f, from: ref c, through: t, at: text, by: r, to: syntax)
        case .ioWrite:
            return $"byn_io_write({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {arg})"
        case .ioReadAll:
            let res = cType(ref cc, from: ref c, for: bType)
            let name = helper(
                ref cc,
                for: "bynh_io_read_all",
                from: $"static {res} bynh_io_read_all(int32_t fd)",
                as: $"{{\n    (void)fd;\n    {res} r = {{0}};\n    r.err.code = byn_io_read_stdin(&r.value, byn_context);\n    return r;\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .strBufAsString:
            return $"byn_strbuf_str({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .panicMessage:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.message"
        case .processExitCode:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.exit_code"
        case .timeNanos:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.nanos"
        case .formatSpecRadix
            or .formatSpecDebug
            or .formatSpecWidth
            or .formatSpecFill
            or .formatSpecAlign
            or .formatSpecDigits:
            let field = $"{member}"[10..].lowercased()
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.{field}"
        case .processStdout:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.out"
        case .processStderr:
            return $"{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.err"
        case .charValue:
            return $"((uint32_t){t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .intToString:
            let p = semantics.primKindOf(ri)
            let signed = semantics.isSignedInteger(rt) ? "true" : "false"
            return $"byn_int_string((int64_t){t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {semantics.primitiveBits(p)}, {signed}, {arg}, byn_context)"
        case .enumName:
            let names = enumNames(ref cc, from: ref c, for: ri)
            return $"{names}[{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}]"
        case .enumOrdinal:
            return $"((int32_t){t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .enumField:
            let ordinal = i64(c.bLiterals[i64(args[0] & 0xFFFFFFFF)].value.integer.lo)
            let names = enumField(ref cc, from: ref c, for: c.enums[ri].fields[ordinal])
            return $"{names}[{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}]"
        case .resultIsOk:
            return $"({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}.err.code == 0)"
        case .ownedValue:
            return $"(*{t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)})"
        case .resultValue or .resultError:
            let value = member == .resultValue
            let res = cType(ref cc, from: ref c, for: rt)
            let name = $"{value ? "bynh_value_" : "bynh_error_"}{key(ref c, for: rt)}"
            let message = value ? "result holds an error" : "result holds a value"
            let check = value ? "r.err.code" : "!r.err.code"
            let field = value ? "r.value" : "r.err"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {cType(ref cc, from: ref c, for: bType)} {name}({res} r, const char* file, int line)",
                as: $"{{\n    if ({check}) byn_panic(\"{message}\", file, line);\n    return {field};\n}}\n",
            )
            return $"{name}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: r)}, {loc(in c, by: in f, at: syntax)})"
        default:
            panic($"cannot emit {csName($"{member}")}")
    }
}

/// The C# name of a selfhost enum case that is the C# member with its first letter lowered (`listTake` → `ListTake`);
/// every `BuiltinMember`, `BinaryOp` and `ConversionKind` case is (Q812).
string csName(string name) uses alloc {
    return $"{rune(name.bytes[0] - 0x20)}{name[1..]}"
}

/// CEmitter.cs:2296 `Unary` (Q845): the C text of unary operation `e`.
public string unary(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr e) uses alloc {
    let u = i64(e & 0xFFFFFFFF)
    let op = c.bUnaries[u].op
    let type = c.bUnaries[u].type
    let span = c.bUnaries[u].span
    let v = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: c.bUnaries[u].operand)
    switch op {
        case .plus: return v
        case .negate:
            return $"byn_neg_{intSuffix(type)}({v}, {loc(in c, by: in f, at: span)})" if semantics.isInteger(type)
            return $"(-{v})"
        case .notKeyword: return $"(!{v})"
        case .complement: return $"(({cType(ref cc, from: ref c, for: type)})~{v})"
        // coverage-exempt: Q812
        default: panic($"cannot emit unary {csName($"{op}")}")
    }
}

/// CEmitter.cs:2310 `BareCase`: an error case with fields written without its payload, under any conversions.
bool bareCase(in Ctx c, for BExpr e) {
    return false if ltree.isLowered(e)
    let i = i64(e & 0xFFFFFFFF)
    switch semantics.boundKind(e) {
        case .errorVariant: return c.bErrorVariants[i].payload.length == 0
            && c.errorVariants[c.bErrorVariants[i].variant].fields.length > 0
        case .conversion: return bareCase(in c, for: c.bConversions[i].operand)
        default: return false
    }
}

/// CEmitter.cs:2317 `Binary` (Q845): the C text of binary operation `e`.
public string binary(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr e) uses alloc {
    let bi = i64(e & 0xFFFFFFFF)
    let op = c.bBinaries[bi].op
    let left = c.bBinaries[bi].left
    let right = c.bBinaries[bi].right
    let span = c.bBinaries[bi].span
    let l = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: left)
    let r = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: right)
    let type = ltree.typeOf(in c, through: in t, for: left)
    if semantics.isInteger(type) {
        let n = intSuffix(type)
        switch op {
            case .add: return $"byn_add_{n}({l}, {r}, {loc(in c, by: in f, at: span)})"
            case .sub: return $"byn_sub_{n}({l}, {r}, {loc(in c, by: in f, at: span)})"
            case .mul: return $"byn_mul_{n}({l}, {r}, {loc(in c, by: in f, at: span)})"
            case .div: return $"byn_div_{n}({l}, {r}, {loc(in c, by: in f, at: span)})"
            case .rem: return $"byn_rem_{n}({l}, {r}, {loc(in c, by: in f, at: span)})"
            case .addWrap: return $"byn_addw_{n}({l}, {r})"
            case .subWrap: return $"byn_subw_{n}({l}, {r})"
            case .mulWrap: return $"byn_mulw_{n}({l}, {r})"
            case .addSat: return $"byn_adds_{n}({l}, {r})"
            case .subSat: return $"byn_subs_{n}({l}, {r})"
            case .mulSat: return $"byn_muls_{n}({l}, {r})"
            case .shl: return $"byn_shl_{n}({l}, (int64_t)({r}))"
            case .shr: return $"byn_shr_{n}({l}, (int64_t)({r}))"
            case .bitAnd: return $"(({cType(ref cc, from: ref c, for: type)})({l} & {r}))"
            case .bitOr: return $"(({cType(ref cc, from: ref c, for: type)})({l} | {r}))"
            case .bitXor: return $"(({cType(ref cc, from: ref c, for: type)})({l} ^ {r}))"
            default: {}
        }
    }
    return type == semantics.prim(.f32) ? $"fmodf({l}, {r})" : $"fmod({l}, {r})" if semantics.isFloat(type)
        && op == .rem
    let ordering = op is .lt or .gt or .le or .ge
    return $"(byn_str_cmp({l}, {r}) {opText(op)} 0)" if semantics.isString(type) && ordering
    // Symbols order by text, as `string` does (R1).
    if type == semantics.builtinType(.symbol) && ordering {
        let a = symbolText(ref cc, for: l)
        let b = symbolText(ref cc, for: r)
        return $"(byn_str_cmp({a}, {b}) {opText(op)} 0)"
    }
    // `== .case` with a payload case written bare tests the code (Q312).
    return $"({l}.code {op == .eq ? "==" : "!="} {r}.code)" if (op is .eq or .ne) && (bareCase(in c, for: left)
        || bareCase(in c, for: right))
    switch op {
        case .eq: return equalHelper(ref cc, from: ref c, for: type, at: l, to: r)
        case .ne: return $"(!{equalHelper(ref cc, from: ref c, for: type, at: l, to: r)})"
        default: return $"({l} {opText(op)} {r})"
    }
}

/// CEmitter.cs:2362 `Op`: the C operator of `op`.
string opText(parser.BinaryOp op) uses alloc {
    switch op {
        case .add: return "+"
        case .sub: return "-"
        case .mul: return "*"
        case .div: return "/"
        case .lt: return "<"
        case .gt: return ">"
        case .le: return "<="
        case .ge: return ">="
        case .bitAnd: return "&"
        case .bitOr: return "|"
        case .bitXor: return "^"
        case .logicalAnd: return "&&"
        case .logicalOr: return "||"
        // coverage-exempt: Q812
        default: panic($"no C operator for {csName($"{op}")}")
    }
}

/// CEmitter.cs:2371 `Conversion` (Q845): the C text of conversion `e`.
public string conversion(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr e) uses alloc {
    let ci = i64(e & 0xFFFFFFFF)
    let kind = c.bConversions[ci].kind
    let to = c.bConversions[ci].type
    let span = c.bConversions[ci].span
    let operand = c.bConversions[ci].operand
    let v = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: operand)
    let from = ltree.typeOf(in c, through: in t, for: operand)
    switch kind {
        case .identity or .fromNever: return v
        case .widen: return $"(({cType(ref cc, from: ref c, for: to)}){v})"
        default: {}
    }
    return $"byn_f2i_{intSuffix(to)}((double){v})" if kind == .numericCast
        && semantics.isInteger(to)
        && semantics.isFloat(from)
    if (kind is .numericCast or .charToInteger) && semantics.isInteger(to) {
        return $"byn_cast_{intSuffix(to)}_i((int64_t){v}, {loc(in c, by: in f, at: span)})" if semantics.isSignedInteger(
            from,
        )
        return $"byn_cast_{intSuffix(to)}_u((uint64_t){v}, {loc(in c, by: in f, at: span)})"
    }
    switch kind {
        case .numericCast: return $"(({cType(ref cc, from: ref c, for: to)}){v})"
        case .integerToChar:
            return $"byn_to_char((int64_t){v}, {loc(in c, by: in f, at: span)})" if semantics.isSignedInteger(from)
            return $"byn_to_char_u((uint64_t){v}, {loc(in c, by: in f, at: span)})"
        case .toOptional: return $"(({cType(ref cc, from: ref c, for: to)}){{true, {v}}})"
        // coverage-exempt: Q812
        case .nullToOptional: return $"(({cType(ref cc, from: ref c, for: to)}){{0}})"
        case .toResult: return $"(({cType(ref cc, from: ref c, for: to)}){{{{0}}, {v}}})"
        case .errorToResult: return $"(({cType(ref cc, from: ref c, for: to)}){{{v}}})"
        case .listToSpan: return $"(({cType(ref cc, from: ref c, for: to)}){{{v}.ptr, {v}.len}})"
        case .stringToBytes: return $"(({cType(ref cc, from: ref c, for: to)}){{(uint8_t*){v}.ptr, {v}.len}})"
        case .arrayToSpan: return $"(({cType(ref cc, from: ref c, for: to)}){{{v}.v, {c.arrayTypes[i64(from & 0xFFFFFFFF)].length}}})"
        case .toDynRef:
            let ct = cType(ref cc, from: ref c, for: to)
            let vt = vtable(
                ref cc,
                from: ref c,
                for: i64(from & 0xFFFFFFFF),
                as: c.dynRefTypes[i64(to & 0xFFFFFFFF)].iface,
            )
            return $"(({ct}){{&{v}, &{vt}}})"
        // coverage-exempt: Q812
        default: panic($"cannot emit conversion {csName($"{kind}")}")
    }
}

/// CEmitter.cs:2415 `Index` (Q845): the C text of index expression `e`.
public string index(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr e) uses alloc {
    let ii = i64(e & 0xFFFFFFFF)
    let target = c.bIndexes[ii].target
    let targetType = ltree.typeOf(in c, through: in t, for: target)
    let et = cType(ref cc, from: ref c, for: c.bIndexes[ii].type)
    let tt = cType(ref cc, from: ref c, for: targetType)
    let name = $"bynh_at_{key(ref c, for: targetType)}"
    let fromEnd = c.bIndexes[ii].fromEnd ? "true" : "false"
    if semantics.kindOf(targetType) == .array {
        let length = c.arrayTypes[i64(targetType & 0xFFFFFFFF)].length
        let _ = helper(
            ref cc,
            for: name,
            from: $"static {et}* {name}({tt}* a, int64_t i, bool from_end, const char* file, int line)",
            as: $"{{\n    if (from_end) i = {length} - i;\n    return &a->v[byn_index(i, {length}, file, line)];\n}}\n",
        )
        let tv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: target)
        let iv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: c.bIndexes[ii].index)
        return $"(*{name}(&{tv}, (int64_t){iv}, {fromEnd}, {loc(in c, by: in f, at: c.bIndexes[ii].span)}))"
    }
    let _ = helper(
        ref cc,
        for: name,
        from: $"static {et}* {name}({tt} s, int64_t i, bool from_end, const char* file, int line)",
        as: "{\n    if (from_end) i = s.len - i;\n    return &s.ptr[byn_index(i, s.len, file, line)];\n}\n",
    )
    let tv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: target)
    let iv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: c.bIndexes[ii].index)
    return $"(*{name}({tv}, (int64_t){iv}, {fromEnd}, {loc(in c, by: in f, at: c.bIndexes[ii].span)}))"
}

/// CEmitter.cs:2432 `Slice` (Q845): the C text of slice expression `e`.
public string slice(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr e) uses alloc {
    let si = i64(e & 0xFFFFFFFF)
    let target = c.bSlices[si].target
    var start = "0, 2"
    if c.bSlices[si].start != -1 {
        start = $"(int64_t){t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: c.bSlices[si].start)}, {c.bSlices[si].startFromEnd ? 1 : 0}"
    }
    var end = "0, 2"
    if c.bSlices[si].end != -1 {
        end = $"(int64_t){t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: c.bSlices[si].end)}, {c.bSlices[si].endFromEnd ? 1 : 0}"
    }
    let tail = $"{start}, {end}, {c.bSlices[si].inclusive ? "true" : "false"}, {loc(in c, by: in f, at: c.bSlices[si].span)}"
    let targetType = ltree.typeOf(in c, through: in t, for: target)
    if semantics.isString(targetType) {
        let str = helper(
            ref cc,
            for: "bynh_slice_str",
            from: "static byn_str bynh_slice_str(byn_str s, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line)",
            as: "{\n    int64_t from, to;\n    byn_slice_range(s.len, a, am, b, bm, incl, file, line, &from, &to);\n    return byn_str_slice(s, from, to, file, line);\n}\n",
        )
        return $"{str}({t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: target)}, {tail})"
    }
    let st = cType(ref cc, from: ref c, for: c.bSlices[si].type)
    let tt = cType(ref cc, from: ref c, for: targetType)
    let name = $"bynh_slice_{key(ref c, for: targetType)}"
    let isArray = semantics.kindOf(targetType) == .array
    let param = isArray ? $"{tt}* x" : $"{tt} x"
    let len = isArray ? $"{c.arrayTypes[i64(targetType & 0xFFFFFFFF)].length}" : "x.len"
    let ptr = isArray ? "x->v" : "x.ptr"
    let tv = t11Expr(ref cc, for: ref f, from: ref c, through: in t, at: target)
    let arg = isArray ? $"&{tv}" : tv
    let _ = helper(
        ref cc,
        for: name,
        from: $"static {st} {name}({param}, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line)",
        as: $"{{\n    int64_t from, to;\n    byn_slice_range({len}, a, am, b, bm, incl, file, line, &from, &to);\n    return ({st}){{{ptr} + from, to - from}};\n}}\n",
    )
    return $"{name}({arg}, {tail})"
}
