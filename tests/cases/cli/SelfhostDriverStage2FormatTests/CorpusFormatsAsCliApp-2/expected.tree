// T9: CEmitter.cs 1173-1236 (constructor, `Signature`, `Emit`), 1254-1616 (statements, ownership checks); D3's
// `Count` (:1481-1482) is not ported. `_sb` is a `ref StrBuf` beside the frame (`CFunc`, cctx.byn), and C#'s
// `_sb.Length = mark` is `t9Truncate`.

import semantics
import emitter.ltree

type TupleField  = semantics.TupleField
type TextSpan    = semantics.TextSpan
type LocalId     = semantics.LocalId
type FuncId      = semantics.FuncId
type BStmt       = semantics.BStmt
type BFormatSpec = semantics.BFormatSpec

/// CEmitter.cs:166 `ResetLine` (T6's range; Q798).
const t9ResetLine: string = "#line generated"

// ── Frame ────────────────────────────────────────────────────────────────────

/// CEmitter.cs:1173 `FunctionEmitter`'s constructor: the frame of `f`, its locals named.
public CFunc functionEmitter(ref CCtx cc, from ref Ctx c, for in ltree.LoweredFunction f) uses alloc {
    let fn = f.symbol
    var fe = CFunc { fn: fn }
    fe.file = fileName(ref cc, from: ref c, for: fn)
    fe.linePath = c.functions[fn].file == -1 ? null : cString(filePath(ref cc, from: ref c, for: fn))
    let parameters = t9Copy(c.functions[fn].parameters)
    for p in parameters {
        fe.names[p] = $"p_{c.locals[p].name}"
    }
    // Q1: round 4 redoes this (CEmitter.cs:1181-1186).
    // A lambda reads each capture from its environment tuple (spec 007 R13).
    let captures = t9Copy(c.functions[fn].captures)
    if captures.length > 0 {
        var fields = List<TupleField>()
        for l in captures {
            fields.append(TupleField { name: null, type: c.locals[l].type })
        }
        let env = cType(ref cc, from: ref c, for: semantics.internTuple(ref c, for: in fields))
        for i in 0..captures.length {
            fe.names[captures[i]] = $"(({env}*)env)->item{i + 1}"
        }
    }
    var n: i64 = 0
    for l in f.locals {
        fe.names[l] = c.locals[l].kind == .temp ? $"t{n}" : $"l{n}_{c.locals[l].name}"
        n += 1
    }
    return fe
}

/// CEmitter.cs:1192 `ReturnsValue`.
bool returnsValue(Ctx c, by FuncId fn) {
    let r = c.functions[fn].returnType
    // coverage-exempt: Q800
    return !semantics.isVoid(r) && !semantics.isNever(r) && c.functions[fn].kind != .constructor
}

/// CEmitter.cs:1194 `FunctionEmitter.Signature` (Q845): the C declarator of `f`, after the frame the constructor (:1173) builds.
public string signature(ref CCtx cc, from ref Ctx c, through ltree.LTree t, for ltree.LoweredFunction f) uses alloc {
    let fe = functionEmitter(ref cc, from: ref c, for: in f)
    return frameSignature(ref cc, for: fe, from: ref c)
}

/// CEmitter.cs:1194 `Signature` on a built frame.
string frameSignature(ref CCtx cc, for CFunc fe, from ref Ctx c) uses alloc {
    let fn = fe.fn
    let kind = c.functions[fn].kind
    let hasFails = c.functions[fn].hasFails
    var result = ""
    if hasFails {
        result = errorCType(ref cc, from: ref c)
    } else if kind == .constructor {
        result = cType(ref cc, from: ref c, for: semantics.structTypeOf(c.functions[fn].owner))
    } else {
        result = cType(ref cc, from: ref c, for: c.functions[fn].returnType)
    }
    var ps = List<string>()
    // Q1: round 4 redoes this (CEmitter.cs:1201).
    if kind == .lambda {
        ps.append("void* env")
    }
    if semantics.functionHasThis(ref c, by: fn) && kind != .constructor {
        ps.append($"{cType(ref cc, from: ref c, for: semantics.structTypeOf(c.functions[fn].owner))}* self")
    }
    let parameters = t9Copy(c.functions[fn].parameters)
    for p in parameters {
        let ct = cType(ref cc, from: ref c, for: c.locals[p].type)
        ps.append($"{ct}{semantics.paramIsByRef(ref c, by: p) ? "*" : ""} {fe.names[p]}")
    }
    if hasFails && returnsValue(c, by: fn) {
        ps.append($"{cType(ref cc, from: ref c, for: c.functions[fn].returnType)}* byn_out")
    }
    let noreturn = semantics.isNever(c.functions[fn].returnType) && !hasFails ? "BYN_NORETURN " : ""
    var joined = StrBuf()
    if ps.length == 0 {
        joined.append("void")
    }
    for i in 0..ps.length {
        if i > 0 {
            joined.append(", ")
        }
        joined.append(ps[i])
    }
    return $"{noreturn}{result} {functionName(ref cc, from: ref c, for: fn)}({joined.finish()})"
}

/// CEmitter.cs:1209 `FunctionEmitter.Emit`: the C definition of `f`.
public string emitFunction(ref CCtx cc, from ref Ctx c, through in ltree.LTree t, for in ltree.LoweredFunction f)
        uses alloc {
    var fe = functionEmitter(ref cc, from: ref c, for: in f)
    let fn = fe.fn
    let file = c.functions[fn].file
    // coverage-exempt: Q827
    if file != -1 {
        if cc.lineFile != file {
            cc.lineStarts = lineStartsOf(in c, for: file)
            cc.lineFile = file
        }
        fe.lineStarts = cc.lineStarts.take()
    }
    let kind = c.functions[fn].kind
    var sb = StrBuf()
    sb.append(frameSignature(ref cc, for: fe, from: ref c))
    sb.append(" {\n")
    if kind == .constructor {
        let ty = cType(ref cc, from: ref c, for: semantics.structTypeOf(c.functions[fn].owner))
        line(ref sb, by: in fe, for: $"{ty} self_v = {{0}};")
        line(ref sb, by: in fe, for: $"{ty}* self = &self_v;")
    }
    for l in f.locals {
        let lt = c.locals[l].type
        continue if semantics.isVoid(lt) || semantics.isNever(lt)
        line(ref sb, by: in fe, for: $"{cType(ref cc, from: ref c, for: lt)} {fe.names[l]} = {{0}};")
    }
    var owned = t9Copy(c.functions[fn].parameters)
    for l in f.locals {
        owned.append(l)
    }
    for l in owned {
        if hasSlot(ref cc, for: ref fe, from: ref c, at: l) {
            line(ref sb, by: in fe, for: $"byn_own_slot {slot(ref cc, for: ref fe, from: ref c, at: l)} = {{0}};")
        }
    }
    for i in 0..f.contextSlots {
        line(ref sb, by: in fe, for: $"byn_alloc* ctx{i} = byn_context;")
    }
    for i in 0..f.panicSlots {
        line(ref sb, by: in fe, for: $"byn_panic_handler ph{i};")
    }
    // Q1: round 4 redoes this (CEmitter.cs:1227).
    if kind == .lambda && c.functions[fn].captures.length == 0 {
        line(ref sb, by: in fe, for: "(void)env;")
    }
    let statements = t9Copy(c.bBlocks[f.body & 0xFFFFFFFF].statements)
    for s in statements {
        statement(ref cc, for: ref fe, from: ref c, through: t, to: ref sb, at: s)
    }
    if kind == .constructor {
        line(ref sb, by: in fe, for: "return self_v;")
    } else if c.functions[fn].hasFails && !returnsValue(c, by: fn) {
        line(ref sb, by: in fe, for: $"return ({errorCType(ref cc, from: ref c)}){{0}};")
    } else if semantics.isNever(c.functions[fn].returnType) {
        line(
            ref sb,
            by: in fe,
            for: $"byn_unreachable({fe.file}, {lineOf(in c, by: in fe, at: semantics.nodeSpan(in c, for: f.body))});",
        )
    }
    sb.append("}\n")
    if fe.lastLine != 0 {
        sb.append(t9ResetLine)
        sb.append("\n")
    }
    // coverage-exempt: Q827
    if file != -1 {
        cc.lineStarts = fe.lineStarts.take()
    }
    return $"{sb.finish()}"
}

// ── Ownership checks ─────────────────────────────────────────────────────────

/// CEmitter.cs:1257 `IsOwner`: a local, owning pattern binding (of `switch move x`) or `move` parameter this function owns.
bool isOwner(Ctx c, for LocalId l) {
    let k = c.locals[l].kind
    return ((k is .letKeyword or .varKeyword or .patternVariable) && !c.locals[l].borrowsSubject)
        || (c.locals[l].isParameter && c.locals[l].modifier == .moveKeyword)
}

/// CEmitter.cs:1261 `HasSlot` (Q845): whether local `l` has a moved slot (ownership checks on, an owned local of a unique type).
public bool hasSlot(ref CCtx cc, for ref CFunc f, from ref Ctx c, at semantics.LocalId l) uses alloc {
    return cc.ownershipChecks && isOwner(c, for: l) && semantics.isUnique(ref c, for: c.locals[l].type)
}

/// CEmitter.cs:1263 `Slot` (Q845): the C name of local `l`'s moved slot.
public string slot(ref CCtx cc, for ref CFunc f, from ref Ctx c, at semantics.LocalId l) uses alloc {
    return $"own_{f.names[l]}"
}

/// CEmitter.cs:1266 `OwnerRoot`: the owned local `e` lives in by value (through fields and tuple items), or -1.
LocalId ownerRoot(Ctx c, for BExpr e) {
    return -1 if ltree.isLowered(e)
    let i = e & 0xFFFFFFFF
    switch semantics.boundKind(e) {
        case .local: return isOwner(c, for: c.bLocals[i].local) ? c.bLocals[i].local : -1
        case .field: return ownerRoot(c, for: c.bFields[i].receiver)
        case .tupleElement: return ownerRoot(c, for: c.bTupleElements[i].receiver)
        default: return -1
    }
}

/// CEmitter.cs:1275 `Root`: the local `e` lives in by value, or -1.
LocalId root(Ctx c, for BExpr e) {
    return -1 if ltree.isLowered(e)
    let i = e & 0xFFFFFFFF
    switch semantics.boundKind(e) {
        case .local: return c.bLocals[i].local
        case .field: return root(c, for: c.bFields[i].receiver)
        case .tupleElement: return root(c, for: c.bTupleElements[i].receiver)
        default: return -1
    }
}

/// CEmitter.cs:1284 `Place`: a store target as an lvalue, without checking its local was not moved.
string placeOf(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr e) uses alloc {
    unless ltree.isLowered(e) {
        let i = e & 0xFFFFFFFF
        switch semantics.boundKind(e) {
            case .local:
                let l = c.bLocals[i].local
                return c.locals[l].isParameter && semantics.paramIsByRef(ref c, by: l) ? $"(*{f.names[l]})" : f.names[l]
            case .field:
                let receiver = placeOf(ref cc, for: ref f, from: ref c, through: t, at: c.bFields[i].receiver)
                return $"{receiver}.{fieldName(c.fields[c.bFields[i].field].name)}"
            case .tupleElement:
                let receiver = placeOf(ref cc, for: ref f, from: ref c, through: t, at: c.bTupleElements[i].receiver)
                return $"{receiver}.item{c.bTupleElements[i].index + 1}"
            default: return emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: e)
        }
    }
    return emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: e)
}

/// CEmitter.cs:1294 `CheckedStore` (Q845): `target = value` through the ownership checker, or null when it needs no hook.
public string? checkedStore(
    ref CCtx cc,
    for ref CFunc f,
    from ref Ctx c,
    through ltree.LTree t,
    at BExpr target,
    to BExpr value,
    bool claim = true
) uses alloc {
    return null if !cc.ownershipChecks
    let r = root(c, for: target)
    var local: LocalId = -1
    if !ltree.isLowered(target) && semantics.boundKind(target) == .local {
        local = c.bLocals[target & 0xFFFFFFFF].local
    }
    let hasLocalSlot = local != -1 && hasSlot(ref cc, for: ref f, from: ref c, at: local)
    let type = ltree.typeOf(in c, through: in t, for: target)
    return null if (r != -1 && c.locals[r].kind == .temp) || (!hasLocalSlot && !ownsStorage(ref c, for: type))
    let claims = claim && r != -1 && isOwner(c, for: r) ? "true" : "false"
    let set = ownSet(ref cc, from: ref c, for: type)
    let p = placeOf(ref cc, for: ref f, from: ref c, through: t, at: target)
    let v = emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: value)
    let s = hasLocalSlot ? $"&{slot(ref cc, for: ref f, from: ref c, at: local)}" : "NULL"
    return $"{set}(&{p}, {v}, {s}, {claims}, {loc(in c, by: in f, at: ltree.spanOf(in c, through: in t, for: target))})"
}

/// CEmitter.cs:1305 `Claimed` (Q845): C `call` followed by the claim of owned `receiver`, or `call` alone.
public string claimed(
    ref CCtx cc,
    for ref CFunc f,
    from ref Ctx c,
    through ltree.LTree t,
    at string call,
    by BExpr receiver,
    to semantics.TextSpan span
) uses alloc {
    return call if !cc.ownershipChecks || ownerRoot(c, for: receiver) == -1
    let claim = ownClaim(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: receiver))
    let p = placeOf(ref cc, for: ref f, from: ref c, through: t, at: receiver)
    return $"({call}, {claim}(&{p}, {loc(in c, by: in f, at: span)}))"
}

/// CEmitter.cs:1310 `ClaimAfterCall` (Q845): records the claim of owned `place`, passed by pointer, to run after the statement.
public void claimAfterCall(
    ref CCtx cc,
    for ref CFunc f,
    from ref Ctx c,
    through ltree.LTree t,
    at BExpr place,
    to semantics.TextSpan span
) uses alloc {
    unless cc.ownershipChecks {
        return
    }
    let r = ownerRoot(c, for: place)
    return if r == -1 || f.moved.contains(r)
    let type = ltree.typeOf(in c, through: in t, for: place)
    unless ownsStorage(ref c, for: type) {
        return
    }
    let claim = ownClaim(ref cc, from: ref c, for: type)
    let p = placeOf(ref cc, for: ref f, from: ref c, through: t, at: place)
    f.afterCalls.append($"{claim}(&{p}, {loc(in c, by: in f, at: span)});")
}

/// CEmitter.cs:1316 `ClaimMapEntry`.
void claimMapEntry(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, to ref StrBuf sb, at BStmt a)
        uses alloc {
    unless cc.ownershipChecks {
        return
    }
    let target = c.bAssigns[a & 0xFFFFFFFF].target
    return if ltree.isLowered(target) || semantics.boundKind(target) != .builtinCall
    let i = target & 0xFFFFFFFF
    let member = c.bBuiltinCalls[i].member
    let map = c.bBuiltinCalls[i].receiver
    // coverage-exempt: Q800
    if (member is .mapIndexSet or .mapSlot) && map != -1 && ownerRoot(c, for: map) != -1 {
        let claim = ownClaim(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: map))
        let p = placeOf(ref cc, for: ref f, from: ref c, through: t, at: map)
        line(ref sb, by: in f, for: $"{claim}(&{p}, {loc(in c, by: in f, at: semantics.nodeSpan(in c, for: a))});")
    }
}

/// CEmitter.cs:1324 `FindUnsequenced`: emits `s` (or an if's condition) dry to find the locals it both reads and moves.
void findUnsequenced(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, to ref StrBuf sb, at BStmt s)
        uses alloc {
    f.unsequenced = Map<LocalId, bool>()
    f.reads = Map<LocalId, bool>()
    f.moves = Map<LocalId, bool>()
    f.hasDryRun = true
    let mark = sb.length
    let lastLine = f.lastLine
    let lastLineEnd = f.lastLineEnd
    if !ltree.isLowered(s) && semantics.boundKind(s) == .ifStmt {
        let _ = emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: c.bIfs[s & 0xFFFFFFFF].condition)
    } else {
        statement(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
    }
    t9Truncate(ref sb, to: mark)
    f.lastLine = lastLine
    f.lastLineEnd = lastLineEnd
    var both = Map<LocalId, bool>()
    for (l, _) in f.reads {
        if f.moves.contains(l) {
            both[l] = true
        }
    }
    f.moved = f.moves.take()
    f.unsequenced = move both
    f.reads = Map<LocalId, bool>()
    f.hasDryRun = false
}

// ── Statements ───────────────────────────────────────────────────────────────

/// CEmitter.cs:1343 `Block`.
void block(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, to ref StrBuf sb, at BStmt s)
        uses alloc {
    f.indent += 1
    if !ltree.isLowered(s) && semantics.boundKind(s) == .block {
        let inner = t9Copy(c.bBlocks[s & 0xFFFFFFFF].statements)
        for x in inner {
            statement(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: x)
        }
    } else {
        statement(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
    }
    f.indent -= 1
}

/// CEmitter.cs:1351 `Statement`.
void statement(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, to ref StrBuf sb, at BStmt s)
        uses alloc {
    let lowered = ltree.isLowered(s)
    let isBlock = !lowered && semantics.boundKind(s) == .block
    let lk = ltree.lKindOf(s)
    let isLabel = lowered && lk == .label
    if cc.ownershipChecks
            && !f.hasDryRun
            && !(isBlock || (lowered && (lk is .loop or .label or .gotoStmt or .pushPanicHandler))) {
        findUnsequenced(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
    }
    f.afterCalls = List<string>()
    let mark = sb.length
    let lastLine = f.lastLine
    let lastLineEnd = f.lastLineEnd
    if !(isBlock || isLabel) {
        mapLine(ref sb, from: in c, through: ref f, at: ltree.spanOf(in c, through: in t, for: s))
    }
    let start = sb.length
    let i = s & 0xFFFFFFFF
    if lowered {
        switch lk {
            case .loop:
                line(ref sb, by: in f, for: "for (;;) {")
                block(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: t.loops[i].body)
                line(ref sb, by: in f, for: "}")
            case .label:
                let indent = f.indent - 1 > 0 ? f.indent - 1 : 0
                sb.appendRepeated(' ', by: indent * 4)
                sb.append(t.labels[i].name)
                sb.append(":;\n")
            case .gotoStmt:
                line(ref sb, by: in f, for: $"goto {t.gotoStmts[i].label};")
            case .returnStmt:
                returnStmt(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
                f.afterCalls = List<string>()
            case .returnError:
                line(
                    ref sb,
                    by: in f,
                    for: $"return {emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: t.returnErrors[i].code)};",
                )
            case .failingCall:
                let result: string? = t.failingCalls[i].result == -1 ? null : $"&{f.names[t.failingCalls[i].result]}"
                let callee = c.bCalls[t.failingCalls[i].call & 0xFFFFFFFF].function
                let builtin = c.functions[callee].builtin
                let error = f.names[t.failingCalls[i].error]
                if builtin == .none {
                    line(
                        ref sb,
                        by: in f,
                        for: $"{error} = {call(ref cc, for: ref f, from: ref c, through: t, at: t.failingCalls[i].call, to: result)};",
                    )
                } else if builtin != .ioRun && builtin != .utf8Decode && builtin != .hexDecode && builtin != .intParse {
                    // A built-in failing call returns the runtime's bare code.
                    line(
                        ref sb,
                        by: in f,
                        for: $"{error} = ({errorCType(ref cc, from: ref c)}){{ .code = {call(ref cc, for: ref f, from: ref c, through: t, at: t.failingCalls[i].call, to: result)} }};",
                    )
                } else {
                    // One that can carry a payload also writes the detail slot, which fills the payload of each
                    // detail-carrying variant of its error sets (plan 007 §1).
                    // Io.run captures into a local, so a signal-killed child's streams fill `.signaled` (Q1157).
                    let run = builtin == .ioRun
                    line(ref sb, by: in f, for: "{")
                    f.indent += 1
                    line(ref sb, by: in f, for: "int64_t detail = 0;")
                    if run {
                        line(ref sb, by: in f, for: "byn_process proc = {0};")
                    }
                    let callText = call(
                        ref cc,
                        for: ref f,
                        from: ref c,
                        through: t,
                        at: t.failingCalls[i].call,
                        to: run ? "&proc" : result,
                        by: "&detail",
                    )
                    line(
                        ref sb,
                        by: in f,
                        for: $"{error} = ({errorCType(ref cc, from: ref c)}){{ .code = {callText} }};",
                    )
                    if run && t.failingCalls[i].result != -1 {
                        line(
                            ref sb,
                            by: in f,
                            for: $"if ({error}.code == 0) {f.names[t.failingCalls[i].result]} = proc;",
                        )
                    }
                    for v in semantics.detailVariants(ref c) {
                        var held = false
                        for set in c.functions[callee].errorSets {
                            for w in c.errorSets[set].variants {
                                if w == v {
                                    held = true
                                }
                            }
                        }
                        if held {
                            let code = c.errorVariants[v].code
                            let field = c.errorVariants[v].fields[0]
                            line(
                                ref sb,
                                by: in f,
                                for: $"if ({error}.code == UINT32_C({code})) {error}.p.e{code}.{fieldName(c.locals[field].name)} = ({cType(ref cc, from: ref c, for: c.locals[field].type)})detail;",
                            )
                            if run && c.errorVariants[v].fields.length == 3 {
                                let outField = fieldName(c.locals[c.errorVariants[v].fields[1]].name)
                                let errField = fieldName(c.locals[c.errorVariants[v].fields[2]].name)
                                line(
                                    ref sb,
                                    by: in f,
                                    for: $"if ({error}.code == UINT32_C({code})) {{ {error}.p.e{code}.{outField} = proc.out; {error}.p.e{code}.{errField} = proc.err; }}",
                                )
                            }
                        }
                    }
                    f.indent -= 1
                    line(ref sb, by: in f, for: "}")
                }
            case .write:
                write(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
            case .panic:
                let message = cString(t.panics[i].message)
                line(ref sb, by: in f, for: $"byn_panic({message}, {loc(in c, by: in f, at: t.panics[i].span)});")
            case .setContext:
                if t.setContexts[i].arena != -1 {
                    line(ref sb, by: in f, for: $"ctx{t.setContexts[i].slot} = byn_context;")
                    line(
                        ref sb,
                        by: in f,
                        for: $"byn_context = byn_arena_alloc({emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: t.setContexts[i].arena)});",
                    )
                } else {
                    line(ref sb, by: in f, for: $"byn_context = ctx{t.setContexts[i].slot};")
                }
            case .freeArena:
                line(
                    ref sb,
                    by: in f,
                    for: $"byn_arena_free({emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: t.freeArenas[i].arena)});",
                )
            case .pushPanicHandler:
                // The runtime longjmps here on a panic; the handler reads only `let`s and parameters, unchanged since the setjmp.
                let slotIndex = t.pushPanicHandlers[i].slot
                line(ref sb, by: in f, for: $"if (BYN_PANIC_CATCH(&ph{slotIndex})) {{")
                f.indent += 1
                if t.pushPanicHandlers[i].panic != -1 {
                    line(ref sb, by: in f, for: $"{f.names[t.pushPanicHandlers[i].panic]} = byn_panic_current();")
                }
                f.indent -= 1
                block(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: t.pushPanicHandlers[i].body)
                f.indent += 1
                line(ref sb, by: in f, for: "byn_panic_resume();")
                f.indent -= 1
                line(ref sb, by: in f, for: "}")
                line(ref sb, by: in f, for: $"byn_panic_push(&ph{slotIndex});")
            case .popPanicHandler:
                line(ref sb, by: in f, for: $"byn_panic_pop(&ph{t.popPanicHandlers[i].slot});")
            case .claim:
                let l = t.claims[i].local
                if cc.ownershipChecks && isOwner(c, for: l) && ownsStorage(ref c, for: c.locals[l].type) {
                    let claim = ownClaim(ref cc, from: ref c, for: c.locals[l].type)
                    line(ref sb, by: in f, for: $"{claim}(&{f.names[l]}, {loc(in c, by: in f, at: t.claims[i].span)});")
                }
            // coverage-exempt: Q800
            default: panic($"cannot emit {t9StmtNames()[t9BoundStmtCount + i64(lk.ordinal)]}")
        }
    } else {
        switch semantics.boundKind(s) {
            case .block:
                line(ref sb, by: in f, for: "{")
                block(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
                line(ref sb, by: in f, for: "}")
            case .exprStmt:
                line(
                    ref sb,
                    by: in f,
                    for: $"(void){emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: c.bExprStmts[i].expr)};",
                )
            case .assign:
                let target = c.bAssigns[i].target
                let value = c.bAssigns[i].value
                var store: string? = null
                if c.bAssigns[i].op is null {
                    store = checkedStore(ref cc, for: ref f, from: ref c, through: t, at: target, to: value)
                }
                if (store is { } stored) {
                    line(ref sb, by: in f, for: $"(void){stored};")
                } else {
                    let tx = emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: target)
                    let vx = emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: value)
                    line(ref sb, by: in f, for: $"{tx} = {vx};")
                }
                claimMapEntry(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: s)
            case .ifStmt:
                line(
                    ref sb,
                    by: in f,
                    for: $"if ({emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: c.bIfs[i].condition)}) {{",
                )
                let after = f.afterCalls.take()
                afterCalls(ref sb, for: ref f, at: after)
                block(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: c.bIfs[i].then)
                let elseBranch = c.bIfs[i].elseBranch
                if elseBranch != -1 || after.length > 0 {
                    line(ref sb, by: in f, for: "} else {")
                    afterCalls(ref sb, for: ref f, at: after)
                    if elseBranch != -1 {
                        block(ref cc, for: ref f, from: ref c, through: t, to: ref sb, at: elseBranch)
                    }
                }
                line(ref sb, by: in f, for: "}")
            case .setOnPanic:
                line(
                    ref sb,
                    by: in f,
                    for: $"byn_on_panic = {functionName(ref cc, from: ref c, for: c.bSetOnPanics[i].handler)};",
                )
            default: panic(
                $"cannot emit {t9StmtNames()[i64(semantics.boundKind(s).ordinal) - i64(semantics.BoundKind.block.ordinal)]}",
            )
        }
    }
    for x in f.afterCalls {
        line(ref sb, by: in f, for: x)
    }
    f.afterCalls = List<string>()
    // A statement with no C (a claim without ownership checks) keeps no `#line` either.
    if sb.length == start {
        t9Truncate(ref sb, to: mark)
        f.lastLine = lastLine
        f.lastLineEnd = lastLineEnd
    }
}

/// CEmitter.cs:1474 `AfterCalls`: the claims after an if's condition, at the start of a branch.
void afterCalls(ref StrBuf sb, for ref CFunc f, at List<string> claims) {
    f.indent += 1
    for x in claims {
        line(ref sb, by: in f, for: x)
    }
    f.indent -= 1
}

/// CEmitter.cs:1484 `Return`.
void returnStmt(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, to ref StrBuf sb, at BStmt r)
        uses alloc {
    let fn = f.fn
    if c.functions[fn].kind == .constructor {
        line(ref sb, by: in f, for: "return self_v;")
        return
    }
    let value = t.returnStmts[r & 0xFFFFFFFF].value
    if c.functions[fn].hasFails {
        if value != -1 {
            line(
                ref sb,
                by: in f,
                for: $"*byn_out = {returned(ref cc, for: ref f, from: ref c, through: t, at: value)};",
            )
        }
        line(ref sb, by: in f, for: $"return ({errorCType(ref cc, from: ref c)}){{0}};")
        return
    }
    if value == -1 {
        line(ref sb, by: in f, for: "return;")
    } else {
        line(ref sb, by: in f, for: $"return {returned(ref cc, for: ref f, from: ref c, through: t, at: value)};")
    }
}

/// CEmitter.cs:1500 `Returned`.
string returned(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, at BExpr value) uses alloc {
    let type = ltree.typeOf(in c, through: in t, for: value)
    if cc.ownershipChecks && ownsStorage(ref c, for: type) {
        let r = ownReturn(ref cc, from: ref c, for: type)
        return $"{r}({emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: value)})"
    }
    return emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: value)
}

/// CEmitter.cs:1503 `Write`.
void write(ref CCtx cc, for ref CFunc f, from ref Ctx c, through ltree.LTree t, to ref StrBuf sb, at BStmt s)
        uses alloc {
    let i = s & 0xFFFFFFFF
    let sink = t.writes[i].sink
    let target = t.writes[i].target
    let span = t.writes[i].span
    line(ref sb, by: in f, for: "{")
    f.indent += 1
    if sink == .strBuf {
        line(
            ref sb,
            by: in f,
            for: $"byn_writer* w = &{emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: target)};",
        )
        line(ref sb, by: in f, for: $"w->file = {f.file};")
        line(ref sb, by: in f, for: $"w->line = {lineOf(in c, by: in f, at: span)};")
    } else {
        let mode = sink == .print ? $"{emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: target)} == 1 ? BYN_WRITE_STDERR : BYN_WRITE_STDOUT" : "BYN_WRITE_TRUNCATE"
        // A panic message keeps as much as the runtime does (`byn_panic_text`), room for an `assert` diagram; a log line never allocates, so it is cut.
        let size: i64 = sink == .panic ? 1024 : sink == .log ? 512 : 256
        line(ref sb, by: in f, for: $"uint8_t wb[{size}];")
        line(ref sb, by: in f, for: $"byn_writer wv = {{wb, {size}, 0, {mode}, {loc(in c, by: in f, at: span)}}};")
        line(ref sb, by: in f, for: "byn_writer* w = &wv;")
    }
    for k in 0..t.writes[i].parts.length {
        let part = t.writes[i].parts[k]
        var write: string? = null
        let text = part.text ?? ""
        if text.length > 0 {
            write = $"byn_w_str(w, {stringLiteral(text)});"
        } else if part.value != -1 {
            if (part.spec is { } spec) {
                write = formatWithSpec(ref cc, for: ref f, from: ref c, through: t, at: part.value, by: spec)
            } else {
                let vt = ltree.typeOf(in c, through: in t, for: part.value)
                let vx = emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: part.value)
                write = format(ref cc, from: ref c, for: vt, at: vx, to: "w")
            }
        }
        let w = write ?? continue
        var guard: BExpr = -1
        if (t.writes[i].guards is { } guards) {
            guard = guards[k]
        }
        if guard != -1 {
            line(
                ref sb,
                by: in f,
                for: $"if ({emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: guard)}) {{ {w} }}",
            )
        } else {
            line(ref sb, by: in f, for: w)
        }
    }
    if cc.ownershipChecks && sink == .strBuf && ownerRoot(c, for: target) != -1 {
        let claim = ownClaim(ref cc, from: ref c, for: ltree.typeOf(in c, through: in t, for: target))
        line(ref sb, by: in f, for: $"{claim}(w, {loc(in c, by: in f, at: span)});")
    }
    if sink == .print {
        line(ref sb, by: in f, for: "byn_w_println(w);")
    } else if sink == .panic {
        line(ref sb, by: in f, for: $"byn_panic_str((byn_str){{wb, wv.len}}, {loc(in c, by: in f, at: span)});")
    } else if sink == .log {
        line(
            ref sb,
            by: in f,
            for: $"byn_log({emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: target)}, (byn_str){{wb, wv.len}});",
        )
    }
    f.indent -= 1
    line(ref sb, by: in f, for: "}")
}

/// CEmitter.cs:1542 `FormatWithSpec`: a hole with specs: the value is formatted into a stack buffer (a radix, fixed
/// digits or the debug view), then written padded to the width in runes.
string formatWithSpec(
    ref CCtx cc,
    for ref CFunc f,
    from ref Ctx c,
    through ltree.LTree t,
    at BExpr value,
    by BFormatSpec spec
) uses alloc {
    let type = ltree.typeOf(in c, through: in t, for: value)
    let v = emitExpr(ref cc, for: ref f, from: ref c, through: in t, at: value)
    // A struct with a `formatInto` that takes the `FormatSpec` reads every spec itself, padding included, even when it also has the one-parameter form.
    if semantics.kindOf(type) == .structType {
        let method = formatIntoWithSpec(ref c, for: type & 0xFFFFFFFF)
        if method != -1 {
            let radix: i64 = spec.radix == 2 ? 0 : spec.radix == 8 ? 1 : spec.radix == 16 ? 3 : 2
            let align = spec.align > 0 ? spec.align : 0
            let ct = cType(ref cc, from: ref c, for: type)
            let name = functionName(ref cc, from: ref c, for: method)
            return $"{{ {ct} fv = {v}; {name}(&fv, w, (byn_format_spec){{{radix}, {spec.debug ? "true" : "false"}, {spec.width}, {spec.fill}u, {align}, {spec.digits}}}); }}"
        }
    }
    if spec.radix != 0 {
        let _ = helper(
            ref cc,
            for: "bynh_w_radix",
            from: "static void bynh_w_radix(byn_writer* w, uint64_t v, bool negative, int base)",
            as:
            "{\n    uint8_t d[64];\n    int n = 0;\n    if (negative) {\n        byn_w_char(w, '-');\n        v = 0 - v;\n    }\n    do {\n        d[n++] = (uint8_t)\"0123456789abcdef\"[v % (uint64_t)base];\n        v /= (uint64_t)base;\n    } while (v > 0);\n    while (n > 0) byn_w_bytes(w, &d[--n], 1);\n}\n",
        )
    }
    if spec.digits >= 0 {
        // Rounds half away from zero; a value too large to scale is written as `byn_w_f64` writes it.
        let _ = helper(
            ref cc,
            for: "bynh_w_digits",
            from: "static void bynh_w_digits(byn_writer* w, double v, int digits)",
            as:
            "{\n    double p = 1;\n    for (int i = 0; i < digits; i++) p *= 10;\n    double s = v * p;\n    if (!(s > -9.0e15 && s < 9.0e15)) {\n        byn_w_f64(w, v);\n        return;\n    }\n    int64_t n = (int64_t)(s < 0 ? s - 0.5 : s + 0.5);\n    if (n < 0 || (n == 0 && v < 0)) byn_w_char(w, '-');\n    uint64_t m = n < 0 ? (uint64_t)-n : (uint64_t)n, q = (uint64_t)p;\n    byn_w_u64(w, m / q);\n    if (digits == 0) return;\n    byn_w_char(w, '.');\n    uint64_t f = m % q;\n    for (uint64_t k = q / 10; k > 0; k /= 10) byn_w_char(w, (uint32_t)('0' + f / k % 10));\n}\n",
        )
    }
    return formatInner(ref cc, from: ref c, for: type, at: v, by: spec, to: "w") if spec.width == 0
    // Numbers align to the end by default, everything else to the start.
    let align: i64 = spec.align >= 0 ? spec.align : semantics.isNumeric(type) ? 1 : 0
    // The 1024-byte cut drops a code point it would split.
    let pad = helper(
        ref cc,
        for: "bynh_w_padded",
        from: "static void bynh_w_padded(byn_writer* w, byn_str s, int64_t width, uint32_t fill, int align)",
        as:
        "{\n    if (s.len > 0) {\n        int64_t k = s.len - 1;\n        while (k > 0 && (s.ptr[k] & 0xC0) == 0x80) k--;\n        uint8_t c = s.ptr[k];\n        int64_t need = c < 0x80 ? 1 : (c & 0xE0) == 0xC0 ? 2 : (c & 0xF0) == 0xE0 ? 3 : 4;\n        if (k + need > s.len) s.len = k;\n    }\n    int64_t runes = 0;\n    for (int64_t i = 0; i < s.len; i++) runes += (s.ptr[i] & 0xC0) != 0x80;\n    int64_t gap = width > runes ? width - runes : 0, before = align == 1 ? gap : align == 2 ? gap / 2 : 0;\n    for (int64_t i = 0; i < before; i++) byn_w_char(w, fill);\n    byn_w_str(w, s);\n    for (int64_t i = before; i < gap; i++) byn_w_char(w, fill);\n}\n",
    )
    let l = loc(in c, by: in f, at: ltree.spanOf(in c, through: in t, for: value))
    let inner = formatInner(ref cc, from: ref c, for: type, at: v, by: spec, to: "sw")
    return $"{{ uint8_t sb[1024]; byn_writer sv = {{sb, 1024, 0, BYN_WRITE_TRUNCATE, {l}}}; byn_writer* sw = &sv; {inner} {pad}(w, (byn_str){{sb, sv.len}}, {spec.width}, {spec.fill}u, {align}); }}"
}

/// CEmitter.cs:1550 `FormatWithSpec`'s local `Inner`.
string formatInner(ref CCtx cc, from ref Ctx c, for Type type, at string v, by BFormatSpec spec, to string sw)
        uses alloc {
    if spec.radix != 0 {
        let negative = semantics.isSignedInteger(type) ? $"({v}) < 0" : "false"
        return $"bynh_w_radix({sw}, (uint64_t)({v}), {negative}, {spec.radix});"
    }
    if spec.digits >= 0 {
        return $"bynh_w_digits({sw}, (double)({v}), {spec.digits});"
    }
    return debug(ref cc, from: ref c, for: type, at: v, to: sw) if spec.debug
    return format(ref cc, from: ref c, for: type, at: v, to: sw)
}

/// CEmitter.cs:1587 `Debug`: the debug view (SPEC §6.6): strings, `Symbol`s and runes quoted, a struct in its literal
/// form `P { x: 1, name: "a" }` (one whose `formatInto` takes the `FormatSpec` formats itself), everything else as it displays.
string debug(ref CCtx cc, from ref Ctx c, for Type type, at string v, to string w) uses alloc {
    if semantics.isString(type) || type == semantics.builtinType(.symbol) {
        let quoted = helper(
            ref cc,
            for: "bynh_w_quoted",
            from: "static void bynh_w_quoted(byn_writer* w, byn_str s, uint32_t quote)",
            as:
            "{\n    byn_w_char(w, quote);\n    for (int64_t i = 0; i < s.len; i++) {\n        uint8_t c = s.ptr[i];\n        if (c == quote || c == '\\\\') byn_w_char(w, '\\\\');\n        if (c == '\\n') byn_w_str(w, (byn_str){(const uint8_t*)\"\\\\n\", 2});\n        else byn_w_bytes(w, &c, 1);\n    }\n    byn_w_char(w, quote);\n}\n",
        )
        let text = semantics.isString(type) ? v : symbolText(ref cc, for: v)
        return $"{quoted}({w}, {text}, '\"');"
    }
    if type == semantics.prim(.char) {
        let quoted = helper(
            ref cc,
            for: "bynh_w_rune_quoted",
            from: "static void bynh_w_rune_quoted(byn_writer* w, uint32_t c)",
            as:
            "{\n    byn_w_char(w, '\\'');\n    if (c == '\\'' || c == '\\\\') byn_w_char(w, '\\\\');\n    if (c == '\\n') byn_w_str(w, (byn_str){(const uint8_t*)\"\\\\n\", 2});\n    else byn_w_char(w, c);\n    byn_w_char(w, '\\'');\n}\n",
        )
        return $"{quoted}({w}, {v});"
    }
    return format(ref cc, from: ref c, for: type, at: v, to: w) if semantics.kindOf(type) != .structType
    let s = type & 0xFFFFFFFF
    let into = formatInto(ref c, for: s)
    return format(ref cc, from: ref c, for: type, at: v, to: w) if into != -1
        && c.functions[into].parameters.length == 2
    let k = key(ref c, for: type)
    let name = $"bynh_debug_{k}"
    let proto = $"static void bynh_debug_{key(ref c, for: type)}(byn_writer* w, {cType(ref cc, from: ref c, for: type)} v)"
    if helperReserve(ref cc, for: name, from: proto) {
        var sb = StrBuf()
        sb.append("{\n")
        let fields = t9Copy(c.structs[s].fields)
        let display = semantics.structDisplayName(ref c, by: s)
        sb.append($"    byn_w_str(w, {stringLiteral($"{display}{fields.length == 0 ? " {}" : " { "}")});\n")
        for i in 0..fields.length {
            let fd = fields[i]
            let fname = c.fields[fd].name
            sb.append($"    byn_w_str(w, {stringLiteral($"{i == 0 ? "" : ", "}{fname}: ")});\n")
            sb.append("    ")
            sb.append(debug(ref cc, from: ref c, for: c.fields[fd].type, at: $"v.{fieldName(fname)}", to: "w"))
            sb.append("\n")
        }
        if fields.length > 0 {
            sb.append($"    byn_w_str(w, {stringLiteral(" }")});\n")
        }
        sb.append("}\n")
        let _ = helperFill(ref cc, for: name, from: proto, as: $"{sb.finish()}")
    }
    return $"{name}({w}, {v});"
}

// ── T9 copies ────────────────────────────────────────────────────────────────

/// The bound statement kinds in `t9StmtNames`, `block` through `errorStmt`.
const t9BoundStmtCount: i64 = 21

/// `s.GetType().Name` for `Statement`'s throw (CEmitter.cs:1461): the C# class of each bound statement kind, `block`
/// through `errorStmt`, then of each lowered kind.
List<string> t9StmtNames() uses alloc {
    var r = List<string>()
    for n in [
        "BoundBlock",
        "BoundLocalDecl",
        "BoundExprStmt",
        "BoundAssign",
        "BoundReturn",
        "BoundFail",
        "BoundBecome",
        "BoundBreak",
        "BoundContinue",
        "BoundIf",
        "BoundWhile",
        "BoundDoWhile",
        "BoundFor",
        "BoundSwitch",
        "BoundDefer",
        "BoundAssert",
        "BoundErrdefer",
        "BoundPanicDefer",
        "BoundSetOnPanic",
        "BoundContext",
        "BoundErrorStmt",
        "LLabel",
        "LGoto",
        "LLoop",
        "LReturn",
        "LReturnError",
        "LFailingCall",
        "LWrite",
        "LPanic",
        "LSetContext",
        "LFreeArena",
        "LPushPanicHandler",
        "LPopPanicHandler",
        "LClaim",
        "LOptionalHas",
        "LOptionalValue",
        "LUnionTag",
        "LUnionField",
        "LErrorCode",
        "LErrorField",
        "LAssignExpr",
        "LSequence",
        "LIndexUnchecked",
        "LNextChar",
        "LNever",
        "LFunctionValue",
        "LMutantIs",
        "LCount",
        "LVoid",
    ] {
        r.append(n)
    }
    return r
}

/// A copy of `xs`, so `c` can be passed by `ref` beside it (common.byn's `t2Copy` is for `Type`).
List<i64> t9Copy(List<i64> xs) uses alloc {
    var r = List<i64>()
    for x in xs {
        r.append(x)
    }
    return r
}

/// C#'s `_sb.Length = mark`: StrBuf has no truncate.
void t9Truncate(ref StrBuf sb, to i64 mark) uses alloc {
    let keep = $"{sb.view[0..mark]}"
    sb.clear()
    sb.append(keep)
}
== emitter/cprint/helpers.byn
// T8: CEmitter.cs 779-1046 (`Equal`, `KeyHash`, `KeyEq`, `MapMethod`, `Format`, `FormatInto`, `FormatIntoWithSpec`).
// A helper is registered in C#'s order: reserve, build the body (which may register others), fill (D5).

import semantics

/// CEmitter.cs:1045 `NoFormatSpec`: the spec a struct's two-parameter `formatInto` receives outside a hole with specs.
const t8NoFormatSpec: string = "((byn_format_spec){2, false, 0, ' ', 0, -1})"

/// `string.Join(sep, parts)`.
string t8Join(in List<string> parts, by string sep) uses alloc {
    var sb = StrBuf()
    for k in 0..parts.length {
        if k > 0 {
            sb.append(sep)
        }
        sb.append(parts[k])
    }
    return $"{sb.finish()}"
}

/// CEmitter.cs:779 `Equal` (Q848): the C expression comparing `a` and `b` of type `t`, registering any helper it calls.
public string equalHelper(ref CCtx cc, from ref Ctx c, for Type t, at string a, to string b) uses alloc {
    let i = i64(t & 0xFFFFFFFF)
    switch semantics.kindOf(t) {
        case .primitive:
            return $"byn_str_eq({a}, {b})" if semantics.isString(t)
            return $"({a} == {b})"
        case .enumType: return $"({a} == {b})"
        case .builtin:
            return $"(({a}).id == ({b}).id)" if t == semantics.builtinType(.symbol)
            return $"({a} == {b})" if t == semantics.builtinType(.millis)
        case .errorSet or .errorUnion:
            // By code, then the payload of a case that has one (Q45, Q28). One helper serves every set, as the
            // `Result`, optional and tuple helpers are keyed without theirs; a case whose payload has no equality is
            // left out, since `==` on its set does not bind (Q344).
            var cases = List<semantics.VariantId>()
            for v in 0..c.errorVariants.length {
                continue if c.errorVariants[v].fields.length == 0
                var all = true
                for fPos in 0..c.errorVariants[v].fields.length {
                    let f = c.errorVariants[v].fields[fPos]
                    if !semantics.isEquatable(ref c, for: c.locals[f].type) {
                        all = false
                    }
                }
                if all {
                    cases.append(v)
                }
            }
            // coverage-exempt: Q793
            return $"({a}.code == {b}.code)" if cases.length == 0
            let ect = errorCType(ref cc, from: ref c)
            let eq = "bynh_eq_err"
            let proto = $"static bool bynh_eq_err({ect} a, {ect} b)"
            if helperReserve(ref cc, for: eq, from: proto) {
                var sb = StrBuf()
                sb.append("{\n    if (a.code != b.code) return false;\n    switch (a.code) {\n")
                for v in cases {
                    var fields = List<string>()
                    for fPos in 0..c.errorVariants[v].fields.length {
                        let f = c.errorVariants[v].fields[fPos]
                        let n = fieldName(c.locals[f].name)
                        let code = c.errorVariants[v].code
                        fields.append(
                            equalHelper(
                                ref cc,
                                from: ref c,
                                for: c.locals[f].type,
                                at: $"a.p.e{code}.{n}",
                                to: $"b.p.e{code}.{n}",
                            ),
                        )
                    }
                    sb.append($"    case {c.errorVariants[v].code}: return {t8Join(in fields, by: "\n        && ")};\n")
                }
                sb.append("    }\n    return true;\n}\n")
                let _ = helperFill(ref cc, for: eq, from: proto, as: $"{sb.finish()}")
            }
            return $"{eq}({a}, {b})"
        case .owned: return equalHelper(ref cc, from: ref c, for: c.ownedTypes[i], at: $"(*{a})", to: $"(*{b})")
        case .untrusted: return equalHelper(ref cc, from: ref c, for: c.untrustedTypes[i], at: a, to: b)
        case .state: return equalHelper(
            ref cc,
            from: ref c,
            for: semantics.makeType(.structType, at: c.stateTypes[i].s),
            at: a,
            to: b,
        )
        default: let _ = 0
    }
    let ct = cType(ref cc, from: ref c, for: t)
    let name = $"bynh_eq_{key(ref c, for: t)}"
    let proto = $"static bool {name}({ct} a, {ct} b)"
    if helperReserve(ref cc, for: name, from: proto) {
        let _ = helperFill(ref cc, for: name, from: proto, as: t8EqBody(ref cc, from: ref c, for: t))
    }
    return $"{name}({a}, {b})"
}

/// The body of the `bynh_eq_` helper of `t` (CEmitter.cs:815-846).
string t8EqBody(ref CCtx cc, from ref Ctx c, for Type t) uses alloc {
    let i = i64(t & 0xFFFFFFFF)
    if semantics.kindOf(t) == .unionType {
        var sb = StrBuf()
        sb.append("{\n    if (a.tag != b.tag) return false;\n    switch (a.tag) {\n")
        for vPos in 0..c.unions[i].variants.length {
            let v = c.unions[i].variants[vPos]
            continue if c.unionVariants[v].fields.length == 0
            sb.append(t8EqCase(ref cc, from: ref c, for: v))
        }
        sb.append("    default: return true;\n    }\n}\n")
        return $"{sb.finish()}"
    }
    if semantics.kindOf(t) == .structType {
        if (c.states.tryGet(at: i) is { } states) {
            // The fields, then the tag, then the payload of the state both are in.
            var sb = StrBuf()
            sb.append("{\n")
            for fPos in 0..c.structs[i].fields.length {
                let f = c.structs[i].fields[fPos]
                let n = fieldName(c.fields[f].name)
                sb.append(
                    $"    if (!{equalHelper(ref cc, from: ref c, for: c.fields[f].type, at: $"a.{n}", to: $"b.{n}")}) return false;\n",
                )
            }
            sb.append("    if (a.tag != b.tag) return false;\n    switch (a.tag) {\n")
            for vPos in 0..c.unions[states].variants.length {
                let v = c.unions[states].variants[vPos]
                continue if c.unionVariants[v].fields.length == 0
                sb.append(t8EqCase(ref cc, from: ref c, for: v))
            }
            sb.append("    default: return true;\n    }\n}\n")
            return $"{sb.finish()}"
        }
    }
    if semantics.kindOf(t) == .array {
        let element = equalHelper(ref cc, from: ref c, for: c.arrayTypes[i].element, at: "a.v[i]", to: "b.v[i]")
        return $"{{\n    for (int64_t i = 0; i < {c.arrayTypes[i].length}; i++)\n        if (!{element}) return false;\n    return true;\n}}\n"
    }
    var tests = List<string>()
    switch semantics.kindOf(t) {
        case .optional:
            tests.append(
                $"a.has == b.has && (!a.has || {equalHelper(ref cc, from: ref c, for: c.optionalTypes[i], at: "a.value", to: "b.value")})",
            )
        case .result:
            let err = equalHelper(ref cc, from: ref c, for: c.resultTypes[i].error, at: "a.err", to: "b.err")
            let value = equalHelper(ref cc, from: ref c, for: c.resultTypes[i].value, at: "a.value", to: "b.value")
            tests.append($"a.err.code == b.err.code && (a.err.code != 0 ? {err} : {value})")
        case .structType:
            for fPos in 0..c.structs[i].fields.length {
                let f = c.structs[i].fields[fPos]
                let n = fieldName(c.fields[f].name)
                tests.append(equalHelper(ref cc, from: ref c, for: c.fields[f].type, at: $"a.{n}", to: $"b.{n}"))
            }
        case .tuple:
            for k in 0..c.tupleTypes[i].length {
                tests.append(
                    equalHelper(
                        ref cc,
                        from: ref c,
                        for: c.tupleTypes[i][k].type,
                        at: $"a.item{k + 1}",
                        to: $"b.item{k + 1}",
                    ),
                )
            }
        default: panic($"no equality for {semantics.typeDisplay(ref c, by: t)}")
    }
    let joined = tests.length == 0 ? "true" : t8Join(in tests, by: "\n        && ")
    return $"{{\n    return {joined};\n}}\n"
}

/// One `case {tag}: return a.u.v.f == b.u.v.f && ...;` line of a union or state helper (CEmitter.cs:823-826).
string t8EqCase(ref CCtx cc, from ref Ctx c, for semantics.VariantId v) uses alloc {
    var fields = List<string>()
    for fPos in 0..c.unionVariants[v].fields.length {
        let f = c.unionVariants[v].fields[fPos]
        let path = $"u.{fieldName(c.unionVariants[v].name)}.{fieldName(c.locals[f].name)}"
        fields.append(equalHelper(ref cc, from: ref c, for: c.locals[f].type, at: $"a.{path}", to: $"b.{path}"))
    }
    return $"    case {c.unionVariants[v].tag}: return {t8Join(in fields, by: "\n        && ")};\n"
}

/// CEmitter.cs:861 `KeyHash`: the hash of a key: seeded FNV-1a over a scalar's bytes, a string's text or a symbol's ID; a
/// tuple or struct folds its parts' hashes in declaration order, so padding never takes part (Q377).
string t8KeyHash(ref CCtx cc, from ref Ctx c, for Type k) uses alloc {
    cc.hashes = true
    let name = $"bynh_hash_{key(ref c, for: k)}"
    let proto = $"static uint64_t {name}({cType(ref cc, from: ref c, for: k)} k)"
    return name if !helperReserve(ref cc, for: name, from: proto)
    let i = i64(k & 0xFFFFFFFF)
    var types = List<Type>()
    var exprs = List<string>()
    var isParts = false
    switch semantics.kindOf(k) {
        case .structType:
            isParts = true
            for fPos in 0..c.structs[i].fields.length {
                let f = c.structs[i].fields[fPos]
                types.append(c.fields[f].type)
                exprs.append($"k.{fieldName(c.fields[f].name)}")
            }
        case .tuple:
            isParts = true
            for n in 0..c.tupleTypes[i].length {
                types.append(c.tupleTypes[i][n].type)
                exprs.append($"k.item{n + 1}")
            }
        default: let _ = 0
    }
    if !isParts {
        if semantics.isString(k) {
            return helperFill(ref cc, for: name, from: proto, as: "{\n    return byn_hash_bytes(k.ptr, k.len);\n}\n")
        }
        if k == semantics.builtinType(.symbol) {
            return helperFill(
                ref cc,
                for: name,
                from: proto,
                as: "{\n    return byn_hash_bytes(&k.id, (int64_t)sizeof k.id);\n}\n",
            )
        }
        return helperFill(
            ref cc,
            for: name,
            from: proto,
            as: "{\n    return byn_hash_bytes(&k, (int64_t)sizeof k);\n}\n",
        )
    }
    var sb = StrBuf()
    sb.append("{\n    uint64_t h = byn_hash_bytes(NULL, 0);\n")
    for n in 0..types.length {
        sb.append($"    h = byn_hash_mix(h, {t8KeyHash(ref cc, from: ref c, for: types[n])}({exprs[n]}));\n")
    }
    sb.append("    return h;\n}\n")
    return helperFill(ref cc, for: name, from: proto, as: $"{sb.finish()}")
}

/// CEmitter.cs:885 `KeyEq`: key equality through pointers, for `byn_map_*`.
string t8KeyEq(ref CCtx cc, from ref Ctx c, for Type k) uses alloc {
    let ct = cType(ref cc, from: ref c, for: k)
    let name = $"bynh_keq_{key(ref c, for: k)}"
    let proto = $"static bool {name}(const void* a, const void* b)"
    return name if !helperReserve(ref cc, for: name, from: proto)
    let eq = equalHelper(ref cc, from: ref c, for: k, at: $"*(const {ct}*)a", to: $"*(const {ct}*)b")
    return helperFill(ref cc, for: name, from: proto, as: $"{{\n    return {eq};\n}}\n")
}

/// CEmitter.cs:894 `MapMethod` (Q845): the C call for map builtin `member` on `map` of map type `t` with C arguments `args`, at C location `loc`.
public string mapMethod(
    ref CCtx cc,
    from ref Ctx c,
    for semantics.BuiltinMember member,
    as Type t,
    at string map,
    by List<string> args,
    to string loc
) uses alloc {
    let i = i64(t & 0xFFFFFFFF)
    let mt = cType(ref cc, from: ref c, for: t)
    let kt = cType(ref cc, from: ref c, for: c.mapTypes[i].key)
    let vt = cType(ref cc, from: ref c, for: c.mapTypes[i].value)
    let hash = t8KeyHash(ref cc, from: ref c, for: c.mapTypes[i].key)
    let eq = t8KeyEq(ref cc, from: ref c, for: c.mapTypes[i].key)
    let find = $"byn_map_find(&m.h, m.keys, (int64_t)sizeof({kt}), &k, {hash}(k), {eq})"
    switch member {
        case .mapIndexSet or .mapSlot:
            // A missing key is inserted with `d`: zero for a write target, the value type's default for `slot`.
            let name = $"bynh_slot_{key(ref c, for: t)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {vt}* {name}({mt}* m, {kt} k, {vt} d)",
                as: $"{{\n    if (!m->h.alloc) m->h.alloc = byn_context;\n    bool added;\n    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof({kt}), (void**)&m->vals, (int64_t)sizeof({vt}), &k, {hash}(k), {eq}, &added);\n    if (added) {{\n        m->keys[i] = k;\n        m->vals[i] = d;\n    }}\n    return &m->vals[i];\n}}\n",
            )
            let d = member == .mapSlot ? args[1] : $"(({vt}){{0}})"
            return $"(*{name}(&{map}, {args[0]}, {d}))"
        case .mapIndex:
            let name = $"bynh_index_{key(ref c, for: t)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {vt} {name}({mt} m, {kt} k, const char* file, int line)",
                as: $"{{\n    int64_t i = {find};\n    if (i < 0) byn_panic(\"key not found in map\", file, line);\n    return m.vals[i];\n}}\n",
            )
            return $"{name}({map}, {args[0]}, {loc})"
        case .mapTryGet:
            let opt = cType(ref cc, from: ref c, for: semantics.internOptional(ref c, by: c.mapTypes[i].value))
            let name = $"bynh_try_get_{key(ref c, for: t)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static {opt} {name}({mt} m, {kt} k)",
                as: $"{{\n    int64_t i = {find};\n    return i < 0 ? ({opt}){{0}} : ({opt}){{true, m.vals[i]}};\n}}\n",
            )
            return $"{name}({map}, {args[0]})"
        case .mapContains:
            let name = $"bynh_has_{key(ref c, for: t)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static bool {name}({mt} m, {kt} k)",
                as: $"{{\n    return {find} >= 0;\n}}\n",
            )
            return $"{name}({map}, {args[0]})"
        default:
            let name = $"bynh_remove_{key(ref c, for: t)}"
            let _ = helper(
                ref cc,
                for: name,
                from: $"static bool {name}({mt}* m, {kt} k)",
                as: $"{{\n    return byn_map_remove(&m->h, m->keys, (int64_t)sizeof({kt}), &k, {hash}(k), {eq});\n}}\n",
            )
            return $"{name}(&{map}, {args[0]})"
    }
}

/// CEmitter.cs:946 `Format` (Q845): the C statement that writes value `v` of type `t` to writer `w`.
public string format(ref CCtx cc, from ref Ctx c, for Type t, at string v, to string w) uses alloc {
    let i = i64(t & 0xFFFFFFFF)
    switch semantics.kindOf(t) {
        case .primitive:
            switch semantics.primKindOf(i) {
                case .string: return $"byn_w_str({w}, {v});"
                case .f64: return $"byn_w_f64({w}, {v});"
                case .f32: return $"byn_w_f32({w}, {v});"
                case .bool: return $"byn_w_bool({w}, {v});"
                case .char: return $"byn_w_char({w}, {v});"
                default:
                    if semantics.isSignedInteger(t) {
                        return $"byn_w_i64({w}, (int64_t)({v}));"
                    }
                    return $"byn_w_u64({w}, (uint64_t)({v}));"
            }
        case .errorSet or .errorUnion: return $"byn_w_error({w}, {v}.code);"
        case .enumType: return $"byn_w_str({w}, {enumNames(ref cc, from: ref c, for: i)}[{v}]);"
        case .builtin:
            if t == semantics.builtinType(.symbol) {
                return $"byn_w_str({w}, {symbolText(ref cc, for: v)});"
            }
            // A unit formats as its value plus its symbol (spec §3.4).
            if t == semantics.builtinType(.millis) {
                return $"byn_w_i64({w}, {v}); byn_w_str({w}, BYN_STR(\" ms\", 3));"
            }
        case .owned: return format(ref cc, from: ref c, for: c.ownedTypes[i], at: $"(*{v})", to: w)
        default: let _ = 0
    }
    let ct = cType(ref cc, from: ref c, for: t)
    let name = $"bynh_fmt_{key(ref c, for: t)}"
    let proto = $"static void {name}(byn_writer* w, {ct} v)"
    if helperReserve(ref cc, for: name, from: proto) {
        let _ = helperFill(ref cc, for: name, from: proto, as: t8FormatBody(ref cc, from: ref c, for: t))
    }
    return $"{name}({w}, {v});"
}

/// `Text` of `Format`'s helper body: `s` written as a literal.
string t8Text(ref CCtx cc, for string s) uses alloc {
    return $"    byn_w_str(w, {stringLiteral(s)});\n"
}

/// The body of the `bynh_fmt_` helper of `t` (CEmitter.cs:964-1027).
string t8FormatBody(ref CCtx cc, from ref Ctx c, for Type t) uses alloc {
    let i = i64(t & 0xFFFFFFFF)
    var sb = StrBuf()
    sb.append("{\n")
    switch semantics.kindOf(t) {
        case .optional:
            sb.append(
                $"    if (v.has) {format(ref cc, from: ref c, for: c.optionalTypes[i], at: "v.value", to: "w")}\n",
            )
            sb.append("    else byn_w_str(w, BYN_STR(\"null\", 4));\n")
        case .result:
            sb.append(
                $"    if (v.err.code) byn_w_error(w, v.err.code);\n    else {format(ref cc, from: ref c, for: c.resultTypes[i].value, at: "v.value", to: "w")}\n",
            )
        case .structType:
            let method = formatInto(ref c, for: i)
            if method == -1 {
                panic($"cannot format {semantics.typeDisplay(ref c, by: t)}")
            }
            let callee = functionName(ref cc, from: ref c, for: method)
            let spec = c.functions[method].parameters.length == 2 ? $", {t8NoFormatSpec}" : ""
            sb.append($"    {callee}(&v, w{spec});\n")
        case .unionType:
            sb.append("    switch (v.tag) {\n")
            for variantPos in 0..c.unions[i].variants.length {
                let variant = c.unions[i].variants[variantPos]
                let vname = c.unionVariants[variant].name
                sb.append($"    case {c.unionVariants[variant].tag}:\n")
                let fieldCount = c.unionVariants[variant].fields.length
                sb.append(t8Text(ref cc, for: fieldCount == 0 ? vname : $"{vname}("))
                for n in 0..fieldCount {
                    let f = c.unionVariants[variant].fields[n]
                    sb.append(t8Text(ref cc, for: $"{n > 0 ? ", " : ""}{c.locals[f].name}: "))
                    let part = format(
                        ref cc,
                        from: ref c,
                        for: c.locals[f].type,
                        at: $"v.u.{fieldName(vname)}.{fieldName(c.locals[f].name)}",
                        to: "w",
                    )
                    sb.append($"    {part}\n")
                }
                if fieldCount > 0 {
                    sb.append(t8Text(ref cc, for: ")"))
                }
                sb.append("        break;\n")
            }
            sb.append("    }\n")
        case .tuple:
            sb.append(t8Text(ref cc, for: "("))
            for n in 0..c.tupleTypes[i].length {
                if n > 0 {
                    sb.append(t8Text(ref cc, for: ", "))
                }
                sb.append(
                    $"    {format(ref cc, from: ref c, for: c.tupleTypes[i][n].type, at: $"v.item{n + 1}", to: "w")}\n",
                )
            }
            sb.append(t8Text(ref cc, for: ")"))
        case .map:
            sb.append("    byn_w_str(w, BYN_STR(\"{\", 1));\n    bool first = true;\n")
            sb.append("    for (int64_t i = 0; i < v.h.len; i++) {\n        if (v.h.dead[i]) continue;\n")
            sb.append("        if (!first) byn_w_str(w, BYN_STR(\", \", 2));\n        first = false;\n")
            sb.append($"        {format(ref cc, from: ref c, for: c.mapTypes[i].key, at: "v.keys[i]", to: "w")}\n")
            sb.append("        byn_w_str(w, BYN_STR(\": \", 2));\n")
            sb.append(
                $"        {format(ref cc, from: ref c, for: c.mapTypes[i].value, at: "v.vals[i]", to: "w")}\n    }}\n",
            )
            sb.append(t8Text(ref cc, for: "}"))
        default: panic($"cannot format {semantics.typeDisplay(ref c, by: t)}")
    }
    sb.append("}\n")
    return $"{sb.finish()}"
}

/// CEmitter.cs:1032 `FormatInto` (Q845): struct `s`'s `formatInto` method a hole without specs calls, or -1.
public semantics.FuncId formatInto(ref Ctx c, for semantics.StructId s) {
    var found: semantics.FuncId = -1
    for m in 0..c.structs[s].methods.length {
        let fn = c.structs[s].methods[m]
        let n = c.functions[fn].parameters.length
        if c.functions[fn].name == "formatInto"
                && !c.functions[fn].isStatic
                && !c.functions[fn].hasFails
                && (n is 1 or 2)
                && semantics.paramIsByRef(ref c, by: c.functions[fn].parameters[0])
                && c.locals[c.functions[fn].parameters[0]].type == semantics.builtinType(.strBuf)
                && (n == 1
                || (!semantics.paramIsByRef(ref c, by: c.functions[fn].parameters[1])
                && c.locals[c.functions[fn].parameters[1]].type == semantics.builtinType(.formatSpec))) {
            // `OrderBy(m => m.Parameters.Count).FirstOrDefault()`: the fewest parameters, the first of them.
            if found == -1 || n < c.functions[found].parameters.length {
                found = fn
            }
        }
    }
    return found
}

/// CEmitter.cs:1039 `FormatIntoWithSpec` (Q845): struct `s`'s two-parameter `formatInto(ref StrBuf, as FormatSpec)`, or -1.
public semantics.FuncId formatIntoWithSpec(ref Ctx c, for semantics.StructId s) {
    for m in 0..c.structs[s].methods.length {
        let fn = c.structs[s].methods[m]
        if c.functions[fn].name == "formatInto"
                && !c.functions[fn].isStatic
                && !c.functions[fn].hasFails
                && c.functions[fn].parameters.length == 2
                && semantics.paramIsByRef(ref c, by: c.functions[fn].parameters[0])
                && c.locals[c.functions[fn].parameters[0]].type == semantics.builtinType(.strBuf)
                && !semantics.paramIsByRef(ref c, by: c.functions[fn].parameters[1])
                && c.locals[c.functions[fn].parameters[1]].type == semantics.builtinType(.formatSpec) {
            return fn
        }
    }
    return -1
}
