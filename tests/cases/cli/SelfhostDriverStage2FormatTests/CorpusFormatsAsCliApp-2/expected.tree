}

public struct StructChecks {
    public FuncId check
    public List<StructRule> rules = []
}

public struct StructRule {
    public TextSpan      span
    public FieldId       field = -1
    public BExpr         condition
    public List<FieldId> reads = []
}

public struct BWithUpdate {
    public FieldId field
    public BExpr   value
}

// ── Constructors ─────────────────────────────────────────────────────────────

public BExpr addLiteral(ref Ctx c, from move BLiteral n) uses alloc {
    c.bLiterals.append(move n)
    return makeBound(.literal, at: c.bLiterals.length - 1)
}

public BExpr addSymbolLiteral(ref Ctx c, from move BSymbolLiteral n) uses alloc {
    c.bSymbolLiterals.append(move n)
    return makeBound(.symbolLiteral, at: c.bSymbolLiterals.length - 1)
}

public BExpr addHostTarget(ref Ctx c, from move BHostTarget n) uses alloc {
    c.bHostTargets.append(move n)
    return makeBound(.hostTarget, at: c.bHostTargets.length - 1)
}

public BExpr addDefault(ref Ctx c, from move BDefault n) uses alloc {
    c.bDefaults.append(move n)
    return makeBound(.defaultValue, at: c.bDefaults.length - 1)
}

public BExpr addLocal(ref Ctx c, from move BLocal n) uses alloc {
    var m = move n
    // C# `new BoundLocal(n, local) { Type = known }` keeps a narrowed state type (BinderExpressions.cs:526).
    if m.type == -1 {
        m.type = c.locals[m.local].type
    }
    c.bLocals.append(move m)
    return makeBound(.local, at: c.bLocals.length - 1)
}

public BExpr addThis(ref Ctx c, from move BThis n) uses alloc {
    c.bThises.append(move n)
    return makeBound(.thisRef, at: c.bThises.length - 1)
}

public BExpr addField(ref Ctx c, from move BField n) uses alloc {
    var m = move n
    m.type = c.fields[m.field].type
    c.bFields.append(move m)
    return makeBound(.field, at: c.bFields.length - 1)
}

public BExpr addTupleElement(ref Ctx c, from move BTupleElement n) uses alloc {
    c.bTupleElements.append(move n)
    return makeBound(.tupleElement, at: c.bTupleElements.length - 1)
}

public BExpr addCall(ref Ctx c, from move BCall n) uses alloc {
