        "release", "reload", "remove", "rename", "render", "reorder", "repeat", "replace", "reply", "report",
        "request", "require", "reserve", "reset", "resize", "resolve", "restart", "restock", "restore", "resume",
        "retry", "return", "reuse", "reverse", "revert", "rewind", "rewrite", "rotate", "round", "route",
