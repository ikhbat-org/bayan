dir my-proj/.github/workflows
=== my-proj/.github/workflows/bayan.yml
name: bayan

on: [push, pull_request]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      # Install zig and bayan here; neither has an official setup action yet.
      - run: bayan check
      - run: bayan test
