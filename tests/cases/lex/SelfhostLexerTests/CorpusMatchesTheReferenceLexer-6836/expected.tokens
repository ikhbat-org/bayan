error BYN0001: bidirectional control character U+2066 is not allowed outside string literals

  2 │ �$"{$"{$"{$"{$"{$"{$"{$"{$"{$"{$"{$"{$"{$"{$"{x}"}"}"}"}"}"}"}"}"}" 
