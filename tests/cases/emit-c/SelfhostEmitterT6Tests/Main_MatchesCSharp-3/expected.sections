== main
int main(int argc, char** argv) {
    byn_err err = {0};
    byn_hash_seed_init(argc == 3 && strcmp(argv[1], "--test") == 0);
    byn_sym_init(byn_symtab, (uint32_t)(sizeof byn_symtab / sizeof byn_symtab[0]));
    if (argc == 3 && strcmp(argv[1], "--test") == 0) {
        switch (atoi(argv[2])) {
        case 0: byn_test_0(); break;
        case 1: byn_test_1(); break;
        default: return 2;
        }
        if (err.code != 0) { byn_report_error(byn_errors[err.code - 1]); return 1; }
        byn_stdout_flush();
        return 0;
    }
    byn_str* byn_argv = byn_args(&argc, argv);
    (void)byn_argv;
    err = byn_main__main();
    if (err.code != 0) { byn_report_error(byn_errors[err.code - 1]); return byn_exit_codes[err.code - 1]; }
    byn_stdout_flush();
    return 0;
}
