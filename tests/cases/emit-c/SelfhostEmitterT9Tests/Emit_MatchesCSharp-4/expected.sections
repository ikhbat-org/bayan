static void bynh_debug_main__P(byn_writer* w, bynt_main__P v) {
    byn_w_str(w, BYN_STR("P { ", 4));
    byn_w_str(w, BYN_STR("x: ", 3));
    byn_w_i64(w, (int64_t)(v.x));
    byn_w_str(w, BYN_STR(", y: ", 5));
    byn_w_i64(w, (int64_t)(v.y));
    byn_w_str(w, BYN_STR(" }", 2));
}
