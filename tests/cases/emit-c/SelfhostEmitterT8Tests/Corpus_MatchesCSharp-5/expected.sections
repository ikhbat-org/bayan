bynh_eq_main__Order static bool bynh_eq_main__Order(bynt_main__Order a, bynt_main__Order b) | static bool bynh_eq_main__Order(bynt_main__Order a, bynt_main__Order b) {
    if (!(a.id == b.id)) return false;
    if (a.tag != b.tag) return false;
    switch (a.tag) {
