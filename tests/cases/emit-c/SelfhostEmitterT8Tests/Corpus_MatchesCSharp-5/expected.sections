    if (a.tag != b.tag) return false;
    switch (a.tag) {
    default: return true;
    }
}
bynh_eq_main__Shape static bool bynh_eq_main__Shape(byn_main_Shape a, byn_main_Shape b) | static bool bynh_eq_main__Shape(byn_main_Shape a, byn_main_Shape b) {
    if (a.tag != b.tag) return false;
    switch (a.tag) {
    case 0: return (a.u.circle.r == b.u.circle.r);
    case 1: return byn_str_eq(a.u.square.side, b.u.square.side)
        && (a.u.square.filled == b.u.square.filled);
    default: return true;
    }
}
bynh_eq_main__Pt static bool bynh_eq_main__Pt(bynt_main__Pt a, bynt_main__Pt b) | static bool bynh_eq_main__Pt(bynt_main__Pt a, bynt_main__Pt b) {
    return (a.x == b.x)
        && (a.y == b.y);
}
bynh_eq_arr2_main__Pt static bool bynh_eq_arr2_main__Pt(bynt_arr2_main__Pt a, bynt_arr2_main__Pt b) | static bool bynh_eq_arr2_main__Pt(bynt_arr2_main__Pt a, bynt_arr2_main__Pt b) {
    for (int64_t i = 0; i < 2; i++)
        if (!bynh_eq_main__Pt(a.v[i], b.v[i])) return false;
    return true;
}
bynh_eq_tup2_main__Pt_i64 static bool bynh_eq_tup2_main__Pt_i64(bynt_tup2_main__Pt_i64 a, bynt_tup2_main__Pt_i64 b) | static bool bynh_eq_tup2_main__Pt_i64(bynt_tup2_main__Pt_i64 a, bynt_tup2_main__Pt_i64 b) {
