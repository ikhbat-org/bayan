}
bynh_hash_main__Pt static uint64_t bynh_hash_main__Pt(bynt_main__Pt k) | static uint64_t bynh_hash_main__Pt(bynt_main__Pt k) {
    uint64_t h = byn_hash_bytes(NULL, 0);
    h = byn_hash_mix(h, bynh_hash_i64(k.x));
    h = byn_hash_mix(h, bynh_hash_i64(k.y));
    return h;
}
bynh_hash_i64 static uint64_t bynh_hash_i64(int64_t k) | static uint64_t bynh_hash_i64(int64_t k) {
    return byn_hash_bytes(&k, (int64_t)sizeof k);
}
