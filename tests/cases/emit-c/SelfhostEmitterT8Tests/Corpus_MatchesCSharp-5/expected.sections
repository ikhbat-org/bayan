bynh_slot_map_main__Pt_i64 static int64_t* bynh_slot_map_main__Pt_i64(bynt_map_main__Pt_i64* m, bynt_main__Pt k, int64_t d) | static int64_t* bynh_slot_map_main__Pt_i64(bynt_map_main__Pt_i64* m, bynt_main__Pt k, int64_t d) {
    if (!m->h.alloc) m->h.alloc = byn_context;
    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(bynt_main__Pt), (void**)&m->vals, (int64_t)sizeof(int64_t), &k, bynh_hash_main__Pt(k), bynh_keq_main__Pt, &added);
    if (added) {
        m->keys[i] = k;
        m->vals[i] = d;
    }
    return &m->vals[i];
}
bynh_index_map_main__Pt_i64 static int64_t bynh_index_map_main__Pt_i64(bynt_map_main__Pt_i64 m, bynt_main__Pt k, const char* file, int line) | static int64_t bynh_index_map_main__Pt_i64(bynt_map_main__Pt_i64 m, bynt_main__Pt k, const char* file, int line) {
