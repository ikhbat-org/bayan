bynh_eq_err static bool bynh_eq_err(byn_err a, byn_err b) | static bool bynh_eq_err(byn_err a, byn_err b) {
    if (a.code != b.code) return false;
    switch (a.code) {
    case 10: return (a.p.e10.signal == b.p.e10.signal)
        && byn_str_eq(a.p.e10.stdout_, b.p.e10.stdout_)
        && byn_str_eq(a.p.e10.stderr_, b.p.e10.stderr_);
    case 11: return (a.p.e11.after == b.p.e11.after)
        && byn_str_eq(a.p.e11.stdout_, b.p.e11.stdout_)
        && byn_str_eq(a.p.e11.stderr_, b.p.e11.stderr_);
    case 12: return (a.p.e12.at == b.p.e12.at);
    case 15: return (a.p.e15.n == b.p.e15.n);
    case 17: return (a.p.e17.at == b.p.e17.at);
    }
    return true;
}
bynh_eq_opt_err static bool bynh_eq_opt_err(bynt_opt_err a, bynt_opt_err b) | static bool bynh_eq_opt_err(bynt_opt_err a, bynt_opt_err b) {
    return a.has == b.has && (!a.has || bynh_eq_err(a.value, b.value));
}
