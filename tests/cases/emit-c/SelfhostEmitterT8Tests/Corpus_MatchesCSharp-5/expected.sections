bynh_fmt_main__Flag static void bynh_fmt_main__Flag(byn_writer* w, byn_main_Flag v) | static void bynh_fmt_main__Flag(byn_writer* w, byn_main_Flag v) {
    switch (v.tag) {
    case 0:
    byn_w_str(w, BYN_STR("on", 2));
        break;
    case 1:
    byn_w_str(w, BYN_STR("off", 3));
        break;
    }
}
bynh_fmt_main__Shape static void bynh_fmt_main__Shape(byn_writer* w, byn_main_Shape v) | static void bynh_fmt_main__Shape(byn_writer* w, byn_main_Shape v) {
    switch (v.tag) {
    case 0:
    byn_w_str(w, BYN_STR("circle(", 7));
    byn_w_str(w, BYN_STR("r: ", 3));
    byn_w_i64(w, (int64_t)(v.u.circle.r));
    byn_w_str(w, BYN_STR(")", 1));
        break;
    case 1:
    byn_w_str(w, BYN_STR("square(", 7));
    byn_w_str(w, BYN_STR("side: ", 6));
    byn_w_str(w, v.u.square.side);
    byn_w_str(w, BYN_STR(", filled: ", 10));
    byn_w_bool(w, v.u.square.filled);
    byn_w_str(w, BYN_STR(")", 1));
        break;
    case 2:
    byn_w_str(w, BYN_STR("none", 4));
        break;
    }
}
bynh_fmt_tup2_i64_bool static void bynh_fmt_tup2_i64_bool(byn_writer* w, bynt_tup2_i64_bool v) | static void bynh_fmt_tup2_i64_bool(byn_writer* w, bynt_tup2_i64_bool v) {
    byn_w_str(w, BYN_STR("(", 1));
    byn_w_i64(w, (int64_t)(v.item1));
    byn_w_str(w, BYN_STR(", ", 2));
    byn_w_bool(w, v.item2);
    byn_w_str(w, BYN_STR(")", 1));
}
bynh_fmt_map_i64_str static void bynh_fmt_map_i64_str(byn_writer* w, bynt_map_i64_str v) | static void bynh_fmt_map_i64_str(byn_writer* w, bynt_map_i64_str v) {
    byn_w_str(w, BYN_STR("{", 1));
    bool first = true;
    for (int64_t i = 0; i < v.h.len; i++) {
        if (v.h.dead[i]) continue;
        if (!first) byn_w_str(w, BYN_STR(", ", 2));
        first = false;
        byn_w_i64(w, (int64_t)(v.keys[i]));
        byn_w_str(w, BYN_STR(": ", 2));
        byn_w_str(w, v.vals[i]);
    }
    byn_w_str(w, BYN_STR("}", 1));
}
bynh_fmt_main__One static void bynh_fmt_main__One(byn_writer* w, bynt_main__One v) | static void bynh_fmt_main__One(byn_writer* w, bynt_main__One v) {
    byn_main__One__formatInto(&v, w);
}
bynh_fmt_main__Two static void bynh_fmt_main__Two(byn_writer* w, bynt_main__Two v) | static void bynh_fmt_main__Two(byn_writer* w, bynt_main__Two v) {
