    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(int64_t), (void**)&m->vals, (int64_t)sizeof(byn_str), &k, bynh_hash_i64(k), bynh_keq_i64, &added);
