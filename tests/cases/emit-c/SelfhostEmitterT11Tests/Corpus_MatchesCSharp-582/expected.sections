== helpers
bynh_io_read_all static bynt_res_str bynh_io_read_all(int32_t fd) | static bynt_res_str bynh_io_read_all(int32_t fd) {
    (void)fd;
    bynt_res_str r = {0};
    r.err.code = byn_io_read_stdin(&r.value, byn_context);
    return r;
}
bynh_value_res_str static byn_str bynh_value_res_str(bynt_res_str r, const char* file, int line) | static byn_str bynh_value_res_str(bynt_res_str r, const char* file, int line) {
    if (r.err.code) byn_panic("result holds an error", file, line);
    return r.value;
}
bynh_str_bytes static bynt_span_u8 bynh_str_bytes(byn_str s) | static bynt_span_u8 bynh_str_bytes(byn_str s) {
    return (bynt_span_u8){(uint8_t*)s.ptr, s.len};
}
bynh_at_span_u8 static uint8_t* bynh_at_span_u8(bynt_span_u8 s, int64_t i, bool from_end, const char* file, int line) | static uint8_t* bynh_at_span_u8(bynt_span_u8 s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
