== helpers
bynh_try_parse_opt_i64 static bynt_opt_i64 bynh_try_parse_opt_i64(byn_str s, byn_builtin_Radix radix) | static bynt_opt_i64 bynh_try_parse_opt_i64(byn_str s, byn_builtin_Radix radix) {
    int64_t v;
    if (!byn_int_parse(s, 64, true, radix, &v)) return (bynt_opt_i64){0};
    return (bynt_opt_i64){true, (int64_t)v};
}
