== helpers
bynh_add_list_i32 static void bynh_add_list_i32(bynt_list_i32* l, int32_t v) | static void bynh_add_list_i32(bynt_list_i32* l, int32_t v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(int32_t), l->alloc);
    l->ptr[l->len++] = v;
}
