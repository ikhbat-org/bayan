== helpers
bynh_slice_span_i32 static bynt_span_i32 bynh_slice_span_i32(bynt_span_i32 x, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) | static bynt_span_i32 bynh_slice_span_i32(bynt_span_i32 x, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) {
    int64_t from, to;
    byn_slice_range(x.len, a, am, b, bm, incl, file, line, &from, &to);
    return (bynt_span_i32){x.ptr + from, to - from};
}
