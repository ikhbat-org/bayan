== helpers
bynh_add_list_main__Line static void bynh_add_list_main__Line(bynt_list_main__Line* l, bynt_main__Line v) | static void bynh_add_list_main__Line(bynt_list_main__Line* l, bynt_main__Line v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(bynt_main__Line), l->alloc);
    l->ptr[l->len++] = v;
}
bynh_at_list_main__Line static bynt_main__Line* bynh_at_list_main__Line(bynt_list_main__Line s, int64_t i, bool from_end, const char* file, int line) | static bynt_main__Line* bynh_at_list_main__Line(bynt_list_main__Line s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
