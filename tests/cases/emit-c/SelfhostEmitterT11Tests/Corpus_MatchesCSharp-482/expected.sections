== helpers
bynh_at_list_u8 static uint8_t* bynh_at_list_u8(bynt_list_u8 s, int64_t i, bool from_end, const char* file, int line) | static uint8_t* bynh_at_list_u8(bynt_list_u8 s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
