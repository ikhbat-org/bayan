bynh_index_map_sym_main__TokenKind static byn_main_TokenKind bynh_index_map_sym_main__TokenKind(bynt_map_sym_main__TokenKind m, byn_sym k, const char* file, int line) | static byn_main_TokenKind bynh_index_map_sym_main__TokenKind(bynt_map_sym_main__TokenKind m, byn_sym k, const char* file, int line) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_sym), &k, bynh_hash_sym(k), bynh_keq_sym);
