== helpers
bynh_slice_str static byn_str bynh_slice_str(byn_str s, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) | static byn_str bynh_slice_str(byn_str s, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) {
    int64_t from, to;
    byn_slice_range(s.len, a, am, b, bm, incl, file, line, &from, &to);
    return byn_str_slice(s, from, to, file, line);
}
bynh_at_list_map_sym_i32 static bynt_map_sym_i32* bynh_at_list_map_sym_i32(bynt_list_map_sym_i32 s, int64_t i, bool from_end, const char* file, int line) | static bynt_map_sym_i32* bynh_at_list_map_sym_i32(bynt_list_map_sym_i32 s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
bynh_hash_sym static uint64_t bynh_hash_sym(byn_sym k) | static uint64_t bynh_hash_sym(byn_sym k) {
    return byn_hash_bytes(&k.id, (int64_t)sizeof k.id);
}
bynh_keq_sym static bool bynh_keq_sym(const void* a, const void* b) | static bool bynh_keq_sym(const void* a, const void* b) {
    return ((*(const byn_sym*)a).id == (*(const byn_sym*)b).id);
}
bynh_has_map_sym_i32 static bool bynh_has_map_sym_i32(bynt_map_sym_i32 m, byn_sym k) | static bool bynh_has_map_sym_i32(bynt_map_sym_i32 m, byn_sym k) {
    return byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_sym), &k, bynh_hash_sym(k), bynh_keq_sym) >= 0;
}
bynh_index_map_sym_i32 static int32_t bynh_index_map_sym_i32(bynt_map_sym_i32 m, byn_sym k, const char* file, int line) | static int32_t bynh_index_map_sym_i32(bynt_map_sym_i32 m, byn_sym k, const char* file, int line) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_sym), &k, bynh_hash_sym(k), bynh_keq_sym);
    if (i < 0) byn_panic("key not found in map", file, line);
    return m.vals[i];
}
bynh_add_list_sym static void bynh_add_list_sym(bynt_list_sym* l, byn_sym v) | static void bynh_add_list_sym(bynt_list_sym* l, byn_sym v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(byn_sym), l->alloc);
    l->ptr[l->len++] = v;
}
bynh_add_list_map_sym_i32 static void bynh_add_list_map_sym_i32(bynt_list_map_sym_i32* l, bynt_map_sym_i32 v) | static void bynh_add_list_map_sym_i32(bynt_list_map_sym_i32* l, bynt_map_sym_i32 v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(bynt_map_sym_i32), l->alloc);
    l->ptr[l->len++] = v;
}
bynh_at_list_sym static byn_sym* bynh_at_list_sym(bynt_list_sym s, int64_t i, bool from_end, const char* file, int line) | static byn_sym* bynh_at_list_sym(bynt_list_sym s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
