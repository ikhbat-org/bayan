bynh_sort_list_f64 static void bynh_sort_list_f64(bynt_list_f64* l) | static void bynh_sort_list_f64(bynt_list_f64* l) {
    byn_sort(l->ptr, l->len, sizeof(*l->ptr), bynh_less_f64);
