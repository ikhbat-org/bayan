== helpers
bynh_str_bytes static bynt_span_u8 bynh_str_bytes(byn_str s) | static bynt_span_u8 bynh_str_bytes(byn_str s) {
    return (bynt_span_u8){(uint8_t*)s.ptr, s.len};
}
bynh_slice_span_u8 static bynt_span_u8 bynh_slice_span_u8(bynt_span_u8 x, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) | static bynt_span_u8 bynh_slice_span_u8(bynt_span_u8 x, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) {
    int64_t from, to;
    byn_slice_range(x.len, a, am, b, bm, incl, file, line, &from, &to);
    return (bynt_span_u8){x.ptr + from, to - from};
}
bynh_add_list_i64 static void bynh_add_list_i64(bynt_list_i64* l, int64_t v) | static void bynh_add_list_i64(bynt_list_i64* l, int64_t v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(int64_t), l->alloc);
    l->ptr[l->len++] = v;
}
bynh_slice_span_i64 static bynt_span_i64 bynh_slice_span_i64(bynt_span_i64 x, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) | static bynt_span_i64 bynh_slice_span_i64(bynt_span_i64 x, int64_t a, int am, int64_t b, int bm, bool incl, const char* file, int line) {
    int64_t from, to;
    byn_slice_range(x.len, a, am, b, bm, incl, file, line, &from, &to);
    return (bynt_span_i64){x.ptr + from, to - from};
}
