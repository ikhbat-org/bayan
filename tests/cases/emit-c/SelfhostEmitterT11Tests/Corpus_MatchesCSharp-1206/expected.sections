bynh_at_span_i32 static int32_t* bynh_at_span_i32(bynt_span_i32 s, int64_t i, bool from_end, const char* file, int line) | static int32_t* bynh_at_span_i32(bynt_span_i32 s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
