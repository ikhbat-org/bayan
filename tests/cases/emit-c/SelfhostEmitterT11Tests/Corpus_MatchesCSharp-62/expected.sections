== helpers
bynh_hash_str static uint64_t bynh_hash_str(byn_str k) | static uint64_t bynh_hash_str(byn_str k) {
    return byn_hash_bytes(k.ptr, k.len);
}
bynh_keq_str static bool bynh_keq_str(const void* a, const void* b) | static bool bynh_keq_str(const void* a, const void* b) {
    return byn_str_eq(*(const byn_str*)a, *(const byn_str*)b);
}
bynh_slot_map_str_i32 static int32_t* bynh_slot_map_str_i32(bynt_map_str_i32* m, byn_str k, int32_t d) | static int32_t* bynh_slot_map_str_i32(bynt_map_str_i32* m, byn_str k, int32_t d) {
    if (!m->h.alloc) m->h.alloc = byn_context;
    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(byn_str), (void**)&m->vals, (int64_t)sizeof(int32_t), &k, bynh_hash_str(k), bynh_keq_str, &added);
    if (added) {
        m->keys[i] = k;
        m->vals[i] = d;
    }
    return &m->vals[i];
}
bynh_index_map_str_i32 static int32_t bynh_index_map_str_i32(bynt_map_str_i32 m, byn_str k, const char* file, int line) | static int32_t bynh_index_map_str_i32(bynt_map_str_i32 m, byn_str k, const char* file, int line) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_str), &k, bynh_hash_str(k), bynh_keq_str);
    if (i < 0) byn_panic("key not found in map", file, line);
    return m.vals[i];
}
bynh_has_map_str_i32 static bool bynh_has_map_str_i32(bynt_map_str_i32 m, byn_str k) | static bool bynh_has_map_str_i32(bynt_map_str_i32 m, byn_str k) {
    return byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_str), &k, bynh_hash_str(k), bynh_keq_str) >= 0;
}
bynh_slot_map_str_i64 static int64_t* bynh_slot_map_str_i64(bynt_map_str_i64* m, byn_str k, int64_t d) | static int64_t* bynh_slot_map_str_i64(bynt_map_str_i64* m, byn_str k, int64_t d) {
    if (!m->h.alloc) m->h.alloc = byn_context;
    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(byn_str), (void**)&m->vals, (int64_t)sizeof(int64_t), &k, bynh_hash_str(k), bynh_keq_str, &added);
    if (added) {
        m->keys[i] = k;
        m->vals[i] = d;
    }
    return &m->vals[i];
}
bynh_index_map_str_str static byn_str bynh_index_map_str_str(bynt_map_str_str m, byn_str k, const char* file, int line) | static byn_str bynh_index_map_str_str(bynt_map_str_str m, byn_str k, const char* file, int line) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_str), &k, bynh_hash_str(k), bynh_keq_str);
    if (i < 0) byn_panic("key not found in map", file, line);
    return m.vals[i];
}
bynh_at_span_i32 static int32_t* bynh_at_span_i32(bynt_span_i32 s, int64_t i, bool from_end, const char* file, int line) | static int32_t* bynh_at_span_i32(bynt_span_i32 s, int64_t i, bool from_end, const char* file, int line) {
    if (from_end) i = s.len - i;
    return &s.ptr[byn_index(i, s.len, file, line)];
}
