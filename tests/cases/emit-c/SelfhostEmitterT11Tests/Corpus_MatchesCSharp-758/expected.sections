== helpers
bynh_hash_i64 static uint64_t bynh_hash_i64(int64_t k) | static uint64_t bynh_hash_i64(int64_t k) {
    return byn_hash_bytes(&k, (int64_t)sizeof k);
}
bynh_keq_i64 static bool bynh_keq_i64(const void* a, const void* b) | static bool bynh_keq_i64(const void* a, const void* b) {
    return (*(const int64_t*)a == *(const int64_t*)b);
}
bynh_slot_map_i64_i64 static int64_t* bynh_slot_map_i64_i64(bynt_map_i64_i64* m, int64_t k, int64_t d) | static int64_t* bynh_slot_map_i64_i64(bynt_map_i64_i64* m, int64_t k, int64_t d) {
    if (!m->h.alloc) m->h.alloc = byn_context;
    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(int64_t), (void**)&m->vals, (int64_t)sizeof(int64_t), &k, bynh_hash_i64(k), bynh_keq_i64, &added);
    if (added) {
        m->keys[i] = k;
        m->vals[i] = d;
    }
    return &m->vals[i];
}
bynh_index_map_i64_i64 static int64_t bynh_index_map_i64_i64(bynt_map_i64_i64 m, int64_t k, const char* file, int line) | static int64_t bynh_index_map_i64_i64(bynt_map_i64_i64 m, int64_t k, const char* file, int line) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(int64_t), &k, bynh_hash_i64(k), bynh_keq_i64);
    if (i < 0) byn_panic("key not found in map", file, line);
    return m.vals[i];
}
bynh_remove_map_i64_i64 static bool bynh_remove_map_i64_i64(bynt_map_i64_i64* m, int64_t k) | static bool bynh_remove_map_i64_i64(bynt_map_i64_i64* m, int64_t k) {
    return byn_map_remove(&m->h, m->keys, (int64_t)sizeof(int64_t), &k, bynh_hash_i64(k), bynh_keq_i64);
}
bynh_has_map_i64_i64 static bool bynh_has_map_i64_i64(bynt_map_i64_i64 m, int64_t k) | static bool bynh_has_map_i64_i64(bynt_map_i64_i64 m, int64_t k) {
    return byn_map_find(&m.h, m.keys, (int64_t)sizeof(int64_t), &k, bynh_hash_i64(k), bynh_keq_i64) >= 0;
}
bynh_hash_str static uint64_t bynh_hash_str(byn_str k) | static uint64_t bynh_hash_str(byn_str k) {
    return byn_hash_bytes(k.ptr, k.len);
}
bynh_keq_str static bool bynh_keq_str(const void* a, const void* b) | static bool bynh_keq_str(const void* a, const void* b) {
    return byn_str_eq(*(const byn_str*)a, *(const byn_str*)b);
}
bynh_slot_map_str_i64 static int64_t* bynh_slot_map_str_i64(bynt_map_str_i64* m, byn_str k, int64_t d) | static int64_t* bynh_slot_map_str_i64(bynt_map_str_i64* m, byn_str k, int64_t d) {
    if (!m->h.alloc) m->h.alloc = byn_context;
    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(byn_str), (void**)&m->vals, (int64_t)sizeof(int64_t), &k, bynh_hash_str(k), bynh_keq_str, &added);
    if (added) {
        m->keys[i] = k;
        m->vals[i] = d;
    }
    return &m->vals[i];
}
bynh_try_get_map_str_i64 static bynt_opt_i64 bynh_try_get_map_str_i64(bynt_map_str_i64 m, byn_str k) | static bynt_opt_i64 bynh_try_get_map_str_i64(bynt_map_str_i64 m, byn_str k) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_str), &k, bynh_hash_str(k), bynh_keq_str);
    return i < 0 ? (bynt_opt_i64){0} : (bynt_opt_i64){true, m.vals[i]};
}
bynh_index_map_str_i64 static int64_t bynh_index_map_str_i64(bynt_map_str_i64 m, byn_str k, const char* file, int line) | static int64_t bynh_index_map_str_i64(bynt_map_str_i64 m, byn_str k, const char* file, int line) {
    int64_t i = byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_str), &k, bynh_hash_str(k), bynh_keq_str);
    if (i < 0) byn_panic("key not found in map", file, line);
    return m.vals[i];
}
bynh_has_map_str_i64 static bool bynh_has_map_str_i64(bynt_map_str_i64 m, byn_str k) | static bool bynh_has_map_str_i64(bynt_map_str_i64 m, byn_str k) {
    return byn_map_find(&m.h, m.keys, (int64_t)sizeof(byn_str), &k, bynh_hash_str(k), bynh_keq_str) >= 0;
}
