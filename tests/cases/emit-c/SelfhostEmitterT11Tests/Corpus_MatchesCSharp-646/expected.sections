== helpers
bynh_add_list_i64 static void bynh_add_list_i64(bynt_list_i64* l, int64_t v) | static void bynh_add_list_i64(bynt_list_i64* l, int64_t v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(int64_t), l->alloc);
    l->ptr[l->len++] = v;
}
bynh_remove_through_list_i64 static void bynh_remove_through_list_i64(bynt_list_i64* l, int64_t start, int64_t end, int mode, const char* file, int line) | static void bynh_remove_through_list_i64(bynt_list_i64* l, int64_t start, int64_t end, int mode, const char* file, int line) {
    if (mode == 2) {
        if (start < 0 || start >= l->len) bayan_trap_bounds(file, line);
        end = start;
    }
    if (mode != 0) {
        byn_slice_check(start, end, l->len - 1, file, line);
        end++;
    }
    byn_slice_check(start, end, l->len, file, line);
    if (end > start) memmove(l->ptr + start, l->ptr + end, (size_t)(l->len - end) * sizeof(*l->ptr));
    l->len -= end - start;
}
bynh_remove_at_range_list_i64 static void bynh_remove_at_range_list_i64(bynt_list_i64* l, bynt_tup3_i64_i64_bool at, const char* file, int line) | static void bynh_remove_at_range_list_i64(bynt_list_i64* l, bynt_tup3_i64_i64_bool at, const char* file, int line) {
    bynh_remove_through_list_i64(l, at.item1, at.item2, at.item3 ? 1 : 0, file, line);
}
