bynh_at_arr2_f64 static double* bynh_at_arr2_f64(bynt_arr2_f64* a, int64_t i, bool from_end, const char* file, int line) | static double* bynh_at_arr2_f64(bynt_arr2_f64* a, int64_t i, bool from_end, const char* file, int line) {
