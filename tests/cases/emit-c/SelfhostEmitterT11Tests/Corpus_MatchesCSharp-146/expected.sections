== helpers
bynh_hash_i64 static uint64_t bynh_hash_i64(int64_t k) | static uint64_t bynh_hash_i64(int64_t k) {
    return byn_hash_bytes(&k, (int64_t)sizeof k);
}
bynh_keq_i64 static bool bynh_keq_i64(const void* a, const void* b) | static bool bynh_keq_i64(const void* a, const void* b) {
    return (*(const int64_t*)a == *(const int64_t*)b);
}
bynh_slot_map_i64_main__S static bynt_main__S* bynh_slot_map_i64_main__S(bynt_map_i64_main__S* m, int64_t k, bynt_main__S d) | static bynt_main__S* bynh_slot_map_i64_main__S(bynt_map_i64_main__S* m, int64_t k, bynt_main__S d) {
    if (!m->h.alloc) m->h.alloc = byn_context;
    bool added;
    int64_t i = byn_map_insert(&m->h, (void**)&m->keys, (int64_t)sizeof(int64_t), (void**)&m->vals, (int64_t)sizeof(bynt_main__S), &k, bynh_hash_i64(k), bynh_keq_i64, &added);
    if (added) {
        m->keys[i] = k;
        m->vals[i] = d;
    }
    return &m->vals[i];
}
