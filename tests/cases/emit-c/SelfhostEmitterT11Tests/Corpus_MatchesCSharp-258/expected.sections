bynh_add_list_main__B static void bynh_add_list_main__B(bynt_list_main__B* l, bynt_main__B v) | static void bynh_add_list_main__B(bynt_list_main__B* l, bynt_main__B v) {
    if (!l->alloc) l->alloc = byn_context;
    byn_list_reserve((void**)&l->ptr, &l->cap, l->len + 1, (int64_t)sizeof(bynt_main__B), l->alloc);
    l->ptr[l->len++] = v;
}
bynh_at_list_i64 static int64_t* bynh_at_list_i64(bynt_list_i64 s, int64_t i, bool from_end, const char* file, int line) | static int64_t* bynh_at_list_i64(bynt_list_i64 s, int64_t i, bool from_end, const char* file, int line) {
