{"code":"BYN1065","severity":"error","file":"input.byn","span":{"start":90,"end":94,"line":10,"column":19,"endLine":10,"endColumn":23},"message":"`uses` must come before `fails`; the order is `where`, `expects`, `uses`, `becomes`, `fails`","label":"out of order","help":"move `uses` before `fails`","fixes":[{"span":{"start":82,"end":110,"line":10,"column":11,"endLine":10,"endColumn":39},"replacement":"uses console fails F fails G"}]}
{"code":"BYN1031","severity":"error","file":"input.byn","span":{"start":75,"end":77,"line":10,"column":4,"endLine":10,"endColumn":6},"message":"`T!E` is an input form; write `T f() fails E`","label":"the input form","help":"write `fails E, F, G` as the last clause of the signature","fixes":[{"span":{"start":75,"end":110,"line":10,"column":4,"endLine":10,"endColumn":39},"replacement":" g() uses console fails E, F, G"}]}
