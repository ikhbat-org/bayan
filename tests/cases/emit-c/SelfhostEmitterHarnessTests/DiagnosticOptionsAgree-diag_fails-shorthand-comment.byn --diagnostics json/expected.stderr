{"code":"BYN1065","severity":"error","file":"input.byn","span":{"start":85,"end":89,"line":9,"column":5,"endLine":9,"endColumn":9},"message":"`uses` must come before `fails`; the order is `where`, `expects`, `uses`, `becomes`, `fails`","label":"out of order","help":"move `uses` before `fails`","fixes":[{"span":{"start":73,"end":97,"line":8,"column":5,"endLine":9,"endColumn":17},"replacement":"uses console\n    fails F"}]}
{"code":"BYN1031","severity":"error","file":"input.byn","span":{"start":51,"end":53,"line":7,"column":4,"endLine":7,"endColumn":6},"message":"`T!E` is an input form; write `T f() fails E`","label":"the input form","help":"write `fails E, F` as the last clause of the signature","fixes":[{"span":{"start":51,"end":97,"line":7,"column":4,"endLine":9,"endColumn":17},"replacement":" g()\n    uses console // keep me\n    fails E, F"}]}
