{"code":"BYN1065","severity":"error","file":"input.byn","span":{"start":66,"end":70,"line":7,"column":19,"endLine":7,"endColumn":23},"message":"`uses` must come before `fails`; the order is `where`, `expects`, `uses`, `becomes`, `fails`","label":"out of order","help":"move `uses` before `fails`","fixes":[{"span":{"start":58,"end":78,"line":7,"column":11,"endLine":7,"endColumn":31},"replacement":"uses console fails F"}]}
{"code":"BYN1031","severity":"error","file":"input.byn","span":{"start":51,"end":53,"line":7,"column":4,"endLine":7,"endColumn":6},"message":"`T!E` is an input form; write `T f() fails E`","label":"the input form","help":"write `fails E, F` as the last clause of the signature","fixes":[{"span":{"start":51,"end":78,"line":7,"column":4,"endLine":7,"endColumn":31},"replacement":" g() uses console fails E, F"}]}
