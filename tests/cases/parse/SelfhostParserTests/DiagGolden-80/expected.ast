CompilationUnit
  ErrorEnum ParseError
    Variant empty doc `No digits.`
    Variant bad doc `Not a digit.`
  Function parse(string s) -> i64 fails ParseError
    Block
      Guarded if (== (. s length) 0)
        Fail .empty
      Return 1
  Function main() -> void
    Block
      Let a = (catch (call parse "1") (e) (switch e ((. ParseError empty) => 0) (_ => 1)))
      Let b = (catch (call parse "") (e) 0)
      Expr (call print (interp (+ a b)))

