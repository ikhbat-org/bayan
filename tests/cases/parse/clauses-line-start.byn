T parse<T>(string s, i64 limit)
    where T : IParse<T>
    expects s.length > 0
    expects limit > 0
    uses fs
    fails IoError {
    return T.parse(s)
}

void close(move this is .open)
    uses console
    becomes .closed
    fails {
    let expects = 1
    print(expects)
    become .closed
}

interface IStore {
    T load<T>(string key)
        where T : IParse<T>
        expects key.length > 0
        uses fs
        fails IoError
    void close(move this is .open)
        becomes .closed
        fails IoError
    i64 size()
}
