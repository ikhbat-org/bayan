$ out="$($BAYAN run main.byn)"; echo "run $?"; case "$(uname -s)-$(uname -m)" in Darwin-arm64) h=macos-arm64 ;; Darwin-x86_64) h=macos-x64 ;; Linux-x86_64) h=linux-x64 ;; Linux-aarch64) h=linux-arm64 ;; *) h=- ;; esac; if [ "$out" = "$h" ]; then echo "prints the host"; else echo "prints $out, not $h"; fi
