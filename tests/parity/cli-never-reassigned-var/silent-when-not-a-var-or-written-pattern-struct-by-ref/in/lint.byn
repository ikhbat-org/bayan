union U {
    a
    b(i64 x)
    c
}
struct P { i64 x }
union W {
    wrap(P p)
    other
}
union L {
    items(List<i64> items)
    none
}
void bump(ref i64 n) { n += 1 }
void reset(ref P p) { p.x = 0 }
interface IC {
    void bump(ref this)
    i64 n
}
struct C : IC {
    i64 n
    void bump(ref this) { n += 1 }
}

void f(U u) {
    let w = W.wrap(P { x: 1 })
    if w is .wrap(var p) {
        reset(ref p)
        print($"{p.x}")
    }
}
f(U.a)
