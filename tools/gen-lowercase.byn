#!/usr/bin/env bayan
// Regenerates the simple case mapping tables in runtime/bayan-rt.c (revision 0015).
//
// Usage: bash scripts/bayan-tool.sh gen-lowercase [path/to/UnicodeData.txt]
//
// Without a path it downloads UnicodeData.txt for unicodeVersion into tmp/ucd-<version>/. The version is the one
// .NET 10's CharUnicodeInfo carries, so `lowercased()` agrees with `ToLowerInvariant` there. The tables are the simple
// mappings (UnicodeData.txt field 13 lowercase, field 12 uppercase), minus the dotted and dotless i, which .NET's
// invariant casing leaves unchanged: U+0130 does not lowercase and U+0131 does not uppercase.
//
// Port of scripts/unicode/gen-lowercase.py (spec 015 T9). The repo root comes from $BAYAN_REPO_ROOT, which
// scripts/bayan-tool.sh sets (or the working directory when run directly).

const unicodeVersion: string = "16.0.0"
const beginMarker: string = "/* BEGIN generated by scripts/unicode/gen-lowercase.py"
const endMarker: string = "/* END generated by scripts/unicode/gen-lowercase.py */"
const excludedLower: u32 = 0x0130
const excludedUpper: u32 = 0x0131

/// Python's `open(path, encoding="utf-8")` (text mode): `\r\n` and a lone `\r` become `\n`.
string readTextMode(string path) uses fs, alloc fails IoError, Utf8Error {
    let bytes = try Io.readFile(path)
    let text = try Utf8.decode(bytes)
    return text.replaced("\r\n", by: "\n").replaced("\r", by: "\n")
}

/// `text.split(sep)`.
List<string> split(string text, by string sep) uses alloc {
    var result: List<string> = List<string>()
    for p in text.parts(by: sep) { result.append(p) }
    return result
}

/// `text.splitlines()` on text already read in text mode.
List<string> splitLines(string text) uses alloc {
    var result = split(text, by: "\n")
    if result[result.length - 1].isEmpty { let _ = result.removeLast() }
    return result
}

/// Formats `pairs` (`a`, `b` alternating) as a 6-per-line C `[][2]` table.
string table(string name, from List<u32> pairs) uses alloc {
    var sb = StrBuf(capacity: 4096)
    sb.append($"static const uint32_t {name}[][2] = {{")
    var i: i64 = 0
    while i < pairs.length {
        sb.append("\n    ")
        let end = i + 12 < pairs.length ? i + 12 : pairs.length
        var j = i
        while j < end {
            if j > i { sb.append(" ") }
            let a = string(pairs[j], as: .hex).uppercased()
            let b = string(pairs[j + 1], as: .hex).uppercased()
            sb.append($"{{0x{a}, 0x{b}}},")
            j += 2
        }
        i += 12
    }
    sb.append("\n};")
    return sb.finish()
}

/// Returns the cached `tmp/ucd-<version>/UnicodeData.txt` under `root`, downloading it via `curl` into `.part` first if missing.
string cachedUcd(string root) uses fs, process, console, alloc {
    let directory = Path.combine(root, $"tmp/ucd-{unicodeVersion}")
    Io.createDirectory(directory) catch {
        print($"gen-lowercase: cannot create {directory}", to: .stderr)
        return ""
    }
    let path = Path.combine(directory, "UnicodeData.txt")
    if !Fs.fileExists(path) {
        // download beside the cache and move it in whole, so an interrupted download is never taken for the file
        let url = $"https://www.unicode.org/Public/{unicodeVersion}/ucd/UnicodeData.txt"
        let part = $"{path}.part"
        var curlArgs: List<string> = List<string>()
        curlArgs.append("-fsSL")
        curlArgs.append("-o")
        curlArgs.append(part)
        curlArgs.append(url)
        let r = Io.run("curl", curlArgs.span) catch {
            print($"gen-lowercase: failed to download {url}", to: .stderr)
            return ""
        }
        if r.exitCode != 0 {
            print($"gen-lowercase: failed to download {url} (curl exit {r.exitCode})", to: .stderr)
            return ""
        }
        Fs.rename(part, to: path) catch {
            print($"gen-lowercase: cannot rename {part} to {path}", to: .stderr)
            return ""
        }
    }
    return path
}

i32 main(ReadOnlySpan<string> argv) uses fs, env, process, console, alloc {
    let runtimeHere = Path.combine(Path.fullPath("."), "runtime/bayan-rt.c")
    var root = Fs.fileExists(runtimeHere) ? Path.fullPath(".") : Env.get("BAYAN_REPO_ROOT") ?? ""
    if root.isEmpty { root = Path.fullPath(".") }
    let path = argv.length > 0 ? argv[0] : cachedUcd(root)
    if path.isEmpty { return 1 }
    let ucdText = readTextMode(path) catch {
        print($"gen-lowercase: cannot read {path}", to: .stderr)
        return 1
    }
    var lower: List<u32> = List<u32>()
    var upper: List<u32> = List<u32>()
    for line in splitLines(ucdText) {
        let fields = split(line, by: ";")
        if fields.length < 14 {
            print("gen-lowercase: malformed UnicodeData.txt line", to: .stderr)
            return 1
        }
        let cp = u32.parse(fields[0], as: .hex) catch {
            print($"gen-lowercase: invalid code point {fields[0]}", to: .stderr)
            return 1
        }
        if !fields[13].isEmpty && cp != excludedLower {
            let lo = u32.parse(fields[13], as: .hex) catch {
                print($"gen-lowercase: invalid lowercase mapping {fields[13]}", to: .stderr)
                return 1
            }
            lower.append(cp)
            lower.append(lo)
        }
        if !fields[12].isEmpty && cp != excludedUpper {
            let up = u32.parse(fields[12], as: .hex) catch {
                print($"gen-lowercase: invalid uppercase mapping {fields[12]}", to: .stderr)
                return 1
            }
            upper.append(cp)
            upper.append(up)
        }
    }
    var genBuf = StrBuf(capacity: 65536)
    genBuf.append($"{beginMarker} from UnicodeData.txt {unicodeVersion}; do not edit. */\n")
    genBuf.append("/* Simple lowercase (field 13) and uppercase (field 12) mappings, sorted by code point; U+0130 and U+0131 map to\n")
    genBuf.append(" * themselves, as in .NET's invariant casing. */\n")
    genBuf.append(table("byn_lower_map", from: lower))
    genBuf.append("\n")
    genBuf.append(table("byn_upper_map", from: upper))
    genBuf.append("\n")
    genBuf.append(endMarker)
    let generated = genBuf.finish()

    let runtimePath = Path.combine(root, "runtime/bayan-rt.c")
    let sourceBytes = Io.readFile(runtimePath) catch {
        print($"gen-lowercase: cannot read {runtimePath}", to: .stderr)
        return 1
    }
    let source = Utf8.decode(sourceBytes) catch {
        print($"gen-lowercase: invalid UTF-8 in {runtimePath}", to: .stderr)
        return 1
    }
    let start = source.position(beginMarker) ?? -1
    let endPos = source.position(endMarker) ?? -1
    if start < 0 || endPos < 0 {
        print("ValueError: substring not found", to: .stderr)
        return 1
    }
    let end = endPos + endMarker.length
    var outBuf = StrBuf(capacity: source.length + generated.length)
    outBuf.append(source[0..start])
    outBuf.append(generated)
    outBuf.append(source[end..source.length])
    let partPath = $"{runtimePath}.part"
    Io.writeFile(partPath, outBuf.finish().bytes) catch {
        print($"gen-lowercase: cannot write {partPath}", to: .stderr)
        return 1
    }
    Fs.rename(partPath, to: runtimePath) catch {
        print($"gen-lowercase: cannot rename {partPath} to {runtimePath}", to: .stderr)
        return 1
    }
    print($"{lower.length / 2} lowercase, {upper.length / 2} uppercase mappings from {path}")
    return 0
}
