void main() {
    let read = Io.stdin.readAll()
    if !read.isOk {
        print("cannot read input", to: .stderr)
        return
    }
    var count = 0
    var blank = 0
    for line in read.value.lines {
        count += 1
        if line.isEmpty {
            blank += 1
            continue
        }
        print($"{count}: {line}")
    }
    print($"{count} lines, {blank} blank")
}
