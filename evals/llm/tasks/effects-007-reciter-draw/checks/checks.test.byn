test "one reciter is always drawn" {
    var i = 0
    while i < 20 {
        assert drawReciter(1) == 0
        i += 1
    }
}

test "every draw is a place in the list" {
    var i = 0
    while i < 200 {
        let place = drawReciter(7)
        assert place >= 0
        assert place < 7
        i += 1
    }
}

test "every reciter can be drawn" {
    var seen = List<bool>()
    seen.append(false)
    seen.append(false)
    seen.append(false)
    var i = 0
    while i < 300 {
        seen[drawReciter(3)] = true
        i += 1
    }
    assert seen[0]
    assert seen[1]
    assert seen[2]
}

test "drawReciter declares no effect beyond random" {
    let draw: i64 -> i64 uses random = drawReciter
    assert draw(2) < 2
}
