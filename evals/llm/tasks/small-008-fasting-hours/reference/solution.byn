/// The hours written in `text`, or -1 when it is not digits with at most one point between digits, or above 24.
f64 hours(string text) {
    var points = 0
    for i in 0..text.length {
        let b = text.bytes[i]
        if b == '.' {
            return -1 if i == 0 || i == text.length - 1
            points += 1
        } else if b < '0' || b > '9' {
            return -1
        }
    }
    return -1 if text.isEmpty || points > 1
    let value = f64.tryParse(text) ?? -1
    return value > 24 ? -1 : value
}

void main() {
    let read = Io.stdin.readAll()
    if !read.isOk {
        print("cannot read input", to: .stderr)
        return
    }
    var days = 0
    var total: f64 = 0
    var longest: f64 = -1
    var longestDay = ""
    for line in read.value.lines {
        let text = line.trimmed()
        continue if text.isEmpty
        var fields = List<string>()
        for part in text.parts(by: " ") {
            fields.append(part)
        }
        let fasted = fields.length == 2 ? hours(fields[1]) : -1
        if fasted < 0 {
            print($"skipped: {text}")
            continue
        }
        print($"{fields[0]}: {fasted, digits: 2}")
        days += 1
        total += fasted
        if fasted > longest {
            longest = fasted
            longestDay = fields[0]
        }
    }
    print($"days: {days}")
    if days == 0 {
        print("average: none")
        print("longest: none")
        return
    }
    print($"average: {total / f64(days), digits: 2}")
    print($"longest: {longestDay} {longest, digits: 2}")
}
