/// Where one juz of the khatm stands.
union Juz {
    open
    claimed(string by)
    finished(string by)
}

/// The line a command prints when it cannot act on `juz`, the juz numbered `number`.
string refusal(Juz juz, at i64 number) {
    switch juz {
        case .open: return $"juz {number} is not claimed"
        case .claimed(let by): return $"juz {number} is taken by {by}"
        case .finished(let by): return $"juz {number} was finished by {by}"
    }
}

/// The open juz of `circle` as runs: `1-3, 5, 9-30`, or `none`.
string openRuns(List<Juz> circle) {
    var text = StrBuf()
    var start: i64 = 0
    for i in 1..=circle.length + 1 {
        let isOpen = i <= circle.length && circle[i - 1] is .open
        if isOpen && start == 0 {
            start = i
        } else if !isOpen && start > 0 {
            text.append(text.length == 0 ? "" : ", ")
            if start == i - 1 {
                text.append(start)
            } else {
                text.append($"{start}-{i - 1}")
            }
            start = 0
        }
    }
    return text.length == 0 ? "none" : text.finish().copy()
}

void main() {
    let read = Io.stdin.readAll()
    if !read.isOk {
        print("cannot read input", to: .stderr)
        return
    }
    var circle = List<Juz>()
    for _ in 0..30 {
        circle.append(.open)
    }
    for line in read.value.lines {
        let text = line.trimmed()
        continue if text.isEmpty
        var fields = List<string>()
        for part in text.parts(by: " ") {
            fields.append(part)
        }
        if fields.length == 1 && fields[0] == "status" {
            var finished = 0
            var claimed = 0
            for juz in circle {
                switch juz {
                    case .open: continue
                    case .claimed(_): claimed += 1
                    case .finished(_): finished += 1
                }
            }
            print($"finished: {finished} claimed: {claimed} open: {openRuns(circle)}")
            continue
        }
        let number = fields.length == 3 ? (i64.tryParse(fields[2]) ?? 0) : 0
        let verb = fields[0]
        if number < 1 || number > 30 || (verb != "claim" && verb != "done" && verb != "release") {
            print($"bad command: {text}")
            continue
        }
        let name = fields[1]
        let juz = circle[number - 1]
        if verb == "claim" {
            if juz is .open {
                circle[number - 1] = .claimed(name)
                print($"{name} claims juz {number}")
            } else {
                print(refusal(juz, at: number))
            }
            continue
        }
        if !(juz is .claimed(let by) && by == name) {
            print(refusal(juz, at: number))
        } else if verb == "done" {
            circle[number - 1] = .finished(name)
            print($"{name} finished juz {number}")
        } else {
            circle[number - 1] = .open
            print($"juz {number} is open again")
        }
    }
}
