import std.regex

void main() {
    let read = Io.stdin.readAll()
    if !read.isOk {
        print("cannot read input", to: .stderr)
        return
    }
    let entry = regex.Regex.parse("^[A-Za-z]+ paid ([0-9]+) on ([0-9]{4}-[0-9]{2})-[0-9]{2}$") catch {
        print("bad pattern", to: .stderr)
        return
    }
    var months = List<string>()
    var totals = Map<string, i64>()
    for line in read.value.lines {
        let text = line.trimmed()
        continue if text.isEmpty
        let found = entry.find(text)
        if found is null {
            print($"skipped: {text}")
            continue
        }
        let amount = i64.tryParse(found.group(1) ?? "") ?? 0
        let month = found.group(2) ?? ""
        if !totals.contains(month) {
            months.append(month)
        }
        totals[month] = (totals.tryGet(at: month) ?? 0) + amount
    }
    for month in months {
        print($"{month}: {totals[month]}")
    }
}
